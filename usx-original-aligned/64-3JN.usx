	<para style="p"><verse number="4" style="v" x-ref="3JN.1.4" sid="3JN 1:4" /><char style="w" x-id="SBLGNT.3JN.1.4.001" x-align="3JN.1.4.a001" x-target-ids="t001" x-target="Greater" x-target-head="t001" x-head="true" lemma="μειζότερος" strong="G3186" x-morph="A-ASF-C" x-gloss="Greater" x-translit="meizoteran" xml:lang="grc">μειζοτέραν</char> <char style="w" x-id="SBLGNT.3JN.1.4.002" x-align="3JN.1.4.a002" x-target-ids="t006 t007" x-target="than this" x-target-head="t007" x-head="true" lemma="οὗτος" strong="G5130" x-morph="D-GPN" x-gloss="than these things" x-translit="toutōn" xml:lang="grc">τούτων</char> <char style="w" x-id="SBLGNT.3JN.1.4.003" x-align="3JN.1.4.a003" x-target-ids="t005" x-target="none" x-target-head="t005" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.3JN.1.4.004" x-align="3JN.1.4.a004" x-target-ids="t003 t004" x-target="have I" x-target-head="t003" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAI-1S" x-gloss="I have" x-translit="echō" xml:lang="grc">ἔχω</char> <char style="w" x-id="SBLGNT.3JN.1.4.005" x-align="3JN.1.4.a005" x-target-ids="t002" x-target="joy" x-target-head="t002" x-head="true" lemma="χαρά" strong="G5479" x-morph="N-ASF" x-gloss="joy" x-translit="charan" xml:lang="grc">χαράν</char>,<char style="w" x-id="SBLGNT.3JN.1.4.006" x-align="3JN.1.4.a006" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.3JN.1.4.007" x-align="3JN.1.4.a007" x-target-ids="t009 t010" x-target="hear of" x-target-head="t009" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-PAS-1S" x-gloss="I should hear of" x-translit="akouō" xml:lang="grc">ἀκούω</char> <char style="w" x-id="SBLGNT.3JN.1.4.008" x-align="3JN.1.4.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-gloss="-" x-tran