	<para style="p"><verse number="1" style="v" x-ref="3JN.1.1" sid="3JN 1:1" /><char style="w" x-id="SBLGNT.3JN.1.1.001" x-align="3JN.1.1.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="The" x-translit="Ho" xml:lang="grc">Ὁ</char> <char style="w" x-id="SBLGNT.3JN.1.1.002" x-align="3JN.1.1.a002" x-target-ids="t002" x-target="elder" x-target-head="t002" x-head="true" lemma="πρεσβύτερος" strong="G4245" x-morph="A-NSM-C" x-gloss="elder" x-translit="presbyteros" xml:lang="grc">πρεσβύτερος</char> <char style="w" x-id="SBLGNT.3JN.1.1.003" x-align="3JN.1.1.a003" x-target-ids="t003 t004" x-target="unto Gaius" x-target-head="t004" x-head="true" lemma="Γάϊος" strong="G1050" x-morph="N-DSM" x-gloss="To Gaius" x-translit="Gaiōi" xml:lang="grc">Γαΐῳ</char> <char style="w" x-id="SBLGNT.3JN.1.1.004" x-align="3JN.1.1.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="the" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.3JN.1.1.005" x-align="3JN.1.1.a005" x-target-ids="t006" x-target="beloved" x-target-head="t006" x-head="true" lemma="ἀγαπητός" strong="G27" x-morph="A-DSM" x-gloss="beloved" x-translit="agapētōi" xml:lang="grc">ἀγαπητῷ</char>,<char style="w" x-id="SBLGNT.3JN.1.1.006" x-align="3JN.1.1.a006" x-target-ids="t007" x-target="whom" x-target-head="t007" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-ASM" x-gloss="whom" x-translit="hon" xml:lang="grc">ὃν</char> <char style="w" x-id="SBLGNT.3JN.1.1.007" x-align="3JN.1.1.a007" x-target-ids="t008" x-target="I" x-target-head="t008" x-head="true" lemma="ἐγώ" strong="G1473" x-morph="P-1NS" x-gloss="I" x-translit="egō" xml:lang="grc">ἐγὼ</char> <char style="w" x-id="SBLGNT.3JN.1.1.008" x-align="3JN.1.1.a008" x-target-ids="t009" x-target="love" x-target-head="t009" x-head="true" lemma="ἀγαπάω" strong="G25" x-morph="V-PAI-1S" x-gloss="love" x-translit="agapō" x