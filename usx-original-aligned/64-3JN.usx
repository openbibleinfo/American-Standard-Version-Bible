	<para style="p"><verse number="9" style="v" x-ref="3JN.1.9" sid="3JN 1:9" /><char style="w" x-id="SBLGNT.3JN.1.9.001" x-align="3JN.1.9.a001" x-target-ids="t001 t002" x-target="I wrote" x-target-head="t002" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-AAI-1S" x-gloss="I have written" x-translit="Egrapsa" xml:lang="grc">Ἔγραψά</char> <char style="w" x-id="SBLGNT.3JN.1.9.002" x-align="3JN.1.9.a002" x-target-ids="t003" x-target="somewhat" x-target-head="t003" x-head="true" lemma="τις" strong="G5100" x-morph="X-ASN" x-gloss="something" x-translit="ti" xml:lang="grc">τι</char> <char style="w" x-id="SBLGNT.3JN.1.9.003" x-align="3JN.1.9.a003" x-target-ids="t004 t005" x-target="unto the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="to the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.3JN.1.9.004" x-align="3JN.1.9.a004" x-target-ids="t006" x-target="church" x-target-head="t006" x-head="true" lemma="ἐκκλησία" strong="G1577" x-morph="N-DSF" x-gloss="church" x-translit="ekklēsiai" xml:lang="grc">ἐκκλησίᾳ</char>·<char style="w" x-id="SBLGNT.3JN.1.9.005" x-align="3JN.1.9.a005" x-target-ids="t007" x-target="but" x-target-head="t007" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.3JN.1.9.006" x-align="3JN.1.9.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the [one]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.3JN.1.9.007" x-align="3JN.1.9.a007" x-target-ids="t009 t010 t011 t012 t013 t014" x-target="who loveth to have the preeminence" x-target-head="t010" x-head="true" lemma="φιλοπρωτεύω" strong="G5383" x-morph="V-PAP-NSM" x-gloss="loving to be first" x-translit="philoprōteuōn" xml:lang="grc">φιλοπρωτεύων</char> <char style="w" x-id="SBLGNT.3JN.1.9.008" x-align="3JN.1.9.a008" x-target-ids="t015 t016" x-target="among them" x-target-head="t016" x