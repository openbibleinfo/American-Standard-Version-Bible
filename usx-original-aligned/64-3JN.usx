	<para style="p"><verse number="10" style="v" x-ref="3JN.1.10" sid="3JN 1:10" /><char style="w" x-id="SBLGNT.3JN.1.10.001" x-align="3JN.1.10.a001" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="Because of" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.3JN.1.10.002" x-align="3JN.1.10.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char>,<char style="w" x-id="SBLGNT.3JN.1.10.003" x-align="3JN.1.10.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.3JN.1.10.004" x-align="3JN.1.10.a003" x-target-ids="t003 t004" x-target="I come" x-target-head="t004" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAS-1S" x-gloss="I might come" x-translit="elthō" xml:lang="grc">ἔλθω</char>,<char style="w" x-id="SBLGNT.3JN.1.10.005" x-align="3JN.1.10.a004" x-target-ids="t005 t006 t007 t008 t009" x-target="I will bring to remembrance" x-target-head="t009" x-head="true" lemma="ὑπομιμνῄσκω" strong="G5279" x-morph="V-FAI-1S" x-gloss="I will bring to remembrance" x-translit="hypomnēsō" xml:lang="grc">ὑπομνήσω</char> <char style="w" x-id="SBLGNT.3JN.1.10.006" x-align="3JN.1.10.a005" x-target-ids="t010" x-target="his" x-target-head="t010" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.3JN.1.10.007" x-align="3JN.1.10.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-gloss="the" x-translit="ta" xml:lang="grc">τὰ</char> <char style="w" x-id="SBLGNT.3JN.1.10.008" x-align="3JN.1.10.a007" x-target-ids="t011" x-target="works" x-target-head="t011" x-head="true" lemma="ἔργον" strong="G2041" x-morph="N-APN" x-gloss="works" x-translit="erga" xml:la