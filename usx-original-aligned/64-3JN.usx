	<para style="p"><verse number="2" style="v" x-ref="3JN.1.2" sid="3JN 1:2" /><char style="w" x-id="SBLGNT.3JN.1.2.001" x-align="3JN.1.2.a001" x-target-ids="t001" x-target="Beloved" x-target-head="t001" x-head="true" lemma="ἀγαπητός" strong="G27" x-morph="A-VSM" x-gloss="Beloved" x-translit="Agapēte" xml:lang="grc">Ἀγαπητέ</char>,<char style="w" x-id="SBLGNT.3JN.1.2.002" x-align="3JN.1.2.a002" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="concerning" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.3JN.1.2.003" x-align="3JN.1.2.a003" x-target-ids="t006 t007" x-target="all things" x-target-head="t006" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-GPN" x-gloss="all things" x-translit="pantōn" xml:lang="grc">πάντων</char> <char style="w" x-id="SBLGNT.3JN.1.2.004" x-align="3JN.1.2.a004" x-target-ids="t002 t003" x-target="I pray" x-target-head="t003" x-head="true" lemma="εὔχομαι" strong="G2172" x-morph="V-PNI-1S" x-gloss="I pray" x-translit="euchomai" xml:lang="grc">εὔχομαί</char> <char style="w" x-id="SBLGNT.3JN.1.2.005" x-align="3JN.1.2.a005" x-target-ids="t008" x-target="thou" x-target-head="t008" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.3JN.1.2.006" x-align="3JN.1.2.a006" x-target-ids="t004 t009 t010" x-target="that mayest prosper" x-target-head="t010" x-head="true" lemma="εὐοδόομαι" strong="G2137" x-morph="V-PPN" x-gloss="to prosper" x-translit="euodousthai" xml:lang="grc">εὐοδοῦσθαι</char> <char style="w" x-id="SBLGNT.3JN.1.2.007" x-align="3JN.1.2.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.3JN.1.2.008" x-align="3JN.1.2.a008" x-target-ids="t012 t013 t014" x-target="be in health" x-target-head="t014" x-head="true" lemma="ὑγιαίνω" strong="G5198" x-morph="V-PAN" x-gloss="to be in good health" x-translit="hygiainein" xml:lang="grc">ὑγιαίνειν</char>,<char style="w" x-id="SBLGNT.3JN.1.2.009" x-align="3JN.1.2.a009" x-target-ids="t015 t016" x-target="even as" x-target-head="t016" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="just as" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.3JN.1.2.010" x-align="3JN.1.2.a010" x-target-ids="t019" x-target="prospereth" x-target-head="t019" x-head="true" lemma="εὐοδόομαι" strong="G2137" x-morph="V-PPI-3S" x-gloss="prospers" x-translit="euodoutai" xml:lang="grc">εὐοδοῦταί</char> <char style="w" x-id="SBLGNT.3JN.1.2.011" x-align="3JN.1.2.a011" x-target-ids="t017" x-target="thy" x-target-head="t017" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="your" x-translit="sou" xml:lang="grc">σου</char> <char style="w" x-id="SBLGNT.3JN.1.2.012" x-align="3JN.1.2.a012" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="-" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.3JN.1.2.013" x-align="3JN.1.2.a013" x-target-ids="t018" x-target="soul" x-target-head="t018" x-head="true" lemma="ψυχή" strong="G5590" x-morph="N-NSF" x-gloss="soul" x-translit="psychē" xml:lang="grc">ψυχή</char>.<verse eid="3JN 1:2" /></para>
	<para style="p"><verse number="3" style="v" x-ref="3JN.1.3" sid="3JN 1:3" /><char style="w" x-id="SBLGNT.3JN.1.3.001" x-align="3JN.1.3.a001" x-target-ids="t002 t003" x-target="I rejoiced" x-target-head="t003" x-head="true" lemma="χαίρω" strong="G5463" x-morph="V-2AOI-1S" x-gloss="I rejoiced" x-translit="echarēn" xml:lang="grc">ἐχάρην</char> <char style="w" x-id="SBLGNT.3JN.1.3.002" x-align="3JN.1.3.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.3JN.1.3.003" x-align="3JN.1.3.a003" x-target-ids="t004" x-target="greatly" x-target-head="t004" x-head="true" lemma="λίαν" strong="G3029" x-morph="ADV" x-gloss="exceedingly" x-translit="lian" xml:lang="grc">λίαν</char> <char style="w" x-id="SBLGNT.3JN.1.3.004" x-align="3JN.1.3.a004" x-target-ids="t005 t007" x-target="when came" x-target-head="t007" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-PNP-GPM" x-gloss="coming" x-translit="erchomenōn" xml:lang="grc">ἐρχομένων</char> <char style="w" x-id="SBLGNT.3JN.1.3.005" x-align="3JN.1.3.a005" x-target-ids="t006" x-target="brethren" x-target-head="t006" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-GPM" x-gloss="of [the] brothers" x-translit="adelphōn" xml:lang="grc">ἀδελφῶν</char> <char style="w" x-id="SBLGNT.3JN.1.3.006" x-align="3JN.1.3.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.3JN.1.3.007" x-align="3JN.1.3.a007" x-target-ids="t009 t010" x-target="bare witness" x-target-head="t010" x-head="true" lemma="μαρτυρέω" strong="G3140" x-morph="V-PAP-GPM" x-gloss="bearing witness" x-translit="martyrountōn" xml:lang="grc">μαρτυρούντων</char> <char style="w" x-id="SBLGNT.3JN.1.3.008" x-align="3JN.1.3.a008" x-target-ids="t012" x-target="thy" x-target-head="t0