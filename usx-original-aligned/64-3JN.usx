	<para style="p"><verse number="11" style="v" x-ref="3JN.1.11" sid="3JN 1:11" /><char style="w" x-id="SBLGNT.3JN.1.11.001" x-align="3JN.1.11.a001" x-target-ids="t001" x-target="Beloved" x-target-head="t001" x-head="true" lemma="ἀγαπητός" strong="G27" x-morph="A-VSM" x-gloss="Beloved" x-translit="Agapēte" xml:lang="grc">Ἀγαπητέ</char>,<char style="w" x-id="SBLGNT.3JN.1.11.002" x-align="3JN.1.11.a002" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.3JN.1.11.003" x-align="3JN.1.11.a003" x-target-ids="t002" x-target="imitate" x-target-head="t002" x-head="true" lemma="μιμέομαι" strong="G3401" x-morph="V-PNM-2S" x-gloss="do imitate" x-translit="mimou" xml:lang="grc">μιμοῦ</char> <char style="w" x-id="SBLGNT.3JN.1.11.004" x-align="3JN.1.11.a004" x-target-ids="t004 t005" x-target="that which" x-target-head="t004" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="what [is]" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.3JN.1.11.005" x-align="3JN.1.11.a005" x-target-ids="t006 t007" x-target="is evil" x-target-head="t007" x-head="true" lemma="κακός" strong="G2556" x-morph="A-ASN" x-gloss="evil" x-translit="kakon" xml:lang="grc">κακὸν</char> <char style="w" x-id="SBLGNT.3JN.1.11.006" x-align="3JN.1.11.a006" x-target-ids="t008" x-target="but" x-target-head="t008" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.3JN.1.11.007" x-align="3JN.1.11.a007" x-target-ids="t009 t010" x-target="that which" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="what [is]" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.3JN.1.11.008" x-align="3JN.1.11.a008" x-target-ids="t011 t012" x-target="is good" x-target-head="t012" x-head="true" lemma="ἀγαθός" strong="G18" x-m