	<para style="p"><verse number="13" style="v" x-ref="3JN.1.13" sid="3JN 1:13" /><char style="w" x-id="SBLGNT.3JN.1.13.001" x-align="3JN.1.13.a001" x-target-ids="t003 t004 t015" x-target="many things them" x-target-italic-ids="t015" x-target-head="t003" x-head="true" lemma="πολύς" strong="G4183" x-morph="A-APN" x-gloss="Many things" x-translit="Polla" xml:lang="grc">Πολλὰ</char> <char style="w" x-id="SBLGNT.3JN.1.13.002" x-align="3JN.1.13.a002" x-target-ids="t001 t002" x-target="I had" x-target-head="t002" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-IAI-1S" x-gloss="I had" x-translit="eichon" xml:lang="grc">εἶχον</char> <char style="w" x-id="SBLGNT.3JN.1.13.003" x-align="3JN.1.13.a003" x-target-ids="t005 t006" x-target="to write" x-target-head="t006" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-AAN" x-gloss="to write" x-translit="grapsai" xml:lang="grc">γράψαι</char> <char style="w" x-id="SBLGNT.3JN.1.13.004" x-align="3JN.1.13.a004" x-target-ids="t007 t008" x-target="unto thee" x-target-head="t008" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="to you" x-translit="soi" xml:lang="grc">σοι</char>,<char style="w" x-id="SBLGNT.3JN.1.13.005" x-align="3JN.1.13.a005" x-target-ids="t009" x-target="but" x-target-head="t009" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.3JN.1.13.006" x-align="3JN.1.13.a006" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.3JN.1.13.007" x-align="3JN.1.13.a006" x-target-ids="t010 t011 t012" x-target="I am unwilling" x-target-head="t012" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-PAI-1S" x-gloss="I desire" x-translit="thelō" xml:lang="grc">θέλω</char> <char style="w" x-id="SBLGNT.3JN.1.13.008" x-align="3JN.1.13.a007" x-target-ids="t018" x-target="with" x-target-head="t018" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gl