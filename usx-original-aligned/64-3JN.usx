	<para style="p"><verse number="5" style="v" x-ref="3JN.1.5" sid="3JN 1:5" /><char style="w" x-id="SBLGNT.3JN.1.5.001" x-align="3JN.1.5.a001" x-target-ids="t001" x-target="Beloved" x-target-head="t001" x-head="true" lemma="ἀγαπητός" strong="G27" x-morph="A-VSM" x-gloss="Beloved" x-translit="Agapēte" xml:lang="grc">Ἀγαπητέ</char>,<char style="w" x-id="SBLGNT.3JN.1.5.002" x-align="3JN.1.5.a002" x-target-ids="t005" x-target="faithful" x-target-head="t005" x-head="true" lemma="πιστός" strong="G4103" x-morph="A-ASN" x-gloss="faithfully" x-translit="piston" xml:lang="grc">πιστὸν</char> <char style="w" x-id="SBLGNT.3JN.1.5.003" x-align="3JN.1.5.a003" x-target-ids="t002 t003 t004 t006" x-target="thou doest a work" x-target-head="t003" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-PAI-2S" x-gloss="you are doing" x-translit="poieis" xml:lang="grc">ποιεῖς</char> <char style="w" x-id="SBLGNT.3JN.1.5.004" x-align="3JN.1.5.a004" x-status="noncompositional" x-target-ids="t007 t008" x-target="in whatsoever" x-target-head="t008" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-ASN" x-gloss="whatever" x-translit="ho" xml:lang="grc">ὃ</char> <char style="w" x-id="SBLGNT.3JN.1.5.005" x-align="3JN.1.5.a004" x-status="noncompositional" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.3JN.1.5.006" x-align="3JN.1.5.a005" x-target-ids="t009 t010" x-target="thou doest" x-target-head="t010" x-head="true" lemma="ἐργάζομαι" strong="G2038" x-morph="V-ADS-2S" x-gloss="you might have done" x-translit="ergasēi" xml:lang="grc">ἐργάσῃ</char> <char style="w" x-id="SBLGNT.3JN.1.5.007" x-align="3JN.1.5.a006" x-target-ids="t011" x-target="toward" x-target-head="t011" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="toward" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.3JN.1.5.008" x-align="3JN.1.5.a007" x-target-ids="t012 t013 t014" x-target="them that are" x-target-head="t012