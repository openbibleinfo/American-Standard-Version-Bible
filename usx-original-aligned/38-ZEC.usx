	<para style="p"><verse number="1" style="v" x-ref="ZEC.14.1" sid="ZEC 14:1" /><char style="w" x-id="WLC.ZEC.14.1.001" x-align="ZEC.14.1.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֥ה</char> <char style="w" x-id="WLC.ZEC.14.1.002" x-align="ZEC.14.1.a002" x-target-ids="t002 t003" x-target="a day" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="a.day" x-translit="yôm-" xml:lang="hbo">יֽוֹם</char>־<char style="w" x-id="WLC.ZEC.14.1.003" x-align="ZEC.14.1.a003" x-target-ids="t006" x-target="cometh" x-target-head="t006" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqrmsa" x-gloss="[is].coming" x-translit="bāʾ" xml:lang="hbo">בָּ֖א</char> <char style="w" x-id="WLC.ZEC.14.1.004" x-align="ZEC.14.1.a004" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.ZEC.14.1.005" x-align="ZEC.14.1.a005" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֑ה</char> <char style="w" x-id="WLC.ZEC.14.1.006" x-align="ZEC.14.1.a006" x-target-ids="t007" x-target="when" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ZEC.14.1.007" x-align="ZEC.14.1.a007" x-target-ids="t010 t011 t012" x-target="shall be divided" x-target-head="t012" x-head="true" lemma="חָלַק" strong="H2505" x-morph="VPq3ms" x-gloss="it.will.be.divided" x-translit="ḥullaq" xml:lang="hbo">חֻלַּ֥ק</char> <char style="w" x-id="WLC.ZEC.14.1.008" x-align="ZEC.14.1.a008" x-target-ids="t009" x-target="spoil" x-target-head="t009" x-head="true" lemma="שָׁלָל" strong="H7998" x-morph="Ncmsc" x-gloss="plunder