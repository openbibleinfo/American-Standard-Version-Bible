	<para style="p"><verse number="8" style="v" x-ref="JON.2.8" sid="JON 2:8" /><char style="w" x-id="WLC.JON.2.8.001" x-align="JON.2.8.a001" x-target-ids="t001 t002 t003" x-target="They that regard" x-target-head="t003" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vprmpa" x-gloss="[those.who].pay.regard" x-translit="məšamməriym" xml:lang="hbo" x-source-ref="JON.2.9">מְשַׁמְּרִ֖ים</char> <char style="w" x-id="WLC.JON.2.8.002" x-align="JON.2.8.a002" x-target-ids="t005" x-target="vanities" x-target-head="t005" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmpc" x-gloss="vanities" x-translit="haḇlê-" xml:lang="hbo" x-source-ref="JON.2.9">הַבְלֵי</char>־<char style="w" x-id="WLC.JON.2.8.003" x-align="JON.2.8.a003" x-target-ids="t004" x-target="lying" x-target-head="t004" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="of.nothingness" x-translit="šāwəʾ" xml:lang="hbo" x-source-ref="JON.2.9">שָׁ֑וְא</char> <char style="w" x-id="WLC.JON.2.8.004" x-align="JON.2.8.a004" x-target-ids="t009" x-target="mercy" x-target-head="t009" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo" x-source-ref="JON.2.9">חַסְדָּ֖</char><char style="w" x-id="WLC.JON.2.8.005" x-align="JON.2.8.a005" x-target-ids="t007 t008" x-target="their own" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="JON.2.9">ם</char> <char style="w" x-id="WLC.JON.2.8.006" x-align="JON.2.8.a006" x-target-ids="t006" x-target="Forsake" x-target-head="t006" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqi3mp" x-gloss="they.abandon" x-translit="yaʿăzōḇû:" xml:lang="hbo" x-source-ref="JON.2.9">יַעֲזֹֽבוּ</char>׃<verse eid="JON 2:8" /></para>
