	<para style="p"><verse number="1" style="v" x-ref="JON.3.1" sid="JON 3:1" /><char style="w" x-id="WLC.JON.3.1.001" x-align="JON.3.1.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JON.3.1.002" x-align="JON.3.1.a002" x-target-ids="t006" x-target="came" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw3ms" x-gloss="it.came" x-translit="yəhiy" xml:lang="hbo">יְהִ֧י</char> <char style="w" x-id="WLC.JON.3.1.003" x-align="JON.3.1.a003" x-target-ids="t002 t003" x-target="the word" x-target-head="t003" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="the.word" x-translit="ḏəḇar-" xml:lang="hbo">דְבַר</char>־<char style="w" x-id="WLC.JON.3.1.004" x-align="JON.3.1.a004" x-target-ids="t004 t005" x-target="of Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֛ה</char> <char style="w" x-id="WLC.JON.3.1.005" x-align="JON.3.1.a005" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.JON.3.1.006" x-align="JON.3.1.a006" x-target-ids="t008" x-target="Jonah" x-target-head="t008" x-head="true" lemma="יוֹנָה" strong="H3124" x-morph="Np" x-gloss="Jonah" x-translit="yônāh" xml:lang="hbo">יוֹנָ֖ה</char> <char style="w" x-id="WLC.JON.3.1.007" x-align="JON.3.1.a007" x-target-ids="t009 t010 t011" x-target="the second time" x-target-head="t010" x-head="true" lemma="שֵׁנִי" strong="H8145" x-morph="Aofsa" x-gloss="a.second.[time]" x-translit="šēniyṯ" xml:lang="hbo">שֵׁנִ֥ית</char> <char style="w" x-id="WLC.JON.3.1.008" x-align="JON.3.1.a008" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(cmp)" x-translit="lē" xml:lang="hbo">לֵ</char>