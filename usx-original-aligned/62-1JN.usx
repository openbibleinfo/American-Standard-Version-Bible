	<para style="p"><verse number="13" style="v" x-ref="1JN.2.13" x-added-alignments="1JN.2.13.a016" x-added-target-ids="t028 t029 t030 t031 t032 t033 t034 t035 t036 t037 t038 t039" x-added-target="I have written unto you little children because ye know the Father" sid="1JN 2:13" /><char style="w" x-id="SBLGNT.1JN.2.13.001" x-align="1JN.2.13.a001" x-target-ids="t001 t002" x-target="I write" x-target-head="t002" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-PAI-1S" x-gloss="I am writing" x-translit="graphō" xml:lang="grc">γράφω</char> <char style="w" x-id="SBLGNT.1JN.2.13.002" x-align="1JN.2.13.a002" x-target-ids="t003 t004" x-target="unto you" x-target-head="t004" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char>,<char style="w" x-id="SBLGNT.1JN.2.13.003" x-align="1JN.2.13.a003" x-target-ids="t005" x-target="fathers" x-target-head="t005" x-head="true" lemma="πατήρ" strong="G3962" x-morph="N-VPM" x-gloss="fathers" x-translit="pateres" xml:lang="grc">πατέρες</char>,<char style="w" x-id="SBLGNT.1JN.2.13.004" x-align="1JN.2.13.a004" x-target-ids="t006" x-target="because" x-target-head="t006" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="because" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.1JN.2.13.005" x-align="1JN.2.13.a005" x-target-ids="t007 t008" x-target="ye know" x-target-head="t008" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-RAI-2P" x-gloss="you have known" x-translit="egnōkate" xml:lang="grc">ἐγνώκατε</char> <char style="w" x-id="SBLGNT.1JN.2.13.006" x-align="1JN.2.13.a006" x-target-ids="t009 t010" x-target="him who" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="Him who [is]" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.1JN.2.13.007" x-align="1JN.2.13.a007" x-target-ids="t011 t012" x-target="is from" x-target-head="t012" x-head="true" lemma="ἀπό" strong="G575" x-mo