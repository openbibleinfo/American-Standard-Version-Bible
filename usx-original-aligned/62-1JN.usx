	<para style="p"><verse number="15" style="v" x-ref="1JN.5.15" sid="1JN 5:15" /><char style="w" x-id="SBLGNT.1JN.5.15.001" x-align="1JN.5.15.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1JN.5.15.002" x-align="1JN.5.15.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.1JN.5.15.003" x-align="1JN.5.15.a003" x-target-ids="t003 t004" x-target="we know" x-target-head="t004" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAI-1P" x-gloss="we know" x-translit="oidamen" xml:lang="grc">οἴδαμεν</char> <char style="w" x-id="SBLGNT.1JN.5.15.004" x-align="1JN.5.15.a004" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.1JN.5.15.005" x-align="1JN.5.15.a005" x-target-ids="t006 t007" x-target="he heareth" x-target-head="t007" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-PAI-3S" x-gloss="He hears" x-translit="akouei" xml:lang="grc">ἀκούει</char> <char style="w" x-id="SBLGNT.1JN.5.15.006" x-align="1JN.5.15.a006" x-target-ids="t008" x-target="us" x-target-head="t008" x-head="true" lemma="ἐγώ" strong="G2257" x-morph="P-1GP" x-gloss="us" x-translit="hēmōn" xml:lang="grc">ἡμῶν</char> <char style="w" x-id="SBLGNT.1JN.5.15.007" x-align="1JN.5.15.a007" x-target-ids="t009" x-target="whatsoever" x-target-head="t009" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-ASN" x-gloss="whatever" x-translit="ho" xml:lang="grc">ὃ</char> <char style="w" x-id="SBLGNT.1JN.5.15.008" x-align="1JN.5.15.a007" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.1JN.5.15