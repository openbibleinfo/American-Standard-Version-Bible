	<para style="p"><verse number="1" style="v" x-ref="1JN.2.1" sid="1JN 2:1" /><char style="w" x-id="SBLGNT.1JN.2.1.001" x-align="1JN.2.1.a001" x-target-ids="t002 t003" x-target="little children" x-target-head="t003" x-head="true" lemma="τεκνίον" strong="G5040" x-morph="N-VPN" x-gloss="Little children" x-translit="Teknia" xml:lang="grc">Τεκνία</char> <char style="w" x-id="SBLGNT.1JN.2.1.002" x-align="1JN.2.1.a002" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of me" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.1JN.2.1.003" x-align="1JN.2.1.a003" x-target-ids="t004 t005" x-target="these things" x-target-head="t004" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="these things" x-translit="tauta" xml:lang="grc">ταῦτα</char> <char style="w" x-id="SBLGNT.1JN.2.1.004" x-align="1JN.2.1.a004" x-target-ids="t006 t007" x-target="write I" x-target-head="t006" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-PAI-1S" x-gloss="I am writing" x-translit="graphō" xml:lang="grc">γράφω</char> <char style="w" x-id="SBLGNT.1JN.2.1.005" x-align="1JN.2.1.a005" x-target-ids="t008 t009" x-target="unto you" x-target-head="t009" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.1JN.2.1.006" x-align="1JN.2.1.a006" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.1JN.2.1.007" x-align="1JN.2.1.a007" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.1JN.2.1.008" x-align="1JN.2.1.a008" x-target-ids="t011 t012 t014" x-target="ye may sin" x-target-head="t014" x-head="true" lemma="ἁμαρτ