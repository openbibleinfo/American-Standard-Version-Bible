	<para style="p"><verse number="3" style="v" x-ref="1JN.2.3" sid="1JN 2:3" /><char style="w" x-id="SBLGNT.1JN.2.3.001" x-align="1JN.2.3.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.1JN.2.3.002" x-align="1JN.2.3.a002" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="by" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1JN.2.3.003" x-align="1JN.2.3.a002" x-target-ids="t002" x-target="hereby" x-target-head="t002" x-head="true" lemma="οὗτος" strong="G5129" x-morph="D-DSN" x-gloss="this" x-translit="toutōi" xml:lang="grc">τούτῳ</char> <char style="w" x-id="SBLGNT.1JN.2.3.004" x-align="1JN.2.3.a003" x-target-ids="t003 t004" x-target="we know" x-target-head="t004" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-PAI-1P" x-gloss="we know" x-translit="ginōskomen" xml:lang="grc">γινώσκομεν</char> <char style="w" x-id="SBLGNT.1JN.2.3.005" x-align="1JN.2.3.a004" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.1JN.2.3.006" x-align="1JN.2.3.a005" x-target-ids="t006 t007" x-target="we know" x-target-head="t007" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-RAI-1P" x-gloss="we have come to know" x-translit="egnōkamen" xml:lang="grc">ἐγνώκαμεν</char> <char style="w" x-id="SBLGNT.1JN.2.3.007" x-align="1JN.2.3.a006" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτόν</char>,<char style="w" x-id="SBLGNT.1JN.2.3.008" x-align="1JN.2.3.a007" x-target-ids="t009" x-target="if" x-target-head="t009" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBL