	<para style="p"><verse number="2" style="v" x-ref="ACT.1.2" sid="ACT 1:2" /><char style="w" x-id="SBLGNT.ACT.1.2.001" x-align="ACT.1.2.a001" x-target-ids="t001" x-target="until" x-target-head="t001" x-head="true" lemma="ἄχρι" strong="G891" x-morph="ADV" x-gloss="until" x-translit="achri" xml:lang="grc">ἄχρι</char> <char style="w" x-id="SBLGNT.ACT.1.2.002" x-align="ACT.1.2.a002" x-target-ids="t004 t005" x-target="in which" x-target-head="t005" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-GSF" x-gloss="the" x-translit="hēs" xml:lang="grc">ἧς</char> <char style="w" x-id="SBLGNT.ACT.1.2.003" x-align="ACT.1.2.a003" x-target-ids="t002 t003" x-target="the day" x-target-head="t003" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-GSF" x-gloss="day" x-translit="hēmeras" xml:lang="grc">ἡμέρας</char> <char style="w" x-id="SBLGNT.ACT.1.2.004" x-align="ACT.1.2.a004" x-target-ids="t010 t011 t012 t013 t014 t015" x-target="after that he had given commandment" x-target-head="t015" x-head="true" lemma="ἐντέλλομαι" strong="G1781" x-morph="V-ANP-NSM" x-gloss="having given orders" x-translit="enteilamenos" xml:lang="grc">ἐντειλάμενος</char> <char style="w" x-id="SBLGNT.ACT.1.2.005" x-align="ACT.1.2.a005" x-target-ids="t020 t021" x-target="unto the" x-target-head="t021" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM" x-gloss="to the" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.ACT.1.2.006" x-align="ACT.1.2.a006" x-target-ids="t022" x-target="apostles" x-target-head="t022" x-head="true" lemma="ἀπόστολος" strong="G652" x-morph="N-DPM" x-gloss="apostles" x-translit="apostolois" xml:lang="grc">ἀποστόλοις</char> <char style="w" x-id="SBLGNT.ACT.1.2.007" x-align="ACT.1.2.a007" x-target-ids="t016" x-target="through" x-target-head="t016" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="by" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.ACT.1.2.008" x-align="ACT.1.2.a008" x-target-ids="t017 t019" x-target="t