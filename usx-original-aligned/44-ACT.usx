	<para style="p"><verse number="33" style="v" x-ref="ACT.5.33" sid="ACT 5:33" /><char style="w" x-id="SBLGNT.ACT.5.33.001" x-align="ACT.5.33.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="Hoi" xml:lang="grc">Οἱ</char> <char style="w" x-id="SBLGNT.ACT.5.33.002" x-align="ACT.5.33.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.ACT.5.33.003" x-align="ACT.5.33.a003" x-target-ids="t003 t004 t005 t006" x-target="when they heard this" x-target-head="t005" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="having heard" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.ACT.5.33.004" x-align="ACT.5.33.a004" x-target-ids="t007 t008 t009 t010 t011" x-target="were cut to the heart" x-target-head="t008" x-head="true" lemma="διαπρίομαι" strong="G1282" x-morph="V-IPI-3P" x-gloss="they were cut [to the heart]" x-translit="dieprionto" xml:lang="grc">διεπρίοντο</char> <char style="w" x-id="SBLGNT.ACT.5.33.005" x-align="ACT.5.33.a005" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.ACT.5.33.006" x-align="ACT.5.33.a006" x-target-ids="t013 t014" x-target="were minded" x-target-head="t014" x-head="true" lemma="βούλομαι" strong="G1014" x-morph="V-INI-3P" x-gloss="were desiring" x-translit="eboulonto" xml:lang="grc">ἐβούλοντο</char> <char style="w" x-id="SBLGNT.ACT.5.33.007" x-align="ACT.5.33.a007" x-target-ids="t015 t016" x-target="to slay" x-target-head="t016" x-head="true" lemma="ἀναιρέω" strong="G337" x-morph="V-2AAN" x-gloss="to put to death" x-translit="anelein" xml:lang="grc">ἀνελεῖν</char> <char style="w" x-id="SBLGNT.ACT.5.33.008" x-al