	<para style="p"><verse number="6" style="v" x-ref="MIC.7.6" sid="MIC 7:6" /><char style="w" x-id="WLC.MIC.7.6.001" x-align="MIC.7.6.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.MIC.7.6.002" x-align="MIC.7.6.a002" x-target-ids="t002 t003" x-target="the son" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="a.son" x-translit="ḇēn" xml:lang="hbo">בֵן֙</char> <char style="w" x-id="WLC.MIC.7.6.003" x-align="MIC.7.6.a003" x-target-ids="t004" x-target="dishonoreth" x-target-head="t004" x-head="true" lemma="נָבַל" strong="H5034a" x-morph="Vprmsa" x-gloss="[is].treating.with.contempt" x-translit="mənabbēl" xml:lang="hbo">מְנַבֵּ֣ל</char> <char style="w" x-id="WLC.MIC.7.6.004" x-align="MIC.7.6.a004" x-target-ids="t005 t006" x-target="the father" x-target-head="t006" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsa" x-gloss="a.father" x-translit="ʾāḇ" xml:lang="hbo">אָ֔ב</char> <char style="w" x-id="WLC.MIC.7.6.005" x-align="MIC.7.6.a005" x-target-ids="t007 t008" x-target="the daughter" x-target-head="t008" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfsa" x-gloss="a.daughter" x-translit="baṯ" xml:lang="hbo">בַּ֚ת</char> <char style="w" x-id="WLC.MIC.7.6.006" x-align="MIC.7.6.a006" x-target-ids="t009 t010" x-target="riseth up" x-target-head="t009" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqrfsa" x-gloss="[is].arising" x-translit="qāmāh" xml:lang="hbo">קָמָ֣ה</char> <char style="w" x-id="WLC.MIC.7.6.007" x-align="MIC.7.6.a007" x-target-ids="t011" x-target="against" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.MIC.7.6.008" x-align="MIC.7.6.a008" x-target-ids="t013" x-target="mother" x-target-head="t013" x-head="true" lemma="אֵם" strong="H517" x-morph="Ncfsc"