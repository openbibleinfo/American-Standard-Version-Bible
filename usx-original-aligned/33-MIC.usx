	<para style="p"><verse number="18" style="v" x-ref="MIC.7.18" sid="MIC 7:18" /><char style="w" x-id="WLC.MIC.7.18.001" x-align="MIC.7.18.a001" x-target-ids="t001" x-target="Who" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="mî-" xml:lang="hbo">מִי</char>־<char style="w" x-id="WLC.MIC.7.18.002" x-align="MIC.7.18.a002" x-target-ids="t002 t003 t004" x-target="is a God" x-target-head="t004" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="[is].a.God" x-translit="ʾēl" xml:lang="hbo">אֵ֣ל</char> <char style="w" x-id="WLC.MIC.7.18.003" x-align="MIC.7.18.a003" x-target-ids="t005 t006" x-target="like unto" x-target-head="t005" x-head="true" lemma="כְּמוֹ" strong="H3644" x-morph="R" x-gloss="like" x-translit="kāmô" xml:lang="hbo">כָּמ֗וֹ</char><char style="w" x-id="WLC.MIC.7.18.004" x-align="MIC.7.18.a004" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.MIC.7.18.005" x-align="MIC.7.18.a005" x-target-ids="t008 t009" x-target="that pardoneth" x-target-head="t009" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqrmsa" x-gloss="[who].forgives" x-translit="nōśēʾ" xml:lang="hbo">נֹשֵׂ֤א</char> <char style="w" x-id="WLC.MIC.7.18.006" x-align="MIC.7.18.a006" x-target-ids="t010" x-target="iniquity" x-target-head="t010" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsa" x-gloss="iniquity" x-translit="ʿāwōn" xml:lang="hbo">עָוֺן֙</char> <char style="w" x-id="WLC.MIC.7.18.007" x-align="MIC.7.18.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[who]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.MIC.7.18.008" x-align="MIC.7.18.a008" x-target-ids="t012" x-target="passeth" x-target-head="t012" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqrmsa" x-gloss="