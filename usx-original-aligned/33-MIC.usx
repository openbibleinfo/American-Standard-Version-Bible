	<para style="p"><verse number="19" style="v" x-ref="MIC.7.19" sid="MIC 7:19" /><char style="w" x-id="WLC.MIC.7.19.001" x-align="MIC.7.19.a001" x-target-ids="t003" x-target="again" x-target-head="t003" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi3ms" x-gloss="he.will.return" x-translit="yāšûḇ" xml:lang="hbo">יָשׁ֣וּב</char> <char style="w" x-id="WLC.MIC.7.19.002" x-align="MIC.7.19.a002" x-target-ids="t001 t002 t004 t005 t006" x-target="He will have compassion upon" x-target-head="t005" x-head="true" lemma="רָחַם" strong="H7355" x-morph="Vpi3ms" x-gloss="he" x-translit="yəraḥăm" xml:lang="hbo">יְרַֽחֲמֵ֔</char><char style="w" x-id="WLC.MIC.7.19.003" x-align="MIC.7.19.a003" x-target-ids="t007" x-target="us" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="will.have.compassion.on.us" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.MIC.7.19.004" x-align="MIC.7.19.a004" x-target-ids="t008 t009 t010 t013 t014" x-target="he will tread under foot" x-target-head="t010" x-head="true" lemma="כָּבַשׁ" strong="H3533" x-morph="Vqi3ms" x-gloss="he.will.subdue" x-translit="yiḵbōš" xml:lang="hbo">יִכְבֹּ֖שׁ</char> <char style="w" x-id="WLC.MIC.7.19.005" x-align="MIC.7.19.a005" x-target-ids="t012" x-target="iniquities" x-target-head="t012" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbpc" x-gloss="iniquities" x-translit="ʿăônōṯēy" xml:lang="hbo">עֲוֺֽנֹתֵ֑י</char><char style="w" x-id="WLC.MIC.7.19.006" x-align="MIC.7.19.a006" x-target-ids="t011" x-target="our" x-target-head="t011" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.MIC.7.19.007" x-align="MIC.7.19.a007" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.MIC.7.19.008" x-align="MIC.7.19.a008" x-target-ids="t016 t017 t