	<para style="p"><verse number="14" style="v" x-ref="MIC.6.14" sid="MIC 6:14" /><char style="w" x-id="WLC.MIC.6.14.001" x-align="MIC.6.14.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֤ה</char> <char style="w" x-id="WLC.MIC.6.14.002" x-align="MIC.6.14.a002" x-target-ids="t002 t003" x-target="shalt eat" x-target-head="t003" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqi2ms" x-gloss="you.will.eat" x-translit="ṯōʾḵal" xml:lang="hbo">תֹאכַל֙</char> <char style="w" x-id="WLC.MIC.6.14.003" x-align="MIC.6.14.a003" x-target-ids="t004" x-target="but" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.MIC.6.14.004" x-align="MIC.6.14.a004" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.MIC.6.14.005" x-align="MIC.6.14.a005" x-target-ids="t006 t007" x-target="be satisfied" x-target-head="t007" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqi2ms" x-gloss="you.will.be.satisfied" x-translit="ṯiśbāʿ" xml:lang="hbo">תִשְׂבָּ֔ע</char> <char style="w" x-id="WLC.MIC.6.14.006" x-align="MIC.6.14.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.MIC.6.14.007" x-align="MIC.6.14.a007" x-target-ids="t010" x-target="humiliation" x-target-head="t010" x-head="true" lemma="יֶשַׁח" strong="H3445" x-morph="Ncmsc" x-gloss="emptiness" x-translit="yešḥ" xml:lang="hbo">יֶשְׁחֲ</char><char style="w" x-id="WLC.MIC.6.14.008" x-align="MIC.6.14.a008" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you