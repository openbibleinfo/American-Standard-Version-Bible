	<para style="p"><verse number="3" style="v" x-ref="MIC.1.3" sid="MIC 1:3" /><char style="w" x-id="WLC.MIC.1.3.001" x-align="MIC.1.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.MIC.1.3.002" x-align="MIC.1.3.a002" x-target-ids="t002" x-target="behold" x-target-head="t002" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֥ה</char> <char style="w" x-id="WLC.MIC.1.3.003" x-align="MIC.1.3.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.MIC.1.3.004" x-align="MIC.1.3.a004" x-target-ids="t004 t005" x-target="cometh forth" x-target-head="t004" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqrmsa" x-gloss="[is].about.to.go.forth" x-translit="yōṣēʾ" xml:lang="hbo">יֹצֵ֣א</char> <char style="w" x-id="WLC.MIC.1.3.005" x-align="MIC.1.3.a005" x-target-ids="t006 t007" x-target="out of" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.MIC.1.3.006" x-align="MIC.1.3.a006" x-target-ids="t009" x-target="place" x-target-head="t009" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsc" x-gloss="place" x-translit="mməqôm" xml:lang="hbo">מְּקוֹמ֑</char><char style="w" x-id="WLC.MIC.1.3.007" x-align="MIC.1.3.a007" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.MIC.1.3.008" x-align="MIC.1.3.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ