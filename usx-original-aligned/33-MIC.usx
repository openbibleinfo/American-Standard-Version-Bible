	<para style="p"><verse number="3" style="v" x-ref="MIC.6.3" sid="MIC 6:3" /><char style="w" x-id="WLC.MIC.6.3.001" x-align="MIC.6.3.a001" x-target-ids="t001 t003" x-target="O people" x-target-head="t003" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="my.people" x-translit="ʿamm" xml:lang="hbo">עַמִּ֛</char><char style="w" x-id="WLC.MIC.6.3.002" x-align="MIC.6.3.a002" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.MIC.6.3.003" x-align="MIC.6.3.a003" x-target-ids="t004" x-target="what" x-target-head="t004" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="meh-" xml:lang="hbo">מֶה</char>־<char style="w" x-id="WLC.MIC.6.3.004" x-align="MIC.6.3.a004" x-target-ids="t005 t006 t007" x-target="have I done" x-target-head="t007" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp1cs" x-gloss="have.I.done" x-translit="ʿāśiyṯî" xml:lang="hbo">עָשִׂ֥יתִי</char> <char style="w" x-id="WLC.MIC.6.3.005" x-align="MIC.6.3.a005" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.MIC.6.3.006" x-align="MIC.6.3.a006" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.MIC.6.3.007" x-align="MIC.6.3.a007" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.MIC.6.3.008" x-align="MIC.6.3.a008" x-target-ids="t011" x-target="wherein" x-target-head="t011" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh" xml:lang="hbo">מָ֣ה</char> <char style="w" x-