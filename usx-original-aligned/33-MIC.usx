	<para style="p"><verse number="2" style="v" x-ref="MIC.1.2" sid="MIC 1:2" /><char style="w" x-id="WLC.MIC.1.2.001" x-align="MIC.1.2.a001" x-target-ids="t001 t002" x-target="Hear ye" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="hear" x-translit="šimʿû" xml:lang="hbo">שִׁמְעוּ֙</char> <char style="w" x-id="WLC.MIC.1.2.002" x-align="MIC.1.2.a002" x-target-ids="t003" x-target="peoples" x-target-head="t003" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmpa" x-gloss="O.peoples" x-translit="ʿammiym" xml:lang="hbo">עַמִּ֣ים</char> <char style="w" x-id="WLC.MIC.1.2.003" x-align="MIC.1.2.a003" x-target-ids="t004" x-target="all" x-target-head="t004" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.them" x-translit="kull" xml:lang="hbo">כֻּלָּ֔</char><char style="w" x-id="WLC.MIC.1.2.004" x-align="MIC.1.2.a004" x-target-ids="t005 t006" x-target="of you" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="all" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.MIC.1.2.005" x-align="MIC.1.2.a005" x-target-ids="t007" x-target="hearken" x-target-head="t007" x-head="true" lemma="קָשַׁב" strong="H7181" x-morph="Vhv2fs" x-gloss="pay.attention" x-translit="haqšiyḇî" xml:lang="hbo">הַקְשִׁ֖יבִי</char> <char style="w" x-id="WLC.MIC.1.2.006" x-align="MIC.1.2.a006" x-target-ids="t008 t009" x-target="O earth" x-target-head="t009" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="O.earth" x-translit="ʾereṣ" xml:lang="hbo">אֶ֣רֶץ</char> <char style="w" x-id="WLC.MIC.1.2.007" x-align="MIC.1.2.a007" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.MIC.1.2.008" x-align="MIC.1.2.a008" x-target-ids="t011" x-target="all" x-target-head="t011" x-head="true" lemma="מְלֹא" strong="H4393" x-morph="Ncmsc" x-gloss="what" x-trans