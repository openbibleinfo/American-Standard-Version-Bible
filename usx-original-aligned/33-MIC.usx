	<para style="p"><verse number="1" style="v" x-ref="MIC.5.1" sid="MIC 5:1" /><char style="w" x-id="WLC.MIC.5.1.001" x-align="MIC.5.1.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo" x-source-ref="MIC.4.14">עַתָּה֙</char> <char style="w" x-id="WLC.MIC.5.1.002" x-align="MIC.5.1.a002" x-target-ids="t002 t003 t004 t005 t006 t007" x-target="shalt thou gather thyself in troops" x-target-head="t004" x-head="true" lemma="גָּדַד" strong="H1413a" x-morph="Vri2fs" x-gloss="you.will.cut.yourself" x-translit="tiṯgōḏəḏiy" xml:lang="hbo" x-source-ref="MIC.4.14">תִּתְגֹּדְדִ֣י</char> <char style="w" x-id="WLC.MIC.5.1.003" x-align="MIC.5.1.a003" x-target-ids="t008 t009" x-target="O daughter" x-target-head="t009" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfsc" x-gloss="O.daughter" x-translit="ḇaṯ-" xml:lang="hbo" x-source-ref="MIC.4.14">בַת</char>־<char style="w" x-id="WLC.MIC.5.1.004" x-align="MIC.5.1.a004" x-target-ids="t010 t011" x-target="of troops" x-target-head="t011" x-head="true" lemma="גְּדוּד" strong="H1416" x-morph="Ncmsa" x-gloss="of.troop[s]" x-translit="gəḏûḏ" xml:lang="hbo" x-source-ref="MIC.4.14">גְּד֔וּד</char> <char style="w" x-id="WLC.MIC.5.1.005" x-align="MIC.5.1.a005" x-target-ids="t015" x-target="siege" x-target-head="t015" x-head="true" lemma="מָצוֹר" strong="H4692" x-morph="Ncmsa" x-gloss="a.siege" x-translit="māṣôr" xml:lang="hbo" x-source-ref="MIC.4.14">מָצ֖וֹר</char> <char style="w" x-id="WLC.MIC.5.1.006" x-align="MIC.5.1.a006" x-target-ids="t012 t013 t014" x-target="he hath laid" x-target-head="t014" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqp3ms" x-gloss="someone.has.set" x-translit="śām" xml:lang="hbo" x-source-ref="MIC.4.14">שָׂ֣ם</char> <char style="w" x-id="WLC.MIC.5.1.007" x-align="MIC.5.1.a007" x-target-ids="t016" x-target="against" x-target-head="t016" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss