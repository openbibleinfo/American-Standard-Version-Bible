	<para style="p"><verse number="10" style="v" x-ref="MIC.1.10" x-added-alignments="MIC.1.10.a002" x-added-target-ids="t002" x-added-target="it" sid="MIC 1:10" /><char style="w" x-id="WLC.MIC.1.10.001" x-align="MIC.1.10.a004" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.MIC.1.10.002" x-align="MIC.1.10.a005" x-target-ids="t005" x-target="Gath" x-target-head="t005" x-head="true" lemma="גַּת" strong="H1661" x-morph="Np" x-gloss="Gath" x-translit="ḡaṯ" xml:lang="hbo">גַת֙</char> <char style="w" x-id="WLC.MIC.1.10.003" x-align="MIC.1.10.a003" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.MIC.1.10.004" x-align="MIC.1.10.a001" x-target-ids="t001" x-target="Tell" x-target-head="t001" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhj2mp" x-gloss="tell" x-translit="taggiyḏû" xml:lang="hbo">תַּגִּ֔ידוּ</char> <char style="w" x-id="WLC.MIC.1.10.005" x-align="MIC.1.10.a008" x-target-ids="t008 t009" x-target="at all" x-target-head="t009" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqa" x-gloss="at.all.(weep)" x-translit="bāḵô" xml:lang="hbo">בָּכ֖וֹ</char> <char style="w" x-id="WLC.MIC.1.10.006" x-align="MIC.1.10.a007" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.MIC.1.10.007" x-align="MIC.1.10.a006" x-target-ids="t006" x-target="weep" x-target-head="t006" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqj2mp" x-gloss="weep" x-translit="tiḇkû" xml:lang="hbo">תִּבְכּ֑וּ</char> <char style="w" x-id="WLC.MIC.1.10.008" x-align="MIC.1.10.a009" x-target-ids="t010" x-target="at" x-target-head="t010" x-head="true" lemma="בְּ" strong