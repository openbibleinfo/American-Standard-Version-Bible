	<para style="p"><verse number="5" style="v" x-ref="MIC.1.5" sid="MIC 1:5" /><char style="w" x-id="WLC.MIC.1.5.001" x-align="MIC.1.5.a001" x-target-ids="t001 t006" x-target="For is" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].for" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.MIC.1.5.002" x-align="MIC.1.5.a002" x-target-ids="t002 t003" x-target="the transgression" x-target-head="t003" x-head="true" lemma="פֶּשַׁע" strong="H6588" x-morph="Ncmsc" x-gloss="the.transgression" x-translit="p̄ešaʿ" xml:lang="hbo">פֶ֤שַׁע</char> <char style="w" x-id="WLC.MIC.1.5.003" x-align="MIC.1.5.a003" x-target-ids="t004 t005" x-target="of Jacob" x-target-head="t005" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="of.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַֽעֲקֹב֙</char> <char style="w" x-id="WLC.MIC.1.5.004" x-align="MIC.1.5.a004" x-target-ids="t007" x-target="all" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.MIC.1.5.005" x-align="MIC.1.5.a005" x-target-ids="t008" x-target="this" x-target-head="t008" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֔את</char> <char style="w" x-id="WLC.MIC.1.5.006" x-align="MIC.1.5.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.MIC.1.5.007" x-align="MIC.1.5.a007" x-target-ids="t010" x-target="for" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="for" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.MIC.1.5.008" x-align="MIC.1.5.a008" x-target-ids="t011 t012" x-target="the sins" x-target-head="t012" x-head="true" lemma="חַטָּאת" strong="H2403" x-morph="Ncfpc" x-gloss="the.sins" x-translit="ḥaṭṭōʾwṯ