	<para style="p"><verse number="11" style="v" x-ref="NUM.19.11" sid="NUM 19:11" /><char style="w" x-id="WLC.NUM.19.11.001" x-align="NUM.19.11.a001" x-target-ids="t001 t002" x-target="He that" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.[one" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.NUM.19.11.002" x-align="NUM.19.11.a002" x-target-ids="t003" x-target="toucheth" x-target-head="t003" x-head="true" lemma="נָגַע" strong="H5060" x-morph="Vqrmsa" x-gloss="who].touches" x-translit="nnōḡēᵃʿ" xml:lang="hbo">נֹּגֵ֥עַ</char> <char style="w" x-id="WLC.NUM.19.11.003" x-align="NUM.19.11.a003" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in).a" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.19.11.004" x-align="NUM.19.11.a004" x-target-ids="t004 t005 t006" x-target="the dead body" x-target-head="t005" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqrmsa" x-gloss="dead.[body]" x-translit="mēṯ" xml:lang="hbo">מֵ֖ת</char> <char style="w" x-id="WLC.NUM.19.11.005" x-align="NUM.19.11.a005" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.NUM.19.11.006" x-align="NUM.19.11.a006" x-target-ids="t008" x-target="any" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.NUM.19.11.007" x-align="NUM.19.11.a007" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsa" x-gloss="corpse" x-translit="nep̄eš" xml:lang="hbo">נֶ֣פֶשׁ</char> <char style="w" x-id="WLC.NUM.19.11.008" x-align="NUM.19.11.a007" x-target-ids="t009" x-target="man" x-target-head="t009" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֑ם</char> <char style="w" x-id="WLC.NUM.19.11.009" x-alig