	<para style="p"><verse number="21" style="v" x-ref="NUM.15.21" sid="NUM 15:21" /><char style="w" x-id="WLC.NUM.15.21.001" x-align="NUM.15.21.a001" x-target-ids="t001" x-target="Of" x-target-head="t001" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="some" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.NUM.15.21.002" x-align="NUM.15.21.a002" x-target-ids="t002 t003" x-target="the first" x-target-head="t003" x-head="true" lemma="רֵאשִׁית" strong="H7225" x-morph="Ncfsc" x-gloss="of.the.first" x-translit="rēʾšîṯ" xml:lang="hbo">רֵאשִׁית֙</char> <char style="w" x-id="WLC.NUM.15.21.003" x-align="NUM.15.21.a003" x-target-ids="t004 t006" x-target="of dough" x-target-head="t006" x-head="true" lemma="עֲרִיסָה" strong="H6182" x-morph="Ncfpc" x-gloss="your.dough(s)" x-translit="ʿărisōṯēy" xml:lang="hbo">עֲרִסֹ֣תֵי</char><char style="w" x-id="WLC.NUM.15.21.004" x-align="NUM.15.21.a004" x-target-ids="t005" x-target="your" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶ֔ם</char> <char style="w" x-id="WLC.NUM.15.21.005" x-align="NUM.15.21.a005" x-target-ids="t007 t008 t009" x-target="ye shall give" x-target-head="t009" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi2mp" x-gloss="you.will.give" x-translit="tittənû" xml:lang="hbo">תִּתְּנ֥וּ</char> <char style="w" x-id="WLC.NUM.15.21.006" x-align="NUM.15.21.a006" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.NUM.15.21.007" x-align="NUM.15.21.a007" x-target-ids="t011" x-target="Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֖ה</char> <char style="w" x-id="WLC.NUM.15.21.008" x-align="NUM.15.21.a008" x-target-ids="t012 t013 t014" x-target="a heave offering" x-target-head="t013" x-hea