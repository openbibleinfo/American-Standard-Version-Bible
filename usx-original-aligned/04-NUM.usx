	<para style="p"><verse number="10" style="v" x-ref="NUM.28.10" sid="NUM 28:10" /><char style="w" x-id="WLC.NUM.28.10.001" x-align="NUM.28.10.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="this is the burnt offering" x-target-head="t004" x-head="true" lemma="עֹלָה" strong="H5930" x-morph="Ncfsc" x-gloss="the.burnt.offering" x-translit="ʿōlaṯ" xml:lang="hbo">עֹלַ֥ת</char> <char style="w" x-id="WLC.NUM.28.10.002" x-align="NUM.28.10.a002" x-target-ids="t006 t008" x-target="of sabbath" x-target-head="t008" x-head="true" lemma="שַׁבָּת" strong="H7676" x-morph="Ncbsc" x-gloss="of.the.sabbath" x-translit="šabbaṯ" xml:lang="hbo">שַׁבַּ֖ת</char> <char style="w" x-id="WLC.NUM.28.10.003" x-align="NUM.28.10.a003" x-target-ids="t007" x-target="every" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.28.10.004" x-align="NUM.28.10.a004" x-status="unrepresented" x-head="true" lemma="שַׁבָּת" strong="H7676" x-morph="Ncbsc" x-gloss="sabbath" x-translit="šabbatt" xml:lang="hbo">שַׁבַּתּ֑</char><char style="w" x-id="WLC.NUM.28.10.005" x-align="NUM.28.10.a005" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.NUM.28.10.006" x-align="NUM.28.10.a006" x-target-ids="t009" x-target="besides" x-target-head="t009" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="[is].to" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.NUM.28.10.007" x-align="NUM.28.10.a007" x-target-ids="t012 t013" x-target="burnt offering" x-target-head="t012" x-head="true" lemma="עֹלָה" strong="H5930" x-morph="Ncfsc" x-gloss="the.burnt.offering" x-translit="ʿōlaṯ" xml:lang="hbo">עֹלַ֥ת</char> <char style="w" x-id="WLC.NUM.28.10.008" x-align="NUM.28.10.a008" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td