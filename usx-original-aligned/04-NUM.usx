	<para style="p"><verse number="20" style="v" x-ref="NUM.23.20" x-added-alignments="NUM.23.20.a004" x-added-target-ids="t005" x-added-target="commandment" sid="NUM 23:20" /><char style="w" x-id="WLC.NUM.23.20.001" x-align="NUM.23.20.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֥ה</char> <char style="w" x-id="WLC.NUM.23.20.002" x-align="NUM.23.20.a002" x-target-ids="t006 t007" x-target="to bless" x-target-head="t007" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpa" x-gloss="to.bless" x-translit="ḇārēḵ" xml:lang="hbo">בָרֵ֖ךְ</char> <char style="w" x-id="WLC.NUM.23.20.003" x-align="NUM.23.20.a003" x-target-ids="t002 t003 t004" x-target="I have received" x-target-head="t004" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqp1cs" x-gloss="I.have.received" x-translit="lāqāḥətî" xml:lang="hbo">לָקָ֑חְתִּי</char> <char style="w" x-id="WLC.NUM.23.20.004" x-align="NUM.23.20.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.NUM.23.20.005" x-align="NUM.23.20.a006" x-target-ids="t009 t010 t011" x-target="he hath blessed" x-target-head="t011" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpp3ms" x-gloss="he.has.blessed" x-translit="ḇērēḵ" xml:lang="hbo">בֵרֵ֖ךְ</char> <char style="w" x-id="WLC.NUM.23.20.006" x-align="NUM.23.20.a007" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NUM.23.20.007" x-align="NUM.23.20.a008" x-target-ids="t014" x-target="cannot" x-target-head="t014" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.NUM.23.20.008" x-align="NUM.23.20.