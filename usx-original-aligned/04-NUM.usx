	<para style="p"><verse number="12" style="v" x-ref="NUM.19.12" sid="NUM 19:12" /><char style="w" x-id="WLC.NUM.19.12.001" x-align="NUM.19.12.a001" x-target-ids="t001 t002" x-target="the same" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֣וּא</char> <char style="w" x-id="WLC.NUM.19.12.002" x-align="NUM.19.12.a002" x-target-ids="t003 t004 t005" x-target="shall purify himself" x-target-head="t004" x-head="true" lemma="חָטָא" strong="H2398" x-morph="Vti3ms" x-gloss="he.will.purify.himself" x-translit="yiṯḥaṭṭāʾ-" xml:lang="hbo">יִתְחַטָּא</char>־<char style="w" x-id="WLC.NUM.19.12.003" x-align="NUM.19.12.a003" x-target-ids="t006" x-target="therewith" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇ" xml:lang="hbo">ב֞</char><char style="w" x-id="WLC.NUM.19.12.004" x-align="NUM.19.12.a003" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="it" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.NUM.19.12.005" x-align="NUM.19.12.a004" x-target-ids="t007" x-target="on" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="on" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.NUM.19.12.006" x-align="NUM.19.12.a005" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.NUM.19.12.007" x-align="NUM.19.12.a006" x-target-ids="t010" x-target="day" x-target-head="t010" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּ֧וֹם</char> <char style="w" x-id="WLC.NUM.19.12.008" x-align="NUM.19.12.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.NUM.19.12.009" x-align="NUM.19.12.a008" x