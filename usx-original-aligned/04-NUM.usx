	<para style="p"><verse number="24" style="v" x-ref="NUM.23.24" sid="NUM 23:24" /><char style="w" x-id="WLC.NUM.23.24.001" x-align="NUM.23.24.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tj" x-gloss="there!" x-translit="hen-" xml:lang="hbo">הֶן</char>־<char style="w" x-id="WLC.NUM.23.24.002" x-align="NUM.23.24.a002" x-target-ids="t002 t003" x-target="the people" x-target-head="t003" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿām" xml:lang="hbo">עָם֙</char> <char style="w" x-id="WLC.NUM.23.24.003" x-align="NUM.23.24.a003" x-target-ids="t006" x-target="as" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.NUM.23.24.004" x-align="NUM.23.24.a004" x-target-ids="t007 t008" x-target="a lioness" x-target-head="t008" x-head="true" lemma="לָבִיא" strong="H3833" x-morph="Ncbsa" x-gloss="a.lion" x-translit="lāḇiyʾ" xml:lang="hbo">לָבִ֣יא</char> <char style="w" x-id="WLC.NUM.23.24.005" x-align="NUM.23.24.a005" x-target-ids="t004 t005" x-target="riseth up" x-target-head="t004" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi3ms" x-gloss="it.rises" x-translit="yāqûm" xml:lang="hbo">יָק֔וּם</char> <char style="w" x-id="WLC.NUM.23.24.006" x-align="NUM.23.24.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NUM.23.24.007" x-align="NUM.23.24.a007" x-target-ids="t010" x-target="as" x-target-head="t010" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ḵa" xml:lang="hbo">כַ</char><char style="w" x-id="WLC.NUM.23.24.008" x-align="NUM.23.24.a008" x-target-ids="t011 t012" x-target="a lion" x-target-head="t012" x-head="true" lemma="אֲרִי" strong="H738" x-morph="Ncmsa" x-gloss="a.lion" x-transli