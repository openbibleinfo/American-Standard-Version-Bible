	<para style="p"><verse number="11" style="v" x-ref="NUM.3.11" sid="NUM 3:11" /><char style="w" x-id="WLC.NUM.3.11.001" x-align="NUM.3.11.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.NUM.3.11.002" x-align="NUM.3.11.a002" x-target-ids="t003" x-target="spake" x-target-head="t003" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpw3ms" x-gloss="he.spoke" x-translit="yəḏabbēr" xml:lang="hbo">יְדַבֵּ֥ר</char> <char style="w" x-id="WLC.NUM.3.11.003" x-align="NUM.3.11.a003" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.NUM.3.11.004" x-align="NUM.3.11.a004" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.NUM.3.11.005" x-align="NUM.3.11.a005" x-target-ids="t005" x-target="Moses" x-target-head="t005" x-head="true" lemma="מֹשֶׁה" strong="H4872" x-morph="Np" x-gloss="Moses" x-translit="mōšeh" xml:lang="hbo">מֹשֶׁ֥ה</char> <char style="w" x-id="WLC.NUM.3.11.006" x-align="NUM.3.11.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(cmp)" x-translit="llē" xml:lang="hbo">לֵּ</char><char style="w" x-id="WLC.NUM.3.11.007" x-align="NUM.3.11.a007" x-target-ids="t006" x-target="saying" x-target-head="t006" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqc" x-translit="ʾmōr:" xml:lang="hbo">אמֹֽר</char>׃<verse eid="NUM 3:11" /></para>
