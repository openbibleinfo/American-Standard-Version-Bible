	<para style="p"><verse number="19" style="v" x-ref="NUM.22.19" sid="NUM 22:19" /><char style="w" x-id="WLC.NUM.22.19.001" x-align="NUM.22.19.a001" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NUM.22.19.002" x-align="NUM.22.19.a002" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֗ה</char> <char style="w" x-id="WLC.NUM.22.19.003" x-align="NUM.22.19.a003" x-target-ids="t006" x-target="tarry" x-target-head="t006" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqv2mp" x-gloss="remain" x-translit="šəḇû" xml:lang="hbo">שְׁב֨וּ</char> <char style="w" x-id="WLC.NUM.22.19.004" x-align="NUM.22.19.a004" x-target-ids="t003 t004 t005" x-target="I pray you" x-target-head="t004" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֥א</char> <char style="w" x-id="WLC.NUM.22.19.005" x-align="NUM.22.19.a005" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇā" xml:lang="hbo">בָ</char><char style="w" x-id="WLC.NUM.22.19.006" x-align="NUM.22.19.a005" x-target-ids="t009" x-target="here" x-target-head="t009" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this.[place]" x-translit="zeh" xml:lang="hbo">זֶ֛ה</char> <char style="w" x-id="WLC.NUM.22.19.007" x-align="NUM.22.19.a006" x-target-ids="t008" x-target="also" x-target-head="t008" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.NUM.22.19.008" x-align="NUM.22.19.a007" x-target-ids="t007" x-target="ye" x-target-head="t007" x-head="true" lemma="אַתֶּם" strong="H859a" x-morph="Pp2mp" x-gloss="you" x-translit="ʾattem" xml:lang="hbo">אַתֶּ֖ם</char> <char style="w" x-id="WLC.NUM.22.19.009" x-align=