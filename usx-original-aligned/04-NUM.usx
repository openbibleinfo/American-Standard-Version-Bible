	<para style="p"><verse number="22" style="v" x-ref="NUM.23.22" sid="NUM 23:22" /><char style="w" x-id="WLC.NUM.23.22.001" x-align="NUM.23.22.a001" x-target-ids="t001" x-target="God" x-target-head="t001" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֖ל</char> <char style="w" x-id="WLC.NUM.23.22.002" x-align="NUM.23.22.a002" x-target-ids="t002 t004" x-target="bringeth forth" x-target-head="t002" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vhrmsc" x-gloss="[is].bringing" x-translit="môṣiyʾ" xml:lang="hbo">מוֹצִיאָ֣</char><char style="w" x-id="WLC.NUM.23.22.003" x-align="NUM.23.22.a003" x-target-ids="t003" x-target="them" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them.out" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.NUM.23.22.004" x-align="NUM.23.22.a004" x-target-ids="t005 t006" x-target="out of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.NUM.23.22.005" x-align="NUM.23.22.a005" x-target-ids="t007" x-target="Egypt" x-target-head="t007" x-head="true" lemma="מִצְרַיִם" strong="H4714" x-morph="Np" x-gloss="Egypt" x-translit="mmiṣrāyim" xml:lang="hbo">מִּצְרָ֑יִם</char> <char style="w" x-id="WLC.NUM.23.22.006" x-align="NUM.23.22.a006" x-target-ids="t010 t011 t012" x-target="as it were" x-target-head="t010" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like.[the]" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.NUM.23.22.007" x-align="NUM.23.22.a007" x-target-ids="t013 t014" x-target="the strength" x-target-head="t014" x-head="true" lemma="תֹּועָפֹות" strong="H8443" x-morph="Ncfpc" x-gloss="horns" x-translit="ṯôʿăp̄ōṯ" xml:lang="hbo">תוֹעֲפֹ֥ת</char> <char style="w" x-id="WLC.NUM.23.22.008" x-align="NUM.23.22.a008" x-target-ids="t015 t016 t017 t018" x-target="of the wild ox" x-target-head="t018" 