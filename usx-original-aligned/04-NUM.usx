	<para style="p"><verse number="24" style="v" x-ref="NUM.18.24" sid="NUM 18:24" /><char style="w" x-id="WLC.NUM.18.24.001" x-align="NUM.18.24.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֞י</char> <char style="w" x-id="WLC.NUM.18.24.002" x-align="NUM.18.24.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.NUM.18.24.003" x-align="NUM.18.24.a003" x-target-ids="t002 t003" x-target="the tithe" x-target-head="t003" x-head="true" lemma="מַעֲשֵׂר" strong="H4643" x-morph="Ncmsc" x-gloss="the.tithe" x-translit="maʿśar" xml:lang="hbo">מַעְשַׂ֣ר</char> <char style="w" x-id="WLC.NUM.18.24.004" x-align="NUM.18.24.a004" x-target-ids="t004 t005 t006" x-target="of the children" x-target-head="t006" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="of.the.people" x-translit="bənēy-" xml:lang="hbo">בְּנֵֽי</char>־<char style="w" x-id="WLC.NUM.18.24.005" x-align="NUM.18.24.a005" x-target-ids="t007 t008" x-target="of Israel" x-target-head="t008" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֗ל</char> <char style="w" x-id="WLC.NUM.18.24.006" x-align="NUM.18.24.a006" x-target-ids="t009" x-target="which" x-target-head="t009" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֨ר</char> <char style="w" x-id="WLC.NUM.18.24.007" x-align="NUM.18.24.a007" x-target-ids="t010 t011" x-target="they offer" x-target-head="t011" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vhi3mp" x-gloss="they.will.offer.up" x-translit="yāriymû" xml:lang="hbo">יָרִ֤ימוּ</char> <char style="w" x-id="WLC.NUM.18.24.008" x-align="NUM.18.24.a008" x-target-ids="t016" x-target="unto" x-target-head="t016" x-head="true" lemma="לְ