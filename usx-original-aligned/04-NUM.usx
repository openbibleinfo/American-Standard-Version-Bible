	<para style="p"><verse number="23" style="v" x-ref="NUM.23.23" sid="NUM 23:23" /><char style="w" x-id="WLC.NUM.23.23.001" x-align="NUM.23.23.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.NUM.23.23.002" x-align="NUM.23.23.a002" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.NUM.23.23.003" x-align="NUM.23.23.a003" x-target-ids="t002 t003 t005" x-target="there is enchantment" x-target-head="t005" x-head="true" lemma="נַחַשׁ" strong="H5173" x-morph="Ncmsa" x-gloss="enchantment" x-translit="naḥaš" xml:lang="hbo">נַ֨חַשׁ֙</char> <char style="w" x-id="WLC.NUM.23.23.004" x-align="NUM.23.23.a004" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.23.23.005" x-align="NUM.23.23.a005" x-target-ids="t007" x-target="Jacob" x-target-head="t007" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֔ב</char> <char style="w" x-id="WLC.NUM.23.23.006" x-align="NUM.23.23.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NUM.23.23.007" x-align="NUM.23.23.a006" x-target-ids="t008" x-target="Neither" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.NUM.23.23.008" x-align="NUM.23.23.a007" x-target-ids="t009 t010 t011 t012" x-target="is there any divination" x-target-head="t012" x-head="true" lemma="קֶסֶם" strong="H7081" x-morph="Ncmsa" x-gloss="divination" x-translit="qesem" xml:lang="hbo">קֶ֖סֶם</char