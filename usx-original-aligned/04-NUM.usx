	<para style="p"><verse number="11" style="v" x-ref="NUM.17.11" sid="NUM 17:11" /><char style="w" x-id="WLC.NUM.17.11.001" x-align="NUM.17.11.a001" x-target-ids="t001" x-target="Thus" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="NUM.17.26">וַ</char><char style="w" x-id="WLC.NUM.17.11.002" x-align="NUM.17.11.a002" x-target-ids="t002" x-target="did" x-target-head="t002" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqw3ms" x-gloss="he.did" x-translit="yyaʿaś" xml:lang="hbo" x-source-ref="NUM.17.26">יַּ֖עַשׂ</char> <char style="w" x-id="WLC.NUM.17.11.003" x-align="NUM.17.11.a003" x-target-ids="t003" x-target="Moses" x-target-head="t003" x-head="true" lemma="מֹשֶׁה" strong="H4872" x-morph="Np" x-gloss="Moses" x-translit="mōšeh" xml:lang="hbo" x-source-ref="NUM.17.26">מֹשֶׁ֑ה</char> <char style="w" x-id="WLC.NUM.17.11.004" x-align="NUM.17.11.a004" x-target-ids="t004" x-target="as" x-target-head="t004" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="just" x-translit="ka" xml:lang="hbo" x-source-ref="NUM.17.26">כַּ</char><char style="w" x-id="WLC.NUM.17.11.005" x-align="NUM.17.11.a004" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="as" x-translit="ʾăšer" xml:lang="hbo" x-source-ref="NUM.17.26">אֲשֶׁ֨ר</char> <char style="w" x-id="WLC.NUM.17.11.006" x-align="NUM.17.11.a005" x-target-ids="t006" x-target="commanded" x-target-head="t006" x-head="true" lemma="צָוָה" strong="H6680" x-morph="Vpp3ms" x-gloss="he.had.commanded" x-translit="ṣiwwāh" xml:lang="hbo" x-source-ref="NUM.17.26">צִוָּ֧ה</char> <char style="w" x-id="WLC.NUM.17.11.007" x-align="NUM.17.11.a006" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="NUM.17.26">יְהוָ֛ה</char> <char style="w" x-id="WLC.NUM.17.11.008" x-align="NUM.17.11.a007" x-status="unrepresented" x-head="tru