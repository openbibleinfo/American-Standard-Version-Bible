	<para style="p"><verse number="28" style="v" x-ref="NUM.21.28" sid="NUM 21:28" /><char style="w" x-id="WLC.NUM.21.28.001" x-align="NUM.21.28.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.NUM.21.28.002" x-align="NUM.21.28.a002" x-target-ids="t002 t003" x-target="a fire" x-target-head="t003" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsa" x-gloss="fire" x-translit="ʾēš" xml:lang="hbo">אֵשׁ֙</char> <char style="w" x-id="WLC.NUM.21.28.003" x-align="NUM.21.28.a003" x-target-ids="t004 t005 t006" x-target="is gone out" x-target-head="t005" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqp3fs" x-gloss="it.went.out" x-translit="yāṣəʾāh" xml:lang="hbo">יָֽצְאָ֣ה</char> <char style="w" x-id="WLC.NUM.21.28.004" x-align="NUM.21.28.a004" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.NUM.21.28.005" x-align="NUM.21.28.a005" x-target-ids="t008" x-target="Heshbon" x-target-head="t008" x-head="true" lemma="חֶשְׁבּוֹן" strong="H2809" x-morph="Np" x-gloss="Heshbon" x-translit="ḥešbôn" xml:lang="hbo">חֶשְׁבּ֔וֹן</char> <char style="w" x-id="WLC.NUM.21.28.006" x-align="NUM.21.28.a006" x-target-ids="t009 t010" x-target="A flame" x-target-head="t010" x-head="true" lemma="לֶהָבָה" strong="H3852" x-morph="Ncfsa" x-gloss="flame" x-translit="lehāḇāh" xml:lang="hbo">לֶהָבָ֖ה</char> <char style="w" x-id="WLC.NUM.21.28.007" x-align="NUM.21.28.a007" x-target-ids="t011" x-target="from" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.NUM.21.28.008" x-align="NUM.21.28.a008" x-target-ids="t012 t013" x-target="the city" x-target-head="t013" x-head="true" lemma="קִרְיָה" strong="H7151" x-mo