	<para style="p"><verse number="14" style="v" x-ref="NUM.18.14" sid="NUM 18:14" /><char style="w" x-id="WLC.NUM.18.14.001" x-align="NUM.18.14.a001" x-target-ids="t001" x-target="Everything" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.NUM.18.14.002" x-align="NUM.18.14.a002" x-target-ids="t002" x-target="devoted" x-target-head="t002" x-head="true" lemma="חֵרֶם" strong="H2764" x-morph="Ncmsa" x-gloss="devoted.thing" x-translit="ḥērem" xml:lang="hbo">חֵ֥רֶם</char> <char style="w" x-id="WLC.NUM.18.14.003" x-align="NUM.18.14.a003" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.18.14.004" x-align="NUM.18.14.a004" x-target-ids="t004" x-target="Israel" x-target-head="t004" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֖ל</char> <char style="w" x-id="WLC.NUM.18.14.005" x-align="NUM.18.14.a005" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.NUM.18.14.006" x-align="NUM.18.14.a005" x-target-ids="t007" x-target="thine" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.NUM.18.14.007" x-align="NUM.18.14.a006" x-target-ids="t005 t006" x-target="shall be" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="it.will.belong" x-translit="yihyeh:" xml:lang="hbo">יִהְיֶֽה</char>׃<verse eid="NUM 18:14" /></para>
