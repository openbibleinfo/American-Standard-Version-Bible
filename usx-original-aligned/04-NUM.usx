	<para style="p"><verse number="27" style="v" x-ref="NUM.21.27" sid="NUM 21:27" /><char style="w" x-id="WLC.NUM.21.27.001" x-align="NUM.21.27.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.NUM.21.27.002" x-align="NUM.21.27.a001" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֛ן</char> <char style="w" x-id="WLC.NUM.21.27.003" x-align="NUM.21.27.a002" x-target-ids="t007" x-target="say" x-target-head="t007" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3mp" x-gloss="they.say" x-translit="yōʾmərû" xml:lang="hbo">יֹאמְר֥וּ</char> <char style="w" x-id="WLC.NUM.21.27.004" x-align="NUM.21.27.a003" x-target-ids="t002 t003" x-target="they that" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.NUM.21.27.005" x-align="NUM.21.27.a004" x-target-ids="t004 t005 t006" x-target="speak in proverbs" x-target-head="t006" x-head="true" lemma="מָשַׁל" strong="H4911" x-morph="Vqrmpa" x-gloss="who].speak.proverbs" x-translit="mmōšəliym" xml:lang="hbo">מֹּשְׁלִ֖ים</char> <char style="w" x-id="WLC.NUM.21.27.006" x-align="NUM.21.27.a005" x-target-ids="t008 t009" x-target="Come ye" x-target-head="t008" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqv2mp" x-gloss="come" x-translit="bōʾû" xml:lang="hbo">בֹּ֣אוּ</char> <char style="w" x-id="WLC.NUM.21.27.007" x-align="NUM.21.27.a006" x-target-ids="t010 t011" x-target="to Heshbon" x-target-head="t011" x-head="true" lemma="חֶשְׁבּוֹן" strong="H2809" x-morph="Np" x-gloss="Heshbon" x-translit="ḥešbôn" xml:lang="hbo">חֶשְׁבּ֑וֹן</char> <char style="w" x-id="WLC.NUM.21.27.008" x-align="NUM.21.27.a007" x-target-ids="t012 t017 t018" x-target="Let be built" x-target-head="t018" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="VNj3fs" x-gloss=