	<para style="p"><verse number="23" style="v" x-ref="NUM.14.23" sid="NUM 14:23" /><char style="w" x-id="WLC.NUM.14.23.001" x-align="NUM.14.23.a001" x-target-ids="t001 t004" x-target="surely not" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.NUM.14.23.002" x-align="NUM.14.23.a002" x-target-ids="t002 t003 t005" x-target="they shall see" x-target-head="t005" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi3mp" x-gloss="they.will.see" x-translit="yirʾû" xml:lang="hbo">יִרְאוּ֙</char> <char style="w" x-id="WLC.NUM.14.23.003" x-align="NUM.14.23.a003" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.NUM.14.23.004" x-align="NUM.14.23.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.NUM.14.23.005" x-align="NUM.14.23.a005" x-target-ids="t007" x-target="land" x-target-head="t007" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="land" x-translit="ʾāreṣ" xml:lang="hbo">אָ֔רֶץ</char> <char style="w" x-id="WLC.NUM.14.23.006" x-align="NUM.14.23.a006" x-target-ids="t008" x-target="which" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֥ר</char> <char style="w" x-id="WLC.NUM.14.23.007" x-align="NUM.14.23.a007" x-target-ids="t009 t010" x-target="I sware" x-target-head="t010" x-head="true" lemma="שָׁבַע" strong="H7650" x-morph="VNp1cs" x-gloss="I.swore" x-translit="nišbaʿətî" xml:lang="hbo">נִשְׁבַּ֖עְתִּי</char> <char style="w" x-id="WLC.NUM.14.23.008" x-align="NUM.14.23.a008" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" 