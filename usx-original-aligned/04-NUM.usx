	<para style="p"><verse number="21" style="v" x-ref="NUM.23.21" sid="NUM 23:21" /><char style="w" x-id="WLC.NUM.23.21.001" x-align="NUM.23.21.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.NUM.23.21.002" x-align="NUM.23.21.a002" x-target-ids="t001 t002 t004" x-target="He hath beheld" x-target-head="t004" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhp3ms" x-gloss="he.has.looked.at" x-translit="hibbiyṭ" xml:lang="hbo">הִבִּ֥יט</char> <char style="w" x-id="WLC.NUM.23.21.003" x-align="NUM.23.21.a003" x-target-ids="t005" x-target="iniquity" x-target-head="t005" x-head="true" lemma="אָוֶן" strong="H205" x-morph="Ncmsa" x-gloss="disaster" x-translit="ʾāwen" xml:lang="hbo">אָ֨וֶן֙</char> <char style="w" x-id="WLC.NUM.23.21.004" x-align="NUM.23.21.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.23.21.005" x-align="NUM.23.21.a005" x-target-ids="t007" x-target="Jacob" x-target-head="t007" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֔ב</char> <char style="w" x-id="WLC.NUM.23.21.006" x-align="NUM.23.21.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NUM.23.21.007" x-align="NUM.23.21.a006" x-target-ids="t008" x-target="Neither" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.NUM.23.21.008" x-align="NUM.23.21.a007" x-target-ids="t009 t010 t011" x-target="hath he seen" x-target-head="t011" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp3ms" x-gloss="he.has.seen" x-translit="rāʾāh" xml:lang="hbo">רָאָ֥ה</char> <c