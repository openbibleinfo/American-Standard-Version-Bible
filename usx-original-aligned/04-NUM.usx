	<para style="p"><verse number="20" style="v" x-ref="NUM.4.20" sid="NUM 4:20" /><char style="w" x-id="WLC.NUM.4.20.001" x-align="NUM.4.20.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NUM.4.20.002" x-align="NUM.4.20.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.NUM.4.20.003" x-align="NUM.4.20.a003" x-target-ids="t002 t003 t005 t006" x-target="they shall go in" x-target-head="t005" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3mp" x-gloss="they.will.go" x-translit="yāḇōʾû" xml:lang="hbo">יָבֹ֧אוּ</char> <char style="w" x-id="WLC.NUM.4.20.004" x-align="NUM.4.20.a004" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.NUM.4.20.005" x-align="NUM.4.20.a005" x-target-ids="t008" x-target="see" x-target-head="t008" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqc" x-gloss="see" x-translit="rəʾôṯ" xml:lang="hbo">רְא֛וֹת</char> <char style="w" x-id="WLC.NUM.4.20.006" x-align="NUM.4.20.a006" x-status="noncompositional" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="as" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.NUM.4.20.007" x-align="NUM.4.20.a006" x-status="noncompositional" x-target-ids="t011 t012 t013 t014" x-target="even for a moment" x-target-head="t014" x-head="true" lemma="בָּלַע" strong="H1104" x-morph="Vpc" x-gloss="a.swallowing" x-translit="ḇallaʿ" xml:lang="hbo">בַלַּ֥ע</char> <char style="w" x-id="WLC.NUM.4.20.008" x-align="NUM.4.20.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id