	<para style="p"><verse number="5" style="v" x-ref="NUM.24.5" sid="NUM 24:5" /><char style="w" x-id="WLC.NUM.24.5.001" x-align="NUM.24.5.a001" x-target-ids="t001" x-target="How" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="how!" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.NUM.24.5.002" x-align="NUM.24.5.a002" x-target-ids="t002 t003" x-target="goodly are" x-target-head="t002" x-head="true" lemma="טוֹב" strong="H2895" x-morph="Vqp3cp" x-gloss="they.are.good" x-translit="ṭṭōḇû" xml:lang="hbo">טֹּ֥בוּ</char> <char style="w" x-id="WLC.NUM.24.5.003" x-align="NUM.24.5.a003" x-target-ids="t005" x-target="tents" x-target-head="t005" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmpc" x-gloss="tents" x-translit="ʾōhāley" xml:lang="hbo">אֹהָלֶ֖י</char><char style="w" x-id="WLC.NUM.24.5.004" x-align="NUM.24.5.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.NUM.24.5.005" x-align="NUM.24.5.a005" x-target-ids="t006 t007" x-target="O Jacob" x-target-head="t007" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="O.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֑ב</char> <char style="w" x-id="WLC.NUM.24.5.006" x-align="NUM.24.5.a006" x-target-ids="t009" x-target="tabernacles" x-target-head="t009" x-head="true" lemma="מִשְׁכָּן" strong="H4908" x-morph="Ncmpc" x-gloss="places" x-translit="miškənōṯey" xml:lang="hbo">מִשְׁכְּנֹתֶ֖י</char><char style="w" x-id="WLC.NUM.24.5.007" x-align="NUM.24.5.a007" x-target-ids="t008" x-target="Thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.dwelling" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.NUM.24.5.008" x-align="NUM.24.5.a008" x-target-ids="t010 t011" x-target="O Israel" x-target-head="t011" x-head="true" lemma="יִשְׂרָאֵל" strong="H3