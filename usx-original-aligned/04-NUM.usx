	<para style="p"><verse number="13" style="v" x-ref="NUM.19.13" sid="NUM 19:13" /><char style="w" x-id="WLC.NUM.19.13.001" x-align="NUM.19.13.a001" x-target-ids="t001" x-target="Whosoever" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kāl-" xml:lang="hbo">כָּֽל</char>־<char style="w" x-id="WLC.NUM.19.13.002" x-align="NUM.19.13.a001" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the).[one" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.NUM.19.13.003" x-align="NUM.19.13.a002" x-target-ids="t002" x-target="toucheth" x-target-head="t002" x-head="true" lemma="נָגַע" strong="H5060" x-morph="Vqrmsa" x-gloss="who].touches" x-translit="nnōḡēᵃʿ" xml:lang="hbo">נֹּגֵ֡עַ</char> <char style="w" x-id="WLC.NUM.19.13.004" x-align="NUM.19.13.a003" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in).a" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.19.13.005" x-align="NUM.19.13.a004" x-target-ids="t003 t004 t005" x-target="a dead person" x-target-head="t004" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqrmsa" x-gloss="dead.[body]" x-translit="mēṯ" xml:lang="hbo">מֵ֣ת</char> <char style="w" x-id="WLC.NUM.19.13.006" x-align="NUM.19.13.a005" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in).the" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NUM.19.13.007" x-align="NUM.19.13.a006" x-target-ids="t006 t007" x-target="the body" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="corpse" x-translit="nep̄eš" xml:lang="hbo">נֶפֶשׁ֩</char> <char style="w" x-id="WLC.NUM.19.13.008" x-align="NUM.19.13.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of.(the)" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.NUM.19.13.009" x-align="NUM.19.13.a008" x-target-ids="t008 t009 t010" x-target=