	<para style="p"><verse number="12" style="v" x-ref="NUM.15.12" sid="NUM 15:12" /><char style="w" x-id="WLC.NUM.15.12.001" x-align="NUM.15.12.a001" x-target-ids="t001 t002" x-target="According to" x-target-head="t001" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="according" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.NUM.15.12.002" x-align="NUM.15.12.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="to" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.NUM.15.12.003" x-align="NUM.15.12.a003" x-target-ids="t004" x-target="number" x-target-head="t004" x-head="true" lemma="מִסְפָּר" strong="H4557" x-morph="Ncmsa" x-gloss="the.number" x-translit="mmispār" xml:lang="hbo">מִּסְפָּ֖ר</char> <char style="w" x-id="WLC.NUM.15.12.004" x-align="NUM.15.12.a004" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.NUM.15.12.005" x-align="NUM.15.12.a005" x-target-ids="t006 t007 t008" x-target="ye shall prepare" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi2mp" x-gloss="you.will.offer" x-translit="taʿăśû" xml:lang="hbo">תַּעֲשׂ֑וּ</char> <char style="w" x-id="WLC.NUM.15.12.006" x-align="NUM.15.12.a006" x-target-ids="t009" x-target="so" x-target-head="t009" x-head="true" lemma="כָּכָה" strong="H3602" x-morph="D" x-gloss="thus" x-translit="kāḵâ" xml:lang="hbo">כָּ֛כָה</char> <char style="w" x-id="WLC.NUM.15.12.007" x-align="NUM.15.12.a007" x-target-ids="t010 t011 t012" x-target="shall ye do" x-target-head="t012" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi2mp" x-gloss="you.will.do" x-translit="taʿăśû" xml:lang="hbo">תַּעֲשׂ֥וּ</char> <char style="w" x-id="WLC.NUM.15.12.008" x-align="NUM.15.12.a008" x-target-ids="t013" x-target="to" x-target-head="t013" x-head