	<para style="p"><verse number="11" style="v" x-ref="2TI.2.11" sid="2TI 2:11" /><char style="w" x-id="SBLGNT.2TI.2.11.001" x-align="2TI.2.11.a001" x-target-ids="t001 t002" x-target="Faithful is" x-target-head="t001" x-head="true" lemma="πιστός" strong="G4103" x-morph="A-NSM" x-gloss="Trustworthy [is]" x-translit="pistos" xml:lang="grc">πιστὸς</char> <char style="w" x-id="SBLGNT.2TI.2.11.002" x-align="2TI.2.11.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.2TI.2.11.003" x-align="2TI.2.11.a003" x-target-ids="t004" x-target="saying" x-target-head="t004" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-NSM" x-gloss="saying" x-translit="logos" xml:lang="grc">λόγος</char>·<char style="w" x-id="SBLGNT.2TI.2.11.004" x-align="2TI.2.11.a004" x-target-ids="t006" x-target="if" x-target-head="t006" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.2TI.2.11.005" x-align="2TI.2.11.a005" x-target-ids="t005" x-target="For" x-target-head="t005" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2TI.2.11.006" x-align="2TI.2.11.a006" x-target-ids="t007 t008 t009 t010" x-target="we died with him" x-target-head="t008" x-head="true" lemma="συναποθνῄσκω" strong="G4880" x-morph="V-2AAI-1P" x-gloss="we have died together [with Him]" x-translit="synapethanomen" xml:lang="grc">συναπεθάνομεν</char>,<char style="w" x-id="SBLGNT.2TI.2.11.007" x-align="2TI.2.11.a007" x-target-ids="t013" x-target="also" x-target-head="t013" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2TI.2.11.008" x-align="2TI.2.11.a008" x-target-ids="t011 t012 t014 t015 t016" x-target="we shall live wit