	<para style="p"><verse number="7" style="v" x-ref="2TI.2.7" sid="2TI 2:7" /><char style="w" x-id="SBLGNT.2TI.2.7.001" x-align="2TI.2.7.a001" x-target-ids="t001" x-target="Consider" x-target-head="t001" x-head="true" lemma="νοέω" strong="G3539" x-morph="V-PAM-2S" x-gloss="Consider" x-translit="noei" xml:lang="grc">νόει</char> <char style="w" x-id="SBLGNT.2TI.2.7.002" x-align="2TI.2.7.a002" x-target-ids="t002" x-target="what" x-target-head="t002" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-ASN" x-gloss="the things" x-translit="ho" xml:lang="grc">ὃ</char> <char style="w" x-id="SBLGNT.2TI.2.7.003" x-align="2TI.2.7.a003" x-target-ids="t003 t004" x-target="I say" x-target-head="t004" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I am saying" x-translit="legō" xml:lang="grc">λέγω</char>·<char style="w" x-id="SBLGNT.2TI.2.7.004" x-align="2TI.2.7.a004" x-target-ids="t008 t009" x-target="shall give" x-target-head="t009" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-FAI-3S" x-gloss="will give" x-translit="dōsei" xml:lang="grc">δώσει</char> <char style="w" x-id="SBLGNT.2TI.2.7.005" x-align="2TI.2.7.a005" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γάρ</char> <char style="w" x-id="SBLGNT.2TI.2.7.006" x-align="2TI.2.7.a006" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="you" x-translit="soi" xml:lang="grc">σοι</char> <char style="w" x-id="SBLGNT.2TI.2.7.007" x-align="2TI.2.7.a007" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.2TI.2.7.008" x-align="2TI.2.7.a008" x-target-ids="t007" x-target="Lord" x-target-head="t007" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-NSM" x-gloss="Lord" x-translit="kyrios