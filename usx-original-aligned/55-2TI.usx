	<para style="p"><verse number="4" style="v" x-ref="2TI.1.4" sid="2TI 1:4" /><char style="w" x-id="SBLGNT.2TI.1.4.001" x-align="2TI.1.4.a001" x-target-ids="t001" x-target="longing" x-target-head="t001" x-head="true" lemma="ἐπιποθέω" strong="G1971" x-morph="V-PAP-NSM" x-gloss="longing" x-translit="epipothōn" xml:lang="grc">ἐπιποθῶν</char> <char style="w" x-id="SBLGNT.2TI.1.4.002" x-align="2TI.1.4.a002" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.2TI.1.4.003" x-align="2TI.1.4.a003" x-target-ids="t002 t003" x-target="to see" x-target-head="t003" x-head="true" lemma="ὁράω" strong="G3708" x-morph="V-2AAN" x-gloss="to see" x-translit="idein" xml:lang="grc">ἰδεῖν</char>,<char style="w" x-id="SBLGNT.2TI.1.4.004" x-align="2TI.1.4.a004" x-target-ids="t005" x-target="remembering" x-target-head="t005" x-head="true" lemma="μιμνῄσκομαι" strong="G3415" x-morph="V-RPP-NSM" x-gloss="recalling" x-translit="memnēmenos" xml:lang="grc">μεμνημένος</char> <char style="w" x-id="SBLGNT.2TI.1.4.005" x-align="2TI.1.4.a005" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="your" x-translit="sou" xml:lang="grc">σου</char> <char style="w" x-id="SBLGNT.2TI.1.4.006" x-align="2TI.1.4.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPN" x-gloss="-" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.2TI.1.4.007" x-align="2TI.1.4.a007" x-target-ids="t007" x-target="tears" x-target-head="t007" x-head="true" lemma="δάκρυον" strong="G1144" x-morph="N-GPN" x-gloss="tears" x-translit="dakryōn" xml:lang="grc">δακρύων</char>,<char style="w" x-id="SBLGNT.2TI.1.4.008" x-align="2TI.1.4.a008" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" 