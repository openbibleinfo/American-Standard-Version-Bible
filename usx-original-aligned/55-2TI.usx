	<para style="p"><verse number="14" style="v" x-ref="2TI.1.14" sid="2TI 1:14" /><char style="w" x-id="SBLGNT.2TI.1.14.001" x-align="2TI.1.14.a001" x-target-ids="t001 t003" x-target="That thing" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="The" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.2TI.1.14.002" x-align="2TI.1.14.a002" x-target-ids="t002" x-target="good" x-target-head="t002" x-head="true" lemma="καλός" strong="G2570" x-morph="A-ASF" x-gloss="good" x-translit="kalēn" xml:lang="grc">καλὴν</char> <char style="w" x-id="SBLGNT.2TI.1.14.003" x-align="2TI.1.14.a003" x-target-ids="t004 t005 t006 t007 t008" x-target="which was committed unto thee" x-target-italic-ids="t008" x-target-head="t006" x-head="true" lemma="παραθήκη" strong="G3866" x-morph="N-ASF" x-gloss="deposit entrusted [to you]" x-translit="parathēkēn" xml:lang="grc">παραθήκην</char> <char style="w" x-id="SBLGNT.2TI.1.14.004" x-align="2TI.1.14.a004" x-target-ids="t009" x-target="guard" x-target-head="t009" x-head="true" lemma="φυλάσσω" strong="G5442" x-morph="V-AAM-2S" x-gloss="keep" x-translit="phylaxon" xml:lang="grc">φύλαξον</char> <char style="w" x-id="SBLGNT.2TI.1.14.005" x-align="2TI.1.14.a005" x-target-ids="t010" x-target="through" x-target-head="t010" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="by" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.2TI.1.14.006" x-align="2TI.1.14.a006" x-target-ids="t011 t013" x-target="the Spirit" x-target-head="t013" x-head="true" lemma="πνεῦμα" strong="G4151" x-morph="N-GSN" x-gloss="[the] Spirit" x-translit="pneumatos" xml:lang="grc">πνεύματος</char> <char style="w" x-id="SBLGNT.2TI.1.14.007" x-align="2TI.1.14.a007" x-target-ids="t012" x-target="Holy" x-target-head="t012" x-head="true" lemma="ἅγιος" strong="G40" x-morph="A-GSN" x-gloss="Holy" x-translit="hagiou" xml:lang="grc">ἁγίου</char> <char style="w" x-id="SBLGNT.2TI.1.14.008" x-align="2TI.1.14.a008