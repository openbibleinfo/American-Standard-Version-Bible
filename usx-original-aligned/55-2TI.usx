	<para style="p"><verse number="6" style="v" x-ref="2TI.2.6" sid="2TI 2:6" /><char style="w" x-id="SBLGNT.2TI.2.6.001" x-align="2TI.2.6.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="For the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.2TI.2.6.002" x-align="2TI.2.6.a002" x-target-ids="t003 t004" x-target="that laboreth" x-target-head="t004" x-head="true" lemma="κοπιάω" strong="G2872" x-morph="V-PAP-ASM" x-gloss="hardworking" x-translit="kopiōnta" xml:lang="grc">κοπιῶντα</char> <char style="w" x-id="SBLGNT.2TI.2.6.003" x-align="2TI.2.6.a003" x-target-ids="t002" x-target="husbandman" x-target-head="t002" x-head="true" lemma="γεωργός" strong="G1092" x-morph="N-ASM" x-gloss="farmer" x-translit="geōrgon" xml:lang="grc">γεωργὸν</char> <char style="w" x-id="SBLGNT.2TI.2.6.004" x-align="2TI.2.6.a004" x-target-ids="t005" x-target="must" x-target-head="t005" x-head="true" lemma="δέω" strong="G1210" x-morph="V-PAI-3S" x-gloss="it is necessary" x-translit="dei" xml:lang="grc">δεῖ</char> <char style="w" x-id="SBLGNT.2TI.2.6.005" x-align="2TI.2.6.a005" x-target-ids="t006 t007 t008" x-target="be the first" x-target-head="t008" x-head="true" lemma="πρῶτος" strong="G4412" x-morph="ADV-S" x-gloss="first" x-translit="prōton" xml:lang="grc">πρῶτον</char> <char style="w" x-id="SBLGNT.2TI.2.6.006" x-align="2TI.2.6.a006" x-target-ids="t011 t012" x-target="of the" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="of the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.2TI.2.6.007" x-align="2TI.2.6.a007" x-target-ids="t013" x-target="fruits" x-target-head="t013" x-head="true" lemma="καρπός" strong="G2590" x-morph="N-GPM" x-gloss="fruits" x-translit="karpōn" xml:lang="grc">καρπῶν</char> <char style="w" x-id="SBLGNT.2TI.2.6.008" x-align="2TI.2.6.a008" x-target-ids="t009 t010" x-target="to partake" x-target-head="t010" x-head="tru