	<para style="p"><verse number="12" style="v" x-ref="2TI.2.12" sid="2TI 2:12" /><char style="w" x-id="SBLGNT.2TI.2.12.001" x-align="2TI.2.12.a001" x-target-ids="t001" x-target="if" x-target-head="t001" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.2TI.2.12.002" x-align="2TI.2.12.a002" x-target-ids="t002 t003" x-target="we endure" x-target-head="t003" x-head="true" lemma="ὑπομένω" strong="G5278" x-morph="V-PAI-1P" x-gloss="we endure" x-translit="hypomenomen" xml:lang="grc">ὑπομένομεν</char>,<char style="w" x-id="SBLGNT.2TI.2.12.003" x-align="2TI.2.12.a003" x-target-ids="t006" x-target="also" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2TI.2.12.004" x-align="2TI.2.12.a004" x-target-ids="t004 t005 t007 t008 t009" x-target="we shall reign with him" x-target-head="t007" x-head="true" lemma="συμβασιλεύω" strong="G4821" x-morph="V-FAI-1P" x-gloss="we will reign together [with Him]" x-translit="symbasileusomen" xml:lang="grc">συμβασιλεύσομεν</char>·<char style="w" x-id="SBLGNT.2TI.2.12.005" x-align="2TI.2.12.a005" x-target-ids="t010" x-target="if" x-target-head="t010" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.2TI.2.12.006" x-align="2TI.2.12.a006" x-target-ids="t011 t012 t013 t014" x-target="we shall deny him" x-target-head="t013" x-head="true" lemma="ἀρνέομαι" strong="G720" x-morph="V-FDI-1P" x-gloss="we will deny [Him]" x-translit="arnēsometha" xml:lang="grc">ἀρνησόμεθα</char>,<char style="w" x-id="SBLGNT.2TI.2.12.007" x-align="2TI.2.12.a007" x-target-ids="t015 t016" x-target="he also" x-target-head="t015" x-head="true" lemma="κἀκεῖνος" strong="G2548" x-morph="D-NSM-K" x-gloss="He also" x-translit="kakeinos" xml:lang="grc">κἀκεῖνος</char> <char style="w" x-id="SBLGNT.2TI