	<para style="p"><verse number="26" style="v" x-ref="2TI.2.26" sid="2TI 2:26" /><char style="w" x-id="SBLGNT.2TI.2.26.001" x-align="2TI.2.26.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2TI.2.26.002" x-align="2TI.2.26.a002" x-target-ids="t002 t003 t004 t005" x-target="they may recover themselves" x-target-head="t004" x-head="true" lemma="ἀνανήφω" strong="G366" x-morph="V-AAS-3P" x-gloss="they might come to their senses" x-translit="ananēpsōsin" xml:lang="grc">ἀνανήψωσιν</char> <char style="w" x-id="SBLGNT.2TI.2.26.003" x-align="2TI.2.26.a003" x-target-ids="t006 t007" x-target="out of" x-target-head="t006" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="out of" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.2TI.2.26.004" x-align="2TI.2.26.a004" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.2TI.2.26.005" x-align="2TI.2.26.a005" x-target-ids="t010 t011" x-target="of the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="of the" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.2TI.2.26.006" x-align="2TI.2.26.a006" x-target-ids="t012" x-target="devil" x-target-head="t012" x-head="true" lemma="διάβολος" strong="G1228" x-morph="A-GSM" x-gloss="devil" x-translit="diabolou" xml:lang="grc">διαβόλου</char> <char style="w" x-id="SBLGNT.2TI.2.26.007" x-align="2TI.2.26.a007" x-target-ids="t009" x-target="snare" x-target-head="t009" x-head="true" lemma="παγίς" strong="G3803" x-morph="N-GSF" x-gloss="snare" x-translit="pagidos" xml:lang="grc">παγίδος</char>,<char style="w" x-id="SBLGNT.2TI.2.26.008" x-align="2TI.2.26.a008" x-target-ids="t013 t014 t015 t016" x-target="having been tak