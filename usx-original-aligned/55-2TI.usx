	<para style="p"><verse number="3" style="v" x-ref="2TI.2.3" sid="2TI 2:3" /><char style="w" x-id="SBLGNT.2TI.2.3.001" x-align="2TI.2.3.a001" x-target-ids="t001 t002 t003 t004" x-target="Suffer hardship with me" x-target-italic-ids="t004" x-target-head="t001" x-head="true" lemma="συγκακοπαθέω" strong="G4777" x-morph="V-AAM-2S" x-gloss="Share in suffering" x-translit="synkakopathēson" xml:lang="grc">συγκακοπάθησον</char> <char style="w" x-id="SBLGNT.2TI.2.3.002" x-align="2TI.2.3.a002" x-target-ids="t005" x-target="as" x-target-head="t005" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.2TI.2.3.003" x-align="2TI.2.3.a003" x-target-ids="t007" x-target="good" x-target-head="t007" x-head="true" lemma="καλός" strong="G2570" x-morph="A-NSM" x-gloss="[a] good" x-translit="kalos" xml:lang="grc">καλὸς</char> <char style="w" x-id="SBLGNT.2TI.2.3.004" x-align="2TI.2.3.a004" x-target-ids="t006 t008" x-target="a soldier" x-target-head="t008" x-head="true" lemma="στρατιώτης" strong="G4757" x-morph="N-NSM" x-gloss="soldier" x-translit="stratiōtēs" xml:lang="grc">στρατιώτης</char> <char style="w" x-id="SBLGNT.2TI.2.3.005" x-align="2TI.2.3.a005" x-target-ids="t009 t010" x-target="of Christ" x-target-head="t010" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-GSM" x-gloss="of Christ" x-translit="Christou" xml:lang="grc">Χριστοῦ</char> <char style="w" x-id="SBLGNT.2TI.2.3.006" x-align="2TI.2.3.a006" x-target-ids="t011" x-target="Jesus" x-target-head="t011" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-GSM" x-gloss="Jesus" x-translit="Iēsou" xml:lang="grc">Ἰησοῦ</char>.<verse eid="2TI 2:3" /></para>
	<para style="p"><verse number="4" style="v" x-ref="2TI.2.4" sid="2TI 2:4" /><char style="w" x-id="SBLGNT.2TI.2.4.001" x-align="2TI.2.4.a001" x-target-ids="t001" x-target="No" x-target-head="t001" x-head="true" lemma="οὐδείς" strong="G3762" x-morph="A-NSM-N" x-gloss="No one" x-translit="oudeis" xml:lang="grc">οὐδεὶς</char> <char style="w" x-id="SBLGNT.2TI.2.4.002" x-align="2TI.2.4.a002" x-target-ids="t002 t003 t004" x-target="soldier on service" x-target-head="t004" x-head="true" lemma="στρατεύομαι" strong="G4754" x-morph="V-PMP-NSM" x-gloss="serving as a soldier" x-translit="strateuomenos" xml:lang="grc">στρατευόμενος</char> <char style="w" x-id="SBLGNT.2TI.2.4.003" x-align="2TI.2.4.a003" x-target-ids="t005 t006" x-target="entangleth himself" x-target-head="t005" x-head="true" lemma="ἐμπλέκομαι" strong="G1707" x-morph="V-PPI-3S" x-gloss="entangles himself" x-translit="empleketai" xml:lang="grc">ἐμπλέκεται</char> <char style="w" x-id="SBLGNT.2TI.2.4.004" x-align="2TI.2.4.a004" x-target-ids="t007 t008" x-target="in the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPF" x-gloss="in the" x-translit="tais" xml:lang="grc">ταῖς</char> <char style="w" x-id="SBLGNT.2TI.2.4.005" x-align="2TI.2.4.a005" x-target-ids="t010 t011" x-target="of this" x-target-italic-ids="t011" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="of this" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.2TI.2.4.006" x-align="2TI.2.4.a006" x-target-ids="t012" x-target="life" x-target-head="t012" x-head="true" lemma="βίος" strong="G979" x-morph="N-GSM" x-gloss="life" x-translit="biou" xml:lang="grc">βίου</char> <char style="w" x-id="SBLGNT.2TI.2.4.007" x-align="2TI.2.4.a007" x-target-ids="t009" x-target="affairs" x-target-head="t009" x-head="true" lemma="πραγματεία" strong="G4230" x-morph="N-DPF" x-gloss="affairs" x-translit="pragmateiais" xml:lang="grc">πραγματείαις</char>,<char style="w" x-id="SBLGNT.2TI.2.4.008" x-ali