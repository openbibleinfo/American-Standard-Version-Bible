	<para style="p"><verse number="1" style="v" x-ref="2TI.2.1" sid="2TI 2:1" /><char style="w" x-id="SBLGNT.2TI.2.1.001" x-align="2TI.2.1.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="σύ" strong="G4771" x-morph="P-2NS" x-gloss="You" x-translit="Sy" xml:lang="grc">Σὺ</char> <char style="w" x-id="SBLGNT.2TI.2.1.002" x-align="2TI.2.1.a002" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char>,<char style="w" x-id="SBLGNT.2TI.2.1.003" x-align="2TI.2.1.a003" x-target-ids="t004" x-target="child" x-target-head="t004" x-head="true" lemma="τέκνον" strong="G5043" x-morph="N-VSN" x-gloss="child" x-translit="teknon" xml:lang="grc">τέκνον</char> <char style="w" x-id="SBLGNT.2TI.2.1.004" x-align="2TI.2.1.a004" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of me" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.2TI.2.1.005" x-align="2TI.2.1.a005" x-target-ids="t005 t006" x-target="be strengthened" x-target-head="t006" x-head="true" lemma="ἐνδυναμόω" strong="G1743" x-morph="V-PPM-2S" x-gloss="be strong" x-translit="endynamou" xml:lang="grc">ἐνδυναμοῦ</char> <char style="w" x-id="SBLGNT.2TI.2.1.006" x-align="2TI.2.1.a006" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2TI.2.1.007" x-align="2TI.2.1.a007" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.2TI.2.1.008" x-align="2TI.2.1.a008" x-target-ids="t009" x-target="grace" x-target-head="t009" x-head="true" lemma="χάρις" strong="G5485" x-morph="N-DSF" x-gloss="grace" x-translit="chariti" x