	<para style="p"><verse number="2" style="v" x-ref="2TI.3.2" sid="2TI 3:2" /><char style="w" x-id="SBLGNT.2TI.3.2.001" x-align="2TI.3.2.a001" x-target-ids="t003 t004" x-target="shall be" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2071" x-morph="V-FDI-3P" x-gloss="Will be" x-translit="esontai" xml:lang="grc">ἔσονται</char> <char style="w" x-id="SBLGNT.2TI.3.2.002" x-align="2TI.3.2.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2TI.3.2.003" x-align="2TI.3.2.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.2TI.3.2.004" x-align="2TI.3.2.a004" x-target-ids="t002" x-target="men" x-target-head="t002" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-NPM" x-gloss="men" x-translit="anthrōpoi" xml:lang="grc">ἄνθρωποι</char> <char style="w" x-id="SBLGNT.2TI.3.2.005" x-align="2TI.3.2.a005" x-target-ids="t005 t006 t007" x-target="lovers of self" x-target-head="t005" x-head="true" lemma="φίλαυτος" strong="G5367" x-morph="A-NPM" x-gloss="lovers of self" x-translit="philautoi" xml:lang="grc">φίλαυτοι</char>,<char style="w" x-id="SBLGNT.2TI.3.2.006" x-align="2TI.3.2.a006" x-target-ids="t008 t009 t010" x-target="lovers of money" x-target-head="t008" x-head="true" lemma="φιλάργυρος" strong="G5366" x-morph="A-NPM" x-gloss="lovers of money" x-translit="philargyroi" xml:lang="grc">φιλάργυροι</char>,<char style="w" x-id="SBLGNT.2TI.3.2.007" x-align="2TI.3.2.a007" x-target-ids="t011" x-target="boastful" x-target-head="t011" x-head="true" lemma="ἀλαζών" strong="G213" x-morph="N-NPM" x-gloss="boastful" x-translit="alazones" xml:lang="grc">ἀλαζόνες</char>,<char style="w" x-id="SBLGNT.2TI.3.2.008" x-align="2TI.3.2.a008" x-target-ids="t012" x-target="haughty" x-target-head="t012" x-head="true" lemma="ὑπ