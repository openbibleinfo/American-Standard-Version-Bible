	<para style="p"><verse number="1" style="v" x-ref="2TI.3.1" sid="2TI 3:1" /><char style="w" x-id="SBLGNT.2TI.3.1.001" x-align="2TI.3.1.a001" x-target-ids="t003" x-target="this" x-target-head="t003" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="This" x-translit="Touto" xml:lang="grc">Τοῦτο</char> <char style="w" x-id="SBLGNT.2TI.3.1.002" x-align="2TI.3.1.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.2TI.3.1.003" x-align="2TI.3.1.a003" x-target-ids="t002" x-target="know" x-target-head="t002" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-PAM-2S" x-gloss="realize" x-translit="ginōske" xml:lang="grc">γίνωσκε</char> <char style="w" x-id="SBLGNT.2TI.3.1.004" x-align="2TI.3.1.a004" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.2TI.3.1.005" x-align="2TI.3.1.a005" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2TI.3.1.006" x-align="2TI.3.1.a006" x-target-ids="t007" x-target="last" x-target-head="t007" x-head="true" lemma="ἔσχατος" strong="G2078" x-morph="A-DPF-S" x-gloss="[the] last" x-translit="eschatais" xml:lang="grc">ἐσχάταις</char> <char style="w" x-id="SBLGNT.2TI.3.1.007" x-align="2TI.3.1.a007" x-target-ids="t006 t008" x-target="the days" x-target-head="t008" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-DPF" x-gloss="days" x-translit="hēmerais" xml:lang="grc">ἡμέραις</char> <char style="w" x-id="SBLGNT.2TI.3.1.008" x-align="2TI.3.1.a008" x-target-ids="t011 t012" x-target="shall come" x-target-head="t012" x-head="true" lemma="ἐνίστημι" strong="G1764" x-morph="V-FDI-3P" x-gloss="