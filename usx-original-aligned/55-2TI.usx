	<para style="p"><verse number="13" style="v" x-ref="2TI.2.13" sid="2TI 2:13" /><char style="w" x-id="SBLGNT.2TI.2.13.001" x-align="2TI.2.13.a001" x-target-ids="t001" x-target="if" x-target-head="t001" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.2TI.2.13.002" x-align="2TI.2.13.a002" x-target-ids="t002 t003 t004" x-target="we are faithless" x-target-head="t004" x-head="true" lemma="ἀπιστέω" strong="G569" x-morph="V-PAI-1P" x-gloss="we are faithless" x-translit="apistoumen" xml:lang="grc">ἀπιστοῦμεν</char>,<char style="w" x-id="SBLGNT.2TI.2.13.003" x-align="2TI.2.13.a003" x-target-ids="t005" x-target="he" x-target-head="t005" x-head="true" lemma="ἐκεῖνος" strong="G1565" x-morph="D-NSM" x-gloss="He" x-translit="ekeinos" xml:lang="grc">ἐκεῖνος</char> <char style="w" x-id="SBLGNT.2TI.2.13.004" x-align="2TI.2.13.a004" x-target-ids="t007" x-target="faithful" x-target-head="t007" x-head="true" lemma="πιστός" strong="G4103" x-morph="A-NSM" x-gloss="faithful" x-translit="pistos" xml:lang="grc">πιστὸς</char> <char style="w" x-id="SBLGNT.2TI.2.13.005" x-align="2TI.2.13.a005" x-target-ids="t006" x-target="abideth" x-target-head="t006" x-head="true" lemma="μένω" strong="G3306" x-morph="V-PAI-3S" x-gloss="remains" x-translit="menei" xml:lang="grc">μένει</char>·<char style="w" x-id="SBLGNT.2TI.2.13.006" x-align="2TI.2.13.a006" x-target-ids="t011" x-target="deny" x-target-head="t011" x-head="true" lemma="ἀρνέομαι" strong="G720" x-morph="V-ADN" x-gloss="to deny" x-translit="arnēsasthai" xml:lang="grc">ἀρνήσασθαι</char> <char style="w" x-id="SBLGNT.2TI.2.13.v006.r01.001" x-align="2TI.2.13.a007" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2TI.2.13.007" x-align="2TI.2.13.a008" x-target-ids="t012" x-target="himself" x-target-head="t012" x-head=