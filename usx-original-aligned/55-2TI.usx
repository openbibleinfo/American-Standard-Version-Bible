	<para style="p"><verse number="9" style="v" x-ref="2TI.2.9" sid="2TI 2:9" /><char style="w" x-id="SBLGNT.2TI.2.9.001" x-align="2TI.2.9.a001" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2TI.2.9.002" x-align="2TI.2.9.a001" x-target-ids="t001" x-target="wherein" x-target-head="t001" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-DSN" x-gloss="which" x-translit="hōi" xml:lang="grc">ᾧ</char> <char style="w" x-id="SBLGNT.2TI.2.9.003" x-align="2TI.2.9.a002" x-target-ids="t002 t003 t004" x-target="I suffer hardship" x-target-head="t003" x-head="true" lemma="κακοπαθέω" strong="G2553" x-morph="V-PAI-1S" x-gloss="I suffer hardship" x-translit="kakopathō" xml:lang="grc">κακοπαθῶ</char> <char style="w" x-id="SBLGNT.2TI.2.9.004" x-align="2TI.2.9.a003" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="μέχρι(ς)" strong="G3360" x-morph="ADV" x-gloss="even to" x-translit="mechri" xml:lang="grc">μέχρι</char> <char style="w" x-id="SBLGNT.2TI.2.9.005" x-align="2TI.2.9.a004" x-target-ids="t006" x-target="bonds" x-target-head="t006" x-head="true" lemma="δεσμός" strong="G1199" x-morph="N-GPM" x-gloss="chains" x-translit="desmōn" xml:lang="grc">δεσμῶν</char> <char style="w" x-id="SBLGNT.2TI.2.9.006" x-align="2TI.2.9.a005" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.2TI.2.9.007" x-align="2TI.2.9.a006" x-target-ids="t008 t009" x-target="a malefactor" x-target-head="t009" x-head="true" lemma="κακοῦργος" strong="G2557" x-morph="A-NSM" x-gloss="an evildoer" x-translit="kakourgos" xml:lang="grc">κακοῦργος</char>.<char style="w" x-id="SBLGNT.2TI.2.9.008" x-align="2TI.2.9.a007" x-target-ids="t010" x-target="but" x-target-head="t010" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="alla" xml:lang="grc">ἀλλὰ</c