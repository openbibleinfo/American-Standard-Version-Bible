	<para style="p"><verse number="5" style="v" x-ref="2TI.2.5" sid="2TI 2:5" /><char style="w" x-id="SBLGNT.2TI.2.5.001" x-align="2TI.2.5.a001" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="If" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.2TI.2.5.002" x-align="2TI.2.5.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.2TI.2.5.003" x-align="2TI.2.5.a003" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2TI.2.5.004" x-align="2TI.2.5.a004" x-target-ids="t006 t007 t008 t009" x-target="contend in the games" x-target-head="t006" x-head="true" lemma="ἀθλέω" strong="G118" x-morph="V-PAS-3S" x-gloss="competes" x-translit="athlēi" xml:lang="grc">ἀθλῇ</char> <char style="w" x-id="SBLGNT.2TI.2.5.005" x-align="2TI.2.5.a005" x-target-ids="t004 t005" x-target="a man" x-target-head="t005" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char>,<char style="w" x-id="SBLGNT.2TI.2.5.006" x-align="2TI.2.5.a006" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.2TI.2.5.007" x-align="2TI.2.5.a007" x-target-ids="t010 t011 t013" x-target="he is crowned" x-target-head="t013" x-head="true" lemma="στεφανόω" strong="G4737" x-morph="V-PPI-3S" x-gloss="he is crowned" x-translit="stephanoutai" xml:lang="grc">στεφανοῦται</char> <char style="w" x-id="SBLGNT.2TI.2.5.008" x-align="2TI.2.5.a008" x-status="noncompositional" x-target-ids="t014" x-target="except" x-target-head="t014" x-head="true" lemma="ἐάν"