	<para style="p"><verse number="8" style="v" x-ref="2TI.2.8" sid="2TI 2:8" /><char style="w" x-id="SBLGNT.2TI.2.8.001" x-align="2TI.2.8.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="μνημονεύω" strong="G3421" x-morph="V-PAM-2S" x-gloss="Remember" x-translit="Mnēmoneue" xml:lang="grc">Μνημόνευε</char> <char style="w" x-id="SBLGNT.2TI.2.8.002" x-align="2TI.2.8.a002" x-target-ids="t002" x-target="Jesus" x-target-head="t002" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-ASM" x-gloss="Jesus" x-translit="Iēsoun" xml:lang="grc">Ἰησοῦν</char> <char style="w" x-id="SBLGNT.2TI.2.8.003" x-align="2TI.2.8.a003" x-target-ids="t003" x-target="Christ" x-target-head="t003" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-ASM" x-gloss="Christ" x-translit="Christon" xml:lang="grc">Χριστὸν</char> <char style="w" x-id="SBLGNT.2TI.2.8.004" x-align="2TI.2.8.a004" x-target-ids="t004" x-target="risen" x-target-head="t004" x-head="true" lemma="ἐγείρω" strong="G1453" x-morph="V-RPP-ASM" x-gloss="having been raised" x-translit="egēgermenon" xml:lang="grc">ἐγηγερμένον</char> <char style="w" x-id="SBLGNT.2TI.2.8.005" x-align="2TI.2.8.a005" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="out from" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.2TI.2.8.006" x-align="2TI.2.8.a006" x-target-ids="t006 t007" x-target="the dead" x-target-head="t007" x-head="true" lemma="νεκρός" strong="G3498" x-morph="A-GPM" x-gloss="[the] dead" x-translit="nekrōn" xml:lang="grc">νεκρῶν</char>,<char style="w" x-id="SBLGNT.2TI.2.8.007" x-align="2TI.2.8.a007" x-target-ids="t008" x-target="of" x-target-head="t008" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="of [the]" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.2TI.2.8.008" x-align="2TI.2.8.a008" x-target-ids="t009 t010" x-target="the seed" x-target-head="t010" x-head="true" le