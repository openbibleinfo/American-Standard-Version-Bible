	<para style="p"><verse number="5" style="v" x-ref="ROM.1.5" sid="ROM 1:5" /><char style="w" x-id="SBLGNT.ROM.1.5.001" x-align="ROM.1.5.a001" x-target-ids="t001" x-target="through" x-target-head="t001" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="through" x-translit="di" xml:lang="grc">δι</char>ʼ<char style="w" x-id="SBLGNT.ROM.1.5.002" x-align="ROM.1.5.a002" x-target-ids="t002" x-target="whom" x-target-head="t002" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-GSM" x-gloss="whom" x-translit="hou" xml:lang="grc">οὗ</char> <char style="w" x-id="SBLGNT.ROM.1.5.003" x-align="ROM.1.5.a003" x-target-ids="t003 t004" x-target="we received" x-target-head="t004" x-head="true" lemma="λαμβάνω" strong="G2983" x-morph="V-2AAI-1P" x-gloss="we have received" x-translit="elabomen" xml:lang="grc">ἐλάβομεν</char> <char style="w" x-id="SBLGNT.ROM.1.5.004" x-align="ROM.1.5.a004" x-target-ids="t005" x-target="grace" x-target-head="t005" x-head="true" lemma="χάρις" strong="G5485" x-morph="N-ASF" x-gloss="grace" x-translit="charin" xml:lang="grc">χάριν</char> <char style="w" x-id="SBLGNT.ROM.1.5.005" x-align="ROM.1.5.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.ROM.1.5.006" x-align="ROM.1.5.a006" x-target-ids="t007" x-target="apostleship" x-target-head="t007" x-head="true" lemma="ἀποστολή" strong="G651" x-morph="N-ASF" x-gloss="apostleship" x-translit="apostolēn" xml:lang="grc">ἀποστολὴν</char> <char style="w" x-id="SBLGNT.ROM.1.5.007" x-align="ROM.1.5.a007" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="unto" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.ROM.1.5.008" x-align="ROM.1.5.a008" x-target-ids="t009" x-target="obedience" x-target-head="t009" x-head="true" lemma="ὑπακοή" strong="G5218" x-morph="N-ASF"