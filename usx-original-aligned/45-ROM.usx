	<para style="p"><verse number="2" style="v" x-ref="ROM.1.2" sid="ROM 1:2" /><char style="w" x-id="SBLGNT.ROM.1.2.001" x-align="ROM.1.2.a001" x-target-ids="t001" x-target="which" x-target-head="t001" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-ASN" x-gloss="which" x-translit="ho" xml:lang="grc">ὃ</char> <char style="w" x-id="SBLGNT.ROM.1.2.002" x-align="ROM.1.2.a002" x-target-ids="t002 t003 t004" x-target="he promised afore" x-target-head="t003" x-head="true" lemma="προεπαγγέλλομαι" strong="G4279" x-morph="V-ADI-3S" x-gloss="He promised beforehand" x-translit="proepēngeilato" xml:lang="grc">προεπηγγείλατο</char> <char style="w" x-id="SBLGNT.ROM.1.2.003" x-align="ROM.1.2.a003" x-target-ids="t005" x-target="through" x-target-head="t005" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="through" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.ROM.1.2.004" x-align="ROM.1.2.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.ROM.1.2.005" x-align="ROM.1.2.a005" x-target-ids="t007" x-target="prophets" x-target-head="t007" x-head="true" lemma="προφήτης" strong="G4396" x-morph="N-GPM" x-gloss="prophets" x-translit="prophētōn" xml:lang="grc">προφητῶν</char> <char style="w" x-id="SBLGNT.ROM.1.2.006" x-align="ROM.1.2.a006" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.ROM.1.2.007" x-align="ROM.1.2.a007" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.ROM.1.2.008" x-align="ROM.1.2.a008" x-target-ids="t009 t011" x-target="the scriptures" x-target-head="t011" x-head="true" lemma="γραφή" strong="G1124" x-morph="N-DPF" 