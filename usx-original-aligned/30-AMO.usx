	<para style="p"><verse number="8" style="v" x-ref="AMO.6.8" sid="AMO 6:8" /><char style="w" x-id="WLC.AMO.6.8.001" x-align="AMO.6.8.a001" x-target-ids="t004 t005" x-target="hath sworn" x-target-head="t005" x-head="true" lemma="שָׁבַע" strong="H7650" x-morph="VNp3ms" x-gloss="he.has.sworn" x-translit="nišbaʿ" xml:lang="hbo">נִשְׁבַּע֩</char> <char style="w" x-id="WLC.AMO.6.8.002" x-align="AMO.6.8.a002" x-target-ids="t001 t002" x-target="The Lord" x-target-head="t002" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֨</char><char style="w" x-id="WLC.AMO.6.8.003" x-align="AMO.6.8.a003" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.AMO.6.8.004" x-align="AMO.6.8.a004" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יְהֹוִה" strong="H3069" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwih" xml:lang="hbo">יְהוִ֜ה</char> <char style="w" x-id="WLC.AMO.6.8.005" x-align="AMO.6.8.a005" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.AMO.6.8.006" x-align="AMO.6.8.a006" x-status="noncompositional" x-target-ids="t007" x-target="himself" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשׁ֗</char><char style="w" x-id="WLC.AMO.6.8.007" x-align="AMO.6.8.a006" x-status="noncompositional" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.AMO.6.8.008" x-align="AMO.6.8.a007" x-target-ids="t008" x-target="saith" x-target-head="t008" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum-" xml:lang="hbo">נְאֻם</char>־<char style="w" x-i