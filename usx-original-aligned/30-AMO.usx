	<para style="p"><verse number="2" style="v" x-ref="AMO.9.2" sid="AMO 9:2" /><char style="w" x-id="WLC.AMO.9.2.001" x-align="AMO.9.2.a001" x-target-ids="t001" x-target="Though" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.AMO.9.2.002" x-align="AMO.9.2.a002" x-target-ids="t002 t003" x-target="they dig" x-target-head="t003" x-head="true" lemma="חָתַר" strong="H2864" x-morph="Vqi3mp" x-gloss="they.will.dig" x-translit="yaḥtərû" xml:lang="hbo">יַחְתְּר֣וּ</char> <char style="w" x-id="WLC.AMO.9.2.003" x-align="AMO.9.2.a003" x-target-ids="t004" x-target="into" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.AMO.9.2.004" x-align="AMO.9.2.a004" x-target-ids="t005" x-target="Sheol" x-target-head="t005" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="Sheol" x-translit="šəʾôl" xml:lang="hbo">שְׁא֔וֹל</char> <char style="w" x-id="WLC.AMO.9.2.005" x-align="AMO.9.2.a005" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.AMO.9.2.006" x-align="AMO.9.2.a005" x-target-ids="t006" x-target="thence" x-target-head="t006" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="there" x-translit="ššām" xml:lang="hbo">שָּׁ֖ם</char> <char style="w" x-id="WLC.AMO.9.2.007" x-align="AMO.9.2.a006" x-target-ids="t009" x-target="hand" x-target-head="t009" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָדִ֣</char><char style="w" x-id="WLC.AMO.9.2.008" x-align="AMO.9.2.a007" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.AMO.9.2.009" x-align="AMO.9.2.a008" x-target-ids="t007 t010" x-target="sh