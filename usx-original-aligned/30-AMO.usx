	<para style="p"><verse number="17" style="v" x-ref="AMO.5.17" sid="AMO 5:17" /><char style="w" x-id="WLC.AMO.5.17.001" x-align="AMO.5.17.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.AMO.5.17.002" x-align="AMO.5.17.a002" x-target-ids="t002 t005 t006" x-target="in shall be" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[will" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.AMO.5.17.003" x-align="AMO.5.17.a003" x-target-ids="t003" x-target="all" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="be].in.all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.AMO.5.17.004" x-align="AMO.5.17.a004" x-target-ids="t004" x-target="vineyards" x-target-head="t004" x-head="true" lemma="כֶּרֶם" strong="H3754" x-morph="Ncbpa" x-gloss="[the].vineyards" x-translit="kərāmiym" xml:lang="hbo">כְּרָמִ֖ים</char> <char style="w" x-id="WLC.AMO.5.17.005" x-align="AMO.5.17.a005" x-target-ids="t007" x-target="wailing" x-target-head="t007" x-head="true" lemma="מִסְפֵּד" strong="H4553" x-morph="Ncmsa" x-gloss="wailing" x-translit="mispēḏ" xml:lang="hbo">מִסְפֵּ֑ד</char> <char style="w" x-id="WLC.AMO.5.17.006" x-align="AMO.5.17.a006" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.AMO.5.17.007" x-align="AMO.5.17.a007" x-target-ids="t009 t010 t011" x-target="I will pass" x-target-head="t011" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqi1cs" x-gloss="I.will.pass" x-translit="ʾeʿĕḇōr" xml:lang="hbo">אֶעֱבֹ֥ר</char> <char style="w" x-id="WLC.AMO.5.17.008" x-align="AMO.5.17.a008" x-target-ids="t012" x-target="through" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="