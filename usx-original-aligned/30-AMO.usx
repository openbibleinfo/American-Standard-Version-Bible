	<para style="p"><verse number="7" style="v" x-ref="AMO.6.7" sid="AMO 6:7" /><char style="w" x-id="WLC.AMO.6.7.001" x-align="AMO.6.7.a001" x-status="noncompositional" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.AMO.6.7.002" x-align="AMO.6.7.a001" x-status="noncompositional" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֛ן</char> <char style="w" x-id="WLC.AMO.6.7.003" x-align="AMO.6.7.a002" x-target-ids="t004" x-target="now" x-target-head="t004" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֥ה</char> <char style="w" x-id="WLC.AMO.6.7.004" x-align="AMO.6.7.a003" x-target-ids="t002 t003 t005 t006" x-target="shall they go captive" x-target-head="t006" x-head="true" lemma="גָּלָה" strong="H1540" x-morph="Vqi3mp" x-gloss="they.will.go.into.exile" x-translit="yiḡlû" xml:lang="hbo">יִגְל֖וּ</char> <char style="w" x-id="WLC.AMO.6.7.005" x-align="AMO.6.7.a004" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.AMO.6.7.006" x-align="AMO.6.7.a005" x-target-ids="t008 t009" x-target="the first" x-target-head="t009" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsa" x-gloss="head" x-translit="rōʾš" xml:lang="hbo">רֹ֣אשׁ</char> <char style="w" x-id="WLC.AMO.6.7.007" x-align="AMO.6.7.a006" x-target-ids="t010 t011 t012" x-target="that go captive" x-target-head="t012" x-head="true" lemma="גָּלָה" strong="H1540" x-morph="Vqrmpa" x-gloss="of.[those.who].go.into.exile" x-translit="gōliym" xml:lang="hbo">גֹּלִ֑ים</char> <char style="w" x-id="WLC.AMO.6.7.008" x-align="AMO.6.7.a007" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-g