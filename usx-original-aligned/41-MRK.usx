	<para style="p"><verse number="25" style="v" x-ref="MRK.5.25" sid="MRK 5:25" /><char style="w" x-id="SBLGNT.MRK.5.25.001" x-align="MRK.5.25.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.5.25.002" x-align="MRK.5.25.a002" x-target-ids="t002 t003" x-target="a woman" x-target-head="t003" x-head="true" lemma="γυνή" strong="G1135" x-morph="N-NSF" x-gloss="a woman" x-translit="gynē" xml:lang="grc">γυνὴ</char> <char style="w" x-id="SBLGNT.MRK.5.25.003" x-align="MRK.5.25.a003" x-target-ids="t004 t005" x-target="who had" x-target-head="t005" x-head="true" lemma="εἰμί" strong="G5607" x-morph="V-PAP-NSF" x-gloss="being" x-translit="ousa" xml:lang="grc">οὖσα</char> <char style="w" x-id="SBLGNT.MRK.5.25.004" x-align="MRK.5.25.a004" x-status="unrepresented" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="with" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.MRK.5.25.005" x-align="MRK.5.25.a005" x-target-ids="t006 t007" x-target="an issue" x-target-head="t007" x-head="true" lemma="ῥύσις" strong="G4511" x-morph="N-DSF" x-gloss="a flux" x-translit="rhysei" xml:lang="grc">ῥύσει</char> <char style="w" x-id="SBLGNT.MRK.5.25.006" x-align="MRK.5.25.a006" x-target-ids="t008 t009" x-target="of blood" x-target-head="t009" x-head="true" lemma="αἷμα" strong="G129" x-morph="N-GSN" x-gloss="of blood" x-translit="haimatos" xml:lang="grc">αἵματος</char> <char style="w" x-id="SBLGNT.MRK.5.25.007" x-align="MRK.5.25.a007" x-target-ids="t010" x-target="twelve" x-target-head="t010" x-head="true" lemma="δώδεκα" strong="G1427" x-morph="A-NUI" x-gloss="twelve" x-translit="dōdeka" xml:lang="grc">δώδεκα</char> <char style="w" x-id="SBLGNT.MRK.5.25.008" x-align="MRK.5.25.a008" x-target-ids="t011" x-target="years" x-target-head="t011" x-head="true" lemma="ἔτος" strong="G2094" x-morph="N-APN" x-gloss="years" x-tr