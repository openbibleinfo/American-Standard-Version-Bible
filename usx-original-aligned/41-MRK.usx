	<para style="p"><verse number="40" style="v" x-ref="MRK.10.40" sid="MRK 10:40" /><char style="w" x-id="SBLGNT.MRK.10.40.001" x-align="MRK.10.40.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MRK.10.40.002" x-align="MRK.10.40.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="but" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MRK.10.40.003" x-align="MRK.10.40.a003" x-target-ids="t002 t003" x-target="to sit" x-target-head="t003" x-head="true" lemma="καθίζω" strong="G2523" x-morph="V-AAN" x-gloss="to sit" x-translit="kathisai" xml:lang="grc">καθίσαι</char> <char style="w" x-id="SBLGNT.MRK.10.40.004" x-align="MRK.10.40.a004" x-target-ids="t004" x-target="on" x-target-head="t004" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="at" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.MRK.10.40.005" x-align="MRK.10.40.a006" x-target-ids="t006 t007" x-target="right hand" x-target-head="t006" x-head="true" lemma="δεξιός" strong="G1188" x-morph="A-GPN" x-gloss="[the] right hand" x-translit="dexiōn" xml:lang="grc">δεξιῶν</char> <char style="w" x-id="SBLGNT.MRK.10.40.006" x-align="MRK.10.40.a005" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of Me" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.MRK.10.40.007" x-align="MRK.10.40.a007" x-target-ids="t008" x-target="or" x-target-head="t008" x-head="true" lemma="ἤ" strong="G2228" x-morph="PRT" x-gloss="or" x-translit="ē" xml:lang="grc">ἢ</char> <char style="w" x-id="SBLGNT.MRK.10.40.008" x-align="MRK.10.40.a008" x-target-ids="t009" x-target="on" x-target-head="t009" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="at" x-translit="ex" xml:lang="grc">ἐξ</char> <char style