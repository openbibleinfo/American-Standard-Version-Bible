ας" strong="G537" x-morph="A-ASM" x-gloss="all" x-translit="hapanta" xml:lang="grc">ἅπαντα</char> <char style="w" x-id="SBLGNT.MRK.16.15.009" x-align="MRK.16.15.a009" x-target-ids="t012 t013" x-target="and preach" x-target-head="t013" x-head="true" lemma="κηρύσσω" strong="G2784" x-morph="V-AAM-2P" x-gloss="proclaim" x-translit="kēryxate" xml:lang="grc">κηρύξατε</char> <char style="w" x-id="SBLGNT.MRK.16.15.010" x-align="MRK.16.15.a010" x-target-ids="t014" x-target="the" x-target-head="t014" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MRK.16.15.011" x-align="MRK.16.15.a011" x-target-ids="t015" x-target="gospel" x-target-head="t015" x-head="true" lemma="εὐαγγέλιον" strong="G2098" x-morph="N-ASN" x-gloss="gospel" x-translit="euangelion" xml:lang="grc">εὐαγγέλιον</char> <char style="w" x-id="SBLGNT.MRK.16.15.012" x-align="MRK.16.15.a012" x-target-ids="t018" x-target="whole" x-target-head="t018" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-DSF" x-gloss="to all" x-translit="pasēi" xml:lang="grc">πάσῃ</char> <char style="w" x-id="SBLGNT.MRK.16.15.013" x-align="MRK.16.15.a013" x-target-ids="t016 t017" x-target="to the" x-target-head="t017" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.MRK.16.15.014" x-align="MRK.16.15.a014" x-target-ids="t019" x-target="creation" x-target-head="t019" x-head="true" lemma="κτίσις" strong="G2937" x-morph="N-DSF" x-gloss="creation" x-translit="ktisei" xml:lang="grc">κτίσει</char>.<verse eid="MRK 16:15" /></para>
