	<para style="p"><verse number="32" style="v" x-ref="MRK.5.32" sid="MRK 5:32" /><char style="w" x-id="SBLGNT.MRK.5.32.001" x-align="MRK.5.32.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.5.32.002" x-align="MRK.5.32.a002" x-target-ids="t002 t003 t004 t005" x-target="he looked round about" x-target-head="t003" x-head="true" lemma="περιβλέπομαι" strong="G4017" x-morph="V-IMI-3S" x-gloss="He was looking around" x-translit="perieblepeto" xml:lang="grc">περιεβλέπετο</char> <char style="w" x-id="SBLGNT.MRK.5.32.003" x-align="MRK.5.32.a003" x-target-ids="t006 t007" x-target="to see" x-target-head="t007" x-head="true" lemma="ὁράω" strong="G3708" x-morph="V-2AAN" x-gloss="to see" x-translit="idein" xml:lang="grc">ἰδεῖν</char> <char style="w" x-id="SBLGNT.MRK.5.32.004" x-align="MRK.5.32.a004" x-target-ids="t008" x-target="her" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="the [one]" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.MRK.5.32.005" x-align="MRK.5.32.a005" x-target-ids="t012 t013" x-target="this thing" x-target-head="t012" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.MRK.5.32.006" x-align="MRK.5.32.a006" x-target-ids="t009 t010 t011" x-target="that had done" x-target-head="t011" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-AAP-ASF" x-gloss="having done" x-translit="poiēsasan" xml:lang="grc">ποιήσασαν</char>.<verse eid="MRK 5:32" /></para>
