	<para style="p"><verse number="24" style="v" x-ref="MRK.1.24" sid="MRK 1:24" /><char style="w" x-id="SBLGNT.MRK.1.24.001" x-align="MRK.1.24.a001" x-target-ids="t001" x-target="saying" x-target-head="t001" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.MRK.1.24.002" x-align="MRK.1.24.a002" x-target-ids="t002" x-target="What" x-target-head="t002" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSN" x-gloss="What" x-translit="Ti" xml:lang="grc">Τί</char> <char style="w" x-id="SBLGNT.MRK.1.24.003" x-align="MRK.1.24.a003" x-target-ids="t003 t004 t005 t006" x-target="have we to do" x-target-head="t004" x-head="true" lemma="ἐγώ" strong="G2254" x-morph="P-1DP" x-gloss="to us" x-translit="hēmin" xml:lang="grc">ἡμῖν</char> <char style="w" x-id="SBLGNT.MRK.1.24.004" x-align="MRK.1.24.a004" x-status="unrepresented" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.1.24.005" x-align="MRK.1.24.a005" x-target-ids="t007 t008" x-target="with thee" x-target-head="t008" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="to You" x-translit="soi" xml:lang="grc">σοί</char>,<char style="w" x-id="SBLGNT.MRK.1.24.006" x-align="MRK.1.24.a006" x-target-ids="t009" x-target="Jesus" x-target-head="t009" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-VSM" x-gloss="Jesus" x-translit="Iēsou" xml:lang="grc">Ἰησοῦ</char> <char style="w" x-id="SBLGNT.MRK.1.24.007" x-align="MRK.1.24.a007" x-target-ids="t010 t011" x-target="thou Nazarene" x-target-head="t011" x-head="true" lemma="Ναζαρηνός" strong="G3479" x-morph="A-VSM" x-gloss="of Nazareth" x-translit="Nazarēne" xml:lang="grc">Ναζαρηνέ</char>;<char style="w" x-id="SBLGNT.MRK.1.24.008" x-align="MRK.1.24.a008" x-target-ids="t012 t013 t014" x-target="art thou come" x-target-head="t014" x-head="true" lemma="ἔρχομαι" strong="G206