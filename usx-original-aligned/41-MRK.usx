	<para style="p"><verse number="8" style="v" x-ref="MRK.5.8" sid="MRK 5:8" /><char style="w" x-id="SBLGNT.MRK.5.8.001" x-align="MRK.5.8.a001" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-IAI-3S" x-gloss="He was saying" x-translit="elegen" xml:lang="grc">ἔλεγεν</char> <char style="w" x-id="SBLGNT.MRK.5.8.002" x-align="MRK.5.8.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.MRK.5.8.003" x-align="MRK.5.8.a003" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.MRK.5.8.004" x-align="MRK.5.8.a004" x-target-ids="t006 t007" x-target="Come forth" x-target-head="t006" x-head="true" lemma="ἐξέρχομαι" strong="G1831" x-morph="V-2AAM-2S" x-gloss="You come forth" x-translit="Exelthe" xml:lang="grc">Ἔξελθε</char> <char style="w" x-id="SBLGNT.MRK.5.8.005" x-align="MRK.5.8.a005" x-target-ids="t008" x-target="thou" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MRK.5.8.006" x-align="MRK.5.8.a006" x-target-ids="t010" x-target="spirit" x-target-head="t010" x-head="true" lemma="πνεῦμα" strong="G4151" x-morph="N-NSN" x-gloss="spirit" x-translit="pneuma" xml:lang="grc">πνεῦμα</char> <char style="w" x-id="SBLGNT.MRK.5.8.007" x-align="MRK.5.8.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MRK.5.8.008" x-align="MRK.5.8.a008" x-target-ids="t009" x-target="unclean" x-target-head="t009" x-head="true" lemma="ἀκάθαρτος" strong="G169" x-morph="A-NSN" x-gloss="unclean" x-translit="a