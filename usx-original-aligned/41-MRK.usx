	<para style="p"><verse number="41" style="v" x-ref="MRK.10.41" sid="MRK 10:41" /><char style="w" x-id="SBLGNT.MRK.10.41.001" x-align="MRK.10.41.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.MRK.10.41.002" x-align="MRK.10.41.a002" x-target-ids="t002 t005 t006" x-target="when heard it" x-target-head="t005" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="having heard [this]" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.MRK.10.41.003" x-align="MRK.10.41.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MRK.10.41.004" x-align="MRK.10.41.a004" x-target-ids="t004" x-target="ten" x-target-head="t004" x-head="true" lemma="δέκα" strong="G1176" x-morph="A-NUI" x-gloss="ten" x-translit="deka" xml:lang="grc">δέκα</char> <char style="w" x-id="SBLGNT.MRK.10.41.005" x-align="MRK.10.41.a005" x-target-ids="t007 t008" x-target="they began" x-target-head="t008" x-head="true" lemma="ἄρχω" strong="G756" x-morph="V-ADI-3P" x-gloss="began" x-translit="ērxanto" xml:lang="grc">ἤρξαντο</char> <char style="w" x-id="SBLGNT.MRK.10.41.006" x-align="MRK.10.41.a006" x-target-ids="t009 t010 t011 t012 t013" x-target="to be moved with indignation" x-target-head="t013" x-head="true" lemma="ἀγανακτέω" strong="G23" x-morph="V-PAN" x-gloss="to be indignant" x-translit="aganaktein" xml:lang="grc">ἀγανακτεῖν</char> <char style="w" x-id="SBLGNT.MRK.10.41.007" x-align="MRK.10.41.a007" x-target-ids="t014" x-target="concerning" x-target-head="t014" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="about" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.MRK.10.41.008" x-align="MRK.10.41.a008" x-target-id