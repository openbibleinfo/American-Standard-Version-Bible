	<para style="p"><verse number="23" style="v" x-ref="MRK.1.23" sid="MRK 1:23" /><char style="w" x-id="SBLGNT.MRK.1.23.001" x-align="MRK.1.23.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.1.23.002" x-align="MRK.1.23.a002" x-target-ids="t002" x-target="straightway" x-target-head="t002" x-head="true" lemma="εὐθύς" strong="G2117" x-morph="ADV" x-gloss="immediately" x-translit="euthys" xml:lang="grc">εὐθὺς</char> <char style="w" x-id="SBLGNT.MRK.1.23.003" x-align="MRK.1.23.a003" x-target-ids="t003 t004" x-target="there was" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="there was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.MRK.1.23.004" x-align="MRK.1.23.a004" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.MRK.1.23.005" x-align="MRK.1.23.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.MRK.1.23.006" x-align="MRK.1.23.a006" x-target-ids="t007" x-target="synagogue" x-target-head="t007" x-head="true" lemma="συναγωγή" strong="G4864" x-morph="N-DSF" x-gloss="synagogue" x-translit="synagōgēi" xml:lang="grc">συναγωγῇ</char> <char style="w" x-id="SBLGNT.MRK.1.23.007" x-align="MRK.1.23.a007" x-target-ids="t006" x-target="their" x-target-head="t006" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="of them" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.MRK.1.23.008" x-align="MRK.1.23.a008" x-target-ids="t008 t009" x-target="a man" x-target-head="t009" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-NSM" x-gloss="a man" x-translit="anth