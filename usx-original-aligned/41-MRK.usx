	<para style="p"><verse number="9" style="v" x-ref="MRK.5.9" sid="MRK 5:9" /><char style="w" x-id="SBLGNT.MRK.5.9.001" x-align="MRK.5.9.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.5.9.002" x-align="MRK.5.9.a002" x-target-ids="t002 t003" x-target="he asked" x-target-head="t003" x-head="true" lemma="ἐπερωτάω" strong="G1905" x-morph="V-IAI-3S" x-gloss="He was asking" x-translit="epērōta" xml:lang="grc">ἐπηρώτα</char> <char style="w" x-id="SBLGNT.MRK.5.9.003" x-align="MRK.5.9.a003" x-target-ids="t004" x-target="him" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="him" x-translit="auton" xml:lang="grc">αὐτόν</char>·<char style="w" x-id="SBLGNT.MRK.5.9.004" x-align="MRK.5.9.a004" x-target-ids="t005 t006" x-target="What is" x-target-head="t005" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSN" x-gloss="What [is]" x-translit="Ti" xml:lang="grc">Τί</char> <char style="w" x-id="SBLGNT.MRK.5.9.005" x-align="MRK.5.9.a005" x-target-ids="t008" x-target="name" x-target-head="t008" x-head="true" lemma="ὄνομα" strong="G3686" x-morph="N-NSN" x-gloss="[the] name" x-translit="onoma" xml:lang="grc">ὄνομά</char> <char style="w" x-id="SBLGNT.MRK.5.9.006" x-align="MRK.5.9.a006" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="of you" x-translit="soi" xml:lang="grc">σοι</char>;<char style="w" x-id="SBLGNT.MRK.5.9.007" x-align="MRK.5.9.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.5.9.008" x-align="MRK.5.9.a008" x-target-ids="t010 t011" x-target="he saith" x-target-head="t011" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-3S" x-gloss="saying" x