	<para style="p"><verse number="16" style="v" x-ref="MRK.10.16" sid="MRK 10:16" /><char style="w" x-id="SBLGNT.MRK.10.16.001" x-align="MRK.10.16.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.10.16.002" x-align="MRK.10.16.a002" x-target-ids="t002 t003 t005 t006 t007" x-target="he took in his arms" x-target-head="t003" x-head="true" lemma="ἐναγκαλίζομαι" strong="G1723" x-morph="V-ADP-NSM" x-gloss="having taken [them] in arms" x-translit="enankalisamenos" xml:lang="grc">ἐναγκαλισάμενος</char> <char style="w" x-id="SBLGNT.MRK.10.16.003" x-align="MRK.10.16.a003" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-APN" x-gloss="them" x-translit="auta" xml:lang="grc">αὐτὰ</char> <char style="w" x-id="SBLGNT.MRK.10.16.004" x-align="MRK.10.16.a004" x-target-ids="t008 t009 t010" x-target="and blessed them" x-target-head="t009" x-head="true" lemma="κατευλογέω" strong="G2127" x-morph="V-IAI-3S" x-gloss="He was blessing" x-translit="kateulogei" xml:lang="grc">κατευλόγει</char> <char style="w" x-id="SBLGNT.MRK.10.16.005" x-align="MRK.10.16.a005" x-target-ids="t011" x-target="laying" x-target-head="t011" x-head="true" lemma="τίθημι" strong="G5087" x-morph="V-PAP-NSM" x-gloss="having laid" x-translit="titheis" xml:lang="grc">τιθεὶς</char> <char style="w" x-id="SBLGNT.MRK.10.16.006" x-align="MRK.10.16.a006" x-target-ids="t012" x-target="his" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APF" x-gloss="the" x-translit="tas" xml:lang="grc">τὰς</char> <char style="w" x-id="SBLGNT.MRK.10.16.007" x-align="MRK.10.16.a007" x-target-ids="t013" x-target="hands" x-target-head="t013" x-head="true" lemma="χείρ" strong="G5495" x-morph="N-APF" x-gloss="hands" x-translit="cheiras" xml:lang="grc">χεῖρας</char> <char style="w" x-id="SBLGNT.MRK.10.16.008" x-ali