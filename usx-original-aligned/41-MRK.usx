	<para style="p"><verse number="11" style="v" x-ref="MRK.12.11" sid="MRK 12:11" /><char style="w" x-id="SBLGNT.MRK.12.11.001" x-align="MRK.12.11.a003" x-target-ids="t003" x-target="from" x-target-head="t003" x-head="true" lemma="παρά" strong="G3844" x-morph="PREP" x-gloss="from [the]" x-translit="para" xml:lang="grc">παρὰ</char> <char style="w" x-id="SBLGNT.MRK.12.11.002" x-align="MRK.12.11.a004" x-target-ids="t004 t005" x-target="the Lord" x-target-head="t005" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-GSM" x-gloss="Lord" x-translit="kyriou" xml:lang="grc">κυρίου</char> <char style="w" x-id="SBLGNT.MRK.12.11.003" x-align="MRK.12.11.a002" x-target-ids="t002" x-target="was" x-target-head="t002" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2ADI-3S" x-gloss="was" x-translit="egeneto" xml:lang="grc">ἐγένετο</char> <char style="w" x-id="SBLGNT.MRK.12.11.004" x-align="MRK.12.11.a001" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G3778" x-morph="D-NSF" x-gloss="this" x-translit="hautē" xml:lang="grc">αὕτη</char>,<char style="w" x-id="SBLGNT.MRK.12.11.005" x-align="MRK.12.11.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MRK.12.11.006" x-align="MRK.12.11.a006" x-target-ids="t007 t008" x-target="it is" x-target-head="t008" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="it is" x-translit="estin" xml:lang="grc">ἔστιν</char> <char style="w" x-id="SBLGNT.MRK.12.11.007" x-align="MRK.12.11.a007" x-target-ids="t009" x-target="marvellous" x-target-head="t009" x-head="true" lemma="θαυμαστός" strong="G2298" x-morph="A-NSF" x-gloss="marvelous" x-translit="thaumastē" xml:lang="grc">θαυμαστὴ</char> <char style="w" x-id="SBLGNT.MRK.12.11.008" x-align="MRK.12.11.a008" x-target-ids="t010" x-target="in" x-target-head="t010" x-head="true" lemma="ἐ