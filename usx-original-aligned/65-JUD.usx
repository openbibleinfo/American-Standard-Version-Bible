	<para style="p"><verse number="2" style="v" x-ref="JUD.1.2" sid="JUD 1:2" /><char style="w" x-id="SBLGNT.JUD.1.2.001" x-align="JUD.1.2.a001" x-target-ids="t001" x-target="Mercy" x-target-head="t001" x-head="true" lemma="ἔλεος" strong="G1656" x-morph="N-NSN" x-gloss="Mercy" x-translit="eleos" xml:lang="grc">ἔλεος</char> <char style="w" x-id="SBLGNT.JUD.1.2.002" x-align="JUD.1.2.a002" x-target-ids="t002 t003" x-target="unto you" x-target-head="t003" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.JUD.1.2.003" x-align="JUD.1.2.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JUD.1.2.004" x-align="JUD.1.2.a004" x-target-ids="t005" x-target="peace" x-target-head="t005" x-head="true" lemma="εἰρήνη" strong="G1515" x-morph="N-NSF" x-gloss="peace" x-translit="eirēnē" xml:lang="grc">εἰρήνη</char> <char style="w" x-id="SBLGNT.JUD.1.2.005" x-align="JUD.1.2.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JUD.1.2.006" x-align="JUD.1.2.a006" x-target-ids="t007" x-target="love" x-target-head="t007" x-head="true" lemma="ἀγάπη" strong="G26" x-morph="N-NSF" x-gloss="love" x-translit="agapē" xml:lang="grc">ἀγάπη</char> <char style="w" x-id="SBLGNT.JUD.1.2.007" x-align="JUD.1.2.a007" x-target-ids="t008 t009" x-target="be multiplied" x-target-head="t009" x-head="true" lemma="πληθύνω" strong="G4129" x-morph="V-APO-3S" x-gloss="be multiplied" x-translit="plēthyntheiē" xml:lang="grc">πληθυνθείη</char>.<verse eid="JUD 1:2" /></para>
