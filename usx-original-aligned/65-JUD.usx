	<para style="p"><verse number="22" style="v" x-ref="JUD.1.22" sid="JUD 1:22" /><char style="w" x-id="SBLGNT.JUD.1.22.001" x-align="JUD.1.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JUD.1.22.002" x-align="JUD.1.22.a002" x-target-ids="t002 t003" x-target="on some" x-target-head="t003" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-APM" x-gloss="those who" x-translit="hous" xml:lang="grc">οὓς</char> <char style="w" x-id="SBLGNT.JUD.1.22.003" x-align="JUD.1.22.a003" x-status="unrepresented" x-head="true" lemma="μέν" strong="G3303" x-morph="PRT" x-gloss="indeed" x-translit="men" xml:lang="grc">μὲν</char> <char style="w" x-id="SBLGNT.JUD.1.22.004" x-align="JUD.1.22.a004" x-target-ids="t004 t005" x-target="have mercy" x-target-head="t005" x-head="true" lemma="ἐλεάω" strong="G1653" x-morph="V-PAM-2P" x-gloss="have mercy on" x-translit="eleate" xml:lang="grc">ἐλεᾶτε</char> <char style="w" x-id="SBLGNT.JUD.1.22.005" x-align="JUD.1.22.a005" x-target-ids="t006 t007 t008 t009" x-target="who are in doubt" x-target-head="t009" x-head="true" lemma="διακρίνω" strong="G1252" x-morph="V-PMP-APM" x-gloss="are doubting" x-translit="diakrinomenous" xml:lang="grc">διακρινομένους</char>,<verse eid="JUD 1:22" /></para>
