	<para style="p"><verse number="20" style="v" x-ref="JUD.1.20" sid="JUD 1:20" /><char style="w" x-id="SBLGNT.JUD.1.20.001" x-align="JUD.1.20.a001" x-target-ids="t002" x-target="ye" x-target-head="t002" x-head="true" lemma="σύ" strong="G5210" x-morph="P-2NP" x-gloss="You" x-translit="hymeis" xml:lang="grc">ὑμεῖς</char> <char style="w" x-id="SBLGNT.JUD.1.20.002" x-align="JUD.1.20.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δέ</char>,<char style="w" x-id="SBLGNT.JUD.1.20.003" x-align="JUD.1.20.a003" x-target-ids="t003" x-target="beloved" x-target-head="t003" x-head="true" lemma="ἀγαπητός" strong="G27" x-morph="A-VPM" x-gloss="beloved" x-translit="agapētoi" xml:lang="grc">ἀγαπητοί</char>,<char style="w" x-id="SBLGNT.JUD.1.20.004" x-align="JUD.1.20.a004" x-target-ids="t004 t005" x-target="building up" x-target-head="t004" x-head="true" lemma="ἐποικοδομέω" strong="G2026" x-morph="V-PAP-NPM" x-gloss="building up" x-translit="epoikodomountes" xml:lang="grc">ἐποικοδομοῦντες</char> <char style="w" x-id="SBLGNT.JUD.1.20.005" x-align="JUD.1.20.a005" x-target-ids="t006" x-target="yourselves" x-target-head="t006" x-head="true" lemma="ἑαυτοῦ" strong="G1438" x-morph="F-2APM" x-gloss="yourselves" x-translit="heautous" xml:lang="grc">ἑαυτοὺς</char> <char style="w" x-id="SBLGNT.JUD.1.20.006" x-align="JUD.1.20.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="in the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.JUD.1.20.007" x-align="JUD.1.20.a007" x-target-ids="t009 t010" x-target="most holy" x-target-head="t010" x-head="true" lemma="ἅγιος" strong="G40" x-morph="A-DSF-S" x-gloss="most holy" x-translit="hagiōtatēi" xml:lang="grc">ἁγιωτάτῃ</char> <char style="w" x-id="SBLGNT.JUD.1.20.008" x-align="JUD.1.20.a008" x-target-ids="t008" x-target="your" x-target-head="t008" x-head="true" lemma="σύ" stro