	<para style="p"><verse number="1" style="v" x-ref="JUD.1.1" sid="JUD 1:1" /><char style="w" x-id="SBLGNT.JUD.1.1.001" x-align="JUD.1.1.a001" x-target-ids="t001" x-target="Jude" x-target-head="t001" x-head="true" lemma="Ἰούδας" strong="G2455" x-morph="N-NSM" x-gloss="Jude" x-translit="Ioudas" xml:lang="grc">Ἰούδας</char> <char style="w" x-id="SBLGNT.JUD.1.1.002" x-align="JUD.1.1.a003" x-target-ids="t004 t005" x-target="of Jesus" x-target-head="t005" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-GSM" x-gloss="of Jesus" x-translit="Iēsou" xml:lang="grc">Ἰησοῦ</char> <char style="w" x-id="SBLGNT.JUD.1.1.003" x-align="JUD.1.1.a004" x-target-ids="t006" x-target="Christ" x-target-head="t006" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-GSM" x-gloss="Christ" x-translit="Christou" xml:lang="grc">Χριστοῦ</char> <char style="w" x-id="SBLGNT.JUD.1.1.004" x-align="JUD.1.1.a002" x-target-ids="t002 t003" x-target="a servant" x-target-head="t003" x-head="true" lemma="δοῦλος" strong="G1401" x-morph="N-NSM" x-gloss="servant" x-translit="doulos" xml:lang="grc">δοῦλος</char>,<char style="w" x-id="SBLGNT.JUD.1.1.005" x-align="JUD.1.1.a006" x-target-ids="t008" x-target="brother" x-target-head="t008" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-NSM" x-gloss="brother" x-translit="adelphos" xml:lang="grc">ἀδελφὸς</char> <char style="w" x-id="SBLGNT.JUD.1.1.006" x-align="JUD.1.1.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.JUD.1.1.007" x-align="JUD.1.1.a007" x-target-ids="t009 t010" x-target="of James" x-target-head="t010" x-head="true" lemma="Ἰάκωβος" strong="G2385" x-morph="N-GSM" x-gloss="of James" x-translit="Iakōbou" xml:lang="grc">Ἰακώβου</char>,<char style="w" x-id="SBLGNT.JUD.1.1.008" x-align="JUD.1.1.a008" x-target-ids="t011 t012 t013" x-target="to them that" x-target-head="t012" x-head="true" lemma