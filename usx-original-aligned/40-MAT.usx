	<para style="p"><verse number="4" style="v" x-ref="MAT.27.4" sid="MAT 27:4" /><char style="w" x-id="SBLGNT.MAT.27.4.001" x-align="MAT.27.4.a001" x-target-ids="t001" x-target="saying" x-target-head="t001" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.MAT.27.4.002" x-align="MAT.27.4.a002" x-target-ids="t002 t003 t004" x-target="I have sinned" x-target-head="t004" x-head="true" lemma="ἁμαρτάνω" strong="G264" x-morph="V-2AAI-1S" x-gloss="I sinned" x-translit="Hēmarton" xml:lang="grc">Ἥμαρτον</char> <char style="w" x-id="SBLGNT.MAT.27.4.003" x-align="MAT.27.4.a003" x-target-ids="t005 t006 t007 t008" x-target="in that I betrayed" x-target-head="t008" x-head="true" lemma="παραδίδωμι" strong="G3860" x-morph="V-2AAP-NSM" x-gloss="having betrayed" x-translit="paradous" xml:lang="grc">παραδοὺς</char> <char style="w" x-id="SBLGNT.MAT.27.4.004" x-align="MAT.27.4.a005" x-target-ids="t010" x-target="blood" x-target-head="t010" x-head="true" lemma="αἷμα" strong="G129" x-morph="N-ASN" x-gloss="blood" x-translit="haima" xml:lang="grc">αἷμα</char> <char style="w" x-id="SBLGNT.MAT.27.4.005" x-align="MAT.27.4.a004" x-target-ids="t009" x-target="innocent" x-target-head="t009" x-head="true" lemma="ἀθῷος" strong="G121" x-morph="A-ASM" x-gloss="innocent" x-translit="athōion" xml:lang="grc">ἀθῷον</char>.<char style="w" x-id="SBLGNT.MAT.27.4.006" x-align="MAT.27.4.a007" x-target-ids="t012" x-target="they" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MAT.27.4.007" x-align="MAT.27.4.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="Then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.27.4.008" x-align="MAT.27.4.a008" x-target-ids="t013" x-target="said" x-target-head="t013" 