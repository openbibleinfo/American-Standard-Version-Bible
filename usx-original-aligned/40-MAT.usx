	<para style="p"><verse number="21" style="v" x-ref="MAT.21.21" sid="MAT 21:21" /><char style="w" x-id="SBLGNT.MAT.21.21.001" x-align="MAT.21.21.a001" x-target-ids="t003" x-target="answered" x-target-head="t003" x-head="true" lemma="ἀποκρίνομαι" strong="G611" x-morph="V-AOP-NSM" x-gloss="Answering" x-translit="apokritheis" xml:lang="grc">ἀποκριθεὶς</char> <char style="w" x-id="SBLGNT.MAT.21.21.002" x-align="MAT.21.21.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.21.21.003" x-align="MAT.21.21.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.21.21.004" x-align="MAT.21.21.a004" x-target-ids="t002" x-target="Jesus" x-target-head="t002" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.MAT.21.21.005" x-align="MAT.21.21.a005" x-target-ids="t004 t005" x-target="and said" x-target-head="t005" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.MAT.21.21.006" x-align="MAT.21.21.a006" x-target-ids="t006 t007" x-target="unto them" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.MAT.21.21.007" x-align="MAT.21.21.a007" x-target-ids="t008" x-target="Verily" x-target-head="t008" x-head="true" lemma="ἀμήν" strong="G281" x-morph="HEB" x-gloss="Truly" x-translit="Amēn" xml:lang="grc">Ἀμὴν</char> <char style="w" x-id="SBLGNT.MAT.21.21.008" x-align="MAT.21.21.a008" x-target-ids="t009 t010" x-target="I say" x-target-head="t010" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1