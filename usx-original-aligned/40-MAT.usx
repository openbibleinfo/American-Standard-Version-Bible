	<para style="p"><verse number="26" style="v" x-ref="MAT.27.26" sid="MAT 27:26" /><char style="w" x-id="SBLGNT.MAT.27.26.001" x-align="MAT.27.26.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="τότε" strong="G5119" x-morph="ADV" x-gloss="Then" x-translit="tote" xml:lang="grc">τότε</char> <char style="w" x-id="SBLGNT.MAT.27.26.002" x-align="MAT.27.26.a002" x-target-ids="t002 t003" x-target="released he" x-target-head="t002" x-head="true" lemma="ἀπολύω" strong="G630" x-morph="V-AAI-3S" x-gloss="he released" x-translit="apelysen" xml:lang="grc">ἀπέλυσεν</char> <char style="w" x-id="SBLGNT.MAT.27.26.003" x-align="MAT.27.26.a003" x-target-ids="t004 t005" x-target="unto them" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char> <char style="w" x-id="SBLGNT.MAT.27.26.004" x-align="MAT.27.26.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="-" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.MAT.27.26.005" x-align="MAT.27.26.a005" x-target-ids="t006" x-target="Barabbas" x-target-head="t006" x-head="true" lemma="Βαραββᾶς" strong="G912" x-morph="N-ASM" x-gloss="Barabbas" x-translit="Barabban" xml:lang="grc">Βαραββᾶν</char>,<char style="w" x-id="SBLGNT.MAT.27.26.006" x-align="MAT.27.26.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="-" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.MAT.27.26.007" x-align="MAT.27.26.a007" x-target-ids="t007" x-target="but" x-target-head="t007" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="and" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.27.26.008" x-align="MAT.27.26.a008" x-target-ids="t008" x-target="Jesus" x-target-head="t008" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-ASM" x-gloss="Jesus" x-translit="Iēsoun" xml:lang="g