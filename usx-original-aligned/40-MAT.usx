	<para style="p"><verse number="21" style="v" x-ref="MAT.26.21" sid="MAT 26:21" /><char style="w" x-id="SBLGNT.MAT.26.21.001" x-align="MAT.26.21.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And [as]" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.26.21.002" x-align="MAT.26.21.a002" x-target-ids="t002 t004 t005" x-target="as were eating" x-target-head="t005" x-head="true" lemma="ἐσθίω" strong="G2068" x-morph="V-PAP-GPM" x-gloss="they were eating" x-translit="esthiontōn" xml:lang="grc">ἐσθιόντων</char> <char style="w" x-id="SBLGNT.MAT.26.21.003" x-align="MAT.26.21.a003" x-target-ids="t003" x-target="they" x-target-head="t003" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="to them" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.MAT.26.21.004" x-align="MAT.26.21.a004" x-target-ids="t006 t007" x-target="he said" x-target-head="t007" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char>·<char style="w" x-id="SBLGNT.MAT.26.21.005" x-align="MAT.26.21.a005" x-target-ids="t008" x-target="Verily" x-target-head="t008" x-head="true" lemma="ἀμήν" strong="G281" x-morph="HEB" x-gloss="Truly" x-translit="Amēn" xml:lang="grc">Ἀμὴν</char> <char style="w" x-id="SBLGNT.MAT.26.21.006" x-align="MAT.26.21.a006" x-target-ids="t009 t010" x-target="I say" x-target-head="t010" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.MAT.26.21.007" x-align="MAT.26.21.a007" x-target-ids="t011 t012" x-target="unto you" x-target-head="t012" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.MAT.26.21.008" x-align="MAT.26.21.a008" x-target-ids="t013" x-target="that" x-target-head="t