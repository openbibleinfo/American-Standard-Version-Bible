	<para style="p"><verse number="4" style="v" x-ref="MAT.5.4" sid="MAT 5:4" /><char style="w" x-id="SBLGNT.MAT.5.4.001" x-align="MAT.5.4.a001" x-target-ids="t001 t002" x-target="Blessed are" x-target-head="t001" x-head="true" lemma="μακάριος" strong="G3107" x-morph="A-NPM" x-gloss="Blessed [are]" x-translit="makarioi" xml:lang="grc">μακάριοι</char> <char style="w" x-id="SBLGNT.MAT.5.4.002" x-align="MAT.5.4.a002" x-target-ids="t003" x-target="they" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MAT.5.4.003" x-align="MAT.5.4.a003" x-target-ids="t004 t005" x-target="that mourn" x-target-head="t005" x-head="true" lemma="πενθέω" strong="G3996" x-morph="V-PAP-NPM" x-gloss="mourning" x-translit="penthountes" xml:lang="grc">πενθοῦντες</char>,<char style="w" x-id="SBLGNT.MAT.5.4.004" x-align="MAT.5.4.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="for" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.MAT.5.4.005" x-align="MAT.5.4.a005" x-target-ids="t007" x-target="they" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NPM" x-gloss="they" x-translit="autoi" xml:lang="grc">αὐτοὶ</char> <char style="w" x-id="SBLGNT.MAT.5.4.006" x-align="MAT.5.4.a006" x-target-ids="t008 t009 t010" x-target="shall be comforted" x-target-head="t010" x-head="true" lemma="παρακαλέω" strong="G3870" x-morph="V-FPI-3P" x-gloss="will be comforted" x-translit="paraklēthēsontai" xml:lang="grc">παρακληθήσονται</char>.<verse eid="MAT 5:4" /></para>
