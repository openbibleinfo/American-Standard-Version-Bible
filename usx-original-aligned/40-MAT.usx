	<para style="p"><verse number="7" style="v" x-ref="MAT.11.7" sid="MAT 11:7" /><char style="w" x-id="SBLGNT.MAT.11.7.001" x-align="MAT.11.7.a001" x-target-ids="t003" x-target="these" x-target-head="t003" x-head="true" lemma="οὗτος" strong="G5130" x-morph="D-GPM" x-gloss="As these" x-translit="Toutōn" xml:lang="grc">Τούτων</char> <char style="w" x-id="SBLGNT.MAT.11.7.002" x-align="MAT.11.7.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.11.7.003" x-align="MAT.11.7.a003" x-target-ids="t002 t004 t005 t006" x-target="as went their way" x-target-head="t004" x-head="true" lemma="πορεύομαι" strong="G4198" x-morph="V-PNP-GPM" x-gloss="were going away" x-translit="poreuomenōn" xml:lang="grc">πορευομένων</char> <char style="w" x-id="SBLGNT.MAT.11.7.004" x-align="MAT.11.7.a004" x-target-ids="t008" x-target="began" x-target-head="t008" x-head="true" lemma="ἄρχω" strong="G756" x-morph="V-ADI-3S" x-gloss="began" x-translit="ērxato" xml:lang="grc">ἤρξατο</char> <char style="w" x-id="SBLGNT.MAT.11.7.005" x-align="MAT.11.7.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.11.7.006" x-align="MAT.11.7.a006" x-target-ids="t007" x-target="Jesus" x-target-head="t007" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.MAT.11.7.007" x-align="MAT.11.7.a007" x-target-ids="t009 t010" x-target="to say" x-target-head="t010" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAN" x-gloss="to speak" x-translit="legein" xml:lang="grc">λέγειν</char> <char style="w" x-id="SBLGNT.MAT.11.7.008" x-align="MAT.11.7.a008" x-target-ids="t011 t012" x-target="unto the" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-mo