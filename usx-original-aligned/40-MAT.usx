	<para style="p"><verse number="35" style="v" x-ref="MAT.22.35" sid="MAT 22:35" /><char style="w" x-id="SBLGNT.MAT.22.35.001" x-align="MAT.22.35.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.22.35.002" x-align="MAT.22.35.a002" x-target-ids="t007 t008 t009 t010" x-target="asked him a question" x-target-head="t007" x-head="true" lemma="ἐπερωτάω" strong="G1905" x-morph="V-AAI-3S" x-gloss="questioned [Him]" x-translit="epērōtēsen" xml:lang="grc">ἐπηρώτησεν</char> <char style="w" x-id="SBLGNT.MAT.22.35.003" x-align="MAT.22.35.a003" x-target-ids="t002" x-target="one" x-target-head="t002" x-head="true" lemma="εἷς" strong="G1520" x-morph="A-NSM" x-gloss="one" x-translit="heis" xml:lang="grc">εἷς</char> <char style="w" x-id="SBLGNT.MAT.22.35.004" x-align="MAT.22.35.a004" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="of" x-translit="ex" xml:lang="grc">ἐξ</char> <char style="w" x-id="SBLGNT.MAT.22.35.005" x-align="MAT.22.35.a005" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="them" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.MAT.22.35.006" x-align="MAT.22.35.a006" x-target-ids="t005 t006" x-target="a lawyer" x-target-head="t006" x-head="true" lemma="νομικός" strong="G3544" x-morph="A-NSM" x-gloss="a lawyer" x-translit="nomikos" xml:lang="grc">νομικὸς</char> <char style="w" x-id="SBLGNT.MAT.22.35.007" x-align="MAT.22.35.a007" x-target-ids="t011" x-target="trying" x-target-head="t011" x-head="true" lemma="πειράζω" strong="G3985" x-morph="V-PAP-NSM" x-gloss="testing" x-translit="peirazōn" xml:lang="grc">πειράζων</char> <char style="w" x-id="SBLGNT.MAT.22.35.008" x-align="MAT.22.35.a008" x-target-ids="t012" x-target="him" x-target-head="t012" 