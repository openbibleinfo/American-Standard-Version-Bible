	<para style="p"><verse number="14" style="v" x-ref="MAT.17.14" sid="MAT 17:14" /><char style="w" x-id="SBLGNT.MAT.17.14.001" x-align="MAT.17.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.MAT.17.14.002" x-align="MAT.17.14.a002" x-target-ids="t002 t003 t004 t005" x-target="when they were come" x-target-head="t005" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAP-GPM" x-gloss="they having come" x-translit="elthontōn" xml:lang="grc">ἐλθόντων</char> <char style="w" x-id="SBLGNT.MAT.17.14.003" x-align="MAT.17.14.a003" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.MAT.17.14.004" x-align="MAT.17.14.a004" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.MAT.17.14.005" x-align="MAT.17.14.a005" x-target-ids="t008" x-target="multitude" x-target-head="t008" x-head="true" lemma="ὄχλος" strong="G3793" x-morph="N-ASM" x-gloss="crowd" x-translit="ochlon" xml:lang="grc">ὄχλον</char> <char style="w" x-id="SBLGNT.MAT.17.14.006" x-align="MAT.17.14.a006" x-target-ids="t009 t010" x-target="there came" x-target-head="t010" x-head="true" lemma="προσέρχομαι" strong="G4334" x-morph="V-2AAI-3S" x-gloss="came" x-translit="prosēlthen" xml:lang="grc">προσῆλθεν</char> <char style="w" x-id="SBLGNT.MAT.17.14.007" x-align="MAT.17.14.a007" x-target-ids="t011 t012" x-target="to him" x-target-head="t012" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to Him" x-translit="autōi" xml:lang="grc">αὐτῷ</char> <char style="w" x-id="SBLGNT.MAT.17.14.008" x-align="MAT.17.14.a008" x-target-ids="t013 t014" x-target="a man" x-tar