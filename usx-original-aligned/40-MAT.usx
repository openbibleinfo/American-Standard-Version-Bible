	<para style="p"><verse number="25" style="v" x-ref="MAT.25.25" sid="MAT 25:25" /><char style="w" x-id="SBLGNT.MAT.25.25.001" x-align="MAT.25.25.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.25.25.002" x-align="MAT.25.25.a002" x-target-ids="t002 t003 t004" x-target="I was afraid" x-target-head="t004" x-head="true" lemma="φοβέομαι" strong="G5399" x-morph="V-AOP-NSM" x-gloss="having been afraid" x-translit="phobētheis" xml:lang="grc">φοβηθεὶς</char> <char style="w" x-id="SBLGNT.MAT.25.25.003" x-align="MAT.25.25.a003" x-target-ids="t005 t006 t007" x-target="and went away" x-target-head="t006" x-head="true" lemma="ἀπέρχομαι" strong="G565" x-morph="V-2AAP-NSM" x-gloss="having gone away" x-translit="apelthōn" xml:lang="grc">ἀπελθὼν</char> <char style="w" x-id="SBLGNT.MAT.25.25.004" x-align="MAT.25.25.a004" x-target-ids="t008 t009" x-target="and hid" x-target-head="t009" x-head="true" lemma="κρύπτω" strong="G2928" x-morph="V-AAI-1S" x-gloss="I hid" x-translit="ekrypsa" xml:lang="grc">ἔκρυψα</char> <char style="w" x-id="SBLGNT.MAT.25.25.005" x-align="MAT.25.25.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MAT.25.25.006" x-align="MAT.25.25.a006" x-target-ids="t011" x-target="talent" x-target-head="t011" x-head="true" lemma="τάλαντον" strong="G5007" x-morph="N-ASN" x-gloss="talent" x-translit="talanton" xml:lang="grc">τάλαντόν</char> <char style="w" x-id="SBLGNT.MAT.25.25.007" x-align="MAT.25.25.a007" x-target-ids="t010" x-target="thy" x-target-head="t010" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="of you" x-translit="sou" xml:lang="grc">σου</char> <char style="w" x-id="SBLGNT.MAT.25.25.008" x-align="MAT.25.25.a008" x-target-ids="t012" x-target="in" x-target-head="t012" x-h