	<para style="p"><verse number="10" style="v" x-ref="MAT.15.10" sid="MAT 15:10" /><char style="w" x-id="SBLGNT.MAT.15.10.001" x-align="MAT.15.10.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.MAT.15.10.002" x-align="MAT.15.10.a002" x-target-ids="t002 t003 t004 t005" x-target="he called to him" x-target-head="t003" x-head="true" lemma="προσκαλέομαι" strong="G4341" x-morph="V-ADP-NSM" x-gloss="having called to [Him]" x-translit="proskalesamenos" xml:lang="grc">προσκαλεσάμενος</char> <char style="w" x-id="SBLGNT.MAT.15.10.003" x-align="MAT.15.10.a003" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.MAT.15.10.004" x-align="MAT.15.10.a004" x-target-ids="t007" x-target="multitude" x-target-head="t007" x-head="true" lemma="ὄχλος" strong="G3793" x-morph="N-ASM" x-gloss="crowd" x-translit="ochlon" xml:lang="grc">ὄχλον</char> <char style="w" x-id="SBLGNT.MAT.15.10.005" x-align="MAT.15.10.a005" x-target-ids="t008 t009" x-target="and said" x-target-head="t009" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.MAT.15.10.006" x-align="MAT.15.10.a006" x-target-ids="t010 t011" x-target="unto them" x-target-head="t011" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.MAT.15.10.007" x-align="MAT.15.10.a007" x-target-ids="t012" x-target="Hear" x-target-head="t012" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-PAM-2P" x-gloss="Hear" x-translit="Akouete" xml:lang="grc">Ἀκούετε</char> <char style="w" x-id="SBLGNT.MAT.15.10.008" x-align="MAT.15.10.a008" x-target-ids="t013" x