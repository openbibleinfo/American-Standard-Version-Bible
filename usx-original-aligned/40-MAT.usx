	<para style="p"><verse number="22" style="v" x-ref="MAT.26.22" sid="MAT 26:22" /><char style="w" x-id="SBLGNT.MAT.26.22.001" x-align="MAT.26.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.26.22.002" x-align="MAT.26.22.a002" x-target-ids="t002 t003 t005" x-target="they were sorrowful" x-target-head="t005" x-head="true" lemma="λυπέω" strong="G3076" x-morph="V-PPP-NPM" x-gloss="being grieved" x-translit="lypoumenoi" xml:lang="grc">λυπούμενοι</char> <char style="w" x-id="SBLGNT.MAT.26.22.003" x-align="MAT.26.22.a003" x-target-ids="t004" x-target="exceeding" x-target-head="t004" x-head="true" lemma="σφόδρα" strong="G4970" x-morph="ADV" x-gloss="exceedingly" x-translit="sphodra" xml:lang="grc">σφόδρα</char> <char style="w" x-id="SBLGNT.MAT.26.22.004" x-align="MAT.26.22.a004" x-target-ids="t006 t007" x-target="and began" x-target-head="t007" x-head="true" lemma="ἄρχω" strong="G756" x-morph="V-ADI-3P" x-gloss="they began" x-translit="ērxanto" xml:lang="grc">ἤρξαντο</char> <char style="w" x-id="SBLGNT.MAT.26.22.005" x-align="MAT.26.22.a005" x-target-ids="t008 t009" x-target="to say" x-target-head="t009" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAN" x-gloss="to say" x-translit="legein" xml:lang="grc">λέγειν</char> <char style="w" x-id="SBLGNT.MAT.26.22.006" x-align="MAT.26.22.a006" x-target-ids="t010 t011" x-target="unto him" x-target-head="t011" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to Him" x-translit="autōi" xml:lang="grc">αὐτῷ</char> <char style="w" x-id="SBLGNT.MAT.26.22.007" x-align="MAT.26.22.a007" x-target-ids="t013" x-target="one" x-target-head="t013" x-head="true" lemma="εἷς" strong="G1520" x-morph="A-NSM" x-gloss="one" x-translit="heis" xml:lang="grc">εἷς</char> <char style="w" x-id="SBLGNT.MAT.26.22.008" x-align="MAT.26.22.a008" x-target-ids="t012" x-target="ever