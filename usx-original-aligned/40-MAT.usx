	<para style="p"><verse number="26" style="v" x-ref="MAT.19.26" sid="MAT 19:26" /><char style="w" x-id="SBLGNT.MAT.19.26.001" x-align="MAT.19.26.a001" x-target-ids="t003 t004 t005" x-target="looking upon them" x-target-italic-ids="t005" x-target-head="t003" x-head="true" lemma="ἐμβλέπω" strong="G1689" x-morph="V-AAP-NSM" x-gloss="Having looked on [them]" x-translit="emblepsas" xml:lang="grc">ἐμβλέψας</char> <char style="w" x-id="SBLGNT.MAT.19.26.002" x-align="MAT.19.26.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.19.26.003" x-align="MAT.19.26.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.19.26.004" x-align="MAT.19.26.a004" x-target-ids="t002" x-target="Jesus" x-target-head="t002" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.MAT.19.26.005" x-align="MAT.19.26.a005" x-target-ids="t006" x-target="said" x-target-head="t006" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.MAT.19.26.006" x-align="MAT.19.26.a006" x-target-ids="t007 t008" x-target="to them" x-target-head="t008" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.MAT.19.26.007" x-align="MAT.19.26.a007" x-target-ids="t009" x-target="With" x-target-head="t009" x-head="true" lemma="παρά" strong="G3844" x-morph="PREP" x-gloss="With" x-translit="Para" xml:lang="grc">Παρὰ</char> <char style="w" x-id="SBLGNT.MAT.19.26.008" x-align="MAT.19.26.a008" x-target-ids="t010" x-target="men" x-target-head="t010" x-head="true" lemma="ἄνθ