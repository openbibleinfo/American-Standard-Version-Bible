	<para style="p"><verse number="22" style="v" x-ref="MAT.22.22" sid="MAT 22:22" /><char style="w" x-id="SBLGNT.MAT.22.22.001" x-align="MAT.22.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.22.22.002" x-align="MAT.22.22.a002" x-target-ids="t002 t003 t004 t005" x-target="when they heard it" x-target-head="t004" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="having heard" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.MAT.22.22.003" x-align="MAT.22.22.a003" x-target-ids="t006 t007" x-target="they marvelled" x-target-head="t007" x-head="true" lemma="θαυμάζω" strong="G2296" x-morph="V-AAI-3P" x-gloss="they marveled" x-translit="ethaumasan" xml:lang="grc">ἐθαύμασαν</char>,<char style="w" x-id="SBLGNT.MAT.22.22.004" x-align="MAT.22.22.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.22.22.005" x-align="MAT.22.22.a005" x-target-ids="t009" x-target="left" x-target-head="t009" x-head="true" lemma="ἀφίημι" strong="G863" x-morph="V-2AAP-NPM" x-gloss="having left" x-translit="aphentes" xml:lang="grc">ἀφέντες</char> <char style="w" x-id="SBLGNT.MAT.22.22.006" x-align="MAT.22.22.a006" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτὸν</char> <char style="w" x-id="SBLGNT.MAT.22.22.007" x-align="MAT.22.22.a007" x-target-ids="t011 t012 t013" x-target="and went away" x-target-head="t012" x-head="true" lemma="ἀπέρχομαι" strong="G565" x-morph="V-2AAI-3P" x-gloss="they went away" x-translit="apēlthan" xml:lang="grc">ἀπῆλθαν</char>.<verse eid="MAT 22:22" /></para>
