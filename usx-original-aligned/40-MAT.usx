	<para style="p"><verse number="16" style="v" x-ref="MAT.27.16" sid="MAT 27:16" /><char style="w" x-id="SBLGNT.MAT.27.16.001" x-align="MAT.27.16.a002" x-target-ids="t002 t003" x-target="they had" x-target-head="t003" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-IAI-3P" x-gloss="They were holding" x-translit="eichon" xml:lang="grc">εἶχον</char> <char style="w" x-id="SBLGNT.MAT.27.16.002" x-align="MAT.27.16.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.27.16.003" x-align="MAT.27.16.a003" x-target-ids="t004" x-target="then" x-target-head="t004" x-head="true" lemma="τότε" strong="G5119" x-morph="ADV" x-gloss="at that time" x-translit="tote" xml:lang="grc">τότε</char> <char style="w" x-id="SBLGNT.MAT.27.16.004" x-align="MAT.27.16.a004" x-target-ids="t005 t007" x-target="a prisoner" x-target-head="t007" x-head="true" lemma="δέσμιος" strong="G1198" x-morph="N-ASM" x-gloss="a prisoner" x-translit="desmion" xml:lang="grc">δέσμιον</char> <char style="w" x-id="SBLGNT.MAT.27.16.005" x-align="MAT.27.16.a005" x-target-ids="t006" x-target="notable" x-target-head="t006" x-head="true" lemma="ἐπίσημος" strong="G1978" x-morph="A-ASM" x-gloss="notable" x-translit="episēmon" xml:lang="grc">ἐπίσημον</char> <char style="w" x-id="SBLGNT.MAT.27.16.006" x-align="MAT.27.16.a006" x-target-ids="t008" x-target="called" x-target-head="t008" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PPP-ASM" x-gloss="called" x-translit="legomenon" xml:lang="grc">λεγόμενον</char> <char style="w" x-id="SBLGNT.MAT.27.16.008" x-align="MAT.27.16.a007" x-target-ids="t009" x-target="Barabbas" x-target-head="t009" x-head="true" lemma="Βαραββᾶς" strong="G912" x-morph="N-ASM" x-gloss="Barabbas" x-translit="Barabban" xml:lang="grc">Βαραββᾶν</char>.<verse eid="MAT 27:16" /></para>
