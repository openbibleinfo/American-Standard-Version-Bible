	<para style="p"><verse number="9" style="v" x-ref="MAT.15.9" sid="MAT 15:9" /><char style="w" x-id="SBLGNT.MAT.15.9.001" x-align="MAT.15.9.a001" x-target-ids="t002 t003" x-target="in vain" x-target-head="t003" x-head="true" lemma="μάτην" strong="G3155" x-morph="ADV" x-gloss="in vain" x-translit="matēn" xml:lang="grc">μάτην</char> <char style="w" x-id="SBLGNT.MAT.15.9.002" x-align="MAT.15.9.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.15.9.003" x-align="MAT.15.9.a003" x-target-ids="t004 t005 t006" x-target="do they worship" x-target-head="t006" x-head="true" lemma="σέβομαι" strong="G4576" x-morph="V-PNI-3P" x-gloss="they worship" x-translit="sebontai" xml:lang="grc">σέβονταί</char> <char style="w" x-id="SBLGNT.MAT.15.9.004" x-align="MAT.15.9.a004" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="ἐγώ" strong="G3165" x-morph="P-1AS" x-gloss="Me" x-translit="me" xml:lang="grc">με</char>,<char style="w" x-id="SBLGNT.MAT.15.9.005" x-align="MAT.15.9.a005" x-target-ids="t008" x-target="Teaching" x-target-head="t008" x-head="true" lemma="διδάσκω" strong="G1321" x-morph="V-PAP-NPM" x-gloss="teaching [as]" x-translit="didaskontes" xml:lang="grc">διδάσκοντες</char> <char style="w" x-id="SBLGNT.MAT.15.9.006" x-align="MAT.15.9.a006" x-target-ids="t009 t010 t011" x-target="as their doctrines" x-target-italic-ids="t009 t010" x-target-head="t011" x-head="true" lemma="διδασκαλία" strong="G1319" x-morph="N-APF" x-gloss="doctrines" x-translit="didaskalias" xml:lang="grc">διδασκαλίας</char> <char style="w" x-id="SBLGNT.MAT.15.9.007" x-align="MAT.15.9.a007" x-target-ids="t012 t013" x-target="the precepts" x-target-head="t013" x-head="true" lemma="ἔνταλμα" strong="G1778" x-morph="N-APN" x-gloss="[the] precepts" x-translit="entalmata" xml:lang="grc">ἐντάλματα</char> <char style="w" x-id="SBLGNT.MAT.15.9.