	<para style="p"><verse number="33" style="v" x-ref="MAT.22.33" sid="MAT 22:33" /><char style="w" x-id="SBLGNT.MAT.22.33.001" x-align="MAT.22.33.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.22.33.002" x-align="MAT.22.33.a002" x-target-ids="t002 t005 t006" x-target="when heard it" x-target-head="t005" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="having heard" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.MAT.22.33.003" x-align="MAT.22.33.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MAT.22.33.004" x-align="MAT.22.33.a004" x-target-ids="t004" x-target="multitudes" x-target-head="t004" x-head="true" lemma="ὄχλος" strong="G3793" x-morph="N-NPM" x-gloss="crowds" x-translit="ochloi" xml:lang="grc">ὄχλοι</char> <char style="w" x-id="SBLGNT.MAT.22.33.005" x-align="MAT.22.33.a005" x-target-ids="t007 t008 t009" x-target="they were astonished" x-target-head="t009" x-head="true" lemma="ἐκπλήσσομαι" strong="G1605" x-morph="V-IPI-3P" x-gloss="were astonished" x-translit="exeplēssonto" xml:lang="grc">ἐξεπλήσσοντο</char> <char style="w" x-id="SBLGNT.MAT.22.33.006" x-align="MAT.22.33.a006" x-target-ids="t010" x-target="at" x-target-head="t010" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="at" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.MAT.22.33.007" x-align="MAT.22.33.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.MAT.22.33.008" x-align="MAT.22.33.a008" x-target-ids="t012" x-target="teaching" x-target-head="t012" x-head="true" lemma="δι