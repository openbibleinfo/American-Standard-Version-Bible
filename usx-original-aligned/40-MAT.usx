	<para style="p"><verse number="11" style="v" x-ref="MAT.4.11" sid="MAT 4:11" /><char style="w" x-id="SBLGNT.MAT.4.11.001" x-align="MAT.4.11.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="τότε" strong="G5119" x-morph="ADV" x-gloss="Then" x-translit="tote" xml:lang="grc">τότε</char> <char style="w" x-id="SBLGNT.MAT.4.11.002" x-align="MAT.4.11.a002" x-target-ids="t004" x-target="leaveth" x-target-head="t004" x-head="true" lemma="ἀφίημι" strong="G863" x-morph="V-PAI-3S" x-gloss="leaves" x-translit="aphiēsin" xml:lang="grc">ἀφίησιν</char> <char style="w" x-id="SBLGNT.MAT.4.11.003" x-align="MAT.4.11.a003" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτὸν</char> <char style="w" x-id="SBLGNT.MAT.4.11.004" x-align="MAT.4.11.a004" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.4.11.005" x-align="MAT.4.11.a005" x-target-ids="t003" x-target="devil" x-target-head="t003" x-head="true" lemma="διάβολος" strong="G1228" x-morph="A-NSM" x-gloss="devil" x-translit="diabolos" xml:lang="grc">διάβολος</char>,<char style="w" x-id="SBLGNT.MAT.4.11.006" x-align="MAT.4.11.a006" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.4.11.007" x-align="MAT.4.11.a007" x-target-ids="t007" x-target="behold" x-target-head="t007" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.MAT.4.11.008" x-align="MAT.4.11.a008" x-target-ids="t008" x-target="angels" x-target-head="t008" x-head="true" lemma="ἄγγελος" strong="G32" x-morph="N-NPM" x-gloss="angels" x-tr