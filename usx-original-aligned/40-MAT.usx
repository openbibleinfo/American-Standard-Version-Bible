	<para style="p"><verse number="2" style="v" x-ref="MAT.25.2" sid="MAT 25:2" /><char style="w" x-id="SBLGNT.MAT.25.2.001" x-align="MAT.25.2.a002" x-target-ids="t002" x-target="five" x-target-head="t002" x-head="true" lemma="πέντε" strong="G4002" x-morph="A-NUI" x-gloss="Five" x-translit="pente" xml:lang="grc">πέντε</char> <char style="w" x-id="SBLGNT.MAT.25.2.002" x-align="MAT.25.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.25.2.003" x-align="MAT.25.2.a003" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="of" x-translit="ex" xml:lang="grc">ἐξ</char> <char style="w" x-id="SBLGNT.MAT.25.2.004" x-align="MAT.25.2.a004" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPF" x-gloss="them" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.MAT.25.2.005" x-align="MAT.25.2.a005" x-target-ids="t005" x-target="were" x-target-head="t005" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3P" x-gloss="were" x-translit="ēsan" xml:lang="grc">ἦσαν</char> <char style="w" x-id="SBLGNT.MAT.25.2.006" x-align="MAT.25.2.a006" x-target-ids="t006" x-target="foolish" x-target-head="t006" x-head="true" lemma="μωρός" strong="G3474" x-morph="A-NPF" x-gloss="foolish" x-translit="mōrai" xml:lang="grc">μωραὶ</char> <char style="w" x-id="SBLGNT.MAT.25.2.007" x-align="MAT.25.2.a007" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.25.2.008" x-align="MAT.25.2.a008" x-target-ids="t008" x-target="five" x-target-head="t008" x-head="true" lemma="πέντε" strong="G4002" x-morph="A-NUI" x-gloss="five" x-translit="pente" xml:lang="grc">πέντ