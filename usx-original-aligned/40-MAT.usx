	<para style="p"><verse number="20" style="v" x-ref="MAT.21.20" sid="MAT 21:20" /><char style="w" x-id="SBLGNT.MAT.21.20.001" x-align="MAT.21.20.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.21.20.002" x-align="MAT.21.20.a002" x-target-ids="t002 t005 t006" x-target="when saw it" x-target-head="t005" x-head="true" lemma="ὁράω" strong="G3708" x-morph="V-2AAP-NPM" x-gloss="having seen [it]" x-translit="idontes" xml:lang="grc">ἰδόντες</char> <char style="w" x-id="SBLGNT.MAT.21.20.003" x-align="MAT.21.20.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MAT.21.20.004" x-align="MAT.21.20.a004" x-target-ids="t004" x-target="disciples" x-target-head="t004" x-head="true" lemma="μαθητής" strong="G3101" x-morph="N-NPM" x-gloss="disciples" x-translit="mathētai" xml:lang="grc">μαθηταὶ</char> <char style="w" x-id="SBLGNT.MAT.21.20.005" x-align="MAT.21.20.a005" x-target-ids="t007 t008" x-target="they marvelled" x-target-head="t008" x-head="true" lemma="θαυμάζω" strong="G2296" x-morph="V-AAI-3P" x-gloss="marveled" x-translit="ethaumasan" xml:lang="grc">ἐθαύμασαν</char> <char style="w" x-id="SBLGNT.MAT.21.20.006" x-align="MAT.21.20.a006" x-target-ids="t009" x-target="saying" x-target-head="t009" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NPM" x-gloss="saying" x-translit="legontes" xml:lang="grc">λέγοντες</char>·<char style="w" x-id="SBLGNT.MAT.21.20.007" x-align="MAT.21.20.a007" x-target-ids="t010" x-target="How" x-target-head="t010" x-head="true" lemma="πῶς" strong="G4459" x-morph="ADV-I" x-gloss="How" x-translit="Pōs" xml:lang="grc">Πῶς</char> <char style="w" x-id="SBLGNT.MAT.21.20.008" x-align="MAT.21.20.a008" x-target-ids="t015" x-target="immediately" x-tar