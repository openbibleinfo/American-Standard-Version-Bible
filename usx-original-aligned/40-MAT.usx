	<para style="p"><verse number="25" style="v" x-ref="MAT.19.25" sid="MAT 19:25" /><char style="w" x-id="SBLGNT.MAT.19.25.001" x-align="MAT.19.25.a001" x-target-ids="t002 t005 t006" x-target="when heard it" x-target-head="t005" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="Having heard" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.MAT.19.25.002" x-align="MAT.19.25.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.19.25.003" x-align="MAT.19.25.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MAT.19.25.004" x-align="MAT.19.25.a004" x-target-ids="t004" x-target="disciples" x-target-head="t004" x-head="true" lemma="μαθητής" strong="G3101" x-morph="N-NPM" x-gloss="disciples" x-translit="mathētai" xml:lang="grc">μαθηταὶ</char> <char style="w" x-id="SBLGNT.MAT.19.25.005" x-align="MAT.19.25.a005" x-target-ids="t007 t008 t009" x-target="they were astonished" x-target-head="t009" x-head="true" lemma="ἐκπλήσσομαι" strong="G1605" x-morph="V-IPI-3P" x-gloss="were astonished" x-translit="exeplēssonto" xml:lang="grc">ἐξεπλήσσοντο</char> <char style="w" x-id="SBLGNT.MAT.19.25.006" x-align="MAT.19.25.a006" x-target-ids="t010" x-target="exceedingly" x-target-head="t010" x-head="true" lemma="σφόδρα" strong="G4970" x-morph="ADV" x-gloss="exceedingly" x-translit="sphodra" xml:lang="grc">σφόδρα</char> <char style="w" x-id="SBLGNT.MAT.19.25.007" x-align="MAT.19.25.a007" x-target-ids="t011" x-target="saying" x-target-head="t011" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NPM" x-gloss="saying" x-translit="legontes" xml:lang="grc">λέγοντες</char>·<char style="w" x-id="SBLGNT.MAT.19.25.008" x-align="MAT.19.25.a00