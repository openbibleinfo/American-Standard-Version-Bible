	<para style="p"><verse number="2" style="v" x-ref="MAT.8.2" sid="MAT 8:2" /><char style="w" x-id="SBLGNT.MAT.8.2.001" x-align="MAT.8.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.8.2.002" x-align="MAT.8.2.a002" x-target-ids="t002" x-target="behold" x-target-head="t002" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.MAT.8.2.003" x-align="MAT.8.2.a004" x-target-ids="t007 t008" x-target="a leper" x-target-head="t008" x-head="true" lemma="λεπρός" strong="G3015" x-morph="A-NSM" x-gloss="a leper" x-translit="lepros" xml:lang="grc">λεπρὸς</char> <char style="w" x-id="SBLGNT.MAT.8.2.004" x-align="MAT.8.2.a003" x-target-ids="t003 t004 t005 t006" x-target="there came to him" x-target-head="t004" x-head="true" lemma="προσέρχομαι" strong="G4334" x-morph="V-2AAP-NSM" x-gloss="having come" x-translit="proselthōn" xml:lang="grc">προσελθὼν</char> <char style="w" x-id="SBLGNT.MAT.8.2.005" x-align="MAT.8.2.a005" x-target-ids="t009 t010" x-target="and worshipped" x-target-head="t010" x-head="true" lemma="προσκυνέω" strong="G4352" x-morph="V-IAI-3S" x-gloss="was worshipping" x-translit="prosekynei" xml:lang="grc">προσεκύνει</char> <char style="w" x-id="SBLGNT.MAT.8.2.006" x-align="MAT.8.2.a006" x-target-ids="t011" x-target="him" x-target-head="t011" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="Him" x-translit="autōi" xml:lang="grc">αὐτῷ</char> <char style="w" x-id="SBLGNT.MAT.8.2.007" x-align="MAT.8.2.a007" x-target-ids="t012" x-target="saying" x-target-head="t012" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.MAT.8.2.008" x-align="MAT.8.2.a008" x-target-ids="t013" x-target="Lord" x-target-h