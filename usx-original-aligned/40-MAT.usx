	<para style="p"><verse number="43" style="v" x-ref="MAT.5.43" sid="MAT 5:43" /><char style="w" x-id="SBLGNT.MAT.5.43.001" x-align="MAT.5.43.a001" x-target-ids="t001 t002 t003" x-target="Ye have heard" x-target-head="t003" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAI-2P" x-gloss="You have heard" x-translit="Ēkousate" xml:lang="grc">Ἠκούσατε</char> <char style="w" x-id="SBLGNT.MAT.5.43.002" x-align="MAT.5.43.a002" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.MAT.5.43.003" x-align="MAT.5.43.a003" x-target-ids="t005 t006 t007" x-target="it was said" x-target-head="t007" x-head="true" lemma="ῥέω" strong="G4483" x-morph="V-API-3S" x-gloss="it was said" x-translit="errethē" xml:lang="grc">ἐρρέθη</char>·<char style="w" x-id="SBLGNT.MAT.5.43.004" x-align="MAT.5.43.a004" x-target-ids="t008 t009 t010" x-target="Thou shalt love" x-target-head="t010" x-head="true" lemma="ἀγαπάω" strong="G25" x-morph="V-FAI-2S" x-gloss="You shall love" x-translit="Agapēseis" xml:lang="grc">Ἀγαπήσεις</char> <char style="w" x-id="SBLGNT.MAT.5.43.005" x-align="MAT.5.43.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="-" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.MAT.5.43.006" x-align="MAT.5.43.a006" x-target-ids="t012" x-target="neighbor" x-target-head="t012" x-head="true" lemma="πλησίον" strong="G4139" x-morph="ADV" x-gloss="neighbor" x-translit="plēsion" xml:lang="grc">πλησίον</char> <char style="w" x-id="SBLGNT.MAT.5.43.007" x-align="MAT.5.43.a007" x-target-ids="t011" x-target="thy" x-target-head="t011" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="of you" x-translit="sou" xml:lang="grc">σου</char> <char style="w" x-id="SBLGNT.MAT.5.43.008" x-align="MAT.5.43.a008" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma