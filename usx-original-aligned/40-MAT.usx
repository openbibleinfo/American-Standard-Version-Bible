	<para style="p"><verse number="34" style="v" x-ref="MAT.22.34" sid="MAT 22:34" /><char style="w" x-id="SBLGNT.MAT.22.34.001" x-align="MAT.22.34.a001" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="Hoi" xml:lang="grc">Οἱ</char> <char style="w" x-id="SBLGNT.MAT.22.34.002" x-align="MAT.22.34.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.22.34.003" x-align="MAT.22.34.a003" x-target-ids="t003" x-target="Pharisees" x-target-head="t003" x-head="true" lemma="Φαρισαῖος" strong="G5330" x-morph="N-NPM" x-gloss="the Pharisees" x-translit="Pharisaioi" xml:lang="grc">Φαρισαῖοι</char> <char style="w" x-id="SBLGNT.MAT.22.34.004" x-align="MAT.22.34.a004" x-target-ids="t004 t005 t006" x-target="when they heard" x-target-head="t006" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="having heard" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.MAT.22.34.005" x-align="MAT.22.34.a005" x-target-ids="t007" x-target="that" x-target-head="t007" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.MAT.22.34.006" x-align="MAT.22.34.a006" x-target-ids="t008 t009 t010 t013 t014" x-target="he had put to silence" x-target-head="t014" x-head="true" lemma="φιμόω" strong="G5392" x-morph="V-AAI-3S" x-gloss="He had silenced" x-translit="ephimōsen" xml:lang="grc">ἐφίμωσεν</char> <char style="w" x-id="SBLGNT.MAT.22.34.007" x-align="MAT.22.34.a007" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="the" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.MAT.22.34.008" x-align="MAT.22.34.a008" x-target-ids="t012" x-target="Sa