	<para style="p"><verse number="3" style="v" x-ref="MAT.8.3" sid="MAT 8:3" /><char style="w" x-id="SBLGNT.MAT.8.3.001" x-align="MAT.8.3.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.8.3.002" x-align="MAT.8.3.a002" x-target-ids="t002 t003 t004" x-target="he stretched forth" x-target-head="t003" x-head="true" lemma="ἐκτείνω" strong="G1614" x-morph="V-AAP-NSM" x-gloss="having stretched out" x-translit="ekteinas" xml:lang="grc">ἐκτείνας</char> <char style="w" x-id="SBLGNT.MAT.8.3.003" x-align="MAT.8.3.a003" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="the" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.MAT.8.3.004" x-align="MAT.8.3.a004" x-target-ids="t006" x-target="hand" x-target-head="t006" x-head="true" lemma="χείρ" strong="G5495" x-morph="N-ASF" x-gloss="hand" x-translit="cheira" xml:lang="grc">χεῖρα</char> <char style="w" x-id="SBLGNT.MAT.8.3.005" x-align="MAT.8.3.a005" x-target-ids="t007 t008" x-target="and touched" x-target-head="t008" x-head="true" lemma="ἅπτω" strong="G680" x-morph="V-ADI-3S" x-gloss="He touched" x-translit="hēpsato" xml:lang="grc">ἥψατο</char> <char style="w" x-id="SBLGNT.MAT.8.3.006" x-align="MAT.8.3.a006" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.MAT.8.3.007" x-align="MAT.8.3.a007" x-target-ids="t010" x-target="saying" x-target-head="t010" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.MAT.8.3.008" x-align="MAT.8.3.a008" x-target-ids="t011 t012" x-target="I will" x-target-head="t012" x-head="true" lemma="θέλω" strong="