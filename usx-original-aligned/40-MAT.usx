	<para style="p"><verse number="2" style="v" x-ref="MAT.26.2" sid="MAT 26:2" /><char style="w" x-id="SBLGNT.MAT.26.2.001" x-align="MAT.26.2.a001" x-target-ids="t001 t002" x-target="Ye know" x-target-head="t002" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAI-2P" x-gloss="You know" x-translit="Oidate" xml:lang="grc">Οἴδατε</char> <char style="w" x-id="SBLGNT.MAT.26.2.002" x-align="MAT.26.2.a002" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.MAT.26.2.003" x-align="MAT.26.2.a003" x-target-ids="t004" x-target="after" x-target-head="t004" x-head="true" lemma="μετά" strong="G3326" x-morph="PREP" x-gloss="after" x-translit="meta" xml:lang="grc">μετὰ</char> <char style="w" x-id="SBLGNT.MAT.26.2.004" x-align="MAT.26.2.a004" x-target-ids="t005" x-target="two" x-target-head="t005" x-head="true" lemma="δύο" strong="G1417" x-morph="A-NUI" x-gloss="two" x-translit="dyo" xml:lang="grc">δύο</char> <char style="w" x-id="SBLGNT.MAT.26.2.005" x-align="MAT.26.2.a005" x-target-ids="t006" x-target="days" x-target-head="t006" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-APF" x-gloss="days" x-translit="hēmeras" xml:lang="grc">ἡμέρας</char> <char style="w" x-id="SBLGNT.MAT.26.2.006" x-align="MAT.26.2.a006" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MAT.26.2.007" x-align="MAT.26.2.a007" x-target-ids="t008" x-target="passover" x-target-head="t008" x-head="true" lemma="πάσχα" strong="G3957" x-morph="ARAM" x-gloss="Passover" x-translit="pascha" xml:lang="grc">πάσχα</char> <char style="w" x-id="SBLGNT.MAT.26.2.008" x-align="MAT.26.2.a008" x-target-ids="t009" x-target="cometh" x-target-head="t009" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-PNI-3S" x-gloss="takes pl