	<para style="p"><verse number="3" style="v" x-ref="MAT.27.3" sid="MAT 27:3" /><char style="w" x-id="SBLGNT.MAT.27.3.001" x-align="MAT.27.3.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="τότε" strong="G5119" x-morph="ADV" x-gloss="Then" x-translit="Tote" xml:lang="grc">Τότε</char> <char style="w" x-id="SBLGNT.MAT.27.3.002" x-align="MAT.27.3.a006" x-target-ids="t006 t007 t008" x-target="when he saw" x-target-head="t008" x-head="true" lemma="ὁράω" strong="G3708" x-morph="V-2AAP-NSM" x-gloss="having seen" x-translit="idōn" xml:lang="grc">ἰδὼν</char> <char style="w" x-id="SBLGNT.MAT.27.3.003" x-align="MAT.27.3.a002" x-target-ids="t002" x-target="Judas" x-target-head="t002" x-head="true" lemma="Ἰούδας" strong="G2455" x-morph="N-NSM" x-gloss="Judas" x-translit="Ioudas" xml:lang="grc">Ἰούδας</char> <char style="w" x-id="SBLGNT.MAT.27.3.004" x-align="MAT.27.3.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the [one]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.27.3.005" x-align="MAT.27.3.a004" x-target-ids="t003 t004" x-target="who betrayed" x-target-head="t004" x-head="true" lemma="παραδίδωμι" strong="G3860" x-morph="V-PAP-NSM" x-translit="paradidous" xml:lang="grc">παραδιδοὺς</char> <char style="w" x-id="SBLGNT.MAT.27.3.006" x-align="MAT.27.3.a005" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτὸν</char> <char style="w" x-id="SBLGNT.MAT.27.3.007" x-align="MAT.27.3.a007" x-target-ids="t009" x-target="that" x-target-head="t009" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.MAT.27.3.008" x-align="MAT.27.3.a008" x-target-ids="t010 t011 t012" x-target="he was condemned" x-target-head="t012" x-head="true" lemma="κατακρίνω" strong="G2632" x-morph="V-API-3S