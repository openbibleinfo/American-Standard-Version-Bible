	<para style="p"><verse number="28" style="v" x-ref="MAT.24.28" sid="MAT 24:28" /><char style="w" x-id="SBLGNT.MAT.24.28.001" x-align="MAT.24.28.a001" x-target-ids="t001" x-target="Wheresoever" x-target-head="t001" x-head="true" lemma="ὅπου" strong="G3699" x-morph="ADV" x-gloss="For wherever" x-translit="hopou" xml:lang="grc">ὅπου</char> <char style="w" x-id="SBLGNT.MAT.24.28.002" x-align="MAT.24.28.a001" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.MAT.24.28.003" x-align="MAT.24.28.a002" x-target-ids="t004" x-target="is" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G5600" x-morph="V-PAS-3S" x-gloss="may be" x-translit="ēi" xml:lang="grc">ᾖ</char> <char style="w" x-id="SBLGNT.MAT.24.28.004" x-align="MAT.24.28.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.MAT.24.28.005" x-align="MAT.24.28.a004" x-target-ids="t003" x-target="carcase" x-target-head="t003" x-head="true" lemma="πτῶμα" strong="G4430" x-morph="N-NSN" x-gloss="carcass" x-translit="ptōma" xml:lang="grc">πτῶμα</char>,<char style="w" x-id="SBLGNT.MAT.24.28.006" x-align="MAT.24.28.a005" x-target-ids="t005" x-target="there" x-target-head="t005" x-head="true" lemma="ἐκεῖ" strong="G1563" x-morph="ADV" x-gloss="there" x-translit="ekei" xml:lang="grc">ἐκεῖ</char> <char style="w" x-id="SBLGNT.MAT.24.28.007" x-align="MAT.24.28.a006" x-target-ids="t006 t009 t010 t011" x-target="will be gathered together" x-target-head="t010" x-head="true" lemma="συνάγω" strong="G4863" x-morph="V-FPI-3P" x-gloss="will be gathered" x-translit="synachthēsontai" xml:lang="grc">συναχθήσονται</char> <char style="w" x-id="SBLGNT.MAT.24.28.008" x-align="MAT.24.28.a007" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-transl