	<para style="p"><verse number="6" style="v" x-ref="MAT.11.6" sid="MAT 11:6" /><char style="w" x-id="SBLGNT.MAT.11.6.001" x-align="MAT.11.6.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.11.6.002" x-align="MAT.11.6.a002" x-target-ids="t002" x-target="blessed" x-target-head="t002" x-head="true" lemma="μακάριος" strong="G3107" x-morph="A-NSM" x-gloss="blessed" x-translit="makarios" xml:lang="grc">μακάριός</char> <char style="w" x-id="SBLGNT.MAT.11.6.003" x-align="MAT.11.6.a003" x-target-ids="t003" x-target="is" x-target-head="t003" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="is" x-translit="estin" xml:lang="grc">ἐστιν</char> <char style="w" x-id="SBLGNT.MAT.11.6.004" x-align="MAT.11.6.a004" x-target-ids="t004 t005" x-target="he whosoever" x-target-head="t005" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-NSM" x-gloss="he who" x-translit="hos" xml:lang="grc">ὃς</char> <char style="w" x-id="SBLGNT.MAT.11.6.005" x-align="MAT.11.6.a004" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.MAT.11.6.006" x-align="MAT.11.6.a005" x-target-ids="t008" x-target="no" x-target-head="t008" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.MAT.11.6.007" x-align="MAT.11.6.a006" x-target-ids="t006 t007 t009 t010 t011" x-target="shall find occasion of stumbling" x-target-head="t011" x-head="true" lemma="σκανδαλίζω" strong="G4624" x-morph="V-APS-3S" x-gloss="shall fall away" x-translit="skandalisthēi" xml:lang="grc">σκανδαλισθῇ</char> <char style="w" x-id="SBLGNT.MAT.11.6.008" x-align="MAT.11.6.a007" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" 