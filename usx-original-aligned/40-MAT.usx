	<para style="p"><verse number="2" style="v" x-ref="MAT.22.2" sid="MAT 22:2" /><char style="w" x-id="SBLGNT.MAT.22.2.001" x-align="MAT.22.2.a001" x-target-ids="t005 t006" x-target="is likened" x-target-head="t006" x-head="true" lemma="ὁμοιόω" strong="G3666" x-morph="V-API-3S" x-gloss="Has become like" x-translit="Hōmoiōthē" xml:lang="grc">Ὡμοιώθη</char> <char style="w" x-id="SBLGNT.MAT.22.2.002" x-align="MAT.22.2.a002" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.MAT.22.2.003" x-align="MAT.22.2.a003" x-target-ids="t002" x-target="kingdom" x-target-head="t002" x-head="true" lemma="βασιλεία" strong="G932" x-morph="N-NSF" x-gloss="kingdom" x-translit="basileia" xml:lang="grc">βασιλεία</char> <char style="w" x-id="SBLGNT.MAT.22.2.004" x-align="MAT.22.2.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="of the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.MAT.22.2.005" x-align="MAT.22.2.a005" x-target-ids="t003 t004" x-target="of heaven" x-target-head="t004" x-head="true" lemma="οὐρανός" strong="G3772" x-morph="N-GPM" x-gloss="heavens" x-translit="ouranōn" xml:lang="grc">οὐρανῶν</char> <char style="w" x-id="SBLGNT.MAT.22.2.006" x-align="MAT.22.2.a006" x-target-ids="t009" x-target="certain" x-target-head="t009" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-DSM" x-gloss="to a man" x-translit="anthrōpōi" xml:lang="grc">ἀνθρώπῳ</char> <char style="w" x-id="SBLGNT.MAT.22.2.007" x-align="MAT.22.2.a007" x-target-ids="t007 t008 t010" x-target="unto a king" x-target-head="t010" x-head="true" lemma="βασιλεύς" strong="G935" x-morph="N-DSM" x-gloss="a king" x-translit="basilei" xml:lang="grc">βασιλεῖ</char>,<char style="w" x-id="SBLGNT.MAT.22.2.008" x-align="MAT.22.2.a008" x-target-ids="t011" x-target="who" x-target-head="t011" x-head="true" lemma="ὅστις" s