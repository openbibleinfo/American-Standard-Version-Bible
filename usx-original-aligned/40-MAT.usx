	<para style="p"><verse number="15" style="v" x-ref="MAT.27.15" sid="MAT 27:15" /><char style="w" x-id="SBLGNT.MAT.27.15.001" x-align="MAT.27.15.a002" x-target-ids="t002" x-target="at" x-target-head="t002" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="At" x-translit="Kata" xml:lang="grc">Κατὰ</char> <char style="w" x-id="SBLGNT.MAT.27.15.002" x-align="MAT.27.15.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.27.15.003" x-align="MAT.27.15.a003" x-target-ids="t003 t004" x-target="the feast" x-target-head="t004" x-head="true" lemma="ἑορτή" strong="G1859" x-morph="N-ASF" x-gloss="[the] feast" x-translit="heortēn" xml:lang="grc">ἑορτὴν</char> <char style="w" x-id="SBLGNT.MAT.27.15.004" x-align="MAT.27.15.a006" x-target-ids="t007 t008" x-target="was wont" x-target-head="t008" x-head="true" lemma="εἴωθα" strong="G1486" x-morph="V-LAI-3S" x-gloss="was accustomed" x-translit="eiōthei" xml:lang="grc">εἰώθει</char> <char style="w" x-id="SBLGNT.MAT.27.15.005" x-align="MAT.27.15.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.27.15.006" x-align="MAT.27.15.a005" x-target-ids="t006" x-target="governor" x-target-head="t006" x-head="true" lemma="ἡγεμών" strong="G2232" x-morph="N-NSM" x-gloss="governor" x-translit="hēgemōn" xml:lang="grc">ἡγεμὼν</char> <char style="w" x-id="SBLGNT.MAT.27.15.007" x-align="MAT.27.15.a007" x-target-ids="t009 t010" x-target="to release" x-target-head="t010" x-head="true" lemma="ἀπολύω" strong="G630" x-morph="V-PAN" x-gloss="to release" x-translit="apolyein" xml:lang="grc">ἀπολύειν</char> <char style="w" x-id="SBLGNT.MAT.27.15.008" x-align="MAT.27.15.a010" x-target-ids="t014" x-target="one" x-target-head="t014" x-head="true" lem