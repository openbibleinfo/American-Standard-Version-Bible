	<para style="p"><verse number="22" style="v" x-ref="MAT.21.22" sid="MAT 21:22" /><char style="w" x-id="SBLGNT.MAT.21.22.001" x-align="MAT.21.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.MAT.21.22.002" x-align="MAT.21.22.a002" x-target-ids="t002 t003" x-target="all things" x-target-head="t002" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-APN" x-gloss="all things" x-translit="panta" xml:lang="grc">πάντα</char> <char style="w" x-id="SBLGNT.MAT.21.22.003" x-align="MAT.21.22.a003" x-target-ids="t004" x-target="whatsoever" x-target-head="t004" x-head="true" lemma="ὅσος" strong="G3745" x-morph="K-APN" x-gloss="as many as" x-translit="hosa" xml:lang="grc">ὅσα</char> <char style="w" x-id="SBLGNT.MAT.21.22.004" x-align="MAT.21.22.a003" lemma="ἄν" strong="G302" x-morph="PRT" x-gloss="-" x-translit="an" xml:lang="grc">ἂν</char> <char style="w" x-id="SBLGNT.MAT.21.22.005" x-align="MAT.21.22.a004" x-target-ids="t005 t006 t007" x-target="ye shall ask" x-target-head="t007" x-head="true" lemma="αἰτέω" strong="G154" x-morph="V-AAS-2P" x-gloss="you might ask" x-translit="aitēsēte" xml:lang="grc">αἰτήσητε</char> <char style="w" x-id="SBLGNT.MAT.21.22.006" x-align="MAT.21.22.a005" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.MAT.21.22.007" x-align="MAT.21.22.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="-" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.MAT.21.22.008" x-align="MAT.21.22.a007" x-target-ids="t009" x-target="prayer" x-target-head="t009" x-head="true" lemma="προσευχή" strong="G4335" x-morph="N-DSF" x-gloss="prayer" x-translit="proseuchēi" xml:lang="grc">προσευχῇ</char> <char style="w" x-id="