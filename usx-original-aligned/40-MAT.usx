	<para style="p"><verse number="13" style="v" x-ref="MAT.28.13" sid="MAT 28:13" /><char style="w" x-id="SBLGNT.MAT.28.13.001" x-align="MAT.28.13.a001" x-target-ids="t001" x-target="saying" x-target-head="t001" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NPM" x-gloss="saying" x-translit="legontes" xml:lang="grc">λέγοντες</char>·<char style="w" x-id="SBLGNT.MAT.28.13.002" x-align="MAT.28.13.a002" x-target-ids="t002 t003" x-target="Say ye" x-target-head="t002" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAM-2P" x-gloss="Say" x-translit="Eipate" xml:lang="grc">Εἴπατε</char> <char style="w" x-id="SBLGNT.MAT.28.13.003" x-align="MAT.28.13.a003" x-status="unrepresented" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.MAT.28.13.004" x-align="MAT.28.13.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="Hoi" xml:lang="grc">Οἱ</char> <char style="w" x-id="SBLGNT.MAT.28.13.005" x-align="MAT.28.13.a005" x-target-ids="t005" x-target="disciples" x-target-head="t005" x-head="true" lemma="μαθητής" strong="G3101" x-morph="N-NPM" x-gloss="disciples" x-translit="mathētai" xml:lang="grc">μαθηταὶ</char> <char style="w" x-id="SBLGNT.MAT.28.13.006" x-align="MAT.28.13.a006" x-target-ids="t004" x-target="His" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.MAT.28.13.007" x-align="MAT.28.13.a007" x-target-ids="t007 t008" x-target="by night" x-target-head="t008" x-head="true" lemma="νύξ" strong="G3571" x-morph="N-GSF" x-gloss="by night" x-translit="nyktos" xml:lang="grc">νυκτὸς</char> <char style="w" x-id="SBLGNT.MAT.28.13.008" x-align="MAT.28.13.a008" x-target-ids="t006" x-target="came" x-target-head="t006" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAP-NPM" x-gloss="having come" x