	<para style="p"><verse number="24" style="v" x-ref="MAT.20.24" sid="MAT 20:24" /><char style="w" x-id="SBLGNT.MAT.20.24.001" x-align="MAT.20.24.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.MAT.20.24.002" x-align="MAT.20.24.a002" x-target-ids="t002 t005 t006" x-target="when heard it" x-target-head="t005" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NPM" x-gloss="having heard [this]" x-translit="akousantes" xml:lang="grc">ἀκούσαντες</char> <char style="w" x-id="SBLGNT.MAT.20.24.003" x-align="MAT.20.24.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.MAT.20.24.004" x-align="MAT.20.24.a004" x-target-ids="t004" x-target="ten" x-target-head="t004" x-head="true" lemma="δέκα" strong="G1176" x-morph="A-NUI" x-gloss="ten" x-translit="deka" xml:lang="grc">δέκα</char> <char style="w" x-id="SBLGNT.MAT.20.24.005" x-align="MAT.20.24.a005" x-target-ids="t007 t008 t009 t010 t011" x-target="they were moved with indignation" x-target-head="t011" x-head="true" lemma="ἀγανακτέω" strong="G23" x-morph="V-AAI-3P" x-gloss="were indignant" x-translit="ēganaktēsan" xml:lang="grc">ἠγανάκτησαν</char> <char style="w" x-id="SBLGNT.MAT.20.24.006" x-align="MAT.20.24.a006" x-target-ids="t012" x-target="concerning" x-target-head="t012" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="about" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.MAT.20.24.007" x-align="MAT.20.24.a007" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.MAT.20.24.008" x-align="MAT.20.24.a008" x-target-ids="t014" x-target="