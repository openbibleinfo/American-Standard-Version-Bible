	<para style="p"><verse number="18" style="v" x-ref="MAT.19.18" sid="MAT 19:18" /><char style="w" x-id="SBLGNT.MAT.19.18.001" x-align="MAT.19.18.a001" x-target-ids="t001 t002" x-target="He saith" x-target-head="t002" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-3S" x-gloss="He says" x-translit="legei" xml:lang="grc">λέγει</char> <char style="w" x-id="SBLGNT.MAT.19.18.002" x-align="MAT.19.18.a002" x-target-ids="t003 t004" x-target="unto him" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.MAT.19.18.003" x-align="MAT.19.18.a003" x-target-ids="t005" x-target="Which" x-target-head="t005" x-head="true" lemma="ποῖος" strong="G4169" x-morph="I-APF" x-gloss="Which" x-translit="Poias" xml:lang="grc">Ποίας</char>;<char style="w" x-id="SBLGNT.MAT.19.18.004" x-align="MAT.19.18.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.MAT.19.18.005" x-align="MAT.19.18.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.MAT.19.18.006" x-align="MAT.19.18.a006" x-target-ids="t007" x-target="Jesus" x-target-head="t007" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.MAT.19.18.007" x-align="MAT.19.18.a007" x-target-ids="t008" x-target="said" x-target-head="t008" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-AAI-3S" x-translit="eipen" xml:lang="grc">εἶπεν</char>·<char style="w" x-id="SBLGNT.MAT.19.18.008" x-align="MAT.19.18.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="-" x-translit="To" xml:lang="grc">Τὸ</char> <char style="w" x-id="SBLGNT