	<para style="p"><verse number="21" style="v" x-ref="JDG.21.21" sid="JDG 21:21" /><char style="w" x-id="WLC.JDG.21.21.001" x-align="JDG.21.21.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JDG.21.21.002" x-align="JDG.21.21.a002" x-target-ids="t002" x-target="see" x-target-head="t002" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqq2mp" x-gloss="you.will.see" x-translit="rəʾîṯem" xml:lang="hbo">רְאִיתֶ֗ם</char> <char style="w" x-id="WLC.JDG.21.21.003" x-align="JDG.21.21.a003" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֠</char><char style="w" x-id="WLC.JDG.21.21.004" x-align="JDG.21.21.a004" x-target-ids="t004" x-target="behold" x-target-head="t004" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo">הִנֵּה</char> <char style="w" x-id="WLC.JDG.21.21.005" x-align="JDG.21.21.a005" x-target-ids="t005" x-target="if" x-target-head="t005" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JDG.21.21.006" x-align="JDG.21.21.a006" x-target-ids="t010 t011" x-target="come out" x-target-head="t010" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqi3mp" x-gloss="they.will.come.out" x-translit="yēṣəʾû" xml:lang="hbo">יֵ֨צְא֥וּ</char> <char style="w" x-id="WLC.JDG.21.21.007" x-align="JDG.21.21.a007" x-target-ids="t006 t007" x-target="the daughters" x-target-head="t007" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfpc" x-gloss="the.daughters" x-translit="ḇənôṯ-" xml:lang="hbo">בְנוֹת</char>־<char style="w" x-id="WLC.JDG.21.21.008" x-align="JDG.21.21.a008" x-target-ids="t008 t009" x-target="of Shiloh" x-target-head="t009" x-head="true" lemma="שִׁלוֹ" strong="H7887" x-morp