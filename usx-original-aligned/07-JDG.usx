	<para style="p"><verse number="22" style="v" x-ref="JDG.21.22" x-added-alignments="JDG.21.22.a026 JDG.21.22.a035 JDG.21.22.a038" x-added-target-ids="t034 t035 t044 t047" x-added-target="of them | them | else" sid="JDG 21:22" /><char style="w" x-id="WLC.JDG.21.22.001" x-align="JDG.21.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JDG.21.22.002" x-align="JDG.21.22.a002" x-target-ids="t002 t003 t004" x-target="it shall be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָ֡ה</char> <char style="w" x-id="WLC.JDG.21.22.003" x-align="JDG.21.22.a003" x-target-ids="t005" x-target="when" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JDG.21.22.004" x-align="JDG.21.22.a004" x-target-ids="t011" x-target="come" x-target-head="t011" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3mp" x-gloss="they.will.come" x-translit="yāḇōʾû" xml:lang="hbo">יָבֹ֣אוּ</char> <char style="w" x-id="WLC.JDG.21.22.005" x-align="JDG.21.22.a005" x-target-ids="t007" x-target="fathers" x-target-head="t007" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmpc" x-gloss="fathers" x-translit="ʾăḇôṯ" xml:lang="hbo">אֲבוֹתָ</char><char style="w" x-id="WLC.JDG.21.22.006" x-align="JDG.21.22.a006" x-target-ids="t006" x-target="their" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם֩</char> <char style="w" x-id="WLC.JDG.21.22.007" x-align="JDG.21.22.a007" x-target-ids="t008" x-target="or" x-target-head="t008" x-head="true" lemma="אוֹ" strong="H176" x-morph="C" x-gloss="or" x-translit="ʾô" xml:lang="hbo">א֨וֹ</char> <char style="w" x-id="WLC.JDG.21.22.008" x-align="JDG.21.22.a00