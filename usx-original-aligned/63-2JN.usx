	<para style="p"><verse number="8" style="v" x-ref="2JN.1.8" sid="2JN 1:8" /><char style="w" x-id="SBLGNT.2JN.1.8.001" x-align="2JN.1.8.a001" x-target-ids="t001" x-target="Look" x-target-head="t001" x-head="true" lemma="βλέπω" strong="G991" x-morph="V-PAM-2P" x-gloss="Watch" x-translit="blepete" xml:lang="grc">βλέπετε</char> <char style="w" x-id="SBLGNT.2JN.1.8.002" x-align="2JN.1.8.a002" x-target-ids="t002 t003" x-target="to yourselves" x-target-head="t003" x-head="true" lemma="ἑαυτοῦ" strong="G1438" x-morph="F-2APM" x-gloss="yourselves" x-translit="heautous" xml:lang="grc">ἑαυτούς</char>,<char style="w" x-id="SBLGNT.2JN.1.8.003" x-align="2JN.1.8.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.2JN.1.8.004" x-align="2JN.1.8.a004" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.2JN.1.8.005" x-align="2JN.1.8.a005" x-target-ids="t005 t006" x-target="ye lose" x-target-head="t006" x-head="true" lemma="ἀπόλλυμι" strong="G622" x-morph="V-AAS-2P" x-gloss="you should lose" x-translit="apolesēte" xml:lang="grc">ἀπολέσητε</char> <char style="w" x-id="SBLGNT.2JN.1.8.006" x-align="2JN.1.8.a006" x-target-ids="t008 t009 t010" x-target="the things which" x-target-head="t009" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-APN" x-gloss="what things" x-translit="ha" xml:lang="grc">ἃ</char> <char style="w" x-id="SBLGNT.2JN.1.8.007" x-align="2JN.1.8.a007" x-target-ids="t011 t012 t013" x-target="we have wrought" x-target-head="t013" x-head="true" lemma="ἐργάζομαι" strong="G2038" x-morph="V-ADI-1P" x-gloss="we have worked for" x-translit="eirgasametha" xml:lang="grc">εἰργασάμεθα</char>,<char style="w" x-id="SBLGNT.2JN.1.8.008" x-align="2JN.1.8.a008" x-target-ids="t014" x-target="b