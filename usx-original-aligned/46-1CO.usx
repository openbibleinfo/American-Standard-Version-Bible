ίω" strong="G2068" x-morph="V-PAI-3S" x-gloss="eats" x-translit="esthiei" xml:lang="grc">ἐσθίει</char> <char style="w" x-id="SBLGNT.1CO.11.29.009" x-align="1CO.11.29.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1CO.11.29.010" x-align="1CO.11.29.a008" x-target-ids="t009" x-target="drinketh" x-target-head="t009" x-head="true" lemma="πίνω" strong="G4095" x-morph="V-PAI-3S" x-gloss="drinks" x-translit="pinei" xml:lang="grc">πίνει</char> <char style="w" x-id="SBLGNT.1CO.11.29.011" x-align="1CO.11.29.a012" x-target-ids="t016" x-target="not" x-target-head="t016" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.1CO.11.29.012" x-align="1CO.11.29.a011" x-target-ids="t013 t014 t015" x-target="if he discern" x-target-head="t015" x-head="true" lemma="διακρίνω" strong="G1252" x-morph="V-PAP-NSM" x-gloss="discerning" x-translit="diakrinōn" xml:lang="grc">διακρίνων</char> <char style="w" x-id="SBLGNT.1CO.11.29.013" x-align="1CO.11.29.a013" x-target-ids="t017" x-target="the" x-target-head="t017" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.1CO.11.29.014" x-align="1CO.11.29.a014" x-target-ids="t018" x-target="body" x-target-head="t018" x-head="true" lemma="σῶμα" strong="G4983" x-morph="N-ASN" x-gloss="body" x-translit="sōma" xml:lang="grc">σῶμα</char>.<verse eid="1CO 11:29" /></para>
