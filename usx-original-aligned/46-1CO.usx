	<para style="p"><verse number="3" style="v" x-ref="1CO.1.3" sid="1CO 1:3" /><char style="w" x-id="SBLGNT.1CO.1.3.001" x-align="1CO.1.3.a001" x-target-ids="t001" x-target="Grace" x-target-head="t001" x-head="true" lemma="χάρις" strong="G5485" x-morph="N-NSF" x-gloss="Grace" x-translit="charis" xml:lang="grc">χάρις</char> <char style="w" x-id="SBLGNT.1CO.1.3.002" x-align="1CO.1.3.a002" x-target-ids="t002 t003" x-target="to you" x-target-head="t003" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.1CO.1.3.003" x-align="1CO.1.3.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1CO.1.3.004" x-align="1CO.1.3.a004" x-target-ids="t005" x-target="peace" x-target-head="t005" x-head="true" lemma="εἰρήνη" strong="G1515" x-morph="N-NSF" x-gloss="peace" x-translit="eirēnē" xml:lang="grc">εἰρήνη</char> <char style="w" x-id="SBLGNT.1CO.1.3.005" x-align="1CO.1.3.a005" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="apo" xml:lang="grc">ἀπὸ</char> <char style="w" x-id="SBLGNT.1CO.1.3.006" x-align="1CO.1.3.a006" x-target-ids="t007" x-target="God" x-target-head="t007" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="God" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.1CO.1.3.007" x-align="1CO.1.3.a007" x-target-ids="t009" x-target="Father" x-target-head="t009" x-head="true" lemma="πατήρ" strong="G3962" x-morph="N-GSM" x-gloss="Father" x-translit="patros" xml:lang="grc">πατρὸς</char> <char style="w" x-id="SBLGNT.1CO.1.3.008" x-align="1CO.1.3.a008" x-target-ids="t008" x-target="our" x-target-head="t008" x-head="true" lemma="ἐγώ" strong="G2257" x-morph="P-1GP" x-gloss="of us" x-translit="hēmōn" xml:lang="g