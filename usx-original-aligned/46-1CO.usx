	<para style="p"><verse number="34" style="v" x-ref="1CO.11.34" sid="1CO 11:34" /><char style="w" x-id="SBLGNT.1CO.11.34.001" x-align="1CO.11.34.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἴ</char> <char style="w" x-id="SBLGNT.1CO.11.34.002" x-align="1CO.11.34.a002" x-target-ids="t002 t003" x-target="any man" x-target-head="t002" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.1CO.11.34.003" x-align="1CO.11.34.a003" x-target-ids="t004 t005" x-target="is hungry" x-target-head="t005" x-head="true" lemma="πεινάω" strong="G3983" x-morph="V-PAI-3S" x-gloss="is hungry" x-translit="peinai" xml:lang="grc">πεινᾷ</char>,<char style="w" x-id="SBLGNT.1CO.11.34.004" x-align="1CO.11.34.a005" x-target-ids="t009" x-target="at" x-target-head="t009" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="at" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1CO.11.34.005" x-align="1CO.11.34.a006" x-target-ids="t010" x-target="home" x-target-head="t010" x-head="true" lemma="οἶκος" strong="G3624" x-morph="N-DSM" x-gloss="home" x-translit="oikōi" xml:lang="grc">οἴκῳ</char> <char style="w" x-id="SBLGNT.1CO.11.34.006" x-align="1CO.11.34.a004" x-target-ids="t006 t007 t008" x-target="let him eat" x-target-head="t008" x-head="true" lemma="ἐσθίω" strong="G2068" x-morph="V-PAM-3S" x-gloss="let him eat" x-translit="esthietō" xml:lang="grc">ἐσθιέτω</char>,<char style="w" x-id="SBLGNT.1CO.11.34.007" x-align="1CO.11.34.a007" x-target-ids="t011" x-target="that" x-target-head="t011" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.1CO.11.34.008" x-align="1CO.11.34.a009" x-target-ids="t016" x-target="not" x-target-head="t016" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.1CO.11.34.009" x-align="1CO.11.34.a010" x-target-ids="t017" x-target="unto" x-target-head="t017" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="for" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.1CO.11.34.010" x-align="1CO.11.34.a011" x-target-ids="t018" x-target="judgment" x-target-head="t018" x-head="true" lemma="κρίμα" strong="G2917" x-morph="N-ASN" x-gloss="judgment" x-translit="krima" xml:lang="grc">κρίμα</char> <char style="w" x-id="SBLGNT.1CO.11.34.011" x-align="1CO.11.34.a008" x-target-ids="t012 t013 t014 t015" x-target="your coming together be" x-target-head="t013" x-head="true" lemma="συνέρχομαι" strong="G4905" x-morph="V-PNS-2P" x-gloss="you might come together" x-translit="synerchēsthe" xml:lang="grc">συνέρχησθε</char>.<char style="w" x-id="SBLGNT.1CO.11.34.012" x-align="1CO.11.34.a013" x-target-ids="t020" x-target="the" x-target-head="t020" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-gloss="-" x-translit="Ta" xml:lang="grc">Τὰ</char> <char style="w" x-id="SBLGNT.1CO.11.34.013" x-align="1CO.11.34.a012" x-target-ids="t019" x-target="And" x-target-head="t019" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.1CO.11.34.014" x-align="1CO.11.34.a014" x-target-ids="t021" x-target="rest" x-target-head="t021" x-head="true" lemma="λοιπός" strong="G3062" x-morph="A-APN" x-gloss="the other things" x-translit="loipa" xml:lang="grc">λοιπὰ</char> <char style="w" x-id="SBLGNT.1CO.11.34.015" x-align="1CO.11.34.a016" x-target-ids="t027" x-target="whensoever" x-target-head="t027" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as soon as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.1CO.11.34.016" x-align="1CO.11.34.a016" lemma="ἄν" strong="G302" x-morph="PRT" x-gloss="-" x-translit="an" xm