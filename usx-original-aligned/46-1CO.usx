	<para style="p"><verse number="2" style="v" x-ref="1CO.4.2" sid="1CO 4:2" /><char style="w" x-id="SBLGNT.1CO.4.2.001" x-align="1CO.4.2.a001" x-target-ids="t001" x-target="Here" x-target-head="t001" x-head="true" lemma="ὧδε" strong="G5602" x-morph="ADV" x-gloss="In this case" x-translit="hōde" xml:lang="grc">ὧδε</char> <char style="w" x-id="SBLGNT.1CO.4.2.002" x-align="1CO.4.2.a002" x-target-ids="t002" x-target="moreover" x-target-head="t002" x-head="true" lemma="λοιπός" strong="G3063" x-morph="A-ASN" x-gloss="moreover" x-translit="loipon" xml:lang="grc">λοιπὸν</char> <char style="w" x-id="SBLGNT.1CO.4.2.003" x-align="1CO.4.2.a003" x-target-ids="t003 t004 t005" x-target="it is required" x-target-head="t005" x-head="true" lemma="ζητέω" strong="G2212" x-morph="V-PPI-3S" x-gloss="it is required" x-translit="zēteitai" xml:lang="grc">ζητεῖται</char> <char style="w" x-id="SBLGNT.1CO.4.2.004" x-align="1CO.4.2.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1CO.4.2.005" x-align="1CO.4.2.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM" x-gloss="the" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.1CO.4.2.006" x-align="1CO.4.2.a006" x-target-ids="t007" x-target="stewards" x-target-head="t007" x-head="true" lemma="οἰκονόμος" strong="G3623" x-morph="N-DPM" x-gloss="stewards" x-translit="oikonomois" xml:lang="grc">οἰκονόμοις</char> <char style="w" x-id="SBLGNT.1CO.4.2.007" x-align="1CO.4.2.a007" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.1CO.4.2.008" x-align="1CO.4.2.a010" x-target-ids="t013" x-target="faithful" x-target-head="t013" x-head="true" lemma="πιστός" strong="G4103" x-morph="A-NSM" x-gloss="faithful" x-t