	<para style="p"><verse number="32" style="v" x-ref="1CO.11.32" sid="1CO 11:32" /><char style="w" x-id="SBLGNT.1CO.11.32.001" x-align="1CO.11.32.a002" x-target-ids="t002 t003 t004 t005" x-target="when we are judged" x-target-head="t005" x-head="true" lemma="κρίνω" strong="G2919" x-morph="V-PPP-NPM" x-gloss="Being judged" x-translit="krinomenoi" xml:lang="grc">κρινόμενοι</char> <char style="w" x-id="SBLGNT.1CO.11.32.002" x-align="1CO.11.32.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.1CO.11.32.003" x-align="1CO.11.32.a004" x-target-ids="t009" x-target="of" x-target-head="t009" x-head="true" lemma="ὑπό" strong="G5259" x-morph="PREP" x-gloss="by" x-translit="hypo" xml:lang="grc">ὑπὸ</char> <char style="w" x-id="SBLGNT.1CO.11.32.004" x-align="1CO.11.32.a005" x-target-ids="t010 t011" x-target="the Lord" x-target-head="t011" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-GSM" x-gloss="Lord" x-translit="kyriou" xml:lang="grc">κυρίου</char> <char style="w" x-id="SBLGNT.1CO.11.32.005" x-align="1CO.11.32.a003" x-target-ids="t006 t007 t008" x-target="we are chastened" x-target-head="t008" x-head="true" lemma="παιδεύω" strong="G3811" x-morph="V-PPI-1P" x-gloss="we are disciplined" x-translit="paideuometha" xml:lang="grc">παιδευόμεθα</char>,<char style="w" x-id="SBLGNT.1CO.11.32.006" x-align="1CO.11.32.a006" x-target-ids="t012" x-target="that" x-target-head="t012" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.1CO.11.32.007" x-align="1CO.11.32.a007" x-target-ids="t015" x-target="not" x-target-head="t015" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.1CO.11.32.008" x-align="1CO.11.32.a009" x-target-ids="t018" x-target="with"