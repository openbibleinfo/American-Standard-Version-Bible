	<para style="p"><verse number="1" style="v" x-ref="1CO.12.1" sid="1CO 12:1" /><char style="w" x-id="SBLGNT.1CO.12.1.001" x-align="1CO.12.1.a002" x-target-ids="t002" x-target="concerning" x-target-head="t002" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="Concerning" x-translit="Peri" xml:lang="grc">Περὶ</char> <char style="w" x-id="SBLGNT.1CO.12.1.002" x-align="1CO.12.1.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.1CO.12.1.003" x-align="1CO.12.1.a003" x-target-ids="t004" x-target="gifts" x-target-italic-ids="t004" x-target-head="t004" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPN" x-gloss="-" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.1CO.12.1.004" x-align="1CO.12.1.a004" x-target-ids="t003" x-target="spiritual" x-target-head="t003" x-head="true" lemma="πνευματικός" strong="G4152" x-morph="A-GPN" x-gloss="spiritual [gifts]" x-translit="pneumatikōn" xml:lang="grc">πνευματικῶν</char>,<char style="w" x-id="SBLGNT.1CO.12.1.005" x-align="1CO.12.1.a005" x-target-ids="t005" x-target="brethren" x-target-head="t005" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char>,<char style="w" x-id="SBLGNT.1CO.12.1.006" x-align="1CO.12.1.a007" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.1CO.12.1.007" x-align="1CO.12.1.a006" x-target-ids="t006 t007" x-target="I would" x-target-head="t007" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-PAI-1S" x-gloss="I do want" x-translit="thelō" xml:lang="grc">θέλω</char> <char style="w" x-id="SBLGNT.1CO.12.1.008" x-align="1CO.12.1.a009" x-target-ids="t010" x-target="you" x-target-head="t010" x-head="true" lemm