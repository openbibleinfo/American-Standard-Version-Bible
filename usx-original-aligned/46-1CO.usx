	<para style="p"><verse number="24" style="v" x-ref="1CO.16.24" sid="1CO 16:24" /><char style="w" x-id="SBLGNT.1CO.16.24.001" x-align="1CO.16.24.a001" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="The" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.1CO.16.24.002" x-align="1CO.16.24.a003" x-target-ids="t002" x-target="love" x-target-head="t002" x-head="true" lemma="ἀγάπη" strong="G26" x-morph="N-NSF" x-gloss="love" x-translit="agapē" xml:lang="grc">ἀγάπη</char> <char style="w" x-id="SBLGNT.1CO.16.24.003" x-align="1CO.16.24.a002" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of Me" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.1CO.16.24.004" x-align="1CO.16.24.a004" x-target-ids="t003 t004" x-target="be with" x-target-head="t004" x-head="true" lemma="μετά" strong="G3326" x-morph="PREP" x-gloss="[be] with" x-translit="meta" xml:lang="grc">μετὰ</char> <char style="w" x-id="SBLGNT.1CO.16.24.005" x-align="1CO.16.24.a006" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-GPM" x-gloss="all" x-translit="pantōn" xml:lang="grc">πάντων</char> <char style="w" x-id="SBLGNT.1CO.16.24.006" x-align="1CO.16.24.a005" x-target-ids="t005" x-target="you" x-target-head="t005" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char> <char style="w" x-id="SBLGNT.1CO.16.24.007" x-align="1CO.16.24.a007" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1CO.16.24.008" x-align="1CO.16.24.a008" x-target-ids="t008" x-target="Christ" x-target-head="t008" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-DSM" x-gloss="Christ" x-translit="Christōi" xml:lang="grc">Χριστῷ</char