	<para style="p"><verse number="2" style="v" x-ref="1CO.12.2" sid="1CO 12:2" /><char style="w" x-id="SBLGNT.1CO.12.2.001" x-align="1CO.12.2.a001" x-target-ids="t001 t002" x-target="Ye know" x-target-head="t002" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAI-2P" x-gloss="You know" x-translit="oidate" xml:lang="grc">οἴδατε</char> <char style="w" x-id="SBLGNT.1CO.12.2.002" x-align="1CO.12.2.a002" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.1CO.12.2.003" x-align="1CO.12.2.a003" x-target-ids="t004" x-target="when" x-target-head="t004" x-head="true" lemma="ὅτε" strong="G3753" x-morph="ADV" x-gloss="when" x-translit="hote" xml:lang="grc">ὅτε</char> <char style="w" x-id="SBLGNT.1CO.12.2.004" x-align="1CO.12.2.a005" x-target-ids="t007" x-target="Gentiles" x-target-head="t007" x-head="true" lemma="ἔθνος" strong="G1484" x-morph="N-NPN" x-gloss="pagans" x-translit="ethnē" xml:lang="grc">ἔθνη</char> <char style="w" x-id="SBLGNT.1CO.12.2.005" x-align="1CO.12.2.a004" x-target-ids="t005 t006" x-target="ye were" x-target-head="t006" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-2P" x-gloss="you were" x-translit="ēte" xml:lang="grc">ἦτε</char> <char style="w" x-id="SBLGNT.1CO.12.2.006" x-align="1CO.12.2.a007" x-target-ids="t012" x-target="unto" x-target-head="t012" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.1CO.12.2.007" x-align="1CO.12.2.a008" x-target-ids="t013" x-target="those" x-target-head="t013" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-gloss="-" x-translit="ta" xml:lang="grc">τὰ</char> <char style="w" x-id="SBLGNT.1CO.12.2.008" x-align="1CO.12.2.a011" x-target-ids="t015" x-target="idols" x-target-head="t015" x-head="true" lemma="εἴδωλον" strong="G1497" x-morph="N-APN" x-gloss="idols" x-tr