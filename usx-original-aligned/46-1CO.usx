	<para style="p"><verse number="33" style="v" x-ref="1CO.11.33" sid="1CO 11:33" /><char style="w" x-id="SBLGNT.1CO.11.33.001" x-align="1CO.11.33.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="ὥστε" strong="G5620" x-morph="CONJ" x-gloss="So then" x-translit="Hōste" xml:lang="grc">Ὥστε</char>,<char style="w" x-id="SBLGNT.1CO.11.33.002" x-align="1CO.11.33.a003" x-target-ids="t003" x-target="brethren" x-target-head="t003" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char> <char style="w" x-id="SBLGNT.1CO.11.33.003" x-align="1CO.11.33.a002" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of me" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.1CO.11.33.004" x-align="1CO.11.33.a004" x-target-ids="t004 t005 t006 t007" x-target="when ye come together" x-target-head="t006" x-head="true" lemma="συνέρχομαι" strong="G4905" x-morph="V-PNP-NPM" x-gloss="coming together" x-translit="synerchomenoi" xml:lang="grc">συνερχόμενοι</char> <char style="w" x-id="SBLGNT.1CO.11.33.005" x-align="1CO.11.33.a005" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="in order" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.1CO.11.33.006" x-align="1CO.11.33.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.1CO.11.33.007" x-align="1CO.11.33.a007" x-target-ids="t009" x-target="eat" x-target-head="t009" x-head="true" lemma="ἐσθίω" strong="G5315" x-morph="V-2AAN" x-gloss="to eat" x-translit="phagein" xml:lang="grc">φαγεῖν</char> <char style="w" x-id="SBLGNT.1CO.11.33.008" x-align="1CO.11.33.a009" x-target-ids="t011 t013" x-target="one another" x-target-head="t013" x-head="true" lemm