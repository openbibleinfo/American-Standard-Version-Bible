	<para style="p"><verse number="23" style="v" x-ref="1CO.16.23" sid="1CO 16:23" /><char style="w" x-id="SBLGNT.1CO.16.23.001" x-align="1CO.16.23.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="The" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.1CO.16.23.002" x-align="1CO.16.23.a002" x-target-ids="t002" x-target="grace" x-target-head="t002" x-head="true" lemma="χάρις" strong="G5485" x-morph="N-NSF" x-gloss="grace" x-translit="charis" xml:lang="grc">χάρις</char> <char style="w" x-id="SBLGNT.1CO.16.23.003" x-align="1CO.16.23.a003" x-target-ids="t003 t004" x-target="of the" x-target-head="t004" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="of the" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.1CO.16.23.004" x-align="1CO.16.23.a004" x-target-ids="t005" x-target="Lord" x-target-head="t005" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-GSM" x-gloss="Lord" x-translit="kyriou" xml:lang="grc">κυρίου</char> <char style="w" x-id="SBLGNT.1CO.16.23.005" x-align="1CO.16.23.a005" x-target-ids="t006" x-target="Jesus" x-target-head="t006" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-GSM" x-gloss="Jesus" x-translit="Iēsou" xml:lang="grc">Ἰησοῦ</char> <char style="w" x-id="SBLGNT.1CO.16.23.v017.r01.001" x-align="1CO.16.23.a006" x-target-ids="t007" x-target="Christ" x-target-head="t007" x-head="true" x-translit="Christou" xml:lang="grc">Χριστοῦ</char> <char style="w" x-id="SBLGNT.1CO.16.23.006" x-align="1CO.16.23.a007" x-target-ids="t008 t009" x-target="be with" x-target-head="t009" x-head="true" lemma="μετά" strong="G3326" x-morph="PREP" x-gloss="[be] with" x-translit="meth" xml:lang="grc">μεθ</char>ʼ<char style="w" x-id="SBLGNT.1CO.16.23.007" x-align="1CO.16.23.a008" x-target-ids="t010" x-target="you" x-target-head="t010" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="you" x-translit="hymōn" xml:lang="grc"