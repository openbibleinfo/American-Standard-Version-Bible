	<para style="p"><verse number="4" style="v" x-ref="1CO.1.4" sid="1CO 1:4" /><char style="w" x-id="SBLGNT.1CO.1.4.001" x-align="1CO.1.4.a001" x-target-ids="t001 t002" x-target="I thank" x-target-head="t002" x-head="true" lemma="εὐχαριστέω" strong="G2168" x-morph="V-PAI-1S" x-gloss="I thank" x-translit="Eucharistō" xml:lang="grc">Εὐχαριστῶ</char> <char style="w" x-id="SBLGNT.1CO.1.4.002" x-align="1CO.1.4.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="the" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.1CO.1.4.003" x-align="1CO.1.4.a003" x-target-ids="t004" x-target="God" x-target-head="t004" x-head="true" lemma="θεός" strong="G2316" x-morph="N-DSM" x-gloss="God" x-translit="theōi" xml:lang="grc">θεῷ</char> <char style="w" x-id="SBLGNT.1CO.1.4.004" x-align="1CO.1.4.a004" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-GS-" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.1CO.1.4.005" x-align="1CO.1.4.a005" x-target-ids="t005" x-target="always" x-target-head="t005" x-head="true" lemma="πάντοτε" strong="G3842" x-morph="ADV" x-gloss="always" x-translit="pantote" xml:lang="grc">πάντοτε</char> <char style="w" x-id="SBLGNT.1CO.1.4.006" x-align="1CO.1.4.a006" x-target-ids="t006" x-target="concerning" x-target-head="t006" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="concerning" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.1CO.1.4.007" x-align="1CO.1.4.a007" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char> <char style="w" x-id="SBLGNT.1CO.1.4.008" x-align="1CO.1.4.a008" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="for" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id