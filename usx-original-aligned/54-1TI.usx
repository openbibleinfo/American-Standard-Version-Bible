	<para style="p"><verse number="2" style="v" x-ref="1TI.4.2" sid="1TI 4:2" /><char style="w" x-id="SBLGNT.1TI.4.2.001" x-align="1TI.4.2.a001" x-target-ids="t001" x-target="through" x-target-head="t001" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1TI.4.2.002" x-align="1TI.4.2.a002" x-target-ids="t002 t003" x-target="the hypocrisy" x-target-head="t003" x-head="true" lemma="ὑπόκρισις" strong="G5272" x-morph="N-DSF" x-gloss="hypocrisy" x-translit="hypokrisei" xml:lang="grc">ὑποκρίσει</char> <char style="w" x-id="SBLGNT.1TI.4.2.003" x-align="1TI.4.2.a003" x-target-ids="t004 t005 t006 t007 t008" x-target="of men that speak lies" x-target-head="t007" x-head="true" lemma="ψευδολόγος" strong="G5573" x-morph="A-GPM" x-gloss="of speakers of lies" x-translit="pseudologōn" xml:lang="grc">ψευδολόγων</char>,<char style="w" x-id="SBLGNT.1TI.4.2.004" x-align="1TI.4.2.a004" x-target-ids="t009 t014 t015 t016 t017 t018" x-target="branded as with a hot iron" x-target-head="t009" x-head="true" lemma="καυστηριάζω" strong="G2743" x-morph="V-RPP-GPM" x-gloss="having been seared" x-translit="kekaustēriasmenōn" xml:lang="grc">κεκαυστηριασμένων</char> <char style="w" x-id="SBLGNT.1TI.4.2.005" x-align="1TI.4.2.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="in the" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.1TI.4.2.006" x-align="1TI.4.2.a006" x-target-ids="t011 t012" x-target="their own" x-target-head="t012" x-head="true" lemma="ἴδιος" strong="G2398" x-morph="A-ASF" x-gloss="own" x-translit="idian" xml:lang="grc">ἰδίαν</char> <char style="w" x-id="SBLGNT.1TI.4.2.007" x-align="1TI.4.2.a007" x-target-ids="t010 t013" x-target="in conscience" x-target-head="t013" x-head="true" lemma="συνείδησις" strong="G4893" x-morph="N-ASF" x-gloss="conscience" x-translit="syneidēsin" xml:lang="grc">συνείδησιν</char>,<verse eid="1TI 4:2" /></para