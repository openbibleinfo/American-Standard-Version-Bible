	<para style="p"><verse number="3" style="v" x-ref="1TI.1.3" sid="1TI 1:3" /><char style="w" x-id="SBLGNT.1TI.1.3.001" x-align="1TI.1.3.a001" x-target-ids="t001" x-target="As" x-target-head="t001" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="Just as" x-translit="Kathōs" xml:lang="grc">Καθὼς</char> <char style="w" x-id="SBLGNT.1TI.1.3.002" x-align="1TI.1.3.a002" x-target-ids="t002 t003" x-target="I exhorted" x-target-head="t003" x-head="true" lemma="παρακαλέω" strong="G3870" x-morph="V-AAI-1S" x-gloss="I urged" x-translit="parekalesa" xml:lang="grc">παρεκάλεσά</char> <char style="w" x-id="SBLGNT.1TI.1.3.003" x-align="1TI.1.3.a003" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.1TI.1.3.004" x-align="1TI.1.3.a004" x-target-ids="t005 t006" x-target="to tarry" x-target-head="t006" x-head="true" lemma="προσμένω" strong="G4357" x-morph="V-AAN" x-gloss="to remain" x-translit="prosmeinai" xml:lang="grc">προσμεῖναι</char> <char style="w" x-id="SBLGNT.1TI.1.3.005" x-align="1TI.1.3.a005" x-target-ids="t007" x-target="at" x-target-head="t007" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1TI.1.3.006" x-align="1TI.1.3.a006" x-target-ids="t008" x-target="Ephesus" x-target-head="t008" x-head="true" lemma="Ἔφεσος" strong="G2181" x-morph="N-DSF" x-gloss="Ephesus" x-translit="Ephesōi" xml:lang="grc">Ἐφέσῳ</char>,<char style="w" x-id="SBLGNT.1TI.1.3.007" x-align="1TI.1.3.a007" x-target-ids="t009 t010 t011 t012" x-target="when I was going" x-target-head="t012" x-head="true" lemma="πορεύομαι" strong="G4198" x-morph="V-PNP-NSM" x-gloss="[when] I was going" x-translit="poreuomenos" xml:lang="grc">πορευόμενος</char> <char style="w" x-id="SBLGNT.1TI.1.3.008" x-align="1TI.1.3.a008" x-target-ids="t013" x-target="into" x-target-head="t0