	<para style="p"><verse number="10" style="v" x-ref="1TI.5.10" sid="1TI 5:10" /><char style="w" x-id="SBLGNT.1TI.5.10.001" x-align="1TI.5.10.a002" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1TI.5.10.002" x-align="1TI.5.10.a004" x-target-ids="t006" x-target="works" x-target-head="t006" x-head="true" lemma="ἔργον" strong="G2041" x-morph="N-DPN" x-gloss="works" x-translit="ergois" xml:lang="grc">ἔργοις</char> <char style="w" x-id="SBLGNT.1TI.5.10.003" x-align="1TI.5.10.a003" x-target-ids="t005" x-target="good" x-target-head="t005" x-head="true" lemma="καλός" strong="G2570" x-morph="A-DPN" x-gloss="good" x-translit="kalois" xml:lang="grc">καλοῖς</char> <char style="w" x-id="SBLGNT.1TI.5.10.004" x-align="1TI.5.10.a001" x-target-ids="t001 t002 t003" x-target="well reported of" x-target-head="t002" x-head="true" lemma="μαρτυρέω" strong="G3140" x-morph="V-PPP-NSF" x-gloss="being borne witness to" x-translit="martyroumenē" xml:lang="grc">μαρτυρουμένη</char>,<char style="w" x-id="SBLGNT.1TI.5.10.005" x-align="1TI.5.10.a005" x-target-ids="t007" x-target="if" x-target-head="t007" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.1TI.5.10.006" x-align="1TI.5.10.a006" x-target-ids="t008 t009 t010 t011 t012" x-target="she hath brought up children" x-target-head="t010" x-head="true" lemma="τεκνοτροφέω" strong="G5044" x-morph="V-AAI-3S" x-gloss="she has brought up children" x-translit="eteknotrophēsen" xml:lang="grc">ἐτεκνοτρόφησεν</char>,<char style="w" x-id="SBLGNT.1TI.5.10.007" x-align="1TI.5.10.a007" x-target-ids="t013" x-target="if" x-target-head="t013" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.1TI.5.10.008" x-align="1TI.5.10.a008" x-target-ids="t01