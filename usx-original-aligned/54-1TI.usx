	<para style="p"><verse number="6" style="v" x-ref="1TI.5.6" sid="1TI 5:6" /><char style="w" x-id="SBLGNT.1TI.5.6.001" x-align="1TI.5.6.a002" x-target-ids="t002" x-target="she" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="She" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.1TI.5.6.002" x-align="1TI.5.6.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.1TI.5.6.003" x-align="1TI.5.6.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="that giveth herself to pleasure" x-target-head="t007" x-head="true" lemma="σπαταλάω" strong="G4684" x-morph="V-PAP-NSF" x-gloss="living in self-indulgence" x-translit="spatalōsa" xml:lang="grc">σπαταλῶσα</char> <char style="w" x-id="SBLGNT.1TI.5.6.004" x-align="1TI.5.6.a005" x-target-ids="t010 t011 t012" x-target="while she liveth" x-target-head="t012" x-head="true" lemma="ζάω" strong="G2198" x-morph="V-PAP-NSF" x-gloss="[while] living" x-translit="zōsa" xml:lang="grc">ζῶσα</char> <char style="w" x-id="SBLGNT.1TI.5.6.005" x-align="1TI.5.6.a004" x-target-ids="t008 t009" x-target="is dead" x-target-head="t009" x-head="true" lemma="θνῄσκω" strong="G2348" x-morph="V-RAI-3S" x-gloss="is dead" x-translit="tethnēken" xml:lang="grc">τέθνηκεν</char>.<verse eid="1TI 5:6" /></para>
	<para style="p"><verse number="7" style="v" x-ref="1TI.5.7" sid="1TI 5:7" /><char style="w" x-id="SBLGNT.1TI.5.7.001" x-align="1TI.5.7.a002" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="Also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1TI.5.7.002" x-align="1TI.5.7.a001" x-target-ids="t001 t002" x-target="These things" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="these things" x-translit="tauta" xml:lang="grc">ταῦτα</char> <char style="w" x-id="SBLGNT.1TI.5.7.003" x-align="1TI.5.7.a003" x-target-ids="t004" x-target="command" x-target-head="t004" x-head="true" lemma="παραγγέλλω" strong="G3853" x-morph="V-PAM-2S" x-gloss="command" x-translit="parangelle" xml:lang="grc">παράγγελλε</char>,<char style="w" x-id="SBLGNT.1TI.5.7.004" x-align="1TI.5.7.a004" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.1TI.5.7.005" x-align="1TI.5.7.a006" x-target-ids="t009 t010" x-target="without reproach" x-target-head="t010" x-head="true" lemma="ἀνεπίλημπτος" strong="G423" x-morph="A-NPM" x-gloss="above reproach" x-translit="anepilēmptoi" xml:lang="grc">ἀνεπίλημπτοι</char> <char style="w" x-id="SBLGNT.1TI.5.7.006" x-align="1TI.5.7.a005" x-target-ids="t006 t007 t008" x-target="they may be" x-target-head="t008" x-head="true" lemma="εἰμί" strong="G5600" x-morph="V-PAS-3P" x-gloss="they should be" x-translit="ōsin" xml:lang="grc">ὦσιν</char>·<verse eid="1TI 5:7" /></para>
	<para style="p"><verse number="8" style="v" x-ref="1TI.5.8" sid="1TI 5:8" /><char style="w" x-id="SBLGNT.1TI.5.8.001" x-align="1TI.5.8.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.1TI.5.8.002" x-align="1TI.5.8.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δέ</char> <char style="w" x-id="SBLGNT.1TI.5.8.003" x-align="1TI.5.8.a003" x-target-ids="t003" x-target="any" x-target-head="t003" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.1TI.5.8.004" x-align="1TI.5.8.a006" x-target-ids="t006 t007" x-target="for his" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.1TI.5.8.005" x-align="1TI.5.8.a007" x-target-ids="t008" x-target="own" x-target-head="t008" x-head="true" lemma="ἴδιος" strong="G2398" x-morph="A-GPM" x-gloss="own" x-translit="idiōn" xml:lang="grc">ἰδίων</char> <char style="w" x-id="SBLGNT.1TI.5.8.006" x-align="1TI.5.8.a008" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1TI.5.8.007" x-align="1TI.5.8.a009" x-target-ids="t010" x-target="specially" x-target-head="t010" x-head="true" lemma="μάλιστα" strong="G3122" x-morph="ADV-S" x-gloss="especially [his]" x-translit="malista" xml:lang="grc">μάλιστα</char> <char style="w" x-id="SBLGNT.1TI.5.8.008" x-align="1TI.5.8.a010" x-target-ids="t011 t012 t013" x-target="his own household" x-target-head="t013" x-head="true" lemma="οἰκεῖος" strong="G3609" x-morph="A-GPM" x-gloss="household" x-translit="oike