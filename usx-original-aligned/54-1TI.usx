	<para style="p"><verse number="4" style="v" x-ref="1TI.1.4" x-added-alignments="1TI.1.4.a017" x-added-target-ids="t023 t024 t025 t026" x-added-target="so do I now" sid="1TI 1:4" /><char style="w" x-id="SBLGNT.1TI.1.4.001" x-align="1TI.1.4.a001" x-target-ids="t001" x-target="neither" x-target-head="t001" x-head="true" lemma="μηδέ" strong="G3366" x-morph="CONJ-N" x-gloss="nor" x-translit="mēde" xml:lang="grc">μηδὲ</char> <char style="w" x-id="SBLGNT.1TI.1.4.002" x-align="1TI.1.4.a002" x-target-ids="t002 t003 t004" x-target="to give heed" x-target-head="t004" x-head="true" lemma="προσέχω" strong="G4337" x-morph="V-PAN" x-gloss="to give heed" x-translit="prosechein" xml:lang="grc">προσέχειν</char> <char style="w" x-id="SBLGNT.1TI.1.4.003" x-align="1TI.1.4.a003" x-target-ids="t005 t006" x-target="to fables" x-target-head="t006" x-head="true" lemma="μῦθος" strong="G3454" x-morph="N-DPM" x-gloss="to myths" x-translit="mythois" xml:lang="grc">μύθοις</char> <char style="w" x-id="SBLGNT.1TI.1.4.004" x-align="1TI.1.4.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1TI.1.4.005" x-align="1TI.1.4.a005" x-target-ids="t009" x-target="genealogies" x-target-head="t009" x-head="true" lemma="γενεαλογία" strong="G1076" x-morph="N-DPF" x-gloss="genealogies" x-translit="genealogiais" xml:lang="grc">γενεαλογίαις</char> <char style="w" x-id="SBLGNT.1TI.1.4.006" x-align="1TI.1.4.a006" x-target-ids="t008" x-target="endless" x-target-head="t008" x-head="true" lemma="ἀπέραντος" strong="G562" x-morph="A-DPF" x-gloss="endless" x-translit="aperantois" xml:lang="grc">ἀπεράντοις</char>,<char style="w" x-id="SBLGNT.1TI.1.4.007" x-align="1TI.1.4.a007" x-target-ids="t010" x-target="which" x-target-head="t010" x-head="true" lemma="ὅστις" strong="G3748" x-morph="R-NPF" x-gloss="which" x-translit="haitines" xml:lang="grc">αἵτινες</char> <char style="w