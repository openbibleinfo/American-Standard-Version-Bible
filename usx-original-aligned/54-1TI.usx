	<para style="p"><verse number="14" style="v" x-ref="1TI.3.14" sid="1TI 3:14" /><char style="w" x-id="SBLGNT.1TI.3.14.001" x-align="1TI.3.14.a001" x-target-ids="t001 t002" x-target="These things" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G5024" x-morph="D-APN" x-gloss="These things" x-translit="Tauta" xml:lang="grc">Ταῦτά</char> <char style="w" x-id="SBLGNT.1TI.3.14.002" x-align="1TI.3.14.a002" x-target-ids="t005 t006" x-target="unto thee" x-target-head="t006" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="to you" x-translit="soi" xml:lang="grc">σοι</char> <char style="w" x-id="SBLGNT.1TI.3.14.003" x-align="1TI.3.14.a003" x-target-ids="t003 t004" x-target="write I" x-target-head="t003" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-PAI-1S" x-gloss="I am writing" x-translit="graphō" xml:lang="grc">γράφω</char>,<char style="w" x-id="SBLGNT.1TI.3.14.004" x-align="1TI.3.14.a004" x-target-ids="t007" x-target="hoping" x-target-head="t007" x-head="true" lemma="ἐλπίζω" strong="G1679" x-morph="V-PAP-NSM" x-gloss="hoping" x-translit="elpizōn" xml:lang="grc">ἐλπίζων</char> <char style="w" x-id="SBLGNT.1TI.3.14.005" x-align="1TI.3.14.a005" x-target-ids="t008 t009" x-target="to come" x-target-head="t009" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAN" x-gloss="to come" x-translit="elthein" xml:lang="grc">ἐλθεῖν</char> <char style="w" x-id="SBLGNT.1TI.3.14.006" x-align="1TI.3.14.a006" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.1TI.3.14.007" x-align="1TI.3.14.a007" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σὲ</char> <char style="w" x-id="SBLGNT.1TI.3.14.008" x-align="1TI.3.14.a008" lemma="ἐν" strong="G1722" x-morph="PREP" x-translit="en" xml:lang="grc">ἐν</ch