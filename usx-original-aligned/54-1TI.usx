	<para style="p"><verse number="4" style="v" x-ref="1TI.4.4" sid="1TI 4:4" /><char style="w" x-id="SBLGNT.1TI.4.4.001" x-align="1TI.4.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="For" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.1TI.4.4.002" x-align="1TI.4.4.a002" x-target-ids="t002" x-target="every" x-target-head="t002" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NSN" x-gloss="every" x-translit="pan" xml:lang="grc">πᾶν</char> <char style="w" x-id="SBLGNT.1TI.4.4.003" x-align="1TI.4.4.a003" x-target-ids="t003" x-target="creature" x-target-head="t003" x-head="true" lemma="κτίσμα" strong="G2938" x-morph="N-NSN" x-gloss="creature" x-translit="ktisma" xml:lang="grc">κτίσμα</char> <char style="w" x-id="SBLGNT.1TI.4.4.004" x-align="1TI.4.4.a004" x-target-ids="t004 t005" x-target="of God" x-target-head="t005" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.1TI.4.4.005" x-align="1TI.4.4.a005" x-target-ids="t006 t007" x-target="is good" x-target-head="t007" x-head="true" lemma="καλός" strong="G2570" x-morph="A-NSN" x-gloss="[is] good" x-translit="kalon" xml:lang="grc">καλόν</char>,<char style="w" x-id="SBLGNT.1TI.4.4.006" x-align="1TI.4.4.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1TI.4.4.007" x-align="1TI.4.4.a007" x-target-ids="t009" x-target="nothing" x-target-head="t009" x-head="true" lemma="οὐδείς" strong="G3762" x-morph="A-NSN-N" x-gloss="nothing [is]" x-translit="ouden" xml:lang="grc">οὐδὲν</char> <char style="w" x-id="SBLGNT.1TI.4.4.008" x-align="1TI.4.4.a008" x-target-ids="t010 t011 t012 t013" x-target="is to be rejected" x-target-head="t013" x-head="true" lemma="ἀπόβλητος" strong="G579" x-