	<para style="p"><verse number="13" style="v" x-ref="1TI.3.13" sid="1TI 3:13" /><char style="w" x-id="SBLGNT.1TI.3.13.001" x-align="1TI.3.13.a001" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="Those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.1TI.3.13.002" x-align="1TI.3.13.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.1TI.3.13.003" x-align="1TI.3.13.a003" x-target-ids="t006" x-target="well" x-target-head="t006" x-head="true" lemma="καλῶς" strong="G2573" x-morph="ADV" x-gloss="well" x-translit="kalōs" xml:lang="grc">καλῶς</char> <char style="w" x-id="SBLGNT.1TI.3.13.004" x-align="1TI.3.13.a004" x-target-ids="t003 t004 t005 t007 t008" x-target="that have served as deacons" x-target-head="t005" x-head="true" lemma="διακονέω" strong="G1247" x-morph="V-AAP-NPM" x-gloss="having served" x-translit="diakonēsantes" xml:lang="grc">διακονήσαντες</char> <char style="w" x-id="SBLGNT.1TI.3.13.005" x-align="1TI.3.13.a005" x-target-ids="t012 t014" x-target="a standing" x-target-head="t014" x-head="true" lemma="βαθμός" strong="G898" x-morph="N-ASM" x-gloss="a standing" x-translit="bathmon" xml:lang="grc">βαθμὸν</char> <char style="w" x-id="SBLGNT.1TI.3.13.006" x-align="1TI.3.13.a006" x-target-ids="t010 t011" x-target="to themselves" x-target-head="t011" x-head="true" lemma="ἑαυτοῦ" strong="G1438" x-morph="F-3DPM" x-gloss="for themselves" x-translit="heautois" xml:lang="grc">ἑαυτοῖς</char> <char style="w" x-id="SBLGNT.1TI.3.13.007" x-align="1TI.3.13.a007" x-target-ids="t013" x-target="good" x-target-head="t013" x-head="true" lemma="καλός" strong="G2570" x-morph="A-ASM" x-gloss="good" x-translit="kalon" xml:lang="grc">καλὸν</char> <char style="w" x-id="SBLGNT.1TI.3.13.008" x-align="1TI.3.13.a008" x-target-ids="t009" x-target="g