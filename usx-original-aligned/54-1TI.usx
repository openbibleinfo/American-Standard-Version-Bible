	<para style="p"><verse number="9" style="v" x-ref="1TI.3.9" sid="1TI 3:9" /><char style="w" x-id="SBLGNT.1TI.3.9.001" x-align="1TI.3.9.a001" x-target-ids="t001" x-target="holding" x-target-head="t001" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAP-APM" x-gloss="holding" x-translit="echontas" xml:lang="grc">ἔχοντας</char> <char style="w" x-id="SBLGNT.1TI.3.9.002" x-align="1TI.3.9.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="to the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.1TI.3.9.003" x-align="1TI.3.9.a003" x-target-ids="t003" x-target="mystery" x-target-head="t003" x-head="true" lemma="μυστήριον" strong="G3466" x-morph="N-ASN" x-gloss="mystery" x-translit="mystērion" xml:lang="grc">μυστήριον</char> <char style="w" x-id="SBLGNT.1TI.3.9.004" x-align="1TI.3.9.a004" x-target-ids="t004 t005" x-target="of the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="of the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.1TI.3.9.005" x-align="1TI.3.9.a005" x-target-ids="t006" x-target="faith" x-target-head="t006" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-GSF" x-gloss="faith" x-translit="pisteōs" xml:lang="grc">πίστεως</char> <char style="w" x-id="SBLGNT.1TI.3.9.006" x-align="1TI.3.9.a006" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="with" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1TI.3.9.007" x-align="1TI.3.9.a007" x-target-ids="t009" x-target="pure" x-target-head="t009" x-head="true" lemma="καθαρός" strong="G2513" x-morph="A-DSF" x-gloss="clear" x-translit="katharai" xml:lang="grc">καθαρᾷ</char> <char style="w" x-id="SBLGNT.1TI.3.9.008" x-align="1TI.3.9.a008" x-target-ids="t008 t010" x-target="a conscience" x-target-head="t010" x-head="true" lemma="συνείδησις" strong="G4893" x-morph="N-DSF