	<para style="p"><verse number="9" style="v" x-ref="1TI.5.9" sid="1TI 5:9" /><char style="w" x-id="SBLGNT.1TI.5.9.001" x-align="1TI.5.9.a003" x-target-ids="t005 t006 t007" x-target="as a widow" x-target-head="t007" x-head="true" lemma="χήρα" strong="G5503" x-morph="N-NSF" x-gloss="A widow" x-translit="Chēra" xml:lang="grc">Χήρα</char> <char style="w" x-id="SBLGNT.1TI.5.9.002" x-align="1TI.5.9.a001" x-target-ids="t001 t003 t004" x-target="Let be enrolled" x-target-head="t004" x-head="true" lemma="καταλέγω" strong="G2639" x-morph="V-PPM-3S" x-gloss="let be enrolled" x-translit="katalegesthō" xml:lang="grc">καταλεγέσθω</char> <char style="w" x-id="SBLGNT.1TI.5.9.003" x-align="1TI.5.9.a002" x-target-ids="t002" x-target="none" x-target-head="t002" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.1TI.5.9.004" x-align="1TI.5.9.a004" x-target-ids="t008" x-target="under" x-target-head="t008" x-head="true" lemma="ἐλάσσων" strong="G1640" x-morph="A-NSN" x-gloss="less than" x-translit="elatton" xml:lang="grc">ἔλαττον</char> <char style="w" x-id="SBLGNT.1TI.5.9.005" x-align="1TI.5.9.a005" x-target-ids="t010 t011" x-target="years old" x-target-head="t010" x-head="true" lemma="ἔτος" strong="G2094" x-morph="N-GPN" x-gloss="years [old]" x-translit="etōn" xml:lang="grc">ἐτῶν</char> <char style="w" x-id="SBLGNT.1TI.5.9.006" x-align="1TI.5.9.a006" x-target-ids="t009" x-target="threescore" x-target-head="t009" x-head="true" lemma="ἑξήκοντα" strong="G1835" x-morph="A-NUI" x-gloss="sixty" x-translit="hexēkonta" xml:lang="grc">ἑξήκοντα</char> <char style="w" x-id="SBLGNT.1TI.5.9.007" x-align="1TI.5.9.a007" x-target-ids="t012 t013" x-target="having been" x-target-italic-ids="t012 t013" x-target-head="t013" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2RAP-NSF" x-gloss="being" x-translit="gegonuia" xml:lang="grc">γεγονυῖα</char>,<char style="w" x-id="SBLGNT.1TI.5.9.008" x-align="1TI.5.9.a009