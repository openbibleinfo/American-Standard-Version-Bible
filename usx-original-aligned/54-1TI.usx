	<para style="p"><verse number="10" style="v" x-ref="1TI.3.10" sid="1TI 3:10" /><char style="w" x-id="SBLGNT.1TI.3.10.001" x-align="1TI.3.10.a001" x-target-ids="t004" x-target="also" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="Also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1TI.3.10.002" x-align="1TI.3.10.a002" x-target-ids="t003" x-target="these" x-target-head="t003" x-head="true" lemma="οὗτος" strong="G3778" x-morph="D-NPM" x-gloss="these" x-translit="houtoi" xml:lang="grc">οὗτοι</char> <char style="w" x-id="SBLGNT.1TI.3.10.003" x-align="1TI.3.10.a003" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.1TI.3.10.004" x-align="1TI.3.10.a004" x-target-ids="t002 t006 t007" x-target="let be proved" x-target-head="t007" x-head="true" lemma="δοκιμάζω" strong="G1381" x-morph="V-PPM-3P" x-gloss="let them be tested" x-translit="dokimazesthōsan" xml:lang="grc">δοκιμαζέσθωσαν</char> <char style="w" x-id="SBLGNT.1TI.3.10.005" x-align="1TI.3.10.a005" x-target-ids="t005" x-target="first" x-target-head="t005" x-head="true" lemma="πρῶτος" strong="G4412" x-morph="ADV-S" x-gloss="first" x-translit="prōton" xml:lang="grc">πρῶτον</char>,<char style="w" x-id="SBLGNT.1TI.3.10.006" x-align="1TI.3.10.a006" x-target-ids="t008" x-target="then" x-target-head="t008" x-head="true" lemma="εἶτα" strong="G1534" x-morph="ADV" x-gloss="then" x-translit="eita" xml:lang="grc">εἶτα</char> <char style="w" x-id="SBLGNT.1TI.3.10.007" x-align="1TI.3.10.a007" x-target-ids="t009 t010 t011 t012 t013" x-target="let them serve as deacons" x-target-head="t011" x-head="true" lemma="διακονέω" strong="G1247" x-morph="V-PAM-3P" x-gloss="let them serve" x-translit="diakoneitōsan" xml:lang="grc">διακονείτωσαν</char> <char style="w" x-id="SBLGNT.1TI.3.10.008" x-align="1TI.3.10.a008" x-target-ids="t017" x-t