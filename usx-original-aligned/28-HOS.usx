	<para style="p"><verse number="9" style="v" x-ref="HOS.12.9" sid="HOS 12:9" /><char style="w" x-id="WLC.HOS.12.9.001" x-align="HOS.12.9.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="HOS.12.10">וְ</char><char style="w" x-id="WLC.HOS.12.9.002" x-align="HOS.12.9.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo" x-source-ref="HOS.12.10">אָנֹכִ֛י</char> <char style="w" x-id="WLC.HOS.12.9.003" x-align="HOS.12.9.a003" x-target-ids="t003 t004" x-target="am Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="[have.been].Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="HOS.12.10">יְהוָ֥ה</char> <char style="w" x-id="WLC.HOS.12.9.004" x-align="HOS.12.9.a004" x-target-ids="t006" x-target="God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōhey" xml:lang="hbo" x-source-ref="HOS.12.10">אֱלֹהֶ֖י</char><char style="w" x-id="WLC.HOS.12.9.005" x-align="HOS.12.9.a005" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="HOS.12.10">ךָ</char> <char style="w" x-id="WLC.HOS.12.9.006" x-align="HOS.12.9.a006" x-target-ids="t007" x-target="from" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo" x-source-ref="HOS.12.10">מֵ</char><char style="w" x-id="WLC.HOS.12.9.007" x-align="HOS.12.9.a007" x-target-ids="t008 t009" x-target="the land" x-target-head="t009" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsc" x-gloss="the.land" x-translit="ʾereṣ" xml:lang="hbo" x-source-ref="HOS.12.10">אֶ֣רֶץ</char> <char style="w" x-id="WLC.HOS.12.9.008" x-alig