	<para style="p"><verse number="7" style="v" x-ref="HOS.12.7" x-added-alignments="HOS.12.7.a001" x-added-target-ids="t001" x-added-target="He" sid="HOS 12:7" /><char style="w" x-id="WLC.HOS.12.7.001" x-align="HOS.12.7.a002" x-target-ids="t002 t003 t004" x-target="is a trafficker" x-target-italic-ids="t002" x-target-head="t004" x-head="true" lemma="כְּנַעַן" strong="H3667a" x-morph="Np" x-gloss="a.merchant" x-translit="kənaʿan" xml:lang="hbo" x-source-ref="HOS.12.8">כְּנַ֗עַן</char> <char style="w" x-id="WLC.HOS.12.7.002" x-align="HOS.12.7.a003" x-target-ids="t009 t010" x-target="are in" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[who" x-translit="bə" xml:lang="hbo" x-source-ref="HOS.12.8">בְּ</char><char style="w" x-id="WLC.HOS.12.7.003" x-align="HOS.12.7.a004" x-target-ids="t012" x-target="hand" x-target-head="t012" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="are]" x-translit="yāḏ" xml:lang="hbo" x-source-ref="HOS.12.8">יָד֛</char><char style="w" x-id="WLC.HOS.12.7.004" x-align="HOS.12.7.a005" x-target-ids="t011" x-target="his" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="in.his.hand" x-translit="ô" xml:lang="hbo" x-source-ref="HOS.12.8">וֹ</char> <char style="w" x-id="WLC.HOS.12.7.005" x-align="HOS.12.7.a006" x-target-ids="t005 t006" x-target="the balances" x-target-head="t006" x-head="true" lemma="מֹאזְנַיִם" strong="H3976" x-morph="Ncmdc" x-gloss="balances" x-translit="mōʾzənēy" xml:lang="hbo" x-source-ref="HOS.12.8">מֹאזְנֵ֥י</char> <char style="w" x-id="WLC.HOS.12.7.006" x-align="HOS.12.7.a007" x-target-ids="t007 t008" x-target="of deceit" x-target-head="t008" x-head="true" lemma="מִרְמָה" strong="H4820" x-morph="Ncfsa" x-gloss="of.deceit" x-translit="mirmāh" xml:lang="hbo" x-source-ref="HOS.12.8">מִרְמָ֖ה</char> <char style="w" x-id="WLC.HOS.12.7.007" x-align="HOS.12.7.a008" x-target-ids="t015" x-target="to" x-target-head="t015" x-head="true" lemma="לְ" s