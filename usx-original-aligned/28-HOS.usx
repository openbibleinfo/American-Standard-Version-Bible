	<para style="p"><verse number="13" style="v" x-ref="HOS.9.13" sid="HOS 9:13" /><char style="w" x-id="WLC.HOS.9.13.001" x-align="HOS.9.13.a001" x-target-ids="t001" x-target="Ephraim" x-target-head="t001" x-head="true" lemma="אֶפְרַיִם" strong="H669" x-morph="Np" x-gloss="Ephraim" x-translit="ʾep̄rayim" xml:lang="hbo">אֶפְרַ֛יִם</char> <char style="w" x-id="WLC.HOS.9.13.002" x-align="HOS.9.13.a002" x-target-ids="t002" x-target="like" x-target-head="t002" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="just" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.HOS.9.13.003" x-align="HOS.9.13.a003" x-target-ids="t003" x-target="as" x-target-head="t003" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="as" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.HOS.9.13.004" x-align="HOS.9.13.a004" x-target-ids="t004 t005 t006" x-target="I have seen" x-target-head="t006" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp1cs" x-gloss="I.have.seen" x-translit="rāʾiyṯî" xml:lang="hbo">רָאִ֥יתִי</char> <char style="w" x-id="WLC.HOS.9.13.005" x-align="HOS.9.13.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.HOS.9.13.006" x-align="HOS.9.13.a006" x-target-ids="t007" x-target="Tyre" x-target-head="t007" x-head="true" lemma="צֹר" strong="H6865" x-morph="Np" x-gloss="Tyre" x-translit="ṣôr" xml:lang="hbo">צ֖וֹר</char> <char style="w" x-id="WLC.HOS.9.13.007" x-align="HOS.9.13.a007" x-target-ids="t008 t009" x-target="is planted" x-target-head="t009" x-head="true" lemma="שָׁתַל" strong="H8362" x-morph="Vqsfsa" x-gloss="planted" x-translit="šəṯûlāh" xml:lang="hbo">שְׁתוּלָ֣ה</char> <char style="w" x-id="WLC.HOS.9.13.008" x-align="HOS.9.13.a008" x-target-ids="t010" x-target="in" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</ch