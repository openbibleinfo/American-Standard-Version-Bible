	<para style="p"><verse number="16" style="v" x-ref="HOS.4.16" sid="HOS 4:16" /><char style="w" x-id="WLC.HOS.4.16.001" x-align="HOS.4.16.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּ֚י</char> <char style="w" x-id="WLC.HOS.4.16.002" x-align="HOS.4.16.a002" x-target-ids="t007" x-target="like" x-target-head="t007" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.HOS.4.16.003" x-align="HOS.4.16.a003" x-target-ids="t008 t010" x-target="a heifer" x-target-head="t010" x-head="true" lemma="פָּרָה" strong="H6510" x-morph="Ncfsa" x-gloss="a.heifer" x-translit="p̄ārāh" xml:lang="hbo">פָרָ֣ה</char> <char style="w" x-id="WLC.HOS.4.16.004" x-align="HOS.4.16.a004" x-target-ids="t009" x-target="stubborn" x-target-head="t009" x-head="true" lemma="סָרַר" strong="H5637" x-morph="Vqrfsa" x-gloss="stubborn" x-translit="sōrērāh" xml:lang="hbo">סֹֽרֵרָ֔ה</char> <char style="w" x-id="WLC.HOS.4.16.005" x-align="HOS.4.16.a005" x-target-ids="t003 t004 t005 t006" x-target="hath behaved himself stubbornly" x-target-head="t006" x-head="true" lemma="סָרַר" strong="H5637" x-morph="Vqp3ms" x-gloss="it.is.stubborn" x-translit="sārar" xml:lang="hbo">סָרַ֖ר</char> <char style="w" x-id="WLC.HOS.4.16.006" x-align="HOS.4.16.a006" x-target-ids="t002" x-target="Israel" x-target-head="t002" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֑ל</char> <char style="w" x-id="WLC.HOS.4.16.007" x-align="HOS.4.16.a007" x-target-ids="t011" x-target="now" x-target-head="t011" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּה֙</char> <char style="w" x-id="WLC.HOS.4.16.008" x-align="HOS.4.16.a008" x-target-ids="t012 t014" x-target="will feed" x-target-head="t014" x-head="true" lem