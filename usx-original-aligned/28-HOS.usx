	<para style="p"><verse number="9" style="v" x-ref="HOS.9.9" sid="HOS 9:9" /><char style="w" x-id="WLC.HOS.9.9.001" x-align="HOS.9.9.a001" x-target-ids="t003" x-target="deeply" x-target-head="t003" x-head="true" lemma="עָמֹק" strong="H6009" x-morph="Vhp3cp" x-gloss="they.have.made.deep" x-translit="heʿmiyqû-" xml:lang="hbo">הֶעְמִֽיקוּ</char>־<char style="w" x-id="WLC.HOS.9.9.002" x-align="HOS.9.9.a002" x-target-ids="t001 t002 t004 t005" x-target="They have corrupted themselves" x-target-head="t004" x-head="true" lemma="שָׁחַת" strong="H7843" x-morph="Vpp3cp" x-gloss="they.have.dealt.corruptly" x-translit="šiḥēṯû" xml:lang="hbo">שִׁחֵ֖תוּ</char> <char style="w" x-id="WLC.HOS.9.9.003" x-align="HOS.9.9.a003" x-target-ids="t006" x-target="as" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.HOS.9.9.004" x-align="HOS.9.9.a004" x-target-ids="t007 t009" x-target="in days" x-target-head="t009" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="the.days" x-translit="ymēy" xml:lang="hbo">ימֵ֣י</char> <char style="w" x-id="WLC.HOS.9.9.005" x-align="HOS.9.9.a005" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of.(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.HOS.9.9.006" x-align="HOS.9.9.a006" x-target-ids="t010 t011" x-target="of Gibeah" x-target-head="t011" x-head="true" lemma="גִּבְעָה" strong="H1390" x-morph="Np" x-gloss="Gibeah" x-translit="giḇʿāh" xml:lang="hbo">גִּבְעָ֑ה</char> <char style="w" x-id="WLC.HOS.9.9.007" x-align="HOS.9.9.a007" x-target-ids="t012 t013 t014" x-target="he will remember" x-target-head="t014" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqi3ms" x-gloss="he.will.remember" x-translit="yizkôr" xml:lang="hbo">יִזְכּ֣וֹר</char> <char style="w" x-id="WLC.HOS.9.9.008" x-align="HOS.9.9.a008" x-target-ids="t016" x-target="iniquity