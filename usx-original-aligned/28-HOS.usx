	<para style="p"><verse number="12" style="v" x-ref="HOS.13.12" sid="HOS 13:12" /><char style="w" x-id="WLC.HOS.13.12.001" x-align="HOS.13.12.a003" x-target-ids="t005 t006 t007" x-target="is bound up" x-target-head="t006" x-head="true" lemma="צָרַר" strong="H6887" x-morph="Vqsmsa" x-gloss="[is].bound.up" x-translit="ṣārûr" xml:lang="hbo">צָרוּר֙</char> <char style="w" x-id="WLC.HOS.13.12.002" x-align="HOS.13.12.a001" x-target-ids="t001 t002" x-target="The iniquity" x-target-head="t002" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsc" x-gloss="the.iniquity" x-translit="ʿăwōn" xml:lang="hbo">עֲוֺ֣ן</char> <char style="w" x-id="WLC.HOS.13.12.003" x-align="HOS.13.12.a002" x-target-ids="t003 t004" x-target="of Ephraim" x-target-head="t004" x-head="true" lemma="אֶפְרַיִם" strong="H669" x-morph="Np" x-gloss="of.Ephraim" x-translit="ʾep̄rāyim" xml:lang="hbo">אֶפְרָ֔יִם</char> <char style="w" x-id="WLC.HOS.13.12.004" x-align="HOS.13.12.a006" x-target-ids="t010 t011 t012 t013 t014" x-target="is laid up in store" x-target-head="t014" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqsfsa" x-gloss="[is].stored.up" x-translit="ṣəp̄ûnāh" xml:lang="hbo">צְפוּנָ֖ה</char> <char style="w" x-id="WLC.HOS.13.12.005" x-align="HOS.13.12.a005" x-target-ids="t009" x-target="sin" x-target-head="t009" x-head="true" lemma="חַטָּאת" strong="H2403" x-morph="Ncfsc" x-gloss="sin" x-translit="ḥaṭṭāʾṯ" xml:lang="hbo">חַטָּאתֽ</char><char style="w" x-id="WLC.HOS.13.12.006" x-align="HOS.13.12.a004" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char>׃<verse eid="HOS 13:12" /></para>
