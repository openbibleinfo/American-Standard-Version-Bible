	<para style="p"><verse number="1" style="v" x-ref="HOS.2.1" sid="HOS 2:1" /><char style="w" x-id="WLC.HOS.2.1.001" x-align="HOS.2.1.a001" x-target-ids="t001 t002" x-target="Say ye" x-target-head="t001" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqv2mp" x-gloss="say" x-translit="ʾimrû" xml:lang="hbo" x-source-ref="HOS.2.3">אִמְר֥וּ</char> <char style="w" x-id="WLC.HOS.2.1.002" x-align="HOS.2.1.a002" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="HOS.2.3">לַ</char><char style="w" x-id="WLC.HOS.2.1.003" x-align="HOS.2.1.a003" x-target-ids="t005" x-target="brethren" x-target-head="t005" x-head="true" lemma="אָח" strong="H251" x-morph="Ncmpc" x-gloss="brothers" x-translit="ʾăḥēy" xml:lang="hbo" x-source-ref="HOS.2.3">אֲחֵי</char><char style="w" x-id="WLC.HOS.2.1.004" x-align="HOS.2.1.a004" x-target-ids="t004" x-target="your" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo" x-source-ref="HOS.2.3">כֶ֖ם</char> <char style="w" x-id="WLC.HOS.2.1.005" x-align="HOS.2.1.a005" x-target-ids="t006" x-target="Ammi" x-target-head="t006" x-head="true" lemma="עַמִּי" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="HOS.2.3">עַמִּ֑</char><char style="w" x-id="WLC.HOS.2.1.006" x-align="HOS.2.1.a005" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="HOS.2.3">י</char> <char style="w" x-id="WLC.HOS.2.1.007" x-align="HOS.2.1.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="HOS.2.3">וְ</char><char style="w" x-id="WLC.HOS.2.1.008" x-align="HOS.2.1.a007" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="t