	<para style="p"><verse number="2" style="v" x-ref="HOS.4.2" x-added-alignments="HOS.4.2.a002" x-added-target-ids="t003 t004" x-added-target="nought but" sid="HOS 4:2" /><char style="w" x-id="WLC.HOS.4.2.001" x-align="HOS.4.2.a001" x-target-ids="t001 t002 t005" x-target="There is swearing" x-target-head="t005" x-head="true" lemma="אָלָה" strong="H422" x-morph="Vqa" x-gloss="cursing" x-translit="ʾālōh" xml:lang="hbo">אָלֹ֣ה</char> <char style="w" x-id="WLC.HOS.4.2.002" x-align="HOS.4.2.a003" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HOS.4.2.003" x-align="HOS.4.2.a004" x-target-ids="t007 t008" x-target="breaking faith" x-target-head="t007" x-head="true" lemma="כָּחַשׁ" strong="H3584" x-morph="Vpa" x-gloss="deceiving" x-translit="ḵaḥēš" xml:lang="hbo">כַחֵ֔שׁ</char> <char style="w" x-id="WLC.HOS.4.2.004" x-align="HOS.4.2.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HOS.4.2.005" x-align="HOS.4.2.a006" x-target-ids="t010" x-target="killing" x-target-head="t010" x-head="true" lemma="רָצַח" strong="H7523" x-morph="Vqa" x-gloss="murdering" x-translit="rāṣōᵃḥ" xml:lang="hbo">רָצֹ֥חַ</char> <char style="w" x-id="WLC.HOS.4.2.006" x-align="HOS.4.2.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HOS.4.2.007" x-align="HOS.4.2.a008" x-target-ids="t012" x-target="stealing" x-target-head="t012" x-head="true" lemma="גָּנַב" strong="H1589" x-morph="Vqa" x-gloss="stealing" x-translit="ḡānōḇ" xml:lang="hbo">גָנֹ֖ב</char> <char style="w" x-id="WLC.HOS.4.2.008" x-align="HOS.4.2.a009" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" 