	<para style="p"><verse number="11" style="v" x-ref="HOS.13.11" x-added-alignments="HOS.13.11.a010" x-added-target-ids="t013" x-added-target="him" sid="HOS 13:11" /><char style="w" x-id="WLC.HOS.13.11.001" x-align="HOS.13.11.a001" x-target-ids="t001 t002 t003" x-target="I have given" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi1cs" x-gloss="I.gave" x-translit="ʾeten-" xml:lang="hbo">אֶֽתֶּן</char>־<char style="w" x-id="WLC.HOS.13.11.002" x-align="HOS.13.11.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.HOS.13.11.003" x-align="HOS.13.11.a003" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.HOS.13.11.004" x-align="HOS.13.11.a004" x-target-ids="t005 t006" x-target="a king" x-target-head="t006" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="a.king" x-translit="meleḵə" xml:lang="hbo">מֶ֨לֶךְ֙</char> <char style="w" x-id="WLC.HOS.13.11.005" x-align="HOS.13.11.a005" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.HOS.13.11.006" x-align="HOS.13.11.a007" x-target-ids="t009" x-target="anger" x-target-head="t009" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsc" x-gloss="anger" x-translit="ʾapp" xml:lang="hbo">אַפִּ֔</char><char style="w" x-id="WLC.HOS.13.11.007" x-align="HOS.13.11.a006" x-target-ids="t008" x-target="mine" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.HOS.13.11.008" x-align="HOS.13.11.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morp