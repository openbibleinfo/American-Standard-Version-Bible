	<para style="p"><verse number="2" style="v" x-ref="HOS.9.2" sid="HOS 9:2" /><char style="w" x-id="WLC.HOS.9.2.001" x-align="HOS.9.2.a001" x-target-ids="t001 t002 t003" x-target="The threshing floor" x-target-head="t003" x-head="true" lemma="גֹּרֶן" strong="H1637" x-morph="Ncbsa" x-gloss="threshing.floor" x-translit="gōren" xml:lang="hbo">גֹּ֥רֶן</char> <char style="w" x-id="WLC.HOS.9.2.002" x-align="HOS.9.2.a002" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.HOS.9.2.003" x-align="HOS.9.2.a003" x-target-ids="t005 t006" x-target="the winepress" x-target-head="t006" x-head="true" lemma="יֶקֶב" strong="H3342" x-morph="Ncmsa" x-gloss="winepress" x-translit="yeqeḇ" xml:lang="hbo">יֶ֖קֶב</char> <char style="w" x-id="WLC.HOS.9.2.004" x-align="HOS.9.2.a004" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.HOS.9.2.005" x-align="HOS.9.2.a005" x-target-ids="t007 t009" x-target="shall feed" x-target-head="t009" x-head="true" lemma="רָעָה" strong="H7462" x-morph="Vqi3ms" x-gloss="it" x-translit="yirʿ" xml:lang="hbo">יִרְעֵ֑</char><char style="w" x-id="WLC.HOS.9.2.006" x-align="HOS.9.2.a006" x-target-ids="t010" x-target="them" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="will.feed.them" x-translit="ēm" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.HOS.9.2.007" x-align="HOS.9.2.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HOS.9.2.008" x-align="HOS.9.2.a008" x-target-ids="t012 t013 t014" x-target="the new wine" x-target-head="t014" x-head="true" lemma="תִּירוֹשׁ" strong="H8492" x-morph="Ncmsa" x-gloss="ne