	<para style="p"><verse number="3" style="v" x-ref="HOS.9.3" sid="HOS 9:3" /><char style="w" x-id="WLC.HOS.9.3.001" x-align="HOS.9.3.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.HOS.9.3.002" x-align="HOS.9.3.a002" x-target-ids="t001 t002 t004" x-target="They shall dwell" x-target-head="t004" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi3mp" x-gloss="they.will.remain" x-translit="yēšəḇû" xml:lang="hbo">יֵשְׁב֖וּ</char> <char style="w" x-id="WLC.HOS.9.3.003" x-align="HOS.9.3.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.HOS.9.3.004" x-align="HOS.9.3.a004" x-target-ids="t007" x-target="land" x-target-head="t007" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsc" x-gloss="the.land" x-translit="ʾereṣ" xml:lang="hbo">אֶ֣רֶץ</char> <char style="w" x-id="WLC.HOS.9.3.005" x-align="HOS.9.3.a005" x-target-ids="t006" x-target="Jehovah’s" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.HOS.9.3.006" x-align="HOS.9.3.a006" x-target-ids="t008" x-target="but" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HOS.9.3.007" x-align="HOS.9.3.a007" x-target-ids="t010 t011" x-target="shall return" x-target-head="t011" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqq3ms" x-gloss="he.will.return" x-translit="šāḇ" xml:lang="hbo">שָׁ֤ב</char> <char style="w" x-id="WLC.HOS.9.3.008" x-align="HOS.9.3.a008" x-target-ids="t009" x-target="Ephraim" x-target-head="t009" x-head="true" lemma="אֶפְרַיִם" strong="H669" x-morph="Np" x-gloss="Ephraim" x-transli