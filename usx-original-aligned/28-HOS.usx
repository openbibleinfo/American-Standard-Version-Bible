	<para style="p"><verse number="4" style="v" x-ref="HOS.9.4" sid="HOS 9:4" /><char style="w" x-id="WLC.HOS.9.4.001" x-align="HOS.9.4.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.HOS.9.4.002" x-align="HOS.9.4.a002" x-target-ids="t001 t002 t004 t005" x-target="They shall pour out" x-target-head="t004" x-head="true" lemma="נָסַךְ" strong="H5258" x-morph="Vqi3mp" x-gloss="they.will.pour.out" x-translit="yissəḵû" xml:lang="hbo">יִסְּכ֨וּ</char> <char style="w" x-id="WLC.HOS.9.4.003" x-align="HOS.9.4.a003" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.HOS.9.4.004" x-align="HOS.9.4.a004" x-target-ids="t009" x-target="Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֥ה</char>׀<char style="w" x-id="WLC.HOS.9.4.005" x-align="HOS.9.4.a005" x-target-ids="t006 t007" x-target="wine offerings" x-target-italic-ids="t007" x-target-head="t006" x-head="true" lemma="יַיִן" strong="H3196" x-morph="Ncmsa" x-gloss="wine" x-translit="yayin" xml:lang="hbo">יַיִן֮</char> <char style="w" x-id="WLC.HOS.9.4.006" x-align="HOS.9.4.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HOS.9.4.007" x-align="HOS.9.4.a006" x-target-ids="t010" x-target="neither" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.HOS.9.4.008" x-align="HOS.9.4.a007" x-target-ids="t011 t012 t013 t014" x-target="shall they be pleasing" x-target-head="t014" x-head="true" lemma="עָרַב" strong="H6149" x-morph="Vqi3mp" x-gloss="they.will.be.pleasing" x-translit="yeʿerḇû-