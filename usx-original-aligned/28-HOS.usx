	<para style="p"><verse number="9" style="v" x-ref="HOS.14.9" sid="HOS 14:9" /><char style="w" x-id="WLC.HOS.14.9.001" x-align="HOS.14.9.a001" x-target-ids="t001" x-target="Who" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo" x-source-ref="HOS.14.10">מִ֤י</char> <char style="w" x-id="WLC.HOS.14.9.002" x-align="HOS.14.9.a002" x-target-ids="t002 t003" x-target="is wise" x-target-head="t003" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="[is].wise" x-translit="ḥāḵām" xml:lang="hbo" x-source-ref="HOS.14.10">חָכָם֙</char> <char style="w" x-id="WLC.HOS.14.9.003" x-align="HOS.14.9.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="HOS.14.10">וְ</char><char style="w" x-id="WLC.HOS.14.9.004" x-align="HOS.14.9.a004" x-target-ids="t005 t006 t007" x-target="he may understand" x-target-head="t007" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqj3ms" x-gloss="let.him.understand" x-translit="yāḇēn" xml:lang="hbo" x-source-ref="HOS.14.10">יָ֣בֵֽן</char> <char style="w" x-id="WLC.HOS.14.9.005" x-align="HOS.14.9.a005" x-target-ids="t008 t009" x-target="these things" x-target-head="t008" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo" x-source-ref="HOS.14.10">אֵ֔לֶּה</char> <char style="w" x-id="WLC.HOS.14.9.006" x-align="HOS.14.9.a006" x-target-ids="t010" x-target="prudent" x-target-head="t010" x-head="true" lemma="בִּין" strong="H995" x-morph="VNrmsa" x-gloss="discerning?" x-translit="nāḇôn" xml:lang="hbo" x-source-ref="HOS.14.10">נָב֖וֹן</char> <char style="w" x-id="WLC.HOS.14.9.007" x-align="HOS.14.9.a007" x-target-ids="t011" x-target="that" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="HOS.14.10">וְ</cha