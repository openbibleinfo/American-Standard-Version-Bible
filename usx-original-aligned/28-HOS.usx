	<para style="p"><verse number="17" style="v" x-ref="HOS.4.17" sid="HOS 4:17" /><char style="w" x-id="WLC.HOS.4.17.001" x-align="HOS.4.17.a001" x-target-ids="t002 t003" x-target="is joined" x-target-head="t003" x-head="true" lemma="חָבַר" strong="H2266" x-morph="Vqsmsc" x-gloss="[is].joined" x-translit="ḥăḇûr" xml:lang="hbo">חֲב֧וּר</char> <char style="w" x-id="WLC.HOS.4.17.002" x-align="HOS.4.17.a002" x-target-ids="t004 t005" x-target="to idols" x-target-head="t005" x-head="true" lemma="עָצָב" strong="H6091" x-morph="Ncmpa" x-gloss="of.idols" x-translit="ʿăṣabbiym" xml:lang="hbo">עֲצַבִּ֛ים</char> <char style="w" x-id="WLC.HOS.4.17.003" x-align="HOS.4.17.a003" x-target-ids="t001" x-target="Ephraim" x-target-head="t001" x-head="true" lemma="אֶפְרַיִם" strong="H669" x-morph="Np" x-gloss="Ephraim" x-translit="ʾep̄rāyim" xml:lang="hbo">אֶפְרָ֖יִם</char> <char style="w" x-id="WLC.HOS.4.17.004" x-align="HOS.4.17.a004" x-target-ids="t006 t008" x-target="let alone" x-target-head="t006" x-head="true" lemma="נוח" strong="H5117" x-morph="Vhv2ms" x-gloss="leave.alone" x-translit="hannaḥ-" xml:lang="hbo">הַֽנַּֽח</char>־<char style="w" x-id="WLC.HOS.4.17.005" x-align="HOS.4.17.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="l" xml:lang="hbo">לֽ</char><char style="w" x-id="WLC.HOS.4.17.006" x-align="HOS.4.17.a006" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char>׃<verse eid="HOS 4:17" /></para>
	<para style="p"><verse number="18" style="v" x-ref="HOS.4.18" sid="HOS 4:18" /><char style="w" x-id="WLC.HOS.4.18.001" x-align="HOS.4.18.a001" x-target-ids="t003 t004 t005" x-target="is become sour" x-target-head="t005" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vqp3ms" x-gloss="it.has.come.to.an.end" x-translit="sār" xml:lang="hbo">סָ֖ר</char> <char style="w" x-id="WLC.HOS.4.18.002" x-align="HOS.4.18.a002" x-target-ids="t002" x-target="drink" x-target-head="t002" x-head="true" lemma="סֹבֶא" strong="H5435" x-morph="Ncmsc" x-gloss="drink" x-translit="sāḇəʾ" xml:lang="hbo">סָבְאָ֑</char><char style="w" x-id="WLC.HOS.4.18.003" x-align="HOS.4.18.a003" x-target-ids="t001" x-target="Their" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.HOS.4.18.004" x-align="HOS.4.18.a004" x-target-ids="t010" x-target="continually" x-target-head="t010" x-head="true" lemma="זָנָה" strong="H2181" x-morph="Vha" x-gloss="continually.(prostitute.themselves)" x-translit="haznēh" xml:lang="hbo">הַזְנֵ֣ה</char> <char style="w" x-id="WLC.HOS.4.18.005" x-align="HOS.4.18.a005" x-target-ids="t006 t007 t008 t009" x-target="they play the harlot" x-target-head="t009" x-head="true" lemma="זָנָה" strong="H2181" x-morph="Vhp3cp" x-gloss="they.have.prostituted.themselves" x-translit="hiznû" xml:lang="hbo">הִזְנ֔וּ</char> <char style="w" x-id="WLC.HOS.4.18.006" x-align="HOS.4.18.a006" x-status="noncompositional" x-target-ids="t013 t014" x-target="dearly love" x-target-head="t014" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqp3cp" x-gloss="they.have.loved" x-translit="ʾāhăḇû" xml:lang="hbo">אָהֲב֥וּ</char> <char style="w" x-id="WLC.HOS.4.18.007" x-align="HOS.4.18.a006" x-status="noncompositional" lemma="יהב" strong="H157" x-morph="Vqv2mp" x-gloss="love" x-translit="hēḇû" xml:lang="hbo">הֵב֛וּ</char> <char style="w" x-id="WLC.HOS.4.18.008" x-align="HOS.4.18.a007" x-target-ids="t01