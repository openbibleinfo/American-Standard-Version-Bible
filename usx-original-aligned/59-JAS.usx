	<para style="p"><verse number="11" style="v" x-ref="JAS.2.11" sid="JAS 2:11" /><char style="w" x-id="SBLGNT.JAS.2.11.001" x-align="JAS.2.11.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="The [One]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.JAS.2.11.002" x-align="JAS.2.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.JAS.2.11.003" x-align="JAS.2.11.a003" x-target-ids="t003 t004" x-target="that said" x-target-head="t004" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAP-NSM" x-gloss="having said" x-translit="eipōn" xml:lang="grc">εἰπών</char> <char style="w" x-id="SBLGNT.JAS.2.11.004" x-align="JAS.2.11.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="Not" x-translit="Mē" xml:lang="grc">Μὴ</char> <char style="w" x-id="SBLGNT.JAS.2.11.005" x-align="JAS.2.11.a005" x-target-ids="t005 t007 t008" x-target="Do commit adultery" x-target-head="t008" x-head="true" lemma="μοιχεύω" strong="G3431" x-morph="V-AAS-2S" x-gloss="you shall commit adultery" x-translit="moicheusēis" xml:lang="grc">μοιχεύσῃς</char> <char style="w" x-id="SBLGNT.JAS.2.11.006" x-align="JAS.2.11.a006" x-target-ids="t009" x-target="said" x-target-head="t009" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.JAS.2.11.007" x-align="JAS.2.11.a007" x-target-ids="t010" x-target="also" x-target-head="t010" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καί</char> <char style="w" x-id="SBLGNT.JAS.2.11.008" x-align="JAS.2.11.a008" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="μή" strong="