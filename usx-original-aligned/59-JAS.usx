	<para style="p"><verse number="4" style="v" x-ref="JAS.2.4" sid="JAS 2:4" /><char style="w" x-id="SBLGNT.JAS.2.4.001" x-align="JAS.2.4.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.JAS.2.4.002" x-align="JAS.2.4.a002" x-target-ids="t001 t002 t004 t005" x-target="do ye make distinctions" x-target-head="t005" x-head="true" lemma="διακρίνω" strong="G1252" x-morph="V-API-2P" x-gloss="have you made a distinction" x-translit="diekrithēte" xml:lang="grc">διεκρίθητε</char> <char style="w" x-id="SBLGNT.JAS.2.4.003" x-align="JAS.2.4.a003" x-target-ids="t006" x-target="among" x-target-head="t006" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="among" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.JAS.2.4.004" x-align="JAS.2.4.a004" x-target-ids="t007" x-target="yourselves" x-target-head="t007" x-head="true" lemma="ἑαυτοῦ" strong="G1438" x-morph="F-2DPM" x-gloss="yourselves" x-translit="heautois" xml:lang="grc">ἑαυτοῖς</char> <char style="w" x-id="SBLGNT.JAS.2.4.005" x-align="JAS.2.4.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.2.4.006" x-align="JAS.2.4.a006" x-target-ids="t009" x-target="become" x-target-head="t009" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2ADI-2P" x-gloss="have become" x-translit="egenesthe" xml:lang="grc">ἐγένεσθε</char> <char style="w" x-id="SBLGNT.JAS.2.4.007" x-align="JAS.2.4.a007" x-target-ids="t010" x-target="judges" x-target-head="t010" x-head="true" lemma="κριτής" strong="G2923" x-morph="N-NPM" x-gloss="judges [with]" x-translit="kritai" xml:lang="grc">κριταὶ</char> <char style="w" x-id="SBLGNT.JAS.2.4.008" x-align="JAS.2.4.a008" x-target-ids="t011 t013" x-target="with thoughts" x-targ