	<para style="p"><verse number="2" style="v" x-ref="JAS.3.2" sid="JAS 3:2" /><char style="w" x-id="SBLGNT.JAS.3.2.001" x-align="JAS.3.2.a002" x-target-ids="t002 t003 t004" x-target="in many things" x-target-head="t003" x-head="true" lemma="πολύς" strong="G4183" x-morph="A-APN" x-gloss="In many ways" x-translit="polla" xml:lang="grc">πολλὰ</char> <char style="w" x-id="SBLGNT.JAS.3.2.002" x-align="JAS.3.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.JAS.3.2.003" x-align="JAS.3.2.a003" x-target-ids="t005 t007" x-target="we stumble" x-target-head="t007" x-head="true" lemma="πταίω" strong="G4417" x-morph="V-PAI-1P" x-gloss="we stumble" x-translit="ptaiomen" xml:lang="grc">πταίομεν</char> <char style="w" x-id="SBLGNT.JAS.3.2.004" x-align="JAS.3.2.a004" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="ἅπας" strong="G537" x-morph="A-NPM" x-gloss="all" x-translit="hapantes" xml:lang="grc">ἅπαντες</char>.<char style="w" x-id="SBLGNT.JAS.3.2.005" x-align="JAS.3.2.a005" x-target-ids="t008" x-target="If" x-target-head="t008" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἴ</char> <char style="w" x-id="SBLGNT.JAS.3.2.006" x-align="JAS.3.2.a006" x-target-ids="t009" x-target="any" x-target-head="t009" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.JAS.3.2.007" x-align="JAS.3.2.a009" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.JAS.3.2.008" x-align="JAS.3.2.a010" x-target-ids="t013" x-target="word" x-target-head="t013" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-DSM" x-gloss="what he says" x-tra