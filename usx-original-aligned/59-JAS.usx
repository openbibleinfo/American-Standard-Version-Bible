	<para style="p"><verse number="2" style="v" x-ref="JAS.1.2" sid="JAS 1:2" /><char style="w" x-id="SBLGNT.JAS.1.2.001" x-align="JAS.1.2.a001" x-target-ids="t003" x-target="all" x-target-head="t003" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-ASF" x-gloss="All" x-translit="Pasan" xml:lang="grc">Πᾶσαν</char> <char style="w" x-id="SBLGNT.JAS.1.2.002" x-align="JAS.1.2.a002" x-target-ids="t004" x-target="joy" x-target-head="t004" x-head="true" lemma="χαρά" strong="G5479" x-morph="N-ASF" x-gloss="joy" x-translit="charan" xml:lang="grc">χαρὰν</char> <char style="w" x-id="SBLGNT.JAS.1.2.003" x-align="JAS.1.2.a003" x-target-ids="t001 t002" x-target="Count it" x-target-head="t001" x-head="true" lemma="ἡγέομαι" strong="G2233" x-morph="V-ADM-2P" x-gloss="esteem [it]" x-translit="hēgēsasthe" xml:lang="grc">ἡγήσασθε</char>,<char style="w" x-id="SBLGNT.JAS.1.2.004" x-align="JAS.1.2.a004" x-target-ids="t006" x-target="brethren" x-target-head="t006" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char> <char style="w" x-id="SBLGNT.JAS.1.2.005" x-align="JAS.1.2.a005" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of me" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.JAS.1.2.006" x-align="JAS.1.2.a006" x-target-ids="t007" x-target="when" x-target-head="t007" x-head="true" lemma="ὅταν" strong="G3752" x-morph="CONJ" x-gloss="when" x-translit="hotan" xml:lang="grc">ὅταν</char> <char style="w" x-id="SBLGNT.JAS.1.2.007" x-align="JAS.1.2.a007" x-target-ids="t010 t012" x-target="into temptations" x-target-head="t012" x-head="true" lemma="πειρασμός" strong="G3986" x-morph="N-DPM" x-gloss="trials" x-translit="peirasmois" xml:lang="grc">πειρασμοῖς</char> <char style="w" x-id="SBLGNT.JAS.1.2.008" x-align="JAS.1.2.a008" x-target-ids="t008 t009" x-target="ye fall" x-target-head="t009" x-head="true" lemma="περιπίπτω" s