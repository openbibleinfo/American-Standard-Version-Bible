	<para style="p"><verse number="18" style="v" x-ref="JAS.5.18" sid="JAS 5:18" /><char style="w" x-id="SBLGNT.JAS.5.18.001" x-align="JAS.5.18.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.5.18.002" x-align="JAS.5.18.a002" x-target-ids="t004" x-target="again" x-target-head="t004" x-head="true" lemma="πάλιν" strong="G3825" x-morph="ADV" x-gloss="again" x-translit="palin" xml:lang="grc">πάλιν</char> <char style="w" x-id="SBLGNT.JAS.5.18.003" x-align="JAS.5.18.a003" x-target-ids="t002 t003" x-target="he prayed" x-target-head="t003" x-head="true" lemma="προσεύχομαι" strong="G4336" x-morph="V-ADI-3S" x-gloss="he prayed" x-translit="prosēuxato" xml:lang="grc">προσηύξατο</char>,<char style="w" x-id="SBLGNT.JAS.5.18.004" x-align="JAS.5.18.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.5.18.005" x-align="JAS.5.18.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.JAS.5.18.006" x-align="JAS.5.18.a006" x-target-ids="t007" x-target="heaven" x-target-head="t007" x-head="true" lemma="οὐρανός" strong="G3772" x-morph="N-NSM" x-gloss="heaven" x-translit="ouranos" xml:lang="grc">οὐρανὸς</char> <char style="w" x-id="SBLGNT.JAS.5.18.007" x-align="JAS.5.18.a007" x-target-ids="t009" x-target="rain" x-target-head="t009" x-head="true" lemma="ὑετός" strong="G5205" x-morph="N-ASM" x-gloss="rain" x-translit="hyeton" xml:lang="grc">ὑετὸν</char> <char style="w" x-id="SBLGNT.JAS.5.18.008" x-align="JAS.5.18.a008" x-target-ids="t008" x-target="gave" x-target-head="t008" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-AAI-3S" x-gl