	<para style="p"><verse number="1" style="v" x-ref="JAS.3.1" sid="JAS 3:1" /><char style="w" x-id="SBLGNT.JAS.3.1.001" x-align="JAS.3.1.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="Not" x-translit="Mē" xml:lang="grc">Μὴ</char> <char style="w" x-id="SBLGNT.JAS.3.1.002" x-align="JAS.3.1.a002" x-target-ids="t003 t004 t005" x-target="many of you" x-target-italic-ids="t004 t005" x-target-head="t003" x-head="true" lemma="πολύς" strong="G4183" x-morph="A-NPM" x-gloss="many [of you]" x-translit="polloi" xml:lang="grc">πολλοὶ</char> <char style="w" x-id="SBLGNT.JAS.3.1.003" x-align="JAS.3.1.a003" x-target-ids="t006" x-target="teachers" x-target-head="t006" x-head="true" lemma="διδάσκαλος" strong="G1320" x-morph="N-NPM" x-gloss="teachers" x-translit="didaskaloi" xml:lang="grc">διδάσκαλοι</char> <char style="w" x-id="SBLGNT.JAS.3.1.004" x-align="JAS.3.1.a004" x-target-ids="t001" x-target="Be" x-target-head="t001" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-PNM-2P" x-gloss="let be" x-translit="ginesthe" xml:lang="grc">γίνεσθε</char>,<char style="w" x-id="SBLGNT.JAS.3.1.005" x-align="JAS.3.1.a005" x-target-ids="t008" x-target="brethren" x-target-head="t008" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char> <char style="w" x-id="SBLGNT.JAS.3.1.006" x-align="JAS.3.1.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of mine" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.JAS.3.1.007" x-align="JAS.3.1.a007" x-target-ids="t009" x-target="knowing" x-target-head="t009" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAP-NPM" x-gloss="knowing" x-translit="eidotes" xml:lang="grc">εἰδότες</char> <char style="w" x-id="SBLGNT.JAS.3.1.008" x-align="JAS.3.1.a008" x-target-ids="t010" x-target="that" x-target-head="t01