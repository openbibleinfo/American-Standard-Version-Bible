	<para style="p"><verse number="7" style="v" x-ref="JAS.4.7" sid="JAS 4:7" /><char style="w" x-id="SBLGNT.JAS.4.7.001" x-align="JAS.4.7.a001" x-target-ids="t001 t002" x-target="Be subject" x-target-head="t002" x-head="true" lemma="ὑποτάσσω" strong="G5293" x-morph="V-2APM-2P" x-gloss="Subject yourselves" x-translit="hypotagēte" xml:lang="grc">ὑποτάγητε</char> <char style="w" x-id="SBLGNT.JAS.4.7.002" x-align="JAS.4.7.a002" x-target-ids="t003" x-target="therefore" x-target-head="t003" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.JAS.4.7.003" x-align="JAS.4.7.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="-" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.JAS.4.7.004" x-align="JAS.4.7.a004" x-target-ids="t004 t005" x-target="unto God" x-target-head="t005" x-head="true" lemma="θεός" strong="G2316" x-morph="N-DSM" x-gloss="to God" x-translit="theōi" xml:lang="grc">θεῷ</char>·<char style="w" x-id="SBLGNT.JAS.4.7.005" x-align="JAS.4.7.a006" x-target-ids="t007" x-target="resist" x-target-head="t007" x-head="true" lemma="ἀνθίστημι" strong="G436" x-morph="V-2AAM-2P" x-gloss="Resist" x-translit="antistēte" xml:lang="grc">ἀντίστητε</char> <char style="w" x-id="SBLGNT.JAS.4.7.006" x-align="JAS.4.7.a005" x-target-ids="t006" x-target="but" x-target-head="t006" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.JAS.4.7.007" x-align="JAS.4.7.a007" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="the" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.JAS.4.7.008" x-align="JAS.4.7.a008" x-target-ids="t009" x-target="devil" x-target-head="t009" x-head="true" lemma="διάβολος" strong="G1228" x-morph="A-DSM" x-gloss="devil" x-translit="d