	<para style="p"><verse number="10" style="v" x-ref="JAS.4.10" sid="JAS 4:10" /><char style="w" x-id="SBLGNT.JAS.4.10.001" x-align="JAS.4.10.a001" x-target-ids="t001 t002" x-target="Humble yourselves" x-target-head="t001" x-head="true" lemma="ταπεινόω" strong="G5013" x-morph="V-APM-2P" x-gloss="Humble yourselves" x-translit="tapeinōthēte" xml:lang="grc">ταπεινώθητε</char> <char style="w" x-id="SBLGNT.JAS.4.10.002" x-align="JAS.4.10.a002" x-target-ids="t003 t004 t005 t006" x-target="in the sight of" x-target-head="t005" x-head="true" lemma="ἐνώπιον" strong="G1799" x-morph="PREP" x-gloss="in the presence of" x-translit="enōpion" xml:lang="grc">ἐνώπιον</char> <char style="w" x-id="SBLGNT.JAS.4.10.003" x-align="JAS.4.10.a003" x-target-ids="t007 t008" x-target="the Lord" x-target-head="t008" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-GSM" x-gloss="[the] Lord" x-translit="kyriou" xml:lang="grc">κυρίου</char>,<char style="w" x-id="SBLGNT.JAS.4.10.004" x-align="JAS.4.10.a004" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.4.10.005" x-align="JAS.4.10.a005" x-target-ids="t010 t011 t012" x-target="he shall exalt" x-target-head="t012" x-head="true" lemma="ὑψόω" strong="G5312" x-morph="V-FAI-3S" x-gloss="He will exalt" x-translit="hypsōsei" xml:lang="grc">ὑψώσει</char> <char style="w" x-id="SBLGNT.JAS.4.10.006" x-align="JAS.4.10.a006" x-target-ids="t013" x-target="you" x-target-head="t013" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char>.<verse eid="JAS 4:10" /></para>
