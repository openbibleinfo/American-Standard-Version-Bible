	<para style="p"><verse number="12" style="v" x-ref="JAS.2.12" sid="JAS 2:12" /><char style="w" x-id="SBLGNT.JAS.2.12.001" x-align="JAS.2.12.a001" x-target-ids="t001" x-target="So" x-target-head="t001" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="So" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.JAS.2.12.002" x-align="JAS.2.12.a002" x-target-ids="t002 t003" x-target="speak ye" x-target-head="t002" x-head="true" lemma="λαλέω" strong="G2980" x-morph="V-PAM-2P" x-gloss="speak" x-translit="laleite" xml:lang="grc">λαλεῖτε</char> <char style="w" x-id="SBLGNT.JAS.2.12.003" x-align="JAS.2.12.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.2.12.004" x-align="JAS.2.12.a004" x-target-ids="t005" x-target="so" x-target-head="t005" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="so" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.JAS.2.12.005" x-align="JAS.2.12.a005" x-target-ids="t006" x-target="do" x-target-head="t006" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-PAM-2P" x-gloss="act" x-translit="poieite" xml:lang="grc">ποιεῖτε</char> <char style="w" x-id="SBLGNT.JAS.2.12.006" x-align="JAS.2.12.a006" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.JAS.2.12.007" x-align="JAS.2.12.a009" x-target-ids="t014" x-target="by" x-target-head="t014" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="by" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.JAS.2.12.008" x-align="JAS.2.12.a010" x-target-ids="t015 t016" x-target="a law" x-target-head="t016" x-head="true" lemma="νόμος" strong="G3551" x-morph="N-GSM" x-gloss="[the] law" x-translit="nomou" xml:lang="grc">νόμου</char> <char style="w" x-id="SBLGNT.JAS.2.12.009" x-align="JAS.2.12.a011" x-target-ids="t017 t018" x-target="of liberty" x-target-head="t018" x-head="true" lemma="ἐλευθερία" strong="G1657" x-morph="N-GSF" x-gloss="of freedom" x-translit="eleutherias" xml:lang="grc">ἐλευθερίας</char> <char style="w" x-id="SBLGNT.JAS.2.12.010" x-align="JAS.2.12.a007" x-target-ids="t008 t009 t010" x-target="men that are" x-target-head="t010" x-head="true" lemma="μέλλω" strong="G3195" x-morph="V-PAP-NPM" x-gloss="being about" x-translit="mellontes" xml:lang="grc">μέλλοντες</char> <char style="w" x-id="SBLGNT.JAS.2.12.011" x-align="JAS.2.12.a008" x-target-ids="t011 t012 t013" x-target="to be judged" x-target-head="t013" x-head="true" lemma="κρίνω" strong="G2919" x-morph="V-PPN" x-gloss="to be judged" x-translit="krinesthai" xml:lang="grc">κρίνεσθαι</char>.<verse eid="JAS 2:12" /></para>
	<para style="p"><verse number="13" style="v" x-ref="JAS.2.13" sid="JAS 2:13" /><char style="w" x-id="SBLGNT.JAS.2.13.001" x-align="JAS.2.13.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="-" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.JAS.2.13.002" x-align="JAS.2.13.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="For" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.JAS.2.13.003" x-align="JAS.2.13.a003" x-target-ids="t002" x-target="judgment" x-target-head="t002" x-head="true" lemma="κρίσις" strong="G2920" x-morph="N-NSF" x-gloss="judgment" x-translit="krisis" xml:lang="grc">κρίσις</char> <char style="w" x-id="SBLGNT.JAS.2.13.004" x-align="JAS.2.13.a004" x-target-ids="t003 t004 t005" x-target="is without mercy" x-target-italic-ids="t003" x-target-head="t005" x-head="true" lemma="ἀνέλεος" strong="G448" x-morph="A-NSF" x-gloss="without mercy [will be]" x-translit="aneleos" xml:lang="grc">ἀνέλεος</char> <char style="w" x-id="SBLGNT.JAS.2.13.005" x-align="JAS.2.13.a005" x-target-ids="t006 t007" x-target="to him" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="to the [one]" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.JAS.2.13.006" x-align="JAS.2.13.a006" x-target-ids="t011" x-target="no" x-target-head="t011" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.JAS.2.13.007" x-align="JAS.2.13.a007" x-target-ids="t008 t009 t010" x-target="that hath showed" x-target-head="t010" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-AAP-DSM" x-gloss="having shown" x-translit="poiēsanti" xml:lang="grc">ποιήσαντι</char> <char style="w" x-id="SBLGNT.JAS.2.13.008" x-align="JAS.2.13.a008" x-target-ids="t012" x-target="mercy" x-target-head="t012" x-head="true" l