	<para style="p"><verse number="9" style="v" x-ref="JAS.4.9" sid="JAS 4:9" /><char style="w" x-id="SBLGNT.JAS.4.9.001" x-align="JAS.4.9.a001" x-target-ids="t001 t002" x-target="Be afflicted" x-target-head="t002" x-head="true" lemma="ταλαιπωρέω" strong="G5003" x-morph="V-AAM-2P" x-translit="talaipōrēsate" xml:lang="grc">ταλαιπωρήσατε</char> <char style="w" x-id="SBLGNT.JAS.4.9.002" x-align="JAS.4.9.a002" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.4.9.003" x-align="JAS.4.9.a003" x-target-ids="t004" x-target="mourn" x-target-head="t004" x-head="true" lemma="πενθέω" strong="G3996" x-morph="V-AAM-2P" x-translit="penthēsate" xml:lang="grc">πενθήσατε</char> <char style="w" x-id="SBLGNT.JAS.4.9.004" x-align="JAS.4.9.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.4.9.005" x-align="JAS.4.9.a005" x-target-ids="t006" x-target="weep" x-target-head="t006" x-head="true" lemma="κλαίω" strong="G2799" x-morph="V-AAM-2P" x-translit="klausate" xml:lang="grc">κλαύσατε</char>·<char style="w" x-id="SBLGNT.JAS.4.9.006" x-align="JAS.4.9.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="The" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.JAS.4.9.007" x-align="JAS.4.9.a007" x-target-ids="t009" x-target="laughter" x-target-head="t009" x-head="true" lemma="γέλως" strong="G1071" x-morph="N-NSM" x-gloss="laughter" x-translit="gelōs" xml:lang="grc">γέλως</char> <char style="w" x-id="SBLGNT.JAS.4.9.008" x-align="JAS.4.9.a008" x-target-ids="t008" x-target="your" x-target-head="t008" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="of you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char> <char style="w" x-id="SBLGNT.JAS.4.9.009" x-alig