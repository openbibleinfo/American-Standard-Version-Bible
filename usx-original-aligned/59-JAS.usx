	<para style="p"><verse number="15" style="v" x-ref="JAS.5.15" sid="JAS 5:15" /><char style="w" x-id="SBLGNT.JAS.5.15.001" x-align="JAS.5.15.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.5.15.002" x-align="JAS.5.15.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.JAS.5.15.003" x-align="JAS.5.15.a003" x-target-ids="t003" x-target="prayer" x-target-head="t003" x-head="true" lemma="εὐχή" strong="G2171" x-morph="N-NSF" x-gloss="prayer" x-translit="euchē" xml:lang="grc">εὐχὴ</char> <char style="w" x-id="SBLGNT.JAS.5.15.004" x-align="JAS.5.15.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="-" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.JAS.5.15.005" x-align="JAS.5.15.a005" x-target-ids="t004 t005" x-target="of faith" x-target-head="t005" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-GSF" x-gloss="of faith" x-translit="pisteōs" xml:lang="grc">πίστεως</char> <char style="w" x-id="SBLGNT.JAS.5.15.006" x-align="JAS.5.15.a006" x-target-ids="t006 t007" x-target="shall save" x-target-head="t007" x-head="true" lemma="σῴζω" strong="G4982" x-morph="V-FAI-3S" x-gloss="will save" x-translit="sōsei" xml:lang="grc">σώσει</char> <char style="w" x-id="SBLGNT.JAS.5.15.007" x-align="JAS.5.15.a007" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the one" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.JAS.5.15.008" x-align="JAS.5.15.a008" x-target-ids="t009 t010 t011" x-target="that is sick" x-target-head="t011" x-head="true" lemma="κάμνω" strong="G2577" x-morph="V-PAP-ASM" x-gloss="ailing" x-translit="kamn