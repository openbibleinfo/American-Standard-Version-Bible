	<para style="p"><verse number="8" style="v" x-ref="JAS.4.8" sid="JAS 4:8" /><char style="w" x-id="SBLGNT.JAS.4.8.001" x-align="JAS.4.8.a001" x-target-ids="t001 t002" x-target="Draw nigh" x-target-head="t002" x-head="true" lemma="ἐγγίζω" strong="G1448" x-morph="V-AAM-2P" x-gloss="Draw near" x-translit="engisate" xml:lang="grc">ἐγγίσατε</char> <char style="w" x-id="SBLGNT.JAS.4.8.002" x-align="JAS.4.8.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="-" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.JAS.4.8.003" x-align="JAS.4.8.a003" x-target-ids="t003 t004" x-target="to God" x-target-head="t004" x-head="true" lemma="θεός" strong="G2316" x-morph="N-DSM" x-gloss="to God" x-translit="theōi" xml:lang="grc">θεῷ</char>,<char style="w" x-id="SBLGNT.JAS.4.8.004" x-align="JAS.4.8.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.4.8.005" x-align="JAS.4.8.a005" x-target-ids="t006 t007 t008 t009" x-target="he will draw nigh" x-target-head="t009" x-head="true" lemma="ἐγγίζω" strong="G1448" x-morph="V-FAI-3S" x-translit="engiei" xml:lang="grc">ἐγγιεῖ</char> <char style="w" x-id="SBLGNT.JAS.4.8.006" x-align="JAS.4.8.a006" x-target-ids="t010 t011" x-target="to you" x-target-head="t011" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char>.<char style="w" x-id="SBLGNT.JAS.4.8.007" x-align="JAS.4.8.a007" x-target-ids="t012" x-target="Cleanse" x-target-head="t012" x-head="true" lemma="καθαρίζω" strong="G2511" x-morph="V-AAM-2P" x-gloss="Cleanse" x-translit="katharisate" xml:lang="grc">καθαρίσατε</char> <char style="w" x-id="SBLGNT.JAS.4.8.008" x-align="JAS.4.8.a008" x-target-ids="t013 t014" x-target="your hands" x-target-head="t014" x-head="true" lemma="χείρ" strong="G5495" x-morph="N-APF" x-glos