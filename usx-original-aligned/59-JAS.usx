	<para style="p"><verse number="17" style="v" x-ref="JAS.5.17" sid="JAS 5:17" /><char style="w" x-id="SBLGNT.JAS.5.17.001" x-align="JAS.5.17.a001" x-target-ids="t001" x-target="Elijah" x-target-head="t001" x-head="true" lemma="Ἠλίας" strong="G2243" x-morph="N-NSM" x-gloss="Elijah" x-translit="Ēlias" xml:lang="grc">Ἠλίας</char> <char style="w" x-id="SBLGNT.JAS.5.17.002" x-align="JAS.5.17.a003" x-target-ids="t003 t004" x-target="a man" x-target-head="t004" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-NSM" x-gloss="a man" x-translit="anthrōpos" xml:lang="grc">ἄνθρωπος</char> <char style="w" x-id="SBLGNT.JAS.5.17.003" x-align="JAS.5.17.a002" x-target-ids="t002" x-target="was" x-target-head="t002" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.JAS.5.17.004" x-align="JAS.5.17.a004" x-target-ids="t005 t006 t007" x-target="of like passions" x-target-head="t007" x-head="true" lemma="ὁμοιοπαθής" strong="G3663" x-morph="A-NSM" x-gloss="of like nature" x-translit="homoiopathēs" xml:lang="grc">ὁμοιοπαθὴς</char> <char style="w" x-id="SBLGNT.JAS.5.17.005" x-align="JAS.5.17.a005" x-target-ids="t008 t009" x-target="with us" x-target-head="t009" x-head="true" lemma="ἐγώ" strong="G2254" x-morph="P-1DP" x-gloss="to us" x-translit="hēmin" xml:lang="grc">ἡμῖν</char>,<char style="w" x-id="SBLGNT.JAS.5.17.006" x-align="JAS.5.17.a006" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.5.17.007" x-align="JAS.5.17.a008" x-target-ids="t013" x-target="fervently" x-target-head="t013" x-head="true" lemma="προσευχή" strong="G4335" x-morph="N-DSF" x-gloss="with fervent prayer" x-translit="proseuchēi" xml:lang="grc">προσευχῇ</char> <char style="w" x-id="SBLGNT.JAS.5.17.008" x-align="JAS.5.17.a007" x-target-ids="t011 t012" x-target="he prayed" x