	<para style="p"><verse number="6" style="v" x-ref="JAS.4.6" sid="JAS 4:6" /><char style="w" x-id="SBLGNT.JAS.4.6.001" x-align="JAS.4.6.a003" x-target-ids="t004" x-target="more" x-target-head="t004" x-head="true" lemma="μέγας" strong="G3187" x-morph="A-ASF-C" x-gloss="Greater" x-translit="meizona" xml:lang="grc">μείζονα</char> <char style="w" x-id="SBLGNT.JAS.4.6.002" x-align="JAS.4.6.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.JAS.4.6.003" x-align="JAS.4.6.a002" x-target-ids="t002 t003" x-target="he giveth" x-target-head="t003" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-PAI-3S" x-gloss="He gives" x-translit="didōsin" xml:lang="grc">δίδωσιν</char> <char style="w" x-id="SBLGNT.JAS.4.6.004" x-align="JAS.4.6.a004" x-target-ids="t005" x-target="grace" x-target-head="t005" x-head="true" lemma="χάρις" strong="G5485" x-morph="N-ASF" x-gloss="grace" x-translit="charin" xml:lang="grc">χάριν</char>·<char style="w" x-id="SBLGNT.JAS.4.6.005" x-align="JAS.4.6.a005" x-target-ids="t006" x-target="Wherefore" x-target-head="t006" x-head="true" lemma="διό" strong="G1352" x-morph="CONJ" x-gloss="Therefore" x-translit="dio" xml:lang="grc">διὸ</char> <char style="w" x-id="SBLGNT.JAS.4.6.006" x-align="JAS.4.6.a006" x-target-ids="t007 t008 t009" x-target="the scripture saith" x-target-italic-ids="t007 t008" x-target-head="t009" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-3S" x-gloss="it says" x-translit="legei" xml:lang="grc">λέγει</char>·<char style="w" x-id="SBLGNT.JAS.4.6.007" x-align="JAS.4.6.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="Ho" xml:lang="grc">Ὁ</char> <char style="w" x-id="SBLGNT.JAS.4.6.008" x-align="JAS.4.6.a008" x-target-ids="t010" x-target="God" x-target-head="t010" x-head="true" lemma="θεός" strong="G2316" x-morph="N-NSM