	<para style="p"><verse number="16" style="v" x-ref="JAS.5.16" sid="JAS 5:16" /><char style="w" x-id="SBLGNT.JAS.5.16.001" x-align="JAS.5.16.a001" x-target-ids="t001" x-target="Confess" x-target-head="t001" x-head="true" lemma="ἐξομολογέω" strong="G1843" x-morph="V-PMM-2P" x-gloss="Confess" x-translit="exomologeisthe" xml:lang="grc">ἐξομολογεῖσθε</char> <char style="w" x-id="SBLGNT.JAS.5.16.002" x-align="JAS.5.16.a002" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.JAS.5.16.003" x-align="JAS.5.16.a005" x-target-ids="t005 t006 t007" x-target="one to another" x-target-head="t007" x-head="true" lemma="ἀλλήλων" strong="G240" x-morph="C-DPM" x-gloss="to one another" x-translit="allēlois" xml:lang="grc">ἀλλήλοις</char> <char style="w" x-id="SBLGNT.JAS.5.16.004" x-align="JAS.5.16.a003" x-target-ids="t003" x-target="your" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APF" x-gloss="the" x-translit="tas" xml:lang="grc">τὰς</char> <char style="w" x-id="SBLGNT.JAS.5.16.005" x-align="JAS.5.16.a004" x-target-ids="t004" x-target="sins" x-target-head="t004" x-head="true" lemma="ἁμαρτία" strong="G266" x-morph="N-APF" x-gloss="sins" x-translit="hamartias" xml:lang="grc">ἁμαρτίας</char> <char style="w" x-id="SBLGNT.JAS.5.16.006" x-align="JAS.5.16.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.5.16.007" x-align="JAS.5.16.a007" x-target-ids="t009" x-target="pray" x-target-head="t009" x-head="true" lemma="εὔχομαι" strong="G2172" x-morph="V-PMM-2P" x-translit="euchesthe" xml:lang="grc">εὔχεσθε</char> <char style="w" x-id="SBLGNT.JAS.5.16.008" x-align="JAS.5.16.a008" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="ὑπέρ