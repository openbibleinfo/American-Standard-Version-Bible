	<para style="p"><verse number="12" style="v" x-ref="JAS.5.12" sid="JAS 5:12" /><char style="w" x-id="SBLGNT.JAS.5.12.001" x-align="JAS.5.12.a002" x-target-ids="t002" x-target="above" x-target-head="t002" x-head="true" lemma="πρό" strong="G4253" x-morph="PREP" x-gloss="Before" x-translit="Pro" xml:lang="grc">Πρὸ</char> <char style="w" x-id="SBLGNT.JAS.5.12.002" x-align="JAS.5.12.a003" x-target-ids="t003 t004" x-target="all things" x-target-head="t003" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-GPN" x-gloss="all things" x-translit="pantōn" xml:lang="grc">πάντων</char> <char style="w" x-id="SBLGNT.JAS.5.12.003" x-align="JAS.5.12.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δέ</char>,<char style="w" x-id="SBLGNT.JAS.5.12.004" x-align="JAS.5.12.a005" x-target-ids="t006" x-target="brethren" x-target-head="t006" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char> <char style="w" x-id="SBLGNT.JAS.5.12.005" x-align="JAS.5.12.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of me" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.JAS.5.12.006" x-align="JAS.5.12.a007" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.JAS.5.12.007" x-align="JAS.5.12.a006" x-target-ids="t007" x-target="swear" x-target-head="t007" x-head="true" lemma="ὀμνύω" strong="G3660" x-morph="V-PAM-2P" x-gloss="swear" x-translit="omnyete" xml:lang="grc">ὀμνύετε</char>,<char style="w" x-id="SBLGNT.JAS.5.12.008" x-align="JAS.5.12.a008" x-target-ids="t009" x-target="neither" x-target-head="t009" x-head="true" lemma="μήτε" strong="G3383" x-morph="CONJ-N" x-gloss="n