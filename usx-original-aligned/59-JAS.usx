	<para style="p"><verse number="5" style="v" x-ref="JAS.5.5" sid="JAS 5:5" /><char style="w" x-id="SBLGNT.JAS.5.5.001" x-align="JAS.5.5.a001" x-target-ids="t001 t002 t003 t004" x-target="Ye have lived delicately" x-target-head="t004" x-head="true" lemma="τρυφάω" strong="G5171" x-morph="V-AAI-2P" x-gloss="You lived in luxury" x-translit="etryphēsate" xml:lang="grc">ἐτρυφήσατε</char> <char style="w" x-id="SBLGNT.JAS.5.5.002" x-align="JAS.5.5.a002" x-target-ids="t005" x-target="on" x-target-head="t005" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="upon" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.JAS.5.5.003" x-align="JAS.5.5.a003" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.JAS.5.5.004" x-align="JAS.5.5.a004" x-target-ids="t007" x-target="earth" x-target-head="t007" x-head="true" lemma="γῆ" strong="G1093" x-morph="N-GSF" x-gloss="earth" x-translit="gēs" xml:lang="grc">γῆς</char> <char style="w" x-id="SBLGNT.JAS.5.5.005" x-align="JAS.5.5.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.JAS.5.5.006" x-align="JAS.5.5.a006" x-target-ids="t009 t010 t011" x-target="taken your pleasure" x-target-head="t011" x-head="true" lemma="σπαταλάω" strong="G4684" x-morph="V-AAI-2P" x-gloss="lived in self-indulgence" x-translit="espatalēsate" xml:lang="grc">ἐσπαταλήσατε</char>,<char style="w" x-id="SBLGNT.JAS.5.5.007" x-align="JAS.5.5.a007" x-target-ids="t012 t013 t014" x-target="ye have nourished" x-target-head="t014" x-head="true" lemma="τρέφω" strong="G5142" x-morph="V-AAI-2P" x-gloss="You have fattened" x-translit="ethrepsate" xml:lang="grc">ἐθρέψατε</char> <char style="w" x-id="SBLGNT.JAS.5.5.008" x-align="JAS.5.5.a008" x-status="unr