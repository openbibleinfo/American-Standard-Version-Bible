	<para style="p"><verse number="11" style="v" x-ref="JAS.5.11" sid="JAS 5:11" /><char style="w" x-id="SBLGNT.JAS.5.11.001" x-align="JAS.5.11.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="Behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.JAS.5.11.002" x-align="JAS.5.11.a002" x-target-ids="t002 t003 t005" x-target="we call blessed" x-target-head="t005" x-head="true" lemma="μακαρίζω" strong="G3106" x-morph="V-PAI-1P" x-gloss="we count blessed" x-translit="makarizomen" xml:lang="grc">μακαρίζομεν</char> <char style="w" x-id="SBLGNT.JAS.5.11.003" x-align="JAS.5.11.a003" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="those" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.JAS.5.11.004" x-align="JAS.5.11.a004" x-target-ids="t006 t007" x-target="that endured" x-target-head="t007" x-head="true" lemma="ὑπομένω" strong="G5278" x-morph="V-AAP-APM" x-gloss="having persevered" x-translit="hypomeinantas" xml:lang="grc">ὑπομείναντας</char>·<char style="w" x-id="SBLGNT.JAS.5.11.005" x-align="JAS.5.11.a006" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="The" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.JAS.5.11.006" x-align="JAS.5.11.a007" x-target-ids="t013" x-target="patience" x-target-head="t013" x-head="true" lemma="ὑπομονή" strong="G5281" x-morph="N-ASF" x-gloss="perseverance" x-translit="hypomonēn" xml:lang="grc">ὑπομονὴν</char> <char style="w" x-id="SBLGNT.JAS.5.11.007" x-align="JAS.5.11.a008" x-target-ids="t014 t015" x-target="of Job" x-target-head="t015" x-head="true" lemma="Ἰώβ" strong="G2492" x-morph="N-PRI" x-gloss="of Job" x-translit="Iōb" xml:lang="grc">Ἰὼβ</char> <char style="w" x-id="SBLGNT.JAS.5.11.008" x-align="JAS.5.11.a005" x-target-ids="t008 t009 t0