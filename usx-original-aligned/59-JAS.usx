	<para style="p"><verse number="15" style="v" x-ref="JAS.1.15" sid="JAS 1:15" /><char style="w" x-id="SBLGNT.JAS.1.15.001" x-align="JAS.1.15.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="εἶτα" strong="G1534" x-morph="ADV" x-gloss="Then" x-translit="eita" xml:lang="grc">εἶτα</char> <char style="w" x-id="SBLGNT.JAS.1.15.002" x-align="JAS.1.15.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="-" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.JAS.1.15.003" x-align="JAS.1.15.a003" x-target-ids="t003" x-target="lust" x-target-head="t003" x-head="true" lemma="ἐπιθυμία" strong="G1939" x-morph="N-NSF" x-gloss="desire" x-translit="epithymia" xml:lang="grc">ἐπιθυμία</char> <char style="w" x-id="SBLGNT.JAS.1.15.004" x-align="JAS.1.15.a004" x-target-ids="t004 t005 t006 t007" x-target="when it hath conceived" x-target-head="t007" x-head="true" lemma="συλλαμβάνω" strong="G4815" x-morph="V-2AAP-NSF" x-gloss="having conceived" x-translit="syllabousa" xml:lang="grc">συλλαβοῦσα</char> <char style="w" x-id="SBLGNT.JAS.1.15.005" x-align="JAS.1.15.a005" x-target-ids="t008" x-target="beareth" x-target-head="t008" x-head="true" lemma="τίκτω" strong="G5088" x-morph="V-PAI-3S" x-gloss="gives birth to" x-translit="tiktei" xml:lang="grc">τίκτει</char> <char style="w" x-id="SBLGNT.JAS.1.15.006" x-align="JAS.1.15.a006" x-target-ids="t009" x-target="sin" x-target-head="t009" x-head="true" lemma="ἁμαρτία" strong="G266" x-morph="N-ASF" x-gloss="sin" x-translit="hamartian" xml:lang="grc">ἁμαρτίαν</char>,<char style="w" x-id="SBLGNT.JAS.1.15.007" x-align="JAS.1.15.a007" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="-" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.JAS.1.15.008" x-align="JAS.1.15.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" le