	<para style="p"><verse number="1" style="v" x-ref="JAS.5.1" sid="JAS 5:1" /><char style="w" x-id="SBLGNT.JAS.5.1.001" x-align="JAS.5.1.a001" x-target-ids="t001" x-target="Come" x-target-head="t001" x-head="true" lemma="ἄγε" strong="G33" x-morph="V-PAM-2S" x-gloss="Come" x-translit="Age" xml:lang="grc">Ἄγε</char> <char style="w" x-id="SBLGNT.JAS.5.1.002" x-align="JAS.5.1.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="νῦν" strong="G3568" x-morph="ADV" x-gloss="now" x-translit="nyn" xml:lang="grc">νῦν</char> <char style="w" x-id="SBLGNT.JAS.5.1.003" x-align="JAS.5.1.a003" x-target-ids="t003" x-target="ye" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="[you]" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.JAS.5.1.004" x-align="JAS.5.1.a004" x-target-ids="t004" x-target="rich" x-target-head="t004" x-head="true" lemma="πλούσιος" strong="G4145" x-morph="A-NPM" x-gloss="rich" x-translit="plousioi" xml:lang="grc">πλούσιοι</char>,<char style="w" x-id="SBLGNT.JAS.5.1.005" x-align="JAS.5.1.a005" x-target-ids="t005" x-target="weep" x-target-head="t005" x-head="true" lemma="κλαίω" strong="G2799" x-morph="V-AAM-2P" x-gloss="weep" x-translit="klausate" xml:lang="grc">κλαύσατε</char> <char style="w" x-id="SBLGNT.JAS.5.1.006" x-align="JAS.5.1.a006" x-target-ids="t006 t007" x-target="and howl" x-target-head="t007" x-head="true" lemma="ὀλολύζω" strong="G3649" x-morph="V-PAP-NPM" x-gloss="wailing" x-translit="ololyzontes" xml:lang="grc">ὀλολύζοντες</char> <char style="w" x-id="SBLGNT.JAS.5.1.007" x-align="JAS.5.1.a007" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="over" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.JAS.5.1.008" x-align="JAS.5.1.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPF" x-gloss="the" x-translit="tais" xml:lang="grc">ταῖς</char> <ch