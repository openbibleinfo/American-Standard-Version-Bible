	<para style="p"><verse number="13" style="v" x-ref="JAS.5.13" sid="JAS 5:13" /><char style="w" x-id="SBLGNT.JAS.5.13.001" x-align="JAS.5.13.a001" x-target-ids="t001 t005" x-target="Is suffering" x-target-head="t005" x-head="true" lemma="κακοπαθέω" strong="G2553" x-morph="V-PAI-3S" x-gloss="Is suffering hardships" x-translit="Kakopathei" xml:lang="grc">Κακοπαθεῖ</char> <char style="w" x-id="SBLGNT.JAS.5.13.002" x-align="JAS.5.13.a002" x-target-ids="t002" x-target="any" x-target-head="t002" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.JAS.5.13.003" x-align="JAS.5.13.a003" x-target-ids="t003" x-target="among" x-target-head="t003" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="among" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.JAS.5.13.004" x-align="JAS.5.13.a004" x-target-ids="t004" x-target="you" x-target-head="t004" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="you" x-translit="hymin" xml:lang="grc">ὑμῖν</char>;<char style="w" x-id="SBLGNT.JAS.5.13.005" x-align="JAS.5.13.a005" x-target-ids="t006 t007 t008" x-target="let him pray" x-target-head="t008" x-head="true" lemma="προσεύχομαι" strong="G4336" x-morph="V-PNM-3S" x-gloss="Let him pray" x-translit="proseuchesthō" xml:lang="grc">προσευχέσθω</char>·<char style="w" x-id="SBLGNT.JAS.5.13.006" x-align="JAS.5.13.a006" x-target-ids="t009 t011" x-target="Is cheerful" x-target-head="t011" x-head="true" lemma="εὐθυμέω" strong="G2114" x-morph="V-PAI-3S" x-gloss="Is cheerful" x-translit="euthymei" xml:lang="grc">εὐθυμεῖ</char> <char style="w" x-id="SBLGNT.JAS.5.13.007" x-align="JAS.5.13.a007" x-target-ids="t010" x-target="any" x-target-head="t010" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char>;<char style="w" x-id="SBLGNT.JAS.5.13.008" x-align="JAS.5.13.a008" x-target-ids="t012 t013 t014 t015" x-