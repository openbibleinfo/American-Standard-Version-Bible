	<para style="p"><verse number="11" style="v" x-ref="GAL.1.11" sid="GAL 1:11" /><char style="w" x-id="SBLGNT.GAL.1.11.001" x-align="GAL.1.11.a002" x-target-ids="t002 t003 t004" x-target="I make known" x-target-head="t004" x-head="true" lemma="γνωρίζω" strong="G1107" x-morph="V-PAI-1S" x-gloss="I make known" x-translit="Gnōrizō" xml:lang="grc">Γνωρίζω</char> <char style="w" x-id="SBLGNT.GAL.1.11.002" x-align="GAL.1.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.GAL.1.11.003" x-align="GAL.1.11.a003" x-target-ids="t005 t006" x-target="to you" x-target-head="t006" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char>,<char style="w" x-id="SBLGNT.GAL.1.11.004" x-align="GAL.1.11.a004" x-target-ids="t007" x-target="brethren" x-target-head="t007" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char>,<char style="w" x-id="SBLGNT.GAL.1.11.005" x-align="GAL.1.11.a005" x-target-ids="t008 t009 t010" x-target="as touching the" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.GAL.1.11.006" x-align="GAL.1.11.a006" x-target-ids="t011" x-target="gospel" x-target-head="t011" x-head="true" lemma="εὐαγγέλιον" strong="G2098" x-morph="N-ASN" x-gloss="gospel" x-translit="euangelion" xml:lang="grc">εὐαγγέλιον</char> <char style="w" x-id="SBLGNT.GAL.1.11.007" x-align="GAL.1.11.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.GAL.1.11.008" x-align="GAL.1.11.a008" x-target-ids="t012 t013 t014" x-target="which was preached" x-target-head="t014" x-head="true" lemma="εὐαγγελί