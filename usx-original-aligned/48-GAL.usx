	<para style="p"><verse number="1" style="v" x-ref="GAL.5.1" sid="GAL 5:1" /><char style="w" x-id="SBLGNT.GAL.5.1.001" x-align="GAL.5.1.a001" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="In" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.GAL.5.1.002" x-align="GAL.5.1.a002" x-target-ids="t001 t002" x-target="For freedom" x-target-head="t002" x-head="true" lemma="ἐλευθερία" strong="G1657" x-morph="N-DSF" x-gloss="freedom" x-translit="eleutheriai" xml:lang="grc">ἐλευθερίᾳ</char> <char style="w" x-id="SBLGNT.GAL.5.1.003" x-align="GAL.5.1.a003" x-target-ids="t006" x-target="us" x-target-head="t006" x-head="true" lemma="ἐγώ" strong="G2248" x-morph="P-1AP" x-gloss="us" x-translit="hēmas" xml:lang="grc">ἡμᾶς</char> <char style="w" x-id="SBLGNT.GAL.5.1.004" x-align="GAL.5.1.a004" x-target-ids="t004" x-target="Christ" x-target-head="t004" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-NSM" x-gloss="Christ" x-translit="Christos" xml:lang="grc">Χριστὸς</char> <char style="w" x-id="SBLGNT.GAL.5.1.005" x-align="GAL.5.1.a005" x-target-ids="t003 t005 t007" x-target="did set free" x-target-head="t007" x-head="true" lemma="ἐλευθερόω" strong="G1659" x-morph="V-AAI-3S" x-gloss="has set free" x-translit="ēleutherōsen" xml:lang="grc">ἠλευθέρωσεν</char>·<char style="w" x-id="SBLGNT.GAL.5.1.006" x-align="GAL.5.1.a006" x-target-ids="t008 t009" x-target="stand fast" x-target-head="t008" x-head="true" lemma="στήκω" strong="G4739" x-morph="V-PAM-2P" x-gloss="stand firm" x-translit="stēkete" xml:lang="grc">στήκετε</char> <char style="w" x-id="SBLGNT.GAL.5.1.007" x-align="GAL.5.1.a007" x-target-ids="t010" x-target="therefore" x-target-head="t010" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.GAL.5.1.008" x-align="GAL.5.1.a008" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.5.1.009" x-align="GAL.5.1.a009" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.GAL.5.1.010" x-align="GAL.5.1.a010" x-target-ids="t015" x-target="again" x-target-head="t015" x-head="true" lemma="πάλιν" strong="G3825" x-morph="ADV" x-gloss="again" x-translit="palin" xml:lang="grc">πάλιν</char> <char style="w" x-id="SBLGNT.GAL.5.1.011" x-align="GAL.5.1.a011" x-target-ids="t016 t017 t018" x-target="in a yoke" x-target-head="t018" x-head="true" lemma="ζυγός" strong="G2218" x-morph="N-DSM" x-gloss="in a yoke" x-translit="zygōi" xml:lang="grc">ζυγῷ</char> <char style="w" x-id="SBLGNT.GAL.5.1.012" x-align="GAL.5.1.a012" x-target-ids="t019 t020" x-target="of bondage" x-target-head="t020" x-head="true" lemma="δουλεία" strong="G1397" x-morph="N-GSF" x-gloss="of slavery" x-translit="douleias" xml:lang="grc">δουλείας</char> <char style="w" x-id="SBLGNT.GAL.5.1.013" x-align="GAL.5.1.a013" x-target-ids="t012 t014" x-target="be entangled" x-target-head="t014" x-head="true" lemma="ἐνέχω" strong="G1758" x-morph="V-PPM-2P" x-gloss="entangle yourselves" x-translit="enechesthe" xml:lang="grc">ἐνέχεσθε</char>.<verse eid="GAL 5:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="GAL.5.2" sid="GAL 5:2" /><char style="w" x-id="SBLGNT.GAL.5.2.001" x-align="GAL.5.2.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="ἴδε" strong="G2396" x-morph="V-2AAM-2S" x-gloss="Behold" x-translit="Ide" xml:lang="grc">Ἴδε</char> <char style="w" x-id="SBLGNT.GAL.5.2.002" x-align="GAL.5.2.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="ἐγώ" strong="G1473" x-morph="P-1NS" x-gloss="I" x-translit="egō" xml:lang="grc">ἐγὼ</char> <char style="w" x-id="SBLGNT.GAL.5.2.003" x-align="GAL.5.2.a003" x-target-ids="t003" x-target="Paul" x-target-head="t003" x-head="true" lemma="Παῦλος" strong="G3972" x-morph="N-NSM" x-gloss="Paul" x-translit="Paulos" xml:lang="grc">Παῦλος</char> <char style="w" x-id="SBLGNT.GAL.5.2.004" x-align="GAL.5.2.a004" x-target-ids="t004" x-target="say" x-target-head="t004" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.GAL.5.2.005" x-align="GAL.5.2.a005" x-target-ids="t005 t006" x-target="unto you" x-target-head="t006" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.GAL.5.2.006" x-align="GAL.5.2.a006" x-target-ids="t007" x-target="that" x-target-head="t007" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.GAL.5.2.007" x-align="GAL.5.2.a007" x-target-ids="t008" x-target="if" x-target-head="t008" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.GAL.5.2.008" x-align="GAL.5.2.a008" x-target-ids="t009 t010 t011" x-target="ye receive circumcision" x-target-head="t011" x-head="true" lemma="περιτέμνω" strong="G4059" x-morph="V-PPS-2P" x-gloss="you shall become circumcised" x-translit="peritemnēsthe" xml:lang="grc">περιτέμνησθε</char> <char style="w" x-id="SBLGNT.GAL.5.2.009" x-align="GAL.5.2.a009" x-target-ids="t012" x-target="Christ" x-target-head="t012" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-NSM" x-gloss="Christ" x-translit="Christos" xml:lang="grc">Χριστὸς</char> <char style="w" x-id="SBLGNT.GAL.5.2.010" x-align="GAL.5.2.a011" x-target-ids="t015" x-target="you" x-target-head="t015" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.GAL.5.2.011" x-align="GAL.5.2.a012" x-target-ids="t016" x-target="nothing" x-target-head="t016" x-head="true" lemma="οὐδείς" strong="G3762" x-morph="A-ASN-N" x-gloss="nothing" x-translit="ouden" xml:lang="grc">οὐδὲν</char> <char style="w" x-id="SBLGNT.GAL.5.2.012" x-align="GAL.5.2.a010" x-target-ids="t013 t014" x-target="will profit" x-target-head="t014" x-head="true" lemma="ὠφελέω" strong="G5623" x-morph="V-FAI-3S" x-gloss="will profit" x-translit="ōphelēsei" xml:lang="grc">ὠφελήσει</char>.<verse eid="GAL 5:2" /></para>
	<para style="p"><verse number="3" style="v" x-ref="GAL.5.3" sid="GAL 5:3" /><char style="w" x-id="SBLGNT.GAL.5.3.001" x-align="GAL.5.3.a001" x-target-ids="t002 t003" x-target="I testify" x-target-head="t003" x-head="true" lemma="μαρτύρομαι" strong="G3143" x-morph="V-PNI-1S" x-gloss="I testify" x-translit="martyromai" xml:lang="grc">μαρτύρομαι</char> <char style="w" x-id="SBLGNT.GAL.5.3.002" x-align="GAL.5.3.a002" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.5.3.003" x-align="GAL.5.3.a003" x-target-ids="t004" x-target="again" x-target-head="t004" x-head="true" lemma="πάλιν" strong="G3825" x-morph="ADV" x-gloss="again" x-translit="palin" xml:lang="grc">πάλιν</char> <char style="w" x-id="SBLGNT.GAL.5.3.004" x-align="GAL.5.3.a004" x-target-ids="t006" x-target="every" x-target-head="t006" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-DSM" x-gloss="to every" x-translit="panti" xml:lang="grc">παντὶ</char> <char style="w" x-id="SBLGNT.GAL.5.3.005" x-align="GAL.5.3.a005" x-target-ids="t005 t007" x-target="to man" x-target-head="t007" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-DSM" x-gloss="man" x-translit="anthrōpōi" xml:lang="grc">ἀνθρώπῳ</char> <char style="w" x-id="SBLGNT.GAL.5.3.006" x-align="GAL.5.3.a006" x-target-ids="t008 t009 t010" x-target="that receiveth circumcision" x-target-head="t010" x-head="true" lemma="περιτέμνω" strong="G4059" x-morph="V-PPP-DSM" x-gloss="being circumcised" x-translit="peritemnomenōi" xml:lang="grc">περιτεμνομένῳ</char> <char style="w" x-id="SBLGNT.GAL.5.3.007" x-align="GAL.5.3.a007" x-target-ids="t011" x-target="that" x-target-head="t011" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.GAL.5.3.008" x-align="GAL.5.3.a008" x-target-ids="t014 t015" x-target="a debtor" x-target-