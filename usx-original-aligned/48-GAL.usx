	<para style="p"><verse number="16" style="v" x-ref="GAL.4.16" sid="GAL 4:16" /><char style="w" x-id="SBLGNT.GAL.4.16.001" x-align="GAL.4.16.a001" x-target-ids="t001 t002" x-target="So then" x-target-head="t001" x-head="true" lemma="ὥστε" strong="G5620" x-morph="CONJ" x-gloss="So" x-translit="hōste" xml:lang="grc">ὥστε</char> <char style="w" x-id="SBLGNT.GAL.4.16.002" x-align="GAL.4.16.a004" x-target-ids="t007" x-target="enemy" x-target-head="t007" x-head="true" lemma="ἐχθρός" strong="G2190" x-morph="A-NSM" x-gloss="enemy" x-translit="echthros" xml:lang="grc">ἐχθρὸς</char> <char style="w" x-id="SBLGNT.GAL.4.16.003" x-align="GAL.4.16.a003" x-target-ids="t006" x-target="your" x-target-head="t006" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="of you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char> <char style="w" x-id="SBLGNT.GAL.4.16.004" x-align="GAL.4.16.a002" x-target-ids="t003 t004 t005" x-target="am I become" x-target-head="t005" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2RAI-1S" x-gloss="have I become" x-translit="gegona" xml:lang="grc">γέγονα</char> <char style="w" x-id="SBLGNT.GAL.4.16.005" x-align="GAL.4.16.a005" x-target-ids="t008 t009 t011 t012" x-target="by telling the truth" x-target-head="t012" x-head="true" lemma="ἀληθεύω" strong="G226" x-morph="V-PAP-NSM" x-gloss="speaking truth" x-translit="alētheuōn" xml:lang="grc">ἀληθεύων</char> <char style="w" x-id="SBLGNT.GAL.4.16.006" x-align="GAL.4.16.a006" x-target-ids="t010" x-target="you" x-target-head="t010" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char>;<verse eid="GAL 4:16" /></para>
	<para style="p"><verse number="17" style="v" x-ref="GAL.4.17" sid="GAL 4:17" /><char style="w" x-id="SBLGNT.GAL.4.17.001" x-align="GAL.4.17.a001" x-target-ids="t001 t002 t003" x-target="They zealously seek" x-target-head="t002" x-head="true" lemma="ζηλόω" strong="G2206" x-morph="V-PAI-3P" x-gloss="They are zealous after" x-translit="zēlousin" xml:lang="grc">ζηλοῦσιν</char> <char style="w" x-id="SBLGNT.GAL.4.17.002" x-align="GAL.4.17.a002" x-target-ids="t004" x-target="you" x-target-head="t004" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.GAL.4.17.003" x-align="GAL.4.17.a003" x-target-ids="t006" x-target="no" x-target-head="t006" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.GAL.4.17.004" x-align="GAL.4.17.a004" x-target-ids="t005 t007 t008" x-target="in good way" x-target-head="t007" x-head="true" lemma="καλῶς" strong="G2573" x-morph="ADV" x-gloss="rightly" x-translit="kalōs" xml:lang="grc">καλῶς</char>,<char style="w" x-id="SBLGNT.GAL.4.17.005" x-align="GAL.4.17.a005" x-target-ids="t009" x-target="nay" x-target-head="t009" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.GAL.4.17.006" x-align="GAL.4.17.a006" x-target-ids="t012 t013 t015" x-target="to shut out" x-target-head="t013" x-head="true" lemma="ἐκκλείω" strong="G1576" x-morph="V-AAN" x-gloss="to exclude" x-translit="ekkleisai" xml:lang="grc">ἐκκλεῖσαι</char> <char style="w" x-id="SBLGNT.GAL.4.17.007" x-align="GAL.4.17.a007" x-target-ids="t014" x-target="you" x-target-head="t014" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you [from us]" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.GAL.4.17.008" x-align="GAL.4.17.a008" x-target-ids="t010 t011" x-target="they desire" x-target-head="t011" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-PAI-3P" x-gloss="They desire" x-translit="thelousin" xml:lang="grc">θέλουσιν</char>,<char style="w" x-id="SBLGNT.GAL.4.17.009" x-align="GAL.4.17.a009" x-target-ids="t016" x-target="that" x-target-head="t016" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.GAL.4.17.010" x-align="GAL.4.17.a010" x-target-ids="t020" x-target="them" x-target-head="t020" x-head="true" lemma="ἑαυτοῦ" strong="G848" x-morph="P-APM" x-gloss="them" x-translit="autous" xml:lang="grc">αὐτοὺς</char> <char style="w" x-id="SBLGNT.GAL.4.17.011" x-align="GAL.4.17.a011" x-target-ids="t017 t018 t019" x-target="ye may seek" x-target-head="t019" x-head="true" lemma="ζηλόω" strong="G2206" x-morph="V-PAS-2P" x-gloss="you might be zealous after" x-translit="zēloute" xml:lang="grc">ζηλοῦτε</char>.<verse eid="GAL 4:17" /></para>
	<para style="p"><verse number="18" style="v" x-ref="GAL.4.18" sid="GAL 4:18" /><char style="w" x-id="SBLGNT.GAL.4.18.001" x-align="GAL.4.18.a002" x-target-ids="t002 t003 t004" x-target="it is good" x-target-head="t004" x-head="true" lemma="καλός" strong="G2570" x-morph="A-NSN" x-gloss="Good [it is]" x-translit="kalon" xml:lang="grc">καλὸν</char> <char style="w" x-id="SBLGNT.GAL.4.18.002" x-align="GAL.4.18.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.4.18.003" x-align="GAL.4.18.a003" x-target-ids="t005 t006 t007 t008" x-target="to be zealously sought" x-target-head="t007" x-head="true" lemma="ζηλόω" strong="G2206" x-morph="V-PPN" x-gloss="to be zealous" x-translit="zēlousthai" xml:lang="grc">ζηλοῦσθαι</char> <char style="w" x-id="SBLGNT.GAL.4.18.004" x-align="GAL.4.18.a004" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.GAL.4.18.005" x-align="GAL.4.18.a005" x-target-ids="t010 t011 t012" x-target="a good matter" x-target-head="t011" x-head="true" lemma="καλός" strong="G2570" x-morph="A-DSN" x-gloss="a right [thing]" x-translit="kalōi" xml:lang="grc">καλῷ</char> <char style="w" x-id="SBLGNT.GAL.4.18.006" x-align="GAL.4.18.a006" x-target-ids="t013 t014 t015" x-target="at all times" x-target-head="t015" x-head="true" lemma="πάντοτε" strong="G3842" x-morph="ADV" x-gloss="at all times" x-translit="pantote" xml:lang="grc">πάντοτε</char>,<char style="w" x-id="SBLGNT.GAL.4.18.007" x-align="GAL.4.18.a007" x-target-ids="t016" x-target="and" x-target-head="t016" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.4.18.008" x-align="GAL.4.18.a008" x-target-ids="t017" x-target="not" x-ta