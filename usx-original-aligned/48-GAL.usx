	<para style="p"><verse number="10" style="v" x-ref="GAL.4.10" sid="GAL 4:10" /><char style="w" x-id="SBLGNT.GAL.4.10.001" x-align="GAL.4.10.a001" x-target-ids="t003" x-target="days" x-target-head="t003" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-APF" x-gloss="Days" x-translit="hēmeras" xml:lang="grc">ἡμέρας</char> <char style="w" x-id="SBLGNT.GAL.4.10.002" x-align="GAL.4.10.a002" x-target-ids="t001 t002" x-target="Ye observe" x-target-head="t002" x-head="true" lemma="παρατηρέω" strong="G3906" x-morph="V-PMI-2P" x-gloss="you observe" x-translit="paratēreisthe" xml:lang="grc">παρατηρεῖσθε</char> <char style="w" x-id="SBLGNT.GAL.4.10.003" x-align="GAL.4.10.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.4.10.004" x-align="GAL.4.10.a004" x-target-ids="t005" x-target="months" x-target-head="t005" x-head="true" lemma="μήν" strong="G3376" x-morph="N-APM" x-gloss="months" x-translit="mēnas" xml:lang="grc">μῆνας</char> <char style="w" x-id="SBLGNT.GAL.4.10.005" x-align="GAL.4.10.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.4.10.006" x-align="GAL.4.10.a006" x-target-ids="t007" x-target="seasons" x-target-head="t007" x-head="true" lemma="καιρός" strong="G2540" x-morph="N-APM" x-gloss="seasons" x-translit="kairous" xml:lang="grc">καιροὺς</char> <char style="w" x-id="SBLGNT.GAL.4.10.007" x-align="GAL.4.10.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.4.10.008" x-align="GAL.4.10.a008" x-target-ids="t009" x-target="years" x-target-head="t009" x-head="true" lemma="ἐνιαυτός" strong="G1763" x-mor