	<para style="p"><verse number="1" style="v" x-ref="GAL.2.1" sid="GAL 2:1" /><char style="w" x-id="SBLGNT.GAL.2.1.001" x-align="GAL.2.1.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="ἔπειτα" strong="G1899" x-morph="ADV" x-gloss="Then" x-translit="Epeita" xml:lang="grc">Ἔπειτα</char> <char style="w" x-id="SBLGNT.GAL.2.1.002" x-align="GAL.2.1.a002" x-target-ids="t002 t003 t004 t005" x-target="after the space of" x-target-head="t002" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="after" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.GAL.2.1.003" x-align="GAL.2.1.a003" x-target-ids="t006" x-target="fourteen" x-target-head="t006" x-head="true" lemma="δεκατέσσαρες" strong="G1180" x-morph="A-GPN" x-gloss="fourteen" x-translit="dekatessarōn" xml:lang="grc">δεκατεσσάρων</char> <char style="w" x-id="SBLGNT.GAL.2.1.004" x-align="GAL.2.1.a004" x-target-ids="t007" x-target="years" x-target-head="t007" x-head="true" lemma="ἔτος" strong="G2094" x-morph="N-GPN" x-gloss="years" x-translit="etōn" xml:lang="grc">ἐτῶν</char> <char style="w" x-id="SBLGNT.GAL.2.1.005" x-align="GAL.2.1.a005" x-target-ids="t011" x-target="again" x-target-head="t011" x-head="true" lemma="πάλιν" strong="G3825" x-morph="ADV" x-gloss="again" x-translit="palin" xml:lang="grc">πάλιν</char> <char style="w" x-id="SBLGNT.GAL.2.1.006" x-align="GAL.2.1.a006" x-target-ids="t008 t009 t010" x-target="I went up" x-target-head="t009" x-head="true" lemma="ἀναβαίνω" strong="G305" x-morph="V-2AAI-1S" x-gloss="I went up" x-translit="anebēn" xml:lang="grc">ἀνέβην</char> <char style="w" x-id="SBLGNT.GAL.2.1.007" x-align="GAL.2.1.a007" x-target-ids="t012" x-target="to" x-target-head="t012" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.GAL.2.1.008" x-align="GAL.2.1.a008" x-target-ids="t013" x-target="Jerusalem" x-target-head="t013" x-head="true" lemma="Ἱεροσ