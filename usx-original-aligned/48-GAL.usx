	<para style="p"><verse number="3" style="v" x-ref="GAL.6.3" sid="GAL 6:3" /><char style="w" x-id="SBLGNT.GAL.6.3.001" x-align="GAL.6.3.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.GAL.6.3.002" x-align="GAL.6.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.GAL.6.3.003" x-align="GAL.6.3.a004" x-target-ids="t005" x-target="thinketh" x-target-head="t005" x-head="true" lemma="δοκέω" strong="G1380" x-morph="V-PAI-3S" x-gloss="thinks [himself]" x-translit="dokei" xml:lang="grc">δοκεῖ</char> <char style="w" x-id="SBLGNT.GAL.6.3.004" x-align="GAL.6.3.a003" x-target-ids="t003 t004" x-target="a man" x-target-head="t004" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.GAL.6.3.005" x-align="GAL.6.3.a005" x-target-ids="t006 t007 t008" x-target="himself to be" x-target-head="t008" x-head="true" lemma="εἰμί" strong="G1511" x-morph="V-PAN" x-gloss="to be" x-translit="einai" xml:lang="grc">εἶναί</char> <char style="w" x-id="SBLGNT.GAL.6.3.006" x-align="GAL.6.3.a006" x-target-ids="t009" x-target="something" x-target-head="t009" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSN" x-gloss="something" x-translit="ti" xml:lang="grc">τι</char> <char style="w" x-id="SBLGNT.GAL.6.3.007" x-align="GAL.6.3.a008" x-target-ids="t013" x-target="nothing" x-target-head="t013" x-head="true" lemma="μηδείς" strong="G3367" x-morph="A-NSN-N" x-gloss="nothing" x-translit="mēden" xml:lang="grc">μηδὲν</char> <char style="w" x-id="SBLGNT.GAL.6.3.008" x-align="GAL.6.3.a007" x-target-ids="t010 t011 t012" x-target="when he is" x-target-head="t012" x-head="true" lemma="εἰμί" strong="G5607" x-morph="V-PAP