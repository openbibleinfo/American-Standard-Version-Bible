	<para style="p"><verse number="13" style="v" x-ref="GAL.4.13" sid="GAL 4:13" /><char style="w" x-id="SBLGNT.GAL.4.13.001" x-align="GAL.4.13.a002" x-target-ids="t002 t003" x-target="ye know" x-target-head="t003" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAI-2P" x-gloss="You know" x-translit="oidate" xml:lang="grc">οἴδατε</char> <char style="w" x-id="SBLGNT.GAL.4.13.002" x-align="GAL.4.13.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.4.13.003" x-align="GAL.4.13.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.GAL.4.13.004" x-align="GAL.4.13.a004" x-target-ids="t005 t006" x-target="because of" x-target-head="t005" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="in" x-translit="di" xml:lang="grc">δι</char>ʼ<char style="w" x-id="SBLGNT.GAL.4.13.005" x-align="GAL.4.13.a005" x-target-ids="t007 t008" x-target="an infirmity" x-target-head="t008" x-head="true" lemma="ἀσθένεια" strong="G769" x-morph="N-ASF" x-gloss="weakness" x-translit="astheneian" xml:lang="grc">ἀσθένειαν</char> <char style="w" x-id="SBLGNT.GAL.4.13.006" x-align="GAL.4.13.a006" x-target-ids="t009 t010" x-target="of the" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="of the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.GAL.4.13.007" x-align="GAL.4.13.a007" x-target-ids="t011" x-target="flesh" x-target-head="t011" x-head="true" lemma="σάρξ" strong="G4561" x-morph="N-GSF" x-gloss="flesh" x-translit="sarkos" xml:lang="grc">σαρκὸς</char> <char style="w" x-id="SBLGNT.GAL.4.13.008" x-align="GAL.4.13.a008" x-target-ids="t012 t013 t014 t015" x-target="I preached the gospel" x-target-head="t013" x-head="true" lemma