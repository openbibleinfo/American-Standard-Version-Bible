	<para style="p"><verse number="8" style="v" x-ref="GAL.4.8" sid="GAL 4:8" /><char style="w" x-id="SBLGNT.GAL.4.8.001" x-align="GAL.4.8.a001" x-target-ids="t001" x-target="Howbeit" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="Alla" xml:lang="grc">Ἀλλὰ</char> <char style="w" x-id="SBLGNT.GAL.4.8.002" x-align="GAL.4.8.a002" x-target-ids="t002 t003 t004" x-target="at that time" x-target-head="t004" x-head="true" lemma="τότε" strong="G5119" x-morph="ADV" x-gloss="at that time" x-translit="tote" xml:lang="grc">τότε</char> <char style="w" x-id="SBLGNT.GAL.4.8.003" x-align="GAL.4.8.a003" x-status="unrepresented" x-head="true" lemma="μέν" strong="G3303" x-morph="PRT" x-gloss="indeed" x-translit="men" xml:lang="grc">μὲν</char> <char style="w" x-id="SBLGNT.GAL.4.8.004" x-align="GAL.4.8.a004" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.GAL.4.8.005" x-align="GAL.4.8.a005" x-target-ids="t006" x-target="knowing" x-target-head="t006" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAP-NPM" x-gloss="knowing" x-translit="eidotes" xml:lang="grc">εἰδότες</char> <char style="w" x-id="SBLGNT.GAL.4.8.006" x-align="GAL.4.8.a006" x-target-ids="t007" x-target="God" x-target-head="t007" x-head="true" lemma="θεός" strong="G2316" x-morph="N-ASM" x-gloss="God" x-translit="theon" xml:lang="grc">θεὸν</char> <char style="w" x-id="SBLGNT.GAL.4.8.007" x-align="GAL.4.8.a007" x-target-ids="t008 t009 t010 t011" x-target="ye were in bondage" x-target-head="t011" x-head="true" lemma="δουλεύω" strong="G1398" x-morph="V-AAI-2P" x-gloss="you were enslaved" x-translit="edouleusate" xml:lang="grc">ἐδουλεύσατε</char> <char style="w" x-id="SBLGNT.GAL.4.8.008" x-align="GAL.4.8.a008" x-target-ids="t012 t013" x-target="to them" x-target-head="t013" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM