	<para style="p"><verse number="4" style="v" x-ref="GAL.5.4" sid="GAL 5:4" /><char style="w" x-id="SBLGNT.GAL.5.4.001" x-align="GAL.5.4.a001" x-target-ids="t001 t002 t003" x-target="Ye are severed" x-target-head="t003" x-head="true" lemma="καταργέω" strong="G2673" x-morph="V-API-2P" x-gloss="You are severed" x-translit="katērgēthēte" xml:lang="grc">κατηργήθητε</char> <char style="w" x-id="SBLGNT.GAL.5.4.002" x-align="GAL.5.4.a002" x-target-ids="t004" x-target="from" x-target-head="t004" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="apo" xml:lang="grc">ἀπὸ</char> <char style="w" x-id="SBLGNT.GAL.5.4.003" x-align="GAL.5.4.a003" x-target-ids="t005" x-target="Christ" x-target-head="t005" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-GSM" x-gloss="Christ" x-translit="Christou" xml:lang="grc">Χριστοῦ</char> <char style="w" x-id="SBLGNT.GAL.5.4.004" x-align="GAL.5.4.a004" x-target-ids="t006 t007" x-target="ye who" x-target-head="t007" x-head="true" lemma="ὅστις" strong="G3748" x-morph="R-NPM" x-gloss="whoever" x-translit="hoitines" xml:lang="grc">οἵτινες</char> <char style="w" x-id="SBLGNT.GAL.5.4.005" x-align="GAL.5.4.a005" x-target-ids="t011" x-target="by" x-target-head="t011" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.GAL.5.4.006" x-align="GAL.5.4.a006" x-target-ids="t012 t013" x-target="the law" x-target-head="t013" x-head="true" lemma="νόμος" strong="G3551" x-morph="N-DSM" x-gloss="[the] Law" x-translit="nomōi" xml:lang="grc">νόμῳ</char> <char style="w" x-id="SBLGNT.GAL.5.4.007" x-align="GAL.5.4.a007" x-target-ids="t008 t009 t010" x-target="would be justified" x-target-head="t010" x-head="true" lemma="δικαιόω" strong="G1344" x-morph="V-PPI-2P" x-gloss="are being justified" x-translit="dikaiousthe" xml:lang="grc">δικαιοῦσθε</char>,<char style="w" x-id="SBLGNT.GAL.5.4.008" x-align="GAL.5.4.a008" x-status="unrepresented" x-head="tru