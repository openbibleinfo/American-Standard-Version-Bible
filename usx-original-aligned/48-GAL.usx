	<para style="p"><verse number="12" style="v" x-ref="GAL.4.12" sid="GAL 4:12" /><char style="w" x-id="SBLGNT.GAL.4.12.001" x-align="GAL.4.12.a004" x-target-ids="t005" x-target="become" x-target-head="t005" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-PNM-2P" x-gloss="Become" x-translit="Ginesthe" xml:lang="grc">Γίνεσθε</char> <char style="w" x-id="SBLGNT.GAL.4.12.002" x-align="GAL.4.12.a005" x-target-ids="t006" x-target="as" x-target-head="t006" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.GAL.4.12.003" x-align="GAL.4.12.a006" x-target-ids="t007 t008" x-target="I am" x-target-italic-ids="t008" x-target-head="t007" x-head="true" lemma="ἐγώ" strong="G1473" x-morph="P-1NS" x-gloss="I [am]" x-translit="egō" xml:lang="grc">ἐγώ</char>,<char style="w" x-id="SBLGNT.GAL.4.12.004" x-align="GAL.4.12.a007" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="because" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.GAL.4.12.005" x-align="GAL.4.12.a008" x-target-ids="t010 t011 t012 t013" x-target="I also am become" x-target-italic-ids="t012 t013" x-target-head="t010" x-head="true" lemma="κἀγώ" strong="G2504" x-morph="P-1NS-K" x-gloss="I also [have become]" x-translit="kagō" xml:lang="grc">κἀγὼ</char> <char style="w" x-id="SBLGNT.GAL.4.12.006" x-align="GAL.4.12.a009" x-target-ids="t014" x-target="as" x-target-head="t014" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.GAL.4.12.007" x-align="GAL.4.12.a010" x-target-ids="t015 t016" x-target="ye are" x-target-italic-ids="t016" x-target-head="t015" x-head="true" lemma="σύ" strong="G5210" x-morph="P-2NP" x-gloss="you" x-translit="hymeis" xml:lang="grc">ὑμεῖς</char>,<char style="w" x-id="SBLGNT.GAL.4.12.008" x-align="GAL.4.12.a003" x-target-ids="t004" x-t