	<para style="p"><verse number="15" style="v" x-ref="GAL.3.15" sid="GAL 3:15" /><char style="w" x-id="SBLGNT.GAL.3.15.001" x-align="GAL.3.15.a001" x-target-ids="t001" x-target="Brethren" x-target-head="t001" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="Brothers" x-translit="Adelphoi" xml:lang="grc">Ἀδελφοί</char>,<char style="w" x-id="SBLGNT.GAL.3.15.002" x-align="GAL.3.15.a002" x-target-ids="t004 t005 t006" x-target="after the manner" x-target-head="t004" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="according to" x-translit="kata" xml:lang="grc">κατὰ</char> <char style="w" x-id="SBLGNT.GAL.3.15.003" x-align="GAL.3.15.a003" x-target-ids="t007 t008" x-target="of men" x-target-head="t008" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-ASM" x-gloss="man" x-translit="anthrōpon" xml:lang="grc">ἄνθρωπον</char> <char style="w" x-id="SBLGNT.GAL.3.15.004" x-align="GAL.3.15.a004" x-target-ids="t002 t003" x-target="I speak" x-target-head="t003" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I am speaking" x-translit="legō" xml:lang="grc">λέγω</char>·<char style="w" x-id="SBLGNT.GAL.3.15.005" x-align="GAL.3.15.a005" x-target-ids="t009 t010 t011 t016" x-target="Though it be yet" x-target-head="t016" x-head="true" lemma="ὅμως" strong="G3676" x-morph="CONJ" x-gloss="Even" x-translit="homōs" xml:lang="grc">ὅμως</char> <char style="w" x-id="SBLGNT.GAL.3.15.006" x-align="GAL.3.15.a006" x-target-ids="t012 t013 t014" x-target="but a man’s" x-target-head="t014" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-GSM" x-gloss="of man" x-translit="anthrōpou" xml:lang="grc">ἀνθρώπου</char> <char style="w" x-id="SBLGNT.GAL.3.15.007" x-align="GAL.3.15.a007" x-target-ids="t017 t018 t019 t020 t021" x-target="when it hath been confirmed" x-target-head="t021" x-head="true" lemma="κυρόω" strong="G2964" x-morph="V-RPP-ASF" x-gloss="having been ratified" x-translit="kekyrōmenēn" xml:lang="grc">κεκυρωμένην</char> <char s