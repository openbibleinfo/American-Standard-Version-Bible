	<para style="p"><verse number="4" style="v" x-ref="GAL.2.4" sid="GAL 2:4" /><char style="w" x-id="SBLGNT.GAL.2.4.001" x-align="GAL.2.4.a001" x-target-ids="t003 t004" x-target="because of" x-target-head="t003" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="because of" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.GAL.2.4.002" x-align="GAL.2.4.a002" x-target-ids="t001 t002" x-target="and that" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="even" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.2.4.003" x-align="GAL.2.4.a003" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="the" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.GAL.2.4.004" x-align="GAL.2.4.a004" x-target-ids="t008 t009 t010" x-target="privily brought in" x-target-head="t009" x-head="true" lemma="παρείσακτος" strong="G3920" x-morph="A-APM" x-gloss="brought in secretly" x-translit="pareisaktous" xml:lang="grc">παρεισάκτους</char> <char style="w" x-id="SBLGNT.GAL.2.4.005" x-align="GAL.2.4.a005" x-target-ids="t006 t007" x-target="false brethren" x-target-head="t007" x-head="true" lemma="ψευδάδελφος" strong="G5569" x-morph="N-APM" x-gloss="false brothers" x-translit="pseudadelphous" xml:lang="grc">ψευδαδέλφους</char>,<char style="w" x-id="SBLGNT.GAL.2.4.006" x-align="GAL.2.4.a006" x-target-ids="t011" x-target="who" x-target-head="t011" x-head="true" lemma="ὅστις" strong="G3748" x-morph="R-NPM" x-gloss="who" x-translit="hoitines" xml:lang="grc">οἵτινες</char> <char style="w" x-id="SBLGNT.GAL.2.4.007" x-align="GAL.2.4.a007" x-target-ids="t012 t013 t014" x-target="came in privily" x-target-head="t012" x-head="true" lemma="παρεισέρχομαι" strong="G3922" x-morph="V-2AAI-3P" x-gloss="came in by stealth" x-translit="pareisēlthon" xml:lang="grc">παρεισῆλθον</char> <char style="w" x-id="SBLGNT.GAL.2.4.008" x-align="G