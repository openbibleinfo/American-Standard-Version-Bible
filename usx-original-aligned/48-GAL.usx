	<para style="p"><verse number="20" style="v" x-ref="GAL.4.20" sid="GAL 4:20" /><char style="w" x-id="SBLGNT.GAL.4.20.001" x-align="GAL.4.20.a002" x-target-ids="t002 t003 t004" x-target="I could wish" x-target-head="t004" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-IAI-1S" x-gloss="I was wishing" x-translit="ēthelon" xml:lang="grc">ἤθελον</char> <char style="w" x-id="SBLGNT.GAL.4.20.002" x-align="GAL.4.20.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="indeed" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.4.20.003" x-align="GAL.4.20.a003" x-target-ids="t005 t006 t007" x-target="to be present" x-target-head="t007" x-head="true" lemma="πάρειμι" strong="G3918" x-morph="V-PAN" x-gloss="to be present" x-translit="pareinai" xml:lang="grc">παρεῖναι</char> <char style="w" x-id="SBLGNT.GAL.4.20.004" x-align="GAL.4.20.a004" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="with" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.GAL.4.20.005" x-align="GAL.4.20.a005" x-target-ids="t009" x-target="you" x-target-head="t009" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.GAL.4.20.006" x-align="GAL.4.20.a006" x-target-ids="t010" x-target="now" x-target-head="t010" x-head="true" lemma="ἄρτι" strong="G737" x-morph="ADV" x-gloss="presently" x-translit="arti" xml:lang="grc">ἄρτι</char>,<char style="w" x-id="SBLGNT.GAL.4.20.007" x-align="GAL.4.20.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.4.20.008" x-align="GAL.4.20.a008" x-target-ids="t012 t013" x-target="to change" x-target-head="t013" x-head="true" lemma="ἀλλάσσω" str