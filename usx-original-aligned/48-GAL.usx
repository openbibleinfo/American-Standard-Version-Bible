	<para style="p"><verse number="5" style="v" x-ref="GAL.5.5" sid="GAL 5:5" /><char style="w" x-id="SBLGNT.GAL.5.5.001" x-align="GAL.5.5.a002" x-target-ids="t002" x-target="we" x-target-head="t002" x-head="true" lemma="ἐγώ" strong="G2249" x-morph="P-1NP" x-gloss="We" x-translit="hēmeis" xml:lang="grc">ἡμεῖς</char> <char style="w" x-id="SBLGNT.GAL.5.5.002" x-align="GAL.5.5.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.GAL.5.5.003" x-align="GAL.5.5.a003" x-target-ids="t003 t004 t005" x-target="through the Spirit" x-target-head="t005" x-head="true" lemma="πνεῦμα" strong="G4151" x-morph="N-DSN" x-gloss="through [the] Spirit" x-translit="pneumati" xml:lang="grc">πνεύματι</char> <char style="w" x-id="SBLGNT.GAL.5.5.004" x-align="GAL.5.5.a004" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="by" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.GAL.5.5.005" x-align="GAL.5.5.a005" x-target-ids="t007" x-target="faith" x-target-head="t007" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-GSF" x-gloss="faith" x-translit="pisteōs" xml:lang="grc">πίστεως</char> <char style="w" x-id="SBLGNT.GAL.5.5.006" x-align="GAL.5.5.a007" x-target-ids="t010 t011" x-target="the hope" x-target-head="t011" x-head="true" lemma="ἐλπίς" strong="G1680" x-morph="N-ASF" x-gloss="[the] hope" x-translit="elpida" xml:lang="grc">ἐλπίδα</char> <char style="w" x-id="SBLGNT.GAL.5.5.007" x-align="GAL.5.5.a008" x-target-ids="t012 t013" x-target="of righteousness" x-target-head="t013" x-head="true" lemma="δικαιοσύνη" strong="G1343" x-morph="N-GSF" x-gloss="of righteousness" x-translit="dikaiosynēs" xml:lang="grc">δικαιοσύνης</char> <char style="w" x-id="SBLGNT.GAL.5.5.008" x-align="GAL.5.5.a006" x-target-ids="t008 t009" x-target="wait for" x-target-head="t008" x-