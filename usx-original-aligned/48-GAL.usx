	<para style="p"><verse number="3" style="v" x-ref="GAL.3.3" sid="GAL 3:3" /><char style="w" x-id="SBLGNT.GAL.3.3.001" x-align="GAL.3.3.a001" x-target-ids="t003" x-target="so" x-target-head="t003" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="So" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.GAL.3.3.002" x-align="GAL.3.3.a002" x-target-ids="t004" x-target="foolish" x-target-head="t004" x-head="true" lemma="ἀνόητος" strong="G453" x-morph="A-NPM" x-gloss="foolish" x-translit="anoētoi" xml:lang="grc">ἀνόητοί</char> <char style="w" x-id="SBLGNT.GAL.3.3.003" x-align="GAL.3.3.a003" x-target-ids="t001 t002" x-target="Are ye" x-target-head="t001" x-head="true" lemma="εἰμί" strong="G2075" x-morph="V-PAI-2P" x-gloss="are you" x-translit="este" xml:lang="grc">ἐστε</char>;<char style="w" x-id="SBLGNT.GAL.3.3.004" x-align="GAL.3.3.a004" x-target-ids="t005 t006" x-target="having begun" x-target-head="t006" x-head="true" lemma="ἐνάρχομαι" strong="G1728" x-morph="V-ADP-NPM" x-gloss="Having begun" x-translit="enarxamenoi" xml:lang="grc">ἐναρξάμενοι</char> <char style="w" x-id="SBLGNT.GAL.3.3.005" x-align="GAL.3.3.a005" x-target-ids="t007 t008 t009" x-target="in the Spirit" x-target-head="t009" x-head="true" lemma="πνεῦμα" strong="G4151" x-morph="N-DSN" x-gloss="in [the] Spirit" x-translit="pneumati" xml:lang="grc">πνεύματι</char> <char style="w" x-id="SBLGNT.GAL.3.3.006" x-align="GAL.3.3.a006" x-target-ids="t012" x-target="now" x-target-head="t012" x-head="true" lemma="νῦν" strong="G3568" x-morph="ADV" x-gloss="now" x-translit="nyn" xml:lang="grc">νῦν</char> <char style="w" x-id="SBLGNT.GAL.3.3.007" x-align="GAL.3.3.a007" x-target-ids="t014 t015 t016" x-target="in the flesh" x-target-head="t016" x-head="true" lemma="σάρξ" strong="G4561" x-morph="N-DSF" x-gloss="in [the] flesh" x-translit="sarki" xml:lang="grc">σαρκὶ</char> <char style="w" x-id="SBLGNT.GAL.3.3.008" x-align="GAL.3.3.a008" x-target-ids="t010 t011 t013" x-target="are 