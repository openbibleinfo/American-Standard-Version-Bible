	<para style="p"><verse number="1" style="v" x-ref="GAL.3.1" sid="GAL 3:1" /><char style="w" x-id="SBLGNT.GAL.3.1.001" x-align="GAL.3.1.a001" x-target-ids="t001" x-target="O" x-target-head="t001" x-head="true" lemma="ὦ" strong="G5599" x-morph="INJ" x-gloss="O" x-translit="Ō" xml:lang="grc">Ὦ</char> <char style="w" x-id="SBLGNT.GAL.3.1.002" x-align="GAL.3.1.a002" x-target-ids="t002" x-target="foolish" x-target-head="t002" x-head="true" lemma="ἀνόητος" strong="G453" x-morph="A-VPM" x-gloss="foolish" x-translit="anoētoi" xml:lang="grc">ἀνόητοι</char> <char style="w" x-id="SBLGNT.GAL.3.1.003" x-align="GAL.3.1.a003" x-target-ids="t003" x-target="Galatians" x-target-head="t003" x-head="true" lemma="Γαλάτης" strong="G1052" x-morph="N-VPM" x-gloss="Galatians" x-translit="Galatai" xml:lang="grc">Γαλάται</char>,<char style="w" x-id="SBLGNT.GAL.3.1.004" x-align="GAL.3.1.a004" x-target-ids="t004" x-target="who" x-target-head="t004" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSM" x-gloss="Who" x-translit="tis" xml:lang="grc">τίς</char> <char style="w" x-id="SBLGNT.GAL.3.1.005" x-align="GAL.3.1.a006" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.GAL.3.1.006" x-align="GAL.3.1.a005" x-target-ids="t005 t006" x-target="did bewitch" x-target-head="t006" x-head="true" lemma="βασκαίνω" strong="G940" x-morph="V-AAI-3S" x-gloss="has bewitched" x-translit="ebaskanen" xml:lang="grc">ἐβάσκανεν</char>,<char style="w" x-id="SBLGNT.GAL.3.1.007" x-align="GAL.3.1.a008" x-target-ids="t009" x-target="whose" x-target-head="t009" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-DPM" x-gloss="whose" x-translit="hois" xml:lang="grc">οἷς</char> <char style="w" x-id="SBLGNT.GAL.3.1.008" x-align="GAL.3.1.a007" x-target-ids="t008" x-target="before" x-target-head="t008" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="before" x