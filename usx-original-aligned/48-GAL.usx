	<para style="p"><verse number="19" style="v" x-ref="GAL.4.19" sid="GAL 4:19" /><char style="w" x-id="SBLGNT.GAL.4.19.v011.r01.001" x-align="GAL.4.19.a001" x-target-ids="t002 t003" x-target="little children" x-target-head="t003" x-head="true" x-translit="teknia" xml:lang="grc">τεκνία</char> <char style="w" x-id="SBLGNT.GAL.4.19.002" x-align="GAL.4.19.a002" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of me" x-translit="mou" xml:lang="grc">μου</char>,<char style="w" x-id="SBLGNT.GAL.4.19.003" x-align="GAL.4.19.a003" x-target-ids="t004 t005" x-target="of whom" x-target-head="t005" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-APM" x-gloss="of whom" x-translit="hous" xml:lang="grc">οὓς</char> <char style="w" x-id="SBLGNT.GAL.4.19.004" x-align="GAL.4.19.a004" x-target-ids="t008" x-target="again" x-target-head="t008" x-head="true" lemma="πάλιν" strong="G3825" x-morph="ADV" x-gloss="again" x-translit="palin" xml:lang="grc">πάλιν</char> <char style="w" x-id="SBLGNT.GAL.4.19.005" x-align="GAL.4.19.a005" x-target-ids="t006 t007 t009 t010" x-target="I am in travail" x-target-head="t010" x-head="true" lemma="ὠδίνω" strong="G5605" x-morph="V-PAI-1S" x-gloss="I travail" x-translit="ōdinō" xml:lang="grc">ὠδίνω</char> <char style="w" x-id="SBLGNT.GAL.4.19.006" x-align="GAL.4.19.a006" x-target-ids="t011" x-target="until" x-target-head="t011" x-head="true" lemma="μέχρι(ς)" strong="G3360" x-morph="ADV" x-gloss="until" x-translit="mechris" xml:lang="grc">μέχρις</char> <char style="w" x-id="SBLGNT.GAL.4.19.007" x-align="GAL.4.19.a007" x-status="unrepresented" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-GSM" x-gloss="that" x-translit="hou" xml:lang="grc">οὗ</char> <char style="w" x-id="SBLGNT.GAL.4.19.008" x-align="GAL.4.19.a008" x-target-ids="t013 t014" x-target="be formed" x-target-head="t014" x-head="true" lemma="μορφόω" strong="G3445" x-morph="V-APS-3S" x-gloss="shall have been formed" x-translit