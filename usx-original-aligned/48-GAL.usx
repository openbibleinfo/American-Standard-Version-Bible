	<para style="p"><verse number="2" style="v" x-ref="GAL.1.2" sid="GAL 1:2" /><char style="w" x-id="SBLGNT.GAL.1.2.001" x-align="GAL.1.2.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.1.2.002" x-align="GAL.1.2.a002" x-target-ids="t003 t005" x-target="the that" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.GAL.1.2.003" x-align="GAL.1.2.a003" x-target-ids="t006 t007" x-target="are with" x-target-head="t007" x-head="true" lemma="σύν" strong="G4862" x-morph="PREP" x-gloss="with" x-translit="syn" xml:lang="grc">σὺν</char> <char style="w" x-id="SBLGNT.GAL.1.2.004" x-align="GAL.1.2.a004" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="ἐγώ" strong="G1698" x-morph="P-1DS" x-gloss="me" x-translit="emoi" xml:lang="grc">ἐμοὶ</char> <char style="w" x-id="SBLGNT.GAL.1.2.005" x-align="GAL.1.2.a005" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NPM" x-gloss="all" x-translit="pantes" xml:lang="grc">πάντες</char> <char style="w" x-id="SBLGNT.GAL.1.2.006" x-align="GAL.1.2.a006" x-target-ids="t004" x-target="brethren" x-target-head="t004" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-NPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char>,<char style="w" x-id="SBLGNT.GAL.1.2.007" x-align="GAL.1.2.a007" x-target-ids="t009 t010" x-target="unto the" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPF" x-gloss="To the" x-translit="tais" xml:lang="grc">ταῖς</char> <char style="w" x-id="SBLGNT.GAL.1.2.008" x-align="GAL.1.2.a008" x-target-ids="t011" x-target="churches" x-target-head="t011" x-head="true" lemma="ἐκκλησία" strong="G1577" x-morph="N-DPF" x-gloss="churches" x-translit="ekk