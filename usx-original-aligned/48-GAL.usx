	<para style="p"><verse number="4" style="v" x-ref="GAL.3.4" sid="GAL 3:4" /><char style="w" x-id="SBLGNT.GAL.3.4.001" x-align="GAL.3.4.a001" x-target-ids="t004 t005 t006" x-target="so many things" x-target-head="t005" x-head="true" lemma="τοσοῦτος" strong="G5118" x-morph="D-APN" x-gloss="So many things" x-translit="tosauta" xml:lang="grc">τοσαῦτα</char> <char style="w" x-id="SBLGNT.GAL.3.4.002" x-align="GAL.3.4.a002" x-target-ids="t001 t002 t003" x-target="Did ye suffer" x-target-head="t003" x-head="true" lemma="πάσχω" strong="G3958" x-morph="V-2AAI-2P" x-gloss="did you suffer" x-translit="epathete" xml:lang="grc">ἐπάθετε</char> <char style="w" x-id="SBLGNT.GAL.3.4.003" x-align="GAL.3.4.a003" x-target-ids="t007 t008" x-target="in vain" x-target-head="t008" x-head="true" lemma="εἰκῇ" strong="G1500" x-morph="ADV" x-gloss="in vain" x-translit="eikēi" xml:lang="grc">εἰκῇ</char>;<char style="w" x-id="SBLGNT.GAL.3.4.004" x-align="GAL.3.4.a004" x-target-ids="t009" x-target="if" x-target-head="t009" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἴ</char> <char style="w" x-id="SBLGNT.GAL.3.4.005" x-align="GAL.3.4.a005" x-target-ids="t012" x-target="indeed" x-target-head="t012" x-head="true" lemma="γέ" strong="G1065" x-morph="PRT" x-gloss="indeed" x-translit="ge" xml:lang="grc">γε</char> <char style="w" x-id="SBLGNT.GAL.3.4.006" x-align="GAL.3.4.a006" x-status="unrepresented" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.3.4.007" x-align="GAL.3.4.a007" x-target-ids="t010 t011 t013 t014" x-target="it be in vain" x-target-head="t014" x-head="true" lemma="εἰκῇ" strong="G1500" x-morph="ADV" x-gloss="in vain" x-translit="eikēi" xml:lang="grc">εἰκῇ</char>.<verse eid="GAL 3:4" /></para>
	<para style="p"><verse number="5" style="v" x-ref="GAL.3.5" sid="GAL 3:5" /><char style="w" x-id="SBLGNT.GAL.3.5.001" x-align="GAL.3.5.a001" x-target-ids="t001 t015" x-target="He he" x-target-italic-ids="t015" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="The [One]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.GAL.3.5.002" x-align="GAL.3.5.a002" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.GAL.3.5.003" x-align="GAL.3.5.a003" x-target-ids="t003 t004" x-target="that supplieth" x-target-head="t004" x-head="true" lemma="ἐπιχορηγέω" strong="G2023" x-morph="V-PAP-NSM" x-gloss="supplying" x-translit="epichorēgōn" xml:lang="grc">ἐπιχορηγῶν</char> <char style="w" x-id="SBLGNT.GAL.3.5.004" x-align="GAL.3.5.a004" x-target-ids="t005 t006" x-target="to you" x-target-head="t006" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.GAL.3.5.005" x-align="GAL.3.5.a005" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.GAL.3.5.006" x-align="GAL.3.5.a006" x-target-ids="t008" x-target="Spirit" x-target-head="t008" x-head="true" lemma="πνεῦμα" strong="G4151" x-morph="N-ASN" x-gloss="Spirit" x-translit="pneuma" xml:lang="grc">πνεῦμα</char> <char style="w" x-id="SBLGNT.GAL.3.5.007" x-align="GAL.3.5.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.GAL.3.5.008" x-align="GAL.3.5.a008" x-target-ids="t010" x-target="worketh" x-target-head="t010" x-head="true" lemma="ἐνεργέω" strong