	<para style="p"><verse number="31" style="v" x-ref="GAL.4.31" sid="GAL 4:31" /><char style="w" x-id="SBLGNT.GAL.4.31.001" x-align="GAL.4.31.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="διό" strong="G1352" x-morph="CONJ" x-gloss="So then" x-translit="dio" xml:lang="grc">διό</char>,<char style="w" x-id="SBLGNT.GAL.4.31.002" x-align="GAL.4.31.a002" x-target-ids="t002" x-target="brethren" x-target-head="t002" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM" x-gloss="brothers" x-translit="adelphoi" xml:lang="grc">ἀδελφοί</char>,<char style="w" x-id="SBLGNT.GAL.4.31.003" x-align="GAL.4.31.a003" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.GAL.4.31.004" x-align="GAL.4.31.a004" x-target-ids="t003 t004" x-target="we are" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2070" x-morph="V-PAI-1P" x-gloss="we are" x-translit="esmen" xml:lang="grc">ἐσμὲν</char> <char style="w" x-id="SBLGNT.GAL.4.31.005" x-align="GAL.4.31.a006" x-target-ids="t007 t008 t009" x-target="of a handmaid" x-target-head="t009" x-head="true" lemma="παιδίσκη" strong="G3814" x-morph="N-GSF" x-gloss="of [the] slave woman" x-translit="paidiskēs" xml:lang="grc">παιδίσκης</char> <char style="w" x-id="SBLGNT.GAL.4.31.006" x-align="GAL.4.31.a005" x-target-ids="t006" x-target="children" x-target-head="t006" x-head="true" lemma="τέκνον" strong="G5043" x-morph="N-NPN" x-gloss="children" x-translit="tekna" xml:lang="grc">τέκνα</char> <char style="w" x-id="SBLGNT.GAL.4.31.007" x-align="GAL.4.31.a007" x-target-ids="t010" x-target="but" x-target-head="t010" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.GAL.4.31.008" x-align="GAL.4.31.a008" x-target-ids="t011 t012" x-target="of the" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="of the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.GAL.4.31.009" x-align="GAL.4.31.a009" x-target-ids="t013" x-target="freewoman" x-target-head="t013" x-head="true" lemma="ἐλεύθερος" strong="G1658" x-morph="A-GSF" x-gloss="free" x-translit="eleutheras" xml:lang="grc">ἐλευθέρας</char>.<verse eid="GAL 4:31" /></para>
	<chapter eid="GAL 4" />
