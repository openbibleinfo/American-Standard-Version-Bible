	<para style="p"><verse number="7" style="v" x-ref="GAL.4.7" sid="GAL 4:7" /><char style="w" x-id="SBLGNT.GAL.4.7.001" x-align="GAL.4.7.a001" x-target-ids="t001 t002" x-target="So that" x-target-head="t001" x-head="true" lemma="ὥστε" strong="G5620" x-morph="CONJ" x-gloss="So" x-translit="hōste" xml:lang="grc">ὥστε</char> <char style="w" x-id="SBLGNT.GAL.4.7.002" x-align="GAL.4.7.a002" x-target-ids="t005 t006" x-target="no longer" x-target-head="t006" x-head="true" lemma="οὐκέτι" strong="G3765" x-morph="ADV-N" x-gloss="no longer" x-translit="ouketi" xml:lang="grc">οὐκέτι</char> <char style="w" x-id="SBLGNT.GAL.4.7.003" x-align="GAL.4.7.a003" x-target-ids="t003 t004" x-target="thou art" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G1488" x-morph="V-PAI-2S" x-gloss="you are" x-translit="ei" xml:lang="grc">εἶ</char> <char style="w" x-id="SBLGNT.GAL.4.7.004" x-align="GAL.4.7.a004" x-target-ids="t007 t008" x-target="a bondservant" x-target-head="t008" x-head="true" lemma="δοῦλος" strong="G1401" x-morph="N-NSM" x-gloss="a slave" x-translit="doulos" xml:lang="grc">δοῦλος</char> <char style="w" x-id="SBLGNT.GAL.4.7.005" x-align="GAL.4.7.a005" x-target-ids="t009" x-target="but" x-target-head="t009" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.GAL.4.7.006" x-align="GAL.4.7.a006" x-target-ids="t010 t011" x-target="a son" x-target-head="t011" x-head="true" lemma="υἱός" strong="G5207" x-morph="N-NSM" x-gloss="a son" x-translit="huios" xml:lang="grc">υἱός</char>·<char style="w" x-id="SBLGNT.GAL.4.7.007" x-align="GAL.4.7.a007" x-target-ids="t013" x-target="if" x-target-head="t013" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.GAL.4.7.008" x-align="GAL.4.7.a008" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now"