	<para style="p"><verse number="9" style="v" x-ref="GAL.4.9" sid="GAL 4:9" /><char style="w" x-id="SBLGNT.GAL.4.9.001" x-align="GAL.4.9.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="νῦν" strong="G3568" x-morph="ADV" x-gloss="now" x-translit="nyn" xml:lang="grc">νῦν</char> <char style="w" x-id="SBLGNT.GAL.4.9.002" x-align="GAL.4.9.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.4.9.003" x-align="GAL.4.9.a003" x-target-ids="t003 t004 t005 t006 t007 t008" x-target="that ye have come to know" x-target-head="t008" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-2AAP-NPM" x-gloss="having known" x-translit="gnontes" xml:lang="grc">γνόντες</char> <char style="w" x-id="SBLGNT.GAL.4.9.004" x-align="GAL.4.9.a004" x-target-ids="t009" x-target="God" x-target-head="t009" x-head="true" lemma="θεός" strong="G2316" x-morph="N-ASM" x-gloss="God" x-translit="theon" xml:lang="grc">θεόν</char>,<char style="w" x-id="SBLGNT.GAL.4.9.005" x-align="GAL.4.9.a006" x-target-ids="t011" x-target="rather" x-target-head="t011" x-head="true" lemma="μᾶλλον" strong="G3123" x-morph="ADV" x-gloss="rather" x-translit="mallon" xml:lang="grc">μᾶλλον</char> <char style="w" x-id="SBLGNT.GAL.4.9.006" x-align="GAL.4.9.a005" x-target-ids="t010" x-target="or" x-target-head="t010" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.GAL.4.9.007" x-align="GAL.4.9.a007" x-target-ids="t012 t013 t014" x-target="to be known" x-target-head="t014" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-APP-NPM" x-gloss="having been known" x-translit="gnōsthentes" xml:lang="grc">γνωσθέντες</char> <char style="w" x-id="SBLGNT.GAL.4.9.008" x-align="GAL.4.9.a008" x-target-ids="t015" x-target="by" x-target-head="t015" x-head="true" le