	<para style="p"><verse number="5" style="v" x-ref="GAL.2.5" sid="GAL 2:5" /><char style="w" x-id="SBLGNT.GAL.2.5.001" x-align="GAL.2.5.a001" x-target-ids="t001 t002" x-target="to whom" x-target-head="t002" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-DPM" x-gloss="to whom" x-translit="hois" xml:lang="grc">οἷς</char> <char style="w" x-id="SBLGNT.GAL.2.5.002" x-align="GAL.2.5.a005" x-target-ids="t011 t012" x-target="no not" x-target-head="t012" x-head="true" lemma="οὐδέ" strong="G3761" x-morph="CONJ-N" x-gloss="not even" x-translit="oude" xml:lang="grc">οὐδὲ</char> <char style="w" x-id="SBLGNT.GAL.2.5.003" x-align="GAL.2.5.a006" x-target-ids="t013" x-target="for" x-target-head="t013" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="for" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.GAL.2.5.004" x-align="GAL.2.5.a007" x-target-ids="t014 t015" x-target="an hour" x-target-head="t015" x-head="true" lemma="ὥρα" strong="G5610" x-morph="N-ASF" x-gloss="an hour" x-translit="hōran" xml:lang="grc">ὥραν</char> <char style="w" x-id="SBLGNT.GAL.2.5.005" x-align="GAL.2.5.a002" x-target-ids="t003 t004 t005" x-target="we gave place" x-target-head="t005" x-head="true" lemma="εἴκω" strong="G1502" x-morph="V-AAI-1P" x-gloss="did we yield" x-translit="eixamen" xml:lang="grc">εἴξαμεν</char> <char style="w" x-id="SBLGNT.GAL.2.5.006" x-align="GAL.2.5.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="-" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.GAL.2.5.007" x-align="GAL.2.5.a004" x-target-ids="t006 t007 t008 t009 t010" x-target="in the way of subjection" x-target-head="t010" x-head="true" lemma="ὑποταγή" strong="G5292" x-morph="N-DSF" x-gloss="in subjection" x-translit="hypotagēi" xml:lang="grc">ὑποταγῇ</char>,<char style="w" x-id="SBLGNT.GAL.2.5.008" x-align="GAL.2.5.a008" x-target-ids="t016" x-target="that" x-target-head="t016" x-head="true" lemma="ἵνα" strong="G244