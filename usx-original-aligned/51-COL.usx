	<para style="p"><verse number="18" style="v" x-ref="COL.4.18" sid="COL 4:18" /><char style="w" x-id="SBLGNT.COL.4.18.001" x-align="COL.4.18.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="The" x-translit="Ho" xml:lang="grc">Ὁ</char> <char style="w" x-id="SBLGNT.COL.4.18.002" x-align="COL.4.18.a002" x-target-ids="t002" x-target="salutation" x-target-head="t002" x-head="true" lemma="ἀσπασμός" strong="G783" x-morph="N-NSM" x-gloss="greeting" x-translit="aspasmos" xml:lang="grc">ἀσπασμὸς</char> <char style="w" x-id="SBLGNT.COL.4.18.003" x-align="COL.4.18.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="[is] in the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.COL.4.18.004" x-align="COL.4.18.a004" x-target-ids="t007 t008" x-target="mine own" x-target-head="t007" x-head="true" lemma="ἐμός" strong="G1699" x-morph="S-1SDSF" x-gloss="own" x-translit="emēi" xml:lang="grc">ἐμῇ</char> <char style="w" x-id="SBLGNT.COL.4.18.005" x-align="COL.4.18.a005" x-target-ids="t006 t009" x-target="with hand" x-target-head="t009" x-head="true" lemma="χείρ" strong="G5495" x-morph="N-DSF" x-gloss="hand" x-translit="cheiri" xml:lang="grc">χειρὶ</char> <char style="w" x-id="SBLGNT.COL.4.18.006" x-align="COL.4.18.a006" x-target-ids="t003 t004 t005" x-target="of me Paul" x-target-head="t005" x-head="true" lemma="Παῦλος" strong="G3972" x-morph="N-GSM" x-gloss="Paul" x-translit="Paulou" xml:lang="grc">Παύλου</char>.<char style="w" x-id="SBLGNT.COL.4.18.007" x-align="COL.4.18.a007" x-target-ids="t010" x-target="Remember" x-target-head="t010" x-head="true" lemma="μνημονεύω" strong="G3421" x-morph="V-PAM-2P" x-gloss="Remember" x-translit="mnēmoneuete" xml:lang="grc">μνημονεύετέ</char> <char style="w" x-id="SBLGNT.COL.4.18.008" x-align="COL.4.18.a008" x-target-ids="t011" x-target="my" x-target-head="t011" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="