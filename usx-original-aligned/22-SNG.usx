	<para style="p"><verse number="1" style="v" x-ref="SNG.1.1" sid="SNG 1:1" /><char style="w" x-id="WLC.SNG.1.1.001" x-align="SNG.1.1.a002" x-target-ids="t002" x-target="Song" x-target-head="t002" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsc" x-gloss="the.song" x-translit="šiyr" xml:lang="hbo">שִׁ֥יר</char> <char style="w" x-id="WLC.SNG.1.1.002" x-align="SNG.1.1.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.SNG.1.1.003" x-align="SNG.1.1.a003" x-target-ids="t003 t004" x-target="of songs" x-target-head="t004" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbpa" x-gloss="the.songs" x-translit="ššîriym" xml:lang="hbo">שִּׁירִ֖ים</char> <char style="w" x-id="WLC.SNG.1.1.004" x-align="SNG.1.1.a004" x-target-ids="t005" x-target="which" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֥ר</char> <char style="w" x-id="WLC.SNG.1.1.005" x-align="SNG.1.1.a005" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].of" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.SNG.1.1.006" x-align="SNG.1.1.a005" x-target-ids="t006 t007" x-target="is Solomon’s" x-target-head="t007" x-head="true" lemma="שְׁלֹמֹה" strong="H8010" x-morph="Np" x-gloss="Solomon" x-translit="šəlōmōh:" xml:lang="hbo">שְׁלֹמֹֽה</char>׃<verse eid="SNG 1:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="SNG.1.2" sid="SNG 1:2" /><char style="w" x-id="WLC.SNG.1.2.001" x-align="SNG.1.2.a001" x-target-ids="t001 t002 t003" x-target="Let him kiss" x-target-head="t003" x-head="true" lemma="נָשַׁק" strong="H5401" x-morph="Vqi3ms" x-gloss="let" x-translit="yiššāq" xml:lang="hbo">יִשָּׁקֵ֨</char><char style="w" x-id="WLC.SNG.1.2.002" x-align="SNG.1.2.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="him.kiss.me" x-translit="ēniy" xml:lang="hbo">נִי֙</char> <char style="w" x-id="WLC.SNG.1.2.003" x-align="SNG.1.2.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.SNG.1.2.004" x-align="SNG.1.2.a004" x-target-ids="t006 t007" x-target="the kisses" x-target-head="t007" x-head="true" lemma="נְשִׁיקָה" strong="H5390" x-morph="Ncfpc" x-gloss="the.kisses" x-translit="nnəšîqôṯ" xml:lang="hbo">נְּשִׁיק֣וֹת</char> <char style="w" x-id="WLC.SNG.1.2.005" x-align="SNG.1.2.a005" x-target-ids="t008 t010" x-target="of mouth" x-target-head="t010" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="his.mouth" x-translit="piy" xml:lang="hbo">פִּ֔י</char><char style="w" x-id="WLC.SNG.1.2.006" x-align="SNG.1.2.a006" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.SNG.1.2.007" x-align="SNG.1.2.a007" x-target-ids="t011" x-target="For" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.SNG.1.2.008" x-align="SNG.1.2.a010" x-target-ids="t014 t015" x-target="is better" x-target-head="t015" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aampa" x-gloss="[are].g