	<para style="p"><verse number="4" style="v" x-ref="SNG.1.4" sid="SNG 1:4" /><char style="w" x-id="WLC.SNG.1.4.001" x-align="SNG.1.4.a001" x-target-ids="t001" x-target="Draw" x-target-head="t001" x-head="true" lemma="מָשַׁךְ" strong="H4900" x-morph="Vqv2ms" x-gloss="draw" x-translit="māšəḵ" xml:lang="hbo">מָשְׁכֵ֖</char><char style="w" x-id="WLC.SNG.1.4.002" x-align="SNG.1.4.a002" x-target-ids="t002" x-target="me" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.SNG.1.4.003" x-align="SNG.1.4.a004" x-target-ids="t006" x-target="after" x-target-head="t006" x-head="true" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="after" x-translit="ʾaḥărey" xml:lang="hbo">אַחֲרֶ֣י</char><char style="w" x-id="WLC.SNG.1.4.004" x-align="SNG.1.4.a005" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.SNG.1.4.005" x-align="SNG.1.4.a003" x-target-ids="t003 t004 t005" x-target="we will run" x-target-head="t005" x-head="true" lemma="רוּץ" strong="H7323" x-morph="Vqh1cp" x-gloss="let.us.run" x-translit="nnārûṣâ" xml:lang="hbo">נָּר֑וּצָה</char> <char style="w" x-id="WLC.SNG.1.4.006" x-align="SNG.1.4.a008" x-target-ids="t010 t011" x-target="hath brought" x-target-head="t011" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vhp3ms" x-gloss="he" x-translit="hĕḇiyʾ" xml:lang="hbo">הֱבִיאַ֨</char><char style="w" x-id="WLC.SNG.1.4.007" x-align="SNG.1.4.a009" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.brought.me" x-translit="aniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.SNG.1.4.008" x-align="SNG.1.4.a006" x-target-ids="t008" x-target="The" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" 