	<para style="p"><verse number="3" style="v" x-ref="SNG.1.3" x-added-alignments="SNG.1.3.a008" x-added-target-ids="t010" x-added-target="as" sid="SNG 1:3" /><char style="w" x-id="WLC.SNG.1.3.001" x-align="SNG.1.3.a003" x-target-ids="t003" x-target="have" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.SNG.1.3.002" x-align="SNG.1.3.a004" x-target-ids="t004 t006" x-target="a fragrance" x-target-head="t006" x-head="true" lemma="רֵיחַ" strong="H7381" x-morph="Ncmsa" x-gloss="odor" x-translit="rēyḥa" xml:lang="hbo">רֵ֨יחַ֙</char> <char style="w" x-id="WLC.SNG.1.3.003" x-align="SNG.1.3.a002" x-target-ids="t002" x-target="oils" x-target-head="t002" x-head="true" lemma="שֶׁמֶן" strong="H8081" x-morph="Ncmpc" x-gloss="oils" x-translit="šəmāney" xml:lang="hbo">שְׁמָנֶ֣י</char><char style="w" x-id="WLC.SNG.1.3.004" x-align="SNG.1.3.a001" x-target-ids="t001" x-target="Thine" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.SNG.1.3.005" x-align="SNG.1.3.a005" x-target-ids="t005" x-target="goodly" x-target-head="t005" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aampa" x-gloss="[are].good" x-translit="ṭôḇiym" xml:lang="hbo">טוֹבִ֔ים</char> <char style="w" x-id="WLC.SNG.1.3.006" x-align="SNG.1.3.a009" x-target-ids="t009 t011" x-target="is oil" x-target-head="t011" x-head="true" lemma="שֶׁמֶן" strong="H8081" x-morph="Ncmsa" x-gloss="[is].oil" x-translit="šemen" xml:lang="hbo">שֶׁ֖מֶן</char> <char style="w" x-id="WLC.SNG.1.3.007" x-align="SNG.1.3.a010" x-target-ids="t012 t013" x-target="poured forth" x-target-head="t012" x-head="true" lemma="רִיק" strong="H7324a" x-morph="VHi3fs" x-gloss="[which].it.is.poured.out" x-translit="tûraq" xml:lang="hbo">תּוּרַ֣ק</char> <char style="w" x-id="WLC.SNG.1.3.008" x-align="SNG.1.3.a007" x-target-ids="t008" x-target="name" x-t