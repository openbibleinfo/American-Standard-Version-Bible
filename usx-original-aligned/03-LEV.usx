	<para style="p"><verse number="11" style="v" x-ref="LEV.19.11" sid="LEV 19:11" /><char style="w" x-id="WLC.LEV.19.11.001" x-align="LEV.19.11.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֖א</char> <char style="w" x-id="WLC.LEV.19.11.002" x-align="LEV.19.11.a002" x-target-ids="t001 t002 t004" x-target="Ye shall steal" x-target-head="t004" x-head="true" lemma="גָּנַב" strong="H1589" x-morph="Vqi2mp" x-gloss="you.will.steal" x-translit="tiḡnōḇû" xml:lang="hbo">תִּגְנֹ֑בוּ</char> <char style="w" x-id="WLC.LEV.19.11.003" x-align="LEV.19.11.a003" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.19.11.004" x-align="LEV.19.11.a003" x-target-ids="t005" x-target="neither" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.LEV.19.11.005" x-align="LEV.19.11.a004" x-target-ids="t006 t007 t008 t009" x-target="shall ye deal falsely" x-target-head="t009" x-head="true" lemma="כָּחַשׁ" strong="H3584" x-morph="Vpi2mp" x-gloss="you.will.deceive" x-translit="ṯəḵaḥăšû" xml:lang="hbo">תְכַחֲשׁ֥וּ</char> <char style="w" x-id="WLC.LEV.19.11.006" x-align="LEV.19.11.a005" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.19.11.007" x-align="LEV.19.11.a005" x-target-ids="t010" x-target="nor" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.LEV.19.11.008" x-align="LEV.19.11.a006" x-target-ids="t011" x-target="lie" x-target-head="t011" x-head="true" lemma="שָׁקַר" strong="H8266" x-morph="Vpi2mp" x-gloss="you.will.deal.falsely" x-translit="ṯəšaqqərû" xml:lang="hbo">תְשַׁקְּר֖וּ</char> <char style="w" x-id="WLC.LEV.19.11.