	<para style="p"><verse number="14" style="v" x-ref="LEV.19.14" sid="LEV 19:14" /><char style="w" x-id="WLC.LEV.19.14.001" x-align="LEV.19.14.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.LEV.19.14.002" x-align="LEV.19.14.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt curse" x-target-head="t004" x-head="true" lemma="קָלַל" strong="H7043" x-morph="Vpi2ms" x-gloss="you.will.curse" x-translit="ṯəqallēl" xml:lang="hbo">תְקַלֵּ֣ל</char> <char style="w" x-id="WLC.LEV.19.14.003" x-align="LEV.19.14.a003" x-target-ids="t005 t006" x-target="the deaf" x-target-head="t006" x-head="true" lemma="חֵרֵשׁ" strong="H2795" x-morph="Aamsa" x-gloss="a.deaf.[person]" x-translit="ḥērēš" xml:lang="hbo">חֵרֵ֔שׁ</char> <char style="w" x-id="WLC.LEV.19.14.004" x-align="LEV.19.14.a004" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.19.14.005" x-align="LEV.19.14.a005" lemma="לְ" strong="H3807a" x-morph="R" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.LEV.19.14.006" x-align="LEV.19.14.a005" x-target-ids="t011" x-target="before" x-target-head="t011" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="before" x-translit="p̄ənēy" xml:lang="hbo">פְנֵ֣י</char> <char style="w" x-id="WLC.LEV.19.14.007" x-align="LEV.19.14.a006" x-target-ids="t012 t013" x-target="the blind" x-target-head="t013" x-head="true" lemma="עִוֵּר" strong="H5787" x-morph="Aamsa" x-gloss="a.blind.[person]" x-translit="ʿiwwēr" xml:lang="hbo">עִוֵּ֔ר</char> <char style="w" x-id="WLC.LEV.19.14.008" x-align="LEV.19.14.a004" x-target-ids="t007" x-target="nor" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LEV.19.14.009" x-align="LEV.19.14.a007" x-target