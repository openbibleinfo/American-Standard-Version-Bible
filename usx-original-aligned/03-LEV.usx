	<para style="p"><verse number="12" style="v" x-ref="LEV.19.12" sid="LEV 19:12" /><char style="w" x-id="WLC.LEV.19.12.001" x-align="LEV.19.12.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.19.12.002" x-align="LEV.19.12.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.LEV.19.12.003" x-align="LEV.19.12.a003" x-target-ids="t002 t003 t005" x-target="ye shall swear" x-target-head="t005" x-head="true" lemma="שָׁבַע" strong="H7650" x-morph="VNi2mp" x-gloss="you.will.swear.an.oath" x-translit="ṯiššāḇəʿû" xml:lang="hbo">תִשָּׁבְע֥וּ</char> <char style="w" x-id="WLC.LEV.19.12.004" x-align="LEV.19.12.a004" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.LEV.19.12.005" x-align="LEV.19.12.a005" x-target-ids="t008" x-target="name" x-target-head="t008" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šəm" xml:lang="hbo">שְׁמִ֖</char><char style="w" x-id="WLC.LEV.19.12.006" x-align="LEV.19.12.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LEV.19.12.007" x-align="LEV.19.12.a007" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.LEV.19.12.008" x-align="LEV.19.12.a007" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LEV.19.12.009" x-align="LEV.19.12.a007" x-target-ids="t009" x-target="falsely" x-target-head="t009" x-head=