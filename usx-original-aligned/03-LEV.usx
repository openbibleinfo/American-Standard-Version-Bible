	<para style="p"><verse number="20" style="v" x-ref="LEV.19.20" sid="LEV 19:20" /><char style="w" x-id="WLC.LEV.19.20.001" x-align="LEV.19.20.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֠</char><char style="w" x-id="WLC.LEV.19.20.002" x-align="LEV.19.20.a002" x-target-ids="t002" x-target="whosoever" x-target-head="t002" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="a.man" x-translit="ʾîš" xml:lang="hbo">אִישׁ</char> <char style="w" x-id="WLC.LEV.19.20.003" x-align="LEV.19.20.a002" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.LEV.19.20.004" x-align="LEV.19.20.a003" x-target-ids="t003" x-target="lieth" x-target-head="t003" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqi3ms" x-gloss="he.will.lie" x-translit="yiškaḇ" xml:lang="hbo">יִשְׁכַּ֨ב</char> <char style="w" x-id="WLC.LEV.19.20.005" x-align="LEV.19.20.a004" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.LEV.19.20.006" x-align="LEV.19.20.a005" x-target-ids="t006 t007" x-target="a woman" x-target-head="t007" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsa" x-gloss="a.woman" x-translit="ʾiššāh" xml:lang="hbo">אִשָּׁ֜ה</char> <char style="w" x-id="WLC.LEV.19.20.007" x-align="LEV.19.20.a006" x-target-ids="t004" x-target="carnally" x-target-head="t004" x-head="true" lemma="שְׁכָבָה" strong="H7902" x-morph="Ncfsc" x-gloss="a.laying" x-translit="šiḵḇaṯ-" xml:lang="hbo">שִׁכְבַת</char>־<char style="w" x-id="WLC.LEV.19.20.008" x-align="LEV.19.20.a006" lemma="זֶרַע" strong="H2233" x-morph="Ncmsa" x-gloss="of.seed" x-translit="zeraʿ" xml:lang="hbo">זֶ֗רַע</char> <char style="w" x-id="WLC.LEV.19.20.009" x-align="LEV.19.20.a007" x-status="unrepre