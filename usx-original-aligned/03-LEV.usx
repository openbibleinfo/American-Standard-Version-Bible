	<para style="p"><verse number="29" style="v" x-ref="LEV.6.29" sid="LEV 6:29" /><char style="w" x-id="WLC.LEV.6.29.001" x-align="LEV.6.29.a001" x-target-ids="t001" x-target="Every" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo" x-source-ref="LEV.6.22">כָּל</char>־<char style="w" x-id="WLC.LEV.6.29.002" x-align="LEV.6.29.a002" x-target-ids="t002" x-target="male" x-target-head="t002" x-head="true" lemma="זָכָר" strong="H2145" x-morph="Aamsa" x-gloss="male" x-translit="zāḵār" xml:lang="hbo" x-source-ref="LEV.6.22">זָכָ֥ר</char> <char style="w" x-id="WLC.LEV.6.29.003" x-align="LEV.6.29.a003" x-target-ids="t003" x-target="among" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ba" xml:lang="hbo" x-source-ref="LEV.6.22">בַּ</char><char style="w" x-id="WLC.LEV.6.29.004" x-align="LEV.6.29.a004" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="LEV.6.22">[הַ]</char><char style="w" x-id="WLC.LEV.6.29.005" x-align="LEV.6.29.a005" x-target-ids="t005" x-target="priests" x-target-head="t005" x-head="true" lemma="כֹּהֵן" strong="H3548" x-morph="Ncmpa" x-gloss="priests" x-translit="kōhăniym" xml:lang="hbo" x-source-ref="LEV.6.22">כֹּהֲנִ֖ים</char> <char style="w" x-id="WLC.LEV.6.29.006" x-align="LEV.6.29.a006" x-target-ids="t006 t007" x-target="shall eat" x-target-head="t007" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqi3ms" x-gloss="he.will.eat" x-translit="yōʾḵal" xml:lang="hbo" x-source-ref="LEV.6.22">יֹאכַ֣ל</char> <char style="w" x-id="WLC.LEV.6.29.007" x-align="LEV.6.29.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾōṯ" xml:lang="hbo" x-source-ref="LEV.6.22">אֹתָ֑</char><char style="w" x-id="WLC.LEV.6.29.008" x-align="LEV.6.29.a008" x-target-ids="t008" x-target="ther