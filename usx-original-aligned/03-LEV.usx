	<para style="p"><verse number="13" style="v" x-ref="LEV.19.13" x-added-alignments="LEV.19.13.a008" x-added-target-ids="t009" x-added-target="him" sid="LEV 19:13" /><char style="w" x-id="WLC.LEV.19.13.001" x-align="LEV.19.13.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.LEV.19.13.002" x-align="LEV.19.13.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt oppress" x-target-head="t004" x-head="true" lemma="עָשַׁק" strong="H6231" x-morph="Vqi2ms" x-gloss="you.will.oppress" x-translit="ṯaʿăšōq" xml:lang="hbo">תַעֲשֹׁ֥ק</char> <char style="w" x-id="WLC.LEV.19.13.003" x-align="LEV.19.13.a003" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.LEV.19.13.004" x-align="LEV.19.13.a004" x-target-ids="t006" x-target="neighbor" x-target-head="t006" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="neighbor" x-translit="rēʿ" xml:lang="hbo">רֵֽעֲ</char><char style="w" x-id="WLC.LEV.19.13.005" x-align="LEV.19.13.a005" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ăḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.LEV.19.13.006" x-align="LEV.19.13.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.19.13.007" x-align="LEV.19.13.a006" x-target-ids="t007" x-target="nor" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.LEV.19.13.008" x-align="LEV.19.13.a007" x-target-ids="t008" x-target="rob" x-target-head="t008" x-head="true" lemma="גָּזַל" strong="H1497" x-morph="Vqi2ms" x-gloss="you.will.rob.[him]" x-translit="ṯiḡzō