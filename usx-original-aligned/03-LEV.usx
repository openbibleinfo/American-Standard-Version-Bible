	<para style="p"><verse number="25" style="v" x-ref="LEV.23.25" sid="LEV 23:25" /><char style="w" x-id="WLC.LEV.23.25.001" x-align="LEV.23.25.a001" x-status="noncompositional" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="any" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LEV.23.25.002" x-align="LEV.23.25.a002" x-target-ids="t006" x-target="work" x-target-head="t006" x-head="true" lemma="מְלֶאכֶת" strong="H4399" x-morph="Ncfsc" x-gloss="work" x-translit="məleʾḵeṯ" xml:lang="hbo">מְלֶ֥אכֶת</char> <char style="w" x-id="WLC.LEV.23.25.003" x-align="LEV.23.25.a003" x-target-ids="t005" x-target="servile" x-target-head="t005" x-head="true" lemma="עֲבֹדָה" strong="H5656" x-morph="Ncfsa" x-gloss="of.servitude" x-translit="ʿăḇōḏāh" xml:lang="hbo">עֲבֹדָ֖ה</char> <char style="w" x-id="WLC.LEV.23.25.004" x-align="LEV.23.25.a001" x-status="noncompositional" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.LEV.23.25.005" x-align="LEV.23.25.a004" x-target-ids="t001 t002 t003" x-target="Ye shall do" x-target-head="t003" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi2mp" x-gloss="you.will.do" x-translit="ṯaʿăśû" xml:lang="hbo">תַעֲשׂ֑וּ</char> <char style="w" x-id="WLC.LEV.23.25.006" x-align="LEV.23.25.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.23.25.007" x-align="LEV.23.25.a006" x-target-ids="t008 t009 t010" x-target="ye shall offer" x-target-head="t010" x-head="true" lemma="קָרַב" strong="H7126" x-morph="Vhq2mp" x-gloss="you.will.present" x-translit="hiqraḇtem" xml:lang="hbo">הִקְרַבְתֶּ֥ם</char> <char style="w" x-id="WLC.LEV.23.25.008" x-align="LEV.23.25.a007" x-target-ids="t011 t012 t013 t014 t015" x-target="an offering made by fire" x-target-