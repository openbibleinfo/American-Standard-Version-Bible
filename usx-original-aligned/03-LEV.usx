	<para style="p"><verse number="1" style="v" x-ref="LEV.26.1" sid="LEV 26:1" /><char style="w" x-id="WLC.LEV.26.1.001" x-align="LEV.26.1.a001" x-target-ids="t005" x-target="no" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.LEV.26.1.002" x-align="LEV.26.1.a002" x-target-ids="t001 t002 t003" x-target="Ye shall make" x-target-head="t003" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi2mp" x-gloss="you.must.make" x-translit="ṯaʿăśû" xml:lang="hbo">תַעֲשׂ֨וּ</char> <char style="w" x-id="WLC.LEV.26.1.003" x-align="LEV.26.1.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.LEV.26.1.004" x-align="LEV.26.1.a004" x-target-ids="t004" x-target="you" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="yourselves" x-translit="āḵem" xml:lang="hbo">כֶ֜ם</char> <char style="w" x-id="WLC.LEV.26.1.005" x-align="LEV.26.1.a005" x-target-ids="t006" x-target="idols" x-target-head="t006" x-head="true" lemma="אֱלִיל" strong="H457" x-morph="Ncmpa" x-gloss="worthless.idols" x-translit="ʾĕlîlim" xml:lang="hbo">אֱלִילִ֗ם</char> <char style="w" x-id="WLC.LEV.26.1.006" x-align="LEV.26.1.a006" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.LEV.26.1.007" x-align="LEV.26.1.a007" x-target-ids="t013 t014 t015" x-target="a graven image" x-target-head="t014" x-head="true" lemma="פֶּסֶל" strong="H6459" x-morph="Ncmsa" x-gloss="an.idol" x-translit="p̄esel" xml:lang="hbo">פֶ֤סֶל</char> <char style="w" x-id="WLC.LEV.26.1.008" x-align="LEV.26.1.a008" x-target-ids="t016" x-target="or" x-target-head="t016" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.LEV.26.1.