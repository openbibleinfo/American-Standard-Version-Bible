	<para style="p"><verse number="42" style="v" x-ref="LEV.25.42" sid="LEV 25:42" /><char style="w" x-id="WLC.LEV.25.42.001" x-align="LEV.25.42.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.LEV.25.42.002" x-align="LEV.25.42.a002" x-target-ids="t003 t005" x-target="are servants" x-target-head="t005" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmpc" x-gloss="servants" x-translit="ʿăḇāḏ" xml:lang="hbo">עֲבָדַ֣</char><char style="w" x-id="WLC.LEV.25.42.003" x-align="LEV.25.42.a003" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[are].my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LEV.25.42.004" x-align="LEV.25.42.a004" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="הֵם" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēm" xml:lang="hbo">הֵ֔ם</char> <char style="w" x-id="WLC.LEV.25.42.005" x-align="LEV.25.42.a005" x-target-ids="t006" x-target="whom" x-target-head="t006" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="whom" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.LEV.25.42.006" x-align="LEV.25.42.a006" x-target-ids="t007 t008 t009" x-target="I brought forth" x-target-head="t008" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vhp1cs" x-gloss="I.brought.out" x-translit="hôṣēʾṯî" xml:lang="hbo">הוֹצֵ֥אתִי</char> <char style="w" x-id="WLC.LEV.25.42.007" x-align="LEV.25.42.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾōṯ" xml:lang="hbo">אֹתָ֖</char><char style="w" x-id="WLC.LEV.25.42.008" x-align="LEV.25.42.a008" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="W