	<para style="p"><verse number="29" style="v" x-ref="LEV.27.29" sid="LEV 27:29" /><char style="w" x-id="WLC.LEV.27.29.001" x-align="LEV.27.29.a001" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LEV.27.29.002" x-align="LEV.27.29.a002" x-target-ids="t002 t003" x-target="one devoted" x-target-head="t003" x-head="true" lemma="חֵרֶם" strong="H2764" x-morph="Ncmsa" x-gloss="dedicated.person" x-translit="ḥērem" xml:lang="hbo">חֵ֗רֶם</char> <char style="w" x-id="WLC.LEV.27.29.003" x-align="LEV.27.29.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֧ר</char> <char style="w" x-id="WLC.LEV.27.29.004" x-align="LEV.27.29.a004" x-target-ids="t005 t006 t007" x-target="shall be devoted" x-target-head="t007" x-head="true" lemma="חָרַם" strong="H2763" x-morph="VHi3ms" x-gloss="he.will.be.dedicated.to.destruction" x-translit="yoḥŏram" xml:lang="hbo">יָחֳרַ֛ם</char> <char style="w" x-id="WLC.LEV.27.29.005" x-align="LEV.27.29.a005" x-target-ids="t008 t009" x-target="from among" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="min-" xml:lang="hbo">מִן</char>־<char style="w" x-id="WLC.LEV.27.29.006" x-align="LEV.27.29.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.LEV.27.29.007" x-align="LEV.27.29.a007" x-target-ids="t010" x-target="men" x-target-head="t010" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="humankind" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֖ם</char> <char style="w" x-id="WLC.LEV.27.29.008" x-align="LEV.27.29.a001" x-target-ids="t001" x-target="No" x-target-head="t001" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char