	<para style="p"><verse number="15" style="v" x-ref="LEV.2.15" sid="LEV 2:15" /><char style="w" x-id="WLC.LEV.2.15.001" x-align="LEV.2.15.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.2.15.002" x-align="LEV.2.15.a002" x-target-ids="t002 t003 t004" x-target="thou shalt put" x-target-head="t004" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqq2ms" x-gloss="you.will.put" x-translit="nāṯattā" xml:lang="hbo">נָתַתָּ֤</char> <char style="w" x-id="WLC.LEV.2.15.003" x-align="LEV.2.15.a003" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāley" xml:lang="hbo">עָלֶ֨י</char><char style="w" x-id="WLC.LEV.2.15.004" x-align="LEV.2.15.a004" x-target-ids="t007" x-target="it" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="it" x-translit="hā" xml:lang="hbo">הָ֙</char> <char style="w" x-id="WLC.LEV.2.15.005" x-align="LEV.2.15.a005" x-target-ids="t005" x-target="oil" x-target-head="t005" x-head="true" lemma="שֶׁמֶן" strong="H8081" x-morph="Ncmsa" x-gloss="oil" x-translit="šemen" xml:lang="hbo">שֶׁ֔מֶן</char> <char style="w" x-id="WLC.LEV.2.15.006" x-align="LEV.2.15.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.2.15.007" x-align="LEV.2.15.a007" x-target-ids="t009" x-target="lay" x-target-head="t009" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqq2ms" x-gloss="you.will.place" x-translit="śamtā" xml:lang="hbo">שַׂמְתָּ֥</char> <char style="w" x-id="WLC.LEV.2.15.008" x-align="LEV.2.15.a008" x-target-ids="t011" x-target="thereon" x-target-head="t011" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāley" xml:lang="hbo">ע