	<para style="p"><verse number="26" style="v" x-ref="LEV.27.26" sid="LEV 27:26" /><char style="w" x-id="WLC.LEV.27.26.001" x-align="LEV.27.26.a001" x-target-ids="t001" x-target="Only" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="nevertheless" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.LEV.27.26.002" x-align="LEV.27.26.a002" x-target-ids="t002 t003" x-target="the firstling" x-target-head="t003" x-head="true" lemma="בְּכֹר" strong="H1060" x-morph="Ncmsa" x-gloss="a.firstborn" x-translit="bəḵôr" xml:lang="hbo">בְּכ֞וֹר</char> <char style="w" x-id="WLC.LEV.27.26.003" x-align="LEV.27.26.a005" x-target-ids="t006" x-target="which" x-target-head="t006" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.LEV.27.26.004" x-align="LEV.27.26.a006" x-target-ids="t007 t008 t009 t010" x-target="is made a firstling" x-target-head="t010" x-head="true" lemma="בָּכַר" strong="H1069" x-morph="VPi3ms" x-gloss="it.will.be.belong.as.a.firstling" x-translit="yəḇukkar" xml:lang="hbo">יְבֻכַּ֤ר</char> <char style="w" x-id="WLC.LEV.27.26.005" x-align="LEV.27.26.a007" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.LEV.27.26.006" x-align="LEV.27.26.a008" x-target-ids="t012" x-target="Jehovah" x-target-head="t012" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָה֙</char> <char style="w" x-id="WLC.LEV.27.26.007" x-align="LEV.27.26.a003" x-target-ids="t004" x-target="among" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.LEV.27.26.008" x-align="LEV.27.26.a004" x-target-ids="t005" x-target="beasts" x-target-head="t005" x-head="true" l