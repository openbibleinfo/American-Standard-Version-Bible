	<para style="p"><verse number="1" style="v" x-ref="LEV.19.1" sid="LEV 19:1" /><char style="w" x-id="WLC.LEV.19.1.001" x-align="LEV.19.1.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LEV.19.1.002" x-align="LEV.19.1.a002" x-target-ids="t003" x-target="spake" x-target-head="t003" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpw3ms" x-gloss="he.spoke" x-translit="yəḏabbēr" xml:lang="hbo">יְדַבֵּ֥ר</char> <char style="w" x-id="WLC.LEV.19.1.003" x-align="LEV.19.1.a003" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.LEV.19.1.004" x-align="LEV.19.1.a004" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LEV.19.1.005" x-align="LEV.19.1.a005" x-target-ids="t005" x-target="Moses" x-target-head="t005" x-head="true" lemma="מֹשֶׁה" strong="H4872" x-morph="Np" x-gloss="Moses" x-translit="mōšeh" xml:lang="hbo">מֹשֶׁ֥ה</char> <char style="w" x-id="WLC.LEV.19.1.006" x-align="LEV.19.1.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(cmp)" x-translit="llē" xml:lang="hbo">לֵּ</char><char style="w" x-id="WLC.LEV.19.1.007" x-align="LEV.19.1.a007" x-target-ids="t006" x-target="saying" x-target-head="t006" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqc" x-translit="ʾmōr" xml:lang="hbo">אמֹֽר</char> <verse eid="LEV 19:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="LEV.19.2" sid="LEV 19:2" /><char style="w" x-id="WLC.LEV.19.2.001" x-align="LEV.19.2.a001" x-target-ids="t001" x-target="Speak" x-target-head="t001" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpv2ms" x-gloss="speak" x-translit="dabbēr" xml:lang="hbo">דַּבֵּ֞ר</char> <char style="w" x-id="WLC.LEV.19.2.002" x-align="LEV.19.2.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LEV.19.2.003" x-align="LEV.19.2.a003" x-target-ids="t003" x-target="all" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LEV.19.2.004" x-align="LEV.19.2.a004" x-target-ids="t004 t005" x-target="the congregation" x-target-head="t005" x-head="true" lemma="עֵדָה" strong="H5712" x-morph="Ncfsc" x-gloss="the.congregation" x-translit="ʿăḏaṯ" xml:lang="hbo">עֲדַ֧ת</char> <char style="w" x-id="WLC.LEV.19.2.005" x-align="LEV.19.2.a005" x-target-ids="t006 t007 t008" x-target="of the children" x-target-head="t008" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="of.the.people" x-translit="bənê-" xml:lang="hbo">בְּנֵי</char>־<char style="w" x-id="WLC.LEV.19.2.006" x-align="LEV.19.2.a006" x-target-ids="t009 t010" x-target="of Israel" x-target-head="t010" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֛ל</char> <char style="w" x-id="WLC.LEV.19.2.007" x-align="LEV.19.2.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.19.2.008" x-align="LEV.19.2.a008" x-target-ids="t012" x-target="say" x-target-head="t012" x-head="true" lemma="אָמַר" strong="H559" x-mo