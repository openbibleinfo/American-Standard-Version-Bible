	<para style="p"><verse number="23" style="v" x-ref="LEV.26.23" sid="LEV 26:23" /><char style="w" x-id="WLC.LEV.26.23.001" x-align="LEV.26.23.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.26.23.002" x-align="LEV.26.23.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִ֨ם</char>־<char style="w" x-id="WLC.LEV.26.23.003" x-align="LEV.26.23.a003" x-target-ids="t003" x-target="by" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LEV.26.23.004" x-align="LEV.26.23.a004" x-target-ids="t004 t005" x-target="these things" x-target-head="t004" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo">אֵ֔לֶּה</char> <char style="w" x-id="WLC.LEV.26.23.005" x-align="LEV.26.23.a005" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LEV.26.23.006" x-align="LEV.26.23.a006" x-target-ids="t006 t007 t009 t010" x-target="ye will be reformed" x-target-head="t010" x-head="true" lemma="יָסַר" strong="H3256" x-morph="VNi2mp" x-gloss="you.will.let.yourself.be.disciplined" x-translit="ṯiwwāsərû" xml:lang="hbo">תִוָּסְר֖וּ</char> <char style="w" x-id="WLC.LEV.26.23.007" x-align="LEV.26.23.a007" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="by" x-translit="l" xml:lang="hbo">לִ֑</char><char style="w" x-id="WLC.LEV.26.23.008" x-align="LEV.26.23.a008" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" 