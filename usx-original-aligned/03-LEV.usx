	<para style="p"><verse number="26" style="v" x-ref="LEV.20.26" sid="LEV 20:26" /><char style="w" x-id="WLC.LEV.20.26.001" x-align="LEV.20.26.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִ</char><char style="w" x-id="WLC.LEV.20.26.002" x-align="LEV.20.26.a002" x-target-ids="t002 t003 t004" x-target="ye shall be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq2mp" x-gloss="you.will.be" x-translit="həyiyṯem" xml:lang="hbo">הְיִ֤יתֶם</char> <char style="w" x-id="WLC.LEV.20.26.003" x-align="LEV.20.26.a003" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.LEV.20.26.004" x-align="LEV.20.26.a004" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.LEV.20.26.005" x-align="LEV.20.26.a005" x-target-ids="t005" x-target="holy" x-target-head="t005" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aampa" x-gloss="holy" x-translit="qəḏōšiym" xml:lang="hbo">קְדֹשִׁ֔ים</char> <char style="w" x-id="WLC.LEV.20.26.006" x-align="LEV.20.26.a006" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.LEV.20.26.007" x-align="LEV.20.26.a007" x-target-ids="t011 t012" x-target="am holy" x-target-head="t012" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aamsa" x-gloss="[am].holy" x-translit="qāḏôš" xml:lang="hbo">קָד֖וֹשׁ</char> <char style="w" x-id="WLC.LEV.20.26.008" x-align="LEV.20.26.a008" x-target-ids="t009" x-target="I" x-target-head="t009" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-transli