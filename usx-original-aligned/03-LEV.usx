	<para style="p"><verse number="16" style="v" x-ref="LEV.19.16" sid="LEV 19:16" /><char style="w" x-id="WLC.LEV.19.16.001" x-align="LEV.19.16.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.LEV.19.16.002" x-align="LEV.19.16.a002" x-target-ids="t001 t002 t004 t005 t006 t007" x-target="Thou shalt go up and down" x-target-head="t004" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi2ms" x-gloss="you.will.go.about" x-translit="ṯēlēḵ" xml:lang="hbo">תֵלֵ֤ךְ</char> <char style="w" x-id="WLC.LEV.19.16.003" x-align="LEV.19.16.a003" x-target-ids="t008 t009 t010" x-target="as a talebearer" x-target-head="t010" x-head="true" lemma="רָכִיל" strong="H7400" x-morph="Ncmsa" x-gloss="slander" x-translit="rāḵîl" xml:lang="hbo">רָכִיל֙</char> <char style="w" x-id="WLC.LEV.19.16.004" x-align="LEV.19.16.a004" x-target-ids="t011" x-target="among" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LEV.19.16.005" x-align="LEV.19.16.a005" x-target-ids="t013" x-target="people" x-target-head="t013" x-head="true" lemma="עַם" strong="H5971a" x-morph="Ncmpc" x-gloss="kinspeople(s)" x-translit="ʿammey" xml:lang="hbo">עַמֶּ֔י</char><char style="w" x-id="WLC.LEV.19.16.006" x-align="LEV.19.16.a006" x-target-ids="t012" x-target="thy" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.LEV.19.16.007" x-align="LEV.19.16.a007" x-target-ids="t014" x-target="neither" x-target-head="t014" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LEV.19.16.008" x-align="LEV.19.16.a008" x-target-ids="t015 t016 t017" x-target="shalt thou stand" x-target-head="t017"