	<para style="p"><verse number="2" style="v" x-ref="LEV.1.2" x-added-alignments="LEV.1.2.a031" x-added-target-ids="t029" x-added-target="even" sid="LEV 1:2" /><char style="w" x-id="WLC.LEV.1.2.001" x-align="LEV.1.2.a001" x-target-ids="t001" x-target="Speak" x-target-head="t001" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpv2ms" x-gloss="speak" x-translit="dabbēr" xml:lang="hbo">דַּבֵּ֞ר</char> <char style="w" x-id="WLC.LEV.1.2.002" x-align="LEV.1.2.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LEV.1.2.003" x-align="LEV.1.2.a003" x-target-ids="t003 t004" x-target="the children" x-target-head="t004" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.people" x-translit="bənēy" xml:lang="hbo">בְּנֵ֤י</char> <char style="w" x-id="WLC.LEV.1.2.004" x-align="LEV.1.2.a004" x-target-ids="t005 t006" x-target="of Israel" x-target-head="t006" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵל֙</char> <char style="w" x-id="WLC.LEV.1.2.005" x-align="LEV.1.2.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.1.2.006" x-align="LEV.1.2.a006" x-target-ids="t008" x-target="say" x-target-head="t008" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq2ms" x-gloss="you.will.say" x-translit="ʾāmartā" xml:lang="hbo">אָמַרְתָּ֣</char> <char style="w" x-id="WLC.LEV.1.2.007" x-align="LEV.1.2.a007" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾăl" xml:lang="hbo">אֲלֵ</char><char style="w" x-id="WLC.LEV.1.2.008" x-align="LEV.1.2.a008" x-target-ids="t010" x-target="them" x-target-head="t010" x-head="true" l