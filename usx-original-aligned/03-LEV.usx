	<para style="p"><verse number="1" style="v" x-ref="LEV.7.1" sid="LEV 7:1" /><char style="w" x-id="WLC.LEV.7.1.001" x-align="LEV.7.1.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LEV.7.1.002" x-align="LEV.7.1.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֥את</char> <char style="w" x-id="WLC.LEV.7.1.003" x-align="LEV.7.1.a003" x-target-ids="t003 t004 t005" x-target="is the law" x-target-head="t005" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="[is].the.legal.[procedure]" x-translit="tôraṯ" xml:lang="hbo">תּוֹרַ֖ת</char> <char style="w" x-id="WLC.LEV.7.1.004" x-align="LEV.7.1.a004" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.LEV.7.1.005" x-align="LEV.7.1.a005" x-target-ids="t006 t008 t009" x-target="of trespass offering" x-target-head="t008" x-head="true" lemma="אָשָׁם" strong="H817" x-morph="Ncmsa" x-gloss="the.guilt.offering" x-translit="ʾāšām" xml:lang="hbo">אָשָׁ֑ם</char> <char style="w" x-id="WLC.LEV.7.1.006" x-align="LEV.7.1.a006" x-target-ids="t011 t013" x-target="is holy" x-target-head="t013" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsc" x-gloss="[is].a.holy.thing" x-translit="qōḏeš" xml:lang="hbo">קֹ֥דֶשׁ</char> <char style="w" x-id="WLC.LEV.7.1.007" x-align="LEV.7.1.a007" x-target-ids="t012" x-target="most" x-target-head="t012" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmpa" x-gloss="of.holy.things" x-translit="qāḏāšiym" xml:lang="hbo">קָֽדָשִׁ֖ים</char> <char style="w" x-id="WLC.LEV.7.1.008" x-align="LEV.7.1.a008" x-target-ids="t010" x-target="it" x-target-head="t010" x-head="true" lemma="הוּא" st