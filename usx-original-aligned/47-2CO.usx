	<para style="p"><verse number="3" style="v" x-ref="2CO.5.3" sid="2CO 5:3" /><char style="w" x-id="SBLGNT.2CO.5.3.001" x-align="2CO.5.3.a001" x-target-ids="t001" x-target="if" x-target-head="t001" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἴ</char> <char style="w" x-id="SBLGNT.2CO.5.3.002" x-align="2CO.5.3.a002" x-target-ids="t002 t003 t004" x-target="so be that" x-target-head="t002" x-head="true" lemma="γέ" strong="G1065" x-morph="PRT" x-gloss="indeed" x-translit="ge" xml:lang="grc">γε</char> <char style="w" x-id="SBLGNT.2CO.5.3.003" x-align="2CO.5.3.a003" x-status="unrepresented" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.5.3.004" x-align="2CO.5.3.a004" x-target-ids="t005 t006" x-target="being clothed" x-target-head="t006" x-head="true" lemma="ἐνδύω" strong="G1746" x-morph="V-AMP-NPM" x-gloss="having been clothed" x-translit="endysamenoi" xml:lang="grc">ἐνδυσάμενοι</char> <char style="w" x-id="SBLGNT.2CO.5.3.005" x-align="2CO.5.3.a005" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.2CO.5.3.006" x-align="2CO.5.3.a006" x-target-ids="t012" x-target="naked" x-target-head="t012" x-head="true" lemma="γυμνός" strong="G1131" x-morph="A-NPM" x-gloss="naked" x-translit="gymnoi" xml:lang="grc">γυμνοὶ</char> <char style="w" x-id="SBLGNT.2CO.5.3.007" x-align="2CO.5.3.a007" x-target-ids="t007 t008 t010 t011" x-target="we shall be found" x-target-head="t011" x-head="true" lemma="εὑρίσκω" strong="G2147" x-morph="V-FPI-1P" x-gloss="we will be found" x-translit="heurethēsometha" xml:lang="grc">εὑρεθησόμεθα</char>.<verse eid="2CO 5:3" /></para>
