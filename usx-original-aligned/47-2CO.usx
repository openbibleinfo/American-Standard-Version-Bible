	<para style="p"><verse number="6" style="v" x-ref="2CO.5.6" sid="2CO 5:6" /><char style="w" x-id="SBLGNT.2CO.5.6.001" x-align="2CO.5.6.a001" x-target-ids="t001 t004 t005 t006" x-target="Being of good courage" x-target-head="t006" x-head="true" lemma="θαρρέω" strong="G2292" x-morph="V-PAP-NPM" x-gloss="being confident" x-translit="Tharrountes" xml:lang="grc">Θαρροῦντες</char> <char style="w" x-id="SBLGNT.2CO.5.6.002" x-align="2CO.5.6.a002" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.2CO.5.6.003" x-align="2CO.5.6.a003" x-target-ids="t003" x-target="always" x-target-head="t003" x-head="true" lemma="πάντοτε" strong="G3842" x-morph="ADV" x-gloss="always" x-translit="pantote" xml:lang="grc">πάντοτε</char> <char style="w" x-id="SBLGNT.2CO.5.6.004" x-align="2CO.5.6.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.5.6.005" x-align="2CO.5.6.a005" x-target-ids="t008" x-target="knowing" x-target-head="t008" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAP-NPM" x-gloss="knowing" x-translit="eidotes" xml:lang="grc">εἰδότες</char> <char style="w" x-id="SBLGNT.2CO.5.6.006" x-align="2CO.5.6.a006" x-target-ids="t009" x-target="that" x-target-head="t009" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.2CO.5.6.007" x-align="2CO.5.6.a007" x-target-ids="t010 t011 t012 t013 t014" x-target="whilst we are at home" x-target-head="t014" x-head="true" lemma="ἐνδημέω" strong="G1736" x-morph="V-PAP-NPM" x-gloss="being at home" x-translit="endēmountes" xml:lang="grc">ἐνδημοῦντες</char> <char style="w" x-id="SBLGNT.2CO.5.6.008" x-align="2CO.5.6.a008" x-target-ids="t015" x-tar