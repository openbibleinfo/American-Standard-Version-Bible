	<para style="p"><verse number="5" style="v" x-ref="2CO.5.5" sid="2CO 5:5" /><char style="w" x-id="SBLGNT.2CO.5.5.001" x-align="2CO.5.5.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="The [One]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.2CO.5.5.002" x-align="2CO.5.5.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.2CO.5.5.003" x-align="2CO.5.5.a003" x-target-ids="t003 t004" x-target="that wrought" x-target-head="t004" x-head="true" lemma="κατεργάζομαι" strong="G2716" x-morph="V-ADP-NSM" x-gloss="having prepared" x-translit="katergasamenos" xml:lang="grc">κατεργασάμενος</char> <char style="w" x-id="SBLGNT.2CO.5.5.004" x-align="2CO.5.5.a004" x-target-ids="t005" x-target="us" x-target-head="t005" x-head="true" lemma="ἐγώ" strong="G2248" x-morph="P-1AP" x-gloss="us" x-translit="hēmas" xml:lang="grc">ἡμᾶς</char> <char style="w" x-id="SBLGNT.2CO.5.5.005" x-align="2CO.5.5.a005" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="for" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.2CO.5.5.006" x-align="2CO.5.5.a007" x-target-ids="t008" x-target="very" x-target-head="t008" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASN" x-gloss="very" x-translit="auto" xml:lang="grc">αὐτὸ</char> <char style="w" x-id="SBLGNT.2CO.5.5.007" x-align="2CO.5.5.a006" x-target-ids="t007 t009" x-target="this thing" x-target-head="t007" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.2CO.5.5.008" x-align="2CO.5.5.a008" x-target-ids="t010 t011" x-target="is God" x-target-head="t011" x-head="true" lemma="θεός" strong="G2316" x-morph="N-NSM" x-gloss="[