	<para style="p"><verse number="2" style="v" x-ref="2CO.11.2" sid="2CO 11:2" /><char style="w" x-id="SBLGNT.2CO.11.2.001" x-align="2CO.11.2.a002" x-target-ids="t002 t003 t004" x-target="I am jealous" x-target-head="t004" x-head="true" lemma="ζηλόω" strong="G2206" x-morph="V-PAI-1S" x-gloss="I am jealous as to" x-translit="zēlō" xml:lang="grc">ζηλῶ</char> <char style="w" x-id="SBLGNT.2CO.11.2.002" x-align="2CO.11.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2CO.11.2.003" x-align="2CO.11.2.a003" x-target-ids="t005 t006" x-target="over you" x-target-head="t006" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.2CO.11.2.004" x-align="2CO.11.2.a005" x-target-ids="t009" x-target="godly" x-target-head="t009" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.2CO.11.2.005" x-align="2CO.11.2.a004" x-target-ids="t007 t008 t010" x-target="with a jealousy" x-target-head="t010" x-head="true" lemma="ζῆλος" strong="G2205" x-morph="N-DSM" x-gloss="with [the] jealousy" x-translit="zēlōi" xml:lang="grc">ζήλῳ</char>,<char style="w" x-id="SBLGNT.2CO.11.2.006" x-align="2CO.11.2.a007" x-target-ids="t012 t013" x-target="I espoused" x-target-head="t013" x-head="true" lemma="ἁρμόζομαι" strong="G718" x-morph="V-AMI-1S" x-gloss="I have betrothed" x-translit="hērmosamēn" xml:lang="grc">ἡρμοσάμην</char> <char style="w" x-id="SBLGNT.2CO.11.2.007" x-align="2CO.11.2.a006" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2CO.11.2.008" x-align="2CO.11.2.a008" x-target-ids="t014 t022" x-target="you you" x-