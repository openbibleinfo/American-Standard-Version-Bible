	<para style="p"><verse number="3" style="v" x-ref="2CO.10.3" sid="2CO 10:3" /><char style="w" x-id="SBLGNT.2CO.10.3.001" x-align="2CO.10.3.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="In" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2CO.10.3.002" x-align="2CO.10.3.a004" x-target-ids="t006 t007" x-target="the flesh" x-target-head="t007" x-head="true" lemma="σάρξ" strong="G4561" x-morph="N-DSF" x-gloss="flesh" x-translit="sarki" xml:lang="grc">σαρκὶ</char> <char style="w" x-id="SBLGNT.2CO.10.3.003" x-align="2CO.10.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2CO.10.3.004" x-align="2CO.10.3.a002" x-target-ids="t002 t003 t004" x-target="though we walk" x-target-head="t004" x-head="true" lemma="περιπατέω" strong="G4043" x-morph="V-PAP-NPM" x-gloss="walking" x-translit="peripatountes" xml:lang="grc">περιπατοῦντες</char> <char style="w" x-id="SBLGNT.2CO.10.3.005" x-align="2CO.10.3.a006" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.2CO.10.3.006" x-align="2CO.10.3.a007" x-target-ids="t012 t013" x-target="according to" x-target-head="t012" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="according to" x-translit="kata" xml:lang="grc">κατὰ</char> <char style="w" x-id="SBLGNT.2CO.10.3.007" x-align="2CO.10.3.a008" x-target-ids="t014 t015" x-target="the flesh" x-target-head="t015" x-head="true" lemma="σάρξ" strong="G4561" x-morph="N-ASF" x-gloss="flesh" x-translit="sarka" xml:lang="grc">σάρκα</char> <char style="w" x-id="SBLGNT.2CO.10.3.008" x-align="2CO.10.3.a005" x-target-ids="t008 t009 t011" x-target="we do war" x-target-head="t011" x-head="true" lem