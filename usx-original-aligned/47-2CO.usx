	<para style="p"><verse number="1" style="v" x-ref="2CO.2.1" sid="2CO 2:1" /><char style="w" x-id="SBLGNT.2CO.2.1.001" x-align="2CO.2.1.a001" x-target-ids="t002 t003" x-target="I determined" x-target-head="t003" x-head="true" lemma="κρίνω" strong="G2919" x-morph="V-AAI-1S" x-gloss="I judged" x-translit="ekrina" xml:lang="grc">ἔκρινα</char> <char style="w" x-id="SBLGNT.2CO.2.1.v001.r01.001" x-align="2CO.2.1.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.2CO.2.1.003" x-align="2CO.2.1.a003" x-target-ids="t005 t006" x-target="for myself" x-target-head="t006" x-head="true" lemma="ἐμαυτοῦ" strong="G1683" x-morph="F-1DSM" x-gloss="within myself" x-translit="emautōi" xml:lang="grc">ἐμαυτῷ</char> <char style="w" x-id="SBLGNT.2CO.2.1.004" x-align="2CO.2.1.a004" x-target-ids="t004" x-target="this" x-target-head="t004" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char>,<char style="w" x-id="SBLGNT.2CO.2.1.005" x-align="2CO.2.1.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.2CO.2.1.006" x-align="2CO.2.1.a006" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.2CO.2.1.007" x-align="2CO.2.1.a007" x-target-ids="t012" x-target="again" x-target-head="t012" x-head="true" lemma="πάλιν" strong="G3825" x-morph="ADV" x-gloss="again" x-translit="palin" xml:lang="grc">πάλιν</char> <char style="w" x-id="SBLGNT.2CO.2.1.008" x-align="2CO.2.1.a008" x-target-ids="t015" x-target="with" x-target-head="t015" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <c