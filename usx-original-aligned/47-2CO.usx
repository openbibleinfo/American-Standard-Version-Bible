	<para style="p"><verse number="2" style="v" x-ref="2CO.2.2" sid="2CO 2:2" /><char style="w" x-id="SBLGNT.2CO.2.2.001" x-align="2CO.2.2.a001" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.2CO.2.2.002" x-align="2CO.2.2.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2CO.2.2.003" x-align="2CO.2.2.a003" x-target-ids="t003" x-target="I" x-target-head="t003" x-head="true" lemma="ἐγώ" strong="G1473" x-morph="P-1NS" x-gloss="I" x-translit="egō" xml:lang="grc">ἐγὼ</char> <char style="w" x-id="SBLGNT.2CO.2.2.004" x-align="2CO.2.2.a004" x-target-ids="t004 t006" x-target="make sorry" x-target-head="t006" x-head="true" lemma="λυπέω" strong="G3076" x-morph="V-PAI-1S" x-gloss="grieve" x-translit="lypō" xml:lang="grc">λυπῶ</char> <char style="w" x-id="SBLGNT.2CO.2.2.005" x-align="2CO.2.2.a005" x-target-ids="t005" x-target="you" x-target-head="t005" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char>,<char style="w" x-id="SBLGNT.2CO.2.2.006" x-align="2CO.2.2.a006" x-target-ids="t008" x-target="then" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="again" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.2.2.007" x-align="2CO.2.2.a007" x-target-ids="t007 t009" x-target="who is" x-target-head="t007" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSM" x-gloss="who" x-translit="tis" xml:lang="grc">τίς</char> <char style="w" x-id="SBLGNT.2CO.2.2.008" x-align="2CO.2.2.a008" x-target-ids="t010" x-target="he" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT