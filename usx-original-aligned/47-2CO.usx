	<para style="p"><verse number="2" style="v" x-ref="2CO.5.2" sid="2CO 5:2" /><char style="w" x-id="SBLGNT.2CO.5.2.001" x-align="2CO.5.2.a002" x-target-ids="t002" x-target="verily" x-target-head="t002" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.5.2.002" x-align="2CO.5.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="indeed" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2CO.5.2.003" x-align="2CO.5.2.a003" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2CO.5.2.004" x-align="2CO.5.2.a004" x-target-ids="t004" x-target="this" x-target-head="t004" x-head="true" lemma="οὗτος" strong="G5129" x-morph="D-DSN" x-gloss="this" x-translit="toutōi" xml:lang="grc">τούτῳ</char> <char style="w" x-id="SBLGNT.2CO.5.2.005" x-align="2CO.5.2.a005" x-target-ids="t005 t006" x-target="we groan" x-target-head="t006" x-head="true" lemma="στενάζω" strong="G4727" x-morph="V-PAI-1P" x-gloss="we groan" x-translit="stenazomen" xml:lang="grc">στενάζομεν</char>,<char style="w" x-id="SBLGNT.2CO.5.2.006" x-align="2CO.5.2.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.2CO.5.2.007" x-align="2CO.5.2.a010" x-target-ids="t014" x-target="habitation" x-target-head="t014" x-head="true" lemma="οἰκητήριον" strong="G3613" x-morph="N-ASN" x-gloss="dwelling" x-translit="oikētērion" xml:lang="grc">οἰκητήριον</char> <char style="w" x-id="SBLGNT.2CO.5.2.008" x-align="2CO.5.2.a009" x-target-ids="t013" x-target="our" x-target-head="t013" x-head="true" lemma="ἐγώ" strong="G2257" x-morph="P-1GP" x-gloss="of us" x-translit="hēmōn" xml:lang="grc">ἡμῶν</cha