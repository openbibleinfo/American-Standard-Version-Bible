	<para style="p"><verse number="8" style="v" x-ref="2CO.4.8" sid="2CO 4:8" /><char style="w" x-id="SBLGNT.2CO.4.8.001" x-align="2CO.4.8.a001" x-target-ids="t004" x-target="on" x-target-head="t004" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2CO.4.8.002" x-align="2CO.4.8.a002" x-target-ids="t005 t006" x-target="every side" x-target-head="t005" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-DSM" x-gloss="every [way]" x-translit="panti" xml:lang="grc">παντὶ</char> <char style="w" x-id="SBLGNT.2CO.4.8.003" x-align="2CO.4.8.a003" x-target-ids="t001 t002 t003" x-target="we are pressed" x-target-italic-ids="t001 t002" x-target-head="t003" x-head="true" lemma="θλίβω" strong="G2346" x-morph="V-PPP-NPM" x-gloss="being hard pressed" x-translit="thlibomenoi" xml:lang="grc">θλιβόμενοι</char> <char style="w" x-id="SBLGNT.2CO.4.8.004" x-align="2CO.4.8.a004" x-target-ids="t007" x-target="yet" x-target-head="t007" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.2CO.4.8.005" x-align="2CO.4.8.a005" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.2CO.4.8.006" x-align="2CO.4.8.a006" x-target-ids="t009" x-target="straitened" x-target-head="t009" x-head="true" lemma="στενοχωρέομαι" strong="G4729" x-morph="V-PPP-NPM" x-gloss="being crushed" x-translit="stenochōroumenoi" xml:lang="grc">στενοχωρούμενοι</char>,<char style="w" x-id="SBLGNT.2CO.4.8.007" x-align="2CO.4.8.a007" x-target-ids="t010" x-target="perplexed" x-target-head="t010" x-head="true" lemma="ἀπορέω" strong="G639" x-morph="V-PMP-NPM" x-gloss="being perplexed" x-translit="aporoumenoi" xml:lang="grc">ἀπορούμενοι</char> <char style="w" x-id="SBLGNT.2CO.4.8.008" x-align="2CO.4.8.a008" x-target-ids="