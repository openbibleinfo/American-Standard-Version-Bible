	<para style="p"><verse number="9" style="v" x-ref="2CO.5.9" sid="2CO 5:9" /><char style="w" x-id="SBLGNT.2CO.5.9.001" x-align="2CO.5.9.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="διό" strong="G1352" x-morph="CONJ" x-gloss="Therefore" x-translit="dio" xml:lang="grc">διὸ</char> <char style="w" x-id="SBLGNT.2CO.5.9.002" x-align="2CO.5.9.a002" x-target-ids="t002" x-target="also" x-target-head="t002" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.5.9.003" x-align="2CO.5.9.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="we make it our aim" x-target-head="t007" x-head="true" lemma="φιλοτιμέομαι" strong="G5389" x-morph="V-PNI-1P" x-gloss="we are ambitious" x-translit="philotimoumetha" xml:lang="grc">φιλοτιμούμεθα</char>,<char style="w" x-id="SBLGNT.2CO.5.9.004" x-align="2CO.5.9.a004" x-target-ids="t008" x-target="whether" x-target-head="t008" x-head="true" lemma="εἴτε" strong="G1535" x-morph="CONJ" x-gloss="whether" x-translit="eite" xml:lang="grc">εἴτε</char> <char style="w" x-id="SBLGNT.2CO.5.9.005" x-align="2CO.5.9.a005" x-target-ids="t009 t010" x-target="at home" x-target-head="t010" x-head="true" lemma="ἐνδημέω" strong="G1736" x-morph="V-PAP-NPM" x-gloss="being at home" x-translit="endēmountes" xml:lang="grc">ἐνδημοῦντες</char> <char style="w" x-id="SBLGNT.2CO.5.9.006" x-align="2CO.5.9.a006" x-target-ids="t011" x-target="or" x-target-head="t011" x-head="true" lemma="εἴτε" strong="G1535" x-morph="CONJ" x-gloss="or" x-translit="eite" xml:lang="grc">εἴτε</char> <char style="w" x-id="SBLGNT.2CO.5.9.007" x-align="2CO.5.9.a007" x-target-ids="t012" x-target="absent" x-target-head="t012" x-head="true" lemma="ἐκδημέω" strong="G1553" x-morph="V-PAP-NPM" x-gloss="being away" x-translit="ekdēmountes" xml:lang="grc">ἐκδημοῦντες</char>,<char style="w" x-id="SBLGNT.2CO.5.9.008" x-align="2CO.5.9.a008" x-target-ids="t015 t016" x-targe