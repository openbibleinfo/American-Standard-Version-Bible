	<para style="p"><verse number="5" style="v" x-ref="2CO.2.5" sid="2CO 2:5" /><char style="w" x-id="SBLGNT.2CO.2.5.001" x-align="2CO.2.5.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="Ei" xml:lang="grc">Εἰ</char> <char style="w" x-id="SBLGNT.2CO.2.5.002" x-align="2CO.2.5.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δέ</char> <char style="w" x-id="SBLGNT.2CO.2.5.003" x-align="2CO.2.5.a003" x-target-ids="t003" x-target="any" x-target-head="t003" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.2CO.2.5.004" x-align="2CO.2.5.a004" x-target-ids="t004 t005 t006" x-target="hath caused sorrow" x-target-head="t006" x-head="true" lemma="λυπέω" strong="G3076" x-morph="V-RAI-3S" x-gloss="has caused grief" x-translit="lelypēken" xml:lang="grc">λελύπηκεν</char>,<char style="w" x-id="SBLGNT.2CO.2.5.005" x-align="2CO.2.5.a006" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.2CO.2.5.006" x-align="2CO.2.5.a007" x-target-ids="t012 t013" x-target="to me" x-target-head="t013" x-head="true" lemma="ἐγώ" strong="G1691" x-morph="P-1AS" x-gloss="me" x-translit="eme" xml:lang="grc">ἐμὲ</char> <char style="w" x-id="SBLGNT.2CO.2.5.007" x-align="2CO.2.5.a005" x-target-ids="t007 t008 t009 t010" x-target="he hath caused sorrow" x-target-head="t010" x-head="true" lemma="λυπέω" strong="G3076" x-morph="V-RAI-3S" x-gloss="has he grieved" x-translit="lelypēken" xml:lang="grc">λελύπηκεν</char>,<char style="w" x-id="SBLGNT.2CO.2.5.008" x-align="2CO.2.5.a008" x-target-ids="t014" x-target="but" x-target-head="t014" x-head="true" lemma="ἀλλά" strong="G235