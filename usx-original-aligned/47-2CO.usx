	<para style="p"><verse number="12" style="v" x-ref="2CO.8.12" sid="2CO 8:12" /><char style="w" x-id="SBLGNT.2CO.8.12.001" x-align="2CO.8.12.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.2CO.8.12.002" x-align="2CO.8.12.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2CO.8.12.003" x-align="2CO.8.12.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.2CO.8.12.004" x-align="2CO.8.12.a004" x-target-ids="t004" x-target="readiness" x-target-head="t004" x-head="true" lemma="προθυμία" strong="G4288" x-morph="N-NSF" x-gloss="readiness" x-translit="prothymia" xml:lang="grc">προθυμία</char> <char style="w" x-id="SBLGNT.2CO.8.12.005" x-align="2CO.8.12.a005" x-target-ids="t005 t006" x-target="is there" x-target-head="t006" x-head="true" lemma="πρόκειμαι" strong="G4295" x-morph="V-PNI-3S" x-gloss="is present" x-translit="prokeitai" xml:lang="grc">πρόκειται</char>,<char style="w" x-id="SBLGNT.2CO.8.12.006" x-align="2CO.8.12.a007" x-target-ids="t010 t011" x-target="according as" x-target-head="t010" x-head="true" lemma="καθό" strong="G2526" x-morph="ADV" x-gloss="as" x-translit="katho" xml:lang="grc">καθὸ</char> <char style="w" x-id="SBLGNT.2CO.8.12.007" x-align="2CO.8.12.a008" x-status="unrepresented" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.2CO.8.12.008" x-align="2CO.8.12.a009" x-target-ids="t012 t013 t014" x-target="a man hath" x-target-italic-ids="t012 t013" x-target-head="t014" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-P