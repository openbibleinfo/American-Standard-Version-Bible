	<para style="p"><verse number="2" style="v" x-ref="2CO.13.2" sid="2CO 13:2" /><char style="w" x-id="SBLGNT.2CO.13.2.001" x-align="2CO.13.2.a001" x-target-ids="t001 t002 t003 t004" x-target="I have said beforehand" x-target-head="t003" x-head="true" lemma="προλέγω" strong="G4302" x-morph="V-RAI-1S" x-gloss="I have warned" x-translit="proeirēka" xml:lang="grc">προείρηκα</char> <char style="w" x-id="SBLGNT.2CO.13.2.002" x-align="2CO.13.2.a002" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.13.2.003" x-align="2CO.13.2.a003" x-target-ids="t006 t007 t008 t009" x-target="I do say beforehand" x-target-head="t008" x-head="true" lemma="προλέγω" strong="G4302" x-morph="V-PAI-1S" x-gloss="I warn" x-translit="prolegō" xml:lang="grc">προλέγω</char> <char style="w" x-id="SBLGNT.2CO.13.2.004" x-align="2CO.13.2.a004" x-target-ids="t010" x-target="as" x-target-head="t010" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.2CO.13.2.005" x-align="2CO.13.2.a005" x-target-ids="t011 t012 t013 t014" x-target="when I was present" x-target-head="t014" x-head="true" lemma="πάρειμι" strong="G3918" x-morph="V-PAP-NSM" x-gloss="being present" x-translit="parōn" xml:lang="grc">παρὼν</char> <char style="w" x-id="SBLGNT.2CO.13.2.006" x-align="2CO.13.2.a006" x-target-ids="t015 t017" x-target="the time" x-target-head="t017" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.2CO.13.2.007" x-align="2CO.13.2.a007" x-target-ids="t016" x-target="second" x-target-head="t016" x-head="true" lemma="δεύτερος" strong="G1208" x-morph="A-ASN" x-gloss="second time" x-translit="deuteron" xml:lang="grc">δεύτερον</char> <char style="w" x-id="SBLGNT.2CO.13.2.008" x-align="2CO.13.2.a008" x-targ