	<para style="p"><verse number="14" style="v" x-ref="2CO.4.14" sid="2CO 4:14" /><char style="w" x-id="SBLGNT.2CO.4.14.001" x-align="2CO.4.14.a001" x-target-ids="t001" x-target="knowing" x-target-head="t001" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAP-NPM" x-gloss="knowing" x-translit="eidotes" xml:lang="grc">εἰδότες</char> <char style="w" x-id="SBLGNT.2CO.4.14.002" x-align="2CO.4.14.a002" x-target-ids="t002" x-target="that" x-target-head="t002" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.2CO.4.14.003" x-align="2CO.4.14.a003" x-target-ids="t003" x-target="he" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the [One]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.2CO.4.14.004" x-align="2CO.4.14.a004" x-target-ids="t004 t005 t006" x-target="that raised up" x-target-head="t005" x-head="true" lemma="ἐγείρω" strong="G1453" x-morph="V-AAP-NSM" x-gloss="having raised up" x-translit="egeiras" xml:lang="grc">ἐγείρας</char> <char style="w" x-id="SBLGNT.2CO.4.14.005" x-align="2CO.4.14.a005" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.2CO.4.14.v009.r01.001" x-align="2CO.4.14.a006" x-target-ids="t008" x-target="Lord" x-target-head="t008" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-ASM" x-gloss="lord" x-translit="kyrion" xml:lang="grc">κύριον</char> <char style="w" x-id="SBLGNT.2CO.4.14.006" x-align="2CO.4.14.a007" x-target-ids="t009" x-target="Jesus" x-target-head="t009" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-ASM" x-gloss="Jesus" x-translit="Iēsoun" xml:lang="grc">Ἰησοῦν</char> <char style="w" x-id="SBLGNT.2CO.4.14.007" x-align="2CO.4.14.a010" x-target-ids="t014" x-target="also" x-target-head="t014" x-head="true" lemma="καί" strong="