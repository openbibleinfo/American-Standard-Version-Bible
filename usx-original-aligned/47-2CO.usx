	<para style="p"><verse number="15" style="v" x-ref="2CO.3.15" sid="2CO 3:15" /><char style="w" x-id="SBLGNT.2CO.3.15.001" x-align="2CO.3.15.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.2CO.3.15.002" x-align="2CO.3.15.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="ἕως" strong="G2193" x-morph="ADV" x-gloss="unto" x-translit="heōs" xml:lang="grc">ἕως</char> <char style="w" x-id="SBLGNT.2CO.3.15.003" x-align="2CO.3.15.a003" x-target-ids="t003 t004" x-target="this day" x-target-head="t004" x-head="true" lemma="σήμερον" strong="G4594" x-morph="ADV" x-gloss="this day" x-translit="sēmeron" xml:lang="grc">σήμερον</char> <char style="w" x-id="SBLGNT.2CO.3.15.004" x-align="2CO.3.15.a004" x-target-ids="t005" x-target="whensoever" x-target-head="t005" x-head="true" lemma="ἡνίκα" strong="G2259" x-morph="ADV" x-gloss="when" x-translit="hēnika" xml:lang="grc">ἡνίκα</char> <char style="w" x-id="SBLGNT.2CO.3.15.005" x-align="2CO.3.15.a004" lemma="ἄν" strong="G302" x-morph="PRT" x-gloss="-" x-translit="an" xml:lang="grc">ἂν</char> <char style="w" x-id="SBLGNT.2CO.3.15.006" x-align="2CO.3.15.a006" x-target-ids="t007 t008" x-target="is read" x-target-head="t008" x-head="true" lemma="ἀναγινώσκω" strong="G314" x-morph="V-PPS-3S" x-gloss="shall be read" x-translit="anaginōskētai" xml:lang="grc">ἀναγινώσκηται</char> <char style="w" x-id="SBLGNT.2CO.3.15.007" x-align="2CO.3.15.a005" x-target-ids="t006" x-target="Moses" x-target-head="t006" x-head="true" lemma="Μωϋσῆς" strong="G3475" x-morph="N-NSM" x-gloss="Moses" x-translit="Mōysēs" xml:lang="grc">Μωϋσῆς</char> <char style="w" x-id="SBLGNT.2CO.3.15.008" x-align="2CO.3.15.a007" x-target-ids="t009 t010" x-target="a veil" x-target-head="t010" x-head="true" lemma="κάλυμμα" strong="G2571" x-morph="N-NSN" x-gloss="a veil" x-translit="kalymma" xml:lang="