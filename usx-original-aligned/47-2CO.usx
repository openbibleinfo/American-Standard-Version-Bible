	<para style="p"><verse number="1" style="v" x-ref="2CO.11.1" sid="2CO 11:1" /><char style="w" x-id="SBLGNT.2CO.11.1.001" x-align="2CO.11.1.a001" x-target-ids="t001 t002" x-target="Would that" x-target-head="t001" x-head="true" lemma="ὄφελον" strong="G3785" x-morph="V-2AAI-1S" x-gloss="I wish" x-translit="Ophelon" xml:lang="grc">Ὄφελον</char> <char style="w" x-id="SBLGNT.2CO.11.1.002" x-align="2CO.11.1.a002" x-target-ids="t003 t004 t005 t006" x-target="ye could bear with" x-target-head="t005" x-head="true" lemma="ἀναιρέω" strong="G337" x-morph="V-INI-2P" x-gloss="you were bearing with" x-translit="aneichesthe" xml:lang="grc">ἀνείχεσθέ</char> <char style="w" x-id="SBLGNT.2CO.11.1.003" x-align="2CO.11.1.a003" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="me" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.2CO.11.1.004" x-align="2CO.11.1.a006" x-target-ids="t010" x-target="little" x-target-head="t010" x-head="true" lemma="μικρός" strong="G3398" x-morph="A-ASN" x-gloss="little" x-translit="mikron" xml:lang="grc">μικρόν</char> <char style="w" x-id="SBLGNT.2CO.11.1.005" x-align="2CO.11.1.a005" x-target-ids="t009" x-target="a" x-target-head="t009" x-head="true" lemma="τις" strong="G5100" x-morph="X-ASN" x-gloss="a" x-translit="ti" xml:lang="grc">τι</char> <char style="w" x-id="SBLGNT.2CO.11.1.006" x-align="2CO.11.1.a004" x-target-ids="t008 t011" x-target="in foolishness" x-target-head="t011" x-head="true" lemma="ἀφροσύνη" strong="G877" x-morph="N-GSF" x-gloss="in foolishness" x-translit="aphrosynēs" xml:lang="grc">ἀφροσύνης</char>·<char style="w" x-id="SBLGNT.2CO.11.1.007" x-align="2CO.11.1.a007" x-target-ids="t012" x-target="but" x-target-head="t012" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.2CO.11.1.008" x-align="2CO.11.1.a008" x-target-ids="t013" x-target="indeed" x-target