	<para style="p"><verse number="3" style="v" x-ref="2CO.2.3" sid="2CO 2:3" /><char style="w" x-id="SBLGNT.2CO.2.3.001" x-align="2CO.2.3.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2CO.2.3.002" x-align="2CO.2.3.a002" x-target-ids="t002 t003" x-target="I wrote" x-target-head="t003" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-AAI-1S" x-gloss="I wrote" x-translit="egrapsa" xml:lang="grc">ἔγραψα</char> <char style="w" x-id="SBLGNT.2CO.2.3.003" x-align="2CO.2.3.a003" x-target-ids="t004 t006" x-target="this thing" x-target-head="t004" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.2CO.2.3.004" x-align="2CO.2.3.a004" x-target-ids="t005" x-target="very" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASN" x-gloss="same thing" x-translit="auto" xml:lang="grc">αὐτὸ</char> <char style="w" x-id="SBLGNT.2CO.2.3.005" x-align="2CO.2.3.a005" x-status="noncompositional" x-target-ids="t007" x-target="lest" x-target-head="t007" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.2CO.2.3.006" x-align="2CO.2.3.a005" x-status="noncompositional" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.2CO.2.3.007" x-align="2CO.2.3.a006" x-target-ids="t008 t009 t010" x-target="when I came" x-target-head="t010" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAP-NSM" x-gloss="having come" x-translit="elthōn" xml:lang="grc">ἐλθὼν</char> <char style="w" x-id="SBLGNT.2CO.2.3.008" x-align="2CO.2.3.a007" x-target-ids="t014" x-target="sorrow" x-target-head="t014" x-head="true" lemma="λύπη" strong="G3077" x-morph="N-ASF" x-gloss="grief