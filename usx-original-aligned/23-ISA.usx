	<para style="p"><verse number="11" style="v" x-ref="ISA.1.11" sid="ISA 1:11" /><char style="w" x-id="WLC.ISA.1.11.001" x-align="ISA.1.11.a001" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.1.11.002" x-align="ISA.1.11.a001" x-target-ids="t001 t004" x-target="What is" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ-" xml:lang="hbo">מָּה</char>־<char style="w" x-id="WLC.ISA.1.11.003" x-align="ISA.1.11.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לִּ֤</char><char style="w" x-id="WLC.ISA.1.11.004" x-align="ISA.1.11.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.1.11.005" x-align="ISA.1.11.a004" x-target-ids="t005 t006" x-target="the multitude" x-target-head="t006" x-head="true" lemma="רֹב" strong="H7230" x-morph="Ncbsc" x-gloss="the.multitude" x-translit="rōḇ-" xml:lang="hbo">רֹב</char>־<char style="w" x-id="WLC.ISA.1.11.006" x-align="ISA.1.11.a005" x-target-ids="t007 t009" x-target="of sacrifices" x-target-head="t009" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmpc" x-gloss="your.sacrifices" x-translit="ziḇḥēy" xml:lang="hbo">זִבְחֵי</char><char style="w" x-id="WLC.ISA.1.11.007" x-align="ISA.1.11.a006" x-target-ids="t008" x-target="your" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶם֙</char> <char style="w" x-id="WLC.ISA.1.11.008" x-align="ISA.1.11.a007" x-target-ids="t010" x-target="saith" x-target-head="t010" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3ms" x-gloss="he.says" x-translit="yōʾmar" xml:lang="hbo">יֹאמַ֣ר</char> <char style="w" x-id="WLC.ISA.1.11.009" x-align="ISA.1.11.a008" x-target-ids="t011" x-target="Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֔ה</char> <char style="w" x-id="WLC.ISA.1.11.010" x-align="ISA.1.11.a009" x-target-ids="t012 t013 t014 t015 t016" x-target="I have had enough of" x-target-head="t015" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqp1cs" x-gloss="I.have.been.surfeited" x-translit="śāḇaʿətî" xml:lang="hbo">שָׂבַ֛עְתִּי</char> <char style="w" x-id="WLC.ISA.1.11.011" x-align="ISA.1.11.a010" x-target-ids="t017 t018 t019" x-target="the burnt offerings" x-target-head="t018" x-head="true" lemma="עֹלָה" strong="H5930" x-morph="Ncfpc" x-gloss="burnt.offerings" x-translit="ʿōlôṯ" xml:lang="hbo">עֹל֥וֹת</char> <char style="w" x-id="WLC.ISA.1.11.012" x-align="ISA.1.11.a011" x-target-ids="t020 t021" x-target="of rams" x-target-head="t021" x-head="true" lemma="אַיִל" strong="H352" x-morph="Ncmpa" x-gloss="of.rams" x-translit="ʾêliym" xml:lang="hbo">אֵילִ֖ים</char> <char style="w" x-id="WLC.ISA.1.11.013" x-align="ISA.1.11.a012" x-target-ids="t022" x-target="and" x-target-head="t022" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.1.11.014" x-align="ISA.1.11.a013" x-target-ids="t023 t024" x-target="the fat" x-target-head="t024" x-head="true" lemma="חֵלֶב" strong="H2459" x-morph="Ncmsc" x-gloss="fat" x-translit="ḥēleḇ" xml:lang="hbo">חֵ֣לֶב</char> <char style="w" x-id="WLC.ISA.1.11.015" x-align="ISA.1.11.a014" x-target-ids="t025 t026 t027" x-target="of fed beasts" x-target-head="t026" x-head="true" lemma="מְרִיא" strong="H4806" x-morph="Ncmpa" x-gloss="of.fatlings" x-translit="mərîʾiym" xml:lang="hbo">מְרִיאִ֑ים</char> <char style="w" x-id="WLC.ISA.1.11.016" x-align="ISA.1.11.a015" x-target-ids="t028" x-target="and" x-target-head="t028" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit=