	<para style="p"><verse number="19" style="v" x-ref="ISA.1.19" sid="ISA 1:19" /><char style="w" x-id="WLC.ISA.1.19.001" x-align="ISA.1.19.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.ISA.1.19.002" x-align="ISA.1.19.a002" x-target-ids="t002 t003 t004" x-target="ye be willing" x-target-head="t004" x-head="true" lemma="אָבָה" strong="H14" x-morph="Vqi2mp" x-gloss="you.will.be.willing" x-translit="tōʾḇû" xml:lang="hbo">תֹּאב֖וּ</char> <char style="w" x-id="WLC.ISA.1.19.003" x-align="ISA.1.19.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.1.19.004" x-align="ISA.1.19.a004" x-target-ids="t006" x-target="obedient" x-target-head="t006" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqq2mp" x-gloss="you.will.obey" x-translit="šəmaʿtem" xml:lang="hbo">שְׁמַעְתֶּ֑ם</char> <char style="w" x-id="WLC.ISA.1.19.005" x-align="ISA.1.19.a005" x-target-ids="t010 t011" x-target="the good" x-target-head="t011" x-head="true" lemma="טוּב" strong="H2898" x-morph="Ncmsc" x-gloss="the.good.thing[s]" x-translit="ṭûḇ" xml:lang="hbo">ט֥וּב</char> <char style="w" x-id="WLC.ISA.1.19.006" x-align="ISA.1.19.a006" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.ISA.1.19.007" x-align="ISA.1.19.a007" x-target-ids="t012 t014" x-target="of land" x-target-head="t014" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="the.land" x-translit="ʾāreṣ" xml:lang="hbo">אָ֖רֶץ</char> <char style="w" x-id="WLC.ISA.1.19.008" x-align="ISA.1.19.a008" x-target-ids="t007 t008 t009" x-target="ye shall eat" x-target-head="t009" x-head="true" lemma="אָכַל" strong="H398