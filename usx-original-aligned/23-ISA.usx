	<para style="p"><verse number="10" style="v" x-ref="ISA.19.10" sid="ISA 19:10" /><char style="w" x-id="WLC.ISA.19.10.001" x-align="ISA.19.10.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.19.10.002" x-align="ISA.19.10.a002" x-target-ids="t006 t007" x-target="shall be" x-target-head="t007" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3cp" x-gloss="they.will.be" x-translit="hāyû" xml:lang="hbo">הָי֥וּ</char> <char style="w" x-id="WLC.ISA.19.10.003" x-align="ISA.19.10.a003" x-target-ids="t002 t003" x-target="the pillars" x-target-head="t003" x-head="true" lemma="שָׁתֹת" strong="H8356" x-morph="Ncmpc" x-gloss="foundations" x-translit="šāṯōṯey" xml:lang="hbo">שָׁתֹתֶ֖י</char><char style="w" x-id="WLC.ISA.19.10.004" x-align="ISA.19.10.a004" x-target-ids="t004 t005" x-target="of Egypt" x-target-italic-ids="t004 t005" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.ISA.19.10.005" x-align="ISA.19.10.a005" x-target-ids="t008 t009 t010" x-target="broken in pieces" x-target-head="t008" x-head="true" lemma="דָּכָא" strong="H1792" x-morph="VPsmpa" x-gloss="crushed" x-translit="məḏukkāʾiym" xml:lang="hbo">מְדֻכָּאִ֑ים</char> <char style="w" x-id="WLC.ISA.19.10.006" x-align="ISA.19.10.a006" x-target-ids="t011" x-target="all" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.19.10.007" x-align="ISA.19.10.a007" x-target-ids="t012 t013 t014" x-target="they that work" x-target-head="t014" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmpc" x-gloss="[those.who].work" x-translit="ʿōśê" xml:lang="hbo">עֹ֥שֵׂי</char> <char style="w" x-id="WLC.ISA.19.10.008" x-align="ISA.19.10.a008" x-target-ids