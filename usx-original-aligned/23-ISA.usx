	<para style="p"><verse number="20" style="v" x-ref="ISA.51.20" sid="ISA 51:20" /><char style="w" x-id="WLC.ISA.51.20.001" x-align="ISA.51.20.a001" x-target-ids="t002" x-target="sons" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="bānay" xml:lang="hbo">בָּנַ֜יִ</char><char style="w" x-id="WLC.ISA.51.20.002" x-align="ISA.51.20.a002" x-target-ids="t001" x-target="Thy" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="iḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.51.20.003" x-align="ISA.51.20.a003" x-target-ids="t003 t004" x-target="have fainted" x-target-head="t004" x-head="true" lemma="עָלַף" strong="H5968" x-morph="VPp3cp" x-gloss="they.have.become.faint" x-translit="ʿulləp̄û" xml:lang="hbo">עֻלְּפ֥וּ</char> <char style="w" x-id="WLC.ISA.51.20.004" x-align="ISA.51.20.a004" x-target-ids="t005 t006" x-target="they lie" x-target-head="t006" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqp3cp" x-gloss="they.have.lain.down" x-translit="šāḵəḇû" xml:lang="hbo">שָׁכְב֛וּ</char> <char style="w" x-id="WLC.ISA.51.20.005" x-align="ISA.51.20.a005" x-target-ids="t007" x-target="at" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.51.20.006" x-align="ISA.51.20.a006" x-target-ids="t008 t009" x-target="the head" x-target-head="t009" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsc" x-gloss="head" x-translit="rōʾš" xml:lang="hbo">רֹ֥אשׁ</char> <char style="w" x-id="WLC.ISA.51.20.007" x-align="ISA.51.20.a007" x-target-ids="t010 t011" x-target="of all" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.51.20.008" x-align="ISA.51.20.a008" x-target-ids="t012 t013" x-target="the streets" x-target-head="t013" x-