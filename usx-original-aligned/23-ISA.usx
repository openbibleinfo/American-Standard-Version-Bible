	<para style="p"><verse number="1" style="v" x-ref="ISA.64.1" sid="ISA 64:1" /><char style="w" x-id="WLC.ISA.64.1.001" x-align="ISA.64.1.a001" x-target-ids="t001 t002" x-target="Oh that" x-target-head="t001" x-head="true" lemma="לוּ" strong="H3863" x-morph="C" x-gloss="if" x-translit="lûʾ-" xml:lang="hbo" x-source-ref="ISA.63.19">לוּא</char>־<char style="w" x-id="WLC.ISA.64.1.002" x-align="ISA.64.1.a002" x-target-ids="t003 t004 t005" x-target="thou wouldest rend" x-target-head="t005" x-head="true" lemma="קָרַע" strong="H7167" x-morph="Vqp2ms" x-gloss="you.tore" x-translit="qāraʿətā" xml:lang="hbo" x-source-ref="ISA.63.19">קָרַ֤עְתָּ</char> <char style="w" x-id="WLC.ISA.64.1.003" x-align="ISA.64.1.a003" x-target-ids="t006 t007" x-target="the heavens" x-target-head="t007" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="[the].heavens" x-translit="šāmayim" xml:lang="hbo" x-source-ref="ISA.63.19">שָׁמַ֨יִם֙</char> <char style="w" x-id="WLC.ISA.64.1.004" x-align="ISA.64.1.a004" x-target-ids="t008 t009 t010 t011 t012" x-target="that thou wouldest come down" x-target-head="t011" x-head="true" lemma="יָרַד" strong="H3381" x-morph="Vqp2ms" x-gloss="you.came.down" x-translit="yāraḏətā" xml:lang="hbo" x-source-ref="ISA.63.19">יָרַ֔דְתָּ</char> <char style="w" x-id="WLC.ISA.64.1.005" x-align="ISA.64.1.a005" x-target-ids="t018" x-target="at" x-target-head="t018" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="ISA.63.19">מִ</char><char style="w" x-id="WLC.ISA.64.1.006" x-align="ISA.64.1.a006" x-target-ids="t020" x-target="presence" x-target-head="t020" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="before" x-translit="pāney" xml:lang="hbo" x-source-ref="ISA.63.19">פָּנֶ֖י</char><char style="w" x-id="WLC.ISA.64.1.007" x-align="ISA.64.1.a007" x-target-ids="t019" x-target="thy" x-target-head="t019" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-tra