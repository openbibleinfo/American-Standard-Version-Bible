	<para style="p"><verse number="6" style="v" x-ref="ISA.10.6" sid="ISA 10:6" /><char style="w" x-id="WLC.ISA.10.6.001" x-align="ISA.10.6.a001" x-target-ids="t005" x-target="against" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.10.6.002" x-align="ISA.10.6.a002" x-target-ids="t006 t008" x-target="a nation" x-target-head="t008" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="a.nation" x-translit="ḡôy" xml:lang="hbo">ג֤וֹי</char> <char style="w" x-id="WLC.ISA.10.6.003" x-align="ISA.10.6.a003" x-target-ids="t007" x-target="profane" x-target-head="t007" x-head="true" lemma="חָנֵף" strong="H2611" x-morph="Aamsa" x-gloss="godless" x-translit="ḥānēp̄" xml:lang="hbo">חָנֵף֙</char> <char style="w" x-id="WLC.ISA.10.6.004" x-align="ISA.10.6.a004" x-target-ids="t001 t002 t003" x-target="I will send" x-target-head="t003" x-head="true" lemma="שָׁלַח" strong="H7971" x-morph="Vpi1cs" x-gloss="I" x-translit="ʾăšalləḥ" xml:lang="hbo">אֲשַׁלְּחֶ֔</char><char style="w" x-id="WLC.ISA.10.6.005" x-align="ISA.10.6.a005" x-target-ids="t004" x-target="him" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="sent.him" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.ISA.10.6.006" x-align="ISA.10.6.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.10.6.007" x-align="ISA.10.6.a007" x-target-ids="t010" x-target="against" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.10.6.008" x-align="ISA.10.6.a008" x-target-ids="t011 t012" x-target="the people" x-target-head="t012" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="the.people" x-trans