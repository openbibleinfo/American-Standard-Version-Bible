	<para style="p"><verse number="29" style="v" x-ref="ISA.10.29" x-added-alignments="ISA.10.29.a003" x-added-target-ids="t007 t008 t009 t010" x-added-target="they have taken up" sid="ISA 10:29" /><char style="w" x-id="WLC.ISA.10.29.001" x-align="ISA.10.29.a001" x-target-ids="t001 t002 t003 t004" x-target="they are gone over" x-target-head="t003" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqp3cp" x-gloss="they.have.passed.over" x-translit="ʿāḇərû" xml:lang="hbo">עָֽבְרוּ֙</char> <char style="w" x-id="WLC.ISA.10.29.002" x-align="ISA.10.29.a002" x-target-ids="t005 t006" x-target="the pass" x-target-head="t006" x-head="true" lemma="מַעֲבָרָה" strong="H4569a" x-morph="Ncfsa" x-gloss="[the].pass" x-translit="maʿbārāh" xml:lang="hbo">מַעְבָּרָ֔ה</char> <char style="w" x-id="WLC.ISA.10.29.003" x-align="ISA.10.29.a004" x-target-ids="t013 t014" x-target="at Geba" x-target-head="t014" x-head="true" lemma="גֶּבַע" strong="H1387" x-morph="Np" x-gloss="Geba" x-translit="geḇaʿ" xml:lang="hbo">גֶּ֖בַע</char> <char style="w" x-id="WLC.ISA.10.29.004" x-align="ISA.10.29.a005" x-target-ids="t012" x-target="lodging" x-target-head="t012" x-head="true" lemma="מָלוֹן" strong="H4411" x-morph="Ncmsa" x-gloss="[will.be].a.lodging.place" x-translit="mālôn" xml:lang="hbo">מָל֣וֹן</char> <char style="w" x-id="WLC.ISA.10.29.005" x-align="ISA.10.29.a006" x-status="unrepresented" x-head="true" lemma="לין" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לָ֑</char><char style="w" x-id="WLC.ISA.10.29.006" x-align="ISA.10.29.a007" x-target-ids="t011" x-target="their" x-target-head="t011" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ānû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.ISA.10.29.007" x-align="ISA.10.29.a008" x-target-ids="t016" x-target="trembleth" x-target-head="t016" x-head="true" lemma="חָרַד" strong="H2729" x-morph="Vqp3fs" x-gloss="it.has.trembled" x-translit="ḥārəḏāh" xml:lang="hbo">חָֽרְדָה֙</char> <char st