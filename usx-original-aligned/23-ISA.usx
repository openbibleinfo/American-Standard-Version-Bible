	<para style="p"><verse number="8" style="v" x-ref="ISA.43.8" sid="ISA 43:8" /><char style="w" x-id="WLC.ISA.43.8.001" x-align="ISA.43.8.a001" x-target-ids="t001 t002" x-target="Bring forth" x-target-head="t001" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vhv2ms" x-gloss="bring.out" x-translit="hôṣiyʾ" xml:lang="hbo">הוֹצִ֥יא</char> <char style="w" x-id="WLC.ISA.43.8.002" x-align="ISA.43.8.a002" x-target-ids="t003 t005" x-target="the people" x-target-head="t005" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿam-" xml:lang="hbo">עַם</char>־<char style="w" x-id="WLC.ISA.43.8.003" x-align="ISA.43.8.a003" x-target-ids="t004" x-target="blind" x-target-head="t004" x-head="true" lemma="עִוֵּר" strong="H5787" x-morph="Aamsa" x-gloss="blind" x-translit="ʿiwwēr" xml:lang="hbo">עִוֵּ֖ר</char> <char style="w" x-id="WLC.ISA.43.8.004" x-align="ISA.43.8.a004" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.8.005" x-align="ISA.43.8.a005" x-target-ids="t008" x-target="eyes" x-target-head="t008" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbda" x-gloss="eyes" x-translit="ʿênayim" xml:lang="hbo">עֵינַ֣יִם</char> <char style="w" x-id="WLC.ISA.43.8.006" x-align="ISA.43.8.a006" x-target-ids="t007" x-target="have" x-target-head="t007" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[are]" x-translit="yēš" xml:lang="hbo">יֵ֑שׁ</char> <char style="w" x-id="WLC.ISA.43.8.007" x-align="ISA.43.8.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.8.008" x-align="ISA.43.8.a008" x-target-ids="t010 t011" x-target="the deaf" x-target-head="t011" x-head="true" lemma="חֵרֵשׁ" strong="H2795" x-morph="Aampa" x-gloss="deaf.[people