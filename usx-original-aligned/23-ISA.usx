	<para style="p"><verse number="18" style="v" x-ref="ISA.41.18" sid="ISA 41:18" /><char style="w" x-id="WLC.ISA.41.18.001" x-align="ISA.41.18.a001" x-target-ids="t001 t002 t003" x-target="I will open" x-target-head="t003" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="Vqi1cs" x-gloss="I.will.open" x-translit="ʾep̄taḥ" xml:lang="hbo">אֶפְתַּ֤ח</char> <char style="w" x-id="WLC.ISA.41.18.002" x-align="ISA.41.18.a002" x-target-ids="t005" x-target="on" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.41.18.003" x-align="ISA.41.18.a003" x-target-ids="t006 t007 t008" x-target="the bare heights" x-target-head="t007" x-head="true" lemma="שְׁפִי" strong="H8205" x-morph="Ncmpa" x-gloss="bare.heights" x-translit="šəp̄āyîm" xml:lang="hbo">שְׁפָיִים֙</char> <char style="w" x-id="WLC.ISA.41.18.004" x-align="ISA.41.18.a004" x-target-ids="t004" x-target="rivers" x-target-head="t004" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmpa" x-gloss="rivers" x-translit="nəhārôṯ" xml:lang="hbo">נְהָר֔וֹת</char> <char style="w" x-id="WLC.ISA.41.18.005" x-align="ISA.41.18.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.41.18.006" x-align="ISA.41.18.a006" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.ISA.41.18.007" x-align="ISA.41.18.a007" x-target-ids="t012 t013" x-target="the midst" x-target-head="t013" x-head="true" lemma="תָּוֶךְ" strong="H8432" x-morph="Ncmsc" x-gloss="middle" x-translit="ṯôḵ" xml:lang="hbo">ת֥וֹךְ</char> <char style="w" x-id="WLC.ISA.41.18.008" x-align="ISA.41.18.a008" x-target-ids="t014 t015 t016" x-target="of the valleys" x-target-head="t016" x-head="true"