	<para style="p"><verse number="21" style="v" x-ref="ISA.51.21" sid="ISA 51:21" /><char style="w" x-id="WLC.ISA.51.21.001" x-align="ISA.51.21.a001" x-status="noncompositional" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.51.21.002" x-align="ISA.51.21.a001" x-status="noncompositional" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֛ן</char> <char style="w" x-id="WLC.ISA.51.21.003" x-align="ISA.51.21.a002" x-target-ids="t002" x-target="hear" x-target-head="t002" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2fs" x-gloss="hear" x-translit="šimʿî-" xml:lang="hbo">שִׁמְעִי</char>־<char style="w" x-id="WLC.ISA.51.21.004" x-align="ISA.51.21.a003" x-target-ids="t003" x-target="now" x-target-head="t003" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֥א</char> <char style="w" x-id="WLC.ISA.51.21.005" x-align="ISA.51.21.a004" x-target-ids="t004" x-target="this" x-target-head="t004" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֖את</char> <char style="w" x-id="WLC.ISA.51.21.006" x-align="ISA.51.21.a005" x-target-ids="t005 t006" x-target="thou afflicted" x-target-head="t006" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aafsa" x-gloss="O.afflicted.[one]" x-translit="ʿăniyyāh" xml:lang="hbo">עֲנִיָּ֑ה</char> <char style="w" x-id="WLC.ISA.51.21.007" x-align="ISA.51.21.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.51.21.008" x-align="ISA.51.21.a007" x-target-ids="t008" x-target="drunken" x-target-head="t008" x-head="true" lemma="שָׁכַר" strong="H7937a" x-morph="Aafsc" x-gloss="O.drunken.[one]" x-translit="šəḵuraṯ