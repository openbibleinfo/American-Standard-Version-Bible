	<para style="p"><verse number="2" style="v" x-ref="ISA.43.2" sid="ISA 43:2" /><char style="w" x-id="WLC.ISA.43.2.001" x-align="ISA.43.2.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.43.2.002" x-align="ISA.43.2.a002" x-target-ids="t002 t003" x-target="thou passest" x-target-head="t003" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqi2ms" x-gloss="you.will.pass" x-translit="ṯaʿăḇōr" xml:lang="hbo">תַעֲבֹ֤ר</char> <char style="w" x-id="WLC.ISA.43.2.003" x-align="ISA.43.2.a003" x-target-ids="t004" x-target="through" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.ISA.43.2.004" x-align="ISA.43.2.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.43.2.005" x-align="ISA.43.2.a005" x-target-ids="t006" x-target="waters" x-target-head="t006" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="waters" x-translit="mmayim" xml:lang="hbo">מַּ֨יִם֙</char> <char style="w" x-id="WLC.ISA.43.2.006" x-align="ISA.43.2.a006" x-target-ids="t008 t009 t010" x-target="will be with" x-target-head="t010" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="[will" x-translit="ʾitt" xml:lang="hbo">אִתְּ</char><char style="w" x-id="WLC.ISA.43.2.007" x-align="ISA.43.2.a007" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="be].with.you" x-translit="əḵā-" xml:lang="hbo">ךָ</char>־<char style="w" x-id="WLC.ISA.43.2.008" x-align="ISA.43.2.a008" x-target-ids="t007" x-target="I" x-target-head="t007" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānî" xml:lang="hbo">אָ֔נִי</char> <char style="w" x-id="WLC.ISA.43.2.009" x-align="ISA.43.2.a009" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.43.2.010" x-align="ISA.43.2.a010" x-target-ids="t013" x-target="through" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ḇa" xml:lang="hbo">בַ</char><char style="w" x-id="WLC.ISA.43.2.011" x-align="ISA.43.2.a011" x-target-ids="t014" x-target="the" x-target-head="t014" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.43.2.012" x-align="ISA.43.2.a012" x-target-ids="t015" x-target="rivers" x-target-head="t015" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmpa" x-gloss="rivers" x-translit="nnəhārôṯ" xml:lang="hbo">נְּהָר֖וֹת</char> <char style="w" x-id="WLC.ISA.43.2.013" x-align="ISA.43.2.a013" x-target-ids="t018" x-target="not" x-target-head="t018" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.43.2.014" x-align="ISA.43.2.a014" x-target-ids="t016 t017 t019" x-target="they shall overflow" x-target-head="t019" x-head="true" lemma="שָׁטַף" strong="H7857" x-morph="Vqi3mp" x-gloss="they" x-translit="yišṭəp̄û" xml:lang="hbo">יִשְׁטְפ֑וּ</char><char style="w" x-id="WLC.ISA.43.2.015" x-align="ISA.43.2.a015" x-target-ids="t020" x-target="thee" x-target-head="t020" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.overflow.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.43.2.016" x-align="ISA.43.2.a016" x-target-ids="t021" x-target="when" x-target-head="t021" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.4