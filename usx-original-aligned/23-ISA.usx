	<para style="p"><verse number="12" style="v" x-ref="ISA.1.12" sid="ISA 1:12" /><char style="w" x-id="WLC.ISA.1.12.001" x-align="ISA.1.12.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.ISA.1.12.002" x-align="ISA.1.12.a002" x-target-ids="t002 t003" x-target="ye come" x-target-head="t003" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi2mp" x-gloss="you.come" x-translit="ṯāḇōʾû" xml:lang="hbo">תָבֹ֔אוּ</char> <char style="w" x-id="WLC.ISA.1.12.003" x-align="ISA.1.12.a003" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo">לֵ</char><char style="w" x-id="WLC.ISA.1.12.004" x-align="ISA.1.12.a004" x-target-ids="t005" x-target="appear" x-target-head="t005" x-head="true" lemma="רָאָה" strong="H7200" x-morph="VNc" x-gloss="present.yourselves" x-translit="rāʾôṯ" xml:lang="hbo">רָא֖וֹת</char> <char style="w" x-id="WLC.ISA.1.12.005" x-align="ISA.1.12.a005" x-target-ids="t006" x-target="before" x-target-head="t006" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="presence" x-translit="pān" xml:lang="hbo">פָּנָ֑</char><char style="w" x-id="WLC.ISA.1.12.006" x-align="ISA.1.12.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.1.12.007" x-align="ISA.1.12.a007" x-target-ids="t008" x-target="who" x-target-head="t008" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="mî-" xml:lang="hbo">מִי</char>־<char style="w" x-id="WLC.ISA.1.12.008" x-align="ISA.1.12.a008" x-target-ids="t009 t010" x-target="hath required" x-target-head="t010" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vpp3ms" x-gloss="did.he.require" x-translit="