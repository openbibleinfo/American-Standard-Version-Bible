	<para style="p"><verse number="10" style="v" x-ref="ISA.43.10" sid="ISA 43:10" /><char style="w" x-id="WLC.ISA.43.10.001" x-align="ISA.43.10.a001" x-target-ids="t001" x-target="Ye" x-target-head="t001" x-head="true" lemma="אַתֶּם" strong="H859a" x-morph="Pp2mp" x-gloss="you" x-translit="ʾattem" xml:lang="hbo">אַתֶּ֤ם</char> <char style="w" x-id="WLC.ISA.43.10.002" x-align="ISA.43.10.a002" x-target-ids="t002 t004" x-target="are witnesses" x-target-head="t004" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmpc" x-gloss="witnesses" x-translit="ʿēḏ" xml:lang="hbo">עֵדַ</char><char style="w" x-id="WLC.ISA.43.10.003" x-align="ISA.43.10.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[are].my" x-translit="ay" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.43.10.004" x-align="ISA.43.10.a004" x-target-ids="t005" x-target="saith" x-target-head="t005" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum-" xml:lang="hbo">נְאֻם</char>־<char style="w" x-id="WLC.ISA.43.10.005" x-align="ISA.43.10.a005" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֔ה</char> <char style="w" x-id="WLC.ISA.43.10.006" x-align="ISA.43.10.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.10.007" x-align="ISA.43.10.a007" x-target-ids="t009" x-target="servant" x-target-head="t009" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo">עַבְדִּ֖</char><char style="w" x-id="WLC.ISA.43.10.008" x-align="ISA.43.10.a008" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="m