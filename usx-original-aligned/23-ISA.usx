	<para style="p"><verse number="13" style="v" x-ref="ISA.48.13" x-added-alignments="ISA.48.13.a011" x-added-target-ids="t020" x-added-target="when" sid="ISA 48:13" /><char style="w" x-id="WLC.ISA.48.13.001" x-align="ISA.48.13.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo">אַף</char>־<char style="w" x-id="WLC.ISA.48.13.002" x-align="ISA.48.13.a003" x-target-ids="t003" x-target="hand" x-target-head="t003" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָדִ</char><char style="w" x-id="WLC.ISA.48.13.003" x-align="ISA.48.13.a002" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.48.13.004" x-align="ISA.48.13.a004" x-target-ids="t004 t005 t006 t007" x-target="hath laid the foundation" x-target-head="t007" x-head="true" lemma="יָסַד" strong="H3245" x-morph="Vqp3fs" x-gloss="it.founded" x-translit="yāsəḏâ" xml:lang="hbo">יָ֣סְדָה</char> <char style="w" x-id="WLC.ISA.48.13.005" x-align="ISA.48.13.a005" x-target-ids="t008 t009 t010" x-target="of the earth" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].earth" x-translit="ʾereṣ" xml:lang="hbo">אֶ֔רֶץ</char> <char style="w" x-id="WLC.ISA.48.13.006" x-align="ISA.48.13.a006" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִֽ</char><char style="w" x-id="WLC.ISA.48.13.007" x-align="ISA.48.13.a008" x-target-ids="t013 t014" x-target="right hand" x-target-head="t013" x-head="true" lemma="יָמִין" strong="H3225" x-morph="Ncfsc" x-gloss="my.right" x-translit="ymiyn" xml:lang="hbo">ימִינִ֖</char><char style="w" x-id="WLC.ISA.48.13.008" x-align="ISA.48.13.a007" x-target-id