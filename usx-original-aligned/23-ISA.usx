	<para style="p"><verse number="18" style="v" x-ref="ISA.63.18" sid="ISA 63:18" /><char style="w" x-id="WLC.ISA.63.18.001" x-align="ISA.63.18.a001" x-target-ids="t006" x-target="but" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for.(the)" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.ISA.63.18.002" x-align="ISA.63.18.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="small" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.63.18.003" x-align="ISA.63.18.a003" x-target-ids="t007 t008 t009" x-target="a little while" x-target-head="t008" x-head="true" lemma="מִצְעָר" strong="H4705" x-morph="Ncmsa" x-gloss="time" x-translit="mmiṣʿār" xml:lang="hbo">מִּצְעָ֕ר</char> <char style="w" x-id="WLC.ISA.63.18.004" x-align="ISA.63.18.a004" x-target-ids="t004 t005" x-target="possessed it" x-target-italic-ids="t005" x-target-head="t004" x-head="true" lemma="יָרַשׁ" strong="H3423" x-morph="Vqp3cp" x-gloss="they.possessed" x-translit="yārəšû" xml:lang="hbo">יָרְשׁ֖וּ</char> <char style="w" x-id="WLC.ISA.63.18.005" x-align="ISA.63.18.a005" x-target-ids="t003" x-target="people" x-target-head="t003" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="the.people" x-translit="ʿam-" xml:lang="hbo">עַם</char>־<char style="w" x-id="WLC.ISA.63.18.006" x-align="ISA.63.18.a006" x-target-ids="t002" x-target="holy" x-target-head="t002" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsc" x-gloss="your.holiness" x-translit="qāḏəš" xml:lang="hbo">קָדְשֶׁ֑</char><char style="w" x-id="WLC.ISA.63.18.007" x-align="ISA.63.18.a007" x-target-ids="t001" x-target="Thy" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.63.18.008" x-align="ISA.63.18.a008" x-target-ids="t011" x-target="adversaries" x-target-head="t011" x-head="true" lemma="צַר" strong=