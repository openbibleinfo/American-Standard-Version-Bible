	<para style="p"><verse number="2" style="v" x-ref="ISA.35.2" sid="ISA 35:2" /><char style="w" x-id="WLC.ISA.35.2.001" x-align="ISA.35.2.a001" x-target-ids="t004" x-target="abundantly" x-target-head="t004" x-head="true" lemma="פָּרַח" strong="H6524" x-morph="Vqa" x-gloss="profusely.(bud)" x-translit="pārōᵃḥ" xml:lang="hbo">פָּרֹ֨חַ</char> <char style="w" x-id="WLC.ISA.35.2.002" x-align="ISA.35.2.a002" x-target-ids="t001 t002 t003" x-target="It shall blossom" x-target-head="t003" x-head="true" lemma="פָּרַח" strong="H6524" x-morph="Vqi3fs" x-gloss="it.will.bud" x-translit="tip̄raḥ" xml:lang="hbo">תִּפְרַ֜ח</char> <char style="w" x-id="WLC.ISA.35.2.003" x-align="ISA.35.2.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.35.2.004" x-align="ISA.35.2.a004" x-target-ids="t006" x-target="rejoice" x-target-head="t006" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqi3fs" x-gloss="let.it.be.glad" x-translit="ṯāḡēl" xml:lang="hbo">תָגֵ֗ל</char> <char style="w" x-id="WLC.ISA.35.2.005" x-align="ISA.35.2.a005" x-target-ids="t007" x-target="even" x-target-head="t007" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄" xml:lang="hbo">אַ֚ף</char> <char style="w" x-id="WLC.ISA.35.2.006" x-align="ISA.35.2.a006" x-target-ids="t008 t009" x-target="with joy" x-target-head="t009" x-head="true" lemma="גִּילָה" strong="H1525" x-morph="Ncfsc" x-gloss="gladness" x-translit="gîlaṯ" xml:lang="hbo">גִּילַ֣ת</char> <char style="w" x-id="WLC.ISA.35.2.007" x-align="ISA.35.2.a007" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.35.2.008" x-align="ISA.35.2.a008" x-target-ids="t011" x-target="singing" x-target-head="t011" x-head="true" lemma="רָנַן" strong="H7442" x-morph=