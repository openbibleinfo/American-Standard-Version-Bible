	<para style="p"><verse number="12" style="v" x-ref="ISA.33.12" x-added-alignments="ISA.33.12.a004 ISA.33.12.a007 ISA.33.12.a010" x-added-target-ids="t006 t011 t015" x-added-target="as | as | that" sid="ISA 33:12" /><char style="w" x-id="WLC.ISA.33.12.001" x-align="ISA.33.12.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.33.12.002" x-align="ISA.33.12.a002" x-target-ids="t004 t005" x-target="shall be" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3cp" x-gloss="they.will.be" x-translit="hāyû" xml:lang="hbo">הָי֥וּ</char> <char style="w" x-id="WLC.ISA.33.12.003" x-align="ISA.33.12.a003" x-target-ids="t002 t003" x-target="the peoples" x-target-head="t003" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmpa" x-gloss="peoples" x-translit="ʿammiym" xml:lang="hbo">עַמִּ֖ים</char> <char style="w" x-id="WLC.ISA.33.12.004" x-align="ISA.33.12.a005" x-target-ids="t007 t008" x-target="the burnings" x-target-head="t008" x-head="true" lemma="מִשְׂרְפֹות" strong="H4955" x-morph="Ncfpc" x-gloss="burnings" x-translit="miśrəp̄ôṯ" xml:lang="hbo">מִשְׂרְפ֣וֹת</char> <char style="w" x-id="WLC.ISA.33.12.005" x-align="ISA.33.12.a006" x-target-ids="t009 t010" x-target="of lime" x-target-head="t010" x-head="true" lemma="שִׂיד" strong="H7875" x-morph="Ncmsa" x-gloss="of.lime" x-translit="śiyḏ" xml:lang="hbo">שִׂ֑יד</char> <char style="w" x-id="WLC.ISA.33.12.006" x-align="ISA.33.12.a008" x-target-ids="t012" x-target="thorns" x-target-head="t012" x-head="true" lemma="קוֹץ" strong="H6975" x-morph="Ncmpa" x-gloss="thorns" x-translit="qôṣiym" xml:lang="hbo">קוֹצִ֥ים</char> <char style="w" x-id="WLC.ISA.33.12.007" x-align="ISA.33.12.a009" x-target-ids="t013 t014" x-target="cut down" x-target-head="t013" x-head="true" lemma="כָּסַח" strong="H3683" x-morph="Vqsmpa" x-gloss="cut.down" x-translit="kəsûḥiym" xml:lang="hbo