	<para style="p"><verse number="10" style="v" x-ref="ISA.1.10" sid="ISA 1:10" /><char style="w" x-id="WLC.ISA.1.10.001" x-align="ISA.1.10.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="hear" x-translit="šimʿû" xml:lang="hbo">שִׁמְע֥וּ</char> <char style="w" x-id="WLC.ISA.1.10.002" x-align="ISA.1.10.a002" x-target-ids="t002 t003" x-target="the word" x-target-head="t003" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="the.word" x-translit="ḏəḇar-" xml:lang="hbo">דְבַר</char>־<char style="w" x-id="WLC.ISA.1.10.003" x-align="ISA.1.10.a003" x-target-ids="t004 t005" x-target="of Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.ISA.1.10.004" x-align="ISA.1.10.a004" x-target-ids="t006 t007" x-target="ye rulers" x-target-head="t007" x-head="true" lemma="קָצִין" strong="H7101" x-morph="Ncmpc" x-gloss="O.rulers" x-translit="qəṣînēy" xml:lang="hbo">קְצִינֵ֣י</char> <char style="w" x-id="WLC.ISA.1.10.005" x-align="ISA.1.10.a005" x-target-ids="t008 t009" x-target="of Sodom" x-target-head="t009" x-head="true" lemma="סְדֹם" strong="H5467" x-morph="Np" x-gloss="of.Sodom" x-translit="səḏōm" xml:lang="hbo">סְדֹ֑ם</char> <char style="w" x-id="WLC.ISA.1.10.006" x-align="ISA.1.10.a006" x-target-ids="t010 t011 t012" x-target="give ear unto" x-target-head="t011" x-head="true" lemma="אָזַן" strong="H238" x-morph="Vhv2mp" x-gloss="give.ear.to" x-translit="haʾăziynû" xml:lang="hbo">הַאֲזִ֛ינוּ</char> <char style="w" x-id="WLC.ISA.1.10.007" x-align="ISA.1.10.a007" x-target-ids="t013 t014" x-target="the law" x-target-head="t014" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="the.instruction" x-translit="tôraṯ" xml:lang="hbo">תּוֹרַ֥ת</char> <char style="w" x-id="WLC.ISA.1.10.008" x-align="ISA.1.10.a008" x-target-ids="t015 t017" x-target=