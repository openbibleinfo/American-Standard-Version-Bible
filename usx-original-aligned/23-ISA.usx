	<para style="p"><verse number="2" style="v" x-ref="ISA.2.2" sid="ISA 2:2" /><char style="w" x-id="WLC.ISA.2.2.001" x-align="ISA.2.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.2.2.002" x-align="ISA.2.2.a002" x-target-ids="t002 t003 t004 t005 t006 t011" x-target="it shall come to pass that" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָ֣ה</char>׀<char style="w" x-id="WLC.ISA.2.2.003" x-align="ISA.2.2.a003" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.2.2.004" x-align="ISA.2.2.a004" x-target-ids="t009" x-target="latter" x-target-head="t009" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="the.end" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִ֣ית</char> <char style="w" x-id="WLC.ISA.2.2.005" x-align="ISA.2.2.a005" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.2.2.006" x-align="ISA.2.2.a006" x-target-ids="t010" x-target="days" x-target-head="t010" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="the.days" x-translit="yyāmiym" xml:lang="hbo">יָּמִ֗ים</char> <char style="w" x-id="WLC.ISA.2.2.007" x-align="ISA.2.2.a007" x-target-ids="t019" x-target="established" x-target-head="t019" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNrmsa" x-gloss="established" x-translit="nāḵôn" xml:lang="hbo">נָכ֨וֹן</char> <char style="w" x-id="WLC.ISA.2.2.008" x-align="ISA.2.2.a008" x-target-ids="t017 t018" x-target="shall be" x-target-head="t018" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss