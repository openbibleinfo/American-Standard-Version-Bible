	<para style="p"><verse number="1" style="v" x-ref="ISA.2.1" sid="ISA 2:1" /><char style="w" x-id="WLC.ISA.2.1.001" x-align="ISA.2.1.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.2.1.002" x-align="ISA.2.1.a002" x-target-ids="t002" x-target="word" x-target-head="t002" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsa" x-gloss="word" x-translit="dāḇār" xml:lang="hbo">דָּבָר֙</char> <char style="w" x-id="WLC.ISA.2.1.003" x-align="ISA.2.1.a003" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.ISA.2.1.004" x-align="ISA.2.1.a004" x-target-ids="t009" x-target="saw" x-target-head="t009" x-head="true" lemma="חָזָה" strong="H2372" x-morph="Vqp3ms" x-gloss="he.saw" x-translit="ḥāzāh" xml:lang="hbo">חָזָ֔ה</char> <char style="w" x-id="WLC.ISA.2.1.005" x-align="ISA.2.1.a005" x-target-ids="t004" x-target="Isaiah" x-target-head="t004" x-head="true" lemma="יְשַׁעְיָהוּ" strong="H3470a" x-morph="Np" x-gloss="Isaiah" x-translit="yəšaʿəyāhû" xml:lang="hbo">יְשַֽׁעְיָ֖הוּ</char> <char style="w" x-id="WLC.ISA.2.1.006" x-align="ISA.2.1.a006" x-target-ids="t005 t006" x-target="the son" x-target-head="t006" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="the.son" x-translit="ben-" xml:lang="hbo">בֶּן</char>־<char style="w" x-id="WLC.ISA.2.1.007" x-align="ISA.2.1.a007" x-target-ids="t007 t008" x-target="of Amoz" x-target-head="t008" x-head="true" lemma="אָמוֹץ" strong="H531" x-morph="Np" x-gloss="of.Amoz" x-translit="ʾāmôṣ" xml:lang="hbo">אָמ֑וֹץ</char> <char style="w" x-id="WLC.ISA.2.1.008" x-align="ISA.2.1.a008" x-target-ids="t010" x-target="concerning" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" x