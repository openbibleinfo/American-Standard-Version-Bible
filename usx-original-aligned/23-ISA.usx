	<para style="p"><verse number="5" style="v" x-ref="ISA.62.5" sid="ISA 62:5" /><char style="w" x-id="WLC.ISA.62.5.001" x-align="ISA.62.5.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.62.5.002" x-align="ISA.62.5.a002" x-target-ids="t002 t006" x-target="as marrieth" x-target-head="t006" x-head="true" lemma="בָּעַל" strong="H1166" x-morph="Vqi3ms" x-gloss="he.marries" x-translit="yiḇʿal" xml:lang="hbo">יִבְעַ֤ל</char> <char style="w" x-id="WLC.ISA.62.5.003" x-align="ISA.62.5.a003" x-target-ids="t003 t004 t005" x-target="a young man" x-target-head="t004" x-head="true" lemma="בָּחוּר" strong="H970" x-morph="Ncmsa" x-gloss="a.young.man" x-translit="bāḥûr" xml:lang="hbo">בָּחוּר֙</char> <char style="w" x-id="WLC.ISA.62.5.004" x-align="ISA.62.5.a004" x-target-ids="t007 t008" x-target="a virgin" x-target-head="t008" x-head="true" lemma="בְּתוּלָה" strong="H1330" x-morph="Ncfsa" x-gloss="a.young.woman" x-translit="bəṯûlāh" xml:lang="hbo">בְּתוּלָ֔ה</char> <char style="w" x-id="WLC.ISA.62.5.005" x-align="ISA.62.5.a005" x-target-ids="t009 t010 t013" x-target="so shall marry" x-target-head="t013" x-head="true" lemma="בָּעַל" strong="H1166" x-morph="Vqi3mp" x-gloss="they" x-translit="yiḇʿālû" xml:lang="hbo">יִבְעָל֖וּ</char><char style="w" x-id="WLC.ISA.62.5.006" x-align="ISA.62.5.a006" x-target-ids="t014" x-target="thee" x-target-head="t014" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="will.marry.you" x-translit="ḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.62.5.007" x-align="ISA.62.5.a007" x-target-ids="t012" x-target="sons" x-target-head="t012" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="sons" x-translit="bānāy" xml:lang="hbo">בָּנָ֑יִ</char><char style="w" x-id="WLC.ISA.62.5.008" x-align="ISA.62.5.a008" x-target-ids="t011" x-target="thy" x-target-head="t011" x