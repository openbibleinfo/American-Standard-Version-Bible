	<para style="p"><verse number="15" style="v" x-ref="ISA.43.15" sid="ISA 43:15" /><char style="w" x-id="WLC.ISA.43.15.001" x-align="ISA.43.15.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֥י</char> <char style="w" x-id="WLC.ISA.43.15.002" x-align="ISA.43.15.a002" x-target-ids="t002 t003" x-target="am Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="[am].Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.ISA.43.15.003" x-align="ISA.43.15.a003" x-target-ids="t005 t006" x-target="Holy One" x-target-head="t005" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aamsc" x-gloss="your.holy" x-translit="qəḏôš" xml:lang="hbo">קְדֽוֹשְׁ</char><char style="w" x-id="WLC.ISA.43.15.004" x-align="ISA.43.15.a004" x-target-ids="t004" x-target="your" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="[one]" x-translit="əḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.ISA.43.15.005" x-align="ISA.43.15.a005" x-target-ids="t007 t008" x-target="the Creator" x-target-head="t008" x-head="true" lemma="בָּרָא" strong="H1254" x-morph="Vqrmsc" x-gloss="[the.one.who].created" x-translit="bôrēʾ" xml:lang="hbo">בּוֹרֵ֥א</char> <char style="w" x-id="WLC.ISA.43.15.006" x-align="ISA.43.15.a006" x-target-ids="t009 t010" x-target="of Israel" x-target-head="t010" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֖ל</char> <char style="w" x-id="WLC.ISA.43.15.007" x-align="ISA.43.15.a007" x-target-ids="t012" x-target="King" x-target-head="t012" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsc" x-gloss="king" x-translit="malk" xml:lang="hbo">מַלְכְּ</char><char style="w" x-id="WLC.ISA.43.15.008" x-align="ISA.43.15.a008" x-target-ids="t011" x-target="your" x-target-head="t011" 