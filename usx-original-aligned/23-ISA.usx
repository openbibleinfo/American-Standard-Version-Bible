	<para style="p"><verse number="12" style="v" x-ref="ISA.48.12" sid="ISA 48:12" /><char style="w" x-id="WLC.ISA.48.12.001" x-align="ISA.48.12.a001" x-target-ids="t001" x-target="Hearken" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen" x-translit="šəmaʿ" xml:lang="hbo">שְׁמַ֤ע</char> <char style="w" x-id="WLC.ISA.48.12.002" x-align="ISA.48.12.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלַ</char><char style="w" x-id="WLC.ISA.48.12.003" x-align="ISA.48.12.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.48.12.004" x-align="ISA.48.12.a004" x-target-ids="t004 t005" x-target="O Jacob" x-target-head="t005" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="O.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַֽעֲקֹ֔ב</char> <char style="w" x-id="WLC.ISA.48.12.005" x-align="ISA.48.12.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.48.12.006" x-align="ISA.48.12.a006" x-target-ids="t007" x-target="Israel" x-target-head="t007" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֖ל</char> <char style="w" x-id="WLC.ISA.48.12.007" x-align="ISA.48.12.a008" x-target-ids="t009" x-target="called" x-target-head="t009" x-head="true" lemma="קָרָא" strong="H7121" x-morph="VPsmsc" x-gloss="my.called" x-translit="məqōrāʾ" xml:lang="hbo">מְקֹרָאִ֑</char><char style="w" x-id="WLC.ISA.48.12.008" x-align="ISA.48.12.a007" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[one]"