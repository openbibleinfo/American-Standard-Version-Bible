	<para style="p"><verse number="4" style="v" x-ref="ISA.63.4" sid="ISA 63:4" /><char style="w" x-id="WLC.ISA.63.4.001" x-align="ISA.63.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֛י</char> <char style="w" x-id="WLC.ISA.63.4.002" x-align="ISA.63.4.a002" x-target-ids="t002 t003" x-target="the day" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsc" x-gloss="a.day" x-translit="yôm" xml:lang="hbo">י֥וֹם</char> <char style="w" x-id="WLC.ISA.63.4.003" x-align="ISA.63.4.a003" x-target-ids="t004 t005" x-target="of vengeance" x-target-head="t005" x-head="true" lemma="נָקָם" strong="H5359" x-morph="Ncmsa" x-gloss="of.vengeance" x-translit="nāqām" xml:lang="hbo">נָקָ֖ם</char> <char style="w" x-id="WLC.ISA.63.4.004" x-align="ISA.63.4.a004" x-target-ids="t006 t007" x-target="was in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[was].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.63.4.005" x-align="ISA.63.4.a005" x-target-ids="t009" x-target="heart" x-target-head="t009" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֑</char><char style="w" x-id="WLC.ISA.63.4.006" x-align="ISA.63.4.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.63.4.007" x-align="ISA.63.4.a007" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.63.4.008" x-align="ISA.63.4.a008" x-target-ids="t011 t012" x-target="the year" x-target-head="t012" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncfsc" x-gloss="the.year" x-translit="šənaṯ" xml:lang