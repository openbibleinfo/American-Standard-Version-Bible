	<para style="p"><verse number="4" style="v" x-ref="ISA.55.4" sid="ISA 55:4" /><char style="w" x-id="WLC.ISA.55.4.001" x-align="ISA.55.4.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="here!" x-translit="hēn" xml:lang="hbo">הֵ֛ן</char> <char style="w" x-id="WLC.ISA.55.4.002" x-align="ISA.55.4.a002" x-target-ids="t006 t007 t008" x-target="for a witness" x-target-head="t008" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsc" x-gloss="a.witness" x-translit="ʿēḏ" xml:lang="hbo">עֵ֥ד</char> <char style="w" x-id="WLC.ISA.55.4.003" x-align="ISA.55.4.a003" x-target-ids="t009 t010 t011" x-target="to the peoples" x-target-head="t011" x-head="true" lemma="לְאֹם" strong="H3816" x-morph="Ncmpa" x-gloss="of.peoples" x-translit="ləʾûmmiym" xml:lang="hbo">לְאוּמִּ֖ים</char> <char style="w" x-id="WLC.ISA.55.4.004" x-align="ISA.55.4.a004" x-target-ids="t002 t003 t004" x-target="I have given" x-target-head="t004" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp1cs" x-gloss="I" x-translit="nəṯattiy" xml:lang="hbo">נְתַתִּ֑י</char><char style="w" x-id="WLC.ISA.55.4.005" x-align="ISA.55.4.a005" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="made.him" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.ISA.55.4.006" x-align="ISA.55.4.a006" x-target-ids="t012 t013" x-target="a leader" x-target-head="t013" x-head="true" lemma="נָגִיד" strong="H5057" x-morph="Ncmsa" x-gloss="a.leader" x-translit="nāḡiyḏ" xml:lang="hbo">נָגִ֥יד</char> <char style="w" x-id="WLC.ISA.55.4.007" x-align="ISA.55.4.a007" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.55.4.008" x-align="ISA.55.4.a008" x-target-ids="t015" x-target="commander" x-target-head="t015" x-head="true" lemma="צָוָה" stron