	<para style="p"><verse number="8" style="v" x-ref="ISA.46.8" x-added-alignments="ISA.46.8.a006" x-added-target-ids="t008" x-added-target="it" sid="ISA 46:8" /><char style="w" x-id="WLC.ISA.46.8.001" x-align="ISA.46.8.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqv2mp" x-gloss="remember" x-translit="ziḵrû-" xml:lang="hbo">זִכְרוּ</char>־<char style="w" x-id="WLC.ISA.46.8.002" x-align="ISA.46.8.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֖את</char> <char style="w" x-id="WLC.ISA.46.8.003" x-align="ISA.46.8.a003" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.46.8.004" x-align="ISA.46.8.a004" x-target-ids="t004 t005 t006" x-target="show yourselves men" x-target-head="t006" x-head="true" lemma="אשׁשׁ" strong="H377a" x-morph="Vrv2mp" x-gloss="pluck.up.courage" x-translit="hiṯʾōšāšû" xml:lang="hbo">הִתְאֹשָׁ֑שׁוּ</char> <char style="w" x-id="WLC.ISA.46.8.005" x-align="ISA.46.8.a005" x-target-ids="t007 t009" x-target="bring again" x-target-head="t007" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhv2mp" x-gloss="bring.[it].back" x-translit="hāšiyḇû" xml:lang="hbo">הָשִׁ֥יבוּ</char> <char style="w" x-id="WLC.ISA.46.8.006" x-align="ISA.46.8.a007" x-target-ids="t012 t013 t014" x-target="O ye transgressors" x-target-head="t014" x-head="true" lemma="פָּשַׁע" strong="H6586" x-morph="Vqrmpa" x-gloss="O.rebels" x-translit="p̄ôšʿiym" xml:lang="hbo">פוֹשְׁעִ֖ים</char> <char style="w" x-id="WLC.ISA.46.8.007" x-align="ISA.46.8.a008" x-target-ids="t010" x-target="to" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.46.8.008" x-