	<para style="p"><verse number="9" style="v" x-ref="ISA.29.9" sid="ISA 29:9" /><char style="w" x-id="WLC.ISA.29.9.001" x-align="ISA.29.9.a001" x-target-ids="t001 t002" x-target="Tarry ye" x-target-head="t001" x-head="true" lemma="מָהַהּ" strong="H4102" x-morph="Vfv2mp" x-gloss="delay" x-translit="hiṯmahməhû" xml:lang="hbo">הִתְמַהְמְה֣וּ</char> <char style="w" x-id="WLC.ISA.29.9.002" x-align="ISA.29.9.a002" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.29.9.003" x-align="ISA.29.9.a003" x-target-ids="t004" x-target="wonder" x-target-head="t004" x-head="true" lemma="תָּמַהּ" strong="H8539" x-morph="Vqv2mp" x-gloss="be.astonished" x-translit="ṯəmāhû" xml:lang="hbo">תְמָ֔הוּ</char> <char style="w" x-id="WLC.ISA.29.9.004" x-align="ISA.29.9.a004" x-target-ids="t005 t006 t007" x-target="take your pleasure" x-target-head="t007" x-head="true" lemma="שָׁעַע" strong="H8173" x-morph="Vfv2mp" x-gloss="blind.yourselves" x-translit="hištaʿašʿû" xml:lang="hbo">הִשְׁתַּֽעַשְׁע֖וּ</char> <char style="w" x-id="WLC.ISA.29.9.005" x-align="ISA.29.9.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.ISA.29.9.006" x-align="ISA.29.9.a006" x-target-ids="t009 t010" x-target="be blind" x-target-head="t010" x-head="true" lemma="שָׁעַע" strong="H8173" x-morph="Vqv2mp" x-gloss="be.blind" x-translit="šōʿû" xml:lang="hbo">שֹׁ֑עוּ</char> <char style="w" x-id="WLC.ISA.29.9.007" x-align="ISA.29.9.a007" x-target-ids="t011 t012 t013" x-target="they are drunken" x-target-head="t013" x-head="true" lemma="שָׁכַר" strong="H7937" x-morph="Vqp3cp" x-gloss="people.have.become.drunk" x-translit="šāḵərû" xml:lang="hbo">שָֽׁכְר֣וּ</char> <char style="w" x-id="WLC.ISA.29.9.008" x-align="ISA.29.9.a008" x-target-ids="t014" x-target