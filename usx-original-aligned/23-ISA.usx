	<para style="p"><verse number="18" style="v" x-ref="ISA.9.18" sid="ISA 9:18" /><char style="w" x-id="WLC.ISA.9.18.001" x-align="ISA.9.18.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="ISA.9.17">כִּֽי</char>־<char style="w" x-id="WLC.ISA.9.18.002" x-align="ISA.9.18.a002" x-target-ids="t003" x-target="burneth" x-target-head="t003" x-head="true" lemma="בָּעַר" strong="H1197" x-morph="Vqp3fs" x-gloss="it.has.burned" x-translit="ḇāʿărāh" xml:lang="hbo" x-source-ref="ISA.9.17">בָעֲרָ֤ה</char> <char style="w" x-id="WLC.ISA.9.18.003" x-align="ISA.9.18.a003" x-target-ids="t004" x-target="as" x-target-head="t004" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ḵā" xml:lang="hbo" x-source-ref="ISA.9.17">כָ</char><char style="w" x-id="WLC.ISA.9.18.004" x-align="ISA.9.18.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo" x-source-ref="ISA.9.17">[הַ]</char><char style="w" x-id="WLC.ISA.9.18.005" x-align="ISA.9.18.a005" x-target-ids="t006" x-target="fire" x-target-head="t006" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsa" x-gloss="fire" x-translit="ʾēš" xml:lang="hbo" x-source-ref="ISA.9.17">אֵשׁ֙</char> <char style="w" x-id="WLC.ISA.9.18.006" x-align="ISA.9.18.a006" x-target-ids="t002" x-target="wickedness" x-target-head="t002" x-head="true" lemma="רִשְׁעָה" strong="H7564" x-morph="Ncfsa" x-gloss="wickedness" x-translit="rišʿāh" xml:lang="hbo" x-source-ref="ISA.9.17">רִשְׁעָ֔ה</char> <char style="w" x-id="WLC.ISA.9.18.007" x-align="ISA.9.18.a007" x-target-ids="t009 t010" x-target="the briers" x-target-head="t010" x-head="true" lemma="שָׁמִיר" strong="H8068" x-morph="Ncmsa" x-gloss="thorn[s]" x-translit="šāmiyr" xml:lang="hbo" x-source-ref="ISA.9.17">שָׁמִ֥יר</char> <char style="w" x-id="WLC.ISA.