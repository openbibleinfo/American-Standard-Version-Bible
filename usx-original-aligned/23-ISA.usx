	<para style="p"><verse number="10" style="v" x-ref="ISA.61.10" sid="ISA 61:10" /><char style="w" x-id="WLC.ISA.61.10.001" x-align="ISA.61.10.a001" x-target-ids="t003" x-target="greatly" x-target-head="t003" x-head="true" lemma="שׂוּשׂ" strong="H7797" x-morph="Vqa" x-gloss="greatly.(rejoice)" x-translit="śôś" xml:lang="hbo">שׂ֧וֹשׂ</char> <char style="w" x-id="WLC.ISA.61.10.002" x-align="ISA.61.10.a002" x-target-ids="t001 t002 t004" x-target="I will rejoice" x-target-head="t004" x-head="true" lemma="שׂוּשׂ" strong="H7797" x-morph="Vqi1cs" x-gloss="I.will.rejoice" x-translit="ʾāśiyś" xml:lang="hbo">אָשִׂ֣ישׂ</char> <char style="w" x-id="WLC.ISA.61.10.003" x-align="ISA.61.10.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּֽ</char><char style="w" x-id="WLC.ISA.61.10.004" x-align="ISA.61.10.a004" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֗ה</char> <char style="w" x-id="WLC.ISA.61.10.005" x-align="ISA.61.10.a005" x-target-ids="t009 t010 t011" x-target="shall be joyful" x-target-head="t011" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqi3fs" x-gloss="it.will.be.glad" x-translit="tāḡēl" xml:lang="hbo">תָּגֵ֤ל</char> <char style="w" x-id="WLC.ISA.61.10.006" x-align="ISA.61.10.a006" x-target-ids="t008" x-target="soul" x-target-head="t008" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ</char><char style="w" x-id="WLC.ISA.61.10.007" x-align="ISA.61.10.a007" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.61.10.008" x-align="ISA.61.10.a008" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בּ