	<para style="p"><verse number="10" style="v" x-ref="ISA.45.10" sid="ISA 45:10" /><char style="w" x-id="WLC.ISA.45.10.001" x-align="ISA.45.10.a001" x-target-ids="t001 t002" x-target="Woe unto" x-target-head="t001" x-head="true" lemma="הוֹי" strong="H1945" x-morph="Tj" x-gloss="woe.to!" x-translit="hôy" xml:lang="hbo">ה֛וֹי</char> <char style="w" x-id="WLC.ISA.45.10.002" x-align="ISA.45.10.a002" x-target-ids="t003 t004 t005" x-target="him that saith" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqrmsa" x-gloss="[one.who].says" x-translit="ʾōmēr" xml:lang="hbo">אֹמֵ֥ר</char> <char style="w" x-id="WLC.ISA.45.10.003" x-align="ISA.45.10.a003" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.45.10.004" x-align="ISA.45.10.a004" x-target-ids="t007 t008" x-target="a father" x-target-head="t008" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsa" x-gloss="a.father" x-translit="ʾāḇ" xml:lang="hbo">אָ֖ב</char> <char style="w" x-id="WLC.ISA.45.10.005" x-align="ISA.45.10.a005" x-target-ids="t009" x-target="What" x-target-head="t009" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.ISA.45.10.006" x-align="ISA.45.10.a006" x-target-ids="t010 t011" x-target="begettest thou" x-target-head="t010" x-head="true" lemma="יָלַד" strong="H3205" x-morph="Vhi2ms" x-gloss="are.you.fathering" x-translit="tôliyḏ" xml:lang="hbo">תּוֹלִ֑יד</char> <char style="w" x-id="WLC.ISA.45.10.007" x-align="ISA.45.10.a007" x-target-ids="t012" x-target="or" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.45.10.008" x-align="ISA.45.10.a008" x-target-ids="t013" x-target="to" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R"