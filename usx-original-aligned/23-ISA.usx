	<para style="p"><verse number="17" style="v" x-ref="ISA.48.17" x-added-alignments="ISA.48.17.a020" x-added-target-ids="t027" x-added-target="that" sid="ISA 48:17" /><char style="w" x-id="WLC.ISA.48.17.001" x-align="ISA.48.17.a001" x-target-ids="t001" x-target="Thus" x-target-head="t001" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="kōh-" xml:lang="hbo">כֹּֽה</char>־<char style="w" x-id="WLC.ISA.48.17.002" x-align="ISA.48.17.a002" x-target-ids="t002" x-target="saith" x-target-head="t002" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֧ר</char> <char style="w" x-id="WLC.ISA.48.17.003" x-align="ISA.48.17.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֛ה</char> <char style="w" x-id="WLC.ISA.48.17.004" x-align="ISA.48.17.a005" x-target-ids="t005" x-target="Redeemer" x-target-head="t005" x-head="true" lemma="גָּאַל" strong="H1350" x-morph="Vqrmsc" x-gloss="redeemer" x-translit="gōʾal" xml:lang="hbo">גֹּאַלְ</char><char style="w" x-id="WLC.ISA.48.17.005" x-align="ISA.48.17.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.ISA.48.17.006" x-align="ISA.48.17.a006" x-target-ids="t006 t007 t008" x-target="the Holy One" x-target-head="t007" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aamsc" x-gloss="the.holy.[one]" x-translit="qəḏôš" xml:lang="hbo">קְד֣וֹשׁ</char> <char style="w" x-id="WLC.ISA.48.17.007" x-align="ISA.48.17.a007" x-target-ids="t009 t010" x-target="of Israel" x-target-head="t010" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֑ל</char> <char style="w" x-id="WLC.ISA.48.17.008" x-align="ISA.48.1