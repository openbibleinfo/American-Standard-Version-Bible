	<para style="p"><verse number="19" style="v" x-ref="ISA.10.19" sid="ISA 10:19" /><char style="w" x-id="WLC.ISA.10.19.001" x-align="ISA.10.19.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.10.19.002" x-align="ISA.10.19.a002" x-target-ids="t002 t003" x-target="the remnant" x-target-head="t003" x-head="true" lemma="שְׁאָר" strong="H7605" x-morph="Ncmsc" x-gloss="the.remnant" x-translit="šəʾār" xml:lang="hbo">שְׁאָ֥ר</char> <char style="w" x-id="WLC.ISA.10.19.003" x-align="ISA.10.19.a003" x-target-ids="t004 t005 t006" x-target="of the trees" x-target-head="t006" x-head="true" lemma="עֵץ" strong="H6086" x-morph="Ncmsc" x-gloss="of.the.tree[s]" x-translit="ʿēṣ" xml:lang="hbo">עֵ֛ץ</char> <char style="w" x-id="WLC.ISA.10.19.004" x-align="ISA.10.19.a004" x-target-ids="t007 t009" x-target="of forest" x-target-head="t009" x-head="true" lemma="יַעַר" strong="H3293" x-morph="Ncmsc" x-gloss="his.forest" x-translit="yaʿr" xml:lang="hbo">יַעְר֖</char><char style="w" x-id="WLC.ISA.10.19.005" x-align="ISA.10.19.a005" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.ISA.10.19.006" x-align="ISA.10.19.a006" x-target-ids="t012" x-target="few" x-target-head="t012" x-head="true" lemma="מִסְפָּר" strong="H4557" x-morph="Ncmsa" x-gloss="a.number" x-translit="mispār" xml:lang="hbo">מִסְפָּ֣ר</char> <char style="w" x-id="WLC.ISA.10.19.007" x-align="ISA.10.19.a007" x-target-ids="t010 t011" x-target="shall be" x-target-head="t011" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3mp" x-gloss="they.will.be" x-translit="yihəyû" xml:lang="hbo">יִֽהְי֑וּ</char> <char style="w" x-id="WLC.ISA.10.19.008" x-align="ISA.10.19.a008" x-target-ids="t013 t014" x-target="so that" x-target-head="t013" x-head="tr