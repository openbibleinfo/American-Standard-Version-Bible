	<para style="p"><verse number="2" style="v" x-ref="ISA.26.2" sid="ISA 26:2" /><char style="w" x-id="WLC.ISA.26.2.001" x-align="ISA.26.2.a001" x-target-ids="t001 t002" x-target="Open ye" x-target-head="t001" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="Vqv2mp" x-gloss="open" x-translit="piṯḥû" xml:lang="hbo">פִּתְח֖וּ</char> <char style="w" x-id="WLC.ISA.26.2.002" x-align="ISA.26.2.a002" x-target-ids="t003 t004" x-target="the gates" x-target-head="t004" x-head="true" lemma="שַׁעַר" strong="H8179" x-morph="Ncmpa" x-gloss="[the].gates" x-translit="šəʿāriym" xml:lang="hbo">שְׁעָרִ֑ים</char> <char style="w" x-id="WLC.ISA.26.2.003" x-align="ISA.26.2.a003" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="so" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.26.2.004" x-align="ISA.26.2.a004" x-target-ids="t012 t013 t014" x-target="may enter in" x-target-head="t013" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3ms" x-gloss="that.it.may.enter" x-translit="yāḇōʾ" xml:lang="hbo">יָבֹ֥א</char> <char style="w" x-id="WLC.ISA.26.2.005" x-align="ISA.26.2.a005" x-target-ids="t006 t008" x-target="the nation" x-target-head="t008" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="a.nation" x-translit="ḡôy-" xml:lang="hbo">גוֹי</char>־<char style="w" x-id="WLC.ISA.26.2.006" x-align="ISA.26.2.a006" x-target-ids="t007" x-target="righteous" x-target-head="t007" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֖יק</char> <char style="w" x-id="WLC.ISA.26.2.007" x-align="ISA.26.2.a007" x-target-ids="t009 t010" x-target="which keepeth" x-target-head="t010" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[which].keeps" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֥ר</char> <char style="w" x-id="WLC.ISA.26.2.008" x-align="ISA.26.2.a008" x-target-ids="t011" x-target="faith" x-target-hea