	<para style="p"><verse number="10" style="v" x-ref="ISA.44.10" sid="ISA 44:10" /><char style="w" x-id="WLC.ISA.44.10.001" x-align="ISA.44.10.a001" x-target-ids="t001" x-target="Who" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy-" xml:lang="hbo">מִֽי</char>־<char style="w" x-id="WLC.ISA.44.10.002" x-align="ISA.44.10.a002" x-target-ids="t002 t003" x-target="hath fashioned" x-target-head="t003" x-head="true" lemma="יָצַר" strong="H3335" x-morph="Vqp3ms" x-gloss="has.he.formed" x-translit="yāṣar" xml:lang="hbo">יָצַ֥ר</char> <char style="w" x-id="WLC.ISA.44.10.003" x-align="ISA.44.10.a003" x-target-ids="t004 t005" x-target="a god" x-target-head="t005" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="a.god" x-translit="ʾēl" xml:lang="hbo">אֵ֖ל</char> <char style="w" x-id="WLC.ISA.44.10.004" x-align="ISA.44.10.a004" x-target-ids="t006" x-target="or" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.44.10.005" x-align="ISA.44.10.a006" x-target-ids="t008 t009" x-target="an image" x-target-head="t009" x-head="true" lemma="פֶּסֶל" strong="H6459" x-morph="Ncmsa" x-gloss="an.idol" x-translit="p̄esel" xml:lang="hbo">פֶ֣סֶל</char> <char style="w" x-id="WLC.ISA.44.10.006" x-align="ISA.44.10.a005" x-target-ids="t007" x-target="molten" x-target-head="t007" x-head="true" lemma="נָסַךְ" strong="H5258" x-morph="Vqp3ms" x-gloss="has.he.cast?" x-translit="nāsāḵ" xml:lang="hbo">נָסָ֑ךְ</char> <char style="w" x-id="WLC.ISA.44.10.007" x-align="ISA.44.10.a007" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.44.10.008" x-align="ISA.44.10.a009" x-target-ids="t013 t014" x-target="for nothing" x-target-head="t014" x-head="true" lemma="בֵּלֶת" strong="H1115" x-morph="C" x-g