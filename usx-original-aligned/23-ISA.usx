	<para style="p"><verse number="8" style="v" x-ref="ISA.56.8" sid="ISA 56:8" /><char style="w" x-id="WLC.ISA.56.8.001" x-align="ISA.56.8.a001" x-target-ids="t010" x-target="saith" x-target-head="t010" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum" xml:lang="hbo">נְאֻם֙</char> <char style="w" x-id="WLC.ISA.56.8.002" x-align="ISA.56.8.a002" x-target-ids="t001 t002" x-target="The Lord" x-target-head="t002" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֣</char><char style="w" x-id="WLC.ISA.56.8.003" x-align="ISA.56.8.a003" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="of.[the]" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.56.8.004" x-align="ISA.56.8.a004" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יְהֹוִה" strong="H3069" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwih" xml:lang="hbo">יְהוִ֔ה</char> <char style="w" x-id="WLC.ISA.56.8.005" x-align="ISA.56.8.a005" x-target-ids="t004 t005" x-target="who gathereth" x-target-head="t005" x-head="true" lemma="קָבַץ" strong="H6908" x-morph="Vprmsa" x-gloss="[who].gathers" x-translit="məqabbēṣ" xml:lang="hbo">מְקַבֵּ֖ץ</char> <char style="w" x-id="WLC.ISA.56.8.006" x-align="ISA.56.8.a006" x-target-ids="t006 t007" x-target="the outcasts" x-target-head="t007" x-head="true" lemma="נדח" strong="H5080" x-morph="VNrmpc" x-gloss="the.banished.[ones]" x-translit="niḏḥēy" xml:lang="hbo">נִדְחֵ֣י</char> <char style="w" x-id="WLC.ISA.56.8.007" x-align="ISA.56.8.a007" x-target-ids="t008 t009" x-target="of Israel" x-target-head="t009" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֑ל</char> <char style="w" x-id="WLC.ISA.56.8.008" x-align="ISA.56.8.a008" x-target-ids="t011 t015" x-target="Yet others" x-target-italic-ids="t015" x-targe