	<para style="p"><verse number="9" style="v" x-ref="ISA.43.9" sid="ISA 43:9" /><char style="w" x-id="WLC.ISA.43.9.001" x-align="ISA.43.9.a001" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kāl-" xml:lang="hbo">כָּֽל</char>־<char style="w" x-id="WLC.ISA.43.9.002" x-align="ISA.43.9.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.43.9.003" x-align="ISA.43.9.a003" x-target-ids="t004" x-target="nations" x-target-head="t004" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="gôyim" xml:lang="hbo">גּוֹיִ֞ם</char> <char style="w" x-id="WLC.ISA.43.9.004" x-align="ISA.43.9.a004" x-target-ids="t001 t005 t006" x-target="Let be gathered" x-target-head="t006" x-head="true" lemma="קָבַץ" strong="H6908" x-morph="VNp3cp" x-gloss="they.have.assembled" x-translit="niqbəṣû" xml:lang="hbo">נִקְבְּצ֣וּ</char> <char style="w" x-id="WLC.ISA.43.9.005" x-align="ISA.43.9.a005" x-target-ids="t007" x-target="together" x-target-head="t007" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="together" x-translit="yaḥdāw" xml:lang="hbo">יַחְדָּ֗ו</char> <char style="w" x-id="WLC.ISA.43.9.006" x-align="ISA.43.9.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.9.007" x-align="ISA.43.9.a007" x-target-ids="t009 t012 t013" x-target="let be assembled" x-target-head="t013" x-head="true" lemma="אָסַף" strong="H622" x-morph="VNi3mp" x-gloss="they.gather" x-translit="yēʾāsəp̄û" xml:lang="hbo">יֵאָֽסְפוּ֙</char> <char style="w" x-id="WLC.ISA.43.9.008" x-align="ISA.43.9.a008" x-target-ids="t010 t011" x-target="the peoples" x-target-head="t011" x-head="true" lemma="