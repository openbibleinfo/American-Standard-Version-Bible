	<para style="p"><verse number="7" style="v" x-ref="ISA.47.7" sid="ISA 47:7" /><char style="w" x-id="WLC.ISA.47.7.001" x-align="ISA.47.7.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.ISA.47.7.002" x-align="ISA.47.7.a002" x-target-ids="t002 t003" x-target="thou saidst" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw2fs" x-gloss="you.said" x-translit="tōʾməriy" xml:lang="hbo">תֹּ֣אמְרִ֔י</char> <char style="w" x-id="WLC.ISA.47.7.003" x-align="ISA.47.7.a003" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.47.7.004" x-align="ISA.47.7.a004" x-target-ids="t009" x-target="ever" x-target-head="t009" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֖ם</char> <char style="w" x-id="WLC.ISA.47.7.005" x-align="ISA.47.7.a005" x-target-ids="t004 t005 t006" x-target="I shall be" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi1cs" x-gloss="I.will.be" x-translit="ʾehyeh" xml:lang="hbo">אֶהְיֶ֣ה</char> <char style="w" x-id="WLC.ISA.47.7.006" x-align="ISA.47.7.a006" x-target-ids="t007" x-target="mistress" x-target-head="t007" x-head="true" lemma="גְּבֶרֶת" strong="H1404" x-morph="Ncfsa" x-gloss="a.queen" x-translit="ḡəḇāreṯ" xml:lang="hbo">גְבָ֑רֶת</char> <char style="w" x-id="WLC.ISA.47.7.007" x-align="ISA.47.7.a007" x-target-ids="t010 t011" x-target="so that" x-target-head="t010" x-head="true" lemma="עַד" strong="H5703" x-morph="R" x-gloss="until" x-translit="ʿaḏ" xml:lang="hbo">עַ֣ד</char> <char style="w" x-id="WLC.ISA.47.7.008" x-align="ISA.47.7.a008" x-target-ids="t014" x-target="not" x-target-head="t014" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x