	<para style="p"><verse number="16" style="v" x-ref="ISA.23.16" sid="ISA 23:16" /><char style="w" x-id="WLC.ISA.23.16.001" x-align="ISA.23.16.a001" x-target-ids="t001" x-target="Take" x-target-head="t001" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqv2fs" x-gloss="take" x-translit="qəḥiy" xml:lang="hbo">קְחִ֥י</char> <char style="w" x-id="WLC.ISA.23.16.002" x-align="ISA.23.16.a002" x-target-ids="t002 t003" x-target="a harp" x-target-head="t003" x-head="true" lemma="כִּנּוֹר" strong="H3658" x-morph="Ncmsa" x-gloss="a.harp" x-translit="ḵinnôr" xml:lang="hbo">כִנּ֛וֹר</char> <char style="w" x-id="WLC.ISA.23.16.003" x-align="ISA.23.16.a003" x-target-ids="t004 t005" x-target="go about" x-target-head="t004" x-head="true" lemma="סָבַב" strong="H5437" x-morph="Vqv2fs" x-gloss="go.around" x-translit="sōbî" xml:lang="hbo">סֹ֥בִּי</char> <char style="w" x-id="WLC.ISA.23.16.004" x-align="ISA.23.16.a004" x-target-ids="t006 t007" x-target="the city" x-target-head="t007" x-head="true" lemma="עִיר" strong="H5892" x-morph="Ncfsa" x-gloss="[the].city" x-translit="ʿiyr" xml:lang="hbo">עִ֖יר</char> <char style="w" x-id="WLC.ISA.23.16.005" x-align="ISA.23.16.a005" x-target-ids="t008 t009" x-target="thou harlot" x-target-head="t009" x-head="true" lemma="זָנָה" strong="H2185" x-morph="Vqrfsa" x-gloss="O.prostitute" x-translit="zônāh" xml:lang="hbo">זוֹנָ֣ה</char> <char style="w" x-id="WLC.ISA.23.16.006" x-align="ISA.23.16.a006" x-target-ids="t010 t011 t012 t013" x-target="that hast been forgotten" x-target-head="t013" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="VNrfsa" x-gloss="forgotten" x-translit="niškāḥāh" xml:lang="hbo">נִשְׁכָּחָ֑ה</char> <char style="w" x-id="WLC.ISA.23.16.007" x-align="ISA.23.16.a007" x-target-ids="t014 t015" x-target="make sweet" x-target-head="t015" x-head="true" lemma="יָטַב" strong="H3190" x-morph="Vhv2fs" x-gloss="do.well" x-translit="hêṭiyḇî" xml:lang="hbo">הֵיטִ֤יבִי</char> <char style="w" x-id="WLC.ISA.23.16.008" x-align="ISA.23.16.a008" 