	<para style="p"><verse number="12" style="v" x-ref="ISA.24.12" sid="ISA 24:12" /><char style="w" x-id="WLC.ISA.24.12.001" x-align="ISA.24.12.a001" x-target-ids="t004 t005" x-target="is left" x-target-head="t005" x-head="true" lemma="שָׁאַר" strong="H7604" x-morph="VNp3ms" x-gloss="it.has.remained" x-translit="nišʾar" xml:lang="hbo">נִשְׁאַ֥ר</char> <char style="w" x-id="WLC.ISA.24.12.002" x-align="ISA.24.12.a002" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="bā" xml:lang="hbo">בָּ</char><char style="w" x-id="WLC.ISA.24.12.003" x-align="ISA.24.12.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.24.12.004" x-align="ISA.24.12.a004" x-target-ids="t003" x-target="city" x-target-head="t003" x-head="true" lemma="עִיר" strong="H5892" x-morph="Ncfsa" x-gloss="city" x-translit="ʿiyr" xml:lang="hbo">עִ֖יר</char> <char style="w" x-id="WLC.ISA.24.12.005" x-align="ISA.24.12.a005" x-target-ids="t006" x-target="desolation" x-target-head="t006" x-head="true" lemma="שַׁמָּה" strong="H8047" x-morph="Ncfsa" x-gloss="desolation" x-translit="šammāh" xml:lang="hbo">שַׁמָּ֑ה</char> <char style="w" x-id="WLC.ISA.24.12.006" x-align="ISA.24.12.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.24.12.007" x-align="ISA.24.12.a007" x-target-ids="t012 t013" x-target="with destruction" x-target-head="t013" x-head="true" lemma="שְׁאִיָּה" strong="H7591" x-morph="Ncfsa" x-gloss="ruin" x-translit="šəʾiyyāh" xml:lang="hbo">שְׁאִיָּ֖ה</char> <char style="w" x-id="WLC.ISA.24.12.008" x-align="ISA.24.12.a008" x-target-ids="t010 t011" x-target="is smitten" x-target-head="t011" x-head="true" lemma="כָּתַת" strong="H3807" x-