	<para style="p"><verse number="1" style="v" x-ref="ISA.35.1" sid="ISA 35:1" /><char style="w" x-id="WLC.ISA.35.1.001" x-align="ISA.35.1.a001" x-target-ids="t007 t008 t009" x-target="shall be glad" x-target-head="t009" x-head="true" lemma="שׂוּשׂ" strong="H7797" x-morph="Vqi3mp" x-gloss="they" x-translit="yəśuśû" xml:lang="hbo">יְשֻׂשׂ֥וּ</char><char style="w" x-id="WLC.ISA.35.1.002" x-align="ISA.35.1.a002" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H4993b" x-morph="Sp3mp" x-gloss="will.rejoice" x-translit="m" xml:lang="hbo">ם</char><char style="w" x-id="WLC.ISA.35.1.003" x-align="ISA.35.1.a003" x-target-ids="t001 t002" x-target="The wilderness" x-target-head="t002" x-head="true" lemma="מִדְבָּר" strong="H4057" x-morph="Ncmsa" x-gloss="[the].wilderness" x-translit="miḏbār" xml:lang="hbo">מִדְבָּ֖ר</char> <char style="w" x-id="WLC.ISA.35.1.004" x-align="ISA.35.1.a004" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.35.1.005" x-align="ISA.35.1.a005" x-target-ids="t004 t005 t006" x-target="the dry land" x-target-head="t005" x-head="true" lemma="צִיָּה" strong="H6723" x-morph="Ncfsa" x-gloss="dry.region" x-translit="ṣiyyāh" xml:lang="hbo">צִיָּ֑ה</char> <char style="w" x-id="WLC.ISA.35.1.006" x-align="ISA.35.1.a006" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.35.1.007" x-align="ISA.35.1.a007" x-target-ids="t013 t014" x-target="shall rejoice" x-target-head="t014" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqi3fs" x-gloss="let.it.be.glad" x-translit="ṯāḡēl" xml:lang="hbo">תָגֵ֧ל</char> <char style="w" x-id="WLC.ISA.35.1.008" x-align="ISA.35.1.a008" x-target-ids="t011 t012" x-target="the desert" x-target-head="t012" x-head="true" lemma="עֲרָבָה" strong=