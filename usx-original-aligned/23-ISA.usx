	<para style="p"><verse number="10" style="v" x-ref="ISA.41.10" sid="ISA 41:10" /><char style="w" x-id="WLC.ISA.41.10.001" x-align="ISA.41.10.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.ISA.41.10.002" x-align="ISA.41.10.a002" x-target-ids="t001 t002" x-target="fear thou" x-target-head="t001" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqj2ms" x-gloss="be.afraid" x-translit="tîrāʾ" xml:lang="hbo">תִּירָא֙</char> <char style="w" x-id="WLC.ISA.41.10.003" x-align="ISA.41.10.a003" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.ISA.41.10.004" x-align="ISA.41.10.a004" x-target-ids="t006 t007" x-target="am with" x-target-head="t007" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="[am].with" x-translit="ʿimm" xml:lang="hbo">עִמְּ</char><char style="w" x-id="WLC.ISA.41.10.005" x-align="ISA.41.10.a005" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā-" xml:lang="hbo">ךָ</char>־<char style="w" x-id="WLC.ISA.41.10.006" x-align="ISA.41.10.a006" x-target-ids="t005" x-target="I" x-target-head="t005" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānî" xml:lang="hbo">אָ֔נִי</char> <char style="w" x-id="WLC.ISA.41.10.007" x-align="ISA.41.10.a007" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.ISA.41.10.008" x-align="ISA.41.10.a008" x-target-ids="t009 t011" x-target="be dismayed" x-target-head="t011" x-head="true" lemma="שָׁעָה" strong="H8159" x-morph="Vqj2ms" x-gloss="fear" x-translit=