	<para style="p"><verse number="3" style="v" x-ref="ISA.35.3" sid="ISA 35:3" /><char style="w" x-id="WLC.ISA.35.3.001" x-align="ISA.35.3.a001" x-target-ids="t001 t002" x-target="Strengthen ye" x-target-head="t001" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vpv2mp" x-gloss="strengthen" x-translit="ḥazzəqû" xml:lang="hbo">חַזְּק֖וּ</char> <char style="w" x-id="WLC.ISA.35.3.002" x-align="ISA.35.3.a002" x-target-ids="t003 t005" x-target="the hands" x-target-head="t005" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbda" x-gloss="hands" x-translit="yāḏayim" xml:lang="hbo">יָדַ֣יִם</char> <char style="w" x-id="WLC.ISA.35.3.003" x-align="ISA.35.3.a003" x-target-ids="t004" x-target="weak" x-target-head="t004" x-head="true" lemma="רָפֶה" strong="H7504" x-morph="Aafpa" x-gloss="slack" x-translit="rāp̄ôṯ" xml:lang="hbo">רָפ֑וֹת</char> <char style="w" x-id="WLC.ISA.35.3.004" x-align="ISA.35.3.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.35.3.005" x-align="ISA.35.3.a005" x-target-ids="t008 t010" x-target="the knees" x-target-head="t010" x-head="true" lemma="בֶּרֶךְ" strong="H1290" x-morph="Ncfda" x-gloss="knees" x-translit="ḇirkayim" xml:lang="hbo">בִרְכַּ֥יִם</char> <char style="w" x-id="WLC.ISA.35.3.006" x-align="ISA.35.3.a006" x-target-ids="t009" x-target="feeble" x-target-head="t009" x-head="true" lemma="כָּשַׁל" strong="H3782" x-morph="Vqrfpa" x-gloss="[which].stumble" x-translit="kōšəlôṯ" xml:lang="hbo">כֹּשְׁל֖וֹת</char> <char style="w" x-id="WLC.ISA.35.3.007" x-align="ISA.35.3.a007" x-target-ids="t007" x-target="confirm" x-target-head="t007" x-head="true" lemma="אָמֵץ" strong="H553" x-morph="Vpv2mp" x-gloss="make.firm" x-translit="ʾammēṣû:" xml:lang="hbo">אַמֵּֽצוּ</char>׃<verse eid="ISA 35:3" /></para>
