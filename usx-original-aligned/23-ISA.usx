	<para style="p"><verse number="17" style="v" x-ref="ISA.9.17" sid="ISA 9:17" /><char style="w" x-id="WLC.ISA.9.17.001" x-align="ISA.9.17.a001" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo" x-source-ref="ISA.9.16">עַל</char>־<char style="w" x-id="WLC.ISA.9.17.002" x-align="ISA.9.17.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo" x-source-ref="ISA.9.16">כֵּ֨ן</char> <char style="w" x-id="WLC.ISA.9.17.003" x-align="ISA.9.17.a002" x-target-ids="t007" x-target="over" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="ISA.9.16">עַל</char>־<char style="w" x-id="WLC.ISA.9.17.004" x-align="ISA.9.17.a003" x-target-ids="t009 t010" x-target="young men" x-target-head="t010" x-head="true" lemma="בָּחוּר" strong="H970" x-morph="Ncmpc" x-gloss="men" x-translit="baḥûrāy" xml:lang="hbo" x-source-ref="ISA.9.16">בַּחוּרָ֜י</char><char style="w" x-id="WLC.ISA.9.17.005" x-align="ISA.9.17.a004" x-target-ids="t008" x-target="their" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its.young" x-translit="w" xml:lang="hbo" x-source-ref="ISA.9.16">ו</char> <char style="w" x-id="WLC.ISA.9.17.006" x-align="ISA.9.17.a005" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="ISA.9.16">לֹֽא</char>־<char style="w" x-id="WLC.ISA.9.17.007" x-align="ISA.9.17.a006" x-target-ids="t004 t006" x-target="will rejoice" x-target-head="t006" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3ms" x-gloss="he.rejoices" x-translit="yiśmaḥ" xml:lang="hbo" x-source-ref="ISA.9.16">יִשְׂמַ֣ח</char>׀<char style="w" x-id="WLC.ISA.9.17.008" x-align="ISA.9.17.a007" x-target-ids="t002 t003" x-target="the Lord" x-target-head="t003