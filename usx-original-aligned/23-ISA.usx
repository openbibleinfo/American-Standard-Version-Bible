	<para style="p"><verse number="28" style="v" x-ref="ISA.10.28" sid="ISA 10:28" /><char style="w" x-id="WLC.ISA.10.28.001" x-align="ISA.10.28.a001" x-target-ids="t001 t002 t003" x-target="He is come" x-target-head="t003" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqp3ms" x-gloss="he.has.come" x-translit="bāʾ" xml:lang="hbo">בָּ֥א</char> <char style="w" x-id="WLC.ISA.10.28.002" x-align="ISA.10.28.a002" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="to" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.10.28.003" x-align="ISA.10.28.a003" x-target-ids="t005" x-target="Aiath" x-target-head="t005" x-head="true" lemma="עַיַּת" strong="H5857b" x-morph="Np" x-gloss="Aiath" x-translit="ʿayyaṯ" xml:lang="hbo">עַיַּ֖ת</char> <char style="w" x-id="WLC.ISA.10.28.004" x-align="ISA.10.28.a004" x-target-ids="t006 t007 t008" x-target="he is passed" x-target-head="t008" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqp3ms" x-gloss="he.has.passed" x-translit="ʿāḇar" xml:lang="hbo">עָבַ֣ר</char> <char style="w" x-id="WLC.ISA.10.28.005" x-align="ISA.10.28.a005" x-target-ids="t009" x-target="through" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.10.28.006" x-align="ISA.10.28.a006" x-target-ids="t010" x-target="Migron" x-target-head="t010" x-head="true" lemma="מִגְרוֹן" strong="H4051" x-morph="Np" x-gloss="Migron" x-translit="miḡrôn" xml:lang="hbo">מִגְר֑וֹן</char> <char style="w" x-id="WLC.ISA.10.28.007" x-align="ISA.10.28.a007" x-target-ids="t011" x-target="at" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.10.28.008" x-align="ISA.10.28.a008" x-target-ids="t012" x-target="Michmash" x-target-head="t012" x-head="true" lemma="מִכְמָשׂ" strong="H4363a" x-morph="Np" x