	<para style="p"><verse number="15" style="v" x-ref="ISA.48.15" sid="ISA 48:15" /><char style="w" x-id="WLC.ISA.48.15.001" x-align="ISA.48.15.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֥י</char> <char style="w" x-id="WLC.ISA.48.15.002" x-align="ISA.48.15.a002" x-target-ids="t002 t003" x-target="even I" x-target-head="t003" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֛י</char> <char style="w" x-id="WLC.ISA.48.15.003" x-align="ISA.48.15.a003" x-target-ids="t004 t005" x-target="have spoken" x-target-head="t005" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpp1cs" x-gloss="I.have.spoken" x-translit="dibbarətî" xml:lang="hbo">דִּבַּ֖רְתִּי</char> <char style="w" x-id="WLC.ISA.48.15.004" x-align="ISA.48.15.a004" x-target-ids="t006" x-target="yea" x-target-head="t006" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo">אַף</char>־<char style="w" x-id="WLC.ISA.48.15.005" x-align="ISA.48.15.a005" x-target-ids="t007 t008 t009" x-target="I have called" x-target-head="t009" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqp1cs" x-gloss="I" x-translit="qərāʾṯiy" xml:lang="hbo">קְרָאתִ֑י</char><char style="w" x-id="WLC.ISA.48.15.006" x-align="ISA.48.15.a006" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="have.summoned.him" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.ISA.48.15.007" x-align="ISA.48.15.a007" x-target-ids="t011 t012 t013" x-target="I have brought" x-target-head="t013" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vhp1cs" x-gloss="I" x-translit="hăḇiyʾōṯiy" xml:lang="hbo">הֲבִיאֹתִ֖י</char><char style="w" x-id="WLC.ISA.48.15.008" x-align="ISA.48.15.a008" x-target-ids="t014" x-target="him" x-target-head="t014" x-head="tru