	<para style="p"><verse number="12" style="v" x-ref="ISA.51.12" sid="ISA 51:12" /><char style="w" x-id="WLC.ISA.51.12.001" x-align="ISA.51.12.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָנֹכִ֧י</char> <char style="w" x-id="WLC.ISA.51.12.002" x-align="ISA.51.12.a002" x-target-ids="t002 t003" x-target="even I" x-target-head="t003" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָנֹכִ֛י</char> <char style="w" x-id="WLC.ISA.51.12.003" x-align="ISA.51.12.a003" x-target-ids="t004 t005" x-target="am he" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="[am].he" x-translit="hûʾ" xml:lang="hbo">ה֖וּא</char> <char style="w" x-id="WLC.ISA.51.12.004" x-align="ISA.51.12.a004" x-target-ids="t006 t007" x-target="that comforteth" x-target-head="t007" x-head="true" lemma="נָחַם" strong="H5162" x-morph="Vprmsc" x-gloss="[who].comforts" x-translit="mənaḥem" xml:lang="hbo">מְנַחֶמְ</char><char style="w" x-id="WLC.ISA.51.12.005" x-align="ISA.51.12.a005" x-target-ids="t008" x-target="you" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="əḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.ISA.51.12.006" x-align="ISA.51.12.a006" x-target-ids="t009 t010" x-target="who art" x-target-head="t009" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy-" xml:lang="hbo">מִֽי</char>־<char style="w" x-id="WLC.ISA.51.12.007" x-align="ISA.51.12.a007" x-target-ids="t011" x-target="thou" x-target-head="t011" x-head="true" lemma="אַתְּ" strong="H859b" x-morph="Pp2fs" x-gloss="[are].you" x-translit="ʾatə" xml:lang="hbo">אַ֤תְּ</char> <char style="w" x-id="WLC.ISA.51.12.008" x-align="ISA.51.12.a008" x-target-ids="t012" x-target="that" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050