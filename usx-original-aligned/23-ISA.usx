	<para style="p"><verse number="25" style="v" x-ref="ISA.3.25" sid="ISA 3:25" /><char style="w" x-id="WLC.ISA.3.25.001" x-align="ISA.3.25.a001" x-target-ids="t002" x-target="men" x-target-head="t002" x-head="true" lemma="מַת" strong="H4962" x-morph="Ncmpc" x-gloss="men" x-translit="məṯay" xml:lang="hbo">מְתַ֖יִ</char><char style="w" x-id="WLC.ISA.3.25.002" x-align="ISA.3.25.a002" x-target-ids="t001" x-target="Thy" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="iḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.3.25.003" x-align="ISA.3.25.a003" x-target-ids="t005" x-target="by" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="by" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.ISA.3.25.004" x-align="ISA.3.25.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.3.25.005" x-align="ISA.3.25.a005" x-target-ids="t007" x-target="sword" x-target-head="t007" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="sword" x-translit="ḥereḇ" xml:lang="hbo">חֶ֣רֶב</char> <char style="w" x-id="WLC.ISA.3.25.006" x-align="ISA.3.25.a006" x-target-ids="t003 t004" x-target="shall fall" x-target-head="t004" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3mp" x-gloss="they.will.fall" x-translit="yippōlû" xml:lang="hbo">יִפֹּ֑לוּ</char> <char style="w" x-id="WLC.ISA.3.25.007" x-align="ISA.3.25.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.3.25.008" x-align="ISA.3.25.a008" x-target-ids="t010" x-target="mighty" x-target-head="t010" x-head="true" lemma="גְּבוּרָה" strong="H1369" x-morph="Ncfsc" x-gloss="strength" x-translit="ḡəḇûrāṯ" xml:lang="hbo">גְבוּ