	<para style="p"><verse number="13" style="v" x-ref="ISA.65.13" sid="ISA 65:13" /><char style="w" x-id="WLC.ISA.65.13.001" x-align="ISA.65.13.a001" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.65.13.002" x-align="ISA.65.13.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֞ן</char> <char style="w" x-id="WLC.ISA.65.13.003" x-align="ISA.65.13.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="kōh-" xml:lang="hbo">כֹּה</char>־<char style="w" x-id="WLC.ISA.65.13.004" x-align="ISA.65.13.a003" x-target-ids="t003" x-target="saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char>׀<char style="w" x-id="WLC.ISA.65.13.005" x-align="ISA.65.13.a004" x-target-ids="t005" x-target="Lord" x-target-head="t005" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֣</char><char style="w" x-id="WLC.ISA.65.13.006" x-align="ISA.65.13.a005" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.65.13.007" x-align="ISA.65.13.a006" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יְהֹוִה" strong="H3069" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwih" xml:lang="hbo">יְהוִ֗ה</char> <char style="w" x-id="WLC.ISA.65.13.008" x-align="ISA.65.13.a007" x-target-ids="t007" x-target="Behold" x-target-head="t007" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֨ה</char> <char style="w" x-id="WLC.ISA.65.13.009" x-align="ISA.65