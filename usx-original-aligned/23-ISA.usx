	<para style="p"><verse number="20" style="v" x-ref="ISA.1.20" x-added-alignments="ISA.1.20.a012" x-added-target-ids="t021" x-added-target="it" sid="ISA 1:20" /><char style="w" x-id="WLC.ISA.1.20.001" x-align="ISA.1.20.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.1.20.002" x-align="ISA.1.20.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.ISA.1.20.003" x-align="ISA.1.20.a003" x-target-ids="t003 t004" x-target="ye refuse" x-target-head="t004" x-head="true" lemma="מָאֵן" strong="H3985" x-morph="Vpi2mp" x-gloss="you.will.refuse" x-translit="təmāʾănû" xml:lang="hbo">תְּמָאֲנ֖וּ</char> <char style="w" x-id="WLC.ISA.1.20.004" x-align="ISA.1.20.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.1.20.005" x-align="ISA.1.20.a005" x-target-ids="t006" x-target="rebel" x-target-head="t006" x-head="true" lemma="מָרָה" strong="H4784" x-morph="Vqq2mp" x-gloss="you.will.rebel" x-translit="mərîṯem" xml:lang="hbo">מְרִיתֶ֑ם</char> <char style="w" x-id="WLC.ISA.1.20.006" x-align="ISA.1.20.a006" x-target-ids="t011 t012 t013" x-target="with the sword" x-target-head="t013" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="[the].sword" x-translit="ḥereḇ" xml:lang="hbo">חֶ֣רֶב</char> <char style="w" x-id="WLC.ISA.1.20.007" x-align="ISA.1.20.a007" x-target-ids="t007 t008 t009 t010" x-target="ye shall be devoured" x-target-head="t010" x-head="true" lemma="אָכַל" strong="H398" x-morph="VQi2mp" x-gloss="you.will.be.eaten" x-translit="təʾukkəlû" xml:lang="hbo">תְּאֻכְּל֔וּ</char> <char style="w" x-id="WLC.ISA.1.20.008" x-align="ISA.1.20.