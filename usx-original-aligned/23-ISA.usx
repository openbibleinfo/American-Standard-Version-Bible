	<para style="p"><verse number="11" style="v" x-ref="ISA.19.11" sid="ISA 19:11" /><char style="w" x-id="WLC.ISA.19.11.001" x-align="ISA.19.11.a001" x-target-ids="t006" x-target="utterly" x-target-head="t006" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="[are].only" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.ISA.19.11.002" x-align="ISA.19.11.a002" x-target-ids="t005 t007" x-target="are foolish" x-target-head="t007" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aampa" x-gloss="fools" x-translit="ʾĕwilîm" xml:lang="hbo">אֱוִלִים֙</char> <char style="w" x-id="WLC.ISA.19.11.003" x-align="ISA.19.11.a003" x-target-ids="t001 t002" x-target="The princes" x-target-head="t002" x-head="true" lemma="שַׂר" strong="H8269" x-morph="Ncmpc" x-gloss="the.officials" x-translit="śārê" xml:lang="hbo">שָׂ֣רֵי</char> <char style="w" x-id="WLC.ISA.19.11.004" x-align="ISA.19.11.a004" x-target-ids="t003 t004" x-target="of Zoan" x-target-head="t004" x-head="true" lemma="צֹעַן" strong="H6814" x-morph="Np" x-gloss="of.Zoan" x-translit="ṣōʿan" xml:lang="hbo">צֹ֔עַן</char> <char style="w" x-id="WLC.ISA.19.11.005" x-align="ISA.19.11.a005" x-target-ids="t010 t011 t012" x-target="of the wisest" x-target-head="t012" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampc" x-gloss="the.wise.[people]" x-translit="ḥaḵmê" xml:lang="hbo">חַכְמֵי֙</char> <char style="w" x-id="WLC.ISA.19.11.006" x-align="ISA.19.11.a006" x-target-ids="t013" x-target="counsellors" x-target-head="t013" x-head="true" lemma="יעץ" strong="H3289a" x-morph="Vqrmpc" x-gloss="of.the.counselors" x-translit="yōʿăṣēy" xml:lang="hbo">יֹעֲצֵ֣י</char> <char style="w" x-id="WLC.ISA.19.11.007" x-align="ISA.19.11.a007" x-target-ids="t014 t015" x-target="of Pharaoh" x-target-head="t015" x-head="true" lemma="פַּרְעֹה" strong="H6547" x-morph="Np" x-gloss="of.Pharaoh" x-translit="p̄arʿōh" xml:lang="hbo">פַרְעֹ֔ה</char> <char style="w" x-id="WLC.ISA.19.11.008" x-align="ISA.19.11.a008" x-target-id