	<para style="p"><verse number="6" style="v" x-ref="ISA.39.6" sid="ISA 39:6" /><char style="w" x-id="WLC.ISA.39.6.001" x-align="ISA.39.6.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּה֮</char> <char style="w" x-id="WLC.ISA.39.6.002" x-align="ISA.39.6.a002" x-target-ids="t002 t003" x-target="the days" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="days" x-translit="yāmiym" xml:lang="hbo">יָמִ֣ים</char> <char style="w" x-id="WLC.ISA.39.6.003" x-align="ISA.39.6.a003" x-target-ids="t004 t005" x-target="are coming" x-target-head="t005" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqrmpa" x-gloss="[are].coming" x-translit="bāʾîm" xml:lang="hbo">בָּאִים֒</char> <char style="w" x-id="WLC.ISA.39.6.004" x-align="ISA.39.6.a004" x-target-ids="t006" x-target="when" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.39.6.005" x-align="ISA.39.6.a005" x-target-ids="t026 t027 t028" x-target="shall be carried" x-target-head="t028" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="VNq3ms" x-gloss="it.will.be.carried.off" x-translit="niśśāʾ" xml:lang="hbo">נִשָּׂ֣א</char>׀<char style="w" x-id="WLC.ISA.39.6.006" x-align="ISA.39.6.a006" x-target-ids="t007" x-target="all" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.39.6.007" x-align="ISA.39.6.a007" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="that" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.ISA.39.6.008" x-align="ISA.39.6.a008" x-target-ids="t009 t010" x-target="is in" x-target-head="t010" x-head="true" lemma="בְּ" strong="H87