05" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.ISA.65.25.026" x-align="ISA.65.25.a024" x-target-ids="t035" x-target="mountain" x-target-head="t035" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmsc" x-gloss="the.mountain" x-translit="har" xml:lang="hbo">הַ֥ר</char> <char style="w" x-id="WLC.ISA.65.25.027" x-align="ISA.65.25.a025" x-target-ids="t034" x-target="holy" x-target-head="t034" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsc" x-gloss="my.holiness" x-translit="qāḏəš" xml:lang="hbo">קָדְשִׁ֖</char><char style="w" x-id="WLC.ISA.65.25.028" x-align="ISA.65.25.a026" x-target-ids="t033" x-target="my" x-target-head="t033" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.65.25.029" x-align="ISA.65.25.a027" x-target-ids="t036" x-target="saith" x-target-head="t036" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֥ר</char> <char style="w" x-id="WLC.ISA.65.25.030" x-align="ISA.65.25.a028" x-target-ids="t037" x-target="Jehovah" x-target-head="t037" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh:" xml:lang="hbo">יְהוָֽה</char>׃ס<verse eid="ISA 65:25" /></para>
