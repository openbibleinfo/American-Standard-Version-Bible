	<para style="p"><verse number="5" style="v" x-ref="ISA.10.5" sid="ISA 10:5" /><char style="w" x-id="WLC.ISA.10.5.001" x-align="ISA.10.5.a001" x-target-ids="t001" x-target="Ho" x-target-head="t001" x-head="true" lemma="הוֹי" strong="H1945" x-morph="Tj" x-gloss="woe.to!" x-translit="hôy" xml:lang="hbo">ה֥וֹי</char> <char style="w" x-id="WLC.ISA.10.5.002" x-align="ISA.10.5.a002" x-target-ids="t002" x-target="Assyrian" x-target-head="t002" x-head="true" lemma="אַשּׁוּר" strong="H804" x-morph="Np" x-gloss="Assyria" x-translit="ʾaššûr" xml:lang="hbo">אַשּׁ֖וּר</char> <char style="w" x-id="WLC.ISA.10.5.003" x-align="ISA.10.5.a003" x-target-ids="t003 t004" x-target="the rod" x-target-head="t004" x-head="true" lemma="שֵׁבֶט" strong="H7626" x-morph="Ncmsc" x-gloss="the.rod" x-translit="šēḇeṭ" xml:lang="hbo">שֵׁ֣בֶט</char> <char style="w" x-id="WLC.ISA.10.5.004" x-align="ISA.10.5.a004" x-target-ids="t005 t007" x-target="of anger" x-target-head="t007" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsc" x-gloss="my.anger" x-translit="ʾapp" xml:lang="hbo">אַפִּ֑</char><char style="w" x-id="WLC.ISA.10.5.005" x-align="ISA.10.5.a005" x-target-ids="t006" x-target="mine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.10.5.006" x-align="ISA.10.5.a006" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.10.5.007" x-align="ISA.10.5.a007" x-target-ids="t008 t009" x-target="the staff" x-target-head="t009" x-head="true" lemma="מַטֶּה" strong="H4294" x-morph="Ncmsa" x-gloss="a.staff" x-translit="maṭṭeh-" xml:lang="hbo">מַטֶּה</char>־<char style="w" x-id="WLC.ISA.10.5.008" x-align="ISA.10.5.a008" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="hûʾ" xml:lang="hbo">ה֥וּא</char> <char style="w" x-id="WLC.I