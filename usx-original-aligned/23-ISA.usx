	<para style="p"><verse number="10" style="v" x-ref="ISA.33.10" sid="ISA 33:10" /><char style="w" x-id="WLC.ISA.33.10.001" x-align="ISA.33.10.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֥ה</char> <char style="w" x-id="WLC.ISA.33.10.002" x-align="ISA.33.10.a002" x-target-ids="t002 t003 t004" x-target="will I arise" x-target-head="t004" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi1cs" x-gloss="I.will.arise" x-translit="ʾāqûm" xml:lang="hbo">אָק֖וּם</char> <char style="w" x-id="WLC.ISA.33.10.003" x-align="ISA.33.10.a003" x-target-ids="t005" x-target="saith" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3ms" x-gloss="he.says" x-translit="yōʾmar" xml:lang="hbo">יֹאמַ֣ר</char> <char style="w" x-id="WLC.ISA.33.10.004" x-align="ISA.33.10.a004" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.ISA.33.10.005" x-align="ISA.33.10.a005" x-target-ids="t007" x-target="now" x-target-head="t007" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּה֙</char> <char style="w" x-id="WLC.ISA.33.10.006" x-align="ISA.33.10.a006" x-target-ids="t008 t009 t010 t011 t012" x-target="will I lift up myself" x-target-head="t010" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vri1cs" x-gloss="I.will.exalt.myself" x-translit="ʾērômām" xml:lang="hbo">אֵֽרוֹמָ֔ם</char> <char style="w" x-id="WLC.ISA.33.10.007" x-align="ISA.33.10.a007" x-target-ids="t013" x-target="now" x-target-head="t013" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֖ה</char> <char style="w" x-id="WLC.ISA.33.10.008" x-align="ISA.33.10.a008" x-target-ids="t014 t015 t016 t017" x-target="will I 