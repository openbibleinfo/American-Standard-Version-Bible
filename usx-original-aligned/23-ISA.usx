	<para style="p"><verse number="10" style="v" x-ref="ISA.9.10" x-added-alignments="ISA.9.10.a011" x-added-target-ids="t023" x-added-target="their" sid="ISA 9:10" /><char style="w" x-id="WLC.ISA.9.10.001" x-align="ISA.9.10.a001" x-target-ids="t001 t002" x-target="The bricks" x-target-head="t002" x-head="true" lemma="לְבֵנָה" strong="H3843" x-morph="Ncfpa" x-gloss="bricks" x-translit="ləḇēniym" xml:lang="hbo" x-source-ref="ISA.9.9">לְבֵנִ֥ים</char> <char style="w" x-id="WLC.ISA.9.10.002" x-align="ISA.9.10.a002" x-target-ids="t003 t004" x-target="are fallen" x-target-head="t004" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqp3cp" x-gloss="they.have.fallen" x-translit="nāp̄ālû" xml:lang="hbo" x-source-ref="ISA.9.9">נָפָ֖לוּ</char> <char style="w" x-id="WLC.ISA.9.10.003" x-align="ISA.9.10.a003" x-target-ids="t005" x-target="but" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="ISA.9.9">וְ</char><char style="w" x-id="WLC.ISA.9.10.004" x-align="ISA.9.10.a004" x-target-ids="t009 t010 t011" x-target="with hewn stone" x-target-head="t010" x-head="true" lemma="גָּזִית" strong="H1496" x-morph="Ncfsa" x-gloss="hewn.[stone]" x-translit="ḡāziyṯ" xml:lang="hbo" x-source-ref="ISA.9.9">גָזִ֣ית</char> <char style="w" x-id="WLC.ISA.9.10.005" x-align="ISA.9.10.a005" x-target-ids="t006 t007 t008" x-target="we will build" x-target-head="t008" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="Vqi1cp" x-gloss="we.will.rebuild" x-translit="niḇneh" xml:lang="hbo" x-source-ref="ISA.9.9">נִבְנֶ֑ה</char> <char style="w" x-id="WLC.ISA.9.10.006" x-align="ISA.9.10.a006" x-target-ids="t012 t013" x-target="the sycomores" x-target-head="t013" x-head="true" lemma="שִׁקְמָה" strong="H8256" x-morph="Ncfpa" x-gloss="sycamores" x-translit="šiqmiym" xml:lang="hbo" x-source-ref="ISA.9.9">שִׁקְמִ֣ים</char> <char style="w" x-id="WLC.ISA.9.10.007" x-align="ISA.9.10.a007" x-target-ids="t014 t015 t016" x-target="are cut