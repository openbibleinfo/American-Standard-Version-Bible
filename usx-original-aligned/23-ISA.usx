	<para style="p"><verse number="1" style="v" x-ref="ISA.25.1" x-added-alignments="ISA.25.1.a014 ISA.25.1.a018" x-added-target-ids="t022 t028" x-added-target="even | and" sid="ISA 25:1" /><char style="w" x-id="WLC.ISA.25.1.001" x-align="ISA.25.1.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֤ה</char> <char style="w" x-id="WLC.ISA.25.1.002" x-align="ISA.25.1.a002" x-target-ids="t004 t006" x-target="art God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōh" xml:lang="hbo">אֱלֹהַ</char><char style="w" x-id="WLC.ISA.25.1.003" x-align="ISA.25.1.a003" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[are].my" x-translit="ay" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.25.1.004" x-align="ISA.25.1.a004" x-target-ids="t003" x-target="thou" x-target-head="t003" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֔ה</char> <char style="w" x-id="WLC.ISA.25.1.005" x-align="ISA.25.1.a005" x-target-ids="t007 t008 t009" x-target="I will exalt" x-target-head="t009" x-head="true" lemma="רוּם" strong="H7311" x-morph="Voi1cs" x-gloss="I" x-translit="ʾărômim" xml:lang="hbo">אֲרֽוֹמִמְ</char><char style="w" x-id="WLC.ISA.25.1.006" x-align="ISA.25.1.a006" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.exalt.you" x-translit="əḵā" xml:lang="hbo">ךָ֙</char> <char style="w" x-id="WLC.ISA.25.1.007" x-align="ISA.25.1.a007" x-target-ids="t011 t012 t013" x-target="I will praise" x-target-head="t013" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I.will.give.thanks.to" x-translit="ʾôḏeh" xml:lang="hbo">אוֹדֶ֣ה</char> <char style="w" x-id="WLC.ISA.25.