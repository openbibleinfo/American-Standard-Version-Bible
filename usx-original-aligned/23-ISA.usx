	<para style="p"><verse number="13" style="v" x-ref="ISA.24.13" sid="ISA 24:13" /><char style="w" x-id="WLC.ISA.24.13.001" x-align="ISA.24.13.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.ISA.24.13.002" x-align="ISA.24.13.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="ḵōh" xml:lang="hbo">כֹ֥ה</char> <char style="w" x-id="WLC.ISA.24.13.003" x-align="ISA.24.13.a003" x-target-ids="t003 t004 t005" x-target="shall it be" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="it.will.be" x-translit="yihyeh" xml:lang="hbo">יִהְיֶ֛ה</char> <char style="w" x-id="WLC.ISA.24.13.004" x-align="ISA.24.13.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.24.13.005" x-align="ISA.24.13.a005" x-target-ids="t007 t008" x-target="the midst" x-target-head="t008" x-head="true" lemma="קֶרֶב" strong="H7130" x-morph="Ncmsc" x-gloss="the.midst" x-translit="qereḇ" xml:lang="hbo">קֶ֥רֶב</char> <char style="w" x-id="WLC.ISA.24.13.006" x-align="ISA.24.13.a006" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.ISA.24.13.007" x-align="ISA.24.13.a007" x-target-ids="t009 t011" x-target="of earth" x-target-head="t011" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="the.earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֖רֶץ</char> <char style="w" x-id="WLC.ISA.24.13.008" x-align="ISA.24.13.a008" x-status="noncompositional" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-translit="bə" xml:lang="hbo">בְּ</char><char sty