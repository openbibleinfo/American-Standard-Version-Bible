	<para style="p"><verse number="21" style="v" x-ref="ISA.1.21" sid="ISA 1:21" /><char style="w" x-id="WLC.ISA.1.21.001" x-align="ISA.1.21.a001" x-target-ids="t001" x-target="How" x-target-head="t001" x-head="true" lemma="אֵיכָה" strong="H349a" x-morph="Ti" x-gloss="how!" x-translit="ʾêḵāh" xml:lang="hbo">אֵיכָה֙</char> <char style="w" x-id="WLC.ISA.1.21.002" x-align="ISA.1.21.a002" x-target-ids="t002 t006" x-target="is become" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3fs" x-gloss="it.has.become" x-translit="hāyəṯāh" xml:lang="hbo">הָיְתָ֣ה</char> <char style="w" x-id="WLC.ISA.1.21.003" x-align="ISA.1.21.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(into).a" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.1.21.004" x-align="ISA.1.21.a004" x-target-ids="t007 t008" x-target="a harlot" x-target-head="t008" x-head="true" lemma="זָנָה" strong="H2185" x-morph="Vqrfsa" x-gloss="prostitute" x-translit="zônāh" xml:lang="hbo">זוֹנָ֔ה</char> <char style="w" x-id="WLC.ISA.1.21.005" x-align="ISA.1.21.a005" x-target-ids="t003 t005" x-target="the city" x-target-head="t005" x-head="true" lemma="קִרְיָה" strong="H7151" x-morph="Ncfsa" x-gloss="a.town" x-translit="qiryāh" xml:lang="hbo">קִרְיָ֖ה</char> <char style="w" x-id="WLC.ISA.1.21.006" x-align="ISA.1.21.a006" x-target-ids="t004" x-target="faithful" x-target-head="t004" x-head="true" lemma="אָמַן" strong="H539" x-morph="VNrfsa" x-gloss="faithful" x-translit="neʾĕmānāh" xml:lang="hbo">נֶאֱמָנָ֑ה</char> <char style="w" x-id="WLC.ISA.1.21.007" x-align="ISA.1.21.a007" x-target-ids="t009 t010 t011 t012" x-target="she that was full" x-target-head="t012" x-head="true" lemma="מָלֵא" strong="H4392" x-morph="Aafsc" x-gloss="full" x-translit="məlēʾăṯiy" xml:lang="hbo">מְלֵאֲתִ֣י</char> <char style="w" x-id="WLC.ISA.1.21.008" x-align="ISA.1.21.a008" x-target-ids="t013 t014" x-target="of justice" x-target-head="t014" x-head="true" lemma="מ