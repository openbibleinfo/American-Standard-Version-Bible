	<para style="p"><verse number="32" style="v" x-ref="ISA.14.32" x-added-alignments="ISA.14.32.a004" x-added-target-ids="t004" x-added-target="one" sid="ISA 14:32" /><char style="w" x-id="WLC.ISA.14.32.001" x-align="ISA.14.32.a001" x-target-ids="t002" x-target="then" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.14.32.002" x-align="ISA.14.32.a002" x-target-ids="t001" x-target="What" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַֽה</char>־<char style="w" x-id="WLC.ISA.14.32.003" x-align="ISA.14.32.a003" x-target-ids="t003 t005" x-target="shall answer" x-target-head="t005" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi3ms" x-gloss="will.anyone.answer" x-translit="yyaʿăneh" xml:lang="hbo">יַּעֲנֶ֖ה</char> <char style="w" x-id="WLC.ISA.14.32.004" x-align="ISA.14.32.a005" x-target-ids="t006 t007" x-target="the messengers" x-target-head="t007" x-head="true" lemma="מַלְאָךְ" strong="H4397" x-morph="Ncmpc" x-gloss="[the].messengers" x-translit="malʾăḵê-" xml:lang="hbo">מַלְאֲכֵי</char>־<char style="w" x-id="WLC.ISA.14.32.005" x-align="ISA.14.32.a006" x-target-ids="t008 t009 t010" x-target="of the nation" x-target-head="t010" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="of.a.nation" x-translit="ḡôy" xml:lang="hbo">ג֑וֹי</char> <char style="w" x-id="WLC.ISA.14.32.006" x-align="ISA.14.32.a007" x-target-ids="t011" x-target="That" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.ISA.14.32.007" x-align="ISA.14.32.a008" x-target-ids="t012" x-target="Jehovah" x-target-head="t012" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.ISA.14.32.008" x-align="ISA.14.