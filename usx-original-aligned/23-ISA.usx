	<para style="p"><verse number="2" style="v" x-ref="ISA.25.2" sid="ISA 25:2" /><char style="w" x-id="WLC.ISA.25.2.001" x-align="ISA.25.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.ISA.25.2.002" x-align="ISA.25.2.a002" x-target-ids="t002 t003 t004" x-target="thou hast made" x-target-head="t004" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqp2ms" x-gloss="you.have.made" x-translit="śamətā" xml:lang="hbo">שַׂ֤מְתָּ</char> <char style="w" x-id="WLC.ISA.25.2.003" x-align="ISA.25.2.a003" x-target-ids="t005" x-target="of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.ISA.25.2.004" x-align="ISA.25.2.a004" x-target-ids="t006 t007" x-target="a city" x-target-head="t007" x-head="true" lemma="עִיר" strong="H5892" x-morph="Ncfsa" x-gloss="a.city" x-translit="ʿîr" xml:lang="hbo">עִיר֙</char> <char style="w" x-id="WLC.ISA.25.2.005" x-align="ISA.25.2.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="into" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.ISA.25.2.006" x-align="ISA.25.2.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.25.2.007" x-align="ISA.25.2.a007" x-target-ids="t008 t009" x-target="a heap" x-target-head="t009" x-head="true" lemma="גַּל" strong="H1530" x-morph="Ncmsa" x-gloss="heap" x-translit="gāl" xml:lang="hbo">גָּ֔ל</char> <char style="w" x-id="WLC.ISA.25.2.008" x-align="ISA.25.2.a008" x-target-ids="t010 t011 t013" x-target="of a city" x-target-head="t013" x-head="true" lemma="קִרְיָה" strong="H7151" x-morph="Ncfsa" x-gloss="a.town" x-translit="qiryāh" xml:lang="hbo">קִרְיָ֥ה</char> <char style="w" x-id="WL