	<para style="p"><verse number="3" style="v" x-ref="ISA.2.3" sid="ISA 2:3" /><char style="w" x-id="WLC.ISA.2.3.001" x-align="ISA.2.3.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.ISA.2.3.002" x-align="ISA.2.3.a002" x-target-ids="t004 t005" x-target="shall go" x-target-head="t005" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqq3cp" x-gloss="they.will.come" x-translit="hāləḵû" xml:lang="hbo">הָלְכ֞וּ</char> <char style="w" x-id="WLC.ISA.2.3.003" x-align="ISA.2.3.a003" x-target-ids="t003" x-target="peoples" x-target-head="t003" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmpa" x-gloss="peoples" x-translit="ʿammiym" xml:lang="hbo">עַמִּ֣ים</char> <char style="w" x-id="WLC.ISA.2.3.004" x-align="ISA.2.3.a004" x-target-ids="t002" x-target="many" x-target-head="t002" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many" x-translit="rabbiym" xml:lang="hbo">רַבִּ֗ים</char> <char style="w" x-id="WLC.ISA.2.3.005" x-align="ISA.2.3.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.2.3.006" x-align="ISA.2.3.a006" x-target-ids="t007" x-target="say" x-target-head="t007" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq3cp" x-gloss="they.will.say" x-translit="ʾāmərû" xml:lang="hbo">אָמְרוּ֙</char> <char style="w" x-id="WLC.ISA.2.3.007" x-align="ISA.2.3.a007" x-target-ids="t008 t009" x-target="Come ye" x-target-head="t008" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2mp" x-gloss="come" x-translit="ləḵû" xml:lang="hbo">לְכ֣וּ</char>׀<char style="w" x-id="WLC.ISA.2.3.008" x-align="ISA.2.3.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">