	<para style="p"><verse number="2" style="v" x-ref="ISA.59.2" sid="ISA 59:2" /><char style="w" x-id="WLC.ISA.59.2.001" x-align="ISA.59.2.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.ISA.59.2.002" x-align="ISA.59.2.a001" lemma="אִם" strong="H518" x-morph="C" x-gloss="(if)" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.ISA.59.2.003" x-align="ISA.59.2.a002" x-target-ids="t003" x-target="iniquities" x-target-head="t003" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbpc" x-gloss="iniquities" x-translit="ʿăônōṯēy" xml:lang="hbo">עֲוֺנֹֽתֵי</char><char style="w" x-id="WLC.ISA.59.2.004" x-align="ISA.59.2.a003" x-target-ids="t002" x-target="your" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶם֙</char> <char style="w" x-id="WLC.ISA.59.2.005" x-align="ISA.59.2.a004" x-target-ids="t004" x-target="have" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3cp" x-gloss="they.have.been" x-translit="hāyû" xml:lang="hbo">הָי֣וּ</char> <char style="w" x-id="WLC.ISA.59.2.006" x-align="ISA.59.2.a005" x-target-ids="t005" x-target="separated" x-target-head="t005" x-head="true" lemma="בָּדַל" strong="H914" x-morph="Vhrmpa" x-gloss="separating" x-translit="maḇdiliym" xml:lang="hbo">מַבְדִּלִ֔ים</char> <char style="w" x-id="WLC.ISA.59.2.007" x-align="ISA.59.2.a006" x-target-ids="t006" x-target="between" x-target-head="t006" x-head="true" lemma="בֵּין" strong="H996" x-morph="R" x-gloss="between" x-translit="bēyn" xml:lang="hbo">בֵּינֵ</char><char style="w" x-id="WLC.ISA.59.2.008" x-align="ISA.59.2.a007" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="ēḵem" xml:lang="hbo">כֶ֕ם</char> <char style="w" x-id="WLC.IS