	<para style="p"><verse number="3" style="v" x-ref="ISA.34.3" sid="ISA 34:3" /><char style="w" x-id="WLC.ISA.34.3.001" x-align="ISA.34.3.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.34.3.002" x-align="ISA.34.3.a002" x-target-ids="t002" x-target="slain" x-target-head="t002" x-head="true" lemma="חָלָל" strong="H2491" x-morph="Aampc" x-gloss="their.slain" x-translit="ḥallēy" xml:lang="hbo">חַלְלֵי</char><char style="w" x-id="WLC.ISA.34.3.003" x-align="ISA.34.3.a003" x-target-ids="t001" x-target="Their" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="[ones]" x-translit="hem" xml:lang="hbo">הֶ֣ם</char> <char style="w" x-id="WLC.ISA.34.3.004" x-align="ISA.34.3.a004" x-target-ids="t004 t005 t006 t007" x-target="shall be cast out" x-target-head="t006" x-head="true" lemma="שָׁלַךְ" strong="H7993" x-morph="VHi3mp" x-gloss="they.will.be.thrown.out" x-translit="yušlāḵû" xml:lang="hbo">יֻשְׁלָ֔כוּ</char> <char style="w" x-id="WLC.ISA.34.3.005" x-align="ISA.34.3.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.34.3.006" x-align="ISA.34.3.a006" x-target-ids="t013 t014" x-target="dead bodies" x-target-head="t013" x-head="true" lemma="פֶּגֶר" strong="H6297" x-morph="Ncmpc" x-gloss="corpses" x-translit="p̄iḡrēy" xml:lang="hbo">פִגְרֵי</char><char style="w" x-id="WLC.ISA.34.3.007" x-align="ISA.34.3.a007" x-target-ids="t012" x-target="their" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo">הֶ֖ם</char> <char style="w" x-id="WLC.ISA.34.3.008" x-align="ISA.34.3.a008" x-target-ids="t015 t016 t017" x-target="shall come up" x-target-head="t016" x-head="true" lemma="עָלָה" str