	<para style="p"><verse number="4" style="v" x-ref="ISA.49.4" x-added-alignments="ISA.49.4.a016" x-added-target-ids="t022" x-added-target="due" sid="ISA 49:4" /><char style="w" x-id="WLC.ISA.49.4.001" x-align="ISA.49.4.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.ISA.49.4.002" x-align="ISA.49.4.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֤י</char> <char style="w" x-id="WLC.ISA.49.4.003" x-align="ISA.49.4.a003" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp1cs" x-gloss="I.said" x-translit="ʾāmarətî" xml:lang="hbo">אָמַ֨רְתִּי֙</char> <char style="w" x-id="WLC.ISA.49.4.004" x-align="ISA.49.4.a004" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.49.4.005" x-align="ISA.49.4.a005" x-target-ids="t008" x-target="vain" x-target-head="t008" x-head="true" lemma="רִיק" strong="H7385" x-morph="Ncmsa" x-gloss="emptiness" x-translit="riyq" xml:lang="hbo">רִ֣יק</char> <char style="w" x-id="WLC.ISA.49.4.006" x-align="ISA.49.4.a006" x-target-ids="t004 t005 t006" x-target="I have labored" x-target-head="t006" x-head="true" lemma="יָגֵעַ" strong="H3021" x-morph="Vqp1cs" x-gloss="I.have.labored" x-translit="yāḡaʿətî" xml:lang="hbo">יָגַ֔עְתִּי</char> <char style="w" x-id="WLC.ISA.49.4.007" x-align="ISA.49.4.a007" x-target-ids="t014" x-target="for" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.49.4.008" x-align="ISA.49.4.a008" x-target-ids="t015" x-target="nought" x-target-head="t015" x-head="true" lemma=