	<para style="p"><verse number="2" style="v" x-ref="ISA.44.2" sid="ISA 44:2" /><char style="w" x-id="WLC.ISA.44.2.001" x-align="ISA.44.2.a001" x-target-ids="t001" x-target="Thus" x-target-head="t001" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="kōh-" xml:lang="hbo">כֹּה</char>־<char style="w" x-id="WLC.ISA.44.2.002" x-align="ISA.44.2.a002" x-target-ids="t002" x-target="saith" x-target-head="t002" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֨ר</char> <char style="w" x-id="WLC.ISA.44.2.003" x-align="ISA.44.2.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֥ה</char> <char style="w" x-id="WLC.ISA.44.2.004" x-align="ISA.44.2.a004" x-target-ids="t004 t005" x-target="that made" x-target-head="t005" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[who].made" x-translit="ʿōś" xml:lang="hbo">עֹשֶׂ֛</char><char style="w" x-id="WLC.ISA.44.2.005" x-align="ISA.44.2.a005" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.44.2.006" x-align="ISA.44.2.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[who]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.44.2.007" x-align="ISA.44.2.a007" x-target-ids="t008" x-target="formed" x-target-head="t008" x-head="true" lemma="יָצַר" strong="H3335" x-morph="Vqrmsc" x-gloss="formed" x-translit="yōṣer" xml:lang="hbo">יֹצֶרְ</char><char style="w" x-id="WLC.ISA.44.2.008" x-align="ISA.44.2.a008" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang