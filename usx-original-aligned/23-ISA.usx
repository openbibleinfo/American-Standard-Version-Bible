	<para style="p"><verse number="2" style="v" x-ref="ISA.53.2" x-added-alignments="ISA.53.2.a022" x-added-target-ids="t027" x-added-target="when" sid="ISA 53:2" /><char style="w" x-id="WLC.ISA.53.2.001" x-align="ISA.53.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.ISA.53.2.002" x-align="ISA.53.2.a002" x-target-ids="t002 t003 t004" x-target="he grew up" x-target-head="t003" x-head="true" lemma="עָלָה" strong="H5927" x-morph="Vqw3ms" x-gloss="he.grew.up" x-translit="yyaʿal" xml:lang="hbo">יַּ֨עַל</char> <char style="w" x-id="WLC.ISA.53.2.003" x-align="ISA.53.2.a003" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.ISA.53.2.004" x-align="ISA.53.2.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.53.2.005" x-align="ISA.53.2.a005" x-target-ids="t008 t009 t010" x-target="a tender plant" x-target-head="t009" x-head="true" lemma="יוֹנֵק" strong="H3126" x-morph="Ncmsa" x-gloss="shoot" x-translit="yyônēq" xml:lang="hbo">יּוֹנֵ֜ק</char> <char style="w" x-id="WLC.ISA.53.2.006" x-align="ISA.53.2.a006" x-status="noncompositional" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.53.2.007" x-align="ISA.53.2.a006" x-status="noncompositional" x-target-ids="t005" x-target="before" x-target-head="t005" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ānāy" xml:lang="hbo">פָנָ֗י</char><char style="w" x-id="WLC.ISA.53.2.008" x-align="ISA.53.2.a007" x-target-ids="t006" x-target="him" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-