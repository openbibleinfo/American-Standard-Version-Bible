	<para style="p"><verse number="5" style="v" x-ref="ISA.55.5" x-added-alignments="ISA.55.5.a003 ISA.55.5.a009" x-added-target-ids="t007 t014" x-added-target="that | that" sid="ISA 55:5" /><char style="w" x-id="WLC.ISA.55.5.001" x-align="ISA.55.5.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֣ן</char> <char style="w" x-id="WLC.ISA.55.5.002" x-align="ISA.55.5.a002" x-target-ids="t005 t006" x-target="a nation" x-target-head="t006" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="a.nation" x-translit="gôy" xml:lang="hbo">גּ֤וֹי</char> <char style="w" x-id="WLC.ISA.55.5.003" x-align="ISA.55.5.a004" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[which].not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.ISA.55.5.004" x-align="ISA.55.5.a005" x-target-ids="t008 t009" x-target="thou knowest" x-target-head="t009" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqi2ms" x-gloss="you.know" x-translit="ṯēḏaʿ" xml:lang="hbo">תֵדַע֙</char> <char style="w" x-id="WLC.ISA.55.5.005" x-align="ISA.55.5.a006" x-target-ids="t002 t003 t004" x-target="thou shalt call" x-target-head="t004" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi2ms" x-gloss="you.will.call" x-translit="tiqrāʾ" xml:lang="hbo">תִּקְרָ֔א</char> <char style="w" x-id="WLC.ISA.55.5.006" x-align="ISA.55.5.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.55.5.007" x-align="ISA.55.5.a008" x-target-ids="t012 t013" x-target="a nation" x-target-head="t013" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="a.nation" x-translit="ḡôy" xml:lang="hbo">ג֥וֹי</char> <char style="w" x-id="WLC.ISA.55.5.008" x-align="ISA.55.5.a0