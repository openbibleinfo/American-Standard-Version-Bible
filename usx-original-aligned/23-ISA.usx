	<para style="p"><verse number="24" style="v" x-ref="ISA.65.24" sid="ISA 65:24" /><char style="w" x-id="WLC.ISA.65.24.001" x-align="ISA.65.24.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.65.24.002" x-align="ISA.65.24.a002" x-target-ids="t002 t003 t004 t005 t006 t007" x-target="it shall come to pass that" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָ֥ה</char> <char style="w" x-id="WLC.ISA.65.24.003" x-align="ISA.65.24.a003" x-target-ids="t008" x-target="before" x-target-head="t008" x-head="true" lemma="טֶרֶם" strong="H2962" x-morph="D" x-gloss="before" x-translit="ṭerem-" xml:lang="hbo">טֶֽרֶם</char>־<char style="w" x-id="WLC.ISA.65.24.004" x-align="ISA.65.24.a004" x-target-ids="t009 t010" x-target="they call" x-target-head="t010" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi3mp" x-gloss="they.will.call" x-translit="yiqrāʾû" xml:lang="hbo">יִקְרָ֖אוּ</char> <char style="w" x-id="WLC.ISA.65.24.005" x-align="ISA.65.24.a005" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.ISA.65.24.006" x-align="ISA.65.24.a006" x-target-ids="t011" x-target="I" x-target-head="t011" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֣י</char> <char style="w" x-id="WLC.ISA.65.24.007" x-align="ISA.65.24.a007" x-target-ids="t012 t013" x-target="will answer" x-target-head="t013" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi1cs" x-gloss="I.will.answer" x-translit="ʾeʿĕneh" xml:lang="hbo">אֶעֱנֶ֑ה</char> <char style="w" x-id="WLC.ISA.65.24.008" x-align="ISA.65.24.a009" x-target-ids="t015 t018" x-target="while yet" x-target-head="t018" x-head="true" lemma="עוֹד" stron