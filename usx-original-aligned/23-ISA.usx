	<para style="p"><verse number="5" style="v" x-ref="ISA.50.5" sid="ISA 50:5" /><char style="w" x-id="WLC.ISA.50.5.001" x-align="ISA.50.5.a001" x-status="noncompositional" x-target-ids="t001 t002" x-target="The Lord" x-target-head="t002" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֤</char><char style="w" x-id="WLC.ISA.50.5.002" x-align="ISA.50.5.a001" x-status="noncompositional" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.50.5.003" x-align="ISA.50.5.a002" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יְהֹוִה" strong="H3069" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוִה֙</char> <char style="w" x-id="WLC.ISA.50.5.004" x-align="ISA.50.5.a003" x-target-ids="t004 t005" x-target="hath opened" x-target-head="t005" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="Vqp3ms" x-gloss="he.has.opened" x-translit="pāṯaḥ-" xml:lang="hbo">פָּתַֽח</char>־<char style="w" x-id="WLC.ISA.50.5.005" x-align="ISA.50.5.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-translit="l" xml:lang="hbo">לִ֣</char><char style="w" x-id="WLC.ISA.50.5.006" x-align="ISA.50.5.a005" x-target-ids="t006" x-target="mine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.50.5.007" x-align="ISA.50.5.a006" x-target-ids="t007" x-target="ear" x-target-head="t007" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsa" x-gloss="ear" x-translit="ʾōzen" xml:lang="hbo">אֹ֔זֶן</char> <char style="w" x-id="WLC.ISA.50.5.008" x-align="ISA.50.5.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.50.5.009" x-align="I