	<para style="p"><verse number="4" style="v" x-ref="ISA.3.4" sid="ISA 3:4" /><char style="w" x-id="WLC.ISA.3.4.001" x-align="ISA.3.4.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.3.4.002" x-align="ISA.3.4.a002" x-target-ids="t002 t003 t004" x-target="I will give" x-target-head="t004" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqq1cs" x-gloss="I.will.make" x-translit="nāṯattiy" xml:lang="hbo">נָתַתִּ֥י</char> <char style="w" x-id="WLC.ISA.3.4.003" x-align="ISA.3.4.a003" x-target-ids="t005" x-target="children" x-target-head="t005" x-head="true" lemma="נַעַר" strong="H5288" x-morph="Ncmpa" x-gloss="youths" x-translit="nəʿāriym" xml:lang="hbo">נְעָרִ֖ים</char> <char style="w" x-id="WLC.ISA.3.4.004" x-align="ISA.3.4.a004" x-target-ids="t006 t007 t009" x-target="to be princes" x-target-head="t009" x-head="true" lemma="שַׂר" strong="H8269" x-morph="Ncmpc" x-gloss="leaders" x-translit="śārēy" xml:lang="hbo">שָׂרֵי</char><char style="w" x-id="WLC.ISA.3.4.005" x-align="ISA.3.4.a005" x-target-ids="t008" x-target="their" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo">הֶ֑ם</char> <char style="w" x-id="WLC.ISA.3.4.006" x-align="ISA.3.4.a006" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.3.4.007" x-align="ISA.3.4.a007" x-target-ids="t011" x-target="babes" x-target-head="t011" x-head="true" lemma="תַּעֲלוּלִים" strong="H8586" x-morph="Ncmpa" x-gloss="wantonness(es)" x-translit="ṯaʿălûliym" xml:lang="hbo">תַעֲלוּלִ֖ים</char> <char style="w" x-id="WLC.ISA.3.4.008" x-align="ISA.3.4.a008" x-target-ids="t012 t013" x-target="shall rule" x-target-head="t013" x-head="true" lemma="מָשַׁל" strong="H4910" x-mo