	<para style="p"><verse number="21" style="v" x-ref="ISA.43.21" x-added-alignments="ISA.43.21.a006" x-added-target-ids="t008" x-added-target="that" sid="ISA 43:21" /><char style="w" x-id="WLC.ISA.43.21.001" x-align="ISA.43.21.a001" x-target-ids="t001 t002" x-target="the people" x-target-head="t002" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿam-" xml:lang="hbo">עַם</char>־<char style="w" x-id="WLC.ISA.43.21.002" x-align="ISA.43.21.a002" x-target-ids="t003" x-target="which" x-target-head="t003" x-head="true" lemma="זוּ" strong="H2098" x-morph="Tr" x-gloss="which" x-translit="zû" xml:lang="hbo">זוּ֙</char> <char style="w" x-id="WLC.ISA.43.21.003" x-align="ISA.43.21.a003" x-target-ids="t004 t005" x-target="I formed" x-target-head="t005" x-head="true" lemma="יָצַר" strong="H3335" x-morph="Vqp1cs" x-gloss="I.formed" x-translit="yāṣarətî" xml:lang="hbo">יָצַ֣רְתִּי</char> <char style="w" x-id="WLC.ISA.43.21.004" x-align="ISA.43.21.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לִ֔</char><char style="w" x-id="WLC.ISA.43.21.005" x-align="ISA.43.21.a005" x-target-ids="t007" x-target="myself" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="myself" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.43.21.006" x-align="ISA.43.21.a008" x-target-ids="t014" x-target="praise" x-target-head="t014" x-head="true" lemma="תְּהִלָּה" strong="H8416" x-morph="Ncfsc" x-gloss="praise" x-translit="təhillāṯ" xml:lang="hbo">תְּהִלָּתִ֖</char><char style="w" x-id="WLC.ISA.43.21.007" x-align="ISA.43.21.a009" x-target-ids="t013" x-target="my" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.43.21.008" x-align="ISA.43.21.a007" x-target-ids="t009 t010 t011 t012" x-target="th