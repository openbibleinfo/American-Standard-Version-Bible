	<para style="p"><verse number="6" style="v" x-ref="ISA.55.6" sid="ISA 55:6" /><char style="w" x-id="WLC.ISA.55.6.001" x-align="ISA.55.6.a001" x-target-ids="t001 t002" x-target="Seek ye" x-target-head="t001" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqv2mp" x-gloss="seek" x-translit="diršû" xml:lang="hbo">דִּרְשׁ֥וּ</char> <char style="w" x-id="WLC.ISA.55.6.002" x-align="ISA.55.6.a002" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.ISA.55.6.003" x-align="ISA.55.6.a003" x-target-ids="t004" x-target="while" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.55.6.004" x-align="ISA.55.6.a004" x-target-ids="t006 t007 t008" x-target="may be found" x-target-head="t008" x-head="true" lemma="מָצָא" strong="H4672" x-morph="VNc" x-gloss="he" x-translit="himmāṣəʾ" xml:lang="hbo">הִמָּצְא֑</char><char style="w" x-id="WLC.ISA.55.6.005" x-align="ISA.55.6.a005" x-target-ids="t005" x-target="he" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="lets.himself.be.found" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.ISA.55.6.006" x-align="ISA.55.6.a006" x-target-ids="t009 t010 t011" x-target="call ye upon" x-target-head="t009" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqv2mp" x-gloss="call" x-translit="qərāʾu" xml:lang="hbo">קְרָאֻ֖</char><char style="w" x-id="WLC.ISA.55.6.007" x-align="ISA.55.6.a007" x-target-ids="t012" x-target="him" x-target-head="t012" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="on.him" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.ISA.55.6.008" x-align="ISA.55.6.a008" x-target-ids="t013" x-target="while" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R