	<para style="p"><verse number="11" style="v" x-ref="ISA.16.11" sid="ISA 16:11" /><char style="w" x-id="WLC.ISA.16.11.001" x-align="ISA.16.11.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.16.11.002" x-align="ISA.16.11.a001" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּן֙</char> <char style="w" x-id="WLC.ISA.16.11.003" x-align="ISA.16.11.a002" x-target-ids="t003" x-target="heart" x-target-head="t003" x-head="true" lemma="מֵעִים" strong="H4578" x-morph="Ncmpc" x-gloss="parts" x-translit="mēʿ" xml:lang="hbo">מֵעַ֣</char><char style="w" x-id="WLC.ISA.16.11.004" x-align="ISA.16.11.a003" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my.inward" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.16.11.005" x-align="ISA.16.11.a004" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.16.11.006" x-align="ISA.16.11.a005" x-target-ids="t009" x-target="Moab" x-target-head="t009" x-head="true" lemma="מוֹאָב" strong="H4124" x-morph="Np" x-gloss="Moab" x-translit="môʾāḇ" xml:lang="hbo">מוֹאָ֔ב</char> <char style="w" x-id="WLC.ISA.16.11.007" x-align="ISA.16.11.a006" x-target-ids="t005" x-target="like" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.ISA.16.11.008" x-align="ISA.16.11.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.16.11.009" x-align="ISA.16.11.a008" x-target-ids="t006 t007" x-target="a harp" x-target-head="t007" x-head="true" lemma="כִּנּוֹר" strong="H3658" x-morph="Ncmsa" x-gloss="harp" x-translit="kinnôr" xml:lang="hbo">כִּנּ֖וֹר</char> <char style="w" x-id="WLC.ISA.16.11.010" x-align="ISA.16.11.a009" x-target-ids="t004" x-target="soundeth" x-target-head="t004" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqi3mp" x-gloss="they.make.a.sound" x-translit="yehĕmû" xml:lang="hbo">יֶֽהֱמ֑וּ</char> <char style="w" x-id="WLC.ISA.16.11.011" x-align="ISA.16.11.a010" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.16.11.012" x-align="ISA.16.11.a011" x-target-ids="t012 t013" x-target="inward parts" x-target-head="t012" x-head="true" lemma="קֶרֶב" strong="H7130" x-morph="Ncmsc" x-gloss="my.inner" x-translit="qirb" xml:lang="hbo">קִרְבִּ֖</char><char style="w" x-id="WLC.ISA.16.11.013" x-align="ISA.16.11.a012" x-target-ids="t011" x-target="mine" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="being" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.16.11.014" x-align="ISA.16.11.a013" x-target-ids="t014" x-target="for" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.16.11.015" x-align="ISA.16.11.a014" x-target-ids="t015" x-target="Kir" x-target-head="t015" x-head="true" lemma="קִיר חֶרֶשׂ" x-morph="Np" x-gloss="Kir" x-translit="qiyrḥāreś" xml:lang="hbo">קִ֥יר</char> <char style="w" x-id="WLC.ISA.16.11.016" x-align="ISA.16.11.a015" x-target-ids="t016" x-target="heres" x-target-head="t016" x-head="true" lemma="קִיר חֶרֶשׂ" x-morph="Np" x-gloss="Heres" x-translit="qiyrḥāreś" xml:lang="hbo">חָֽרֶשׂ</char>׃<verse eid="ISA 16:11" /></para>
	<para style="p"><verse number="12" style="v" x-ref="ISA.16.12" sid="ISA 16:12" /><char style="w" x-id="WLC.ISA.16.12.001" x-align="ISA.16.12.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.16.12.002" x-align="ISA.16.12.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="it shall come to pass" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָ֧ה</char> <char style="w" x-id="WLC.ISA.16.12.003" x-align="ISA.16.12.a003" x-target-ids="t007" x-target="when" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="ḵiy-" xml:lang="hbo">כִֽי</char>־<char style="w" x-id="WLC.ISA.16.12.004" x-align="ISA.16.12.a004" x-target-ids="t009 t010" x-target="presenteth himself" x-target-head="t009" x-head="true" lemma="רָאָה" strong="H7200" x-morph="VNp3ms" x-gloss="it.has.presented.itself" x-translit="nirʾāh" xml:lang="hbo">נִרְאָ֛ה</char> <char style="w" x-id="WLC.ISA.16.12.005" x-align="ISA.16.12.a005" x-target-ids="t011" x-target="when" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.16.12.006" x-align="ISA.16.12.a006" x-target-ids="t012 t013 t014" x-target="he wearieth himself" x-target-head="t013" x-head="true" lemma="לָאָה" strong="H3811" x-morph="VNp3ms" x-gloss="it.has.wearied.itself" x-translit="nilʾāh" xml:lang="hbo">נִלְאָ֥ה</char> <char style="w" x-id="WLC.ISA.16.12.007" x-align="ISA.16.12.a007" x-target-ids="t008" x-target="Moab" x-target-head="t008" x-head="true" lemma="מוֹאָב" strong="H4124" x-morph="Np" x-gloss="Moab" x-translit="môʾāḇ" xml:lang="hbo">מוֹאָ֖ב</char> <char style="w" x-id="WLC.ISA.16.12.008" x-align="ISA.16.12.a008" x-target-ids="t015" x-target="upon" x