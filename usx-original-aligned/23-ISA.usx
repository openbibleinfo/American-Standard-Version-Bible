	<para style="p"><verse number="18" style="v" x-ref="ISA.42.18" sid="ISA 42:18" /><char style="w" x-id="WLC.ISA.42.18.001" x-align="ISA.42.18.a001" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="O" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.42.18.002" x-align="ISA.42.18.a002" x-target-ids="t002 t003" x-target="ye deaf" x-target-head="t003" x-head="true" lemma="חֵרֵשׁ" strong="H2795" x-morph="Aampa" x-gloss="deaf.[people]" x-translit="ḥērəšiym" xml:lang="hbo">חֵרְשִׁ֖ים</char> <char style="w" x-id="WLC.ISA.42.18.003" x-align="ISA.42.18.a003" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="listen" x-translit="šəmāʿû" xml:lang="hbo">שְׁמָ֑עוּ</char> <char style="w" x-id="WLC.ISA.42.18.004" x-align="ISA.42.18.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.42.18.005" x-align="ISA.42.18.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="O" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.42.18.006" x-align="ISA.42.18.a006" x-target-ids="t006 t007" x-target="ye blind" x-target-head="t007" x-head="true" lemma="עִוֵּר" strong="H5787" x-morph="Aampa" x-gloss="blind.[people]" x-translit="ʿiwriym" xml:lang="hbo">עִוְרִ֖ים</char> <char style="w" x-id="WLC.ISA.42.18.007" x-align="ISA.42.18.a007" x-target-ids="t005" x-target="look" x-target-head="t005" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhv2mp" x-gloss="look" x-translit="habbiyṭû" xml:lang="hbo">הַבִּ֥יטוּ</char> <char style="w" x-id="WLC.ISA.42.18.008" x-align="ISA.42.18.a008" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id