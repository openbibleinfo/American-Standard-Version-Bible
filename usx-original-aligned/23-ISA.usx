	<para style="p"><verse number="1" style="v" x-ref="ISA.44.1" sid="ISA 44:1" /><char style="w" x-id="WLC.ISA.44.1.001" x-align="ISA.44.1.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.44.1.002" x-align="ISA.44.1.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="therefore" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֥ה</char> <char style="w" x-id="WLC.ISA.44.1.003" x-align="ISA.44.1.a003" x-target-ids="t003" x-target="hear" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen" x-translit="šəmaʿ" xml:lang="hbo">שְׁמַ֖ע</char> <char style="w" x-id="WLC.ISA.44.1.004" x-align="ISA.44.1.a004" x-target-ids="t004 t005" x-target="O Jacob" x-target-head="t005" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="O.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֣ב</char> <char style="w" x-id="WLC.ISA.44.1.005" x-align="ISA.44.1.a006" x-target-ids="t007" x-target="servant" x-target-head="t007" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo">עַבְדִּ֑</char><char style="w" x-id="WLC.ISA.44.1.006" x-align="ISA.44.1.a005" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.44.1.007" x-align="ISA.44.1.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.44.1.008" x-align="ISA.44.1.a008" x-target-ids="t009" x-target="Israel" x-target-head="t009" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo