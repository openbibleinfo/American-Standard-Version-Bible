	<para style="p"><verse number="2" style="v" x-ref="ISA.9.2" sid="ISA 9:2" /><char style="w" x-id="WLC.ISA.9.2.001" x-align="ISA.9.2.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="ISA.9.1">הָ</char><char style="w" x-id="WLC.ISA.9.2.002" x-align="ISA.9.2.a002" x-target-ids="t002" x-target="people" x-target-head="t002" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="people" x-translit="ʿām" xml:lang="hbo" x-source-ref="ISA.9.1">עָם֙</char> <char style="w" x-id="WLC.ISA.9.2.003" x-align="ISA.9.2.a003" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[which]" x-translit="ha" xml:lang="hbo" x-source-ref="ISA.9.1">הַ</char><char style="w" x-id="WLC.ISA.9.2.004" x-align="ISA.9.2.a004" x-target-ids="t004" x-target="walked" x-target-head="t004" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmpa" x-gloss="walk" x-translit="hōləḵiym" xml:lang="hbo" x-source-ref="ISA.9.1">הֹלְכִ֣ים</char> <char style="w" x-id="WLC.ISA.9.2.005" x-align="ISA.9.2.a005" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo" x-source-ref="ISA.9.1">בַּ</char><char style="w" x-id="WLC.ISA.9.2.006" x-align="ISA.9.2.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="ISA.9.1">[הַ]</char><char style="w" x-id="WLC.ISA.9.2.007" x-align="ISA.9.2.a007" x-target-ids="t006" x-target="darkness" x-target-head="t006" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo" x-source-ref="ISA.9.1">חֹ֔שֶׁךְ</char> <char style="w" x-id="WLC.ISA.9.2.008" x-align="ISA.9.2.a008" x-target-ids="t007 t008" x-target="have seen" x-target-head="t008" x-head="t