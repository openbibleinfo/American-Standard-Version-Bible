	<para style="p"><verse number="25" style="v" x-ref="ISA.45.25" sid="ISA 45:25" /><char style="w" x-id="WLC.ISA.45.25.001" x-align="ISA.45.25.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.ISA.45.25.002" x-align="ISA.45.25.a002" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֛ה</char> <char style="w" x-id="WLC.ISA.45.25.003" x-align="ISA.45.25.a003" x-target-ids="t003 t009 t010" x-target="shall be justified" x-target-head="t010" x-head="true" lemma="צָדֵק" strong="H6663" x-morph="Vqi3mp" x-gloss="they.will.be.justified" x-translit="yiṣdəqû" xml:lang="hbo">יִצְדְּק֥וּ</char> <char style="w" x-id="WLC.ISA.45.25.004" x-align="ISA.45.25.a004" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.45.25.005" x-align="ISA.45.25.a005" x-target-ids="t012 t013" x-target="shall glory" x-target-head="t013" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vti3mp" x-gloss="they.will.boast" x-translit="yiṯəhaləlû" xml:lang="hbo">יִֽתְהַלְל֖וּ</char> <char style="w" x-id="WLC.ISA.45.25.006" x-align="ISA.45.25.a006" x-target-ids="t004" x-target="all" x-target-head="t004" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.45.25.007" x-align="ISA.45.25.a007" x-target-ids="t005 t006" x-target="the seed" x-target-head="t006" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsc" x-gloss="the.offspring" x-translit="zeraʿ" xml:lang="hbo">זֶ֥רַע</char> <char style="w" x-id="WLC.ISA.45.25.008" x-align="ISA.45.25.a008" x-target-ids="t007 t008" x-target="of Israel" x-target-head="t008" x-h