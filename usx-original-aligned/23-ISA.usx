	<para style="p"><verse number="5" style="v" x-ref="ISA.49.5" sid="ISA 49:5" /><char style="w" x-id="WLC.ISA.49.5.001" x-align="ISA.49.5.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.49.5.002" x-align="ISA.49.5.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֣ה</char>׀<char style="w" x-id="WLC.ISA.49.5.003" x-align="ISA.49.5.a003" x-target-ids="t003" x-target="saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.ISA.49.5.004" x-align="ISA.49.5.a004" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.ISA.49.5.005" x-align="ISA.49.5.a005" x-target-ids="t005 t006" x-target="that formed" x-target-head="t006" x-head="true" lemma="יָצַר" strong="H3335" x-morph="Vqrmsc" x-gloss="[who].formed" x-translit="yōṣər" xml:lang="hbo">יֹצְרִ֤</char><char style="w" x-id="WLC.ISA.49.5.006" x-align="ISA.49.5.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.49.5.007" x-align="ISA.49.5.a007" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.ISA.49.5.008" x-align="ISA.49.5.a008" x-target-ids="t009 t010" x-target="the womb" x-target-head="t010" x-head="true" lemma="בֶּטֶן" strong="H990" x-morph="Ncfsa" x-gloss="womb" x-translit="beṭen" xml:lang