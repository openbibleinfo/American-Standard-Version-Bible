	<para style="p"><verse number="23" style="v" x-ref="ISA.44.23" x-added-alignments="ISA.44.23.a006" x-added-target-ids="t009" x-added-target="it" sid="ISA 44:23" /><char style="w" x-id="WLC.ISA.44.23.001" x-align="ISA.44.23.a001" x-target-ids="t001" x-target="Sing" x-target-head="t001" x-head="true" lemma="רָנַן" strong="H7442" x-morph="Vqv2mp" x-gloss="shout.for.joy" x-translit="rānnû" xml:lang="hbo">רָנּ֨וּ</char> <char style="w" x-id="WLC.ISA.44.23.002" x-align="ISA.44.23.a002" x-target-ids="t002 t003 t004" x-target="O ye heavens" x-target-head="t004" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="O.heaven" x-translit="šāmayim" xml:lang="hbo">שָׁמַ֜יִם</char> <char style="w" x-id="WLC.ISA.44.23.003" x-align="ISA.44.23.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.44.23.004" x-align="ISA.44.23.a005" x-target-ids="t007 t008" x-target="hath done" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3ms" x-gloss="he.has.acted" x-translit="ʿāśāh" xml:lang="hbo">עָשָׂ֣ה</char> <char style="w" x-id="WLC.ISA.44.23.005" x-align="ISA.44.23.a004" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.ISA.44.23.006" x-align="ISA.44.23.a007" x-target-ids="t010" x-target="shout" x-target-head="t010" x-head="true" lemma="רוּעַ" strong="H7321" x-morph="Vhv2mp" x-gloss="shout.in.triumph" x-translit="hāriyʿû" xml:lang="hbo">הָרִ֨יעוּ֙</char> <char style="w" x-id="WLC.ISA.44.23.007" x-align="ISA.44.23.a008" x-target-ids="t011 t012 t013" x-target="ye lower parts" x-target-head="t012" x-head="true" lemma="תַּחְתִּי" strong="H8482" x-morph="Aafpc" x-gloss="O.lower.parts" x-translit="taḥtiyyôṯ" xml:lang="hbo">תַּחְתִּיּ֣וֹת</char>