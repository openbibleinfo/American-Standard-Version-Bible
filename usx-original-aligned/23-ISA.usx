	<para style="p"><verse number="7" style="v" x-ref="ISA.14.7" x-added-alignments="ISA.14.7.a006" x-added-target-ids="t007" x-added-target="and" sid="ISA 14:7" /><char style="w" x-id="WLC.ISA.14.7.001" x-align="ISA.14.7.a001" x-target-ids="t004 t005 t006" x-target="is at rest" x-target-head="t006" x-head="true" lemma="נוּחַ" strong="H5117" x-morph="Vqp3fs" x-gloss="it.is.at.rest" x-translit="nāḥâ" xml:lang="hbo">נָ֥חָה</char> <char style="w" x-id="WLC.ISA.14.7.002" x-align="ISA.14.7.a002" x-target-ids="t008 t009" x-target="is quiet" x-target-head="t009" x-head="true" lemma="שָׁקַט" strong="H8252" x-morph="Vqp3fs" x-gloss="it.is.at.peace" x-translit="šāqəṭāh" xml:lang="hbo">שָׁקְטָ֖ה</char> <char style="w" x-id="WLC.ISA.14.7.003" x-align="ISA.14.7.a003" x-target-ids="t002" x-target="whole" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.14.7.004" x-align="ISA.14.7.a004" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.ISA.14.7.005" x-align="ISA.14.7.a005" x-target-ids="t003" x-target="earth" x-target-head="t003" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.ISA.14.7.006" x-align="ISA.14.7.a007" x-target-ids="t010 t011 t012" x-target="they break forth" x-target-head="t011" x-head="true" lemma="פָּצַח" strong="H6476" x-morph="Vqp3cp" x-gloss="people.have.broken.forth" x-translit="pāṣḥû" xml:lang="hbo">פָּצְח֖וּ</char> <char style="w" x-id="WLC.ISA.14.7.007" x-align="ISA.14.7.a008" x-target-ids="t013 t014" x-target="into singing" x-target-head="t014" x-head="true" lemma="רִנָּה" strong="H7440" x-morph="Ncfsa" x-gloss="a.shout.of.joy" x-translit="rinnāh:" xml:lang="hbo">רִנָּֽה</char>׃<verse eid="ISA 14:7" /></para>
