	<para style="p"><verse number="10" style="v" x-ref="ISA.3.10" x-added-alignments="ISA.3.10.a005" x-added-target-ids="t011 t012" x-added-target="with him" sid="ISA 3:10" /><char style="w" x-id="WLC.ISA.3.10.001" x-align="ISA.3.10.a001" x-target-ids="t001 t002 t003" x-target="Say ye of" x-target-head="t001" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqv2mp" x-gloss="tell" x-translit="ʾimrû" xml:lang="hbo">אִמְר֥וּ</char> <char style="w" x-id="WLC.ISA.3.10.002" x-align="ISA.3.10.a002" x-target-ids="t004 t005" x-target="the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֖יק</char> <char style="w" x-id="WLC.ISA.3.10.003" x-align="ISA.3.10.a003" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.ISA.3.10.004" x-align="ISA.3.10.a004" x-target-ids="t007 t008 t009 t010" x-target="it shall be well" x-target-italic-ids="t007 t008 t009" x-target-head="t010" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.ISA.3.10.005" x-align="ISA.3.10.a006" x-target-ids="t013" x-target="for" x-target-head="t013" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.3.10.006" x-align="ISA.3.10.a007" x-target-ids="t017 t018" x-target="the fruit" x-target-head="t018" x-head="true" lemma="פְּרִי" strong="H6529" x-morph="Ncmsc" x-gloss="the.fruit" x-translit="p̄əriy" xml:lang="hbo">פְרִ֥י</char> <char style="w" x-id="WLC.ISA.3.10.007" x-align="ISA.3.10.a008" x-target-ids="t019 t021" x-target="of doings" x-target-head="t021" x-head="true" lemma="מַעֲלָל" strong="H4611" x-morph="Ncmpc" x-gloss="their.deeds" x-translit="maʿallēy" xml:lang="hbo">מַעַלְ