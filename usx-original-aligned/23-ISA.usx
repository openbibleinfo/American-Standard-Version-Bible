	<para style="p"><verse number="11" style="v" x-ref="ISA.3.11" x-added-alignments="ISA.3.11.a005" x-added-target-ids="t009 t010" x-added-target="with him" sid="ISA 3:11" /><char style="w" x-id="WLC.ISA.3.11.001" x-align="ISA.3.11.a001" x-target-ids="t001" x-target="Woe" x-target-head="t001" x-head="true" lemma="אוֹי" strong="H188" x-morph="Tj" x-gloss="woe!" x-translit="ʾôy" xml:lang="hbo">א֖וֹי</char> <char style="w" x-id="WLC.ISA.3.11.002" x-align="ISA.3.11.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.3.11.003" x-align="ISA.3.11.a003" x-target-ids="t003 t004" x-target="the wicked" x-target-head="t004" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="wicked" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֣ע</char> <char style="w" x-id="WLC.ISA.3.11.004" x-align="ISA.3.11.a004" x-target-ids="t005 t006 t007 t008" x-target="it shall be ill" x-target-italic-ids="t005 t006 t007" x-target-head="t008" x-head="true" lemma="רעע" strong="H7489" x-morph="Vqp3ms" x-gloss="it.will.be.bad" x-translit="rāʿ" xml:lang="hbo">רָ֑ע</char> <char style="w" x-id="WLC.ISA.3.11.005" x-align="ISA.3.11.a006" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.3.11.006" x-align="ISA.3.11.a007" x-target-ids="t012 t015 t016" x-target="what have done" x-target-head="t016" x-head="true" lemma="גְּמוּל" strong="H1576" x-morph="Ncmsc" x-gloss="the.dealing" x-translit="ḡəmûl" xml:lang="hbo">גְמ֥וּל</char> <char style="w" x-id="WLC.ISA.3.11.007" x-align="ISA.3.11.a008" x-target-ids="t014" x-target="hands" x-target-head="t014" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbdc" x-gloss="his.hands" x-translit="yāḏāy" xml:lang="hbo">יָדָ֖י</char><char style="w" x-id="WLC.ISA.3.11.008