	<para style="p"><verse number="2" style="v" x-ref="ISA.12.2" x-added-alignments="ISA.12.2.a015" x-added-target-ids="t016" x-added-target="even" sid="ISA 12:2" /><char style="w" x-id="WLC.ISA.12.2.001" x-align="ISA.12.2.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֨ה</char> <char style="w" x-id="WLC.ISA.12.2.002" x-align="ISA.12.2.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֧ל</char> <char style="w" x-id="WLC.ISA.12.2.003" x-align="ISA.12.2.a003" x-target-ids="t003 t005" x-target="is salvation" x-target-head="t005" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsc" x-gloss="salvation" x-translit="yəšûʿāṯ" xml:lang="hbo">יְשׁוּעָתִ֛</char><char style="w" x-id="WLC.ISA.12.2.004" x-align="ISA.12.2.a004" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[is].my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.12.2.005" x-align="ISA.12.2.a005" x-target-ids="t006 t007 t008" x-target="I will trust" x-target-head="t008" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqi1cs" x-gloss="I.will.trust" x-translit="ʾeḇṭaḥ" xml:lang="hbo">אֶבְטַ֖ח</char> <char style="w" x-id="WLC.ISA.12.2.006" x-align="ISA.12.2.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.12.2.007" x-align="ISA.12.2.a007" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.12.2.008" x-align="ISA.12.2.a008" x-target-ids="t010 t012 t013" x-target="will be afraid"