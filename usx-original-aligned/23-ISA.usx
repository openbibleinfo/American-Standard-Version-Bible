	<para style="p"><verse number="13" style="v" x-ref="ISA.19.13" x-added-alignments="ISA.19.13.a010" x-added-target-ids="t021" x-added-target="that" sid="ISA 19:13" /><char style="w" x-id="WLC.ISA.19.13.001" x-align="ISA.19.13.a001" x-target-ids="t005 t006 t007" x-target="are become fools" x-target-head="t007" x-head="true" lemma="יָאַל" strong="H2973" x-morph="VNp3cp" x-gloss="they.have.become.fools" x-translit="nôʾălû" xml:lang="hbo">נֽוֹאֲלוּ֙</char> <char style="w" x-id="WLC.ISA.19.13.002" x-align="ISA.19.13.a002" x-target-ids="t001 t002" x-target="The princes" x-target-head="t002" x-head="true" lemma="שַׂר" strong="H8269" x-morph="Ncmpc" x-gloss="the.officials" x-translit="śārê" xml:lang="hbo">שָׂ֣רֵי</char> <char style="w" x-id="WLC.ISA.19.13.003" x-align="ISA.19.13.a003" x-target-ids="t003 t004" x-target="of Zoan" x-target-head="t004" x-head="true" lemma="צֹעַן" strong="H6814" x-morph="Np" x-gloss="of.Zoan" x-translit="ṣōʿan" xml:lang="hbo">צֹ֔עַן</char> <char style="w" x-id="WLC.ISA.19.13.004" x-align="ISA.19.13.a004" x-target-ids="t012 t013" x-target="are deceived" x-target-head="t013" x-head="true" lemma="נָשָׁא" strong="H5377" x-morph="VNp3cp" x-gloss="they.have.been.deceived" x-translit="niššəʾû" xml:lang="hbo">נִשְּׁא֖וּ</char> <char style="w" x-id="WLC.ISA.19.13.005" x-align="ISA.19.13.a005" x-target-ids="t008 t009" x-target="the princes" x-target-head="t009" x-head="true" lemma="שַׂר" strong="H8269" x-morph="Ncmpc" x-gloss="the.officials" x-translit="śārê" xml:lang="hbo">שָׂ֣רֵי</char> <char style="w" x-id="WLC.ISA.19.13.006" x-align="ISA.19.13.a006" x-target-ids="t010 t011" x-target="of Memphis" x-target-head="t011" x-head="true" lemma="נֹף" strong="H5297" x-morph="Np" x-gloss="of.Memphis" x-translit="nōp̄" xml:lang="hbo">נֹ֑ף</char> <char style="w" x-id="WLC.ISA.19.13.007" x-align="ISA.19.13.a007" x-target-ids="t014 t015 t016 t018 t019 t020" x-target="they have caused to go astray" x-target-head="t020" x-head="true" lemma="תָּעָה" strong="H8582" x-mo