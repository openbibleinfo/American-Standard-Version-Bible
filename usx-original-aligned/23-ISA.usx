	<para style="p"><verse number="20" style="v" x-ref="ISA.28.20" x-added-alignments="ISA.28.20.a006 ISA.28.20.a008 ISA.28.20.a009 ISA.28.20.a016 ISA.28.20.a017" x-added-target-ids="t008 t009 t013 t014 t025 t026" x-added-target="a man | on | it | in | it" sid="ISA 28:20" /><char style="w" x-id="WLC.ISA.28.20.001" x-align="ISA.28.20.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.28.20.002" x-align="ISA.28.20.a002" x-target-ids="t004 t005" x-target="is shorter" x-target-head="t005" x-head="true" lemma="קָצֵר" strong="H7114a" x-morph="Vqp3ms" x-gloss="it.is.[too].short" x-translit="qāṣar" xml:lang="hbo">קָצַ֥ר</char> <char style="w" x-id="WLC.ISA.28.20.003" x-align="ISA.28.20.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.28.20.004" x-align="ISA.28.20.a004" x-target-ids="t003" x-target="bed" x-target-head="t003" x-head="true" lemma="מַצָּע" strong="H4702" x-morph="Ncmsa" x-gloss="bed" x-translit="mmaṣṣāʿ" xml:lang="hbo">מַּצָּ֖ע</char> <char style="w" x-id="WLC.ISA.28.20.005" x-align="ISA.28.20.a005" x-target-ids="t006 t007" x-target="than that" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="for" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.ISA.28.20.006" x-align="ISA.28.20.a007" x-target-ids="t010 t011 t012" x-target="can stretch himself" x-target-head="t011" x-head="true" lemma="שָׂרַע" strong="H8311" x-morph="Vtc" x-gloss="stretching.oneself" x-translit="hiśtārēᵃʿ" xml:lang="hbo">הִשְׂתָּרֵ֑עַ</char> <char style="w" x-id="WLC.ISA.28.20.007" x-align="ISA.28.20.a010" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xm