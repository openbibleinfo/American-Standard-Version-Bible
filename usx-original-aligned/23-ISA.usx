	<para style="p"><verse number="18" style="v" x-ref="ISA.1.18" sid="ISA 1:18" /><char style="w" x-id="WLC.ISA.1.18.001" x-align="ISA.1.18.a001" x-target-ids="t001" x-target="Come" x-target-head="t001" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2mp" x-gloss="come" x-translit="ləḵû-" xml:lang="hbo">לְכוּ</char>־<char style="w" x-id="WLC.ISA.1.18.002" x-align="ISA.1.18.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֛א</char> <char style="w" x-id="WLC.ISA.1.18.003" x-align="ISA.1.18.a003" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.1.18.004" x-align="ISA.1.18.a004" x-target-ids="t004 t005 t006 t007" x-target="let us reason together" x-target-head="t006" x-head="true" lemma="יָכַח" strong="H3198" x-morph="VNh1cp" x-gloss="let.us.argue.our.case.together" x-translit="niwwāḵəḥāh" xml:lang="hbo">נִוָּֽכְחָ֖ה</char> <char style="w" x-id="WLC.ISA.1.18.005" x-align="ISA.1.18.a005" x-target-ids="t008" x-target="saith" x-target-head="t008" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3ms" x-gloss="he.says" x-translit="yōʾmar" xml:lang="hbo">יֹאמַ֣ר</char> <char style="w" x-id="WLC.ISA.1.18.006" x-align="ISA.1.18.a006" x-target-ids="t009" x-target="Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.ISA.1.18.007" x-align="ISA.1.18.a007" x-target-ids="t010" x-target="though" x-target-head="t010" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="though" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.ISA.1.18.008" x-align="ISA.1.18.a008" x-target-ids="t013" x-target="be" x-target-head="t013" x-head="true" lemma="הָיָה" strong="H1961" x-morph="V