	<para style="p"><verse number="2" style="v" x-ref="ISA.1.2" sid="ISA 1:2" /><char style="w" x-id="WLC.ISA.1.2.001" x-align="ISA.1.2.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="hear" x-translit="šimʿû" xml:lang="hbo">שִׁמְע֤וּ</char> <char style="w" x-id="WLC.ISA.1.2.002" x-align="ISA.1.2.a002" x-target-ids="t002 t003" x-target="O heavens" x-target-head="t003" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="O.heavens" x-translit="šāmayim" xml:lang="hbo">שָׁמַ֨יִם֙</char> <char style="w" x-id="WLC.ISA.1.2.003" x-align="ISA.1.2.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.1.2.004" x-align="ISA.1.2.a004" x-target-ids="t005 t006" x-target="give ear" x-target-head="t006" x-head="true" lemma="אָזַן" strong="H238" x-morph="Vhv2fs" x-gloss="give.ear" x-translit="haʾăziynî" xml:lang="hbo">הַאֲזִ֣ינִי</char> <char style="w" x-id="WLC.ISA.1.2.005" x-align="ISA.1.2.a005" x-target-ids="t007 t008" x-target="O earth" x-target-head="t008" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="O.earth" x-translit="ʾereṣ" xml:lang="hbo">אֶ֔רֶץ</char> <char style="w" x-id="WLC.ISA.1.2.006" x-align="ISA.1.2.a006" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.ISA.1.2.007" x-align="ISA.1.2.a007" x-target-ids="t010" x-target="Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.ISA.1.2.008" x-align="ISA.1.2.a008" x-target-ids="t011 t012" x-target="hath spoken" x-target-head="t012" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpp3ms" x-glos