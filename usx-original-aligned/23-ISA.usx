	<para style="p"><verse number="2" style="v" x-ref="ISA.32.2" sid="ISA 32:2" /><char style="w" x-id="WLC.ISA.32.2.001" x-align="ISA.32.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.32.2.002" x-align="ISA.32.2.a002" x-target-ids="t004 t005" x-target="shall be" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="he.will.be" x-translit="hāyâ-" xml:lang="hbo">הָיָה</char>־<char style="w" x-id="WLC.ISA.32.2.003" x-align="ISA.32.2.a003" x-target-ids="t002 t003" x-target="a man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="each" x-translit="ʾiyš" xml:lang="hbo">אִ֥ישׁ</char> <char style="w" x-id="WLC.ISA.32.2.004" x-align="ISA.32.2.a004" x-target-ids="t006" x-target="as" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.ISA.32.2.005" x-align="ISA.32.2.a005" x-target-ids="t007 t008 t009" x-target="a hiding place" x-target-head="t008" x-head="true" lemma="מַחֲבֵא" strong="H4224" x-morph="Ncmsc" x-gloss="a.hiding.place" x-translit="maḥăḇēʾ-" xml:lang="hbo">מַֽחֲבֵא</char>־<char style="w" x-id="WLC.ISA.32.2.006" x-align="ISA.32.2.a006" x-target-ids="t010 t011 t012" x-target="from the wind" x-target-head="t012" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="of.a.wind" x-translit="rûᵃḥ" xml:lang="hbo">ר֖וּחַ</char> <char style="w" x-id="WLC.ISA.32.2.007" x-align="ISA.32.2.a007" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.32.2.008" x-align="ISA.32.2.a008" x-target-ids="t014 t015" x-target="a covert" x-target-head="t015" x-head="true" lemma="סֵתֶר" strong="H5643" x-morph="Ncmsc