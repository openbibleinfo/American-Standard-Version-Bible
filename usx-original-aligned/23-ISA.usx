	<para style="p"><verse number="18" style="v" x-ref="ISA.14.18" sid="ISA 14:18" /><char style="w" x-id="WLC.ISA.14.18.001" x-align="ISA.14.18.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.14.18.002" x-align="ISA.14.18.a002" x-target-ids="t002 t003" x-target="the kings" x-target-head="t003" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmpc" x-gloss="[the].kings" x-translit="malḵēy" xml:lang="hbo">מַלְכֵ֥י</char> <char style="w" x-id="WLC.ISA.14.18.003" x-align="ISA.14.18.a003" x-target-ids="t004 t005 t006" x-target="of the nations" x-target-head="t006" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="of.[the].nations" x-translit="ḡôyim" xml:lang="hbo">גוֹיִ֖ם</char> <char style="w" x-id="WLC.ISA.14.18.004" x-align="ISA.14.18.a004" x-target-ids="t007" x-target="all" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.them" x-translit="kull" xml:lang="hbo">כֻּלָּ֑</char><char style="w" x-id="WLC.ISA.14.18.005" x-align="ISA.14.18.a005" x-target-ids="t008 t009" x-target="of them" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="all" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.ISA.14.18.006" x-align="ISA.14.18.a006" x-target-ids="t010" x-target="sleep" x-target-head="t010" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqp3cp" x-gloss="they.have.lain.down" x-translit="šāḵəḇû" xml:lang="hbo">שָׁכְב֥וּ</char> <char style="w" x-id="WLC.ISA.14.18.007" x-align="ISA.14.18.a007" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.ISA.14.18.008" x-align="ISA.14.18.a008" x-target-ids="t012" x-target="glory" x-target-head="t012" x-head="true" lemma="כָּבוֹד