	<para style="p"><verse number="16" style="v" x-ref="ISA.57.16" x-added-alignments="ISA.57.16.a016" x-added-target-ids="t024" x-added-target="that" sid="ISA 57:16" /><char style="w" x-id="WLC.ISA.57.16.001" x-align="ISA.57.16.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.ISA.57.16.002" x-align="ISA.57.16.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֤א</char> <char style="w" x-id="WLC.ISA.57.16.003" x-align="ISA.57.16.a003" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.57.16.004" x-align="ISA.57.16.a004" x-target-ids="t007" x-target="ever" x-target-head="t007" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָם֙</char> <char style="w" x-id="WLC.ISA.57.16.005" x-align="ISA.57.16.a005" x-target-ids="t002 t003 t005" x-target="I will contend" x-target-head="t005" x-head="true" lemma="רִיב" strong="H7378" x-morph="Vqi1cs" x-gloss="I.will.conduct.a.case" x-translit="ʾāriyḇ" xml:lang="hbo">אָרִ֔יב</char> <char style="w" x-id="WLC.ISA.57.16.006" x-align="ISA.57.16.a006" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.57.16.007" x-align="ISA.57.16.a006" x-status="noncompositional" x-target-ids="t008" x-target="neither" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.ISA.57.16.008" x-align="ISA.57.16.a007" x-status="noncompositional" lemma="לְ" strong="H3807a" x-morph="R" x-glo