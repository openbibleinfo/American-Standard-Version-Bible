	<para style="p"><verse number="24" style="v" x-ref="ISA.44.24" sid="ISA 44:24" /><char style="w" x-id="WLC.ISA.44.24.001" x-align="ISA.44.24.a001" x-target-ids="t001" x-target="Thus" x-target-head="t001" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="kōh-" xml:lang="hbo">כֹּֽה</char>־<char style="w" x-id="WLC.ISA.44.24.002" x-align="ISA.44.24.a002" x-target-ids="t002" x-target="saith" x-target-head="t002" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֤ר</char> <char style="w" x-id="WLC.ISA.44.24.003" x-align="ISA.44.24.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.ISA.44.24.004" x-align="ISA.44.24.a005" x-target-ids="t005" x-target="Redeemer" x-target-head="t005" x-head="true" lemma="גָּאַל" strong="H1350" x-morph="Vqrmsc" x-gloss="redeemer" x-translit="gōʾăl" xml:lang="hbo">גֹּאֲלֶ֔</char><char style="w" x-id="WLC.ISA.44.24.005" x-align="ISA.44.24.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.44.24.006" x-align="ISA.44.24.a006" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.44.24.007" x-align="ISA.44.24.a007" x-target-ids="t007 t008 t009" x-target="he that formed" x-target-head="t009" x-head="true" lemma="יָצַר" strong="H3335" x-morph="Vqrmsc" x-gloss="the.[one" x-translit="yōṣer" xml:lang="hbo">יֹצֶרְ</char><char style="w" x-id="WLC.ISA.44.24.008" x-align="ISA.44.24.a008" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="wh