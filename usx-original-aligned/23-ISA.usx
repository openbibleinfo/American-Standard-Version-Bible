	<para style="p"><verse number="10" style="v" x-ref="ISA.8.10" sid="ISA 8:10" /><char style="w" x-id="WLC.ISA.8.10.001" x-align="ISA.8.10.a001" x-target-ids="t001 t003" x-target="Take together" x-target-head="t001" x-head="true" lemma="עוּץ" strong="H5779" x-morph="Vqv2mp" x-gloss="plan" x-translit="ʿuṣû" xml:lang="hbo">עֻ֥צוּ</char> <char style="w" x-id="WLC.ISA.8.10.002" x-align="ISA.8.10.a002" x-target-ids="t002" x-target="counsel" x-target-head="t002" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsa" x-gloss="a.plan" x-translit="ʿēṣāh" xml:lang="hbo">עֵצָ֖ה</char> <char style="w" x-id="WLC.ISA.8.10.003" x-align="ISA.8.10.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.8.10.004" x-align="ISA.8.10.a004" x-target-ids="t005 t006 t007 t008 t009 t010" x-target="it shall be brought to nought" x-target-head="t010" x-head="true" lemma="פָּרַר" strong="H6565" x-morph="VHi3fs" x-gloss="it.will.be.frustrated" x-translit="ṯup̄ār" xml:lang="hbo">תֻפָ֑ר</char> <char style="w" x-id="WLC.ISA.8.10.005" x-align="ISA.8.10.a005" x-target-ids="t011" x-target="speak" x-target-head="t011" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpv2mp" x-gloss="speak" x-translit="dabbərû" xml:lang="hbo">דַּבְּר֤וּ</char> <char style="w" x-id="WLC.ISA.8.10.006" x-align="ISA.8.10.a006" x-target-ids="t012 t013" x-target="the word" x-target-head="t013" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsa" x-gloss="a.word" x-translit="ḏāḇār" xml:lang="hbo">דָבָר֙</char> <char style="w" x-id="WLC.ISA.8.10.007" x-align="ISA.8.10.a007" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.8.10.008" x-align="ISA.8.10.a008" x-target-ids="t017" x-target="not" x-target-head="t017" x-head="true" lemma="ל