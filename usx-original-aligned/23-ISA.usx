	<para style="p"><verse number="12" style="v" x-ref="ISA.19.12" sid="ISA 19:12" /><char style="w" x-id="WLC.ISA.19.12.001" x-align="ISA.19.12.a001" x-target-ids="t001 t003" x-target="Where are" x-target-head="t001" x-head="true" lemma="אַי" strong="H335" x-morph="Ti" x-gloss="where.[are]" x-translit="ʾay" xml:lang="hbo">אַיָּ</char><char style="w" x-id="WLC.ISA.19.12.002" x-align="ISA.19.12.a002" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="they?" x-translit="ām" xml:lang="hbo">ם֙</char> <char style="w" x-id="WLC.ISA.19.12.003" x-align="ISA.19.12.a003" x-target-ids="t002" x-target="then" x-target-head="t002" x-head="true" lemma="אֵפוֹ" strong="H645" x-morph="D" x-gloss="then" x-translit="ʾēp̄ôʾ" xml:lang="hbo">אֵפ֣וֹא</char> <char style="w" x-id="WLC.ISA.19.12.004" x-align="ISA.19.12.a004" x-target-ids="t005 t006" x-target="wise men" x-target-head="t005" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampc" x-gloss="your.wise" x-translit="ḥăḵāmey" xml:lang="hbo">חֲכָמֶ֔י</char><char style="w" x-id="WLC.ISA.19.12.005" x-align="ISA.19.12.a005" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="[people]" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.19.12.006" x-align="ISA.19.12.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.19.12.007" x-align="ISA.19.12.a007" x-target-ids="t008 t009 t010" x-target="let them tell" x-target-head="t010" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhj3mp" x-gloss="they.will.tell" x-translit="yaggiyḏû" xml:lang="hbo">יַגִּ֥ידוּ</char> <char style="w" x-id="WLC.ISA.19.12.008" x-align="ISA.19.12.a008" x-target-ids="t012" x-target="now" x-target-head="t012" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit