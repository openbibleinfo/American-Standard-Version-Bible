	<para style="p"><verse number="24" style="v" x-ref="ISA.66.24" sid="ISA 66:24" /><char style="w" x-id="WLC.ISA.66.24.001" x-align="ISA.66.24.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.66.24.002" x-align="ISA.66.24.a002" x-target-ids="t002 t003 t004 t005" x-target="they shall go forth" x-target-head="t004" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqq3cp" x-gloss="they.will.go.out" x-translit="yāṣʾû" xml:lang="hbo">יָצְא֣וּ</char> <char style="w" x-id="WLC.ISA.66.24.003" x-align="ISA.66.24.a003" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.66.24.004" x-align="ISA.66.24.a004" x-target-ids="t007" x-target="look" x-target-head="t007" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqq3cp" x-gloss="they.will.look" x-translit="rāʾû" xml:lang="hbo">רָא֔וּ</char> <char style="w" x-id="WLC.ISA.66.24.005" x-align="ISA.66.24.a005" x-target-ids="t008" x-target="upon" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.66.24.006" x-align="ISA.66.24.a006" x-target-ids="t009 t010 t011" x-target="the dead bodies" x-target-head="t011" x-head="true" lemma="פֶּגֶר" strong="H6297" x-morph="Ncmpc" x-gloss="the.corpses" x-translit="p̄iḡrê" xml:lang="hbo">פִגְרֵי֙</char> <char style="w" x-id="WLC.ISA.66.24.007" x-align="ISA.66.24.a007" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.ISA.66.24.008" x-align="ISA.66.24.a008" x-target-ids="t012 t014" x-target="of men" x-target-head="t014" x-head="true" lemma="אִישׁ" strong="H376" x-morph