	<para style="p"><verse number="3" style="v" x-ref="ISA.25.3" sid="ISA 25:3" /><char style="w" x-id="WLC.ISA.25.3.001" x-align="ISA.25.3.a001" x-status="noncompositional" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.25.3.002" x-align="ISA.25.3.a001" x-status="noncompositional" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֖ן</char> <char style="w" x-id="WLC.ISA.25.3.003" x-align="ISA.25.3.a002" x-target-ids="t002 t006" x-target="shall glorify" x-target-head="t006" x-head="true" lemma="כָּבֵד" strong="H3513" x-morph="Vpi3mp" x-gloss="they" x-translit="yəḵabbəḏû" xml:lang="hbo">יְכַבְּד֣וּ</char><char style="w" x-id="WLC.ISA.25.3.004" x-align="ISA.25.3.a003" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.honor.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.25.3.005" x-align="ISA.25.3.a004" x-target-ids="t003 t005" x-target="a people" x-target-head="t005" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿam-" xml:lang="hbo">עַם</char>־<char style="w" x-id="WLC.ISA.25.3.006" x-align="ISA.25.3.a005" x-target-ids="t004" x-target="strong" x-target-head="t004" x-head="true" lemma="עַז" strong="H5794" x-morph="Aamsa" x-gloss="strong" x-translit="ʿāz" xml:lang="hbo">עָ֑ז</char> <char style="w" x-id="WLC.ISA.25.3.007" x-align="ISA.25.3.a006" x-target-ids="t008 t009" x-target="a city" x-target-head="t009" x-head="true" lemma="קִרְיָה" strong="H7151" x-morph="Ncfsc" x-gloss="a.town" x-translit="qiryaṯ" xml:lang="hbo">קִרְיַ֛ת</char> <char style="w" x-id="WLC.ISA.25.3.008" x-align="ISA.25.3.a007" x-target-ids="t010 t012" x-target="of nations" x-target-head="t012" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="of.nations"