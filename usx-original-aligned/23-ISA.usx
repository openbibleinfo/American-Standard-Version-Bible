	<para style="p"><verse number="3" style="v" x-ref="ISA.26.3" sid="ISA 26:3" /><char style="w" x-id="WLC.ISA.26.3.001" x-align="ISA.26.3.a001" x-target-ids="t004 t008 t009" x-target="him whose mind" x-target-italic-ids="t004 t008" x-target-head="t009" x-head="true" lemma="יֵצֶר" strong="H3336" x-morph="Ncmsa" x-gloss="an.inclination" x-translit="yēṣer" xml:lang="hbo">יֵ֣צֶר</char> <char style="w" x-id="WLC.ISA.26.3.002" x-align="ISA.26.3.a002" x-target-ids="t010 t011" x-target="is stayed" x-target-italic-ids="t010" x-target-head="t011" x-head="true" lemma="סָמַךְ" strong="H5564" x-morph="Vqsmsa" x-gloss="firm" x-translit="sāmûḵ" xml:lang="hbo">סָמ֔וּךְ</char> <char style="w" x-id="WLC.ISA.26.3.003" x-align="ISA.26.3.a003" x-target-ids="t001 t002 t003" x-target="Thou wilt keep" x-target-head="t003" x-head="true" lemma="נָצַר" strong="H5341" x-morph="Vqi2ms" x-gloss="you.will.keep" x-translit="tiṣṣōr" xml:lang="hbo">תִּצֹּ֖ר</char> <char style="w" x-id="WLC.ISA.26.3.004" x-align="ISA.26.3.a004" x-target-ids="t006" x-target="perfect" x-target-head="t006" x-head="true" lemma="שָׁלוֹם" strong="H7965" x-morph="Ncmsa" x-gloss="peace" x-translit="šālôm" xml:lang="hbo">שָׁל֣וֹם</char>׀<char style="w" x-id="WLC.ISA.26.3.005" x-align="ISA.26.3.a005" x-target-ids="t005 t007" x-target="in peace" x-target-head="t007" x-head="true" lemma="שָׁלוֹם" strong="H7965" x-morph="Ncmsa" x-gloss="peace" x-translit="šālôm" xml:lang="hbo">שָׁל֑וֹם</char> <char style="w" x-id="WLC.ISA.26.3.006" x-align="ISA.26.3.a006" x-target-ids="t014" x-target="because" x-target-head="t014" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.ISA.26.3.007" x-align="ISA.26.3.a007" x-target-ids="t012 t017" x-target="on in" x-target-italic-ids="t012" x-target-head="t017" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇ" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.ISA.26.3.008" x-align="IS