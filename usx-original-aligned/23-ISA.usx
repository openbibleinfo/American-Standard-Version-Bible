	<para style="p"><verse number="16" style="v" x-ref="ISA.8.16" sid="ISA 8:16" /><char style="w" x-id="WLC.ISA.8.16.001" x-align="ISA.8.16.a001" x-target-ids="t001 t002 t003" x-target="Bind thou up" x-target-head="t001" x-head="true" lemma="צָרַר" strong="H6887" x-morph="Vqv2ms" x-gloss="bind.up" x-translit="ṣôr" xml:lang="hbo">צ֖וֹר</char> <char style="w" x-id="WLC.ISA.8.16.002" x-align="ISA.8.16.a002" x-target-ids="t004 t005" x-target="the testimony" x-target-head="t005" x-head="true" lemma="תְּעוּדָה" strong="H8584" x-morph="Ncfsa" x-gloss="[the].testimony" x-translit="təʿûḏāh" xml:lang="hbo">תְּעוּדָ֑ה</char> <char style="w" x-id="WLC.ISA.8.16.003" x-align="ISA.8.16.a003" x-target-ids="t006" x-target="seal" x-target-head="t006" x-head="true" lemma="חָתַם" strong="H2856" x-morph="Vqv2ms" x-gloss="seal.up" x-translit="ḥăṯôm" xml:lang="hbo">חֲת֥וֹם</char> <char style="w" x-id="WLC.ISA.8.16.004" x-align="ISA.8.16.a004" x-target-ids="t007 t008" x-target="the law" x-target-head="t008" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsa" x-gloss="[the].instruction" x-translit="tôrāh" xml:lang="hbo">תּוֹרָ֖ה</char> <char style="w" x-id="WLC.ISA.8.16.005" x-align="ISA.8.16.a005" x-target-ids="t009" x-target="among" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.8.16.006" x-align="ISA.8.16.a006" x-target-ids="t011" x-target="disciples" x-target-head="t011" x-head="true" lemma="לִמֻּד" strong="H3928" x-morph="Aampc" x-gloss="my" x-translit="limmuḏ" xml:lang="hbo">לִמֻּדָֽ</char><char style="w" x-id="WLC.ISA.8.16.007" x-align="ISA.8.16.a007" x-target-ids="t010" x-target="my" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="disciples" x-translit="āy" xml:lang="hbo">י</char>׃<verse eid="ISA 8:16" /></para>
