	<para style="p"><verse number="13" style="v" x-ref="ISA.33.13" sid="ISA 33:13" /><char style="w" x-id="WLC.ISA.33.13.001" x-align="ISA.33.13.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="hear" x-translit="šimʿû" xml:lang="hbo">שִׁמְע֥וּ</char> <char style="w" x-id="WLC.ISA.33.13.002" x-align="ISA.33.13.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="ye that are far off" x-target-head="t005" x-head="true" lemma="רָחֹוק" strong="H7350" x-morph="Aampa" x-gloss="O.distant.[ones]" x-translit="rəḥôqiym" xml:lang="hbo">רְחוֹקִ֖ים</char> <char style="w" x-id="WLC.ISA.33.13.003" x-align="ISA.33.13.a003" x-target-ids="t007" x-target="what" x-target-head="t007" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[that].which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.ISA.33.13.004" x-align="ISA.33.13.a004" x-target-ids="t008 t009 t010" x-target="I have done" x-target-head="t010" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp1cs" x-gloss="I.have.done" x-translit="ʿāśiyṯî" xml:lang="hbo">עָשִׂ֑יתִי</char> <char style="w" x-id="WLC.ISA.33.13.005" x-align="ISA.33.13.a005" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.33.13.006" x-align="ISA.33.13.a006" x-target-ids="t016" x-target="acknowledge" x-target-head="t016" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqv2mp" x-gloss="know" x-translit="ḏəʿû" xml:lang="hbo">דְע֥וּ</char> <char style="w" x-id="WLC.ISA.33.13.007" x-align="ISA.33.13.a007" x-target-ids="t012 t013 t014 t015" x-target="ye that are near" x-target-head="t015" x-head="true" lemma="קָרֹוב" strong="H7138" x-morph="Aampa" x-gloss="O.near.[ones]" x-translit="qərôḇiym" xml:lang="hbo">קְרוֹבִ֖ים</char> <char style="w" x-id="WLC.ISA.33.13.008" x-align="ISA.33.13.a008" x-tar