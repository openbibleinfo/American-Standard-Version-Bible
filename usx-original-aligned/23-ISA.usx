	<para style="p"><verse number="18" style="v" x-ref="ISA.57.18" sid="ISA 57:18" /><char style="w" x-id="WLC.ISA.57.18.001" x-align="ISA.57.18.a001" x-target-ids="t005" x-target="ways" x-target-head="t005" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="dərāḵāy" xml:lang="hbo">דְּרָכָ֥י</char><char style="w" x-id="WLC.ISA.57.18.002" x-align="ISA.57.18.a002" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.ISA.57.18.003" x-align="ISA.57.18.a003" x-target-ids="t001 t002 t003" x-target="I have seen" x-target-head="t003" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp1cs" x-gloss="I.have.seen" x-translit="rāʾiyṯî" xml:lang="hbo">רָאִ֖יתִי</char> <char style="w" x-id="WLC.ISA.57.18.004" x-align="ISA.57.18.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.57.18.005" x-align="ISA.57.18.a005" x-target-ids="t007 t008" x-target="will heal" x-target-head="t008" x-head="true" lemma="רָפָא" strong="H7495" x-morph="Vqi1cs" x-gloss="I" x-translit="ʾerpāʾ" xml:lang="hbo">אֶרְפָּאֵ֑</char><char style="w" x-id="WLC.ISA.57.18.006" x-align="ISA.57.18.a006" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="will.heal.him" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.ISA.57.18.007" x-align="ISA.57.18.a007" x-target-ids="t014" x-target="also" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.57.18.008" x-align="ISA.57.18.a008" x-target-ids="t010 t011 t012" x-target="I will lead" x-target-head="t012" x-head="true" lemma="נָחָה" strong="H5148" x-morph="Vh