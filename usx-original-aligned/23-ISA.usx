	<para style="p"><verse number="5" style="v" x-ref="ISA.24.5" sid="ISA 24:5" /><char style="w" x-id="WLC.ISA.24.5.001" x-align="ISA.24.5.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.24.5.002" x-align="ISA.24.5.a002" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.ISA.24.5.003" x-align="ISA.24.5.a003" x-target-ids="t002" x-target="earth" x-target-head="t002" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֥רֶץ</char> <char style="w" x-id="WLC.ISA.24.5.004" x-align="ISA.24.5.a004" x-target-ids="t004 t005" x-target="is polluted" x-target-head="t005" x-head="true" lemma="חָנֵף" strong="H2610" x-morph="Vqp3fs" x-gloss="it.has.been.polluted" x-translit="ḥānəp̄āh" xml:lang="hbo">חָנְפָ֖ה</char> <char style="w" x-id="WLC.ISA.24.5.005" x-align="ISA.24.5.a005" x-target-ids="t006" x-target="under" x-target-head="t006" x-head="true" lemma="תַּחַת" strong="H8478" x-morph="R" x-gloss="under" x-translit="taḥaṯ" xml:lang="hbo">תַּ֣חַת</char> <char style="w" x-id="WLC.ISA.24.5.006" x-align="ISA.24.5.a006" x-target-ids="t007 t008" x-target="the inhabitants" x-target-head="t008" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqrmpc" x-gloss="inhabitants" x-translit="yōšəḇey" xml:lang="hbo">יֹשְׁבֶ֑י</char><char style="w" x-id="WLC.ISA.24.5.007" x-align="ISA.24.5.a007" x-target-ids="t009" x-target="thereof" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.ISA.24.5.008" x-align="ISA.24.5.a008" x-target-ids="t010" x-target="because" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)