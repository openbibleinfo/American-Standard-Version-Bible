	<para style="p"><verse number="9" style="v" x-ref="ISA.2.9" sid="ISA 2:9" /><char style="w" x-id="WLC.ISA.2.9.001" x-align="ISA.2.9.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.ISA.2.9.002" x-align="ISA.2.9.a002" x-target-ids="t005 t006 t007" x-target="is bowed down" x-target-head="t006" x-head="true" lemma="שָׁחַח" strong="H7817" x-morph="VNw3ms" x-gloss="he.has.been.humbled" x-translit="yyiššaḥ" xml:lang="hbo">יִּשַּׁ֥ח</char> <char style="w" x-id="WLC.ISA.2.9.003" x-align="ISA.2.9.a003" x-target-ids="t002 t003 t004" x-target="the mean man" x-target-head="t004" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="everyone" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֖ם</char> <char style="w" x-id="WLC.ISA.2.9.004" x-align="ISA.2.9.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.ISA.2.9.005" x-align="ISA.2.9.a005" x-target-ids="t012 t013 t014" x-target="is brought low" x-target-head="t014" x-head="true" lemma="שָׁפֵל" strong="H8213" x-morph="Vqw3ms" x-gloss="he.has.become.low" x-translit="yyišpal-" xml:lang="hbo">יִּשְׁפַּל</char>־<char style="w" x-id="WLC.ISA.2.9.006" x-align="ISA.2.9.a006" x-target-ids="t009 t010 t011" x-target="the great man" x-target-head="t011" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="everyone" x-translit="ʾiyš" xml:lang="hbo">אִ֑ישׁ</char> <char style="w" x-id="WLC.ISA.2.9.007" x-align="ISA.2.9.a007" x-target-ids="t015" x-target="therefore" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.2.9.008" x-align="ISA.2.9.a008" x-target-ids="t018" x-target="not" x-target-head="t018" x-head="true" lemma="אַל" strong="H