	<para style="p"><verse number="7" style="v" x-ref="ISA.39.7" sid="ISA 39:7" /><char style="w" x-id="WLC.ISA.39.7.001" x-align="ISA.39.7.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.39.7.002" x-align="ISA.39.7.a002" x-target-ids="t002" x-target="of" x-target-head="t002" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="some" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.ISA.39.7.003" x-align="ISA.39.7.a003" x-target-ids="t004" x-target="sons" x-target-head="t004" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="of" x-translit="bāney" xml:lang="hbo">בָּנֶ֜י</char><char style="w" x-id="WLC.ISA.39.7.004" x-align="ISA.39.7.a004" x-target-ids="t003" x-target="thy" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.descendants" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.39.7.005" x-align="ISA.39.7.a005" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֨ר</char> <char style="w" x-id="WLC.ISA.39.7.006" x-align="ISA.39.7.a006" x-target-ids="t006 t007" x-target="shall issue" x-target-head="t007" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqi3mp" x-gloss="they.will.come.forth" x-translit="yēṣʾû" xml:lang="hbo">יֵצְא֧וּ</char> <char style="w" x-id="WLC.ISA.39.7.007" x-align="ISA.39.7.a007" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" xml:lang="hbo">מִמְּ</char><char style="w" x-id="WLC.ISA.39.7.008" x-align="ISA.39.7.a008" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo">ךָ֛</ch