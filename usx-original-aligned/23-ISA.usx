	<para style="p"><verse number="10" style="v" x-ref="ISA.32.10" sid="ISA 32:10" /><char style="w" x-id="WLC.ISA.32.10.001" x-align="ISA.32.10.a001" x-target-ids="t001 t002" x-target="For days" x-target-head="t002" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="days" x-translit="yāmîm" xml:lang="hbo">יָמִים֙</char> <char style="w" x-id="WLC.ISA.32.10.002" x-align="ISA.32.10.a002" x-target-ids="t003" x-target="beyond" x-target-head="t003" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="with" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.32.10.003" x-align="ISA.32.10.a003" x-target-ids="t004 t005" x-target="a year" x-target-head="t005" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncfsa" x-gloss="a.year" x-translit="šānāh" xml:lang="hbo">שָׁנָ֔ה</char> <char style="w" x-id="WLC.ISA.32.10.004" x-align="ISA.32.10.a004" x-target-ids="t006 t007 t008 t009" x-target="shall ye be troubled" x-target-head="t009" x-head="true" lemma="רָגַז" strong="H7264" x-morph="Vqi2fp" x-gloss="you.will.be.agitated" x-translit="tirgazənâ" xml:lang="hbo">תִּרְגַּ֖זְנָה</char> <char style="w" x-id="WLC.ISA.32.10.005" x-align="ISA.32.10.a005" x-target-ids="t010 t011 t012" x-target="ye careless women" x-target-head="t011" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqrfpa" x-gloss="O.confident.[women]" x-translit="bōṭəḥôṯ" xml:lang="hbo">בֹּֽטְח֑וֹת</char> <char style="w" x-id="WLC.ISA.32.10.006" x-align="ISA.32.10.a006" x-target-ids="t013" x-target="for" x-target-head="t013" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּ֚י</char> <char style="w" x-id="WLC.ISA.32.10.007" x-align="ISA.32.10.a007" x-target-ids="t016 t017" x-target="shall fail" x-target-head="t017" x-head="true" lemma="כָּלָה" strong="H3615" x-morph="Vqp3ms" x-gloss="it.will.fail" x-translit="kālāh" xml:lang="hbo">כָּלָ֣ה</char> <char style="w" x-id="WLC.ISA.32.10.008" x-align="ISA.32.10.a008" x-targe