	<para style="p"><verse number="8" style="v" x-ref="ISA.47.8" sid="ISA 47:8" /><char style="w" x-id="WLC.ISA.47.8.001" x-align="ISA.47.8.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.47.8.002" x-align="ISA.47.8.a002" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="therefore" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֞ה</char> <char style="w" x-id="WLC.ISA.47.8.003" x-align="ISA.47.8.a003" x-target-ids="t003" x-target="hear" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2fs" x-gloss="listen.to" x-translit="šimʿî-" xml:lang="hbo">שִׁמְעִי</char>־<char style="w" x-id="WLC.ISA.47.8.004" x-align="ISA.47.8.a004" x-target-ids="t004" x-target="this" x-target-head="t004" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֤את</char> <char style="w" x-id="WLC.ISA.47.8.005" x-align="ISA.47.8.a005" x-target-ids="t005 t006 t007 t008 t009 t010" x-target="thou that art given to pleasures" x-target-head="t008" x-head="true" lemma="עָדִין" strong="H5719" x-morph="Aafsa" x-gloss="O.voluptuous.[woman]" x-translit="ʿăḏînāh" xml:lang="hbo">עֲדִינָה֙</char> <char style="w" x-id="WLC.ISA.47.8.006" x-align="ISA.47.8.a006" x-target-ids="t011" x-target="that" x-target-head="t011" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[who]" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.47.8.007" x-align="ISA.47.8.a007" x-target-ids="t012" x-target="sittest" x-target-head="t012" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqrfsa" x-gloss="dwells" x-translit="yyôšeḇeṯ" xml:lang="hbo">יּוֹשֶׁ֣בֶת</char> <char style="w" x-id="WLC.ISA.47.8.008" x-align="ISA.47.8.a008" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" 