	<para style="p"><verse number="3" style="v" x-ref="ISA.44.3" sid="ISA 44:3" /><char style="w" x-id="WLC.ISA.44.3.001" x-align="ISA.44.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.ISA.44.3.002" x-align="ISA.44.3.a002" x-target-ids="t002 t003 t004" x-target="I will pour" x-target-head="t004" x-head="true" lemma="יָצַק" strong="H3332" x-morph="Vqi1cs" x-gloss="I.will.pour.out" x-translit="ʾeṣṣāq-" xml:lang="hbo">אֶצָּק</char>־<char style="w" x-id="WLC.ISA.44.3.003" x-align="ISA.44.3.a003" x-target-ids="t005" x-target="water" x-target-head="t005" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="water" x-translit="mayim" xml:lang="hbo">מַ֨יִם֙</char> <char style="w" x-id="WLC.ISA.44.3.004" x-align="ISA.44.3.a004" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.44.3.005" x-align="ISA.44.3.a005" x-target-ids="t007 t008 t009 t010" x-target="him that is thirsty" x-target-head="t010" x-head="true" lemma="צָמֵא" strong="H6771" x-morph="Aamsa" x-gloss="thirsty.[ground]" x-translit="ṣāmēʾ" xml:lang="hbo">צָמֵ֔א</char> <char style="w" x-id="WLC.ISA.44.3.006" x-align="ISA.44.3.a006" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.44.3.007" x-align="ISA.44.3.a007" x-target-ids="t012" x-target="streams" x-target-head="t012" x-head="true" lemma="נָזַל" strong="H5140a" x-morph="Vqrmpa" x-gloss="streams" x-translit="nōzəliym" xml:lang="hbo">נֹזְלִ֖ים</char> <char style="w" x-id="WLC.ISA.44.3.008" x-align="ISA.44.3.a008" x-target-ids="t013" x-target="upon" x-target-head="t013" x-head="true" lemma="עַל" strong="H5921" x-mor