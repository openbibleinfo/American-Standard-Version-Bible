	<para style="p"><verse number="2" style="v" x-ref="ISA.46.2" sid="ISA 46:2" /><char style="w" x-id="WLC.ISA.46.2.001" x-align="ISA.46.2.a001" x-target-ids="t001 t002" x-target="They stoop" x-target-head="t002" x-head="true" lemma="קָרַס" strong="H7164" x-morph="Vqp3cp" x-gloss="they.have.stooped.low" x-translit="qārəsû" xml:lang="hbo">קָרְס֤וּ</char> <char style="w" x-id="WLC.ISA.46.2.002" x-align="ISA.46.2.a002" x-target-ids="t003 t004 t005" x-target="they bow down" x-target-head="t004" x-head="true" lemma="כָּרַע" strong="H3766" x-morph="Vqp3cp" x-gloss="they.have.bowed.down" x-translit="ḵārəʿû" xml:lang="hbo">כָֽרְעוּ֙</char> <char style="w" x-id="WLC.ISA.46.2.003" x-align="ISA.46.2.a003" x-target-ids="t006" x-target="together" x-target-head="t006" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="together" x-translit="yaḥdāw" xml:lang="hbo">יַחְדָּ֔ו</char> <char style="w" x-id="WLC.ISA.46.2.004" x-align="ISA.46.2.a004" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.ISA.46.2.005" x-align="ISA.46.2.a005" x-target-ids="t007 t008" x-target="they could" x-target-head="t008" x-head="true" lemma="יָכֹל" strong="H3201" x-morph="Vqp3cp" x-gloss="they.have.been.able" x-translit="yāḵəlû" xml:lang="hbo">יָכְל֖וּ</char> <char style="w" x-id="WLC.ISA.46.2.006" x-align="ISA.46.2.a006" x-target-ids="t010" x-target="deliver" x-target-head="t010" x-head="true" lemma="מָלַט" strong="H4422" x-morph="Vpc" x-gloss="to.rescue" x-translit="mallēṭ" xml:lang="hbo">מַלֵּ֣ט</char> <char style="w" x-id="WLC.ISA.46.2.007" x-align="ISA.46.2.a007" x-target-ids="t011 t012" x-target="the burden" x-target-head="t012" x-head="true" lemma="מַשָּׂא" strong="H4853" x-morph="Ncmsa" x-gloss="a.burden" x-translit="maśśāʾ" xml:lang="hbo">מַשָּׂ֑א</char> <char style="w" x-id="WLC.ISA.46.2.008" x-align="ISA.46.2.a008" x-target-ids="t013" x-ta