	<para style="p"><verse number="13" style="v" x-ref="ISA.26.13" x-added-alignments="ISA.26.13.a009" x-added-target-ids="t014" x-added-target="but" sid="ISA 26:13" /><char style="w" x-id="WLC.ISA.26.13.001" x-align="ISA.26.13.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.ISA.26.13.002" x-align="ISA.26.13.a002" x-target-ids="t004" x-target="God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōhēy" xml:lang="hbo">אֱלֹהֵ֔י</char><char style="w" x-id="WLC.ISA.26.13.003" x-align="ISA.26.13.a003" x-target-ids="t003" x-target="our" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.ISA.26.13.004" x-align="ISA.26.13.a004" x-target-ids="t009 t010 t011" x-target="have had dominion" x-target-head="t011" x-head="true" lemma="בָּעַל" strong="H1166" x-morph="Vqp3cp" x-gloss="they" x-translit="bəʿālû" xml:lang="hbo">בְּעָל֥וּ</char><char style="w" x-id="WLC.ISA.26.13.005" x-align="ISA.26.13.a005" x-target-ids="t012 t013" x-target="over us" x-target-head="t013" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="have.ruled.over.us" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.ISA.26.13.006" x-align="ISA.26.13.a006" x-target-ids="t005 t006" x-target="other lords" x-target-head="t006" x-head="true" lemma="אָדוֹן" strong="H113" x-morph="Ncmpa" x-gloss="lords" x-translit="ʾăḏōniym" xml:lang="hbo">אֲדֹנִ֖ים</char> <char style="w" x-id="WLC.ISA.26.13.007" x-align="ISA.26.13.a007" x-target-ids="t007" x-target="besides" x-target-head="t007" x-head="true" lemma="זוּלָה" strong="H2108" x-morph="R" x-gloss="except" x-translit="zûlāṯ" xml:lang="hbo">זֽוּלָתֶ֑</char><char style="w" x-id="WLC.ISA.26.13.008" x-ali