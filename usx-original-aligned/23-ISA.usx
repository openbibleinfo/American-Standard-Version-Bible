" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.66.24.017" x-align="ISA.66.24.a017" x-target-ids="t023 t025" x-target="shall die" x-target-head="t025" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqi3fs" x-gloss="it.will.die" x-translit="ṯāmûṯ" xml:lang="hbo">תָמ֗וּת</char> <char style="w" x-id="WLC.ISA.66.24.018" x-align="ISA.66.24.a018" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.66.24.019" x-align="ISA.66.24.a019" x-target-ids="t029" x-target="fire" x-target-head="t029" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsc" x-gloss="fire" x-translit="ʾišš" xml:lang="hbo">אִשָּׁ</char><char style="w" x-id="WLC.ISA.66.24.020" x-align="ISA.66.24.a020" x-target-ids="t028" x-target="their" x-target-head="t028" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם֙</char> <char style="w" x-id="WLC.ISA.66.24.021" x-align="ISA.66.24.a018" x-target-ids="t026" x-target="neither" x-target-head="t026" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.66.24.022" x-align="ISA.66.24.a021" x-target-ids="t027 t030 t031" x-target="shall be quenched" x-target-head="t031" x-head="true" lemma="כָּבָה" strong="H3518" x-morph="Vqi3fs" x-gloss="it.will.be.extinguished" x-translit="ṯiḵbeh" xml:lang="hbo">תִכְבֶּ֔ה</char> <char style="w" x-id="WLC.ISA.66.24.023" x-align="ISA.66.24.a022" x-target-ids="t032" x-target="and" x-target-head="t032" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.66.24.024" x-align="ISA.66.24.a023" x-target-ids="t033 t034 t035" x-target="they shall be" x-target-head="t035" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3cp" x-gloss="they.will.be" x-translit="hāyû" xml:lang="hbo">הָי֥וּ</char> <char style="w" x-id="WLC.ISA.66.24.