	<para style="p"><verse number="9" style="v" x-ref="ISA.32.9" x-added-alignments="ISA.32.9.a012" x-added-target-ids="t009" x-added-target="and" sid="ISA 32:9" /><char style="w" x-id="WLC.ISA.32.9.001" x-align="ISA.32.9.a001" x-target-ids="t003 t004" x-target="ye women" x-target-head="t004" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfpa" x-gloss="O.women" x-translit="nāšîm" xml:lang="hbo">נָשִׁים֙</char> <char style="w" x-id="WLC.ISA.32.9.002" x-align="ISA.32.9.a002" x-target-ids="t005 t006 t007 t008" x-target="that are at ease" x-target-head="t008" x-head="true" lemma="שַׁאֲנָן" strong="H7600" x-morph="Aafpa" x-gloss="carefree" x-translit="šaʾănannôṯ" xml:lang="hbo">שַֽׁאֲנַנּ֔וֹת</char> <char style="w" x-id="WLC.ISA.32.9.003" x-align="ISA.32.9.a003" x-target-ids="t001 t002" x-target="Rise up" x-target-head="t001" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqv2fp" x-gloss="arise" x-translit="qōmənâ" xml:lang="hbo">קֹ֖מְנָה</char> <char style="w" x-id="WLC.ISA.32.9.004" x-align="ISA.32.9.a004" x-target-ids="t010" x-target="hear" x-target-head="t010" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2fp" x-gloss="hear" x-translit="šəmaʿənâ" xml:lang="hbo">שְׁמַ֣עְנָה</char> <char style="w" x-id="WLC.ISA.32.9.005" x-align="ISA.32.9.a005" x-target-ids="t012" x-target="voice" x-target-head="t012" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="voice" x-translit="qôl" xml:lang="hbo">קוֹלִ֑</char><char style="w" x-id="WLC.ISA.32.9.006" x-align="ISA.32.9.a006" x-target-ids="t011" x-target="my" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.32.9.007" x-align="ISA.32.9.a007" x-target-ids="t013 t015" x-target="ye daughters" x-target-head="t015" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfpa" x-gloss="O.daughters" x-translit="bānôṯ" xml:lang="hbo">בָּנוֹת֙</char> <char style="w" x-id="WLC.ISA.32.9.008" x-align