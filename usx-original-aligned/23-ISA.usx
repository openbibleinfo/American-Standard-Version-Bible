	<para style="p"><verse number="14" style="v" x-ref="ISA.13.14" sid="ISA 13:14" /><char style="w" x-id="WLC.ISA.13.14.001" x-align="ISA.13.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.13.14.002" x-align="ISA.13.14.a002" x-target-ids="t002 t003 t004 t005 t006 t007" x-target="it shall come to pass that" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָה֙</char> <char style="w" x-id="WLC.ISA.13.14.003" x-align="ISA.13.14.a003" x-target-ids="t008" x-target="as" x-target-head="t008" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.ISA.13.14.004" x-align="ISA.13.14.a004" x-target-ids="t009 t011" x-target="the roe" x-target-head="t011" x-head="true" lemma="צְבִי" strong="H6643a" x-morph="Ncbsa" x-gloss="a.gazelle" x-translit="ṣəḇiy" xml:lang="hbo">צְבִ֣י</char> <char style="w" x-id="WLC.ISA.13.14.005" x-align="ISA.13.14.a005" x-target-ids="t010" x-target="chased" x-target-head="t010" x-head="true" lemma="נָדַח" strong="H5080" x-morph="VHsmsa" x-gloss="hunted" x-translit="muddāḥ" xml:lang="hbo">מֻדָּ֔ח</char> <char style="w" x-id="WLC.ISA.13.14.006" x-align="ISA.13.14.a006" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.13.14.007" x-align="ISA.13.14.a007" x-target-ids="t013" x-target="as" x-target-head="t013" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ḵ" xml:lang="hbo">כְ</char><char style="w" x-id="WLC.ISA.13.14.008" x-align="ISA.13.14.a008" x-target-ids="t014" x-target="sheep" x-target-head="t014" x-head="true" lemma="צֹאן" strong="H6629" x-morph="Ncbsa" x-gloss="