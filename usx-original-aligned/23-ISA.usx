	<para style="p"><verse number="14" style="v" x-ref="ISA.57.14" sid="ISA 57:14" /><char style="w" x-id="WLC.ISA.57.14.001" x-align="ISA.57.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.57.14.002" x-align="ISA.57.14.a002" x-target-ids="t002 t003 t004" x-target="he will say" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq3ms" x-gloss="someone.will.say" x-translit="ʾāmar" xml:lang="hbo">אָמַ֥ר</char> <char style="w" x-id="WLC.ISA.57.14.003" x-align="ISA.57.14.a003" x-target-ids="t005 t006 t007" x-target="Cast ye up" x-target-head="t005" x-head="true" lemma="סָלַל" strong="H5549" x-morph="Vqv2mp" x-gloss="cast.up" x-translit="sōllû-" xml:lang="hbo">סֹֽלּוּ</char>־<char style="w" x-id="WLC.ISA.57.14.004" x-align="ISA.57.14.a004" x-target-ids="t008 t009 t010" x-target="cast ye up" x-target-head="t008" x-head="true" lemma="סָלַל" strong="H5549" x-morph="Vqv2mp" x-gloss="cast.up" x-translit="sōllû" xml:lang="hbo">סֹ֖לּוּ</char> <char style="w" x-id="WLC.ISA.57.14.005" x-align="ISA.57.14.a005" x-target-ids="t011" x-target="prepare" x-target-head="t011" x-head="true" lemma="פָּנָה" strong="H6437" x-morph="Vpv2mp" x-gloss="make.clear" x-translit="pannû-" xml:lang="hbo">פַּנּוּ</char>־<char style="w" x-id="WLC.ISA.57.14.006" x-align="ISA.57.14.a006" x-target-ids="t012 t013" x-target="the way" x-target-head="t013" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="[the].way" x-translit="ḏāreḵ" xml:lang="hbo">דָ֑רֶךְ</char> <char style="w" x-id="WLC.ISA.57.14.007" x-align="ISA.57.14.a007" x-target-ids="t014 t015" x-target="take up" x-target-head="t014" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vhv2mp" x-gloss="lift.up" x-translit="hāriymû" xml:lang="hbo">הָרִ֥ימוּ</char> <char style="w" x-id="WLC.ISA.57.14.008" x-align="ISA.57.14.a008" x-target-ids="t016 t017 t018" x-targ