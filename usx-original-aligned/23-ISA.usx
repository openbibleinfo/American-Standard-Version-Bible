	<para style="p"><verse number="21" style="v" x-ref="ISA.42.21" x-added-alignments="ISA.42.21.a010" x-added-target-ids="t014" x-added-target="it" sid="ISA 42:21" /><char style="w" x-id="WLC.ISA.42.21.001" x-align="ISA.42.21.a001" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֥ה</char> <char style="w" x-id="WLC.ISA.42.21.002" x-align="ISA.42.21.a002" x-target-ids="t001 t002" x-target="It pleased" x-target-head="t002" x-head="true" lemma="חָפֵץ" strong="H2654" x-morph="Vqp3ms" x-gloss="he.was.pleased" x-translit="ḥāp̄ēṣ" xml:lang="hbo">חָפֵ֖ץ</char> <char style="w" x-id="WLC.ISA.42.21.003" x-align="ISA.42.21.a003" x-target-ids="t004 t007" x-target="for sake" x-target-head="t007" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="for.the.sake.of" x-translit="ləmaʿan" xml:lang="hbo">לְמַ֣עַן</char> <char style="w" x-id="WLC.ISA.42.21.004" x-align="ISA.42.21.a004" x-target-ids="t006" x-target="righteousness" x-target-head="t006" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsc" x-gloss="righteousness" x-translit="ṣiḏq" xml:lang="hbo">צִדְק֑</char><char style="w" x-id="WLC.ISA.42.21.005" x-align="ISA.42.21.a005" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.ISA.42.21.006" x-align="ISA.42.21.a006" x-target-ids="t008 t009" x-target="to magnify" x-target-head="t009" x-head="true" lemma="גָּדַל" strong="H1431" x-morph="Vhi3ms" x-gloss="he.will.make.great" x-translit="yaḡdiyl" xml:lang="hbo">יַגְדִּ֥יל</char> <char style="w" x-id="WLC.ISA.42.21.007" x-align="ISA.42.21.a007" x-target-ids="t010 t011" x-target="the law" x-target-head="t011" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsa" x-gloss="[the].law" x-translit="tôrāh" xml:lang="hbo">תּוֹרָ֖ה</char> <char style="w" x