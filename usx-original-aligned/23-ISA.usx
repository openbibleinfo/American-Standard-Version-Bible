	<para style="p"><verse number="20" style="v" x-ref="ISA.42.20" x-added-alignments="ISA.42.20.a007" x-added-target-ids="t009" x-added-target="his" sid="ISA 42:20" /><char style="w" x-id="WLC.ISA.42.20.v001.r01.001" x-align="ISA.42.20.a001" x-target-ids="t001 t002" x-target="Thou seest" x-target-head="t002" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp2ms" x-translit="rʾyṯ" xml:lang="hbo">ראית</char> <char style="w" x-id="WLC.ISA.42.20.002" x-align="ISA.42.20.a002" x-target-ids="t003 t004" x-target="many things" x-target-head="t003" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafpa" x-gloss="many.[things]" x-translit="rabôṯ" xml:lang="hbo">רַבּ֖וֹת</char> <char style="w" x-id="WLC.ISA.42.20.003" x-align="ISA.42.20.a003" x-target-ids="t005" x-target="but" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.42.20.004" x-align="ISA.42.20.a004" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.42.20.005" x-align="ISA.42.20.a005" x-target-ids="t006 t007" x-target="thou observest" x-target-head="t007" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqi2ms" x-gloss="you.keep.[them]" x-translit="ṯišmōr" xml:lang="hbo">תִשְׁמֹ֑ר</char> <char style="w" x-id="WLC.ISA.42.20.006" x-align="ISA.42.20.a006" x-target-ids="t011 t012" x-target="are open" x-target-head="t012" x-head="true" lemma="פָּקַח" strong="H6491" x-morph="Vqa" x-gloss="they.are.open" x-translit="pāqôᵃḥ" xml:lang="hbo">פָּק֥וֹחַ</char> <char style="w" x-id="WLC.ISA.42.20.007" x-align="ISA.42.20.a008" x-target-ids="t010" x-target="ears" x-target-head="t010" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfda" x-gloss="ears" x-translit="ʾāzənayim" xml:lang="hbo">אָזְנַ֖יִם</char> <char style="w" x-id="WLC.ISA.42.20.008" x-align="ISA.42.20.a00