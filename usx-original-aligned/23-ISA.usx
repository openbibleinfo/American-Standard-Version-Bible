	<para style="p"><verse number="10" style="v" x-ref="ISA.24.10" x-added-alignments="ISA.24.10.a009" x-added-target-ids="t014" x-added-target="man" sid="ISA 24:10" /><char style="w" x-id="WLC.ISA.24.10.001" x-align="ISA.24.10.a001" x-target-ids="t004 t005 t006" x-target="is broken down" x-target-head="t005" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="VNp3fs" x-gloss="it.has.been.broken" x-translit="nišbərāh" xml:lang="hbo">נִשְׁבְּרָ֖ה</char> <char style="w" x-id="WLC.ISA.24.10.002" x-align="ISA.24.10.a002" x-target-ids="t001 t003" x-target="The city" x-target-head="t003" x-head="true" lemma="קִרְיָה" strong="H7151" x-morph="Ncfsc" x-gloss="[the].town" x-translit="qiryaṯ-" xml:lang="hbo">קִרְיַת</char>־<char style="w" x-id="WLC.ISA.24.10.003" x-align="ISA.24.10.a003" x-target-ids="t002" x-target="waste" x-target-head="t002" x-head="true" lemma="תֹּהוּ" strong="H8414" x-morph="Ncmsa" x-gloss="of.formlessness" x-translit="tōhû" xml:lang="hbo">תֹּ֑הוּ</char> <char style="w" x-id="WLC.ISA.24.10.004" x-align="ISA.24.10.a004" x-target-ids="t009 t010 t011" x-target="is shut up" x-target-head="t010" x-head="true" lemma="סָגַר" strong="H5462" x-morph="VPp3ms" x-gloss="it.has.been.shut.up" x-translit="suggar" xml:lang="hbo">סֻגַּ֥ר</char> <char style="w" x-id="WLC.ISA.24.10.005" x-align="ISA.24.10.a005" x-target-ids="t007" x-target="every" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.24.10.006" x-align="ISA.24.10.a006" x-target-ids="t008" x-target="house" x-target-head="t008" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsa" x-gloss="house" x-translit="bayiṯ" xml:lang="hbo">בַּ֖יִת</char> <char style="w" x-id="WLC.ISA.24.10.007" x-align="ISA.24.10.a007" x-target-ids="t012 t013" x-target="that no" x-target-head="t013" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style=