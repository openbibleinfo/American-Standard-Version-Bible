	<para style="p"><verse number="1" style="v" x-ref="ISA.12.1" sid="ISA 12:1" /><char style="w" x-id="WLC.ISA.12.1.001" x-align="ISA.12.1.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.12.1.002" x-align="ISA.12.1.a002" x-target-ids="t005 t006 t007" x-target="thou shalt say" x-target-head="t007" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq2ms" x-gloss="you.will.say" x-translit="ʾāmartā" xml:lang="hbo">אָֽמַרְתָּ֙</char> <char style="w" x-id="WLC.ISA.12.1.003" x-align="ISA.12.1.a003" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.ISA.12.1.004" x-align="ISA.12.1.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.12.1.005" x-align="ISA.12.1.a005" x-target-ids="t004" x-target="day" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּ֣וֹם</char> <char style="w" x-id="WLC.ISA.12.1.006" x-align="ISA.12.1.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.12.1.007" x-align="ISA.12.1.a007" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="that" x-translit="hûʾ" xml:lang="hbo">ה֔וּא</char> <char style="w" x-id="WLC.ISA.12.1.008" x-align="ISA.12.1.a008" x-target-ids="t008 t009 t010 t011 t012" x-target="I will give thanks unto" x-target-head="t011" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo">אוֹדְ</char><char style="w" x-id="WLC.ISA.12.1.