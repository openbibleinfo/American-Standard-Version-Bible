	<para style="p"><verse number="13" style="v" x-ref="ISA.43.13" sid="ISA 43:13" /><char style="w" x-id="WLC.ISA.43.13.001" x-align="ISA.43.13.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.ISA.43.13.002" x-align="ISA.43.13.a002" x-target-ids="t002" x-target="since" x-target-head="t002" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.ISA.43.13.003" x-align="ISA.43.13.a003" x-target-ids="t003 t004 t005" x-target="the day was" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="a.day" x-translit="yyôm" xml:lang="hbo">יּוֹם֙</char> <char style="w" x-id="WLC.ISA.43.13.004" x-align="ISA.43.13.a004" x-target-ids="t006" x-target="I" x-target-head="t006" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֣י</char> <char style="w" x-id="WLC.ISA.43.13.005" x-align="ISA.43.13.a005" x-target-ids="t007 t008" x-target="am he" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="[am].he" x-translit="hûʾ" xml:lang="hbo">ה֔וּא</char> <char style="w" x-id="WLC.ISA.43.13.006" x-align="ISA.43.13.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.13.007" x-align="ISA.43.13.a007" x-target-ids="t010 t011 t012" x-target="there is none" x-target-head="t012" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֥ין</char> <char style="w" x-id="WLC.ISA.43.13.008" x-align="ISA.43.13.a008" x-target-ids="t016 t017" x-target="out of" x-target-head="t016" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-tra