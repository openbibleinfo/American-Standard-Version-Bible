	<para style="p"><verse number="2" style="v" x-ref="ISA.63.2" sid="ISA 63:2" /><char style="w" x-id="WLC.ISA.63.2.001" x-align="ISA.63.2.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="מַדּוּעַ" strong="H4069" x-morph="Ti" x-gloss="why?" x-translit="madûᵃʿ" xml:lang="hbo">מַדּ֥וּעַ</char> <char style="w" x-id="WLC.ISA.63.2.002" x-align="ISA.63.2.a002" x-target-ids="t002 t003 t004" x-target="art thou red" x-target-head="t004" x-head="true" lemma="אָדֹם" strong="H122" x-morph="Aamsa" x-gloss="[does].redness" x-translit="ʾāḏōm" xml:lang="hbo">אָדֹ֖ם</char> <char style="w" x-id="WLC.ISA.63.2.003" x-align="ISA.63.2.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belong].to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.ISA.63.2.004" x-align="ISA.63.2.a004" x-target-ids="t007" x-target="apparel" x-target-head="t007" x-head="true" lemma="לְבוּשׁ" strong="H3830" x-morph="Ncmsc" x-gloss="clothing" x-translit="ləḇûš" xml:lang="hbo">לְבוּשֶׁ֑</char><char style="w" x-id="WLC.ISA.63.2.005" x-align="ISA.63.2.a005" x-target-ids="t006" x-target="thine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.63.2.006" x-align="ISA.63.2.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[are]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.63.2.007" x-align="ISA.63.2.a007" x-target-ids="t010" x-target="garments" x-target-head="t010" x-head="true" lemma="בֶּגֶד" strong="H899" x-morph="Ncmpc" x-gloss="garments?" x-translit="ḇəḡāḏey" xml:lang="hbo">בְגָדֶ֖י</char><char style="w" x-id="WLC.ISA.63.2.008" x-align="ISA.63.2.a008" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss