	<para style="p"><verse number="4" style="v" x-ref="ISA.9.4" sid="ISA 9:4" /><char style="w" x-id="WLC.ISA.9.4.001" x-align="ISA.9.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="ISA.9.3">כִּ֣י</char>׀<char style="w" x-id="WLC.ISA.9.4.002" x-align="ISA.9.4.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="ISA.9.3">אֶת</char>־<char style="w" x-id="WLC.ISA.9.4.003" x-align="ISA.9.4.a003" x-target-ids="t002 t003" x-target="the yoke" x-target-head="t003" x-head="true" lemma="עֹל" strong="H5923" x-morph="Ncmsc" x-gloss="the.yoke" x-translit="ʿōl" xml:lang="hbo" x-source-ref="ISA.9.3">עֹ֣ל</char> <char style="w" x-id="WLC.ISA.9.4.004" x-align="ISA.9.4.a004" x-target-ids="t004 t006" x-target="of burden" x-target-head="t006" x-head="true" lemma="סֹבֶל" strong="H5448" x-morph="Ncmsc" x-gloss="its.burden" x-translit="subbŏl" xml:lang="hbo" x-source-ref="ISA.9.3">סֻבֳּל֗</char><char style="w" x-id="WLC.ISA.9.4.005" x-align="ISA.9.4.a005" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="ISA.9.3">וֹ</char> <char style="w" x-id="WLC.ISA.9.4.006" x-align="ISA.9.4.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="ISA.9.3">וְ</char><char style="w" x-id="WLC.ISA.9.4.007" x-align="ISA.9.4.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾēṯ" xml:lang="hbo" x-source-ref="ISA.9.3">אֵת֙</char> <char style="w" x-id="WLC.ISA.9.4.008" x-align="ISA.9.4.a008" x-target-ids="t008 t009" x-target="the staff" x-target-head="t009" x-head="true" lemma="מַטֶּה" strong="H429