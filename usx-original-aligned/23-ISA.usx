	<para style="p"><verse number="15" style="v" x-ref="ISA.57.15" sid="ISA 57:15" /><char style="w" x-id="WLC.ISA.57.15.001" x-align="ISA.57.15.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּי֩</char> <char style="w" x-id="WLC.ISA.57.15.002" x-align="ISA.57.15.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="ḵōh" xml:lang="hbo">כֹ֨ה</char> <char style="w" x-id="WLC.ISA.57.15.003" x-align="ISA.57.15.a003" x-target-ids="t003" x-target="saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֜ר</char> <char style="w" x-id="WLC.ISA.57.15.004" x-align="ISA.57.15.a004" x-target-ids="t004 t005 t008" x-target="the high One" x-target-head="t005" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vqrmsa" x-gloss="[the.one.who.is].high" x-translit="rām" xml:lang="hbo">רָ֣ם</char> <char style="w" x-id="WLC.ISA.57.15.005" x-align="ISA.57.15.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.57.15.006" x-align="ISA.57.15.a006" x-target-ids="t007" x-target="lofty" x-target-head="t007" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="VNrmsa" x-gloss="[the.one.who.is].exalted" x-translit="niśśāʾ" xml:lang="hbo">נִשָּׂ֗א</char> <char style="w" x-id="WLC.ISA.57.15.007" x-align="ISA.57.15.a007" x-target-ids="t009 t010" x-target="that inhabiteth" x-target-head="t010" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqrmsa" x-gloss="[who].dwells" x-translit="šōḵēn" xml:lang="hbo">שֹׁכֵ֥ן</char> <char style="w" x-id="WLC.ISA.57.15.008" x-align="ISA.57.15.a008" x-target-ids="t011" x-target="eternity" x-target-head="t011" x-head="true" lemma="עַ