	<para style="p"><verse number="1" style="v" x-ref="ISA.21.1" sid="ISA 21:1" /><char style="w" x-id="WLC.ISA.21.1.001" x-align="ISA.21.1.a001" x-target-ids="t001 t002" x-target="The burden" x-target-head="t002" x-head="true" lemma="מַשָּׂא" strong="H4853a" x-morph="Ncmsc" x-gloss="[the].oracle" x-translit="maśśāʾ" xml:lang="hbo">מַשָּׂ֖א</char> <char style="w" x-id="WLC.ISA.21.1.002" x-align="ISA.21.1.a002" x-target-ids="t003 t004 t005" x-target="of the wilderness" x-target-head="t005" x-head="true" lemma="מִדְבָּר" strong="H4057" x-morph="Ncmsc" x-gloss="of.[the].wilderness" x-translit="miḏbar-" xml:lang="hbo">מִדְבַּר</char>־<char style="w" x-id="WLC.ISA.21.1.003" x-align="ISA.21.1.a003" x-target-ids="t006 t007 t008" x-target="of the sea" x-target-head="t008" x-head="true" lemma="יָם" strong="H3220" x-morph="Ncmsa" x-gloss="of.[the].sea" x-translit="yām" xml:lang="hbo">יָ֑ם</char> <char style="w" x-id="WLC.ISA.21.1.004" x-align="ISA.21.1.a004" x-target-ids="t009" x-target="As" x-target-head="t009" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.ISA.21.1.005" x-align="ISA.21.1.a005" x-target-ids="t010" x-target="whirlwinds" x-target-head="t010" x-head="true" lemma="סוּפָה" strong="H5492" x-morph="Ncfpa" x-gloss="storm-winds" x-translit="sûp̄ôṯ" xml:lang="hbo">סוּפ֤וֹת</char> <char style="w" x-id="WLC.ISA.21.1.006" x-align="ISA.21.1.a006" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.ISA.21.1.007" x-align="ISA.21.1.a007" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.21.1.008" x-align="ISA.21.1.a008" x-target-ids="t013" x-target="South" x-target-head="t013" x-head="true" lemma="נֶגֶב" strong