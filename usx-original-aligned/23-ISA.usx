	<para style="p"><verse number="13" style="v" x-ref="ISA.3.13" sid="ISA 3:13" /><char style="w" x-id="WLC.ISA.3.13.001" x-align="ISA.3.13.a001" x-target-ids="t002 t003" x-target="standeth up" x-target-head="t002" x-head="true" lemma="נָצַב" strong="H5324" x-morph="VNrmsa" x-gloss="[is].taking.his.stand" x-translit="niṣṣāḇ" xml:lang="hbo">נִצָּ֥ב</char> <char style="w" x-id="WLC.ISA.3.13.002" x-align="ISA.3.13.a002" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.3.13.003" x-align="ISA.3.13.a003" x-target-ids="t005" x-target="contend" x-target-head="t005" x-head="true" lemma="רִיב" strong="H7378" x-morph="Vqc" x-gloss="conduct.a.case" x-translit="riyḇ" xml:lang="hbo">רִ֖יב</char> <char style="w" x-id="WLC.ISA.3.13.004" x-align="ISA.3.13.a004" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.ISA.3.13.005" x-align="ISA.3.13.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.3.13.006" x-align="ISA.3.13.a006" x-target-ids="t007" x-target="standeth" x-target-head="t007" x-head="true" lemma="עָמַד" strong="H5975" x-morph="Vqrmsa" x-gloss="[he.is].standing" x-translit="ʿōmēḏ" xml:lang="hbo">עֹמֵ֖ד</char> <char style="w" x-id="WLC.ISA.3.13.007" x-align="ISA.3.13.a007" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.3.13.008" x-align="ISA.3.13.a008" x-target-ids="t009" x-target="judge" x-target-head="t009" x-head="true" lemma="דִּין" strong="H1777" x-morph="Vqc" x-gloss="judge" x-translit="ḏiyn