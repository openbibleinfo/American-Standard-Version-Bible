	<para style="p"><verse number="22" style="v" x-ref="ISA.24.22" sid="ISA 24:22" /><char style="w" x-id="WLC.ISA.24.22.001" x-align="ISA.24.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.24.22.002" x-align="ISA.24.22.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="they shall be gathered together" x-target-head="t005" x-head="true" lemma="אָסַף" strong="H622" x-morph="VPq3cp" x-gloss="they.will.be.gathered" x-translit="ʾussəp̄û" xml:lang="hbo">אֻסְּפ֨וּ</char> <char style="w" x-id="WLC.ISA.24.22.003" x-align="ISA.24.22.a003" x-target-ids="t007 t009 t010" x-target="as are gathered" x-target-head="t010" x-head="true" lemma="אֲסֵפָה" strong="H626" x-morph="Ncfsa" x-gloss="a.gathering" x-translit="ʾăsēp̄āh" xml:lang="hbo">אֲסֵפָ֤ה</char> <char style="w" x-id="WLC.ISA.24.22.004" x-align="ISA.24.22.a004" x-target-ids="t008" x-target="prisoners" x-target-head="t008" x-head="true" lemma="אַסִּיר" strong="H616" x-morph="Ncmsa" x-gloss="prisoner[s]" x-translit="ʾassîr" xml:lang="hbo">אַסִּיר֙</char> <char style="w" x-id="WLC.ISA.24.22.005" x-align="ISA.24.22.a005" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="to" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.24.22.006" x-align="ISA.24.22.a006" x-target-ids="t012 t013" x-target="the pit" x-target-head="t013" x-head="true" lemma="בּוֹר" strong="H953" x-morph="Ncmsa" x-gloss="a.pit" x-translit="bôr" xml:lang="hbo">בּ֔וֹר</char> <char style="w" x-id="WLC.ISA.24.22.007" x-align="ISA.24.22.a007" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.24.22.008" x-align="ISA.24.22.a008" x-target-ids="t015 t016 t017 t018" x-target="shall be shu