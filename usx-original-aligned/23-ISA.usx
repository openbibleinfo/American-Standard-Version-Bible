	<para style="p"><verse number="15" style="v" x-ref="ISA.8.15" sid="ISA 8:15" /><char style="w" x-id="WLC.ISA.8.15.001" x-align="ISA.8.15.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.8.15.002" x-align="ISA.8.15.a002" x-target-ids="t003 t004" x-target="shall stumble" x-target-head="t004" x-head="true" lemma="כָּשַׁל" strong="H3782" x-morph="Vqq3cp" x-gloss="they.will.stumble" x-translit="ḵāšəlû" xml:lang="hbo">כָ֥שְׁלוּ</char> <char style="w" x-id="WLC.ISA.8.15.003" x-align="ISA.8.15.a003" x-target-ids="t005" x-target="thereon" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="over" x-translit="ḇ" xml:lang="hbo">בָ֖</char><char style="w" x-id="WLC.ISA.8.15.004" x-align="ISA.8.15.a003" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.ISA.8.15.005" x-align="ISA.8.15.a004" x-target-ids="t002" x-target="many" x-target-head="t002" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbiym" xml:lang="hbo">רַבִּ֑ים</char> <char style="w" x-id="WLC.ISA.8.15.006" x-align="ISA.8.15.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.8.15.007" x-align="ISA.8.15.a006" x-target-ids="t007" x-target="fall" x-target-head="t007" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqq3cp" x-gloss="they.will.fall" x-translit="nāp̄əlû" xml:lang="hbo">נָפְל֣וּ</char> <char style="w" x-id="WLC.ISA.8.15.008" x-align="ISA.8.15.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.8.15.009" x-align="ISA.8