	<para style="p"><verse number="20" style="v" x-ref="ISA.13.20" x-added-alignments="ISA.13.20.a016" x-added-target-ids="t027 t028" x-added-target="their flocks" sid="ISA 13:20" /><char style="w" x-id="WLC.ISA.13.20.001" x-align="ISA.13.20.a001" x-status="noncompositional" x-target-ids="t003" x-target="never" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.ISA.13.20.002" x-align="ISA.13.20.a002" x-target-ids="t001 t002 t004 t005" x-target="It shall be inhabited" x-target-head="t005" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi3fs" x-gloss="it.will.remain" x-translit="ṯēšēḇ" xml:lang="hbo">תֵשֵׁ֣ב</char> <char style="w" x-id="WLC.ISA.13.20.003" x-align="ISA.13.20.a001" x-status="noncompositional" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.13.20.004" x-align="ISA.13.20.a001" x-status="noncompositional" lemma="נֵצַח" strong="H5331" x-morph="Ncmsa" x-gloss="perpetuity" x-translit="neṣaḥ" xml:lang="hbo">נֶ֔צַח</char> <char style="w" x-id="WLC.ISA.13.20.005" x-align="ISA.13.20.a003" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.13.20.006" x-align="ISA.13.20.a003" x-status="noncompositional" x-target-ids="t006" x-target="neither" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.ISA.13.20.007" x-align="ISA.13.20.a004" x-target-ids="t007 t008 t009 t010 t011" x-target="shall it be dwelt in" x-target-head="t010" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqi3fs" x-gloss="it.will.settle" x-translit="ṯiškōn" xml:lang="hbo">תִשְׁכֹּ֖ן</char> <char style="w" x-id="WLC.ISA.13.20.008" x-align="ISA.13.20.a005" x-target-ids="t012" x-target="from" x-target-head="t012