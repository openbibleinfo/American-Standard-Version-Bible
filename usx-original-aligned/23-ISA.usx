	<para style="p"><verse number="3" style="v" x-ref="ISA.18.3" sid="ISA 18:3" /><char style="w" x-id="WLC.ISA.18.3.001" x-align="ISA.18.3.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="O.all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.18.3.002" x-align="ISA.18.3.a002" x-target-ids="t002 t003" x-target="ye inhabitants" x-target-head="t003" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqrmpc" x-gloss="the.inhabitants" x-translit="yōšəḇēy" xml:lang="hbo">יֹשְׁבֵ֥י</char> <char style="w" x-id="WLC.ISA.18.3.003" x-align="ISA.18.3.a003" x-target-ids="t004 t005 t006" x-target="of the world" x-target-head="t006" x-head="true" lemma="תֵּבֵל" strong="H8398" x-morph="Ncfsa" x-gloss="of.[the].world" x-translit="ṯēḇēl" xml:lang="hbo">תֵבֵ֖ל</char> <char style="w" x-id="WLC.ISA.18.3.004" x-align="ISA.18.3.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.18.3.005" x-align="ISA.18.3.a005" x-target-ids="t008 t009" x-target="ye dwellers" x-target-head="t009" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqrmpc" x-gloss="[those.who].dwell" x-translit="šōḵənê" xml:lang="hbo">שֹׁ֣כְנֵי</char> <char style="w" x-id="WLC.ISA.18.3.006" x-align="ISA.18.3.a006" x-target-ids="t010 t011 t012" x-target="on the earth" x-target-head="t012" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.ISA.18.3.007" x-align="ISA.18.3.a007" x-target-ids="t013" x-target="when" x-target-head="t013" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="just" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.ISA.18.3.008" x-align="ISA.18.3.a008" x-target-ids="t016 t017 t018" x-target="is lifted up" x-target-head="t017"