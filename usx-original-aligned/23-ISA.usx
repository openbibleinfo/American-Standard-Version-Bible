	<para style="p"><verse number="22" style="v" x-ref="ISA.45.22" sid="ISA 45:22" /><char style="w" x-id="WLC.ISA.45.22.001" x-align="ISA.45.22.a001" x-target-ids="t001" x-target="Look" x-target-head="t001" x-head="true" lemma="פָּנָה" strong="H6437" x-morph="Vqv2mp" x-gloss="turn" x-translit="pənû-" xml:lang="hbo">פְּנוּ</char>־<char style="w" x-id="WLC.ISA.45.22.002" x-align="ISA.45.22.a002" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלַ֥</char><char style="w" x-id="WLC.ISA.45.22.003" x-align="ISA.45.22.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.45.22.004" x-align="ISA.45.22.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.45.22.005" x-align="ISA.45.22.a005" x-target-ids="t005 t006 t007" x-target="be ye saved" x-target-head="t007" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="VNv2mp" x-gloss="be.saved" x-translit="hiwwāšəʿû" xml:lang="hbo">הִוָּשְׁע֖וּ</char> <char style="w" x-id="WLC.ISA.45.22.006" x-align="ISA.45.22.a006" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="O.all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.45.22.007" x-align="ISA.45.22.a007" x-target-ids="t009 t010" x-target="the ends" x-target-head="t010" x-head="true" lemma="אֶפֶס" strong="H657" x-morph="Ncmpc" x-gloss="[the].ends" x-translit="ʾap̄sê-" xml:lang="hbo">אַפְסֵי</char>־<char style="w" x-id="WLC.ISA.45.22.008" x-align="ISA.45.22.a008" x-target-ids="t011 t012 t013" x-target="of the earth" x-target-head="t013" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbs