	<para style="p"><verse number="2" style="v" x-ref="ISA.66.2" sid="ISA 66:2" /><char style="w" x-id="WLC.ISA.66.2.001" x-align="ISA.66.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.66.2.002" x-align="ISA.66.2.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.ISA.66.2.003" x-align="ISA.66.2.a003" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.66.2.004" x-align="ISA.66.2.a004" x-target-ids="t003 t004" x-target="these things" x-target-head="t003" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo">אֵ֨לֶּה֙</char> <char style="w" x-id="WLC.ISA.66.2.005" x-align="ISA.66.2.a005" x-target-ids="t007" x-target="hand" x-target-head="t007" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָדִ֣</char><char style="w" x-id="WLC.ISA.66.2.006" x-align="ISA.66.2.a006" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.66.2.007" x-align="ISA.66.2.a007" x-target-ids="t005 t008" x-target="hath made" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3fs" x-gloss="it.made" x-translit="ʿāśāṯâ" xml:lang="hbo">עָשָׂ֔תָה</char> <char style="w" x-id="WLC.ISA.66.2.008" x-align="ISA.66.2.a008" x-target-ids="t009 t010" x-target="and so" x-target-italic-ids="t010" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</