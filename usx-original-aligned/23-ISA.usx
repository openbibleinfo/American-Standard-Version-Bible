	<para style="p"><verse number="27" style="v" x-ref="ISA.41.27" x-added-alignments="ISA.41.27.a001 ISA.41.27.a003 ISA.41.27.a004" x-added-target-ids="t001 t005 t006" x-added-target="I | that | saith" sid="ISA 41:27" /><char style="w" x-id="WLC.ISA.41.27.001" x-align="ISA.41.27.a002" x-target-ids="t002 t003 t004" x-target="am the first" x-target-italic-ids="t002 t003" x-target-head="t004" x-head="true" lemma="רִאשׁוֹן" strong="H7223" x-morph="Aamsa" x-gloss="a.first.[one]" x-translit="riʾšôn" xml:lang="hbo">רִאשׁ֥וֹן</char> <char style="w" x-id="WLC.ISA.41.27.002" x-align="ISA.41.27.a005" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.41.27.003" x-align="ISA.41.27.a006" x-target-ids="t008" x-target="Zion" x-target-head="t008" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="Zion" x-translit="ṣiyyôn" xml:lang="hbo">צִיּ֖וֹן</char> <char style="w" x-id="WLC.ISA.41.27.004" x-align="ISA.41.27.a007" x-target-ids="t009" x-target="Behold" x-target-head="t009" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֣ה</char> <char style="w" x-id="WLC.ISA.41.27.005" x-align="ISA.41.27.a008" x-target-ids="t010" x-target="behold" x-target-head="t010" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here" x-translit="hinn" xml:lang="hbo">הִנָּ֑</char><char style="w" x-id="WLC.ISA.41.27.006" x-align="ISA.41.27.a009" x-target-ids="t011" x-target="them" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="they.[are]" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.ISA.41.27.007" x-align="ISA.41.27.a010" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.41