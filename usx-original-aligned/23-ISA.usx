	<para style="p"><verse number="19" style="v" x-ref="ISA.63.19" sid="ISA 63:19" /><char style="w" x-id="WLC.ISA.63.19.001" x-align="ISA.63.19.a001" x-target-ids="t001 t002 t003" x-target="We are become" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cp" x-gloss="we.have.been" x-translit="hāyiynû" xml:lang="hbo">הָיִ֗ינוּ</char> <char style="w" x-id="WLC.ISA.63.19.002" x-align="ISA.63.19.a002" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.ISA.63.19.003" x-align="ISA.63.19.a002" x-target-ids="t009" x-target="never" x-target-head="t009" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="long.ago" x-translit="ʿôlām" xml:lang="hbo">עוֹלָם֙</char> <char style="w" x-id="WLC.ISA.63.19.004" x-align="ISA.63.19.a002" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[those.whom].not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.ISA.63.19.005" x-align="ISA.63.19.a003" x-target-ids="t008 t010 t011" x-target="thou barest rule" x-target-head="t011" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vqp2ms" x-gloss="you.ruled" x-translit="māšalətā" xml:lang="hbo">מָשַׁ֣לְתָּ</char> <char style="w" x-id="WLC.ISA.63.19.006" x-align="ISA.63.19.a004" x-target-ids="t006" x-target="over" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="over" x-translit="b" xml:lang="hbo">בָּ֔</char><char style="w" x-id="WLC.ISA.63.19.007" x-align="ISA.63.19.a005" x-target-ids="t004 t005 t007" x-target="as they whom" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.ISA.63.19.008" x-align="ISA.63.19.a006" x-target-ids="t016" x-target="not" x-target-head="t016" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[those.whom].not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.ISA.63