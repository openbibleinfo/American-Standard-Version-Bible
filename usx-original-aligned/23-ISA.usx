	<para style="p"><verse number="12" style="v" x-ref="ISA.64.12" sid="ISA 64:12" /><char style="w" x-id="WLC.ISA.64.12.001" x-align="ISA.64.12.a001" x-status="unrepresented" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="ha" xml:lang="hbo" x-source-ref="ISA.64.11">הַ</char><char style="w" x-id="WLC.ISA.64.12.002" x-align="ISA.64.12.a002" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="ISA.64.11">עַל</char>־<char style="w" x-id="WLC.ISA.64.12.003" x-align="ISA.64.12.a003" x-target-ids="t006 t007" x-target="these things" x-target-head="t006" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo" x-source-ref="ISA.64.11">אֵ֥לֶּה</char> <char style="w" x-id="WLC.ISA.64.12.004" x-align="ISA.64.12.a004" x-target-ids="t001 t002 t003 t004" x-target="Wilt thou refrain thyself" x-target-head="t003" x-head="true" lemma="אָפַק" strong="H662" x-morph="Vti2ms" x-gloss="will.you.restrain.yourself" x-translit="ṯiṯʾappaq" xml:lang="hbo" x-source-ref="ISA.64.11">תִתְאַפַּ֖ק</char> <char style="w" x-id="WLC.ISA.64.12.005" x-align="ISA.64.12.a005" x-target-ids="t008 t009" x-target="O Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="ISA.64.11">יְהוָ֑ה</char> <char style="w" x-id="WLC.ISA.64.12.006" x-align="ISA.64.12.a006" x-target-ids="t010 t011 t012 t013 t014" x-target="wilt thou hold thy peace" x-target-head="t012" x-head="true" lemma="חָשָׁה" strong="H2814" x-morph="Vqi2ms" x-gloss="will.you.be.silent?" x-translit="teḥĕšeh" xml:lang="hbo" x-source-ref="ISA.64.11">תֶּחֱשֶׁ֥ה</char> <char style="w" x-id="WLC.ISA.64.12.007" x-align="ISA.64.12.a007" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-t