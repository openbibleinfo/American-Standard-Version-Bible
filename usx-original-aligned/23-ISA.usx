025" x-head="true" lemma="יָתֵד" strong="H3489" x-morph="Ncfpc" x-gloss="your.tent" x-translit="yṯēḏōṯay" xml:lang="hbo">יתֵדֹתַ֖יִ</char><char style="w" x-id="WLC.ISA.54.2.017" x-align="ISA.54.2.a017" x-target-ids="t024" x-target="thy" x-target-head="t024" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="pegs" x-translit="iḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.54.2.018" x-align="ISA.54.2.a018" x-target-ids="t023" x-target="strengthen" x-target-head="t023" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vpv2fs" x-gloss="make.strong" x-translit="ḥazzēqî:" xml:lang="hbo">חַזֵּֽקִי</char>׃<verse eid="ISA 54:2" /></para>
	<para style="p"><verse number="3" style="v" x-ref="ISA.54.3" sid="ISA 54:3" /><char style="w" x-id="WLC.ISA.54.3.001" x-align="ISA.54.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.ISA.54.3.002" x-align="ISA.54.3.a002" x-target-ids="t006 t007 t008 t009" x-target="on the right hand" x-target-head="t008" x-head="true" lemma="יָמִין" strong="H3225" x-morph="Ncfsa" x-gloss="right" x-translit="yāmiyn" xml:lang="hbo">יָמִ֥ין</char> <char style="w" x-id="WLC.ISA.54.3.003" x-align="ISA.54.3.a003" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.54.3.004" x-align="ISA.54.3.a004" x-target-ids="t011 t012 t013" x-target="on the left" x-target-head="t013" x-head="true" lemma="שְׂמֹאל" strong="H8040" x-morph="Ncmsa" x-gloss="left" x-translit="śəmōʾwl" xml:lang="hbo">שְׂמֹ֖אול</char> <char style="w" x-id="WLC.ISA.54.3.005" x-align="ISA.54.3.a005" x-target-ids="t002 t003 t004 t005" x-target="thou shalt spread abroad" x-target-head="t004" x-head="true" lemma="פָּרַץ" strong="H6555" x-morph="Vqi2fs" x-gloss="you.will.spread.out" x-translit="tip̄rōṣî" xml:lang="hbo">תִּפְרֹ֑צִי</char> <char style="w" x-id="WLC.ISA.54.3.006" x-align="ISA.54.3.a006" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.54.3.007" x-align="ISA.54.3.a007" x-target-ids="t016" x-target="seed" x-target-head="t016" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsc" x-gloss="offspring" x-translit="zarʿ" xml:lang="hbo">זַרְעֵ</char><char style="w" x-id="WLC.ISA.54.3.008" x-align="ISA.54.3.a008" x-target-ids="t015" x-target="thy" x-target-head="t015" x-head="true" lemma="הוּ