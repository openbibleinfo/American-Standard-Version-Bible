	<para style="p"><verse number="15" style="v" x-ref="ISA.13.15" sid="ISA 13:15" /><char style="w" x-id="WLC.ISA.13.15.001" x-align="ISA.13.15.a001" x-target-ids="t001" x-target="Every" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.ISA.13.15.002" x-align="ISA.13.15.a002" x-target-ids="t002 t003" x-target="one that" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the).[one" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.13.15.003" x-align="ISA.13.15.a003" x-target-ids="t004 t005" x-target="is found" x-target-head="t005" x-head="true" lemma="מָצָא" strong="H4672" x-morph="VNrmsa" x-gloss="who.is].found" x-translit="nnimṣāʾ" xml:lang="hbo">נִּמְצָ֖א</char> <char style="w" x-id="WLC.ISA.13.15.004" x-align="ISA.13.15.a004" x-target-ids="t006 t007 t008 t009" x-target="shall be thrust through" x-target-head="t008" x-head="true" lemma="דָּקַר" strong="H1856" x-morph="VNi3ms" x-gloss="he.will.be.pierced.through" x-translit="yiddāqēr" xml:lang="hbo">יִדָּקֵ֑ר</char> <char style="w" x-id="WLC.ISA.13.15.005" x-align="ISA.13.15.a005" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.13.15.006" x-align="ISA.13.15.a006" x-target-ids="t011" x-target="every" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.ISA.13.15.007" x-align="ISA.13.15.a007" x-target-ids="t012 t013" x-target="one that" x-target-head="t012" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the).[one" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.13.15.008" x-align="ISA.13.15.a008" x-target-ids="t014 t015" x-target="is taken" x-target-head="t015" 