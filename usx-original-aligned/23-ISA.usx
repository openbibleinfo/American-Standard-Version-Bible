	<para style="p"><verse number="14" style="v" x-ref="ISA.23.14" sid="ISA 23:14" /><char style="w" x-id="WLC.ISA.23.14.001" x-align="ISA.23.14.a001" x-target-ids="t001 t002" x-target="Howl ye" x-target-head="t001" x-head="true" lemma="יָלַל" strong="H3213" x-morph="Vhv2mp" x-gloss="wail" x-translit="hêliylû" xml:lang="hbo">הֵילִ֖ילוּ</char> <char style="w" x-id="WLC.ISA.23.14.002" x-align="ISA.23.14.a002" x-target-ids="t003" x-target="ships" x-target-head="t003" x-head="true" lemma="אֳנִיָּה" strong="H591" x-morph="Ncfpc" x-gloss="O.ships" x-translit="ʾŏniyyôṯ" xml:lang="hbo">אֳנִיּ֣וֹת</char> <char style="w" x-id="WLC.ISA.23.14.003" x-align="ISA.23.14.a003" x-target-ids="t004 t005" x-target="of Tarshish" x-target-head="t005" x-head="true" lemma="תַּרְשִׁישׁ" strong="H8659" x-morph="Np" x-gloss="of.Tarshish" x-translit="taršiyš" xml:lang="hbo">תַּרְשִׁ֑ישׁ</char> <char style="w" x-id="WLC.ISA.23.14.004" x-align="ISA.23.14.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.ISA.23.14.005" x-align="ISA.23.14.a005" x-target-ids="t009 t010 t011" x-target="is laid waste" x-target-head="t011" x-head="true" lemma="שָׁדַד" strong="H7703" x-morph="VPp3ms" x-gloss="it.has.been.devastated" x-translit="šuddaḏ" xml:lang="hbo">שֻׁדַּ֖ד</char> <char style="w" x-id="WLC.ISA.23.14.006" x-align="ISA.23.14.a006" x-target-ids="t008" x-target="stronghold" x-target-head="t008" x-head="true" lemma="מָעוֹז" strong="H4581" x-morph="Ncmsc" x-gloss="stronghold" x-translit="māʿuzz" xml:lang="hbo">מָעֻזְּ</char><char style="w" x-id="WLC.ISA.23.14.007" x-align="ISA.23.14.a007" x-target-ids="t007" x-target="your" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3654a" x-morph="Sp2fp" x-gloss="your" x-translit="əḵen" xml:lang="hbo">כֶֽן</char>׃ס<verse eid="ISA 23:14" /></para>
