	<para style="p"><verse number="15" style="v" x-ref="ISA.19.15" sid="ISA 19:15" /><char style="w" x-id="WLC.ISA.19.15.001" x-align="ISA.19.15.a001" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.19.15.002" x-align="ISA.19.15.a001" x-target-ids="t001" x-target="Neither" x-target-head="t001" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.ISA.19.15.003" x-align="ISA.19.15.a002" x-target-ids="t002 t003 t004" x-target="shall there be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="it.will.be" x-translit="yihyeh" xml:lang="hbo">יִהְיֶ֥ה</char> <char style="w" x-id="WLC.ISA.19.15.004" x-align="ISA.19.15.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.19.15.005" x-align="ISA.19.15.a004" x-target-ids="t006" x-target="Egypt" x-target-head="t006" x-head="true" lemma="מִצְרַיִם" strong="H4714" x-morph="Np" x-gloss="Egypt" x-translit="miṣrayim" xml:lang="hbo">מִצְרַ֖יִם</char> <char style="w" x-id="WLC.ISA.19.15.006" x-align="ISA.19.15.a005" x-target-ids="t007 t008" x-target="any work" x-target-head="t008" x-head="true" lemma="מַעֲשֶׂה" strong="H4639" x-morph="Ncmsa" x-gloss="a.deed" x-translit="maʿăśeh" xml:lang="hbo">מַֽעֲשֶׂ֑ה</char> <char style="w" x-id="WLC.ISA.19.15.007" x-align="ISA.19.15.a006" x-target-ids="t009" x-target="which" x-target-head="t009" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֧ר</char> <char style="w" x-id="WLC.ISA.19.15.008" x-align="ISA.19.15.a007" x-target-ids="t017 t018" x-target="may do" x-target-head="t018" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi3ms" x-gloss="it.will.do" x-translit="yaʿăśeh" xml:lang="hbo">יַע