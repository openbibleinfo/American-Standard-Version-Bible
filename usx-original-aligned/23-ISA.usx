	<para style="p"><verse number="1" style="v" x-ref="ISA.54.1" sid="ISA 54:1" /><char style="w" x-id="WLC.ISA.54.1.001" x-align="ISA.54.1.a001" x-target-ids="t001" x-target="Sing" x-target-head="t001" x-head="true" lemma="רָנַן" strong="H7442" x-morph="Vqv2fs" x-gloss="shout.for.joy" x-translit="ronniy" xml:lang="hbo">רָנִּ֥י</char> <char style="w" x-id="WLC.ISA.54.1.002" x-align="ISA.54.1.a002" x-target-ids="t002 t003 t004" x-target="O barren thou" x-target-head="t003" x-head="true" lemma="עָקָר" strong="H6135" x-morph="Aafsa" x-gloss="O.barren.[woman]" x-translit="ʿăqārāh" xml:lang="hbo">עֲקָרָ֖ה</char> <char style="w" x-id="WLC.ISA.54.1.003" x-align="ISA.54.1.a003" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[who].not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.54.1.004" x-align="ISA.54.1.a004" x-target-ids="t005 t006 t008" x-target="that didst bear" x-target-head="t008" x-head="true" lemma="יָלַד" strong="H3205" x-morph="Vqp3fs" x-gloss="she.has.given.birth" x-translit="yālāḏâ" xml:lang="hbo">יָלָ֑דָה</char> <char style="w" x-id="WLC.ISA.54.1.005" x-align="ISA.54.1.a005" x-target-ids="t009 t010" x-target="break forth" x-target-head="t009" x-head="true" lemma="פָּצַח" strong="H6476" x-morph="Vqv2fs" x-gloss="break.forth" x-translit="piṣḥiy" xml:lang="hbo">פִּצְחִ֨י</char> <char style="w" x-id="WLC.ISA.54.1.006" x-align="ISA.54.1.a006" x-target-ids="t011 t012" x-target="into singing" x-target-head="t012" x-head="true" lemma="רִנָּה" strong="H7440" x-morph="Ncfsa" x-gloss="a.shout.of.joy" x-translit="rinnāh" xml:lang="hbo">רִנָּ֤ה</char> <char style="w" x-id="WLC.ISA.54.1.007" x-align="ISA.54.1.a007" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.54.1.008" x-align="ISA.54.1.a008" x-target-ids="t014 t015" x-target="cry 