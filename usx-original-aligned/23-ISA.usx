	<para style="p"><verse number="3" style="v" x-ref="ISA.66.3" sid="ISA 66:3" /><char style="w" x-id="WLC.ISA.66.3.001" x-align="ISA.66.3.a001" x-target-ids="t001 t002 t003" x-target="He that killeth" x-target-head="t003" x-head="true" lemma="שָׁחַט" strong="H7819" x-morph="Vqrmsa" x-gloss="[one.who].slaughters" x-translit="šôḥēṭ" xml:lang="hbo">שׁוֹחֵ֨ט</char> <char style="w" x-id="WLC.ISA.66.3.002" x-align="ISA.66.3.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.66.3.003" x-align="ISA.66.3.a003" x-target-ids="t004 t005" x-target="an ox" x-target-head="t005" x-head="true" lemma="שׁוֹר" strong="H7794" x-morph="Ncmsa" x-gloss="ox" x-translit="ššôr" xml:lang="hbo">שּׁ֜וֹר</char> <char style="w" x-id="WLC.ISA.66.3.004" x-align="ISA.66.3.a004" x-target-ids="t006 t007 t008 t009 t010" x-target="is as he that slayeth" x-target-head="t010" x-head="true" lemma="נָכָה" strong="H5221" x-morph="Vhrmsc" x-gloss="[one.who].strikes.down" x-translit="makkēh-" xml:lang="hbo">מַכֵּה</char>־<char style="w" x-id="WLC.ISA.66.3.005" x-align="ISA.66.3.a005" x-target-ids="t011 t012" x-target="a man" x-target-head="t012" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="(of).a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֗ישׁ</char> <char style="w" x-id="WLC.ISA.66.3.006" x-align="ISA.66.3.a006" x-target-ids="t013 t014 t015" x-target="he that sacrificeth" x-target-head="t015" x-head="true" lemma="זָבַח" strong="H2076" x-morph="Vqrmsa" x-gloss="[one.who].sacrifices" x-translit="zôḇēᵃḥ" xml:lang="hbo">זוֹבֵ֤חַ</char> <char style="w" x-id="WLC.ISA.66.3.007" x-align="ISA.66.3.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.66.3.008" x-align="ISA.66.3.a008" x-target-ids="t016 t017" x-target="a lamb" x-target-head="t017" x-head="true" lemma