	<para style="p"><verse number="13" style="v" x-ref="ISA.57.13" sid="ISA 57:13" /><char style="w" x-id="WLC.ISA.57.13.001" x-align="ISA.57.13.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.57.13.002" x-align="ISA.57.13.a002" x-target-ids="t003" x-target="criest" x-target-head="t003" x-head="true" lemma="זָעַק" strong="H2199" x-morph="Vqc" x-gloss="you" x-translit="zaʿăq" xml:lang="hbo">זַֽעֲקֵ</char><char style="w" x-id="WLC.ISA.57.13.003" x-align="ISA.57.13.a003" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="cry.out" x-translit="ēḵ" xml:lang="hbo">ךְ֙</char> <char style="w" x-id="WLC.ISA.57.13.004" x-align="ISA.57.13.a004" x-target-ids="t004 t010" x-target="let deliver" x-target-head="t010" x-head="true" lemma="נָצַל" strong="H5337" x-morph="Vhi3mp" x-gloss="let" x-translit="yaṣṣiylu" xml:lang="hbo">יַצִּילֻ֣</char><char style="w" x-id="WLC.ISA.57.13.005" x-align="ISA.57.13.a005" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="them.deliver.you" x-translit="ḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.57.13.006" x-align="ISA.57.13.a006" x-target-ids="t005 t006 t008 t009" x-target="them that hast gathered" x-target-head="t009" x-head="true" lemma="קִבּוּץ" strong="H6899" x-morph="Ncmpc" x-gloss="collection(s)" x-translit="qibbûṣay" xml:lang="hbo">קִבּוּצַ֔יִ</char><char style="w" x-id="WLC.ISA.57.13.007" x-align="ISA.57.13.a007" x-target-ids="t007" x-target="thou" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="iḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.57.13.008" x-align="ISA.57.13.a008" x-target-ids="t012" x-target="but" x-target-head="t012" x-head="true" lemma="וְ" strong=