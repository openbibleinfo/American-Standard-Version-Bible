	<para style="p"><verse number="21" style="v" x-ref="ISA.13.21" sid="ISA 13:21" /><char style="w" x-id="WLC.ISA.13.21.001" x-align="ISA.13.21.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.13.21.002" x-align="ISA.13.21.a002" x-target-ids="t007 t008" x-target="shall lie" x-target-head="t008" x-head="true" lemma="רָבַץ" strong="H7257" x-morph="Vqq3cp" x-gloss="they.will.lie.down" x-translit="rāḇəṣû-" xml:lang="hbo">רָבְצוּ</char>־<char style="w" x-id="WLC.ISA.13.21.003" x-align="ISA.13.21.a003" x-target-ids="t009" x-target="there" x-target-head="t009" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="there" x-translit="šām" xml:lang="hbo">שָׁ֣ם</char> <char style="w" x-id="WLC.ISA.13.21.004" x-align="ISA.13.21.a004" x-target-ids="t002 t003 t004 t005 t006" x-target="wild beasts of the desert" x-target-head="t003" x-head="true" lemma="צִי" strong="H6728a" x-morph="Ncmpa" x-gloss="desert-dwellers" x-translit="ṣiyyiym" xml:lang="hbo">צִיִּ֔ים</char> <char style="w" x-id="WLC.ISA.13.21.005" x-align="ISA.13.21.a005" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.13.21.006" x-align="ISA.13.21.a006" x-target-ids="t013 t014 t015 t016" x-target="shall be full of" x-target-head="t015" x-head="true" lemma="מָלֵא" strong="H4390" x-morph="Vqq3cp" x-gloss="they.will.be.full" x-translit="mālʾû" xml:lang="hbo">מָלְא֥וּ</char> <char style="w" x-id="WLC.ISA.13.21.007" x-align="ISA.13.21.a007" x-target-ids="t012" x-target="houses" x-target-head="t012" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmpc" x-gloss="houses" x-translit="ḇāttēy" xml:lang="hbo">בָתֵּי</char><char style="w" x-id="WLC.ISA.13.21.008" x-align="ISA.13.21.a008" x-target-ids="t011" x-target="their" x-target