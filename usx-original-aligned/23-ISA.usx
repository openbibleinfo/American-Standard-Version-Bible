	<para style="p"><verse number="2" style="v" x-ref="ISA.57.2" sid="ISA 57:2" /><char style="w" x-id="WLC.ISA.57.2.001" x-align="ISA.57.2.a001" x-target-ids="t001 t002 t003" x-target="He entereth into" x-target-head="t002" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3ms" x-gloss="he.will.go" x-translit="yāḇôʾ" xml:lang="hbo">יָב֣וֹא</char> <char style="w" x-id="WLC.ISA.57.2.002" x-align="ISA.57.2.a002" x-target-ids="t004" x-target="peace" x-target-head="t004" x-head="true" lemma="שָׁלוֹם" strong="H7965" x-morph="Ncmsa" x-gloss="peace" x-translit="šālôm" xml:lang="hbo">שָׁל֔וֹם</char> <char style="w" x-id="WLC.ISA.57.2.003" x-align="ISA.57.2.a003" x-target-ids="t005 t006" x-target="they rest" x-target-head="t006" x-head="true" lemma="נוּחַ" strong="H5117" x-morph="Vqi3mp" x-gloss="they.will.rest" x-translit="yānûḥû" xml:lang="hbo">יָנ֖וּחוּ</char> <char style="w" x-id="WLC.ISA.57.2.004" x-align="ISA.57.2.a004" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.57.2.005" x-align="ISA.57.2.a005" x-target-ids="t009" x-target="beds" x-target-head="t009" x-head="true" lemma="מִשְׁכָּב" strong="H4904" x-morph="Ncmpc" x-gloss="beds" x-translit="miškəḇôṯ" xml:lang="hbo">מִשְׁכְּבוֹתָ֑</char><char style="w" x-id="WLC.ISA.57.2.006" x-align="ISA.57.2.a006" x-target-ids="t008" x-target="their" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.ISA.57.2.007" x-align="ISA.57.2.a007" x-target-ids="t010 t011 t012 t013" x-target="each one that walketh" x-target-head="t013" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[one.who].walks" x-translit="hōlēḵ" xml:lang="hbo">הֹלֵ֖ךְ</char> <char style="w" x-id="WLC.ISA.57.2.008" x-align="ISA.57.2.a008" x-target-ids="t014 t016" x-target="in uprightness" x-tar