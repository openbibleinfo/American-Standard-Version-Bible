	<para style="p"><verse number="13" style="v" x-ref="ISA.14.13" sid="ISA 14:13" /><char style="w" x-id="WLC.ISA.14.13.001" x-align="ISA.14.13.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.14.13.002" x-align="ISA.14.13.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֞ה</char> <char style="w" x-id="WLC.ISA.14.13.003" x-align="ISA.14.13.a003" x-target-ids="t003" x-target="saidst" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp2ms" x-gloss="you.said" x-translit="ʾāmarətā" xml:lang="hbo">אָמַ֤רְתָּ</char> <char style="w" x-id="WLC.ISA.14.13.004" x-align="ISA.14.13.a004" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇi" xml:lang="hbo">בִֽ</char><char style="w" x-id="WLC.ISA.14.13.005" x-align="ISA.14.13.a005" x-target-ids="t006" x-target="heart" x-target-head="t006" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsc" x-gloss="heart" x-translit="ləḇāḇ" xml:lang="hbo">לְבָבְ</char><char style="w" x-id="WLC.ISA.14.13.006" x-align="ISA.14.13.a006" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֙</char> <char style="w" x-id="WLC.ISA.14.13.007" x-align="ISA.14.13.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.14.13.008" x-align="ISA.14.13.a008" x-target-ids="t010 t011" x-target="into heaven" x-target-head="t011" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heavens" x-translit="ššāmayim" xml:lang="hbo">שָּׁמַ֣יִם</char> <ch