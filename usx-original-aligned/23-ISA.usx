	<para style="p"><verse number="6" style="v" x-ref="ISA.19.6" sid="ISA 19:6" /><char style="w" x-id="WLC.ISA.19.6.001" x-align="ISA.19.6.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.19.6.002" x-align="ISA.19.6.a002" x-target-ids="t004 t005 t006" x-target="shall become foul" x-target-head="t006" x-head="true" lemma="זָנַח" strong="H2186a" x-morph="Vhq3cp" x-gloss="they.will.stink" x-translit="heʾezniyḥû" xml:lang="hbo">הֶאֶזְנִ֣יחוּ</char> <char style="w" x-id="WLC.ISA.19.6.003" x-align="ISA.19.6.a003" x-target-ids="t002 t003" x-target="the rivers" x-target-head="t003" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmpa" x-gloss="[the].rivers" x-translit="nəhārôṯ" xml:lang="hbo">נְהָר֔וֹת</char> <char style="w" x-id="WLC.ISA.19.6.004" x-align="ISA.19.6.a004" x-target-ids="t011 t012 t013" x-target="shall be diminished" x-target-head="t013" x-head="true" lemma="דָּלַל" strong="H1809" x-morph="Vqp3cp" x-gloss="they.will.be.low" x-translit="dālălû" xml:lang="hbo">דָּלֲל֥וּ</char> <char style="w" x-id="WLC.ISA.19.6.005" x-align="ISA.19.6.a005" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.19.6.006" x-align="ISA.19.6.a006" x-target-ids="t015 t016" x-target="dried up" x-target-head="t015" x-head="true" lemma="חָרֵב" strong="H2717" x-morph="Vqq3cp" x-gloss="they.will.become.dry" x-translit="ḥārəḇû" xml:lang="hbo">חָרְב֖וּ</char> <char style="w" x-id="WLC.ISA.19.6.007" x-align="ISA.19.6.a007" x-target-ids="t007 t008" x-target="the streams" x-target-head="t008" x-head="true" lemma="יְאֹר" strong="H2975" x-morph="Ncmpc" x-gloss="the.canals" x-translit="yəʾōrēy" xml:lang="hbo">יְאֹרֵ֣י</char> <char style="w" x-id="WLC.ISA.19.6.008" x-align="ISA.19.6.a008" x-target-ids="t009 t01