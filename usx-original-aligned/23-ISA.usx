	<para style="p"><verse number="23" style="v" x-ref="ISA.14.23" sid="ISA 14:23" /><char style="w" x-id="WLC.ISA.14.23.001" x-align="ISA.14.23.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.14.23.002" x-align="ISA.14.23.a002" x-target-ids="t001 t002 t004" x-target="I will make" x-target-head="t004" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqq1cs" x-gloss="I" x-translit="śamtiy" xml:lang="hbo">שַׂמְתִּ֛י</char><char style="w" x-id="WLC.ISA.14.23.003" x-align="ISA.14.23.a003" x-target-ids="t005" x-target="it" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="will.make.it" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.ISA.14.23.004" x-align="ISA.14.23.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(into).a" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.14.23.005" x-align="ISA.14.23.a005" x-target-ids="t006 t007" x-target="a possession" x-target-head="t007" x-head="true" lemma="מוֹרָשׁ" strong="H4180" x-morph="Ncmsc" x-gloss="possession" x-translit="môraš" xml:lang="hbo">מוֹרַ֥שׁ</char> <char style="w" x-id="WLC.ISA.14.23.006" x-align="ISA.14.23.a006" x-target-ids="t008 t009 t010" x-target="for the porcupine" x-target-head="t010" x-head="true" lemma="קִפֹּד" strong="H7090" x-morph="Ncmsa" x-gloss="of.hedgehog[s]" x-translit="qippōḏ" xml:lang="hbo">קִפֹּ֖ד</char> <char style="w" x-id="WLC.ISA.14.23.007" x-align="ISA.14.23.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.14.23.008" x-align="ISA.14.23.a008" x-target-ids="t012" x-target="pools" x-target-head="t012" x-head="true" lemma="אֲגַם" strong="H98" x-morph="Ncmpc" x-gloss="pools" x-t