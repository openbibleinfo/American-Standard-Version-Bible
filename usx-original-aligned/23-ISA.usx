	<para style="p"><verse number="11" style="v" x-ref="ISA.41.11" sid="ISA 41:11" /><char style="w" x-id="WLC.ISA.41.11.001" x-align="ISA.41.11.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֤ן</char> <char style="w" x-id="WLC.ISA.41.11.002" x-align="ISA.41.11.a002" x-target-ids="t009 t010 t011 t012 t013" x-target="shall be put to shame" x-target-head="t013" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi3mp" x-gloss="they.will.be.ashamed" x-translit="yēḇōšû" xml:lang="hbo">יֵבֹ֨שׁוּ֙</char> <char style="w" x-id="WLC.ISA.41.11.003" x-align="ISA.41.11.a003" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.41.11.004" x-align="ISA.41.11.a004" x-target-ids="t015" x-target="confounded" x-target-head="t015" x-head="true" lemma="כָּלַם" strong="H3637" x-morph="VNi3mp" x-gloss="they.will.be.put.to.shame" x-translit="yikkāləmû" xml:lang="hbo">יִכָּ֣לְמ֔וּ</char> <char style="w" x-id="WLC.ISA.41.11.005" x-align="ISA.41.11.a005" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kōl" xml:lang="hbo">כֹּ֖ל</char> <char style="w" x-id="WLC.ISA.41.11.006" x-align="ISA.41.11.a006" x-target-ids="t003 t004" x-target="they that" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.41.11.007" x-align="ISA.41.11.a007" x-target-ids="t005 t006" x-target="are incensed" x-target-head="t006" x-head="true" lemma="חָרָה" strong="H2734" x-morph="VNrmpa" x-gloss="who.are].angry" x-translit="nneḥĕriym" xml:lang="hbo">נֶּחֱרִ֣ים</char> <char style="w" x-id="WLC.ISA.41.11.008" x-align="ISA.41.11.a008" x-target-ids="t007" x-target="again