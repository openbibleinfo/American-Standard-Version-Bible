	<para style="p"><verse number="14" style="v" x-ref="ISA.14.14" sid="ISA 14:14" /><char style="w" x-id="WLC.ISA.14.14.001" x-align="ISA.14.14.a001" x-target-ids="t001 t002 t003" x-target="I will ascend" x-target-head="t003" x-head="true" lemma="עָלָה" strong="H5927" x-morph="Vqi1cs" x-gloss="I.will.ascend" x-translit="ʾeʿĕleh" xml:lang="hbo">אֶעֱלֶ֖ה</char> <char style="w" x-id="WLC.ISA.14.14.002" x-align="ISA.14.14.a002" x-target-ids="t004" x-target="above" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="above" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.14.14.003" x-align="ISA.14.14.a003" x-target-ids="t005 t006" x-target="the heights" x-target-head="t006" x-head="true" lemma="בָּמָה" strong="H1116" x-morph="Ncfpc" x-gloss="[the].high.places" x-translit="bāmŏṯê" xml:lang="hbo">בָּ֣מֳתֵי</char> <char style="w" x-id="WLC.ISA.14.14.004" x-align="ISA.14.14.a004" x-target-ids="t007 t008 t009" x-target="of the clouds" x-target-head="t009" x-head="true" lemma="עָב" strong="H5645" x-morph="Ncbsa" x-gloss="of.[the].cloud[s]" x-translit="ʿāḇ" xml:lang="hbo">עָ֑ב</char> <char style="w" x-id="WLC.ISA.14.14.005" x-align="ISA.14.14.a005" x-target-ids="t010 t011 t012 t013" x-target="I will make myself" x-target-head="t012" x-head="true" lemma="דָּמָה" strong="H1819" x-morph="Vti1cs" x-gloss="I.will.make.myself.like" x-translit="ʾeddammeh" xml:lang="hbo">אֶדַּמֶּ֖ה</char> <char style="w" x-id="WLC.ISA.14.14.006" x-align="ISA.14.14.a006" x-target-ids="t014" x-target="like" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to).the" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.14.14.007" x-align="ISA.14.14.a007" x-target-ids="t015 t016 t017" x-target="the Most High" x-target-head="t016" x-head="true" lemma="עֶלְיוֹן" strong="H5945a" x-morph="Aamsa" x-gloss="Most.High" x-translit="ʿelyôn:" xml:lang="hbo">עֶלְיֽוֹן</char>׃<verse eid="ISA 14:14" /></para>
	<para style="p"><verse number="15" style="v" x-ref="ISA.14.15" sid="ISA 14:15" /><char style="w" x-id="WLC.ISA.14.15.001" x-align="ISA.14.15.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="nevertheless" x-translit="ʾaḵ" xml:lang="hbo">אַ֧ךְ</char> <char style="w" x-id="WLC.ISA.14.15.002" x-align="ISA.14.15.a002" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.ISA.14.15.003" x-align="ISA.14.15.a003" x-target-ids="t008" x-target="Sheol" x-target-head="t008" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="Sheol" x-translit="šəʾôl" xml:lang="hbo">שְׁא֛וֹל</char> <char style="w" x-id="WLC.ISA.14.15.004" x-align="ISA.14.15.a004" x-target-ids="t002 t003 t004 t005 t006" x-target="thou shalt be brought down" x-target-head="t005" x-head="true" lemma="יָרַד" strong="H3381" x-morph="VHi3ms" x-gloss="you.have.been.brought.down" x-translit="tûrāḏ" xml:lang="hbo">תּוּרָ֖ד</char> <char style="w" x-id="WLC.ISA.14.15.005" x-align="ISA.14.15.a005" x-target-ids="t009" x-target="to" x-target-head="t009" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.ISA.14.15.006" x-align="ISA.14.15.a006" x-target-ids="t010 t011 t012" x-target="the uttermost parts" x-target-head="t011" x-head="true" lemma="יַרְכָה" strong="H3411" x-morph="Ncfdc" x-gloss="[the].remotest.parts" x-translit="yarkəṯê-" xml:lang="hbo">יַרְכְּתֵי</char>־<char style="w" x-id="WLC.ISA.14.15.007" x-align="ISA.14.15.a007" x-target-ids="t013 t014 t015" x-target="of the pit" x-target-head="t015" x-head="true" lemma="בּוֹר" strong="H953" x-morph="Ncmsa" x-gloss="of.[the].pit" x-translit="ḇôr:" xml:lang="hbo">בֽוֹר</char>׃<verse eid="ISA 14:15" /></para>
