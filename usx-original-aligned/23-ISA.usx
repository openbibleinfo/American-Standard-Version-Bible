	<para style="p"><verse number="2" style="v" x-ref="ISA.16.2" x-added-alignments="ISA.16.2.a008" x-added-target-ids="t013" x-added-target="so" sid="ISA 16:2" /><char style="w" x-id="WLC.ISA.16.2.001" x-align="ISA.16.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.16.2.002" x-align="ISA.16.2.a002" x-target-ids="t002 t003 t004 t005" x-target="it shall be that" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָ֥ה</char> <char style="w" x-id="WLC.ISA.16.2.003" x-align="ISA.16.2.a003" x-target-ids="t006 t009" x-target="as as" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ḵ" xml:lang="hbo">כְ</char><char style="w" x-id="WLC.ISA.16.2.004" x-align="ISA.16.2.a004" x-target-ids="t008" x-target="birds" x-target-head="t008" x-head="true" lemma="עוֹף" strong="H5775" x-morph="Ncmsa" x-gloss="a.bird" x-translit="ʿôp̄-" xml:lang="hbo">עוֹף</char>־<char style="w" x-id="WLC.ISA.16.2.005" x-align="ISA.16.2.a005" x-target-ids="t007" x-target="wandering" x-target-head="t007" x-head="true" lemma="נָדַד" strong="H5074" x-morph="Vqrmsa" x-gloss="fluttering" x-translit="nôḏēḏ" xml:lang="hbo">נוֹדֵ֖ד</char> <char style="w" x-id="WLC.ISA.16.2.006" x-align="ISA.16.2.a006" x-target-ids="t010 t012" x-target="a nest" x-target-head="t012" x-head="true" lemma="קֵן" strong="H7064" x-morph="Ncmsa" x-gloss="a.nest" x-translit="qēn" xml:lang="hbo">קֵ֣ן</char> <char style="w" x-id="WLC.ISA.16.2.007" x-align="ISA.16.2.a007" x-target-ids="t011" x-target="scattered" x-target-head="t011" x-head="true" lemma="שָׁלַח" strong="H7971" x-morph="VPsmsa" x-gloss="sent.away" x-translit="məšullāḥ" xml:lang="hbo">מְשֻׁלָּ֑ח</char> <char style="w" x-id="WLC.ISA.16.2.008" x-align="ISA.16.2.a009" x-target-ids="t014 t019" x-tar