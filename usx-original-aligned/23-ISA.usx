	<para style="p"><verse number="23" style="v" x-ref="ISA.43.23" sid="ISA 43:23" /><char style="w" x-id="WLC.ISA.43.23.001" x-align="ISA.43.23.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.ISA.43.23.002" x-align="ISA.43.23.a002" x-target-ids="t001 t002 t004" x-target="Thou hast brought" x-target-head="t004" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vhp2ms" x-gloss="you.have.brought" x-translit="hēḇēyʾṯā" xml:lang="hbo">הֵבֵ֤יאתָ</char> <char style="w" x-id="WLC.ISA.43.23.003" x-align="ISA.43.23.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לִּ</char><char style="w" x-id="WLC.ISA.43.23.004" x-align="ISA.43.23.a004" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.43.23.005" x-align="ISA.43.23.a005" x-target-ids="t006 t008" x-target="of sheep" x-target-head="t008" x-head="true" lemma="שֶׂה" strong="H7716" x-morph="Ncbsc" x-gloss="the.sheep" x-translit="śēh" xml:lang="hbo">שֵׂ֣ה</char> <char style="w" x-id="WLC.ISA.43.23.006" x-align="ISA.43.23.a006" x-target-ids="t009 t010 t011" x-target="for burnt offerings" x-target-head="t010" x-head="true" lemma="עֹלָה" strong="H5930" x-morph="Ncfpc" x-gloss="your.burnt.offerings" x-translit="ʿōlōṯey" xml:lang="hbo">עֹלֹתֶ֔י</char><char style="w" x-id="WLC.ISA.43.23.007" x-align="ISA.43.23.a007" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.43.23.008" x-align="ISA.43.23.a008" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.