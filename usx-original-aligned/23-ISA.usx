	<para style="p"><verse number="24" style="v" x-ref="ISA.43.24" sid="ISA 43:24" /><char style="w" x-id="WLC.ISA.43.24.001" x-align="ISA.43.24.a001" x-target-ids="t005" x-target="no" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.ISA.43.24.002" x-align="ISA.43.24.a002" x-target-ids="t001 t002 t003" x-target="Thou hast bought" x-target-head="t003" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqp2ms" x-gloss="you.have.bought" x-translit="qāniyṯā" xml:lang="hbo">קָנִ֨יתָ</char> <char style="w" x-id="WLC.ISA.43.24.003" x-align="ISA.43.24.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="ll" xml:lang="hbo">לִּ֤</char><char style="w" x-id="WLC.ISA.43.24.004" x-align="ISA.43.24.a004" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.43.24.005" x-align="ISA.43.24.a005" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="for" x-translit="ḇa" xml:lang="hbo">בַ</char><char style="w" x-id="WLC.ISA.43.24.006" x-align="ISA.43.24.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ISA.43.24.007" x-align="ISA.43.24.a007" x-target-ids="t009" x-target="money" x-target-head="t009" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="money" x-translit="kesep̄" xml:lang="hbo">כֶּ֨סֶף֙</char> <char style="w" x-id="WLC.ISA.43.24.008" x-align="ISA.43.24.a008" x-target-ids="t006 t007" x-target="sweet cane" x-target-head="t007" x-head="true" lemma="קָנֶה" strong="H7070" x-morph="Ncmsa" x-gloss="calamus" x-translit="qāneh" xml:lang="hbo">קָנֶ֔ה</char> <char style="w" x-id="W