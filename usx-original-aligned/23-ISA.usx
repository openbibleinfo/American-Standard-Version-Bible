	<para style="p"><verse number="9" style="v" x-ref="ISA.16.9" sid="ISA 16:9" /><char style="w" x-id="WLC.ISA.16.9.001" x-align="ISA.16.9.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.16.9.002" x-align="ISA.16.9.a001" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֡ן</char> <char style="w" x-id="WLC.ISA.16.9.003" x-align="ISA.16.9.a002" x-target-ids="t002 t003 t004 t010" x-target="I will weep for" x-target-head="t004" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqi1cs" x-gloss="I.weep" x-translit="ʾeḇkeh" xml:lang="hbo">אֶבְכֶּ֞ה</char> <char style="w" x-id="WLC.ISA.16.9.004" x-align="ISA.16.9.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.ISA.16.9.005" x-align="ISA.16.9.a004" x-target-ids="t006 t007" x-target="the weeping" x-target-head="t007" x-head="true" lemma="בְּכִי" strong="H1065" x-morph="Ncmsc" x-gloss="the.weeping" x-translit="ḇəḵiy" xml:lang="hbo">בְכִ֤י</char> <char style="w" x-id="WLC.ISA.16.9.006" x-align="ISA.16.9.a005" x-target-ids="t008 t009" x-target="of Jazer" x-target-head="t009" x-head="true" lemma="יַעְזֵר" strong="H3270" x-morph="Np" x-gloss="of.Jazer" x-translit="yaʿzēr" xml:lang="hbo">יַעְזֵר֙</char> <char style="w" x-id="WLC.ISA.16.9.007" x-align="ISA.16.9.a006" x-target-ids="t011 t012" x-target="the vine" x-target-head="t012" x-head="true" lemma="גֶּפֶן" strong="H1612" x-morph="Ncbsc" x-gloss="the.vine[s]" x-translit="gep̄en" xml:lang="hbo">גֶּ֣פֶן</char> <char style="w" x-id="WLC.ISA.16.9.008" x-align="ISA.16.9.a007" x-target-ids="t013 t014" x-target="of Sibmah" x-target-head="t014" x-head="true" lemma="שִׂבְמָה" strong="H7643" x-morph="Np" x-gloss="of.Sibmah" x-translit="śiḇmāh" xml:lang