	<para style="p"><verse number="1" style="v" x-ref="ISA.66.1" sid="ISA 66:1" /><char style="w" x-id="WLC.ISA.66.1.001" x-align="ISA.66.1.a001" x-target-ids="t001" x-target="Thus" x-target-head="t001" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="kōh" xml:lang="hbo">כֹּ֚ה</char> <char style="w" x-id="WLC.ISA.66.1.002" x-align="ISA.66.1.a002" x-target-ids="t002" x-target="saith" x-target-head="t002" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.ISA.66.1.003" x-align="ISA.66.1.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֔ה</char> <char style="w" x-id="WLC.ISA.66.1.004" x-align="ISA.66.1.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.66.1.005" x-align="ISA.66.1.a005" x-target-ids="t004" x-target="Heaven" x-target-head="t004" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heavens" x-translit="ššāmayim" xml:lang="hbo">שָּׁמַ֣יִם</char> <char style="w" x-id="WLC.ISA.66.1.006" x-align="ISA.66.1.a006" x-target-ids="t005 t007" x-target="is throne" x-target-head="t007" x-head="true" lemma="כִּסֵּא" strong="H3678" x-morph="Ncmsc" x-gloss="throne" x-translit="kisʾ" xml:lang="hbo">כִּסְאִ֔</char><char style="w" x-id="WLC.ISA.66.1.007" x-align="ISA.66.1.a007" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[are].my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.66.1.008" x-align="ISA.66.1.a008" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x