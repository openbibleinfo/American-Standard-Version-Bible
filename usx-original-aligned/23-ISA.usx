	<para style="p"><verse number="12" style="v" x-ref="ISA.3.12" x-added-alignments="ISA.3.12.a001 ISA.3.12.a017" x-added-target-ids="t001 t002 t022" x-added-target="As for | thee" sid="ISA 3:12" /><char style="w" x-id="WLC.ISA.3.12.001" x-align="ISA.3.12.a002" x-target-ids="t004" x-target="people" x-target-head="t004" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo">עַמִּ</char><char style="w" x-id="WLC.ISA.3.12.002" x-align="ISA.3.12.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.ISA.3.12.003" x-align="ISA.3.12.a004" x-target-ids="t006 t008" x-target="are oppressors" x-target-head="t008" x-head="true" lemma="נָגַשׂ" strong="H5065" x-morph="Vqrmpc" x-gloss="oppressors" x-translit="nōḡəśāy" xml:lang="hbo">נֹגְשָׂ֣י</char><char style="w" x-id="WLC.ISA.3.12.004" x-align="ISA.3.12.a005" x-target-ids="t007" x-target="their" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.ISA.3.12.005" x-align="ISA.3.12.a006" x-target-ids="t005" x-target="children" x-target-head="t005" x-head="true" lemma="עָלַל" strong="H5953b" x-morph="Vmrmsa" x-gloss="[is].acting.like.children" x-translit="məʿôlēl" xml:lang="hbo">מְעוֹלֵ֔ל</char> <char style="w" x-id="WLC.ISA.3.12.006" x-align="ISA.3.12.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.3.12.007" x-align="ISA.3.12.a008" x-target-ids="t010" x-target="women" x-target-head="t010" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfpa" x-gloss="women" x-translit="nāšiym" xml:lang="hbo">נָשִׁ֖ים</char> <char style="w" x-id="WLC.ISA.3.12.008" x-align="ISA.3.12.a009" x-target-id