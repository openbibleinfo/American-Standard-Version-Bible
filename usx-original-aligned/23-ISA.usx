	<para style="p"><verse number="10" style="v" x-ref="ISA.40.10" sid="ISA 40:10" /><char style="w" x-id="WLC.ISA.40.10.001" x-align="ISA.40.10.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֨ה</char> <char style="w" x-id="WLC.ISA.40.10.002" x-align="ISA.40.10.a002" x-target-ids="t002 t003" x-target="the Lord" x-target-head="t003" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֤</char><char style="w" x-id="WLC.ISA.40.10.003" x-align="ISA.40.10.a003" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.40.10.004" x-align="ISA.40.10.a004" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יְהֹוִה" strong="H3069" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוִה֙</char> <char style="w" x-id="WLC.ISA.40.10.005" x-align="ISA.40.10.a005" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in).a" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ISA.40.10.006" x-align="ISA.40.10.a006" x-target-ids="t008 t009 t010" x-target="a mighty one" x-target-head="t009" x-head="true" lemma="חָזָק" strong="H2389" x-morph="Aamsa" x-gloss="strong.[one]" x-translit="ḥāzāq" xml:lang="hbo">חָזָ֣ק</char> <char style="w" x-id="WLC.ISA.40.10.007" x-align="ISA.40.10.a007" x-target-ids="t005 t006" x-target="will come" x-target-head="t006" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3ms" x-gloss="he.will.come" x-translit="yāḇôʾ" xml:lang="hbo">יָב֔וֹא</char> <char style="w" x-id="WLC.ISA.40.10.008" x-align="ISA.40.10.a008" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-tr