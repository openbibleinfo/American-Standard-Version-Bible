	<para style="p"><verse number="20" style="v" x-ref="ISA.43.20" x-added-alignments="ISA.43.20.a015" x-added-target-ids="t021" x-added-target="and" sid="ISA 43:20" /><char style="w" x-id="WLC.ISA.43.20.001" x-align="ISA.43.20.a001" x-target-ids="t006 t007" x-target="shall honor" x-target-head="t007" x-head="true" lemma="כָּבֵד" strong="H3513" x-morph="Vpi3fs" x-gloss="it" x-translit="təḵabbəḏ" xml:lang="hbo">תְּכַבְּדֵ֨</char><char style="w" x-id="WLC.ISA.43.20.002" x-align="ISA.43.20.a002" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="honors.me" x-translit="ēniy" xml:lang="hbo">נִי֙</char> <char style="w" x-id="WLC.ISA.43.20.003" x-align="ISA.43.20.a003" x-target-ids="t001 t002" x-target="The beasts" x-target-head="t002" x-head="true" lemma="חַיָּה" strong="H2416c" x-morph="Ncfsc" x-gloss="the.animal[s]" x-translit="ḥayyaṯ" xml:lang="hbo">חַיַּ֣ת</char> <char style="w" x-id="WLC.ISA.43.20.004" x-align="ISA.43.20.a004" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ISA.43.20.005" x-align="ISA.43.20.a005" x-target-ids="t003 t005" x-target="of field" x-target-head="t005" x-head="true" lemma="שָׂדֶה" strong="H7704" x-morph="Ncmsa" x-gloss="the.field" x-translit="śśāḏeh" xml:lang="hbo">שָּׂדֶ֔ה</char> <char style="w" x-id="WLC.ISA.43.20.006" x-align="ISA.43.20.a006" x-target-ids="t009 t010" x-target="the jackals" x-target-head="t010" x-head="true" lemma="תַּן" strong="H8565" x-morph="Ncmpa" x-gloss="jackals" x-translit="tanniym" xml:lang="hbo">תַּנִּ֖ים</char> <char style="w" x-id="WLC.ISA.43.20.007" x-align="ISA.43.20.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.ISA.43.20.008" x-align="ISA.43.20.a008" x-statu