	<para style="p"><verse number="8" style="v" x-ref="ISA.16.8" x-added-alignments="ISA.16.8.a005 ISA.16.8.a015 ISA.16.8.a017" x-added-target-ids="t007 t024 t029" x-added-target="and | which | which" sid="ISA 16:8" /><char style="w" x-id="WLC.ISA.16.8.001" x-align="ISA.16.8.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.ISA.16.8.002" x-align="ISA.16.8.a002" x-target-ids="t002 t003" x-target="the fields" x-target-head="t003" x-head="true" lemma="שְׁדֵמָה" strong="H7709" x-morph="Ncfpc" x-gloss="the.terraced.fields" x-translit="šaḏmôṯ" xml:lang="hbo">שַׁדְמוֹת֩</char> <char style="w" x-id="WLC.ISA.16.8.003" x-align="ISA.16.8.a003" x-target-ids="t004 t005" x-target="of Heshbon" x-target-head="t005" x-head="true" lemma="חֶשְׁבּוֹן" strong="H2809" x-morph="Np" x-gloss="of.Heshbon" x-translit="ḥešbôn" xml:lang="hbo">חֶשְׁבּ֨וֹן</char> <char style="w" x-id="WLC.ISA.16.8.004" x-align="ISA.16.8.a004" x-target-ids="t006" x-target="languish" x-target-head="t006" x-head="true" lemma="אָמַל" strong="H535" x-morph="VKp3ms" x-gloss="it.has.languished" x-translit="ʾumlāl" xml:lang="hbo">אֻמְלָ֜ל</char> <char style="w" x-id="WLC.ISA.16.8.005" x-align="ISA.16.8.a006" x-target-ids="t008 t009" x-target="the vine" x-target-head="t009" x-head="true" lemma="גֶּפֶן" strong="H1612" x-morph="Ncbsc" x-gloss="the.vine[s]" x-translit="gep̄en" xml:lang="hbo">גֶּ֣פֶן</char> <char style="w" x-id="WLC.ISA.16.8.006" x-align="ISA.16.8.a007" x-target-ids="t010 t011" x-target="of Sibmah" x-target-head="t011" x-head="true" lemma="שִׂבְמָה" strong="H7643" x-morph="Np" x-gloss="of.Sibmah" x-translit="śiḇmāh" xml:lang="hbo">שִׂבְמָ֗ה</char> <char style="w" x-id="WLC.ISA.16.8.007" x-align="ISA.16.8.a008" x-target-ids="t012 t013" x-target="the lords" x-target-head="t013" x-head="true" lemma="בַּעַל" strong="H1167" x-morph="Ncmpc" x-gloss="rulers" x-translit=