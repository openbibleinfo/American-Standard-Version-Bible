	<para style="p"><verse number="4" style="v" x-ref="ISA.57.4" x-added-alignments="ISA.57.4.a008" x-added-target-ids="t014" x-added-target="and" sid="ISA 57:4" /><char style="w" x-id="WLC.ISA.57.4.001" x-align="ISA.57.4.a001" x-target-ids="t001" x-target="Against" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.57.4.002" x-align="ISA.57.4.a002" x-target-ids="t002" x-target="whom" x-target-head="t002" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="whom?" x-translit="mî" xml:lang="hbo">מִי֙</char> <char style="w" x-id="WLC.ISA.57.4.003" x-align="ISA.57.4.a003" x-target-ids="t003 t004 t005 t006" x-target="do ye sport yourselves" x-target-head="t005" x-head="true" lemma="עָנֹג" strong="H6026" x-morph="Vti2mp" x-gloss="are.you.making.fun" x-translit="tiṯʿannāḡû" xml:lang="hbo">תִּתְעַנָּ֔גוּ</char> <char style="w" x-id="WLC.ISA.57.4.004" x-align="ISA.57.4.a004" x-target-ids="t007" x-target="against" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ISA.57.4.005" x-align="ISA.57.4.a005" x-target-ids="t008" x-target="whom" x-target-head="t008" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="whom?" x-translit="miy" xml:lang="hbo">מִ֛י</char> <char style="w" x-id="WLC.ISA.57.4.006" x-align="ISA.57.4.a006" x-target-ids="t009 t010 t012" x-target="make ye wide" x-target-head="t012" x-head="true" lemma="רָחַב" strong="H7337" x-morph="Vhi2mp" x-gloss="do.you.make.wide" x-translit="tarḥiyḇû" xml:lang="hbo">תַּרְחִ֥יבוּ</char> <char style="w" x-id="WLC.ISA.57.4.007" x-align="ISA.57.4.a007" x-target-ids="t011 t013" x-target="a mouth" x-target-head="t013" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsa" x-gloss="a.mouth" x-translit="p̄eh" xml:lang="hbo">פֶ֖ה</char> <char style="w" x-id="WLC.ISA.57.4.008" x-align="ISA.57.4.a009" x