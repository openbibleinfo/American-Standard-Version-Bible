	<para style="p"><verse number="7" style="v" x-ref="ISA.16.7" sid="ISA 16:7" /><char style="w" x-id="WLC.ISA.16.7.001" x-align="ISA.16.7.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.ISA.16.7.002" x-align="ISA.16.7.a001" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֗ן</char> <char style="w" x-id="WLC.ISA.16.7.003" x-align="ISA.16.7.a002" x-target-ids="t002 t004" x-target="shall wail" x-target-head="t004" x-head="true" lemma="יָלַל" strong="H3213" x-morph="Vhi3ms" x-gloss="it.will.wail" x-translit="yəyēliyl" xml:lang="hbo">יְיֵלִ֥יל</char> <char style="w" x-id="WLC.ISA.16.7.004" x-align="ISA.16.7.a003" x-target-ids="t003" x-target="Moab" x-target-head="t003" x-head="true" lemma="מוֹאָב" strong="H4124" x-morph="Np" x-gloss="Moab" x-translit="môʾāḇ" xml:lang="hbo">מוֹאָ֛ב</char> <char style="w" x-id="WLC.ISA.16.7.005" x-align="ISA.16.7.a004" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.ISA.16.7.006" x-align="ISA.16.7.a005" x-target-ids="t006" x-target="Moab" x-target-head="t006" x-head="true" lemma="מוֹאָב" strong="H4124" x-morph="Np" x-gloss="Moab" x-translit="môʾāḇ" xml:lang="hbo">מוֹאָ֖ב</char> <char style="w" x-id="WLC.ISA.16.7.007" x-align="ISA.16.7.a006" x-target-ids="t007" x-target="every" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.it" x-translit="kull" xml:lang="hbo">כֻּלֹּ֣</char><char style="w" x-id="WLC.ISA.16.7.008" x-align="ISA.16.7.a007" x-target-ids="t008" x-target="one" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="all" x-translit="ōh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.ISA.16.7.009" x-align="ISA.16.7.a008" x-target-id