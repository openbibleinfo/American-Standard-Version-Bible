	<para style="p"><verse number="22" style="v" x-ref="ISA.43.22" sid="ISA 43:22" /><char style="w" x-id="WLC.ISA.43.22.001" x-align="ISA.43.22.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.22.002" x-align="ISA.43.22.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.ISA.43.22.003" x-align="ISA.43.22.a003" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾōṯ" xml:lang="hbo">אֹתִ֥</char><char style="w" x-id="WLC.ISA.43.22.004" x-align="ISA.43.22.a004" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.ISA.43.22.005" x-align="ISA.43.22.a005" x-target-ids="t002 t003 t005" x-target="thou hast called" x-target-head="t005" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqp2ms" x-gloss="you.have.called.on" x-translit="qārāʾṯā" xml:lang="hbo">קָרָ֖אתָ</char> <char style="w" x-id="WLC.ISA.43.22.006" x-align="ISA.43.22.a006" x-target-ids="t008 t009" x-target="O Jacob" x-target-head="t009" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="O.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַֽעֲקֹ֑ב</char> <char style="w" x-id="WLC.ISA.43.22.007" x-align="ISA.43.22.a007" x-target-ids="t010" x-target="but" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.ISA.43.22.008" x-align="ISA.43.22.a008" x-target-ids="t011 t012 t013 t014" x-target="thou hast been weary" x-target-head="t014" x-head="true" lemma="יָגֵעַ" strong="H3021" x-morph="Vqp2ms" x-gl