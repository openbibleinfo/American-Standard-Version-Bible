	<para style="p"><verse number="18" style="v" x-ref="ISA.43.18" sid="ISA 43:18" /><char style="w" x-id="WLC.ISA.43.18.001" x-align="ISA.43.18.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.ISA.43.18.002" x-align="ISA.43.18.a002" x-target-ids="t001 t002" x-target="Remember ye" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqj2mp" x-gloss="remember" x-translit="tizkərû" xml:lang="hbo">תִּזְכְּר֖וּ</char> <char style="w" x-id="WLC.ISA.43.18.003" x-align="ISA.43.18.a003" x-target-ids="t004 t005 t006" x-target="the former things" x-target-head="t005" x-head="true" lemma="רִאשׁוֹן" strong="H7223" x-morph="Aafpa" x-gloss="former.[things]" x-translit="riʾšōnôṯ" xml:lang="hbo">רִֽאשֹׁנ֑וֹת</char> <char style="w" x-id="WLC.ISA.43.18.004" x-align="ISA.43.18.a004" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.43.18.005" x-align="ISA.43.18.a005" x-target-ids="t009 t010 t011 t012" x-target="the things of old" x-target-head="t012" x-head="true" lemma="קַדְמֹנִי" strong="H6931" x-morph="Aafpa" x-gloss="ancient.[things]" x-translit="qaḏmōniyyôṯ" xml:lang="hbo">קַדְמֹנִיּ֖וֹת</char> <char style="w" x-id="WLC.ISA.43.18.006" x-align="ISA.43.18.a004" x-target-ids="t007" x-target="neither" x-target-head="t007" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.ISA.43.18.007" x-align="ISA.43.18.a006" x-target-ids="t008" x-target="consider" x-target-head="t008" x-head="true" lemma="בִּין" strong="H995" x-morph="Vrj2mp" x-gloss="consider" x-translit="tiṯbōnānû:" xml:lang="hbo">תִּתְבֹּנָֽנוּ</char>׃<verse eid="ISA 43:18" /></para>
