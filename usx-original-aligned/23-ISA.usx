	<para style="p"><verse number="11" style="v" x-ref="ISA.32.11" x-added-alignments="ISA.32.11.a012 ISA.32.11.a013" x-added-target-ids="t021 t023" x-added-target="sackcloth | your" sid="ISA 32:11" /><char style="w" x-id="WLC.ISA.32.11.001" x-align="ISA.32.11.a001" x-target-ids="t001" x-target="Tremble" x-target-head="t001" x-head="true" lemma="חָרַד" strong="H2729" x-morph="Vqv2mp" x-gloss="tremble" x-translit="ḥirḏû" xml:lang="hbo">חִרְדוּ֙</char> <char style="w" x-id="WLC.ISA.32.11.002" x-align="ISA.32.11.a002" x-target-ids="t002 t003 t004 t005 t006 t007" x-target="ye women that are at ease" x-target-head="t007" x-head="true" lemma="שַׁאֲנָן" strong="H7600" x-morph="Aafpa" x-gloss="O.carefree.[women]" x-translit="šaʾănannôṯ" xml:lang="hbo">שַֽׁאֲנַנּ֔וֹת</char> <char style="w" x-id="WLC.ISA.32.11.003" x-align="ISA.32.11.a003" x-target-ids="t008 t009" x-target="be troubled" x-target-head="t009" x-head="true" lemma="רָגַז" strong="H7264" x-morph="Vqv2fp" x-gloss="be.agitated" x-translit="rəḡāzâ" xml:lang="hbo">רְגָ֖זָה</char> <char style="w" x-id="WLC.ISA.32.11.004" x-align="ISA.32.11.a004" x-target-ids="t010 t011 t012" x-target="ye careless ones" x-target-head="t011" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqrfpa" x-gloss="O.confident.[women]" x-translit="bōṭəḥôṯ" xml:lang="hbo">בֹּֽטְח֑וֹת</char> <char style="w" x-id="WLC.ISA.32.11.005" x-align="ISA.32.11.a005" x-target-ids="t013 t014" x-target="strip you" x-target-head="t013" x-head="true" lemma="פָּשַׁט" strong="H6584" x-morph="Vqv2fp" x-gloss="strip.off" x-translit="pəšōṭāh" xml:lang="hbo">פְּשֹׁ֣טָֽה</char> <char style="w" x-id="WLC.ISA.32.11.006" x-align="ISA.32.11.a006" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.32.11.007" x-align="ISA.32.11.a007" x-target-ids="t016 t017 t018" x-target="make you bare" x-target-head="t018" x-head="true" lemma="עָרַר" 