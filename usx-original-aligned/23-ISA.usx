	<para style="p"><verse number="2" style="v" x-ref="ISA.54.2" sid="ISA 54:2" /><char style="w" x-id="WLC.ISA.54.2.001" x-align="ISA.54.2.a001" x-target-ids="t001" x-target="Enlarge" x-target-head="t001" x-head="true" lemma="רָחַב" strong="H7337" x-morph="Vhv2fs" x-gloss="enlarge" x-translit="harḥiyḇî" xml:lang="hbo">הַרְחִ֣יבִי</char>׀<char style="w" x-id="WLC.ISA.54.2.002" x-align="ISA.54.2.a002" x-target-ids="t002 t003" x-target="the place" x-target-head="t003" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsc" x-gloss="the.place" x-translit="məqôm" xml:lang="hbo">מְק֣וֹם</char> <char style="w" x-id="WLC.ISA.54.2.003" x-align="ISA.54.2.a003" x-target-ids="t004 t006" x-target="of tent" x-target-head="t006" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmsc" x-gloss="your.tent" x-translit="ʾāhŏl" xml:lang="hbo">אָהֳלֵ֗</char><char style="w" x-id="WLC.ISA.54.2.004" x-align="ISA.54.2.a004" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="ēḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.ISA.54.2.005" x-align="ISA.54.2.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִ</char><char style="w" x-id="WLC.ISA.54.2.006" x-align="ISA.54.2.a006" x-target-ids="t012 t013" x-target="the curtains" x-target-head="t013" x-head="true" lemma="יְרִיעָה" strong="H3407" x-morph="Ncfpc" x-gloss="the.tent.curtains" x-translit="yrîʿôṯ" xml:lang="hbo">ירִיע֧וֹת</char> <char style="w" x-id="WLC.ISA.54.2.007" x-align="ISA.54.2.a007" x-target-ids="t014 t016" x-target="of habitations" x-target-head="t016" x-head="true" lemma="מִשְׁכָּן" strong="H4908" x-morph="Ncmpc" x-gloss="your.dwellings" x-translit="miškənôṯay" xml:lang="hbo">מִשְׁכְּנוֹתַ֛יִ</char><char style="w" x-id="WLC.ISA.54.2.008" x-align="ISA.54.2.a008" x-target-ids="t015" x-target="thy" x-target-head="t015" x-he