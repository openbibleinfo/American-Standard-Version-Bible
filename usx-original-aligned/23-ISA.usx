	<para style="p"><verse number="10" style="v" x-ref="ISA.48.10" sid="ISA 48:10" /><char style="w" x-id="WLC.ISA.48.10.001" x-align="ISA.48.10.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֥ה</char> <char style="w" x-id="WLC.ISA.48.10.002" x-align="ISA.48.10.a002" x-target-ids="t002 t003 t004" x-target="I have refined" x-target-head="t004" x-head="true" lemma="צָרַף" strong="H6884" x-morph="Vqp1cs" x-gloss="I" x-translit="ṣərap̄tiy" xml:lang="hbo">צְרַפְתִּ֖י</char><char style="w" x-id="WLC.ISA.48.10.003" x-align="ISA.48.10.a003" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="have.refined.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ISA.48.10.004" x-align="ISA.48.10.a004" x-target-ids="t006" x-target="but" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ISA.48.10.005" x-align="ISA.48.10.a005" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.ISA.48.10.006" x-align="ISA.48.10.a006" x-target-ids="t008" x-target="as" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in)" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.ISA.48.10.007" x-align="ISA.48.10.a007" x-target-ids="t009" x-target="silver" x-target-head="t009" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="silver" x-translit="ḵāsep̄" xml:lang="hbo">כָ֑סֶף</char> <char style="w" x-id="WLC.ISA.48.10.008" x-align="ISA.48.10.a008" x-target-ids="t010 t011 t012" x-target="I have chosen" x-target-head="t012" x-head="true" lemma="בָּחַר" strong="H977" x-morph="Vqp1cs" x-gl