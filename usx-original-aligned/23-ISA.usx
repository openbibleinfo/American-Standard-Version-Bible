	<para style="p"><verse number="14" style="v" x-ref="ISA.42.14" x-added-alignments="ISA.42.14.a004 ISA.42.14.a006 ISA.42.14.a015" x-added-target-ids="t012 t015 t006" x-added-target="and | now | my" sid="ISA 42:14" /><char style="w" x-id="WLC.ISA.42.14.001" x-align="ISA.42.14.a001" x-target-ids="t001 t002 t005 t007" x-target="I have holden peace" x-target-head="t007" x-head="true" lemma="חָשָׁה" strong="H2814" x-morph="Vhp1cs" x-gloss="I.have.been.silent" x-translit="heḥĕšēyṯî" xml:lang="hbo">הֶחֱשֵׁ֨יתִי֙</char> <char style="w" x-id="WLC.ISA.42.14.002" x-align="ISA.42.14.a002" x-status="noncompositional" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.ISA.42.14.003" x-align="ISA.42.14.a002" x-status="noncompositional" x-target-ids="t003 t004" x-target="long time" x-target-head="t004" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="a.long.time" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֔ם</char> <char style="w" x-id="WLC.ISA.42.14.004" x-align="ISA.42.14.a003" x-target-ids="t008 t009 t010 t011" x-target="I have been still" x-target-head="t011" x-head="true" lemma="חָרֵשׁ" strong="H2790a" x-morph="Vhi1cs" x-gloss="I.have.kept.silent" x-translit="ʾaḥăriyš" xml:lang="hbo">אַחֲרִ֖ישׁ</char> <char style="w" x-id="WLC.ISA.42.14.005" x-align="ISA.42.14.a005" x-target-ids="t013 t014" x-target="refrained myself" x-target-head="t013" x-head="true" lemma="אָפַק" strong="H662" x-morph="Vti1cs" x-gloss="I.have.restrained.myself" x-translit="ʾeṯʾappāq" xml:lang="hbo">אֶתְאַפָּ֑ק</char> <char style="w" x-id="WLC.ISA.42.14.006" x-align="ISA.42.14.a007" x-target-ids="t020" x-target="like" x-target-head="t020" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like.(the)" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.ISA.42.14.007" x-align="ISA.42.14.a008" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[woman" x-translit=