	<para style="p"><verse number="7" style="v" x-ref="1SA.2.7" sid="1SA 2:7" /><char style="w" x-id="WLC.1SA.2.7.001" x-align="1SA.2.7.a001" x-target-ids="t001 t007 t010" x-target="Jehovah He he" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.1SA.2.7.002" x-align="1SA.2.7.a002" x-target-ids="t002 t003" x-target="maketh poor" x-target-head="t003" x-head="true" lemma="יָרַשׁ" strong="H3423" x-morph="Vhrmsa" x-gloss="[is].making.poor" x-translit="môriyš" xml:lang="hbo">מוֹרִ֣ישׁ</char> <char style="w" x-id="WLC.1SA.2.7.003" x-align="1SA.2.7.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.1SA.2.7.004" x-align="1SA.2.7.a004" x-target-ids="t005 t006" x-target="maketh rich" x-target-head="t006" x-head="true" lemma="עָשַׁר" strong="H6238" x-morph="Vhrmsa" x-gloss="[he.is].making.rich" x-translit="maʿăšiyr" xml:lang="hbo">מַעֲשִׁ֑יר</char> <char style="w" x-id="WLC.1SA.2.7.005" x-align="1SA.2.7.a005" x-target-ids="t008 t009" x-target="bringeth low" x-target-head="t009" x-head="true" lemma="שָׁפֵל" strong="H8213" x-morph="Vhrmsa" x-gloss="[he.is].bringing.low" x-translit="mašpiyl" xml:lang="hbo">מַשְׁפִּ֖יל</char> <char style="w" x-id="WLC.1SA.2.7.006" x-align="1SA.2.7.a006" x-target-ids="t011" x-target="also" x-target-head="t011" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo">אַף</char>־<char style="w" x-id="WLC.1SA.2.7.007" x-align="1SA.2.7.a007" x-target-ids="t012 t013" x-target="lifteth up" x-target-head="t012" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vormsa" x-gloss="[he.is].exalting" x-translit="mərômēm:" xml:lang="hbo">מְרוֹמֵֽם</char>׃<verse eid="1SA 2:7" /></para>
