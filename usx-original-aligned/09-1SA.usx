	<para style="p"><verse number="23" style="v" x-ref="1SA.23.23" sid="1SA 23:23" /><char style="w" x-id="WLC.1SA.23.23.001" x-align="1SA.23.23.a001" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.1SA.23.23.002" x-align="1SA.23.23.a002" x-target-ids="t001" x-target="See" x-target-head="t001" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqv2mp" x-gloss="see" x-translit="rəʾû" xml:lang="hbo">רְא֣וּ</char> <char style="w" x-id="WLC.1SA.23.23.003" x-align="1SA.23.23.a003" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.1SA.23.23.004" x-align="1SA.23.23.a004" x-target-ids="t004 t005" x-target="take knowledge" x-target-head="t005" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqv2mp" x-gloss="know" x-translit="ḏəʿû" xml:lang="hbo">דְע֗וּ</char> <char style="w" x-id="WLC.1SA.23.23.005" x-align="1SA.23.23.a005" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.1SA.23.23.006" x-align="1SA.23.23.a006" x-target-ids="t007" x-target="all" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kōl" xml:lang="hbo">כֹּ֤ל</char> <char style="w" x-id="WLC.1SA.23.23.007" x-align="1SA.23.23.a007" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.hiding" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.1SA.23.23.008" x-align="1SA.23.23.a008" x-target-ids="t009 t010" x-target="lurking places" x-target-head="t009" x-head="true" lemma="מַחֲבֹאִים" strong="H4224a" x-morph="Ncmpa" x-gloss="places" x-translit="mmaḥăḇōʾîm" xml: