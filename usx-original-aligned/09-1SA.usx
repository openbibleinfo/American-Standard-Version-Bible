	<para style="p"><verse number="21" style="v" x-ref="1SA.23.21" sid="1SA 23:21" /><char style="w" x-id="WLC.1SA.23.21.001" x-align="1SA.23.21.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.1SA.23.21.002" x-align="1SA.23.21.a002" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmer" xml:lang="hbo">יֹּ֣אמֶר</char> <char style="w" x-id="WLC.1SA.23.21.003" x-align="1SA.23.21.a003" x-target-ids="t002" x-target="Saul" x-target-head="t002" x-head="true" lemma="שָׁאוּל" strong="H7586" x-morph="Np" x-gloss="Saul" x-translit="šāʾûl" xml:lang="hbo">שָׁא֔וּל</char> <char style="w" x-id="WLC.1SA.23.21.004" x-align="1SA.23.21.a004" x-target-ids="t004 t005" x-target="Blessed be" x-target-head="t004" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vqsmpa" x-gloss="[be].blessed" x-translit="bərûḵiym" xml:lang="hbo">בְּרוּכִ֥ים</char> <char style="w" x-id="WLC.1SA.23.21.005" x-align="1SA.23.21.a005" x-target-ids="t006" x-target="ye" x-target-head="t006" x-head="true" lemma="אַתֶּם" strong="H859a" x-morph="Pp2mp" x-gloss="you" x-translit="ʾattem" xml:lang="hbo">אַתֶּ֖ם</char> <char style="w" x-id="WLC.1SA.23.21.006" x-align="1SA.23.21.a006" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="by" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.1SA.23.21.007" x-align="1SA.23.21.a007" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֑ה</char> <char style="w" x-id="WLC.1SA.23.21.008" x-align="1SA.23.21.a008" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-tran