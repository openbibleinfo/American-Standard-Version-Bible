	<para style="p"><verse number="22" style="v" x-ref="1SA.23.22" x-added-alignments="1SA.23.22.a016 1SA.23.22.a025" x-added-target-ids="t019 t030" x-added-target="and | that" sid="1SA 23:22" /><char style="w" x-id="WLC.1SA.23.22.001" x-align="1SA.23.22.a001" x-target-ids="t001" x-target="Go" x-target-head="t001" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2mp" x-gloss="go" x-translit="ləḵû-" xml:lang="hbo">לְכוּ</char>־<char style="w" x-id="WLC.1SA.23.22.002" x-align="1SA.23.22.a002" x-target-ids="t002 t003 t004" x-target="I pray you" x-target-head="t003" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֞א</char> <char style="w" x-id="WLC.1SA.23.22.003" x-align="1SA.23.22.a003" x-target-ids="t005 t008" x-target="make sure" x-target-head="t008" x-head="true" lemma="כּוּן" strong="H3559" x-morph="Vhv2mp" x-gloss="prepare" x-translit="hāḵiynû" xml:lang="hbo">הָכִ֣ינוּ</char> <char style="w" x-id="WLC.1SA.23.22.004" x-align="1SA.23.22.a004" x-target-ids="t006 t007" x-target="yet more" x-target-head="t007" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="still" x-translit="ʿôḏ" xml:lang="hbo">ע֗וֹד</char> <char style="w" x-id="WLC.1SA.23.22.005" x-align="1SA.23.22.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.1SA.23.22.006" x-align="1SA.23.22.a006" x-target-ids="t010" x-target="know" x-target-head="t010" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqv2mp" x-gloss="know" x-translit="ḏəʿû" xml:lang="hbo">דְע֤וּ</char> <char style="w" x-id="WLC.1SA.23.22.007" x-align="1SA.23.22.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.1SA.23.22.008" x-align="1SA.23.22.a008" x-target-ids="t012" x-target="see" x-