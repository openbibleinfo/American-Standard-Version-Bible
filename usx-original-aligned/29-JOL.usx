	<para style="p"><verse number="26" style="v" x-ref="JOL.2.26" sid="JOL 2:26" /><char style="w" x-id="WLC.JOL.2.26.001" x-align="JOL.2.26.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOL.2.26.002" x-align="JOL.2.26.a002" x-target-ids="t002 t003 t004" x-target="ye shall eat" x-target-head="t004" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqq2mp" x-gloss="you.will.eat" x-translit="ʾăḵaltem" xml:lang="hbo">אֲכַלְתֶּ֤ם</char> <char style="w" x-id="WLC.JOL.2.26.003" x-align="JOL.2.26.a003" x-target-ids="t005 t006" x-target="in plenty" x-target-head="t006" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqa" x-gloss="eating" x-translit="ʾāḵôl" xml:lang="hbo">אָכוֹל֙</char> <char style="w" x-id="WLC.JOL.2.26.004" x-align="JOL.2.26.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOL.2.26.005" x-align="JOL.2.26.a005" x-target-ids="t008 t009" x-target="be satisfied" x-target-head="t009" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqa" x-gloss="being.satisfied" x-translit="śāḇôᵃʿ" xml:lang="hbo">שָׂב֔וֹעַ</char> <char style="w" x-id="WLC.JOL.2.26.006" x-align="JOL.2.26.a006" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOL.2.26.007" x-align="JOL.2.26.a007" x-target-ids="t011 t012" x-target="shall praise" x-target-head="t012" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpq2mp" x-gloss="you.will.praise" x-translit="hillaltem" xml:lang="hbo">הִלַּלְתֶּ֗ם</char> <char style="w" x-id="WLC.JOL.2.26.008" x-align="JOL.2.26.a008" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-