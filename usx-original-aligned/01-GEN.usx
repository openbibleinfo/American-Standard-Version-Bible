	<para style="p"><verse number="2" style="v" x-ref="GEN.49.2" sid="GEN 49:2" /><char style="w" x-id="WLC.GEN.49.2.001" x-align="GEN.49.2.a001" x-target-ids="t001 t002" x-target="Assemble yourselves" x-target-head="t001" x-head="true" lemma="קָבַץ" strong="H6908" x-morph="VNv2mp" x-gloss="assemble" x-translit="hiqqāḇəṣû" xml:lang="hbo">הִקָּבְצ֥וּ</char> <char style="w" x-id="WLC.GEN.49.2.002" x-align="GEN.49.2.a002" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.GEN.49.2.003" x-align="GEN.49.2.a003" x-target-ids="t004 t005" x-target="hear ye" x-target-head="t004" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="listen" x-translit="šimʿû" xml:lang="hbo">שִׁמְע֖וּ</char> <char style="w" x-id="WLC.GEN.49.2.004" x-align="GEN.49.2.a004" x-target-ids="t006" x-target="sons" x-target-head="t006" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="O.sons" x-translit="bənēy" xml:lang="hbo">בְּנֵ֣י</char> <char style="w" x-id="WLC.GEN.49.2.005" x-align="GEN.49.2.a005" x-target-ids="t007 t008" x-target="of Jacob" x-target-head="t008" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="of.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֑ב</char> <char style="w" x-id="WLC.GEN.49.2.006" x-align="GEN.49.2.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.GEN.49.2.007" x-align="GEN.49.2.a007" x-target-ids="t010" x-target="hearken" x-target-head="t010" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="listen" x-translit="šimʿû" xml:lang="hbo">שִׁמְע֖וּ</char> <char style="w" x-id="WLC.GEN.49.2.008" x-align="GEN.49.2.a008" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-