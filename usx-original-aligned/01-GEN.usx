	<para style="p"><verse number="43" style="v" x-ref="GEN.24.43" sid="GEN 24:43" /><char style="w" x-id="WLC.GEN.24.43.001" x-align="GEN.24.43.a001" x-target-ids="t001" x-target="behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֛ה</char> <char style="w" x-id="WLC.GEN.24.43.002" x-align="GEN.24.43.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָנֹכִ֥י</char> <char style="w" x-id="WLC.GEN.24.43.003" x-align="GEN.24.43.a003" x-target-ids="t003 t004" x-target="am standing" x-target-head="t004" x-head="true" lemma="נָצַב" strong="H5324" x-morph="VNrmsa" x-gloss="[am].standing" x-translit="niṣṣāḇ" xml:lang="hbo">נִצָּ֖ב</char> <char style="w" x-id="WLC.GEN.24.43.004" x-align="GEN.24.43.a004" x-target-ids="t005" x-target="by" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="at" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.GEN.24.43.005" x-align="GEN.24.43.a005" x-target-ids="t007" x-target="fountain" x-target-head="t007" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbsc" x-gloss="the.spring" x-translit="ʿēyn" xml:lang="hbo">עֵ֣ין</char> <char style="w" x-id="WLC.GEN.24.43.006" x-align="GEN.24.43.a006" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.GEN.24.43.007" x-align="GEN.24.43.a007" x-target-ids="t008 t009" x-target="of water" x-target-head="t009" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="the.water" x-translit="mmāyim" xml:lang="hbo">מָּ֑יִם</char> <char style="w" x-id="WLC.GEN.24.43.008" x-align="GEN.24.43.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss=