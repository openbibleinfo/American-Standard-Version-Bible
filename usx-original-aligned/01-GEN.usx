	<para style="p"><verse number="13" style="v" x-ref="GEN.4.13" sid="GEN 4:13" /><char style="w" x-id="WLC.GEN.4.13.001" x-align="GEN.4.13.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.GEN.4.13.002" x-align="GEN.4.13.a002" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmer" xml:lang="hbo">יֹּ֥אמֶר</char> <char style="w" x-id="WLC.GEN.4.13.003" x-align="GEN.4.13.a003" x-target-ids="t002" x-target="Cain" x-target-head="t002" x-head="true" lemma="קַיִן" strong="H7014" x-morph="Np" x-gloss="Cain" x-translit="qayin" xml:lang="hbo">קַ֖יִן</char> <char style="w" x-id="WLC.GEN.4.13.004" x-align="GEN.4.13.a004" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.GEN.4.13.005" x-align="GEN.4.13.a005" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.GEN.4.13.006" x-align="GEN.4.13.a006" x-target-ids="t008 t009" x-target="is greater" x-target-head="t009" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="[is.too].great" x-translit="gāḏôl" xml:lang="hbo">גָּד֥וֹל</char> <char style="w" x-id="WLC.GEN.4.13.007" x-align="GEN.4.13.a007" x-target-ids="t007" x-target="punishment" x-target-head="t007" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsc" x-gloss="punishment" x-translit="ʿăôn" xml:lang="hbo">עֲוֺנִ֖</char><char style="w" x-id="WLC.GEN.4.13.008" x-align="GEN.4.13.a008" x-target-ids="t006" x-target="My" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy