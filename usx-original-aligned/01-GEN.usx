	<para style="p"><verse number="17" style="v" x-ref="GEN.22.17" sid="GEN 22:17" /><char style="w" x-id="WLC.GEN.22.17.001" x-align="GEN.22.17.a001" x-target-ids="t001" x-target="that" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.GEN.22.17.002" x-align="GEN.22.17.a002" x-target-ids="t002 t003" x-target="in blessing" x-target-head="t003" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpa" x-gloss="surely.(bless)" x-translit="ḇārēḵ" xml:lang="hbo">בָרֵ֣ךְ</char> <char style="w" x-id="WLC.GEN.22.17.003" x-align="GEN.22.17.a003" x-target-ids="t004 t005 t006" x-target="I will bless" x-target-head="t006" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpi1cs" x-gloss="I" x-translit="ʾăḇāreḵ" xml:lang="hbo">אֲבָרֶכְ</char><char style="w" x-id="WLC.GEN.22.17.004" x-align="GEN.22.17.a004" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.bless.you" x-translit="əḵā" xml:lang="hbo">ךָ֗</char> <char style="w" x-id="WLC.GEN.22.17.005" x-align="GEN.22.17.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.GEN.22.17.006" x-align="GEN.22.17.a006" x-target-ids="t009 t010" x-target="in multiplying" x-target-head="t010" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vha" x-gloss="greatly.(increase)" x-translit="harbāh" xml:lang="hbo">הַרְבָּ֨ה</char> <char style="w" x-id="WLC.GEN.22.17.007" x-align="GEN.22.17.a007" x-target-ids="t011 t012 t013" x-target="I will multiply" x-target-head="t013" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vhi1cs" x-gloss="I.will.increase" x-translit="ʾarbeh" xml:lang="hbo">אַרְבֶּ֤ה</char> <char style="w" x-id="WLC.GEN.22.17.008" x-align="GEN.22.17.a008" x-status="unrepresented" x-head="true"