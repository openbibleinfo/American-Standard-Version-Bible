	<para style="p"><verse number="23" style="v" x-ref="2KI.18.23" sid="2KI 18:23" /><char style="w" x-id="WLC.2KI.18.23.001" x-align="2KI.18.23.a001" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.2KI.18.23.002" x-align="2KI.18.23.a002" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="therefore" x-translit="ʿattāh" xml:lang="hbo">עַתָּה֙</char> <char style="w" x-id="WLC.2KI.18.23.003" x-align="2KI.18.23.a003" x-target-ids="t006 t007" x-target="give pledges" x-target-head="t007" x-head="true" lemma="עָרַב" strong="H6148" x-morph="Vtv2ms" x-gloss="make.a.wager" x-translit="hiṯʿāreḇ" xml:lang="hbo">הִתְעָ֣רֶב</char> <char style="w" x-id="WLC.2KI.18.23.004" x-align="2KI.18.23.a004" x-target-ids="t003 t004 t005" x-target="I pray thee" x-target-head="t004" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֔א</char> <char style="w" x-id="WLC.2KI.18.23.005" x-align="2KI.18.23.a005" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.2KI.18.23.006" x-align="2KI.18.23.a006" x-target-ids="t010" x-target="master" x-target-head="t010" x-head="true" lemma="אָדוֹן" strong="H113" x-morph="Ncmsc" x-gloss="master" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנִ֖</char><char style="w" x-id="WLC.2KI.18.23.007" x-align="2KI.18.23.a007" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.2KI.18.23.008" x-align="2KI.18.23.a008" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">א