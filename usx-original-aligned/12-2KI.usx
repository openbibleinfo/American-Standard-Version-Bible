	<para style="p"><verse number="9" style="v" x-ref="2KI.18.9" sid="2KI 18:9" /><char style="w" x-id="WLC.2KI.18.9.001" x-align="2KI.18.9.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.2KI.18.9.002" x-align="2KI.18.9.a002" x-target-ids="t002 t003 t004 t005 t026" x-target="it came to pass that" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw3ms" x-gloss="it.was" x-translit="yəhiy" xml:lang="hbo">יְהִ֞י</char> <char style="w" x-id="WLC.2KI.18.9.003" x-align="2KI.18.9.a003" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.2KI.18.9.004" x-align="2KI.18.9.a004" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.2KI.18.9.005" x-align="2KI.18.9.a005" x-target-ids="t009" x-target="year" x-target-head="t009" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncfsa" x-gloss="year" x-translit="ššānāh" xml:lang="hbo">שָּׁנָ֤ה</char> <char style="w" x-id="WLC.2KI.18.9.006" x-align="2KI.18.9.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="hā" xml:lang="hbo">הָֽ</char><char style="w" x-id="WLC.2KI.18.9.007" x-align="2KI.18.9.a007" x-target-ids="t008" x-target="fourth" x-target-head="t008" x-head="true" lemma="רְבִיעִי" strong="H7243" x-morph="Aofsa" x-gloss="fourth" x-translit="rəḇîʿîṯ" xml:lang="hbo">רְבִיעִית֙</char> <char style="w" x-id="WLC.2KI.18.9.008" x-align="2KI.18.9.a008" x-target-ids="t010" x-target="of" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="of" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="W