	<para style="p"><verse number="2" style="v" x-ref="HAB.1.2" sid="HAB 1:2" /><char style="w" x-id="WLC.HAB.1.2.001" x-align="HAB.1.2.a001" x-status="noncompositional" x-target-ids="t003 t004" x-target="how long" x-target-head="t004" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.HAB.1.2.002" x-align="HAB.1.2.a001" x-status="noncompositional" lemma="אָן" strong="H575" x-morph="D" x-gloss="when?" x-translit="ʾānâ" xml:lang="hbo">אָ֧נָה</char> <char style="w" x-id="WLC.HAB.1.2.003" x-align="HAB.1.2.a002" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֛ה</char> <char style="w" x-id="WLC.HAB.1.2.004" x-align="HAB.1.2.a003" x-target-ids="t005 t006 t007" x-target="shall I cry" x-target-head="t007" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpp1cs" x-gloss="have.I.cried.for.help" x-translit="šiwwaʿətî" xml:lang="hbo">שִׁוַּ֖עְתִּי</char> <char style="w" x-id="WLC.HAB.1.2.005" x-align="HAB.1.2.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.HAB.1.2.006" x-align="HAB.1.2.a005" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.HAB.1.2.007" x-align="HAB.1.2.a006" x-target-ids="t009 t010 t012" x-target="thou wilt hear" x-target-head="t012" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi2ms" x-gloss="you.will.hear" x-translit="ṯišmāʿ" xml:lang="hbo">תִשְׁמָ֑ע</char> <char style="w" x-id="WLC.HAB.1.2.008" x-align="HAB.1.2.a007" x-target-ids="t013 t014 t015" x-target="I cry out" x-target-head="t014" x-head="true" lemma="זָעַק" strong="H2199" x-morph="Vqi1c