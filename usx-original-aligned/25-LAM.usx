	<para style="p"><verse number="4" style="v" x-ref="LAM.4.4" x-added-alignments="LAM.4.4.a013 LAM.4.4.a016" x-added-target-ids="t021 t025" x-added-target="and | it" sid="LAM 4:4" /><char style="w" x-id="WLC.LAM.4.4.001" x-align="LAM.4.4.a001" x-target-ids="t007" x-target="cleaveth" x-target-head="t007" x-head="true" lemma="דָּבַק" strong="H1692" x-morph="Vqp3ms" x-gloss="it.has.cleaved" x-translit="dāḇaq" xml:lang="hbo">דָּבַ֨ק</char> <char style="w" x-id="WLC.LAM.4.4.002" x-align="LAM.4.4.a002" x-target-ids="t001 t002" x-target="The tongue" x-target-head="t002" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="[the].tongue" x-translit="ləšôn" xml:lang="hbo">לְשׁ֥וֹן</char> <char style="w" x-id="WLC.LAM.4.4.003" x-align="LAM.4.4.a003" x-target-ids="t003 t004 t005 t006" x-target="of the sucking child" x-target-head="t005" x-head="true" lemma="יָנַק" strong="H3126" x-morph="Vqrmsa" x-gloss="of.a.sucking.child" x-translit="yônēq" xml:lang="hbo">יוֹנֵ֛ק</char> <char style="w" x-id="WLC.LAM.4.4.004" x-align="LAM.4.4.a004" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LAM.4.4.005" x-align="LAM.4.4.a005" x-target-ids="t009 t010 t011 t013" x-target="the roof of mouth" x-target-head="t010" x-head="true" lemma="חֵךְ" strong="H2441" x-morph="Ncmsc" x-gloss="palate" x-translit="ḥk" xml:lang="hbo">חכּ֖</char><char style="w" x-id="WLC.LAM.4.4.006" x-align="LAM.4.4.a006" x-target-ids="t012" x-target="his" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="ô" xml:lang="hbo">וֹ</char><char style="w" x-id="WLC.LAM.4.4.007" x-align="LAM.4.4.a007" x-target-ids="t014" x-target="for" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="by" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.LAM.4.4.008" x-align="LAM.4.4.a008" x