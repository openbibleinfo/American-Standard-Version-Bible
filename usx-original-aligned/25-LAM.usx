	<para style="p"><verse number="13" style="v" x-ref="LAM.2.13" sid="LAM 2:13" /><char style="w" x-id="WLC.LAM.2.13.001" x-align="LAM.2.13.a001" x-target-ids="t001" x-target="What" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh-" xml:lang="hbo">מָֽה</char>־<char style="w" x-id="WLC.LAM.2.13.002" x-align="LAM.2.13.a002" x-target-ids="t002 t003 t004 t005" x-target="shall I testify unto" x-target-head="t004" x-head="true" lemma="עוּד" strong="H5749a" x-morph="Vhi1cs" x-gloss="will" x-translit="ʾăʿiyḏ" xml:lang="hbo">אֲעִידֵ֞</char><char style="w" x-id="WLC.LAM.2.13.003" x-align="LAM.2.13.a003" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="I.testify.for.you" x-translit="ēḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.LAM.2.13.004" x-align="LAM.2.13.a004" x-target-ids="t007" x-target="what" x-target-head="t007" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh" xml:lang="hbo">מָ֣ה</char> <char style="w" x-id="WLC.LAM.2.13.005" x-align="LAM.2.13.a005" x-target-ids="t008 t009 t010" x-target="shall I liken" x-target-head="t010" x-head="true" lemma="דָּמָה" strong="H1819" x-morph="Vpi1cs" x-gloss="will.I.liken" x-translit="ʾăḏammeh-" xml:lang="hbo">אֲדַמֶּה</char>־<char style="w" x-id="WLC.LAM.2.13.006" x-align="LAM.2.13.a006" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לָּ֗</char><char style="w" x-id="WLC.LAM.2.13.007" x-align="LAM.2.13.a007" x-target-ids="t012" x-target="thee" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.LAM.2.13.008" x-align="LAM.2.13.a008" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="O" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.LAM.2.13.009" x-align="LAM.2.13.a009" x-target-ids="t013 t014" x-target="O daughter" x-target-head="t014" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfsa" x-gloss="daughter" x-translit="baṯ" xml:lang="hbo">בַּת֙</char> <char style="w" x-id="WLC.LAM.2.13.010" x-align="LAM.2.13.a010" x-target-ids="t015 t016" x-target="of Jerusalem" x-target-head="t016" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389" x-morph="Np" x-gloss="of.Jerusalem" x-translit="yərûšālaim" xml:lang="hbo">יְר֣וּשָׁלִַ֔ם</char> <char style="w" x-id="WLC.LAM.2.13.011" x-align="LAM.2.13.a011" x-target-ids="t017" x-target="What" x-target-head="t017" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh" xml:lang="hbo">מָ֤ה</char> <char style="w" x-id="WLC.LAM.2.13.012" x-align="LAM.2.13.a012" x-target-ids="t018 t019 t020" x-target="shall I compare" x-target-head="t020" x-head="true" lemma="שָׁוָה" strong="H7737" x-morph="Vhi1cs" x-gloss="will.I.make.equal" x-translit="ʾašweh-" xml:lang="hbo">אַשְׁוֶה</char>־<char style="w" x-id="WLC.LAM.2.13.013" x-align="LAM.2.13.a013" x-target-ids="t021" x-target="to" x-target-head="t021" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לָּ</char><char style="w" x-id="WLC.LAM.2.13.014" x-align="LAM.2.13.a014" x-target-ids="t022" x-target="thee" x-target-head="t022" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ֙</char> <char style="w" x-id="WLC.LAM.2.13.015" x-align="LAM.2.13.a015" x-target-ids="t023" x-target="that" x-target-head="t023" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="so" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LAM.2.13.016" x-align="LAM.2.13.a016" x-target-ids="t024 t025 t026" x-target="I may comfort" x-target-head="t026" x-head="true" lemma="נָחַם" strong="H5162" x-morph="Vpi1cs" x-gloss="that" x-translit="ʾănaḥăm" xml:lang=