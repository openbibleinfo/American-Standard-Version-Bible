	<para style="p"><verse number="3" style="v" x-ref="LAM.3.3" sid="LAM 3:3" /><char style="w" x-id="WLC.LAM.3.3.001" x-align="LAM.3.3.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ" xml:lang="hbo">אַ֣ךְ</char> <char style="w" x-id="WLC.LAM.3.3.002" x-align="LAM.3.3.a002" x-target-ids="t002" x-target="against" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="b" xml:lang="hbo">בִּ֥</char><char style="w" x-id="WLC.LAM.3.3.003" x-align="LAM.3.3.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.3.004" x-align="LAM.3.3.a004" x-target-ids="t008 t009 t010" x-target="again and again" x-target-head="t008" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi3ms" x-gloss="he.returned" x-translit="yāšuḇ" xml:lang="hbo">יָשֻׁ֛ב</char> <char style="w" x-id="WLC.LAM.3.3.005" x-align="LAM.3.3.a005" x-target-ids="t004 t005" x-target="he turneth" x-target-head="t005" x-head="true" lemma="הָפַךְ" strong="H2015" x-morph="Vqi3ms" x-gloss="he.turned" x-translit="yahăp̄ōḵ" xml:lang="hbo">יַהֲפֹ֥ךְ</char> <char style="w" x-id="WLC.LAM.3.3.006" x-align="LAM.3.3.a006" x-target-ids="t007" x-target="hand" x-target-head="t007" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָד֖</char><char style="w" x-id="WLC.LAM.3.3.007" x-align="LAM.3.3.a007" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.LAM.3.3.008" x-align="LAM.3.3.a008" x-target-ids="t011" x-target="all" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל