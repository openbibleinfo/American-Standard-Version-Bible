	<para style="p"><verse number="1" style="v" x-ref="LAM.5.1" sid="LAM 5:1" /><char style="w" x-id="WLC.LAM.5.1.001" x-align="LAM.5.1.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqv2ms" x-gloss="remember" x-translit="zəḵōr" xml:lang="hbo">זְכֹ֤ר</char> <char style="w" x-id="WLC.LAM.5.1.002" x-align="LAM.5.1.a002" x-target-ids="t002 t003" x-target="O Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.LAM.5.1.003" x-align="LAM.5.1.a003" x-target-ids="t004" x-target="what" x-target-head="t004" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="meh-" xml:lang="hbo">מֶֽה</char>־<char style="w" x-id="WLC.LAM.5.1.004" x-align="LAM.5.1.a004" x-target-ids="t005 t006" x-target="is come" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3ms" x-gloss="has.it.happened" x-translit="hāyâ" xml:lang="hbo">הָ֣יָה</char> <char style="w" x-id="WLC.LAM.5.1.005" x-align="LAM.5.1.a005" x-target-ids="t007" x-target="upon" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ֔</char><char style="w" x-id="WLC.LAM.5.1.006" x-align="LAM.5.1.a006" x-target-ids="t008" x-target="us" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ānû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.1.007" x-align="LAM.5.1.a007" x-target-ids="t009" x-target="Behold" x-target-head="t009" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhv2ms" x-gloss="look" x-translit="habbiyṭ" xml:lang="hbo">הַבִּ֖יטָ</char><char style="w" x-id="WLC.LAM.5.1.008" x-align="LAM.5.1.a008" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.LAM.5.1.009" x-al