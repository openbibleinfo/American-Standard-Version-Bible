	<para style="p"><verse number="22" style="v" x-ref="LAM.2.22" sid="LAM 2:22" /><char style="w" x-id="WLC.LAM.2.22.001" x-align="LAM.2.22.a001" x-target-ids="t001 t002 t003" x-target="Thou hast called" x-target-head="t003" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi2ms" x-gloss="you.have.summoned" x-translit="tiqrāʾ" xml:lang="hbo">תִּקְרָא֩</char> <char style="w" x-id="WLC.LAM.2.22.002" x-align="LAM.2.22.a002" x-target-ids="t004" x-target="as" x-target-head="t004" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like.[the]" x-translit="ḵ" xml:lang="hbo">כְ</char><char style="w" x-id="WLC.LAM.2.22.003" x-align="LAM.2.22.a003" x-target-ids="t005 t006 t007" x-target="in the day" x-target-head="t007" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsc" x-gloss="day" x-translit="yôm" xml:lang="hbo">י֨וֹם</char> <char style="w" x-id="WLC.LAM.2.22.004" x-align="LAM.2.22.a004" x-target-ids="t008 t009 t010 t011" x-target="of a solemn assembly" x-target-head="t011" x-head="true" lemma="מוֹעֵד" strong="H4150" x-morph="Ncmsa" x-gloss="of.an.appointed.feast" x-translit="môʿēḏ" xml:lang="hbo">מוֹעֵ֤ד</char> <char style="w" x-id="WLC.LAM.2.22.005" x-align="LAM.2.22.a005" x-target-ids="t013" x-target="terrors" x-target-head="t013" x-head="true" lemma="מְגוּרִים" strong="H4032" x-morph="Ncmpc" x-gloss="terrors" x-translit="məḡûr" xml:lang="hbo">מְגוּרַ</char><char style="w" x-id="WLC.LAM.2.22.006" x-align="LAM.2.22.a006" x-target-ids="t012" x-target="my" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.LAM.2.22.007" x-align="LAM.2.22.a007" x-target-ids="t014" x-target="on" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.LAM.2.22.008" x-align="LAM.2.22.a008" x-target-ids="t015 t016" x-target="every side" x-target-head="t016" x-head="true"