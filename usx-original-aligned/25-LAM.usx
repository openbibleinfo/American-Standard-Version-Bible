	<para style="p"><verse number="11" style="v" x-ref="LAM.3.11" sid="LAM 3:11" /><char style="w" x-id="WLC.LAM.3.11.001" x-align="LAM.3.11.a001" x-target-ids="t006" x-target="ways" x-target-head="t006" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="dərāḵ" xml:lang="hbo">דְּרָכַ֥</char><char style="w" x-id="WLC.LAM.3.11.002" x-align="LAM.3.11.a002" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.11.003" x-align="LAM.3.11.a003" x-target-ids="t001 t002 t003 t004" x-target="He hath turned aside" x-target-head="t003" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vop3ms" x-gloss="he.has.caused.to.deviate" x-translit="sôrēr" xml:lang="hbo">סוֹרֵ֛ר</char> <char style="w" x-id="WLC.LAM.3.11.004" x-align="LAM.3.11.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.LAM.3.11.005" x-align="LAM.3.11.a005" x-target-ids="t008 t010 t011" x-target="pulled in pieces" x-target-head="t008" x-head="true" lemma="פָּשַׁח" strong="H6582" x-morph="Vpw3ms" x-gloss="he" x-translit="yəp̄aššəḥ" xml:lang="hbo">יְפַשְּׁחֵ֖</char><char style="w" x-id="WLC.LAM.3.11.006" x-align="LAM.3.11.a006" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.torn.me.in.pieces" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.LAM.3.11.007" x-align="LAM.3.11.a007" x-target-ids="t012 t013 t014" x-target="he hath made" x-target-head="t014" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqp3ms" x-gloss="he" x-translit="śām" xml:lang="hbo">שָׂמַ֥</char><char style="w" x-id="WLC.LAM.3.11.008" x-align="LAM.3.11.a008" x-target-ids="t015" x-target="me" x-target-head="t015" x-head="true" lem