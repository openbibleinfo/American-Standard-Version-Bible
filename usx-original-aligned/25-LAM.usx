	<para style="p"><verse number="6" style="v" x-ref="LAM.3.6" sid="LAM 3:6" /><char style="w" x-id="WLC.LAM.3.6.001" x-align="LAM.3.6.a001" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.6.002" x-align="LAM.3.6.a002" x-target-ids="t008 t009" x-target="dark places" x-target-head="t008" x-head="true" lemma="מַחְשָׁךְ" strong="H4285" x-morph="Ncmpa" x-gloss="dark.places" x-translit="maḥăšakkiym" xml:lang="hbo">מַחֲשַׁכִּ֥ים</char> <char style="w" x-id="WLC.LAM.3.6.003" x-align="LAM.3.6.a003" x-target-ids="t001 t002 t003 t005 t006" x-target="He hath made to dwell" x-target-head="t006" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vhp3ms" x-gloss="he" x-translit="hôšiyḇ" xml:lang="hbo">הוֹשִׁיבַ֖</char><char style="w" x-id="WLC.LAM.3.6.004" x-align="LAM.3.6.a004" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.caused.me.to.dwell" x-translit="aniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.LAM.3.6.005" x-align="LAM.3.6.a005" x-target-ids="t010" x-target="as" x-target-head="t010" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.LAM.3.6.006" x-align="LAM.3.6.a006" x-target-ids="t011 t012 t013 t014 t016" x-target="those that have been dead" x-target-head="t016" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqrmpc" x-gloss="dead.[people]" x-translit="mēṯēy" xml:lang="hbo">מֵתֵ֥י</char> <char style="w" x-id="WLC.LAM.3.6.007" x-align="LAM.3.6.a007" x-target-ids="t015" x-target="long" x-target-head="t015" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.antiquity" x-translit="ʿôlām:" xml:lang="hbo">עוֹלָֽם</char>׃ס<verse eid="LAM 3:6" /></para>
	<para style="p"><verse number="7" style="v" x-ref="LAM.3.7" sid="LAM 3:7" /><char style="w" x-id="WLC.LAM.3.7.001" x-align="LAM.3.7.a001" x-target-ids="t001 t002 t003" x-target="He hath walled" x-target-head="t003" x-head="true" lemma="גָּדַר" strong="H1443" x-morph="Vqp3ms" x-gloss="he.has.walled.up" x-translit="gāḏar" xml:lang="hbo">גָּדַ֧ר</char> <char style="w" x-id="WLC.LAM.3.7.002" x-align="LAM.3.7.a002" x-target-ids="t005" x-target="about" x-target-head="t005" x-head="true" lemma="בַּעַד" strong="H1157" x-morph="R" x-gloss="behind" x-translit="baʿăḏ" xml:lang="hbo">בַּעֲדִ֛</char><char style="w" x-id="WLC.LAM.3.7.003" x-align="LAM.3.7.a003" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.7.004" x-align="LAM.3.7.a004" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.3.7.005" x-align="LAM.3.7.a005" x-target-ids="t008" x-target="cannot" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LAM.3.7.006" x-align="LAM.3.7.a006" x-target-ids="t007 t009 t010" x-target="I go forth" x-target-head="t009" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqi1cs" x-gloss="I.will.go.out" x-translit="ʾēṣēʾ" xml:lang="hbo">אֵצֵ֖א</char> <char style="w" x-id="WLC.LAM.3.7.007" x-align="LAM.3.7.a007" x-target-ids="t011 t012 t013 t016" x-target="he hath made heavy" x-target-head="t016" x-head="true" lemma="כָּבֵד" strong="H3513" x-morph="Vhp3ms" x-gloss="he.has.made.heavy" x-translit="hiḵbiyḏ" xml:lang="hbo">הִכְבִּ֥יד</char> <char style="w" x-id="WLC.LAM.3.7.008" x-align="LAM.3.7.a008" x-target-ids="t015" x-target="chain" x-target-head="t015" x-head="true" lemma="נְחֹשֶׁת" strong="H5178" x-morph="Ncfsc" x-gloss="fetter[s]" x-translit="nəḥāšətt" xml:lang="hbo">נְחָשְׁתִּֽ</char><char style="w" x-id="WLC.LAM.3.7.009" x-align="LAM.3.7.a009" x-target-ids="t014" x-target="my" x-target-head="t014" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my.bronze" x-translit="iy" xml:lang="hbo">י</char>׃<verse eid="LAM 3:7" /></para>
	<para style="p"><verse number="8" style="v" x-ref="LAM.3.8" sid="LAM 3:8" /><char style="w" x-id="WLC.LAM.3.8.001" x-align="LAM.3.8.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam" xml:lang="hbo">גַּ֣ם</char> <char style="w" x-id="WLC.LAM.3.8.002" x-align="LAM.3.8.a002" x-target-ids="t002" x-target="when" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.LAM.3.8.003" x-align="LAM.3.8.a003" x-target-ids="t003 t004" x-target="I cry" x-target-head="t004" x-head="true" lemma="זָעַק" strong="H2199" x-morph="Vqi1cs" x-gloss="I.will.cry.out" x-translit="ʾezʿaq" xml:lang="hbo">אֶזְעַק֙</char> <char style="w" x-id="WLC.LAM.3.8.004" x-align="LAM.3.8.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LAM.3.8.005" x-align="LAM.3.8.a005" x-target-ids="t006 t007 t008" x-target="call for help" x-target-head="t006" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpi1cs" x-gloss="I.will.cry.for.help" x-translit="ʾăšawwēᵃʿ" xml:lang="hbo">אֲשַׁוֵּ֔עַ</char> <char style="w" x-id="WLC.LAM.3.8.006" x-align="LAM.3.8.a006" x-target-ids="t009 t010 t011" x-target="he shutteth out" x-target-head="t010" x-head="true" lemma="שָׂתַם" strong="H5640a" x-morph="Vqp3ms" x-gloss="he.has.shut.out" x-translit="śāṯam" xml:lang="hbo">שָׂתַ֖ם</char> <char style="w" x-id="WLC.LAM.3.8.007" x-align="LAM.3.8.a007" x-target-ids="t013" x-target="prayer" x-target-head="t013" x-head="true" lemma="תְּפִלָּה" strong="H8605" x-morph="Ncfsc" x-gloss="prayer" x-translit="təp̄illāṯ" xml:lang="hbo">תְּפִלָּתִֽ</char><char style="w" x-id="WLC.LAM.3.8.008" x-align="LAM.3.8.a008" x-target-ids="t012" x-target="my" x-target-head="t012" x-head="true" lemma="הוּא" strong=