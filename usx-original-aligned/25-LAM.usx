	<para style="p"><verse number="1" style="v" x-ref="LAM.2.1" sid="LAM 2:1" /><char style="w" x-id="WLC.LAM.2.1.001" x-align="LAM.2.1.a001" x-target-ids="t001" x-target="How" x-target-head="t001" x-head="true" lemma="אֵיכָה" strong="H349a" x-morph="Ti" x-gloss="how!" x-translit="ʾêḵāh" xml:lang="hbo">אֵיכָה֩</char> <char style="w" x-id="WLC.LAM.2.1.002" x-align="LAM.2.1.a002" x-target-ids="t002 t005 t010 t011 t012" x-target="hath covered with a cloud" x-target-head="t005" x-head="true" lemma="עוּב" strong="H5743" x-morph="Vhi3ms" x-gloss="he.covers.with.a.cloud" x-translit="yāʿiyḇ" xml:lang="hbo">יָעִ֨יב</char> <char style="w" x-id="WLC.LAM.2.1.003" x-align="LAM.2.1.a003" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.2.1.004" x-align="LAM.2.1.a004" x-target-ids="t015" x-target="anger" x-target-head="t015" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsc" x-gloss="anger" x-translit="ʾapp" xml:lang="hbo">אַפּ֤</char><char style="w" x-id="WLC.LAM.2.1.005" x-align="LAM.2.1.a005" x-target-ids="t014" x-target="his" x-target-head="t014" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char>׀<char style="w" x-id="WLC.LAM.2.1.006" x-align="LAM.2.1.a006" x-target-ids="t003 t004" x-target="the Lord" x-target-head="t004" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ</char><char style="w" x-id="WLC.LAM.2.1.007" x-align="LAM.2.1.a007" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.LAM.2.1.008" x-align="LAM.2.1.a008" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.LAM.2.1.009"