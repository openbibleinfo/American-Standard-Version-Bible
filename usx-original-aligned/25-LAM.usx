	<para style="p"><verse number="19" style="v" x-ref="LAM.5.19" sid="LAM 5:19" /><char style="w" x-id="WLC.LAM.5.19.001" x-align="LAM.5.19.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֤ה</char> <char style="w" x-id="WLC.LAM.5.19.002" x-align="LAM.5.19.a002" x-target-ids="t002 t003" x-target="O Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.LAM.5.19.003" x-align="LAM.5.19.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.5.19.004" x-align="LAM.5.19.a004" x-target-ids="t006" x-target="ever" x-target-head="t006" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֣ם</char> <char style="w" x-id="WLC.LAM.5.19.005" x-align="LAM.5.19.a005" x-target-ids="t004" x-target="abidest" x-target-head="t004" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi2ms" x-gloss="you.will.sit" x-translit="tēšēḇ" xml:lang="hbo">תֵּשֵׁ֔ב</char> <char style="w" x-id="WLC.LAM.5.19.006" x-align="LAM.5.19.a006" x-target-ids="t008" x-target="throne" x-target-head="t008" x-head="true" lemma="כִּסֵּא" strong="H3678" x-morph="Ncmsc" x-gloss="throne" x-translit="kisʾ" xml:lang="hbo">כִּסְאֲ</char><char style="w" x-id="WLC.LAM.5.19.007" x-align="LAM.5.19.a007" x-target-ids="t007" x-target="Thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ăḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.LAM.5.19.008" x-align="LAM.5.19.a008" x-target-ids="t009 t010" x-target="is from" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is]