	<para style="p"><verse number="2" style="v" x-ref="LAM.5.2" sid="LAM 5:2" /><char style="w" x-id="WLC.LAM.5.2.001" x-align="LAM.5.2.a001" x-target-ids="t002" x-target="inheritance" x-target-head="t002" x-head="true" lemma="נַחֲלָה" strong="H5159" x-morph="Ncfsc" x-gloss="inheritance" x-translit="naḥălāṯ" xml:lang="hbo">נַחֲלָתֵ֨</char><char style="w" x-id="WLC.LAM.5.2.002" x-align="LAM.5.2.a002" x-target-ids="t001" x-target="Our" x-target-head="t001" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo">נוּ֙</char> <char style="w" x-id="WLC.LAM.5.2.003" x-align="LAM.5.2.a003" x-target-ids="t003 t004" x-target="is turned" x-target-head="t004" x-head="true" lemma="הָפַךְ" strong="H2015" x-morph="VNp3fs" x-gloss="it.has.been.turned.over" x-translit="nehep̄ḵāh" xml:lang="hbo">נֶֽהֶפְכָ֣ה</char> <char style="w" x-id="WLC.LAM.5.2.004" x-align="LAM.5.2.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.5.2.005" x-align="LAM.5.2.a005" x-target-ids="t006" x-target="strangers" x-target-head="t006" x-head="true" lemma="זָר" strong="H2114b" x-morph="Aampa" x-gloss="strangers" x-translit="zāriym" xml:lang="hbo">זָרִ֔ים</char> <char style="w" x-id="WLC.LAM.5.2.006" x-align="LAM.5.2.a006" x-target-ids="t008" x-target="houses" x-target-head="t008" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmpc" x-gloss="houses" x-translit="bāttēy" xml:lang="hbo">בָּתֵּ֖י</char><char style="w" x-id="WLC.LAM.5.2.007" x-align="LAM.5.2.a007" x-target-ids="t007" x-target="Our" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.2.008" x-align="LAM.5.2.a008" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-t