	<para style="p"><verse number="58" style="v" x-ref="LAM.3.58" sid="LAM 3:58" /><char style="w" x-id="WLC.LAM.3.58.001" x-align="LAM.3.58.a001" x-target-ids="t003 t004 t005" x-target="thou hast pleaded" x-target-head="t005" x-head="true" lemma="רִיב" strong="H7378" x-morph="Vqp2ms" x-gloss="you.have.conducted" x-translit="raḇətā" xml:lang="hbo">רַ֧בְתָּ</char> <char style="w" x-id="WLC.LAM.3.58.002" x-align="LAM.3.58.a002" x-target-ids="t001 t002" x-target="O Lord" x-target-head="t002" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֛</char><char style="w" x-id="WLC.LAM.3.58.003" x-align="LAM.3.58.a003" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.58.004" x-align="LAM.3.58.a004" x-target-ids="t006 t007" x-target="the causes" x-target-head="t007" x-head="true" lemma="רִיב" strong="H7379" x-morph="Ncbpc" x-gloss="the.cases" x-translit="rîḇēy" xml:lang="hbo">רִיבֵ֥י</char> <char style="w" x-id="WLC.LAM.3.58.005" x-align="LAM.3.58.a005" x-target-ids="t008 t010" x-target="of soul" x-target-head="t010" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="my.self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֖</char><char style="w" x-id="WLC.LAM.3.58.006" x-align="LAM.3.58.a006" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.58.007" x-align="LAM.3.58.a007" x-target-ids="t011 t012 t013" x-target="thou hast redeemed" x-target-head="t013" x-head="true" lemma="גָּאַל" strong="H1350" x-morph="Vqp2ms" x-gloss="you.have.redeemed" x-translit="gāʾalətā" xml:lang="hbo">גָּאַ֥לְתָּ</char> <char style="w" x-id="WLC.LAM.3.58.008" x-align="LAM.3.58.a008" x-target-ids="t015" x-target="life" x-target-head="t015" x-head="true" lemma="חַיִּים