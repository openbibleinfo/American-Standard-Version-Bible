	<para style="p"><verse number="14" style="v" x-ref="LAM.1.14" sid="LAM 1:14" /><char style="w" x-id="WLC.LAM.1.14.001" x-align="LAM.1.14.a004" x-target-ids="t006 t007" x-target="is bound" x-target-head="t007" x-head="true" lemma="שָׂקַד" strong="H8244" x-morph="VNp3ms" x-gloss="it.has.been.bound.on" x-translit="niśqaḏ" xml:lang="hbo">נִשְׂקַד֩</char> <char style="w" x-id="WLC.LAM.1.14.002" x-align="LAM.1.14.a001" x-target-ids="t001 t002" x-target="The yoke" x-target-head="t002" x-head="true" lemma="עֹל" strong="H5923" x-morph="Ncmsc" x-gloss="the.yoke" x-translit="ʿōl" xml:lang="hbo">עֹ֨ל</char> <char style="w" x-id="WLC.LAM.1.14.003" x-align="LAM.1.14.a002" x-target-ids="t003 t005" x-target="of transgressions" x-target-head="t005" x-head="true" lemma="פֶּשַׁע" strong="H6588" x-morph="Ncmpc" x-gloss="my.transgressions" x-translit="pəšāʿ" xml:lang="hbo">פְּשָׁעַ֜</char><char style="w" x-id="WLC.LAM.1.14.004" x-align="LAM.1.14.a003" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.1.14.005" x-align="LAM.1.14.a005" x-target-ids="t008" x-target="by" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.1.14.006" x-align="LAM.1.14.a007" x-target-ids="t010" x-target="hand" x-target-head="t010" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָד֗</char><char style="w" x-id="WLC.LAM.1.14.007" x-align="LAM.1.14.a006" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.LAM.1.14.008" x-align="LAM.1.14.a008" x-target-ids="t011 t012 t013 t014" x-target="They are knit together" x-target-head="t013" x-head="true" lemma="שָׂרַג" strong="H