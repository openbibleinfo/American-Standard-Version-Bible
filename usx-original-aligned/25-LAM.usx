	<para style="p"><verse number="2" style="v" x-ref="LAM.1.2" sid="LAM 1:2" /><char style="w" x-id="WLC.LAM.1.2.001" x-align="LAM.1.2.a001" x-target-ids="t003" x-target="sore" x-target-head="t003" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqa" x-gloss="bitterly.(weep)" x-translit="bāḵô" xml:lang="hbo">בָּכ֨וֹ</char> <char style="w" x-id="WLC.LAM.1.2.002" x-align="LAM.1.2.a002" x-target-ids="t001 t002" x-target="She weepeth" x-target-head="t002" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqi3fs" x-gloss="it.weeps" x-translit="ṯiḇkeh" xml:lang="hbo">תִבְכֶּ֜ה</char> <char style="w" x-id="WLC.LAM.1.2.003" x-align="LAM.1.2.a003" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.LAM.1.2.004" x-align="LAM.1.2.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LAM.1.2.005" x-align="LAM.1.2.a005" x-target-ids="t006" x-target="night" x-target-head="t006" x-head="true" lemma="לַיְלָה" strong="H3915" x-morph="Ncmsa" x-gloss="night" x-translit="llayəlâ" xml:lang="hbo">לַּ֗יְלָה</char> <char style="w" x-id="WLC.LAM.1.2.006" x-align="LAM.1.2.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.1.2.007" x-align="LAM.1.2.a007" x-target-ids="t009" x-target="tears" x-target-head="t009" x-head="true" lemma="דִּמְעָה" strong="H1832" x-morph="Ncfsc" x-gloss="tear[s]" x-translit="ḏimʿāṯ" xml:lang="hbo">דִמְעָתָ</char><char style="w" x-id="WLC.LAM.1.2.008" x-align="LAM.1.2.a008" x-target-ids="t008" x-target="her" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="āhh" xml:lang="hbo">הּ֙</c