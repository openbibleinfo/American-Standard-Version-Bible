	<para style="p"><verse number="5" style="v" x-ref="LAM.5.5" sid="LAM 5:5" /><char style="w" x-id="WLC.LAM.5.5.001" x-align="LAM.5.5.a001" x-target-ids="t004" x-target="upon" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="at" x-translit="ʿal" xml:lang="hbo">עַ֤ל</char> <char style="w" x-id="WLC.LAM.5.5.002" x-align="LAM.5.5.a002" x-target-ids="t006" x-target="necks" x-target-head="t006" x-head="true" lemma="צַוָּאר" strong="H6677" x-morph="Ncmsc" x-gloss="neck" x-translit="ṣawwāʾr" xml:lang="hbo">צַוָּארֵ֨</char><char style="w" x-id="WLC.LAM.5.5.003" x-align="LAM.5.5.a003" x-target-ids="t005" x-target="our" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo">נוּ֙</char> <char style="w" x-id="WLC.LAM.5.5.004" x-align="LAM.5.5.a004" x-target-ids="t001 t002 t003" x-target="Our pursuers are" x-target-head="t002" x-head="true" lemma="רָדַף" strong="H7291" x-morph="VNp1cp" x-gloss="we.have.been.pursued" x-translit="nirdāp̄ənû" xml:lang="hbo">נִרְדָּ֔פְנוּ</char> <char style="w" x-id="WLC.LAM.5.5.005" x-align="LAM.5.5.a005" x-target-ids="t007 t008 t009" x-target="We are weary" x-target-head="t009" x-head="true" lemma="יָגֵעַ" strong="H3021" x-morph="Vqp1cp" x-gloss="we.have.become.weary" x-translit="yāḡaʿənû" xml:lang="hbo">יָגַ֖עְנוּ</char> <char style="w" x-id="WLC.LAM.5.5.006" x-align="LAM.5.5.a006" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.5.5.007" x-align="LAM.5.5.a007" x-target-ids="t012" x-target="no" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="**lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LAM.5.5.008" x-align="LAM.5.5.a008" x-target-ids="t011 t013" x-target="have rest" x-target-head="t013" x-head="true" lemma="נוּחַ" strong="H5117" x-mor