	<para style="p"><verse number="2" style="v" x-ref="LAM.3.2" x-added-alignments="LAM.3.2.a006" x-added-target-ids="t007" x-added-target="me" sid="LAM 3:2" /><char style="w" x-id="WLC.LAM.3.2.001" x-align="LAM.3.2.a001" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾôṯ" xml:lang="hbo">אוֹתִ֥</char><char style="w" x-id="WLC.LAM.3.2.002" x-align="LAM.3.2.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.2.003" x-align="LAM.3.2.a003" x-target-ids="t001 t002 t003" x-target="He hath led" x-target-head="t003" x-head="true" lemma="נָהַג" strong="H5090" x-morph="Vqp3ms" x-gloss="he.has.driven" x-translit="nāhaḡ" xml:lang="hbo">נָהַ֛ג</char> <char style="w" x-id="WLC.LAM.3.2.004" x-align="LAM.3.2.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LAM.3.2.005" x-align="LAM.3.2.a005" x-target-ids="t006 t008 t009" x-target="caused to walk" x-target-head="t009" x-head="true" lemma="הלך" strong="H1980" x-morph="Vhw3ms" x-gloss="he.has.made.walk" x-translit="yyōlaḵ" xml:lang="hbo">יֹּלַ֖ךְ</char> <char style="w" x-id="WLC.LAM.3.2.006" x-align="LAM.3.2.a007" x-target-ids="t010 t011" x-target="in darkness" x-target-head="t011" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֥שֶׁךְ</char> <char style="w" x-id="WLC.LAM.3.2.007" x-align="LAM.3.2.a008" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.3.2.008" x-align="LAM.3.2.a009" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-g