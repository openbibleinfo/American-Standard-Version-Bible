	<para style="p"><verse number="9" style="v" x-ref="LAM.1.9" sid="LAM 1:9" /><char style="w" x-id="WLC.LAM.1.9.001" x-align="LAM.1.9.a001" x-target-ids="t002" x-target="filthiness" x-target-head="t002" x-head="true" lemma="טֻמְאָה" strong="H2932" x-morph="Ncfsc" x-gloss="uncleanness" x-translit="ṭumʾāṯ" xml:lang="hbo">טֻמְאָתָ֣</char><char style="w" x-id="WLC.LAM.1.9.002" x-align="LAM.1.9.a002" x-target-ids="t001" x-target="Her" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.LAM.1.9.003" x-align="LAM.1.9.a003" x-target-ids="t003 t004" x-target="was in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[was].the" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.1.9.004" x-align="LAM.1.9.a004" x-target-ids="t006" x-target="skirts" x-target-head="t006" x-head="true" lemma="שׁוּל" strong="H7757" x-morph="Ncmpc" x-gloss="skirts" x-translit="šûley" xml:lang="hbo">שׁוּלֶ֗י</char><char style="w" x-id="WLC.LAM.1.9.005" x-align="LAM.1.9.a005" x-target-ids="t005" x-target="her" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="of.its.robe" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.LAM.1.9.006" x-align="LAM.1.9.a006" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֤א</char> <char style="w" x-id="WLC.LAM.1.9.007" x-align="LAM.1.9.a007" x-target-ids="t007 t008" x-target="she remembered" x-target-head="t008" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqp3fs" x-gloss="it.remembered" x-translit="zāḵərāh" xml:lang="hbo">זָֽכְרָה֙</char> <char style="w" x-id="WLC.LAM.1.9.008" x-align="LAM.1.9.a008" x-target-ids="t011 t012" x-target="latter end" x-target-head="t012" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="outc