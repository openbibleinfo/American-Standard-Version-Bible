	<para style="p"><verse number="18" style="v" x-ref="LAM.3.18" sid="LAM 3:18" /><char style="w" x-id="WLC.LAM.3.18.001" x-align="LAM.3.18.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.LAM.3.18.002" x-align="LAM.3.18.a002" x-target-ids="t002 t003" x-target="I said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw1cs" x-gloss="I.said" x-translit="ʾōmar" xml:lang="hbo">אֹמַר֙</char> <char style="w" x-id="WLC.LAM.3.18.003" x-align="LAM.3.18.a003" x-target-ids="t006 t007" x-target="is perished" x-target-head="t007" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqp3ms" x-gloss="it.has.perished" x-translit="ʾāḇaḏ" xml:lang="hbo">אָבַ֣ד</char> <char style="w" x-id="WLC.LAM.3.18.004" x-align="LAM.3.18.a004" x-target-ids="t005" x-target="strength" x-target-head="t005" x-head="true" lemma="נֵצַח" strong="H5331" x-morph="Ncmsc" x-gloss="endurance" x-translit="niṣḥ" xml:lang="hbo">נִצְחִ֔</char><char style="w" x-id="WLC.LAM.3.18.005" x-align="LAM.3.18.a005" x-target-ids="t004" x-target="My" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.18.006" x-align="LAM.3.18.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.3.18.007" x-align="LAM.3.18.a007" x-target-ids="t010" x-target="expectation" x-target-head="t010" x-head="true" lemma="תּוֹחֶלֶת" strong="H8431" x-morph="Ncfsc" x-gloss="hope" x-translit="ṯôḥalt" xml:lang="hbo">תוֹחַלְתִּ֖</char><char style="w" x-id="WLC.LAM.3.18.008" x-align="LAM.3.18.a008" x-target-ids="t009" x-target="mine" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" 