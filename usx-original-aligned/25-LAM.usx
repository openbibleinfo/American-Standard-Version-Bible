	<para style="p"><verse number="46" style="v" x-ref="LAM.3.46" sid="LAM 3:46" /><char style="w" x-id="WLC.LAM.3.46.001" x-align="LAM.3.46.a001" x-target-ids="t004 t005 t008" x-target="have opened wide" x-target-head="t005" x-head="true" lemma="פָּצָה" strong="H6475" x-morph="Vqp3cp" x-gloss="they.have.opened" x-translit="pāṣû" xml:lang="hbo">פָּצ֥וּ</char> <char style="w" x-id="WLC.LAM.3.46.002" x-align="LAM.3.46.a002" x-target-ids="t009" x-target="against" x-target-head="t009" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿālēy" xml:lang="hbo">עָלֵ֛י</char><char style="w" x-id="WLC.LAM.3.46.003" x-align="LAM.3.46.a003" x-target-ids="t010" x-target="us" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.3.46.004" x-align="LAM.3.46.a004" x-target-ids="t007" x-target="mouth" x-target-head="t007" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="piy" xml:lang="hbo">פִּי</char><char style="w" x-id="WLC.LAM.3.46.005" x-align="LAM.3.46.a005" x-target-ids="t006" x-target="their" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo">הֶ֖ם</char> <char style="w" x-id="WLC.LAM.3.46.006" x-align="LAM.3.46.a006" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LAM.3.46.007" x-align="LAM.3.46.a007" x-target-ids="t003" x-target="enemies" x-target-head="t003" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾōyəḇēy" xml:lang="hbo">אֹיְבֵֽי</char><char style="w" x-id="WLC.LAM.3.46.008" x-align="LAM.3.46.a008" x-target-ids="t002" x-target="our" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-transli