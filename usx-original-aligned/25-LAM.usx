	<para style="p"><verse number="9" style="v" x-ref="LAM.3.9" sid="LAM 3:9" /><char style="w" x-id="WLC.LAM.3.9.001" x-align="LAM.3.9.a001" x-target-ids="t001 t002 t003 t004" x-target="He hath walled up" x-target-head="t003" x-head="true" lemma="גָּדַר" strong="H1443" x-morph="Vqp3ms" x-gloss="he.has.walled.up" x-translit="gāḏar" xml:lang="hbo">גָּדַ֤ר</char> <char style="w" x-id="WLC.LAM.3.9.002" x-align="LAM.3.9.a002" x-target-ids="t006" x-target="ways" x-target-head="t006" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="dərāḵ" xml:lang="hbo">דְּרָכַ</char><char style="w" x-id="WLC.LAM.3.9.003" x-align="LAM.3.9.a003" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.LAM.3.9.004" x-align="LAM.3.9.a004" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.9.005" x-align="LAM.3.9.a005" x-target-ids="t008 t009" x-target="hewn stone" x-target-head="t008" x-head="true" lemma="גָּזִית" strong="H1496" x-morph="Ncfsa" x-gloss="hewn.[stone]" x-translit="ḡāziyṯ" xml:lang="hbo">גָזִ֔ית</char> <char style="w" x-id="WLC.LAM.3.9.006" x-align="LAM.3.9.a006" x-target-ids="t014" x-target="paths" x-target-head="t014" x-head="true" lemma="נְתִיבָה" strong="H5410" x-morph="Ncbpc" x-gloss="paths" x-translit="nəṯiyḇōṯ" xml:lang="hbo">נְתִיבֹתַ֖</char><char style="w" x-id="WLC.LAM.3.9.007" x-align="LAM.3.9.a007" x-target-ids="t013" x-target="my" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.9.008" x-align="LAM.3.9.a008" x-target-ids="t010 t011 t012 t015" x-target="he hath made crooked" x-target-head="t015" x-head="true" lemma="עָוָה" strong="H5753" x-morph="Vpp3ms" x-gloss="he.has.made.crooked" x-translit="ʿiwwāh:" xml:lang="hbo">עִוָּֽה</char>׃ס<verse eid="LAM 3:9" /></para>
	<para style="p"><verse number="10" style="v" x-ref="LAM.3.10" sid="LAM 3:10" /><char style="w" x-id="WLC.LAM.3.10.001" x-align="LAM.3.10.a001" x-target-ids="t002 t005 t006 t007" x-target="is as a bear" x-target-head="t007" x-head="true" lemma="דֹּב" strong="H1677" x-morph="Ncmsa" x-gloss="[is].a.bear" x-translit="dōḇ" xml:lang="hbo">דֹּ֣ב</char> <char style="w" x-id="WLC.LAM.3.10.002" x-align="LAM.3.10.a002" x-target-ids="t008 t009 t010" x-target="lying in wait" x-target-head="t008" x-head="true" lemma="אָרַב" strong="H693" x-morph="Vqrmsa" x-gloss="[which].lies.in.wait" x-translit="ʾōrēḇ" xml:lang="hbo">אֹרֵ֥ב</char> <char style="w" x-id="WLC.LAM.3.10.003" x-align="LAM.3.10.a003" x-target-ids="t001" x-target="He" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">הוּא֙</char> <char style="w" x-id="WLC.LAM.3.10.004" x-align="LAM.3.10.a004" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֔</char><char style="w" x-id="WLC.LAM.3.10.005" x-align="LAM.3.10.a005" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.10.006" x-align="LAM.3.10.a006" x-target-ids="t011 t012 t013" x-target="as a lion" x-target-head="t013" x-head="true" lemma="אֲרִי" strong="H738" x-morph="Ncmsa" x-gloss="a.lion" x-translit="**ʾăriy" xml:lang="hbo">אֲרִ֖י</char> <char style="w" x-id="WLC.LAM.3.10.007" x-align="LAM.3.10.a007" x-target-ids="t014" x-target="in" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.10.008" x-align="LAM.3.10.a008" x-target-ids="t015 t016" x-target="secret places" x-target-head="t015" x-head="true" lemma="מִסְתָּר" strong="H4565" x-morph="Ncm