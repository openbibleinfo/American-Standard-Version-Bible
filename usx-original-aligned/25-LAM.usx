	<para style="p"><verse number="18" style="v" x-ref="LAM.5.18" sid="LAM 5:18" /><char style="w" x-id="WLC.LAM.5.18.001" x-align="LAM.5.18.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal" xml:lang="hbo">עַ֤ל</char> <char style="w" x-id="WLC.LAM.5.18.002" x-align="LAM.5.18.a002" x-target-ids="t002 t003" x-target="the mountain" x-target-head="t003" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmsc" x-gloss="the.mountain" x-translit="har-" xml:lang="hbo">הַר</char>־<char style="w" x-id="WLC.LAM.5.18.003" x-align="LAM.5.18.a003" x-target-ids="t004 t005" x-target="of Zion" x-target-head="t005" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="of.Zion" x-translit="ṣiyyôn" xml:lang="hbo">צִיּוֹן֙</char> <char style="w" x-id="WLC.LAM.5.18.004" x-align="LAM.5.18.a004" x-target-ids="t006" x-target="which" x-target-head="t006" x-head="true" lemma="שֶׁ" strong="H7578a" x-morph="Tr" x-gloss="which.[is]" x-translit="še" xml:lang="hbo">שֶׁ</char><char style="w" x-id="WLC.LAM.5.18.005" x-align="LAM.5.18.a005" x-target-ids="t007 t008" x-target="is desolate" x-target-head="t008" x-head="true" lemma="שָׁמֵם" strong="H8074" x-morph="Vqp3ms" x-gloss="desolate" x-translit="ššāmēm" xml:lang="hbo">שָּׁמֵ֔ם</char> <char style="w" x-id="WLC.LAM.5.18.006" x-align="LAM.5.18.a006" x-target-ids="t009 t010" x-target="The foxes" x-target-head="t010" x-head="true" lemma="שׁוּעָל" strong="H7776" x-morph="Ncmpa" x-gloss="foxes" x-translit="šûʿāliym" xml:lang="hbo">שׁוּעָלִ֖ים</char> <char style="w" x-id="WLC.LAM.5.18.007" x-align="LAM.5.18.a007" x-target-ids="t011" x-target="walk" x-target-head="t011" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vpp3cp" x-gloss="they.have.prowled" x-translit="hilləḵû-" xml:lang="hbo">הִלְּכוּ</char>־<char style="w" x-id="WLC.LAM.5.18.008" x-align="LAM.5.18.a008" x-target-ids="t012" x-target="upon" x-target-head="t012" x-head="true" lemma="בְּ"