	<para style="p"><verse number="19" style="v" x-ref="LAM.3.19" sid="LAM 3:19" /><char style="w" x-id="WLC.LAM.3.19.001" x-align="LAM.3.19.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqv2ms" x-gloss="remember" x-translit="zəḵār-" xml:lang="hbo">זְכָר</char>־<char style="w" x-id="WLC.LAM.3.19.002" x-align="LAM.3.19.a002" x-target-ids="t003" x-target="affliction" x-target-head="t003" x-head="true" lemma="עֳנִי" strong="H6040" x-morph="Ncmsc" x-gloss="affliction" x-translit="ʿānəy" xml:lang="hbo">עָנְיִ֥</char><char style="w" x-id="WLC.LAM.3.19.003" x-align="LAM.3.19.a003" x-target-ids="t002" x-target="mine" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.19.004" x-align="LAM.3.19.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.LAM.3.19.005" x-align="LAM.3.19.a005" x-target-ids="t006" x-target="misery" x-target-head="t006" x-head="true" lemma="מָרוֹד" strong="H4788" x-morph="Ncmsc" x-gloss="homelessness" x-translit="mərûḏ" xml:lang="hbo">מְרוּדִ֖</char><char style="w" x-id="WLC.LAM.3.19.006" x-align="LAM.3.19.a006" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.19.007" x-align="LAM.3.19.a007" x-target-ids="t007 t008" x-target="the wormwood" x-target-head="t008" x-head="true" lemma="לַעֲנָה" strong="H3939" x-morph="Ncfsa" x-gloss="wormwood" x-translit="laʿănāh" xml:lang="hbo">לַעֲנָ֥ה</char> <char style="w" x-id="WLC.LAM.3.19.008" x-align="LAM.3.19.a008" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā"