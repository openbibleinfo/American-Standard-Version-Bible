	<para style="p"><verse number="2" style="v" x-ref="LAM.2.2" x-added-alignments="LAM.2.2.a019" x-added-target-ids="t032" x-added-target="them" sid="LAM 2:2" /><char style="w" x-id="WLC.LAM.2.2.001" x-align="LAM.2.2.a001" x-target-ids="t003 t004 t005" x-target="hath swallowed up" x-target-head="t004" x-head="true" lemma="בָּלַע" strong="H1104" x-morph="Vpp3ms" x-gloss="he.has.swallowed.up" x-translit="billaʿ" xml:lang="hbo">בִּלַּ֨ע</char> <char style="w" x-id="WLC.LAM.2.2.002" x-align="LAM.2.2.a002" x-target-ids="t001 t002" x-target="The Lord" x-target-head="t002" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֜</char><char style="w" x-id="WLC.LAM.2.2.003" x-align="LAM.2.2.a003" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.2.2.004" x-align="LAM.2.2.a004" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.2.2.005" x-align="LAM.2.2.a005" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="**lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.LAM.2.2.006" x-align="LAM.2.2.a006" x-target-ids="t012 t014" x-target="hath pitied" x-target-head="t014" x-head="true" lemma="חָמַל" strong="H2550" x-morph="Vqp3ms" x-gloss="he.has.spared" x-translit="ḥāmal" xml:lang="hbo">חָמַ֗ל</char> <char style="w" x-id="WLC.LAM.2.2.007" x-align="LAM.2.2.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾēṯ" xml:lang="hbo">אֵ֚ת</char> <char style="w" x-id="WLC.LAM.2.2.008" x-align="LAM.2.2.a008" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss