	<para style="p"><verse number="44" style="v" x-ref="LAM.3.44" sid="LAM 3:44" /><char style="w" x-id="WLC.LAM.3.44.001" x-align="LAM.3.44.a001" x-target-ids="t001 t002 t003" x-target="Thou hast covered" x-target-head="t003" x-head="true" lemma="סָכַךְ" strong="H5526" x-morph="Vqp2ms" x-gloss="you.have.covered" x-translit="sakôṯâ" xml:lang="hbo">סַכּ֤וֹתָה</char> <char style="w" x-id="WLC.LAM.3.44.002" x-align="LAM.3.44.a002" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="with" x-translit="ḇe" xml:lang="hbo">בֶֽ</char><char style="w" x-id="WLC.LAM.3.44.003" x-align="LAM.3.44.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LAM.3.44.004" x-align="LAM.3.44.a004" x-target-ids="t006 t007" x-target="a cloud" x-target-head="t007" x-head="true" lemma="עָנָן" strong="H6051" x-morph="Ncmsa" x-gloss="cloud" x-translit="ʿānān" xml:lang="hbo">עָנָן֙</char> <char style="w" x-id="WLC.LAM.3.44.005" x-align="LAM.3.44.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="l" xml:lang="hbo">לָ֔</char><char style="w" x-id="WLC.LAM.3.44.006" x-align="LAM.3.44.a006" x-target-ids="t004" x-target="thyself" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="yourself" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.LAM.3.44.007" x-align="LAM.3.44.a007" x-target-ids="t008 t009 t010" x-target="so that no" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.LAM.3.44.008" x-align="LAM.3.44.a008" x-target-ids="t012 t013 t014" x-target="can pass through" x-target-head="t013" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqc" x-gloss="passing.through" x-translit="ʿăḇôr" xml:lang="hbo">עֲב֖