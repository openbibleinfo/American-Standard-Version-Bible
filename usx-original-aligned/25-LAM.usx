	<para style="p"><verse number="20" style="v" x-ref="LAM.3.20" x-added-alignments="LAM.3.20.a003" x-added-target-ids="t004" x-added-target="them" sid="LAM 3:20" /><char style="w" x-id="WLC.LAM.3.20.001" x-align="LAM.3.20.a001" x-target-ids="t005" x-target="still" x-target-head="t005" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqa" x-gloss="continually.(remember)" x-translit="zāḵôr" xml:lang="hbo">זָכ֣וֹר</char> <char style="w" x-id="WLC.LAM.3.20.002" x-align="LAM.3.20.a002" x-target-ids="t003 t006 t007" x-target="hath in remembrance" x-target-head="t007" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqi3fs" x-gloss="it.remembers" x-translit="tizkôr" xml:lang="hbo">תִּזְכּ֔וֹר</char> <char style="w" x-id="WLC.LAM.3.20.003" x-align="LAM.3.20.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.3.20.004" x-align="LAM.3.20.a005" x-target-ids="t009 t010 t011" x-target="is bowed down" x-target-head="t010" x-head="true" lemma="שׁחח" strong="H7817" x-morph="Vqi3fs" x-gloss="it.is.bowed.down" x-translit="**ṯāšôᵃḥ" xml:lang="hbo">תָשׁ֥וֹחַ</char> <char style="w" x-id="WLC.LAM.3.20.005" x-align="LAM.3.20.a006" x-target-ids="t012" x-target="within" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāl" xml:lang="hbo">עָלַ֖</char><char style="w" x-id="WLC.LAM.3.20.006" x-align="LAM.3.20.a007" x-target-ids="t013" x-target="me" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.20.007" x-align="LAM.3.20.a008" x-target-ids="t002" x-target="soul" x-target-head="t002" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִֽׁ</char><char style="w" x-id="WLC.LAM.3.20.008" x-align="LAM.3.20.a009" x-target-id