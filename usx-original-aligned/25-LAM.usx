	<para style="p"><verse number="4" style="v" x-ref="LAM.5.4" sid="LAM 5:4" /><char style="w" x-id="WLC.LAM.5.4.001" x-align="LAM.5.4.a001" x-target-ids="t005" x-target="water" x-target-head="t005" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpc" x-gloss="water" x-translit="mēymēy" xml:lang="hbo">מֵימֵ֨י</char><char style="w" x-id="WLC.LAM.5.4.002" x-align="LAM.5.4.a002" x-target-ids="t004" x-target="our" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ֙</char> <char style="w" x-id="WLC.LAM.5.4.003" x-align="LAM.5.4.a003" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="for" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.5.4.004" x-align="LAM.5.4.a004" x-target-ids="t007" x-target="money" x-target-head="t007" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="money" x-translit="ḵesep̄" xml:lang="hbo">כֶ֣סֶף</char> <char style="w" x-id="WLC.LAM.5.4.005" x-align="LAM.5.4.a005" x-target-ids="t001 t002 t003" x-target="We have drunken" x-target-head="t003" x-head="true" lemma="שָׁתָה" strong="H8354" x-morph="Vqp1cp" x-gloss="we.have.drunk" x-translit="šāṯiynû" xml:lang="hbo">שָׁתִ֔ינוּ</char> <char style="w" x-id="WLC.LAM.5.4.006" x-align="LAM.5.4.a006" x-target-ids="t009" x-target="wood" x-target-head="t009" x-head="true" lemma="עֵץ" strong="H6086" x-morph="Ncmpc" x-gloss="wood(s)" x-translit="ʿēṣēy" xml:lang="hbo">עֵצֵ֖י</char><char style="w" x-id="WLC.LAM.5.4.007" x-align="LAM.5.4.a007" x-target-ids="t008 t012 t013" x-target="Our unto us" x-target-head="t013" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.4.008" x-align="LAM.5.4.a008" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="for" x-translit="bi" xml:lang="hbo">בִּ</char><char st