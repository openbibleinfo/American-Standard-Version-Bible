	<para style="p"><verse number="13" style="v" x-ref="LAM.3.13" sid="LAM 3:13" /><char style="w" x-id="WLC.LAM.3.13.001" x-align="LAM.3.13.a001" x-target-ids="t001 t002 t003 t009 t010" x-target="He hath caused to enter" x-target-head="t010" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vhp3ms" x-gloss="he.has.brought" x-translit="hēḇîʾ" xml:lang="hbo">הֵבִיא֙</char> <char style="w" x-id="WLC.LAM.3.13.002" x-align="LAM.3.13.a002" x-target-ids="t011" x-target="into" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.13.003" x-align="LAM.3.13.a003" x-target-ids="t013" x-target="reins" x-target-head="t013" x-head="true" lemma="כִּלְיָה" strong="H3629" x-morph="Ncfpc" x-gloss="kidneys" x-translit="ḵilyôṯ" xml:lang="hbo">כִלְיוֹתָ֔</char><char style="w" x-id="WLC.LAM.3.13.004" x-align="LAM.3.13.a004" x-target-ids="t012" x-target="my" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.13.005" x-align="LAM.3.13.a005" x-target-ids="t004 t005" x-target="the shafts" x-target-head="t005" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.sons" x-translit="bənēy" xml:lang="hbo">בְּנֵ֖י</char> <char style="w" x-id="WLC.LAM.3.13.006" x-align="LAM.3.13.a006" x-target-ids="t006 t008" x-target="of quiver" x-target-head="t008" x-head="true" lemma="אַשְׁפָּה" strong="H827" x-morph="Ncfsc" x-gloss="his.quiver" x-translit="ʾašpāṯ" xml:lang="hbo">אַשְׁפָּתֽ</char><char style="w" x-id="WLC.LAM.3.13.007" x-align="LAM.3.13.a007" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char>׃<verse eid="LAM 3:13" /></para>
	<para style="p"><verse number="14" style="v" x-ref="LAM.3.14" x-added-alignments="LAM.3.14.a007" x-added-target-ids="t010" x-added-target="and" sid="LAM 3:14" /><char style="w" x-id="WLC.LAM.3.14.001" x-align="LAM.3.14.a001" x-target-ids="t001 t002 t003" x-target="I am become" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cs" x-gloss="I.have.become" x-translit="hāyiyṯî" xml:lang="hbo">הָיִ֤יתִי</char> <char style="w" x-id="WLC.LAM.3.14.002" x-align="LAM.3.14.a002" x-target-ids="t004 t005" x-target="a derision" x-target-head="t005" x-head="true" lemma="שְׂחֹוק" strong="H7814" x-morph="Ncmsa" x-gloss="a.laughing-stock" x-translit="śśəḥōq" xml:lang="hbo">שְּׂחֹק֙</char><char style="w" x-id="WLC.LAM.3.14.003" x-align="LAM.3.14.a003" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.3.14.004" x-align="LAM.3.14.a004" x-target-ids="t007" x-target="all" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.LAM.3.14.005" x-align="LAM.3.14.a005" x-target-ids="t009" x-target="people" x-target-head="t009" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo">עַמִּ֔</char><char style="w" x-id="WLC.LAM.3.14.006" x-align="LAM.3.14.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.14.007" x-align="LAM.3.14.a008" x-target-ids="t012" x-target="song" x-target-head="t012" x-head="true" lemma="נְגִינָה" strong="H5058" x-morph="Ncfsc" x-gloss="song" x-translit="nəḡiynāṯ" xml:lang="hbo">נְגִינָתָ֖</char><char style="w" x-id="WLC.LAM.3.14.008" x-align="LAM.3.14.a009" x-target-ids="t011" x-target="their" x-tar