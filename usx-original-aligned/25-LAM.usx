	<para style="p"><verse number="45" style="v" x-ref="LAM.3.45" sid="LAM 3:45" /><char style="w" x-id="WLC.LAM.3.45.001" x-align="LAM.3.45.a001" x-target-ids="t005 t006" x-target="an offscouring" x-target-head="t006" x-head="true" lemma="סְחִי" strong="H5501" x-morph="Ncmsa" x-gloss="offscouring" x-translit="səḥiy" xml:lang="hbo">סְחִ֧י</char> <char style="w" x-id="WLC.LAM.3.45.002" x-align="LAM.3.45.a002" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.LAM.3.45.003" x-align="LAM.3.45.a003" x-target-ids="t008" x-target="refuse" x-target-head="t008" x-head="true" lemma="מאס" strong="H3973" x-morph="Ncmsa" x-gloss="refuse" x-translit="māʾôs" xml:lang="hbo">מָא֛וֹס</char> <char style="w" x-id="WLC.LAM.3.45.004" x-align="LAM.3.45.a004" x-target-ids="t001 t002 t003" x-target="Thou hast made" x-target-head="t003" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqi2ms" x-gloss="you" x-translit="təśiym" xml:lang="hbo">תְּשִׂימֵ֖</char><char style="w" x-id="WLC.LAM.3.45.005" x-align="LAM.3.45.a005" x-target-ids="t004" x-target="us" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="have.made.us" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.3.45.006" x-align="LAM.3.45.a006" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.45.007" x-align="LAM.3.45.a007" x-target-ids="t010 t011" x-target="the midst" x-target-head="t011" x-head="true" lemma="קֶרֶב" strong="H7130" x-morph="Ncmsc" x-gloss="the.midst" x-translit="qereḇ" xml:lang="hbo">קֶ֥רֶב</char> <char style="w" x-id="WLC.LAM.3.45.008" x-align="LAM.3.45.a008" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-