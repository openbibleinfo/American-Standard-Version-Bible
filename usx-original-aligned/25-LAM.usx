	<para style="p"><verse number="21" style="v" x-ref="LAM.2.21" x-added-alignments="LAM.2.21.a019 LAM.2.21.a025" x-added-target-ids="t028 t038" x-added-target="them | and" sid="LAM 2:21" /><char style="w" x-id="WLC.LAM.2.21.001" x-align="LAM.2.21.a001" x-target-ids="t007" x-target="lie" x-target-head="t007" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqp3cp" x-gloss="they.have.lain.down" x-translit="šāḵəḇû" xml:lang="hbo">שָׁכְב֨וּ</char> <char style="w" x-id="WLC.LAM.2.21.002" x-align="LAM.2.21.a002" x-target-ids="t008" x-target="on" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.LAM.2.21.003" x-align="LAM.2.21.a003" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LAM.2.21.004" x-align="LAM.2.21.a004" x-target-ids="t010" x-target="ground" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="ground" x-translit="ʾāreṣ" xml:lang="hbo">אָ֤רֶץ</char> <char style="w" x-id="WLC.LAM.2.21.005" x-align="LAM.2.21.a005" x-target-ids="t011 t012 t013" x-target="in the streets" x-target-head="t013" x-head="true" lemma="חוּץ" strong="H2351" x-morph="Ncmpa" x-gloss="streets" x-translit="ḥûṣôṯ" xml:lang="hbo">חוּצוֹת֙</char> <char style="w" x-id="WLC.LAM.2.21.006" x-align="LAM.2.21.a006" x-target-ids="t001 t002" x-target="The youth" x-target-head="t002" x-head="true" lemma="נַעַר" strong="H5288" x-morph="Ncmsa" x-gloss="youth" x-translit="naʿar" xml:lang="hbo">נַ֣עַר</char> <char style="w" x-id="WLC.LAM.2.21.007" x-align="LAM.2.21.a007" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.2.21.008" x-align="LAM.2.21.a008" x-target-ids="t004 t005 t006" x-t