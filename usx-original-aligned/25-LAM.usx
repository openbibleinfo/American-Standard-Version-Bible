	<para style="p"><verse number="17" style="v" x-ref="LAM.2.17" sid="LAM 2:17" /><char style="w" x-id="WLC.LAM.2.17.001" x-align="LAM.2.17.a001" x-target-ids="t002 t003" x-target="hath done" x-target-head="t003" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3ms" x-gloss="he.has.done" x-translit="ʿāśāh" xml:lang="hbo">עָשָׂ֨ה</char> <char style="w" x-id="WLC.LAM.2.17.002" x-align="LAM.2.17.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֜ה</char> <char style="w" x-id="WLC.LAM.2.17.003" x-align="LAM.2.17.a003" x-target-ids="t004 t005" x-target="that which" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="what" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.LAM.2.17.004" x-align="LAM.2.17.a004" x-target-ids="t006 t007" x-target="he purposed" x-target-head="t007" x-head="true" lemma="זָמַם" strong="H2161" x-morph="Vqp3ms" x-gloss="he.planned" x-translit="zāmām" xml:lang="hbo">זָמָ֗ם</char> <char style="w" x-id="WLC.LAM.2.17.005" x-align="LAM.2.17.a005" x-target-ids="t008 t009 t010" x-target="he hath fulfilled" x-target-head="t010" x-head="true" lemma="בָּצַע" strong="H1214" x-morph="Vpp3ms" x-gloss="he.has.fulfilled" x-translit="biṣṣaʿ" xml:lang="hbo">בִּצַּ֤ע</char> <char style="w" x-id="WLC.LAM.2.17.006" x-align="LAM.2.17.a006" x-target-ids="t012" x-target="word" x-target-head="t012" x-head="true" lemma="אֶמְרָה" strong="H565a" x-morph="Ncfsc" x-gloss="word" x-translit="ʾemrāṯ" xml:lang="hbo">אֶמְרָת</char><char style="w" x-id="WLC.LAM.2.17.007" x-align="LAM.2.17.a007" x-target-ids="t011" x-target="his" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ֙</char> <char style="w" x-id="WLC.LAM.2.17.008" x-align="LAM.2.17.a008" x-target-ids="t013" x-target="that" x-target-head="t013" x-head="true"