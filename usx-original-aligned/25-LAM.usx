	<para style="p"><verse number="10" style="v" x-ref="LAM.1.10" x-added-alignments="LAM.1.10.a011 LAM.1.10.a018" x-added-target-ids="t017 t030" x-added-target="that | that" sid="LAM 1:10" /><char style="w" x-id="WLC.LAM.1.10.001" x-align="LAM.1.10.a004" x-target-ids="t007" x-target="hand" x-target-head="t007" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָד</char><char style="w" x-id="WLC.LAM.1.10.002" x-align="LAM.1.10.a003" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ֙</char> <char style="w" x-id="WLC.LAM.1.10.003" x-align="LAM.1.10.a002" x-target-ids="t003 t004 t005" x-target="hath spread out" x-target-head="t004" x-head="true" lemma="פָּרַשׂ" strong="H6566" x-morph="Vqp3ms" x-gloss="he.has.spread.out" x-translit="pāraś" xml:lang="hbo">פָּ֣רַשׂ</char> <char style="w" x-id="WLC.LAM.1.10.004" x-align="LAM.1.10.a001" x-target-ids="t001 t002" x-target="The adversary" x-target-head="t002" x-head="true" lemma="צַר" strong="H6862a" x-morph="Ncmsa" x-gloss="[the].foe" x-translit="ṣār" xml:lang="hbo">צָ֔ר</char> <char style="w" x-id="WLC.LAM.1.10.005" x-align="LAM.1.10.a005" x-target-ids="t008" x-target="upon" x-target-head="t008" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal" xml:lang="hbo">עַ֖ל</char> <char style="w" x-id="WLC.LAM.1.10.006" x-align="LAM.1.10.a006" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LAM.1.10.007" x-align="LAM.1.10.a008" x-target-ids="t011 t012" x-target="pleasant things" x-target-head="t011" x-head="true" lemma="מַחְמָד" strong="H4261" x-morph="Ncmpc" x-gloss="things" x-translit="maḥămaddey" xml:lang="hbo">מַחֲמַדֶּ֑י</char><char style="w" x-id="WLC.LAM.1.10.008" x-align="LAM.1.10.a00