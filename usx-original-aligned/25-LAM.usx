	<para style="p"><verse number="23" style="v" x-ref="LAM.3.23" sid="LAM 3:23" /><char style="w" x-id="WLC.LAM.3.23.001" x-align="LAM.3.23.a001" x-target-ids="t001 t002 t003" x-target="They are new" x-target-head="t003" x-head="true" lemma="חָדָשׁ" strong="H2319" x-morph="Aampa" x-gloss="[they.are].new" x-translit="ḥăḏāšîm" xml:lang="hbo">חֲדָשִׁים֙</char> <char style="w" x-id="WLC.LAM.3.23.002" x-align="LAM.3.23.a002" x-target-ids="t004" x-target="every" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.LAM.3.23.003" x-align="LAM.3.23.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LAM.3.23.004" x-align="LAM.3.23.a004" x-target-ids="t005" x-target="morning" x-target-head="t005" x-head="true" lemma="בֹּקֶר" strong="H1242" x-morph="Ncmpa" x-gloss="mornings" x-translit="bəqāriym" xml:lang="hbo">בְּקָרִ֔ים</char> <char style="w" x-id="WLC.LAM.3.23.005" x-align="LAM.3.23.a005" x-target-ids="t006 t007" x-target="great is" x-target-head="t006" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafsa" x-gloss="[is].great" x-translit="rabbāh" xml:lang="hbo">רַבָּ֖ה</char> <char style="w" x-id="WLC.LAM.3.23.006" x-align="LAM.3.23.a006" x-target-ids="t009" x-target="faithfulness" x-target-head="t009" x-head="true" lemma="אֱמוּנָה" strong="H530" x-morph="Ncfsc" x-gloss="faithfulness" x-translit="ʾĕmûnāṯ" xml:lang="hbo">אֱמוּנָתֶֽ</char><char style="w" x-id="WLC.LAM.3.23.007" x-align="LAM.3.23.a007" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char>׃<verse eid="LAM 3:23" /></para>
	<para style="p"><verse number="24" style="v" x-ref="LAM.3.24" sid="LAM 3:24" /><char style="w" x-id="WLC.LAM.3.24.001" x-align="LAM.3.24.a001" x-target-ids="t002 t004" x-target="is portion" x-target-head="t004" x-head="true" lemma="חֵלֶק" strong="H2506" x-morph="Ncmsc" x-gloss="portion" x-translit="ḥelq" xml:lang="hbo">חֶלְקִ֤</char><char style="w" x-id="WLC.LAM.3.24.002" x-align="LAM.3.24.a002" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[is].my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.24.003" x-align="LAM.3.24.a003" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.LAM.3.24.004" x-align="LAM.3.24.a004" x-target-ids="t005" x-target="saith" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3fs" x-gloss="it.has.said" x-translit="ʾāmərāh" xml:lang="hbo">אָמְרָ֣ה</char> <char style="w" x-id="WLC.LAM.3.24.005" x-align="LAM.3.24.a005" x-target-ids="t007" x-target="soul" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֔</char><char style="w" x-id="WLC.LAM.3.24.006" x-align="LAM.3.24.a006" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.24.007" x-align="LAM.3.24.a007" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.LAM.3.24.008" x-align="LAM.3.24.a007" x-target-ids="t008" x-target="therefore" x-target-head="t008" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֖ן</char> <char style="w" x-id="WLC.LAM.3.24.009" x-align="LAM.3.24.a0