	<para style="p"><verse number="15" style="v" x-ref="LAM.3.15" sid="LAM 3:15" /><char style="w" x-id="WLC.LAM.3.15.001" x-align="LAM.3.15.a001" x-target-ids="t001 t002 t003" x-target="He hath filled" x-target-head="t003" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vhp3ms" x-gloss="he" x-translit="hiśbiyʿ" xml:lang="hbo">הִשְׂבִּיעַ֥</char><char style="w" x-id="WLC.LAM.3.15.002" x-align="LAM.3.15.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.surfeited.me" x-translit="aniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.LAM.3.15.003" x-align="LAM.3.15.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="with.(the)" x-translit="ḇa" xml:lang="hbo">בַ</char><char style="w" x-id="WLC.LAM.3.15.004" x-align="LAM.3.15.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="bitter" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LAM.3.15.005" x-align="LAM.3.15.a005" x-target-ids="t006" x-target="bitterness" x-target-head="t006" x-head="true" lemma="מָרֹר" strong="H4844" x-morph="Ncmpa" x-gloss="things" x-translit="mmərôriym" xml:lang="hbo">מְּרוֹרִ֖ים</char> <char style="w" x-id="WLC.LAM.3.15.006" x-align="LAM.3.15.a006" x-target-ids="t007 t008 t009" x-target="he hath sated" x-target-head="t009" x-head="true" lemma="רָוָה" strong="H7301" x-morph="Vhp3ms" x-gloss="he" x-translit="hirw" xml:lang="hbo">הִרְוַ֥</char><char style="w" x-id="WLC.LAM.3.15.007" x-align="LAM.3.15.a007" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.made.me.drink" x-translit="aniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.LAM.3.15.008" x-align="LAM.3.15.a008" x-target-ids="t011 t012" x-target="with wormwood" x-target-head="t012" x-head="true" lemma="לַעֲנָה" strong="H3939" x-morph="N