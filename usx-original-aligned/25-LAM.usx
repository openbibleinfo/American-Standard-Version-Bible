	<para style="p"><verse number="57" style="v" x-ref="LAM.3.57" sid="LAM 3:57" /><char style="w" x-id="WLC.LAM.3.57.001" x-align="LAM.3.57.a001" x-target-ids="t001 t002 t003" x-target="Thou drewest near" x-target-head="t002" x-head="true" lemma="קָרַב" strong="H7126" x-morph="Vqp2ms" x-gloss="you.drew.near" x-translit="qāraḇətā" xml:lang="hbo">קָרַ֨בְתָּ֙</char> <char style="w" x-id="WLC.LAM.3.57.002" x-align="LAM.3.57.a002" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.57.003" x-align="LAM.3.57.a003" x-target-ids="t005 t006" x-target="the day" x-target-head="t006" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yôm" xml:lang="hbo">י֣וֹם</char> <char style="w" x-id="WLC.LAM.3.57.004" x-align="LAM.3.57.a004" x-target-ids="t007 t008 t009 t010" x-target="that I called upon" x-target-head="t009" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi1cs" x-gloss="[when].I" x-translit="ʾeqrāʾ" xml:lang="hbo">אֶקְרָאֶ֔</char><char style="w" x-id="WLC.LAM.3.57.005" x-align="LAM.3.57.a005" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="called.on.you" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.LAM.3.57.006" x-align="LAM.3.57.a006" x-target-ids="t012 t013" x-target="thou saidst" x-target-head="t013" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp2ms" x-gloss="you.said" x-translit="ʾāmarətā" xml:lang="hbo">אָמַ֖רְתָּ</char> <char style="w" x-id="WLC.LAM.3.57.007" x-align="LAM.3.57.a007" x-target-ids="t015" x-target="not" x-target-head="t015" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.LAM.3.57.008" x-align="LAM.3.57.a008" x-target-ids="t014" x-target="Fear" x-target-head="t014" x-head="t