	<para style="p"><verse number="3" style="v" x-ref="LAM.4.3" sid="LAM 4:3" /><char style="w" x-id="WLC.LAM.4.3.001" x-align="LAM.4.3.a001" x-target-ids="t001" x-target="Even" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.LAM.4.3.002" x-align="LAM.4.3.a002" x-target-ids="t002 t003" x-target="the jackals" x-target-head="t003" x-head="true" lemma="תַּן" strong="H8565" x-morph="Ncbpa" x-gloss="jackals" x-translit="**tannîm" xml:lang="hbo">תַּנִּים֙</char> <char style="w" x-id="WLC.LAM.4.3.003" x-align="LAM.4.3.a003" x-target-ids="t004 t005" x-target="draw out" x-target-head="t004" x-head="true" lemma="חָלַץ" strong="H2502" x-morph="Vqp3cp" x-gloss="they.draw.out" x-translit="ḥāləṣû" xml:lang="hbo">חָ֣לְצוּ</char> <char style="w" x-id="WLC.LAM.4.3.004" x-align="LAM.4.3.a004" x-target-ids="t006 t007" x-target="the breast" x-target-head="t007" x-head="true" lemma="שַׁד" strong="H7699" x-morph="Ncmsa" x-gloss="a.breast" x-translit="šaḏ" xml:lang="hbo">שַׁ֔ד</char> <char style="w" x-id="WLC.LAM.4.3.005" x-align="LAM.4.3.a005" x-target-ids="t008 t009 t010 t011" x-target="they give suck to" x-target-head="t010" x-head="true" lemma="יָנַק" strong="H3243" x-morph="Vhp3cp" x-gloss="they.suckle" x-translit="hêniyqû" xml:lang="hbo">הֵינִ֖יקוּ</char> <char style="w" x-id="WLC.LAM.4.3.006" x-align="LAM.4.3.a006" x-target-ids="t013 t014" x-target="young ones" x-target-head="t013" x-head="true" lemma="גּוּר" strong="H1482" x-morph="Ncmpc" x-gloss="cubs" x-translit="gûrēy" xml:lang="hbo">גּוּרֵי</char><char style="w" x-id="WLC.LAM.4.3.007" x-align="LAM.4.3.a007" x-target-ids="t012" x-target="their" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2004" x-morph="Sp3fp" x-gloss="their" x-translit="hen" xml:lang="hbo">הֶ֑ן</char> <char style="w" x-id="WLC.LAM.4.3.008" x-align="LAM.4.3.a008" x-target-ids="t015 t016" x-target="The daughter" x-target-head="t016" x-head="