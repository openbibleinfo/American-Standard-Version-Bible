	<para style="p"><verse number="21" style="v" x-ref="LAM.5.21" sid="LAM 5:21" /><char style="w" x-id="WLC.LAM.5.21.001" x-align="LAM.5.21.a001" x-target-ids="t001 t002" x-target="Turn thou" x-target-head="t001" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhv2ms" x-gloss="restore" x-translit="hăšiyḇ" xml:lang="hbo">הֲשִׁיבֵ֨</char><char style="w" x-id="WLC.LAM.5.21.002" x-align="LAM.5.21.a002" x-target-ids="t003" x-target="us" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.21.003" x-align="LAM.5.21.a003" x-target-ids="t006 t007" x-target="O Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֤ה</char>׀<char style="w" x-id="WLC.LAM.5.21.004" x-align="LAM.5.21.a004" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēley" xml:lang="hbo">אֵלֶ֨י</char><char style="w" x-id="WLC.LAM.5.21.005" x-align="LAM.5.21.a005" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="yourself" x-translit="ḵā" xml:lang="hbo">ךָ֙</char> <char style="w" x-id="WLC.LAM.5.21.006" x-align="LAM.5.21.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="so" x-translit="**wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.LAM.5.21.007" x-align="LAM.5.21.a007" x-target-ids="t009 t010 t011 t012" x-target="we shall be turned" x-target-head="t012" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqh1cp" x-gloss="that.we.may.return" x-translit="**nāšûḇâ" xml:lang="hbo">נָשׁ֔וּבָה</char> <char style="w" x-id="WLC.LAM.5.21.008" x-align="LAM.5.21.a008" x-target-ids="t013" x-target="Renew" x-target-head="t013" x-head="true" lemma="חָדַשׁ" strong="H2318" x-morph=