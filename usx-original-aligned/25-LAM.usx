	<para style="p"><verse number="42" style="v" x-ref="LAM.3.42" sid="LAM 3:42" /><char style="w" x-id="WLC.LAM.3.42.001" x-align="LAM.3.42.a001" x-target-ids="t001" x-target="We" x-target-head="t001" x-head="true" lemma="נַחְנוּ" strong="H5168" x-morph="Pp1cp" x-gloss="we" x-translit="naḥənû" xml:lang="hbo">נַ֤חְנוּ</char> <char style="w" x-id="WLC.LAM.3.42.002" x-align="LAM.3.42.a002" x-target-ids="t002 t003" x-target="have transgressed" x-target-head="t003" x-head="true" lemma="פָּשַׁע" strong="H6586" x-morph="Vqp1cp" x-gloss="we.have.transgressed" x-translit="p̄āšaʿənû" xml:lang="hbo">פָשַׁ֨עְנוּ֙</char> <char style="w" x-id="WLC.LAM.3.42.003" x-align="LAM.3.42.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.LAM.3.42.004" x-align="LAM.3.42.a004" x-target-ids="t005 t006" x-target="have rebelled" x-target-head="t006" x-head="true" lemma="מָרָה" strong="H4784" x-morph="Vqp1cp" x-gloss="we.have.rebelled" x-translit="māriynû" xml:lang="hbo">מָרִ֔ינוּ</char> <char style="w" x-id="WLC.LAM.3.42.005" x-align="LAM.3.42.a005" x-target-ids="t007" x-target="thou" x-target-head="t007" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֖ה</char> <char style="w" x-id="WLC.LAM.3.42.006" x-align="LAM.3.42.a006" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LAM.3.42.007" x-align="LAM.3.42.a007" x-target-ids="t008 t010" x-target="hast pardoned" x-target-head="t010" x-head="true" lemma="סָלַח" strong="H5545" x-morph="Vqp2ms" x-gloss="you.have.forgiven" x-translit="sālāḥətā:" xml:lang="hbo">סָלָֽחְתָּ</char>׃ס<verse eid="LAM 3:42" /></para>
	<para style="p"><verse number="43" style="v" x-ref="LAM.3.43" sid="LAM 3:43" /><char style="w" x-id="WLC.LAM.3.43.001" x-align="LAM.3.43.a001" x-target-ids="t001 t002 t003" x-target="Thou hast covered" x-target-head="t003" x-head="true" lemma="סָכַךְ" strong="H5526" x-morph="Vqp2ms" x-gloss="you.have.covered.yourself" x-translit="sakkōṯâ" xml:lang="hbo">סַכֹּ֤תָה</char> <char style="w" x-id="WLC.LAM.3.43.002" x-align="LAM.3.43.a002" x-target-ids="t004" x-target="with" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇā" xml:lang="hbo">בָ</char><char style="w" x-id="WLC.LAM.3.43.003" x-align="LAM.3.43.a003" x-target-ids="t005" x-target="anger" x-target-head="t005" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsa" x-gloss="anger" x-translit="ʾap̄" xml:lang="hbo">אַף֙</char> <char style="w" x-id="WLC.LAM.3.43.004" x-align="LAM.3.43.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.LAM.3.43.005" x-align="LAM.3.43.a005" x-target-ids="t007" x-target="pursued" x-target-head="t007" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vqw2ms" x-gloss="you" x-translit="tirdəp̄" xml:lang="hbo">תִּרְדְּפֵ֔</char><char style="w" x-id="WLC.LAM.3.43.006" x-align="LAM.3.43.a006" x-target-ids="t008" x-target="us" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="have.pursued.us" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.3.43.007" x-align="LAM.3.43.a007" x-target-ids="t009 t010 t011" x-target="thou hast slain" x-target-head="t011" x-head="true" lemma="הָרַג" strong="H2026" x-morph="Vqp2ms" x-gloss="you.have.killed" x-translit="hāraḡətā" xml:lang="hbo">הָרַ֖גְתָּ</char> <char style="w" x-id="WLC.LAM.3.43.008" x-align="LAM.3.43.a008" x-target-ids="t014" x-target="not" x-target-head="t014" x-head="true" lemma="לֹא" st