	<para style="p"><verse number="60" style="v" x-ref="LAM.3.60" x-added-alignments="LAM.3.60.a005" x-added-target-ids="t007" x-added-target="and" sid="LAM 3:60" /><char style="w" x-id="WLC.LAM.3.60.001" x-align="LAM.3.60.a001" x-target-ids="t001 t002 t003" x-target="Thou hast seen" x-target-head="t003" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp2ms" x-gloss="you.have.seen" x-translit="rāʾiyṯāh" xml:lang="hbo">רָאִ֨יתָה֙</char> <char style="w" x-id="WLC.LAM.3.60.002" x-align="LAM.3.60.a002" x-target-ids="t004" x-target="all" x-target-head="t004" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LAM.3.60.003" x-align="LAM.3.60.a003" x-target-ids="t006" x-target="vengeance" x-target-head="t006" x-head="true" lemma="נְקָמָה" strong="H5360" x-morph="Ncfsc" x-gloss="vengeance" x-translit="niqmāṯ" xml:lang="hbo">נִקְמָתָ֔</char><char style="w" x-id="WLC.LAM.3.60.004" x-align="LAM.3.60.a004" x-target-ids="t005" x-target="their" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.LAM.3.60.005" x-align="LAM.3.60.a006" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.LAM.3.60.006" x-align="LAM.3.60.a007" x-target-ids="t010" x-target="devices" x-target-head="t010" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpc" x-gloss="plans" x-translit="maḥšəḇōṯ" xml:lang="hbo">מַחְשְׁבֹתָ֖</char><char style="w" x-id="WLC.LAM.3.60.007" x-align="LAM.3.60.a008" x-target-ids="t009" x-target="their" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.LAM.3.60.008" x-align="LAM.3.60.a009" x-target-ids="t011" x-target