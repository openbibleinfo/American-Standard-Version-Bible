	<para style="p"><verse number="5" style="v" x-ref="LAM.3.5" x-added-alignments="LAM.3.5.a006" x-added-target-ids="t008" x-added-target="me" sid="LAM 3:5" /><char style="w" x-id="WLC.LAM.3.5.001" x-align="LAM.3.5.a001" x-target-ids="t001 t002 t003" x-target="He hath builded" x-target-head="t003" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="Vqp3ms" x-gloss="he.has.built" x-translit="bānāh" xml:lang="hbo">בָּנָ֥ה</char> <char style="w" x-id="WLC.LAM.3.5.002" x-align="LAM.3.5.a002" x-target-ids="t004" x-target="against" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāl" xml:lang="hbo">עָלַ֛</char><char style="w" x-id="WLC.LAM.3.5.003" x-align="LAM.3.5.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.5.004" x-align="LAM.3.5.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LAM.3.5.005" x-align="LAM.3.5.a005" x-target-ids="t007" x-target="compassed" x-target-head="t007" x-head="true" lemma="נָקַף" strong="H5362a" x-morph="Vhw3ms" x-gloss="he.has.surrounded.[me]" x-translit="yyaqqap̄" xml:lang="hbo">יַּקַּ֖ף</char> <char style="w" x-id="WLC.LAM.3.5.006" x-align="LAM.3.5.a007" x-target-ids="t009 t010" x-target="with gall" x-target-head="t010" x-head="true" lemma="רֹאשׁ" strong="H7219" x-morph="Ncmsa" x-gloss="poison" x-translit="rōʾš" xml:lang="hbo">רֹ֥אשׁ</char> <char style="w" x-id="WLC.LAM.3.5.007" x-align="LAM.3.5.a008" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.LAM.3.5.008" x-align="LAM.3.5.a009" x-target-ids="t012" x-target="travail" x-target-head="t012" x-head="true" l