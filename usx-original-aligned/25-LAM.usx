	<para style="p"><verse number="4" style="v" x-ref="LAM.3.4" sid="LAM 3:4" /><char style="w" x-id="WLC.LAM.3.4.001" x-align="LAM.3.4.a001" x-target-ids="t006 t007 t008 t009" x-target="hath he made old" x-target-head="t009" x-head="true" lemma="בָּלָה" strong="H1086" x-morph="Vpp3ms" x-gloss="he.has.made.to.waste.away" x-translit="billāh" xml:lang="hbo">בִּלָּ֤ה</char> <char style="w" x-id="WLC.LAM.3.4.002" x-align="LAM.3.4.a002" x-target-ids="t002" x-target="flesh" x-target-head="t002" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmsc" x-gloss="flesh" x-translit="ḇəśār" xml:lang="hbo">בְשָׂרִ</char><char style="w" x-id="WLC.LAM.3.4.003" x-align="LAM.3.4.a003" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י֙</char> <char style="w" x-id="WLC.LAM.3.4.004" x-align="LAM.3.4.a004" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.3.4.005" x-align="LAM.3.4.a005" x-target-ids="t005" x-target="skin" x-target-head="t005" x-head="true" lemma="עוֹר" strong="H5785" x-morph="Ncmsc" x-gloss="skin" x-translit="ʿôr" xml:lang="hbo">עוֹרִ֔</char><char style="w" x-id="WLC.LAM.3.4.006" x-align="LAM.3.4.a006" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.4.007" x-align="LAM.3.4.a007" x-target-ids="t010 t011 t012" x-target="he hath broken" x-target-head="t012" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="Vpp3ms" x-gloss="he.has.broken" x-translit="šibbar" xml:lang="hbo">שִׁבַּ֖ר</char> <char style="w" x-id="WLC.LAM.3.4.008" x-align="LAM.3.4.a008" x-target-ids="t014" x-target="bones" x-target-head="t014" x-head="true" lemma="עֶצֶם" strong="H6106" x-morph="Ncfpc" x-gloss="