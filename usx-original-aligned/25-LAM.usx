	<para style="p"><verse number="1" style="v" x-ref="LAM.4.1" sid="LAM 4:1" /><char style="w" x-id="WLC.LAM.4.1.001" x-align="LAM.4.1.a001" x-target-ids="t001 t007" x-target="How how" x-target-italic-ids="t007" x-target-head="t001" x-head="true" lemma="אֵיכָה" strong="H349a" x-morph="Ti" x-gloss="how!" x-translit="ʾêḵāh" xml:lang="hbo">אֵיכָה֙</char> <char style="w" x-id="WLC.LAM.4.1.002" x-align="LAM.4.1.a002" x-target-ids="t002 t005 t006" x-target="is become dim" x-target-head="t006" x-head="true" lemma="עָמַם" strong="H6004" x-morph="VHi3ms" x-gloss="it.is.dimmed" x-translit="yûʿam" xml:lang="hbo">יוּעַ֣ם</char> <char style="w" x-id="WLC.LAM.4.1.003" x-align="LAM.4.1.a003" x-target-ids="t003 t004" x-target="the gold" x-target-head="t004" x-head="true" lemma="זָהָב" strong="H2091" x-morph="Ncmsa" x-gloss="gold" x-translit="zāhāḇ" xml:lang="hbo">זָהָ֔ב</char> <char style="w" x-id="WLC.LAM.4.1.004" x-align="LAM.4.1.a004" x-target-ids="t008 t013" x-target="is changed" x-target-head="t013" x-head="true" lemma="שָׁנָא" strong="H8132" x-morph="Vqi3ms" x-gloss="it.is.changed" x-translit="yišneʾ" xml:lang="hbo">יִשְׁנֶ֖א</char> <char style="w" x-id="WLC.LAM.4.1.005" x-align="LAM.4.1.a005" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.LAM.4.1.006" x-align="LAM.4.1.a006" x-target-ids="t012" x-target="gold" x-target-head="t012" x-head="true" lemma="כֶּתֶם" strong="H3800" x-morph="Ncmsa" x-gloss="gold" x-translit="keṯem" xml:lang="hbo">כֶּ֣תֶם</char> <char style="w" x-id="WLC.LAM.4.1.007" x-align="LAM.4.1.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.LAM.4.1.008" x-align="LAM.4.1.a008" x-target-ids="t010 t011" x-target="most pure" x-target-head="t011" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss=