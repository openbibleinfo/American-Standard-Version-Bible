	<para style="p"><verse number="3" style="v" x-ref="LAM.5.3" sid="LAM 5:3" /><char style="w" x-id="WLC.LAM.5.3.001" x-align="LAM.5.3.a001" x-target-ids="t003" x-target="orphans" x-target-head="t003" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmpa" x-gloss="fatherless.ones" x-translit="yəṯômiym" xml:lang="hbo">יְתוֹמִ֤ים</char> <char style="w" x-id="WLC.LAM.5.3.002" x-align="LAM.5.3.a002" x-target-ids="t001 t002" x-target="We are" x-target-head="t002" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cp" x-gloss="we.have.become" x-translit="hāyiynû" xml:lang="hbo">הָיִ֨ינוּ֙</char> <char style="w" x-id="WLC.LAM.5.3.003" x-align="LAM.5.3.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.LAM.5.3.004" x-align="LAM.5.3.a004" x-target-ids="t005" x-target="fatherless" x-target-head="t005" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="**ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.LAM.5.3.005" x-align="LAM.5.3.a004" lemma="אָב" strong="H1" x-morph="Ncmsa" x-gloss="a.father" x-translit="ʾāḇ" xml:lang="hbo">אָ֔ב</char> <char style="w" x-id="WLC.LAM.5.3.006" x-align="LAM.5.3.a005" x-target-ids="t007" x-target="mothers" x-target-head="t007" x-head="true" lemma="אֵם" strong="H517" x-morph="Ncfpc" x-gloss="mothers" x-translit="ʾimmōṯēy" xml:lang="hbo">אִמֹּתֵ֖י</char><char style="w" x-id="WLC.LAM.5.3.007" x-align="LAM.5.3.a006" x-target-ids="t006" x-target="Our" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.3.008" x-align="LAM.5.3.a007" x-target-ids="t008 t009" x-target="are as" x-target-head="t009" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="[are].like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.