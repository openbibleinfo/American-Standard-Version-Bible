	<para style="p"><verse number="16" style="v" x-ref="LAM.3.16" sid="LAM 3:16" /><char style="w" x-id="WLC.LAM.3.16.001" x-align="LAM.3.16.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LAM.3.16.002" x-align="LAM.3.16.a002" x-target-ids="t001 t002 t004" x-target="He hath broken" x-target-head="t004" x-head="true" lemma="גָּרַס" strong="H1638" x-morph="Vhw3ms" x-gloss="he.has.broken" x-translit="yyaḡrēs" xml:lang="hbo">יַּגְרֵ֤ס</char> <char style="w" x-id="WLC.LAM.3.16.003" x-align="LAM.3.16.a003" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="with" x-translit="be" xml:lang="hbo">בֶּֽ</char><char style="w" x-id="WLC.LAM.3.16.004" x-align="LAM.3.16.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.LAM.3.16.005" x-align="LAM.3.16.a005" x-target-ids="t008 t009" x-target="gravel stones" x-target-head="t008" x-head="true" lemma="חָצָץ" strong="H2687" x-morph="Ncmsa" x-gloss="gravel" x-translit="ḥāṣāṣ" xml:lang="hbo">חָצָץ֙</char> <char style="w" x-id="WLC.LAM.3.16.006" x-align="LAM.3.16.a006" x-target-ids="t006" x-target="teeth" x-target-head="t006" x-head="true" lemma="שֵׁן" strong="H8127" x-morph="Ncbdc" x-gloss="teeth" x-translit="šinn" xml:lang="hbo">שִׁנָּ֔</char><char style="w" x-id="WLC.LAM.3.16.007" x-align="LAM.3.16.a007" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.16.008" x-align="LAM.3.16.a008" x-target-ids="t010 t011 t012" x-target="he hath covered" x-target-head="t012" x-head="true" lemma="כָּפַשׁ" strong="H3728" x-morph="Vhp3ms" x-gloss="he" x-translit="hiḵpiyš" xml:lan