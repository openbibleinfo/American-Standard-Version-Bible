	<para style="p"><verse number="25" style="v" x-ref="LAM.3.25" sid="LAM 3:25" /><char style="w" x-id="WLC.LAM.3.25.001" x-align="LAM.3.25.a001" x-target-ids="t002 t003" x-target="is good" x-target-head="t003" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֤וֹב</char> <char style="w" x-id="WLC.LAM.3.25.002" x-align="LAM.3.25.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.LAM.3.25.003" x-align="LAM.3.25.a003" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.3.25.004" x-align="LAM.3.25.a004" x-target-ids="t005 t006 t007 t008" x-target="them that wait for" x-target-head="t007" x-head="true" lemma="קָוָה" strong="H6960" x-morph="Vqrmpc" x-gloss="[those" x-translit="qô" xml:lang="hbo">קוָֹ֔</char><char style="w" x-id="WLC.LAM.3.25.005" x-align="LAM.3.25.a005" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="who].wait.for.him" x-translit="āw" xml:lang="hbo">ו</char><char style="w" x-id="WLC.LAM.3.25.006" x-align="LAM.3.25.a006" x-target-ids="t010" x-target="to" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.3.25.007" x-align="LAM.3.25.a007" x-target-ids="t011 t012" x-target="the soul" x-target-head="t012" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsa" x-gloss="anyone" x-translit="nep̄eš" xml:lang="hbo">נֶ֖פֶשׁ</char> <char style="w" x-id="WLC.LAM.3.25.008" x-align="LAM.3.25.a008" x-target-ids="t013 t014" x-target="that seeketh" x-target-head="t014" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqi3fs" x-g