	<para style="p"><verse number="20" style="v" x-ref="LAM.5.20" x-added-alignments="LAM.5.20.a008" x-added-target-ids="t008" x-added-target="And" sid="LAM 5:20" /><char style="w" x-id="WLC.LAM.5.20.001" x-align="LAM.5.20.a001" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo">לָ֤</char><char style="w" x-id="WLC.LAM.5.20.002" x-align="LAM.5.20.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ" xml:lang="hbo">מָּה</char> <char style="w" x-id="WLC.LAM.5.20.003" x-align="LAM.5.20.a002" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.LAM.5.20.004" x-align="LAM.5.20.a003" x-target-ids="t007" x-target="ever" x-target-head="t007" x-head="true" lemma="נֵצַח" strong="H5331" x-morph="Ncmsa" x-gloss="perpetuity" x-translit="neṣaḥ" xml:lang="hbo">נֶ֨צַח֙</char> <char style="w" x-id="WLC.LAM.5.20.005" x-align="LAM.5.20.a004" x-target-ids="t002 t003 t004" x-target="dost thou forget" x-target-head="t004" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqi2ms" x-gloss="do" x-translit="tiškāḥ" xml:lang="hbo">תִּשְׁכָּחֵ֔</char><char style="w" x-id="WLC.LAM.5.20.006" x-align="LAM.5.20.a005" x-target-ids="t005" x-target="us" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="you.forget.us" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.20.007" x-align="LAM.5.20.a006" x-target-ids="t009" x-target="forsake" x-target-head="t009" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqi2ms" x-gloss="do" x-translit="taʿazḇ" xml:lang="hbo">תַּֽעַזְבֵ֖</char><char style="w" x-id="WLC.LAM.5.20.008" x-align="LAM.5.20.a007" x-target-ids="t010" x-target="us" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="you.abandon.us?" x-tran