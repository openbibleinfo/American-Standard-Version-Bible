	<para style="p"><verse number="21" style="v" x-ref="LAM.3.21" sid="LAM 3:21" /><char style="w" x-id="WLC.LAM.3.21.001" x-align="LAM.3.21.a001" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֛את</char> <char style="w" x-id="WLC.LAM.3.21.002" x-align="LAM.3.21.a002" x-target-ids="t002 t003" x-target="I recall" x-target-head="t003" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhi1cs" x-gloss="I.bring.back" x-translit="ʾāšiyḇ" xml:lang="hbo">אָשִׁ֥יב</char> <char style="w" x-id="WLC.LAM.3.21.003" x-align="LAM.3.21.a003" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LAM.3.21.004" x-align="LAM.3.21.a004" x-target-ids="t006" x-target="mind" x-target-head="t006" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֖</char><char style="w" x-id="WLC.LAM.3.21.005" x-align="LAM.3.21.a005" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.21.006" x-align="LAM.3.21.a006" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.LAM.3.21.007" x-align="LAM.3.21.a006" x-target-ids="t007" x-target="therefore" x-target-head="t007" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֥ן</char> <char style="w" x-id="WLC.LAM.3.21.008" x-align="LAM.3.21.a007" x-target-ids="t008 t009 t010" x-target="have I hope" x-target-head="t010" x-head="true" lemma="יָחַל" strong="H3176" x-morph="Vhi1cs" x-gloss="I.will.wait" x-translit="ʾôḥiyl:" xml:lang="hbo">אוֹחִֽיל</char>׃ס<verse eid="LAM 3:21" /></para>
	<para style="p"><verse number="22" style="v" x-ref="LAM.3.22" sid="LAM 3:22" /><char style="w" x-id="WLC.LAM.3.22.001" x-align="LAM.3.22.a001" x-target-ids="t001 t002 t003 t005" x-target="It is of lovingkindnesses" x-target-italic-ids="t001 t002 t003" x-target-head="t005" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmpc" x-gloss="the.covenant.loyalti(es)" x-translit="ḥasəḏēy" xml:lang="hbo">חַֽסְדֵ֤י</char> <char style="w" x-id="WLC.LAM.3.22.002" x-align="LAM.3.22.a002" x-target-ids="t004" x-target="Jehovah’s" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.LAM.3.22.003" x-align="LAM.3.22.a003" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.LAM.3.22.004" x-align="LAM.3.22.a004" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.LAM.3.22.005" x-align="LAM.3.22.a005" x-target-ids="t007 t008 t010" x-target="we are consumed" x-target-head="t010" x-head="true" lemma="תָּמַם" strong="H8552" x-morph="Vqp1cp" x-gloss="we.have.met.our.end" x-translit="ṯāmənû" xml:lang="hbo">תָ֔מְנוּ</char> <char style="w" x-id="WLC.LAM.3.22.006" x-align="LAM.3.22.a006" x-target-ids="t011" x-target="because" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.LAM.3.22.007" x-align="LAM.3.22.a007" x-target-ids="t015" x-target="not" x-target-head="t015" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.LAM.3.22.008" x-align="LAM.3.22.a008" x-target-ids="t014" x-target="fail" x-target-