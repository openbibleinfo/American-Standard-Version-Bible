	<para style="p"><verse number="30" style="v" x-ref="LAM.3.30" sid="LAM 3:30" /><char style="w" x-id="WLC.LAM.3.30.001" x-align="LAM.3.30.a001" x-target-ids="t001 t002 t003" x-target="Let him give" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="let.him.give" x-translit="yittēn" xml:lang="hbo">יִתֵּ֧ן</char> <char style="w" x-id="WLC.LAM.3.30.002" x-align="LAM.3.30.a002" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.3.30.003" x-align="LAM.3.30.a003" x-target-ids="t007 t008 t009" x-target="him that smiteth" x-target-head="t009" x-head="true" lemma="נָכָה" strong="H5221" x-morph="Vhrmsc" x-gloss="[the" x-translit="makk" xml:lang="hbo">מַכֵּ֛</char><char style="w" x-id="WLC.LAM.3.30.004" x-align="LAM.3.30.a004" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="one.who].strikes.him" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.LAM.3.30.005" x-align="LAM.3.30.a005" x-target-ids="t004 t005" x-target="his cheek" x-target-head="t005" x-head="true" lemma="לְחִי" strong="H3895" x-morph="Ncbsa" x-gloss="a.cheek" x-translit="leḥî" xml:lang="hbo">לֶ֖חִי</char> <char style="w" x-id="WLC.LAM.3.30.006" x-align="LAM.3.30.a006" x-target-ids="t011 t012 t013 t014 t015" x-target="let him be filled full" x-target-head="t014" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqj3ms" x-gloss="let.him.be.sated" x-translit="yiśbaʿ" xml:lang="hbo">יִשְׂבַּ֥ע</char> <char style="w" x-id="WLC.LAM.3.30.007" x-align="LAM.3.30.a007" x-target-ids="t016" x-target="with" x-target-head="t016" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.30.008" x-align="LAM.3.30.a008" x-target-ids="t017" x-target="reproach" x-target-head="t