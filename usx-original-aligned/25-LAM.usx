	<para style="p"><verse number="59" style="v" x-ref="LAM.3.59" sid="LAM 3:59" /><char style="w" x-id="WLC.LAM.3.59.001" x-align="LAM.3.59.a001" x-target-ids="t003 t004 t005" x-target="thou hast seen" x-target-head="t005" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp2ms" x-gloss="you.have.seen" x-translit="rāʾiyṯâ" xml:lang="hbo">רָאִ֤יתָה</char> <char style="w" x-id="WLC.LAM.3.59.002" x-align="LAM.3.59.a002" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֙</char> <char style="w" x-id="WLC.LAM.3.59.003" x-align="LAM.3.59.a003" x-target-ids="t007" x-target="wrong" x-target-head="t007" x-head="true" lemma="עַוָּתָה" strong="H5792" x-morph="Ncfsc" x-gloss="oppression" x-translit="ʿawwāṯāṯ" xml:lang="hbo">עַוָּ֣תָתִ֔</char><char style="w" x-id="WLC.LAM.3.59.004" x-align="LAM.3.59.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.59.005" x-align="LAM.3.59.a005" x-target-ids="t008 t009" x-target="judge thou" x-target-head="t008" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vqv2ms" x-gloss="judge" x-translit="šāp̄əṭ" xml:lang="hbo">שָׁפְטָ֖</char><char style="w" x-id="WLC.LAM.3.59.006" x-align="LAM.3.59.a006" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.LAM.3.59.007" x-align="LAM.3.59.a007" x-target-ids="t011" x-target="cause" x-target-head="t011" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsc" x-gloss="judgment" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּטִֽ</char><char style="w" x-id="WLC.LAM.3.59.008" x-align="LAM.3.59.a008" x-target-ids="t010" x-target="my" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-transli