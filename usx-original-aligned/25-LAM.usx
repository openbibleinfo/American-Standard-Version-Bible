	<para style="p"><verse number="17" style="v" x-ref="LAM.5.17" sid="LAM 5:17" /><char style="w" x-id="WLC.LAM.5.17.001" x-align="LAM.5.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.LAM.5.17.002" x-align="LAM.5.17.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֗ה</char> <char style="w" x-id="WLC.LAM.5.17.003" x-align="LAM.5.17.a003" x-target-ids="t005" x-target="is" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3ms" x-gloss="it.has.become" x-translit="hāyāh" xml:lang="hbo">הָיָ֤ה</char> <char style="w" x-id="WLC.LAM.5.17.004" x-align="LAM.5.17.a004" x-target-ids="t006" x-target="faint" x-target-head="t006" x-head="true" lemma="דָּוֶה" strong="H1739" x-morph="Aamsa" x-gloss="faint" x-translit="ḏāweh" xml:lang="hbo">דָוֶה֙</char> <char style="w" x-id="WLC.LAM.5.17.005" x-align="LAM.5.17.a005" x-target-ids="t004" x-target="heart" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבֵּ֔</char><char style="w" x-id="WLC.LAM.5.17.006" x-align="LAM.5.17.a006" x-target-ids="t003" x-target="our" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.LAM.5.17.007" x-align="LAM.5.17.a007" x-target-ids="t007" x-target="For" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.LAM.5.17.008" x-align="LAM.5.17.a008" x-target-ids="t008 t009" x-target="these things" x-target-head="t008" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="h