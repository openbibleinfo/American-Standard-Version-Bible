	<para style="p"><verse number="17" style="v" x-ref="LAM.3.17" sid="LAM 3:17" /><char style="w" x-id="WLC.LAM.3.17.001" x-align="LAM.3.17.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.LAM.3.17.002" x-align="LAM.3.17.a002" x-target-ids="t002 t003 t004 t007 t008" x-target="thou hast removed far off" x-target-head="t004" x-head="true" lemma="זָנַח" strong="H2186" x-morph="Vqw3fs" x-gloss="it.has.excluded" x-translit="tiznaḥ" xml:lang="hbo">תִּזְנַ֧ח</char> <char style="w" x-id="WLC.LAM.3.17.003" x-align="LAM.3.17.a003" x-target-ids="t009" x-target="from" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.LAM.3.17.004" x-align="LAM.3.17.a004" x-target-ids="t010" x-target="peace" x-target-head="t010" x-head="true" lemma="שָׁלוֹם" strong="H7965" x-morph="Ncmsa" x-gloss="peace" x-translit="ššālôm" xml:lang="hbo">שָּׁל֛וֹם</char> <char style="w" x-id="WLC.LAM.3.17.005" x-align="LAM.3.17.a005" x-target-ids="t006" x-target="soul" x-target-head="t006" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֖</char><char style="w" x-id="WLC.LAM.3.17.006" x-align="LAM.3.17.a006" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.LAM.3.17.007" x-align="LAM.3.17.a007" x-target-ids="t011 t012" x-target="I forgat" x-target-head="t012" x-head="true" lemma="נָשָׁה" strong="H5382" x-morph="Vqp1cs" x-gloss="I.have.forgotten" x-translit="nāšiyṯî" xml:lang="hbo">נָשִׁ֥יתִי</char> <char style="w" x-id="WLC.LAM.3.17.008" x-align="LAM.3.17.a008" x-target-ids="t013" x-target="prosperity" x-target-head="t013" x-head="true" lemma="טוֹבָה" strong="H