	<para style="p"><verse number="1" style="v" x-ref="LAM.3.1" sid="LAM 3:1" /><char style="w" x-id="WLC.LAM.3.1.001" x-align="LAM.3.1.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֤י</char> <char style="w" x-id="WLC.LAM.3.1.002" x-align="LAM.3.1.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[am].the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.LAM.3.1.003" x-align="LAM.3.1.a003" x-target-ids="t002 t004" x-target="am man" x-target-head="t004" x-head="true" lemma="גֶּבֶר" strong="H1397" x-morph="Ncmsa" x-gloss="man" x-translit="geḇer" xml:lang="hbo">גֶּ֨בֶר֙</char> <char style="w" x-id="WLC.LAM.3.1.004" x-align="LAM.3.1.a004" x-target-ids="t005 t006 t007" x-target="that hath seen" x-target-head="t007" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp3ms" x-gloss="[who].he.has.seen" x-translit="rāʾāh" xml:lang="hbo">רָאָ֣ה</char> <char style="w" x-id="WLC.LAM.3.1.005" x-align="LAM.3.1.a005" x-target-ids="t008" x-target="affliction" x-target-head="t008" x-head="true" lemma="עֳנִי" strong="H6040" x-morph="Ncmsa" x-gloss="affliction" x-translit="ʿŏniy" xml:lang="hbo">עֳנִ֔י</char> <char style="w" x-id="WLC.LAM.3.1.006" x-align="LAM.3.1.a006" x-target-ids="t009" x-target="by" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.LAM.3.1.007" x-align="LAM.3.1.a007" x-target-ids="t010 t011" x-target="the rod" x-target-head="t011" x-head="true" lemma="שֵׁבֶט" strong="H7626" x-morph="Ncmsc" x-gloss="the.rod" x-translit="šēḇeṭ" xml:lang="hbo">שֵׁ֖בֶט</char> <char style="w" x-id="WLC.LAM.3.1.008" x-align="LAM.3.1.a008" x-target-ids="t012 t014" x-target="of wrath" x-target-head="t014" x-head="true" lemma="עֶבְרָה" strong="H5678" x-morph="Ncfsc" x-gloss="his.