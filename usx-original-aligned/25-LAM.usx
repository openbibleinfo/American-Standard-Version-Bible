	<para style="p"><verse number="31" style="v" x-ref="LAM.3.31" sid="LAM 3:31" /><char style="w" x-id="WLC.LAM.3.31.001" x-align="LAM.3.31.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.LAM.3.31.002" x-align="LAM.3.31.a002" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.LAM.3.31.003" x-align="LAM.3.31.a003" x-target-ids="t004 t006 t007" x-target="will cast off" x-target-head="t006" x-head="true" lemma="זָנַח" strong="H2186" x-morph="Vqi3ms" x-gloss="he.will.reject" x-translit="yiznaḥ" xml:lang="hbo">יִזְנַ֛ח</char> <char style="w" x-id="WLC.LAM.3.31.004" x-align="LAM.3.31.a004" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.LAM.3.31.005" x-align="LAM.3.31.a005" x-target-ids="t009" x-target="ever" x-target-head="t009" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֖ם</char> <char style="w" x-id="WLC.LAM.3.31.006" x-align="LAM.3.31.a006" x-target-ids="t002 t003" x-target="the Lord" x-target-head="t003" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָֽ</char><char style="w" x-id="WLC.LAM.3.31.007" x-align="LAM.3.31.a007" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo">י</char>׃<verse eid="LAM 3:31" /></para>
