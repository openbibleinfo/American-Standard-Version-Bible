	<para style="p"><verse number="41" style="v" x-ref="LAM.3.41" sid="LAM 3:41" /><char style="w" x-id="WLC.LAM.3.41.001" x-align="LAM.3.41.a001" x-target-ids="t001 t002 t003 t004" x-target="Let us lift up" x-target-head="t003" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqh1cp" x-gloss="let.us.lift.up" x-translit="niśśāʾ" xml:lang="hbo">נִשָּׂ֤א</char> <char style="w" x-id="WLC.LAM.3.41.002" x-align="LAM.3.41.a002" x-target-ids="t006" x-target="heart" x-target-head="t006" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsc" x-gloss="heart" x-translit="ləḇāḇ" xml:lang="hbo">לְבָבֵ֨</char><char style="w" x-id="WLC.LAM.3.41.003" x-align="LAM.3.41.a003" x-target-ids="t005" x-target="our" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo">נוּ֙</char> <char style="w" x-id="WLC.LAM.3.41.004" x-align="LAM.3.41.a004" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LAM.3.41.005" x-align="LAM.3.41.a005" x-target-ids="t008 t009" x-target="our hands" x-target-head="t009" x-head="true" lemma="כַּף" strong="H3709" x-morph="Ncfda" x-gloss="palms" x-translit="kappāyim" xml:lang="hbo">כַּפָּ֔יִם</char> <char style="w" x-id="WLC.LAM.3.41.006" x-align="LAM.3.41.a006" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.LAM.3.41.007" x-align="LAM.3.41.a007" x-target-ids="t011" x-target="God" x-target-head="t011" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֖ל</char> <char style="w" x-id="WLC.LAM.3.41.008" x-align="LAM.3.41.a008" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba"