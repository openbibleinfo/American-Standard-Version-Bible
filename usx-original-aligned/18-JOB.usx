	<para style="p"><verse number="3" style="v" x-ref="JOB.20.3" sid="JOB 20:3" /><char style="w" x-id="WLC.JOB.20.3.001" x-align="JOB.20.3.a001" x-target-ids="t004 t005" x-target="the reproof" x-target-head="t005" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsc" x-gloss="[the].correction" x-translit="mûsar" xml:lang="hbo">מוּסַ֣ר</char> <char style="w" x-id="WLC.JOB.20.3.002" x-align="JOB.20.3.a002" x-target-ids="t006 t007 t009 t010" x-target="which putteth to shame" x-target-head="t010" x-head="true" lemma="כְּלִמָּה" strong="H3639" x-morph="Ncfsc" x-gloss="my.insult" x-translit="kəlimmāṯ" xml:lang="hbo">כְּלִמָּתִ֣</char><char style="w" x-id="WLC.JOB.20.3.003" x-align="JOB.20.3.a003" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.20.3.004" x-align="JOB.20.3.a004" x-target-ids="t001 t002 t003" x-target="I have heard" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi1cs" x-gloss="I.have.heard" x-translit="ʾešmāʿ" xml:lang="hbo">אֶשְׁמָ֑ע</char> <char style="w" x-id="WLC.JOB.20.3.005" x-align="JOB.20.3.a005" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.20.3.006" x-align="JOB.20.3.a006" x-target-ids="t012 t013" x-target="the spirit" x-target-head="t013" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="a.spirit" x-translit="rûᵃḥ" xml:lang="hbo">ר֗וּחַ</char> <char style="w" x-id="WLC.JOB.20.3.007" x-align="JOB.20.3.a007" x-target-ids="t014" x-target="of" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִֽ</char><char style="w" x-id="WLC.JOB.20.3.008" x-align="JOB.20.3.a008" x-target-ids="t016" x-target="understanding" x-target-head="t016" x-head="tru