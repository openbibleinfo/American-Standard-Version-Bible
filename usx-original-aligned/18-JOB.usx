	<para style="p"><verse number="4" style="v" x-ref="JOB.22.4" x-added-alignments="JOB.22.4.a002 JOB.22.4.a006 JOB.22.4.a007 JOB.22.4.a010" x-added-target-ids="t002 t006 t007 t008 t012" x-added-target="it | of him | that | That" sid="JOB 22:4" /><char style="w" x-id="WLC.JOB.22.4.001" x-align="JOB.22.4.a001" x-target-ids="t001" x-target="Is" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="hă" xml:lang="hbo">הֲֽ֭</char><char style="w" x-id="WLC.JOB.22.4.002" x-align="JOB.22.4.a003" x-target-ids="t003" x-target="for" x-target-head="t003" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.22.4.003" x-align="JOB.22.4.a004" x-target-ids="t005" x-target="fear" x-target-head="t005" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="fear" x-translit="yyirʾāṯ" xml:lang="hbo">יִּרְאָ֣תְ</char><char style="w" x-id="WLC.JOB.22.4.004" x-align="JOB.22.4.a005" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.22.4.005" x-align="JOB.22.4.a008" x-target-ids="t009 t010" x-target="he reproveth" x-target-head="t010" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhi3ms" x-gloss="does" x-translit="yōḵiyḥ" xml:lang="hbo">יֹכִיחֶ֑</char><char style="w" x-id="WLC.JOB.22.4.006" x-align="JOB.22.4.a009" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="he.reprove.you" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.22.4.007" x-align="JOB.22.4.a011" x-target-ids="t013 t014" x-target="he entereth" x-target-head="t014" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3ms" x-gloss="does.he.go?" x-translit="yāḇôʾ" xml:lang="hbo">יָב֥וֹא</char> <char style="w" x-id="WLC.JOB.22.4.008" x-ali