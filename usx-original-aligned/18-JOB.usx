	<para style="p"><verse number="31" style="v" x-ref="JOB.31.31" sid="JOB 31:31" /><char style="w" x-id="WLC.JOB.31.31.001" x-align="JOB.31.31.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.31.002" x-align="JOB.31.31.a006" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.31.31.003" x-align="JOB.31.31.a005" x-target-ids="t007 t009" x-target="have said" x-target-head="t009" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3cp" x-gloss="they.have.said" x-translit="ʾāmərû" xml:lang="hbo">אָ֭מְרוּ</char> <char style="w" x-id="WLC.JOB.31.31.004" x-align="JOB.31.31.a002" x-target-ids="t002 t003" x-target="the men" x-target-head="t003" x-head="true" lemma="מַת" strong="H4962" x-morph="Ncmpc" x-gloss="the.men" x-translit="məṯēy" xml:lang="hbo">מְתֵ֣י</char> <char style="w" x-id="WLC.JOB.31.31.005" x-align="JOB.31.31.a003" x-target-ids="t004 t006" x-target="of tent" x-target-head="t006" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmsc" x-gloss="my.tent" x-translit="ʾāhŏl" xml:lang="hbo">אָהֳלִ֑</char><char style="w" x-id="WLC.JOB.31.31.006" x-align="JOB.31.31.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.31.007" x-align="JOB.31.31.a007" x-target-ids="t010" x-target="Who" x-target-head="t010" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy-" xml:lang="hbo">מִֽי</char>־<char style="w" x-id="WLC.JOB.31.31.008" x-align="JOB.31.31.a008" x-target-ids="t011 t012" x-target="can find" x-target-head="t012" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="will.he