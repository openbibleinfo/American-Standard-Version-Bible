	<para style="p"><verse number="12" style="v" x-ref="JOB.29.12" sid="JOB 29:12" /><char style="w" x-id="WLC.JOB.29.12.001" x-align="JOB.29.12.a001" x-target-ids="t001" x-target="Because" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.29.12.002" x-align="JOB.29.12.a002" x-target-ids="t002 t003" x-target="I delivered" x-target-head="t003" x-head="true" lemma="מָלַט" strong="H4422" x-morph="Vpi1cs" x-gloss="I.rescued" x-translit="ʾămallēṭ" xml:lang="hbo">אֲ֭מַלֵּט</char> <char style="w" x-id="WLC.JOB.29.12.003" x-align="JOB.29.12.a003" x-target-ids="t004 t005" x-target="the poor" x-target-head="t005" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aamsa" x-gloss="[the].afflicted" x-translit="ʿāniy" xml:lang="hbo">עָנִ֣י</char> <char style="w" x-id="WLC.JOB.29.12.004" x-align="JOB.29.12.a004" x-target-ids="t006 t007" x-target="that cried" x-target-head="t007" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vprmsa" x-gloss="[who].cried.for.help" x-translit="məšawwēᵃʿ" xml:lang="hbo">מְשַׁוֵּ֑עַ</char> <char style="w" x-id="WLC.JOB.29.12.005" x-align="JOB.29.12.a005" x-target-ids="t010" x-target="also" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.29.12.006" x-align="JOB.29.12.a006" x-target-ids="t008 t009" x-target="The fatherless" x-target-head="t009" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmsa" x-gloss="fatherless" x-translit="yāṯôm" xml:lang="hbo">יָת֗וֹם</char> <char style="w" x-id="WLC.JOB.29.12.007" x-align="JOB.29.12.a007" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.JOB.29.12.008" x-align="JOB.29.12.a008" x-target-ids="t013" x-target="none" x-target-head="t013" x-head="true" lemma="לֹא" strong=