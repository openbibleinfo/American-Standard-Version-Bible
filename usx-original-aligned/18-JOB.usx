	<para style="p"><verse number="22" style="v" x-ref="JOB.37.22" x-added-alignments="JOB.37.22.a006" x-added-target-ids="t009" x-added-target="hath" sid="JOB 37:22" /><char style="w" x-id="WLC.JOB.37.22.001" x-align="JOB.37.22.a001" x-target-ids="t001 t002" x-target="Out of" x-target-head="t001" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ֭</char><char style="w" x-id="WLC.JOB.37.22.002" x-align="JOB.37.22.a002" x-target-ids="t003 t004" x-target="the north" x-target-head="t004" x-head="true" lemma="צָפוֹן" strong="H6828" x-morph="Ncfsa" x-gloss="north" x-translit="ṣṣāp̄ôn" xml:lang="hbo">צָּפוֹן</char> <char style="w" x-id="WLC.JOB.37.22.003" x-align="JOB.37.22.a004" x-target-ids="t006 t007" x-target="golden splendor" x-target-head="t006" x-head="true" lemma="זָהָב" strong="H2091" x-morph="Ncmsa" x-gloss="gold" x-translit="zāhāḇ" xml:lang="hbo">זָהָ֣ב</char> <char style="w" x-id="WLC.JOB.37.22.004" x-align="JOB.37.22.a003" x-target-ids="t005" x-target="cometh" x-target-head="t005" x-head="true" lemma="אָתָה" strong="H857" x-morph="Vqi3ms" x-gloss="it.comes" x-translit="yeʾĕṯeh" xml:lang="hbo">יֶֽאֱתֶ֑ה</char> <char style="w" x-id="WLC.JOB.37.22.005" x-align="JOB.37.22.a007" x-target-ids="t010" x-target="upon" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="[is].on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JOB.37.22.006" x-align="JOB.37.22.a005" x-target-ids="t008 t011" x-target="God him" x-target-head="t008" x-head="true" lemma="אֱלֹוהַּ" strong="H433" x-morph="Ncmsa" x-gloss="God" x-translit="ʾĕlôᵃẖ" xml:lang="hbo">אֱ֝ל֗וֹהַּ</char> <char style="w" x-id="WLC.JOB.37.22.007" x-align="JOB.37.22.a008" x-target-ids="t012" x-target="terrible" x-target-head="t012" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="VNrmsc" x-gloss="awesome" x-translit="nôrāʾ" xml:lang="hbo">נ֣וֹרָא</char> <char style="w" x-id="WLC.JOB.37.22.008" x-align="JOB.37.22.