	<para style="p"><verse number="19" style="v" x-ref="JOB.8.19" sid="JOB 8:19" /><char style="w" x-id="WLC.JOB.8.19.001" x-align="JOB.8.19.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tj" x-gloss="there!" x-translit="hen-" xml:lang="hbo">הֶן</char>־<char style="w" x-id="WLC.JOB.8.19.002" x-align="JOB.8.19.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="hûʾ" xml:lang="hbo">ה֭וּא</char> <char style="w" x-id="WLC.JOB.8.19.003" x-align="JOB.8.19.a003" x-target-ids="t003 t004 t005" x-target="is the joy" x-target-head="t005" x-head="true" lemma="מָשׂוֹשׂ" strong="H4885" x-morph="Ncmsc" x-gloss="[is].the.joy" x-translit="məśôś" xml:lang="hbo">מְשׂ֣וֹשׂ</char> <char style="w" x-id="WLC.JOB.8.19.004" x-align="JOB.8.19.a004" x-target-ids="t006 t008" x-target="of way" x-target-head="t008" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="its.way" x-translit="dark" xml:lang="hbo">דַּרְכּ֑</char><char style="w" x-id="WLC.JOB.8.19.005" x-align="JOB.8.19.a005" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.8.19.006" x-align="JOB.8.19.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.8.19.007" x-align="JOB.8.19.a007" x-target-ids="t010 t011" x-target="out of" x-target-head="t010" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.JOB.8.19.008" x-align="JOB.8.19.a008" x-target-ids="t012 t013" x-target="the earth" x-target-head="t013" x-head="true" lemma="עָפָר" strong="H6083" x-morph="Ncmsa" x-gloss="dust" x-translit