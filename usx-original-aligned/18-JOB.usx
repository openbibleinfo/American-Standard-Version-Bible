	<para style="p"><verse number="34" style="v" x-ref="JOB.41.34" sid="JOB 41:34" /><char style="w" x-id="WLC.JOB.41.34.001" x-align="JOB.41.34.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾēṯ-" xml:lang="hbo" x-source-ref="JOB.41.26">אֵֽת</char>־<char style="w" x-id="WLC.JOB.41.34.002" x-align="JOB.41.34.a003" x-target-ids="t003" x-target="everything" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo" x-source-ref="JOB.41.26">כָּל</char>־<char style="w" x-id="WLC.JOB.41.34.003" x-align="JOB.41.34.a004" x-target-ids="t004 t005 t006" x-target="that is high" x-target-head="t006" x-head="true" lemma="גָּבֹהַּ" strong="H1364" x-morph="Aamsa" x-gloss="exalted.[one]" x-translit="gāḇōᵃẖ" xml:lang="hbo" x-source-ref="JOB.41.26">גָּבֹ֥הַּ</char> <char style="w" x-id="WLC.JOB.41.34.004" x-align="JOB.41.34.a001" x-target-ids="t001 t002" x-target="He beholdeth" x-target-head="t002" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi3ms" x-gloss="it.sees" x-translit="yirʾeh" xml:lang="hbo" x-source-ref="JOB.41.26">יִרְאֶ֑ה</char> <char style="w" x-id="WLC.JOB.41.34.005" x-align="JOB.41.34.a005" x-target-ids="t007" x-target="He" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="hûʾ" xml:lang="hbo" x-source-ref="JOB.41.26">ה֝֗וּא</char> <char style="w" x-id="WLC.JOB.41.34.006" x-align="JOB.41.34.a006" x-target-ids="t008 t009" x-target="is king" x-target-head="t009" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="[is].king" x-translit="meleḵ" xml:lang="hbo" x-source-ref="JOB.41.26">מֶ֣לֶךְ</char> <char style="w" x-id="WLC.JOB.41.34.007" x-align="JOB.41.34.a007" x-target-ids="t010" x-target="over" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal-" xml:lang="hbo" x-source-ref="JOB.41.26">עַל</char>־<char style="