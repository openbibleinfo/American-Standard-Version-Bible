	<para style="p"><verse number="27" style="v" x-ref="JOB.31.27" sid="JOB 31:27" /><char style="w" x-id="WLC.JOB.31.27.001" x-align="JOB.31.27.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.31.27.002" x-align="JOB.31.27.a004" x-target-ids="t004 t005 t007" x-target="hath been enticed" x-target-head="t007" x-head="true" lemma="פָּתָה" strong="H6601" x-morph="Vqw3ms" x-gloss="it.was.gullible" x-translit="yyip̄tə" xml:lang="hbo">יִּ֣פְתְּ</char> <char style="w" x-id="WLC.JOB.31.27.003" x-align="JOB.31.27.a005" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.JOB.31.27.004" x-align="JOB.31.27.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.31.27.005" x-align="JOB.31.27.a005" x-target-ids="t006" x-target="secretly" x-target-head="t006" x-head="true" lemma="סֵתֶר" strong="H5643" x-morph="Ncmsa" x-gloss="secrecy" x-translit="ssēṯer" xml:lang="hbo">סֵּ֣תֶר</char> <char style="w" x-id="WLC.JOB.31.27.006" x-align="JOB.31.27.a003" x-target-ids="t003" x-target="heart" x-target-head="t003" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֑</char><char style="w" x-id="WLC.JOB.31.27.007" x-align="JOB.31.27.a002" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.27.008" x-align="JOB.31.27.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.31.27.009" x-align="JOB.31.27.a010" x-target-ids=