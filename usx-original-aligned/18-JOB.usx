	<para style="p"><verse number="21" style="v" x-ref="JOB.8.21" sid="JOB 8:21" /><char style="w" x-id="WLC.JOB.8.21.001" x-align="JOB.8.21.a001" x-target-ids="t003" x-target="yet" x-target-head="t003" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.JOB.8.21.002" x-align="JOB.8.21.a002" x-target-ids="t001 t002 t004" x-target="He will fill" x-target-head="t004" x-head="true" lemma="מָלֵא" strong="H4390" x-morph="Vpi3ms" x-gloss="he.will.fill" x-translit="yəmallēh" xml:lang="hbo">יְמַלֵּ֣ה</char> <char style="w" x-id="WLC.JOB.8.21.003" x-align="JOB.8.21.a005" x-target-ids="t007 t008" x-target="with laughter" x-target-head="t008" x-head="true" lemma="שְׂחֹוק" strong="H7814" x-morph="Ncmsa" x-gloss="laughter" x-translit="śəḥôq" xml:lang="hbo">שְׂח֣וֹק</char> <char style="w" x-id="WLC.JOB.8.21.004" x-align="JOB.8.21.a004" x-target-ids="t006" x-target="mouth" x-target-head="t006" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="piy" xml:lang="hbo">פִּ֑י</char><char style="w" x-id="WLC.JOB.8.21.005" x-align="JOB.8.21.a003" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.8.21.006" x-align="JOB.8.21.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.8.21.007" x-align="JOB.8.21.a008" x-target-ids="t011" x-target="lips" x-target-head="t011" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śəp̄āṯey" xml:lang="hbo">שְׂפָתֶ֥י</char><char style="w" x-id="WLC.JOB.8.21.008" x-align="JOB.8.21.a007" x-target-ids="t010" x-target="thy" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-