	<para style="p"><verse number="1" style="v" x-ref="JOB.12.1" sid="JOB 12:1" /><char style="w" x-id="WLC.JOB.12.1.001" x-align="JOB.12.1.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.12.1.002" x-align="JOB.12.1.a002" x-target-ids="t003" x-target="answered" x-target-head="t003" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw3ms" x-gloss="he.answered" x-translit="yyaʿan" xml:lang="hbo">יַּ֥עַן</char> <char style="w" x-id="WLC.JOB.12.1.003" x-align="JOB.12.1.a003" x-target-ids="t002" x-target="Job" x-target-head="t002" x-head="true" lemma="אִיּוֹב" strong="H347" x-morph="Np" x-gloss="Job" x-translit="ʾiyyôḇ" xml:lang="hbo">אִיּ֗וֹב</char> <char style="w" x-id="WLC.JOB.12.1.004" x-align="JOB.12.1.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.12.1.005" x-align="JOB.12.1.a005" x-target-ids="t005" x-target="said" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar:" xml:lang="hbo">יֹּאמַֽר</char>׃<verse eid="JOB 12:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="JOB.12.2" sid="JOB 12:2" /><char style="w" x-id="WLC.JOB.12.2.001" x-align="JOB.12.2.a001" x-target-ids="t001 t002" x-target="No doubt" x-target-head="t002" x-head="true" lemma="אׇמְנָם" strong="H551" x-morph="D" x-gloss="truly" x-translit="ʾomnām" xml:lang="hbo">אָ֭מְנָם</char> <char style="w" x-id="WLC.JOB.12.2.002" x-align="JOB.12.2.a002" x-target-ids="t003" x-target="but" x-target-head="t003" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.JOB.12.2.003" x-align="JOB.12.2.a003" x-target-ids="t004" x-target="ye" x-target-head="t004" x-head="true" lemma="אַתֶּם" strong="H859a" x-morph="Pp2mp" x-gloss="you" x-translit="ʾattem-" xml:lang="hbo">אַתֶּם</char>־<char style="w" x-id="WLC.JOB.12.2.004" x-align="JOB.12.2.a004" x-target-ids="t005 t006 t007" x-target="are the people" x-target-head="t007" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="[are.the].people" x-translit="ʿām" xml:lang="hbo">עָ֑ם</char> <char style="w" x-id="WLC.JOB.12.2.005" x-align="JOB.12.2.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.12.2.006" x-align="JOB.12.2.a006" x-target-ids="t012" x-target="with" x-target-head="t012" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿimm" xml:lang="hbo">עִמָּ</char><char style="w" x-id="WLC.JOB.12.2.007" x-align="JOB.12.2.a007" x-target-ids="t013" x-target="you" x-target-head="t013" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="āḵem" xml:lang="hbo">כֶ֗ם</char> <char style="w" x-id="WLC.JOB.12.2.008" x-align="JOB.12.2.a008" x-target-ids="t010 t011" x-target="shall die" x-target-head="t011" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqi3fs" x-gloss="it.will.die" x-translit