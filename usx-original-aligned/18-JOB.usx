	<para style="p"><verse number="19" style="v" x-ref="JOB.27.19" x-added-alignments="JOB.27.19.a006" x-added-target-ids="t011 t012 t013" x-added-target="to his fathers" sid="JOB 27:19" /><char style="w" x-id="WLC.JOB.27.19.001" x-align="JOB.27.19.a001" x-target-ids="t004" x-target="rich" x-target-head="t004" x-head="true" lemma="עָשִׁיר" strong="H6223" x-morph="Aamsa" x-gloss="rich" x-translit="ʿāšiyr" xml:lang="hbo">עָשִׁ֣יר</char> <char style="w" x-id="WLC.JOB.27.19.002" x-align="JOB.27.19.a002" x-target-ids="t001 t002 t003" x-target="He lieth down" x-target-head="t002" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqi3ms" x-gloss="he.will.lie.down" x-translit="yiškaḇ" xml:lang="hbo">יִ֭שְׁכַּב</char> <char style="w" x-id="WLC.JOB.27.19.003" x-align="JOB.27.19.a003" x-target-ids="t005" x-target="but" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.27.19.004" x-align="JOB.27.19.a004" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.27.19.005" x-align="JOB.27.19.a005" x-target-ids="t006 t007 t009 t010" x-target="he shall be gathered" x-target-head="t010" x-head="true" lemma="אָסַף" strong="H622" x-morph="VNi3ms" x-gloss="he.will.be.removed" x-translit="yēʾāsēp̄" xml:lang="hbo">יֵאָסֵ֑ף</char> <char style="w" x-id="WLC.JOB.27.19.006" x-align="JOB.27.19.a007" x-target-ids="t017" x-target="eyes" x-target-head="t017" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿēynāy" xml:lang="hbo">עֵינָ֖י</char><char style="w" x-id="WLC.JOB.27.19.007" x-align="JOB.27.19.a008" x-target-ids="t016" x-target="his" x-target-head="t016" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.27.19.008" x-