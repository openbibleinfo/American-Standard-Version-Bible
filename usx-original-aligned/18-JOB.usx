	<para style="p"><verse number="11" style="v" x-ref="JOB.29.11" x-added-alignments="JOB.29.11.a004 JOB.29.11.a011" x-added-target-ids="t006 t016" x-added-target="me | me" sid="JOB 29:11" /><char style="w" x-id="WLC.JOB.29.11.001" x-align="JOB.29.11.a001" x-target-ids="t001 t002 t012" x-target="For when when" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JOB.29.11.002" x-align="JOB.29.11.a002" x-target-ids="t003 t004" x-target="the ear" x-target-head="t004" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsa" x-gloss="an.ear" x-translit="ʾōzen" xml:lang="hbo">אֹ֣זֶן</char> <char style="w" x-id="WLC.JOB.29.11.003" x-align="JOB.29.11.a003" x-target-ids="t005" x-target="heard" x-target-head="t005" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp3fs" x-gloss="it.heard" x-translit="šāmʿâ" xml:lang="hbo">שָׁ֭מְעָה</char> <char style="w" x-id="WLC.JOB.29.11.004" x-align="JOB.29.11.a005" x-target-ids="t007" x-target="then" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.JOB.29.11.005" x-align="JOB.29.11.a006" x-target-ids="t008 t009" x-target="it blessed" x-target-head="t009" x-head="true" lemma="אָשַׁר" strong="H833a" x-morph="Vpw3fs" x-gloss="it" x-translit="təʾaššər" xml:lang="hbo">תְּאַשְּׁרֵ֑</char><char style="w" x-id="WLC.JOB.29.11.006" x-align="JOB.29.11.a007" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="called.me.blessed" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.29.11.007" x-align="JOB.29.11.a008" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.29.11.008" x-align="JOB.29.11.a009" x-ta