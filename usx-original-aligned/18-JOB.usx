	<para style="p"><verse number="19" style="v" x-ref="JOB.9.19" x-added-alignments="JOB.9.19.a002 JOB.9.19.a012" x-added-target-ids="t002 t003 t015 t016" x-added-target="we speak | saith he" sid="JOB 9:19" /><char style="w" x-id="WLC.JOB.9.19.001" x-align="JOB.9.19.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.19.002" x-align="JOB.9.19.a003" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.9.19.003" x-align="JOB.9.19.a004" x-target-ids="t005" x-target="strength" x-target-head="t005" x-head="true" lemma="כֹּחַ" strong="H3581" x-morph="Ncmsa" x-gloss="power" x-translit="ḵōᵃḥ" xml:lang="hbo">כֹ֣חַ</char> <char style="w" x-id="WLC.JOB.9.19.004" x-align="JOB.9.19.a005" x-target-ids="t007 t008 t009" x-target="he is mighty" x-target-italic-ids="t007 t008" x-target-head="t009" x-head="true" lemma="אַמִּיץ" strong="H533" x-morph="Aamsa" x-gloss="a.strong.[one]" x-translit="ʾammiyṣ" xml:lang="hbo">אַמִּ֣יץ</char> <char style="w" x-id="WLC.JOB.9.19.005" x-align="JOB.9.19.a006" x-target-ids="t006" x-target="lo" x-target-head="t006" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֑ה</char> <char style="w" x-id="WLC.JOB.9.19.006" x-align="JOB.9.19.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.9.19.007" x-align="JOB.9.19.a008" x-target-ids="t011" x-target="if" x-target-head="t011" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.19.008" x-align="JOB.9.19.a009" x-target-ids="t012" x-ta