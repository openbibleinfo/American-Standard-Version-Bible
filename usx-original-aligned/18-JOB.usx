	<para style="p"><verse number="28" style="v" x-ref="JOB.15.28" x-added-alignments="JOB.15.28.a006 JOB.15.28.a008" x-added-target-ids="t010 t012" x-added-target="which | man" sid="JOB 15:28" /><char style="w" x-id="WLC.JOB.15.28.001" x-align="JOB.15.28.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.15.28.002" x-align="JOB.15.28.a002" x-target-ids="t002 t003 t004" x-target="he hath dwelt" x-target-head="t004" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqw3ms" x-gloss="he.dwelt" x-translit="yyiškôn" xml:lang="hbo">יִּשְׁכּ֤וֹן</char>׀<char style="w" x-id="WLC.JOB.15.28.003" x-align="JOB.15.28.a003" x-target-ids="t005 t007" x-target="in cities" x-target-head="t007" x-head="true" lemma="עִיר" strong="H5892" x-morph="Ncfpa" x-gloss="cities" x-translit="ʿāriym" xml:lang="hbo">עָ֘רִ֤ים</char> <char style="w" x-id="WLC.JOB.15.28.004" x-align="JOB.15.28.a004" x-target-ids="t006" x-target="desolate" x-target-head="t006" x-head="true" lemma="כָּחַד" strong="H3582" x-morph="VNrfpa" x-gloss="destroyed" x-translit="niḵḥāḏôṯ" xml:lang="hbo">נִכְחָד֗וֹת</char> <char style="w" x-id="WLC.JOB.15.28.005" x-align="JOB.15.28.a005" x-target-ids="t008 t009" x-target="In houses" x-target-head="t009" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmpa" x-gloss="houses" x-translit="bottîm" xml:lang="hbo">בָּ֭תִּים</char> <char style="w" x-id="WLC.JOB.15.28.006" x-align="JOB.15.28.a007" x-target-ids="t011" x-target="no" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[which].not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.15.28.007" x-align="JOB.15.28.a009" x-target-ids="t013" x-target="inhabited" x-target-head="t013" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi3mp" x-gloss="people.will.dwell" x-translit="yēšəḇû" xml:lang="hbo">יֵ֣שְׁבוּ</char> <char