	<para style="p"><verse number="19" style="v" x-ref="JOB.32.19" x-added-alignments="JOB.32.19.a006" x-added-target-ids="t007" x-added-target="which" sid="JOB 32:19" /><char style="w" x-id="WLC.JOB.32.19.001" x-align="JOB.32.19.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh-" xml:lang="hbo">הִנֵּֽה</char>־<char style="w" x-id="WLC.JOB.32.19.002" x-align="JOB.32.19.a002" x-target-ids="t003" x-target="breast" x-target-head="t003" x-head="true" lemma="בֶּטֶן" strong="H990" x-morph="Ncfsc" x-gloss="belly" x-translit="ḇiṭn" xml:lang="hbo">בִטְנִ֗</char><char style="w" x-id="WLC.JOB.32.19.003" x-align="JOB.32.19.a003" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.32.19.004" x-align="JOB.32.19.a004" x-target-ids="t004 t005" x-target="is as" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="[is].like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.JOB.32.19.005" x-align="JOB.32.19.a005" x-target-ids="t006" x-target="wine" x-target-head="t006" x-head="true" lemma="יַיִן" strong="H3196" x-morph="Ncmsa" x-gloss="wine" x-translit="yayin" xml:lang="hbo">יַ֥יִן</char> <char style="w" x-id="WLC.JOB.32.19.006" x-align="JOB.32.19.a007" x-target-ids="t009" x-target="no" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[which].not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.32.19.007" x-align="JOB.32.19.a008" x-target-ids="t008 t010" x-target="hath vent" x-target-head="t010" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="VNi3ms" x-gloss="it.is.opened" x-translit="yippāṯēᵃḥ" xml:lang="hbo">יִפָּתֵ֑חַ</char> <char style="w" x-id="WLC.JOB.32.19.008" x-align="JOB.32.19.a009" x-target-ids="t011" x-target="Like"