	<para style="p"><verse number="28" style="v" x-ref="JOB.22.28" sid="JOB 22:28" /><char style="w" x-id="WLC.JOB.22.28.001" x-align="JOB.22.28.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.JOB.22.28.002" x-align="JOB.22.28.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt decree" x-target-head="t004" x-head="true" lemma="גָּזַר" strong="H1504" x-morph="Vqi2ms" x-gloss="you.will.decide" x-translit="ṯiḡzar-" xml:lang="hbo">תִגְזַר</char>־<char style="w" x-id="WLC.JOB.22.28.003" x-align="JOB.22.28.a003" x-target-ids="t005 t006" x-target="a thing" x-target-head="t006" x-head="true" lemma="אֹמֶר" strong="H562" x-morph="Ncmsa" x-gloss="a.matter" x-translit="ʾômer" xml:lang="hbo">א֭וֹמֶר</char><char style="w" x-id="WLC.JOB.22.28.004" x-align="JOB.22.28.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.22.28.005" x-align="JOB.22.28.a005" x-target-ids="t008 t009 t010 t011" x-target="it shall be established" x-target-head="t011" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqj3ms" x-gloss="it.will.be.fulfilled" x-translit="yāqām" xml:lang="hbo">יָ֣קָם</char> <char style="w" x-id="WLC.JOB.22.28.006" x-align="JOB.22.28.a006" x-target-ids="t012" x-target="unto" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לָ֑</char><char style="w" x-id="WLC.JOB.22.28.007" x-align="JOB.22.28.a007" x-target-ids="t013" x-target="thee" x-target-head="t013" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.JOB.22.28.008" x-align="JOB.22.28.a008" x-target-ids="t014" x-target="And" x-target-head="t014" x-head="true" lemma="וְ" strong="H