	<para style="p"><verse number="23" style="v" x-ref="JOB.3.23" x-added-alignments="JOB.3.23.a001" x-added-target-ids="t001 t002 t003 t004" x-added-target="Why is light given" sid="JOB 3:23" /><char style="w" x-id="WLC.JOB.3.23.001" x-align="JOB.3.23.a002" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֭</char><char style="w" x-id="WLC.JOB.3.23.002" x-align="JOB.3.23.a003" x-target-ids="t006 t007" x-target="a man" x-target-head="t007" x-head="true" lemma="גֶּבֶר" strong="H1397" x-morph="Ncmsa" x-gloss="a.man" x-translit="ḡeḇer" xml:lang="hbo">גֶבֶר</char> <char style="w" x-id="WLC.JOB.3.23.003" x-align="JOB.3.23.a004" x-target-ids="t008" x-target="whose" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="whom" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.JOB.3.23.004" x-align="JOB.3.23.a005" x-target-ids="t009" x-target="way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="dark" xml:lang="hbo">דַּרְכּ֣</char><char style="w" x-id="WLC.JOB.3.23.005" x-align="JOB.3.23.a004" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.3.23.006" x-align="JOB.3.23.a006" x-target-ids="t010 t011" x-target="is hid" x-target-head="t011" x-head="true" lemma="סָתַר" strong="H5641" x-morph="VNp3fs" x-gloss="it.is.hidden" x-translit="nistārâ" xml:lang="hbo">נִסְתָּ֑רָה</char> <char style="w" x-id="WLC.JOB.3.23.007" x-align="JOB.3.23.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.3.23.008" x-align="JOB.3.23.a008" x-target-ids="t015 t016 t017" x-target="hath hedged in" x-target-head="t016" x-head="true" lemma="סכך" strong="H5526" x-morph="