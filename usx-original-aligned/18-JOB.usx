	<para style="p"><verse number="1" style="v" x-ref="JOB.13.1" sid="JOB 13:1" /><char style="w" x-id="WLC.JOB.13.1.001" x-align="JOB.13.1.a001" x-target-ids="t001" x-target="Lo" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tj" x-gloss="there!" x-translit="hen-" xml:lang="hbo">הֶן</char>־<char style="w" x-id="WLC.JOB.13.1.002" x-align="JOB.13.1.a002" x-target-ids="t006 t007" x-target="all this" x-target-italic-ids="t007" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="all" x-translit="kōl" xml:lang="hbo">כֹּ֭ל</char> <char style="w" x-id="WLC.JOB.13.1.003" x-align="JOB.13.1.a003" x-target-ids="t004 t005" x-target="hath seen" x-target-head="t005" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp3fs" x-gloss="it.has.seen" x-translit="rāʾăṯāh" xml:lang="hbo">רָאֲתָ֣ה</char> <char style="w" x-id="WLC.JOB.13.1.004" x-align="JOB.13.1.a004" x-target-ids="t003" x-target="eye" x-target-head="t003" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbsc" x-gloss="eye" x-translit="ʿēyn" xml:lang="hbo">עֵינִ֑</char><char style="w" x-id="WLC.JOB.13.1.005" x-align="JOB.13.1.a005" x-target-ids="t002" x-target="mine" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.13.1.006" x-align="JOB.13.1.a006" x-target-ids="t010 t011" x-target="hath heard" x-target-head="t011" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp3fs" x-gloss="it.has.heard" x-translit="šāməʿāh" xml:lang="hbo">שָֽׁמְעָ֥ה</char> <char style="w" x-id="WLC.JOB.13.1.007" x-align="JOB.13.1.a007" x-target-ids="t009" x-target="ear" x-target-head="t009" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsc" x-gloss="ear" x-translit="ʾāzən" xml:lang="hbo">אָ֝זְנִ֗</char><char style="w" x-id="WLC.JOB.13.1.008" x-align="JOB.13.1.a008" x-target-ids="t008" x-target="Mine" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x