	<para style="p"><verse number="29" style="v" x-ref="JOB.9.29" sid="JOB 9:29" /><char style="w" x-id="WLC.JOB.9.29.001" x-align="JOB.9.29.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָנֹכִ֥י</char> <char style="w" x-id="WLC.JOB.9.29.002" x-align="JOB.9.29.a002" x-target-ids="t002 t003 t004" x-target="shall be condemned" x-target-head="t004" x-head="true" lemma="רָשַׁע" strong="H7561" x-morph="Vqi1cs" x-gloss="I.will.be.guilty" x-translit="ʾeršāʿ" xml:lang="hbo">אֶרְשָׁ֑ע</char> <char style="w" x-id="WLC.JOB.9.29.003" x-align="JOB.9.29.a003" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.9.29.004" x-align="JOB.9.29.a003" x-target-ids="t005" x-target="Why" x-target-head="t005" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ-" xml:lang="hbo">מָּה</char>־<char style="w" x-id="WLC.JOB.9.29.005" x-align="JOB.9.29.a004" x-target-ids="t006" x-target="then" x-target-head="t006" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zzeh" xml:lang="hbo">זֶּ֝֗ה</char> <char style="w" x-id="WLC.JOB.9.29.006" x-align="JOB.9.29.a005" x-target-ids="t010 t011" x-target="in vain" x-target-head="t011" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsa" x-gloss="vanity" x-translit="heḇel" xml:lang="hbo">הֶ֣בֶל</char> <char style="w" x-id="WLC.JOB.9.29.007" x-align="JOB.9.29.a006" x-target-ids="t007 t008 t009" x-target="do I labor" x-target-head="t009" x-head="true" lemma="יָגֵעַ" strong="H3021" x-morph="Vqi1cs" x-gloss="will.I.labor" x-translit="ʾîḡāʿ:" xml:lang="hbo">אִיגָֽע</char>׃<verse eid="JOB 9:29" /></para>
	<para style="p"><verse number="30" style="v" x-ref="JOB.9.30" sid="JOB 9:30" /><char style="w" x-id="WLC.JOB.9.30.001" x-align="JOB.9.30.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.30.002" x-align="JOB.9.30.a002" x-target-ids="t002 t003 t004" x-target="I wash myself" x-target-head="t003" x-head="true" lemma="רָחַץ" strong="H7364" x-morph="Vtp1cs" x-gloss="I.washed.myself" x-translit="hiṯrāḥaṣətî" xml:lang="hbo">הִתְרָחַ֥צְתִּי</char> <char style="w" x-id="WLC.JOB.9.30.003" x-align="JOB.9.30.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="**ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.JOB.9.30.004" x-align="JOB.9.30.a004" x-target-ids="t007" x-target="water" x-target-head="t007" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpc" x-gloss="water" x-translit="**mê-" xml:lang="hbo">מֵי</char>־<char style="w" x-id="WLC.JOB.9.30.005" x-align="JOB.9.30.a005" x-target-ids="t006" x-target="snow" x-target-head="t006" x-head="true" lemma="שֶׁלֶג" strong="H7950" x-morph="Ncmsa" x-gloss="of.snow" x-translit="šāleḡ" xml:lang="hbo">שָׁ֑לֶג</char> <char style="w" x-id="WLC.JOB.9.30.006" x-align="JOB.9.30.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝</char><char style="w" x-id="WLC.JOB.9.30.007" x-align="JOB.9.30.a007" x-target-ids="t009 t014" x-target="make clean" x-target-head="t014" x-head="true" lemma="זָכַךְ" strong="H2141" x-morph="Vhq1cs" x-gloss="I.cleansed" x-translit="hăzikôṯî" xml:lang="hbo">הֲזִכּ֗וֹתִי</char> <char style="w" x-id="WLC.JOB.9.30.008" x-align="JOB.9.30.a008" x-status="noncompositional" x-target-ids="t012 t013" x-target="never so" x-target-head="t013" x-head="true" lemma="בְּ" s