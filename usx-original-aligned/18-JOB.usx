	<para style="p"><verse number="31" style="v" x-ref="JOB.15.31" sid="JOB 15:31" /><char style="w" x-id="WLC.JOB.15.31.001" x-align="JOB.15.31.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.JOB.15.31.002" x-align="JOB.15.31.a002" x-target-ids="t001 t002 t004" x-target="Let him trust" x-target-head="t004" x-head="true" lemma="אָמַן" strong="H539" x-morph="Vhj3ms" x-gloss="let.him.trust" x-translit="yaʾămēn" xml:lang="hbo">יַאֲמֵ֣ן</char> <char style="w" x-id="WLC.JOB.15.31.003" x-align="JOB.15.31.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="**ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.JOB.15.31.004" x-align="JOB.15.31.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.15.31.005" x-align="JOB.15.31.a005" x-target-ids="t006" x-target="vanity" x-target-head="t006" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="worthlessness" x-translit="**ššāyw" xml:lang="hbo">שָּׁ֣יו</char> <char style="w" x-id="WLC.JOB.15.31.006" x-align="JOB.15.31.a006" x-target-ids="t007 t008" x-target="deceiving himself" x-target-head="t007" x-head="true" lemma="תָּעָה" strong="H8582" x-morph="VNp3ms" x-gloss="he.has.been.led.astray" x-translit="niṯʿāh" xml:lang="hbo">נִתְעָ֑ה</char> <char style="w" x-id="WLC.JOB.15.31.007" x-align="JOB.15.31.a007" x-target-ids="t009" x-target="For" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.15.31.008" x-align="JOB.15.31.a008" x-target-ids="t010" x-target="vanity" x-target-head="t010" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-glos