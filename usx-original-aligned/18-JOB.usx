	<para style="p"><verse number="17" style="v" x-ref="JOB.9.17" sid="JOB 9:17" /><char style="w" x-id="WLC.JOB.9.17.001" x-align="JOB.9.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.JOB.9.17.002" x-align="JOB.9.17.a002" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.JOB.9.17.003" x-align="JOB.9.17.a003" x-target-ids="t006 t007" x-target="a tempest" x-target-head="t007" x-head="true" lemma="שְׂעָרָה" strong="H8183" x-morph="Ncfsa" x-gloss="a.storm" x-translit="śəʿārāh" xml:lang="hbo">שְׂעָרָ֥ה</char> <char style="w" x-id="WLC.JOB.9.17.004" x-align="JOB.9.17.a004" x-target-ids="t002 t003" x-target="he breaketh" x-target-head="t003" x-head="true" lemma="שׁוּף" strong="H7779" x-morph="Vqi3ms" x-gloss="he" x-translit="yəšûp̄" xml:lang="hbo">יְשׁוּפֵ֑</char><char style="w" x-id="WLC.JOB.9.17.005" x-align="JOB.9.17.a005" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="crushes.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.9.17.006" x-align="JOB.9.17.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.9.17.007" x-align="JOB.9.17.a007" x-target-ids="t009" x-target="multiplieth" x-target-head="t009" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vhq3ms" x-gloss="he.increases" x-translit="hirbāh" xml:lang="hbo">הִרְבָּ֖ה</char> <char style="w" x-id="WLC.JOB.9.17.008" x-align="JOB.9.17.a008" x-target-ids="t011" x-target="wounds" x-target-head="t011" x-head="true" lemma="פֶּצַע" strong="H6482" x-morph="Ncmpc" x-gloss="bruis