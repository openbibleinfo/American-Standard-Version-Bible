	<para style="p"><verse number="6" style="v" x-ref="JOB.19.6" x-added-alignments="JOB.19.6.a007" x-added-target-ids="t008 t009 t010" x-added-target="in my cause" sid="JOB 19:6" /><char style="w" x-id="WLC.JOB.19.6.001" x-align="JOB.19.6.a001" x-target-ids="t001" x-target="Know" x-target-head="t001" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqv2mp" x-gloss="know" x-translit="dəʿû-" xml:lang="hbo">דְּֽעוּ</char>־<char style="w" x-id="WLC.JOB.19.6.002" x-align="JOB.19.6.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="אֵפוֹ" strong="H645" x-morph="D" x-gloss="then" x-translit="ʾēp̄ô" xml:lang="hbo">אֵ֭פוֹ</char> <char style="w" x-id="WLC.JOB.19.6.003" x-align="JOB.19.6.a003" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.19.6.004" x-align="JOB.19.6.a004" x-target-ids="t004" x-target="God" x-target-head="t004" x-head="true" lemma="אֱלֹוהַּ" strong="H433" x-morph="Ncmsa" x-gloss="God" x-translit="ʾĕlôᵃẖ" xml:lang="hbo">אֱל֣וֹהַּ</char> <char style="w" x-id="WLC.JOB.19.6.005" x-align="JOB.19.6.a005" x-target-ids="t005 t006" x-target="hath subverted" x-target-head="t006" x-head="true" lemma="עָוַת" strong="H5791" x-morph="Vpp3ms" x-gloss="he" x-translit="ʿiwwəṯ" xml:lang="hbo">עִוְּתָ֑</char><char style="w" x-id="WLC.JOB.19.6.006" x-align="JOB.19.6.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.subverted.me" x-translit="āniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.19.6.007" x-align="JOB.19.6.a008" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.19.6.008" x-align="JOB.19.6.a009" x-target-ids="t017" x-target="net" x-target-head="t01