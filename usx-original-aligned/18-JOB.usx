	<para style="p"><verse number="4" style="v" x-ref="JOB.7.4" sid="JOB 7:4" /><char style="w" x-id="WLC.JOB.7.4.001" x-align="JOB.7.4.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.7.4.002" x-align="JOB.7.4.a002" x-target-ids="t002 t003 t004" x-target="I lie down" x-target-head="t003" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqp1cs" x-gloss="I.lay.down" x-translit="šāḵaḇətî" xml:lang="hbo">שָׁכַ֗בְתִּי</char> <char style="w" x-id="WLC.JOB.7.4.003" x-align="JOB.7.4.a003" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.7.4.004" x-align="JOB.7.4.a004" x-target-ids="t005 t006" x-target="I say" x-target-head="t006" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq1cs" x-gloss="I.will.say" x-translit="ʾāmarətî" xml:lang="hbo">אָמַ֗רְתִּי</char> <char style="w" x-id="WLC.JOB.7.4.005" x-align="JOB.7.4.a005" x-target-ids="t007" x-target="When" x-target-head="t007" x-head="true" lemma="מָתַי" strong="H4970" x-morph="Ti" x-gloss="when?" x-translit="māṯay" xml:lang="hbo">מָתַ֣י</char> <char style="w" x-id="WLC.JOB.7.4.006" x-align="JOB.7.4.a006" x-target-ids="t008 t009 t010" x-target="shall I arise" x-target-head="t010" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi1cs" x-gloss="will.I.arise" x-translit="ʾāqûm" xml:lang="hbo">אָ֭קוּם</char> <char style="w" x-id="WLC.JOB.7.4.007" x-align="JOB.7.4.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.7.4.008" x-align="JOB.7.4.a008" x-target-ids="t014 t015" x-target="be gone" x-target-head="t015" x-head="true" lemma="מָדַד" strong="H4058" x-morph="Vpq3ms" x-gloss="it.will.continue" x-translit="middaḏ-"