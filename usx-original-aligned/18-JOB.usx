	<para style="p"><verse number="1" style="v" x-ref="JOB.9.1" sid="JOB 9:1" /><char style="w" x-id="WLC.JOB.9.1.001" x-align="JOB.9.1.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.9.1.002" x-align="JOB.9.1.a002" x-target-ids="t003" x-target="answered" x-target-head="t003" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw3ms" x-gloss="he.answered" x-translit="yyaʿan" xml:lang="hbo">יַּ֥עַן</char> <char style="w" x-id="WLC.JOB.9.1.003" x-align="JOB.9.1.a003" x-target-ids="t002" x-target="Job" x-target-head="t002" x-head="true" lemma="אִיּוֹב" strong="H347" x-morph="Np" x-gloss="Job" x-translit="ʾiyyôḇ" xml:lang="hbo">אִיּ֗וֹב</char> <char style="w" x-id="WLC.JOB.9.1.004" x-align="JOB.9.1.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.9.1.005" x-align="JOB.9.1.a005" x-target-ids="t005" x-target="said" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar:" xml:lang="hbo">יֹּאמַֽר</char>׃<verse eid="JOB 9:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="JOB.9.2" sid="JOB 9:2" /><char style="w" x-id="WLC.JOB.9.2.001" x-align="JOB.9.2.a001" x-target-ids="t001 t002 t003" x-target="Of a truth" x-target-head="t003" x-head="true" lemma="אׇמְנָם" strong="H551" x-morph="D" x-gloss="truly" x-translit="ʾomnām" xml:lang="hbo">אָ֭מְנָם</char> <char style="w" x-id="WLC.JOB.9.2.002" x-align="JOB.9.2.a002" x-target-ids="t004 t005" x-target="I know" x-target-head="t005" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿətî" xml:lang="hbo">יָדַ֣עְתִּי</char> <char style="w" x-id="WLC.JOB.9.2.003" x-align="JOB.9.2.a003" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="ḵî-" xml:lang="hbo">כִי</char>־<char style="w" x-id="WLC.JOB.9.2.004" x-align="JOB.9.2.a004" x-target-ids="t007 t008 t009" x-target="it is so" x-target-head="t009" x-head="true" lemma="כֵּן" strong="H3651a" x-morph="D" x-gloss="thus" x-translit="ḵēn" xml:lang="hbo">כֵ֑ן</char> <char style="w" x-id="WLC.JOB.9.2.005" x-align="JOB.9.2.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.9.2.006" x-align="JOB.9.2.a006" x-target-ids="t011" x-target="how" x-target-head="t011" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.9.2.007" x-align="JOB.9.2.a007" x-target-ids="t012 t014 t015" x-target="can be just" x-target-head="t015" x-head="true" lemma="צָדֵק" strong="H6663" x-morph="Vqi3ms" x-gloss="will.he.be.justified" x-translit="yyiṣdaq" xml:lang="hbo">יִּצְדַּ֖ק</char> <char style="w" x-id="WLC.JOB.9.2.008" x-align="JOB.9.2.a008" x-target-ids="t013" x-target="man" x-target-head="t013" x-head="true" lemma="אֱנוֹשׁ" strong="H582" x-morph="Ncmsa" x-gloss=