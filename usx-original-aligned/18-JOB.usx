	<para style="p"><verse number="18" style="v" x-ref="JOB.34.18" x-added-alignments="JOB.34.18.a009 JOB.34.18.a010 JOB.34.18.a011" x-added-target-ids="t007 t010 t013" x-added-target="Thou | Or | Ye" sid="JOB 34:18" /><char style="w" x-id="WLC.JOB.34.18.001" x-align="JOB.34.18.a001" x-status="unrepresented" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="to" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JOB.34.18.002" x-align="JOB.34.18.a002" x-target-ids="t001 t002 t003" x-target="Him that saith" x-target-italic-ids="t001" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqc" x-gloss="say?" x-translit="ʾămōr" xml:lang="hbo">אֲמֹ֣ר</char> <char style="w" x-id="WLC.JOB.34.18.003" x-align="JOB.34.18.a003" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.34.18.004" x-align="JOB.34.18.a004" x-target-ids="t005 t006" x-target="a king" x-target-head="t006" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="a.king" x-translit="meleḵ" xml:lang="hbo">מֶ֣לֶךְ</char> <char style="w" x-id="WLC.JOB.34.18.005" x-align="JOB.34.18.a005" x-target-ids="t008 t009" x-target="art vile" x-target-italic-ids="t008" x-target-head="t009" x-head="true" lemma="בְּלִיַּעַל" strong="H1100" x-morph="Ncmsa" x-gloss="worthless.person" x-translit="bəliyyāʿal" xml:lang="hbo">בְּלִיָּ֑עַל</char> <char style="w" x-id="WLC.JOB.34.18.006" x-align="JOB.34.18.a006" x-target-ids="t014 t015" x-target="are wicked" x-target-italic-ids="t014" x-target-head="t015" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="wicked.[one]" x-translit="rāšāʿ" xml:lang="hbo">רָ֝שָׁ֗ע</char> <char style="w" x-id="WLC.JOB.34.18.007" x-align="JOB.34.18.a007" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:la