	<para style="p"><verse number="19" style="v" x-ref="JOB.11.19" x-added-alignments="JOB.11.19.a010" x-added-target-ids="t010" x-added-target="thee" sid="JOB 11:19" /><char style="w" x-id="WLC.JOB.11.19.001" x-align="JOB.11.19.a001" x-target-ids="t001" x-target="Also" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ֭</char><char style="w" x-id="WLC.JOB.11.19.002" x-align="JOB.11.19.a002" x-target-ids="t002 t003 t004 t005" x-target="thou shalt lie down" x-target-head="t004" x-head="true" lemma="רָבַץ" strong="H7257" x-morph="Vqq2ms" x-gloss="you.will.lie.down" x-translit="rāḇaṣtā" xml:lang="hbo">רָבַצְתָּ</char> <char style="w" x-id="WLC.JOB.11.19.003" x-align="JOB.11.19.a003" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.11.19.004" x-align="JOB.11.19.a004" x-target-ids="t007" x-target="none" x-target-head="t007" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[will].not.[be]" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.JOB.11.19.005" x-align="JOB.11.19.a005" x-target-ids="t008 t009 t011" x-target="shall make afraid" x-target-head="t011" x-head="true" lemma="חָרַד" strong="H2729" x-morph="Vhrmsa" x-gloss="[one.who].terrifies" x-translit="maḥăriyḏ" xml:lang="hbo">מַחֲרִ֑יד</char> <char style="w" x-id="WLC.JOB.11.19.006" x-align="JOB.11.19.a006" x-target-ids="t012" x-target="Yea" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.11.19.007" x-align="JOB.11.19.a007" x-target-ids="t014 t015 t016 t017" x-target="shall make suit unto" x-target-head="t016" x-head="true" lemma="חָלָה" strong="H2470a" x-morph="Vpq3cp" x-gloss="they.will.entreat" x-translit="ḥillû" xml:lang="hbo">חִלּ֖וּ</char> <char style=