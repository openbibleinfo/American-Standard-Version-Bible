	<para style="p"><verse number="17" style="v" x-ref="JOB.28.17" sid="JOB 28:17" /><char style="w" x-id="WLC.JOB.28.17.001" x-align="JOB.28.17.a001" x-target-ids="t004" x-target="cannot" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.28.17.002" x-align="JOB.28.17.a002" x-target-ids="t005" x-target="equal" x-target-head="t005" x-head="true" lemma="עָרַךְ" strong="H6186" x-morph="Vqi3ms" x-gloss="it" x-translit="yaʿarḵ" xml:lang="hbo">יַעַרְכֶ֣</char><char style="w" x-id="WLC.JOB.28.17.003" x-align="JOB.28.17.a003" x-target-ids="t006" x-target="it" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5089a" x-morph="Sp3fs" x-gloss="will.be.comparable.to.it" x-translit="ennāh" xml:lang="hbo">נָּה</char> <char style="w" x-id="WLC.JOB.28.17.004" x-align="JOB.28.17.a004" x-target-ids="t001" x-target="Gold" x-target-head="t001" x-head="true" lemma="זָהָב" strong="H2091" x-morph="Ncmsa" x-gloss="gold" x-translit="zāhāḇ" xml:lang="hbo">זָ֭הָב</char> <char style="w" x-id="WLC.JOB.28.17.005" x-align="JOB.28.17.a005" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.28.17.006" x-align="JOB.28.17.a006" x-target-ids="t003" x-target="glass" x-target-head="t003" x-head="true" lemma="זְכוּכִית" strong="H2137" x-morph="Ncfsa" x-gloss="glass" x-translit="zəḵôḵiyṯ" xml:lang="hbo">זְכוֹכִ֑ית</char> <char style="w" x-id="WLC.JOB.28.17.007" x-align="JOB.28.17.a007" x-target-ids="t007" x-target="Neither" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.28.17.008" x-align="JOB.28.17.a008" x-target-ids="t008 t010 t011" x-target="shall be exchanged" x-target-head="t011" x-head="true" lemma="תְּמוּרָה" strong="H8545" x-morph="