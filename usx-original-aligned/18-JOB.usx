	<para style="p"><verse number="20" style="v" x-ref="JOB.30.20" sid="JOB 30:20" /><char style="w" x-id="WLC.JOB.30.20.001" x-align="JOB.30.20.a001" x-target-ids="t001 t002" x-target="I cry" x-target-head="t002" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpi1cs" x-gloss="I.cry.for.help" x-translit="ʾăšawwaʿ" xml:lang="hbo">אֲשַׁוַּ֣ע</char> <char style="w" x-id="WLC.JOB.30.20.002" x-align="JOB.30.20.a002" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēley" xml:lang="hbo">אֵ֭לֶי</char><char style="w" x-id="WLC.JOB.30.20.003" x-align="JOB.30.20.a003" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.30.20.004" x-align="JOB.30.20.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.30.20.005" x-align="JOB.30.20.a006" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.30.20.006" x-align="JOB.30.20.a005" x-target-ids="t006 t007 t009" x-target="thou dost answer" x-target-head="t009" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi2ms" x-gloss="you" x-translit="ṯaʿăn" xml:lang="hbo">תַעֲנֵ֑</char><char style="w" x-id="WLC.JOB.30.20.007" x-align="JOB.30.20.a007" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="answer.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.30.20.008" x-align="JOB.30.20.a008" x-target-ids="t011 t012 t013" x-target="I stand up" x-target-head="t012" x-head="true" lemma="עָמַד" strong="H5975" x-morph="Vqp1cs" x-g