	<para style="p"><verse number="14" style="v" x-ref="JOB.10.14" sid="JOB 10:14" /><char style="w" x-id="WLC.JOB.10.14.001" x-align="JOB.10.14.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.10.14.002" x-align="JOB.10.14.a002" x-target-ids="t002 t003" x-target="I sin" x-target-head="t003" x-head="true" lemma="חָטָא" strong="H2398" x-morph="Vqp1cs" x-gloss="I.sinned" x-translit="ḥāṭāʾṯî" xml:lang="hbo">חָטָ֥אתִי</char> <char style="w" x-id="WLC.JOB.10.14.003" x-align="JOB.10.14.a003" x-target-ids="t004" x-target="then" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.10.14.004" x-align="JOB.10.14.a004" x-target-ids="t005 t006" x-target="thou markest" x-target-head="t006" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqq2ms" x-gloss="you" x-translit="šəmartā" xml:lang="hbo">שְׁמַרְתָּ֑</char><char style="w" x-id="WLC.JOB.10.14.005" x-align="JOB.10.14.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.watch.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.10.14.006" x-align="JOB.10.14.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.10.14.007" x-align="JOB.10.14.a007" x-target-ids="t014" x-target="from" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.JOB.10.14.008" x-align="JOB.10.14.a008" x-target-ids="t016" x-target="iniquity" x-target-head="t016" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsc" x-gloss="iniquity" x-translit="ʿăôn" xml