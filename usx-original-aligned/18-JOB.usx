	<para style="p"><verse number="9" style="v" x-ref="JOB.32.9" x-added-alignments="JOB.32.9.a001 JOB.32.9.a004 JOB.32.9.a008" x-added-target-ids="t001 t002 t006 t012" x-added-target="It is | that | that" sid="JOB 32:9" /><char style="w" x-id="WLC.JOB.32.9.001" x-align="JOB.32.9.a002" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.32.9.002" x-align="JOB.32.9.a003" x-target-ids="t004 t005" x-target="the great" x-target-head="t005" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbiym" xml:lang="hbo">רַבִּ֥ים</char> <char style="w" x-id="WLC.JOB.32.9.003" x-align="JOB.32.9.a005" x-target-ids="t007 t008" x-target="are wise" x-target-head="t008" x-head="true" lemma="חָכַם" strong="H2449" x-morph="Vqi3mp" x-gloss="they.are.wise" x-translit="yeḥkāmû" xml:lang="hbo">יֶחְכָּ֑מוּ</char> <char style="w" x-id="WLC.JOB.32.9.004" x-align="JOB.32.9.a006" x-target-ids="t009" x-target="Nor" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.32.9.005" x-align="JOB.32.9.a007" x-target-ids="t010 t011" x-target="the aged" x-target-head="t011" x-head="true" lemma="זָקֵן" strong="H2205" x-morph="Aampa" x-gloss="old.[people]" x-translit="zəqēniym" xml:lang="hbo">זְקֵנִ֗ים</char> <char style="w" x-id="WLC.JOB.32.9.006" x-align="JOB.32.9.a009" x-target-ids="t013" x-target="understand" x-target-head="t013" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi3mp" x-gloss="they.understand" x-translit="yāḇiynû" xml:lang="hbo">יָבִ֥ינוּ</char> <char style="w" x-id="WLC.JOB.32.9.007" x-align="JOB.32.9.a010" x-target-ids="t014" x-target="justice" x-target-head="t014" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="justice" x-translit="mišpāṭ:" xml:lang="hbo">מִשְׁפָּֽט</cha