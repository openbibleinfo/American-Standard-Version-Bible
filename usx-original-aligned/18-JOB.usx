	<para style="p"><verse number="32" style="v" x-ref="JOB.41.32" sid="JOB 41:32" /><char style="w" x-id="WLC.JOB.41.32.001" x-align="JOB.41.32.a003" x-target-ids="t007" x-target="after" x-target-head="t007" x-head="true" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="behind" x-translit="ʾaḥărāy" xml:lang="hbo" x-source-ref="JOB.41.24">אַ֭חֲרָי</char><char style="w" x-id="WLC.JOB.41.32.002" x-align="JOB.41.32.a004" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="it" x-translit="w" xml:lang="hbo" x-source-ref="JOB.41.24">ו</char> <char style="w" x-id="WLC.JOB.41.32.003" x-align="JOB.41.32.a001" x-target-ids="t001 t002 t005 t006" x-target="He maketh to shine" x-target-head="t006" x-head="true" lemma="אוֹר" strong="H215" x-morph="Vhi3ms" x-gloss="it.makes.shine" x-translit="yāʾiyr" xml:lang="hbo" x-source-ref="JOB.41.24">יָאִ֣יר</char> <char style="w" x-id="WLC.JOB.41.32.004" x-align="JOB.41.32.a002" x-target-ids="t003 t004" x-target="a path" x-target-head="t004" x-head="true" lemma="נָתִיב" strong="H5410a" x-morph="Ncbsa" x-gloss="a.path" x-translit="nāṯiyḇ" xml:lang="hbo" x-source-ref="JOB.41.24">נָתִ֑יב</char> <char style="w" x-id="WLC.JOB.41.32.005" x-align="JOB.41.32.a005" x-target-ids="t009 t010 t011" x-target="One would think" x-target-head="t011" x-head="true" lemma="חָשַׁב" strong="H2803" x-morph="Vqi3ms" x-gloss="anyone.considers" x-translit="yaḥšōḇ" xml:lang="hbo" x-source-ref="JOB.41.24">יַחְשֹׁ֖ב</char> <char style="w" x-id="WLC.JOB.41.32.006" x-align="JOB.41.32.a006" x-target-ids="t012 t013" x-target="the deep" x-target-head="t013" x-head="true" lemma="תְּהוֹם" strong="H8415" x-morph="Ncbsa" x-gloss="the.deep" x-translit="təhôm" xml:lang="hbo" x-source-ref="JOB.41.24">תְּה֣וֹם</char> <char style="w" x-id="WLC.JOB.41.32.007" x-align="JOB.41.32.a007" x-target-ids="t014 t015" x-target="to be" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-tra