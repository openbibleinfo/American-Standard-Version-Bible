	<para style="p"><verse number="21" style="v" x-ref="JOB.20.21" x-added-alignments="JOB.20.21.a006" x-added-target-ids="t008" x-added-target="not" sid="JOB 20:21" /><char style="w" x-id="WLC.JOB.20.21.001" x-align="JOB.20.21.a001" x-target-ids="t001 t002 t003" x-target="There was nothing" x-target-head="t003" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾên-" xml:lang="hbo">אֵין</char>־<char style="w" x-id="WLC.JOB.20.21.002" x-align="JOB.20.21.a002" x-target-ids="t004" x-target="left" x-target-head="t004" x-head="true" lemma="שָׂרִיד" strong="H8300" x-morph="Ncmsa" x-gloss="a.survivor" x-translit="śāriyḏ" xml:lang="hbo">שָׂרִ֥יד</char> <char style="w" x-id="WLC.JOB.20.21.003" x-align="JOB.20.21.a003" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="he" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.20.21.004" x-align="JOB.20.21.a004" x-target-ids="t007" x-target="devoured" x-target-head="t007" x-head="true" lemma="אֹכֶל" strong="H400" x-morph="Vqc" x-gloss="to" x-translit="ʾāḵəl" xml:lang="hbo">אָכְל֑</char><char style="w" x-id="WLC.JOB.20.21.005" x-align="JOB.20.21.a005" x-target-ids="t006" x-target="he" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="devour" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.20.21.006" x-align="JOB.20.21.a007" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JOB.20.21.007" x-align="JOB.20.21.a007" x-target-ids="t009" x-target="Therefore" x-target-head="t009" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֝֗ן</char> <char style="w" x-id="WLC.JOB.20.21.008" x-align="JOB.20.21.a008" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit=