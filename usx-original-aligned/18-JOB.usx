	<para style="p"><verse number="20" style="v" x-ref="JOB.22.20" x-added-alignments="JOB.22.20.a001" x-added-target-ids="t001" x-added-target="Saying" sid="JOB 22:20" /><char style="w" x-id="WLC.JOB.22.20.001" x-align="JOB.22.20.a002" x-target-ids="t002" x-target="Surely" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.22.20.002" x-align="JOB.22.20.a002" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.22.20.003" x-align="JOB.22.20.a003" x-target-ids="t010 t011 t012" x-target="are cut off" x-target-head="t011" x-head="true" lemma="כָּחַד" strong="H3582" x-morph="VNp3ms" x-gloss="he.has.been.destroyed" x-translit="niḵḥaḏ" xml:lang="hbo">נִכְחַ֣ד</char> <char style="w" x-id="WLC.JOB.22.20.004" x-align="JOB.22.20.a004" x-target-ids="t003 t004 t005 t006 t007 t008" x-target="they that did rise up against" x-target-head="t006" x-head="true" lemma="קִים" strong="H7009" x-morph="Ncmsc" x-gloss="adversary" x-translit="qiym" xml:lang="hbo">קִימָ֑</char><char style="w" x-id="WLC.JOB.22.20.005" x-align="JOB.22.20.a005" x-target-ids="t009" x-target="us" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ānû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.JOB.22.20.006" x-align="JOB.22.20.a006" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.22.20.007" x-align="JOB.22.20.a007" x-target-ids="t014 t015" x-target="the remnant" x-target-head="t015" x-head="true" lemma="יֶתֶר" strong="H3499" x-morph="Ncmsc" x-gloss="abundance" x-translit="yiṯr" xml:lang="hbo">יִתְרָ֗</char><char style="w" x-id="WLC.JOB.22.20.008" x-align="JOB.22.20.a008" x-target-ids="t016 t017" x-target="of them" x-target-head="