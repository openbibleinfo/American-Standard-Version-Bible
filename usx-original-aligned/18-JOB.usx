	<para style="p"><verse number="12" style="v" x-ref="JOB.36.12" sid="JOB 36:12" /><char style="w" x-id="WLC.JOB.36.12.001" x-align="JOB.36.12.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.36.12.002" x-align="JOB.36.12.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.36.12.003" x-align="JOB.36.12.a003" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.36.12.004" x-align="JOB.36.12.a004" x-target-ids="t003 t004" x-target="they hearken" x-target-head="t004" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi3mp" x-gloss="they.will.hear" x-translit="yišməʿû" xml:lang="hbo">יִ֭שְׁמְעוּ</char> <char style="w" x-id="WLC.JOB.36.12.005" x-align="JOB.36.12.a005" x-target-ids="t009" x-target="by" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.36.12.006" x-align="JOB.36.12.a006" x-target-ids="t010 t011" x-target="the sword" x-target-head="t011" x-head="true" lemma="שֶׁלַח" strong="H7973a" x-morph="Ncmsa" x-gloss="a.missile" x-translit="šelaḥ" xml:lang="hbo">שֶׁ֣לַח</char> <char style="w" x-id="WLC.JOB.36.12.007" x-align="JOB.36.12.a007" x-target-ids="t006 t007 t008" x-target="they shall perish" x-target-head="t008" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqi3mp" x-gloss="they.will.pass.away" x-translit="yaʿăḇōrû" xml:lang="hbo">יַעֲבֹ֑רוּ</char> <char style="w" x-id="WLC.JOB.36.12.008" x-align="JOB.36.12.a008" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-m