	<para style="p"><verse number="16" style="v" x-ref="JOB.35.16" sid="JOB 35:16" /><char style="w" x-id="WLC.JOB.35.16.001" x-align="JOB.35.16.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.JOB.35.16.002" x-align="JOB.35.16.a002" x-target-ids="t003" x-target="Job" x-target-head="t003" x-head="true" lemma="אִיּוֹב" strong="H347" x-morph="Np" x-gloss="Job" x-translit="ʾiyyôḇ" xml:lang="hbo">אִיּוֹב</char> <char style="w" x-id="WLC.JOB.35.16.003" x-align="JOB.35.16.a003" x-target-ids="t007 t008" x-target="in vanity" x-target-head="t008" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsa" x-gloss="vanity" x-translit="heḇel" xml:lang="hbo">הֶ֣בֶל</char> <char style="w" x-id="WLC.JOB.35.16.004" x-align="JOB.35.16.a004" x-target-ids="t002 t004" x-target="doth open" x-target-head="t004" x-head="true" lemma="פָּצָה" strong="H6475" x-morph="Vqi3ms" x-gloss="he.opens" x-translit="yip̄ṣeh-" xml:lang="hbo">יִפְצֶה</char>־<char style="w" x-id="WLC.JOB.35.16.005" x-align="JOB.35.16.a005" x-target-ids="t006" x-target="mouth" x-target-head="t006" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="piy" xml:lang="hbo">פִּ֑י</char><char style="w" x-id="WLC.JOB.35.16.006" x-align="JOB.35.16.a006" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.JOB.35.16.007" x-align="JOB.35.16.a007" x-status="noncompositional" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.JOB.35.16.008" x-align="JOB.35.16.a007" x-status="noncompositional" x-target-ids="t012" x-target="without" x-target-head="t012" x-head="true" lemma="בְּלִי" strong="H1097" x-morph="Ncmsc" x-gloss="not" x-translit="ḇəlî-" xm