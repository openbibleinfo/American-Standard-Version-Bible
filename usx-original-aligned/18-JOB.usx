	<para style="p"><verse number="20" style="v" x-ref="JOB.31.20" sid="JOB 31:20" /><char style="w" x-id="WLC.JOB.31.20.001" x-align="JOB.31.20.a001" x-target-ids="t001 t009" x-target="If if" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.20.002" x-align="JOB.31.20.a005" x-target-ids="t005 t012" x-target="not not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.31.20.003" x-align="JOB.31.20.a004" x-target-ids="t004 t006" x-target="have blessed" x-target-head="t006" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpp3cp" x-gloss="they" x-translit="ḇērăḵû" xml:lang="hbo">בֵרֲכ֣וּ</char><char style="w" x-id="WLC.JOB.31.20.004" x-align="JOB.31.20.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="blessed.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.31.20.005" x-align="JOB.31.20.a003" x-target-ids="t003" x-target="loins" x-target-head="t003" x-head="true" lemma="חָלָץ" strong="H2504" x-morph="Ncbdc" x-gloss="loins" x-translit="ḥălāṣāy" xml:lang="hbo">חֲלָצָ֑י</char><char style="w" x-id="WLC.JOB.31.20.006" x-align="JOB.31.20.a002" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.31.20.007" x-align="JOB.31.20.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.31.20.008" x-align="JOB.31.20.a009" x-target-ids="t015" x-target="with" x-target-head="t015" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="h