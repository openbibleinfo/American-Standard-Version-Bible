	<para style="p"><verse number="32" style="v" x-ref="JOB.9.32" x-added-alignments="JOB.9.32.a004 JOB.9.32.a007 JOB.9.32.a010" x-added-target-ids="t002 t010 t015" x-added-target="he | that | That" sid="JOB 9:32" /><char style="w" x-id="WLC.JOB.9.32.001" x-align="JOB.9.32.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.9.32.002" x-align="JOB.9.32.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.9.32.003" x-align="JOB.9.32.a003" x-target-ids="t003 t005 t006" x-target="is a man" x-target-head="t006" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="[he.is].a.human" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.JOB.9.32.004" x-align="JOB.9.32.a005" x-target-ids="t007 t009" x-target="as am" x-target-head="t007" x-head="true" lemma="כְּמוֹ" strong="H3644" x-morph="R" x-gloss="like" x-translit="kāmō" xml:lang="hbo">כָּמֹ֣</char><char style="w" x-id="WLC.JOB.9.32.005" x-align="JOB.9.32.a006" x-target-ids="t008" x-target="I" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.9.32.006" x-align="JOB.9.32.a008" x-target-ids="t011 t012 t013" x-target="I should answer" x-target-head="t013" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi1cs" x-gloss="I" x-translit="ʾeʿĕn" xml:lang="hbo">אֶֽעֱנֶ֑</char><char style="w" x-id="WLC.JOB.9.32.007" x-align="JOB.9.32.a009" x-target-ids="t014" x-target="him" x-target-head="t014" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="will.answer.him" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.JOB.9.32.008" x-align="JOB.9.32.a011" x-