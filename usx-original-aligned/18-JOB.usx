	<para style="p"><verse number="21" style="v" x-ref="JOB.18.21" sid="JOB 18:21" /><char style="w" x-id="WLC.JOB.18.21.001" x-align="JOB.18.21.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.JOB.18.21.002" x-align="JOB.18.21.a002" x-target-ids="t002" x-target="such" x-target-head="t002" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these" x-translit="ʾēlleh" xml:lang="hbo">אֵ֭לֶּה</char> <char style="w" x-id="WLC.JOB.18.21.003" x-align="JOB.18.21.a003" x-target-ids="t003 t004 t005" x-target="are the dwellings" x-target-head="t005" x-head="true" lemma="מִשְׁכָּן" strong="H4908" x-morph="Ncmpc" x-gloss="[are].the.dwelling.places" x-translit="miškənôṯ" xml:lang="hbo">מִשְׁכְּנ֣וֹת</char> <char style="w" x-id="WLC.JOB.18.21.004" x-align="JOB.18.21.a004" x-target-ids="t006 t007 t008" x-target="of the unrighteous" x-target-head="t008" x-head="true" lemma="עַוָּל" strong="H5767" x-morph="Ncmsa" x-gloss="of.an.unjust.person" x-translit="ʿawwāl" xml:lang="hbo">עַוָּ֑ל</char> <char style="w" x-id="WLC.JOB.18.21.005" x-align="JOB.18.21.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.18.21.006" x-align="JOB.18.21.a006" x-target-ids="t010" x-target="this" x-target-head="t010" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֗ה</char> <char style="w" x-id="WLC.JOB.18.21.007" x-align="JOB.18.21.a007" x-target-ids="t011 t012 t013" x-target="is the place" x-target-head="t013" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsc" x-gloss="[is.the].place" x-translit="məqôm" xml:lang="hbo">מְק֣וֹם</char> <char style="w" x-id="WLC.JOB.18.21.008" x-align="JOB.18.21.a008" x-target-ids="t018" x-target=