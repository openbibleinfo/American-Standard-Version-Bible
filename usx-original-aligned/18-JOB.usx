	<para style="p"><verse number="20" style="v" x-ref="JOB.32.20" sid="JOB 32:20" /><char style="w" x-id="WLC.JOB.32.20.001" x-align="JOB.32.20.a001" x-target-ids="t001 t002 t003" x-target="I will speak" x-target-head="t003" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vph1cs" x-gloss="let.me.speak" x-translit="ʾăḏabbərāh" xml:lang="hbo">אֲדַבְּרָ֥ה</char> <char style="w" x-id="WLC.JOB.32.20.002" x-align="JOB.32.20.a002" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="so" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.32.20.003" x-align="JOB.32.20.a003" x-target-ids="t006 t007 t008" x-target="may be refreshed" x-target-head="t008" x-head="true" lemma="רָוַח" strong="H7304" x-morph="Vqi3ms" x-gloss="that.it.may.be.relief" x-translit="yirəwaḥ-" xml:lang="hbo">יִֽרְוַֽח</char>־<char style="w" x-id="WLC.JOB.32.20.004" x-align="JOB.32.20.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֑</char><char style="w" x-id="WLC.JOB.32.20.005" x-align="JOB.32.20.a005" x-target-ids="t005" x-target="I" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.32.20.006" x-align="JOB.32.20.a006" x-target-ids="t009 t010 t011" x-target="I will open" x-target-head="t011" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="Vqi1cs" x-gloss="let.me.open" x-translit="ʾep̄taḥ" xml:lang="hbo">אֶפְתַּ֖ח</char> <char style="w" x-id="WLC.JOB.32.20.007" x-align="JOB.32.20.a007" x-target-ids="t013" x-target="lips" x-target-head="t013" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śəp̄āṯ" xml:lang="hbo">שְׂפָתַ֣</char><char style="w" x-id="WLC.JOB.32.20.008" x-align="JOB.32.20.a008" x-target-ids="t012" x-target="my" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a"