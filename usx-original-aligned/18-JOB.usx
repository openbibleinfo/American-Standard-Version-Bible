	<para style="p"><verse number="5" style="v" x-ref="JOB.24.5" x-added-alignments="JOB.24.5.a015" x-added-target-ids="t020" x-added-target="yieldeth" sid="JOB 24:5" /><char style="w" x-id="WLC.JOB.24.5.001" x-align="JOB.24.5.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֤ן</char> <char style="w" x-id="WLC.JOB.24.5.002" x-align="JOB.24.5.a002" x-target-ids="t002 t003 t004" x-target="as wild asses" x-target-head="t004" x-head="true" lemma="פֶּרֶא" strong="H6501" x-morph="Ncmpa" x-gloss="wild.donkeys" x-translit="pərāʾiym" xml:lang="hbo">פְּרָאִ֨ים</char>׀<char style="w" x-id="WLC.JOB.24.5.003" x-align="JOB.24.5.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּֽ</char><char style="w" x-id="WLC.JOB.24.5.004" x-align="JOB.24.5.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.24.5.005" x-align="JOB.24.5.a005" x-target-ids="t007" x-target="desert" x-target-head="t007" x-head="true" lemma="מִדְבָּר" strong="H4057" x-morph="Ncmsa" x-gloss="wilderness" x-translit="mmiḏbār" xml:lang="hbo">מִּדְבָּ֗ר</char> <char style="w" x-id="WLC.JOB.24.5.006" x-align="JOB.24.5.a006" x-target-ids="t008 t009 t010" x-target="They go forth" x-target-head="t009" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqp3cp" x-gloss="they.go.forth" x-translit="yāṣʾû" xml:lang="hbo">יָצְא֣וּ</char> <char style="w" x-id="WLC.JOB.24.5.007" x-align="JOB.24.5.a007" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.JOB.24.5.008" x-align="JOB.24.5.a008" x-target-ids="t013" x-target="wor