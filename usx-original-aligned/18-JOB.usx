	<para style="p"><verse number="2" style="v" x-ref="JOB.38.2" sid="JOB 38:2" /><char style="w" x-id="WLC.JOB.38.2.001" x-align="JOB.38.2.a001" x-target-ids="t001 t002" x-target="Who is" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo">מִ֤י</char> <char style="w" x-id="WLC.JOB.38.2.002" x-align="JOB.38.2.a002" x-target-ids="t003" x-target="this" x-target-head="t003" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֨ה</char>׀<char style="w" x-id="WLC.JOB.38.2.003" x-align="JOB.38.2.a003" x-target-ids="t004 t005" x-target="that darkeneth" x-target-head="t005" x-head="true" lemma="חָשַׁךְ" strong="H2821" x-morph="Vhrmsa" x-gloss="[is].making.dark" x-translit="maḥšiyḵ" xml:lang="hbo">מַחְשִׁ֖יךְ</char> <char style="w" x-id="WLC.JOB.38.2.004" x-align="JOB.38.2.a004" x-target-ids="t006" x-target="counsel" x-target-head="t006" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsa" x-gloss="counsel" x-translit="ʿēṣāh" xml:lang="hbo">עֵצָ֥ה</char> <char style="w" x-id="WLC.JOB.38.2.005" x-align="JOB.38.2.a005" x-target-ids="t007" x-target="By" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.JOB.38.2.006" x-align="JOB.38.2.a006" x-target-ids="t008" x-target="words" x-target-head="t008" x-head="true" lemma="מִלָּה" strong="H4405" x-morph="Ncfpa" x-gloss="words" x-translit="milliyn" xml:lang="hbo">מִלִּ֗ין</char> <char style="w" x-id="WLC.JOB.38.2.007" x-align="JOB.38.2.a007" x-target-ids="t009" x-target="without" x-target-head="t009" x-head="true" lemma="בְּלִי" strong="H1097" x-morph="Tn" x-gloss="not" x-translit="bəlî-" xml:lang="hbo">בְּֽלִי</char>־<char style="w" x-id="WLC.JOB.38.2.008" x-align="JOB.38.2.a008" x-target-ids="t010" x-target="knowledge" x-target-head="t010" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="