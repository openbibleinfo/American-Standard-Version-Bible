	<para style="p"><verse number="18" style="v" x-ref="JOB.4.18" sid="JOB 4:18" /><char style="w" x-id="WLC.JOB.4.18.001" x-align="JOB.4.18.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֣ן</char> <char style="w" x-id="WLC.JOB.4.18.002" x-align="JOB.4.18.a002" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ֭</char><char style="w" x-id="WLC.JOB.4.18.003" x-align="JOB.4.18.a003" x-target-ids="t008" x-target="servants" x-target-head="t008" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmpc" x-gloss="servants" x-translit="ʿăḇāḏāy" xml:lang="hbo">עֲבָדָי</char><char style="w" x-id="WLC.JOB.4.18.004" x-align="JOB.4.18.a004" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.4.18.005" x-align="JOB.4.18.a005" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.4.18.006" x-align="JOB.4.18.a006" x-target-ids="t002 t003 t005" x-target="he putteth trust" x-target-head="t005" x-head="true" lemma="אָמַן" strong="H539" x-morph="Vhi3ms" x-gloss="he.trusts" x-translit="yaʾămiyn" xml:lang="hbo">יַאֲמִ֑ין</char> <char style="w" x-id="WLC.JOB.4.18.007" x-align="JOB.4.18.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.4.18.008" x-align="JOB.4.18.a008" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="against" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.JOB.4.18.0