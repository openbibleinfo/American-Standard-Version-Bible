	<para style="p"><verse number="13" style="v" x-ref="JOB.27.13" x-added-alignments="JOB.27.13.a010" x-added-target-ids="t016" x-added-target="which" sid="JOB 27:13" /><char style="w" x-id="WLC.JOB.27.13.001" x-align="JOB.27.13.a001" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֤ה</char>׀<char style="w" x-id="WLC.JOB.27.13.002" x-align="JOB.27.13.a002" x-target-ids="t002 t003 t004" x-target="is the portion" x-target-head="t004" x-head="true" lemma="חֵלֶק" strong="H2506" x-morph="Ncmsc" x-gloss="[is.the].portion" x-translit="ḥēleq-" xml:lang="hbo">חֵֽלֶק</char>־<char style="w" x-id="WLC.JOB.27.13.003" x-align="JOB.27.13.a003" x-target-ids="t005 t006 t008" x-target="of a man" x-target-head="t008" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֖ם</char> <char style="w" x-id="WLC.JOB.27.13.004" x-align="JOB.27.13.a004" x-target-ids="t007" x-target="wicked" x-target-head="t007" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="wicked" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֥ע</char>׀<char style="w" x-id="WLC.JOB.27.13.005" x-align="JOB.27.13.a005" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.JOB.27.13.006" x-align="JOB.27.13.a006" x-target-ids="t010" x-target="God" x-target-head="t010" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֑ל</char> <char style="w" x-id="WLC.JOB.27.13.007" x-align="JOB.27.13.a007" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.JOB.27.13.008" x-align="JOB.27.13.a008" x-target-ids="t012 t013" x-