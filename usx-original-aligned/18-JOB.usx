	<para style="p"><verse number="7" style="v" x-ref="JOB.16.7" sid="JOB 16:7" /><char style="w" x-id="WLC.JOB.16.7.001" x-align="JOB.16.7.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="nevertheless" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.JOB.16.7.002" x-align="JOB.16.7.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֥ה</char> <char style="w" x-id="WLC.JOB.16.7.003" x-align="JOB.16.7.a003" x-target-ids="t003 t004 t005 t007" x-target="he hath made weary" x-target-head="t007" x-head="true" lemma="לָאָה" strong="H3811" x-morph="Vhp3ms" x-gloss="he" x-translit="helʾ" xml:lang="hbo">הֶלְאָ֑</char><char style="w" x-id="WLC.JOB.16.7.004" x-align="JOB.16.7.a004" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.made.me.weary" x-translit="āniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.16.7.005" x-align="JOB.16.7.a005" x-target-ids="t008 t009 t010 t011" x-target="Thou hast made desolate" x-target-head="t011" x-head="true" lemma="שָׁמֵם" strong="H8074" x-morph="Vhp2ms" x-gloss="you.have.devastated" x-translit="hăšimmôṯā" xml:lang="hbo">הֲ֝שִׁמּ֗וֹתָ</char> <char style="w" x-id="WLC.JOB.16.7.006" x-align="JOB.16.7.a006" x-target-ids="t012" x-target="all" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.JOB.16.7.007" x-align="JOB.16.7.a007" x-target-ids="t014" x-target="company" x-target-head="t014" x-head="true" lemma="עֵדָה" strong="H5712" x-morph="Ncfsc" x-gloss="company" x-translit="ʿăḏāṯ" xml:lang="hbo">עֲדָתִֽ</char><char style="w" x-id="WLC.JOB.16.7.008" x-align="JOB.16.7.a008" x-target-ids="t013" x-target="my" x-target-head="t013" x-head="t