	<para style="p"><verse number="28" style="v" x-ref="JOB.19.28" sid="JOB 19:28" /><char style="w" x-id="WLC.JOB.19.28.001" x-align="JOB.19.28.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.JOB.19.28.002" x-align="JOB.19.28.a002" x-target-ids="t002 t003" x-target="ye say" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi2mp" x-gloss="you.will.say" x-translit="ṯōʾmərû" xml:lang="hbo">תֹ֭אמְרוּ</char><char style="w" x-id="WLC.JOB.19.28.003" x-align="JOB.19.28.a003" x-target-ids="t004" x-target="How" x-target-head="t004" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.19.28.004" x-align="JOB.19.28.a004" x-target-ids="t005 t006 t007" x-target="we will persecute" x-target-head="t007" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vqi1cp" x-gloss="will.we.persecute" x-translit="nnirdāp̄-" xml:lang="hbo">נִּרְדָּף</char>־<char style="w" x-id="WLC.JOB.19.28.005" x-align="JOB.19.28.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.JOB.19.28.006" x-align="JOB.19.28.a006" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.19.28.007" x-align="JOB.19.28.a007" x-target-ids="t009 t010" x-target="And that" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.19.28.008" x-align="JOB.19.28.a008" x-target-ids="t011 t012" x-target="the root" x-target-head="t012" x-head="true" lemma="שֹׁרֶשׁ" strong="H8328" x-morph="Ncmsc" x-gloss="root" x-transl