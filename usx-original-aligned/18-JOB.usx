	<para style="p"><verse number="31" style="v" x-ref="JOB.33.31" sid="JOB 33:31" /><char style="w" x-id="WLC.JOB.33.31.001" x-align="JOB.33.31.a001" x-target-ids="t001 t002" x-target="Mark well" x-target-head="t001" x-head="true" lemma="קָשַׁב" strong="H7181" x-morph="Vhv2ms" x-gloss="pay.attention" x-translit="haqšēḇ" xml:lang="hbo">הַקְשֵׁ֖ב</char> <char style="w" x-id="WLC.JOB.33.31.002" x-align="JOB.33.31.a002" x-target-ids="t003 t004" x-target="O Job" x-target-head="t004" x-head="true" lemma="אִיּוֹב" strong="H347" x-morph="Np" x-gloss="O.Job" x-translit="ʾiyyôḇ" xml:lang="hbo">אִיּ֥וֹב</char> <char style="w" x-id="WLC.JOB.33.31.003" x-align="JOB.33.31.a003" x-target-ids="t005" x-target="hearken" x-target-head="t005" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen" x-translit="šəmaʿ-" xml:lang="hbo">שְֽׁמַֽע</char>־<char style="w" x-id="WLC.JOB.33.31.004" x-align="JOB.33.31.a004" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֑</char><char style="w" x-id="WLC.JOB.33.31.005" x-align="JOB.33.31.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.33.31.006" x-align="JOB.33.31.a006" x-target-ids="t008 t009 t010" x-target="Hold thy peace" x-target-head="t010" x-head="true" lemma="חָרֵשׁ" strong="H2790a" x-morph="Vhv2ms" x-gloss="keep.quiet" x-translit="haḥărēš" xml:lang="hbo">הַ֝חֲרֵ֗שׁ</char> <char style="w" x-id="WLC.JOB.33.31.007" x-align="JOB.33.31.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.33.31.008" x-align="JOB.33.31.a008" x-target-ids="t012" x-target="I" x-target-head="t012" x-head="true" lemma="אָנֹכִי" strong="H595" x-mor