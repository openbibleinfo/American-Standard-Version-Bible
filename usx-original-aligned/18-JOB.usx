	<para style="p"><verse number="13" style="v" x-ref="JOB.35.13" sid="JOB 35:13" /><char style="w" x-id="WLC.JOB.35.13.001" x-align="JOB.35.13.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.JOB.35.13.002" x-align="JOB.35.13.a002" x-target-ids="t006 t007 t008" x-target="an empty cry" x-target-italic-ids="t008" x-target-head="t007" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="emptiness" x-translit="šāwʾ" xml:lang="hbo">שָׁ֭וְא</char> <char style="w" x-id="WLC.JOB.35.13.003" x-align="JOB.35.13.a003" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.35.13.004" x-align="JOB.35.13.a004" x-target-ids="t003 t005" x-target="will hear" x-target-head="t005" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi3ms" x-gloss="he.hears" x-translit="yišmaʿ" xml:lang="hbo">יִשְׁמַ֥ע</char>׀<char style="w" x-id="WLC.JOB.35.13.005" x-align="JOB.35.13.a005" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֑ל</char> <char style="w" x-id="WLC.JOB.35.13.006" x-align="JOB.35.13.a006" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.35.13.007" x-align="JOB.35.13.a007" x-target-ids="t011 t012" x-target="the Almighty" x-target-head="t012" x-head="true" lemma="שַׁדַּי" strong="H7706" x-morph="Np" x-gloss="Almighty" x-translit="šadday" xml:lang="hbo">שַׁדַּ֗י</char> <char style="w" x-id="WLC.JOB.35.13.008" x-align="JOB.35.13.a006" x-status="noncompositional" x-target-ids="t009" x-target="Neither" x-target-head="t009" x-head="true" lemma="לֹא" strong="