	<para style="p"><verse number="13" style="v" x-ref="JOB.30.13" x-added-alignments="JOB.30.13.a008" x-added-target-ids="t010" x-added-target="Even" sid="JOB 30:13" /><char style="w" x-id="WLC.JOB.30.13.001" x-align="JOB.30.13.a001" x-target-ids="t001 t002" x-target="They mar" x-target-head="t002" x-head="true" lemma="נָתַס" strong="H5420" x-morph="Vqp3cp" x-gloss="they.have.torn.down" x-translit="nāṯəsû" xml:lang="hbo">נָתְס֗וּ</char> <char style="w" x-id="WLC.JOB.30.13.002" x-align="JOB.30.13.a003" x-target-ids="t004" x-target="path" x-target-head="t004" x-head="true" lemma="נְתִיבָה" strong="H5410" x-morph="Ncbsc" x-gloss="pathway" x-translit="nəṯiyḇāṯ" xml:lang="hbo">נְֽתִיבָ֫תִ֥</char><char style="w" x-id="WLC.JOB.30.13.003" x-align="JOB.30.13.a002" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.30.13.004" x-align="JOB.30.13.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.30.13.005" x-align="JOB.30.13.a007" x-target-ids="t009" x-target="calamity" x-target-head="t009" x-head="true" lemma="הַוָּה" strong="H1942a" x-morph="Ncfsc" x-gloss="destruction" x-translit="hawwāṯ" xml:lang="hbo">הַוָּתִ֥</char><char style="w" x-id="WLC.JOB.30.13.006" x-align="JOB.30.13.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.30.13.007" x-align="JOB.30.13.a004" x-target-ids="t005 t006 t007" x-target="They set forward" x-target-head="t006" x-head="true" lemma="יָעַל" strong="H3276" x-morph="Vhi3mp" x-gloss="they.benefit" x-translit="yōʿiylû" xml:lang="hbo">יֹעִ֑ילוּ</char> <char style="w" x-id="WLC.JOB.30.13.008" x-align="JOB.30.13.a011" x-target-ids="t014" x-target="no