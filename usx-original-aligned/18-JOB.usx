	<para style="p"><verse number="12" style="v" x-ref="JOB.11.12" sid="JOB 11:12" /><char style="w" x-id="WLC.JOB.11.12.001" x-align="JOB.11.12.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.11.12.002" x-align="JOB.11.12.a002" x-target-ids="t003" x-target="man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.JOB.11.12.003" x-align="JOB.11.12.a003" x-target-ids="t002" x-target="vain" x-target-head="t002" x-head="true" lemma="נָבַב" strong="H5014a" x-morph="Vqsmsa" x-gloss="hollow" x-translit="nāḇûḇ" xml:lang="hbo">נָ֭בוּב</char> <char style="w" x-id="WLC.JOB.11.12.004" x-align="JOB.11.12.a004" x-target-ids="t004 t005 t006 t007" x-target="is void of understanding" x-target-head="t007" x-head="true" lemma="לָבַב" strong="H3823" x-morph="VNi3ms" x-gloss="he.will.get.understanding" x-translit="yillāḇēḇ" xml:lang="hbo">יִלָּבֵ֑ב</char> <char style="w" x-id="WLC.JOB.11.12.005" x-align="JOB.11.12.a005" x-target-ids="t008" x-target="Yea" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.11.12.006" x-align="JOB.11.12.a006" x-target-ids="t012 t016" x-target="as colt" x-target-italic-ids="t012" x-target-head="t016" x-head="true" lemma="עַיִר" strong="H5895" x-morph="Ncmsc" x-gloss="a.male.donkey" x-translit="ʿayir" xml:lang="hbo">עַ֥יִר</char> <char style="w" x-id="WLC.JOB.11.12.007" x-align="JOB.11.12.a007" x-target-ids="t013 t014 t015" x-target="a wild ass’s" x-target-head="t015" x-head="true" lemma="פֶּרֶא" strong="H6501" x-morph="Ncmsa" x-gloss="of.a.wild.donkey" x-translit="pereʾ" xml:lang="hbo">פֶּ֝֗רֶא</char> <char style="w" x-id="WLC.JOB.11.12.008" x-align="JOB.11.12.a008" x-target-ids="t009" x-t