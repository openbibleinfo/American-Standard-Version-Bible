	<para style="p"><verse number="19" style="v" x-ref="JOB.6.19" sid="JOB 6:19" /><char style="w" x-id="WLC.JOB.6.19.001" x-align="JOB.6.19.a001" x-target-ids="t005" x-target="looked" x-target-head="t005" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhp3cp" x-gloss="they.look" x-translit="hibbîṭû" xml:lang="hbo">הִ֭בִּיטוּ</char> <char style="w" x-id="WLC.JOB.6.19.002" x-align="JOB.6.19.a002" x-target-ids="t001 t002" x-target="The caravans" x-target-head="t002" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbpc" x-gloss="the.caravans" x-translit="ʾārḥôṯ" xml:lang="hbo">אָרְח֣וֹת</char> <char style="w" x-id="WLC.JOB.6.19.003" x-align="JOB.6.19.a003" x-target-ids="t003 t004" x-target="of Tema" x-target-head="t004" x-head="true" lemma="תֵּימָא" strong="H8485" x-morph="Np" x-gloss="of.Tema" x-translit="tēmāʾ" xml:lang="hbo">תֵּמָ֑א</char> <char style="w" x-id="WLC.JOB.6.19.004" x-align="JOB.6.19.a004" x-target-ids="t006 t007" x-target="The companies" x-target-head="t007" x-head="true" lemma="הֲלִיכָה" strong="H1979" x-morph="Ncfpc" x-gloss="the.caravans" x-translit="hălîḵōṯ" xml:lang="hbo">הֲלִיכֹ֥ת</char> <char style="w" x-id="WLC.JOB.6.19.005" x-align="JOB.6.19.a005" x-target-ids="t008 t009" x-target="of Sheba" x-target-head="t009" x-head="true" lemma="שְׁבָא" strong="H7614" x-morph="Np" x-gloss="of.Sheba" x-translit="šəḇāʾ" xml:lang="hbo">שְׁ֝בָ֗א</char> <char style="w" x-id="WLC.JOB.6.19.006" x-align="JOB.6.19.a006" x-target-ids="t010" x-target="waited" x-target-head="t010" x-head="true" lemma="קָוָה" strong="H6960" x-morph="Vpp3cp" x-gloss="they.wait.eagerly" x-translit="qiwwû-" xml:lang="hbo">קִוּוּ</char>־<char style="w" x-id="WLC.JOB.6.19.007" x-align="JOB.6.19.a007" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807z" x-morph="R" x-gloss="for" x-translit="lā" xml:lang="hbo">לָֽ</char><char style="w" x-id="WLC.JOB.6.19.008" x-align="JOB.6.19.a008" x-target-ids="t012" x-target="them" x-target-head="t012" x-he