	<para style="p"><verse number="8" style="v" x-ref="JOB.23.8" x-added-alignments="JOB.23.8.a007" x-added-target-ids="t009" x-added-target="there" sid="JOB 23:8" /><char style="w" x-id="WLC.JOB.23.8.001" x-align="JOB.23.8.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="here!" x-translit="hēn" xml:lang="hbo">הֵ֤ן</char> <char style="w" x-id="WLC.JOB.23.8.002" x-align="JOB.23.8.a003" x-target-ids="t004" x-target="forward" x-target-head="t004" x-head="true" lemma="קֶדֶם" strong="H6924" x-morph="Ncmsa" x-gloss="forward" x-translit="qeḏem" xml:lang="hbo">קֶ֣דֶם</char> <char style="w" x-id="WLC.JOB.23.8.003" x-align="JOB.23.8.a002" x-target-ids="t002 t003" x-target="I go" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqi1cs" x-gloss="I.go" x-translit="ʾehĕlōḵ" xml:lang="hbo">אֶהֱלֹ֣ךְ</char> <char style="w" x-id="WLC.JOB.23.8.004" x-align="JOB.23.8.a004" x-target-ids="t005" x-target="but" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.23.8.005" x-align="JOB.23.8.a006" x-target-ids="t007 t008" x-target="is not" x-target-head="t008" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="he.[is]" x-translit="ʾēyn" xml:lang="hbo">אֵינֶ֑</char><char style="w" x-id="WLC.JOB.23.8.006" x-align="JOB.23.8.a005" x-target-ids="t006" x-target="he" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="not" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.JOB.23.8.007" x-align="JOB.23.8.a008" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.23.8.008" x-align="JOB.23.8.a009" x-target-ids="t011" x-target="backward" x-target-head="t011" x-head="true" lemma="אָחוֹר" str