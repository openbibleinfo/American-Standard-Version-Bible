	<para style="p"><verse number="22" style="v" x-ref="JOB.30.22" x-added-alignments="JOB.30.22.a007" x-added-target-ids="t013 t014" x-added-target="upon it" sid="JOB 30:22" /><char style="w" x-id="WLC.JOB.30.22.001" x-align="JOB.30.22.a001" x-target-ids="t001 t002 t004" x-target="Thou liftest up" x-target-head="t002" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi2ms" x-gloss="you" x-translit="tiśśāʾ" xml:lang="hbo">תִּשָּׂאֵ֣</char><char style="w" x-id="WLC.JOB.30.22.002" x-align="JOB.30.22.a002" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="lift.me.up" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.30.22.003" x-align="JOB.30.22.a003" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.JOB.30.22.004" x-align="JOB.30.22.a004" x-target-ids="t006 t007" x-target="the wind" x-target-head="t007" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="[the].wind" x-translit="rûᵃḥ" xml:lang="hbo">ר֭וּחַ</char><char style="w" x-id="WLC.JOB.30.22.005" x-align="JOB.30.22.a005" x-target-ids="t008 t009 t011 t012" x-target="thou causest to ride" x-target-head="t012" x-head="true" lemma="רָכַב" strong="H7392" x-morph="Vhi2ms" x-gloss="you" x-translit="tarkiyḇ" xml:lang="hbo">תַּרְכִּיבֵ֑</char><char style="w" x-id="WLC.JOB.30.22.006" x-align="JOB.30.22.a006" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="make.me.ride" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.30.22.007" x-align="JOB.30.22.a008" x-target-ids="t015" x-target="And" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.30.22.008" x-align="JOB.30.22.a00