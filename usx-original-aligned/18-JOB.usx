	<para style="p"><verse number="27" style="v" x-ref="JOB.34.27" sid="JOB 34:27" /><char style="w" x-id="WLC.JOB.34.27.001" x-align="JOB.34.27.a001" x-status="noncompositional" x-target-ids="t001" x-target="Because" x-target-head="t001" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="that" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.JOB.34.27.002" x-align="JOB.34.27.a001" x-status="noncompositional" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JOB.34.27.003" x-align="JOB.34.27.a001" x-status="noncompositional" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֭ן</char> <char style="w" x-id="WLC.JOB.34.27.004" x-align="JOB.34.27.a002" x-target-ids="t002 t003 t004" x-target="they turned aside" x-target-head="t003" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vqp3cp" x-gloss="they.turned.aside" x-translit="sārû" xml:lang="hbo">סָ֣רוּ</char> <char style="w" x-id="WLC.JOB.34.27.005" x-align="JOB.34.27.a003" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.JOB.34.27.006" x-align="JOB.34.27.a004" x-target-ids="t006" x-target="following" x-target-head="t006" x-head="true" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="after" x-translit="ʾaḥărāy" xml:lang="hbo">אַחֲרָ֑י</char><char style="w" x-id="WLC.JOB.34.27.007" x-align="JOB.34.27.a005" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.34.27.008" x-align="JOB.34.27.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.34.27.009" x-