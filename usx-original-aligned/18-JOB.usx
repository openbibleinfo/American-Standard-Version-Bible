	<para style="p"><verse number="10" style="v" x-ref="JOB.32.10" sid="JOB 32:10" /><char style="w" x-id="WLC.JOB.32.10.001" x-align="JOB.32.10.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.32.10.002" x-align="JOB.32.10.a001" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֣ן</char> <char style="w" x-id="WLC.JOB.32.10.003" x-align="JOB.32.10.a002" x-target-ids="t002 t003" x-target="I said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp1cs" x-gloss="I.say" x-translit="ʾāmartî" xml:lang="hbo">אָ֭מַרְתִּי</char> <char style="w" x-id="WLC.JOB.32.10.004" x-align="JOB.32.10.a003" x-target-ids="t004" x-target="Hearken" x-target-head="t004" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen" x-translit="šimʿ" xml:lang="hbo">שִׁמְעָ</char><char style="w" x-id="WLC.JOB.32.10.005" x-align="JOB.32.10.a004" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh-" xml:lang="hbo">ה</char>־<char style="w" x-id="WLC.JOB.32.10.006" x-align="JOB.32.10.a005" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לִּ֑</char><char style="w" x-id="WLC.JOB.32.10.007" x-align="JOB.32.10.a006" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.32.10.008" x-align="JOB.32.10.a007" x-target-ids="t009 t010" x-target="will show" x-target-head="t010" x-head="true" lemma="חָוָה" strong="H2331" x-morph="Vpi1cs" x-gloss="I.will.declare" x-translit="ʾăḥawweh" xml:lang="hbo">אֲחַוֶּ֖ה</char> <char style="w" x-id="WLC.JOB.32.10.009" x-align="JOB.32.10.a008" x-target-ids="t012" x-target