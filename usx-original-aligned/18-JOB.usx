	<para style="p"><verse number="2" style="v" x-ref="JOB.27.2" x-added-alignments="JOB.27.2.a003 JOB.27.2.a009" x-added-target-ids="t004 t013" x-added-target="who | who" sid="JOB 27:2" /><char style="w" x-id="WLC.JOB.27.2.001" x-align="JOB.27.2.a001" x-target-ids="t001 t003" x-target="As liveth" x-target-head="t003" x-head="true" lemma="חַי" strong="H2416" x-morph="Aamsa" x-gloss="[by].the.life" x-translit="ḥay-" xml:lang="hbo">חַי</char>־<char style="w" x-id="WLC.JOB.27.2.002" x-align="JOB.27.2.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="of.God" x-translit="ʾēl" xml:lang="hbo">אֵ֭ל</char> <char style="w" x-id="WLC.JOB.27.2.003" x-align="JOB.27.2.a004" x-target-ids="t005 t006 t007" x-target="hath taken away" x-target-head="t006" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vhp3ms" x-gloss="[who].he.has.taken.away" x-translit="hēsiyr" xml:lang="hbo">הֵסִ֣יר</char> <char style="w" x-id="WLC.JOB.27.2.004" x-align="JOB.27.2.a005" x-target-ids="t009" x-target="right" x-target-head="t009" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsc" x-gloss="right" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּטִ֑</char><char style="w" x-id="WLC.JOB.27.2.005" x-align="JOB.27.2.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.27.2.006" x-align="JOB.27.2.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.27.2.007" x-align="JOB.27.2.a008" x-target-ids="t011 t012" x-target="the Almighty" x-target-head="t012" x-head="true" lemma="שַׁדַּי" strong="H7706" x-morph="Np" x-gloss="Almighty" x-translit="šadday" xml:lang="hbo">שַׁדַּ֗י</char> <char style="w" x-id="WLC.JOB.27.2.008" x-align="JOB.27