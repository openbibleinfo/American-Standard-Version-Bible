	<para style="p"><verse number="1" style="v" x-ref="JOB.42.1" sid="JOB 42:1" /><char style="w" x-id="WLC.JOB.42.1.001" x-align="JOB.42.1.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.42.1.002" x-align="JOB.42.1.a002" x-target-ids="t003" x-target="answered" x-target-head="t003" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw3ms" x-gloss="he.answered" x-translit="yyaʿan" xml:lang="hbo">יַּ֖עַן</char> <char style="w" x-id="WLC.JOB.42.1.003" x-align="JOB.42.1.a003" x-target-ids="t002" x-target="Job" x-target-head="t002" x-head="true" lemma="אִיּוֹב" strong="H347" x-morph="Np" x-gloss="Job" x-translit="ʾiyyôḇ" xml:lang="hbo">אִיּ֥וֹב</char> <char style="w" x-id="WLC.JOB.42.1.004" x-align="JOB.42.1.a004" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.JOB.42.1.005" x-align="JOB.42.1.a005" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.JOB.42.1.006" x-align="JOB.42.1.a006" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.42.1.007" x-align="JOB.42.1.a007" x-target-ids="t006" x-target="said" x-target-head="t006" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar:" xml:lang="hbo">יֹּאמַֽר</char>׃<verse eid="JOB 42:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="JOB.42.2" sid="JOB 42:2" /><char style="w" x-id="WLC.JOB.42.2.001" x-align="JOB.42.2.a001" x-target-ids="t001 t002" x-target="I know" x-target-head="t002" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="**yāḏaʿtî" xml:lang="hbo">יָ֭דַעְתִּי</char> <char style="w" x-id="WLC.JOB.42.2.002" x-align="JOB.42.2.a002" x-target-ids="t003 t010" x-target="that that" x-target-head="t003" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.42.2.003" x-align="JOB.42.2.a003" x-target-ids="t007 t008" x-target="all things" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="everything" x-translit="ḵōl" xml:lang="hbo">כֹ֣ל</char> <char style="w" x-id="WLC.JOB.42.2.004" x-align="JOB.42.2.a004" x-target-ids="t004 t005 t006" x-target="thou canst do" x-target-head="t005" x-head="true" lemma="יָכֹל" strong="H3201" x-morph="Vqi2ms" x-gloss="you.are.able" x-translit="tûḵāl" xml:lang="hbo">תּוּכָ֑ל</char> <char style="w" x-id="WLC.JOB.42.2.005" x-align="JOB.42.2.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.42.2.006" x-align="JOB.42.2.a006" x-target-ids="t011" x-target="no" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.42.2.007" x-align="JOB.42.2.a007" x-target-ids="t015 t016 t017" x-target="can be restrained" x-target-head="t017" x-head="true" lemma="בָּצַר" strong="H1219b" x-morph="VNi3ms" x-gloss="it.is.withheld" x-translit="yibbāṣēr" xml:lang="hbo">יִבָּצֵ֖ר</char> <char style="w" x-id="WLC.JOB.42.2.008" x-align="JOB.42.2.a008" x-target-ids="t013" x-target="of" x-target-head="t013" x-head="true" lemma=