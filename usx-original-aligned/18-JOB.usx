	<para style="p"><verse number="2" style="v" x-ref="JOB.17.2" sid="JOB 17:2" /><char style="w" x-id="WLC.JOB.17.2.001" x-align="JOB.17.2.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="(if)?" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.17.2.002" x-align="JOB.17.2.a001" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.17.2.003" x-align="JOB.17.2.a003" x-target-ids="t004" x-target="mockers" x-target-head="t004" x-head="true" lemma="הֲתֻלִים" strong="H2049" x-morph="Ncmpa" x-gloss="mockeri(es)" x-translit="hăṯulîm" xml:lang="hbo">הֲ֭תֻלִים</char> <char style="w" x-id="WLC.JOB.17.2.004" x-align="JOB.17.2.a002" x-target-ids="t002 t003 t005" x-target="there are with" x-target-head="t005" x-head="true" lemma="עִמָּד" strong="H5978" x-morph="R" x-gloss="[are].with" x-translit="ʿimmāḏ" xml:lang="hbo">עִמָּדִ֑</char><char style="w" x-id="WLC.JOB.17.2.005" x-align="JOB.17.2.a004" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.17.2.006" x-align="JOB.17.2.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.17.2.007" x-align="JOB.17.2.a009" x-target-ids="t011" x-target="upon" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.JOB.17.2.008" x-align="JOB.17.2.a011" x-target-ids="t013" x-target="provocation" x-target-head="t013" x-head="true" lemma="מָרָה" strong="H4784" x-morph="Vhc" x-gloss="rebelling" x-translit="hammərôṯ" xml:lang="hbo">הַמְּרוֹתָ֗</char><char style="w" x-id="WLC.JOB.17.2.009" x-align="J