	<para style="p"><verse number="18" style="v" x-ref="JOB.32.18" sid="JOB 32:18" /><char style="w" x-id="WLC.JOB.32.18.001" x-align="JOB.32.18.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּ֭י</char> <char style="w" x-id="WLC.JOB.32.18.002" x-align="JOB.32.18.a002" x-target-ids="t002 t003 t004" x-target="I am full" x-target-head="t004" x-head="true" lemma="מָלֵא" strong="H4390" x-morph="Vqp1cs" x-gloss="I.am.full" x-translit="mālēṯî" xml:lang="hbo">מָלֵ֣תִי</char> <char style="w" x-id="WLC.JOB.32.18.003" x-align="JOB.32.18.a003" x-target-ids="t005 t006" x-target="of words" x-target-head="t006" x-head="true" lemma="מִלָּה" strong="H4405" x-morph="Ncfpa" x-gloss="words" x-translit="milliym" xml:lang="hbo">מִלִּ֑ים</char> <char style="w" x-id="WLC.JOB.32.18.004" x-align="JOB.32.18.a004" x-target-ids="t011" x-target="constraineth" x-target-head="t011" x-head="true" lemma="צוּק" strong="H6693" x-morph="Vhp3fs" x-gloss="it" x-translit="hĕṣiyqaṯ" xml:lang="hbo">הֱ֝צִיקַ֗תְ</char><char style="w" x-id="WLC.JOB.32.18.005" x-align="JOB.32.18.a005" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.constrained.me" x-translit="əniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.32.18.006" x-align="JOB.32.18.a006" x-target-ids="t007 t008" x-target="The spirit" x-target-head="t008" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="the.spirit" x-translit="rûᵃḥ" xml:lang="hbo">ר֣וּחַ</char> <char style="w" x-id="WLC.JOB.32.18.007" x-align="JOB.32.18.a007" x-target-ids="t009" x-target="within" x-target-head="t009" x-head="true" lemma="בֶּטֶן" strong="H990" x-morph="Ncfsc" x-gloss="my.belly" x-translit="biṭn" xml:lang="hbo">בִּטְנִֽ</char><char style="w" x-id="WLC.JOB.32.18.008" x-align="JOB.32.18.a008" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="tr