	<para style="p"><verse number="27" style="v" x-ref="JOB.15.27" x-added-alignments="JOB.15.27.a012" x-added-target-ids="t014" x-added-target="his" sid="JOB 15:27" /><char style="w" x-id="WLC.JOB.15.27.001" x-align="JOB.15.27.a001" x-target-ids="t001" x-target="Because" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.15.27.002" x-align="JOB.15.27.a002" x-target-ids="t002 t003 t004" x-target="he hath covered" x-target-head="t004" x-head="true" lemma="כָּסָה" strong="H3680" x-morph="Vpp3ms" x-gloss="he.has.covered" x-translit="ḵissāh" xml:lang="hbo">כִסָּ֣ה</char> <char style="w" x-id="WLC.JOB.15.27.003" x-align="JOB.15.27.a003" x-target-ids="t006" x-target="face" x-target-head="t006" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="face" x-translit="p̄ānāy" xml:lang="hbo">פָנָ֣י</char><char style="w" x-id="WLC.JOB.15.27.004" x-align="JOB.15.27.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.15.27.005" x-align="JOB.15.27.a005" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.15.27.006" x-align="JOB.15.27.a006" x-target-ids="t009" x-target="fatness" x-target-head="t009" x-head="true" lemma="חֵלֶב" strong="H2459" x-morph="Ncmsc" x-gloss="fat" x-translit="ḥelb" xml:lang="hbo">חֶלְבּ֑</char><char style="w" x-id="WLC.JOB.15.27.007" x-align="JOB.15.27.a007" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.15.27.008" x-align="JOB.15.27.a008" x-target-ids="t010" x-target="And" x-target-head="t010"