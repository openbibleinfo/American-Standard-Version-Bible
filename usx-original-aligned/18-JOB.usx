	<para style="p"><verse number="16" style="v" x-ref="JOB.13.16" sid="JOB 13:16" /><char style="w" x-id="WLC.JOB.13.16.001" x-align="JOB.13.16.a001" x-target-ids="t002" x-target="also" x-target-head="t002" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.JOB.13.16.002" x-align="JOB.13.16.a002" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="that" x-translit="hûʾ-" xml:lang="hbo">הוּא</char>־<char style="w" x-id="WLC.JOB.13.16.003" x-align="JOB.13.16.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לִ֥</char><char style="w" x-id="WLC.JOB.13.16.004" x-align="JOB.13.16.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.13.16.005" x-align="JOB.13.16.a005" x-target-ids="t003 t004" x-target="shall be" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[will" x-translit="li" xml:lang="hbo">לִֽ</char><char style="w" x-id="WLC.JOB.13.16.006" x-align="JOB.13.16.a006" x-target-ids="t006" x-target="salvation" x-target-head="t006" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsa" x-gloss="be].for.deliverance" x-translit="yšûʿāh" xml:lang="hbo">ישׁוּעָ֑ה</char> <char style="w" x-id="WLC.JOB.13.16.007" x-align="JOB.13.16.a007" x-target-ids="t007" x-target="That" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.13.16.008" x-align="JOB.13.16.a008" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="