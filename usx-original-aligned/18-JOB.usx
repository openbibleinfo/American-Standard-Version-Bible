	<para style="p"><verse number="7" style="v" x-ref="JOB.19.7" sid="JOB 19:7" /><char style="w" x-id="WLC.JOB.19.7.001" x-align="JOB.19.7.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֤ן</char> <char style="w" x-id="WLC.JOB.19.7.002" x-align="JOB.19.7.a002" x-target-ids="t002 t003 t004 t005" x-target="I cry out of" x-target-head="t003" x-head="true" lemma="צָעַק" strong="H6817" x-morph="Vqi1cs" x-gloss="I.cry.out" x-translit="ʾeṣʿaq" xml:lang="hbo">אֶצְעַ֣ק</char> <char style="w" x-id="WLC.JOB.19.7.003" x-align="JOB.19.7.a003" x-target-ids="t006" x-target="wrong" x-target-head="t006" x-head="true" lemma="חָמָס" strong="H2555" x-morph="Ncmsa" x-gloss="violence" x-translit="ḥāmās" xml:lang="hbo">חָ֭מָס</char> <char style="w" x-id="WLC.JOB.19.7.004" x-align="JOB.19.7.a004" x-target-ids="t007" x-target="but" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.19.7.005" x-align="JOB.19.7.a005" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.19.7.006" x-align="JOB.19.7.a006" x-target-ids="t008 t009 t011" x-target="I am heard" x-target-head="t011" x-head="true" lemma="עָנָה" strong="H6030" x-morph="VNi1cs" x-gloss="I.am.answered" x-translit="ʾēʿāneh" xml:lang="hbo">אֵעָנֶ֑ה</char> <char style="w" x-id="WLC.JOB.19.7.007" x-align="JOB.19.7.a007" x-target-ids="t012 t013 t014 t015" x-target="I cry for help" x-target-head="t013" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpi1cs" x-gloss="I.cry.for.help" x-translit="ʾăšawwaʿ" xml:lang="hbo">אֲ֝שַׁוַּ֗ע</char> <char style="w" x-id="WLC.JOB.19.7.008" x-align="JOB.19.7.a008" x-target-ids="t016" x-target="but" x-target-head="t016" x-head="true" lemma=