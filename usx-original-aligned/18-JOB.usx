	<para style="p"><verse number="26" style="v" x-ref="JOB.31.26" sid="JOB 31:26" /><char style="w" x-id="WLC.JOB.31.26.001" x-align="JOB.31.26.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.26.002" x-align="JOB.31.26.a002" x-target-ids="t002 t003 t004" x-target="I have beheld" x-target-head="t004" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi1cs" x-gloss="I.saw" x-translit="ʾerʾeh" xml:lang="hbo">אֶרְאֶ֣ה</char> <char style="w" x-id="WLC.JOB.31.26.003" x-align="JOB.31.26.a003" x-target-ids="t005 t006" x-target="the sun" x-target-head="t006" x-head="true" lemma="אוֹר" strong="H216" x-morph="Ncbsa" x-gloss="a.light" x-translit="ʾôr" xml:lang="hbo">א֖וֹר</char> <char style="w" x-id="WLC.JOB.31.26.004" x-align="JOB.31.26.a004" x-target-ids="t007" x-target="when" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.JOB.31.26.005" x-align="JOB.31.26.a005" x-target-ids="t008 t009" x-target="it shined" x-target-head="t009" x-head="true" lemma="הָלַל" strong="H1984" x-morph="Vhi3ms" x-gloss="it.shone" x-translit="yāhēl" xml:lang="hbo">יָהֵ֑ל</char> <char style="w" x-id="WLC.JOB.31.26.006" x-align="JOB.31.26.a006" x-target-ids="t010" x-target="Or" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.31.26.007" x-align="JOB.31.26.a007" x-target-ids="t011 t012" x-target="the moon" x-target-head="t012" x-head="true" lemma="יָרֵחַ" strong="H3394" x-morph="Ncmsa" x-gloss="moon" x-translit="yārēᵃḥ" xml:lang="hbo">יָרֵ֗חַ</char> <char style="w" x-id="WLC.JOB.31.26.008" x-align="JOB.31.26.a009" x-target-ids="t014 t015" x-target="in brightness" x-target-head="t015" x-head="true" lemma="יָקָר" strong="H3368"