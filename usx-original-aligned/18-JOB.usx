	<para style="p"><verse number="21" style="v" x-ref="JOB.5.21" sid="JOB 5:21" /><char style="w" x-id="WLC.JOB.5.21.001" x-align="JOB.5.21.a001" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.5.21.002" x-align="JOB.5.21.a002" x-target-ids="t006 t007" x-target="the scourge" x-target-head="t007" x-head="true" lemma="שׁוֹט" strong="H7752" x-morph="Ncmsc" x-gloss="whip" x-translit="šôṭ" xml:lang="hbo">שׁ֣וֹט</char> <char style="w" x-id="WLC.JOB.5.21.003" x-align="JOB.5.21.a003" x-target-ids="t008 t009 t010" x-target="of the tongue" x-target-head="t010" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsa" x-gloss="of.[the].tongue" x-translit="lāšôn" xml:lang="hbo">לָ֭שׁוֹן</char> <char style="w" x-id="WLC.JOB.5.21.004" x-align="JOB.5.21.a004" x-target-ids="t001 t002 t003 t004" x-target="Thou shalt be hid" x-target-head="t004" x-head="true" lemma="חָבָא" strong="H2244" x-morph="VNi2ms" x-gloss="you.will.be.hidden" x-translit="tēḥāḇēʾ" xml:lang="hbo">תֵּחָבֵ֑א</char> <char style="w" x-id="WLC.JOB.5.21.005" x-align="JOB.5.21.a005" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.JOB.5.21.006" x-align="JOB.5.21.a005" x-target-ids="t011" x-target="Neither" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.5.21.007" x-align="JOB.5.21.a006" x-target-ids="t012 t013 t014 t015" x-target="shalt thou be afraid" x-target-head="t015" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqi2ms" x-gloss="you.will.be.afraid" x-translit="ṯîrāʾ" xml:lang="hbo">תִירָ֥א</char> <char style="w" x-id="WLC.JOB.5.21.008" x-align="JOB.5.21.a007" x-target-ids="t016" x-target="of" x-target-head="t016" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="