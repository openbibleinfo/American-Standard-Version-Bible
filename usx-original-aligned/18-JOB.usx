	<para style="p"><verse number="27" style="v" x-ref="JOB.9.27" sid="JOB 9:27" /><char style="w" x-id="WLC.JOB.9.27.001" x-align="JOB.9.27.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.27.002" x-align="JOB.9.27.a002" x-target-ids="t003" x-target="say" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqc" x-gloss="my.saying" x-translit="ʾāmər" xml:lang="hbo">אָ֭מְרִ</char><char style="w" x-id="WLC.JOB.9.27.003" x-align="JOB.9.27.a003" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="[is]" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.9.27.004" x-align="JOB.9.27.a004" x-target-ids="t004 t005 t006" x-target="I will forget" x-target-head="t006" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqh1cs" x-gloss="I.will.forget" x-translit="ʾeškəḥāh" xml:lang="hbo">אֶשְׁכְּחָ֣ה</char> <char style="w" x-id="WLC.JOB.9.27.005" x-align="JOB.9.27.a005" x-target-ids="t008" x-target="complaint" x-target-head="t008" x-head="true" lemma="שִׂיחַ" strong="H7879" x-morph="Ncmsc" x-gloss="complaint" x-translit="śiyḥ" xml:lang="hbo">שִׂיחִ֑</char><char style="w" x-id="WLC.JOB.9.27.006" x-align="JOB.9.27.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.9.27.007" x-align="JOB.9.27.a007" x-target-ids="t009 t010 t011 t012" x-target="I will put off" x-target-head="t011" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqh1cs" x-gloss="I.will.let.loose" x-translit="ʾeʿezḇāh" xml:lang="hbo">אֶעֶזְבָ֖ה</char> <char style="w" x-id="WLC.JOB.9.27.008" x-align="JOB.9.27.a008" x-target-ids="t014 t015" x-target="sad countenance" x-target-italic-ids="t014" x-target-head="t015