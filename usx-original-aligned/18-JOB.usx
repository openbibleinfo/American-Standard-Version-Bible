	<para style="p"><verse number="5" style="v" x-ref="JOB.9.5" x-added-alignments="JOB.9.5.a007" x-added-target-ids="t009" x-added-target="it" sid="JOB 9:5" /><char style="w" x-id="WLC.JOB.9.5.001" x-align="JOB.9.5.a001" x-target-ids="t001 t002" x-target="Him that" x-target-italic-ids="t001" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.[one" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JOB.9.5.002" x-align="JOB.9.5.a002" x-target-ids="t003" x-target="removeth" x-target-head="t003" x-head="true" lemma="עָתַק" strong="H6275" x-morph="Vhrmsa" x-gloss="who].removes" x-translit="mmaʿtiyq" xml:lang="hbo">מַּעְתִּ֣יק</char> <char style="w" x-id="WLC.JOB.9.5.003" x-align="JOB.9.5.a003" x-target-ids="t004 t005" x-target="the mountains" x-target-head="t005" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpa" x-gloss="mountains" x-translit="hārîm" xml:lang="hbo">הָ֭רִים</char> <char style="w" x-id="WLC.JOB.9.5.004" x-align="JOB.9.5.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.9.5.005" x-align="JOB.9.5.a005" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.9.5.006" x-align="JOB.9.5.a006" x-target-ids="t007 t008" x-target="they know" x-target-head="t008" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3cp" x-gloss="they.know" x-translit="yāḏāʿû" xml:lang="hbo">יָדָ֑עוּ</char> <char style="w" x-id="WLC.JOB.9.5.007" x-align="JOB.9.5.a008" x-target-ids="t011" x-target="When" x-target-head="t011" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[the.one].who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֖ר</char> <char style="w" x-id="WLC.JOB.9.5.008" x-align="JOB.9.5.a009" x-target-ids="t012 t013" x-ta