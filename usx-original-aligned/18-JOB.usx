	<para style="p"><verse number="2" style="v" x-ref="JOB.26.2" x-added-alignments="JOB.26.2.a004 JOB.26.2.a009" x-added-target-ids="t005 t006 t016 t017" x-added-target="him that | that hath" sid="JOB 26:2" /><char style="w" x-id="WLC.JOB.26.2.001" x-align="JOB.26.2.a001" x-target-ids="t001 t010" x-target="How How" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="how!" x-translit="meh-" xml:lang="hbo">מֶה</char>־<char style="w" x-id="WLC.JOB.26.2.002" x-align="JOB.26.2.a002" x-target-ids="t002 t003 t004" x-target="hast thou helped" x-target-head="t004" x-head="true" lemma="עָזַר" strong="H5826" x-morph="Vqp2ms" x-gloss="you.have.helped" x-translit="ʿāzarətā" xml:lang="hbo">עָזַ֥רְתָּ</char> <char style="w" x-id="WLC.JOB.26.2.003" x-align="JOB.26.2.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.26.2.004" x-align="JOB.26.2.a005" x-target-ids="t007 t008" x-target="is without" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.26.2.005" x-align="JOB.26.2.a006" x-target-ids="t009" x-target="power" x-target-head="t009" x-head="true" lemma="כֹּחַ" strong="H3581" x-morph="Ncmsa" x-gloss="power" x-translit="ḵōᵃḥ" xml:lang="hbo">כֹ֑חַ</char> <char style="w" x-id="WLC.JOB.26.2.006" x-align="JOB.26.2.a007" x-target-ids="t011 t012 t013" x-target="hast thou saved" x-target-head="t013" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="Vhp2ms" x-gloss="you.have.saved" x-translit="hôšaʿətā" xml:lang="hbo">ה֝וֹשַׁ֗עְתָּ</char> <char style="w" x-id="WLC.JOB.26.2.007" x-align="JOB.26.2.a008" x-target-ids="t014 t015" x-target="the arm" x-target-head="t015" x-head="true" lemma="זְרוֹעַ" strong="H2220" x-morph="Ncbsc" x-gloss="[the].arm" x-translit="zərôᵃʿ" xml:lang="hbo">זְר֣וֹעַ</char> <char style="w" x-id="WLC.JOB.26.2.0