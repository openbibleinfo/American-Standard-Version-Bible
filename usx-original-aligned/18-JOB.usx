	<para style="p"><verse number="3" style="v" x-ref="JOB.7.3" sid="JOB 7:3" /><char style="w" x-id="WLC.JOB.7.3.001" x-align="JOB.7.3.a001" x-target-ids="t001" x-target="So" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-gloss="so" x-translit="kēn" xml:lang="hbo">כֵּ֤ן</char> <char style="w" x-id="WLC.JOB.7.3.002" x-align="JOB.7.3.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="am I made to possess" x-target-head="t006" x-head="true" lemma="נָחַל" strong="H5157" x-morph="VHp1cs" x-gloss="I.have.been.allotted" x-translit="hānḥalətî" xml:lang="hbo">הָנְחַ֣לְתִּי</char> <char style="w" x-id="WLC.JOB.7.3.003" x-align="JOB.7.3.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="li" xml:lang="hbo">לִ֭</char><char style="w" x-id="WLC.JOB.7.3.004" x-align="JOB.7.3.a004" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="myself" x-translit="y" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.7.3.005" x-align="JOB.7.3.a005" x-target-ids="t007" x-target="months" x-target-head="t007" x-head="true" lemma="יֶרַח" strong="H3391" x-morph="Ncmpc" x-gloss="months" x-translit="yarḥê-" xml:lang="hbo">יַרְחֵי</char>־<char style="w" x-id="WLC.JOB.7.3.006" x-align="JOB.7.3.a006" x-target-ids="t008 t009" x-target="of misery" x-target-head="t009" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="of.worthlessness" x-translit="šāwəʾ" xml:lang="hbo">שָׁ֑וְא</char> <char style="w" x-id="WLC.JOB.7.3.007" x-align="JOB.7.3.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.7.3.008" x-align="JOB.7.3.a008" x-target-ids="t012" x-target="nights" x-target-head="t012" x-head="true" lemma="לַיְלָה" strong="H3915" x-morph="Ncmpc" x-gloss="nights" x-translit="lêlôṯ" xml:lang="hbo">לֵיל֥וֹת</char> <char