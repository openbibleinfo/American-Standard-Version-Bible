	<para style="p"><verse number="13" style="v" x-ref="JOB.6.13" sid="JOB 6:13" /><char style="w" x-id="WLC.JOB.6.13.001" x-align="JOB.6.13.a001" x-target-ids="t001" x-target="Is" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JOB.6.13.002" x-align="JOB.6.13.a002" x-target-ids="t002 t004" x-target="it that" x-target-head="t004" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim" xml:lang="hbo">אִ֬ם</char> <char style="w" x-id="WLC.JOB.6.13.003" x-align="JOB.6.13.a003" x-target-ids="t003 t006 t007" x-target="not have no" x-target-head="t007" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.JOB.6.13.004" x-align="JOB.6.13.a004" x-target-ids="t008" x-target="help" x-target-head="t008" x-head="true" lemma="עֶזְרָה" strong="H5833" x-morph="Ncfsc" x-gloss="help" x-translit="ʿezrāṯ" xml:lang="hbo">עֶזְרָתִ֣</char><char style="w" x-id="WLC.JOB.6.13.005" x-align="JOB.6.13.a005" x-target-ids="t005" x-target="I" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[is].my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.6.13.006" x-align="JOB.6.13.a006" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇ" xml:lang="hbo">בִ֑</char><char style="w" x-id="WLC.JOB.6.13.007" x-align="JOB.6.13.a007" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="myself" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.6.13.008" x-align="JOB.6.13.a008" x-target-ids="t011 t012" x-target="And that" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="W