	<para style="p"><verse number="19" style="v" x-ref="JOB.30.19" sid="JOB 30:19" /><char style="w" x-id="WLC.JOB.30.19.001" x-align="JOB.30.19.a001" x-target-ids="t001 t002 t003" x-target="He hath cast" x-target-head="t003" x-head="true" lemma="יָרָה" strong="H3384" x-morph="Vhp3ms" x-gloss="he" x-translit="hōr" xml:lang="hbo">הֹרָ֥</char><char style="w" x-id="WLC.JOB.30.19.002" x-align="JOB.30.19.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.thrown.me" x-translit="āniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.30.19.003" x-align="JOB.30.19.a003" x-target-ids="t005" x-target="into" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.JOB.30.19.004" x-align="JOB.30.19.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.30.19.005" x-align="JOB.30.19.a005" x-target-ids="t007" x-target="mire" x-target-head="t007" x-head="true" lemma="חֹמֶר" strong="H2563b" x-morph="Ncmsa" x-gloss="mud" x-translit="ḥōmer" xml:lang="hbo">חֹ֑מֶר</char> <char style="w" x-id="WLC.JOB.30.19.006" x-align="JOB.30.19.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ֝</char><char style="w" x-id="WLC.JOB.30.19.007" x-align="JOB.30.19.a007" x-target-ids="t009 t010 t011" x-target="I am become" x-target-head="t011" x-head="true" lemma="מָשַׁל" strong="H4911" x-morph="Vtw1cs" x-gloss="I.have.become.like" x-translit="ʾeṯmaššēl" xml:lang="hbo">אֶתְמַשֵּׁ֗ל</char> <char style="w" x-id="WLC.JOB.30.19.008" x-align="JOB.30.19.a008" x-target-ids="t012" x-target="like" x-target-head="t012" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss