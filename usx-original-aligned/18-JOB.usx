	<para style="p"><verse number="14" style="v" x-ref="JOB.27.14" x-added-alignments="JOB.27.14.a005" x-added-target-ids="t006" x-added-target="it" sid="JOB 27:14" /><char style="w" x-id="WLC.JOB.27.14.001" x-align="JOB.27.14.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.27.14.002" x-align="JOB.27.14.a002" x-target-ids="t004 t005" x-target="be multiplied" x-target-head="t005" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vqi3mp" x-gloss="they.will.increase" x-translit="yirbû" xml:lang="hbo">יִרְבּ֣וּ</char> <char style="w" x-id="WLC.JOB.27.14.003" x-align="JOB.27.14.a003" x-target-ids="t003" x-target="children" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="ḇānāy" xml:lang="hbo">בָנָ֣י</char><char style="w" x-id="WLC.JOB.27.14.004" x-align="JOB.27.14.a004" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.27.14.005" x-align="JOB.27.14.a006" x-target-ids="t007 t008" x-target="is for" x-target-head="t008" x-head="true" lemma="לְמוֹ" strong="H3926" x-morph="R" x-gloss="for" x-translit="ləmô-" xml:lang="hbo">לְמוֹ</char>־<char style="w" x-id="WLC.JOB.27.14.006" x-align="JOB.27.14.a007" x-target-ids="t009 t010" x-target="the sword" x-target-head="t010" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="[the].sword" x-translit="ḥāreḇ" xml:lang="hbo">חָ֑רֶב</char> <char style="w" x-id="WLC.JOB.27.14.007" x-align="JOB.27.14.a008" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.27.14.008" x-align="JOB.27.14.a009" x-target-ids="t013" x-target="offspring"