	<para style="p"><verse number="14" style="v" x-ref="JOB.29.14" sid="JOB 29:14" /><char style="w" x-id="WLC.JOB.29.14.001" x-align="JOB.29.14.a001" x-target-ids="t004" x-target="righteousness" x-target-head="t004" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="righteousness" x-translit="ṣeḏeq" xml:lang="hbo">צֶ֣דֶק</char> <char style="w" x-id="WLC.JOB.29.14.002" x-align="JOB.29.14.a002" x-target-ids="t001 t002 t003" x-target="I put on" x-target-head="t002" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqp1cs" x-gloss="I.put.on" x-translit="lāḇaštî" xml:lang="hbo">לָ֭בַשְׁתִּי</char> <char style="w" x-id="WLC.JOB.29.14.003" x-align="JOB.29.14.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.29.14.004" x-align="JOB.29.14.a004" x-target-ids="t006 t007" x-target="it clothed" x-target-head="t007" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqw3ms" x-gloss="it" x-translit="yyilbāš" xml:lang="hbo">יִּלְבָּשֵׁ֑</char><char style="w" x-id="WLC.JOB.29.14.005" x-align="JOB.29.14.a005" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="clothed.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.29.14.006" x-align="JOB.29.14.a006" x-target-ids="t011 t012" x-target="was as" x-target-head="t012" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="[was].like" x-translit="ki" xml:lang="hbo">כִּֽ</char><char style="w" x-id="WLC.JOB.29.14.007" x-align="JOB.29.14.a007" x-target-ids="t013 t014" x-target="a robe" x-target-head="t014" x-head="true" lemma="מְעִיל" strong="H4598" x-morph="Ncmsa" x-gloss="a.robe" x-translit="məʿiyl" xml:lang="hbo">מְעִ֥יל</char> <char style="w" x-id="WLC.JOB.29.14.008" x-align="JOB.29.14.a008" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma