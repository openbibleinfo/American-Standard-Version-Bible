	<para style="p"><verse number="4" style="v" x-ref="JOB.14.4" sid="JOB 14:4" /><char style="w" x-id="WLC.JOB.14.4.001" x-align="JOB.14.4.a001" x-target-ids="t001" x-target="Who" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy-" xml:lang="hbo">מִֽי</char>־<char style="w" x-id="WLC.JOB.14.4.002" x-align="JOB.14.4.a002" x-target-ids="t002 t003" x-target="can bring" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="will.he.make" x-translit="yittēn" xml:lang="hbo">יִתֵּ֣ן</char> <char style="w" x-id="WLC.JOB.14.4.003" x-align="JOB.14.4.a003" x-target-ids="t004 t005 t006" x-target="a clean thing" x-target-head="t005" x-head="true" lemma="טָהֹר" strong="H2889" x-morph="Aamsa" x-gloss="a.clean.[thing]" x-translit="ṭāhôr" xml:lang="hbo">טָ֭הוֹר</char> <char style="w" x-id="WLC.JOB.14.4.004" x-align="JOB.14.4.a004" x-target-ids="t007 t008" x-target="out of" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.14.4.005" x-align="JOB.14.4.a005" x-target-ids="t009 t010" x-target="an unclean" x-target-head="t010" x-head="true" lemma="טָמֵא" strong="H2931" x-morph="Aamsa" x-gloss="an.unclean.[thing]" x-translit="ṭṭāmēʾ" xml:lang="hbo">טָּמֵ֗א</char> <char style="w" x-id="WLC.JOB.14.4.006" x-align="JOB.14.4.a006" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.14.4.007" x-align="JOB.14.4.a007" x-target-ids="t012" x-target="one" x-target-head="t012" x-head="true" lemma="אֶחָד" strong="H259" x-morph="Acmsa" x-gloss="one.[person]" x-translit="ʾeḥāḏ:" xml:lang="hbo">אֶחָֽד</char>׃<verse eid="JOB 14:4" /></para>
