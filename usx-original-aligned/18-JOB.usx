	<para style="p"><verse number="17" style="v" x-ref="JOB.5.17" sid="JOB 5:17" /><char style="w" x-id="WLC.JOB.5.17.001" x-align="JOB.5.17.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֤ה</char> <char style="w" x-id="WLC.JOB.5.17.002" x-align="JOB.5.17.a002" x-target-ids="t002 t003" x-target="happy is" x-target-head="t002" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrēy" xml:lang="hbo">אַשְׁרֵ֣י</char> <char style="w" x-id="WLC.JOB.5.17.003" x-align="JOB.5.17.a003" x-target-ids="t004 t005" x-target="the man" x-target-head="t005" x-head="true" lemma="אֱנוֹשׁ" strong="H582" x-morph="Ncmsa" x-gloss="[is.the].person" x-translit="ʾĕnôš" xml:lang="hbo">אֱ֭נוֹשׁ</char> <char style="w" x-id="WLC.JOB.5.17.004" x-align="JOB.5.17.a004" x-target-ids="t008" x-target="correcteth" x-target-head="t008" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhi3ms" x-gloss="[whom].he" x-translit="yôḵiḥ" xml:lang="hbo">יוֹכִחֶ֣</char><char style="w" x-id="WLC.JOB.5.17.005" x-align="JOB.5.17.a005" x-target-ids="t006" x-target="whom" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="reproves.him" x-translit="ennû" xml:lang="hbo">נּֽוּ</char> <char style="w" x-id="WLC.JOB.5.17.006" x-align="JOB.5.17.a006" x-target-ids="t007" x-target="God" x-target-head="t007" x-head="true" lemma="אֱלֹוהַּ" strong="H433" x-morph="Ncmsa" x-gloss="God" x-translit="ʾĕlôᵃẖ" xml:lang="hbo">אֱל֑וֹהַּ</char> <char style="w" x-id="WLC.JOB.5.17.007" x-align="JOB.5.17.a007" x-target-ids="t009" x-target="Therefore" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.5.17.008" x-align="JOB.5.17.a008" x-target-ids="t013 t014" x-target="the chastening" x-target-head="t014" x-head="true" lemma="מ