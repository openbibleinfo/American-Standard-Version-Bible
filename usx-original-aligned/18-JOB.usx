	<para style="p"><verse number="33" style="v" x-ref="JOB.15.33" sid="JOB 15:33" /><char style="w" x-id="WLC.JOB.15.33.001" x-align="JOB.15.33.a001" x-target-ids="t001 t002 t003 t004" x-target="He shall shake off" x-target-head="t003" x-head="true" lemma="חָמַס" strong="H2554" x-morph="Vqi3ms" x-gloss="he.will.treat.violently" x-translit="yaḥmōs" xml:lang="hbo">יַחְמֹ֣ס</char> <char style="w" x-id="WLC.JOB.15.33.002" x-align="JOB.15.33.a002" x-target-ids="t008" x-target="as" x-target-head="t008" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.JOB.15.33.003" x-align="JOB.15.33.a003" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.15.33.004" x-align="JOB.15.33.a004" x-target-ids="t010" x-target="vine" x-target-head="t010" x-head="true" lemma="גֶּפֶן" strong="H1612" x-morph="Ncbsa" x-gloss="vine" x-translit="gep̄en" xml:lang="hbo">גֶּ֣פֶן</char> <char style="w" x-id="WLC.JOB.15.33.005" x-align="JOB.15.33.a005" x-target-ids="t006 t007" x-target="unripe grape" x-target-head="t007" x-head="true" lemma="בֶּסֶר" strong="H1155" x-morph="Ncmsc" x-gloss="grape[s]" x-translit="bisr" xml:lang="hbo">בִּסְר֑</char><char style="w" x-id="WLC.JOB.15.33.006" x-align="JOB.15.33.a006" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.unripe" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.15.33.007" x-align="JOB.15.33.a007" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.33.008" x-align="JOB.15.33.a008" x-target-ids="t012 t013 t014" x-target="shall cast off" x-target-head="t013" x-head="true" lemma="שָׁלַךְ"