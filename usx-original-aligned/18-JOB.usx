	<para style="p"><verse number="8" style="v" x-ref="JOB.28.8" sid="JOB 28:8" /><char style="w" x-id="WLC.JOB.28.8.001" x-align="JOB.28.8.a001" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.28.8.002" x-align="JOB.28.8.a002" x-target-ids="t004 t006" x-target="have trodden" x-target-head="t006" x-head="true" lemma="דָּרַךְ" strong="H1869" x-morph="Vhp3cp" x-gloss="they" x-translit="hiḏriyḵu" xml:lang="hbo">הִדְרִיכֻ֥</char><char style="w" x-id="WLC.JOB.28.8.003" x-align="JOB.28.8.a003" x-target-ids="t007" x-target="it" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="tread.it" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.JOB.28.8.004" x-align="JOB.28.8.a004" x-target-ids="t001 t003" x-target="The beasts" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="[the].sons" x-translit="ḇənê-" xml:lang="hbo">בְנֵי</char>־<char style="w" x-id="WLC.JOB.28.8.005" x-align="JOB.28.8.a005" x-target-ids="t002" x-target="proud" x-target-head="t002" x-head="true" lemma="שַׁחַץ" strong="H7830" x-morph="Ncmsa" x-gloss="of.pride" x-translit="šāḥaṣ" xml:lang="hbo">שָׁ֑חַץ</char> <char style="w" x-id="WLC.JOB.28.8.006" x-align="JOB.28.8.a006" x-target-ids="t008" x-target="Nor" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.28.8.007" x-align="JOB.28.8.a007" x-target-ids="t009 t013" x-target="hath passed" x-target-head="t013" x-head="true" lemma="עָדָה" strong="H5710" x-morph="Vqp3ms" x-gloss="it.passes.by" x-translit="ʿāḏāh" xml:lang="hbo">עָדָ֖ה</char> <char style="w" x-id="WLC.JOB.28.8.008" x-align="JOB.28.8.a008" x-target-ids="t014" x-target="thereby" x-target-head="t014" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-