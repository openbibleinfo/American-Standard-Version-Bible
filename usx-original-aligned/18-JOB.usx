	<para style="p"><verse number="15" style="v" x-ref="JOB.21.15" sid="JOB 21:15" /><char style="w" x-id="WLC.JOB.21.15.001" x-align="JOB.21.15.a001" x-target-ids="t001 t002" x-target="What is" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.21.15.002" x-align="JOB.21.15.a002" x-target-ids="t003 t004" x-target="the Almighty" x-target-head="t004" x-head="true" lemma="שַׁדַּי" strong="H7706" x-morph="Np" x-gloss="[is.the].Almighty" x-translit="šadday" xml:lang="hbo">שַׁדַּ֥י</char> <char style="w" x-id="WLC.JOB.21.15.003" x-align="JOB.21.15.a003" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.21.15.004" x-align="JOB.21.15.a004" x-target-ids="t006 t007 t008" x-target="we should serve" x-target-head="t008" x-head="true" lemma="עָבַד" strong="H5647" x-morph="Vqi1cp" x-gloss="we" x-translit="naʿaḇḏ" xml:lang="hbo">נַֽעַבְדֶ֑</char><char style="w" x-id="WLC.JOB.21.15.005" x-align="JOB.21.15.a005" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp1cp" x-gloss="will.serve.him" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.JOB.21.15.006" x-align="JOB.21.15.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.21.15.007" x-align="JOB.21.15.a007" x-target-ids="t011" x-target="what" x-target-head="t011" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.21.15.008" x-align="JOB.21.15.a008" x-target-ids="t012 t013 t014 t015" x-target="profit should we have" x-target-head="t012" x-head="true" lemma="