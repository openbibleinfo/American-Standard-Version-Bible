	<para style="p"><verse number="24" style="v" x-ref="JOB.36.24" sid="JOB 36:24" /><char style="w" x-id="WLC.JOB.36.24.001" x-align="JOB.36.24.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqv2ms" x-gloss="remember" x-translit="zəḵōr" xml:lang="hbo">זְ֭כֹר</char> <char style="w" x-id="WLC.JOB.36.24.002" x-align="JOB.36.24.a002" x-target-ids="t002" x-target="that" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.36.24.003" x-align="JOB.36.24.a003" x-target-ids="t003 t004" x-target="thou magnify" x-target-head="t004" x-head="true" lemma="שָׂגָא" strong="H7679" x-morph="Vhi2ms" x-gloss="you.will.magnify" x-translit="ṯaśgiyʾ" xml:lang="hbo">תַשְׂגִּ֣יא</char> <char style="w" x-id="WLC.JOB.36.24.004" x-align="JOB.36.24.a004" x-target-ids="t006" x-target="work" x-target-head="t006" x-head="true" lemma="פֹּעַל" strong="H6467" x-morph="Ncmsc" x-gloss="work" x-translit="p̄āʿŏl" xml:lang="hbo">פָעֳל֑</char><char style="w" x-id="WLC.JOB.36.24.005" x-align="JOB.36.24.a005" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.36.24.006" x-align="JOB.36.24.a006" x-target-ids="t007" x-target="Whereof" x-target-head="t007" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֖ר</char> <char style="w" x-id="WLC.JOB.36.24.007" x-align="JOB.36.24.a007" x-target-ids="t009 t010" x-target="have sung" x-target-head="t010" x-head="true" lemma="שִׁיר" strong="H7891" x-morph="Vop3cp" x-gloss="they.have.sung" x-translit="šōrərû" xml:lang="hbo">שֹׁרְר֣וּ</char> <char style="w" x-id="WLC.JOB.36.24.008" x-align="JOB.36.24.a008" x-target-ids="t008" x-target="men" x-target-head="t008" x-head="true" lemma="א