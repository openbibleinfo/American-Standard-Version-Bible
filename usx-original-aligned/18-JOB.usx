	<para style="p"><verse number="20" style="v" x-ref="JOB.13.20" sid="JOB 13:20" /><char style="w" x-id="WLC.JOB.13.20.001" x-align="JOB.13.20.a001" x-target-ids="t001" x-target="Only" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="only" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.JOB.13.20.002" x-align="JOB.13.20.a002" x-target-ids="t004 t005" x-target="two things" x-target-head="t004" x-head="true" lemma="שְׁנַיִם" strong="H8147" x-morph="Acfda" x-gloss="two.[things]" x-translit="šətayim" xml:lang="hbo">שְׁ֭תַּיִם</char> <char style="w" x-id="WLC.JOB.13.20.003" x-align="JOB.13.20.a003" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.JOB.13.20.004" x-align="JOB.13.20.a004" x-target-ids="t002" x-target="do" x-target-head="t002" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqj2ms" x-gloss="do" x-translit="taʿaś" xml:lang="hbo">תַּ֣עַשׂ</char> <char style="w" x-id="WLC.JOB.13.20.005" x-align="JOB.13.20.a005" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="עִמָּד" strong="H5978" x-morph="R" x-gloss="with" x-translit="ʿimmāḏ" xml:lang="hbo">עִמָּדִ֑</char><char style="w" x-id="WLC.JOB.13.20.006" x-align="JOB.13.20.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.13.20.007" x-align="JOB.13.20.a007" x-target-ids="t008" x-target="Then" x-target-head="t008" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֥ז</char> <char style="w" x-id="WLC.JOB.13.20.008" x-align="JOB.13.20.a008" x-target-ids="t014" x-target="from" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang=