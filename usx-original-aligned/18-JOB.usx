	<para style="p"><verse number="16" style="v" x-ref="JOB.28.16" sid="JOB 28:16" /><char style="w" x-id="WLC.JOB.28.16.001" x-align="JOB.28.16.a001" x-target-ids="t002" x-target="cannot" x-target-head="t002" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.28.16.002" x-align="JOB.28.16.a002" x-target-ids="t001 t003 t004" x-target="It be valued" x-target-head="t004" x-head="true" lemma="סָלָה" strong="H5541a" x-morph="VPi3fs" x-gloss="it.will.be.paid" x-translit="ṯəsulleh" xml:lang="hbo">תְ֭סֻלֶּה</char> <char style="w" x-id="WLC.JOB.28.16.003" x-align="JOB.28.16.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.(the)" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.28.16.004" x-align="JOB.28.16.a004" x-target-ids="t006 t007" x-target="the gold" x-target-head="t007" x-head="true" lemma="כֶּתֶם" strong="H3800" x-morph="Ncmsc" x-gloss="gold" x-translit="ḵeṯem" xml:lang="hbo">כֶ֣תֶם</char> <char style="w" x-id="WLC.JOB.28.16.005" x-align="JOB.28.16.a005" x-target-ids="t008 t009" x-target="of Ophir" x-target-head="t009" x-head="true" lemma="אוֹפִיר" strong="H211a" x-morph="Np" x-gloss="of.Ophir" x-translit="ʾôp̄iyr" xml:lang="hbo">אוֹפִ֑יר</char> <char style="w" x-id="WLC.JOB.28.16.006" x-align="JOB.28.16.a006" x-target-ids="t010" x-target="With" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.28.16.007" x-align="JOB.28.16.a007" x-target-ids="t011 t013" x-target="the onyx" x-target-head="t013" x-head="true" lemma="שֹׁהַם" strong="H7718" x-morph="Ncmsa" x-gloss="onyx" x-translit="šōham" xml:lang="hbo">שֹׁ֖הַם</char> <char style="w" x-id="WLC.JOB.28.16.008" x-align="JOB.28.16.a008" x-target-ids="t012" x-target="precious" x-target-head="t012" x-head="true" lemma="יָקָר" stron