	<para style="p"><verse number="5" style="v" x-ref="JOB.27.5" sid="JOB 27:5" /><char style="w" x-id="WLC.JOB.27.5.001" x-align="JOB.27.5.a001" x-target-ids="t001 t002 t003" x-target="Far be it" x-target-head="t001" x-head="true" lemma="חָלִילָה" strong="H2486" x-morph="Tj" x-gloss="far" x-translit="ḥāliyl" xml:lang="hbo">חָלִ֣ילָ</char><char style="w" x-id="WLC.JOB.27.5.002" x-align="JOB.27.5.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886c" x-morph="Sh" x-gloss="be.it" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.JOB.27.5.003" x-align="JOB.27.5.a003" x-target-ids="t004" x-target="from" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לִּ</char><char style="w" x-id="WLC.JOB.27.5.004" x-align="JOB.27.5.a004" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י֮</char> <char style="w" x-id="WLC.JOB.27.5.005" x-align="JOB.27.5.a005" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.27.5.006" x-align="JOB.27.5.a006" x-target-ids="t007 t008 t009" x-target="I should justify" x-target-head="t009" x-head="true" lemma="צָדֵק" strong="H6663" x-morph="Vhi1cs" x-gloss="I.will.declare.right" x-translit="ʾaṣdiyq" xml:lang="hbo">אַצְדִּ֪יק</char> <char style="w" x-id="WLC.JOB.27.5.007" x-align="JOB.27.5.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾeṯ" xml:lang="hbo">אֶ֫תְ</char><char style="w" x-id="WLC.JOB.27.5.008" x-align="JOB.27.5.a008" x-target-ids="t010" x-target="you" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="əḵem" xml:lang="hbo">כֶ֥ם</char> <char style="w" x-id="WLC.JOB.27.5.009" x-align="JOB.27.5.a009