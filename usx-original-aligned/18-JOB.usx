	<para style="p"><verse number="11" style="v" x-ref="JOB.34.11" sid="JOB 34:11" /><char style="w" x-id="WLC.JOB.34.11.001" x-align="JOB.34.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JOB.34.11.002" x-align="JOB.34.11.a002" x-target-ids="t002 t003" x-target="the work" x-target-head="t003" x-head="true" lemma="פֹּעַל" strong="H6467" x-morph="Ncmsc" x-gloss="[the].work" x-translit="p̄ōʿal" xml:lang="hbo">פֹ֣עַל</char> <char style="w" x-id="WLC.JOB.34.11.003" x-align="JOB.34.11.a003" x-target-ids="t004 t005 t006" x-target="of a man" x-target-head="t006" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.JOB.34.11.004" x-align="JOB.34.11.a004" x-target-ids="t007 t008 t009" x-target="will he render" x-target-head="t009" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="Vpi3ms" x-gloss="he.will.repay" x-translit="yəšallem-" xml:lang="hbo">יְשַׁלֶּם</char>־<char style="w" x-id="WLC.JOB.34.11.005" x-align="JOB.34.11.a005" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.JOB.34.11.006" x-align="JOB.34.11.a006" x-target-ids="t011" x-target="him" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.34.11.007" x-align="JOB.34.11.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.JOB.34.11.008" x-align="JOB.34.11.a008" x-target-ids="t018 t019" x-target="according to" x-target-head="t018" x-head="true" lemma="כְּ" strong="H3509a" x-