	<para style="p"><verse number="19" style="v" x-ref="JOB.4.19" sid="JOB 4:19" /><char style="w" x-id="WLC.JOB.4.19.001" x-align="JOB.4.19.a001" x-target-ids="t001 t002 t003" x-target="How much more" x-target-head="t003" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄" xml:lang="hbo">אַ֤ף</char>׀<char style="w" x-id="WLC.JOB.4.19.002" x-align="JOB.4.19.a002" x-target-ids="t004 t005 t006" x-target="them that dwell" x-target-head="t006" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqrmpc" x-gloss="[those.who].dwell" x-translit="šōḵənēy" xml:lang="hbo">שֹׁכְנֵ֬י</char> <char style="w" x-id="WLC.JOB.4.19.003" x-align="JOB.4.19.a003" x-target-ids="t007 t008" x-target="in houses" x-target-head="t008" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmpc" x-gloss="of.houses" x-translit="ḇātê-" xml:lang="hbo">בָֽתֵּי</char>־<char style="w" x-id="WLC.JOB.4.19.004" x-align="JOB.4.19.a004" x-target-ids="t009 t010" x-target="of clay" x-target-head="t010" x-head="true" lemma="חֹמֶר" strong="H2563b" x-morph="Ncmsa" x-gloss="of.clay" x-translit="ḥōmer" xml:lang="hbo">חֹ֗מֶר</char> <char style="w" x-id="WLC.JOB.4.19.005" x-align="JOB.4.19.a005" x-target-ids="t011" x-target="Whose" x-target-head="t011" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.JOB.4.19.006" x-align="JOB.4.19.a006" x-target-ids="t013 t014" x-target="is in" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="[is].in" x-translit="be" xml:lang="hbo">בֶּ</char><char style="w" x-id="WLC.JOB.4.19.007" x-align="JOB.4.19.a007" x-target-ids="t015" x-target="the" x-target-head="t015" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.4.19.008" x-align="JOB.4.19.a008" x-target-ids="t016" x-target="dust" x-target-head="t016" x-head="true" lemma="עָפָר" strong