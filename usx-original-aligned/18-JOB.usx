	<para style="p"><verse number="3" style="v" x-ref="JOB.35.3" x-added-alignments="JOB.35.3.a007" x-added-target-ids="t011" x-added-target="And" sid="JOB 35:3" /><char style="w" x-id="WLC.JOB.35.3.001" x-align="JOB.35.3.a001" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.35.3.002" x-align="JOB.35.3.a002" x-target-ids="t002 t003" x-target="thou sayest" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi2ms" x-gloss="you.say" x-translit="ṯōʾmar" xml:lang="hbo">תֹ֭אמַר</char> <char style="w" x-id="WLC.JOB.35.3.003" x-align="JOB.35.3.a003" x-target-ids="t004" x-target="What" x-target-head="t004" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.35.3.004" x-align="JOB.35.3.a004" x-target-ids="t005 t006 t007 t008" x-target="advantage will it be" x-target-head="t005" x-head="true" lemma="סָכַן" strong="H5532" x-morph="Vqi3ms" x-gloss="will.it.be.of.use" x-translit="yyiskān-" xml:lang="hbo">יִּסְכָּן</char>־<char style="w" x-id="WLC.JOB.35.3.005" x-align="JOB.35.3.a005" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ֑</char><char style="w" x-id="WLC.JOB.35.3.006" x-align="JOB.35.3.a006" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.JOB.35.3.007" x-align="JOB.35.3.a008" x-target-ids="t012" x-target="What" x-target-head="t012" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh-" xml:lang="hbo">מָֽה</char>־<char style="w" x-id="WLC.JOB.35.3.008" x-align="JOB.35.3.a009" x-target-ids="t013 t014 t015 t016" x-target="profit