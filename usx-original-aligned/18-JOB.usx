	<para style="p"><verse number="25" style="v" x-ref="JOB.12.25" sid="JOB 12:25" /><char style="w" x-id="WLC.JOB.12.25.001" x-align="JOB.12.25.a001" x-target-ids="t001 t002 t003" x-target="They grope in" x-target-head="t002" x-head="true" lemma="מָשַׁשׁ" strong="H4959" x-morph="Vpi3mp" x-gloss="they.grope" x-translit="yəmašəšû-" xml:lang="hbo">יְמַֽשְׁשׁוּ</char>־<char style="w" x-id="WLC.JOB.12.25.002" x-align="JOB.12.25.a002" x-target-ids="t004 t005" x-target="the dark" x-target-head="t005" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֥שֶׁךְ</char> <char style="w" x-id="WLC.JOB.12.25.003" x-align="JOB.12.25.a003" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.12.25.004" x-align="JOB.12.25.a003" x-target-ids="t006" x-target="without" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.12.25.005" x-align="JOB.12.25.a004" x-target-ids="t007" x-target="light" x-target-head="t007" x-head="true" lemma="אוֹר" strong="H216" x-morph="Ncbsa" x-gloss="light" x-translit="ʾôr" xml:lang="hbo">א֑וֹר</char> <char style="w" x-id="WLC.JOB.12.25.006" x-align="JOB.12.25.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝</char><char style="w" x-id="WLC.JOB.12.25.007" x-align="JOB.12.25.a006" x-target-ids="t009 t010 t012 t013" x-target="he maketh to stagger" x-target-head="t013" x-head="true" lemma="תָּעָה" strong="H8582" x-morph="Vhw3ms" x-gloss="he" x-translit="yyaṯʿ" xml:lang="hbo">יַּתְעֵ֗</char><char style="w" x-id="WLC.JOB.12.25.008" x-align="JOB.12.25.a007" x-target-ids="t011" x-target="them" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="made.them.wander" x-translit="ēm" xm