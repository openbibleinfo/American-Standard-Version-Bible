	<para style="p"><verse number="11" style="v" x-ref="JOB.31.11" sid="JOB 31:11" /><char style="w" x-id="WLC.JOB.31.11.001" x-align="JOB.31.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.31.11.002" x-align="JOB.31.11.a002" x-target-ids="t002" x-target="that" x-target-head="t002" x-head="true" lemma="הִיא" strong="H1931a" x-morph="Pp3fs" x-gloss="it" x-translit="**hiyʾ" xml:lang="hbo">הִ֥יא</char> <char style="w" x-id="WLC.JOB.31.11.003" x-align="JOB.31.11.a003" x-target-ids="t003 t004 t005 t006" x-target="were a heinous crime" x-target-head="t005" x-head="true" lemma="זִמָּה" strong="H2154" x-morph="Ncfsa" x-gloss="[is].wickedness" x-translit="zimmāh" xml:lang="hbo">זִמָּ֑ה</char> <char style="w" x-id="WLC.JOB.31.11.004" x-align="JOB.31.11.a004" x-target-ids="t007" x-target="Yea" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.31.11.005" x-align="JOB.31.11.a005" x-target-ids="t008" x-target="it" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="**hûʾ" xml:lang="hbo">ה֗וּא</char> <char style="w" x-id="WLC.JOB.31.11.006" x-align="JOB.31.11.a006" x-target-ids="t009 t010 t011" x-target="were an iniquity" x-target-head="t011" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsa" x-gloss="[is].iniquity" x-translit="ʿāwōn" xml:lang="hbo">עָוֺ֥ן</char> <char style="w" x-id="WLC.JOB.31.11.007" x-align="JOB.31.11.a007" x-target-ids="t012 t013 t014 t015 t016 t017" x-target="to be punished by the judges" x-target-head="t017" x-head="true" lemma="פָּלִיל" strong="H6414" x-morph="Ncmpa" x-gloss="judges" x-translit="pəlîliym:" xml:lang="hbo">פְּלִילִֽים</char>׃<verse eid="JOB 31:11" /></para>
