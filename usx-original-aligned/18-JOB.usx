	<para style="p"><verse number="25" style="v" x-ref="JOB.3.25" x-added-alignments="JOB.3.25.a003" x-added-target-ids="t004" x-added-target="which" sid="JOB 3:25" /><char style="w" x-id="WLC.JOB.3.25.001" x-align="JOB.3.25.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JOB.3.25.002" x-align="JOB.3.25.a002" x-target-ids="t002 t003" x-target="the thing" x-target-head="t003" x-head="true" lemma="פַּחַד" strong="H6343" x-morph="Ncmsa" x-gloss="a.fear" x-translit="p̄aḥaḏ" xml:lang="hbo">פַ֣חַד</char> <char style="w" x-id="WLC.JOB.3.25.003" x-align="JOB.3.25.a004" x-target-ids="t005 t006" x-target="I fear" x-target-head="t006" x-head="true" lemma="פָּחַד" strong="H6342" x-morph="Vqp1cs" x-gloss="I.feared" x-translit="pāḥaḏtî" xml:lang="hbo">פָּ֭חַדְתִּי</char> <char style="w" x-id="WLC.JOB.3.25.004" x-align="JOB.3.25.a005" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.3.25.005" x-align="JOB.3.25.a006" x-target-ids="t007 t008" x-target="cometh upon" x-target-head="t007" x-head="true" lemma="אָתָה" strong="H857" x-morph="Vqw3ms" x-gloss="it" x-translit="yyeʾĕṯāy" xml:lang="hbo">יֶּאֱתָיֵ֑</char><char style="w" x-id="WLC.JOB.3.25.006" x-align="JOB.3.25.a007" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="came.to.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.3.25.007" x-align="JOB.3.25.a008" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[that]" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.3.25.008" x-align="JOB.3.25.a009" x-target-ids="t011 t012" x-target="that which" x-target-head="t012" x-head="true" lem