	<para style="p"><verse number="18" style="v" x-ref="JOB.11.18" x-added-alignments="JOB.11.18.a011 JOB.11.18.a012" x-added-target-ids="t014 t015 t016" x-added-target="about thee | and" sid="JOB 11:18" /><char style="w" x-id="WLC.JOB.11.18.001" x-align="JOB.11.18.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ֭</char><char style="w" x-id="WLC.JOB.11.18.002" x-align="JOB.11.18.a002" x-target-ids="t002 t003 t004 t005" x-target="thou shalt be secure" x-target-head="t005" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqq2ms" x-gloss="you.will.be.secure" x-translit="ḇāṭaḥtā" xml:lang="hbo">בָטַחְתָּ</char> <char style="w" x-id="WLC.JOB.11.18.003" x-align="JOB.11.18.a003" x-target-ids="t006" x-target="because" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.11.18.004" x-align="JOB.11.18.a004" x-target-ids="t007 t008" x-target="there is" x-target-head="t008" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.JOB.11.18.005" x-align="JOB.11.18.a005" x-target-ids="t009" x-target="hope" x-target-head="t009" x-head="true" lemma="תִּקְוָה" strong="H8615" x-morph="Ncfsa" x-gloss="hope" x-translit="tiqwāh" xml:lang="hbo">תִּקְוָ֑ה</char> <char style="w" x-id="WLC.JOB.11.18.006" x-align="JOB.11.18.a006" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.11.18.007" x-align="JOB.11.18.a007" x-target-ids="t011 t012 t013" x-target="thou shalt search" x-target-head="t013" x-head="true" lemma="חָפַר" strong="H2658" x-morph="Vqq2ms" x-gloss="you.will.be.well.protected" x-translit="ḥāp̄artā" xml:lang="hbo">חָפַרְתָּ֗</char>