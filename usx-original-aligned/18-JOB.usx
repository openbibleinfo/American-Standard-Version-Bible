	<para style="p"><verse number="20" style="v" x-ref="JOB.18.20" sid="JOB 18:20" /><char style="w" x-id="WLC.JOB.18.20.001" x-align="JOB.18.20.a001" x-target-ids="t008" x-target="at" x-target-head="t008" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JOB.18.20.002" x-align="JOB.18.20.a002" x-target-ids="t010" x-target="day" x-target-head="t010" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsc" x-gloss="day" x-translit="yôm" xml:lang="hbo">י֭וֹמ</char><char style="w" x-id="WLC.JOB.18.20.003" x-align="JOB.18.20.a003" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.18.20.004" x-align="JOB.18.20.a004" x-target-ids="t005 t006 t007" x-target="shall be astonished" x-target-head="t007" x-head="true" lemma="שָׁמֵם" strong="H8074" x-morph="VNp3cp" x-gloss="they.are.appalled" x-translit="nāšammû" xml:lang="hbo">נָשַׁ֣מּוּ</char> <char style="w" x-id="WLC.JOB.18.20.005" x-align="JOB.18.20.a005" x-target-ids="t001 t002 t003 t004" x-target="They that come after" x-target-head="t004" x-head="true" lemma="אַחֲרוֹן" strong="H314" x-morph="Aampa" x-gloss="[the].western" x-translit="ʾaḥărōniym" xml:lang="hbo">אַחֲרֹנִ֑ים</char> <char style="w" x-id="WLC.JOB.18.20.006" x-align="JOB.18.20.a006" x-target-ids="t011" x-target="As" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.18.20.007" x-align="JOB.18.20.a007" x-target-ids="t012 t013 t014 t015" x-target="they that went before" x-target-head="t015" x-head="true" lemma="קַדְמֹנִי" strong="H6931" x-morph="Aampa" x-gloss="eastern" x-translit="qaḏmōniym" xml:lang="hbo">קַדְמֹנִ֗ים</char> <char style="w" x-id="WLC.JOB.18.20.008" x-align="JOB.18.20.a008" x-status="noncompositional" x-ta