	<para style="p"><verse number="18" style="v" x-ref="JOB.9.18" sid="JOB 9:18" /><char style="w" x-id="WLC.JOB.9.18.001" x-align="JOB.9.18.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.9.18.002" x-align="JOB.9.18.a002" x-target-ids="t001 t002 t004" x-target="He will suffer" x-target-head="t004" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="he" x-translit="yittən" xml:lang="hbo">יִ֭תְּנֵ</char><char style="w" x-id="WLC.JOB.9.18.003" x-align="JOB.9.18.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="permits.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.9.18.004" x-align="JOB.9.18.a004" x-target-ids="t006 t007" x-target="to take" x-target-head="t007" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vha" x-gloss="to.bring.back" x-translit="hāšēḇ" xml:lang="hbo">הָשֵׁ֣ב</char> <char style="w" x-id="WLC.JOB.9.18.005" x-align="JOB.9.18.a005" x-target-ids="t009" x-target="breath" x-target-head="t009" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="breath" x-translit="rûḥ" xml:lang="hbo">רוּחִ֑</char><char style="w" x-id="WLC.JOB.9.18.006" x-align="JOB.9.18.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.9.18.007" x-align="JOB.9.18.a007" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.JOB.9.18.008" x-align="JOB.9.18.a008" x-target-ids="t011" x-target="filleth" x-target-head="t011" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vhi3ms" x-gloss="he" x-translit="y