	<para style="p"><verse number="17" style="v" x-ref="JOB.11.17" x-added-alignments="JOB.11.17.a012 JOB.11.17.a013" x-added-target-ids="t002 t010" x-added-target="thy | Though" sid="JOB 11:17" /><char style="w" x-id="WLC.JOB.11.17.001" x-align="JOB.11.17.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ֭</char><char style="w" x-id="WLC.JOB.11.17.002" x-align="JOB.11.17.a002" x-target-ids="t007" x-target="than" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.11.17.003" x-align="JOB.11.17.a003" x-target-ids="t008 t009" x-target="the noonday" x-target-head="t009" x-head="true" lemma="צָהֳרַיִם" strong="H6672a" x-morph="Ncmpa" x-gloss="than.noon(s)" x-translit="ṣṣohŏrayim" xml:lang="hbo">צָּהֳרַיִם</char> <char style="w" x-id="WLC.JOB.11.17.004" x-align="JOB.11.17.a004" x-target-ids="t004 t005 t006" x-target="shall be clearer" x-target-head="t006" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi3ms" x-gloss="it.will.rise" x-translit="yāqûm" xml:lang="hbo">יָק֣וּם</char> <char style="w" x-id="WLC.JOB.11.17.005" x-align="JOB.11.17.a005" x-target-ids="t003" x-target="life" x-target-head="t003" x-head="true" lemma="חֶלֶד" strong="H2465" x-morph="Ncmsa" x-gloss="lifespan" x-translit="ḥāleḏ" xml:lang="hbo">חָ֑לֶד</char> <char style="w" x-id="WLC.JOB.11.17.006" x-align="JOB.11.17.a006" x-target-ids="t011 t012 t013" x-target="there be darkness" x-target-head="t013" x-head="true" lemma="תְּעוּפָה" strong="H5774a" x-morph="Vqi3fs" x-gloss="it" x-translit="tāʿup̄" xml:lang="hbo">תָּ֝עֻ֗פָ</char><char style="w" x-id="WLC.JOB.11.17.007" x-align="JOB.11.17.a007" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-gloss="will.be.dark" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.JOB.11.17.008" x-align="JOB.11.17