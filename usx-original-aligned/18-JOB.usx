	<para style="p"><verse number="2" style="v" x-ref="JOB.6.2" sid="JOB 6:2" /><char style="w" x-id="WLC.JOB.6.2.001" x-align="JOB.6.2.a001" x-target-ids="t001 t002" x-target="Oh that" x-target-head="t002" x-head="true" lemma="לוּ" strong="H3863" x-morph="C" x-gloss="if" x-translit="lû" xml:lang="hbo">ל֗וּ</char> <char style="w" x-id="WLC.JOB.6.2.002" x-align="JOB.6.2.a002" x-target-ids="t006" x-target="but" x-target-head="t006" x-head="true" lemma="שָׁקַל" strong="H8254" x-morph="Vqa" x-gloss="actually.(weigh)" x-translit="šāqôl" xml:lang="hbo">שָׁק֣וֹל</char> <char style="w" x-id="WLC.JOB.6.2.003" x-align="JOB.6.2.a003" x-target-ids="t005 t007" x-target="were weighed" x-target-head="t007" x-head="true" lemma="שָׁקַל" strong="H8254" x-morph="VNi3ms" x-gloss="it.will.be.weighed" x-translit="yiššāqēl" xml:lang="hbo">יִשָּׁקֵ֣ל</char> <char style="w" x-id="WLC.JOB.6.2.004" x-align="JOB.6.2.a004" x-target-ids="t004" x-target="vexation" x-target-head="t004" x-head="true" lemma="כַּעַס" strong="H3708a" x-morph="Ncmsc" x-gloss="grief" x-translit="kaʿś" xml:lang="hbo">כַּעְשִׂ֑</char><char style="w" x-id="WLC.JOB.6.2.005" x-align="JOB.6.2.a005" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.6.2.006" x-align="JOB.6.2.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.6.2.007" x-align="JOB.6.2.a007" x-target-ids="t011" x-target="calamity" x-target-head="t011" x-head="true" lemma="הַוָּה" strong="H1942a" x-morph="Ncfsc" x-gloss="destruction" x-translit="hawwāṯ" xml:lang="hbo">הַוָּתִ֗</char><char style="w" x-id="WLC.JOB.6.2.008" x-align="JOB.6.2.a008" x-target-ids="t010" x-target="my" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-tran