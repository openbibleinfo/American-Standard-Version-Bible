	<para style="p"><verse number="20" style="v" x-ref="JOB.11.20" sid="JOB 11:20" /><char style="w" x-id="WLC.JOB.11.20.001" x-align="JOB.11.20.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.11.20.002" x-align="JOB.11.20.a002" x-target-ids="t002 t003" x-target="the eyes" x-target-head="t003" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֥י</char> <char style="w" x-id="WLC.JOB.11.20.003" x-align="JOB.11.20.a003" x-target-ids="t004 t005 t006" x-target="of the wicked" x-target-head="t006" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֗ים</char> <char style="w" x-id="WLC.JOB.11.20.004" x-align="JOB.11.20.a004" x-target-ids="t007 t008" x-target="shall fail" x-target-head="t008" x-head="true" lemma="כָּלָה" strong="H3615" x-morph="Vqi3fp" x-gloss="they.will.fail" x-translit="tiḵəleynâ" xml:lang="hbo">תִּ֫כְלֶ֥ינָה</char> <char style="w" x-id="WLC.JOB.11.20.005" x-align="JOB.11.20.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֭</char><char style="w" x-id="WLC.JOB.11.20.006" x-align="JOB.11.20.a006" x-target-ids="t014 t015 t016" x-target="way to flee" x-target-head="t016" x-head="true" lemma="מָנוֹס" strong="H4498" x-morph="Ncmsa" x-gloss="a.place.of.escape" x-translit="mānôs" xml:lang="hbo">מָנוֹס</char> <char style="w" x-id="WLC.JOB.11.20.007" x-align="JOB.11.20.a007" x-target-ids="t011 t012 t013" x-target="shall have no" x-target-head="t012" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqp3ms" x-gloss="it.will.be.lost" x-translit="ʾāḇaḏ" xml:lang="hbo">אָבַ֣ד</char> <char style="w" x-id="WLC.JOB.11.20.008" x-align="JOB.11.20.a008" x-status="unreprese