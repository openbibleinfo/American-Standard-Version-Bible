	<para style="p"><verse number="2" style="v" x-ref="JOB.28.2" sid="JOB 28:2" /><char style="w" x-id="WLC.JOB.28.2.001" x-align="JOB.28.2.a001" x-target-ids="t001" x-target="Iron" x-target-head="t001" x-head="true" lemma="בַּרְזֶל" strong="H1270" x-morph="Ncmsa" x-gloss="iron" x-translit="barzel" xml:lang="hbo">בַּ֭רְזֶל</char> <char style="w" x-id="WLC.JOB.28.2.002" x-align="JOB.28.2.a002" x-target-ids="t004 t005 t012 t013" x-target="out of out of" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.JOB.28.2.003" x-align="JOB.28.2.a003" x-target-ids="t006 t007" x-target="the earth" x-target-head="t007" x-head="true" lemma="עָפָר" strong="H6083" x-morph="Ncmsa" x-gloss="dust" x-translit="ʿāp̄ār" xml:lang="hbo">עָפָ֣ר</char> <char style="w" x-id="WLC.JOB.28.2.004" x-align="JOB.28.2.a004" x-target-ids="t002 t003" x-target="is taken" x-target-head="t003" x-head="true" lemma="לָקַח" strong="H3947" x-morph="VQi3ms" x-gloss="it.is.taken" x-translit="yuqqāḥ" xml:lang="hbo">יֻקָּ֑ח</char> <char style="w" x-id="WLC.JOB.28.2.005" x-align="JOB.28.2.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.28.2.006" x-align="JOB.28.2.a006" x-target-ids="t014 t015" x-target="the stone" x-target-head="t015" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="stone" x-translit="ʾeḇen" xml:lang="hbo">אֶ֗בֶן</char> <char style="w" x-id="WLC.JOB.28.2.007" x-align="JOB.28.2.a007" x-target-ids="t010 t011" x-target="is molten" x-target-head="t011" x-head="true" lemma="יצק" strong="H6694" x-morph="Vqi3ms" x-gloss="someone.pours.out" x-translit="yāṣûq" xml:lang="hbo">יָצ֥וּק</char> <char style="w" x-id="WLC.JOB.28.2.008" x-align="JOB.28.2.a008" x-target-ids="t009" x-target="copper" x-target-head="t009" x-head="true" lemma="נְחוּש