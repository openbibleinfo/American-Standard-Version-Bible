	<para style="p"><verse number="4" style="v" x-ref="JOB.9.4" sid="JOB 9:4" /><char style="w" x-id="WLC.JOB.9.4.001" x-align="JOB.9.4.a001" x-target-ids="t001 t002 t003" x-target="He is wise" x-target-italic-ids="t001 t002" x-target-head="t003" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsc" x-gloss="wise" x-translit="ḥăḵam" xml:lang="hbo">חֲכַ֣ם</char> <char style="w" x-id="WLC.JOB.9.4.002" x-align="JOB.9.4.a002" x-target-ids="t004 t005" x-target="in heart" x-target-head="t005" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇāḇ" xml:lang="hbo">לֵ֭בָב</char> <char style="w" x-id="WLC.JOB.9.4.003" x-align="JOB.9.4.a003" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.9.4.004" x-align="JOB.9.4.a004" x-target-ids="t007" x-target="mighty" x-target-head="t007" x-head="true" lemma="אַמִּיץ" strong="H533" x-morph="Aamsc" x-gloss="strong" x-translit="ʾammiyṣ" xml:lang="hbo">אַמִּ֣יץ</char> <char style="w" x-id="WLC.JOB.9.4.005" x-align="JOB.9.4.a005" x-target-ids="t008 t009" x-target="in strength" x-target-head="t009" x-head="true" lemma="כֹּחַ" strong="H3581" x-morph="Ncmsa" x-gloss="of.power" x-translit="kōᵃḥ" xml:lang="hbo">כֹּ֑חַ</char> <char style="w" x-id="WLC.JOB.9.4.006" x-align="JOB.9.4.a006" x-target-ids="t010" x-target="Who" x-target-head="t010" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy-" xml:lang="hbo">מִֽי</char>־<char style="w" x-id="WLC.JOB.9.4.007" x-align="JOB.9.4.a007" x-target-ids="t011 t012 t013" x-target="hath hardened himself" x-target-head="t012" x-head="true" lemma="קָשָׁה" strong="H7185" x-morph="Vhp3ms" x-gloss="has.he.shown.stubbornness" x-translit="hiqšāh" xml:lang="hbo">הִקְשָׁ֥ה</char> <char style="w" x-id="WLC.JOB.9.4.008" x-align="JOB.9.4.a008" x-target-ids="t014" x-target="against" x-target-head="t014" 