	<para style="p"><verse number="30" style="v" x-ref="JOB.22.30" x-added-alignments="JOB.22.30.a002" x-added-target-ids="t004" x-added-target="even" sid="JOB 22:30" /><char style="w" x-id="WLC.JOB.22.30.001" x-align="JOB.22.30.a001" x-target-ids="t001 t002 t003" x-target="He will deliver" x-target-head="t003" x-head="true" lemma="מָלַט" strong="H4422" x-morph="Vpi3ms" x-gloss="he.will.deliver" x-translit="yəmallēṭ" xml:lang="hbo">יְֽמַלֵּ֥ט</char><char style="w" x-id="WLC.JOB.22.30.002" x-align="JOB.22.30.a003" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="אִי" strong="H336" x-morph="Tj" x-gloss="not" x-translit="ʾiy-" xml:lang="hbo">אִֽי</char>־<char style="w" x-id="WLC.JOB.22.30.003" x-align="JOB.22.30.a004" x-target-ids="t005 t006 t007 t009" x-target="him that is innocent" x-target-head="t009" x-head="true" lemma="נָקִי" strong="H5355" x-morph="Aamsa" x-gloss="an.innocent.[person]" x-translit="nāqiy" xml:lang="hbo">נָקִ֑י</char> <char style="w" x-id="WLC.JOB.22.30.004" x-align="JOB.22.30.a005" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.22.30.005" x-align="JOB.22.30.a006" x-target-ids="t011 t012 t013 t014" x-target="he shall be delivered" x-target-head="t014" x-head="true" lemma="מָלַט" strong="H4422" x-morph="VNq3ms" x-gloss="he.will.be.delivered" x-translit="nimlaṭ" xml:lang="hbo">נִמְלַ֗ט</char> <char style="w" x-id="WLC.JOB.22.30.006" x-align="JOB.22.30.a007" x-target-ids="t015" x-target="through" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.22.30.007" x-align="JOB.22.30.a008" x-target-ids="t016 t017" x-target="the cleanness" x-target-head="t017" x-head="true" lemma="בֹּר" strong="H1252" x-morph="Ncmsc" x-gloss="the.cleanness" x-translit="ḇōr" xml:lang="hbo">בֹ֣ר</char> <