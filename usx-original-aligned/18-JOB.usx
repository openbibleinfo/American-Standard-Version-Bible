	<para style="p"><verse number="12" style="v" x-ref="JOB.15.12" sid="JOB 15:12" /><char style="w" x-id="WLC.JOB.15.12.001" x-align="JOB.15.12.a001" x-target-ids="t001" x-target="Why" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.15.12.002" x-align="JOB.15.12.a002" x-target-ids="t002 t005 t007" x-target="doth carry away" x-target-head="t005" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqi3ms" x-gloss="does" x-translit="yyiqqāḥ" xml:lang="hbo">יִּקָּחֲ</char><char style="w" x-id="WLC.JOB.15.12.003" x-align="JOB.15.12.a003" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="it.carry.you.away" x-translit="ăḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.JOB.15.12.004" x-align="JOB.15.12.a004" x-target-ids="t004" x-target="heart" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבֶּ֑</char><char style="w" x-id="WLC.JOB.15.12.005" x-align="JOB.15.12.a005" x-target-ids="t003" x-target="thy" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.15.12.006" x-align="JOB.15.12.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.JOB.15.12.007" x-align="JOB.15.12.a007" x-target-ids="t009" x-target="why" x-target-head="t009" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.15.12.008" x-align="JOB.15.12.a008" x-target-ids="t010 t013" x-target="do flash" x-target-head="t013" x-head="true" lemma="רָזַם" strong="H7335" x-morph="Vqi3mp" x-gloss="do" x-translit