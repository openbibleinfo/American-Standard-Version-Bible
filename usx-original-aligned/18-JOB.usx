	<para style="p"><verse number="13" style="v" x-ref="JOB.15.13" sid="JOB 15:13" /><char style="w" x-id="WLC.JOB.15.13.001" x-align="JOB.15.13.a001" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.15.13.002" x-align="JOB.15.13.a002" x-target-ids="t004 t005" x-target="thou turnest" x-target-head="t005" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhi2ms" x-gloss="you.will.turn" x-translit="ṯāšiyḇ" xml:lang="hbo">תָשִׁ֣יב</char> <char style="w" x-id="WLC.JOB.15.13.003" x-align="JOB.15.13.a003" x-target-ids="t002" x-target="against" x-target-head="t002" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="against" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.JOB.15.13.004" x-align="JOB.15.13.a004" x-target-ids="t003" x-target="God" x-target-head="t003" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֣ל</char> <char style="w" x-id="WLC.JOB.15.13.005" x-align="JOB.15.13.a005" x-target-ids="t007" x-target="spirit" x-target-head="t007" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="spirit" x-translit="rûḥ" xml:lang="hbo">רוּחֶ֑</char><char style="w" x-id="WLC.JOB.15.13.006" x-align="JOB.15.13.a006" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.15.13.007" x-align="JOB.15.13.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.13.008" x-align="JOB.15.13.a008" x-target-ids="t009 t011 t012" x-target="lettest go out" x-target-head="t011" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vhq2ms" x-gloss="you.wil