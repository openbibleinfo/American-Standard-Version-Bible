	<para style="p"><verse number="15" style="v" x-ref="JOB.11.15" sid="JOB 11:15" /><char style="w" x-id="WLC.JOB.11.15.001" x-align="JOB.11.15.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.11.15.002" x-align="JOB.11.15.a002" x-target-ids="t002" x-target="then" x-target-head="t002" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֤ז</char>׀<char style="w" x-id="WLC.JOB.11.15.003" x-align="JOB.11.15.a003" x-target-ids="t003 t004 t005 t006" x-target="shalt thou lift up" x-target-head="t005" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi2ms" x-gloss="you.will.lift.up" x-translit="tiśśāʾ" xml:lang="hbo">תִּשָּׂ֣א</char> <char style="w" x-id="WLC.JOB.11.15.004" x-align="JOB.11.15.a004" x-target-ids="t008" x-target="face" x-target-head="t008" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="face" x-translit="p̄āney" xml:lang="hbo">פָנֶ֣י</char><char style="w" x-id="WLC.JOB.11.15.005" x-align="JOB.11.15.a005" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.11.15.006" x-align="JOB.11.15.a006" x-target-ids="t009" x-target="without" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.11.15.007" x-align="JOB.11.15.a007" x-target-ids="t010" x-target="spot" x-target-head="t010" x-head="true" lemma="מאוּם" strong="H3971a" x-morph="Ncmsa" x-gloss="blemish" x-translit="mmûm" xml:lang="hbo">מּ֑וּם</char> <char style="w" x-id="WLC.JOB.11.15.008" x-align="JOB.11.15.a008" x-target-ids="t011" x-target="Yea" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" 