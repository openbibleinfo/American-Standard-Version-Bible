	<para style="p"><verse number="23" style="v" x-ref="JOB.30.23" x-added-alignments="JOB.30.23.a003" x-added-target-ids="t004" x-added-target="that" sid="JOB 30:23" /><char style="w" x-id="WLC.JOB.30.23.001" x-align="JOB.30.23.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.30.23.002" x-align="JOB.30.23.a002" x-target-ids="t002 t003" x-target="I know" x-target-head="t003" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿtî" xml:lang="hbo">יָ֭דַעְתִּי</char> <char style="w" x-id="WLC.JOB.30.23.003" x-align="JOB.30.23.a006" x-target-ids="t009 t010" x-target="to death" x-target-head="t010" x-head="true" lemma="מָוֶת" strong="H4194" x-morph="Ncmsa" x-gloss="death" x-translit="māweṯ" xml:lang="hbo">מָ֣וֶת</char> <char style="w" x-id="WLC.JOB.30.23.004" x-align="JOB.30.23.a004" x-target-ids="t005 t006 t007" x-target="thou wilt bring" x-target-head="t007" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhi2ms" x-gloss="you" x-translit="təšiyḇ" xml:lang="hbo">תְּשִׁיבֵ֑</char><char style="w" x-id="WLC.JOB.30.23.005" x-align="JOB.30.23.a005" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.bring.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.30.23.006" x-align="JOB.30.23.a007" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.30.23.007" x-align="JOB.30.23.a008" x-target-ids="t012 t013 t014" x-target="to the house" x-target-head="t014" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="a.house" x-translit="ḇēyṯ" xml:lang="hbo">בֵ֖ית</char> <char style="w" x-id="WLC.JOB.30.23.008" x-align="JOB.30.23.a009" x-t