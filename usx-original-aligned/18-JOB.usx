	<para style="p"><verse number="15" style="v" x-ref="JOB.9.15" x-added-alignments="JOB.9.15.a004" x-added-target-ids="t006" x-added-target="yet" sid="JOB 9:15" /><char style="w" x-id="WLC.JOB.9.15.001" x-align="JOB.9.15.a001" x-target-ids="t001" x-target="Whom" x-target-head="t001" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.JOB.9.15.002" x-align="JOB.9.15.a002" x-target-ids="t002" x-target="though" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="though" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.15.003" x-align="JOB.9.15.a003" x-target-ids="t003 t004 t005" x-target="I were righteous" x-target-head="t005" x-head="true" lemma="צָדֵק" strong="H6663" x-morph="Vqp1cs" x-gloss="I.am.righteous" x-translit="ṣāḏaqtî" xml:lang="hbo">צָ֭דַקְתִּי</char> <char style="w" x-id="WLC.JOB.9.15.004" x-align="JOB.9.15.a005" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.9.15.005" x-align="JOB.9.15.a006" x-target-ids="t007 t008 t010" x-target="would I answer" x-target-head="t010" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi1cs" x-gloss="I.will.answer" x-translit="ʾeʿĕneh" xml:lang="hbo">אֶעֱנֶ֑ה</char> <char style="w" x-id="WLC.JOB.9.15.006" x-align="JOB.9.15.a007" x-target-ids="t015" x-target="to" x-target-head="t015" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ֝</char><char style="w" x-id="WLC.JOB.9.15.007" x-align="JOB.9.15.a008" x-target-ids="t017" x-target="judge" x-target-head="t017" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vmrmsc" x-gloss="judge" x-translit="məšōp̄əṭ" xml:lang="hbo">מְשֹׁפְטִ֗</char><char style="w" x-id="WLC.JOB.9.15.008" x-align="JOB.9.15.a009" x-target-ids="t016" x-targe