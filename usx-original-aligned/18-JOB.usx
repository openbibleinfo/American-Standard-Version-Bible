	<para style="p"><verse number="26" style="v" x-ref="JOB.22.26" sid="JOB 22:26" /><char style="w" x-id="WLC.JOB.22.26.001" x-align="JOB.22.26.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.22.26.002" x-align="JOB.22.26.a002" x-target-ids="t002" x-target="then" x-target-head="t002" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֭ז</char> <char style="w" x-id="WLC.JOB.22.26.003" x-align="JOB.22.26.a003" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JOB.22.26.004" x-align="JOB.22.26.a004" x-target-ids="t008 t009" x-target="the Almighty" x-target-head="t009" x-head="true" lemma="שַׁדַּי" strong="H7706" x-morph="Np" x-gloss="[the].Almighty" x-translit="šadday" xml:lang="hbo">שַׁדַּ֣י</char> <char style="w" x-id="WLC.JOB.22.26.005" x-align="JOB.22.26.a005" x-target-ids="t003 t004 t005 t006" x-target="shalt thou delight thyself" x-target-head="t005" x-head="true" lemma="עָנֹג" strong="H6026" x-morph="Vti2ms" x-gloss="you.will.take.delight" x-translit="tiṯʿannāḡ" xml:lang="hbo">תִּתְעַנָּ֑ג</char> <char style="w" x-id="WLC.JOB.22.26.006" x-align="JOB.22.26.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.22.26.007" x-align="JOB.22.26.a007" x-target-ids="t011 t012 t013" x-target="shalt lift up" x-target-head="t012" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi2ms" x-gloss="you.will.lift.up" x-translit="ṯiśśāʾ" xml:lang="hbo">תִשָּׂ֖א</char> <char style="w" x-id="WLC.JOB.22.26.008" x-align="JOB.22.26.a008" x-target-ids="t016" x-target="unto" x-target-head="t016" x-hea