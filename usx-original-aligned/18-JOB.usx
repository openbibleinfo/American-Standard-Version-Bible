	<para style="p"><verse number="25" style="v" x-ref="JOB.30.25" sid="JOB 30:25" /><char style="w" x-id="WLC.JOB.30.25.001" x-align="JOB.30.25.a001" x-target-ids="t001 t011" x-target="Did Was" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="(if)?" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.30.25.002" x-align="JOB.30.25.a002" x-target-ids="t002 t012" x-target="not not" x-target-head="t002" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.30.25.003" x-align="JOB.30.25.a003" x-target-ids="t003 t004" x-target="I weep" x-target-head="t004" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqp1cs" x-gloss="did.I.weep" x-translit="ḇāḵîṯî" xml:lang="hbo">בָ֭כִיתִי</char> <char style="w" x-id="WLC.JOB.30.25.004" x-align="JOB.30.25.a004" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for.[the]" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.JOB.30.25.005" x-align="JOB.30.25.a005" x-target-ids="t006 t007 t008 t009 t010" x-target="him that was in trouble" x-target-head="t010" x-head="true" lemma="קָשֶׁה" strong="H7186" x-morph="Aamsc" x-gloss="hard" x-translit="qəšēh-" xml:lang="hbo">קְשֵׁה</char>־<char style="w" x-id="WLC.JOB.30.25.006" x-align="JOB.30.25.a006" x-status="unrepresented" x-head="true" lemma="יוֹם" strong="H3117a" x-morph="Ncmsa" x-gloss="of.day" x-translit="yôm" xml:lang="hbo">י֑וֹם</char> <char style="w" x-id="WLC.JOB.30.25.007" x-align="JOB.30.25.a009" x-target-ids="t015" x-target="grieved" x-target-head="t015" x-head="true" lemma="עָגַם" strong="H5701" x-morph="Vqp3fs" x-gloss="was.it.grieved?" x-translit="ʿāḡəmāh" xml:lang="hbo">עָֽגְמָ֥ה</char> <char style="w" x-id="WLC.JOB.30.25.008" x-align="JOB.30.25.a008" x-target-ids="t014" x-target="soul" x-target-head="t014" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-m