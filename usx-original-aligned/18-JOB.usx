	<para style="p"><verse number="3" style="v" x-ref="JOB.13.3" sid="JOB 13:3" /><char style="w" x-id="WLC.JOB.13.3.001" x-align="JOB.13.3.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אוּלָם" strong="H199" x-morph="D" x-gloss="but" x-translit="ʾûlām" xml:lang="hbo">אוּלָ֗ם</char> <char style="w" x-id="WLC.JOB.13.3.002" x-align="JOB.13.3.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾănî" xml:lang="hbo">אֲ֭נִי</char> <char style="w" x-id="WLC.JOB.13.3.003" x-align="JOB.13.3.a003" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.JOB.13.3.004" x-align="JOB.13.3.a004" x-target-ids="t006 t007" x-target="the Almighty" x-target-head="t007" x-head="true" lemma="שַׁדַּי" strong="H7706" x-morph="Np" x-gloss="[the].Almighty" x-translit="šadday" xml:lang="hbo">שַׁדַּ֣י</char> <char style="w" x-id="WLC.JOB.13.3.005" x-align="JOB.13.3.a005" x-target-ids="t003 t004" x-target="would speak" x-target-head="t004" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpi1cs" x-gloss="I.will.speak" x-translit="ʾăḏabbēr" xml:lang="hbo">אֲדַבֵּ֑ר</char> <char style="w" x-id="WLC.JOB.13.3.006" x-align="JOB.13.3.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.13.3.007" x-align="JOB.13.3.a007" x-target-ids="t011 t012" x-target="to reason" x-target-head="t012" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vha" x-gloss="to.argue" x-translit="hôḵēᵃḥ" xml:lang="hbo">הוֹכֵ֖חַ</char> <char style="w" x-id="WLC.JOB.13.3.008" x-align="JOB.13.3.a008" x-target-ids="t013" x-target="with" x-target-head="t013" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-transl