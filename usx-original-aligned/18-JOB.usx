	<para style="p"><verse number="2" style="v" x-ref="JOB.33.2" sid="JOB 33:2" /><char style="w" x-id="WLC.JOB.33.2.001" x-align="JOB.33.2.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh-" xml:lang="hbo">הִנֵּה</char>־<char style="w" x-id="WLC.JOB.33.2.002" x-align="JOB.33.2.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֭א</char> <char style="w" x-id="WLC.JOB.33.2.003" x-align="JOB.33.2.a003" x-target-ids="t003 t004 t005" x-target="I have opened" x-target-head="t005" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="Vqp1cs" x-gloss="I.open" x-translit="pāṯaḥətî" xml:lang="hbo">פָּתַ֣חְתִּי</char> <char style="w" x-id="WLC.JOB.33.2.004" x-align="JOB.33.2.a004" x-target-ids="t007" x-target="mouth" x-target-head="t007" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄" xml:lang="hbo">פִ֑</char><char style="w" x-id="WLC.JOB.33.2.005" x-align="JOB.33.2.a005" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.33.2.006" x-align="JOB.33.2.a006" x-target-ids="t010 t011" x-target="hath spoken" x-target-head="t011" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpp3fs" x-gloss="it.speaks" x-translit="dibbərāh" xml:lang="hbo">דִּבְּרָ֖ה</char> <char style="w" x-id="WLC.JOB.33.2.007" x-align="JOB.33.2.a007" x-target-ids="t009" x-target="tongue" x-target-head="t009" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="tongue" x-translit="ləšôn" xml:lang="hbo">לְשׁוֹנִ֣</char><char style="w" x-id="WLC.JOB.33.2.008" x-align="JOB.33.2.a008" x-target-ids="t008" x-target="My" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" 