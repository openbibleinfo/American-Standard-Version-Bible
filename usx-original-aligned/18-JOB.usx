	<para style="p"><verse number="23" style="v" x-ref="JOB.31.23" sid="JOB 31:23" /><char style="w" x-id="WLC.JOB.31.23.001" x-align="JOB.31.23.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JOB.31.23.002" x-align="JOB.31.23.a004" x-target-ids="t005 t006 t007" x-target="is a terror" x-target-head="t007" x-head="true" lemma="פַּחַד" strong="H6343" x-morph="Ncmsa" x-gloss="[was].a.fear" x-translit="p̄aḥaḏ" xml:lang="hbo">פַ֣חַד</char> <char style="w" x-id="WLC.JOB.31.23.003" x-align="JOB.31.23.a005" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵ֭לַ</char><char style="w" x-id="WLC.JOB.31.23.004" x-align="JOB.31.23.a006" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.23.005" x-align="JOB.31.23.a002" x-target-ids="t002" x-target="calamity" x-target-head="t002" x-head="true" lemma="אֵיד" strong="H343" x-morph="Ncmsc" x-gloss="(the).calamity" x-translit="ʾēyḏ" xml:lang="hbo">אֵ֣יד</char> <char style="w" x-id="WLC.JOB.31.23.006" x-align="JOB.31.23.a003" x-target-ids="t003 t004" x-target="from God" x-target-head="t004" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="of.God" x-translit="ʾēl" xml:lang="hbo">אֵ֑ל</char> <char style="w" x-id="WLC.JOB.31.23.007" x-align="JOB.31.23.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.31.23.008" x-align="JOB.31.23.a008" x-target-ids="t011 t012 t013" x-target="by reason of" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-tra