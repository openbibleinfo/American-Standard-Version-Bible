	<para style="p"><verse number="3" style="v" x-ref="JOB.42.3" sid="JOB 42:3" /><char style="w" x-id="WLC.JOB.42.3.001" x-align="JOB.42.3.a001" x-target-ids="t001 t002" x-target="Who is" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo">מִ֤י</char> <char style="w" x-id="WLC.JOB.42.3.002" x-align="JOB.42.3.a002" x-target-ids="t003" x-target="this" x-target-head="t003" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֨ה</char>׀<char style="w" x-id="WLC.JOB.42.3.003" x-align="JOB.42.3.a003" x-target-ids="t004 t005" x-target="that hideth" x-target-head="t005" x-head="true" lemma="עָלַם" strong="H5956" x-morph="Vhrmsc" x-gloss="[is].concealing" x-translit="maʿliym" xml:lang="hbo">מַעְלִ֥ים</char> <char style="w" x-id="WLC.JOB.42.3.004" x-align="JOB.42.3.a004" x-target-ids="t006" x-target="counsel" x-target-head="t006" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsa" x-gloss="(of).counsel" x-translit="ʿēṣāh" xml:lang="hbo">עֵצָ֗ה</char> <char style="w" x-id="WLC.JOB.42.3.005" x-align="JOB.42.3.a005" x-target-ids="t007" x-target="without" x-target-head="t007" x-head="true" lemma="בְּלִי" strong="H1097" x-morph="Tn" x-gloss="not" x-translit="bəliy" xml:lang="hbo">בְּֽלִ֫י</char> <char style="w" x-id="WLC.JOB.42.3.006" x-align="JOB.42.3.a006" x-target-ids="t008" x-target="knowledge" x-target-head="t008" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="ḏāʿaṯ" xml:lang="hbo">דָ֥עַת</char> <char style="w" x-id="WLC.JOB.42.3.007" x-align="JOB.42.3.a007" x-target-ids="t009" x-target="Therefore" x-target-head="t009" x-head="true" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.42.3.008" x-align="JOB.42.3.a007" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֣ן</char> <char style="w" x-id="WLC.JO