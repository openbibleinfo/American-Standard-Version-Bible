	<para style="p"><verse number="16" style="v" x-ref="JOB.9.16" x-added-alignments="JOB.9.16.a006" x-added-target-ids="t010" x-added-target="Yet" sid="JOB 9:16" /><char style="w" x-id="WLC.JOB.9.16.001" x-align="JOB.9.16.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.16.002" x-align="JOB.9.16.a002" x-target-ids="t002 t003 t004" x-target="I had called" x-target-head="t004" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqp1cs" x-gloss="I.called" x-translit="qārāʾṯî" xml:lang="hbo">קָרָ֥אתִי</char> <char style="w" x-id="WLC.JOB.9.16.003" x-align="JOB.9.16.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.JOB.9.16.004" x-align="JOB.9.16.a004" x-target-ids="t006 t007 t008" x-target="he had answered" x-target-head="t008" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw3ms" x-gloss="he" x-translit="yyaʿăn" xml:lang="hbo">יַּעֲנֵ֑</char><char style="w" x-id="WLC.JOB.9.16.005" x-align="JOB.9.16.a005" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="answered.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.9.16.006" x-align="JOB.9.16.a007" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.9.16.007" x-align="JOB.9.16.a008" x-target-ids="t011 t012 t014" x-target="would I believe" x-target-head="t014" x-head="true" lemma="אָמַן" strong="H539" x-morph="Vhi1cs" x-gloss="I.believe" x-translit="ʾaʾămiyn" xml:lang="hbo">אַ֝אֲמִ֗ין</char> <char style="w" x-id="WLC.JOB.9.16.008" x-align="JOB.9.16.a009" x-target-ids="t015" x-target=