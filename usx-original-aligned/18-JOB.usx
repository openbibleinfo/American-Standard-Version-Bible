	<para style="p"><verse number="8" style="v" x-ref="JOB.3.8" sid="JOB 3:8" /><char style="w" x-id="WLC.JOB.3.8.001" x-align="JOB.3.8.a001" x-target-ids="t001 t002 t003" x-target="Let them curse" x-target-head="t003" x-head="true" lemma="קבב" strong="H6895" x-morph="Vqi3mp" x-gloss="let" x-translit="yiqqəḇu" xml:lang="hbo">יִקְּבֻ֥</char><char style="w" x-id="WLC.JOB.3.8.002" x-align="JOB.3.8.a002" x-target-ids="t004" x-target="it" x-target-head="t004" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="them.curse.it" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.JOB.3.8.003" x-align="JOB.3.8.a003" x-target-ids="t005 t006" x-target="that curse" x-target-head="t006" x-head="true" lemma="אָרַר" strong="H779" x-morph="Vqrmpc" x-gloss="[those.who].curse" x-translit="ʾōrərê-" xml:lang="hbo">אֹרְרֵי</char>־<char style="w" x-id="WLC.JOB.3.8.004" x-align="JOB.3.8.a004" x-target-ids="t007 t008" x-target="the day" x-target-head="t008" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="(of).a.day" x-translit="yôm" xml:lang="hbo">י֑וֹם</char> <char style="w" x-id="WLC.JOB.3.8.005" x-align="JOB.3.8.a005" x-target-ids="t009" x-target="Who" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.[ones]" x-translit="hā" xml:lang="hbo">הָ֝</char><char style="w" x-id="WLC.JOB.3.8.006" x-align="JOB.3.8.a006" x-target-ids="t010 t011" x-target="are ready" x-target-head="t011" x-head="true" lemma="עָתִיד" strong="H6264" x-morph="Aampa" x-gloss="ready" x-translit="ʿăṯîḏiym" xml:lang="hbo">עֲתִידִ֗ים</char> <char style="w" x-id="WLC.JOB.3.8.007" x-align="JOB.3.8.a007" x-target-ids="t012 t013 t014" x-target="to rouse up" x-target-head="t013" x-head="true" lemma="עוּר" strong="H5782" x-morph="Voc" x-gloss="to.rouse" x-translit="ʿōrēr" xml:lang="hbo">עֹרֵ֥ר</char> <char style="w" x-id="WLC.JOB.3.8.008" x-align="JOB.3.8.a008" x-target-ids="t015" x-target="leviathan" x-target-head="t015" x-head="true" lemma="לִ