	<para style="p"><verse number="22" style="v" x-ref="JOB.15.22" sid="JOB 15:22" /><char style="w" x-id="WLC.JOB.15.22.001" x-align="JOB.15.22.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.15.22.002" x-align="JOB.15.22.a002" x-target-ids="t001 t002" x-target="He believeth" x-target-head="t002" x-head="true" lemma="אָמַן" strong="H539" x-morph="Vhi3ms" x-gloss="he.believes" x-translit="yaʾămiyn" xml:lang="hbo">יַאֲמִ֣ין</char> <char style="w" x-id="WLC.JOB.15.22.003" x-align="JOB.15.22.a003" x-target-ids="t004 t005 t006 t007" x-target="that he shall return" x-target-head="t007" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqc" x-gloss="to.return" x-translit="šûḇ" xml:lang="hbo">שׁ֭וּב</char> <char style="w" x-id="WLC.JOB.15.22.004" x-align="JOB.15.22.a004" x-target-ids="t008 t009" x-target="out of" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="minnî-" xml:lang="hbo">מִנִּי</char>־<char style="w" x-id="WLC.JOB.15.22.005" x-align="JOB.15.22.a005" x-target-ids="t010" x-target="darkness" x-target-head="t010" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֑שֶׁךְ</char> <char style="w" x-id="WLC.JOB.15.22.006" x-align="JOB.15.22.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.22.007" x-align="JOB.15.22.a007" x-target-ids="t013 t014 t015" x-target="is waited for" x-target-head="t014" x-head="true" lemma="צָפָה" strong="H6822" x-morph="Vqsmsa" x-gloss="watched" x-translit="**ṣāp̄ûy" xml:lang="hbo">צָפ֖וּי</char> <char style="w" x-id="WLC.JOB.15.22.008" x-align="JOB.15.22.a008" x-target-ids="t012" x-target="he" x-target-head="t012" x-h