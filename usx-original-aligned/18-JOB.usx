	<para style="p"><verse number="16" style="v" x-ref="JOB.27.16" sid="JOB 27:16" /><char style="w" x-id="WLC.JOB.27.16.001" x-align="JOB.27.16.a001" x-target-ids="t001" x-target="Though" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.27.16.002" x-align="JOB.27.16.a002" x-target-ids="t002 t003 t004" x-target="he heap up" x-target-head="t003" x-head="true" lemma="צָבַר" strong="H6651" x-morph="Vqi3ms" x-gloss="he.will.heap.up" x-translit="yiṣbōr" xml:lang="hbo">יִצְבֹּ֣ר</char> <char style="w" x-id="WLC.JOB.27.16.003" x-align="JOB.27.16.a003" x-target-ids="t006" x-target="as" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ke" xml:lang="hbo">כֶּ</char><char style="w" x-id="WLC.JOB.27.16.004" x-align="JOB.27.16.a004" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.27.16.005" x-align="JOB.27.16.a005" x-target-ids="t008" x-target="dust" x-target-head="t008" x-head="true" lemma="עָפָר" strong="H6083" x-morph="Ncmsa" x-gloss="dust" x-translit="ʿāp̄ār" xml:lang="hbo">עָפָ֣ר</char> <char style="w" x-id="WLC.JOB.27.16.006" x-align="JOB.27.16.a006" x-target-ids="t005" x-target="silver" x-target-head="t005" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="silver" x-translit="kāsep̄" xml:lang="hbo">כָּ֑סֶף</char> <char style="w" x-id="WLC.JOB.27.16.007" x-align="JOB.27.16.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.27.16.008" x-align="JOB.27.16.a008" x-target-ids="t012" x-target="as" x-target-head="t012" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ḵa" xml: