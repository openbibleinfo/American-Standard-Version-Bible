	<para style="p"><verse number="26" style="v" x-ref="JOB.9.26" x-added-alignments="JOB.9.26.a007" x-added-target-ids="t012" x-added-target="that" sid="JOB 9:26" /><char style="w" x-id="WLC.JOB.9.26.001" x-align="JOB.9.26.a001" x-target-ids="t001 t002 t003 t004" x-target="They are passed away" x-target-head="t003" x-head="true" lemma="חָלַף" strong="H2498" x-morph="Vqp3cp" x-gloss="they.have.passed.on" x-translit="ḥāləp̄û" xml:lang="hbo">חָ֭לְפוּ</char> <char style="w" x-id="WLC.JOB.9.26.002" x-align="JOB.9.26.a002" x-target-ids="t005" x-target="as" x-target-head="t005" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.JOB.9.26.003" x-align="JOB.9.26.a003" x-target-ids="t006 t008" x-target="the ships" x-target-head="t008" x-head="true" lemma="אֳנִיָּה" strong="H591" x-morph="Ncfpa" x-gloss="ships" x-translit="ʾŏniyyôṯ" xml:lang="hbo">אֳנִיּ֣וֹת</char> <char style="w" x-id="WLC.JOB.9.26.004" x-align="JOB.9.26.a004" x-target-ids="t007" x-target="swift" x-target-head="t007" x-head="true" lemma="אֵבֶה" strong="H16" x-morph="Ncmsa" x-gloss="of.reed" x-translit="ʾēḇeh" xml:lang="hbo">אֵבֶ֑ה</char> <char style="w" x-id="WLC.JOB.9.26.005" x-align="JOB.9.26.a005" x-target-ids="t009" x-target="As" x-target-head="t009" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ֝</char><char style="w" x-id="WLC.JOB.9.26.006" x-align="JOB.9.26.a006" x-target-ids="t010 t011" x-target="the eagle" x-target-head="t011" x-head="true" lemma="נֶשֶׁר" strong="H5404" x-morph="Ncmsa" x-gloss="an.eagle" x-translit="nešer" xml:lang="hbo">נֶ֗שֶׁר</char> <char style="w" x-id="WLC.JOB.9.26.007" x-align="JOB.9.26.a008" x-target-ids="t013" x-target="swoopeth" x-target-head="t013" x-head="true" lemma="טוּשׂ" strong="H2907" x-morph="Vqi3ms" x-gloss="[which].it.rushes" x-translit="yāṭûś" xml:lang="hbo">יָט֥וּשׂ</char> <char style="w" x-id="WLC.JOB.9.26.008" x-align="JOB