	<para style="p"><verse number="33" style="v" x-ref="JOB.41.33" sid="JOB 41:33" /><char style="w" x-id="WLC.JOB.41.33.001" x-align="JOB.41.33.a003" x-target-ids="t003 t004 t005" x-target="there is not" x-target-head="t005" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn-" xml:lang="hbo" x-source-ref="JOB.41.25">אֵֽין</char>־<char style="w" x-id="WLC.JOB.41.33.002" x-align="JOB.41.33.a001" x-target-ids="t001" x-target="Upon" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="JOB.41.25">עַל</char>־<char style="w" x-id="WLC.JOB.41.33.003" x-align="JOB.41.33.a002" x-target-ids="t002" x-target="earth" x-target-head="t002" x-head="true" lemma="עָפָר" strong="H6083" x-morph="Ncmsa" x-gloss="[the].dust" x-translit="ʿāp̄ār" xml:lang="hbo" x-source-ref="JOB.41.25">עָפָ֥ר</char> <char style="w" x-id="WLC.JOB.41.33.004" x-align="JOB.41.33.a005" x-target-ids="t007" x-target="like" x-target-head="t007" x-head="true" lemma="מֹשֶׁל" strong="H4915a" x-morph="Ncmsc" x-gloss="likeness" x-translit="māšəl" xml:lang="hbo" x-source-ref="JOB.41.25">מָשְׁל֑</char><char style="w" x-id="WLC.JOB.41.33.005" x-align="JOB.41.33.a004" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="ô" xml:lang="hbo" x-source-ref="JOB.41.25">וֹ</char> <char style="w" x-id="WLC.JOB.41.33.006" x-align="JOB.41.33.a006" x-target-ids="t008" x-target="That" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.[one]" x-translit="he" xml:lang="hbo" x-source-ref="JOB.41.25">הֶ֝</char><char style="w" x-id="WLC.JOB.41.33.007" x-align="JOB.41.33.a007" x-target-ids="t009 t010" x-target="is made" x-target-head="t010" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqsmsa" x-gloss="made" x-translit="ʿāśû" xml:lang="hbo" x-source-ref="JOB.41.25">עָשׂ֗וּ</char> <char styl