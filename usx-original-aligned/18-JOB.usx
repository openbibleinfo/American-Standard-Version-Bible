	<para style="p"><verse number="14" style="v" x-ref="JOB.13.14" sid="JOB 13:14" /><char style="w" x-id="WLC.JOB.13.14.001" x-align="JOB.13.14.a001" lemma="עַל" strong="H5921" x-morph="R" x-gloss="concerning" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JOB.13.14.002" x-align="JOB.13.14.a001" x-target-ids="t001" x-target="Wherefore" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh" xml:lang="hbo">מָ֤ה</char>׀<char style="w" x-id="WLC.JOB.13.14.003" x-align="JOB.13.14.a002" x-target-ids="t002 t003 t004" x-target="should I take" x-target-head="t004" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi1cs" x-gloss="will.I.take" x-translit="ʾeśśāʾ" xml:lang="hbo">אֶשָּׂ֣א</char> <char style="w" x-id="WLC.JOB.13.14.004" x-align="JOB.13.14.a003" x-target-ids="t006" x-target="flesh" x-target-head="t006" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmsc" x-gloss="flesh" x-translit="ḇəśār" xml:lang="hbo">בְשָׂרִ֣</char><char style="w" x-id="WLC.JOB.13.14.005" x-align="JOB.13.14.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.13.14.006" x-align="JOB.13.14.a005" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.JOB.13.14.007" x-align="JOB.13.14.a006" x-target-ids="t009" x-target="teeth" x-target-head="t009" x-head="true" lemma="שֵׁן" strong="H8127" x-morph="Ncbdc" x-gloss="teeth" x-translit="šinn" xml:lang="hbo">שִׁנָּ֑</char><char style="w" x-id="WLC.JOB.13.14.008" x-align="JOB.13.14.a007" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.13.14.009" x