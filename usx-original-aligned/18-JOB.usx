	<para style="p"><verse number="33" style="v" x-ref="JOB.21.33" sid="JOB 21:33" /><char style="w" x-id="WLC.JOB.21.33.001" x-align="JOB.21.33.a001" x-target-ids="t006 t007 t008" x-target="shall be sweet" x-target-head="t008" x-head="true" lemma="מָתֹק" strong="H4985" x-morph="Vqp3cp" x-gloss="they.will.be.sweet" x-translit="māṯəqû-" xml:lang="hbo">מָֽתְקוּ</char>־<char style="w" x-id="WLC.JOB.21.33.002" x-align="JOB.21.33.a002" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">ל֗</char><char style="w" x-id="WLC.JOB.21.33.003" x-align="JOB.21.33.a003" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.21.33.004" x-align="JOB.21.33.a004" x-target-ids="t001 t002" x-target="The clods" x-target-head="t002" x-head="true" lemma="רֶגֶב" strong="H7263" x-morph="Ncmpc" x-gloss="[the].clods" x-translit="riḡḇēy" xml:lang="hbo">רִגְבֵ֫י</char> <char style="w" x-id="WLC.JOB.21.33.005" x-align="JOB.21.33.a005" x-target-ids="t003 t004 t005" x-target="of the valley" x-target-head="t005" x-head="true" lemma="נַחַל" strong="H5158" x-morph="Ncmsa" x-gloss="of.[the].wadi" x-translit="nāḥal" xml:lang="hbo">נָ֥חַל</char> <char style="w" x-id="WLC.JOB.21.33.006" x-align="JOB.21.33.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.JOB.21.33.007" x-align="JOB.21.33.a007" x-target-ids="t016" x-target="after" x-target-head="t016" x-head="true" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="after" x-translit="ʾaḥărāy" xml:lang="hbo">אַחֲרָי</char><char style="w" x-id="WLC.JOB.21.33.008" x-align="JOB.21.33.a008" x-target-ids="t017" x-target="him" x-target-head="t017" x-head="true" lemma="הוּא" strong="H2