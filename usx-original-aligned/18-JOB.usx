	<para style="p"><verse number="5" style="v" x-ref="JOB.21.5" x-added-alignments="JOB.21.5.a008 JOB.21.5.a011" x-added-target-ids="t008 t011" x-added-target="your | your" sid="JOB 21:5" /><char style="w" x-id="WLC.JOB.21.5.001" x-align="JOB.21.5.a001" x-target-ids="t001" x-target="Mark" x-target-head="t001" x-head="true" lemma="פָּנָה" strong="H6437" x-morph="Vqv2mp" x-gloss="turn" x-translit="pənû-" xml:lang="hbo">פְּנוּ</char>־<char style="w" x-id="WLC.JOB.21.5.002" x-align="JOB.21.5.a002" x-status="unrepresented" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלַ֥</char><char style="w" x-id="WLC.JOB.21.5.003" x-align="JOB.21.5.a003" x-target-ids="t002" x-target="me" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.21.5.004" x-align="JOB.21.5.a004" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.21.5.005" x-align="JOB.21.5.a005" x-target-ids="t004 t005" x-target="be astonished" x-target-head="t005" x-head="true" lemma="שָׁמֵם" strong="H8074" x-morph="Vhv2mp" x-gloss="be.appalled" x-translit="hāšammû" xml:lang="hbo">הָשַׁ֑מּוּ</char> <char style="w" x-id="WLC.JOB.21.5.006" x-align="JOB.21.5.a006" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.21.5.007" x-align="JOB.21.5.a007" x-target-ids="t007" x-target="lay" x-target-head="t007" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqv2mp" x-gloss="put" x-translit="śiymû" xml:lang="hbo">שִׂ֖ימוּ</char> <char style="w" x-id="WLC.JOB.21.5.008" x-align="JOB.21.5.a009" x-target-ids="t009" x-target="hand" x-target-head="t009" x-head="true" lemma="יָד" strong="H3027" x-morph