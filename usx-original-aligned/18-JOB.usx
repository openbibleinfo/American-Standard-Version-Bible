	<para style="p"><verse number="3" style="v" x-ref="JOB.9.3" sid="JOB 9:3" /><char style="w" x-id="WLC.JOB.9.3.001" x-align="JOB.9.3.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.9.3.002" x-align="JOB.9.3.a002" x-target-ids="t002 t003 t004" x-target="he be pleased" x-target-head="t004" x-head="true" lemma="חָפֵץ" strong="H2654" x-morph="Vqi3ms" x-gloss="someone.desires" x-translit="yaḥpōṣ" xml:lang="hbo">יַ֭חְפֹּץ</char> <char style="w" x-id="WLC.JOB.9.3.003" x-align="JOB.9.3.a003" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.9.3.004" x-align="JOB.9.3.a004" x-target-ids="t006" x-target="contend" x-target-head="t006" x-head="true" lemma="רִיב" strong="H7378" x-morph="Vqc" x-gloss="conduct.a.case" x-translit="riyḇ" xml:lang="hbo">רִ֣יב</char> <char style="w" x-id="WLC.JOB.9.3.005" x-align="JOB.9.3.a005" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿimm" xml:lang="hbo">עִמּ֑</char><char style="w" x-id="WLC.JOB.9.3.006" x-align="JOB.9.3.a006" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.9.3.007" x-align="JOB.9.3.a007" x-target-ids="t010" x-target="cannot" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.9.3.008" x-align="JOB.9.3.a008" x-target-ids="t009 t011" x-target="He answer" x-target-head="t011" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi3ms" x-gloss="he" x-translit="yaʿăn" xml:lang="hbo">יַ֝עֲנֶ֗</char><