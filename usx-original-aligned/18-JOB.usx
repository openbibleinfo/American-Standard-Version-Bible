	<para style="p"><verse number="15" style="v" x-ref="JOB.10.15" x-added-alignments="JOB.10.15.a008" x-added-target-ids="t013" x-added-target="yet" sid="JOB 10:15" /><char style="w" x-id="WLC.JOB.10.15.001" x-align="JOB.10.15.a001" x-target-ids="t001 t009" x-target="If if" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.10.15.002" x-align="JOB.10.15.a002" x-target-ids="t002 t003 t004" x-target="I be wicked" x-target-head="t004" x-head="true" lemma="רָשַׁע" strong="H7561" x-morph="Vqp1cs" x-gloss="I.am.guilty" x-translit="rāšaʿətî" xml:lang="hbo">רָשַׁ֡עְתִּי</char> <char style="w" x-id="WLC.JOB.10.15.003" x-align="JOB.10.15.a003" x-target-ids="t005" x-target="woe" x-target-head="t005" x-head="true" lemma="אַלְלַי" strong="H480" x-morph="Tj" x-gloss="woe!" x-translit="ʾaləlay" xml:lang="hbo">אַלְלַ֬י</char> <char style="w" x-id="WLC.JOB.10.15.004" x-align="JOB.10.15.a004" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֗</char><char style="w" x-id="WLC.JOB.10.15.005" x-align="JOB.10.15.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.10.15.006" x-align="JOB.10.15.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.JOB.10.15.007" x-align="JOB.10.15.a007" x-target-ids="t010 t011 t012" x-target="I be righteous" x-target-head="t012" x-head="true" lemma="צָדֵק" strong="H6663" x-morph="Vqq1cs" x-gloss="I.have.been.righteous" x-translit="ṣāḏaqtî" xml:lang="hbo">צָדַקְתִּי</char> <char style="w" x-id="WLC.JOB.10.15.008" x-align="JOB.10.15.a009" x-target-ids="t016" x-ta