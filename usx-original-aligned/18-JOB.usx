	<para style="p"><verse number="21" style="v" x-ref="JOB.30.21" sid="JOB 30:21" /><char style="w" x-id="WLC.JOB.30.21.001" x-align="JOB.30.21.a001" x-target-ids="t001 t002 t003" x-target="Thou art turned" x-target-head="t003" x-head="true" lemma="הָפַךְ" strong="H2015" x-morph="VNi2ms" x-gloss="you.change.yourself" x-translit="tēhāp̄ēḵ" xml:lang="hbo">תֵּהָפֵ֣ךְ</char> <char style="w" x-id="WLC.JOB.30.21.002" x-align="JOB.30.21.a002" x-target-ids="t004 t005" x-target="to be" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="into.[one]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.30.21.003" x-align="JOB.30.21.a003" x-target-ids="t006" x-target="cruel" x-target-head="t006" x-head="true" lemma="אַכְזָר" strong="H393" x-morph="Aamsa" x-gloss="cruel" x-translit="ʾaḵzār" xml:lang="hbo">אַכְזָ֣ר</char> <char style="w" x-id="WLC.JOB.30.21.004" x-align="JOB.30.21.a004" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֑</char><char style="w" x-id="WLC.JOB.30.21.005" x-align="JOB.30.21.a005" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.30.21.006" x-align="JOB.30.21.a006" x-target-ids="t009" x-target="With" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.30.21.007" x-align="JOB.30.21.a007" x-target-ids="t010 t011" x-target="the might" x-target-head="t011" x-head="true" lemma="עֹצֶם" strong="H6108" x-morph="Ncmsc" x-gloss="the.might" x-translit="ʿōṣem" xml:lang="hbo">עֹ֖צֶם</char> <char style="w" x-id="WLC.JOB.30.21.008" x-align="JOB.30.21.a008" x-target-ids="t012 t014" x-target="of hand" x-target-head="t014" x-head="true" lemma="יָד" strong="H3027" x-morph="N