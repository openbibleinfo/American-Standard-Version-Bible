	<para style="p"><verse number="9" style="v" x-ref="JOB.8.9" sid="JOB 8:9" /><char style="w" x-id="WLC.JOB.8.9.001" x-align="JOB.8.9.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.8.9.002" x-align="JOB.8.9.a003" x-target-ids="t003 t004 t005 t006" x-target="are but of yesterday" x-target-head="t006" x-head="true" lemma="תְּמוֹל" strong="H8543" x-morph="D" x-gloss="[are].yesterday" x-translit="ṯəmôl" xml:lang="hbo">תְמ֣וֹל</char> <char style="w" x-id="WLC.JOB.8.9.003" x-align="JOB.8.9.a002" x-target-ids="t002" x-target="we" x-target-head="t002" x-head="true" lemma="אֲנַחְנוּ" strong="H587" x-morph="Pp1cp" x-gloss="we" x-translit="ʾănaḥnû" xml:lang="hbo">אֲ֭נַחְנוּ</char> <char style="w" x-id="WLC.JOB.8.9.004" x-align="JOB.8.9.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.8.9.005" x-align="JOB.8.9.a006" x-target-ids="t009" x-target="nothing" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.8.9.006" x-align="JOB.8.9.a005" x-target-ids="t008" x-target="know" x-target-head="t008" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqi1cp" x-gloss="we.know" x-translit="nēḏāʿ" xml:lang="hbo">נֵדָ֑ע</char> <char style="w" x-id="WLC.JOB.8.9.007" x-align="JOB.8.9.a007" x-target-ids="t010" x-target="Because" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JOB.8.9.008" x-align="JOB.8.9.a012" x-target-ids="t015 t016 t017" x-target="are a shadow" x-target-head="t017" x-head="true" lemma="צֵל" strong="H6738" x-morph="Ncmsa" x-gloss="[are].a.shadow" x-t