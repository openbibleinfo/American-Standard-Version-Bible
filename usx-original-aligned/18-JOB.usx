	<para style="p"><verse number="18" style="v" x-ref="JOB.5.18" sid="JOB 5:18" /><char style="w" x-id="WLC.JOB.5.18.001" x-align="JOB.5.18.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JOB.5.18.002" x-align="JOB.5.18.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֣וּא</char> <char style="w" x-id="WLC.JOB.5.18.003" x-align="JOB.5.18.a003" x-target-ids="t003 t004" x-target="maketh sore" x-target-head="t004" x-head="true" lemma="כָּאַב" strong="H3510" x-morph="Vhi3ms" x-gloss="he.causes.pain" x-translit="yaḵʾiyḇ" xml:lang="hbo">יַכְאִ֣יב</char> <char style="w" x-id="WLC.JOB.5.18.004" x-align="JOB.5.18.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.5.18.005" x-align="JOB.5.18.a005" x-target-ids="t006 t007" x-target="bindeth up" x-target-head="t006" x-head="true" lemma="חָבַשׁ" strong="H2280" x-morph="Vqi3ms" x-gloss="he.binds.up" x-translit="yeḥbāš" xml:lang="hbo">יֶחְבָּ֑שׁ</char> <char style="w" x-id="WLC.JOB.5.18.006" x-align="JOB.5.18.a006" x-target-ids="t008 t009" x-target="He woundeth" x-target-head="t009" x-head="true" lemma="מָחַץ" strong="H4272" x-morph="Vqi3ms" x-gloss="he.smashes" x-translit="yimḥaṣ" xml:lang="hbo">יִ֝מְחַ֗ץ</char> <char style="w" x-id="WLC.JOB.5.18.007" x-align="JOB.5.18.a007" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.5.18.008" x-align="JOB.5.18.a008" x-target-ids="t012" x-target="hands" x-target-head="t012" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbdc" x-gloss="h