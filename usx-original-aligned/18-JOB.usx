	<para style="p"><verse number="18" style="v" x-ref="JOB.8.18" x-added-alignments="JOB.8.18.a011" x-added-target-ids="t013" x-added-target="saying" sid="JOB 8:18" /><char style="w" x-id="WLC.JOB.8.18.001" x-align="JOB.8.18.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.8.18.002" x-align="JOB.8.18.a003" x-target-ids="t003 t004" x-target="be destroyed" x-target-head="t004" x-head="true" lemma="בָּלַע" strong="H1104" x-morph="Vpi3ms" x-gloss="someone" x-translit="yəḇalləʿ" xml:lang="hbo">יְבַלְּעֶ֥</char><char style="w" x-id="WLC.JOB.8.18.003" x-align="JOB.8.18.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="will.swallow.it" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.JOB.8.18.004" x-align="JOB.8.18.a004" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.8.18.005" x-align="JOB.8.18.a006" x-target-ids="t007" x-target="place" x-target-head="t007" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsc" x-gloss="place" x-translit="mməqôm" xml:lang="hbo">מְּקוֹמ֑</char><char style="w" x-id="WLC.JOB.8.18.006" x-align="JOB.8.18.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.8.18.007" x-align="JOB.8.18.a007" x-target-ids="t008" x-target="Then" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.8.18.008" x-align="JOB.8.18.a008" x-target-ids="t009 t010 t011" x-target="it shall deny" x-target-head="t011" x-head="true"