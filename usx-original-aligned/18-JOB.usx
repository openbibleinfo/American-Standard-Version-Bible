	<para style="p"><verse number="20" style="v" x-ref="JOB.8.20" sid="JOB 8:20" /><char style="w" x-id="WLC.JOB.8.20.001" x-align="JOB.8.20.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tj" x-gloss="there!" x-translit="hen-" xml:lang="hbo">הֶן</char>־<char style="w" x-id="WLC.JOB.8.20.002" x-align="JOB.8.20.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֭ל</char> <char style="w" x-id="WLC.JOB.8.20.003" x-align="JOB.8.20.a004" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.8.20.004" x-align="JOB.8.20.a003" x-target-ids="t003 t005 t006" x-target="will cast away" x-target-head="t005" x-head="true" lemma="מָאַס" strong="H3988" x-morph="Vqi3ms" x-gloss="he.rejects" x-translit="yimʾas-" xml:lang="hbo">יִמְאַס</char>־<char style="w" x-id="WLC.JOB.8.20.005" x-align="JOB.8.20.a005" x-target-ids="t007 t008 t009" x-target="a perfect man" x-target-head="t008" x-head="true" lemma="תָּם" strong="H8535" x-morph="Aamsa" x-gloss="a.blameless.[person]" x-translit="tām" xml:lang="hbo">תָּ֑ם</char> <char style="w" x-id="WLC.JOB.8.20.006" x-align="JOB.8.20.a006" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.8.20.007" x-align="JOB.8.20.a006" x-status="noncompositional" x-target-ids="t010" x-target="Neither" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.8.20.008" x-align="JOB.8.20.a007" x-target-ids="t011 t012 t013" x-target="will he uphold" x-target-head="t013" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vhi3ms" x-gloss="he.takes.