	<para style="p"><verse number="19" style="v" x-ref="JOB.37.19" x-added-alignments="JOB.37.19.a007 JOB.37.19.a010" x-added-target-ids="t009 t013 t014" x-added-target="For | our speech" sid="JOB 37:19" /><char style="w" x-id="WLC.JOB.37.19.001" x-align="JOB.37.19.a001" x-target-ids="t001" x-target="Teach" x-target-head="t001" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vhv2ms" x-gloss="make" x-translit="hôḏiyʿ" xml:lang="hbo">ה֭וֹדִיעֵ</char><char style="w" x-id="WLC.JOB.37.19.002" x-align="JOB.37.19.a002" x-target-ids="t002" x-target="us" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="known.to.us" x-translit="ēnû" xml:lang="hbo">נוּ</char><char style="w" x-id="WLC.JOB.37.19.003" x-align="JOB.37.19.a003" x-target-ids="t003" x-target="what" x-target-head="t003" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JOB.37.19.004" x-align="JOB.37.19.a004" x-target-ids="t004 t005 t006" x-target="we shall say" x-target-head="t006" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi1cp" x-gloss="will.we.say" x-translit="nnōʾmar" xml:lang="hbo">נֹּ֣אמַר</char> <char style="w" x-id="WLC.JOB.37.19.005" x-align="JOB.37.19.a005" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.JOB.37.19.006" x-align="JOB.37.19.a006" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.37.19.007" x-align="JOB.37.19.a008" x-target-ids="t011" x-target="cannot" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹ֥א</char>־<char style="w" x-id="WLC.JOB.37.19.008" x-align="JOB.37.19.a009" x-target-ids="t010 t012 t