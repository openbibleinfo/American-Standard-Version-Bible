	<para style="p"><verse number="2" style="v" x-ref="JOB.24.2" x-added-alignments="JOB.24.2.a001 JOB.24.2.a008" x-added-target-ids="t001 t002 t003 t014" x-added-target="There are that | them" sid="JOB 24:2" /><char style="w" x-id="WLC.JOB.24.2.001" x-align="JOB.24.2.a002" x-target-ids="t005 t006" x-target="the landmarks" x-target-head="t006" x-head="true" lemma="גְּבוּלָה" strong="H1367" x-morph="Ncfpa" x-gloss="borders" x-translit="gəḇulôṯ" xml:lang="hbo">גְּבֻל֥וֹת</char> <char style="w" x-id="WLC.JOB.24.2.002" x-align="JOB.24.2.a003" x-target-ids="t004" x-target="remove" x-target-head="t004" x-head="true" lemma="סוג" strong="H5381" x-morph="Vhi3mp" x-gloss="people.reach" x-translit="yaśśiyḡû" xml:lang="hbo">יַשִּׂ֑יגוּ</char> <char style="w" x-id="WLC.JOB.24.2.003" x-align="JOB.24.2.a004" x-target-ids="t011" x-target="flocks" x-target-head="t011" x-head="true" lemma="עֵדֶר" strong="H5739" x-morph="Ncmsa" x-gloss="flock[s]" x-translit="ʿēḏer" xml:lang="hbo">עֵ֥דֶר</char> <char style="w" x-id="WLC.JOB.24.2.004" x-align="JOB.24.2.a005" x-target-ids="t007 t008 t009 t010" x-target="They violently take away" x-target-head="t009" x-head="true" lemma="גָּזַל" strong="H1497" x-morph="Vqp3cp" x-gloss="they.seize" x-translit="gāzəlû" xml:lang="hbo">גָּ֝זְל֗וּ</char> <char style="w" x-id="WLC.JOB.24.2.005" x-align="JOB.24.2.a006" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.24.2.006" x-align="JOB.24.2.a007" x-target-ids="t013" x-target="feed" x-target-head="t013" x-head="true" lemma="רָעָה" strong="H7462" x-morph="Vqw3mp" x-gloss="they.have.pastured.[them]" x-translit="yyirʿû:" xml:lang="hbo">יִּרְעֽוּ</char>׃<verse eid="JOB 24:2" /></para>
	<para style="p"><verse number="3" style="v" x-ref="JOB.24.3" sid="JOB 24:3" /><char style="w" x-id="WLC.JOB.24.3.001" x-align="JOB.24.3.a001" x-target-ids="t004 t005" x-target="the ass" x-target-head="t005" x-head="true" lemma="חֲמוֹר" strong="H2543" x-morph="Ncbsc" x-gloss="[the].donkey" x-translit="ḥămôr" xml:lang="hbo">חֲמ֣וֹר</char> <char style="w" x-id="WLC.JOB.24.3.002" x-align="JOB.24.3.a002" x-target-ids="t006 t007 t008" x-target="of the fatherless" x-target-head="t008" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmpa" x-gloss="of.fatherless.ones" x-translit="yəṯômiym" xml:lang="hbo">יְתוֹמִ֣ים</char> <char style="w" x-id="WLC.JOB.24.3.003" x-align="JOB.24.3.a003" x-target-ids="t001 t002 t003" x-target="They drive away" x-target-head="t002" x-head="true" lemma="נָהַג" strong="H5090" x-morph="Vqi3mp" x-gloss="they.drive.away" x-translit="yinhāḡû" xml:lang="hbo">יִנְהָ֑גוּ</char> <char style="w" x-id="WLC.JOB.24.3.004" x-align="JOB.24.3.a004" x-target-ids="t009 t010 t014 t015 t016" x-target="They take for a pledge" x-target-head="t016" x-head="true" lemma="חָבַל" strong="H2254" x-morph="Vqi3mp" x-gloss="they.take.as.pledge" x-translit="yaḥbəlû" xml:lang="hbo">יַ֝חְבְּל֗וּ</char> <char style="w" x-id="WLC.JOB.24.3.005" x-align="JOB.24.3.a005" x-target-ids="t013" x-target="ox" x-target-head="t013" x-head="true" lemma="שׁוֹר" strong="H7794" x-morph="Ncmsc" x-gloss="[the].ox" x-translit="šôr" xml:lang="hbo">שׁ֣וֹר</char> <char style="w" x-id="WLC.JOB.24.3.006" x-align="JOB.24.3.a006" x-target-ids="t011 t012" x-target="the widow’s" x-target-head="t012" x-head="true" lemma="אַלְמָנָה" strong="H490" x-morph="Ncfsa" x-gloss="of.a.widow" x-translit="ʾalmānāh:" xml:lang="hbo">אַלְמָנָֽה</char>׃<verse eid="JOB 24:3" /></para>
