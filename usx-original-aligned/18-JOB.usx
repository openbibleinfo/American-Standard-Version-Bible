	<para style="p"><verse number="7" style="v" x-ref="JOB.10.7" sid="JOB 10:7" /><char style="w" x-id="WLC.JOB.10.7.001" x-align="JOB.10.7.a001" x-target-ids="t001" x-target="Although" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַֽל</char>־<char style="w" x-id="WLC.JOB.10.7.002" x-align="JOB.10.7.a002" x-target-ids="t003" x-target="knowest" x-target-head="t003" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsc" x-gloss="knowledge" x-translit="daʿt" xml:lang="hbo">דַּ֭עְתְּ</char><char style="w" x-id="WLC.JOB.10.7.003" x-align="JOB.10.7.a003" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.10.7.004" x-align="JOB.10.7.a004" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.10.7.005" x-align="JOB.10.7.a005" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.10.7.006" x-align="JOB.10.7.a006" x-target-ids="t005 t006 t008" x-target="I am wicked" x-target-head="t008" x-head="true" lemma="רָשַׁע" strong="H7561" x-morph="Vqi1cs" x-gloss="I.am.guilty" x-translit="ʾeršāʿ" xml:lang="hbo">אֶרְשָׁ֑ע</char> <char style="w" x-id="WLC.JOB.10.7.007" x-align="JOB.10.7.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.10.7.008" x-align="JOB.10.7.a008" x-target-ids="t010 t011 t012" x-target="there is none" x-target-head="t012" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-tr