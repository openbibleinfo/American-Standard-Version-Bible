	<para style="p"><verse number="12" style="v" x-ref="JOB.10.12" sid="JOB 10:12" /><char style="w" x-id="WLC.JOB.10.12.001" x-align="JOB.10.12.a001" x-target-ids="t005" x-target="life" x-target-head="t005" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֣ים</char> <char style="w" x-id="WLC.JOB.10.12.002" x-align="JOB.10.12.a002" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ֭</char><char style="w" x-id="WLC.JOB.10.12.003" x-align="JOB.10.12.a003" x-target-ids="t007" x-target="lovingkindness" x-target-head="t007" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsa" x-gloss="loyalty" x-translit="ḥeseḏ" xml:lang="hbo">חֶסֶד</char> <char style="w" x-id="WLC.JOB.10.12.004" x-align="JOB.10.12.a004" x-target-ids="t001 t002 t003" x-target="Thou hast granted" x-target-head="t003" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp2ms" x-gloss="you.have.done" x-translit="ʿāśiyṯā" xml:lang="hbo">עָשִׂ֣יתָ</char> <char style="w" x-id="WLC.JOB.10.12.005" x-align="JOB.10.12.a005" x-status="unrepresented" x-head="true" lemma="עִמָּד" strong="H5978" x-morph="R" x-gloss="with" x-translit="ʿimmāḏ" xml:lang="hbo">עִמָּדִ֑</char><char style="w" x-id="WLC.JOB.10.12.006" x-align="JOB.10.12.a006" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.10.12.007" x-align="JOB.10.12.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.JOB.10.12.008" x-align="JOB.10.12.a008" x-target-ids="t010" x-target="visitation" x-target-head="t010" x-head="true" lemma="פְּקֻדָּה" strong="H6486" x-morph="Ncfsc" x-gloss="care" x-translit="p̄ə