	<para style="p"><verse number="1" style="v" x-ref="JOB.14.1" sid="JOB 14:1" /><char style="w" x-id="WLC.JOB.14.1.001" x-align="JOB.14.1.a001" x-target-ids="t001" x-target="Man" x-target-head="t001" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="a.human.being" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.JOB.14.1.002" x-align="JOB.14.1.a002" x-target-ids="t002 t003 t004" x-target="that is born" x-target-head="t004" x-head="true" lemma="יָלַד" strong="H3205" x-morph="Vqsmsc" x-gloss="born" x-translit="yəlûḏ" xml:lang="hbo">יְל֣וּד</char> <char style="w" x-id="WLC.JOB.14.1.003" x-align="JOB.14.1.a003" x-target-ids="t005 t006 t007" x-target="of a woman" x-target-head="t007" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsa" x-gloss="of.a.woman" x-translit="ʾiššāh" xml:lang="hbo">אִשָּׁ֑ה</char> <char style="w" x-id="WLC.JOB.14.1.004" x-align="JOB.14.1.a004" x-target-ids="t008 t010" x-target="Is few" x-target-head="t010" x-head="true" lemma="קָצֵר" strong="H7116" x-morph="Aamsc" x-gloss="[is].short" x-translit="qəṣar" xml:lang="hbo">קְצַ֥ר</char> <char style="w" x-id="WLC.JOB.14.1.005" x-align="JOB.14.1.a005" x-target-ids="t009 t011" x-target="of days" x-target-head="t011" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="of.days" x-translit="yāmiym" xml:lang="hbo">יָ֝מִ֗ים</char> <char style="w" x-id="WLC.JOB.14.1.006" x-align="JOB.14.1.a006" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.JOB.14.1.007" x-align="JOB.14.1.a007" x-target-ids="t013" x-target="full" x-target-head="t013" x-head="true" lemma="שָׂבֵעַ" strong="H7649" x-morph="Aamsc" x-gloss="surfeited" x-translit="śəḇaʿ-" xml:lang="hbo">שְׂבַֽע</char>־<char style="w" x-id="WLC.JOB.14.1.008" x-align="JOB.14.1.a008" x-target-ids="t014 t015" x-target="of trouble" x-target-head="t015" x-head="true" le