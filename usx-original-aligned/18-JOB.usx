	<para style="p"><verse number="22" style="v" x-ref="JOB.20.22" sid="JOB 20:22" /><char style="w" x-id="WLC.JOB.20.22.001" x-align="JOB.20.22.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.JOB.20.22.002" x-align="JOB.20.22.a002" x-target-ids="t002 t003" x-target="the fulness" x-target-head="t003" x-head="true" lemma="מָלֵא" strong="H4390" x-morph="Vqc" x-gloss="is.full" x-translit="məlōʾwṯ" xml:lang="hbo">מְלֹ֣אות</char> <char style="w" x-id="WLC.JOB.20.22.003" x-align="JOB.20.22.a003" x-target-ids="t004 t006" x-target="of sufficiency" x-target-head="t006" x-head="true" lemma="שֵׂפֶק" strong="H8230b" x-morph="Ncmsc" x-gloss="sufficiency" x-translit="śip̄q" xml:lang="hbo">שִׂ֭פְק</char><char style="w" x-id="WLC.JOB.20.22.004" x-align="JOB.20.22.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.20.22.005" x-align="JOB.20.22.a005" x-target-ids="t008 t009 t010 t011" x-target="shall be in straits" x-target-head="t011" x-head="true" lemma="צרר" strong="H6887" x-morph="Vqi3ms" x-gloss="it.will.be.distress" x-translit="yēṣer" xml:lang="hbo">יֵ֣צֶר</char> <char style="w" x-id="WLC.JOB.20.22.006" x-align="JOB.20.22.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.JOB.20.22.007" x-align="JOB.20.22.a007" x-target-ids="t007" x-target="he" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.20.22.008" x-align="JOB.20.22.a008" x-target-ids="t015" x-target="every" x-target-head="t015" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-tra