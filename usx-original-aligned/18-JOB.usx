	<para style="p"><verse number="13" style="v" x-ref="JOB.13.13" sid="JOB 13:13" /><char style="w" x-id="WLC.JOB.13.13.001" x-align="JOB.13.13.a001" x-target-ids="t001 t002 t003" x-target="Hold your peace" x-target-head="t003" x-head="true" lemma="חָרֵשׁ" strong="H2790a" x-morph="Vhv2mp" x-gloss="be.silent" x-translit="haḥăriyšû" xml:lang="hbo">הַחֲרִ֣ישׁוּ</char> <char style="w" x-id="WLC.JOB.13.13.002" x-align="JOB.13.13.a002" x-target-ids="t004 t006" x-target="let alone" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" xml:lang="hbo">מִ֭מֶּ</char><char style="w" x-id="WLC.JOB.13.13.003" x-align="JOB.13.13.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="enniy" xml:lang="hbo">נִּי</char> <char style="w" x-id="WLC.JOB.13.13.004" x-align="JOB.13.13.a004" x-target-ids="t007" x-target="that" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="so" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.13.13.005" x-align="JOB.13.13.a005" x-target-ids="t009 t010" x-target="may speak" x-target-head="t010" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vph1cs" x-gloss="that.I.may.speak" x-translit="ʾăḏabbərâ-" xml:lang="hbo">אֲדַבְּרָה</char>־<char style="w" x-id="WLC.JOB.13.13.006" x-align="JOB.13.13.a006" x-target-ids="t008" x-target="I" x-target-head="t008" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānî" xml:lang="hbo">אָ֑נִי</char> <char style="w" x-id="WLC.JOB.13.13.007" x-align="JOB.13.13.a007" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.13.13.008" x-align="JOB.13.13.a008" x-target-ids="t012 t013" x-target="let come" x-target-head="t013" x-head="true" lemma="עָבַר" strong="H5674" x