	<para style="p"><verse number="3" style="v" x-ref="JOB.27.3" sid="JOB 27:3" /><char style="w" x-id="WLC.JOB.27.3.001" x-align="JOB.27.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.27.3.002" x-align="JOB.27.3.a002" x-target-ids="t006" x-target="whole" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.JOB.27.3.003" x-align="JOB.27.3.a003" x-target-ids="t005" x-target="yet" x-target-head="t005" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="still" x-translit="ʿôḏ" xml:lang="hbo">ע֣וֹד</char> <char style="w" x-id="WLC.JOB.27.3.004" x-align="JOB.27.3.a004" x-target-ids="t003" x-target="life" x-target-head="t003" x-head="true" lemma="נְשָׁמָה" strong="H5397" x-morph="Ncfsc" x-gloss="breath" x-translit="nišmāṯ" xml:lang="hbo">נִשְׁמָתִ֣</char><char style="w" x-id="WLC.JOB.27.3.005" x-align="JOB.27.3.a005" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.27.3.006" x-align="JOB.27.3.a006" x-target-ids="t004 t007" x-target="is in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="ḇ" xml:lang="hbo">בִ֑</char><char style="w" x-id="WLC.JOB.27.3.007" x-align="JOB.27.3.a007" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.27.3.008" x-align="JOB.27.3.a008" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.27.3