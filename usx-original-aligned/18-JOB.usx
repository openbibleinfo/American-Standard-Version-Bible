	<para style="p"><verse number="19" style="v" x-ref="JOB.31.19" sid="JOB 31:19" /><char style="w" x-id="WLC.JOB.31.19.001" x-align="JOB.31.19.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.19.002" x-align="JOB.31.19.a002" x-target-ids="t002 t003 t004" x-target="I have seen" x-target-head="t004" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi1cs" x-gloss="I.saw" x-translit="ʾerʾeh" xml:lang="hbo">אֶרְאֶ֣ה</char> <char style="w" x-id="WLC.JOB.31.19.003" x-align="JOB.31.19.a003" x-target-ids="t005 t006" x-target="any perish" x-target-head="t006" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqrmsa" x-gloss="[one.who.was].perishing" x-translit="ʾôḇēḏ" xml:lang="hbo">א֭וֹבֵד</char><char style="w" x-id="WLC.JOB.31.19.004" x-align="JOB.31.19.a004" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.31.19.005" x-align="JOB.31.19.a005" x-target-ids="t008" x-target="want" x-target-head="t008" x-head="true" lemma="בְּלִי" strong="H1097" x-morph="Ncmsc" x-gloss="not" x-translit="bəliy" xml:lang="hbo">בְּלִ֣י</char> <char style="w" x-id="WLC.JOB.31.19.006" x-align="JOB.31.19.a006" x-target-ids="t009 t010" x-target="of clothing" x-target-head="t010" x-head="true" lemma="לְבוּשׁ" strong="H3830" x-morph="Ncmsa" x-gloss="clothing" x-translit="ləḇûš" xml:lang="hbo">לְב֑וּשׁ</char> <char style="w" x-id="WLC.JOB.31.19.007" x-align="JOB.31.19.a007" x-target-ids="t011 t012" x-target="Or that" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.31.19.008" x-align="JOB.31.19.a011" x-target-ids="t016" x-target="no" x-target-head="t016" x-head="true" lemma="אַיִן" strong="H369" x-morp