	<para style="p"><verse number="18" style="v" x-ref="JOB.15.18" x-added-alignments="JOB.15.18.a007" x-added-target-ids="t013" x-added-target="it" sid="JOB 15:18" /><char style="w" x-id="WLC.JOB.15.18.001" x-align="JOB.15.18.a001" x-target-ids="t001" x-target="Which" x-target-head="t001" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[that].which" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.JOB.15.18.002" x-align="JOB.15.18.a002" x-target-ids="t002 t003" x-target="wise men" x-target-head="t002" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֥ים</char> <char style="w" x-id="WLC.JOB.15.18.003" x-align="JOB.15.18.a003" x-target-ids="t004 t005" x-target="have told" x-target-head="t005" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhi3mp" x-gloss="they.have.told" x-translit="yaggiyḏû" xml:lang="hbo">יַגִּ֑ידוּ</char> <char style="w" x-id="WLC.JOB.15.18.004" x-align="JOB.15.18.a004" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.18.005" x-align="JOB.15.18.a005" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.JOB.15.18.006" x-align="JOB.15.18.a006" x-target-ids="t010 t012" x-target="have hid" x-target-head="t012" x-head="true" lemma="כָּחַד" strong="H3582" x-morph="Vpp3cp" x-gloss="they.have.hidden" x-translit="ḵiḥăḏû" xml:lang="hbo">כִֽ֝חֲד֗וּ</char> <char style="w" x-id="WLC.JOB.15.18.007" x-align="JOB.15.18.a008" x-target-ids="t006" x-target="From" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.JOB.15.18.008" x-align="JOB.15.18.a009" x-target-