	<para style="p"><verse number="20" style="v" x-ref="JOB.20.20" x-added-alignments="JOB.20.20.a007" x-added-target-ids="t012 t013" x-added-target="aught of" sid="JOB 20:20" /><char style="w" x-id="WLC.JOB.20.20.001" x-align="JOB.20.20.a001" x-target-ids="t001" x-target="Because" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char>׀<char style="w" x-id="WLC.JOB.20.20.002" x-align="JOB.20.20.a002" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.20.20.003" x-align="JOB.20.20.a003" x-target-ids="t002 t003" x-target="he knew" x-target-head="t003" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3ms" x-gloss="he.knows" x-translit="yāḏaʿ" xml:lang="hbo">יָדַ֣ע</char> <char style="w" x-id="WLC.JOB.20.20.004" x-align="JOB.20.20.a004" x-target-ids="t005" x-target="quietness" x-target-head="t005" x-head="true" lemma="שָׁלֵיו" strong="H7961" x-morph="Aamsa" x-gloss="ease" x-translit="šālēw" xml:lang="hbo">שָׁלֵ֣ו</char> <char style="w" x-id="WLC.JOB.20.20.005" x-align="JOB.20.20.a005" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.20.20.006" x-align="JOB.20.20.a005" x-target-ids="t006" x-target="within" x-target-head="t006" x-head="true" lemma="בֶּטֶן" strong="H990" x-morph="Ncfsc" x-gloss="belly" x-translit="ḇiṭn" xml:lang="hbo">בִטְנ֑</char><char style="w" x-id="WLC.JOB.20.20.007" x-align="JOB.20.20.a006" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.20.20.008" x-align="JOB.20.20.a008" x-target-ids="t015" x-target="wherein" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-tran