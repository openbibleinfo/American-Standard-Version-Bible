	<para style="p"><verse number="9" style="v" x-ref="JOB.10.9" sid="JOB 10:9" /><char style="w" x-id="WLC.JOB.10.9.001" x-align="JOB.10.9.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqv2ms" x-gloss="remember" x-translit="zəḵār-" xml:lang="hbo">זְכָר</char>־<char style="w" x-id="WLC.JOB.10.9.002" x-align="JOB.10.9.a002" x-target-ids="t002 t003 t004" x-target="I beseech thee" x-target-head="t003" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֭א</char> <char style="w" x-id="WLC.JOB.10.9.003" x-align="JOB.10.9.a003" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.10.9.004" x-align="JOB.10.9.a004" x-target-ids="t010" x-target="as" x-target-head="t010" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ḵa" xml:lang="hbo">כַ</char><char style="w" x-id="WLC.JOB.10.9.005" x-align="JOB.10.9.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.10.9.006" x-align="JOB.10.9.a006" x-target-ids="t011" x-target="clay" x-target-head="t011" x-head="true" lemma="חֹמֶר" strong="H2563b" x-morph="Ncmsa" x-gloss="clay" x-translit="ḥōmer" xml:lang="hbo">חֹ֣מֶר</char> <char style="w" x-id="WLC.JOB.10.9.007" x-align="JOB.10.9.a007" x-target-ids="t006 t007 t008" x-target="thou hast fashioned" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp2ms" x-gloss="you" x-translit="ʿăśiyṯā" xml:lang="hbo">עֲשִׂיתָ֑</char><char style="w" x-id="WLC.JOB.10.9.008" x-align="JOB.10.9.a008" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="made.me" x-translit="niy" xml:lang="hb