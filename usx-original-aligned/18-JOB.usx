	<para style="p"><verse number="3" style="v" x-ref="JOB.17.3" sid="JOB 17:3" /><char style="w" x-id="WLC.JOB.17.3.001" x-align="JOB.17.3.a001" x-target-ids="t001 t003 t004" x-target="Give a pledge" x-target-head="t004" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqv2ms" x-gloss="make" x-translit="śiym" xml:lang="hbo">שִֽׂימָ</char><char style="w" x-id="WLC.JOB.17.3.002" x-align="JOB.17.3.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh-" xml:lang="hbo">ה</char>־<char style="w" x-id="WLC.JOB.17.3.003" x-align="JOB.17.3.a003" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="נָא" strong="H4994" x-morph="Tj" x-gloss="please" x-translit="nnāʾ" xml:lang="hbo">נָּ֭א</char> <char style="w" x-id="WLC.JOB.17.3.004" x-align="JOB.17.3.a004" x-target-ids="t005 t006 t007" x-target="be surety for" x-target-head="t006" x-head="true" lemma="עָרַב" strong="H6148" x-morph="Vqv2ms" x-gloss="stand" x-translit="ʿārəḇ" xml:lang="hbo">עָרְבֵ֣</char><char style="w" x-id="WLC.JOB.17.3.005" x-align="JOB.17.3.a005" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="surety.for.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.17.3.006" x-align="JOB.17.3.a006" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿimm" xml:lang="hbo">עִמָּ֑</char><char style="w" x-id="WLC.JOB.17.3.007" x-align="JOB.17.3.a007" x-target-ids="t010" x-target="thyself" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="yourself" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.JOB.17.3.008" x-align="JOB.17.3.a008" x-target-ids="t011 t012 t013" x-target="Who is there" x-target-head="t011" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo">מִֽי</char> 