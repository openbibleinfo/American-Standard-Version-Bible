	<para style="p"><verse number="3" style="v" x-ref="JOB.19.3" x-added-alignments="JOB.19.3.a008" x-added-target-ids="t012" x-added-target="that" sid="JOB 19:3" /><char style="w" x-id="WLC.JOB.19.3.001" x-align="JOB.19.3.a001" x-target-ids="t001" x-target="These" x-target-head="t001" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֤ה</char> <char style="w" x-id="WLC.JOB.19.3.002" x-align="JOB.19.3.a002" x-target-ids="t002" x-target="ten" x-target-head="t002" x-head="true" lemma="עֶשֶׂר" strong="H6235" x-morph="Acfsa" x-gloss="ten" x-translit="ʿeśer" xml:lang="hbo">עֶ֣שֶׂר</char> <char style="w" x-id="WLC.JOB.19.3.003" x-align="JOB.19.3.a003" x-target-ids="t003" x-target="times" x-target-head="t003" x-head="true" lemma="פַּעַם" strong="H6471" x-morph="Ncfpa" x-gloss="times" x-translit="pəʿāmîm" xml:lang="hbo">פְּ֭עָמִים</char> <char style="w" x-id="WLC.JOB.19.3.004" x-align="JOB.19.3.a004" x-target-ids="t004 t005 t006" x-target="have ye reproached" x-target-head="t006" x-head="true" lemma="כָּלַם" strong="H3637" x-morph="Vhi2mp" x-gloss="you" x-translit="taḵliymû" xml:lang="hbo">תַּכְלִימ֑וּ</char><char style="w" x-id="WLC.JOB.19.3.005" x-align="JOB.19.3.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="have.insulted.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.19.3.006" x-align="JOB.19.3.a006" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.19.3.007" x-align="JOB.19.3.a007" x-target-ids="t008 t009 t011" x-target="Ye are ashamed" x-target-head="t011" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi2mp" x-gloss="you.have.been.ashamed" x-translit="ṯēḇōšû" xml:lang="hbo">תֵ֝בֹ֗שׁוּ</char> <char style="w" x-id="WLC.JOB.19.3.008" x-align="JOB.19.3.a009