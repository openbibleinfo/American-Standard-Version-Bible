	<para style="p"><verse number="4" style="v" x-ref="JOB.16.4" sid="JOB 16:4" /><char style="w" x-id="WLC.JOB.16.4.001" x-align="JOB.16.4.a001" x-target-ids="t002" x-target="also" x-target-head="t002" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam" xml:lang="hbo">גַּ֤ם</char>׀<char style="w" x-id="WLC.JOB.16.4.002" x-align="JOB.16.4.a002" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵî" xml:lang="hbo">אָנֹכִי֮</char> <char style="w" x-id="WLC.JOB.16.4.003" x-align="JOB.16.4.a003" x-target-ids="t005" x-target="as" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="k" xml:lang="hbo">כָּ</char><char style="w" x-id="WLC.JOB.16.4.004" x-align="JOB.16.4.a004" x-target-ids="t006" x-target="ye" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="āḵem" xml:lang="hbo">כֶ֪ם</char> <char style="w" x-id="WLC.JOB.16.4.005" x-align="JOB.16.4.a005" x-target-ids="t003 t004 t007" x-target="could speak do" x-target-head="t004" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vph1cs" x-gloss="I.will.speak" x-translit="ʾăḏabērâ" xml:lang="hbo">אֲדַ֫בֵּ֥רָה</char> <char style="w" x-id="WLC.JOB.16.4.006" x-align="JOB.16.4.a006" x-target-ids="t008" x-target="If" x-target-head="t008" x-head="true" lemma="לוּ" strong="H3863" x-morph="C" x-gloss="if" x-translit="lû-" xml:lang="hbo">ל֤וּ</char>־<char style="w" x-id="WLC.JOB.16.4.007" x-align="JOB.16.4.a007" x-target-ids="t011" x-target="were" x-target-head="t011" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="(there)" x-translit="yēš" xml:lang="hbo">יֵ֪שׁ</char> <char style="w" x-id="WLC.JOB.16.4.008" x-align="JOB.16.4.a008" x-target-ids="t010" x-target="soul" x-target-head="t010" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">