	<para style="p"><verse number="22" style="v" x-ref="JOB.8.22" sid="JOB 8:22" /><char style="w" x-id="WLC.JOB.8.22.001" x-align="JOB.8.22.a001" x-target-ids="t001 t002 t003" x-target="They that hate" x-target-head="t003" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmpc" x-gloss="[those" x-translit="śōnəʾey" xml:lang="hbo">שֹׂנְאֶ֥י</char><char style="w" x-id="WLC.JOB.8.22.002" x-align="JOB.8.22.a002" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="who].hate.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.8.22.003" x-align="JOB.8.22.a003" x-target-ids="t005 t006 t007" x-target="shall be clothed" x-target-head="t007" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqi3mp" x-gloss="they.will.be.clothed" x-translit="yilbəšû-" xml:lang="hbo">יִלְבְּשׁוּ</char>־<char style="w" x-id="WLC.JOB.8.22.004" x-align="JOB.8.22.a004" x-target-ids="t008 t009" x-target="with shame" x-target-head="t009" x-head="true" lemma="בֹּשֶׁת" strong="H1322" x-morph="Ncfsa" x-gloss="shame" x-translit="ḇōšeṯ" xml:lang="hbo">בֹ֑שֶׁת</char> <char style="w" x-id="WLC.JOB.8.22.005" x-align="JOB.8.22.a005" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.8.22.006" x-align="JOB.8.22.a006" x-target-ids="t011 t012" x-target="the tent" x-target-head="t012" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmsc" x-gloss="tent" x-translit="ʾōhel" xml:lang="hbo">אֹ֖הֶל</char> <char style="w" x-id="WLC.JOB.8.22.007" x-align="JOB.8.22.a007" x-target-ids="t013 t014 t015" x-target="of the wicked" x-target-head="t015" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.JOB.8.22.008" x-align="JOB.8.22.a008" x-target-ids="t016 t017