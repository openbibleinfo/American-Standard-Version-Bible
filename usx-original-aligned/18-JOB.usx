	<para style="p"><verse number="12" style="v" x-ref="JOB.27.12" x-added-alignments="JOB.27.12.a006" x-added-target-ids="t007" x-added-target="it" sid="JOB 27:12" /><char style="w" x-id="WLC.JOB.27.12.001" x-align="JOB.27.12.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn-" xml:lang="hbo">הֵן</char>־<char style="w" x-id="WLC.JOB.27.12.002" x-align="JOB.27.12.a002" x-target-ids="t003" x-target="ye" x-target-head="t003" x-head="true" lemma="אַתֶּם" strong="H859a" x-morph="Pp2mp" x-gloss="you" x-translit="ʾattem" xml:lang="hbo">אַתֶּ֣ם</char> <char style="w" x-id="WLC.JOB.27.12.003" x-align="JOB.27.12.a003" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.you" x-translit="kull" xml:lang="hbo">כֻּלְּ</char><char style="w" x-id="WLC.JOB.27.12.004" x-align="JOB.27.12.a004" x-target-ids="t004" x-target="yourselves" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="all" x-translit="əḵem" xml:lang="hbo">כֶ֣ם</char> <char style="w" x-id="WLC.JOB.27.12.005" x-align="JOB.27.12.a005" x-target-ids="t005 t006" x-target="have seen" x-target-head="t006" x-head="true" lemma="חָזָה" strong="H2372" x-morph="Vqp2mp" x-gloss="you.have.seen" x-translit="ḥăzîṯem" xml:lang="hbo">חֲזִיתֶ֑ם</char> <char style="w" x-id="WLC.JOB.27.12.006" x-align="JOB.27.12.a007" x-target-ids="t009" x-target="then" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.27.12.007" x-align="JOB.27.12.a008" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.27.12.008" x-align="JOB.27.12.a008" x-target-ids="t008" x-target="Why" x-target-head="t008" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ-" xml: