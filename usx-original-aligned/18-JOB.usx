	<para style="p"><verse number="16" style="v" x-ref="JOB.8.16" sid="JOB 8:16" /><char style="w" x-id="WLC.JOB.8.16.001" x-align="JOB.8.16.a002" x-target-ids="t002 t003" x-target="is green" x-target-head="t003" x-head="true" lemma="רָטֹב" strong="H7373" x-morph="Aamsa" x-gloss="[is].a.fresh.[plant]" x-translit="rāṭōḇ" xml:lang="hbo">רָטֹ֣ב</char> <char style="w" x-id="WLC.JOB.8.16.002" x-align="JOB.8.16.a001" x-target-ids="t001" x-target="He" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֭וּא</char><char style="w" x-id="WLC.JOB.8.16.003" x-align="JOB.8.16.a003" x-status="noncompositional" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.JOB.8.16.004" x-align="JOB.8.16.a003" x-status="noncompositional" x-target-ids="t004" x-target="before" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ənê-" xml:lang="hbo">פְנֵי</char>־<char style="w" x-id="WLC.JOB.8.16.005" x-align="JOB.8.16.a004" x-target-ids="t005 t006" x-target="the sun" x-target-head="t006" x-head="true" lemma="שֶׁמֶשׁ" strong="H8121" x-morph="Ncbsa" x-gloss="[the].sun" x-translit="šāmeš" xml:lang="hbo">שָׁ֑מֶשׁ</char> <char style="w" x-id="WLC.JOB.8.16.006" x-align="JOB.8.16.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.8.16.007" x-align="JOB.8.16.a009" x-target-ids="t012" x-target="over" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal" xml:lang="hbo">עַ֥ל</char> <char style="w" x-id="WLC.JOB.8.16.008" x-align="JOB.8.16.a011" x-target-ids="t014" x-target="garden" x-target-head="t014" x-head="true" lemma="גַּנָּה" strong="H1593" x-morph="Ncfsc" x-gloss="garden" x-translit="gannāṯ" xml:lang="hbo">גַּ֝נָּת֗</char