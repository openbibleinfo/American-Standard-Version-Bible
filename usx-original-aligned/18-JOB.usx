	<para style="p"><verse number="14" style="v" x-ref="JOB.11.14" sid="JOB 11:14" /><char style="w" x-id="WLC.JOB.11.14.001" x-align="JOB.11.14.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.11.14.002" x-align="JOB.11.14.a002" x-target-ids="t002" x-target="iniquity" x-target-head="t002" x-head="true" lemma="אָוֶן" strong="H205" x-morph="Ncmsa" x-gloss="wickedness" x-translit="ʾāwen" xml:lang="hbo">אָ֣וֶן</char> <char style="w" x-id="WLC.JOB.11.14.003" x-align="JOB.11.14.a003" x-target-ids="t003 t004" x-target="be in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.JOB.11.14.004" x-align="JOB.11.14.a004" x-target-ids="t006" x-target="hand" x-target-head="t006" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָדְ</char><char style="w" x-id="WLC.JOB.11.14.005" x-align="JOB.11.14.a005" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.11.14.006" x-align="JOB.11.14.a006" x-target-ids="t007 t009 t010" x-target="put far away" x-target-head="t009" x-head="true" lemma="רָחַק" strong="H7368" x-morph="Vhv2ms" x-gloss="put" x-translit="harḥiyq" xml:lang="hbo">הַרְחִיקֵ֑</char><char style="w" x-id="WLC.JOB.11.14.007" x-align="JOB.11.14.a007" x-target-ids="t008" x-target="it" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="it.far.away" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.JOB.11.14.008" x-align="JOB.11.14.a008" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə