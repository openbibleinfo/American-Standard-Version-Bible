	<para style="p"><verse number="28" style="v" x-ref="JOB.9.28" sid="JOB 9:28" /><char style="w" x-id="WLC.JOB.9.28.001" x-align="JOB.9.28.a001" x-target-ids="t001 t002 t003 t004" x-target="I am afraid of" x-target-head="t003" x-head="true" lemma="יָגֹר" strong="H3025" x-morph="Vqp1cs" x-gloss="I.am.afraid.of" x-translit="yāḡōrətî" xml:lang="hbo">יָגֹ֥רְתִּי</char> <char style="w" x-id="WLC.JOB.9.28.002" x-align="JOB.9.28.a002" x-target-ids="t005" x-target="all" x-target-head="t005" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.JOB.9.28.003" x-align="JOB.9.28.a003" x-target-ids="t007" x-target="sorrows" x-target-head="t007" x-head="true" lemma="עַצָּבָה" strong="H6094" x-morph="Ncfpc" x-gloss="pains" x-translit="ʿaṣṣəḇōṯ" xml:lang="hbo">עַצְּבֹתָ֑</char><char style="w" x-id="WLC.JOB.9.28.004" x-align="JOB.9.28.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.9.28.005" x-align="JOB.9.28.a005" x-target-ids="t008 t009" x-target="I know" x-target-head="t009" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿətî" xml:lang="hbo">יָ֝דַ֗עְתִּי</char> <char style="w" x-id="WLC.JOB.9.28.006" x-align="JOB.9.28.a006" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.9.28.007" x-align="JOB.9.28.a007" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.JOB.9.28.008" x-align="JOB.9.28.a008" x-target-ids="t011 t012 t014 t016" x-target="thou wilt hold innocent" x-target-head="t016" x-head="true" lemma="נ