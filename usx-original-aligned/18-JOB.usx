	<para style="p"><verse number="5" style="v" x-ref="JOB.25.5" sid="JOB 25:5" /><char style="w" x-id="WLC.JOB.25.5.001" x-align="JOB.25.5.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֣ן</char> <char style="w" x-id="WLC.JOB.25.5.002" x-align="JOB.25.5.a002" x-target-ids="t002" x-target="even" x-target-head="t002" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="up.to" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.JOB.25.5.003" x-align="JOB.25.5.a003" x-target-ids="t003 t004" x-target="the moon" x-target-head="t004" x-head="true" lemma="יָרֵחַ" strong="H3394" x-morph="Ncmsa" x-gloss="[the].moon" x-translit="yārēᵃḥ" xml:lang="hbo">יָ֭רֵחַ</char> <char style="w" x-id="WLC.JOB.25.5.004" x-align="JOB.25.5.a004" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.25.5.005" x-align="JOB.25.5.a005" x-target-ids="t006" x-target="no" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.25.5.006" x-align="JOB.25.5.a006" x-target-ids="t005 t007" x-target="hath brightness" x-target-head="t007" x-head="true" lemma="אָהַל" strong="H166" x-morph="Vhi3ms" x-gloss="it.is.clear" x-translit="yaʾăhiyl" xml:lang="hbo">יַאֲהִ֑יל</char> <char style="w" x-id="WLC.JOB.25.5.007" x-align="JOB.25.5.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.25.5.008" x-align="JOB.25.5.a008" x-target-ids="t009 t010" x-target="the stars" x-target-head="t010" x-head="true" lemma="כּוֹכָב" strong="H3556" x-morph="Ncmpa" x-gloss="stars" x-translit="ḵôḵāḇiym" xml:lang="hbo">כוֹכָבִ֗ים