	<para style="p"><verse number="27" style="v" x-ref="JOB.22.27" x-added-alignments="JOB.22.27.a002" x-added-target-ids="t004" x-added-target="thy" sid="JOB 22:27" /><char style="w" x-id="WLC.JOB.22.27.001" x-align="JOB.22.27.a001" x-target-ids="t001 t002 t003 t005" x-target="Thou shalt make prayer" x-target-head="t005" x-head="true" lemma="עָתַר" strong="H6279" x-morph="Vhi2ms" x-gloss="you.will.pray" x-translit="taʿtiyr" xml:lang="hbo">תַּעְתִּ֣יר</char> <char style="w" x-id="WLC.JOB.22.27.002" x-align="JOB.22.27.a003" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēlāy" xml:lang="hbo">אֵ֭לָי</char><char style="w" x-id="WLC.JOB.22.27.003" x-align="JOB.22.27.a004" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.22.27.004" x-align="JOB.22.27.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.22.27.005" x-align="JOB.22.27.a006" x-target-ids="t009 t010 t011" x-target="he will hear" x-target-head="t011" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi3ms" x-gloss="he" x-translit="yišmāʿ" xml:lang="hbo">יִשְׁמָעֶ֑</char><char style="w" x-id="WLC.JOB.22.27.006" x-align="JOB.22.27.a007" x-target-ids="t012" x-target="thee" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.hear.you" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.JOB.22.27.007" x-align="JOB.22.27.a008" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.22.27.008" x-align="JOB.22.27.a009" x-target-ids="t018" x-target="v