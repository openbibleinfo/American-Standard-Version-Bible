	<para style="p"><verse number="19" style="v" x-ref="JOB.20.19" x-added-alignments="JOB.20.19.a003" x-added-target-ids="t005" x-added-target="and" sid="JOB 20:19" /><char style="w" x-id="WLC.JOB.20.19.001" x-align="JOB.20.19.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.20.19.002" x-align="JOB.20.19.a002" x-target-ids="t002 t003 t004" x-target="he hath oppressed" x-target-head="t004" x-head="true" lemma="רָצַץ" strong="H7533" x-morph="Vpp3ms" x-gloss="he.has.crushed" x-translit="riṣṣaṣ" xml:lang="hbo">רִ֭צַּץ</char> <char style="w" x-id="WLC.JOB.20.19.003" x-align="JOB.20.19.a004" x-target-ids="t006" x-target="forsaken" x-target-head="t006" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqp3ms" x-gloss="he.has.neglected" x-translit="ʿāzaḇ" xml:lang="hbo">עָזַ֣ב</char> <char style="w" x-id="WLC.JOB.20.19.004" x-align="JOB.20.19.a005" x-target-ids="t007 t008" x-target="the poor" x-target-head="t008" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aampa" x-gloss="poor.[people]" x-translit="dalliym" xml:lang="hbo">דַּלִּ֑ים</char> <char style="w" x-id="WLC.JOB.20.19.005" x-align="JOB.20.19.a006" x-target-ids="t014 t015" x-target="a house" x-target-head="t015" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsa" x-gloss="a.house" x-translit="bayiṯ" xml:lang="hbo">בַּ֥יִת</char> <char style="w" x-id="WLC.JOB.20.19.006" x-align="JOB.20.19.a007" x-target-ids="t009 t010 t011 t012 t013" x-target="He hath violently taken away" x-target-head="t012" x-head="true" lemma="גָּזַל" strong="H1497" x-morph="Vqp3ms" x-gloss="he.has.seized" x-translit="gāzal" xml:lang="hbo">גָּ֝זַ֗ל</char> <char style="w" x-id="WLC.JOB.20.19.007" x-align="JOB.20.19.a008" x-target-ids="t016" x-target="and" x-target-head="t016" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char