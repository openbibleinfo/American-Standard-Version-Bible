	<para style="p"><verse number="31" style="v" x-ref="JOB.9.31" sid="JOB 9:31" /><char style="w" x-id="WLC.JOB.9.31.001" x-align="JOB.9.31.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֭ז</char> <char style="w" x-id="WLC.JOB.9.31.002" x-align="JOB.9.31.a002" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.JOB.9.31.003" x-align="JOB.9.31.a003" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.JOB.9.31.004" x-align="JOB.9.31.a004" x-target-ids="t008" x-target="ditch" x-target-head="t008" x-head="true" lemma="שַׁחַת" strong="H7845" x-morph="Ncfsa" x-gloss="pit" x-translit="ššaḥaṯ" xml:lang="hbo">שַּׁ֣חַת</char> <char style="w" x-id="WLC.JOB.9.31.005" x-align="JOB.9.31.a005" x-target-ids="t002 t003 t004" x-target="wilt thou plunge" x-target-head="t004" x-head="true" lemma="טָבַל" strong="H2881" x-morph="Vqi2ms" x-gloss="you" x-translit="tiṭbəl" xml:lang="hbo">תִּטְבְּלֵ֑</char><char style="w" x-id="WLC.JOB.9.31.006" x-align="JOB.9.31.a006" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.dip.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.9.31.007" x-align="JOB.9.31.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.9.31.008" x-align="JOB.9.31.a008" x-target-ids="t013 t014" x-target="shall abhor" x-target-head="t014" x-head="true" lemma="תַּעָב" strong="H8581" x-morph="Vpq3cp" x-gloss="they" x-translit="ṯiʿăḇû" xml:lang="