	<para style="p"><verse number="13" style="v" x-ref="JOB.10.13" sid="JOB 10:13" /><char style="w" x-id="WLC.JOB.10.13.001" x-align="JOB.10.13.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.JOB.10.13.002" x-align="JOB.10.13.a002" x-target-ids="t002 t003" x-target="these things" x-target-head="t002" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo">אֵלֶּה</char> <char style="w" x-id="WLC.JOB.10.13.003" x-align="JOB.10.13.a003" x-target-ids="t004 t005 t006" x-target="thou didst hide" x-target-head="t006" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqp2ms" x-gloss="you.hid" x-translit="ṣāp̄anətā" xml:lang="hbo">צָפַ֣נְתָּ</char> <char style="w" x-id="WLC.JOB.10.13.004" x-align="JOB.10.13.a004" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.JOB.10.13.005" x-align="JOB.10.13.a005" x-target-ids="t009" x-target="heart" x-target-head="t009" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsc" x-gloss="heart" x-translit="ləḇāḇ" xml:lang="hbo">לְבָבֶ֑</char><char style="w" x-id="WLC.JOB.10.13.006" x-align="JOB.10.13.a006" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.10.13.007" x-align="JOB.10.13.a007" x-target-ids="t010 t011" x-target="I know" x-target-head="t011" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿətî" xml:lang="hbo">יָ֝דַ֗עְתִּי</char> <char style="w" x-id="WLC.JOB.10.13.008" x-align="JOB.10.13.a008" x-target-ids="t012" x-target="that" x-target-head="t012" x-head="true" lemma="כִּי" strong="H3588" 