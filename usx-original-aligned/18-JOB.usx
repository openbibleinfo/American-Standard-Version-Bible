	<para style="p"><verse number="1" style="v" x-ref="JOB.19.1" sid="JOB 19:1" /><char style="w" x-id="WLC.JOB.19.1.001" x-align="JOB.19.1.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.19.1.002" x-align="JOB.19.1.a002" x-target-ids="t003" x-target="answered" x-target-head="t003" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw3ms" x-gloss="he.answered" x-translit="yyaʿan" xml:lang="hbo">יַּ֥עַן</char> <char style="w" x-id="WLC.JOB.19.1.003" x-align="JOB.19.1.a003" x-target-ids="t002" x-target="Job" x-target-head="t002" x-head="true" lemma="אִיּוֹב" strong="H347" x-morph="Np" x-gloss="Job" x-translit="ʾiyyôḇ" xml:lang="hbo">אִיּ֗וֹב</char> <char style="w" x-id="WLC.JOB.19.1.004" x-align="JOB.19.1.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.19.1.005" x-align="JOB.19.1.a005" x-target-ids="t005" x-target="said" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar:" xml:lang="hbo">יֹּאמַֽר</char>׃<verse eid="JOB 19:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="JOB.19.2" sid="JOB 19:2" /><char style="w" x-id="WLC.JOB.19.2.001" x-align="JOB.19.2.a001" x-status="noncompositional" x-target-ids="t001 t002" x-target="How long" x-target-head="t002" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.JOB.19.2.002" x-align="JOB.19.2.a001" x-status="noncompositional" lemma="אָן" strong="H575" x-morph="D" x-gloss="when?" x-translit="ʾānâ" xml:lang="hbo">אָ֭נָה</char> <char style="w" x-id="WLC.JOB.19.2.003" x-align="JOB.19.2.a002" x-target-ids="t003 t004 t005" x-target="will ye vex" x-target-head="t005" x-head="true" lemma="יָגָה" strong="H3013" x-morph="Vhi2mp" x-gloss="will" x-translit="tôḡəyû" xml:lang="hbo">תּוֹגְי֣וּ</char><char style="w" x-id="WLC.JOB.19.2.004" x-align="JOB.19.2.a003" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="you.grieve" x-translit="n" xml:lang="hbo">ן</char> <char style="w" x-id="WLC.JOB.19.2.005" x-align="JOB.19.2.a004" x-target-ids="t007" x-target="soul" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֑</char><char style="w" x-id="WLC.JOB.19.2.006" x-align="JOB.19.2.a005" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.19.2.007" x-align="JOB.19.2.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.JOB.19.2.008" x-align="JOB.19.2.a007" x-target-ids="t009 t011 t012" x-target="break in pieces" x-target-head="t009" x-head="true" lemma="דָּכָא" strong="H1792" x-morph="Vpi2mp" x-gloss="will" x-translit="ṯəḏakkəʾû" xml:lang="hbo">תְדַכְּאוּ</char><char style="w