	<para style="p"><verse number="24" style="v" x-ref="JOB.30.24" x-added-alignments="JOB.30.24.a006" x-added-target-ids="t010" x-added-target="his" sid="JOB 30:24" /><char style="w" x-id="WLC.JOB.30.24.001" x-align="JOB.30.24.a001" x-target-ids="t001" x-target="Howbeit" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ" xml:lang="hbo">אַ֣ךְ</char> <char style="w" x-id="WLC.JOB.30.24.002" x-align="JOB.30.24.a003" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.30.24.003" x-align="JOB.30.24.a005" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="ḇə" xml:lang="hbo">בְ֭</char><char style="w" x-id="WLC.JOB.30.24.004" x-align="JOB.30.24.a007" x-target-ids="t011" x-target="fall" x-target-head="t011" x-head="true" lemma="עִי" strong="H5856" x-morph="Ncmsa" x-gloss="a.heap.of.ruins" x-translit="ʿî" xml:lang="hbo">עִי</char> <char style="w" x-id="WLC.JOB.30.24.005" x-align="JOB.30.24.a002" x-target-ids="t002 t004 t005 t006" x-target="doth one stretch out" x-target-head="t005" x-head="true" lemma="שָׁלַח" strong="H7971" x-morph="Vqi3ms" x-gloss="anyone.stretches.out" x-translit="yišlaḥ-" xml:lang="hbo">יִשְׁלַח</char>־<char style="w" x-id="WLC.JOB.30.24.006" x-align="JOB.30.24.a004" x-target-ids="t007 t008" x-target="the hand" x-target-head="t008" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsa" x-gloss="a.hand" x-translit="yāḏ" xml:lang="hbo">יָ֑ד</char> <char style="w" x-id="WLC.JOB.30.24.007" x-align="JOB.30.24.a008" x-target-ids="t012" x-target="Or" x-target-head="t012" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="or" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.30.24.008" x-align="JOB.30.24.a009" x-target-ids="t013" x-target="in" x-tar