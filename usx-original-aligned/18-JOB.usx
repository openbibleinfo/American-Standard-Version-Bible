	<para style="p"><verse number="4" style="v" x-ref="JOB.19.4" sid="JOB 19:4" /><char style="w" x-id="WLC.JOB.19.4.001" x-align="JOB.19.4.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.19.4.002" x-align="JOB.19.4.a002" x-target-ids="t002 t003 t005" x-target="be it that" x-target-head="t002" x-head="true" lemma="אַף" strong="H637" x-morph="D" x-gloss="even" x-translit="ʾap̄-" xml:lang="hbo">אַף</char>־<char style="w" x-id="WLC.JOB.19.4.003" x-align="JOB.19.4.a003" x-target-ids="t004" x-target="indeed" x-target-head="t004" x-head="true" lemma="אׇמְנָם" strong="H551" x-morph="D" x-gloss="truly" x-translit="ʾomnām" xml:lang="hbo">אָמְנָ֥ם</char> <char style="w" x-id="WLC.JOB.19.4.004" x-align="JOB.19.4.a004" x-target-ids="t006 t007 t008" x-target="I have erred" x-target-head="t008" x-head="true" lemma="שָׁגָה" strong="H7686" x-morph="Vqp1cs" x-gloss="I.have.erred" x-translit="šāḡiyṯî" xml:lang="hbo">שָׁגִ֑יתִי</char> <char style="w" x-id="WLC.JOB.19.4.005" x-align="JOB.19.4.a005" x-target-ids="t012" x-target="with" x-target-head="t012" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾitt" xml:lang="hbo">אִ֝תִּ֗</char><char style="w" x-id="WLC.JOB.19.4.006" x-align="JOB.19.4.a006" x-target-ids="t013" x-target="myself" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.19.4.007" x-align="JOB.19.4.a007" x-target-ids="t011" x-target="remaineth" x-target-head="t011" x-head="true" lemma="לין" strong="H3885a" x-morph="Vqi3fs" x-gloss="it.lodges" x-translit="tāliyn" xml:lang="hbo">תָּלִ֥ין</char> <char style="w" x-id="WLC.JOB.19.4.008" x-align="JOB.19.4.a008" x-target-ids="t010" x-target="error" x-target-head="t010" x-head="true" lemma="מְשׁוּגָה" strong="H4879" x-morph="Ncfsc" x-gloss="er