	<para style="p"><verse number="3" style="v" x-ref="JOB.33.3" x-added-alignments="JOB.33.3.a006" x-added-target-ids="t003 t004" x-added-target="shall utter" sid="JOB 33:3" /><char style="w" x-id="WLC.JOB.33.3.001" x-align="JOB.33.3.a001" x-target-ids="t005 t006" x-target="the uprightness" x-target-head="t006" x-head="true" lemma="יֹשֶׁר" strong="H3476" x-morph="Ncmsc" x-gloss="[are].the.uprightness" x-translit="yōšer-" xml:lang="hbo">יֹֽשֶׁר</char>־<char style="w" x-id="WLC.JOB.33.3.002" x-align="JOB.33.3.a002" x-target-ids="t007 t009" x-target="of heart" x-target-head="t009" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="my.heart" x-translit="libb" xml:lang="hbo">לִבִּ֥</char><char style="w" x-id="WLC.JOB.33.3.003" x-align="JOB.33.3.a003" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.33.3.004" x-align="JOB.33.3.a004" x-target-ids="t002" x-target="words" x-target-head="t002" x-head="true" lemma="אֵמֶר" strong="H561" x-morph="Ncmpc" x-gloss="words" x-translit="ʾămār" xml:lang="hbo">אֲמָרָ֑</char><char style="w" x-id="WLC.JOB.33.3.005" x-align="JOB.33.3.a005" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.33.3.006" x-align="JOB.33.3.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.33.3.007" x-align="JOB.33.3.a008" x-target-ids="t011 t012 t015" x-target="that which know" x-target-head="t015" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsc" x-gloss="the.knowledge" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֥עַת</char> <char style="w" x-id="WLC.JOB.33.3.008" x-align="JOB.33.3.a009" x-target-ids="t014" x-ta