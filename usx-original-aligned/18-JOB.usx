	<para style="p"><verse number="15" style="v" x-ref="JOB.13.15" sid="JOB 13:15" /><char style="w" x-id="WLC.JOB.13.15.001" x-align="JOB.13.15.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֣ן</char> <char style="w" x-id="WLC.JOB.13.15.002" x-align="JOB.13.15.a002" x-target-ids="t002 t003 t004" x-target="he will slay" x-target-head="t004" x-head="true" lemma="קָטַל" strong="H6991" x-morph="Vqi3ms" x-gloss="he" x-translit="yiqṭəl" xml:lang="hbo">יִ֭קְטְלֵ</char><char style="w" x-id="WLC.JOB.13.15.003" x-align="JOB.13.15.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.kill.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.JOB.13.15.v001.r01.001" x-align="JOB.13.15.a004" x-target-ids="t008" x-target="no" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-translit="lʾ" xml:lang="hbo">לא</char> <char style="w" x-id="WLC.JOB.13.15.006" x-align="JOB.13.15.a005" x-target-ids="t006 t007 t009" x-target="I have hope" x-target-head="t009" x-head="true" lemma="יָחַל" strong="H3176" x-morph="Vpi1cs" x-gloss="I.will.wait" x-translit="ʾăyaḥēl" xml:lang="hbo">אֲיַחֵ֑ל</char> <char style="w" x-id="WLC.JOB.13.15.007" x-align="JOB.13.15.a006" x-target-ids="t010" x-target="Nevertheless" x-target-head="t010" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="nevertheless" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.JOB.13.15.008" x-align="JOB.13.15.a007" x-target-ids="t015" x-target="ways" x-target-head="t015" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="dərāḵ" xml:lang="hbo">דְּ֝רָכַ֗</char><char style="w" x-id="WLC.JOB.13.15.009" x-align="JOB.13.15.a008" x-target-ids="t014" x-target="my" x-target-head="t014" x-head="true" lemma="הוּא" strong="H2967a" x