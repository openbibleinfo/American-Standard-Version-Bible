	<para style="p"><verse number="29" style="v" x-ref="JOB.19.29" x-added-alignments="JOB.19.29.a008" x-added-target-ids="t009" x-added-target="bringeth" sid="JOB 19:29" /><char style="w" x-id="WLC.JOB.19.29.001" x-align="JOB.19.29.a001" x-target-ids="t001 t003" x-target="Be afraid" x-target-head="t003" x-head="true" lemma="גּוּר" strong="H1481b" x-morph="Vqv2mp" x-gloss="be.afraid" x-translit="gûrû" xml:lang="hbo">גּ֤וּרוּ</char> <char style="w" x-id="WLC.JOB.19.29.002" x-align="JOB.19.29.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(for" x-translit="l" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.19.29.003" x-align="JOB.19.29.a003" x-target-ids="t002" x-target="ye" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="yourselves" x-translit="āḵem" xml:lang="hbo">כֶ֨ם</char>׀<char style="w" x-id="WLC.JOB.19.29.004" x-align="JOB.19.29.a004" lemma="מִן" strong="H4480" x-morph="R" x-gloss="of" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JOB.19.29.005" x-align="JOB.19.29.a004" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="pənê-" xml:lang="hbo">פְּנֵי</char>־<char style="w" x-id="WLC.JOB.19.29.006" x-align="JOB.19.29.a005" x-target-ids="t005 t006" x-target="the sword" x-target-head="t006" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="[the].sword" x-translit="ḥereḇ" xml:lang="hbo">חֶ֗רֶב</char> <char style="w" x-id="WLC.JOB.19.29.007" x-align="JOB.19.29.a006" x-target-ids="t007" x-target="For" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.19.29.008" x-align="JOB.19.29.a007" x-target-ids="t008" x-target="wrath" x-target-head="t008" x-head="true" lemma="חֵמָה" strong="H2534" x-morph="Ncfsa" x-gloss="rage" x-translit="ḥēmâ" xml:lang="hbo">חֵ֭מָה