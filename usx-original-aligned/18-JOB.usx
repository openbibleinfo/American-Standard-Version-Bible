	<para style="p"><verse number="28" style="v" x-ref="JOB.31.28" sid="JOB 31:28" /><char style="w" x-id="WLC.JOB.31.28.001" x-align="JOB.31.28.a002" x-target-ids="t002" x-target="also" x-target-head="t002" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.JOB.31.28.002" x-align="JOB.31.28.a001" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="that" x-translit="hûʾ" xml:lang="hbo">ה֭וּא</char><char style="w" x-id="WLC.JOB.31.28.003" x-align="JOB.31.28.a003" x-target-ids="t003 t004 t005" x-target="were an iniquity" x-target-head="t005" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsa" x-gloss="[is].iniquity" x-translit="ʿāwōn" xml:lang="hbo">עָוֺ֣ן</char> <char style="w" x-id="WLC.JOB.31.28.004" x-align="JOB.31.28.a004" x-target-ids="t006 t007 t008 t009 t010 t011" x-target="to be punished by the judges" x-target-head="t011" x-head="true" lemma="פְּלִילִי" strong="H6416" x-morph="Aamsa" x-gloss="calling.for.judgment" x-translit="pəlîliy" xml:lang="hbo">פְּלִילִ֑י</char> <char style="w" x-id="WLC.JOB.31.28.005" x-align="JOB.31.28.a005" x-target-ids="t012" x-target="For" x-target-head="t012" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.31.28.006" x-align="JOB.31.28.a006" x-target-ids="t013 t014 t015 t016" x-target="I should have denied" x-target-head="t016" x-head="true" lemma="כָּחַשׁ" strong="H3584" x-morph="Vpp1cs" x-gloss="I.denied" x-translit="ḵiḥašətî" xml:lang="hbo">כִחַ֖שְׁתִּי</char> <char style="w" x-id="WLC.JOB.31.28.007" x-align="JOB.31.28.a007" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="(to)" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.JOB.31.28.008" x-align="JOB.31.28.a008" x-target-ids="t017" x-target="the" x-target-head=