	<para style="p"><verse number="29" style="v" x-ref="JOB.15.29" sid="JOB 15:29" /><char style="w" x-id="WLC.JOB.15.29.001" x-align="JOB.15.29.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.15.29.002" x-align="JOB.15.29.a002" x-target-ids="t001 t002 t004 t005" x-target="He shall be rich" x-target-head="t005" x-head="true" lemma="עָשַׁר" strong="H6238" x-morph="Vqi3ms" x-gloss="he.will.be.rich" x-translit="yeʿšar" xml:lang="hbo">יֶ֭עְשַׁר</char> <char style="w" x-id="WLC.JOB.15.29.003" x-align="JOB.15.29.a003" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.29.004" x-align="JOB.15.29.a003" x-target-ids="t006" x-target="neither" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.15.29.005" x-align="JOB.15.29.a004" x-target-ids="t007 t010" x-target="shall continue" x-target-head="t010" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi3ms" x-gloss="it.will.endure" x-translit="yāqûm" xml:lang="hbo">יָק֣וּם</char> <char style="w" x-id="WLC.JOB.15.29.006" x-align="JOB.15.29.a005" x-target-ids="t009" x-target="substance" x-target-head="t009" x-head="true" lemma="חַיִל" strong="H2428" x-morph="Ncmsc" x-gloss="wealth" x-translit="ḥēyl" xml:lang="hbo">חֵיל֑</char><char style="w" x-id="WLC.JOB.15.29.007" x-align="JOB.15.29.a006" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.15.29.008" x-align="JOB.15.29.a007" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.29.009" x-align="JOB.15.29.a007" x-target-ids="t01