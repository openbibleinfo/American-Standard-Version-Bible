	<para style="p"><verse number="2" style="v" x-ref="JOB.13.2" sid="JOB 13:2" /><char style="w" x-id="WLC.JOB.13.2.001" x-align="JOB.13.2.a001" x-target-ids="t001 t004 t005" x-target="What the same" x-target-italic-ids="t004 t005" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּֽ֭</char><char style="w" x-id="WLC.JOB.13.2.002" x-align="JOB.13.2.a002" x-target-ids="t003" x-target="know" x-target-head="t003" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsc" x-gloss="knowledge" x-translit="ḏaʿt" xml:lang="hbo">דַעְתְּ</char><char style="w" x-id="WLC.JOB.13.2.003" x-align="JOB.13.2.a003" x-target-ids="t002" x-target="ye" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="əḵem" xml:lang="hbo">כֶם</char> <char style="w" x-id="WLC.JOB.13.2.004" x-align="JOB.13.2.a004" x-target-ids="t006 t008" x-target="do know" x-target-head="t008" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿətî" xml:lang="hbo">יָדַ֣עְתִּי</char> <char style="w" x-id="WLC.JOB.13.2.005" x-align="JOB.13.2.a005" x-target-ids="t009" x-target="also" x-target-head="t009" x-head="true" lemma="גַּם" strong="H1571" x-morph="D" x-gloss="also" x-translit="ḡam-" xml:lang="hbo">גַם</char>־<char style="w" x-id="WLC.JOB.13.2.006" x-align="JOB.13.2.a006" x-target-ids="t007" x-target="I" x-target-head="t007" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānî" xml:lang="hbo">אָ֑נִי</char> <char style="w" x-id="WLC.JOB.13.2.007" x-align="JOB.13.2.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.13.2.008" x-align="JOB.13.2.a008" x-target-ids="t011 t013" x-target="am inferior" x-target-head="t013" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqrm