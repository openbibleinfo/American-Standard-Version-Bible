	<para style="p"><verse number="17" style="v" x-ref="JOB.15.17" sid="JOB 15:17" /><char style="w" x-id="WLC.JOB.15.17.001" x-align="JOB.15.17.a001" x-target-ids="t001 t002 t003" x-target="I will show" x-target-head="t003" x-head="true" lemma="חָוָה" strong="H2331" x-morph="Vpi1cs" x-gloss="I" x-translit="ʾăḥaw" xml:lang="hbo">אֲחַוְ</char><char style="w" x-id="WLC.JOB.15.17.002" x-align="JOB.15.17.a002" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.inform.you" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.JOB.15.17.003" x-align="JOB.15.17.a003" x-target-ids="t005 t006" x-target="hear thou" x-target-head="t005" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen" x-translit="šəmaʿ-" xml:lang="hbo">שְֽׁמַֽע</char>־<char style="w" x-id="WLC.JOB.15.17.004" x-align="JOB.15.17.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֑</char><char style="w" x-id="WLC.JOB.15.17.005" x-align="JOB.15.17.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.15.17.006" x-align="JOB.15.17.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.17.007" x-align="JOB.15.17.a007" x-target-ids="t009 t010" x-target="that which" x-target-head="t009" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="what" x-translit="zeh-" xml:lang="hbo">זֶֽה</char>־<char style="w" x-id="WLC.JOB.15.17.008" x-align="JOB.15.17.a008" x-target-ids="t011 t012 t013" x-target="I have seen" x-target-head="t013" x-head="true" lemma="חָזָה" strong="H2372" x-morph="Vqp1cs" x-gloss="I.have.seen" x-translit="ḥā