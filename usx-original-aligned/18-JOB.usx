	<para style="p"><verse number="11" style="v" x-ref="JOB.11.11" x-added-alignments="JOB.11.11.a012" x-added-target-ids="t014" x-added-target="it" sid="JOB 11:11" /><char style="w" x-id="WLC.JOB.11.11.001" x-align="JOB.11.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.11.11.002" x-align="JOB.11.11.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֭וּא</char> <char style="w" x-id="WLC.JOB.11.11.003" x-align="JOB.11.11.a003" x-target-ids="t003" x-target="knoweth" x-target-head="t003" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3ms" x-gloss="he.knows" x-translit="yāḏaʿ" xml:lang="hbo">יָדַ֣ע</char> <char style="w" x-id="WLC.JOB.11.11.004" x-align="JOB.11.11.a004" x-target-ids="t005" x-target="men" x-target-head="t005" x-head="true" lemma="מַת" strong="H4962" x-morph="Ncmpc" x-gloss="men" x-translit="məṯê-" xml:lang="hbo">מְתֵי</char>־<char style="w" x-id="WLC.JOB.11.11.005" x-align="JOB.11.11.a005" x-target-ids="t004" x-target="false" x-target-head="t004" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāwəʾ" xml:lang="hbo">שָׁ֑וְא</char> <char style="w" x-id="WLC.JOB.11.11.006" x-align="JOB.11.11.a006" x-target-ids="t009" x-target="also" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.11.11.007" x-align="JOB.11.11.a007" x-target-ids="t006 t007" x-target="He seeth" x-target-head="t007" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqw3ms" x-gloss="he.has.seen" x-translit="yyarʾ-" xml:lang="hbo">יַּרְא</char>־<char style="w" x-id="WLC.JOB.11.11.008" x-align="JOB.11.11.a008" x-target-ids="t008" x-target="iniquity" x-target-head="t