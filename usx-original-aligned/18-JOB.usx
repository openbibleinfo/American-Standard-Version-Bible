	<para style="p"><verse number="14" style="v" x-ref="JOB.15.14" sid="JOB 15:14" /><char style="w" x-id="WLC.JOB.15.14.001" x-align="JOB.15.14.a001" x-target-ids="t001 t002" x-target="What is" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh-" xml:lang="hbo">מָֽה</char>־<char style="w" x-id="WLC.JOB.15.14.002" x-align="JOB.15.14.a002" x-target-ids="t003" x-target="man" x-target-head="t003" x-head="true" lemma="אֱנוֹשׁ" strong="H582" x-morph="Ncmsa" x-gloss="[is].a.person" x-translit="ʾĕnôš" xml:lang="hbo">אֱנ֥וֹשׁ</char> <char style="w" x-id="WLC.JOB.15.14.003" x-align="JOB.15.14.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.15.14.004" x-align="JOB.15.14.a004" x-target-ids="t005 t006 t007 t008" x-target="he should be clean" x-target-head="t008" x-head="true" lemma="זָכָה" strong="H2135" x-morph="Vqi3ms" x-gloss="he.will.be.pure" x-translit="yizkeh" xml:lang="hbo">יִזְכֶּ֑ה</char> <char style="w" x-id="WLC.JOB.15.14.005" x-align="JOB.15.14.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.15.14.006" x-align="JOB.15.14.a006" x-target-ids="t017" x-target="that" x-target-head="t017" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="ḵiy-" xml:lang="hbo">כִֽי</char>־<char style="w" x-id="WLC.JOB.15.14.007" x-align="JOB.15.14.a007" x-target-ids="t018 t019 t020 t021" x-target="he should be righteous" x-target-head="t021" x-head="true" lemma="צָדֵק" strong="H6663" x-morph="Vqi3ms" x-gloss="he.will.be.righteous" x-translit="yiṣdaq" xml:lang="hbo">יִ֝צְדַּ֗ק</char> <char style="w" x-id="WLC.JOB.15.14.008" x-align="JOB.15.14.a008" x-target-ids="t010 t011 t012 t013" x-target="he that i