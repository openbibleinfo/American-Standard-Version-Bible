	<para style="p"><verse number="17" style="v" x-ref="JOB.21.17" x-added-alignments="JOB.21.17.a002 JOB.21.17.a003 JOB.21.17.a013 JOB.21.17.a014" x-added-target-ids="t003 t004 t005 t020 t021" x-added-target="is it | that | That | God" sid="JOB 21:17" /><char style="w" x-id="WLC.JOB.21.17.001" x-align="JOB.21.17.a001" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="how" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.JOB.21.17.002" x-align="JOB.21.17.a001" x-target-ids="t001 t002" x-target="How oft" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="often?" x-translit="mmāh" xml:lang="hbo">מָּ֤ה</char>׀<char style="w" x-id="WLC.JOB.21.17.003" x-align="JOB.21.17.a004" x-target-ids="t006 t007" x-target="the lamp" x-target-head="t007" x-head="true" lemma="נֵר" strong="H5216" x-morph="Ncmsc" x-gloss="[the].lamp" x-translit="nēr-" xml:lang="hbo">נֵר</char>־<char style="w" x-id="WLC.JOB.21.17.004" x-align="JOB.21.17.a005" x-target-ids="t008 t009 t010" x-target="of the wicked" x-target-head="t010" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁ֘עִ֤ים</char> <char style="w" x-id="WLC.JOB.21.17.005" x-align="JOB.21.17.a006" x-target-ids="t011 t012 t013" x-target="is put out" x-target-head="t012" x-head="true" lemma="דָּעַךְ" strong="H1846" x-morph="Vqi3ms" x-gloss="is.it.extinguished" x-translit="yiḏʿāḵ" xml:lang="hbo">יִדְעָ֗ךְ</char> <char style="w" x-id="WLC.JOB.21.17.006" x-align="JOB.21.17.a007" x-target-ids="t014" x-target="That" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.21.17.007" x-align="JOB.21.17.a008" x-target-ids="t017" x-target="cometh" x-target-head="t017" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3ms" x-gloss="does.it.come?" x-translit="yāḇōʾ" xml:lang="hbo">יָבֹ֣א</char> <char style="w" x-id="WLC.JOB.