	<para style="p"><verse number="24" style="v" x-ref="JOB.31.24" x-added-alignments="JOB.31.24.a011" x-added-target-ids="t015" x-added-target="Thou" sid="JOB 31:24" /><char style="w" x-id="WLC.JOB.31.24.001" x-align="JOB.31.24.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.24.002" x-align="JOB.31.24.a002" x-target-ids="t002 t003 t004" x-target="I have made" x-target-head="t004" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqp1cs" x-gloss="I.have.made" x-translit="śamətî" xml:lang="hbo">שַׂ֣מְתִּי</char> <char style="w" x-id="WLC.JOB.31.24.003" x-align="JOB.31.24.a003" x-target-ids="t005" x-target="gold" x-target-head="t005" x-head="true" lemma="זָהָב" strong="H2091" x-morph="Ncmsa" x-gloss="gold" x-translit="zāhāḇ" xml:lang="hbo">זָהָ֣ב</char> <char style="w" x-id="WLC.JOB.31.24.004" x-align="JOB.31.24.a005" x-target-ids="t007" x-target="hope" x-target-head="t007" x-head="true" lemma="כֶּסֶל" strong="H3689a" x-morph="Ncmsc" x-gloss="confidence" x-translit="kisl" xml:lang="hbo">כִּסְלִ֑</char><char style="w" x-id="WLC.JOB.31.24.005" x-align="JOB.31.24.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.24.006" x-align="JOB.31.24.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.31.24.007" x-align="JOB.31.24.a008" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.JOB.31.24.008" x-align="JOB.31.24.a009" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="true" lemma