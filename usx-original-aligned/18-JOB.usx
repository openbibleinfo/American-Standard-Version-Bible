	<para style="p"><verse number="15" style="v" x-ref="JOB.15.15" sid="JOB 15:15" /><char style="w" x-id="WLC.JOB.15.15.001" x-align="JOB.15.15.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֣ן</char> <char style="w" x-id="WLC.JOB.15.15.002" x-align="JOB.15.15.a002" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="**bi" xml:lang="hbo">בִּ֭</char><char style="w" x-id="WLC.JOB.15.15.003" x-align="JOB.15.15.a003" x-target-ids="t008 t009" x-target="holy ones" x-target-head="t008" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aampc" x-gloss="his.holy" x-translit="qəḏōšāy" xml:lang="hbo">קְדֹשָׁי</char><char style="w" x-id="WLC.JOB.15.15.004" x-align="JOB.15.15.a004" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="[ones]" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.JOB.15.15.005" x-align="JOB.15.15.a005" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.15.15.006" x-align="JOB.15.15.a006" x-target-ids="t002 t003 t005" x-target="he putteth trust" x-target-head="t005" x-head="true" lemma="אָמַן" strong="H539" x-morph="Vhi3ms" x-gloss="he.trusts" x-translit="yaʾămiyn" xml:lang="hbo">יַאֲמִ֑ין</char> <char style="w" x-id="WLC.JOB.15.15.007" x-align="JOB.15.15.a007" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.15.15.008" x-align="JOB.15.15.a008" x-target-ids="t011 t012" x-target="the heavens" x-target-head="t012" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-