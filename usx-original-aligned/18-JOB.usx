	<para style="p"><verse number="3" style="v" x-ref="JOB.4.3" sid="JOB 4:3" /><char style="w" x-id="WLC.JOB.4.3.001" x-align="JOB.4.3.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo">הִ֭נֵּה</char> <char style="w" x-id="WLC.JOB.4.3.002" x-align="JOB.4.3.a002" x-target-ids="t002 t003 t004" x-target="thou hast instructed" x-target-head="t004" x-head="true" lemma="יָסַר" strong="H3256" x-morph="Vpp2ms" x-gloss="you.have.instructed" x-translit="yissarətā" xml:lang="hbo">יִסַּ֣רְתָּ</char> <char style="w" x-id="WLC.JOB.4.3.003" x-align="JOB.4.3.a003" x-target-ids="t005" x-target="many" x-target-head="t005" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbiym" xml:lang="hbo">רַבִּ֑ים</char> <char style="w" x-id="WLC.JOB.4.3.004" x-align="JOB.4.3.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.4.3.005" x-align="JOB.4.3.a005" x-target-ids="t010 t012" x-target="the hands" x-target-head="t012" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbda" x-gloss="hands" x-translit="yāḏayim" xml:lang="hbo">יָדַ֖יִם</char> <char style="w" x-id="WLC.JOB.4.3.006" x-align="JOB.4.3.a006" x-target-ids="t011" x-target="weak" x-target-head="t011" x-head="true" lemma="רָפֶה" strong="H7504" x-morph="Aafpa" x-gloss="slack" x-translit="rāp̄ôṯ" xml:lang="hbo">רָפ֣וֹת</char> <char style="w" x-id="WLC.JOB.4.3.007" x-align="JOB.4.3.a007" x-target-ids="t007 t008 t009" x-target="thou hast strengthened" x-target-head="t009" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vpi2ms" x-gloss="you.strengthened" x-translit="təḥazzēq:" xml:lang="hbo">תְּחַזֵּֽק</char>׃<verse eid="JOB 4:3" /></para>
