	<para style="p"><verse number="29" style="v" x-ref="JOB.31.29" sid="JOB 31:29" /><char style="w" x-id="WLC.JOB.31.29.001" x-align="JOB.31.29.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.29.002" x-align="JOB.31.29.a002" x-target-ids="t002 t003 t004" x-target="I have rejoiced" x-target-head="t004" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi1cs" x-gloss="I.rejoiced" x-translit="ʾeśmaḥ" xml:lang="hbo">אֶ֭שְׂמַח</char> <char style="w" x-id="WLC.JOB.31.29.003" x-align="JOB.31.29.a003" x-target-ids="t005" x-target="at" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JOB.31.29.004" x-align="JOB.31.29.a004" x-target-ids="t006 t007" x-target="the destruction" x-target-head="t007" x-head="true" lemma="פִּיד" strong="H6365" x-morph="Ncmsc" x-gloss="the.disaster" x-translit="p̄iyḏ" xml:lang="hbo">פִ֣יד</char> <char style="w" x-id="WLC.JOB.31.29.005" x-align="JOB.31.29.a005" x-target-ids="t008 t009 t010 t011" x-target="of him that hated" x-target-head="t011" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vprmsc" x-gloss="of" x-translit="məśanʾ" xml:lang="hbo">מְשַׂנְאִ֑</char><char style="w" x-id="WLC.JOB.31.29.006" x-align="JOB.31.29.a006" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[one.who].hated.me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.29.007" x-align="JOB.31.29.a007" x-target-ids="t013" x-target="Or" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.31.29.008" x-align="JOB.31.29.a008" x-target-ids="t014 t015 t016" x-target="lifted up myself" x-target-head="t014" x-head="true" 