	<para style="p"><verse number="2" style="v" x-ref="JOB.16.2" sid="JOB 16:2" /><char style="w" x-id="WLC.JOB.16.2.001" x-align="JOB.16.2.a001" x-target-ids="t001 t002 t003" x-target="I have heard" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp1cs" x-gloss="I.have.heard" x-translit="šāmaʿətî" xml:lang="hbo">שָׁמַ֣עְתִּי</char> <char style="w" x-id="WLC.JOB.16.2.002" x-align="JOB.16.2.a002" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ḵ" xml:lang="hbo">כְ</char><char style="w" x-id="WLC.JOB.16.2.003" x-align="JOB.16.2.a002" x-target-ids="t005 t006" x-target="such things" x-target-head="t005" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo">אֵ֣לֶּה</char> <char style="w" x-id="WLC.JOB.16.2.004" x-align="JOB.16.2.a003" x-target-ids="t004" x-target="many" x-target-head="t004" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafpa" x-gloss="many" x-translit="rabôṯ" xml:lang="hbo">רַבּ֑וֹת</char> <char style="w" x-id="WLC.JOB.16.2.005" x-align="JOB.16.2.a004" x-target-ids="t008 t009" x-target="comforters are" x-target-head="t008" x-head="true" lemma="נָחַם" strong="H5162" x-morph="Vprmpc" x-gloss="[are].comforters" x-translit="mənaḥămēy" xml:lang="hbo">מְנַחֲמֵ֖י</char> <char style="w" x-id="WLC.JOB.16.2.006" x-align="JOB.16.2.a005" x-target-ids="t007" x-target="Miserable" x-target-head="t007" x-head="true" lemma="עָמָל" strong="H5999" x-morph="Ncbsa" x-gloss="of.trouble" x-translit="ʿāmāl" xml:lang="hbo">עָמָ֣ל</char> <char style="w" x-id="WLC.JOB.16.2.007" x-align="JOB.16.2.a006" x-target-ids="t011" x-target="all" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.you" x-translit="kull" xml:lang="hbo">כֻּלְּ</char><char style="w" x-id="WLC.JOB.16.2.008" x-align="JOB.16.2.a007" x-target-ids="t010" x-target="ye" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="all" x-trans