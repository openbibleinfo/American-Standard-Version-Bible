	<para style="p"><verse number="1" style="v" x-ref="JOB.5.1" sid="JOB 5:1" /><char style="w" x-id="WLC.JOB.5.1.001" x-align="JOB.5.1.a001" x-target-ids="t001" x-target="Call" x-target-head="t001" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqv2ms" x-gloss="call" x-translit="qərāʾ-" xml:lang="hbo">קְֽרָא</char>־<char style="w" x-id="WLC.JOB.5.1.002" x-align="JOB.5.1.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֭א</char> <char style="w" x-id="WLC.JOB.5.1.003" x-align="JOB.5.1.a003" x-target-ids="t003" x-target="is" x-target-head="t003" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="[is]" x-translit="hă" xml:lang="hbo">הֲ</char><char style="w" x-id="WLC.JOB.5.1.004" x-align="JOB.5.1.a004" x-target-ids="t004" x-target="there" x-target-head="t004" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there?" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.JOB.5.1.005" x-align="JOB.5.1.a005" x-target-ids="t005 t006 t007 t008" x-target="any that will answer" x-target-head="t008" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqrmsc" x-gloss="[one" x-translit="ʿôn" xml:lang="hbo">עוֹנֶ֑</char><char style="w" x-id="WLC.JOB.5.1.006" x-align="JOB.5.1.a006" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="who].answers.you" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.JOB.5.1.007" x-align="JOB.5.1.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.5.1.008" x-align="JOB.5.1.a008" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w