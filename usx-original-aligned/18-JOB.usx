	<para style="p"><verse number="13" style="v" x-ref="JOB.29.13" sid="JOB 29:13" /><char style="w" x-id="WLC.JOB.29.13.001" x-align="JOB.29.13.a001" x-target-ids="t001 t002" x-target="The blessing" x-target-head="t002" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfsc" x-gloss="[the].blessing" x-translit="birkaṯ" xml:lang="hbo">בִּרְכַּ֣ת</char> <char style="w" x-id="WLC.JOB.29.13.002" x-align="JOB.29.13.a002" x-target-ids="t003 t004 t005 t006 t007 t008 t009" x-target="of him that was ready to perish" x-target-head="t009" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqrmsa" x-gloss="of.[one].about.to.perish" x-translit="ʾōḇēḏ" xml:lang="hbo">אֹ֭בֵד</char> <char style="w" x-id="WLC.JOB.29.13.003" x-align="JOB.29.13.a003" x-target-ids="t011" x-target="upon" x-target-head="t011" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāl" xml:lang="hbo">עָלַ֣</char><char style="w" x-id="WLC.JOB.29.13.004" x-align="JOB.29.13.a004" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.29.13.005" x-align="JOB.29.13.a005" x-target-ids="t010" x-target="came" x-target-head="t010" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3fs" x-gloss="it.came" x-translit="tāḇōʾ" xml:lang="hbo">תָּבֹ֑א</char> <char style="w" x-id="WLC.JOB.29.13.006" x-align="JOB.29.13.a006" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.29.13.007" x-align="JOB.29.13.a007" x-target-ids="t018" x-target="heart" x-target-head="t018" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="lēḇ" xml:lang="hbo">לֵ֖ב</char> <char style="w" x-id="WLC.JOB.29.13.008" x-align="JOB.29.13.a008" x-target-ids="t016 t017" x-target="the widow’s" x-target-head="t0