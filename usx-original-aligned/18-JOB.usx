	<para style="p"><verse number="16" style="v" x-ref="JOB.3.16" x-added-alignments="JOB.3.16.a009" x-added-target-ids="t013" x-added-target="that" sid="JOB 3:16" /><char style="w" x-id="WLC.JOB.3.16.001" x-align="JOB.3.16.a001" x-target-ids="t001" x-target="Or" x-target-head="t001" x-head="true" lemma="אוֹ" strong="H176" x-morph="C" x-gloss="or" x-translit="ʾô" xml:lang="hbo">א֤וֹ</char><char style="w" x-id="WLC.JOB.3.16.002" x-align="JOB.3.16.a002" x-target-ids="t002" x-target="as" x-target-head="t002" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ḵ" xml:lang="hbo">כְ</char><char style="w" x-id="WLC.JOB.3.16.003" x-align="JOB.3.16.a003" x-target-ids="t003 t005 t006" x-target="a untimely birth" x-target-head="t005" x-head="true" lemma="נֵפֶל" strong="H5309" x-morph="Ncmsa" x-gloss="a.miscarriage" x-translit="nēp̄el" xml:lang="hbo">נֵ֣פֶל</char> <char style="w" x-id="WLC.JOB.3.16.004" x-align="JOB.3.16.a004" x-target-ids="t004" x-target="hidden" x-target-head="t004" x-head="true" lemma="טָמַן" strong="H2934" x-morph="Vqsmsa" x-gloss="hidden" x-translit="ṭāmûn" xml:lang="hbo">טָ֭מוּן</char> <char style="w" x-id="WLC.JOB.3.16.005" x-align="JOB.3.16.a005" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.3.16.006" x-align="JOB.3.16.a006" x-target-ids="t007 t008 t010" x-target="I had been" x-target-head="t010" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi1cs" x-gloss="was.I?" x-translit="ʾehyeh" xml:lang="hbo">אֶהְיֶ֑ה</char> <char style="w" x-id="WLC.JOB.3.16.007" x-align="JOB.3.16.a007" x-target-ids="t011" x-target="As" x-target-head="t011" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ֝</char><char style="w" x-id="WLC.JOB.3.16.008" x-align="JOB.3.16.a008" x-target-ids="t012" x-target="infants" x-target-head="t012" x-head="t