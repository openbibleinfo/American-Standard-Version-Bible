	<para style="p"><verse number="25" style="v" x-ref="JOB.22.25" sid="JOB 22:25" /><char style="w" x-id="WLC.JOB.22.25.001" x-align="JOB.22.25.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.22.25.002" x-align="JOB.22.25.a002" x-target-ids="t004 t005" x-target="will be" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="he.will.be" x-translit="hāyāh" xml:lang="hbo">הָיָ֣ה</char> <char style="w" x-id="WLC.JOB.22.25.003" x-align="JOB.22.25.a003" x-target-ids="t002 t003" x-target="the Almighty" x-target-head="t003" x-head="true" lemma="שַׁדַּי" strong="H7706" x-morph="Np" x-gloss="[the].Almighty" x-translit="šadday" xml:lang="hbo">שַׁדַּ֣י</char> <char style="w" x-id="WLC.JOB.22.25.004" x-align="JOB.22.25.a004" x-target-ids="t007" x-target="treasure" x-target-head="t007" x-head="true" lemma="בֶּצֶר" strong="H1220" x-morph="Ncmpc" x-gloss="gold(s)" x-translit="bəṣārey" xml:lang="hbo">בְּצָרֶ֑י</char><char style="w" x-id="WLC.JOB.22.25.005" x-align="JOB.22.25.a005" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.22.25.006" x-align="JOB.22.25.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.22.25.007" x-align="JOB.22.25.a007" x-target-ids="t010" x-target="silver" x-target-head="t010" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsc" x-gloss="silver" x-translit="ḵesep̄" xml:lang="hbo">כֶ֖סֶף</char> <char style="w" x-id="WLC.JOB.22.25.008" x-align="JOB.22.25.a008" x-target-ids="t009" x-target="precious" x-target-head="t009" x-head="true" lemma="תֹּועָפֹות" strong="H8443" x-morph="N