	<para style="p"><verse number="30" style="v" x-ref="JOB.31.30" sid="JOB 31:30" /><char style="w" x-id="WLC.JOB.31.30.001" x-align="JOB.31.30.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.31.30.002" x-align="JOB.31.30.a003" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.31.30.003" x-align="JOB.31.30.a002" x-target-ids="t002 t003 t005" x-target="I have suffered" x-target-head="t005" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp1cs" x-gloss="I.have.permitted" x-translit="nāṯatî" xml:lang="hbo">נָתַ֣תִּי</char> <char style="w" x-id="WLC.JOB.31.30.004" x-align="JOB.31.30.a006" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.JOB.31.30.005" x-align="JOB.31.30.a007" x-target-ids="t009" x-target="sin" x-target-head="t009" x-head="true" lemma="חָטָא" strong="H2398" x-morph="Vqc" x-gloss="sin" x-translit="ḥăṭōʾ" xml:lang="hbo">חֲטֹ֣א</char> <char style="w" x-id="WLC.JOB.31.30.006" x-align="JOB.31.30.a005" x-target-ids="t007" x-target="mouth" x-target-head="t007" x-head="true" lemma="חֵךְ" strong="H2441" x-morph="Ncmsc" x-gloss="palate" x-translit="ḥikk" xml:lang="hbo">חִכִּ֑</char><char style="w" x-id="WLC.JOB.31.30.007" x-align="JOB.31.30.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.30.008" x-align="JOB.31.30.a008" x-target-ids="t010" x-target="By" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="by" x-translit="li" xml:lang="hbo">לִ</char