	<para style="p"><verse number="16" style="v" x-ref="JOB.21.16" sid="JOB 21:16" /><char style="w" x-id="WLC.JOB.21.16.001" x-align="JOB.21.16.a001" x-target-ids="t001" x-target="Lo" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֤ן</char> <char style="w" x-id="WLC.JOB.21.16.002" x-align="JOB.21.16.a002" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.JOB.21.16.003" x-align="JOB.21.16.a003" x-target-ids="t004 t006" x-target="is in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.JOB.21.16.004" x-align="JOB.21.16.a004" x-target-ids="t008" x-target="hand" x-target-head="t008" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="their.own" x-translit="yāḏ" xml:lang="hbo">יָדָ֣</char><char style="w" x-id="WLC.JOB.21.16.005" x-align="JOB.21.16.a005" x-target-ids="t007" x-target="their" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="hand" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.JOB.21.16.006" x-align="JOB.21.16.a006" x-target-ids="t003" x-target="prosperity" x-target-head="t003" x-head="true" lemma="טוּב" strong="H2898" x-morph="Ncmsc" x-gloss="prosperity" x-translit="ṭûḇ" xml:lang="hbo">טוּבָ֑</char><char style="w" x-id="WLC.JOB.21.16.007" x-align="JOB.21.16.a007" x-target-ids="t002" x-target="their" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.JOB.21.16.008" x-align="JOB.21.16.a008" x-target-ids="t009 t010" x-target="The counsel" x-target-head="t010" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsc" x-gloss="[the].counsel" x-translit="ʿăṣa