	<para style="p"><verse number="3" style="v" x-ref="JOB.34.3" sid="JOB 34:3" /><char style="w" x-id="WLC.JOB.34.3.001" x-align="JOB.34.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.34.3.002" x-align="JOB.34.3.a002" x-target-ids="t002 t003" x-target="the ear" x-target-head="t003" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsa" x-gloss="[the].ear" x-translit="ʾōzen" xml:lang="hbo">אֹ֭זֶן</char> <char style="w" x-id="WLC.JOB.34.3.003" x-align="JOB.34.3.a003" x-target-ids="t005" x-target="words" x-target-head="t005" x-head="true" lemma="מִלָּה" strong="H4405" x-morph="Ncfpa" x-gloss="words" x-translit="milliyn" xml:lang="hbo">מִלִּ֣ין</char> <char style="w" x-id="WLC.JOB.34.3.004" x-align="JOB.34.3.a004" x-target-ids="t004" x-target="trieth" x-target-head="t004" x-head="true" lemma="בָּחַן" strong="H974" x-morph="Vqi3fs" x-gloss="it.tests" x-translit="tiḇḥān" xml:lang="hbo">תִּבְחָ֑ן</char> <char style="w" x-id="WLC.JOB.34.3.005" x-align="JOB.34.3.a005" x-target-ids="t006" x-target="As" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.34.3.006" x-align="JOB.34.3.a006" x-target-ids="t007 t008" x-target="the palate" x-target-head="t008" x-head="true" lemma="חֵךְ" strong="H2441" x-morph="Ncmsa" x-gloss="palate" x-translit="ḥēḵ" xml:lang="hbo">חֵ֗ךְ</char> <char style="w" x-id="WLC.JOB.34.3.007" x-align="JOB.34.3.a007" x-target-ids="t009" x-target="tasteth" x-target-head="t009" x-head="true" lemma="טָעַם" strong="H2938" x-morph="Vqi3ms" x-gloss="it.tastes" x-translit="yiṭʿam" xml:lang="hbo">יִטְעַ֥ם</char> <char style="w" x-id="WLC.JOB.34.3.008" x-align="JOB.34.3.a008" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="le" xml:lang="hbo">ל