	<para style="p"><verse number="30" style="v" x-ref="JOB.15.30" sid="JOB 15:30" /><char style="w" x-id="WLC.JOB.15.30.001" x-align="JOB.15.30.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JOB.15.30.002" x-align="JOB.15.30.a002" x-target-ids="t001 t002 t004" x-target="He shall depart" x-target-head="t004" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vqi3ms" x-gloss="he.will.depart" x-translit="yāsûr" xml:lang="hbo">יָס֨וּר</char>׀<char style="w" x-id="WLC.JOB.15.30.003" x-align="JOB.15.30.a003" x-target-ids="t005 t006" x-target="out of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="minnî-" xml:lang="hbo">מִנִּי</char>־<char style="w" x-id="WLC.JOB.15.30.004" x-align="JOB.15.30.a004" x-target-ids="t007" x-target="darkness" x-target-head="t007" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֗שֶׁךְ</char> <char style="w" x-id="WLC.JOB.15.30.005" x-align="JOB.15.30.a005" x-target-ids="t014" x-target="branches" x-target-head="t014" x-head="true" lemma="יוֹנֶקֶת" strong="H3127" x-morph="Ncfsc" x-gloss="shoot[s]" x-translit="yōnaqt" xml:lang="hbo">יֹֽ֭נַקְתּ</char><char style="w" x-id="WLC.JOB.15.30.006" x-align="JOB.15.30.a006" x-target-ids="t013" x-target="his" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.young" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JOB.15.30.007" x-align="JOB.15.30.a007" x-target-ids="t010 t011 t012" x-target="shall dry up" x-target-head="t011" x-head="true" lemma="יָבֵשׁ" strong="H3001" x-morph="Vpi3fs" x-gloss="it.will.dry.up" x-translit="təyabbēš" xml:lang="hbo">תְּיַבֵּ֣שׁ</char> <char style="w" x-id="WLC.JOB.15.30.008" x-align="JOB.15.30.a008" x-target-ids="t008 t009" x-target="The flame" x-targ