	<para style="p"><verse number="6" style="v" x-ref="JOB.36.6" x-added-alignments="JOB.36.6.a008" x-added-target-ids="t014" x-added-target="their" sid="JOB 36:6" /><char style="w" x-id="WLC.JOB.36.6.001" x-align="JOB.36.6.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.36.6.002" x-align="JOB.36.6.a002" x-target-ids="t001 t002 t004 t005" x-target="He preserveth the life" x-target-head="t002" x-head="true" lemma="חָיָה" strong="H2421" x-morph="Vpi3ms" x-gloss="he.preserves.alive" x-translit="yəḥayyeh" xml:lang="hbo">יְחַיֶּ֥ה</char> <char style="w" x-id="WLC.JOB.36.6.003" x-align="JOB.36.6.a003" x-target-ids="t006 t007 t008" x-target="of the wicked" x-target-head="t008" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="[the].wicked" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֑ע</char> <char style="w" x-id="WLC.JOB.36.6.004" x-align="JOB.36.6.a004" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.36.6.005" x-align="JOB.36.6.a005" x-target-ids="t015" x-target="right" x-target-head="t015" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsc" x-gloss="justice" x-translit="mišpaṭ" xml:lang="hbo">מִשְׁפַּ֖ט</char> <char style="w" x-id="WLC.JOB.36.6.006" x-align="JOB.36.6.a006" x-target-ids="t011 t012 t013" x-target="to the afflicted" x-target-head="t013" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aampa" x-gloss="of.afflicted.[people]" x-translit="ʿăniyyiym" xml:lang="hbo">עֲנִיִּ֣ים</char> <char style="w" x-id="WLC.JOB.36.6.007" x-align="JOB.36.6.a007" x-target-ids="t010" x-target="giveth" x-target-head="t010" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="he.gives" x-translit="yittēn:" xml:lang="hbo">יִתֵּֽן</char>׃<vers