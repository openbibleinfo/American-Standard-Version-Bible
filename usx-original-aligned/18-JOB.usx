	<para style="p"><verse number="1" style="v" x-ref="JOB.20.1" sid="JOB 20:1" /><char style="w" x-id="WLC.JOB.20.1.001" x-align="JOB.20.1.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֭</char><char style="w" x-id="WLC.JOB.20.1.002" x-align="JOB.20.1.a002" x-target-ids="t002" x-target="answered" x-target-head="t002" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw3ms" x-gloss="he.answered" x-translit="yyaʿan" xml:lang="hbo">יַּעַן</char> <char style="w" x-id="WLC.JOB.20.1.003" x-align="JOB.20.1.a003" x-target-ids="t003" x-target="Zophar" x-target-head="t003" x-head="true" lemma="צֹפַר" strong="H6691" x-morph="Np" x-gloss="Zophar" x-translit="ṣōp̄ar" xml:lang="hbo">צֹפַ֥ר</char> <char style="w" x-id="WLC.JOB.20.1.004" x-align="JOB.20.1.a004" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JOB.20.1.005" x-align="JOB.20.1.a005" x-target-ids="t005" x-target="Naamathite" x-target-head="t005" x-head="true" lemma="נַעֲמָתִי" strong="H5284" x-morph="Ngmsa" x-gloss="Naamathite" x-translit="nnaʿămāṯiy" xml:lang="hbo">נַּֽעֲמָתִ֗י</char> <char style="w" x-id="WLC.JOB.20.1.006" x-align="JOB.20.1.a006" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.20.1.007" x-align="JOB.20.1.a007" x-target-ids="t007" x-target="said" x-target-head="t007" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar:" xml:lang="hbo">יֹּאמַֽר</char>׃<verse eid="JOB 20:1" /></para>
