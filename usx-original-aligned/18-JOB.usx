	<para style="p"><verse number="4" style="v" x-ref="JOB.42.4" sid="JOB 42:4" /><char style="w" x-id="WLC.JOB.42.4.001" x-align="JOB.42.4.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen" x-translit="šəmaʿ-" xml:lang="hbo">שְֽׁמַֽע</char>־<char style="w" x-id="WLC.JOB.42.4.002" x-align="JOB.42.4.a002" x-target-ids="t002 t003 t004" x-target="I beseech thee" x-target-head="t003" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֭א</char> <char style="w" x-id="WLC.JOB.42.4.003" x-align="JOB.42.4.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.42.4.004" x-align="JOB.42.4.a004" x-target-ids="t006" x-target="I" x-target-head="t006" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָנֹכִ֣י</char> <char style="w" x-id="WLC.JOB.42.4.005" x-align="JOB.42.4.a005" x-target-ids="t007 t008" x-target="will speak" x-target-head="t008" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpi1cs" x-gloss="I.will.speak" x-translit="ʾăḏabbēr" xml:lang="hbo">אֲדַבֵּ֑ר</char> <char style="w" x-id="WLC.JOB.42.4.006" x-align="JOB.42.4.a006" x-target-ids="t009 t010 t011 t012" x-target="I will demand of" x-target-head="t011" x-head="true" lemma="שָׁאַל" strong="H7592" x-morph="Vqi1cs" x-gloss="I" x-translit="ʾešʾāl" xml:lang="hbo">אֶ֝שְׁאָלְ</char><char style="w" x-id="WLC.JOB.42.4.007" x-align="JOB.42.4.a007" x-target-ids="t013" x-target="thee" x-target-head="t013" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.ask.you" x-translit="əḵā" xml:lang="hbo">ךָ֗</char> <char style="w" x-id="WLC.JOB.42.4.008" x-align="JOB.42.4.a008" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.42.4.009" x-align="JOB.42.4.a009" x-target-ids="t015 t016 t017" x-target="declare thou unto" x-target-head="t015" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vhv2ms" x-gloss="make" x-translit="hôḏiyʿ" xml:lang="hbo">הוֹדִיעֵֽ</char><char style="w" x-id="WLC.JOB.42.4.010" x-align="JOB.42.4.a010" x-target-ids="t018" x-target="me" x-target-head="t018" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="known.to.me" x-translit="ēniy" xml:lang="hbo">נִי</char>׃<verse eid="JOB 42:4" /></para>
	<para style="p"><verse number="5" style="v" x-ref="JOB.42.5" sid="JOB 42:5" /><char style="w" x-id="WLC.JOB.42.5.001" x-align="JOB.42.5.a001" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JOB.42.5.002" x-align="JOB.42.5.a002" x-target-ids="t007 t008" x-target="the hearing" x-target-head="t008" x-head="true" lemma="שֵׁמַע" strong="H8088" x-morph="Ncmsc" x-gloss="hearing" x-translit="šēmaʿ-" xml:lang="hbo">שֵֽׁמַע</char>־<char style="w" x-id="WLC.JOB.42.5.003" x-align="JOB.42.5.a003" x-target-ids="t009 t010 t011" x-target="of the ear" x-target-head="t011" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsa" x-gloss="of.[the].ear" x-translit="ʾōzen" xml:lang="hbo">אֹ֥זֶן</char> <char style="w" x-id="WLC.JOB.42.5.004" x-align="JOB.42.5.a004" x-target-ids="t001 t002 t003 t004" x-target="I had heard of" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp1cs" x-gloss="I" x-translit="šəmaʿtiy" xml:lang="hbo">שְׁמַעְתִּ֑י</char><char style="w" x-id="WLC.JOB.42.5.005" x-align="JOB.42.5.a005" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="had.heard.of.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.42.5.006" x-align="JOB.42.5.a006" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.42.5.007" x-align="JOB.42.5.a007" x-target-ids="t013" x-target="now" x-target-head="t013" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֗ה</char> <char style="w" x-id="WLC.JOB.42.5.008" x-align="JOB.42.5.a008" x-target-ids="t015" x-target="eye" x-target-head="t015" x-head="true" lemma="עַיִן" strong="H5869" x-morph="