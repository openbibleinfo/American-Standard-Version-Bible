	<para style="p"><verse number="25" style="v" x-ref="JOB.31.25" sid="JOB 31:25" /><char style="w" x-id="WLC.JOB.31.25.001" x-align="JOB.31.25.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.31.25.002" x-align="JOB.31.25.a002" x-target-ids="t002 t003 t004" x-target="I have rejoiced" x-target-head="t004" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi1cs" x-gloss="I.rejoiced" x-translit="ʾeśmaḥ" xml:lang="hbo">אֶ֭שְׂמַח</char> <char style="w" x-id="WLC.JOB.31.25.003" x-align="JOB.31.25.a003" x-target-ids="t005" x-target="because" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JOB.31.25.004" x-align="JOB.31.25.a006" x-target-ids="t008 t009" x-target="was great" x-target-head="t009" x-head="true" lemma="רַב" strong="H7227" x-morph="Aamsa" x-gloss="[was].great" x-translit="raḇ" xml:lang="hbo">רַ֣ב</char> <char style="w" x-id="WLC.JOB.31.25.005" x-align="JOB.31.25.a005" x-target-ids="t007" x-target="wealth" x-target-head="t007" x-head="true" lemma="חַיִל" strong="H2428" x-morph="Ncmsc" x-gloss="wealth" x-translit="ḥēyl" xml:lang="hbo">חֵילִ֑</char><char style="w" x-id="WLC.JOB.31.25.006" x-align="JOB.31.25.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.31.25.007" x-align="JOB.31.25.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.31.25.008" x-align="JOB.31.25.a008" x-target-ids="t011" x-target="because" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit=