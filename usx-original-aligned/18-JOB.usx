	<para style="p"><verse number="26" style="v" x-ref="JOB.3.26" sid="JOB 3:26" /><char style="w" x-id="WLC.JOB.3.26.001" x-align="JOB.3.26.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֤א</char> <char style="w" x-id="WLC.JOB.3.26.002" x-align="JOB.3.26.a002" x-target-ids="t001 t002 t004 t005" x-target="I am at ease" x-target-head="t005" x-head="true" lemma="שָׁלָה" strong="H7951" x-morph="Vqp1cs" x-gloss="I.am.at.ease" x-translit="šālawətî" xml:lang="hbo">שָׁלַ֨וְתִּי</char>׀<char style="w" x-id="WLC.JOB.3.26.003" x-align="JOB.3.26.a003" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.3.26.004" x-align="JOB.3.26.a003" x-target-ids="t006" x-target="neither" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֖א</char> <char style="w" x-id="WLC.JOB.3.26.005" x-align="JOB.3.26.a004" x-target-ids="t007 t008 t009" x-target="am I quiet" x-target-head="t009" x-head="true" lemma="שָׁקַט" strong="H8252" x-morph="Vqp1cs" x-gloss="I.am.at.peace" x-translit="šāqaṭətî" xml:lang="hbo">שָׁקַ֥טְתִּי</char> <char style="w" x-id="WLC.JOB.3.26.006" x-align="JOB.3.26.a005" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.JOB.3.26.007" x-align="JOB.3.26.a005" x-target-ids="t010" x-target="neither" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.3.26.008" x-align="JOB.3.26.a006" x-target-ids="t011 t012 t013" x-target="have I rest" x-target-head="t013" x-head="true" lemma="נוּחַ" strong="H5117" x-morph="Vqp1cs" x-gloss="I.am.at.rest" x-translit="nāḥətî" xml:lang="hbo">נָ֗חְתִּי</char> <char style="w" x-id="WLC.JOB.3.26.009" x-align="JOB.3.26.a007" x-target-ids="t014" x-target="But" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JOB.3.26.010" x-align="JOB.3.26.a008" x-target-ids="t016" x-target="cometh" x-target-head="t016" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqw3ms" x-gloss="it.has.come" x-translit="yyāḇōʾ" xml:lang="hbo">יָּ֥בֹא</char> <char style="w" x-id="WLC.JOB.3.26.011" x-align="JOB.3.26.a009" x-target-ids="t015" x-target="trouble" x-target-head="t015" x-head="true" lemma="רֹגֶז" strong="H7267" x-morph="Ncmsa" x-gloss="turmoil" x-translit="rōḡez:" xml:lang="hbo">רֹֽגֶז</char>׃פ<verse eid="JOB 3:26" /></para>
