	<para style="p"><verse number="34" style="v" x-ref="JOB.15.34" sid="JOB 15:34" /><char style="w" x-id="WLC.JOB.15.34.001" x-align="JOB.15.34.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.15.34.002" x-align="JOB.15.34.a002" x-target-ids="t002 t003" x-target="the company" x-target-head="t003" x-head="true" lemma="עֵדָה" strong="H5712" x-morph="Ncfsc" x-gloss="a.company" x-translit="ʿăḏaṯ" xml:lang="hbo">עֲדַ֣ת</char> <char style="w" x-id="WLC.JOB.15.34.003" x-align="JOB.15.34.a003" x-target-ids="t004 t005 t006" x-target="of the godless" x-target-head="t006" x-head="true" lemma="חָנֵף" strong="H2611" x-morph="Aamsa" x-gloss="of.[the].godless" x-translit="ḥānēp̄" xml:lang="hbo">חָנֵ֣ף</char> <char style="w" x-id="WLC.JOB.15.34.004" x-align="JOB.15.34.a004" x-target-ids="t007 t008 t009" x-target="shall be barren" x-target-head="t009" x-head="true" lemma="גַּלְמוּד" strong="H1565" x-morph="Aamsa" x-gloss="[is].barren" x-translit="galmûḏ" xml:lang="hbo">גַּלְמ֑וּד</char> <char style="w" x-id="WLC.JOB.15.34.005" x-align="JOB.15.34.a005" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.15.34.006" x-align="JOB.15.34.a006" x-target-ids="t011" x-target="fire" x-target-head="t011" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsa" x-gloss="fire" x-translit="ʾēš" xml:lang="hbo">אֵ֗שׁ</char> <char style="w" x-id="WLC.JOB.15.34.007" x-align="JOB.15.34.a007" x-target-ids="t012 t013" x-target="shall consume" x-target-head="t013" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqp3fs" x-gloss="it.consumes" x-translit="ʾāḵəlāh" xml:lang="hbo">אָכְלָ֥ה</char> <char style="w" x-id="WLC.JOB.15.34.008" x-align="JOB.15.34.a008" x-target-ids="t014 t015" x-target="the tents" x-targe