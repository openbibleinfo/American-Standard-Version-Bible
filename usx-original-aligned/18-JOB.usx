	<para style="p"><verse number="13" style="v" x-ref="JOB.3.13" sid="JOB 3:13" /><char style="w" x-id="WLC.JOB.3.13.001" x-align="JOB.3.13.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JOB.3.13.002" x-align="JOB.3.13.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattâ" xml:lang="hbo">עַ֭תָּה</char> <char style="w" x-id="WLC.JOB.3.13.003" x-align="JOB.3.13.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="should I have lain down" x-target-head="t006" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqp1cs" x-gloss="I.lay.down" x-translit="šāḵaḇətî" xml:lang="hbo">שָׁכַ֣בְתִּי</char> <char style="w" x-id="WLC.JOB.3.13.004" x-align="JOB.3.13.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.3.13.005" x-align="JOB.3.13.a005" x-target-ids="t009 t010" x-target="been quiet" x-target-head="t010" x-head="true" lemma="שָׁקַט" strong="H8252" x-morph="Vqi1cs" x-gloss="I.am.at.peace" x-translit="ʾešqôṭ" xml:lang="hbo">אֶשְׁק֑וֹט</char> <char style="w" x-id="WLC.JOB.3.13.006" x-align="JOB.3.13.a006" x-target-ids="t011 t012 t013 t014" x-target="I should have slept" x-target-head="t014" x-head="true" lemma="יָשֵׁן" strong="H3462" x-morph="Vqp1cs" x-gloss="I.slept" x-translit="yāšanətî" xml:lang="hbo">יָ֝שַׁ֗נְתִּי</char> <char style="w" x-id="WLC.JOB.3.13.007" x-align="JOB.3.13.a007" x-target-ids="t015" x-target="then" x-target-head="t015" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֤ז</char>׀<char style="w" x-id="WLC.JOB.3.13.008" x-align="JOB.3.13.a008" x-target-ids="t016 t018 t019 t020" x-target="had been at rest" x-t