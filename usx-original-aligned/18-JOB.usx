	<para style="p"><verse number="21" style="v" x-ref="JOB.28.21" sid="JOB 28:21" /><char style="w" x-id="WLC.JOB.28.21.001" x-align="JOB.28.21.a001" x-target-ids="t001" x-target="Seeing" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ֭</char><char style="w" x-id="WLC.JOB.28.21.002" x-align="JOB.28.21.a002" x-target-ids="t002 t003 t004" x-target="it is hid" x-target-head="t004" x-head="true" lemma="עָלַם" strong="H5956" x-morph="VNp3fs" x-gloss="it.has.been.concealed" x-translit="neʿelmâ" xml:lang="hbo">נֶעֶלְמָה</char> <char style="w" x-id="WLC.JOB.28.21.003" x-align="JOB.28.21.a003" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.JOB.28.21.004" x-align="JOB.28.21.a004" x-target-ids="t006 t007" x-target="the eyes" x-target-head="t007" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֣י</char> <char style="w" x-id="WLC.JOB.28.21.005" x-align="JOB.28.21.a005" x-target-ids="t008 t009" x-target="of all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.JOB.28.21.006" x-align="JOB.28.21.a006" x-target-ids="t010" x-target="living" x-target-head="t010" x-head="true" lemma="חַי" strong="H2416a" x-morph="Aamsa" x-gloss="living.[thing]" x-translit="ḥāy" xml:lang="hbo">חָ֑י</char> <char style="w" x-id="WLC.JOB.28.21.007" x-align="JOB.28.21.a007" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.28.21.008" x-align="JOB.28.21.a008" x-target-ids="t014" x-target="from" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-