	<para style="p"><verse number="6" style="v" x-ref="JOB.16.6" sid="JOB 16:6" /><char style="w" x-id="WLC.JOB.16.6.001" x-align="JOB.16.6.a001" x-target-ids="t001 t010" x-target="Though though" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִֽם</char>־<char style="w" x-id="WLC.JOB.16.6.002" x-align="JOB.16.6.a002" x-target-ids="t002 t003" x-target="I speak" x-target-head="t003" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vph1cs" x-gloss="I.will.speak" x-translit="ʾăḏabbərâ" xml:lang="hbo">אֲ֭דַבְּרָה</char> <char style="w" x-id="WLC.JOB.16.6.003" x-align="JOB.16.6.a003" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.JOB.16.6.004" x-align="JOB.16.6.a004" x-target-ids="t006 t008" x-target="is assuaged" x-target-head="t008" x-head="true" lemma="חָשַׂךְ" strong="H2820" x-morph="VNi3ms" x-gloss="it.will.be.restrained" x-translit="yēḥāśēḵ" xml:lang="hbo">יֵחָשֵׂ֣ךְ</char> <char style="w" x-id="WLC.JOB.16.6.005" x-align="JOB.16.6.a005" x-target-ids="t005" x-target="grief" x-target-head="t005" x-head="true" lemma="כְּאֵב" strong="H3511" x-morph="Ncmsc" x-gloss="pain" x-translit="kəʾēḇ" xml:lang="hbo">כְּאֵבִ֑</char><char style="w" x-id="WLC.JOB.16.6.006" x-align="JOB.16.6.a006" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JOB.16.6.007" x-align="JOB.16.6.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.JOB.16.6.008" x-align="JOB.16.6.a008" x-target-ids="t011 t012" x-target="I forbear" x-target-head="t012" x-head="true" lemma="חָדַל" strong="H2308" x-morph="Vqh1cs