	<para style="p"><verse number="13" style="v" x-ref="JOB.11.13" sid="JOB 11:13" /><char style="w" x-id="WLC.JOB.11.13.001" x-align="JOB.11.13.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JOB.11.13.002" x-align="JOB.11.13.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַ֭תָּ֗ה</char><char style="w" x-id="WLC.JOB.11.13.003" x-align="JOB.11.13.a003" x-target-ids="t003 t006" x-target="set aright" x-target-head="t003" x-head="true" lemma="כּוּן" strong="H3559" x-morph="Vhp2ms" x-gloss="you.have.directed" x-translit="hăḵînôṯā" xml:lang="hbo">הֲכִינ֣וֹתָ</char> <char style="w" x-id="WLC.JOB.11.13.004" x-align="JOB.11.13.a004" x-target-ids="t005" x-target="heart" x-target-head="t005" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבֶּ֑</char><char style="w" x-id="WLC.JOB.11.13.005" x-align="JOB.11.13.a005" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JOB.11.13.006" x-align="JOB.11.13.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JOB.11.13.007" x-align="JOB.11.13.a007" x-target-ids="t008 t009" x-target="stretch out" x-target-head="t008" x-head="true" lemma="פָּרַשׂ" strong="H6566" x-morph="Vqq2ms" x-gloss="you.will.spread.out" x-translit="p̄āraśtā" xml:lang="hbo">פָרַשְׂתָּ֖</char> <char style="w" x-id="WLC.JOB.11.13.008" x-align="JOB.11.13.a008" x-target-ids="t012" x-target="toward" x-target-head="t012" x-head="true" lemma="אֶל" strong="H413" x-morph