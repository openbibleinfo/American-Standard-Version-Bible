	<para style="p"><verse number="21" style="v" x-ref="JOB.32.21" sid="JOB 32:21" /><char style="w" x-id="WLC.JOB.32.21.001" x-align="JOB.32.21.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.JOB.32.21.002" x-align="JOB.32.21.a002" x-target-ids="t004 t005 t006" x-target="I pray you" x-target-head="t005" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֭א</char> <char style="w" x-id="WLC.JOB.32.21.003" x-align="JOB.32.21.a003" x-target-ids="t001 t002 t007" x-target="Let me respect" x-target-head="t007" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqh1cs" x-gloss="let.me.lift.up" x-translit="ʾeśśāʾ" xml:lang="hbo">אֶשָּׂ֣א</char> <char style="w" x-id="WLC.JOB.32.21.004" x-align="JOB.32.21.a004" x-target-ids="t010" x-target="person" x-target-head="t010" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="[the].face" x-translit="p̄ənê-" xml:lang="hbo">פְנֵי</char>־<char style="w" x-id="WLC.JOB.32.21.005" x-align="JOB.32.21.a005" x-target-ids="t008 t009" x-target="any man’s" x-target-head="t009" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.anyone" x-translit="ʾiyš" xml:lang="hbo">אִ֑ישׁ</char> <char style="w" x-id="WLC.JOB.32.21.006" x-align="JOB.32.21.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JOB.32.21.007" x-align="JOB.32.21.a007" x-target-ids="t017" x-target="unto" x-target-head="t017" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.JOB.32.21.008" x-align="JOB.32.21.a008" x-target-ids="t018 t019" x-target="any man" x-target-head="t019" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾāḏām" xml:lang="hbo">אָ֝דָ֗ם<