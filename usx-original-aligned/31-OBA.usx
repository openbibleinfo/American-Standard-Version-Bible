	<para style="p"><verse number="6" style="v" x-ref="OBA.1.6" sid="OBA 1:6" /><char style="w" x-id="WLC.OBA.1.6.001" x-align="OBA.1.6.a001" x-target-ids="t001 t008" x-target="How how" x-target-head="t001" x-head="true" lemma="אֵיךְ" strong="H349" x-morph="Ti" x-gloss="how!" x-translit="ʾêḵ" xml:lang="hbo">אֵ֚יךְ</char> <char style="w" x-id="WLC.OBA.1.6.002" x-align="OBA.1.6.a002" x-target-ids="t002 t007" x-target="are searched" x-target-head="t007" x-head="true" lemma="חָפַשׂ" strong="H2664" x-morph="VNp3cp" x-gloss="they.will.be.plundered" x-translit="neḥpəśû" xml:lang="hbo">נֶחְפְּשׂ֣וּ</char> <char style="w" x-id="WLC.OBA.1.6.003" x-align="OBA.1.6.a003" x-target-ids="t003 t004 t005 t006" x-target="the things of Esau" x-target-italic-ids="t003 t004 t005" x-target-head="t006" x-head="true" lemma="עֵשָׂו" strong="H6215" x-morph="Np" x-gloss="Esau" x-translit="ʿēśāw" xml:lang="hbo">עֵשָׂ֔ו</char> <char style="w" x-id="WLC.OBA.1.6.004" x-align="OBA.1.6.a004" x-target-ids="t009 t013 t014" x-target="are sought out" x-target-head="t013" x-head="true" lemma="בָּעָה" strong="H1158" x-morph="VNp3cp" x-gloss="they.will.be.searched.out" x-translit="niḇʿû" xml:lang="hbo">נִבְע֖וּ</char> <char style="w" x-id="WLC.OBA.1.6.005" x-align="OBA.1.6.a005" x-target-ids="t011 t012" x-target="hidden treasures" x-target-head="t011" x-head="true" lemma="מַצְפּוּנִים" strong="H4710" x-morph="Ncmpc" x-gloss="treasures" x-translit="maṣpunāy" xml:lang="hbo">מַצְפֻּנָֽי</char><char style="w" x-id="WLC.OBA.1.6.006" x-align="OBA.1.6.a006" x-target-ids="t010" x-target="his" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its.hidden" x-translit="w" xml:lang="hbo">ו</char>׃<verse eid="OBA 1:6" /></para>
