	<para style="p"><verse number="2" style="v" x-ref="OBA.1.2" sid="OBA 1:2" /><char style="w" x-id="WLC.OBA.1.2.001" x-align="OBA.1.2.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֥ה</char> <char style="w" x-id="WLC.OBA.1.2.002" x-align="OBA.1.2.a002" x-target-ids="t006" x-target="small" x-target-head="t006" x-head="true" lemma="קָטֹן" strong="H6996a" x-morph="Aamsa" x-gloss="small" x-translit="qāṭōn" xml:lang="hbo">קָטֹ֛ן</char> <char style="w" x-id="WLC.OBA.1.2.003" x-align="OBA.1.2.a003" x-target-ids="t002 t003 t004" x-target="I have made" x-target-head="t004" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp1cs" x-gloss="I" x-translit="nəṯattiy" xml:lang="hbo">נְתַתִּ֖י</char><char style="w" x-id="WLC.OBA.1.2.004" x-align="OBA.1.2.a004" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.make.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.OBA.1.2.005" x-align="OBA.1.2.a005" x-target-ids="t007" x-target="among" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.OBA.1.2.006" x-align="OBA.1.2.a006" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.OBA.1.2.007" x-align="OBA.1.2.a007" x-target-ids="t009" x-target="nations" x-target-head="t009" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="gôyim" xml:lang="hbo">גּוֹיִ֑ם</char> <char style="w" x-id="WLC.OBA.1.2.008" x-align="OBA.1.2.a008" x-target-ids="t011 t013" x-target="art despised" x-target-head="t013" x-head="true" lemma="בָּזָה" strong="H959" x-morph="Vqsmsa" x-gloss="[will.be].despised" 