	<para style="p"><verse number="3" style="v" x-ref="OBA.1.3" sid="OBA 1:3" /><char style="w" x-id="WLC.OBA.1.3.001" x-align="OBA.1.3.a001" x-target-ids="t001 t002" x-target="The pride" x-target-head="t002" x-head="true" lemma="זָדוֹן" strong="H2087" x-morph="Ncmsc" x-gloss="the.presumption" x-translit="zəḏôn" xml:lang="hbo">זְד֤וֹן</char> <char style="w" x-id="WLC.OBA.1.3.002" x-align="OBA.1.3.a002" x-target-ids="t003 t005" x-target="of heart" x-target-head="t005" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="your.heart" x-translit="libb" xml:lang="hbo">לִבְּ</char><char style="w" x-id="WLC.OBA.1.3.003" x-align="OBA.1.3.a003" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֙</char> <char style="w" x-id="WLC.OBA.1.3.004" x-align="OBA.1.3.a004" x-target-ids="t006 t007" x-target="hath deceived" x-target-head="t007" x-head="true" lemma="נָשָׁא" strong="H5377" x-morph="Vhp3ms" x-gloss="it" x-translit="hiššiyʾ" xml:lang="hbo">הִשִּׁיאֶ֔</char><char style="w" x-id="WLC.OBA.1.3.005" x-align="OBA.1.3.a005" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="has.deceived.you" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.OBA.1.3.006" x-align="OBA.1.3.a006" x-target-ids="t009 t010 t011 t012" x-target="O thou that dwellest" x-target-head="t012" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqrmsc" x-gloss="O.[you.who].dwell" x-translit="šōḵəniy" xml:lang="hbo">שֹׁכְנִ֥י</char> <char style="w" x-id="WLC.OBA.1.3.007" x-align="OBA.1.3.a007" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.OBA.1.3.008" x-align="OBA.1.3.a008" x-target-ids="t014 t015" x-target="the clefts" x-target-head="t015" x-head="true" lemma="