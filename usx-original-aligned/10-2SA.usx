	<para style="p"><verse number="26" style="v" x-ref="2SA.19.26" sid="2SA 19:26" /><char style="w" x-id="WLC.2SA.19.26.001" x-align="2SA.19.26.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="2SA.19.27">וַ</char><char style="w" x-id="WLC.2SA.19.26.002" x-align="2SA.19.26.a002" x-target-ids="t002 t003" x-target="he answered" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar" xml:lang="hbo" x-source-ref="2SA.19.27">יֹּאמַ֕ר</char> <char style="w" x-id="WLC.2SA.19.26.003" x-align="2SA.19.26.a003" x-target-ids="t005" x-target="lord" x-target-head="t005" x-head="true" lemma="אָדוֹן" strong="H113" x-morph="Ncmsc" x-gloss="my.lord" x-translit="ʾăḏōn" xml:lang="hbo" x-source-ref="2SA.19.27">אֲדֹנִ֥</char><char style="w" x-id="WLC.2SA.19.26.004" x-align="2SA.19.26.a004" x-target-ids="t004" x-target="My" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="2SA.19.27">י</char> <char style="w" x-id="WLC.2SA.19.26.005" x-align="2SA.19.26.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="2SA.19.27">הַ</char><char style="w" x-id="WLC.2SA.19.26.006" x-align="2SA.19.26.a006" x-target-ids="t006 t007" x-target="O king" x-target-head="t007" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="king" x-translit="mmeleḵ" xml:lang="hbo" x-source-ref="2SA.19.27">מֶּ֖לֶךְ</char> <char style="w" x-id="WLC.2SA.19.26.007" x-align="2SA.19.26.a007" x-target-ids="t009" x-target="servant" x-target-head="t009" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo" x-source-ref="2SA.19.27">עַבְדִּ֣</char><char style="w" x-id="WLC.2SA.19.26.008" x-align="2SA.19.26.a00