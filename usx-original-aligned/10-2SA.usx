	<para style="p"><verse number="25" style="v" x-ref="2SA.19.25" sid="2SA 19:25" /><char style="w" x-id="WLC.2SA.19.25.001" x-align="2SA.19.25.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="2SA.19.26">וַ</char><char style="w" x-id="WLC.2SA.19.25.002" x-align="2SA.19.25.a002" x-target-ids="t002 t003 t004 t005" x-target="it came to pass" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw3ms" x-gloss="it.was" x-translit="yəhiy" xml:lang="hbo" x-source-ref="2SA.19.26">יְהִ֛י</char> <char style="w" x-id="WLC.2SA.19.25.003" x-align="2SA.19.25.a003" x-target-ids="t006" x-target="when" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo" x-source-ref="2SA.19.26">כִּי</char>־<char style="w" x-id="WLC.2SA.19.25.004" x-align="2SA.19.25.a004" x-target-ids="t007 t008 t009" x-target="he was come" x-target-head="t009" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqp3ms" x-gloss="he.came" x-translit="ḇāʾ" xml:lang="hbo" x-source-ref="2SA.19.26">בָ֥א</char> <char style="w" x-id="WLC.2SA.19.25.005" x-align="2SA.19.25.a005" x-target-ids="t010 t011" x-target="to Jerusalem" x-target-head="t011" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389" x-morph="Np" x-gloss="Jerusalem" x-translit="yərûšālaim" xml:lang="hbo" x-source-ref="2SA.19.26">יְרוּשָׁלִַ֖ם</char> <char style="w" x-id="WLC.2SA.19.25.006" x-align="2SA.19.25.a006" x-target-ids="t012" x-target="to" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="2SA.19.26">לִ</char><char style="w" x-id="WLC.2SA.19.25.007" x-align="2SA.19.25.a007" x-target-ids="t013" x-target="meet" x-target-head="t013" x-head="true" lemma="קרא" strong="H7122" x-morph="Vqc" x-gloss="meet" x-translit="qəraʾṯ" xml:lang="hbo" x-source-ref="2SA.19.26">קְרַ֣את<