	<para style="p"><verse number="26" style="v" x-ref="2SA.22.26" sid="2SA 22:26" /><char style="w" x-id="WLC.2SA.22.26.001" x-align="2SA.22.26.a001" x-target-ids="t001" x-target="With" x-target-head="t001" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.2SA.22.26.002" x-align="2SA.22.26.a002" x-target-ids="t002 t003" x-target="the merciful" x-target-head="t003" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aamsa" x-gloss="a.faithful.[person]" x-translit="ḥāsiyḏ" xml:lang="hbo">חָסִ֖יד</char> <char style="w" x-id="WLC.2SA.22.26.003" x-align="2SA.22.26.a003" x-target-ids="t004 t005 t006 t007 t008" x-target="thou wilt show thyself merciful" x-target-head="t008" x-head="true" lemma="חָסַד" strong="H2616" x-morph="Vti2ms" x-gloss="you.show.yourself.faithful" x-translit="tiṯḥassāḏ" xml:lang="hbo">תִּתְחַסָּ֑ד</char> <char style="w" x-id="WLC.2SA.22.26.004" x-align="2SA.22.26.a004" x-target-ids="t009" x-target="With" x-target-head="t009" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.2SA.22.26.005" x-align="2SA.22.26.a005" x-target-ids="t010 t012" x-target="the man" x-target-head="t012" x-head="true" lemma="גִּבּוֹר" strong="H1368" x-morph="Aamsa" x-gloss="a.mighty.[man]" x-translit="gibôr" xml:lang="hbo">גִּבּ֥וֹר</char> <char style="w" x-id="WLC.2SA.22.26.006" x-align="2SA.22.26.a006" x-target-ids="t011" x-target="perfect" x-target-head="t011" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aamsa" x-gloss="blameless" x-translit="tāmiym" xml:lang="hbo">תָּמִ֖ים</char> <char style="w" x-id="WLC.2SA.22.26.007" x-align="2SA.22.26.a007" x-target-ids="t013 t014 t015 t016 t017" x-target="thou wilt show thyself perfect" x-target-head="t017" x-head="true" lemma="תָּמַם" strong="H8552" x-morph="Vti2ms" x-gloss="you.show.yourself.blameless" x-translit="tittammām:" xml:lang="hbo">תִּתַּמָּֽם</