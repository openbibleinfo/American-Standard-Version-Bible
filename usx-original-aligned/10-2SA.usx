	<para style="p"><verse number="28" style="v" x-ref="2SA.22.28" x-added-alignments="2SA.22.28.a011 2SA.22.28.a013" x-added-target-ids="t015 t019" x-added-target="that | them" sid="2SA 22:28" /><char style="w" x-id="WLC.2SA.22.28.001" x-align="2SA.22.28.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.2SA.22.28.002" x-align="2SA.22.28.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.2SA.22.28.003" x-align="2SA.22.28.a003" x-target-ids="t002 t004" x-target="the people" x-target-head="t004" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿam" xml:lang="hbo">עַ֥ם</char> <char style="w" x-id="WLC.2SA.22.28.004" x-align="2SA.22.28.a004" x-target-ids="t003" x-target="afflicted" x-target-head="t003" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aamsa" x-gloss="afflicted" x-translit="ʿāniy" xml:lang="hbo">עָנִ֖י</char> <char style="w" x-id="WLC.2SA.22.28.005" x-align="2SA.22.28.a005" x-target-ids="t005 t006 t007" x-target="thou wilt save" x-target-head="t007" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="Vhi2ms" x-gloss="you.save" x-translit="tôšiyᵃʿ" xml:lang="hbo">תּוֹשִׁ֑יעַ</char> <char style="w" x-id="WLC.2SA.22.28.006" x-align="2SA.22.28.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.2SA.22.28.007" x-align="2SA.22.28.a007" x-target-ids="t010" x-target="eyes" x-target-head="t010" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿēyney" xml:lang="hbo">עֵינֶ֖י</char><char style="w" x-id="WLC.2SA.22.28.008" x-align="2SA.22.28.a008" x-target-ids="t009" x-target="thine" x-target-h