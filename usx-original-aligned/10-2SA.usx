	<para style="p"><verse number="2" style="v" x-ref="2SA.23.2" sid="2SA 23:2" /><char style="w" x-id="WLC.2SA.23.2.001" x-align="2SA.23.2.a001" x-target-ids="t001 t002" x-target="The Spirit" x-target-head="t002" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="the.spirit" x-translit="rûᵃḥ" xml:lang="hbo">ר֥וּחַ</char> <char style="w" x-id="WLC.2SA.23.2.002" x-align="2SA.23.2.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.2SA.23.2.003" x-align="2SA.23.2.a003" x-target-ids="t005" x-target="spake" x-target-head="t005" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpp3ms" x-gloss="he.has.spoken" x-translit="dibber-" xml:lang="hbo">דִּבֶּר</char>־<char style="w" x-id="WLC.2SA.23.2.004" x-align="2SA.23.2.a004" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="b" xml:lang="hbo">בִּ֑</char><char style="w" x-id="WLC.2SA.23.2.005" x-align="2SA.23.2.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.2SA.23.2.006" x-align="2SA.23.2.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.2SA.23.2.007" x-align="2SA.23.2.a008" x-target-ids="t010" x-target="word" x-target-head="t010" x-head="true" lemma="מִלָּה" strong="H4405" x-morph="Ncfsc" x-gloss="speech" x-translit="millāṯ" xml:lang="hbo">מִלָּת֖</char><char style="w" x-id="WLC.2SA.23.2.008" x-align="2SA.23.2.a007" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="