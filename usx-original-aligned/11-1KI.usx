	<para style="p"><verse number="2" style="v" x-ref="1KI.11.2" sid="1KI 11:2" /><char style="w" x-id="WLC.1KI.11.2.001" x-align="1KI.11.2.a001" x-target-ids="t001" x-target="of" x-target-head="t001" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="min-" xml:lang="hbo">מִן</char>־<char style="w" x-id="WLC.1KI.11.2.002" x-align="1KI.11.2.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.1KI.11.2.003" x-align="1KI.11.2.a003" x-target-ids="t003" x-target="nations" x-target-head="t003" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="gôyim" xml:lang="hbo">גּוֹיִ֗ם</char> <char style="w" x-id="WLC.1KI.11.2.004" x-align="1KI.11.2.a004" x-target-ids="t004 t005" x-target="concerning which" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.1KI.11.2.005" x-align="1KI.11.2.a005" x-target-ids="t007" x-target="said" x-target-head="t007" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.had.said" x-translit="ʾāmar-" xml:lang="hbo">אָֽמַר</char>־<char style="w" x-id="WLC.1KI.11.2.006" x-align="1KI.11.2.a006" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֩</char> <char style="w" x-id="WLC.1KI.11.2.007" x-align="1KI.11.2.a007" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.1KI.11.2.008" x-align="1KI.11.2.a008" x-target-ids="t009 t010" x-target="the children" x-target-head="t010" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.people" x-translit="bə