	<para style="p"><verse number="14" style="v" x-ref="1KI.22.14" sid="1KI 22:14" /><char style="w" x-id="WLC.1KI.22.14.001" x-align="1KI.22.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.1KI.22.14.002" x-align="1KI.22.14.a002" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmer" xml:lang="hbo">יֹּ֖אמֶר</char> <char style="w" x-id="WLC.1KI.22.14.003" x-align="1KI.22.14.a003" x-target-ids="t002" x-target="Micaiah" x-target-head="t002" x-head="true" lemma="מִיכָיְהוּ" strong="H4321" x-morph="Np" x-gloss="Micaiah" x-translit="mîḵāyəhû" xml:lang="hbo">מִיכָ֑יְהוּ</char> <char style="w" x-id="WLC.1KI.22.14.004" x-align="1KI.22.14.a004" x-target-ids="t004 t006" x-target="As liveth" x-target-head="t006" x-head="true" lemma="חַי" strong="H2416" x-morph="Aamsa" x-gloss="[by].the.life" x-translit="ḥay-" xml:lang="hbo">חַי</char>־<char style="w" x-id="WLC.1KI.22.14.005" x-align="1KI.22.14.a005" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֕ה</char> <char style="w" x-id="WLC.1KI.22.14.006" x-align="1KI.22.14.a006" x-status="unrepresented" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּ֠י</char> <char style="w" x-id="WLC.1KI.22.14.007" x-align="1KI.22.14.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.1KI.22.14.008" x-align="1KI.22.14.a008" x-target-ids="t007" x-target="what" x-target-head="t007" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[that].which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֨ר</char> <char sty