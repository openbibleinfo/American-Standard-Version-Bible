	<para style="p"><verse number="19" style="v" x-ref="1PE.1.19" x-added-alignments="1PE.1.19.a009" x-added-target-ids="t014 t015 t016" x-added-target="even the blood" sid="1PE 1:19" /><char style="w" x-id="SBLGNT.1PE.1.19.001" x-align="1PE.1.19.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.1PE.1.19.002" x-align="1PE.1.19.a002" x-target-ids="t003" x-target="precious" x-target-head="t003" x-head="true" lemma="τίμιος" strong="G5093" x-morph="A-DSN" x-gloss="by [the] precious" x-translit="timiōi" xml:lang="grc">τιμίῳ</char> <char style="w" x-id="SBLGNT.1PE.1.19.003" x-align="1PE.1.19.a003" x-target-ids="t002 t004" x-target="with blood" x-target-head="t004" x-head="true" lemma="αἷμα" strong="G129" x-morph="N-DSN" x-gloss="blood" x-translit="haimati" xml:lang="grc">αἵματι</char> <char style="w" x-id="SBLGNT.1PE.1.19.004" x-align="1PE.1.19.a004" x-target-ids="t005" x-target="as" x-target-head="t005" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.1PE.1.19.005" x-align="1PE.1.19.a005" x-target-ids="t006 t007 t008" x-target="of a lamb" x-target-head="t008" x-head="true" lemma="ἀμνός" strong="G286" x-morph="N-GSM" x-gloss="of a lamb" x-translit="amnou" xml:lang="grc">ἀμνοῦ</char> <char style="w" x-id="SBLGNT.1PE.1.19.006" x-align="1PE.1.19.a006" x-target-ids="t009 t010" x-target="without blemish" x-target-head="t010" x-head="true" lemma="ἄμωμος" strong="G299" x-morph="A-GSM" x-gloss="without blemish" x-translit="amōmou" xml:lang="grc">ἀμώμου</char> <char style="w" x-id="SBLGNT.1PE.1.19.007" x-align="1PE.1.19.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1PE.1.19.008" x-align="