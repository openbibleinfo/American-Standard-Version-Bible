	<para style="p"><verse number="24" style="v" x-ref="1PE.2.24" sid="1PE 2:24" /><char style="w" x-id="SBLGNT.1PE.2.24.001" x-align="1PE.2.24.a001" x-target-ids="t001" x-target="who" x-target-head="t001" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-NSM" x-gloss="Who" x-translit="hos" xml:lang="grc">ὃς</char> <char style="w" x-id="SBLGNT.1PE.2.24.002" x-align="1PE.2.24.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APF" x-gloss="the" x-translit="tas" xml:lang="grc">τὰς</char> <char style="w" x-id="SBLGNT.1PE.2.24.003" x-align="1PE.2.24.a003" x-target-ids="t007" x-target="sins" x-target-head="t007" x-head="true" lemma="ἁμαρτία" strong="G266" x-morph="N-APF" x-gloss="sins" x-translit="hamartias" xml:lang="grc">ἁμαρτίας</char> <char style="w" x-id="SBLGNT.1PE.2.24.004" x-align="1PE.2.24.a004" x-target-ids="t006" x-target="our" x-target-head="t006" x-head="true" lemma="ἐγώ" strong="G2257" x-morph="P-1GP" x-gloss="of us" x-translit="hēmōn" xml:lang="grc">ἡμῶν</char> <char style="w" x-id="SBLGNT.1PE.2.24.005" x-align="1PE.2.24.a005" x-target-ids="t002 t003 t004" x-target="his own self" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NSM" x-gloss="Himself" x-translit="autos" xml:lang="grc">αὐτὸς</char> <char style="w" x-id="SBLGNT.1PE.2.24.006" x-align="1PE.2.24.a006" x-target-ids="t005" x-target="bare" x-target-head="t005" x-head="true" lemma="ἀναφέρω" strong="G399" x-morph="V-AAI-3S" x-gloss="bore" x-translit="anēnenken" xml:lang="grc">ἀνήνεγκεν</char> <char style="w" x-id="SBLGNT.1PE.2.24.007" x-align="1PE.2.24.a007" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1PE.2.24.008" x-align="1PE.2.24.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSN" x-gloss="the" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.1