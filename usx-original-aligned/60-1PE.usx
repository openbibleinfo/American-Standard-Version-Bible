	<para style="p"><verse number="4" style="v" x-ref="1PE.4.4" sid="1PE 4:4" /><char style="w" x-id="SBLGNT.1PE.4.4.001" x-align="1PE.4.4.a001" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="With respect to" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1PE.4.4.002" x-align="1PE.4.4.a001" x-target-ids="t001" x-target="wherein" x-target-head="t001" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-DSN" x-gloss="this" x-translit="hōi" xml:lang="grc">ᾧ</char> <char style="w" x-id="SBLGNT.1PE.4.4.003" x-align="1PE.4.4.a002" x-target-ids="t002 t003 t004 t005" x-target="they think it strange" x-target-head="t005" x-head="true" lemma="ξενίζω" strong="G3579" x-morph="V-PPI-3P" x-gloss="they think it strange" x-translit="xenizontai" xml:lang="grc">ξενίζονται</char> <char style="w" x-id="SBLGNT.1PE.4.4.004" x-align="1PE.4.4.a003" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.1PE.4.4.005" x-align="1PE.4.4.a004" x-target-ids="t006 t008 t010 t011" x-target="that run with them" x-target-italic-ids="t011" x-target-head="t008" x-head="true" lemma="συντρέχω" strong="G4936" x-morph="V-PAP-GPM" x-gloss="running with [them]" x-translit="syntrechontōn" xml:lang="grc">συντρεχόντων</char> <char style="w" x-id="SBLGNT.1PE.4.4.006" x-align="1PE.4.4.a005" x-target-ids="t007" x-target="ye" x-target-head="t007" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="of you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char> <char style="w" x-id="SBLGNT.1PE.4.4.007" x-align="1PE.4.4.a006" x-target-ids="t012" x-target="into" x-target-head="t012" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="into" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.1PE.4.4.008" x-align="1PE.4.4.a007" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="true" lemma="ὁ" strong="G3588" x-mo