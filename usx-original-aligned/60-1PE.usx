	<para style="p"><verse number="7" style="v" x-ref="1PE.2.7" sid="1PE 2:7" /><char style="w" x-id="SBLGNT.1PE.2.7.001" x-align="1PE.2.7.a001" x-target-ids="t001 t002 t006" x-target="For you is" x-target-head="t002" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="To you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.1PE.2.7.002" x-align="1PE.2.7.a002" x-target-ids="t003" x-target="therefore" x-target-head="t003" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore [is]" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.1PE.2.7.003" x-align="1PE.2.7.a005" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.1PE.2.7.004" x-align="1PE.2.7.a006" x-target-ids="t008" x-target="preciousness" x-target-head="t008" x-head="true" lemma="τιμή" strong="G5092" x-morph="N-NSF" x-gloss="preciousness" x-translit="timē" xml:lang="grc">τιμὴ</char> <char style="w" x-id="SBLGNT.1PE.2.7.005" x-align="1PE.2.7.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM" x-gloss="-" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.1PE.2.7.006" x-align="1PE.2.7.a004" x-target-ids="t004 t005" x-target="that believe" x-target-head="t005" x-head="true" lemma="πιστεύω" strong="G4100" x-morph="V-PAP-DPM" x-gloss="believing" x-translit="pisteuousin" xml:lang="grc">πιστεύουσιν</char>·<char style="w" x-id="SBLGNT.1PE.2.7.007" x-align="1PE.2.7.a008" x-target-ids="t010 t011 t012 t013" x-target="for such as disbelieve" x-target-head="t013" x-head="true" lemma="ἀπιστέω" strong="G569" x-morph="V-PAP-DPM" x-gloss="[to those] disobeying" x-translit="apistousin" xml:lang="grc">ἀπιστοῦσιν</char> <char style="w" x-id="SBLGNT.1PE.2.7.008" x-align="1PE.2.7.a007" x-target-ids="t009" x-target="but" x-target-head="t009" x-head="true" lemma