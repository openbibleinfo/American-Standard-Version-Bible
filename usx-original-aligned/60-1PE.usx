	<para style="p"><verse number="25" style="v" x-ref="1PE.2.25" sid="1PE 2:25" /><char style="w" x-id="SBLGNT.1PE.2.25.001" x-align="1PE.2.25.a002" x-target-ids="t002 t003" x-target="ye were" x-target-head="t003" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-2P" x-gloss="You were" x-translit="ēte" xml:lang="grc">ἦτε</char> <char style="w" x-id="SBLGNT.1PE.2.25.002" x-align="1PE.2.25.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.1PE.2.25.003" x-align="1PE.2.25.a004" x-target-ids="t006" x-target="like" x-target-head="t006" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="like" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.1PE.2.25.004" x-align="1PE.2.25.a005" x-target-ids="t007" x-target="sheep" x-target-head="t007" x-head="true" lemma="πρόβατον" strong="G4263" x-morph="N-NPN" x-gloss="sheep" x-translit="probata" xml:lang="grc">πρόβατα</char> <char style="w" x-id="SBLGNT.1PE.2.25.005" x-align="1PE.2.25.a003" x-target-ids="t004 t005" x-target="going astray" x-target-head="t005" x-head="true" lemma="πλανάω" strong="G4105" x-morph="V-PPP-NPM" x-gloss="going astray" x-translit="planōmenoi" xml:lang="grc">πλανώμενοι</char>,<char style="w" x-id="SBLGNT.1PE.2.25.006" x-align="1PE.2.25.a006" x-target-ids="t008" x-target="but" x-target-head="t008" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.1PE.2.25.007" x-align="1PE.2.25.a007" x-target-ids="t009 t011" x-target="are returned" x-target-head="t011" x-head="true" lemma="ἐπιστρέφω" strong="G1994" x-morph="V-2API-2P" x-gloss="you have returned" x-translit="epestraphēte" xml:lang="grc">ἐπεστράφητε</char> <char style="w" x-id="SBLGNT.1PE.2.25.008" x-align="1PE.2.25.a008" x-target-ids="t010" x-target="now" x-target-head="t010" x-head