	<para style="p"><verse number="44" style="v" x-ref="EZR.10.44" sid="EZR 10:44" /><char style="w" x-id="WLC.EZR.10.44.001" x-align="EZR.10.44.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.EZR.10.44.002" x-align="EZR.10.44.a002" x-target-ids="t002" x-target="these" x-target-head="t002" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these" x-translit="ʾēlleh" xml:lang="hbo">אֵ֕לֶּה</char> <char style="w" x-id="WLC.EZR.10.44.003" x-align="EZR.10.44.a003" x-target-ids="t003 t004" x-target="had taken" x-target-head="t004" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqp3cp" x-gloss="they.had.taken" x-translit="**nāśʾû" xml:lang="hbo">נָשְׂא֖וּ</char><char style="w" x-id="WLC.EZR.10.44.004" x-align="EZR.10.44.a004" x-target-ids="t006" x-target="wives" x-target-head="t006" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfpa" x-gloss="women" x-translit="nāšiym" xml:lang="hbo">נָשִׁ֣ים</char> <char style="w" x-id="WLC.EZR.10.44.005" x-align="EZR.10.44.a005" x-target-ids="t005" x-target="foreign" x-target-head="t005" x-head="true" lemma="נׇכְרִי" strong="H5237" x-morph="Aafpa" x-gloss="foreign" x-translit="nāḵəriyyôṯ" xml:lang="hbo">נָכְרִיּ֑וֹת</char> <char style="w" x-id="WLC.EZR.10.44.006" x-align="EZR.10.44.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EZR.10.44.007" x-align="EZR.10.44.a007" x-target-ids="t011" x-target="had" x-target-head="t011" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[were]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.EZR.10.44.008" x-align="EZR.10.44.a008" x-target-ids="t008 t009" x-target="some of" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480