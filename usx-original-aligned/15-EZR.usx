	<para style="p"><verse number="6" style="v" x-ref="EZR.1.6" sid="EZR 1:6" /><char style="w" x-id="WLC.EZR.1.6.001" x-align="EZR.1.6.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EZR.1.6.002" x-align="EZR.1.6.a002" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.EZR.1.6.003" x-align="EZR.1.6.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="they that were round about" x-target-head="t006" x-head="true" lemma="סָבִיב" strong="H5439" x-morph="Ncbpc" x-gloss="around" x-translit="səḇiyḇōṯēy" xml:lang="hbo">סְבִיבֹֽתֵי</char><char style="w" x-id="WLC.EZR.1.6.004" x-align="EZR.1.6.a004" x-target-ids="t008" x-target="them" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="hem" xml:lang="hbo">הֶם֙</char> <char style="w" x-id="WLC.EZR.1.6.005" x-align="EZR.1.6.a005" x-target-ids="t009" x-target="strengthened" x-target-head="t009" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vpp3cp" x-gloss="they.strengthened" x-translit="ḥizzəqû" xml:lang="hbo">חִזְּק֣וּ</char> <char style="w" x-id="WLC.EZR.1.6.006" x-align="EZR.1.6.a006" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in)" x-translit="ḇi" xml:lang="hbo">בִֽ</char><char style="w" x-id="WLC.EZR.1.6.007" x-align="EZR.1.6.a007" x-target-ids="t011" x-target="hands" x-target-head="t011" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbdc" x-gloss="hands" x-translit="yḏēy" xml:lang="hbo">ידֵי</char><char style="w" x-id="WLC.EZR.1.6.008" x-align="EZR.1.6.a008" x-target-ids="t010" x-target="their" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo">הֶ֔ם