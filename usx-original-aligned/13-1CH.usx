	<para style="p"><verse number="25" style="v" x-ref="1CH.16.25" sid="1CH 16:25" /><char style="w" x-id="WLC.1CH.16.25.001" x-align="1CH.16.25.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּי֩</char> <char style="w" x-id="WLC.1CH.16.25.002" x-align="1CH.16.25.a002" x-target-ids="t002 t003" x-target="great is" x-target-head="t002" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="[is].great" x-translit="ḡāḏôl" xml:lang="hbo">גָד֨וֹל</char> <char style="w" x-id="WLC.1CH.16.25.003" x-align="1CH.16.25.a003" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֤ה</char> <char style="w" x-id="WLC.1CH.16.25.004" x-align="1CH.16.25.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.1CH.16.25.005" x-align="1CH.16.25.a005" x-target-ids="t007 t008 t009" x-target="to be praised" x-target-head="t009" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="VPsmsa" x-gloss="to.be.praised" x-translit="məhullāl" xml:lang="hbo">מְהֻלָּל֙</char> <char style="w" x-id="WLC.1CH.16.25.006" x-align="1CH.16.25.a006" x-target-ids="t006" x-target="greatly" x-target-head="t006" x-head="true" lemma="מְאֹד" strong="H3966" x-morph="D" x-gloss="exceedingly" x-translit="məʾōḏ" xml:lang="hbo">מְאֹ֔ד</char> <char style="w" x-id="WLC.1CH.16.25.007" x-align="1CH.16.25.a007" x-target-ids="t011" x-target="also" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.1CH.16.25.008" x-align="1CH.16.25.a008" x-target-ids="t012 t013 t014 t015" x-target="is to be feared" x-target-head="t015" x-head="true" lemma="יָ