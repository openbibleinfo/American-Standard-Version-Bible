	<para style="p"><verse number="3" style="v" x-ref="PSA.138.3" x-added-alignments="PSA.138.3.a003" x-added-target-ids="t004" x-added-target="that" sid="PSA 138:3" /><char style="w" x-id="WLC.PSA.138.3.001" x-align="PSA.138.3.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.138.3.002" x-align="PSA.138.3.a002" x-target-ids="t002 t003" x-target="the day" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yôm" xml:lang="hbo">י֣וֹם</char> <char style="w" x-id="WLC.PSA.138.3.003" x-align="PSA.138.3.a004" x-target-ids="t005 t006" x-target="I called" x-target-head="t006" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqp1cs" x-gloss="[when].I.called.out" x-translit="qārāʾṯî" xml:lang="hbo">קָ֭רָֽאתִי</char> <char style="w" x-id="WLC.PSA.138.3.004" x-align="PSA.138.3.a005" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.PSA.138.3.005" x-align="PSA.138.3.a006" x-target-ids="t007 t008" x-target="thou answeredst" x-target-head="t008" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqw2ms" x-gloss="you" x-translit="taʿăn" xml:lang="hbo">תַּעֲנֵ֑</char><char style="w" x-id="WLC.PSA.138.3.006" x-align="PSA.138.3.a007" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="answered.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.138.3.007" x-align="PSA.138.3.a008" x-target-ids="t010 t011 t012" x-target="Thou didst encourage" x-target-head="t012" x-head="true" lemma="רָהַב" strong="H7292" x-morph="Vhi2ms" x-gloss="you" x-translit="tarhiḇ" xml:lang="hbo">תַּרְהִבֵ֖</char><char style="w" x-id="WLC.PSA.138.3.008" x-align="PSA.138.3.a009" x-target-ids="t013" x-target=