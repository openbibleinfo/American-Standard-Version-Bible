	<para style="p"><verse number="3" style="v" x-ref="PSA.53.3" sid="PSA 53:3" /><char style="w" x-id="WLC.PSA.53.3.001" x-align="PSA.53.3.a001" x-target-ids="t001 t002" x-target="Every one" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.it" x-translit="kull" xml:lang="hbo" x-source-ref="PSA.53.4">כֻּלּ֥</char><char style="w" x-id="WLC.PSA.53.3.002" x-align="PSA.53.3.a002" x-target-ids="t003 t004" x-target="of them" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="all" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.53.4">וֹ</char> <char style="w" x-id="WLC.PSA.53.3.003" x-align="PSA.53.3.a003" x-target-ids="t005 t006 t007" x-target="is gone back" x-target-head="t006" x-head="true" lemma="סוּג" strong="H5472" x-morph="Vqp3ms" x-gloss="he.backslides" x-translit="sāḡ" xml:lang="hbo" x-source-ref="PSA.53.4">סָג֮</char> <char style="w" x-id="WLC.PSA.53.3.004" x-align="PSA.53.3.a005" x-target-ids="t010" x-target="together" x-target-head="t010" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="all.together" x-translit="yaḥdāw" xml:lang="hbo" x-source-ref="PSA.53.4">יַחְדָּ֪ו</char> <char style="w" x-id="WLC.PSA.53.3.005" x-align="PSA.53.3.a004" x-target-ids="t008 t009 t011 t012" x-target="they are become filthy" x-target-head="t012" x-head="true" lemma="אָלַח" strong="H444" x-morph="VNp3cp" x-gloss="they.are.corrupt" x-translit="neʾĕlāḥû" xml:lang="hbo" x-source-ref="PSA.53.4">נֶ֫אֱלָ֥חוּ</char> <char style="w" x-id="WLC.PSA.53.3.006" x-align="PSA.53.3.a006" x-target-ids="t013 t014 t015" x-target="There is none" x-target-head="t015" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo" x-source-ref="PSA.53.4">אֵ֤ין</char> <char style="w" x-id="WLC.PSA.53.3.007" x-align="PSA.53.3.a007" x-target-ids="t016 t017" x-target="that doeth" x-target-head="t017" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[one.who].does" x-translit="ʿōśēh-" xml:lang="hbo" x-source-ref="PSA.53.4">עֹֽשֵׂה</char>־<char style="w" x-id="WLC.PSA.53.3.008" x-align="PSA.53.3.a008" x-target-ids="t018" x-target="good" x-target-head="t018" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="(of).good" x-translit="ṭôḇ" xml:lang="hbo" x-source-ref="PSA.53.4">ט֑וֹב</char> <char style="w" x-id="WLC.PSA.53.3.009" x-align="PSA.53.3.a009" x-target-ids="t019 t020" x-target="no not" x-target-head="t019" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo" x-source-ref="PSA.53.4">אֵ֝֗ין</char> <char style="w" x-id="WLC.PSA.53.3.010" x-align="PSA.53.3.a010" x-status="unrepresented" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo" x-source-ref="PSA.53.4">גַּם</char>־<char style="w" x-id="WLC.PSA.53.3.011" x-align="PSA.53.3.a011" x-target-ids="t021" x-target="one" x-target-head="t021" x-head="true" lemma="אֶחָד" strong="H259" x-morph="Acmsa" x-gloss="one" x-translit="ʾeḥāḏ:" xml:lang="hbo" x-source-ref="PSA.53.4">אֶחָֽד</char>׃<verse eid="PSA 53:3" /></para>
	<para style="p"><verse number="4" style="v" x-ref="PSA.53.4" x-added-alignments="PSA.53.4.a009 PSA.53.4.a012" x-added-target-ids="t013 t017" x-added-target="as | And" sid="PSA 53:4" /><char style="w" x-id="WLC.PSA.53.4.001" x-align="PSA.53.4.a001" x-status="unrepresented" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="hă" xml:lang="hbo" x-source-ref="PSA.53.5">הֲ</char><char style="w" x-id="WLC.PSA.53.4.002" x-align="PSA.53.4.a003" x-target-ids="t006" x-target="no" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.53.5">לֹ֥א</char> <char style="w" x-id="WLC.PSA.53.4.003" x-align="PSA.53.4.a002" x-target-ids="t001 t007" x-target="Have knowledge" x-target-head="t007" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3cp" x-gloss="do.they.know" x-translit="yāḏʿû" xml:lang="hbo" x-source-ref="PSA.53.5">יָדְעוּ֮</char> <char style="w" x-id="WLC.PSA.53.4.004" x-align="PSA.53.4.a004" x-target-ids="t002 t003" x-target="the workers" x-target-head="t003" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqrmpc" x-gloss="[those.who].do" x-translit="pōʿălēy" xml:lang="hbo" x-source-ref="PSA.53.5">פֹּ֤עֲלֵ֫י</char> <char style="w" x-id="WLC.PSA.53.4.005" x-align="PSA.53.4.a005" x-target-ids="t004 t005" x-target="of iniquity" x-target-head="t005" x-head="true" lemma="אָוֶן" strong="H205" x-morph="Ncmsa" x-gloss="(of).wickedness" x-translit="ʾāwen" xml:lang="hbo" x-source-ref="PSA.53.5">אָ֥וֶן</char> <char style="w" x-id="WLC.PSA.53.4.006" x-align="PSA.53.4.a006" x-target-ids="t008 t009 t010" x-target="Who eat up" x-target-head="t009" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqrmpc" x-gloss="[those.who].devour" x-translit="ʾōḵəlēy" xml:lang="hbo" x-source-ref="PSA.53.5">אֹכְלֵ֣י</char> <char style="w" x-id="WLC.PSA.53.4.007" x-align="PSA.53.4.a008" x-target-ids="t012" x-target="people" x-target-head="t012" x-head="true" lemma="עַם" strong="H597