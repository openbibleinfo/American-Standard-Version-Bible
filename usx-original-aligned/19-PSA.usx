	<para style="p"><verse number="7" style="v" x-ref="PSA.6.7" sid="PSA 6:7" /><char style="w" x-id="WLC.PSA.6.7.001" x-align="PSA.6.7.a001" x-target-ids="t003 t004" x-target="wasteth away" x-target-head="t003" x-head="true" lemma="עָשֵׁשׁ" strong="H6244" x-morph="Vqp3fs" x-gloss="it.has.wasted.away" x-translit="ʿāšəšāh" xml:lang="hbo" x-source-ref="PSA.6.8">עָֽשְׁשָׁ֣ה</char> <char style="w" x-id="WLC.PSA.6.7.002" x-align="PSA.6.7.a002" x-target-ids="t005 t006" x-target="because of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.6.8">מִ</char><char style="w" x-id="WLC.PSA.6.7.003" x-align="PSA.6.7.a003" x-target-ids="t007" x-target="grief" x-target-head="t007" x-head="true" lemma="כַּעַס" strong="H3708" x-morph="Ncmsa" x-gloss="grief" x-translit="kaʿas" xml:lang="hbo" x-source-ref="PSA.6.8">כַּ֣עַס</char> <char style="w" x-id="WLC.PSA.6.7.004" x-align="PSA.6.7.a004" x-target-ids="t002" x-target="eye" x-target-head="t002" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbsc" x-gloss="eye" x-translit="ʿēyn" xml:lang="hbo" x-source-ref="PSA.6.8">עֵינִ֑</char><char style="w" x-id="WLC.PSA.6.7.005" x-align="PSA.6.7.a005" x-target-ids="t001" x-target="Mine" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.6.8">י</char> <char style="w" x-id="WLC.PSA.6.7.006" x-align="PSA.6.7.a006" x-target-ids="t008 t009 t010" x-target="It waxeth old" x-target-head="t010" x-head="true" lemma="עָתַק" strong="H6275" x-morph="Vqp3fs" x-gloss="it.has.grown.weak" x-translit="ʿāṯəqāh" xml:lang="hbo" x-source-ref="PSA.6.8">עָֽ֝תְקָ֗ה</char> <char style="w" x-id="WLC.PSA.6.7.007" x-align="PSA.6.7.a007" x-target-ids="t011 t012" x-target="because of" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.6.8">בְּ</char><char style="w