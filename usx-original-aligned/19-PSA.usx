	<para style="p"><verse number="1" style="v" x-ref="PSA.71.1" sid="PSA 71:1" /><char style="w" x-id="WLC.PSA.71.1.001" x-align="PSA.71.1.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="b" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.71.1.002" x-align="PSA.71.1.a002" x-target-ids="t002" x-target="thee" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā-" xml:lang="hbo">ךָֽ</char>־<char style="w" x-id="WLC.PSA.71.1.003" x-align="PSA.71.1.a003" x-target-ids="t003 t004" x-target="O Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֥ה</char> <char style="w" x-id="WLC.PSA.71.1.004" x-align="PSA.71.1.a004" x-target-ids="t005 t006 t007 t008" x-target="do I take refuge" x-target-head="t008" x-head="true" lemma="חָסָה" strong="H2620" x-morph="Vqp1cs" x-gloss="I.have.taken.refuge" x-translit="ḥāsiyṯî" xml:lang="hbo">חָסִ֑יתִי</char> <char style="w" x-id="WLC.PSA.71.1.005" x-align="PSA.71.1.a005" x-target-ids="t011" x-target="never" x-target-head="t011" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PSA.71.1.006" x-align="PSA.71.1.a006" x-target-ids="t009 t010 t012 t013 t014 t015" x-target="Let me be put to shame" x-target-head="t015" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqh1cs" x-gloss="let.me.be.ashamed" x-translit="ʾēḇôšâ" xml:lang="hbo">אֵב֥וֹשָׁה</char> <char style="w" x-id="WLC.PSA.71.1.007" x-align="PSA.71.1.a005" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.71.1.008" x-align="PSA.71.1.a005" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām:" xml:lang="hbo">עוֹלָֽם</char>׃<verse eid="PSA 71:1" /></par