	<para style="p"><verse number="3" style="v" x-ref="PSA.7.3" sid="PSA 7:3" /><char style="w" x-id="WLC.PSA.7.3.001" x-align="PSA.7.3.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.7.4">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.7.3.002" x-align="PSA.7.3.a002" x-target-ids="t004" x-target="God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōh" xml:lang="hbo" x-source-ref="PSA.7.4">אֱ֭לֹהַ</char><char style="w" x-id="WLC.PSA.7.3.003" x-align="PSA.7.3.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo" x-source-ref="PSA.7.4">י</char> <char style="w" x-id="WLC.PSA.7.3.004" x-align="PSA.7.3.a004" x-target-ids="t005" x-target="if" x-target-head="t005" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="PSA.7.4">אִם</char>־<char style="w" x-id="WLC.PSA.7.3.005" x-align="PSA.7.3.a005" x-target-ids="t006 t007 t008" x-target="I have done" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp1cs" x-gloss="I.have.done" x-translit="ʿāśiyṯî" xml:lang="hbo" x-source-ref="PSA.7.4">עָשִׂ֣יתִי</char> <char style="w" x-id="WLC.PSA.7.3.006" x-align="PSA.7.3.a006" x-target-ids="t009" x-target="this" x-target-head="t009" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo" x-source-ref="PSA.7.4">זֹ֑את</char> <char style="w" x-id="WLC.PSA.7.3.007" x-align="PSA.7.3.a007" x-target-ids="t010" x-target="If" x-target-head="t010" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="PSA.7.4">אִֽם</char>־<char style="w" x-id="WLC.PSA.7.3.008" x-align="PSA.7.3.a008" x-target-ids=