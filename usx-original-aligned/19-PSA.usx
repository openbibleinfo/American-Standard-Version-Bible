	<para style="p"><verse number="4" style="v" x-ref="PSA.8.4" sid="PSA 8:4" /><char style="w" x-id="WLC.PSA.8.4.001" x-align="PSA.8.4.a001" x-target-ids="t001" x-target="What" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh-" xml:lang="hbo" x-source-ref="PSA.8.5">מָֽה</char>־<char style="w" x-id="WLC.PSA.8.4.002" x-align="PSA.8.4.a002" x-target-ids="t002 t003" x-target="is man" x-target-head="t003" x-head="true" lemma="אֱנוֹשׁ" strong="H582" x-morph="Ncmsa" x-gloss="[is].humankind" x-translit="ʾĕnôš" xml:lang="hbo" x-source-ref="PSA.8.5">אֱנ֥וֹשׁ</char> <char style="w" x-id="WLC.PSA.8.4.003" x-align="PSA.8.4.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.8.5">כִּֽי</char>־<char style="w" x-id="WLC.PSA.8.4.004" x-align="PSA.8.4.a004" x-target-ids="t005 t006 t007" x-target="thou art mindful" x-target-head="t007" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqi2ms" x-gloss="you" x-translit="ṯizkər" xml:lang="hbo" x-source-ref="PSA.8.5">תִזְכְּרֶ֑</char><char style="w" x-id="WLC.PSA.8.4.005" x-align="PSA.8.4.a005" x-target-ids="t008 t009" x-target="of him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="will.remember.him" x-translit="ennû" xml:lang="hbo" x-source-ref="PSA.8.5">נּוּ</char> <char style="w" x-id="WLC.PSA.8.4.006" x-align="PSA.8.4.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.8.5">וּ</char><char style="w" x-id="WLC.PSA.8.4.007" x-align="PSA.8.4.a007" x-target-ids="t011 t012" x-target="the son" x-target-head="t012" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="a.son" x-translit="ḇen-" xml:lang="hbo" x-source-ref="PSA.8.5">בֶן</char>־<char style="w" x-id="WLC.PSA.8.4.008"