	<para style="p"><verse number="15" style="v" x-ref="PSA.73.15" sid="PSA 73:15" /><char style="w" x-id="WLC.PSA.73.15.001" x-align="PSA.73.15.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PSA.73.15.002" x-align="PSA.73.15.a002" x-target-ids="t002 t003 t004" x-target="I had said" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp1cs" x-gloss="I.had.said" x-translit="ʾāmartî" xml:lang="hbo">אָ֭מַרְתִּי</char> <char style="w" x-id="WLC.PSA.73.15.003" x-align="PSA.73.15.a003" x-target-ids="t005 t006 t007" x-target="I will speak" x-target-head="t007" x-head="true" lemma="סָפַר" strong="H5608" x-morph="Vph1cs" x-gloss="I.will.speak" x-translit="ʾăsappərāh" xml:lang="hbo">אֲסַפְּרָ֥ה</char> <char style="w" x-id="WLC.PSA.73.15.004" x-align="PSA.73.15.a004" x-target-ids="t008" x-target="thus" x-target-head="t008" x-head="true" lemma="כְּמוֹ" strong="H3644" x-morph="R" x-gloss="like" x-translit="ḵəmô" xml:lang="hbo">כְמ֑וֹ</char> <char style="w" x-id="WLC.PSA.73.15.005" x-align="PSA.73.15.a005" x-target-ids="t009" x-target="Behold" x-target-head="t009" x-head="true" lemma="הִנֵּה" strong="H2008" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֤ה</char> <char style="w" x-id="WLC.PSA.73.15.006" x-align="PSA.73.15.a007" x-target-ids="t015 t016" x-target="the generation" x-target-head="t016" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsc" x-gloss="the.generation" x-translit="ḏôr" xml:lang="hbo">ד֭וֹר</char> <char style="w" x-id="WLC.PSA.73.15.007" x-align="PSA.73.15.a008" x-target-ids="t017 t019" x-target="of children" x-target-head="t019" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="your.children" x-translit="bāney" xml:lang="hbo">בָּנֶ֣י</char><char style="w" x-id="WLC.PSA.73.15.008" x-align="PSA.73.15.a009" x-target-ids="t018" x-target="thy" x-target-h