	<para style="p"><verse number="2" style="v" x-ref="PSA.46.2" sid="PSA 46:2" /><char style="w" x-id="WLC.PSA.46.2.001" x-align="PSA.46.2.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.46.3">עַל</char>־<char style="w" x-id="WLC.PSA.46.2.002" x-align="PSA.46.2.a001" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo" x-source-ref="PSA.46.3">כֵּ֣ן</char> <char style="w" x-id="WLC.PSA.46.2.003" x-align="PSA.46.2.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.46.3">לֹא</char>־<char style="w" x-id="WLC.PSA.46.2.004" x-align="PSA.46.2.a003" x-target-ids="t002 t003 t005" x-target="will we fear" x-target-head="t005" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqi1cp" x-gloss="we.will.fear" x-translit="nîrāʾ" xml:lang="hbo" x-source-ref="PSA.46.3">נִ֭ירָא</char> <char style="w" x-id="WLC.PSA.46.2.005" x-align="PSA.46.2.a004" x-target-ids="t006" x-target="though" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.46.3">בְּ</char><char style="w" x-id="WLC.PSA.46.2.006" x-align="PSA.46.2.a005" x-target-ids="t009 t010" x-target="do change" x-target-head="t010" x-head="true" lemma="מוּר" strong="H4171a" x-morph="Vhc" x-gloss="changes" x-translit="hāmiyr" xml:lang="hbo" x-source-ref="PSA.46.3">הָמִ֣יר</char> <char style="w" x-id="WLC.PSA.46.2.007" x-align="PSA.46.2.a006" x-target-ids="t007 t008" x-target="the earth" x-target-head="t008" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].earth" x-translit="ʾāreṣ" xml:lang="hbo" x-source-ref="PSA.46.3">אָ֑רֶץ</char> <char style="w" x-id="WLC.PSA.46.2.008" x-align="PSA.46.2.a007" x-target-ids="t011" x-target="And" x-target-he