	<para style="p"><verse number="1" style="v" x-ref="PSA.25.1" x-added-alignments="PSA.25.1.a001" x-added-target-ids="t001 t002" x-added-target="A Psalm" sid="PSA 25:1" /><char style="w" x-id="WLC.PSA.25.1.001" x-align="PSA.25.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.25.1.002" x-align="PSA.25.1.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָוִ֡ד</char><char style="w" x-id="WLC.PSA.25.1.003" x-align="PSA.25.1.a004" x-target-ids="t005" x-target="Unto" x-target-head="t005" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēley" xml:lang="hbo">אֵלֶ֥י</char><char style="w" x-id="WLC.PSA.25.1.004" x-align="PSA.25.1.a005" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.25.1.005" x-align="PSA.25.1.a006" x-target-ids="t007 t008" x-target="O Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְ֝הוָ֗ה</char> <char style="w" x-id="WLC.PSA.25.1.006" x-align="PSA.25.1.a007" x-target-ids="t014" x-target="soul" x-target-head="t014" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="desire" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֥</char><char style="w" x-id="WLC.PSA.25.1.007" x-align="PSA.25.1.a008" x-target-ids="t013" x-target="my" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.25.1.008" x-align="PSA.25.1.a009" x-target-ids="t009 t010 t011 t012" x-target="do I lift up" x-target-head="t011" x-head="true" lem