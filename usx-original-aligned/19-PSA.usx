	<para style="d" x-ref="PSA.53.0"><char style="w" x-id="WLC.PSA.53.0.001" x-align="PSA.53.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.53.1">לַ</char><char style="w" x-id="WLC.PSA.53.0.002" x-align="PSA.53.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.53.1">[הַ]</char><char style="w" x-id="WLC.PSA.53.0.003" x-align="PSA.53.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.53.1">מְנַצֵּ֥חַ</char> <char style="w" x-id="WLC.PSA.53.0.004" x-align="PSA.53.0.a004" x-target-ids="t005 t006" x-target="set to" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.53.1">עַֽל</char>־<char style="w" x-id="WLC.PSA.53.0.005" x-align="PSA.53.0.a005" x-target-ids="t007" x-target="Mahalath" x-target-head="t007" x-head="true" lemma="מַחֲלַת" strong="H4257" x-morph="Ncfsa" x-gloss="machalath" x-translit="māḥălaṯ" xml:lang="hbo" x-source-ref="PSA.53.1">מָחֲלַ֗ת</char> <char style="w" x-id="WLC.PSA.53.0.006" x-align="PSA.53.0.a006" x-target-ids="t008" x-target="Maschil" x-target-head="t008" x-head="true" lemma="מַשְׂכִּיל" strong="H4905" x-morph="Ncmsa" x-gloss="a.poem" x-translit="maśkiyl" xml:lang="hbo" x-source-ref="PSA.53.1">מַשְׂכִּ֥יל</char> <char style="w" x-id="WLC.PSA.53.0.007" x-align="PSA.53.0.a007" x-target-ids="t009" x-target="of" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.53.1">לְ</char><char style="w" x-id="WLC.PSA.53.0.008" x-align="PSA.53.0.a008" x-target-ids="t010" x-target="David" x-target-head="t010" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ:" xml:lang="hbo" x-source-ref="PSA.53.1">דָוִֽד</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.53.1" sid="PSA 53:1" /><char style="w" x-id="WLC.PSA.53.1.001" x-align="PSA.53.1.a002" x-target-ids="t003 t004" x-target="hath said" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo" x-source-ref="PSA.53.2">אָ֘מַ֤ר</char> <char style="w" x-id="WLC.PSA.53.1.002" x-align="PSA.53.1.a001" x-target-ids="t001 t002" x-target="The fool" x-target-head="t002" x-head="true" lemma="נָבָל" strong="H5036" x-morph="Aamsa" x-gloss="a.fool" x-translit="nāḇāl" xml:lang="hbo" x-source-ref="PSA.53.2">נָבָ֣ל</char> <char style="w" x-id="WLC.PSA.53.1.003" x-align="PSA.53.1.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.53.2">בְּ֭</char><char style="w" x-id="WLC.PSA.53.1.004" x-align="PSA.53.1.a005" x-target-ids="t007" x-target="heart" x-target-head="t007" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo" x-source-ref="PSA.53.2">לִבּ</char><char style="w" x-id="WLC.PSA.53.1.005" x-align="PSA.53.1.a004" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.53.2">וֹ</char> <char style="w" x-id="WLC.PSA.53.1.006" x-align="PSA.53.1.a006" x-target-ids="t008 t009 t010" x-target="There is no" x-target-head="t010" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo" x-source-ref="PSA.53.2">אֵ֣ין</char> <char style="w" x-id="WLC.PSA.53.1.007" x-align="PSA.53.1.a007" x-target-ids="t011" x-target="God" x-target-head="t011" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="a.god" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.53.2">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.53.1.008" x-align="PSA.53.1.a008" x-target-ids="t012 t013 t014" x-target="Corrupt are they" x-target-head="t012" x-head="true" lemma="שָׁחַת" strong="H7843" x-morph="Vhp3cp" x-gloss="they.behave.corruptly" x-translit="hišəḥiyṯû" xml:lang="hbo" x-source-ref="PSA.53.2">הִֽ֝שְׁחִ֗יתוּ</char> <char style="w" x-id="WLC.PSA.53.1.009" x-align="PSA.53.1.a009" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.53.2">וְ</char><char style="w" x-id="WLC.PSA.53.1.010" x-align="PSA.53.1.a010" x-target-ids="t016 t017 t018" x-target="have done abominable" x-target-head="t018" x-head="true" lemma="תַּעָב" strong="H8581" x-morph="Vhp3cp" x-gloss="they.do.abominably" x-translit="hiṯəʿiyḇû" xml:lang="hbo" x-source-ref="PSA.53.2">הִֽתְעִ֥יבוּ</char> <char style="w" x-id="WLC.PSA.53.1.011" x-align="PSA.53.1.a011" x-target-ids="t019" x-target="iniquity" x-target-head="t019" x-head="true" lemma="עָוֶל" strong="H5766" x-morph="Ncbsa" x-gloss="unrighteousness" x-translit="ʿāwel" xml:lang="hbo" x-source-ref="PSA.53.2">עָ֝֗וֶל</char> <char style="w" x-id="WLC.PSA.53.1.012" x-align="PSA.53.1.a012" x-target-ids="t020 t021 t022" x-target="There is none" x-target-head="t022" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo" x-source-ref="PSA.53.2">אֵ֣ין</char> <char style="w" x-id="WLC.PSA.53.1.013" x-align="PSA.53.1.a013" x-target-ids="t023 t024" x-target="that doeth" x-target-head="t024" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[one.who].does" x-translit="ʿōśēh-" xml:lang="hbo" x-source-ref="PSA.53.2">עֹֽשֵׂה</char>־<char style="w" x-id="WLC.PSA.53.1.014" x-align="PSA.53.1.a014" x-target-ids="t025" x-target="good" x-target-head="t025" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="(of).good" x-translit="ṭôḇ:" xml:lang="hbo" x-source-ref="PSA.53.2">טֽוֹב</char>׃<ver