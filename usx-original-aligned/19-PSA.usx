	<para style="p"><verse number="8" style="v" x-ref="PSA.119.8" x-added-alignments="PSA.119.8.a006 PSA.119.8.a010" x-added-target-ids="t006 t011 t012" x-added-target="Oh | ב Beth" sid="PSA 119:8" /><char style="w" x-id="WLC.PSA.119.8.001" x-align="PSA.119.8.a001" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.119.8.002" x-align="PSA.119.8.a002" x-target-ids="t005" x-target="statutes" x-target-head="t005" x-head="true" lemma="חֹק" strong="H2706" x-morph="Ncmpc" x-gloss="decrees" x-translit="ḥuqqey" xml:lang="hbo">חֻקֶּ֥י</char><char style="w" x-id="WLC.PSA.119.8.003" x-align="PSA.119.8.a003" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.8.004" x-align="PSA.119.8.a004" x-target-ids="t001 t002 t003" x-target="I will observe" x-target-head="t003" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqi1cs" x-gloss="I.will.keep" x-translit="ʾešmōr" xml:lang="hbo">אֶשְׁמֹ֑ר</char> <char style="w" x-id="WLC.PSA.119.8.005" x-align="PSA.119.8.a005" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.PSA.119.8.006" x-align="PSA.119.8.a007" x-target-ids="t007" x-target="forsake" x-target-head="t007" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqj2ms" x-gloss="forsake" x-translit="taʿazḇ" xml:lang="hbo">תַּעַזְבֵ֥</char><char style="w" x-id="WLC.PSA.119.8.007" x-align="PSA.119.8.a008" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.8.008" x-align="PSA.119.8.a009" lemma="עַד" strong="H5704" x-morph="R"