	<para style="p"><verse number="18" style="v" x-ref="PSA.51.18" sid="PSA 51:18" /><char style="w" x-id="WLC.PSA.51.18.001" x-align="PSA.51.18.a001" x-target-ids="t001 t002" x-target="Do good" x-target-head="t002" x-head="true" lemma="יָטַב" strong="H3190" x-morph="Vhv2ms" x-gloss="do" x-translit="hēyṭiyḇ" xml:lang="hbo" x-source-ref="PSA.51.20">הֵיטִ֣יבָ</char><char style="w" x-id="WLC.PSA.51.18.002" x-align="PSA.51.18.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-gloss="good.to" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.51.20">ה</char> <char style="w" x-id="WLC.PSA.51.18.003" x-align="PSA.51.18.a003" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇi" xml:lang="hbo" x-source-ref="PSA.51.20">בִ֭</char><char style="w" x-id="WLC.PSA.51.18.004" x-align="PSA.51.18.a004" x-target-ids="t005 t006" x-target="good pleasure" x-target-head="t006" x-head="true" lemma="רָצוֹן" strong="H7522" x-morph="Ncmsc" x-gloss="favor" x-translit="rəṣôn" xml:lang="hbo" x-source-ref="PSA.51.20">רְצוֹנְ</char><char style="w" x-id="WLC.PSA.51.18.005" x-align="PSA.51.18.a005" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.51.20">ךָ</char> <char style="w" x-id="WLC.PSA.51.18.006" x-align="PSA.51.18.a006" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="PSA.51.20">אֶת</char>־<char style="w" x-id="WLC.PSA.51.18.007" x-align="PSA.51.18.a007" x-target-ids="t008" x-target="Zion" x-target-head="t008" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="Zion" x-translit="ṣiyyôn" xml:lang="hbo" x-source-ref="PSA.51.20">צִיּ֑וֹן</char> <char style="w" x-id="WLC.PSA.51.18.008" x-align="PSA.51.18.a008" x-target-i