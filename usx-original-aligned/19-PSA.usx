	<para style="p"><verse number="3" style="v" x-ref="PSA.113.3" sid="PSA 113:3" /><char style="w" x-id="WLC.PSA.113.3.001" x-align="PSA.113.3.a001" x-target-ids="t001" x-target="From" x-target-head="t001" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.113.3.002" x-align="PSA.113.3.a002" x-target-ids="t002 t003" x-target="the rising" x-target-head="t003" x-head="true" lemma="מִזְרָח" strong="H4217" x-morph="Ncmsc" x-gloss="rising" x-translit="mmizraḥ-" xml:lang="hbo">מִּזְרַח</char>־<char style="w" x-id="WLC.PSA.113.3.003" x-align="PSA.113.3.a003" x-target-ids="t004 t005 t006" x-target="of the sun" x-target-head="t006" x-head="true" lemma="שֶׁמֶשׁ" strong="H8121" x-morph="Ncbsa" x-gloss="of.[the].sun" x-translit="šemeš" xml:lang="hbo">שֶׁ֥מֶשׁ</char> <char style="w" x-id="WLC.PSA.113.3.004" x-align="PSA.113.3.a004" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="to" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PSA.113.3.005" x-align="PSA.113.3.a005" x-target-ids="t008 t009 t010" x-target="the going down" x-target-head="t009" x-head="true" lemma="מָבוֹא" strong="H3996" x-morph="Ncmsc" x-gloss="setting" x-translit="məḇôʾ" xml:lang="hbo">מְבוֹא֑</char><char style="w" x-id="WLC.PSA.113.3.006" x-align="PSA.113.3.a006" x-target-ids="t011 t012 t013" x-target="of the same" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.113.3.007" x-align="PSA.113.3.a007" x-target-ids="t016 t017 t018 t019" x-target="is to be praised" x-target-head="t019" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="VPsmsa" x-gloss="[is].to.be.praised" x-translit="məhullāl" xml:lang="hbo">מְ֝הֻלָּ֗ל</char> <char style="w" x-id="WLC.PSA.113.3.008" x-align="PSA.113.3.a008" x-target-ids="t015" x-target