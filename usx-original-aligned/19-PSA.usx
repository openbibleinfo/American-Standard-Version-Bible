	<para style="p"><verse number="22" style="v" x-ref="PSA.118.22" x-added-alignments="PSA.118.22.a002" x-added-target-ids="t003" x-added-target="which" sid="PSA 118:22" /><char style="w" x-id="WLC.PSA.118.22.001" x-align="PSA.118.22.a001" x-target-ids="t001 t002" x-target="The stone" x-target-head="t002" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="a.stone" x-translit="ʾeḇen" xml:lang="hbo">אֶ֭בֶן</char> <char style="w" x-id="WLC.PSA.118.22.002" x-align="PSA.118.22.a003" x-target-ids="t006" x-target="rejected" x-target-head="t006" x-head="true" lemma="מָאַס" strong="H3988" x-morph="Vqp3cp" x-gloss="[which].they.rejected" x-translit="māʾăsû" xml:lang="hbo">מָאֲס֣וּ</char> <char style="w" x-id="WLC.PSA.118.22.003" x-align="PSA.118.22.a004" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PSA.118.22.004" x-align="PSA.118.22.a005" x-target-ids="t005" x-target="builders" x-target-head="t005" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="Vqrmpa" x-gloss="builders" x-translit="bôniym" xml:lang="hbo">בּוֹנִ֑ים</char> <char style="w" x-id="WLC.PSA.118.22.005" x-align="PSA.118.22.a006" x-target-ids="t007 t008" x-target="Is become" x-target-head="t008" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3fs" x-gloss="it.has.become" x-translit="hāyəṯāh" xml:lang="hbo">הָ֝יְתָ֗ה</char> <char style="w" x-id="WLC.PSA.118.22.006" x-align="PSA.118.22.a007" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(into).[the]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.118.22.007" x-align="PSA.118.22.a008" x-target-ids="t009 t010" x-target="the head" x-target-head="t010" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsc" x-gloss="head" x-translit="rōʾš" xml:lang="hbo">רֹ֣אשׁ</char> <char style="w" x-id="WLC.PSA.118.22.008" x-align="PSA.118.22.a009" x-t