	<para style="p"><verse number="39" style="v" x-ref="PSA.18.39" sid="PSA 18:39" /><char style="w" x-id="WLC.PSA.18.39.001" x-align="PSA.18.39.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.18.40">וַ</char><char style="w" x-id="WLC.PSA.18.39.002" x-align="PSA.18.39.a002" x-target-ids="t002 t003 t004" x-target="thou hast girded" x-target-head="t004" x-head="true" lemma="אָזַר" strong="H247" x-morph="Vpw2ms" x-gloss="you" x-translit="təʾazzər" xml:lang="hbo" x-source-ref="PSA.18.40">תְּאַזְּרֵ֣</char><char style="w" x-id="WLC.PSA.18.39.003" x-align="PSA.18.39.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="girded.me" x-translit="ēniy" xml:lang="hbo" x-source-ref="PSA.18.40">נִי</char> <char style="w" x-id="WLC.PSA.18.39.004" x-align="PSA.18.39.a004" x-target-ids="t006 t007" x-target="with strength" x-target-head="t007" x-head="true" lemma="חַיִל" strong="H2428" x-morph="Ncmsa" x-gloss="strength" x-translit="ḥayil" xml:lang="hbo" x-source-ref="PSA.18.40">חַ֭יִל</char> <char style="w" x-id="WLC.PSA.18.39.005" x-align="PSA.18.39.a005" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo" x-source-ref="PSA.18.40">לַ</char><char style="w" x-id="WLC.PSA.18.39.006" x-align="PSA.18.39.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.18.40">[הַ]</char><char style="w" x-id="WLC.PSA.18.39.007" x-align="PSA.18.39.a007" x-target-ids="t010" x-target="battle" x-target-head="t010" x-head="true" lemma="מִלְחָמָה" strong="H4421" x-morph="Ncfsa" x-gloss="battle" x-translit="mmilḥāmāh" xml:lang="hbo" x-source-ref="PSA.18.40">מִּלְחָמָ֑ה</char> <char s