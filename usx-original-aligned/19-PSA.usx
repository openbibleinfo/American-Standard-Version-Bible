	<para style="p"><verse number="8" style="v" x-ref="PSA.44.8" sid="PSA 44:8" /><char style="w" x-id="WLC.PSA.44.8.001" x-align="PSA.44.8.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bē" xml:lang="hbo" x-source-ref="PSA.44.9">בֵּֽ֭</char><char style="w" x-id="WLC.PSA.44.8.002" x-align="PSA.44.8.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾlōhîm" xml:lang="hbo" x-source-ref="PSA.44.9">אלֹהִים</char> <char style="w" x-id="WLC.PSA.44.8.003" x-align="PSA.44.8.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="have we made our boast" x-target-head="t007" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpp1cp" x-gloss="we.have.boasted" x-translit="hillalənû" xml:lang="hbo" x-source-ref="PSA.44.9">הִלַּלְ֣נוּ</char><char style="w" x-id="WLC.PSA.44.8.004" x-align="PSA.44.8.a004" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.44.9">כָל</char>־<char style="w" x-id="WLC.PSA.44.8.005" x-align="PSA.44.8.a005" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.44.9">הַ</char><char style="w" x-id="WLC.PSA.44.8.006" x-align="PSA.44.8.a006" x-target-ids="t010 t011" x-target="day long" x-target-head="t010" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo" x-source-ref="PSA.44.9">יּ֑וֹם</char> <char style="w" x-id="WLC.PSA.44.8.007" x-align="PSA.44.8.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.44.9">וְ</char><char style="w" x-id="WLC.PSA.44.8.008