	<para style="p"><verse number="17" style="v" x-ref="PSA.37.17" sid="PSA 37:17" /><char style="w" x-id="WLC.PSA.37.17.001" x-align="PSA.37.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PSA.37.17.002" x-align="PSA.37.17.a002" x-target-ids="t002 t003" x-target="the arms" x-target-head="t003" x-head="true" lemma="זְרוֹעַ" strong="H2220" x-morph="Ncbpc" x-gloss="[the].arms" x-translit="zərôʿôṯ" xml:lang="hbo">זְרוֹע֣וֹת</char> <char style="w" x-id="WLC.PSA.37.17.003" x-align="PSA.37.17.a003" x-target-ids="t004 t005 t006" x-target="of the wicked" x-target-head="t006" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿîm" xml:lang="hbo">רְ֭שָׁעִים</char> <char style="w" x-id="WLC.PSA.37.17.004" x-align="PSA.37.17.a004" x-target-ids="t007 t008 t009" x-target="shall be broken" x-target-head="t009" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="VNi3fp" x-gloss="they.will.be.broken" x-translit="tiššāḇarənâ" xml:lang="hbo">תִּשָּׁבַ֑רְנָה</char> <char style="w" x-id="WLC.PSA.37.17.005" x-align="PSA.37.17.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.37.17.006" x-align="PSA.37.17.a006" x-target-ids="t012" x-target="upholdeth" x-target-head="t012" x-head="true" lemma="סָמַךְ" strong="H5564" x-morph="Vqrmsa" x-gloss="sustaining" x-translit="sômēḵ" xml:lang="hbo">סוֹמֵ֖ךְ</char> <char style="w" x-id="WLC.PSA.37.17.007" x-align="PSA.37.17.a007" x-target-ids="t013 t014" x-target="the righteous" x-target-head="t014" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַדִּיקִ֣ים</char> <char style="w" x-id="WLC.PSA.37.17.008" x-align="PSA