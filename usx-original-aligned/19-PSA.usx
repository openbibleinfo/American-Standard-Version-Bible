	<para style="p"><verse number="9" style="v" x-ref="PSA.116.9" sid="PSA 116:9" /><char style="w" x-id="WLC.PSA.116.9.001" x-align="PSA.116.9.a001" x-target-ids="t001 t002 t003" x-target="I will walk" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vti1cs" x-gloss="I.will.walk.about" x-translit="ʾeṯhallēḵ" xml:lang="hbo">אֶ֭תְהַלֵּךְ</char> <char style="w" x-id="WLC.PSA.116.9.002" x-align="PSA.116.9.a002" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.116.9.003" x-align="PSA.116.9.a002" x-target-ids="t004" x-target="before" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ənēy" xml:lang="hbo">פְנֵ֣י</char> <char style="w" x-id="WLC.PSA.116.9.004" x-align="PSA.116.9.a003" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.116.9.005" x-align="PSA.116.9.a004" x-target-ids="t006" x-target="In" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֝</char><char style="w" x-id="WLC.PSA.116.9.006" x-align="PSA.116.9.a005" x-target-ids="t007 t008" x-target="the land" x-target-head="t008" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbpc" x-gloss="the.lands" x-translit="ʾarṣôṯ" xml:lang="hbo">אַרְצ֗וֹת</char> <char style="w" x-id="WLC.PSA.116.9.007" x-align="PSA.116.9.a006" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַֽ</char><char style="w" x-id="WLC.PSA.116.9.008" x-align="PSA.116.9.a007" x-target-ids="t009 t011" x-target="of living" x-target-head="t011" x-head="true" lemma="חַי" strong="H2416" x-morph="Aampa" x-gloss="the.living" x-translit="ḥayyiym:" xml:lang="hbo">חַיִּֽים</char>׃<ve