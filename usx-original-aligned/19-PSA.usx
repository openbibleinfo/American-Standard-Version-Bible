	<para style="p"><verse number="37" style="v" x-ref="PSA.89.37" x-added-alignments="PSA.89.37.a007" x-added-target-ids="t011" x-added-target="as" sid="PSA 89:37" /><char style="w" x-id="WLC.PSA.89.37.001" x-align="PSA.89.37.a001" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like.[the]" x-translit="kə" xml:lang="hbo" x-source-ref="PSA.89.38">כְּ֭</char><char style="w" x-id="WLC.PSA.89.37.002" x-align="PSA.89.37.a002" x-target-ids="t008 t009" x-target="the moon" x-target-head="t009" x-head="true" lemma="יָרֵחַ" strong="H3394" x-morph="Ncmsa" x-gloss="moon" x-translit="yārēᵃḥ" xml:lang="hbo" x-source-ref="PSA.89.38">יָרֵחַ</char> <char style="w" x-id="WLC.PSA.89.37.003" x-align="PSA.89.37.a003" x-target-ids="t001 t002 t003 t004" x-target="It shall be established" x-target-head="t004" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNi3ms" x-gloss="it.will.be.established" x-translit="yikôn" xml:lang="hbo" x-source-ref="PSA.89.38">יִכּ֣וֹן</char> <char style="w" x-id="WLC.PSA.89.37.004" x-align="PSA.89.37.a004" x-target-ids="t005 t006" x-target="for ever" x-target-head="t006" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="forever" x-translit="ʿôlām" xml:lang="hbo" x-source-ref="PSA.89.38">עוֹלָ֑ם</char> <char style="w" x-id="WLC.PSA.89.37.005" x-align="PSA.89.37.a005" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.89.38">וְ</char><char style="w" x-id="WLC.PSA.89.37.006" x-align="PSA.89.37.a006" x-target-ids="t012 t014" x-target="the witness" x-target-head="t014" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsa" x-gloss="a.witness" x-translit="ʿēḏ" xml:lang="hbo" x-source-ref="PSA.89.38">עֵ֥ד</char> <char style="w" x-id="WLC.PSA.89.37.007" x-align="PSA.89.37.a008" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma="בְּ" s