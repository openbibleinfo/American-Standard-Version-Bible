	<para style="p"><verse number="11" style="v" x-ref="PSA.30.11" sid="PSA 30:11" /><char style="w" x-id="WLC.PSA.30.11.001" x-align="PSA.30.11.a001" x-target-ids="t001 t002 t003" x-target="Thou hast turned" x-target-head="t003" x-head="true" lemma="הָפַךְ" strong="H2015" x-morph="Vqp2ms" x-gloss="you.turned" x-translit="hāp̄aḵətā" xml:lang="hbo" x-source-ref="PSA.30.12">הָפַ֣כְתָּ</char> <char style="w" x-id="WLC.PSA.30.11.002" x-align="PSA.30.11.a002" x-target-ids="t007" x-target="mourning" x-target-head="t007" x-head="true" lemma="מִסְפֵּד" strong="H4553" x-morph="Ncmsc" x-gloss="wailing" x-translit="mispəḏ" xml:lang="hbo" x-source-ref="PSA.30.12">מִסְפְּדִ</char><char style="w" x-id="WLC.PSA.30.11.003" x-align="PSA.30.11.a003" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.30.12">י֮</char> <char style="w" x-id="WLC.PSA.30.11.004" x-align="PSA.30.11.a004" x-target-ids="t008" x-target="into" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="into" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.30.12">לְ</char><char style="w" x-id="WLC.PSA.30.11.005" x-align="PSA.30.11.a005" x-target-ids="t009" x-target="dancing" x-target-head="t009" x-head="true" lemma="מָחוֹל" strong="H4234" x-morph="Ncmsa" x-gloss="dancing" x-translit="māḥôl" xml:lang="hbo" x-source-ref="PSA.30.12">מָח֪וֹל</char> <char style="w" x-id="WLC.PSA.30.11.006" x-align="PSA.30.11.a006" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo" x-source-ref="PSA.30.12">לִ֥</char><char style="w" x-id="WLC.PSA.30.11.007" x-align="PSA.30.11.a007" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.30.12">י</char> <char style="w" x-id="W