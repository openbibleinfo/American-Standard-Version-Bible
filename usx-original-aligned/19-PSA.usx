	<para style="p"><verse number="5" style="v" x-ref="PSA.60.5" sid="PSA 60:5" /><char style="w" x-id="WLC.PSA.60.5.001" x-align="PSA.60.5.a001" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="so.that" x-translit="ləmaʿan" xml:lang="hbo" x-source-ref="PSA.60.7">לְ֭מַעַן</char> <char style="w" x-id="WLC.PSA.60.5.002" x-align="PSA.60.5.a004" x-target-ids="t004 t005 t006" x-target="may be delivered" x-target-head="t006" x-head="true" lemma="חָלַץ" strong="H2502" x-morph="VNi3mp" x-gloss="they" x-translit="yēḥāləṣû" xml:lang="hbo" x-source-ref="PSA.60.7">יֵחָלְצ֣וּ</char><char style="w" x-id="WLC.PSA.60.5.003" x-align="PSA.60.5.a005" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="may.be.rescued" x-translit="n" xml:lang="hbo" x-source-ref="PSA.60.7">ן</char> <char style="w" x-id="WLC.PSA.60.5.004" x-align="PSA.60.5.a003" x-target-ids="t003" x-target="beloved" x-target-head="t003" x-head="true" lemma="יָדִיד" strong="H3039" x-morph="Aampc" x-gloss="your.beloved" x-translit="yəḏiyḏey" xml:lang="hbo" x-source-ref="PSA.60.7">יְדִידֶ֑י</char><char style="w" x-id="WLC.PSA.60.5.005" x-align="PSA.60.5.a002" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="[ones]" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.60.7">ךָ</char> <char style="w" x-id="WLC.PSA.60.5.006" x-align="PSA.60.5.a006" x-target-ids="t007" x-target="Save" x-target-head="t007" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="Vhv2ms" x-gloss="save" x-translit="hôšiyʿ" xml:lang="hbo" x-source-ref="PSA.60.7">הוֹשִׁ֖יעָ</char><char style="w" x-id="WLC.PSA.60.5.007" x-align="PSA.60.5.a007" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.60.7">ה</char> <char style="w" x-id="WLC.PSA.60.5.008" x-align="PSA.60.5.a008" x-target-ids="t008 t010 t011" x-tar