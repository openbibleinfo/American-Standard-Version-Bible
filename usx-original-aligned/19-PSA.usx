	<para style="p"><verse number="44" style="v" x-ref="PSA.18.44" x-added-alignments="PSA.18.44.a004" x-added-target-ids="t006 t007" x-added-target="of me" sid="PSA 18:44" /><char style="w" x-id="WLC.PSA.18.44.001" x-align="PSA.18.44.a001" x-target-ids="t001 t002 t003" x-target="As soon as" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.18.45">לְ</char><char style="w" x-id="WLC.PSA.18.44.002" x-align="PSA.18.44.a002" x-target-ids="t004 t005" x-target="they hear" x-target-head="t005" x-head="true" lemma="שֵׁמַע" strong="H8088" x-morph="Ncmsc" x-gloss="hearing" x-translit="šēmaʿ" xml:lang="hbo" x-source-ref="PSA.18.45">שֵׁ֣מַֽע</char> <char style="w" x-id="WLC.PSA.18.44.003" x-align="PSA.18.44.a003" x-status="unrepresented" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsa" x-gloss="of.an.ear" x-translit="ʾōzen" xml:lang="hbo" x-source-ref="PSA.18.45">אֹ֭זֶן</char> <char style="w" x-id="WLC.PSA.18.44.004" x-align="PSA.18.44.a005" x-target-ids="t008 t009 t010" x-target="they shall obey" x-target-head="t010" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="VNi3mp" x-gloss="they.became.obedient" x-translit="yiššāməʿû" xml:lang="hbo" x-source-ref="PSA.18.45">יִשָּׁ֣מְעוּ</char> <char style="w" x-id="WLC.PSA.18.44.005" x-align="PSA.18.44.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo" x-source-ref="PSA.18.45">לִ֑</char><char style="w" x-id="WLC.PSA.18.44.006" x-align="PSA.18.44.a007" x-target-ids="t011" x-target="me" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.18.45">י</char> <char style="w" x-id="WLC.PSA.18.44.007" x-align="PSA.18.44.a008" x-target-ids="t012 t013" x-target="The foreigners" x-target-head="t013" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="sons" x-translit="bə