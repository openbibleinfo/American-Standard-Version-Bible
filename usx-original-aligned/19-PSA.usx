	<para style="p"><verse number="9" style="v" x-ref="PSA.90.9" sid="PSA 90:9" /><char style="w" x-id="WLC.PSA.90.9.001" x-align="PSA.90.9.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PSA.90.9.002" x-align="PSA.90.9.a002" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.90.9.003" x-align="PSA.90.9.a003" x-target-ids="t004" x-target="days" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="days" x-translit="yāmēy" xml:lang="hbo">יָ֭מֵי</char><char style="w" x-id="WLC.PSA.90.9.004" x-align="PSA.90.9.a004" x-target-ids="t003" x-target="our" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.PSA.90.9.005" x-align="PSA.90.9.a005" x-target-ids="t005 t006 t007" x-target="are passed away" x-target-head="t006" x-head="true" lemma="פָּנָה" strong="H6437" x-morph="Vqp3cp" x-gloss="they.turn" x-translit="pānû" xml:lang="hbo">פָּנ֣וּ</char> <char style="w" x-id="WLC.PSA.90.9.006" x-align="PSA.90.9.a006" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PSA.90.9.007" x-align="PSA.90.9.a007" x-target-ids="t010" x-target="wrath" x-target-head="t010" x-head="true" lemma="עֶבְרָה" strong="H5678" x-morph="Ncfsc" x-gloss="fury" x-translit="ʿeḇrāṯ" xml:lang="hbo">עֶבְרָתֶ֑</char><char style="w" x-id="WLC.PSA.90.9.008" x-align="PSA.90.9.a008" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</