	<para style="p"><verse number="2" style="v" x-ref="PSA.69.2" sid="PSA 69:2" /><char style="w" x-id="WLC.PSA.69.2.001" x-align="PSA.69.2.a001" x-target-ids="t001 t002" x-target="I sink" x-target-head="t002" x-head="true" lemma="טָבַע" strong="H2883" x-morph="Vqp1cs" x-gloss="I.have.sunk" x-translit="ṭāḇaʿətî" xml:lang="hbo" x-source-ref="PSA.69.3">טָבַ֤עְתִּי</char>׀<char style="w" x-id="WLC.PSA.69.2.002" x-align="PSA.69.2.a002" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo" x-source-ref="PSA.69.3">בִּ</char><char style="w" x-id="WLC.PSA.69.2.003" x-align="PSA.69.2.a003" x-target-ids="t005" x-target="mire" x-target-head="t005" x-head="true" lemma="יָוֵן" strong="H3121" x-morph="Ncmsc" x-gloss="mire" x-translit="ywēn" xml:lang="hbo" x-source-ref="PSA.69.3">יוֵ֣ן</char> <char style="w" x-id="WLC.PSA.69.2.004" x-align="PSA.69.2.a004" x-target-ids="t004" x-target="deep" x-target-head="t004" x-head="true" lemma="מְצוֹלָה" strong="H4688" x-morph="Ncfsa" x-gloss="of.depth" x-translit="məṣûlâ" xml:lang="hbo" x-source-ref="PSA.69.3">מְ֭צוּלָה</char> <char style="w" x-id="WLC.PSA.69.2.005" x-align="PSA.69.2.a005" x-target-ids="t006" x-target="where" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.69.3">וְ</char><char style="w" x-id="WLC.PSA.69.2.006" x-align="PSA.69.2.a006" x-target-ids="t007 t008 t009" x-target="there is no" x-target-head="t009" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo" x-source-ref="PSA.69.3">אֵ֣ין</char> <char style="w" x-id="WLC.PSA.69.2.007" x-align="PSA.69.2.a007" x-target-ids="t010" x-target="standing" x-target-head="t010" x-head="true" lemma="מׇעֳמָד" strong="H4613" x-morph="Ncmsa" x-gloss="a.foothold" x-translit="moʿŏmāḏ" xml:lang="hbo" x-source-ref="PSA.69.3">מָעֳמָ֑ד</char> <char style="w