	<para style="p"><verse number="15" style="v" x-ref="PSA.37.15" sid="PSA 37:15" /><char style="w" x-id="WLC.PSA.37.15.001" x-align="PSA.37.15.a001" x-target-ids="t002" x-target="sword" x-target-head="t002" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsc" x-gloss="sword" x-translit="ḥarb" xml:lang="hbo">חַ֭רְבָּ</char><char style="w" x-id="WLC.PSA.37.15.002" x-align="PSA.37.15.a002" x-target-ids="t001" x-target="Their" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.37.15.003" x-align="PSA.37.15.a003" x-target-ids="t003 t004" x-target="shall enter" x-target-head="t004" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3fs" x-gloss="it.will.go" x-translit="tāḇôʾ" xml:lang="hbo">תָּב֣וֹא</char> <char style="w" x-id="WLC.PSA.37.15.004" x-align="PSA.37.15.a004" x-target-ids="t005" x-target="into" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PSA.37.15.005" x-align="PSA.37.15.a005" x-target-ids="t008" x-target="heart" x-target-head="t008" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="their.own" x-translit="libb" xml:lang="hbo">לִבָּ֑</char><char style="w" x-id="WLC.PSA.37.15.006" x-align="PSA.37.15.a006" x-target-ids="t006 t007" x-target="their own" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="heart" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.37.15.007" x-align="PSA.37.15.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.37.15.008" x-align="PSA.37.15.a008" x-target-ids="t011" x-target="bows" x-target-head="t011" x-head="true" lemma="קֶשֶׁת" strong="H7198" x-morph="Ncfpc" x-gloss="bows" x-translit="qaš