	<para style="p"><verse number="5" style="v" x-ref="PSA.145.5" sid="PSA 145:5" /><char style="w" x-id="WLC.PSA.145.5.001" x-align="PSA.145.5.a001" x-target-ids="t002 t004" x-target="the majesty" x-target-head="t004" x-head="true" lemma="הָדָר" strong="H1926" x-morph="Ncmsc" x-gloss="the.majesty" x-translit="hăḏar" xml:lang="hbo">הֲ֭דַר</char> <char style="w" x-id="WLC.PSA.145.5.002" x-align="PSA.145.5.a002" x-target-ids="t003" x-target="glorious" x-target-head="t003" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="of.the.glory" x-translit="kəḇôḏ" xml:lang="hbo">כְּב֣וֹד</char> <char style="w" x-id="WLC.PSA.145.5.003" x-align="PSA.145.5.a003" x-target-ids="t005 t007" x-target="of honor" x-target-head="t007" x-head="true" lemma="הוֹד" strong="H1935" x-morph="Ncmsc" x-gloss="your.splendor" x-translit="hôḏ" xml:lang="hbo">הוֹדֶ֑</char><char style="w" x-id="WLC.PSA.145.5.004" x-align="PSA.145.5.a004" x-target-ids="t006" x-target="thine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.145.5.005" x-align="PSA.145.5.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.145.5.006" x-align="PSA.145.5.a006" x-target-ids="t012" x-target="works" x-target-head="t012" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpc" x-gloss="the.matters" x-translit="ḏiḇrēy" xml:lang="hbo">דִבְרֵ֖י</char> <char style="w" x-id="WLC.PSA.145.5.007" x-align="PSA.145.5.a007" x-target-ids="t011" x-target="wondrous" x-target-head="t011" x-head="true" lemma="פָּלָא" strong="H6381" x-morph="VNrfpc" x-gloss="of" x-translit="nip̄ləʾôṯey" xml:lang="hbo">נִפְלְאוֹתֶ֣י</char><char style="w" x-id="WLC.PSA.145.5.008" x-align="PSA.145.5.a008" x-target-ids="t010" x-target="thy" x-target-head="t010" x-head="true" lemma="הוּא"