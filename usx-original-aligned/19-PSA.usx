	<para style="p"><verse number="3" style="v" x-ref="PSA.97.3" sid="PSA 97:3" /><char style="w" x-id="WLC.PSA.97.3.001" x-align="PSA.97.3.a001" x-target-ids="t001 t002" x-target="A fire" x-target-head="t002" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsa" x-gloss="fire" x-translit="ʾēš" xml:lang="hbo">אֵ֭שׁ</char> <char style="w" x-id="WLC.PSA.97.3.002" x-align="PSA.97.3.a002" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.97.3.003" x-align="PSA.97.3.a002" x-target-ids="t004" x-target="before" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ānāy" xml:lang="hbo">פָנָ֣י</char><char style="w" x-id="WLC.PSA.97.3.004" x-align="PSA.97.3.a003" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.97.3.005" x-align="PSA.97.3.a004" x-target-ids="t003" x-target="goeth" x-target-head="t003" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi3fs" x-gloss="it.goes" x-translit="tēlēḵ" xml:lang="hbo">תֵּלֵ֑ךְ</char> <char style="w" x-id="WLC.PSA.97.3.006" x-align="PSA.97.3.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.97.3.007" x-align="PSA.97.3.a006" x-target-ids="t007 t008" x-target="burneth up" x-target-head="t007" x-head="true" lemma="לָהַט" strong="H3857" x-morph="Vpi3fs" x-gloss="it.sets.ablaze" x-translit="ṯəlahēṭ" xml:lang="hbo">תְלַהֵ֖ט</char> <char style="w" x-id="WLC.PSA.97.3.008" x-align="PSA.97.3.a007" x-target-ids="t011 t012" x-target="round about" x-target-head="t011" x-head="true" lemma="סָבִיב" strong="H5439" x-morph="Ncbsa" x-gloss="all.around" x-translit="sāḇiyḇ" xml:lang="hbo">סָבִ֣יב</char> <char style="w" x-id="WLC.PSA.97.3.009" x-alig