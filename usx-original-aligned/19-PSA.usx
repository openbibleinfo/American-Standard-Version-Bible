	<para style="p"><verse number="2" style="v" x-ref="PSA.82.2" sid="PSA 82:2" /><char style="w" x-id="WLC.PSA.82.2.001" x-align="PSA.82.2.a001" x-status="noncompositional" x-target-ids="t001 t002" x-target="How long" x-target-head="t002" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PSA.82.2.002" x-align="PSA.82.2.a001" x-status="noncompositional" lemma="מָתַי" strong="H4970" x-morph="Ti" x-gloss="when?" x-translit="māṯay" xml:lang="hbo">מָתַ֥י</char> <char style="w" x-id="WLC.PSA.82.2.003" x-align="PSA.82.2.a002" x-target-ids="t003 t004 t005" x-target="will ye judge" x-target-head="t005" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vqi2mp" x-gloss="will.you.judge" x-translit="tišpəṭû-" xml:lang="hbo">תִּשְׁפְּטוּ</char>־<char style="w" x-id="WLC.PSA.82.2.004" x-align="PSA.82.2.a003" x-target-ids="t006" x-target="unjustly" x-target-head="t006" x-head="true" lemma="עָוֶל" strong="H5766" x-morph="Ncbsa" x-gloss="injustice" x-translit="ʿāwel" xml:lang="hbo">עָ֑וֶל</char> <char style="w" x-id="WLC.PSA.82.2.005" x-align="PSA.82.2.a004" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.82.2.006" x-align="PSA.82.2.a006" x-target-ids="t009 t010" x-target="the persons" x-target-head="t010" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="face" x-translit="p̄ənēy" xml:lang="hbo">פְנֵ֥י</char> <char style="w" x-id="WLC.PSA.82.2.007" x-align="PSA.82.2.a007" x-target-ids="t011 t012 t013" x-target="of the wicked" x-target-head="t013" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְ֝שָׁעִ֗ים</char> <char style="w" x-id="WLC.PSA.82.2.008" x-align="PSA.82.2.a005" x-target-ids="t008" x-target="respect" x-target-head="t008" x-head="true" lemma