	<para style="p"><verse number="27" style="v" x-ref="PSA.118.27" sid="PSA 118:27" /><char style="w" x-id="WLC.PSA.118.27.001" x-align="PSA.118.27.a001" x-target-ids="t002 t003" x-target="is God" x-target-head="t003" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsc" x-gloss="[is].God" x-translit="ʾēl" xml:lang="hbo">אֵ֤ל</char>׀<char style="w" x-id="WLC.PSA.118.27.002" x-align="PSA.118.27.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְהוָה֮</char> <char style="w" x-id="WLC.PSA.118.27.003" x-align="PSA.118.27.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.118.27.004" x-align="PSA.118.27.a004" x-target-ids="t005 t006 t007 t009" x-target="he hath given light" x-target-head="t009" x-head="true" lemma="אוֹר" strong="H215" x-morph="Vhw3ms" x-gloss="he.has.given.light" x-translit="yyāʾer" xml:lang="hbo">יָּ֪אֶר</char> <char style="w" x-id="WLC.PSA.118.27.005" x-align="PSA.118.27.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ֥</char><char style="w" x-id="WLC.PSA.118.27.006" x-align="PSA.118.27.a006" x-target-ids="t008" x-target="us" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ānû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.PSA.118.27.007" x-align="PSA.118.27.a007" x-target-ids="t010" x-target="Bind" x-target-head="t010" x-head="true" lemma="אָסַר" strong="H631" x-morph="Vqv2mp" x-gloss="bind" x-translit="ʾisrû-" xml:lang="hbo">אִסְרוּ</char>־<char style="w" x-id="WLC.PSA.118.27.008" x-align="PSA.118.27.a008" x-target-ids="t011 t012" x-target="the sacrifice" x-target-head="t012" x-head="true" lemma="חַג" strong="H2282" x-morph="Ncmsa" x-gloss="a.f