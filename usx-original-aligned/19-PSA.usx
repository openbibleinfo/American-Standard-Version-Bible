	<para style="p"><verse number="8" style="v" x-ref="PSA.139.8" x-added-alignments="PSA.139.8.a008" x-added-target-ids="t013" x-added-target="my" sid="PSA 139:8" /><char style="w" x-id="WLC.PSA.139.8.001" x-align="PSA.139.8.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PSA.139.8.002" x-align="PSA.139.8.a002" x-target-ids="t002 t003 t004" x-target="I ascend up" x-target-head="t003" x-head="true" lemma="סָלֵק" strong="H5559a" x-morph="Vqi1cs" x-gloss="I.will.ascend" x-translit="ʾessaq" xml:lang="hbo">אֶסַּ֣ק</char> <char style="w" x-id="WLC.PSA.139.8.003" x-align="PSA.139.8.a003" x-target-ids="t005 t006" x-target="into heaven" x-target-head="t006" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heavens" x-translit="šāmayim" xml:lang="hbo">שָׁ֭מַיִם</char> <char style="w" x-id="WLC.PSA.139.8.004" x-align="PSA.139.8.a004" x-target-ids="t008 t009" x-target="art there" x-target-head="t009" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="[are].there" x-translit="šām" xml:lang="hbo">שָׁ֣ם</char> <char style="w" x-id="WLC.PSA.139.8.005" x-align="PSA.139.8.a005" x-target-ids="t007" x-target="thou" x-target-head="t007" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾātâ" xml:lang="hbo">אָ֑תָּה</char> <char style="w" x-id="WLC.PSA.139.8.006" x-align="PSA.139.8.a006" x-target-ids="t010" x-target="If" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.139.8.007" x-align="PSA.139.8.a007" x-target-ids="t011 t012 t014" x-target="I make bed" x-target-head="t014" x-head="true" lemma="יָצַע" strong="H3331" x-morph="Vhh1cs" x-gloss="I.will.spread.as.a.bed" x-translit="ʾaṣṣiyʿâ" xml:lang="hbo">אַצִּ֖יעָה</char> <char style="w" x-id="WLC.PSA.139.8.008" x-align="P