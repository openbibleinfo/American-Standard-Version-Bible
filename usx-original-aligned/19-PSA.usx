	<para style="p"><verse number="2" style="v" x-ref="PSA.120.2" x-added-alignments="PSA.120.2.a009" x-added-target-ids="t009" x-added-target="And" sid="PSA 120:2" /><char style="w" x-id="WLC.PSA.120.2.001" x-align="PSA.120.2.a001" x-target-ids="t004 t005" x-target="O Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.120.2.002" x-align="PSA.120.2.a002" x-target-ids="t001" x-target="Deliver" x-target-head="t001" x-head="true" lemma="נָצַל" strong="H5337" x-morph="Vhv2ms" x-gloss="deliver" x-translit="haṣṣiyl" xml:lang="hbo">הַצִּ֣ילָ</char><char style="w" x-id="WLC.PSA.120.2.003" x-align="PSA.120.2.a003" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PSA.120.2.004" x-align="PSA.120.2.a004" x-target-ids="t003" x-target="soul" x-target-head="t003" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַ֭פְשִׁ</char><char style="w" x-id="WLC.PSA.120.2.005" x-align="PSA.120.2.a005" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.120.2.006" x-align="PSA.120.2.a006" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.120.2.007" x-align="PSA.120.2.a007" x-target-ids="t008" x-target="lips" x-target-head="t008" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfsc" x-gloss="a.lip" x-translit="śśəp̄aṯ-" xml:lang="hbo">שְּׂפַת</char>־<char style="w" x-id="WLC.PSA.120.2.008" x-align="PSA.120.2.a008" x-target-ids="t007" x-target="lying" x-target-head="t007" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph=