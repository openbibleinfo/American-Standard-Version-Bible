	<para style="p"><verse number="26" style="v" x-ref="PSA.102.26" sid="PSA 102:26" /><char style="w" x-id="WLC.PSA.102.26.001" x-align="PSA.102.26.a001" x-target-ids="t001" x-target="They" x-target-head="t001" x-head="true" lemma="הֵמָּה" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēmmāh" xml:lang="hbo" x-source-ref="PSA.102.27">הֵ֤מָּה</char>׀<char style="w" x-id="WLC.PSA.102.26.002" x-align="PSA.102.26.a002" x-target-ids="t002 t003" x-target="shall perish" x-target-head="t003" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqi3mp" x-gloss="they.will.perish" x-translit="yōʾḇēḏû" xml:lang="hbo" x-source-ref="PSA.102.27">יֹאבֵדוּ֮</char> <char style="w" x-id="WLC.PSA.102.26.003" x-align="PSA.102.26.a003" x-target-ids="t004" x-target="but" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.102.27">וְ</char><char style="w" x-id="WLC.PSA.102.26.004" x-align="PSA.102.26.a004" x-target-ids="t005" x-target="thou" x-target-head="t005" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.102.27">אַתָּ֪ה</char> <char style="w" x-id="WLC.PSA.102.26.005" x-align="PSA.102.26.a005" x-target-ids="t006 t007" x-target="shalt endure" x-target-head="t007" x-head="true" lemma="עָמַד" strong="H5975" x-morph="Vqi2ms" x-gloss="you.will.endure" x-translit="ṯaʿămōḏ" xml:lang="hbo" x-source-ref="PSA.102.27">תַ֫עֲמֹ֥ד</char> <char style="w" x-id="WLC.PSA.102.26.006" x-align="PSA.102.26.a006" x-target-ids="t008" x-target="Yea" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.102.27">וְ֭</char><char style="w" x-id="WLC.PSA.102.26.007" x-align="PSA.102.26.a007" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵull" xml:lang="hbo" x-source-ref="PSA.