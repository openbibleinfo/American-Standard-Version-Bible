	<para style="p"><verse number="32" style="v" x-ref="PSA.107.32" sid="PSA 107:32" /><char style="w" x-id="WLC.PSA.107.32.001" x-align="PSA.107.32.a001" x-target-ids="t005" x-target="also" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִֽ֭</char><char style="w" x-id="WLC.PSA.107.32.002" x-align="PSA.107.32.a002" x-target-ids="t001 t002 t003" x-target="Let them exalt" x-target-head="t003" x-head="true" lemma="רוּם" strong="H7311" x-morph="Voi3mp" x-gloss="let" x-translit="yrōməmû" xml:lang="hbo">ירֹמְמוּ</char><char style="w" x-id="WLC.PSA.107.32.003" x-align="PSA.107.32.a003" x-target-ids="t004" x-target="him" x-target-head="t004" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="them.exalt.him" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PSA.107.32.004" x-align="PSA.107.32.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PSA.107.32.005" x-align="PSA.107.32.a005" x-target-ids="t007 t008" x-target="the assembly" x-target-head="t008" x-head="true" lemma="קָהָל" strong="H6951" x-morph="Ncmsc" x-gloss="assembly" x-translit="qəhal-" xml:lang="hbo">קְהַל</char>־<char style="w" x-id="WLC.PSA.107.32.006" x-align="PSA.107.32.a006" x-target-ids="t009 t010 t011" x-target="of the people" x-target-head="t011" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="of.[the].people" x-translit="ʿām" xml:lang="hbo">עָ֑ם</char> <char style="w" x-id="WLC.PSA.107.32.007" x-align="PSA.107.32.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.107.32.008" x-align="PSA.107.32.a010" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a