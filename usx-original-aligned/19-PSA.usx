	<para style="p"><verse number="5" style="v" x-ref="PSA.91.5" x-added-alignments="PSA.91.5.a008" x-added-target-ids="t015" x-added-target="that" sid="PSA 91:5" /><char style="w" x-id="WLC.PSA.91.5.001" x-align="PSA.91.5.a001" x-target-ids="t003 t011" x-target="not Nor" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.91.5.002" x-align="PSA.91.5.a002" x-target-ids="t001 t002 t004 t005" x-target="Thou shalt be afraid" x-target-head="t005" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqi2ms" x-gloss="you.will.be.afraid" x-translit="ṯîrāʾ" xml:lang="hbo">תִ֭ירָא</char> <char style="w" x-id="WLC.PSA.91.5.003" x-align="PSA.91.5.a003" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.91.5.004" x-align="PSA.91.5.a004" x-target-ids="t007 t008" x-target="the terror" x-target-head="t008" x-head="true" lemma="פַּחַד" strong="H6343" x-morph="Ncmsc" x-gloss="dread" x-translit="paḥaḏ" xml:lang="hbo">פַּ֣חַד</char> <char style="w" x-id="WLC.PSA.91.5.005" x-align="PSA.91.5.a005" x-target-ids="t009 t010" x-target="by night" x-target-head="t010" x-head="true" lemma="לַיְלָה" strong="H3915" x-morph="Ncmsa" x-gloss="of.night" x-translit="lāyəlâ" xml:lang="hbo">לָ֑יְלָה</char> <char style="w" x-id="WLC.PSA.91.5.006" x-align="PSA.91.5.a006" x-target-ids="t012" x-target="for" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ֝</char><char style="w" x-id="WLC.PSA.91.5.007" x-align="PSA.91.5.a007" x-target-ids="t013 t014" x-target="the arrow" x-target-head="t014" x-head="true" lemma="חֵץ" strong="H2671" x-morph="Ncmsa" x-gloss="an.arrow" x-translit="ḥēṣ" xml:lang="hbo">חֵ֗ץ</char> <char style="w" x-id="WLC.PSA.91.5.008" x-align="PSA.91.5.a009" x-target-id