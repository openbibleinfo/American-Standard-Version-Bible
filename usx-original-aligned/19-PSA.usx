	<para style="p"><verse number="23" style="v" x-ref="PSA.71.23" sid="PSA 71:23" /><char style="w" x-id="WLC.PSA.71.23.001" x-align="PSA.71.23.a001" x-target-ids="t003 t004 t005 t006" x-target="shall shout for joy" x-target-head="t004" x-head="true" lemma="רָנַן" strong="H7442" x-morph="Vpi3fp" x-gloss="they.will.sing.for.joy" x-translit="tərannēnnāh" xml:lang="hbo">תְּרַנֵּ֣נָּ֣ה</char> <char style="w" x-id="WLC.PSA.71.23.002" x-align="PSA.71.23.a002" x-target-ids="t002" x-target="lips" x-target-head="t002" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śəp̄āṯ" xml:lang="hbo">שְׂ֭פָתַ</char><char style="w" x-id="WLC.PSA.71.23.003" x-align="PSA.71.23.a003" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.71.23.004" x-align="PSA.71.23.a004" x-target-ids="t007" x-target="when" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PSA.71.23.005" x-align="PSA.71.23.a005" x-target-ids="t008 t009 t010" x-target="I sing praises" x-target-head="t010" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vpi1cs" x-gloss="I.will.make.music" x-translit="ʾăzammərâ-" xml:lang="hbo">אֲזַמְּרָה</char>־<char style="w" x-id="WLC.PSA.71.23.006" x-align="PSA.71.23.a006" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לָּ֑</char><char style="w" x-id="WLC.PSA.71.23.007" x-align="PSA.71.23.a007" x-target-ids="t012" x-target="thee" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.PSA.71.23.008" x-align="PSA.71.23.a008" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" 