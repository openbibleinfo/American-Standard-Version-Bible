	<para style="p"><verse number="15" style="v" x-ref="PSA.119.15" sid="PSA 119:15" /><char style="w" x-id="WLC.PSA.119.15.001" x-align="PSA.119.15.a001" x-target-ids="t004" x-target="on" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.15.002" x-align="PSA.119.15.a002" x-target-ids="t006" x-target="precepts" x-target-head="t006" x-head="true" lemma="פִּקּוּדִים" strong="H6490" x-morph="Ncmpc" x-gloss="precepts" x-translit="p̄iqquḏey" xml:lang="hbo">פִקֻּדֶ֥י</char><char style="w" x-id="WLC.PSA.119.15.003" x-align="PSA.119.15.a003" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.15.004" x-align="PSA.119.15.a004" x-target-ids="t001 t002 t003" x-target="I will meditate" x-target-head="t003" x-head="true" lemma="שִׂיחַ" strong="H7878" x-morph="Vqh1cs" x-gloss="I.will.meditate" x-translit="ʾāśiyḥâ" xml:lang="hbo">אָשִׂ֑יחָה</char> <char style="w" x-id="WLC.PSA.119.15.005" x-align="PSA.119.15.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.119.15.006" x-align="PSA.119.15.a006" x-target-ids="t008 t009 t010" x-target="have respect unto" x-target-head="t009" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhh1cs" x-gloss="I.will.pay.attention.to" x-translit="ʾabbiyṭâ" xml:lang="hbo">אַבִּ֗יטָה</char> <char style="w" x-id="WLC.PSA.119.15.007" x-align="PSA.119.15.a007" x-target-ids="t012" x-target="ways" x-target-head="t012" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbpc" x-gloss="paths" x-translit="ʾōrəḥōṯey" xml:lang="hbo">אֹרְחֹתֶֽי</char><char style="w" x-id="WLC.PSA.119.15.008" x-align="PSA.119.15.a008" x-target-ids="t011" x-target="thy" x-targe