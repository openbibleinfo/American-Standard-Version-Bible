	<para style="p"><verse number="2" style="v" x-ref="PSA.45.2" sid="PSA 45:2" /><char style="w" x-id="WLC.PSA.45.2.001" x-align="PSA.45.2.a001" x-target-ids="t001 t002 t003" x-target="Thou art fairer" x-target-head="t003" x-head="true" lemma="יָפָה" strong="H3302" x-morph="Vjp2ms" x-gloss="you.are.handsome" x-translit="yāp̄əyāp̄iyṯā" xml:lang="hbo" x-source-ref="PSA.45.3">יָפְיָפִ֡יתָ</char> <char style="w" x-id="WLC.PSA.45.2.002" x-align="PSA.45.2.a002" x-target-ids="t004" x-target="than" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.45.3">מִ</char><char style="w" x-id="WLC.PSA.45.2.003" x-align="PSA.45.2.a003" x-target-ids="t005 t006" x-target="the children" x-target-head="t006" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="than.[the].sons" x-translit="bənēy" xml:lang="hbo" x-source-ref="PSA.45.3">בְּנֵ֬י</char> <char style="w" x-id="WLC.PSA.45.2.004" x-align="PSA.45.2.a004" x-target-ids="t007 t008" x-target="of men" x-target-head="t008" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.humankind" x-translit="ʾāḏām" xml:lang="hbo" x-source-ref="PSA.45.3">אָדָ֗ם</char> <char style="w" x-id="WLC.PSA.45.2.005" x-align="PSA.45.2.a005" x-target-ids="t010 t011" x-target="is poured" x-target-head="t011" x-head="true" lemma="יָצַק" strong="H3332" x-morph="VHp3ms" x-gloss="it.has.been.poured" x-translit="hûṣaq" xml:lang="hbo" x-source-ref="PSA.45.3">ה֣וּצַק</char> <char style="w" x-id="WLC.PSA.45.2.006" x-align="PSA.45.2.a006" x-target-ids="t009" x-target="Grace" x-target-head="t009" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="grace" x-translit="ḥēn" xml:lang="hbo" x-source-ref="PSA.45.3">חֵ֭ן</char> <char style="w" x-id="WLC.PSA.45.2.007" x-align="PSA.45.2.a007" x-target-ids="t012" x-target="into" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo" x-sourc