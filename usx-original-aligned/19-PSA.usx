	<para style="p"><verse number="7" style="v" x-ref="PSA.22.7" x-added-alignments="PSA.22.7.a012" x-added-target-ids="t019" x-added-target="saying" sid="PSA 22:7" /><char style="w" x-id="WLC.PSA.22.7.001" x-align="PSA.22.7.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.22.8">כָּל</char>־<char style="w" x-id="WLC.PSA.22.7.002" x-align="PSA.22.7.a002" x-target-ids="t002 t003 t004" x-target="they that see" x-target-head="t004" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqrmpc" x-gloss="[those" x-translit="rōʾ" xml:lang="hbo" x-source-ref="PSA.22.8">רֹ֭אַ</char><char style="w" x-id="WLC.PSA.22.7.003" x-align="PSA.22.7.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="who].see.me" x-translit="ay" xml:lang="hbo" x-source-ref="PSA.22.8">י</char> <char style="w" x-id="WLC.PSA.22.7.004" x-align="PSA.22.7.a004" x-target-ids="t006 t008 t009" x-target="laugh to scorn" x-target-head="t009" x-head="true" lemma="לָעַג" strong="H3932" x-morph="Vhi3mp" x-gloss="they.mock" x-translit="yalʿiḡû" xml:lang="hbo" x-source-ref="PSA.22.8">יַלְעִ֣גוּ</char> <char style="w" x-id="WLC.PSA.22.7.005" x-align="PSA.22.7.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="l" xml:lang="hbo" x-source-ref="PSA.22.8">לִ֑</char><char style="w" x-id="WLC.PSA.22.7.006" x-align="PSA.22.7.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.22.8">י</char> <char style="w" x-id="WLC.PSA.22.7.007" x-align="PSA.22.7.a007" x-target-ids="t010 t011 t012" x-target="They shoot out" x-target-head="t011" x-head="true" lemma="פָּטַר" strong="H6362" x-morph="Vhi3mp" x-gloss="they.make.a.separation" x-translit="yap̄