	<para style="p"><verse number="4" style="v" x-ref="PSA.7.4" sid="PSA 7:4" /><char style="w" x-id="WLC.PSA.7.4.001" x-align="PSA.7.4.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="PSA.7.5">אִם</char>־<char style="w" x-id="WLC.PSA.7.4.002" x-align="PSA.7.4.a002" x-target-ids="t002 t003 t004" x-target="I have rewarded" x-target-head="t004" x-head="true" lemma="גָּמַל" strong="H1580" x-morph="Vqp1cs" x-gloss="I.have.repaid" x-translit="gāmaltî" xml:lang="hbo" x-source-ref="PSA.7.5">גָּ֭מַלְתִּי</char> <char style="w" x-id="WLC.PSA.7.4.003" x-align="PSA.7.4.a003" x-target-ids="t006 t007 t008 t009 t010 t011" x-target="unto him that was at peace" x-target-head="t011" x-head="true" lemma="שָׁלַם" strong="H7999" x-morph="Vqrmsc" x-gloss="[one" x-translit="šôləm" xml:lang="hbo" x-source-ref="PSA.7.5">שֽׁוֹלְמִ֥</char><char style="w" x-id="WLC.PSA.7.4.004" x-align="PSA.7.4.a004" x-target-ids="t012 t013" x-target="with me" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="who.is].at.peace.with.me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.7.5">י</char> <char style="w" x-id="WLC.PSA.7.4.005" x-align="PSA.7.4.a005" x-target-ids="t005" x-target="evil" x-target-head="t005" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="evil" x-translit="rāʿ" xml:lang="hbo" x-source-ref="PSA.7.5">רָ֑ע</char> <char style="w" x-id="WLC.PSA.7.4.006" x-align="PSA.7.4.a006" x-target-ids="t014" x-target="Yea" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo" x-source-ref="PSA.7.5">וָ</char><char style="w" x-id="WLC.PSA.7.4.007" x-align="PSA.7.4.a007" x-target-ids="t015 t016 t017" x-target="I have delivered" x-target-head="t017" x-head="true" lemma="חָלַץ" strong="H2502" x-morph="Vpw1cs" x-gloss="I" x-translit="ʾăḥalləṣ" xml:lang="hbo" x-source-ref="