	<para style="p"><verse number="4" style="v" x-ref="PSA.48.4" sid="PSA 48:4" /><char style="w" x-id="WLC.PSA.48.4.001" x-align="PSA.48.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.48.5">כִּֽי</char>־<char style="w" x-id="WLC.PSA.48.4.002" x-align="PSA.48.4.a002" x-target-ids="t002" x-target="lo" x-target-head="t002" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo" x-source-ref="PSA.48.5">הִנֵּ֣ה</char> <char style="w" x-id="WLC.PSA.48.4.003" x-align="PSA.48.4.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.48.5">הַ֭</char><char style="w" x-id="WLC.PSA.48.4.004" x-align="PSA.48.4.a004" x-target-ids="t004" x-target="kings" x-target-head="t004" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmpa" x-gloss="kings" x-translit="mməlāḵîm" xml:lang="hbo" x-source-ref="PSA.48.5">מְּלָכִים</char> <char style="w" x-id="WLC.PSA.48.4.005" x-align="PSA.48.4.a005" x-target-ids="t005 t006" x-target="assembled themselves" x-target-head="t005" x-head="true" lemma="יָעַד" strong="H3259" x-morph="VNp3cp" x-gloss="they.assembled" x-translit="nôʿăḏû" xml:lang="hbo" x-source-ref="PSA.48.5">נֽוֹעֲד֑וּ</char> <char style="w" x-id="WLC.PSA.48.4.006" x-align="PSA.48.4.a006" x-target-ids="t007 t008 t009" x-target="They passed by" x-target-head="t008" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqp3cp" x-gloss="they.passed.on" x-translit="ʿāḇərû" xml:lang="hbo" x-source-ref="PSA.48.5">עָבְר֥וּ</char> <char style="w" x-id="WLC.PSA.48.4.007" x-align="PSA.48.4.a007" x-target-ids="t010" x-target="together" x-target-head="t010" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="together" x-translit="yaḥdāw:" xml:lang="hbo" x-source-ref="PSA.48.5