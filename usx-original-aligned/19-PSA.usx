	<para style="p"><verse number="12" style="v" x-ref="PSA.91.12" x-added-alignments="PSA.91.12.a002" x-added-target-ids="t007" x-added-target="their" sid="PSA 91:12" /><char style="w" x-id="WLC.PSA.91.12.001" x-align="PSA.91.12.a001" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.91.12.002" x-align="PSA.91.12.a003" x-target-ids="t008" x-target="hands" x-target-head="t008" x-head="true" lemma="כַּף" strong="H3709" x-morph="Ncfda" x-gloss="palms" x-translit="kappayim" xml:lang="hbo">כַּפַּ֥יִם</char> <char style="w" x-id="WLC.PSA.91.12.003" x-align="PSA.91.12.a004" x-target-ids="t001 t002 t003 t005" x-target="They shall bear up" x-target-head="t003" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi3mp" x-gloss="they" x-translit="yiśśāʾû" xml:lang="hbo">יִשָּׂא֑וּ</char><char style="w" x-id="WLC.PSA.91.12.004" x-align="PSA.91.12.a005" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="will" x-translit="n" xml:lang="hbo">נְ</char><char style="w" x-id="WLC.PSA.91.12.005" x-align="PSA.91.12.a006" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="lift.you.up" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.91.12.006" x-align="PSA.91.12.a007" x-target-ids="t009" x-target="Lest" x-target-head="t009" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo">פֶּן</char>־<char style="w" x-id="WLC.PSA.91.12.007" x-align="PSA.91.12.a008" x-target-ids="t010 t011" x-target="thou dash" x-target-head="t011" x-head="true" lemma="נָגַף" strong="H5062" x-morph="Vqi2ms" x-gloss="you.should.strike" x-translit="tiggōp̄" xml:lang="hbo">תִּגֹּ֖ף</char> <char style="w" x-id="WLC.PSA.91.12.008" x-align="PSA.91.12.a009" x-target-ids="t014" x-target="against" x-target-