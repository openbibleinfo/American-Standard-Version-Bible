	<para style="p"><verse number="46" style="v" x-ref="PSA.18.46" sid="PSA 18:46" /><char style="w" x-id="WLC.PSA.18.46.001" x-align="PSA.18.46.a001" x-target-ids="t002" x-target="liveth" x-target-head="t002" x-head="true" lemma="חַי" strong="H2416" x-morph="Aamsa" x-gloss="[is].living" x-translit="ḥay-" xml:lang="hbo" x-source-ref="PSA.18.47">חַי</char>־<char style="w" x-id="WLC.PSA.18.46.002" x-align="PSA.18.46.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.18.47">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.18.46.003" x-align="PSA.18.46.a003" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[be]" x-translit="û" xml:lang="hbo" x-source-ref="PSA.18.47">וּ</char><char style="w" x-id="WLC.PSA.18.46.004" x-align="PSA.18.46.a004" x-target-ids="t004 t005" x-target="blessed be" x-target-head="t004" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vqsmsa" x-gloss="blessed" x-translit="ḇārûḵ" xml:lang="hbo" x-source-ref="PSA.18.47">בָר֣וּךְ</char> <char style="w" x-id="WLC.PSA.18.46.005" x-align="PSA.18.46.a005" x-target-ids="t007" x-target="rock" x-target-head="t007" x-head="true" lemma="צוּר" strong="H6697" x-morph="Ncmsc" x-gloss="rock" x-translit="ṣûr" xml:lang="hbo" x-source-ref="PSA.18.47">צוּרִ֑</char><char style="w" x-id="WLC.PSA.18.46.006" x-align="PSA.18.46.a006" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.18.47">י</char> <char style="w" x-id="WLC.PSA.18.46.007" x-align="PSA.18.46.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.47">וְ֝</char><char style="w" x-id="WLC.PSA.18.46.008" x-align