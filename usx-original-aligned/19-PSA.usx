	<para style="p"><verse number="6" style="v" x-ref="PSA.64.6" x-added-alignments="PSA.64.6.a004" x-added-target-ids="t008 t009" x-added-target="say they" sid="PSA 64:6" /><char style="w" x-id="WLC.PSA.64.6.001" x-align="PSA.64.6.a001" x-target-ids="t001 t002 t003" x-target="They search out" x-target-head="t002" x-head="true" lemma="חָפַשׂ" strong="H2664" x-morph="Vqi3mp" x-gloss="they.plot" x-translit="yaḥpəśû-" xml:lang="hbo" x-source-ref="PSA.64.7">יַֽחְפְּֽשׂוּ</char>־<char style="w" x-id="WLC.PSA.64.6.002" x-align="PSA.64.6.a002" x-target-ids="t004" x-target="iniquities" x-target-head="t004" x-head="true" lemma="עַוְלָה" strong="H5766a" x-morph="Ncbpa" x-gloss="injustice(s)" x-translit="ʿôlōṯ" xml:lang="hbo" x-source-ref="PSA.64.7">עוֹלֹ֗ת</char> <char style="w" x-id="WLC.PSA.64.6.003" x-align="PSA.64.6.a003" x-target-ids="t005 t006 t007" x-target="We have accomplished" x-target-head="t007" x-head="true" lemma="תָּמַם" strong="H8552" x-morph="Vqp1cp" x-gloss="we.have.finished" x-translit="tamnû" xml:lang="hbo" x-source-ref="PSA.64.7">תַּ֭מְנוּ</char> <char style="w" x-id="WLC.PSA.64.6.004" x-align="PSA.64.6.a005" x-target-ids="t010 t012" x-target="a search" x-target-head="t012" x-head="true" lemma="חֵפֶשׂ" strong="H2665" x-morph="Ncmsa" x-gloss="a.plot" x-translit="ḥēp̄eś" xml:lang="hbo" x-source-ref="PSA.64.7">חֵ֣פֶשׂ</char> <char style="w" x-id="WLC.PSA.64.6.005" x-align="PSA.64.6.a006" x-target-ids="t011" x-target="diligent" x-target-head="t011" x-head="true" lemma="חָפַשׂ" strong="H2664" x-morph="VPsmsa" x-gloss="plotted" x-translit="məḥuppāś" xml:lang="hbo" x-source-ref="PSA.64.7">מְחֻפָּ֑שׂ</char> <char style="w" x-id="WLC.PSA.64.6.006" x-align="PSA.64.6.a007" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.64.7">וְ</char><char style="w" x-id="WLC.PSA.64.6.007" x-align="PSA.64.6.a008" x-target-ids="t014 t015 t016" x-target="the 