	<para style="p"><verse number="13" style="v" x-ref="PSA.77.13" sid="PSA 77:13" /><char style="w" x-id="WLC.PSA.77.13.001" x-align="PSA.77.13.a001" x-target-ids="t003 t004" x-target="O God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.77.14">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.77.13.002" x-align="PSA.77.13.a002" x-target-ids="t005 t006" x-target="is in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="[is].in" x-translit="ba" xml:lang="hbo" x-source-ref="PSA.77.14">בַּ</char><char style="w" x-id="WLC.PSA.77.13.003" x-align="PSA.77.13.a003" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.77.14">[הַ]</char><char style="w" x-id="WLC.PSA.77.13.004" x-align="PSA.77.13.a004" x-target-ids="t008" x-target="sanctuary" x-target-head="t008" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsa" x-gloss="holiness" x-translit="qqōḏeš" xml:lang="hbo" x-source-ref="PSA.77.14">קֹּ֣דֶשׁ</char> <char style="w" x-id="WLC.PSA.77.13.005" x-align="PSA.77.13.a005" x-target-ids="t002" x-target="way" x-target-head="t002" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="dark" xml:lang="hbo" x-source-ref="PSA.77.14">דַּרְכֶּ֑</char><char style="w" x-id="WLC.PSA.77.13.006" x-align="PSA.77.13.a006" x-target-ids="t001" x-target="Thy" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.77.14">ךָ</char> <char style="w" x-id="WLC.PSA.77.13.007" x-align="PSA.77.13.a007" x-target-ids="t009 t010" x-target="Who is" x-target-head="t009" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="mî-" xml:lang="hbo" x-source-ref="PSA.77.14">מִי</char>־<char style="w" x-id="