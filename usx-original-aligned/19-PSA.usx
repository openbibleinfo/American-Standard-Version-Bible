	<para style="p"><verse number="4" style="v" x-ref="PSA.85.4" sid="PSA 85:4" /><char style="w" x-id="WLC.PSA.85.4.001" x-align="PSA.85.4.a001" x-target-ids="t001" x-target="Turn" x-target-head="t001" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqv2ms" x-gloss="restore" x-translit="šûḇ" xml:lang="hbo" x-source-ref="PSA.85.5">שׁ֭וּבֵ</char><char style="w" x-id="WLC.PSA.85.4.002" x-align="PSA.85.4.a002" x-target-ids="t002" x-target="us" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ēnû" xml:lang="hbo" x-source-ref="PSA.85.5">נוּ</char> <char style="w" x-id="WLC.PSA.85.4.003" x-align="PSA.85.4.a003" x-target-ids="t003 t004" x-target="O God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="O.God" x-translit="ʾĕlōhēy" xml:lang="hbo" x-source-ref="PSA.85.5">אֱלֹהֵ֣י</char> <char style="w" x-id="WLC.PSA.85.4.004" x-align="PSA.85.4.a004" x-target-ids="t005 t007" x-target="of salvation" x-target-head="t007" x-head="true" lemma="יֵשַׁע" strong="H3468" x-morph="Ncmsc" x-gloss="our.salvation" x-translit="yišʿ" xml:lang="hbo" x-source-ref="PSA.85.5">יִשְׁעֵ֑</char><char style="w" x-id="WLC.PSA.85.4.005" x-align="PSA.85.4.a005" x-target-ids="t006" x-target="our" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo" x-source-ref="PSA.85.5">נוּ</char> <char style="w" x-id="WLC.PSA.85.4.006" x-align="PSA.85.4.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.85.5">וְ</char><char style="w" x-id="WLC.PSA.85.4.007" x-align="PSA.85.4.a007" x-target-ids="t009 t014 t015" x-target="cause to cease" x-target-head="t015" x-head="true" lemma="פָּרַר" strong="H6565" x-morph="Vhv2ms" x-gloss="break" x-translit="hāp̄ēr" xml:lang="hbo" x-source-ref="PSA.85.5">הָפֵ֖ר</char> <char style="w" x-id="