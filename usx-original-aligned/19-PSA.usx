	<para style="p"><verse number="126" style="v" x-ref="PSA.119.126" x-added-alignments="PSA.119.126.a006" x-added-target-ids="t008" x-added-target="For" sid="PSA 119:126" /><char style="w" x-id="WLC.PSA.119.126.001" x-align="PSA.119.126.a001" x-target-ids="t001 t002 t003" x-target="It is time" x-target-head="t003" x-head="true" lemma="עֵת" strong="H6256" x-morph="Ncbsa" x-gloss="a.time" x-translit="ʿēṯ" xml:lang="hbo">עֵ֭ת</char> <char style="w" x-id="WLC.PSA.119.126.002" x-align="PSA.119.126.a002" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.119.126.003" x-align="PSA.119.126.a003" x-target-ids="t007" x-target="work" x-target-head="t007" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqc" x-gloss="act" x-translit="ʿăśôṯ" xml:lang="hbo">עֲשׂ֣וֹת</char> <char style="w" x-id="WLC.PSA.119.126.004" x-align="PSA.119.126.a004" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belongs].to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.119.126.005" x-align="PSA.119.126.a005" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֑ה</char> <char style="w" x-id="WLC.PSA.119.126.006" x-align="PSA.119.126.a007" x-target-ids="t009 t010 t011 t012" x-target="they have made void" x-target-head="t012" x-head="true" lemma="פָּרַר" strong="H6565" x-morph="Vhp3cp" x-gloss="people.have.broken" x-translit="hēp̄ērû" xml:lang="hbo">הֵ֝פֵ֗רוּ</char> <char style="w" x-id="WLC.PSA.119.126.007" x-align="PSA.119.126.a008" x-target-ids="t014" x-target="law" x-target-head="t014" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="law" x-translit="tôrāṯ" xml:lang="hbo">תּוֹרָתֶֽ</char><char style="w" x-id="WLC.PSA.119.126.008" x