	<para style="p"><verse number="11" style="v" x-ref="PSA.105.11" sid="PSA 105:11" /><char style="w" x-id="WLC.PSA.105.11.001" x-align="PSA.105.11.a001" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(cmp)" x-translit="lē" xml:lang="hbo">לֵ</char><char style="w" x-id="WLC.PSA.105.11.002" x-align="PSA.105.11.a002" x-target-ids="t001" x-target="Saying" x-target-head="t001" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqc" x-translit="ʾmōr" xml:lang="hbo">אמֹ֗ר</char> <char style="w" x-id="WLC.PSA.105.11.003" x-align="PSA.105.11.a003" x-target-ids="t002" x-target="Unto" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.105.11.004" x-align="PSA.105.11.a004" x-target-ids="t003" x-target="thee" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo">ךָ֗</char> <char style="w" x-id="WLC.PSA.105.11.005" x-align="PSA.105.11.a005" x-target-ids="t004 t005 t006" x-target="will I give" x-target-head="t006" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi1cs" x-gloss="I.will.give" x-translit="ʾettēn" xml:lang="hbo">אֶתֵּ֥ן</char> <char style="w" x-id="WLC.PSA.105.11.006" x-align="PSA.105.11.a006" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.105.11.007" x-align="PSA.105.11.a007" x-target-ids="t007 t008" x-target="the land" x-target-head="t008" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsc" x-gloss="the.land" x-translit="ʾereṣ-" xml:lang="hbo">אֶֽרֶץ</char>־<char style="w" x-id="WLC.PSA.105.11.008" x-align="PSA.105.11.a008" x-target-ids="t009 t010" x-target="of Canaan" x-target-head="t010" x-head="true" lemma="כְּנַעַן" strong="H3667" x-morph="Np" x-gloss="of.Canaan" x-translit="kənāʿan" xml:lang="hbo">כְּנָ֑עַן</char> <char st