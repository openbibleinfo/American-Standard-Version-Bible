	<para style="p"><verse number="5" style="v" x-ref="PSA.94.5" sid="PSA 94:5" /><char style="w" x-id="WLC.PSA.94.5.001" x-align="PSA.94.5.a003" x-target-ids="t006" x-target="people" x-target-head="t006" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo">עַמְּ</char><char style="w" x-id="WLC.PSA.94.5.002" x-align="PSA.94.5.a002" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֣</char> <char style="w" x-id="WLC.PSA.94.5.003" x-align="PSA.94.5.a004" x-target-ids="t007 t008" x-target="O Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.94.5.004" x-align="PSA.94.5.a001" x-target-ids="t001 t002 t003 t004" x-target="They break in pieces" x-target-head="t002" x-head="true" lemma="דָּכָא" strong="H1792" x-morph="Vpi3mp" x-gloss="they.crush" x-translit="yəḏakkəʾû" xml:lang="hbo">יְדַכְּא֑וּ</char> <char style="w" x-id="WLC.PSA.94.5.005" x-align="PSA.94.5.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.94.5.006" x-align="PSA.94.5.a007" x-target-ids="t012" x-target="heritage" x-target-head="t012" x-head="true" lemma="נַחֲלָה" strong="H5159" x-morph="Ncfsc" x-gloss="inheritance" x-translit="naḥălāṯ" xml:lang="hbo">נַחֲלָתְ</char><char style="w" x-id="WLC.PSA.94.5.007" x-align="PSA.94.5.a006" x-target-ids="t011" x-target="thy" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PSA.94.5.008" x-align="PSA.94.5.a008" x-target-ids="t010" x-target="afflict" x-target-head="t010" x-head="true" lemma="עָנָה" strong="H6031" x-mor