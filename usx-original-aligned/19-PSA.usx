	<para style="p"><verse number="21" style="v" x-ref="PSA.37.21" sid="PSA 37:21" /><char style="w" x-id="WLC.PSA.37.21.001" x-align="PSA.37.21.a001" x-target-ids="t003" x-target="borroweth" x-target-head="t003" x-head="true" lemma="לָוָה" strong="H3867a" x-morph="Vqrmsa" x-gloss="[is].borrowing" x-translit="lōweh" xml:lang="hbo">לֹוֶ֣ה</char> <char style="w" x-id="WLC.PSA.37.21.002" x-align="PSA.37.21.a002" x-target-ids="t001 t002" x-target="The wicked" x-target-head="t002" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="[the].wicked" x-translit="rāšāʿ" xml:lang="hbo">רָ֭שָׁע</char> <char style="w" x-id="WLC.PSA.37.21.003" x-align="PSA.37.21.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.37.21.004" x-align="PSA.37.21.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PSA.37.21.005" x-align="PSA.37.21.a005" x-target-ids="t005 t007" x-target="payeth again" x-target-head="t005" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="Vpi3ms" x-gloss="he.repays" x-translit="yəšallēm" xml:lang="hbo">יְשַׁלֵּ֑ם</char> <char style="w" x-id="WLC.PSA.37.21.006" x-align="PSA.37.21.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.37.21.007" x-align="PSA.37.21.a007" x-target-ids="t009 t010" x-target="the righteous" x-target-head="t010" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֗יק</char> <char style="w" x-id="WLC.PSA.37.21.008" x-align="PSA.37.21.a008" x-target-ids="t011 t012" x-target="dealeth graciously" x-target-head="t012" x-head=