	<para style="p"><verse number="36" style="v" x-ref="PSA.18.36" sid="PSA 18:36" /><char style="w" x-id="WLC.PSA.18.36.001" x-align="PSA.18.36.a001" x-target-ids="t001 t002 t003" x-target="Thou hast enlarged" x-target-head="t003" x-head="true" lemma="רָחַב" strong="H7337" x-morph="Vhi2ms" x-gloss="you.enlarge" x-translit="tarḥiyḇ" xml:lang="hbo" x-source-ref="PSA.18.37">תַּרְחִ֣יב</char> <char style="w" x-id="WLC.PSA.18.36.002" x-align="PSA.18.36.a002" x-target-ids="t005" x-target="steps" x-target-head="t005" x-head="true" lemma="צַעַד" strong="H6806" x-morph="Ncmsc" x-gloss="step[s]" x-translit="ṣaʿăḏ" xml:lang="hbo" x-source-ref="PSA.18.37">צַעֲדִ֣</char><char style="w" x-id="WLC.PSA.18.36.003" x-align="PSA.18.36.a003" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.18.37">י</char> <char style="w" x-id="WLC.PSA.18.36.004" x-align="PSA.18.36.a004" x-target-ids="t006" x-target="under" x-target-head="t006" x-head="true" lemma="תַּחַת" strong="H8478" x-morph="R" x-gloss="under" x-translit="ṯaḥt" xml:lang="hbo" x-source-ref="PSA.18.37">תַחְתָּ֑</char><char style="w" x-id="WLC.PSA.18.36.005" x-align="PSA.18.36.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.18.37">י</char> <char style="w" x-id="WLC.PSA.18.36.006" x-align="PSA.18.36.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.37">וְ</char><char style="w" x-id="WLC.PSA.18.36.007" x-align="PSA.18.36.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.18.37">לֹ֥א</char> <char style="w" x-id="WLC.PSA.18.36.00