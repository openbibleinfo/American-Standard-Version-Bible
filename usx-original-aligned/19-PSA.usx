	<para style="p"><verse number="14" style="v" x-ref="PSA.81.14" sid="PSA 81:14" /><char style="w" x-id="WLC.PSA.81.14.001" x-align="PSA.81.14.a002" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ki" xml:lang="hbo" x-source-ref="PSA.81.15">כִּ֭</char><char style="w" x-id="WLC.PSA.81.14.002" x-align="PSA.81.14.a002" x-target-ids="t003" x-target="soon" x-target-head="t003" x-head="true" lemma="מְעַט" strong="H4592" x-morph="Ncmsa" x-gloss="a.little" x-translit="məʿaṭ" xml:lang="hbo" x-source-ref="PSA.81.15">מְעַט</char> <char style="w" x-id="WLC.PSA.81.14.003" x-align="PSA.81.14.a004" x-target-ids="t006" x-target="enemies" x-target-head="t006" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾôyəḇēy" xml:lang="hbo" x-source-ref="PSA.81.15">אוֹיְבֵי</char><char style="w" x-id="WLC.PSA.81.14.004" x-align="PSA.81.14.a003" x-target-ids="t005" x-target="their" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo" x-source-ref="PSA.81.15">הֶ֣ם</char> <char style="w" x-id="WLC.PSA.81.14.005" x-align="PSA.81.14.a001" x-target-ids="t001 t002 t004" x-target="I would subdue" x-target-head="t004" x-head="true" lemma="כָּנַע" strong="H3665" x-morph="Vhi1cs" x-gloss="I.will.subdue" x-translit="ʾaḵniyᵃʿ" xml:lang="hbo" x-source-ref="PSA.81.15">אַכְנִ֑יעַ</char> <char style="w" x-id="WLC.PSA.81.14.006" x-align="PSA.81.14.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.81.15">וְ</char><char style="w" x-id="WLC.PSA.81.14.007" x-align="PSA.81.14.a009" x-target-ids="t011" x-target="against" x-target-head="t011" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal" xml:lang="hbo" x-source-ref="PSA.81.15">עַ֥ל</char> <char style="w" x-id="WLC.PSA.81.14.008" x-align="PSA.81.14.a011" x-target-ids="t013" x