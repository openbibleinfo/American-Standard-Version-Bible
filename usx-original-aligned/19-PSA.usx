	<para style="p"><verse number="10" style="v" x-ref="PSA.109.10" x-added-alignments="PSA.109.10.a010" x-added-target-ids="t012 t013" x-added-target="their bread" sid="PSA 109:10" /><char style="w" x-id="WLC.PSA.109.10.001" x-align="PSA.109.10.a001" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.109.10.002" x-align="PSA.109.10.a002" x-status="unrepresented" x-head="true" lemma="נוּעַ" strong="H5128" x-morph="Vqa" x-gloss="really.(wander)" x-translit="nôᵃʿ" xml:lang="hbo">נ֤וֹעַ</char> <char style="w" x-id="WLC.PSA.109.10.003" x-align="PSA.109.10.a003" x-target-ids="t001 t004 t005" x-target="Let be vagabonds" x-target-head="t005" x-head="true" lemma="נוּעַ" strong="H5128" x-morph="Vqi3mp" x-gloss="may.they.wander" x-translit="yānûʿû" xml:lang="hbo">יָנ֣וּעוּ</char> <char style="w" x-id="WLC.PSA.109.10.004" x-align="PSA.109.10.a004" x-target-ids="t003" x-target="children" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="ḇānāy" xml:lang="hbo">בָנָ֣י</char><char style="w" x-id="WLC.PSA.109.10.005" x-align="PSA.109.10.a005" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.109.10.006" x-align="PSA.109.10.a006" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.109.10.007" x-align="PSA.109.10.a007" x-target-ids="t007" x-target="beg" x-target-head="t007" x-head="true" lemma="שָׁאַל" strong="H7592" x-morph="Vpq3cp" x-gloss="they.will.beg" x-translit="šiʾēlû" xml:lang="hbo">שִׁאֵ֑לוּ</char> <char style="w" x-id="WLC.PSA.109.10.008" x-align="PSA.109.10.a008" x-target-ids="t008" x-target="And" x-target-head="t008" x-head