	<para style="p"><verse number="3" style="v" x-ref="PSA.80.3" sid="PSA 80:3" /><char style="w" x-id="WLC.PSA.80.3.001" x-align="PSA.80.3.a001" x-target-ids="t004 t005" x-target="O God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.80.4">אֱלֹהִ֥ים</char> <char style="w" x-id="WLC.PSA.80.3.002" x-align="PSA.80.3.a002" x-target-ids="t001 t003" x-target="Turn again" x-target-head="t001" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhv2ms" x-gloss="restore" x-translit="hăšiyḇ" xml:lang="hbo" x-source-ref="PSA.80.4">הֲשִׁיבֵ֑</char><char style="w" x-id="WLC.PSA.80.3.003" x-align="PSA.80.3.a003" x-target-ids="t002" x-target="us" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ēnû" xml:lang="hbo" x-source-ref="PSA.80.4">נוּ</char> <char style="w" x-id="WLC.PSA.80.3.004" x-align="PSA.80.3.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.80.4">וְ</char><char style="w" x-id="WLC.PSA.80.3.005" x-align="PSA.80.3.a005" x-target-ids="t007 t010 t011" x-target="cause to shine" x-target-head="t011" x-head="true" lemma="אוֹר" strong="H215" x-morph="Vhv2ms" x-gloss="make.shine" x-translit="hāʾēr" xml:lang="hbo" x-source-ref="PSA.80.4">הָאֵ֥ר</char> <char style="w" x-id="WLC.PSA.80.3.006" x-align="PSA.80.3.a006" x-target-ids="t009" x-target="face" x-target-head="t009" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="face" x-translit="pāney" xml:lang="hbo" x-source-ref="PSA.80.4">פָּ֝נֶ֗י</char><char style="w" x-id="WLC.PSA.80.3.007" x-align="PSA.80.3.a007" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.80.4">ךָ</char> <char style="w" x-id="WLC