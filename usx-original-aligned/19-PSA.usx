	<para style="p"><verse number="17" style="v" x-ref="PSA.10.17" sid="PSA 10:17" /><char style="w" x-id="WLC.PSA.10.17.001" x-align="PSA.10.17.a001" x-target-ids="t005 t006" x-target="the desire" x-target-head="t006" x-head="true" lemma="תַּאֲוָה" strong="H8378" x-morph="Ncfsc" x-gloss="[the].desire" x-translit="taʾăwaṯ" xml:lang="hbo">תַּאֲוַ֬ת</char> <char style="w" x-id="WLC.PSA.10.17.002" x-align="PSA.10.17.a002" x-target-ids="t007 t008 t009" x-target="of the meek" x-target-head="t009" x-head="true" lemma="עָנָו" strong="H6035" x-morph="Aampa" x-gloss="of.humble.[people]" x-translit="ʿănāwiym" xml:lang="hbo">עֲנָוִ֣ים</char> <char style="w" x-id="WLC.PSA.10.17.003" x-align="PSA.10.17.a003" x-target-ids="t002 t003 t004" x-target="thou hast heard" x-target-head="t004" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp2ms" x-gloss="you.have.heard" x-translit="šāmaʿətā" xml:lang="hbo">שָׁמַ֣עְתָּ</char> <char style="w" x-id="WLC.PSA.10.17.004" x-align="PSA.10.17.a004" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.10.17.005" x-align="PSA.10.17.a005" x-target-ids="t010 t011 t012" x-target="Thou wilt prepare" x-target-head="t012" x-head="true" lemma="כּוּן" strong="H3559" x-morph="Vhi2ms" x-gloss="you.establish" x-translit="tāḵiyn" xml:lang="hbo">תָּכִ֥ין</char> <char style="w" x-id="WLC.PSA.10.17.006" x-align="PSA.10.17.a006" x-target-ids="t014" x-target="heart" x-target-head="t014" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִ֝בָּ֗</char><char style="w" x-id="WLC.PSA.10.17.007" x-align="PSA.10.17.a007" x-target-ids="t013" x-target="their" x-target-head="t013" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.10.17.008" x-align="PSA.10.17.a008