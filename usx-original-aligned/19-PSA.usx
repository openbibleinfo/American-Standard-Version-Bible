	<para style="p"><verse number="8" style="v" x-ref="PSA.22.8" x-added-alignments="PSA.22.8.a002" x-added-target-ids="t002" x-added-target="thyself" sid="PSA 22:8" /><char style="w" x-id="WLC.PSA.22.8.001" x-align="PSA.22.8.a001" x-target-ids="t001" x-target="Commit" x-target-head="t001" x-head="true" lemma="גָּלַל" strong="H1556" x-morph="Vqv2ms" x-gloss="roll" x-translit="gōl" xml:lang="hbo" x-source-ref="PSA.22.9">גֹּ֣ל</char> <char style="w" x-id="WLC.PSA.22.8.002" x-align="PSA.22.8.a003" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo" x-source-ref="PSA.22.9">אֶל</char>־<char style="w" x-id="WLC.PSA.22.8.003" x-align="PSA.22.8.a004" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.22.9">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.22.8.004" x-align="PSA.22.8.a005" x-target-ids="t005 t006 t007" x-target="let him deliver" x-target-head="t007" x-head="true" lemma="פָּלַט" strong="H6403" x-morph="Vpi3ms" x-gloss="let" x-translit="yəp̄alləṭ" xml:lang="hbo" x-source-ref="PSA.22.9">יְפַלְּטֵ֑</char><char style="w" x-id="WLC.PSA.22.8.005" x-align="PSA.22.8.a006" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="him.rescue.him" x-translit="ēhû" xml:lang="hbo" x-source-ref="PSA.22.9">הוּ</char> <char style="w" x-id="WLC.PSA.22.8.006" x-align="PSA.22.8.a007" x-target-ids="t009 t010 t011" x-target="Let him rescue" x-target-head="t011" x-head="true" lemma="נָצַל" strong="H5337" x-morph="Vhi3ms" x-gloss="let" x-translit="yaṣṣiyl" xml:lang="hbo" x-source-ref="PSA.22.9">יַ֝צִּילֵ֗</char><char style="w" x-id="WLC.PSA.22.8.007" x-align="PSA.22.8.a008" x-target-ids="t012" x-target="him" x-target-head="t012" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-glo