	<para style="p"><verse number="13" style="v" x-ref="PSA.88.13" sid="PSA 88:13" /><char style="w" x-id="WLC.PSA.88.13.001" x-align="PSA.88.13.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.88.14">וַ</char><char style="w" x-id="WLC.PSA.88.13.002" x-align="PSA.88.13.a002" x-target-ids="t007" x-target="I" x-target-head="t007" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo" x-source-ref="PSA.88.14">אֲנִ֤י</char>׀<char style="w" x-id="WLC.PSA.88.13.003" x-align="PSA.88.13.a003" x-target-ids="t002" x-target="unto" x-target-head="t002" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēley" xml:lang="hbo" x-source-ref="PSA.88.14">אֵלֶ֣י</char><char style="w" x-id="WLC.PSA.88.13.004" x-align="PSA.88.13.a004" x-target-ids="t003" x-target="thee" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.88.14">ךָ</char> <char style="w" x-id="WLC.PSA.88.13.005" x-align="PSA.88.13.a005" x-target-ids="t004 t005" x-target="O Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.88.14">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.88.13.006" x-align="PSA.88.13.a006" x-target-ids="t006 t008" x-target="have cried" x-target-head="t008" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpp1cs" x-gloss="I.cry.for.help" x-translit="šiwwaʿətî" xml:lang="hbo" x-source-ref="PSA.88.14">שִׁוַּ֑עְתִּי</char> <char style="w" x-id="WLC.PSA.88.13.007" x-align="PSA.88.13.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.88.14">וּ֝</char><char style="w" x-id="WLC.PSA.88.13.008