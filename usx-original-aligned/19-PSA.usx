	<para style="p"><verse number="4" style="v" x-ref="PSA.14.4" x-added-alignments="PSA.14.4.a012" x-added-target-ids="t018" x-added-target="And" sid="PSA 14:4" /><char style="w" x-id="WLC.PSA.14.4.001" x-align="PSA.14.4.a001" x-target-ids="t001" x-target="Have" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="hă" xml:lang="hbo">הֲ</char><char style="w" x-id="WLC.PSA.14.4.002" x-align="PSA.14.4.a002" x-target-ids="t007" x-target="no" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.PSA.14.4.003" x-align="PSA.14.4.a003" x-target-ids="t008" x-target="knowledge" x-target-head="t008" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3cp" x-gloss="do.they.know" x-translit="yāḏʿû" xml:lang="hbo">יָדְעוּ֮</char> <char style="w" x-id="WLC.PSA.14.4.004" x-align="PSA.14.4.a004" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.14.4.005" x-align="PSA.14.4.a005" x-target-ids="t003 t004" x-target="the workers" x-target-head="t004" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqrmpc" x-gloss="[those.who].do" x-translit="pōʿălēy" xml:lang="hbo">פֹּ֪עֲלֵ֫י</char> <char style="w" x-id="WLC.PSA.14.4.006" x-align="PSA.14.4.a006" x-target-ids="t005 t006" x-target="of iniquity" x-target-head="t006" x-head="true" lemma="אָוֶן" strong="H205" x-morph="Ncmsa" x-gloss="(of).wickedness" x-translit="ʾāwen" xml:lang="hbo">אָ֥וֶן</char> <char style="w" x-id="WLC.PSA.14.4.007" x-align="PSA.14.4.a007" x-target-ids="t009 t010 t011" x-target="Who eat up" x-target-head="t010" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqrmpc" x-gloss="[those.who].devour" x-translit="ʾōḵəlēy" xml:lang="hbo">אֹכְלֵ֣י</char> <char style="w" x-id="WLC.PSA.14.4.008" x-align="PSA.14.4.a008" x-targ