	<para style="p"><verse number="63" style="v" x-ref="PSA.119.63" sid="PSA 119:63" /><char style="w" x-id="WLC.PSA.119.63.001" x-align="PSA.119.63.a001" x-target-ids="t002 t003 t004" x-target="am a companion" x-target-head="t004" x-head="true" lemma="חָבֵר" strong="H2270" x-morph="Ncmsa" x-gloss="[am].a.companion" x-translit="ḥāḇēr" xml:lang="hbo">חָבֵ֣ר</char> <char style="w" x-id="WLC.PSA.119.63.002" x-align="PSA.119.63.a002" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānî" xml:lang="hbo">אָ֭נִי</char> <char style="w" x-id="WLC.PSA.119.63.003" x-align="PSA.119.63.a003" x-target-ids="t005" x-target="of" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.119.63.004" x-align="PSA.119.63.a004" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.119.63.005" x-align="PSA.119.63.a005" x-target-ids="t007 t008" x-target="them that" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[those].who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.PSA.119.63.006" x-align="PSA.119.63.a006" x-target-ids="t009" x-target="fear" x-target-head="t009" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqp3cp" x-gloss="they" x-translit="yərēʾû" xml:lang="hbo">יְרֵא֑וּ</char><char style="w" x-id="WLC.PSA.119.63.007" x-align="PSA.119.63.a007" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="fear.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.63.008" x-align="PSA.119.63.a008" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph=