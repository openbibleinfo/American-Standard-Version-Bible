	<para style="p"><verse number="5" style="v" x-ref="PSA.69.5" sid="PSA 69:5" /><char style="w" x-id="WLC.PSA.69.5.001" x-align="PSA.69.5.a001" x-target-ids="t001 t002" x-target="O God" x-target-head="t002" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.69.6">אֱֽלֹהִ֗ים</char> <char style="w" x-id="WLC.PSA.69.5.002" x-align="PSA.69.5.a002" x-target-ids="t003" x-target="thou" x-target-head="t003" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.69.6">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.69.5.003" x-align="PSA.69.5.a003" x-target-ids="t004" x-target="knowest" x-target-head="t004" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp2ms" x-gloss="you.know" x-translit="yāḏaʿtā" xml:lang="hbo" x-source-ref="PSA.69.6">יָ֭דַעְתָּ</char> <char style="w" x-id="WLC.PSA.69.5.004" x-align="PSA.69.5.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.69.6">לְ</char><char style="w" x-id="WLC.PSA.69.5.005" x-align="PSA.69.5.a005" x-target-ids="t006" x-target="foolishness" x-target-head="t006" x-head="true" lemma="אִוֶּלֶת" strong="H200" x-morph="Ncfsc" x-gloss="folly" x-translit="ʾiwwalt" xml:lang="hbo" x-source-ref="PSA.69.6">אִוַּלְתִּ֑</char><char style="w" x-id="WLC.PSA.69.5.006" x-align="PSA.69.5.a006" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.69.6">י</char> <char style="w" x-id="WLC.PSA.69.5.007" x-align="PSA.69.5.a007" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.69.6">וְ֝</char><char style="w" x-id="WLC.PSA.69.5.008" x-align="PSA.69.5.a008" x-target-ids="