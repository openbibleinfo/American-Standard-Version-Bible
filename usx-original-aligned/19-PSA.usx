	<para style="d" x-ref="PSA.83.0"><char style="w" x-id="WLC.PSA.83.0.001" x-align="PSA.83.0.a001" x-target-ids="t001 t002" x-target="A Song" x-target-head="t002" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsa" x-gloss="a.song" x-translit="šiyr" xml:lang="hbo" x-source-ref="PSA.83.1">שִׁ֖יר</char> <char style="w" x-id="WLC.PSA.83.0.002" x-align="PSA.83.0.a002" x-target-ids="t003 t004" x-target="a Psalm" x-target-head="t004" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.83.1">מִזְמ֣וֹר</char> <char style="w" x-id="WLC.PSA.83.0.003" x-align="PSA.83.0.a003" x-target-ids="t005" x-target="of" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.83.1">לְ</char><char style="w" x-id="WLC.PSA.83.0.004" x-align="PSA.83.0.a004" x-target-ids="t006" x-target="Asaph" x-target-head="t006" x-head="true" lemma="אָסָף" strong="H623" x-morph="Np" x-gloss="Asaph" x-translit="ʾāsāp̄:" xml:lang="hbo" x-source-ref="PSA.83.1">אָסָֽף</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.83.1" sid="PSA 83:1" /><char style="w" x-id="WLC.PSA.83.1.001" x-align="PSA.83.1.a001" x-target-ids="t001 t002" x-target="O God" x-target-head="t002" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.83.2">אֱלֹהִ֥ים</char> <char style="w" x-id="WLC.PSA.83.1.002" x-align="PSA.83.1.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="[let].not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.83.2">אַל</char>־<char style="w" x-id="WLC.PSA.83.1.003" x-align="PSA.83.1.a003" x-target-ids="t006" x-target="silence" x-target-head="t006" x-head="true" lemma="דֳּמִי" strong="H1824" x-morph="Ncmsa" x-gloss="rest" x-translit="dŏmî-" xml:lang="hbo" x-source-ref="PSA.83.2">דֳּמִי</char>־<char style="w" x-id="WLC.PSA.83.1.004" x-align="PSA.83.1.a004" x-target-ids="t003" x-target="keep" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belong].to" x-translit="l" xml:lang="hbo" x-source-ref="PSA.83.2">לָ֑</char><char style="w" x-id="WLC.PSA.83.1.005" x-align="PSA.83.1.a005" x-target-ids="t005" x-target="thou" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo" x-source-ref="PSA.83.2">ךְ</char> <char style="w" x-id="WLC.PSA.83.1.006" x-align="PSA.83.1.a006" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.83.2">אַל</char>־<char style="w" x-id="WLC.PSA.83.1.007" x-align="PSA.83.1.a007" x-target-ids="t007 t009 t010" x-target="Hold thy peace" x-target-head="t010" x-head="true" lemma="חָרֵשׁ" strong="H2790a" x-morph="Vqj2ms" x-gloss="be.silent" x-translit="teḥĕraš" xml:lang="hbo" x-source-ref="PSA.83.2">תֶּחֱרַ֖שׁ</char> <char style="w" x-id="WLC.PSA