	<para style="p"><verse number="3" style="v" x-ref="PSA.34.3" sid="PSA 34:3" /><char style="w" x-id="WLC.PSA.34.3.001" x-align="PSA.34.3.a001" x-target-ids="t001 t002" x-target="Oh magnify" x-target-head="t002" x-head="true" lemma="גָּדַל" strong="H1431" x-morph="Vpv2mp" x-gloss="magnify" x-translit="gaddəlû" xml:lang="hbo" x-source-ref="PSA.34.4">גַּדְּל֣וּ</char> <char style="w" x-id="WLC.PSA.34.3.002" x-align="PSA.34.3.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="la" xml:lang="hbo" x-source-ref="PSA.34.4">לַ</char><char style="w" x-id="WLC.PSA.34.3.003" x-align="PSA.34.3.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo" x-source-ref="PSA.34.4">יהוָ֣ה</char> <char style="w" x-id="WLC.PSA.34.3.004" x-align="PSA.34.3.a004" x-target-ids="t004" x-target="with" x-target-head="t004" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾitt" xml:lang="hbo" x-source-ref="PSA.34.4">אִתִּ֑</char><char style="w" x-id="WLC.PSA.34.3.005" x-align="PSA.34.3.a005" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.34.4">י</char> <char style="w" x-id="WLC.PSA.34.3.006" x-align="PSA.34.3.a006" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.34.4">וּ</char><char style="w" x-id="WLC.PSA.34.3.007" x-align="PSA.34.3.a007" x-target-ids="t007 t008 t009" x-target="let us exalt" x-target-head="t009" x-head="true" lemma="רוּם" strong="H7311" x-morph="Voh1cp" x-gloss="let.us.exalt" x-translit="nərôməmāh" xml:lang="hbo" x-source-ref="PSA.34.4">נְרוֹמְמָ֖ה</char> <char style="w" x-id="WLC.PSA.34.3.008" x-align="PSA.34.3.a008" x-target-ids="