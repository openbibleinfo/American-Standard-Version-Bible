	<para style="p"><verse number="25" style="v" x-ref="PSA.69.25" sid="PSA 69:25" /><char style="w" x-id="WLC.PSA.69.25.001" x-align="PSA.69.25.a001" x-target-ids="t001 t004" x-target="Let be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3fs" x-gloss="may.it.be" x-translit="təhî-" xml:lang="hbo" x-source-ref="PSA.69.26">תְּהִי</char>־<char style="w" x-id="WLC.PSA.69.25.002" x-align="PSA.69.25.a002" x-target-ids="t003" x-target="habitation" x-target-head="t003" x-head="true" lemma="טִירָה" strong="H2918" x-morph="Ncfsc" x-gloss="encampment" x-translit="ṭiyrāṯ" xml:lang="hbo" x-source-ref="PSA.69.26">טִֽירָתָ֥</char><char style="w" x-id="WLC.PSA.69.25.003" x-align="PSA.69.25.a003" x-target-ids="t002" x-target="their" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="PSA.69.26">ם</char> <char style="w" x-id="WLC.PSA.69.25.004" x-align="PSA.69.25.a004" x-target-ids="t005" x-target="desolate" x-target-head="t005" x-head="true" lemma="נְשָׁמָה" strong="H8074" x-morph="VNrfsa" x-gloss="made.desolate" x-translit="nəšammāh" xml:lang="hbo" x-source-ref="PSA.69.26">נְשַׁמָּ֑ה</char> <char style="w" x-id="WLC.PSA.69.25.005" x-align="PSA.69.25.a008" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.69.26">בְּ֝</char><char style="w" x-id="WLC.PSA.69.25.006" x-align="PSA.69.25.a009" x-target-ids="t011" x-target="tents" x-target-head="t011" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmpc" x-gloss="tents" x-translit="ʾāhŏlēy" xml:lang="hbo" x-source-ref="PSA.69.26">אָהֳלֵי</char><char style="w" x-id="WLC.PSA.69.25.007" x-align="PSA.69.25.a010" x-target-ids="t010" x-target="their" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo" x-source-ref="PSA.69.26">הֶ֗ם</ch