	<para style="p"><verse number="8" style="v" x-ref="PSA.17.8" sid="PSA 17:8" /><char style="w" x-id="WLC.PSA.17.8.001" x-align="PSA.17.8.a001" x-target-ids="t001" x-target="Keep" x-target-head="t001" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqv2ms" x-gloss="keep" x-translit="šāmər" xml:lang="hbo">שָׁ֭מְרֵ</char><char style="w" x-id="WLC.PSA.17.8.002" x-align="PSA.17.8.a002" x-target-ids="t002" x-target="me" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.17.8.003" x-align="PSA.17.8.a003" x-target-ids="t003" x-target="as" x-target-head="t003" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like.[the]" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.PSA.17.8.004" x-align="PSA.17.8.a004" x-target-ids="t004 t005" x-target="the apple" x-target-head="t005" x-head="true" lemma="אִישׁוֹן" strong="H380" x-morph="Ncmsc" x-gloss="pupil" x-translit="ʾîšôn" xml:lang="hbo">אִישׁ֣וֹן</char> <char style="w" x-id="WLC.PSA.17.8.005" x-align="PSA.17.8.a005" x-status="unrepresented" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfsc" x-gloss="of.[the].daughter" x-translit="baṯ-" xml:lang="hbo">בַּת</char>־<char style="w" x-id="WLC.PSA.17.8.006" x-align="PSA.17.8.a006" x-target-ids="t006 t007 t008" x-target="of the eye" x-target-head="t008" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbsa" x-gloss="of.an.eye" x-translit="ʿāyin" xml:lang="hbo">עָ֑יִן</char> <char style="w" x-id="WLC.PSA.17.8.007" x-align="PSA.17.8.a007" x-target-ids="t011" x-target="under" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.17.8.008" x-align="PSA.17.8.a008" x-target-ids="t012 t013" x-target="the shadow" x-target-head="t013" x-head="true" lemma="צֵל" strong="H6738" x-morph="Ncmsc" x-gloss="the.shadow" x-translit="ṣēl" xml:la