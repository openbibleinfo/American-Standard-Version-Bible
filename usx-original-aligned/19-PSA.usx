	<para style="p"><verse number="16" style="v" x-ref="PSA.51.16" x-added-alignments="PSA.51.16.a007" x-added-target-ids="t011" x-added-target="it" sid="PSA 51:16" /><char style="w" x-id="WLC.PSA.51.16.001" x-align="PSA.51.16.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.51.18">כִּ֤י</char>׀<char style="w" x-id="WLC.PSA.51.16.002" x-align="PSA.51.16.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.51.18">לֹא</char>־<char style="w" x-id="WLC.PSA.51.16.003" x-align="PSA.51.16.a003" x-target-ids="t002 t003 t005" x-target="thou delightest in" x-target-head="t003" x-head="true" lemma="חָפֵץ" strong="H2654" x-morph="Vqi2ms" x-gloss="you.desire" x-translit="ṯaḥpōṣ" xml:lang="hbo" x-source-ref="PSA.51.18">תַחְפֹּ֣ץ</char> <char style="w" x-id="WLC.PSA.51.16.004" x-align="PSA.51.16.a004" x-target-ids="t006" x-target="sacrifice" x-target-head="t006" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmsa" x-gloss="sacrifice" x-translit="zeḇaḥ" xml:lang="hbo" x-source-ref="PSA.51.18">זֶ֣בַח</char> <char style="w" x-id="WLC.PSA.51.16.005" x-align="PSA.51.16.a005" x-target-ids="t007" x-target="else" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.51.18">וְ</char><char style="w" x-id="WLC.PSA.51.16.006" x-align="PSA.51.16.a006" x-target-ids="t008 t009 t010" x-target="would I give" x-target-head="t010" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqh1cs" x-gloss="I.will.give.[it]" x-translit="ʾettēnâ" xml:lang="hbo" x-source-ref="PSA.51.18">אֶתֵּ֑נָה</char> <char style="w" x-id="WLC.PSA.51.16.007" x-align="PSA.51.16.a008" x-target-ids="t017 t018" x-target="burnt offering" x-target-head="t017" x-head="true" lemma="עֹלָה" stro