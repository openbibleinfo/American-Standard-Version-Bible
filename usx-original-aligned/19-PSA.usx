	<para style="p"><verse number="17" style="v" x-ref="PSA.49.17" sid="PSA 49:17" /><char style="w" x-id="WLC.PSA.49.17.001" x-align="PSA.49.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.49.18">כִּ֤י</char> <char style="w" x-id="WLC.PSA.49.17.002" x-align="PSA.49.17.a002" x-target-ids="t008" x-target="nothing" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.49.18">לֹ֣א</char> <char style="w" x-id="WLC.PSA.49.17.003" x-align="PSA.49.17.a003" x-target-ids="t002" x-target="when" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.49.18">בְ֭</char><char style="w" x-id="WLC.PSA.49.17.004" x-align="PSA.49.17.a004" x-target-ids="t004" x-target="dieth" x-target-head="t004" x-head="true" lemma="מָוֶת" strong="H4194" x-morph="Ncmsc" x-gloss="death" x-translit="môṯ" xml:lang="hbo" x-source-ref="PSA.49.18">מוֹת</char><char style="w" x-id="WLC.PSA.49.17.005" x-align="PSA.49.17.a005" x-target-ids="t003" x-target="he" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.49.18">וֹ</char> <char style="w" x-id="WLC.PSA.49.17.006" x-align="PSA.49.17.a006" x-target-ids="t005 t006 t007 t009" x-target="he shall carry away" x-target-head="t007" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqi3ms" x-gloss="he.will.take" x-translit="yiqqaḥ" xml:lang="hbo" x-source-ref="PSA.49.18">יִקַּ֣ח</char> <char style="w" x-id="WLC.PSA.49.17.007" x-align="PSA.49.17.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.49.18">הַ</char><char style="w" x-id="WLC.PSA.49.17.008" x-align="PSA.49.17.a002" lemma="כֹּ