	<para style="p"><verse number="9" style="v" x-ref="PSA.112.9" sid="PSA 112:9" /><char style="w" x-id="WLC.PSA.112.9.001" x-align="PSA.112.9.a001" x-target-ids="t001 t002 t003" x-target="He hath dispersed" x-target-head="t003" x-head="true" lemma="פָּזַר" strong="H6340" x-morph="Vpp3ms" x-gloss="he.scatters" x-translit="pizzar" xml:lang="hbo">פִּזַּ֤ר</char>׀<char style="w" x-id="WLC.PSA.112.9.002" x-align="PSA.112.9.a002" x-target-ids="t004 t005 t006" x-target="he hath given" x-target-head="t006" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp3ms" x-gloss="he.gives" x-translit="nāṯan" xml:lang="hbo">נָ֘תַ֤ן</char> <char style="w" x-id="WLC.PSA.112.9.003" x-align="PSA.112.9.a003" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to.(the)" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PSA.112.9.004" x-align="PSA.112.9.a004" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="needy" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.112.9.005" x-align="PSA.112.9.a005" x-target-ids="t009" x-target="needy" x-target-head="t009" x-head="true" lemma="אֶבְיוֹן" strong="H34" x-morph="Aampa" x-gloss="[people]" x-translit="ʾeḇyôniym" xml:lang="hbo">אֶבְיוֹנִ֗ים</char> <char style="w" x-id="WLC.PSA.112.9.006" x-align="PSA.112.9.a007" x-target-ids="t011" x-target="righteousness" x-target-head="t011" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsc" x-gloss="righteousness" x-translit="ṣiḏqāṯ" xml:lang="hbo">צִ֭דְקָת</char><char style="w" x-id="WLC.PSA.112.9.007" x-align="PSA.112.9.a006" x-target-ids="t010" x-target="His" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.112.9.008" x-align="PSA.112.9.a008" x-target-ids="t012" x-target="endureth" x-target-head="t012" x-head="t