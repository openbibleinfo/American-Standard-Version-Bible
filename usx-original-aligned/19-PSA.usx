	<para style="p"><verse number="11" style="v" x-ref="PSA.36.11" sid="PSA 36:11" /><char style="w" x-id="WLC.PSA.36.11.001" x-align="PSA.36.11.a002" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.36.12">אַל</char>־<char style="w" x-id="WLC.PSA.36.11.002" x-align="PSA.36.11.a001" x-target-ids="t001 t007 t008" x-target="Let come against" x-target-head="t007" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqj3fs" x-gloss="may" x-translit="təḇôʾ" xml:lang="hbo" x-source-ref="PSA.36.12">תְּ֭בוֹאֵ</char><char style="w" x-id="WLC.PSA.36.11.003" x-align="PSA.36.11.a005" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="it.come.to.me" x-translit="ēniy" xml:lang="hbo" x-source-ref="PSA.36.12">נִי</char> <char style="w" x-id="WLC.PSA.36.11.004" x-align="PSA.36.11.a003" x-target-ids="t003 t004" x-target="the foot" x-target-head="t004" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfsc" x-gloss="[the].foot" x-translit="reḡel" xml:lang="hbo" x-source-ref="PSA.36.12">רֶ֣גֶל</char> <char style="w" x-id="WLC.PSA.36.11.005" x-align="PSA.36.11.a004" x-target-ids="t005 t006" x-target="of pride" x-target-head="t006" x-head="true" lemma="גַּאֲוָה" strong="H1346" x-morph="Ncfsa" x-gloss="of.pride" x-translit="gaʾăwāh" xml:lang="hbo" x-source-ref="PSA.36.12">גַּאֲוָ֑ה</char> <char style="w" x-id="WLC.PSA.36.11.006" x-align="PSA.36.11.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.36.12">וְ</char><char style="w" x-id="WLC.PSA.36.11.007" x-align="PSA.36.11.a009" x-target-ids="t013 t014" x-target="the hand" x-target-head="t014" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yaḏ-" xml:lang="hbo" x-source-ref="PSA.36.