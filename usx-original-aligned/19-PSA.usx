	<para style="p"><verse number="1" style="v" x-ref="PSA.85.1" sid="PSA 85:1" /><char style="w" x-id="WLC.PSA.85.1.001" x-align="PSA.85.1.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="thou hast been favorable unto" x-target-head="t005" x-head="true" lemma="רָצָה" strong="H7521" x-morph="Vqp2ms" x-gloss="you.showed.favor.to" x-translit="rāṣiyṯā" xml:lang="hbo" x-source-ref="PSA.85.2">רָצִ֣יתָ</char> <char style="w" x-id="WLC.PSA.85.1.002" x-align="PSA.85.1.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.85.2">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.85.1.003" x-align="PSA.85.1.a004" x-target-ids="t008" x-target="land" x-target-head="t008" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsc" x-gloss="land" x-translit="ʾarṣ" xml:lang="hbo" x-source-ref="PSA.85.2">אַרְצֶ֑</char><char style="w" x-id="WLC.PSA.85.1.004" x-align="PSA.85.1.a003" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.85.2">ךָ</char> <char style="w" x-id="WLC.PSA.85.1.005" x-align="PSA.85.1.a005" x-target-ids="t009 t010 t011 t012" x-target="Thou hast brought back" x-target-head="t011" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqp2ms" x-gloss="you.turned.back" x-translit="šaḇətā" xml:lang="hbo" x-source-ref="PSA.85.2">שַׁ֝֗בְתָּ</char> <char style="w" x-id="WLC.PSA.85.1.006" x-align="PSA.85.1.a006" x-target-ids="t013 t014" x-target="the captivity" x-target-head="t014" x-head="true" lemma="שְׁבִית" strong="H7622a" x-morph="Ncfsc" x-gloss="the.captivity" x-translit="**šəḇiyṯ" xml:lang="hbo" x-source-ref="PSA.85.2">שְׁבִ֣ית</char> <char style="w" x-id="WLC.PSA.85.1.007" x-align="PSA.85.1.a007" x-target-ids="t015 t016" x-target="of Jacob" x-target-head="t016" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-