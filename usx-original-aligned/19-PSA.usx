	<para style="p"><verse number="1" style="v" x-ref="PSA.44.1" x-added-alignments="PSA.44.1.a011" x-added-target-ids="t014" x-added-target="What" sid="PSA 44:1" /><char style="w" x-id="WLC.PSA.44.1.001" x-align="PSA.44.1.a001" x-target-ids="t007 t008" x-target="O God" x-target-head="t008" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.44.2">אֱלֹהִ֤ים</char>׀<char style="w" x-id="WLC.PSA.44.1.002" x-align="PSA.44.1.a002" x-target-ids="t004" x-target="with" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.44.2">בְּ</char><char style="w" x-id="WLC.PSA.44.1.003" x-align="PSA.44.1.a003" x-target-ids="t006" x-target="ears" x-target-head="t006" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfdc" x-gloss="ears" x-translit="ʾāzənēy" xml:lang="hbo" x-source-ref="PSA.44.2">אָזְנֵ֬י</char><char style="w" x-id="WLC.PSA.44.1.004" x-align="PSA.44.1.a004" x-target-ids="t005" x-target="our" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo" x-source-ref="PSA.44.2">נוּ</char> <char style="w" x-id="WLC.PSA.44.1.005" x-align="PSA.44.1.a005" x-target-ids="t001 t002 t003" x-target="We have heard" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp1cp" x-gloss="we.have.heard" x-translit="šāmaʿənû" xml:lang="hbo" x-source-ref="PSA.44.2">שָׁמַ֗עְנוּ</char> <char style="w" x-id="WLC.PSA.44.1.006" x-align="PSA.44.1.a006" x-target-ids="t010" x-target="fathers" x-target-head="t010" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmpc" x-gloss="ancestors" x-translit="ʾăḇôṯēy" xml:lang="hbo" x-source-ref="PSA.44.2">אֲבוֹתֵ֥י</char><char style="w" x-id="WLC.PSA.44.1.007" x-align="PSA.44.1.a007" x-target-ids="t009" x-target="Our" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-