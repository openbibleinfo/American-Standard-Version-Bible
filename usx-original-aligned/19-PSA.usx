	<para style="p"><verse number="13" style="v" x-ref="PSA.140.13" sid="PSA 140:13" /><char style="w" x-id="WLC.PSA.140.13.001" x-align="PSA.140.13.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ" xml:lang="hbo" x-source-ref="PSA.140.14">אַ֣ךְ</char> <char style="w" x-id="WLC.PSA.140.13.002" x-align="PSA.140.13.a002" x-target-ids="t002 t003" x-target="the righteous" x-target-head="t003" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="righteous.[people]" x-translit="ṣaddîqîm" xml:lang="hbo" x-source-ref="PSA.140.14">צַ֭דִּיקִים</char> <char style="w" x-id="WLC.PSA.140.13.003" x-align="PSA.140.13.a003" x-target-ids="t004 t005 t006" x-target="shall give thanks" x-target-head="t006" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi3mp" x-gloss="they.will.give.thanks" x-translit="yôḏû" xml:lang="hbo" x-source-ref="PSA.140.14">יוֹד֣וּ</char> <char style="w" x-id="WLC.PSA.140.13.004" x-align="PSA.140.13.a004" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="PSA.140.14">לִ</char><char style="w" x-id="WLC.PSA.140.13.005" x-align="PSA.140.13.a005" x-target-ids="t009" x-target="name" x-target-head="t009" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šəm" xml:lang="hbo" x-source-ref="PSA.140.14">שְׁמֶ֑</char><char style="w" x-id="WLC.PSA.140.13.006" x-align="PSA.140.13.a006" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.140.14">ךָ</char> <char style="w" x-id="WLC.PSA.140.13.007" x-align="PSA.140.13.a007" x-target-ids="t012 t013" x-target="shall dwell" x-target-head="t013" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi3mp" x-gloss="they.will.dwell" x-tran