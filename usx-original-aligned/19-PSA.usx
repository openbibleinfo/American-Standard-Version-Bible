	<para style="p"><verse number="14" style="v" x-ref="PSA.80.14" sid="PSA 80:14" /><char style="w" x-id="WLC.PSA.80.14.001" x-align="PSA.80.14.a001" x-target-ids="t006 t007" x-target="O God" x-target-head="t007" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.80.15">אֱלֹהִ֣ים</char> <char style="w" x-id="WLC.PSA.80.14.002" x-align="PSA.80.14.a002" x-target-ids="t008 t009" x-target="of hosts" x-target-head="t009" x-head="true" lemma="צָבָא" strong="H6635" x-morph="Ncbpa" x-gloss="of.hosts" x-translit="ṣəḇāʾôṯ" xml:lang="hbo" x-source-ref="PSA.80.15">צְבָאוֹת֮</char> <char style="w" x-id="WLC.PSA.80.14.003" x-align="PSA.80.14.a003" x-target-ids="t001 t002" x-target="Turn again" x-target-head="t001" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqv2ms" x-gloss="return" x-translit="šûḇ-" xml:lang="hbo" x-source-ref="PSA.80.15">שֽׁ֫וּב</char>־<char style="w" x-id="WLC.PSA.80.14.004" x-align="PSA.80.14.a004" x-target-ids="t003 t004 t005" x-target="we beseech thee" x-target-head="t004" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo" x-source-ref="PSA.80.15">נָ֥א</char> <char style="w" x-id="WLC.PSA.80.14.005" x-align="PSA.80.14.a005" x-target-ids="t010 t011" x-target="Look down" x-target-head="t010" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhv2ms" x-gloss="pay.attention" x-translit="habbēṭ" xml:lang="hbo" x-source-ref="PSA.80.15">הַבֵּ֣ט</char> <char style="w" x-id="WLC.PSA.80.14.006" x-align="PSA.80.14.a006" x-target-ids="t012" x-target="from" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.80.15">מִ</char><char style="w" x-id="WLC.PSA.80.14.007" x-align="PSA.80.14.a007" x-target-ids="t013" x-target="heaven" x-target-head="t013" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heaven" x-translit="ššāmayim" xml