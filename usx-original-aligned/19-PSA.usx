	<para style="p"><verse number="5" style="v" x-ref="PSA.16.5" sid="PSA 16:5" /><char style="w" x-id="WLC.PSA.16.5.001" x-align="PSA.16.5.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.16.5.002" x-align="PSA.16.5.a002" x-target-ids="t002 t003 t004" x-target="is the portion" x-target-head="t004" x-head="true" lemma="מְנָת" strong="H4521" x-morph="Ncfsc" x-gloss="[is].the.portion" x-translit="mənāṯ-" xml:lang="hbo">מְנָת</char>־<char style="w" x-id="WLC.PSA.16.5.003" x-align="PSA.16.5.a003" x-target-ids="t005 t007" x-target="of inheritance" x-target-head="t007" x-head="true" lemma="חֵלֶק" strong="H2506" x-morph="Ncmsc" x-gloss="my.possession" x-translit="ḥelq" xml:lang="hbo">חֶלְקִ֥</char><char style="w" x-id="WLC.PSA.16.5.004" x-align="PSA.16.5.a004" x-target-ids="t006" x-target="mine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.16.5.005" x-align="PSA.16.5.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.16.5.006" x-align="PSA.16.5.a006" x-target-ids="t009 t011" x-target="of cup" x-target-head="t011" x-head="true" lemma="כּוֹס" strong="H3563" x-morph="Ncfsc" x-gloss="cup" x-translit="ḵôs" xml:lang="hbo">כוֹסִ֑</char><char style="w" x-id="WLC.PSA.16.5.007" x-align="PSA.16.5.a007" x-target-ids="t010" x-target="my" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.16.5.008" x-align="PSA.16.5.a008" x-target-ids="t012" x-target="Thou" x-target-head="t012" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-