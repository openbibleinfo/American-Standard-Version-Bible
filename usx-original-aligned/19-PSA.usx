	<para style="d" x-ref="PSA.4.0"><char style="w" x-id="WLC.PSA.4.0.001" x-align="PSA.4.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.4.1">לַ</char><char style="w" x-id="WLC.PSA.4.0.002" x-align="PSA.4.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.4.1">[הַ]</char><char style="w" x-id="WLC.PSA.4.0.003" x-align="PSA.4.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.4.1">מְנַצֵּ֥חַ</char> <char style="w" x-id="WLC.PSA.4.0.004" x-align="PSA.4.0.a004" x-target-ids="t005" x-target="on" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:lang="hbo" x-source-ref="PSA.4.1">בִּ</char><char style="w" x-id="WLC.PSA.4.0.005" x-align="PSA.4.0.a005" x-target-ids="t006 t007" x-target="stringed instruments" x-target-head="t006" x-head="true" lemma="נְגִינָה" strong="H5058" x-morph="Ncfpa" x-gloss="stringed.instruments" x-translit="nəḡînôṯ" xml:lang="hbo" x-source-ref="PSA.4.1">נְגִינ֗וֹת</char> <char style="w" x-id="WLC.PSA.4.0.006" x-align="PSA.4.0.a006" x-target-ids="t008 t009" x-target="A Psalm" x-target-head="t009" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.4.1">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.4.0.007" x-align="PSA.4.0.a007" x-target-ids="t010" x-target="of" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.4.1">לְ</char><char style="w" x-id="WLC.PSA.4.0.008" x-align="PSA.4.0.a008" x-target-ids="t011" x-