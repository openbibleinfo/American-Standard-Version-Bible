	<para style="p"><verse number="26" style="v" x-ref="PSA.69.26" sid="PSA 69:26" /><char style="w" x-id="WLC.PSA.69.26.001" x-align="PSA.69.26.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.69.27">כִּֽי</char>־<char style="w" x-id="WLC.PSA.69.26.002" x-align="PSA.69.26.a004" x-target-ids="t006" x-target="thou" x-target-head="t006" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.69.27">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.69.26.003" x-align="PSA.69.26.a003" x-target-ids="t004 t005" x-target="him whom" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[those].whom" x-translit="ʾăšer-" xml:lang="hbo" x-source-ref="PSA.69.27">אֲשֶׁר</char>־<char style="w" x-id="WLC.PSA.69.26.004" x-align="PSA.69.26.a005" x-target-ids="t007 t008" x-target="hast smitten" x-target-head="t008" x-head="true" lemma="נָכָה" strong="H5221" x-morph="Vhp2ms" x-gloss="you.struck" x-translit="hikkiyṯā" xml:lang="hbo" x-source-ref="PSA.69.27">הִכִּ֣יתָ</char> <char style="w" x-id="WLC.PSA.69.26.005" x-align="PSA.69.26.a002" x-target-ids="t002 t003" x-target="they persecute" x-target-head="t003" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vqp3cp" x-gloss="they.have.harassed" x-translit="rāḏāp̄û" xml:lang="hbo" x-source-ref="PSA.69.27">רָדָ֑פוּ</char> <char style="w" x-id="WLC.PSA.69.26.006" x-align="PSA.69.26.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.69.27">וְ</char><char style="w" x-id="WLC.PSA.69.26.007" x-align="PSA.69.26.a008" x-target-ids="t012" x-target="of" x-target-head="t012" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="concerning" x-translit="ʾel-" xml:lang="hbo" x-source-ref="PSA.6