	<para style="p"><verse number="3" style="v" x-ref="PSA.15.3" sid="PSA 15:3" /><char style="w" x-id="WLC.PSA.15.3.001" x-align="PSA.15.3.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PSA.15.3.002" x-align="PSA.15.3.a001" x-target-ids="t001 t002 t003" x-target="He that slandereth" x-target-head="t003" x-head="true" lemma="רָגַל" strong="H7270" x-morph="Vqp3ms" x-gloss="he.takes.slander" x-translit="rāḡal" xml:lang="hbo">רָגַ֨ל</char>׀<char style="w" x-id="WLC.PSA.15.3.003" x-align="PSA.15.3.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.15.3.004" x-align="PSA.15.3.a004" x-target-ids="t007" x-target="tongue" x-target-head="t007" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="tongue" x-translit="ləšōn" xml:lang="hbo">לְשֹׁנ֗</char><char style="w" x-id="WLC.PSA.15.3.005" x-align="PSA.15.3.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.15.3.006" x-align="PSA.15.3.a006" x-target-ids="t008" x-target="Nor" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.15.3.007" x-align="PSA.15.3.a007" x-target-ids="t009" x-target="doeth" x-target-head="t009" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3ms" x-gloss="he.does" x-translit="ʿāśāh" xml:lang="hbo">עָשָׂ֣ה</char> <char style="w" x-id="WLC.PSA.15.3.008" x-align="PSA.15.3.a009" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hb