	<para style="p"><verse number="3" style="v" x-ref="PSA.108.3" sid="PSA 108:3" /><char style="w" x-id="WLC.PSA.108.3.001" x-align="PSA.108.3.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="I will give thanks unto" x-target-head="t004" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo" x-source-ref="PSA.108.4">אוֹדְ</char><char style="w" x-id="WLC.PSA.108.3.002" x-align="PSA.108.3.a002" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.108.4">ךָ֖</char> <char style="w" x-id="WLC.PSA.108.3.003" x-align="PSA.108.3.a004" x-target-ids="t009" x-target="among" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ḇā" xml:lang="hbo" x-source-ref="PSA.108.4">בָ</char><char style="w" x-id="WLC.PSA.108.3.004" x-align="PSA.108.3.a005" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.108.4">[הַ]</char><char style="w" x-id="WLC.PSA.108.3.005" x-align="PSA.108.3.a006" x-target-ids="t011" x-target="peoples" x-target-head="t011" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmpa" x-gloss="peoples" x-translit="ʿammiym" xml:lang="hbo" x-source-ref="PSA.108.4">עַמִּ֥ים</char>׀<char style="w" x-id="WLC.PSA.108.3.006" x-align="PSA.108.3.a003" x-target-ids="t007 t008" x-target="O Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.108.4">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.108.3.007" x-align="PSA.108.3.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.108.4">וַ֝</char