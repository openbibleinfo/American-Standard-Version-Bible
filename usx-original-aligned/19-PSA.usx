	<para style="p"><verse number="8" style="v" x-ref="PSA.88.8" sid="PSA 88:8" /><char style="w" x-id="WLC.PSA.88.8.001" x-align="PSA.88.8.a001" x-target-ids="t001 t002 t003 t006" x-target="Thou hast put far" x-target-head="t006" x-head="true" lemma="רָחַק" strong="H7368" x-morph="Vhp2ms" x-gloss="you.have.removed.far.away" x-translit="hirḥaqətā" xml:lang="hbo" x-source-ref="PSA.88.9">הִרְחַ֥קְתָּ</char> <char style="w" x-id="WLC.PSA.88.8.002" x-align="PSA.88.8.a002" x-target-ids="t005" x-target="acquaintance" x-target-head="t005" x-head="true" lemma="יָדַע" strong="H3045" x-morph="VPsmpc" x-gloss="acquaintances" x-translit="məyuddāʿ" xml:lang="hbo" x-source-ref="PSA.88.9">מְיֻדָּעַ֗</char><char style="w" x-id="WLC.PSA.88.8.003" x-align="PSA.88.8.a003" x-target-ids="t004" x-target="mine" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo" x-source-ref="PSA.88.9">י</char> <char style="w" x-id="WLC.PSA.88.8.004" x-align="PSA.88.8.a004" x-target-ids="t007" x-target="from" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" xml:lang="hbo" x-source-ref="PSA.88.9">מִ֫מֶּ֥</char><char style="w" x-id="WLC.PSA.88.8.005" x-align="PSA.88.8.a005" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="enniy" xml:lang="hbo" x-source-ref="PSA.88.9">נִּי</char> <char style="w" x-id="WLC.PSA.88.8.006" x-align="PSA.88.8.a006" x-target-ids="t009 t010 t011" x-target="Thou hast made" x-target-head="t011" x-head="true" lemma="שִׁית" strong="H7896" x-morph="Vqp2ms" x-gloss="you" x-translit="šatta" xml:lang="hbo" x-source-ref="PSA.88.9">שַׁתַּ֣</char><char style="w" x-id="WLC.PSA.88.8.007" x-align="PSA.88.8.a007" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="have.made.me" x-translit="niy" xml:lang="hbo" x-sou