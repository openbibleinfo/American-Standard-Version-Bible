	<para style="p"><verse number="16" style="v" x-ref="PSA.73.16" sid="PSA 73:16" /><char style="w" x-id="WLC.PSA.73.16.001" x-align="PSA.73.16.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָֽ֭</char><char style="w" x-id="WLC.PSA.73.16.002" x-align="PSA.73.16.a002" x-target-ids="t002 t003" x-target="I thought" x-target-head="t003" x-head="true" lemma="חָשַׁב" strong="H2803" x-morph="Vpw1cs" x-gloss="I" x-translit="ʾăḥaššəḇ" xml:lang="hbo">אֲחַשְּׁבָ</char><char style="w" x-id="WLC.PSA.73.16.003" x-align="PSA.73.16.a003" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-gloss="thought" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PSA.73.16.004" x-align="PSA.73.16.a004" x-target-ids="t004" x-target="how" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PSA.73.16.005" x-align="PSA.73.16.a005" x-target-ids="t005 t006 t007" x-target="I might know" x-target-head="t007" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqc" x-gloss="know" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֣עַת</char> <char style="w" x-id="WLC.PSA.73.16.006" x-align="PSA.73.16.a006" x-target-ids="t008" x-target="this" x-target-head="t008" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֑את</char> <char style="w" x-id="WLC.PSA.73.16.007" x-align="PSA.73.16.a008" x-target-ids="t010 t011 t012" x-target="was too painful" x-target-head="t012" x-head="true" lemma="עָמָל" strong="H5999" x-morph="Ncbsa" x-gloss="[was].trouble" x-translit="ʿāmāl" xml:lang="hbo">עָמָ֖ל</char> <char style="w" x-id="WLC.PSA.73.16.008" x-align="PSA.73.16.a007" x-target-ids="t009" x-target="It" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="**hûʾ" xml:lan