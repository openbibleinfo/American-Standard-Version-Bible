	<para style="p"><verse number="30" style="v" x-ref="PSA.69.30" sid="PSA 69:30" /><char style="w" x-id="WLC.PSA.69.30.001" x-align="PSA.69.30.a001" x-target-ids="t001 t002 t003" x-target="I will praise" x-target-head="t003" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vph1cs" x-gloss="I.will.praise" x-translit="ʾăhaləlāh" xml:lang="hbo" x-source-ref="PSA.69.31">אֲהַֽלְלָ֣ה</char> <char style="w" x-id="WLC.PSA.69.30.002" x-align="PSA.69.30.a002" x-target-ids="t004 t005" x-target="the name" x-target-head="t005" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="the.name" x-translit="šēm-" xml:lang="hbo" x-source-ref="PSA.69.31">שֵׁם</char>־<char style="w" x-id="WLC.PSA.69.30.003" x-align="PSA.69.30.a003" x-target-ids="t006 t007" x-target="of God" x-target-head="t007" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="of.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.69.31">אֱלֹהִ֣ים</char> <char style="w" x-id="WLC.PSA.69.30.004" x-align="PSA.69.30.a004" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.69.31">בְּ</char><char style="w" x-id="WLC.PSA.69.30.005" x-align="PSA.69.30.a005" x-target-ids="t009 t010" x-target="a song" x-target-head="t010" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsa" x-gloss="a.song" x-translit="šiyr" xml:lang="hbo" x-source-ref="PSA.69.31">שִׁ֑יר</char> <char style="w" x-id="WLC.PSA.69.30.006" x-align="PSA.69.30.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.69.31">וַ</char><char style="w" x-id="WLC.PSA.69.30.007" x-align="PSA.69.30.a007" x-target-ids="t012 t013" x-target="will magnify" x-target-head="t013" x-head="true" lemma="גָּדַל" strong="H1431" x-morph="Vph1cs" x-gloss="I" x-translit="ʾăḡaddəl" xml:lang="hbo" x-source