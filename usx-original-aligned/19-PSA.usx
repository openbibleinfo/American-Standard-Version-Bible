	<para style="p"><verse number="33" style="v" x-ref="PSA.89.33" sid="PSA 89:33" /><char style="w" x-id="WLC.PSA.89.33.001" x-align="PSA.89.33.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.89.34">וְ֭</char><char style="w" x-id="WLC.PSA.89.33.002" x-align="PSA.89.33.a002" x-target-ids="t003" x-target="lovingkindness" x-target-head="t003" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="my.covenant" x-translit="ḥasd" xml:lang="hbo" x-source-ref="PSA.89.34">חַסְדִּ</char><char style="w" x-id="WLC.PSA.89.33.003" x-align="PSA.89.33.a003" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="loyalty" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.89.34">י</char> <char style="w" x-id="WLC.PSA.89.33.004" x-align="PSA.89.33.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.89.34">לֹֽא</char>־<char style="w" x-id="WLC.PSA.89.33.005" x-align="PSA.89.33.a005" x-target-ids="t004 t005 t007 t008" x-target="will I utterly take" x-target-head="t008" x-head="true" lemma="פּוּר" strong="H6565" x-morph="Vhi1cs" x-gloss="I.will.break.off" x-translit="ʾāp̄iyr" xml:lang="hbo" x-source-ref="PSA.89.34">אָפִ֣יר</char> <char style="w" x-id="WLC.PSA.89.33.006" x-align="PSA.89.33.a006" x-target-ids="t009" x-target="from" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.89.34">מֵֽ</char><char style="w" x-id="WLC.PSA.89.33.007" x-align="PSA.89.33.a006" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿimm" xml:lang="hbo" x-source-ref="PSA.89.34">עִמּ֑</char><char style="w" x-id="WLC.PSA.89.33.008" x-align="PSA.89.33.a007" x-target-ids="t010" x-tar