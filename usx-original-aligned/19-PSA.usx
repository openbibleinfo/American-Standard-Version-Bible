	<para style="p"><verse number="4" style="v" x-ref="PSA.72.4" sid="PSA 72:4" /><char style="w" x-id="WLC.PSA.72.4.001" x-align="PSA.72.4.a001" x-target-ids="t001 t002 t003" x-target="He will judge" x-target-head="t003" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vqi3ms" x-gloss="he.will.judge" x-translit="yišpōṭ" xml:lang="hbo">יִשְׁפֹּ֤ט</char>׀<char style="w" x-id="WLC.PSA.72.4.002" x-align="PSA.72.4.a002" x-target-ids="t004 t005" x-target="the poor" x-target-head="t005" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aampc" x-gloss="[the].poor.[people]" x-translit="ʿăniyyê-" xml:lang="hbo">עֲֽנִיֵּי</char>־<char style="w" x-id="WLC.PSA.72.4.003" x-align="PSA.72.4.a003" x-target-ids="t006 t007 t008" x-target="of the people" x-target-head="t008" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="of.[the].people" x-translit="ʿām" xml:lang="hbo">עָ֗ם</char> <char style="w" x-id="WLC.PSA.72.4.004" x-align="PSA.72.4.a004" x-target-ids="t009 t010 t011" x-target="He will save" x-target-head="t011" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="Vhi3ms" x-gloss="he.will.save" x-translit="yôšîᵃʿ" xml:lang="hbo">י֭וֹשִׁיעַ</char> <char style="w" x-id="WLC.PSA.72.4.005" x-align="PSA.72.4.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to).[the]" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.72.4.006" x-align="PSA.72.4.a006" x-target-ids="t012 t013" x-target="the children" x-target-head="t013" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="ḇənēy" xml:lang="hbo">בְנֵ֣י</char> <char style="w" x-id="WLC.PSA.72.4.007" x-align="PSA.72.4.a007" x-target-ids="t014 t015 t016" x-target="of the needy" x-target-head="t016" x-head="true" lemma="אֶבְיוֹן" strong="H34" x-morph="Aamsa" x-gloss="of.[the].needy" x-translit="ʾeḇyôn" xml:lang="hbo">אֶבְי֑וֹן</char> <char style="w" x-id="WLC.PSA.72.4.008" x-align="PSA.72.4.a008" x-target-ids="t017" x-tar