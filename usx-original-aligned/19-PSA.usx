	<para style="p"><verse number="1" style="v" x-ref="PSA.34.1" sid="PSA 34:1" /><char style="w" x-id="WLC.PSA.34.1.001" x-align="PSA.34.1.a001" x-target-ids="t001 t002 t003" x-target="I will bless" x-target-head="t003" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vph1cs" x-gloss="I.will.bless" x-translit="ʾăḇārăḵāh" xml:lang="hbo" x-source-ref="PSA.34.2">אֲבָרֲכָ֣ה</char> <char style="w" x-id="WLC.PSA.34.1.002" x-align="PSA.34.1.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="PSA.34.2">אֶת</char>־<char style="w" x-id="WLC.PSA.34.1.003" x-align="PSA.34.1.a003" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.34.2">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.34.1.004" x-align="PSA.34.1.a004" x-target-ids="t005" x-target="at" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.34.2">בְּ</char><char style="w" x-id="WLC.PSA.34.1.005" x-align="PSA.34.1.a005" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.34.2">כָל</char>־<char style="w" x-id="WLC.PSA.34.1.006" x-align="PSA.34.1.a006" x-target-ids="t007" x-target="times" x-target-head="t007" x-head="true" lemma="עֵת" strong="H6256" x-morph="Ncbsa" x-gloss="time" x-translit="ʿēṯ" xml:lang="hbo" x-source-ref="PSA.34.2">עֵ֑ת</char> <char style="w" x-id="WLC.PSA.34.1.007" x-align="PSA.34.1.a007" x-target-ids="t011" x-target="continually" x-target-head="t011" x-head="true" lemma="תָּמִיד" strong="H8548" x-morph="Ncmsa" x-gloss="continually" x-translit="tāmiyḏ" xml:lang="hbo" x-source-ref="PSA.34.2">תָּ֝מִ֗יד</char> <char style="w" x-id="WLC.PSA.34.1.008" x-align="PSA.34.1.a00