	<para style="p"><verse number="9" style="v" x-ref="PSA.132.9" sid="PSA 132:9" /><char style="w" x-id="WLC.PSA.132.9.001" x-align="PSA.132.9.a001" x-target-ids="t003" x-target="priests" x-target-head="t003" x-head="true" lemma="כֹּהֵן" strong="H3548" x-morph="Ncmpc" x-gloss="priests" x-translit="kōhăney" xml:lang="hbo">כֹּהֲנֶ֥י</char><char style="w" x-id="WLC.PSA.132.9.002" x-align="PSA.132.9.a002" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.132.9.003" x-align="PSA.132.9.a003" x-target-ids="t001 t004 t005 t006" x-target="Let be clothed with" x-target-head="t005" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqi3mp" x-gloss="let.them.be.clothed" x-translit="yilbəšû-" xml:lang="hbo">יִלְבְּשׁוּ</char>־<char style="w" x-id="WLC.PSA.132.9.004" x-align="PSA.132.9.a004" x-target-ids="t007" x-target="righteousness" x-target-head="t007" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="righteousness" x-translit="ṣeḏeq" xml:lang="hbo">צֶ֑דֶק</char> <char style="w" x-id="WLC.PSA.132.9.005" x-align="PSA.132.9.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.132.9.006" x-align="PSA.132.9.a006" x-target-ids="t011" x-target="saints" x-target-head="t011" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aampc" x-gloss="your.faithful" x-translit="ḥăsiyḏey" xml:lang="hbo">חֲסִידֶ֥י</char><char style="w" x-id="WLC.PSA.132.9.007" x-align="PSA.132.9.a007" x-target-ids="t010" x-target="thy" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="[people]" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.132.9.008" x-align="PSA.132.9.a008" x-target-ids="t009 t012 t013 t014" x-target="let shout for joy" x