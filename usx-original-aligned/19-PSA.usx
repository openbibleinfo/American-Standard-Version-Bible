	<para style="p"><verse number="6" style="v" x-ref="PSA.35.6" sid="PSA 35:6" /><char style="w" x-id="WLC.PSA.35.6.001" x-align="PSA.35.6.a001" x-target-ids="t001 t004" x-target="Let be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqj3ms" x-gloss="may.it.be" x-translit="yəhî-" xml:lang="hbo">יְֽהִי</char>־<char style="w" x-id="WLC.PSA.35.6.002" x-align="PSA.35.6.a002" x-target-ids="t003" x-target="way" x-target-head="t003" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="ḏark" xml:lang="hbo">דַרְכָּ֗</char><char style="w" x-id="WLC.PSA.35.6.003" x-align="PSA.35.6.a003" x-target-ids="t002" x-target="their" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.35.6.004" x-align="PSA.35.6.a004" x-target-ids="t005" x-target="dark" x-target-head="t005" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֥שֶׁךְ</char> <char style="w" x-id="WLC.PSA.35.6.005" x-align="PSA.35.6.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.35.6.006" x-align="PSA.35.6.a006" x-target-ids="t007" x-target="slippery" x-target-head="t007" x-head="true" lemma="חֲלַקְלַקּוֹת" strong="H2519" x-morph="Ncfpa" x-gloss="slippery.places" x-translit="ḥălaqlaqqôṯ" xml:lang="hbo">חֲלַקְלַקּ֑וֹת</char> <char style="w" x-id="WLC.PSA.35.6.007" x-align="PSA.35.6.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.35.6.008" x-align="PSA.35.6.a008" x-target-ids="t009 t010" x-target="the angel" x-target-head="t010" x-head="true" lemma="מַלְאָךְ" strong="H4397" x-morph="Ncmsc" x-gloss=