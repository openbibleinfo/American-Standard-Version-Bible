	<para style="p"><verse number="22" style="v" x-ref="PSA.50.22" x-added-alignments="PSA.50.22.a008" x-added-target-ids="t011" x-added-target="you" sid="PSA 50:22" /><char style="w" x-id="WLC.PSA.50.22.001" x-align="PSA.50.22.a001" x-target-ids="t002" x-target="consider" x-target-head="t002" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqv2mp" x-gloss="consider" x-translit="biynû-" xml:lang="hbo">בִּֽינוּ</char>־<char style="w" x-id="WLC.PSA.50.22.002" x-align="PSA.50.22.a002" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֣א</char> <char style="w" x-id="WLC.PSA.50.22.003" x-align="PSA.50.22.a003" x-target-ids="t003" x-target="this" x-target-head="t003" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֭את</char> <char style="w" x-id="WLC.PSA.50.22.004" x-align="PSA.50.22.a004" x-target-ids="t004 t005 t006" x-target="ye that forget" x-target-head="t006" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqrmpc" x-gloss="O.[you.who].forget" x-translit="šōḵḥēy" xml:lang="hbo">שֹׁכְחֵ֣י</char> <char style="w" x-id="WLC.PSA.50.22.005" x-align="PSA.50.22.a005" x-target-ids="t007" x-target="God" x-target-head="t007" x-head="true" lemma="אֱלֹוהַּ" strong="H433" x-morph="Ncmsa" x-gloss="(of).God" x-translit="ʾĕlôᵃẖ" xml:lang="hbo">אֱל֑וֹהַּ</char> <char style="w" x-id="WLC.PSA.50.22.006" x-align="PSA.50.22.a006" x-target-ids="t008" x-target="Lest" x-target-head="t008" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo">פֶּן</char>־<char style="w" x-id="WLC.PSA.50.22.007" x-align="PSA.50.22.a007" x-target-ids="t009 t010 t012 t013" x-target="I tear in pieces" x-target-head="t010" x-head="true" lemma="טָרַף" strong="H2963" x-morph="Vqi1cs" x-gloss="I.should.tear.to.pieces" x-translit="ʾeṭrōp̄" xml:lang="hbo">אֶ֝טְרֹ֗ף</char> <char style="w" x-id="WLC.