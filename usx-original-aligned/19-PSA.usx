	<para style="p"><verse number="12" style="v" x-ref="PSA.30.12" x-added-alignments="PSA.30.12.a005" x-added-target-ids="t005" x-added-target="my" sid="PSA 30:12" /><char style="w" x-id="WLC.PSA.30.12.001" x-align="PSA.30.12.a001" x-target-ids="t001 t002 t003 t004" x-target="To the end that" x-target-head="t003" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="so.that" x-translit="ləmaʿan" xml:lang="hbo" x-source-ref="PSA.30.13">לְמַ֤עַן</char>׀<char style="w" x-id="WLC.PSA.30.12.002" x-align="PSA.30.12.a002" x-target-ids="t007 t008 t009 t010" x-target="may sing praise to" x-target-head="t008" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vpi3ms" x-gloss="it" x-translit="yəzammer" xml:lang="hbo" x-source-ref="PSA.30.13">יְזַמֶּרְ</char><char style="w" x-id="WLC.PSA.30.12.003" x-align="PSA.30.12.a003" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="may.sing.praises.to.you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.30.13">ךָ֣</char> <char style="w" x-id="WLC.PSA.30.12.004" x-align="PSA.30.12.a004" x-target-ids="t006" x-target="glory" x-target-head="t006" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="honor" x-translit="ḵāḇôḏ" xml:lang="hbo" x-source-ref="PSA.30.13">כָ֭בוֹד</char> <char style="w" x-id="WLC.PSA.30.12.005" x-align="PSA.30.12.a006" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.30.13">וְ</char><char style="w" x-id="WLC.PSA.30.12.006" x-align="PSA.30.12.a007" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.30.13">לֹ֣א</char> <char style="w" x-id="WLC.PSA.30.12.007" x-align="PSA.30.12.a008" x-target-ids="t014 t015" x-target="be silent" x-target-head="t015" x-head="true" lemma="דָּמַם