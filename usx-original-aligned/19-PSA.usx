	<para style="p"><verse number="73" style="v" x-ref="PSA.119.73" sid="PSA 119:73" /><char style="w" x-id="WLC.PSA.119.73.001" x-align="PSA.119.73.a001" x-target-ids="t002" x-target="hands" x-target-head="t002" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbdc" x-gloss="hands" x-translit="yāḏey" xml:lang="hbo">יָדֶ֣י</char><char style="w" x-id="WLC.PSA.119.73.002" x-align="PSA.119.73.a002" x-target-ids="t001" x-target="Thy" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.73.003" x-align="PSA.119.73.a003" x-target-ids="t003 t004" x-target="have made" x-target-head="t004" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3cp" x-gloss="they" x-translit="ʿāśû" xml:lang="hbo">עָ֭שׂוּ</char><char style="w" x-id="WLC.PSA.119.73.004" x-align="PSA.119.73.a004" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="made.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.73.005" x-align="PSA.119.73.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ</char><char style="w" x-id="WLC.PSA.119.73.006" x-align="PSA.119.73.a006" x-target-ids="t007" x-target="fashioned" x-target-head="t007" x-head="true" lemma="כּוּן" strong="H3559" x-morph="Voi3mp" x-gloss="they" x-translit="yəḵônənû" xml:lang="hbo">יְכוֹנְנ֑וּ</char><char style="w" x-id="WLC.PSA.119.73.007" x-align="PSA.119.73.a007" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="prepared.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.73.008" x-align="PSA.119.73.a008" x-target-ids="t009 t011" x-target="Give understanding" x-target-head="t011" x-head="true" lemma="בִּין" strong="H995" x-mor