	<para style="p"><verse number="10" style="v" x-ref="PSA.65.10" sid="PSA 65:10" /><char style="w" x-id="WLC.PSA.65.10.001" x-align="PSA.65.10.a001" x-target-ids="t004" x-target="furrows" x-target-head="t004" x-head="true" lemma="תֶּלֶם" strong="H8525" x-morph="Ncmpc" x-gloss="furrows" x-translit="təlāmey" xml:lang="hbo" x-source-ref="PSA.65.11">תְּלָמֶ֣י</char><char style="w" x-id="WLC.PSA.65.10.002" x-align="PSA.65.10.a002" x-target-ids="t003" x-target="its" x-target-head="t003" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.65.11">הָ</char> <char style="w" x-id="WLC.PSA.65.10.003" x-align="PSA.65.10.a003" x-target-ids="t001 t002 t005" x-target="Thou waterest abundantly" x-target-head="t002" x-head="true" lemma="רָוָה" strong="H7301" x-morph="Vpa" x-gloss="you.water.abundantly" x-translit="rawwēh" xml:lang="hbo" x-source-ref="PSA.65.11">רַ֭וֵּה</char> <char style="w" x-id="WLC.PSA.65.10.004" x-align="PSA.65.10.a004" x-target-ids="t006 t007" x-target="Thou settlest" x-target-head="t007" x-head="true" lemma="נָחֵת" strong="H5181" x-morph="Vpa" x-gloss="you.press.down" x-translit="naḥēṯ" xml:lang="hbo" x-source-ref="PSA.65.11">נַחֵ֣ת</char> <char style="w" x-id="WLC.PSA.65.10.005" x-align="PSA.65.10.a005" x-target-ids="t008 t009" x-target="the ridges" x-target-head="t009" x-head="true" lemma="גְּדוּד" strong="H1417" x-morph="Ncmpc" x-gloss="ridges" x-translit="gəḏûḏey" xml:lang="hbo" x-source-ref="PSA.65.11">גְּדוּדֶ֑י</char><char style="w" x-id="WLC.PSA.65.10.006" x-align="PSA.65.10.a006" x-target-ids="t010" x-target="thereof" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.65.11">הָ</char> <char style="w" x-id="WLC.PSA.65.10.007" x-align="PSA.65.10.a007" x-target-ids="t015" x-target="with" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:la