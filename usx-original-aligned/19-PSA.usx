	<para style="d" x-ref="PSA.31.0"><char style="w" x-id="WLC.PSA.31.0.001" x-align="PSA.31.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.31.1">לַ</char><char style="w" x-id="WLC.PSA.31.0.002" x-align="PSA.31.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.31.1">[הַ]</char><char style="w" x-id="WLC.PSA.31.0.003" x-align="PSA.31.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.31.1">מְנַצֵּ֗חַ</char> <char style="w" x-id="WLC.PSA.31.0.004" x-align="PSA.31.0.a004" x-target-ids="t005 t006" x-target="A Psalm" x-target-head="t006" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.31.1">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.31.0.005" x-align="PSA.31.0.a005" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.31.1">לְ</char><char style="w" x-id="WLC.PSA.31.0.006" x-align="PSA.31.0.a006" x-target-ids="t008" x-target="David" x-target-head="t008" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ:" xml:lang="hbo" x-source-ref="PSA.31.1">דָוִֽד</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.31.1" sid="PSA 31:1" /><char style="w" x-id="WLC.PSA.31.1.001" x-align="PSA.31.1.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="b" xml:lang="hbo" x-source-ref="PSA.31.2">בְּ</char><char style="w" x-id="WLC.PSA.31.1.002" x-align="PSA.31.1.a002" x-target-ids="t002" x-target="thee" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.31.2">ךָ֖</char> <char style="w" x-id="WLC.PSA.31.1.003" x-align="PSA.31.1.a003" x-target-ids="t003 t004" x-target="O Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.31.2">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.31.1.004" x-align="PSA.31.1.a004" x-target-ids="t005 t006 t007 t008" x-target="do I take refuge" x-target-head="t008" x-head="true" lemma="חָסָה" strong="H2620" x-morph="Vqp1cs" x-gloss="I.have.taken.refuge" x-translit="ḥāsîṯî" xml:lang="hbo" x-source-ref="PSA.31.2">חָ֭סִיתִי</char> <char style="w" x-id="WLC.PSA.31.1.005" x-align="PSA.31.1.a005" x-target-ids="t011" x-target="never" x-target-head="t011" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.31.2">אַל</char>־<char style="w" x-id="WLC.PSA.31.1.006" x-align="PSA.31.1.a006" x-target-ids="t009 t010 t012 t013 t014 t015" x-target="Let me be put to shame" x-target-head="t015" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqh1cs" x-gloss="let.me.be.ashamed" x-translit="ʾēḇôšâ" xml:lang="hbo" x-source-ref="PSA.31.2">אֵב֣וֹשָׁה</char> <char style="w" x-id="WLC.PSA.31.1.007" x-align="PSA.31.1.a005" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.31.2">לְ</char><char style="w" x-id="WLC.PSA.31.1.008" x-align