	<para style="p"><verse number="52" style="v" x-ref="PSA.119.52" sid="PSA 119:52" /><char style="w" x-id="WLC.PSA.119.52.001" x-align="PSA.119.52.a001" x-target-ids="t001 t002 t003" x-target="I have remembered" x-target-head="t003" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqp1cs" x-gloss="I.remember" x-translit="zāḵarətî" xml:lang="hbo">זָ֘כַ֤רְתִּי</char> <char style="w" x-id="WLC.PSA.119.52.002" x-align="PSA.119.52.a002" x-target-ids="t005" x-target="ordinances" x-target-head="t005" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmpc" x-gloss="judgments" x-translit="mišpāṭey" xml:lang="hbo">מִשְׁפָּטֶ֖י</char><char style="w" x-id="WLC.PSA.119.52.003" x-align="PSA.119.52.a003" x-target-ids="t004" x-target="thine" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.52.004" x-align="PSA.119.52.a004" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PSA.119.52.005" x-align="PSA.119.52.a005" x-target-ids="t007" x-target="old" x-target-head="t007" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="long.ago" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֥ם</char>׀<char style="w" x-id="WLC.PSA.119.52.006" x-align="PSA.119.52.a006" x-target-ids="t008 t009" x-target="O Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.PSA.119.52.007" x-align="PSA.119.52.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָֽ</char><char style="w" x-id="WLC.PSA.119.52.008" x-align="PSA.119.52.a008" x-target-ids="t011 t012 t013" x-target="have comforted myself" x-target-head=