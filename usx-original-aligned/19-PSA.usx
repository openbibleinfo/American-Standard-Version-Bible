	<para style="p"><verse number="2" style="v" x-ref="PSA.47.2" sid="PSA 47:2" /><char style="w" x-id="WLC.PSA.47.2.001" x-align="PSA.47.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.47.3">כִּֽי</char>־<char style="w" x-id="WLC.PSA.47.2.002" x-align="PSA.47.2.a002" x-target-ids="t002 t007" x-target="Jehovah He" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.47.3">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.47.2.003" x-align="PSA.47.2.a003" x-target-ids="t003 t004" x-target="Most High" x-target-head="t004" x-head="true" lemma="עֶלְיוֹן" strong="H5945a" x-morph="Aamsa" x-gloss="the.Most.High" x-translit="ʿelyôn" xml:lang="hbo" x-source-ref="PSA.47.3">עֶלְי֣וֹן</char> <char style="w" x-id="WLC.PSA.47.2.004" x-align="PSA.47.2.a004" x-target-ids="t005 t006" x-target="is terrible" x-target-head="t006" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="VNrmsa" x-gloss="[is].to.be.feared" x-translit="nôrāʾ" xml:lang="hbo" x-source-ref="PSA.47.3">נוֹרָ֑א</char> <char style="w" x-id="WLC.PSA.47.2.005" x-align="PSA.47.2.a005" x-target-ids="t008 t009 t011" x-target="is a King" x-target-head="t011" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="a.king" x-translit="meleḵ" xml:lang="hbo" x-source-ref="PSA.47.3">מֶ֥לֶךְ</char> <char style="w" x-id="WLC.PSA.47.2.006" x-align="PSA.47.2.a006" x-target-ids="t010" x-target="great" x-target-head="t010" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="great" x-translit="gāḏôl" xml:lang="hbo" x-source-ref="PSA.47.3">גָּ֝דוֹל</char> <char style="w" x-id="WLC.PSA.47.2.007" x-align="PSA.47.2.a007" x-target-ids="t012" x-target="over" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal-" xml:lang="hbo" x-source-ref="P