	<para style="p"><verse number="46" style="v" x-ref="PSA.89.46" x-added-alignments="PSA.89.46.a012" x-added-target-ids="t011 t012" x-added-target="How long" sid="PSA 89:46" /><char style="w" x-id="WLC.PSA.89.46.001" x-align="PSA.89.46.a001" x-target-ids="t002" x-target="long" x-target-head="t002" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo" x-source-ref="PSA.89.47">עַד</char>־<char style="w" x-id="WLC.PSA.89.46.002" x-align="PSA.89.46.a002" x-target-ids="t001" x-target="How" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="when?" x-translit="māh" xml:lang="hbo" x-source-ref="PSA.89.47">מָ֣ה</char> <char style="w" x-id="WLC.PSA.89.46.003" x-align="PSA.89.46.a003" x-target-ids="t003 t004" x-target="O Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.89.47">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.89.46.004" x-align="PSA.89.46.a004" x-target-ids="t005 t006 t007 t008" x-target="wilt thou hide thyself" x-target-head="t007" x-head="true" lemma="סָתַר" strong="H5641" x-morph="VNi2ms" x-gloss="will.you.hide.yourself?" x-translit="tissāṯēr" xml:lang="hbo" x-source-ref="PSA.89.47">תִּסָּתֵ֣ר</char> <char style="w" x-id="WLC.PSA.89.46.005" x-align="PSA.89.46.a005" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.89.47">לָ</char><char style="w" x-id="WLC.PSA.89.46.006" x-align="PSA.89.46.a006" x-target-ids="t010" x-target="ever" x-target-head="t010" x-head="true" lemma="נֵצַח" strong="H5331" x-morph="Ncmsa" x-gloss="perpetuity" x-translit="neṣaḥ" xml:lang="hbo" x-source-ref="PSA.89.47">נֶ֑צַח</char> <char style="w" x-id="WLC.PSA.89.46.007" x-align="PSA.89.46.a007" x-target-ids="t013 t016" x-target="shall burn" x-target-head="t016" x-head="true" lemma="בָּעַר" s