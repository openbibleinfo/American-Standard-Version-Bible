	<para style="d" x-ref="PSA.47.0"><char style="w" x-id="WLC.PSA.47.0.001" x-align="PSA.47.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.47.1">לַ</char><char style="w" x-id="WLC.PSA.47.0.002" x-align="PSA.47.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.47.1">[הַ]</char><char style="w" x-id="WLC.PSA.47.0.003" x-align="PSA.47.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēḥa" xml:lang="hbo" x-source-ref="PSA.47.1">מְנַצֵּ֬חַ</char>׀<char style="w" x-id="WLC.PSA.47.0.004" x-align="PSA.47.0.a004" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="li" xml:lang="hbo" x-source-ref="PSA.47.1">לִ</char><char style="w" x-id="WLC.PSA.47.0.005" x-align="PSA.47.0.a005" x-target-ids="t008 t009" x-target="the sons" x-target-head="t009" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.sons" x-translit="ḇənê-" xml:lang="hbo" x-source-ref="PSA.47.1">בְנֵי</char>־<char style="w" x-id="WLC.PSA.47.0.006" x-align="PSA.47.0.a006" x-target-ids="t010 t011" x-target="of Korah" x-target-head="t011" x-head="true" lemma="קֹרַח" strong="H7141" x-morph="Np" x-gloss="of.Korah" x-translit="qōraḥ" xml:lang="hbo" x-source-ref="PSA.47.1">קֹ֬רַח</char> <char style="w" x-id="WLC.PSA.47.0.007" x-align="PSA.47.0.a007" x-target-ids="t005 t006" x-target="A Psalm" x-target-head="t006" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr:" xml:lang="hbo" x-source-ref="PSA.47.1">מִזְמֽוֹר</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.47.1" x-added-alignments="PSA.47.1.a005" x-added-target-ids="t003" x-added-target="your" sid="PSA 47:1" /><char style="w" x-id="WLC.PSA.47.1.001" x-align="PSA.47.1.a001" x-target-ids="t005" x-target="all" x-target-head="t005" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="O.all" x-translit="kāl-" xml:lang="hbo" x-source-ref="PSA.47.2">כָּֽל</char>־<char style="w" x-id="WLC.PSA.47.1.002" x-align="PSA.47.1.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.47.2">הָ֭</char><char style="w" x-id="WLC.PSA.47.1.003" x-align="PSA.47.1.a003" x-target-ids="t006 t007" x-target="ye peoples" x-target-head="t007" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmpa" x-gloss="peoples" x-translit="ʿammîm" xml:lang="hbo" x-source-ref="PSA.47.2">עַמִּים</char> <char style="w" x-id="WLC.PSA.47.1.004" x-align="PSA.47.1.a004" x-target-ids="t001 t002" x-target="Oh clap" x-target-head="t002" x-head="true" lemma="תָּקַע" strong="H8628" x-morph="Vqv2mp" x-gloss="strike" x-translit="tiqʿû-" xml:lang="hbo" x-source-ref="PSA.47.2">תִּקְעוּ</char>־<char style="w" x-id="WLC.PSA.47.1.005" x-align="PSA.47.1.a006" x-target-ids="t004" x-target="hands" x-target-head="t004" x-head="true" lemma="כַּף" strong="H3709" x-morph="Ncfsa" x-gloss="a.palm" x-translit="ḵāp̄" xml:lang="hbo" x-source-ref="PSA.47.2">כָ֑ף</char> <char style="w" x-id="WLC.PSA.47.1.006" x-align="PSA.47.1.a007" x-target-ids="t008" x-target="Shout" x-target-head="t008" x-head="true" lemma="רוּעַ" strong="H7321" x-morph="Vhv2mp" x-gloss="shout.for.joy" x-translit="hāriyʿû" xml:lang="hbo" x-source-ref="PSA.47.2">הָרִ֥יעוּ</char> <char style="w" x-id="WLC.PSA.47.1.007" x-align="PSA.47.1.a008" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo" x-source-ref="PSA.47.2