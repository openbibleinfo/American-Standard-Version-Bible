	<para style="p"><verse number="3" style="v" x-ref="PSA.106.3" x-added-alignments="PSA.106.3.a004" x-added-target-ids="t007" x-added-target="And" sid="PSA 106:3" /><char style="w" x-id="WLC.PSA.106.3.001" x-align="PSA.106.3.a001" x-target-ids="t001 t002" x-target="Blessed are" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrê" xml:lang="hbo">אַ֭שְׁרֵי</char> <char style="w" x-id="WLC.PSA.106.3.002" x-align="PSA.106.3.a002" x-target-ids="t003 t004 t005" x-target="they that keep" x-target-head="t005" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmpc" x-gloss="[are.those.who].keep" x-translit="šōmərēy" xml:lang="hbo">שֹׁמְרֵ֣י</char> <char style="w" x-id="WLC.PSA.106.3.003" x-align="PSA.106.3.a003" x-target-ids="t006" x-target="justice" x-target-head="t006" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="(of).justice" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּ֑ט</char> <char style="w" x-id="WLC.PSA.106.3.004" x-align="PSA.106.3.a005" x-target-ids="t008 t009 t010" x-target="he that doeth" x-target-head="t010" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[one.who].does" x-translit="ʿōśēh" xml:lang="hbo">עֹשֵׂ֖ה</char> <char style="w" x-id="WLC.PSA.106.3.005" x-align="PSA.106.3.a006" x-target-ids="t011" x-target="righteousness" x-target-head="t011" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="(of).righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְדָקָ֣ה</char> <char style="w" x-id="WLC.PSA.106.3.006" x-align="PSA.106.3.a007" x-target-ids="t012" x-target="at" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PSA.106.3.007" x-align="PSA.106.3.a008" x-target-ids="t013" x-target="all" x-target-head="t013" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</ch