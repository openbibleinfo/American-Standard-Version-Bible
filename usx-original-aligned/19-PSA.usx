	<para style="p"><verse number="21" style="v" x-ref="PSA.31.21" sid="PSA 31:21" /><char style="w" x-id="WLC.PSA.31.21.001" x-align="PSA.31.21.a001" x-target-ids="t001 t002" x-target="Blessed be" x-target-head="t001" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vqsmsa" x-gloss="[be].blessed" x-translit="bārûḵ" xml:lang="hbo" x-source-ref="PSA.31.22">בָּר֥וּךְ</char> <char style="w" x-id="WLC.PSA.31.21.002" x-align="PSA.31.21.a002" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.31.22">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.31.21.003" x-align="PSA.31.21.a003" x-target-ids="t004" x-target="For" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.31.22">כִּ֥י</char> <char style="w" x-id="WLC.PSA.31.21.004" x-align="PSA.31.21.a004" x-target-ids="t005 t006 t007 t010" x-target="he hath showed marvellous" x-target-head="t010" x-head="true" lemma="פָּלָא" strong="H6381" x-morph="Vhp3ms" x-gloss="he.has.made.wonderful" x-translit="hip̄liyʾ" xml:lang="hbo" x-source-ref="PSA.31.22">הִפְלִ֘יא</char> <char style="w" x-id="WLC.PSA.31.21.005" x-align="PSA.31.21.a005" x-target-ids="t011" x-target="lovingkindness" x-target-head="t011" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo" x-source-ref="PSA.31.22">חַסְדּ֥</char><char style="w" x-id="WLC.PSA.31.21.006" x-align="PSA.31.21.a006" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.covenant" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.31.22">וֹ</char> <char style="w" x-id="WLC.PSA.31.21.007" x-align="PSA.31.21.a007" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="PSA.3