	<para style="p"><verse number="29" style="v" x-ref="PSA.107.29" sid="PSA 107:29" /><char style="w" x-id="WLC.PSA.107.29.001" x-align="PSA.107.29.a001" x-target-ids="t001 t002" x-target="He maketh" x-target-head="t002" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vhi3ms" x-gloss="he.raised" x-translit="yāqēm" xml:lang="hbo">יָקֵ֣ם</char> <char style="w" x-id="WLC.PSA.107.29.002" x-align="PSA.107.29.a002" x-target-ids="t003 t004" x-target="the storm" x-target-head="t004" x-head="true" lemma="סְעָרָה" strong="H5591a" x-morph="Ncfsa" x-gloss="[the].storm" x-translit="səʿārâ" xml:lang="hbo">סְ֭עָרָה</char> <char style="w" x-id="WLC.PSA.107.29.003" x-align="PSA.107.29.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="into" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.107.29.004" x-align="PSA.107.29.a004" x-target-ids="t005 t006" x-target="a calm" x-target-head="t006" x-head="true" lemma="דְּמָמָה" strong="H1827" x-morph="Ncfsa" x-gloss="a.whisper" x-translit="ḏəmāmāh" xml:lang="hbo">דְמָמָ֑ה</char> <char style="w" x-id="WLC.PSA.107.29.005" x-align="PSA.107.29.a005" x-target-ids="t007 t008" x-target="So that" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝</char><char style="w" x-id="WLC.PSA.107.29.006" x-align="PSA.107.29.a008" x-target-ids="t012 t013" x-target="are still" x-target-head="t013" x-head="true" lemma="חָשָׁה" strong="H2814" x-morph="Vqw3mp" x-gloss="they.were.still" x-translit="yyeḥĕšû" xml:lang="hbo">יֶּחֱשׁ֗וּ</char> <char style="w" x-id="WLC.PSA.107.29.007" x-align="PSA.107.29.a006" x-target-ids="t009 t010" x-target="the waves" x-target-head="t010" x-head="true" lemma="גַּל" strong="H1530a" x-morph="Ncmpc" x-gloss="waves" x-translit="gallēy" xml:lang="hbo">גַּלֵּי</char><char style="w" x-id="WLC.PSA.107.29.008" x-align="PSA.107.29.a007" x-target-ids="t011" x-target="thereof" x-target-head="t011" x-head="true"