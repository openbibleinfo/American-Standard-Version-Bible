	<para style="p"><verse number="8" style="v" x-ref="PSA.47.8" sid="PSA 47:8" /><char style="w" x-id="WLC.PSA.47.8.001" x-align="PSA.47.8.a001" x-target-ids="t002" x-target="reigneth" x-target-head="t002" x-head="true" lemma="מָלַךְ" strong="H4427" x-morph="Vqp3ms" x-gloss="he.reigns" x-translit="mālaḵ" xml:lang="hbo" x-source-ref="PSA.47.9">מָלַ֣ךְ</char> <char style="w" x-id="WLC.PSA.47.8.002" x-align="PSA.47.8.a002" x-target-ids="t001" x-target="God" x-target-head="t001" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.47.9">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.47.8.003" x-align="PSA.47.8.a003" x-target-ids="t003" x-target="over" x-target-head="t003" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.47.9">עַל</char>־<char style="w" x-id="WLC.PSA.47.8.004" x-align="PSA.47.8.a004" x-target-ids="t004 t005" x-target="the nations" x-target-head="t005" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="gôyim" xml:lang="hbo" x-source-ref="PSA.47.9">גּוֹיִ֑ם</char> <char style="w" x-id="WLC.PSA.47.8.005" x-align="PSA.47.8.a005" x-target-ids="t006" x-target="God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.47.9">אֱ֝לֹהִ֗ים</char> <char style="w" x-id="WLC.PSA.47.8.006" x-align="PSA.47.8.a006" x-target-ids="t007" x-target="sitteth" x-target-head="t007" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqp3ms" x-gloss="he.sits" x-translit="yāšaḇ" xml:lang="hbo" x-source-ref="PSA.47.9">יָשַׁ֤ב</char>׀<char style="w" x-id="WLC.PSA.47.8.007" x-align="PSA.47.8.a007" x-target-ids="t008" x-target="upon" x-target-head="t008" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.47.9">עַל</char>־<char style="w" x-id="WL