	<para style="p"><verse number="27" style="v" x-ref="PSA.102.27" sid="PSA 102:27" /><char style="w" x-id="WLC.PSA.102.27.001" x-align="PSA.102.27.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.102.28">וְ</char><char style="w" x-id="WLC.PSA.102.27.002" x-align="PSA.102.27.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattâ-" xml:lang="hbo" x-source-ref="PSA.102.28">אַתָּה</char>־<char style="w" x-id="WLC.PSA.102.27.003" x-align="PSA.102.27.a003" x-target-ids="t003 t004 t005" x-target="art the same" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="[are].he" x-translit="hûʾ" xml:lang="hbo" x-source-ref="PSA.102.28">ה֑וּא</char> <char style="w" x-id="WLC.PSA.102.27.004" x-align="PSA.102.27.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.102.28">וּ֝</char><char style="w" x-id="WLC.PSA.102.27.005" x-align="PSA.102.27.a005" x-target-ids="t008" x-target="years" x-target-head="t008" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncfpc" x-gloss="years" x-translit="šənôṯey" xml:lang="hbo" x-source-ref="PSA.102.28">שְׁנוֹתֶ֗י</char><char style="w" x-id="WLC.PSA.102.27.006" x-align="PSA.102.27.a006" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.102.28">ךָ</char> <char style="w" x-id="WLC.PSA.102.27.007" x-align="PSA.102.27.a007" x-target-ids="t011" x-target="no" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.102.28">לֹ֣א</char> <char style="w" x-id="WLC.PSA.1