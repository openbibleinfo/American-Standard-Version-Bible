	<para style="p"><verse number="6" style="v" x-ref="PSA.8.6" sid="PSA 8:6" /><char style="w" x-id="WLC.PSA.8.6.001" x-align="PSA.8.6.a001" x-target-ids="t001 t002 t004 t005 t006" x-target="Thou makest to have dominion" x-target-head="t006" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vhi2ms" x-gloss="you" x-translit="tamšiyl" xml:lang="hbo" x-source-ref="PSA.8.7">תַּ֭מְשִׁילֵ</char><char style="w" x-id="WLC.PSA.8.6.002" x-align="PSA.8.6.a002" x-target-ids="t003" x-target="him" x-target-head="t003" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="make.him.rule" x-translit="ēhû" xml:lang="hbo" x-source-ref="PSA.8.7">הוּ</char> <char style="w" x-id="WLC.PSA.8.6.003" x-align="PSA.8.6.a003" x-target-ids="t007" x-target="over" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="over" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.8.7">בְּ</char><char style="w" x-id="WLC.PSA.8.6.004" x-align="PSA.8.6.a004" x-target-ids="t008 t009" x-target="the works" x-target-head="t009" x-head="true" lemma="מַעֲשֶׂה" strong="H4639" x-morph="Ncmpc" x-gloss="the.works" x-translit="maʿăśēy" xml:lang="hbo" x-source-ref="PSA.8.7">מַעֲשֵׂ֣י</char> <char style="w" x-id="WLC.PSA.8.6.005" x-align="PSA.8.6.a005" x-target-ids="t010 t012" x-target="of hands" x-target-head="t012" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbdc" x-gloss="your.hands" x-translit="yāḏey" xml:lang="hbo" x-source-ref="PSA.8.7">יָדֶ֑י</char><char style="w" x-id="WLC.PSA.8.6.006" x-align="PSA.8.6.a006" x-target-ids="t011" x-target="thy" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.8.7">ךָ</char> <char style="w" x-id="WLC.PSA.8.6.007" x-align="PSA.8.6.a007" x-target-ids="t016 t017" x-target="all things" x-target-head="t016" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="everything" x-translit="kōl" xml:lang="hbo" x-source-ref="PSA.8.7">כֹּ֝ל<