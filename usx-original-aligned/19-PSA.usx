	<para style="p"><verse number="7" style="v" x-ref="PSA.76.7" x-added-alignments="PSA.76.7.a002" x-added-target-ids="t002" x-added-target="even" sid="PSA 76:7" /><char style="w" x-id="WLC.PSA.76.7.001" x-align="PSA.76.7.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.76.8">אַתָּ֤ה</char>׀<char style="w" x-id="WLC.PSA.76.7.002" x-align="PSA.76.7.a004" x-target-ids="t004 t005 t006 t007" x-target="art to be feared" x-target-head="t007" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="VNrmsa" x-gloss="[are].to.be.feared" x-translit="nôrāʾ" xml:lang="hbo" x-source-ref="PSA.76.8">נ֥וֹרָא</char> <char style="w" x-id="WLC.PSA.76.7.003" x-align="PSA.76.7.a003" x-target-ids="t003" x-target="thou" x-target-head="t003" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾatâ" xml:lang="hbo" x-source-ref="PSA.76.8">אַ֗תָּה</char> <char style="w" x-id="WLC.PSA.76.7.004" x-align="PSA.76.7.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.76.8">וּ</char><char style="w" x-id="WLC.PSA.76.7.005" x-align="PSA.76.7.a006" x-target-ids="t009" x-target="who" x-target-head="t009" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy-" xml:lang="hbo" x-source-ref="PSA.76.8">מִֽי</char>־<char style="w" x-id="WLC.PSA.76.7.006" x-align="PSA.76.7.a007" x-target-ids="t010 t011" x-target="may stand" x-target-head="t011" x-head="true" lemma="עָמַד" strong="H5975" x-morph="Vqi3ms" x-gloss="will.he.stand" x-translit="yaʿămōḏ" xml:lang="hbo" x-source-ref="PSA.76.8">יַעֲמֹ֥ד</char> <char style="w" x-id="WLC.PSA.76.7.007" x-align="PSA.76.7.a008" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-tran