	<para style="p"><verse number="2" style="v" x-ref="PSA.57.2" x-added-alignments="PSA.57.2.a009" x-added-target-ids="t012 t013" x-added-target="all things" sid="PSA 57:2" /><char style="w" x-id="WLC.PSA.57.2.001" x-align="PSA.57.2.a001" x-target-ids="t001 t002 t003" x-target="I will cry" x-target-head="t003" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi1cs" x-gloss="I.call.out" x-translit="ʾeqrāʾ" xml:lang="hbo" x-source-ref="PSA.57.3">אֶ֭קְרָא</char> <char style="w" x-id="WLC.PSA.57.2.002" x-align="PSA.57.2.a002" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo" x-source-ref="PSA.57.3">לֵֽ</char><char style="w" x-id="WLC.PSA.57.2.003" x-align="PSA.57.2.a003" x-target-ids="t005" x-target="God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾlōhiym" xml:lang="hbo" x-source-ref="PSA.57.3">אלֹהִ֣ים</char> <char style="w" x-id="WLC.PSA.57.2.004" x-align="PSA.57.2.a004" x-target-ids="t006 t007" x-target="Most High" x-target-head="t007" x-head="true" lemma="עֶלְיוֹן" strong="H5945a" x-morph="Aamsa" x-gloss="Most.High" x-translit="ʿelyôn" xml:lang="hbo" x-source-ref="PSA.57.3">עֶלְי֑וֹן</char> <char style="w" x-id="WLC.PSA.57.2.005" x-align="PSA.57.2.a005" x-target-ids="t008" x-target="Unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.57.3">לָ֝</char><char style="w" x-id="WLC.PSA.57.2.006" x-align="PSA.57.2.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.57.3">[הַ]</char><char style="w" x-id="WLC.PSA.57.2.007" x-align="PSA.57.2.a007" x-target-ids="t009" x-target="God" x-target-head="t009" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo" x-source-ref="PSA.57.3">אֵ֗ל</char>