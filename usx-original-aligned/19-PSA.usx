	<para style="p"><verse number="19" style="v" x-ref="PSA.102.19" sid="PSA 102:19" /><char style="w" x-id="WLC.PSA.102.19.001" x-align="PSA.102.19.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.102.20">כִּֽי</char>־<char style="w" x-id="WLC.PSA.102.19.002" x-align="PSA.102.19.a002" x-target-ids="t002 t003 t004 t005" x-target="he hath looked down" x-target-head="t004" x-head="true" lemma="שָׁקַף" strong="H8259" x-morph="Vhp3ms" x-gloss="he.has.looked.down" x-translit="hišqîp̄" xml:lang="hbo" x-source-ref="PSA.102.20">הִ֭שְׁקִיף</char> <char style="w" x-id="WLC.PSA.102.19.003" x-align="PSA.102.19.a003" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.102.20">מִ</char><char style="w" x-id="WLC.PSA.102.19.004" x-align="PSA.102.19.a004" x-target-ids="t007 t008" x-target="the height" x-target-head="t008" x-head="true" lemma="מָרוֹם" strong="H4791" x-morph="Ncmsc" x-gloss="the.height" x-translit="mmərôm" xml:lang="hbo" x-source-ref="PSA.102.20">מְּר֣וֹם</char> <char style="w" x-id="WLC.PSA.102.19.005" x-align="PSA.102.19.a005" x-target-ids="t009 t011" x-target="of sanctuary" x-target-head="t011" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsc" x-gloss="his.holiness" x-translit="qāḏəš" xml:lang="hbo" x-source-ref="PSA.102.20">קָדְשׁ֑</char><char style="w" x-id="WLC.PSA.102.19.006" x-align="PSA.102.19.a006" x-target-ids="t010" x-target="his" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.102.20">וֹ</char> <char style="w" x-id="WLC.PSA.102.19.007" x-align="PSA.102.19.a007" x-target-ids="t015" x-target="Jehovah" x-target-head="t015" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəh