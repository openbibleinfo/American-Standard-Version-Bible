	<para style="p"><verse number="11" style="v" x-ref="PSA.91.11" sid="PSA 91:11" /><char style="w" x-id="WLC.PSA.91.11.001" x-align="PSA.91.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PSA.91.11.002" x-align="PSA.91.11.a002" x-target-ids="t006" x-target="angels" x-target-head="t006" x-head="true" lemma="מַלְאָךְ" strong="H4397" x-morph="Ncmpc" x-gloss="angels" x-translit="malʾāḵāy" xml:lang="hbo">מַ֭לְאָכָי</char><char style="w" x-id="WLC.PSA.91.11.003" x-align="PSA.91.11.a003" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.91.11.004" x-align="PSA.91.11.a004" x-target-ids="t002 t003 t004 t007" x-target="he will give charge" x-target-head="t007" x-head="true" lemma="צָוָה" strong="H6680" x-morph="Vpi3ms" x-gloss="he.will.command" x-translit="yəṣawweh-" xml:lang="hbo">יְצַוֶּה</char>־<char style="w" x-id="WLC.PSA.91.11.005" x-align="PSA.91.11.a005" x-target-ids="t008" x-target="over" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לָּ֑</char><char style="w" x-id="WLC.PSA.91.11.006" x-align="PSA.91.11.a006" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.PSA.91.11.007" x-align="PSA.91.11.a007" x-target-ids="t010" x-target="To" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ֝</char><char style="w" x-id="WLC.PSA.91.11.008" x-align="PSA.91.11.a008" x-target-ids="t011" x-target="keep" x-target-head="t011" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqc" x-gloss="guard" x-tr