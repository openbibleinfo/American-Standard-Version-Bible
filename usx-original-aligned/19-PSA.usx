	<para style="p"><verse number="1" style="v" x-ref="PSA.30.1" sid="PSA 30:1" /><char style="w" x-id="WLC.PSA.30.1.001" x-align="PSA.30.1.a001" x-target-ids="t001 t002 t003" x-target="I will extol" x-target-head="t003" x-head="true" lemma="רוּם" strong="H7311" x-morph="Voi1cs" x-gloss="I" x-translit="ʾărômim" xml:lang="hbo" x-source-ref="PSA.30.2">אֲרוֹמִמְ</char><char style="w" x-id="WLC.PSA.30.1.002" x-align="PSA.30.1.a002" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.exalt.you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.30.2">ךָ֣</char> <char style="w" x-id="WLC.PSA.30.1.003" x-align="PSA.30.1.a003" x-target-ids="t005 t006" x-target="O Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.30.2">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.30.1.004" x-align="PSA.30.1.a004" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.30.2">כִּ֣י</char> <char style="w" x-id="WLC.PSA.30.1.005" x-align="PSA.30.1.a005" x-target-ids="t008 t009 t010 t012" x-target="thou hast raised up" x-target-head="t010" x-head="true" lemma="דָּלָה" strong="H1802" x-morph="Vpp2ms" x-gloss="you" x-translit="ḏilliyṯā" xml:lang="hbo" x-source-ref="PSA.30.2">דִלִּיתָ֑</char><char style="w" x-id="WLC.PSA.30.1.006" x-align="PSA.30.1.a006" x-target-ids="t011" x-target="me" x-target-head="t011" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="have.drawn.me.up" x-translit="niy" xml:lang="hbo" x-source-ref="PSA.30.2">נִי</char> <char style="w" x-id="WLC.PSA.30.1.007" x-align="PSA.30.1.a007" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.30.2">וְ</char><c