	<para style="p"><verse number="17" style="v" x-ref="PSA.38.17" sid="PSA 38:17" /><char style="w" x-id="WLC.PSA.38.17.001" x-align="PSA.38.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.38.18">כִּֽי</char>־<char style="w" x-id="WLC.PSA.38.17.002" x-align="PSA.38.17.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾănî" xml:lang="hbo" x-source-ref="PSA.38.18">אֲ֭נִי</char> <char style="w" x-id="WLC.PSA.38.17.003" x-align="PSA.38.17.a003" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.38.18">לְ</char><char style="w" x-id="WLC.PSA.38.17.004" x-align="PSA.38.17.a004" x-target-ids="t006" x-target="fall" x-target-head="t006" x-head="true" lemma="צֶלַע" strong="H6761" x-morph="Ncmsa" x-gloss="stumbling" x-translit="ṣelaʿ" xml:lang="hbo" x-source-ref="PSA.38.18">צֶ֣לַע</char> <char style="w" x-id="WLC.PSA.38.17.005" x-align="PSA.38.17.a005" x-target-ids="t003 t004" x-target="am ready" x-target-head="t004" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNrmsa" x-gloss="[am].prepared" x-translit="nāḵôn" xml:lang="hbo" x-source-ref="PSA.38.18">נָכ֑וֹן</char> <char style="w" x-id="WLC.PSA.38.17.006" x-align="PSA.38.17.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.38.18">וּ</char><char style="w" x-id="WLC.PSA.38.17.007" x-align="PSA.38.17.a007" x-target-ids="t009" x-target="sorrow" x-target-head="t009" x-head="true" lemma="מַכְאוֹב" strong="H4341" x-morph="Ncmsc" x-gloss="pain" x-translit="maḵʾôḇ" xml:lang="hbo" x-source-ref="PSA.38.18">מַכְאוֹבִ֖</char><char style="w" x-id="WLC.PSA.38.17.008" x-a