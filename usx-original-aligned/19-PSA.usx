	<para style="p"><verse number="8" style="v" x-ref="PSA.86.8" x-added-alignments="PSA.86.8.a010" x-added-target-ids="t016" x-added-target="works" sid="PSA 86:8" /><char style="w" x-id="WLC.PSA.86.8.001" x-align="PSA.86.8.a001" x-target-ids="t001 t002 t003" x-target="There is none" x-target-head="t003" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾên-" xml:lang="hbo">אֵין</char>־<char style="w" x-id="WLC.PSA.86.8.002" x-align="PSA.86.8.a002" x-target-ids="t004 t005" x-target="like unto" x-target-head="t004" x-head="true" lemma="כְּמוֹ" strong="H3644" x-morph="R" x-gloss="like" x-translit="kāmô" xml:lang="hbo">כָּמ֖וֹ</char><char style="w" x-id="WLC.PSA.86.8.003" x-align="PSA.86.8.a003" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.86.8.004" x-align="PSA.86.8.a004" x-target-ids="t007" x-target="among" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ḇā" xml:lang="hbo">בָ</char><char style="w" x-id="WLC.PSA.86.8.005" x-align="PSA.86.8.a005" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.86.8.006" x-align="PSA.86.8.a006" x-target-ids="t009" x-target="gods" x-target-head="t009" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="gods" x-translit="ʾĕlōhiym" xml:lang="hbo">אֱלֹהִ֥ים</char>׀<char style="w" x-id="WLC.PSA.86.8.007" x-align="PSA.86.8.a007" x-target-ids="t010 t011" x-target="O Lord" x-target-head="t011" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo">אֲדֹנָ֗</char><char style="w" x-id="WLC.PSA.86.8.008" x-align="PSA.86.8.a008" x-status="unrepresented" x-head="true" lemma="הוּא" strong