	<para style="p"><verse number="2" style="v" x-ref="PSA.7.2" sid="PSA 7:2" /><char style="w" x-id="WLC.PSA.7.2.001" x-align="PSA.7.2.a001" x-target-ids="t001" x-target="Lest" x-target-head="t001" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo" x-source-ref="PSA.7.3">פֶּן</char>־<char style="w" x-id="WLC.PSA.7.2.002" x-align="PSA.7.2.a002" x-target-ids="t002 t003" x-target="they tear" x-target-head="t003" x-head="true" lemma="טָרַף" strong="H2963" x-morph="Vqi3ms" x-gloss="he.should.tear.to.pieces" x-translit="yiṭrōp̄" xml:lang="hbo" x-source-ref="PSA.7.3">יִטְרֹ֣ף</char> <char style="w" x-id="WLC.PSA.7.2.003" x-align="PSA.7.2.a003" x-target-ids="t006" x-target="like" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo" x-source-ref="PSA.7.3">כְּ</char><char style="w" x-id="WLC.PSA.7.2.004" x-align="PSA.7.2.a004" x-target-ids="t007 t008" x-target="a lion" x-target-head="t008" x-head="true" lemma="אַרְיֵה" strong="H738a" x-morph="Ncmsa" x-gloss="a.lion" x-translit="ʾaryēh" xml:lang="hbo" x-source-ref="PSA.7.3">אַרְיֵ֣ה</char> <char style="w" x-id="WLC.PSA.7.2.005" x-align="PSA.7.2.a005" x-target-ids="t005" x-target="soul" x-target-head="t005" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo" x-source-ref="PSA.7.3">נַפְשִׁ֑</char><char style="w" x-id="WLC.PSA.7.2.006" x-align="PSA.7.2.a006" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.7.3">י</char> <char style="w" x-id="WLC.PSA.7.2.007" x-align="PSA.7.2.a007" x-target-ids="t009 t010 t011 t012" x-target="Rending it in pieces" x-target-head="t009" x-head="true" lemma="פָּרַק" strong="H6561" x-morph="Vqrmsa" x-gloss="tearing" x-translit="pōrēq" xml:lang="hbo" x-source-ref="PSA.7.3">פֹּ֝רֵ֗ק</char> <char style="w" x-