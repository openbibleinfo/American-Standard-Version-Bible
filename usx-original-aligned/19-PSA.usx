	<para style="p"><verse number="6" style="v" x-ref="PSA.105.6" sid="PSA 105:6" /><char style="w" x-id="WLC.PSA.105.6.001" x-align="PSA.105.6.a001" x-target-ids="t001 t002 t003" x-target="O ye seed" x-target-head="t003" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsc" x-gloss="O.offspring" x-translit="zeraʿ" xml:lang="hbo">זֶ֭רַע</char> <char style="w" x-id="WLC.PSA.105.6.002" x-align="PSA.105.6.a002" x-target-ids="t004 t005" x-target="of Abraham" x-target-head="t005" x-head="true" lemma="אַבְרָהָם" strong="H85" x-morph="Np" x-gloss="of.Abraham" x-translit="ʾaḇrāhām" xml:lang="hbo">אַבְרָהָ֣ם</char> <char style="w" x-id="WLC.PSA.105.6.003" x-align="PSA.105.6.a003" x-target-ids="t007" x-target="servant" x-target-head="t007" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo">עַבְדּ֑</char><char style="w" x-id="WLC.PSA.105.6.004" x-align="PSA.105.6.a004" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.105.6.005" x-align="PSA.105.6.a005" x-target-ids="t008 t009" x-target="Ye children" x-target-head="t009" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="O.descendants" x-translit="bənēy" xml:lang="hbo">בְּנֵ֖י</char> <char style="w" x-id="WLC.PSA.105.6.006" x-align="PSA.105.6.a006" x-target-ids="t010 t011" x-target="of Jacob" x-target-head="t011" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="of.Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֣ב</char> <char style="w" x-id="WLC.PSA.105.6.007" x-align="PSA.105.6.a007" x-target-ids="t013 t014" x-target="chosen ones" x-target-head="t013" x-head="true" lemma="בָּחִיר" strong="H972" x-morph="Aampc" x-gloss="ones" x-translit="bəḥiyrāy" xml:lang="hbo">בְּחִירָֽי</char><char style="w" x-id="WLC.PSA.105.6.008" x-align="PSA.105.6.a008" x-target-ids="t012" x-target="his" x-targe