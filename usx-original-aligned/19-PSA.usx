	<para style="p"><verse number="14" style="v" x-ref="PSA.9.14" sid="PSA 9:14" /><char style="w" x-id="WLC.PSA.9.14.001" x-align="PSA.9.14.a001" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="so.that" x-translit="ləmaʿan" xml:lang="hbo" x-source-ref="PSA.9.15">לְמַ֥עַן</char> <char style="w" x-id="WLC.PSA.9.14.002" x-align="PSA.9.14.a002" x-target-ids="t002 t003 t004 t005" x-target="I may show forth" x-target-head="t004" x-head="true" lemma="סָפַר" strong="H5608" x-morph="Vph1cs" x-gloss="I.may.recount" x-translit="ʾăsappərāh" xml:lang="hbo" x-source-ref="PSA.9.15">אֲסַפְּרָ֗ה</char> <char style="w" x-id="WLC.PSA.9.14.003" x-align="PSA.9.14.a003" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kāl-" xml:lang="hbo" x-source-ref="PSA.9.15">כָּֽל</char>־<char style="w" x-id="WLC.PSA.9.14.004" x-align="PSA.9.14.a004" x-target-ids="t008" x-target="praise" x-target-head="t008" x-head="true" lemma="תְּהִלָּה" strong="H8416" x-morph="Ncfpc" x-gloss="praises" x-translit="təhillāṯey" xml:lang="hbo" x-source-ref="PSA.9.15">תְּהִלָּ֫תֶ֥י</char><char style="w" x-id="WLC.PSA.9.14.005" x-align="PSA.9.14.a005" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.9.15">ךָ</char> <char style="w" x-id="WLC.PSA.9.14.006" x-align="PSA.9.14.a006" x-target-ids="t009" x-target="In" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.9.15">בְּ</char><char style="w" x-id="WLC.PSA.9.14.007" x-align="PSA.9.14.a007" x-target-ids="t010 t011" x-target="the gates" x-target-head="t011" x-head="true" lemma="שַׁעַר" strong="H8179" x-morph="Ncmpc" x-gloss="the.gates" x-translit="šaʿărēy" xml:lang="hbo" x-source-ref="PSA.9.15">שַֽׁע