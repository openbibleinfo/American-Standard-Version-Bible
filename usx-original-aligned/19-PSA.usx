	<para style="p"><verse number="3" style="v" x-ref="PSA.46.3" x-added-alignments="PSA.46.3.a001 PSA.46.3.a005 PSA.46.3.a007" x-added-target-ids="t001 t006 t009" x-added-target="Though | and | Though" sid="PSA 46:3" /><char style="w" x-id="WLC.PSA.46.3.001" x-align="PSA.46.3.a004" x-target-ids="t005" x-target="roar" x-target-head="t005" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqi3mp" x-gloss="they.will.roar" x-translit="yehĕmû" xml:lang="hbo" x-source-ref="PSA.46.4">יֶהֱמ֣וּ</char> <char style="w" x-id="WLC.PSA.46.3.002" x-align="PSA.46.3.a006" x-target-ids="t007 t008" x-target="be troubled" x-target-head="t008" x-head="true" lemma="חָמַר" strong="H2560" x-morph="Vqi3mp" x-gloss="they.will.foam" x-translit="yeḥmərû" xml:lang="hbo" x-source-ref="PSA.46.4">יֶחְמְר֣וּ</char> <char style="w" x-id="WLC.PSA.46.3.003" x-align="PSA.46.3.a002" x-target-ids="t002 t003" x-target="the waters" x-target-head="t003" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpc" x-gloss="waters" x-translit="mēymāy" xml:lang="hbo" x-source-ref="PSA.46.4">מֵימָ֑י</char><char style="w" x-id="WLC.PSA.46.3.004" x-align="PSA.46.3.a003" x-target-ids="t004" x-target="thereof" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="w" xml:lang="hbo" x-source-ref="PSA.46.4">ו</char> <char style="w" x-id="WLC.PSA.46.3.005" x-align="PSA.46.3.a009" x-target-ids="t012" x-target="tremble" x-target-head="t012" x-head="true" lemma="רָעַשׁ" strong="H7493" x-morph="Vqi3mp" x-gloss="they.will.shake" x-translit="yirəʿăšû-" xml:lang="hbo" x-source-ref="PSA.46.4">יִֽרְעֲשֽׁוּ</char>־<char style="w" x-id="WLC.PSA.46.3.006" x-align="PSA.46.3.a008" x-target-ids="t010 t011" x-target="the mountains" x-target-head="t011" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpa" x-gloss="mountains" x-translit="hāriym" xml:lang="hbo" x-source-ref="PSA.46.4">הָרִ֖ים</char> <char style="w" x-id="WLC.PSA.46.3.007" x-align="PSA.46.3.a010" x-target-ids="t013" x-