	<para style="p"><verse number="2" style="v" x-ref="PSA.26.2" sid="PSA 26:2" /><char style="w" x-id="WLC.PSA.26.2.001" x-align="PSA.26.2.a001" x-target-ids="t001" x-target="Examine" x-target-head="t001" x-head="true" lemma="בָּחַן" strong="H974" x-morph="Vqv2ms" x-gloss="test" x-translit="bəḥān" xml:lang="hbo">בְּחָנֵ֣</char><char style="w" x-id="WLC.PSA.26.2.002" x-align="PSA.26.2.a002" x-target-ids="t002" x-target="me" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.26.2.003" x-align="PSA.26.2.a003" x-target-ids="t003 t004" x-target="O Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.26.2.004" x-align="PSA.26.2.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.26.2.005" x-align="PSA.26.2.a005" x-target-ids="t006" x-target="prove" x-target-head="t006" x-head="true" lemma="נָסָה" strong="H5254" x-morph="Vpv2ms" x-gloss="put" x-translit="nass" xml:lang="hbo">נַסֵּ֑</char><char style="w" x-id="WLC.PSA.26.2.006" x-align="PSA.26.2.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me.to.the.test" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.26.2.007" x-align="PSA.26.2.a007" x-target-ids="t008" x-target="Try" x-target-head="t008" x-head="true" lemma="צָרַף" strong="H6884" x-morph="Vqv2ms" x-gloss="test" x-translit="ṣārəp̄" xml:lang="hbo">צָרְפָ֖</char><char style="w" x-id="WLC.PSA.26.2.008" x-align="PSA.26.2.a008" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PSA.26.2.009" x