	<para style="p"><verse number="45" style="v" x-ref="PSA.105.45" sid="PSA 105:45" /><char style="w" x-id="WLC.PSA.105.45.001" x-align="PSA.105.45.a001" x-status="noncompositional" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="so" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.105.45.002" x-align="PSA.105.45.a001" x-status="noncompositional" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="עָבוּר" strong="H5668" x-morph="Ncmsc" x-gloss="that" x-translit="ʿăḇûr" xml:lang="hbo">עֲב֤וּר</char>׀<char style="w" x-id="WLC.PSA.105.45.003" x-align="PSA.105.45.a002" x-target-ids="t002 t003 t004" x-target="they might keep" x-target-head="t004" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqi3mp" x-gloss="they.may.keep" x-translit="yišmərû" xml:lang="hbo">יִשְׁמְר֣וּ</char> <char style="w" x-id="WLC.PSA.105.45.004" x-align="PSA.105.45.a003" x-target-ids="t006" x-target="statutes" x-target-head="t006" x-head="true" lemma="חֹק" strong="H2706" x-morph="Ncmpc" x-gloss="decrees" x-translit="ḥuqqāy" xml:lang="hbo">חֻ֭קָּי</char><char style="w" x-id="WLC.PSA.105.45.005" x-align="PSA.105.45.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.105.45.006" x-align="PSA.105.45.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.105.45.007" x-align="PSA.105.45.a006" x-target-ids="t010" x-target="laws" x-target-head="t010" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfpc" x-gloss="laws" x-translit="ṯôrōṯāy" xml:lang="hbo">תוֹרֹתָ֥י</char><char style="w" x-id="WLC.PSA.105.45.008" x-align="PSA.105.45.a007" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss=