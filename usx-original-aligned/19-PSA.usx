	<para style="p"><verse number="25" style="v" x-ref="PSA.104.25" sid="PSA 104:25" /><char style="w" x-id="WLC.PSA.104.25.001" x-align="PSA.104.25.a001" x-target-ids="t001 t002" x-target="Yonder is" x-target-head="t001" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֤ה</char>׀<char style="w" x-id="WLC.PSA.104.25.002" x-align="PSA.104.25.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PSA.104.25.003" x-align="PSA.104.25.a003" x-target-ids="t004" x-target="sea" x-target-head="t004" x-head="true" lemma="יָם" strong="H3220" x-morph="Ncmsa" x-gloss="sea" x-translit="yyām" xml:lang="hbo">יָּ֥ם</char> <char style="w" x-id="WLC.PSA.104.25.004" x-align="PSA.104.25.a004" x-target-ids="t005" x-target="great" x-target-head="t005" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="[is].great" x-translit="gāḏôl" xml:lang="hbo">גָּדוֹל֮</char> <char style="w" x-id="WLC.PSA.104.25.005" x-align="PSA.104.25.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.104.25.006" x-align="PSA.104.25.a006" x-target-ids="t007" x-target="wide" x-target-head="t007" x-head="true" lemma="רָחָב" strong="H7342" x-morph="Aamsc" x-gloss="broad" x-translit="rəḥaḇ" xml:lang="hbo">רְחַ֪ב</char> <char style="w" x-id="WLC.PSA.104.25.007" x-align="PSA.104.25.a006" lemma="יָד" strong="H3027" x-morph="Ncbda" x-gloss="of.both.sides" x-translit="yāḏāyim" xml:lang="hbo">יָ֫דָ֥יִם</char> <char style="w" x-id="WLC.PSA.104.25.008" x-align="PSA.104.25.a007" x-target-ids="t008 t009" x-target="Wherein are" x-target-head="t008" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="[are].there" x-translit="šām-" xml:lang="hbo">שָֽׁם</char>־<char sty