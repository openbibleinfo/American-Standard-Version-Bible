	<para style="p"><verse number="33" style="v" x-ref="PSA.106.33" sid="PSA 106:33" /><char style="w" x-id="WLC.PSA.106.33.001" x-align="PSA.106.33.a001" x-target-ids="t001" x-target="Because" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.106.33.002" x-align="PSA.106.33.a002" x-target-ids="t002 t003 t004" x-target="they were rebellious" x-target-head="t004" x-head="true" lemma="מָרָה" strong="H4784" x-morph="Vhp3cp" x-gloss="they.rebelled.toward" x-translit="himrû" xml:lang="hbo">הִמְר֥וּ</char> <char style="w" x-id="WLC.PSA.106.33.003" x-align="PSA.106.33.a003" x-target-ids="t005" x-target="against" x-target-head="t005" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.106.33.004" x-align="PSA.106.33.a004" x-target-ids="t007" x-target="spirit" x-target-head="t007" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="spirit" x-translit="rûḥ" xml:lang="hbo">רוּח֑</char><char style="w" x-id="WLC.PSA.106.33.005" x-align="PSA.106.33.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.106.33.006" x-align="PSA.106.33.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝</char><char style="w" x-id="WLC.PSA.106.33.007" x-align="PSA.106.33.a007" x-target-ids="t009 t010 t011" x-target="he spake unadvisedly" x-target-head="t010" x-head="true" lemma="בטא" strong="H981" x-morph="Vpw3ms" x-gloss="he.spoke.rashly" x-translit="yəḇaṭṭēʾ" xml:lang="hbo">יְבַטֵּ֗א</char> <char style="w" x-id="WLC.PSA.106.33.008" x-align="PSA.106.33.a008" x-target-ids="t012" x-target="with" x-target-head="t012" x-head="true