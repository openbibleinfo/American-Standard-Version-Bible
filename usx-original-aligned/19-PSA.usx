	<para style="p"><verse number="2" style="v" x-ref="PSA.4.2" x-added-alignments="PSA.4.2.a009" x-added-target-ids="t015 t016" x-added-target="How long" sid="PSA 4:2" /><char style="w" x-id="WLC.PSA.4.2.001" x-align="PSA.4.2.a001" x-target-ids="t001 t002 t003" x-target="O ye sons" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="O.sons" x-translit="bənēy" xml:lang="hbo" x-source-ref="PSA.4.3">בְּנֵ֥י</char> <char style="w" x-id="WLC.PSA.4.2.002" x-align="PSA.4.2.a002" x-target-ids="t004 t005" x-target="of men" x-target-head="t005" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.man" x-translit="ʾiyš" xml:lang="hbo" x-source-ref="PSA.4.3">אִ֡ישׁ</char> <char style="w" x-id="WLC.PSA.4.2.003" x-align="PSA.4.2.a003" x-target-ids="t007" x-target="long" x-target-head="t007" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo" x-source-ref="PSA.4.3">עַד</char>־<char style="w" x-id="WLC.PSA.4.2.004" x-align="PSA.4.2.a004" x-target-ids="t006" x-target="how" x-target-head="t006" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="when?" x-translit="meh" xml:lang="hbo" x-source-ref="PSA.4.3">מֶ֬ה</char> <char style="w" x-id="WLC.PSA.4.2.005" x-align="PSA.4.2.a005" x-target-ids="t010" x-target="glory" x-target-head="t010" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="honor" x-translit="ḵəḇôḏ" xml:lang="hbo" x-source-ref="PSA.4.3">כְבוֹדִ֣</char><char style="w" x-id="WLC.PSA.4.2.006" x-align="PSA.4.2.a006" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[will].my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.4.3">י</char> <char style="w" x-id="WLC.PSA.4.2.007" x-align="PSA.4.2.a007" x-target-ids="t008 t011 t012 t013" x-target="shall be turned into" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[become].(into)" x-translit="l