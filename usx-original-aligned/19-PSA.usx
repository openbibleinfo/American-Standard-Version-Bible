	<para style="p"><verse number="22" style="v" x-ref="PSA.22.22" sid="PSA 22:22" /><char style="w" x-id="WLC.PSA.22.22.001" x-align="PSA.22.22.a001" x-target-ids="t001 t002 t003" x-target="I will declare" x-target-head="t003" x-head="true" lemma="סָפַר" strong="H5608" x-morph="Vph1cs" x-gloss="I.will.recount" x-translit="ʾăsappərāh" xml:lang="hbo" x-source-ref="PSA.22.23">אֲסַפְּרָ֣ה</char> <char style="w" x-id="WLC.PSA.22.22.002" x-align="PSA.22.22.a002" x-target-ids="t005" x-target="name" x-target-head="t005" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šim" xml:lang="hbo" x-source-ref="PSA.22.23">שִׁמְ</char><char style="w" x-id="WLC.PSA.22.22.003" x-align="PSA.22.22.a003" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.22.23">ךָ֣</char> <char style="w" x-id="WLC.PSA.22.22.004" x-align="PSA.22.22.a004" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.22.23">לְ</char><char style="w" x-id="WLC.PSA.22.22.005" x-align="PSA.22.22.a005" x-target-ids="t008" x-target="brethren" x-target-head="t008" x-head="true" lemma="אָח" strong="H251" x-morph="Ncmpc" x-gloss="brothers" x-translit="ʾeḥ" xml:lang="hbo" x-source-ref="PSA.22.23">אֶחָ֑</char><char style="w" x-id="WLC.PSA.22.22.006" x-align="PSA.22.22.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.22.23">י</char> <char style="w" x-id="WLC.PSA.22.22.007" x-align="PSA.22.22.a007" x-target-ids="t009" x-target="In" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.22.23">בְּ</char><char style="w" x-id="WLC.PSA.22.22.008