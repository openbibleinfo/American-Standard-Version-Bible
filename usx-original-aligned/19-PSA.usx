	<para style="p"><verse number="15" style="v" x-ref="PSA.77.15" x-added-alignments="PSA.77.15.a004" x-added-target-ids="t004" x-added-target="thine" sid="PSA 77:15" /><char style="w" x-id="WLC.PSA.77.15.001" x-align="PSA.77.15.a001" x-target-ids="t001 t002 t006" x-target="Thou hast redeemed" x-target-head="t006" x-head="true" lemma="גָּאַל" strong="H1350" x-morph="Vqp2ms" x-gloss="you.redeemed" x-translit="gāʾalətā" xml:lang="hbo" x-source-ref="PSA.77.16">גָּאַ֣לְתָּ</char> <char style="w" x-id="WLC.PSA.77.15.002" x-align="PSA.77.15.a002" x-target-ids="t003" x-target="with" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bi" xml:lang="hbo" x-source-ref="PSA.77.16">בִּ</char><char style="w" x-id="WLC.PSA.77.15.003" x-align="PSA.77.15.a003" x-target-ids="t005" x-target="arm" x-target-head="t005" x-head="true" lemma="זְרוֹעַ" strong="H2220" x-morph="Ncbsa" x-gloss="an.arm" x-translit="zərôᵃʿ" xml:lang="hbo" x-source-ref="PSA.77.16">זְר֣וֹעַ</char> <char style="w" x-id="WLC.PSA.77.15.004" x-align="PSA.77.15.a005" x-target-ids="t008" x-target="people" x-target-head="t008" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="PSA.77.16">עַמֶּ֑</char><char style="w" x-id="WLC.PSA.77.15.005" x-align="PSA.77.15.a006" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.77.16">ךָ</char> <char style="w" x-id="WLC.PSA.77.15.006" x-align="PSA.77.15.a007" x-target-ids="t009 t010" x-target="The sons" x-target-head="t010" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.descendants" x-translit="bənê-" xml:lang="hbo" x-source-ref="PSA.77.16">בְּנֵי</char>־<char style="w" x-id="WLC.PSA.77.15.007" x-align="PSA.77.15.a008" x-target-ids="t011 t012" x-target="of Jacob" x-target-head="t012" x-head="true" lemma="יַעֲקֹב" strong