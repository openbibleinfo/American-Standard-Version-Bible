	<para style="p"><verse number="3" style="v" x-ref="PSA.5.3" x-added-alignments="PSA.5.3.a008" x-added-target-ids="t017 t018" x-added-target="my prayer" sid="PSA 5:3" /><char style="w" x-id="WLC.PSA.5.3.001" x-align="PSA.5.3.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.5.4">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.5.3.002" x-align="PSA.5.3.a002" x-target-ids="t003 t004 t005" x-target="in the morning" x-target-head="t005" x-head="true" lemma="בֹּקֶר" strong="H1242" x-morph="Ncmsa" x-gloss="morning" x-translit="bōqer" xml:lang="hbo" x-source-ref="PSA.5.4">בֹּ֭קֶר</char><char style="w" x-id="WLC.PSA.5.3.003" x-align="PSA.5.3.a003" x-target-ids="t006 t007 t008" x-target="shalt thou hear" x-target-head="t008" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi2ms" x-gloss="you.hear" x-translit="tišmaʿ" xml:lang="hbo" x-source-ref="PSA.5.4">תִּשְׁמַ֣ע</char> <char style="w" x-id="WLC.PSA.5.3.004" x-align="PSA.5.3.a004" x-target-ids="t010" x-target="voice" x-target-head="t010" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="voice" x-translit="qôl" xml:lang="hbo" x-source-ref="PSA.5.4">קוֹלִ֑</char><char style="w" x-id="WLC.PSA.5.3.005" x-align="PSA.5.3.a005" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.5.4">י</char> <char style="w" x-id="WLC.PSA.5.3.006" x-align="PSA.5.3.a006" x-target-ids="t011 t012 t013" x-target="In the morning" x-target-head="t013" x-head="true" lemma="בֹּקֶר" strong="H1242" x-morph="Ncmsa" x-gloss="morning" x-translit="bōqer" xml:lang="hbo" x-source-ref="PSA.5.4">בֹּ֥קֶר</char> <char style="w" x-id="WLC.PSA.5.3.007" x-align="PSA.5.3.a007" x-target-ids="t014 t015 t016" x-target="will I order" x-target-head="t016" x-head="true" lemma="עָרַךְ" s