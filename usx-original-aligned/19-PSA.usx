	<para style="p"><verse number="7" style="v" x-ref="PSA.113.7" x-added-alignments="PSA.113.7.a001 PSA.113.7.a006" x-added-target-ids="t001 t010" x-added-target="He | And" sid="PSA 113:7" /><char style="w" x-id="WLC.PSA.113.7.001" x-align="PSA.113.7.a002" x-target-ids="t002 t003" x-target="raiseth up" x-target-head="t002" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vhrmsc" x-gloss="[he.is].raising" x-translit="məqiymiy" xml:lang="hbo">מְקִֽימִ֣י</char> <char style="w" x-id="WLC.PSA.113.7.002" x-align="PSA.113.7.a003" x-target-ids="t006 t007" x-target="out of" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PSA.113.7.003" x-align="PSA.113.7.a004" x-target-ids="t008 t009" x-target="the dust" x-target-head="t009" x-head="true" lemma="עָפָר" strong="H6083" x-morph="Ncmsa" x-gloss="dust" x-translit="ʿāp̄ār" xml:lang="hbo">עָפָ֣ר</char> <char style="w" x-id="WLC.PSA.113.7.004" x-align="PSA.113.7.a005" x-target-ids="t004 t005" x-target="the poor" x-target-head="t005" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="[the].poor" x-translit="dāl" xml:lang="hbo">דָּ֑ל</char> <char style="w" x-id="WLC.PSA.113.7.005" x-align="PSA.113.7.a007" x-target-ids="t015" x-target="from" x-target-head="t015" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo">מֵֽ֝</char><char style="w" x-id="WLC.PSA.113.7.006" x-align="PSA.113.7.a008" x-target-ids="t016 t017" x-target="the dunghill" x-target-head="t017" x-head="true" lemma="אַשְׁפֹּת" strong="H830" x-morph="Ncmsa" x-gloss="ash.heap" x-translit="ʾašpōṯ" xml:lang="hbo">אַשְׁפֹּ֗ת</char> <char style="w" x-id="WLC.PSA.113.7.007" x-align="PSA.113.7.a009" x-target-ids="t011 t012" x-target="lifteth up" x-target-head="t011" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vhi3ms" x-gloss="he.lifts.up" x-translit="yāriym" xml:lang="hbo">יָרִ֥ים</char> <char st