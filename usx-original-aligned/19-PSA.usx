	<para style="p"><verse number="1" style="v" x-ref="PSA.95.1" sid="PSA 95:1" /><char style="w" x-id="WLC.PSA.95.1.001" x-align="PSA.95.1.a001" x-target-ids="t001 t002" x-target="Oh come" x-target-head="t002" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2mp" x-gloss="come" x-translit="ləḵû" xml:lang="hbo">לְ֭כוּ</char> <char style="w" x-id="WLC.PSA.95.1.002" x-align="PSA.95.1.a002" x-target-ids="t003 t004 t005" x-target="let us sing" x-target-head="t005" x-head="true" lemma="רָנַן" strong="H7442" x-morph="Vph1cp" x-gloss="let.us.sing.for.joy" x-translit="nərannənāh" xml:lang="hbo">נְרַנְּנָ֣ה</char> <char style="w" x-id="WLC.PSA.95.1.003" x-align="PSA.95.1.a003" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.95.1.004" x-align="PSA.95.1.a004" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֑ה</char> <char style="w" x-id="WLC.PSA.95.1.005" x-align="PSA.95.1.a005" x-target-ids="t008 t009 t010 t011 t012 t013" x-target="Let us make a joyful noise" x-target-head="t013" x-head="true" lemma="רוּעַ" strong="H7321" x-morph="Vhh1cp" x-gloss="let.us.shout.for.joy" x-translit="nāriyʿâ" xml:lang="hbo">נָ֝רִ֗יעָה</char> <char style="w" x-id="WLC.PSA.95.1.006" x-align="PSA.95.1.a006" x-target-ids="t014" x-target="to" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.95.1.007" x-align="PSA.95.1.a007" x-target-ids="t015 t016" x-target="the rock" x-target-head="t016" x-head="true" lemma="צוּר" strong="H6697" x-morph="Ncmsc" x-gloss="the.rock" x-translit="ṣûr" xml:lang="hbo">צ֣וּר</char> <char style="w" x-id="WLC.PSA.95.1.008" x-align="PSA.95.1.a008" x-target-ids="t017 t019" x-target="of salvation" x-target-hea