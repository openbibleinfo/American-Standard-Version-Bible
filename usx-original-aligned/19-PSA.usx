	<para style="d" x-ref="PSA.9.0"><char style="w" x-id="WLC.PSA.9.0.001" x-align="PSA.9.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.9.1">לַ֭</char><char style="w" x-id="WLC.PSA.9.0.002" x-align="PSA.9.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.9.1">[הַ]</char><char style="w" x-id="WLC.PSA.9.0.003" x-align="PSA.9.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.9.1">מְנַצֵּחַ</char> <char style="w" x-id="WLC.PSA.9.0.004" x-align="PSA.9.0.a004" x-target-ids="t005 t006 t007" x-target="set to Muth" x-target-head="t007" x-head="true" lemma="עַלְמוּת" strong="H4192" x-morph="Ncfsc" x-gloss="alumoth" x-translit="ʿalmûṯ" xml:lang="hbo" x-source-ref="PSA.9.1">עַלְמ֥וּת</char> <char style="w" x-id="WLC.PSA.9.0.005" x-align="PSA.9.0.a005" x-target-ids="t008" x-target="labben" x-target-head="t008" x-head="true" lemma="לְ" strong="H4192" x-morph="Np" x-gloss="labben" x-translit="labbēn" xml:lang="hbo" x-source-ref="PSA.9.1">לַבֵּ֗ן</char> <char style="w" x-id="WLC.PSA.9.0.006" x-align="PSA.9.0.a006" x-target-ids="t009 t010" x-target="A Psalm" x-target-head="t010" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.9.1">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.9.0.007" x-align="PSA.9.0.a007" x-target-ids="t011" x-target="of" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.9.1">לְ</char><char style="w" x-id="WLC.PSA.9.0.008" x-align="PSA.9.0.a008" x-target-ids="t012" x-targ