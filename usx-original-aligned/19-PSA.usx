	<para style="p"><verse number="6" style="v" x-ref="PSA.10.6" sid="PSA 10:6" /><char style="w" x-id="WLC.PSA.10.6.001" x-align="PSA.10.6.a001" x-target-ids="t001 t002" x-target="He saith" x-target-head="t002" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.PSA.10.6.002" x-align="PSA.10.6.a002" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PSA.10.6.003" x-align="PSA.10.6.a003" x-target-ids="t005" x-target="heart" x-target-head="t005" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבּ</char><char style="w" x-id="WLC.PSA.10.6.004" x-align="PSA.10.6.a004" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.10.6.005" x-align="PSA.10.6.a005" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PSA.10.6.006" x-align="PSA.10.6.a006" x-target-ids="t006 t007 t009 t010" x-target="I shall be moved" x-target-head="t010" x-head="true" lemma="מוֹט" strong="H4131" x-morph="VNi1cs" x-gloss="I.will.be.shaken" x-translit="ʾemmôṭ" xml:lang="hbo">אֶמּ֑וֹט</char> <char style="w" x-id="WLC.PSA.10.6.007" x-align="PSA.10.6.a007" x-target-ids="t011" x-target="To" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.10.6.008" x-align="PSA.10.6.a008" x-target-ids="t013" x-target="generations" x-target-head="t013" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsa" x-gloss="a.generation" x-translit="ḏ