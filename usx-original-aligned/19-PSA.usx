	<para style="p"><verse number="21" style="v" x-ref="PSA.44.21" sid="PSA 44:21" /><char style="w" x-id="WLC.PSA.44.21.001" x-align="PSA.44.21.a001" x-target-ids="t001" x-target="Will" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="hă" xml:lang="hbo" x-source-ref="PSA.44.22">הֲ</char><char style="w" x-id="WLC.PSA.44.21.002" x-align="PSA.44.21.a002" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.44.22">לֹ֣א</char> <char style="w" x-id="WLC.PSA.44.21.003" x-align="PSA.44.21.a003" x-target-ids="t003" x-target="God" x-target-head="t003" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.44.22">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.44.21.004" x-align="PSA.44.21.a004" x-target-ids="t004 t006" x-target="search out" x-target-head="t004" x-head="true" lemma="חָקַר" strong="H2713" x-morph="Vqi3ms" x-gloss="will.he.search.out" x-translit="yaḥăqār-" xml:lang="hbo" x-source-ref="PSA.44.22">יַֽחֲקָר</char>־<char style="w" x-id="WLC.PSA.44.21.005" x-align="PSA.44.21.a005" x-target-ids="t005" x-target="this" x-target-head="t005" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo" x-source-ref="PSA.44.22">זֹ֑את</char> <char style="w" x-id="WLC.PSA.44.21.006" x-align="PSA.44.21.a006" x-target-ids="t007" x-target="For" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.44.22">כִּֽי</char>־<char style="w" x-id="WLC.PSA.44.21.007" x-align="PSA.44.21.a007" x-target-ids="t008" x-target="he" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo" x-source-ref="PSA.44.22">ה֥וּא</char> <char style="w" x-id="WLC.PSA.44.21.00