	<para style="p"><verse number="2" style="v" x-ref="PSA.60.2" sid="PSA 60:2" /><char style="w" x-id="WLC.PSA.60.2.001" x-align="PSA.60.2.a001" x-target-ids="t001 t002 t003 t006 t007" x-target="Thou hast made to tremble" x-target-head="t007" x-head="true" lemma="רָעַשׁ" strong="H7493" x-morph="Vhp2ms" x-gloss="you.have.made.quake" x-translit="hirʿašətâ" xml:lang="hbo" x-source-ref="PSA.60.4">הִרְעַ֣שְׁתָּה</char> <char style="w" x-id="WLC.PSA.60.2.002" x-align="PSA.60.2.a002" x-target-ids="t004 t005" x-target="the land" x-target-head="t005" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].land" x-translit="ʾereṣ" xml:lang="hbo" x-source-ref="PSA.60.4">אֶ֣רֶץ</char> <char style="w" x-id="WLC.PSA.60.2.003" x-align="PSA.60.2.a003" x-target-ids="t008 t009 t010" x-target="thou hast rent" x-target-head="t010" x-head="true" lemma="פָּצַם" strong="H6480" x-morph="Vqp2ms" x-gloss="you" x-translit="pəṣamtā" xml:lang="hbo" x-source-ref="PSA.60.4">פְּצַמְתָּ֑</char><char style="w" x-id="WLC.PSA.60.2.004" x-align="PSA.60.2.a004" x-target-ids="t011" x-target="it" x-target-head="t011" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="have.split.it.open" x-translit="hh" xml:lang="hbo" x-source-ref="PSA.60.4">הּ</char> <char style="w" x-id="WLC.PSA.60.2.005" x-align="PSA.60.2.a005" x-target-ids="t012" x-target="Heal" x-target-head="t012" x-head="true" lemma="רָפָא" strong="H7495" x-morph="Vqv2ms" x-gloss="repair" x-translit="rəp̄" xml:lang="hbo" x-source-ref="PSA.60.4">רְפָ֖</char><char style="w" x-id="WLC.PSA.60.2.006" x-align="PSA.60.2.a006" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.60.4">ה</char> <char style="w" x-id="WLC.PSA.60.2.007" x-align="PSA.60.2.a007" x-target-ids="t013 t014" x-target="the breaches" x-target-head="t014" x-head="true" lemma="שֶׁבֶר" strong="H7667" x-morph="Ncmpc" x-gloss="fractures" x-translit="šəḇārey" xml:lang="hbo" x-source-ref="