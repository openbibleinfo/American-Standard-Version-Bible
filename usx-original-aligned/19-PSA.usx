	<para style="p"><verse number="3" style="v" x-ref="PSA.119.3" sid="PSA 119:3" /><char style="w" x-id="WLC.PSA.119.3.001" x-align="PSA.119.3.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄" xml:lang="hbo">אַ֭ף</char> <char style="w" x-id="WLC.PSA.119.3.002" x-align="PSA.119.3.a002" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PSA.119.3.003" x-align="PSA.119.3.a003" x-target-ids="t002 t003" x-target="they do" x-target-head="t003" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqp3cp" x-gloss="they.do" x-translit="p̄āʿălû" xml:lang="hbo">פָעֲל֣וּ</char> <char style="w" x-id="WLC.PSA.119.3.004" x-align="PSA.119.3.a004" x-target-ids="t005" x-target="unrighteousness" x-target-head="t005" x-head="true" lemma="עַוְלָה" strong="H5766a" x-morph="Ncbsa" x-gloss="injustice" x-translit="ʿawlāh" xml:lang="hbo">עַוְלָ֑ה</char> <char style="w" x-id="WLC.PSA.119.3.005" x-align="PSA.119.3.a006" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PSA.119.3.006" x-align="PSA.119.3.a007" x-target-ids="t010" x-target="ways" x-target-head="t010" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="ḏərāḵāy" xml:lang="hbo">דְרָכָ֥י</char><char style="w" x-id="WLC.PSA.119.3.007" x-align="PSA.119.3.a008" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.119.3.008" x-align="PSA.119.3.a005" x-target-ids="t006 t007" x-target="They walk" x-target-head="t007" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqp3cp" x-gloss="they.w