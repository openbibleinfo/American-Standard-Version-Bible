	<para style="p"><verse number="9" style="v" x-ref="PSA.35.9" sid="PSA 35:9" /><char style="w" x-id="WLC.PSA.35.9.001" x-align="PSA.35.9.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.PSA.35.9.002" x-align="PSA.35.9.a002" x-target-ids="t003" x-target="soul" x-target-head="t003" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ</char><char style="w" x-id="WLC.PSA.35.9.003" x-align="PSA.35.9.a003" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.35.9.004" x-align="PSA.35.9.a004" x-target-ids="t004 t005 t006" x-target="shall be joyful" x-target-head="t006" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqi3fs" x-gloss="it.will.rejoice" x-translit="tāḡiyl" xml:lang="hbo">תָּגִ֣יל</char> <char style="w" x-id="WLC.PSA.35.9.005" x-align="PSA.35.9.a005" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.35.9.006" x-align="PSA.35.9.a006" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֑ה</char> <char style="w" x-id="WLC.PSA.35.9.007" x-align="PSA.35.9.a007" x-target-ids="t009 t010 t011" x-target="It shall rejoice" x-target-head="t011" x-head="true" lemma="שׂוּשׂ" strong="H7797" x-morph="Vqi3fs" x-gloss="it.will.exult" x-translit="tāśîś" xml:lang="hbo">תָּ֝שִׂישׂ</char> <char style="w" x-id="WLC.PSA.35.9.008" x-align="PSA.35.9.a008" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-tr