	<para style="p"><verse number="2" style="v" x-ref="PSA.58.2" sid="PSA 58:2" /><char style="w" x-id="WLC.PSA.58.2.001" x-align="PSA.58.2.a001" x-target-ids="t001" x-target="Nay" x-target-head="t001" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo" x-source-ref="PSA.58.3">אַף</char>־<char style="w" x-id="WLC.PSA.58.2.002" x-align="PSA.58.2.a002" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.58.3">בְּ</char><char style="w" x-id="WLC.PSA.58.2.003" x-align="PSA.58.2.a003" x-target-ids="t003" x-target="heart" x-target-head="t003" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="heart" x-translit="lēḇ" xml:lang="hbo" x-source-ref="PSA.58.3">לֵב֮</char> <char style="w" x-id="WLC.PSA.58.2.004" x-align="PSA.58.2.a004" x-target-ids="t006" x-target="wickedness" x-target-head="t006" x-head="true" lemma="עַוְלָה" strong="H5766a" x-morph="Ncbpa" x-gloss="injustice(s)" x-translit="ʿôlōṯ" xml:lang="hbo" x-source-ref="PSA.58.3">עוֹלֹ֪ת</char> <char style="w" x-id="WLC.PSA.58.2.005" x-align="PSA.58.2.a005" x-target-ids="t004 t005" x-target="ye work" x-target-head="t005" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqi2mp" x-gloss="you" x-translit="tip̄ʿālû" xml:lang="hbo" x-source-ref="PSA.58.3">תִּפְעָ֫ל֥וּ</char><char style="w" x-id="WLC.PSA.58.2.006" x-align="PSA.58.2.a006" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="do" x-translit="n" xml:lang="hbo" x-source-ref="PSA.58.3">ן</char> <char style="w" x-id="WLC.PSA.58.2.007" x-align="PSA.58.2.a007" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="bā" xml:lang="hbo" x-source-ref="PSA.58.3">בָּ</char><char style="w" x-id="WLC.PSA.58.2.008" x-align="PSA.58.2.a008" x-target-ids="t016" x-target="the" x-target