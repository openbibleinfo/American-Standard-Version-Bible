	<para style="p"><verse number="21" style="v" x-ref="PSA.118.21" sid="PSA 118:21" /><char style="w" x-id="WLC.PSA.118.21.001" x-align="PSA.118.21.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="I will give thanks unto" x-target-head="t004" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo">א֭וֹדְ</char><char style="w" x-id="WLC.PSA.118.21.002" x-align="PSA.118.21.a002" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.118.21.003" x-align="PSA.118.21.a003" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PSA.118.21.004" x-align="PSA.118.21.a004" x-target-ids="t008 t009 t010" x-target="thou hast answered" x-target-head="t010" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqp2ms" x-gloss="you" x-translit="ʿăniyṯā" xml:lang="hbo">עֲנִיתָ֑</char><char style="w" x-id="WLC.PSA.118.21.005" x-align="PSA.118.21.a005" x-target-ids="t011" x-target="me" x-target-head="t011" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="answered.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.118.21.006" x-align="PSA.118.21.a006" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.118.21.007" x-align="PSA.118.21.a007" x-target-ids="t013 t014" x-target="art become" x-target-head="t014" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw2ms" x-gloss="you.have.become" x-translit="təhî-" xml:lang="hbo">תְּהִי</char>־<char style="w" x-id="WLC.PSA.118.21.008" x-align="PSA.118.21.a008" x-status="unrepresented" x-head="true" lemma="ל