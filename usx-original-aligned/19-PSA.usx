	<para style="p"><verse number="40" style="v" x-ref="PSA.18.40" sid="PSA 18:40" /><char style="w" x-id="WLC.PSA.18.40.001" x-align="PSA.18.40.a001" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.41">וְֽ</char><char style="w" x-id="WLC.PSA.18.40.002" x-align="PSA.18.40.a002" x-target-ids="t006" x-target="enemies" x-target-head="t006" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾōyəḇ" xml:lang="hbo" x-source-ref="PSA.18.41">אֹיְבַ֗</char><char style="w" x-id="WLC.PSA.18.40.003" x-align="PSA.18.40.a003" x-target-ids="t005" x-target="mine" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo" x-source-ref="PSA.18.41">י</char> <char style="w" x-id="WLC.PSA.18.40.004" x-align="PSA.18.40.a004" x-target-ids="t001 t002 t004 t007" x-target="Thou hast made turn" x-target-head="t007" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp2ms" x-gloss="you.gave" x-translit="nāṯatâ" xml:lang="hbo" x-source-ref="PSA.18.41">נָתַ֣תָּה</char> <char style="w" x-id="WLC.PSA.18.40.005" x-align="PSA.18.40.a005" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo" x-source-ref="PSA.18.41">לִּ֣</char><char style="w" x-id="WLC.PSA.18.40.006" x-align="PSA.18.40.a006" x-target-ids="t011" x-target="me" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.18.41">י</char> <char style="w" x-id="WLC.PSA.18.40.007" x-align="PSA.18.40.a007" x-target-ids="t008 t009" x-target="their backs" x-target-head="t009" x-head="true" lemma="עֹרֶף" strong="H6203" x-morph="Ncmsa" x-gloss="neck" x-translit="ʿōrep̄" xml:lang="hbo" x-source-ref="PSA.18.41">עֹ֑רֶף</char> <char style="w" x-id