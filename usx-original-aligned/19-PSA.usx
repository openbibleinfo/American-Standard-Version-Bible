	<para style="p"><verse number="26" style="v" x-ref="PSA.118.26" sid="PSA 118:26" /><char style="w" x-id="WLC.PSA.118.26.001" x-align="PSA.118.26.a001" x-target-ids="t001 t002" x-target="Blessed be" x-target-head="t001" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vqsmsa" x-gloss="[be].blessed" x-translit="bārûḵ" xml:lang="hbo">בָּר֣וּךְ</char> <char style="w" x-id="WLC.PSA.118.26.002" x-align="PSA.118.26.a002" x-target-ids="t003 t004" x-target="he that" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.[one" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PSA.118.26.003" x-align="PSA.118.26.a003" x-target-ids="t005" x-target="cometh" x-target-head="t005" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqrmsa" x-gloss="who].comes" x-translit="bāʾ" xml:lang="hbo">בָּא</char> <char style="w" x-id="WLC.PSA.118.26.004" x-align="PSA.118.26.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.118.26.005" x-align="PSA.118.26.a005" x-target-ids="t007 t008" x-target="the name" x-target-head="t008" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="the.name" x-translit="šēm" xml:lang="hbo">שֵׁ֣ם</char> <char style="w" x-id="WLC.PSA.118.26.006" x-align="PSA.118.26.a006" x-target-ids="t009 t010" x-target="of Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.118.26.007" x-align="PSA.118.26.a007" x-target-ids="t011 t012 t013" x-target="We have blessed" x-target-head="t013" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpp1cp" x-gloss="we" x-translit="bēraḵnû" xml:lang="hbo">בֵּ֝רַֽכְנוּ</char><char style="w" x-id="WLC.PSA.118.26.008" x-align="PSA.118.26.a008" x-target-ids="t014" x-target="you" x-target-head="t014"