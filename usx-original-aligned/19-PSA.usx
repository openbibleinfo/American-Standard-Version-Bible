	<para style="p"><verse number="1" style="v" x-ref="PSA.11.1" x-added-alignments="PSA.11.1.a004" x-added-target-ids="t005 t006" x-added-target="A Psalm" sid="PSA 11:1" /><char style="w" x-id="WLC.PSA.11.1.001" x-align="PSA.11.1.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.11.1.002" x-align="PSA.11.1.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.11.1.003" x-align="PSA.11.1.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo">מְנַצֵּ֗חַ</char> <char style="w" x-id="WLC.PSA.11.1.004" x-align="PSA.11.1.a005" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.11.1.005" x-align="PSA.11.1.a006" x-target-ids="t008" x-target="David" x-target-head="t008" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָ֫וִ֥ד</char><char style="w" x-id="WLC.PSA.11.1.006" x-align="PSA.11.1.a007" x-target-ids="t009" x-target="In" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּֽ</char><char style="w" x-id="WLC.PSA.11.1.007" x-align="PSA.11.1.a008" x-target-ids="t010" x-target="Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֨ה</char>׀<char style="w" x-id="WLC.PSA.11.1.008" x-align="PSA.11.1.a009" x-target-ids="t011 t012 t013 t014" x-target="do I take refuge" x-target-head="t014" x-head="true" lemma="חָסָה" strong="H2620" x-morph="Vqp1cs" x-gloss="I.have.taken.refuge" x-translit="ḥāsiyṯî" xml:lang="hbo">חָסִ֗יתִי</char> <char style="w" x-id="WLC.PSA.11.1.009" x-align="PSA.11.1.a010" x-target-ids="t015" x-target="How" x-target-head="t015" x-head="true" lemma="אֵיךְ" strong="H349" x-morph="Ti" x-gloss="how?" x-translit="ʾêḵ" xml:lang="hbo">אֵ֭יךְ</char> <char style="w" x-id="WLC.PSA.11.1.010" x-align="PSA.11.1.a011" x-target-ids="t016 t017" x-target="say ye" x-target-head="t016" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi2mp" x-gloss="will.you.say" x-translit="tōʾmərû" xml:lang="hbo">תֹּאמְר֣וּ</char> <char style="w" x-id="WLC.PSA.11.1.011" x-align="PSA.11.1.a012" x-target-ids="t018" x-target="to" x-target-head="t018" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.11.1.012" x-align="PSA.11.1.a013" x-target-ids="t020" x-target="soul" x-target-head="t020" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֑</char><char style="w" x-id="WLC.PSA.11.1.013" x-align="PSA.11.1.a014" x-target-ids="t019" x-target="my" x-target-head="t019" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.11.1.014" x-align="PSA.11.1.a015" x-target-ids="t021" x-target="Flee" x-target-head="t021" x-head="true" lemma="נוּד" strong="H5110" x-morph="Vqv2fs" x-gloss="take.flight" x-translit="**nûḏî" xml:lang="hbo">נ֝֗וּדִי</char> <char style="w" x-id="WLC.PSA.11.1.015" x-align="PSA.11.1.a017" x-target-ids="t025 t027" x-target="to mountain" x-target-head="t027" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmsc" x-gloss="mountain" x-translit="har" xml:lang="hbo">הַרְ</char><char style="w" x-id="WLC.PSA.11.1.016" x-align="PSA.11.1.a018" x-target-ids="t026" x-target="your" x-target-head="t026" x-head="true" lemma="הוּא" strong="H3641