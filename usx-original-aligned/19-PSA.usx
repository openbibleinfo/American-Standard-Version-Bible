	<para style="p"><verse number="30" style="v" x-ref="PSA.22.30" x-added-alignments="PSA.22.30.a010" x-added-target-ids="t015" x-added-target="next" sid="PSA 22:30" /><char style="w" x-id="WLC.PSA.22.30.001" x-align="PSA.22.30.a001" x-target-ids="t001 t002" x-target="A seed" x-target-head="t002" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsa" x-gloss="offspring" x-translit="zeraʿ" xml:lang="hbo" x-source-ref="PSA.22.31">זֶ֥רַע</char> <char style="w" x-id="WLC.PSA.22.30.002" x-align="PSA.22.30.a002" x-target-ids="t003 t004" x-target="shall serve" x-target-head="t004" x-head="true" lemma="עָבַד" strong="H5647" x-morph="Vqi3ms" x-gloss="it" x-translit="yaʿaḇḏ" xml:lang="hbo" x-source-ref="PSA.22.31">יַֽעַבְדֶ֑</char><char style="w" x-id="WLC.PSA.22.30.003" x-align="PSA.22.30.a003" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="will.serve.him" x-translit="ennû" xml:lang="hbo" x-source-ref="PSA.22.31">נּוּ</char> <char style="w" x-id="WLC.PSA.22.30.004" x-align="PSA.22.30.a004" x-target-ids="t006 t007 t008 t009" x-target="It shall be told" x-target-head="t009" x-head="true" lemma="סָפַר" strong="H5608" x-morph="VPi3ms" x-gloss="it.will.be.recounted" x-translit="yəsuppar" xml:lang="hbo" x-source-ref="PSA.22.31">יְסֻפַּ֖ר</char> <char style="w" x-id="WLC.PSA.22.30.005" x-align="PSA.22.30.a005" x-target-ids="t010" x-target="of" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="la" xml:lang="hbo" x-source-ref="PSA.22.31">לַֽ</char><char style="w" x-id="WLC.PSA.22.30.006" x-align="PSA.22.30.a006" x-target-ids="t011 t012" x-target="the Lord" x-target-head="t012" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="[the]" x-translit="ʾḏōn" xml:lang="hbo" x-source-ref="PSA.22.31">אדֹנָ֣</char><char style="w" x-id="WLC.PSA.22.30.007" x-align="PSA.22.30.a007" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-mor