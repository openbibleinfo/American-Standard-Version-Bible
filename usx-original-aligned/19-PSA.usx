	<para style="p"><verse number="32" style="v" x-ref="PSA.69.32" x-added-alignments="PSA.69.32.a003 PSA.69.32.a004" x-added-target-ids="t005 t006" x-added-target="it | and" sid="PSA 69:32" /><char style="w" x-id="WLC.PSA.69.32.001" x-align="PSA.69.32.a002" x-target-ids="t003 t004" x-target="have seen" x-target-head="t004" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp3cp" x-gloss="they.will.see" x-translit="rāʾû" xml:lang="hbo" x-source-ref="PSA.69.33">רָא֣וּ</char> <char style="w" x-id="WLC.PSA.69.32.002" x-align="PSA.69.32.a001" x-target-ids="t001 t002" x-target="The meek" x-target-head="t002" x-head="true" lemma="עָנָו" strong="H6035" x-morph="Aampa" x-gloss="humble.[people]" x-translit="ʿănāwiym" xml:lang="hbo" x-source-ref="PSA.69.33">עֲנָוִ֣ים</char> <char style="w" x-id="WLC.PSA.69.32.003" x-align="PSA.69.32.a005" x-target-ids="t007 t008" x-target="are glad" x-target-head="t008" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3mp" x-gloss="they.will.rejoice" x-translit="yiśmāḥû" xml:lang="hbo" x-source-ref="PSA.69.33">יִשְׂמָ֑חוּ</char> <char style="w" x-id="WLC.PSA.69.32.004" x-align="PSA.69.32.a006" x-target-ids="t009 t010 t011 t012" x-target="Ye that seek after" x-target-head="t011" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqrmpc" x-gloss="O.[you.who].seek" x-translit="dōrəšēy" xml:lang="hbo" x-source-ref="PSA.69.33">דֹּרְשֵׁ֥י</char> <char style="w" x-id="WLC.PSA.69.32.005" x-align="PSA.69.32.a007" x-target-ids="t013" x-target="God" x-target-head="t013" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="(of).God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.69.33">אֱ֝לֹהִ֗ים</char> <char style="w" x-id="WLC.PSA.69.32.006" x-align="PSA.69.32.a008" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo" x-source-ref="PSA.69.33">וִ</char><char style="w" x-id="WLC.PSA.69.32.007" x-align="PSA.69.32.a009" x-target-ids="t014 t017" x-target