	<para style="d" x-ref="PSA.70.0" x-added-alignments="PSA.70.0.a004" x-added-target-ids="t005 t006" x-added-target="A Psalm"><char style="w" x-id="WLC.PSA.70.0.001" x-align="PSA.70.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.70.1">לַ֝</char><char style="w" x-id="WLC.PSA.70.0.002" x-align="PSA.70.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.70.1">[הַ]</char><char style="w" x-id="WLC.PSA.70.0.003" x-align="PSA.70.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.70.1">מְנַצֵּ֗חַ</char> <char style="w" x-id="WLC.PSA.70.0.004" x-align="PSA.70.0.a005" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.70.1">לְ</char><char style="w" x-id="WLC.PSA.70.0.005" x-align="PSA.70.0.a006" x-target-ids="t008" x-target="David" x-target-head="t008" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo" x-source-ref="PSA.70.1">דָוִ֥ד</char> <char style="w" x-id="WLC.PSA.70.0.006" x-align="PSA.70.0.a007" x-target-ids="t009" x-target="to" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.70.1">לְ</char><char style="w" x-id="WLC.PSA.70.0.007" x-align="PSA.70.0.a008" x-target-ids="t010 t011 t012" x-target="bring to remembrance" x-target-head="t012" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vhc" x-gloss="make.remembrance" x-translit="hazkiyr:" xml:lang="hbo" x-source-ref="PSA.70.1">הַזְכִּֽיר</