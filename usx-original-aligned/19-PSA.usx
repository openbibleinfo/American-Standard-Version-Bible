	<para style="p"><verse number="3" style="v" x-ref="PSA.85.3" sid="PSA 85:3" /><char style="w" x-id="WLC.PSA.85.3.001" x-align="PSA.85.3.a001" x-target-ids="t001 t002 t003 t004" x-target="Thou hast taken away" x-target-head="t003" x-head="true" lemma="אָסַף" strong="H622" x-morph="Vqp2ms" x-gloss="you.withdrew" x-translit="ʾāsap̄ətā" xml:lang="hbo" x-source-ref="PSA.85.4">אָסַ֥פְתָּ</char> <char style="w" x-id="WLC.PSA.85.3.002" x-align="PSA.85.3.a002" x-target-ids="t005" x-target="all" x-target-head="t005" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.85.4">כָל</char>־<char style="w" x-id="WLC.PSA.85.3.003" x-align="PSA.85.3.a004" x-target-ids="t007" x-target="wrath" x-target-head="t007" x-head="true" lemma="עֶבְרָה" strong="H5678" x-morph="Ncfsc" x-gloss="fury" x-translit="ʿeḇrāṯ" xml:lang="hbo" x-source-ref="PSA.85.4">עֶבְרָתֶ֑</char><char style="w" x-id="WLC.PSA.85.3.004" x-align="PSA.85.3.a003" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.85.4">ךָ</char> <char style="w" x-id="WLC.PSA.85.3.005" x-align="PSA.85.3.a005" x-target-ids="t008 t009 t010 t011" x-target="Thou hast turned thyself" x-target-italic-ids="t011" x-target-head="t010" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhp2ms" x-gloss="you.turned.back" x-translit="hĕšîḇôṯā" xml:lang="hbo" x-source-ref="PSA.85.4">הֱ֝שִׁיב֗וֹתָ</char> <char style="w" x-id="WLC.PSA.85.3.006" x-align="PSA.85.3.a006" x-target-ids="t012" x-target="from" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.85.4">מֵ</char><char style="w" x-id="WLC.PSA.85.3.007" x-align="PSA.85.3.a007" x-target-ids="t013 t014" x-target="the fierceness" x-target-head="t014" x-head="true" lemma="חָרוֹן" strong="H2740" x-morph="Ncmsc" x-gloss="the.b