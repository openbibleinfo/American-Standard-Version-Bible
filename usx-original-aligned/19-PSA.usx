	<para style="p"><verse number="7" style="v" x-ref="PSA.63.7" sid="PSA 63:7" /><char style="w" x-id="WLC.PSA.63.7.001" x-align="PSA.63.7.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.63.8">כִּֽי</char>־<char style="w" x-id="WLC.PSA.63.7.002" x-align="PSA.63.7.a002" x-target-ids="t002 t003 t004" x-target="thou hast been" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp2ms" x-gloss="you.are" x-translit="hāyiyṯā" xml:lang="hbo" x-source-ref="PSA.63.8">הָיִ֣יתָ</char> <char style="w" x-id="WLC.PSA.63.7.003" x-align="PSA.63.7.a003" x-target-ids="t006" x-target="help" x-target-head="t006" x-head="true" lemma="עֶזְרָה" strong="H5833" x-morph="Ncfsc" x-gloss="help" x-translit="ʿezrāṯ" xml:lang="hbo" x-source-ref="PSA.63.8">עֶזְרָ֣תָ</char><char style="w" x-id="WLC.PSA.63.7.004" x-align="PSA.63.7.a004" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886c" x-morph="Sh" x-gloss="(to).a" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.63.8">ה</char> <char style="w" x-id="WLC.PSA.63.7.005" x-align="PSA.63.7.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-translit="ll" xml:lang="hbo" x-source-ref="PSA.63.8">לִּ֑</char><char style="w" x-id="WLC.PSA.63.7.006" x-align="PSA.63.7.a006" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.63.8">י</char> <char style="w" x-id="WLC.PSA.63.7.007" x-align="PSA.63.7.a007" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.63.8">וּ</char><char style="w" x-id="WLC.PSA.63.7.008" x-align="PSA.63.7.a008" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a"