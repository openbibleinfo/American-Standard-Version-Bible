	<para style="p"><verse number="16" style="v" x-ref="PSA.49.16" sid="PSA 49:16" /><char style="w" x-id="WLC.PSA.49.16.001" x-align="PSA.49.16.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.49.17">אַל</char>־<char style="w" x-id="WLC.PSA.49.16.002" x-align="PSA.49.16.a002" x-target-ids="t001 t003 t004" x-target="Be thou afraid" x-target-head="t004" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqj2ms" x-gloss="fear" x-translit="tîrāʾ" xml:lang="hbo" x-source-ref="PSA.49.17">תִּ֭ירָא</char> <char style="w" x-id="WLC.PSA.49.16.003" x-align="PSA.49.16.a003" x-target-ids="t005" x-target="when" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.49.17">כִּֽי</char>־<char style="w" x-id="WLC.PSA.49.16.004" x-align="PSA.49.16.a004" x-target-ids="t007 t008 t009" x-target="is made rich" x-target-head="t009" x-head="true" lemma="עָשַׁר" strong="H6238" x-morph="Vhi3ms" x-gloss="he.will.become.rich" x-translit="yaʿăšir" xml:lang="hbo" x-source-ref="PSA.49.17">יַעֲשִׁ֣ר</char> <char style="w" x-id="WLC.PSA.49.16.005" x-align="PSA.49.16.a005" x-target-ids="t006" x-target="one" x-target-head="t006" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾiyš" xml:lang="hbo" x-source-ref="PSA.49.17">אִ֑ישׁ</char> <char style="w" x-id="WLC.PSA.49.16.006" x-align="PSA.49.16.a006" x-target-ids="t010" x-target="When" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.49.17">כִּֽי</char>־<char style="w" x-id="WLC.PSA.49.16.007" x-align="PSA.49.16.a007" x-target-ids="t016 t017" x-target="is increased" x-target-head="t017" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vqi3ms" x-gloss="it.will.increase" x-translit="yirbeh" xml:lang="hbo" x