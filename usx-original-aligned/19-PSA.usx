	<para style="p"><verse number="4" style="v" x-ref="PSA.104.4" sid="PSA 104:4" /><char style="w" x-id="WLC.PSA.104.4.001" x-align="PSA.104.4.a001" x-target-ids="t001 t002" x-target="Who maketh" x-target-head="t002" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsa" x-gloss="[he.is].making" x-translit="ʿōśeh" xml:lang="hbo">עֹשֶׂ֣ה</char> <char style="w" x-id="WLC.PSA.104.4.002" x-align="PSA.104.4.a002" x-target-ids="t005" x-target="messengers" x-target-head="t005" x-head="true" lemma="מַלְאָךְ" strong="H4397" x-morph="Ncmpc" x-gloss="messengers" x-translit="malʾāḵāy" xml:lang="hbo">מַלְאָכָ֣י</char><char style="w" x-id="WLC.PSA.104.4.003" x-align="PSA.104.4.a003" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.104.4.004" x-align="PSA.104.4.a004" x-target-ids="t003" x-target="winds" x-target-head="t003" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbpa" x-gloss="winds" x-translit="rûḥôṯ" xml:lang="hbo">רוּח֑וֹת</char> <char style="w" x-id="WLC.PSA.104.4.005" x-align="PSA.104.4.a005" x-target-ids="t010" x-target="ministers" x-target-head="t010" x-head="true" lemma="שָׁרַת" strong="H8334" x-morph="Vprmpc" x-gloss="servants" x-translit="məšārəṯāy" xml:lang="hbo">מְ֝שָׁרְתָ֗י</char><char style="w" x-id="WLC.PSA.104.4.006" x-align="PSA.104.4.a006" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.104.4.007" x-align="PSA.104.4.a007" x-target-ids="t007 t008" x-target="of fire" x-target-head="t008" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsa" x-gloss="a.fire" x-translit="ʾēš" xml:lang="hbo">אֵ֣שׁ</char> <char style="w" x-id="WLC.PSA.104.4.008" x-align="PSA.104.4.a008" x-target-ids="t006" x-target="Flames" x-target-head="t006" x-head="true" lemma="לָהַט"