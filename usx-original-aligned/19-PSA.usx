	<para style="p"><verse number="32" style="v" x-ref="PSA.89.32" sid="PSA 89:32" /><char style="w" x-id="WLC.PSA.89.32.001" x-align="PSA.89.32.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.89.33">וּ</char><char style="w" x-id="WLC.PSA.89.32.002" x-align="PSA.89.32.a002" x-target-ids="t002 t003 t004" x-target="will I visit" x-target-head="t004" x-head="true" lemma="פָּקַד" strong="H6485" x-morph="Vqq1cs" x-gloss="I.will.punish" x-translit="p̄āqaḏtiy" xml:lang="hbo" x-source-ref="PSA.89.33">פָקַדְתִּ֣י</char> <char style="w" x-id="WLC.PSA.89.32.003" x-align="PSA.89.32.a003" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.89.33">בְ</char><char style="w" x-id="WLC.PSA.89.32.004" x-align="PSA.89.32.a004" x-target-ids="t008 t009" x-target="the rod" x-target-head="t009" x-head="true" lemma="שֵׁבֶט" strong="H7626" x-morph="Ncmsa" x-gloss="a.rod" x-translit="šēḇeṭ" xml:lang="hbo" x-source-ref="PSA.89.33">שֵׁ֣בֶט</char> <char style="w" x-id="WLC.PSA.89.32.005" x-align="PSA.89.32.a005" x-target-ids="t006" x-target="transgression" x-target-head="t006" x-head="true" lemma="פֶּשַׁע" strong="H6588" x-morph="Ncmsc" x-gloss="transgression" x-translit="pišʿ" xml:lang="hbo" x-source-ref="PSA.89.33">פִּשְׁעָ֑</char><char style="w" x-id="WLC.PSA.89.32.006" x-align="PSA.89.32.a006" x-target-ids="t005" x-target="their" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="PSA.89.33">ם</char> <char style="w" x-id="WLC.PSA.89.32.007" x-align="PSA.89.32.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.89.33">וּ</char><char style