	<para style="p"><verse number="6" style="v" x-ref="PSA.150.6" x-added-alignments="PSA.150.6.a004" x-added-target-ids="t003 t004" x-added-target="that hath" sid="PSA 150:6" /><char style="w" x-id="WLC.PSA.150.6.001" x-align="PSA.150.6.a001" x-target-ids="t002" x-target="everything" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kōl" xml:lang="hbo">כֹּ֣ל</char> <char style="w" x-id="WLC.PSA.150.6.002" x-align="PSA.150.6.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the).breathing" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PSA.150.6.003" x-align="PSA.150.6.a003" x-target-ids="t005" x-target="breath" x-target-head="t005" x-head="true" lemma="נְשָׁמָה" strong="H5397" x-morph="Ncfsa" x-gloss="thing" x-translit="nnəšāmâ" xml:lang="hbo">נְּשָׁמָה</char> <char style="w" x-id="WLC.PSA.150.6.004" x-align="PSA.150.6.a005" x-target-ids="t001 t006" x-target="Let praise" x-target-head="t006" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpi3fs" x-gloss="let.it.praise" x-translit="təhallēl" xml:lang="hbo">תְּהַלֵּ֥ל</char> <char style="w" x-id="WLC.PSA.150.6.005" x-align="PSA.150.6.a006" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יָהּ" strong="H3050" x-morph="Np" x-gloss="Yahweh" x-translit="yāẖ" xml:lang="hbo">יָ֗הּ</char> <char style="w" x-id="WLC.PSA.150.6.006" x-align="PSA.150.6.a007" x-target-ids="t008 t009" x-target="Praise ye" x-target-head="t008" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpv2mp" x-gloss="praise" x-translit="haləlû-" xml:lang="hbo">הַֽלְלוּ</char>־<char style="w" x-id="WLC.PSA.150.6.007" x-align="PSA.150.6.a008" x-target-ids="t010" x-target="Jehovah" x-target-head="t010" x-head="true" lemma="יָהּ" strong="H3050" x-morph="Np" x-gloss="Yahweh" x-translit="yāẖ:" xml:lang="hbo">יָֽהּ</char>׃<verse eid="PSA 150:6" /></para>
