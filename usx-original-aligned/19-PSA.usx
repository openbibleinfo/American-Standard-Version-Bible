	<para style="p"><verse number="28" style="v" x-ref="PSA.102.28" sid="PSA 102:28" /><char style="w" x-id="WLC.PSA.102.28.001" x-align="PSA.102.28.a001" x-target-ids="t001 t002" x-target="The children" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.children" x-translit="bənēy-" xml:lang="hbo" x-source-ref="PSA.102.29">בְּנֵֽי</char>־<char style="w" x-id="WLC.PSA.102.28.002" x-align="PSA.102.28.a002" x-target-ids="t003 t005" x-target="of servants" x-target-head="t005" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmpc" x-gloss="your.servants" x-translit="ʿăḇāḏey" xml:lang="hbo" x-source-ref="PSA.102.29">עֲבָדֶ֥י</char><char style="w" x-id="WLC.PSA.102.28.003" x-align="PSA.102.28.a003" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.102.29">ךָ</char> <char style="w" x-id="WLC.PSA.102.28.004" x-align="PSA.102.28.a004" x-target-ids="t006 t007" x-target="shall continue" x-target-head="t007" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqi3mp" x-gloss="they.will.dwell" x-translit="yiškônû" xml:lang="hbo" x-source-ref="PSA.102.29">יִשְׁכּ֑וֹנוּ</char> <char style="w" x-id="WLC.PSA.102.28.005" x-align="PSA.102.28.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.102.29">וְ֝</char><char style="w" x-id="WLC.PSA.102.28.006" x-align="PSA.102.28.a006" x-target-ids="t010" x-target="seed" x-target-head="t010" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsc" x-gloss="offspring" x-translit="zarʿ" xml:lang="hbo" x-source-ref="PSA.102.29">זַרְעָ֗</char><char style="w" x-id="WLC.PSA.102.28.007" x-align="PSA.102.28.a007" x-target-ids="t009" x-target="their" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ā