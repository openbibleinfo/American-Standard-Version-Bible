	<para style="p"><verse number="10" style="v" x-ref="PSA.36.10" sid="PSA 36:10" /><char style="w" x-id="WLC.PSA.36.10.001" x-align="PSA.36.10.a001" x-target-ids="t001 t002" x-target="Oh continue" x-target-head="t002" x-head="true" lemma="מָשַׁךְ" strong="H4900" x-morph="Vqv2ms" x-gloss="prolong" x-translit="məšōḵ" xml:lang="hbo" x-source-ref="PSA.36.11">מְשֹׁ֣ךְ</char> <char style="w" x-id="WLC.PSA.36.10.002" x-align="PSA.36.10.a003" x-target-ids="t004" x-target="lovingkindness" x-target-head="t004" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo" x-source-ref="PSA.36.11">חַ֭סְדְּ</char><char style="w" x-id="WLC.PSA.36.10.003" x-align="PSA.36.10.a002" x-target-ids="t003" x-target="thy" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.covenant" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.36.11">ךָ</char> <char style="w" x-id="WLC.PSA.36.10.004" x-align="PSA.36.10.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.36.11">לְ</char><char style="w" x-id="WLC.PSA.36.10.005" x-align="PSA.36.10.a005" x-target-ids="t006 t007 t008" x-target="them that know" x-target-head="t008" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqrmpc" x-gloss="[those" x-translit="yōḏəʿey" xml:lang="hbo" x-source-ref="PSA.36.11">יֹדְעֶ֑י</char><char style="w" x-id="WLC.PSA.36.10.006" x-align="PSA.36.10.a006" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="who].know.you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.36.11">ךָ</char> <char style="w" x-id="WLC.PSA.36.10.007" x-align="PSA.36.10.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.36.11">וְ֝</c