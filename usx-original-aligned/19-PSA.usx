	<para style="p"><verse number="29" style="v" x-ref="PSA.37.29" sid="PSA 37:29" /><char style="w" x-id="WLC.PSA.37.29.001" x-align="PSA.37.29.a001" x-target-ids="t001 t002" x-target="The righteous" x-target-head="t002" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַדִּיקִ֥ים</char> <char style="w" x-id="WLC.PSA.37.29.002" x-align="PSA.37.29.a002" x-target-ids="t003 t004" x-target="shall inherit" x-target-head="t004" x-head="true" lemma="יָרַשׁ" strong="H3423" x-morph="Vqi3mp" x-gloss="they.will.possess" x-translit="yiyrəšû-" xml:lang="hbo">יִֽירְשׁוּ</char>־<char style="w" x-id="WLC.PSA.37.29.003" x-align="PSA.37.29.a003" x-target-ids="t005 t006" x-target="the land" x-target-head="t006" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].land" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.PSA.37.29.004" x-align="PSA.37.29.a004" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.37.29.005" x-align="PSA.37.29.a005" x-target-ids="t008" x-target="dwell" x-target-head="t008" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqi3mp" x-gloss="they.will.dwell" x-translit="yiškənû" xml:lang="hbo">יִשְׁכְּנ֖וּ</char> <char style="w" x-id="WLC.PSA.37.29.006" x-align="PSA.37.29.a006" x-target-ids="t010" x-target="for" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PSA.37.29.007" x-align="PSA.37.29.a007" x-target-ids="t011" x-target="ever" x-target-head="t011" x-head="true" lemma="עַד" strong="H5703" x-morph="Ncmsa" x-translit="ʿaḏ" xml:lang="hbo">עַ֣ד</char> <char style="w" x-id="WLC.PSA.37.29.008" x-align="PSA.37.29.a008" x-target-ids="t009" x-target="therein" x-target-head="t009" x-head="true" l