	<para style="p"><verse number="16" style="v" x-ref="PSA.40.16" sid="PSA 40:16" /><char style="w" x-id="WLC.PSA.40.16.001" x-align="PSA.40.16.a001" x-target-ids="t001 t007" x-target="Let rejoice" x-target-head="t007" x-head="true" lemma="שׂוּשׂ" strong="H7797" x-morph="Vqi3mp" x-gloss="may.they.exult" x-translit="yāśiyśû" xml:lang="hbo" x-source-ref="PSA.40.17">יָ֘שִׂ֤ישׂוּ</char> <char style="w" x-id="WLC.PSA.40.16.002" x-align="PSA.40.16.a002" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.40.17">וְ</char><char style="w" x-id="WLC.PSA.40.16.003" x-align="PSA.40.16.a003" x-target-ids="t009 t010" x-target="be glad" x-target-head="t010" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3mp" x-gloss="may.they.rejoice" x-translit="yiśməḥû" xml:lang="hbo" x-source-ref="PSA.40.17">יִשְׂמְח֨וּ</char>׀<char style="w" x-id="WLC.PSA.40.16.004" x-align="PSA.40.16.a004" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="b" xml:lang="hbo" x-source-ref="PSA.40.17">בְּ</char><char style="w" x-id="WLC.PSA.40.16.005" x-align="PSA.40.16.a005" x-target-ids="t012" x-target="thee" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.40.17">ךָ֗</char> <char style="w" x-id="WLC.PSA.40.16.006" x-align="PSA.40.16.a006" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kāl-" xml:lang="hbo" x-source-ref="PSA.40.17">כָּֽל</char>־<char style="w" x-id="WLC.PSA.40.16.007" x-align="PSA.40.16.a007" x-target-ids="t003 t004 t005" x-target="those that seek" x-target-head="t005" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vprmpc" x-gloss="[those" x-translit="məḇaqšey" xml:lang="hbo" x-source-ref="PSA.40.1