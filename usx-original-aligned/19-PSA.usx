	<para style="p"><verse number="5" style="v" x-ref="PSA.79.5" sid="PSA 79:5" /><char style="w" x-id="WLC.PSA.79.5.001" x-align="PSA.79.5.a002" x-target-ids="t002" x-target="long" x-target-head="t002" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PSA.79.5.002" x-align="PSA.79.5.a001" x-target-ids="t001" x-target="How" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="when?" x-translit="māh" xml:lang="hbo">מָ֣ה</char> <char style="w" x-id="WLC.PSA.79.5.003" x-align="PSA.79.5.a003" x-target-ids="t003 t004" x-target="O Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.79.5.004" x-align="PSA.79.5.a004" x-target-ids="t005 t006 t007 t008" x-target="wilt thou be angry" x-target-head="t008" x-head="true" lemma="אָנַף" strong="H599" x-morph="Vqi2ms" x-gloss="will.you.be.angry?" x-translit="teʾĕnap̄" xml:lang="hbo">תֶּאֱנַ֣ף</char> <char style="w" x-id="WLC.PSA.79.5.005" x-align="PSA.79.5.a005" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PSA.79.5.006" x-align="PSA.79.5.a006" x-target-ids="t010" x-target="ever" x-target-head="t010" x-head="true" lemma="נֵצַח" strong="H5331" x-morph="Ncmsa" x-gloss="perpetuity" x-translit="neṣaḥ" xml:lang="hbo">נֶ֑צַח</char> <char style="w" x-id="WLC.PSA.79.5.007" x-align="PSA.79.5.a007" x-target-ids="t011 t014" x-target="Shall burn" x-target-head="t014" x-head="true" lemma="בָּעַר" strong="H1197" x-morph="Vqi3fs" x-gloss="will.it.burn?" x-translit="tiḇʿar" xml:lang="hbo">תִּבְעַ֥ר</char> <char style="w" x-id="WLC.PSA.79.5.008" x-align="PSA.79.5.a010" x-target-ids="t015" x-target="like" x-target-head="t015" x-head="true" lemma="כְּמוֹ" strong="H3644"