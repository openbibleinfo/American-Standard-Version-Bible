	<para style="p"><verse number="2" style="v" x-ref="PSA.86.2" sid="PSA 86:2" /><char style="w" x-id="WLC.PSA.86.2.001" x-align="PSA.86.2.a001" x-target-ids="t001" x-target="Preserve" x-target-head="t001" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqv2ms" x-gloss="preserve" x-translit="šāmər" xml:lang="hbo">שָֽׁמְרָ֣</char><char style="w" x-id="WLC.PSA.86.2.002" x-align="PSA.86.2.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PSA.86.2.003" x-align="PSA.86.2.a003" x-target-ids="t003" x-target="soul" x-target-head="t003" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="life" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ</char><char style="w" x-id="WLC.PSA.86.2.004" x-align="PSA.86.2.a004" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י֮</char> <char style="w" x-id="WLC.PSA.86.2.005" x-align="PSA.86.2.a005" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.86.2.006" x-align="PSA.86.2.a006" x-target-ids="t006 t007" x-target="am godly" x-target-head="t007" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aamsa" x-gloss="[am].faithful" x-translit="ḥāsiyḏ" xml:lang="hbo">חָסִ֪יד</char> <char style="w" x-id="WLC.PSA.86.2.007" x-align="PSA.86.2.a007" x-target-ids="t005" x-target="I" x-target-head="t005" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānî" xml:lang="hbo">אָ֥נִי</char> <char style="w" x-id="WLC.PSA.86.2.008" x-align="PSA.86.2.a008" x-target-ids="t012" x-target="save" x-target-head="t012" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="Vhv2ms" x-gloss="save" x-translit="hôšaʿ" xml:lang="hbo">הוֹשַׁ֣ע</char> <char style="w" x-id="WLC.P