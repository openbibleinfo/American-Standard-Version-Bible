	<para style="p"><verse number="9" style="v" x-ref="PSA.80.9" sid="PSA 80:9" /><char style="w" x-id="WLC.PSA.80.9.001" x-align="PSA.80.9.a001" x-target-ids="t001 t002 t003" x-target="Thou preparedst room" x-target-italic-ids="t003" x-target-head="t002" x-head="true" lemma="פָּנָה" strong="H6437" x-morph="Vpp2ms" x-gloss="you.made.clear" x-translit="pinniyṯā" xml:lang="hbo" x-source-ref="PSA.80.10">פִּנִּ֥יתָ</char> <char style="w" x-id="WLC.PSA.80.9.002" x-align="PSA.80.9.a002" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.80.10">לְ</char><char style="w" x-id="WLC.PSA.80.9.003" x-align="PSA.80.9.a002" x-target-ids="t004" x-target="before" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄āney" xml:lang="hbo" x-source-ref="PSA.80.10">פָנֶ֑י</char><char style="w" x-id="WLC.PSA.80.9.004" x-align="PSA.80.9.a003" x-target-ids="t005" x-target="it" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="it" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.80.10">הָ</char> <char style="w" x-id="WLC.PSA.80.9.005" x-align="PSA.80.9.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.80.10">וַ</char><char style="w" x-id="WLC.PSA.80.9.006" x-align="PSA.80.9.a005" x-target-ids="t007 t008" x-target="it took" x-target-head="t008" x-head="true" lemma="שָׁרַשׁ" strong="H8327" x-morph="Vhw3fs" x-gloss="it.took.root" x-translit="tašrēš" xml:lang="hbo" x-source-ref="PSA.80.10">תַּשְׁרֵ֥שׁ</char> <char style="w" x-id="WLC.PSA.80.9.007" x-align="PSA.80.9.a006" x-target-ids="t009 t010" x-target="deep root" x-target-head="t010" x-head="true" lemma="שֹׁרֶשׁ" strong="H8328" x-morph="Ncmpc" x-gloss="roots" x-translit="šārāšey" xml:lang="hbo" x-source-ref="PSA.80.10">שָׁ֝רָשֶׁ֗י</char><char style="w" x-id="WLC.PSA.80.9.008" x-align="PS