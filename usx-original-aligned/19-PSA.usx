	<para style="p"><verse number="4" style="v" x-ref="PSA.149.4" sid="PSA 149:4" /><char style="w" x-id="WLC.PSA.149.4.001" x-align="PSA.149.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.149.4.002" x-align="PSA.149.4.a002" x-target-ids="t003 t004" x-target="taketh pleasure" x-target-head="t004" x-head="true" lemma="רָצָה" strong="H7521" x-morph="Vqrmsa" x-gloss="[is].taking.pleasure" x-translit="rôṣeh" xml:lang="hbo">רוֹצֶ֣ה</char> <char style="w" x-id="WLC.PSA.149.4.003" x-align="PSA.149.4.a003" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.149.4.004" x-align="PSA.149.4.a004" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.149.4.005" x-align="PSA.149.4.a005" x-target-ids="t007" x-target="people" x-target-head="t007" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo">עַמּ֑</char><char style="w" x-id="WLC.PSA.149.4.006" x-align="PSA.149.4.a006" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.149.4.007" x-align="PSA.149.4.a007" x-target-ids="t008 t009 t010" x-target="He will beautify" x-target-head="t010" x-head="true" lemma="פָּאַר" strong="H6286" x-morph="Vpi3ms" x-gloss="he.glorifies" x-translit="yəp̄āʾēr" xml:lang="hbo">יְפָאֵ֥ר</char> <char style="w" x-id="WLC.PSA.149.4.008" x-align="PSA.149.4.a008" x-target-ids="t011 t012" x-target="the meek" x-target-head="t012" x-head="true" lemma="עָנָו" strong