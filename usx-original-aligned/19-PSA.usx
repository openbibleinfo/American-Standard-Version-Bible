	<para style="p"><verse number="11" style="v" x-ref="PSA.73.11" sid="PSA 73:11" /><char style="w" x-id="WLC.PSA.73.11.001" x-align="PSA.73.11.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.73.11.002" x-align="PSA.73.11.a002" x-target-ids="t002 t003" x-target="they say" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3cp" x-gloss="they.say" x-translit="ʾāmərû" xml:lang="hbo">אָמְר֗וּ</char> <char style="w" x-id="WLC.PSA.73.11.003" x-align="PSA.73.11.a003" x-target-ids="t004" x-target="How" x-target-head="t004" x-head="true" lemma="אֵיכָה" strong="H349a" x-morph="Ti" x-gloss="how?" x-translit="ʾêḵāh" xml:lang="hbo">אֵיכָ֥ה</char> <char style="w" x-id="WLC.PSA.73.11.004" x-align="PSA.73.11.a004" x-target-ids="t005 t007" x-target="doth know" x-target-head="t007" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3ms" x-gloss="does.he.know" x-translit="yāḏaʿ-" xml:lang="hbo">יָדַֽע</char>־<char style="w" x-id="WLC.PSA.73.11.005" x-align="PSA.73.11.a005" x-target-ids="t006" x-target="God" x-target-head="t006" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֑ל</char> <char style="w" x-id="WLC.PSA.73.11.006" x-align="PSA.73.11.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.73.11.007" x-align="PSA.73.11.a007" x-target-ids="t009 t010" x-target="is there" x-target-head="t009" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there?" x-translit="yēš" xml:lang="hbo">יֵ֖שׁ</char> <char style="w" x-id="WLC.PSA.73.11.008" x-align="PSA.73.11.a008" x-target-ids="t011" x-target="knowledge" x-target-head="t011" x-head="true" lemma="דֵּעָה" strong="H1844" x-morph="Ncfsa" x-gloss="kno