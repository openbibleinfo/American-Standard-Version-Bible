	<para style="d" x-ref="PSA.52.0" x-added-alignments="PSA.52.0.a007" x-added-target-ids="t008 t009 t010 t011 t012 t013 t014 t015 t016 t017 t018 t019 t020 t021 t022 t023 t024 t025 t026 t027" x-added-target="when Doeg the Edomite came and told Saul and said unto him David is come to the house of Ahimelech"><char style="w" x-id="WLC.PSA.52.0.001" x-align="PSA.52.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.52.1">לַ</char><char style="w" x-id="WLC.PSA.52.0.002" x-align="PSA.52.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.52.1">[הַ]</char><char style="w" x-id="WLC.PSA.52.0.003" x-align="PSA.52.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.52.1">מְנַצֵּ֗חַ</char> <char style="w" x-id="WLC.PSA.52.0.004" x-align="PSA.52.0.a004" x-target-ids="t005" x-target="Maschil" x-target-head="t005" x-head="true" lemma="מַשְׂכִּיל" strong="H4905" x-morph="Ncmsa" x-gloss="a.poem" x-translit="maśkiyl" xml:lang="hbo" x-source-ref="PSA.52.1">מַשְׂכִּ֥יל</char> <char style="w" x-id="WLC.PSA.52.0.005" x-align="PSA.52.0.a005" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.52.1">לְ</char><char style="w" x-id="WLC.PSA.52.0.006" x-align="PSA.52.0.a006" x-target-ids="t007" x-target="David" x-target-head="t007" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ:" xml:lang="hbo" x-source-ref="PSA.52.1">דָוִֽד</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.52.1" sid="PSA 52:1" /><char style="w" x-id="WLC.PSA.52.1.001" x-align="PSA.52.1.a001" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.52.2">בְּ</char><char style="w" x-id="WLC.PSA.52.1.002" x-align="PSA.52.1.a002" x-status="unrepresented" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqc" x-gloss="came" x-translit="ḇôʾ" xml:lang="hbo" x-source-ref="PSA.52.2">ב֤וֹא</char>׀<char style="w" x-id="WLC.PSA.52.1.003" x-align="PSA.52.1.a003" x-status="unrepresented" x-head="true" lemma="דֹּאֵג" strong="H1673" x-morph="Np" x-gloss="Doeg" x-translit="dôʾēḡ" xml:lang="hbo" x-source-ref="PSA.52.2">דּוֹאֵ֣ג</char> <char style="w" x-id="WLC.PSA.52.1.004" x-align="PSA.52.1.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.52.2">הָ</char><char style="w" x-id="WLC.PSA.52.1.005" x-align="PSA.52.1.a005" x-status="unrepresented" x-head="true" lemma="אֲדֹמִי" strong="H130" x-morph="Ngmsa" x-gloss="Edomite" x-translit="ʾăḏōmî" xml:lang="hbo" x-source-ref="PSA.52.2">אֲדֹמִי֮</char> <char style="w" x-id="WLC.PSA.52.1.006" x-align="PSA.52.1.a006" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.52.2">וַ</char><char style="w" x-id="WLC.PSA.52.1.007" x-align="PSA.52.1.a007" x-status="unrepresented" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhw3ms" x-gloss="he.told" x-translit="yyaggēḏ" xml:lang="hbo" x-source-ref="PSA.52.2">יַּגֵּ֪ד</char> <char style="w" x-id="WLC.PSA.52.1.008" x-align="PSA.52.1.a008" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.52.2">לְ</char><char style="w" x-id="WLC.PSA.52.1.009" x-align="PSA.52.1.a009" x-status="unrepresented" x