	<chapter eid="PSA 60" />
	<chapter number="61" style="c" sid="PSA 61" />
	<para style="d" x-ref="PSA.61.0" x-added-alignments="PSA.61.0.a006" x-added-target-ids="t009 t010" x-added-target="A Psalm"><char style="w" x-id="WLC.PSA.61.0.001" x-align="PSA.61.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.61.1">לַ</char><char style="w" x-id="WLC.PSA.61.0.002" x-align="PSA.61.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.61.1">[הַ]</char><char style="w" x-id="WLC.PSA.61.0.003" x-align="PSA.61.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēḥa" xml:lang="hbo" x-source-ref="PSA.61.1">מְנַצֵּ֬חַ</char>׀<char style="w" x-id="WLC.PSA.61.0.004" x-align="PSA.61.0.a004" x-target-ids="t005" x-target="on" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.61.1">עַֽל</char>־<char style="w" x-id="WLC.PSA.61.0.005" x-align="PSA.61.0.a005" x-target-ids="t006 t007 t008" x-target="a stringed instrument" x-target-head="t007" x-head="true" lemma="נְגִינָה" strong="H5058" x-morph="Ncfsc" x-gloss="a.stringed.instrument" x-translit="nəḡînaṯ" xml:lang="hbo" x-source-ref="PSA.61.1">נְגִינַ֬ת</char> <char style="w" x-id="WLC.PSA.61.0.006" x-align="PSA.61.0.a007" x-target-ids="t011" x-target="of" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.61.1">לְ</char><char style="w" x-id="WLC.PSA.61.0.007" x-align="PSA.61.0.a008" x-target-ids="t012" x-target="David" x-target-head="t012" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ:" xml:lang="hbo" x-source-ref="PSA.