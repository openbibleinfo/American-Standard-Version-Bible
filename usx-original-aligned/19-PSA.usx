	<para style="p"><verse number="1" style="v" x-ref="PSA.70.1" sid="PSA 70:1" /><char style="w" x-id="WLC.PSA.70.1.001" x-align="PSA.70.1.a001" x-target-ids="t003 t004" x-target="O God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.70.2">אֱלֹהִ֥ים</char> <char style="w" x-id="WLC.PSA.70.1.002" x-align="PSA.70.1.a002" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.70.2">לְ</char><char style="w" x-id="WLC.PSA.70.1.003" x-align="PSA.70.1.a003" x-target-ids="t006" x-target="deliver" x-target-head="t006" x-head="true" lemma="נָצַל" strong="H5337" x-morph="Vhc" x-gloss="deliver" x-translit="haṣṣiyl" xml:lang="hbo" x-source-ref="PSA.70.2">הַצִּילֵ֑</char><char style="w" x-id="WLC.PSA.70.1.004" x-align="PSA.70.1.a004" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo" x-source-ref="PSA.70.2">נִי</char> <char style="w" x-id="WLC.PSA.70.1.005" x-align="PSA.70.1.a005" x-target-ids="t013 t014" x-target="O Jehovah" x-target-head="t014" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.70.2">יְ֝הוָ֗ה</char> <char style="w" x-id="WLC.PSA.70.1.006" x-align="PSA.70.1.a006" x-target-ids="t010" x-target="to" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.70.2">לְ</char><char style="w" x-id="WLC.PSA.70.1.007" x-align="PSA.70.1.a007" x-target-ids="t011" x-target="help" x-target-head="t011" x-head="true" lemma="עֶזְרָה" strong="H5833" x-morph="Ncfsc" x-gloss="help" x-translit="ʿezrāṯ" xml:lang="hbo" x-source-ref="PSA.70.2">עֶזְרָ֥תִ</char><char style="w" x-id="WLC.PSA.70.1.008" x-align="PSA.70