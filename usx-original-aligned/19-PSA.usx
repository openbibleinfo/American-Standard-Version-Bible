	<para style="p"><verse number="4" style="v" x-ref="PSA.15.4" sid="PSA 15:4" /><char style="w" x-id="WLC.PSA.15.4.001" x-align="PSA.15.4.a005" x-target-ids="t006 t007" x-target="is despised" x-target-head="t007" x-head="true" lemma="בָּזָה" strong="H959" x-morph="VNrmsa" x-gloss="[is].despised" x-translit="niḇzeh" xml:lang="hbo">נִבְזֶ֤ה</char>׀<char style="w" x-id="WLC.PSA.15.4.002" x-align="PSA.15.4.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּֽ</char><char style="w" x-id="WLC.PSA.15.4.003" x-align="PSA.15.4.a003" x-target-ids="t003" x-target="eyes" x-target-head="t003" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿēynāy" xml:lang="hbo">עֵ֘ינָ֤י</char><char style="w" x-id="WLC.PSA.15.4.004" x-align="PSA.15.4.a002" x-target-ids="t002" x-target="whose" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.15.4.005" x-align="PSA.15.4.a004" x-target-ids="t004 t005" x-target="a reprobate" x-target-head="t005" x-head="true" lemma="מָאַס" strong="H3988" x-morph="VNrmsa" x-gloss="a.rejected.[person]" x-translit="nimʾās" xml:lang="hbo">נִמְאָ֗ס</char> <char style="w" x-id="WLC.PSA.15.4.006" x-align="PSA.15.4.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.15.4.007" x-align="PSA.15.4.a008" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.15.4.008" x-align="PSA.15.4.a009" x-target-ids="t011 t012 t013" x-target="them that fear" x-target-head="t013" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aampc" x-gloss="[those].fearing" x-translit="yirʾēy"