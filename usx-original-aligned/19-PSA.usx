	<para style="p"><verse number="6" style="v" x-ref="PSA.112.6" sid="PSA 112:6" /><char style="w" x-id="WLC.PSA.112.6.001" x-align="PSA.112.6.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.112.6.002" x-align="PSA.112.6.a003" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.112.6.003" x-align="PSA.112.6.a003" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֥ם</char> <char style="w" x-id="WLC.PSA.112.6.004" x-align="PSA.112.6.a003" x-target-ids="t004" x-target="never" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.112.6.005" x-align="PSA.112.6.a002" x-target-ids="t002 t003 t005 t006" x-target="he shall be moved" x-target-head="t006" x-head="true" lemma="מוֹט" strong="H4131" x-morph="VNi3ms" x-gloss="he.will.be.shaken" x-translit="yimmôṭ" xml:lang="hbo">יִמּ֑וֹט</char> <char style="w" x-id="WLC.PSA.112.6.006" x-align="PSA.112.6.a006" x-target-ids="t011 t012" x-target="had in" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(into).a" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.112.6.007" x-align="PSA.112.6.a008" x-target-ids="t014" x-target="remembrance" x-target-head="t014" x-head="true" lemma="זֵכֶר" strong="H2143" x-morph="Ncmsc" x-gloss="remembrance" x-translit="zēḵer" xml:lang="hbo">זֵ֥כֶר</char> <char style="w" x-id="WLC.PSA.112.6.008" x-align="PSA.112.6.a007" x-target-ids="t013" x-target="everlasting" x-target-head="t013" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">ע֝וֹלָ֗ם</char> <char style="w" x-id="WLC.PSA.112.6.009" x-a