	<para style="p"><verse number="2" style="v" x-ref="PSA.87.2" sid="PSA 87:2" /><char style="w" x-id="WLC.PSA.87.2.001" x-align="PSA.87.2.a002" x-target-ids="t002" x-target="loveth" x-target-head="t002" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[is].loving" x-translit="ʾōhēḇ" xml:lang="hbo">אֹהֵ֣ב</char> <char style="w" x-id="WLC.PSA.87.2.002" x-align="PSA.87.2.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.87.2.003" x-align="PSA.87.2.a003" x-target-ids="t003 t004" x-target="the gates" x-target-head="t004" x-head="true" lemma="שַׁעַר" strong="H8179" x-morph="Ncmpc" x-gloss="the.gates" x-translit="šaʿărēy" xml:lang="hbo">שַׁעֲרֵ֣י</char> <char style="w" x-id="WLC.PSA.87.2.004" x-align="PSA.87.2.a004" x-target-ids="t005 t006" x-target="of Zion" x-target-head="t006" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="of.Zion" x-translit="ṣiyyôn" xml:lang="hbo">צִיּ֑וֹן</char> <char style="w" x-id="WLC.PSA.87.2.005" x-align="PSA.87.2.a005" x-target-ids="t007 t008" x-target="More than" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִ֝</char><char style="w" x-id="WLC.PSA.87.2.006" x-align="PSA.87.2.a006" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="than.all" x-translit="kōl" xml:lang="hbo">כֹּ֗ל</char> <char style="w" x-id="WLC.PSA.87.2.007" x-align="PSA.87.2.a007" x-target-ids="t010 t011" x-target="the dwellings" x-target-head="t011" x-head="true" lemma="מִשְׁכָּן" strong="H4908" x-morph="Ncmpc" x-gloss="the.dwelling.places" x-translit="miškənôṯ" xml:lang="hbo">מִשְׁכְּנ֥וֹת</char> <char style="w" x-id="WLC.PSA.87.2.008" x-align="PSA.87.2.a008" x-target-ids="t012 t013" x-target="of Jacob" x-target-head="t013" x-head=