	<para style="p"><verse number="17" style="v" x-ref="PSA.34.17" x-added-alignments="PSA.34.17.a001" x-added-target-ids="t001 t002" x-added-target="The righteous" sid="PSA 34:17" /><char style="w" x-id="WLC.PSA.34.17.001" x-align="PSA.34.17.a002" x-target-ids="t003" x-target="cried" x-target-head="t003" x-head="true" lemma="צָעַק" strong="H6817" x-morph="Vqp3cp" x-gloss="they.cry.out" x-translit="ṣāʿăqû" xml:lang="hbo" x-source-ref="PSA.34.18">צָעֲק֣וּ</char> <char style="w" x-id="WLC.PSA.34.17.002" x-align="PSA.34.17.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.34.18">וַ</char><char style="w" x-id="WLC.PSA.34.17.003" x-align="PSA.34.17.a004" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo" x-source-ref="PSA.34.18">יהוָ֣ה</char> <char style="w" x-id="WLC.PSA.34.17.004" x-align="PSA.34.17.a005" x-target-ids="t006" x-target="heard" x-target-head="t006" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp3ms" x-gloss="he.hears" x-translit="šāmēᵃʿ" xml:lang="hbo" x-source-ref="PSA.34.18">שָׁמֵ֑עַ</char> <char style="w" x-id="WLC.PSA.34.17.005" x-align="PSA.34.17.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.34.18">וּ</char><char style="w" x-id="WLC.PSA.34.17.006" x-align="PSA.34.17.a007" x-target-ids="t010 t011" x-target="out of" x-target-head="t010" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.34.18">מִ</char><char style="w" x-id="WLC.PSA.34.17.007" x-align="PSA.34.17.a008" x-target-ids="t012" x-target="all" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml: