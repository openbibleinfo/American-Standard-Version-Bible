	<para style="p"><verse number="2" style="v" x-ref="PSA.106.2" x-added-alignments="PSA.106.2.a005" x-added-target-ids="t009" x-added-target="Or" sid="PSA 106:2" /><char style="w" x-id="WLC.PSA.106.2.001" x-align="PSA.106.2.a001" x-target-ids="t001" x-target="Who" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo">מִ֗י</char> <char style="w" x-id="WLC.PSA.106.2.002" x-align="PSA.106.2.a002" x-target-ids="t002 t003" x-target="can utter" x-target-head="t003" x-head="true" lemma="מָלַל" strong="H4448" x-morph="Vpi3ms" x-gloss="will.he.utter" x-translit="yəmallēl" xml:lang="hbo">יְ֭מַלֵּל</char> <char style="w" x-id="WLC.PSA.106.2.003" x-align="PSA.106.2.a003" x-target-ids="t004 t005 t006" x-target="the mighty acts" x-target-head="t005" x-head="true" lemma="גְּבוּרָה" strong="H1369" x-morph="Ncfpc" x-gloss="the.mighty.deeds" x-translit="gəḇûrôṯ" xml:lang="hbo">גְּבוּר֣וֹת</char> <char style="w" x-id="WLC.PSA.106.2.004" x-align="PSA.106.2.a004" x-target-ids="t007 t008" x-target="of Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.106.2.005" x-align="PSA.106.2.a006" x-target-ids="t010 t011" x-target="show forth" x-target-head="t010" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vhi3ms" x-gloss="will.he.proclaim?" x-translit="yašmiyᵃʿ" xml:lang="hbo">יַ֝שְׁמִ֗יעַ</char> <char style="w" x-id="WLC.PSA.106.2.006" x-align="PSA.106.2.a007" x-target-ids="t012" x-target="all" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.106.2.007" x-align="PSA.106.2.a008" x-target-ids="t014" x-target="praise" x-target-head="t014" x-head="true" lemma="תְּהִלָּה" strong="H8416" x-morph="Ncfsc" x-gloss="praise" x-translit="təhillāṯ" xml:lang="hbo">תְּהִלָּתֽ</char><char