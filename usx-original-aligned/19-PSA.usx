	<para style="p"><verse number="3" style="v" x-ref="PSA.70.3" sid="PSA 70:3" /><char style="w" x-id="WLC.PSA.70.3.001" x-align="PSA.70.3.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="Let them be turned back" x-target-head="t004" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi3mp" x-gloss="may.they.turn.back" x-translit="yāšûḇû" xml:lang="hbo" x-source-ref="PSA.70.4">יָ֭שׁוּבוּ</char> <char style="w" x-id="WLC.PSA.70.3.002" x-align="PSA.70.3.a002" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.70.4">עַל</char>־<char style="w" x-id="WLC.PSA.70.3.003" x-align="PSA.70.3.a002" x-target-ids="t006 t007 t008" x-target="by reason of" x-target-head="t007" x-head="true" lemma="עֵקֶב" strong="H6118" x-morph="Ncmsc" x-gloss="the.consequence" x-translit="ʿēqeḇ" xml:lang="hbo" x-source-ref="PSA.70.4">עֵ֣קֶב</char> <char style="w" x-id="WLC.PSA.70.3.004" x-align="PSA.70.3.a003" x-target-ids="t010" x-target="shame" x-target-head="t010" x-head="true" lemma="בֹּשֶׁת" strong="H1322" x-morph="Ncfsc" x-gloss="their.shame" x-translit="bāšətt" xml:lang="hbo" x-source-ref="PSA.70.4">בָּשְׁתָּ֑</char><char style="w" x-id="WLC.PSA.70.3.005" x-align="PSA.70.3.a004" x-target-ids="t009" x-target="their" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="PSA.70.4">ם</char> <char style="w" x-id="WLC.PSA.70.3.006" x-align="PSA.70.3.a005" x-target-ids="t011" x-target="That" x-target-head="t011" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.70.4">הָ֝</char><char style="w" x-id="WLC.PSA.70.3.007" x-align="PSA.70.3.a006" x-target-ids="t012" x-target="say" x-target-head="t012" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqrmpa" x-gloss="who].say" x-translit="ʾōməriym" xml:lang="hbo" x-source-ref="PSA.70.4">אֹמְרִ֗ים</char> <char style="w" x-id="WLC.PSA.70.3.008" 