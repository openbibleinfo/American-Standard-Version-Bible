	<para style="p"><verse number="8" style="v" x-ref="PSA.112.8" x-added-alignments="PSA.112.8.a008" x-added-target-ids="t013 t014" x-added-target="his desire" sid="PSA 112:8" /><char style="w" x-id="WLC.PSA.112.8.001" x-align="PSA.112.8.a003" x-target-ids="t003 t004" x-target="is established" x-target-head="t004" x-head="true" lemma="סָמַךְ" strong="H5564" x-morph="Vqsmsa" x-gloss="[is].sustained" x-translit="sāmûḵ" xml:lang="hbo">סָמ֣וּךְ</char> <char style="w" x-id="WLC.PSA.112.8.002" x-align="PSA.112.8.a002" x-target-ids="t002" x-target="heart" x-target-head="t002" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִ֭בּ</char><char style="w" x-id="WLC.PSA.112.8.003" x-align="PSA.112.8.a001" x-target-ids="t001" x-target="His" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.112.8.004" x-align="PSA.112.8.a005" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PSA.112.8.005" x-align="PSA.112.8.a004" x-target-ids="t005 t006 t008 t009" x-target="he shall be afraid" x-target-head="t009" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqi3ms" x-gloss="he.will.be.afraid" x-translit="yîrāʾ" xml:lang="hbo">יִירָ֑א</char> <char style="w" x-id="WLC.PSA.112.8.006" x-align="PSA.112.8.a006" x-target-ids="t010" x-target="Until" x-target-head="t010" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ" xml:lang="hbo">עַ֖ד</char> <char style="w" x-id="WLC.PSA.112.8.007" x-align="PSA.112.8.a006" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="that" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.PSA.112.8.008" x-align="PSA.112.8.a007" x-target-ids="t011 t012" x-target="he see" x-target-head="t012" x-head="tru