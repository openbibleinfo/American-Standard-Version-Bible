	<para style="p"><verse number="9" style="v" x-ref="PSA.44.9" x-added-alignments="PSA.44.9.a003" x-added-target-ids="t006" x-added-target="us" sid="PSA 44:9" /><char style="w" x-id="WLC.PSA.44.9.001" x-align="PSA.44.9.a001" x-target-ids="t001 t002" x-target="But now" x-target-head="t001" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo" x-source-ref="PSA.44.10">אַף</char>־<char style="w" x-id="WLC.PSA.44.9.002" x-align="PSA.44.9.a002" x-target-ids="t003 t004 t005 t007" x-target="thou hast cast off" x-target-head="t005" x-head="true" lemma="זָנַח" strong="H2186" x-morph="Vqp2ms" x-gloss="you.have.rejected" x-translit="zānaḥtā" xml:lang="hbo" x-source-ref="PSA.44.10">זָ֭נַחְתָּ</char> <char style="w" x-id="WLC.PSA.44.9.003" x-align="PSA.44.9.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.44.10">וַ</char><char style="w" x-id="WLC.PSA.44.9.004" x-align="PSA.44.9.a005" x-target-ids="t009 t011 t012" x-target="brought to dishonor" x-target-head="t012" x-head="true" lemma="כָּלַם" strong="H3637" x-morph="Vhw2ms" x-gloss="you" x-translit="taḵliym" xml:lang="hbo" x-source-ref="PSA.44.10">תַּכְלִימֵ֑</char><char style="w" x-id="WLC.PSA.44.9.005" x-align="PSA.44.9.a006" x-target-ids="t010" x-target="us" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="have.humiliated.us" x-translit="ēnû" xml:lang="hbo" x-source-ref="PSA.44.10">נוּ</char> <char style="w" x-id="WLC.PSA.44.9.006" x-align="PSA.44.9.a007" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.44.10">וְ</char><char style="w" x-id="WLC.PSA.44.9.007" x-align="PSA.44.9.a008" x-target-ids="t015" x-target="not" x-target-head="t015" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-g