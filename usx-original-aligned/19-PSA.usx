	<para style="p"><verse number="2" style="v" x-ref="PSA.83.2" sid="PSA 83:2" /><char style="w" x-id="WLC.PSA.83.2.001" x-align="PSA.83.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.83.3">כִּֽי</char>־<char style="w" x-id="WLC.PSA.83.2.002" x-align="PSA.83.2.a002" x-target-ids="t002" x-target="lo" x-target-head="t002" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo" x-source-ref="PSA.83.3">הִנֵּ֣ה</char> <char style="w" x-id="WLC.PSA.83.2.003" x-align="PSA.83.2.a003" x-target-ids="t004" x-target="enemies" x-target-head="t004" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾôyəḇey" xml:lang="hbo" x-source-ref="PSA.83.3">א֭וֹיְבֶי</char><char style="w" x-id="WLC.PSA.83.2.004" x-align="PSA.83.2.a004" x-target-ids="t003" x-target="thine" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.83.3">ךָ</char> <char style="w" x-id="WLC.PSA.83.2.005" x-align="PSA.83.2.a005" x-target-ids="t005 t006 t007" x-target="make a tumult" x-target-head="t007" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqi3mp" x-gloss="they" x-translit="yehĕmāyû" xml:lang="hbo" x-source-ref="PSA.83.3">יֶהֱמָי֑וּ</char><char style="w" x-id="WLC.PSA.83.2.006" x-align="PSA.83.2.a006" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="are.in.an.uproar" x-translit="n" xml:lang="hbo" x-source-ref="PSA.83.3">ן</char> <char style="w" x-id="WLC.PSA.83.2.007" x-align="PSA.83.2.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.83.3">וּ֝</char><char style="w" x-id="WLC.PSA.83.2.008" x-align="PSA.83.2.a008" x-target-ids="t009