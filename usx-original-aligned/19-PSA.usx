	<para style="p"><verse number="3" style="v" x-ref="PSA.17.3" x-added-alignments="PSA.17.3.a005 PSA.17.3.a009" x-added-target-ids="t009 t017" x-added-target="me | and" sid="PSA 17:3" /><char style="w" x-id="WLC.PSA.17.3.001" x-align="PSA.17.3.a001" x-target-ids="t001 t002 t003" x-target="Thou hast proved" x-target-head="t003" x-head="true" lemma="בָּחַן" strong="H974" x-morph="Vqp2ms" x-gloss="you.have.tested" x-translit="bāḥanətā" xml:lang="hbo">בָּ֘חַ֤נְתָּ</char> <char style="w" x-id="WLC.PSA.17.3.002" x-align="PSA.17.3.a003" x-target-ids="t005" x-target="heart" x-target-head="t005" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֨</char><char style="w" x-id="WLC.PSA.17.3.003" x-align="PSA.17.3.a002" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char>׀<char style="w" x-id="WLC.PSA.17.3.004" x-align="PSA.17.3.a004" x-target-ids="t006 t007 t008" x-target="thou hast visited" x-target-head="t008" x-head="true" lemma="פָּקַד" strong="H6485" x-morph="Vqp2ms" x-gloss="you.have.visited" x-translit="pāqaḏətā" xml:lang="hbo">פָּ֘קַ֤דְתָּ</char> <char style="w" x-id="WLC.PSA.17.3.005" x-align="PSA.17.3.a006" x-target-ids="t010 t011 t012" x-target="in the night" x-target-head="t012" x-head="true" lemma="לַיְלָה" strong="H3915" x-morph="Ncmsa" x-gloss="night" x-translit="llayəlâ" xml:lang="hbo">לַּ֗יְלָה</char> <char style="w" x-id="WLC.PSA.17.3.006" x-align="PSA.17.3.a007" x-target-ids="t013 t014 t015" x-target="Thou hast tried" x-target-head="t015" x-head="true" lemma="צָרַף" strong="H6884" x-morph="Vqp2ms" x-gloss="you" x-translit="ṣərap̄ta" xml:lang="hbo">צְרַפְתַּ֥</char><char style="w" x-id="WLC.PSA.17.3.007" x-align="PSA.17.3.a008" x-target-ids="t016" x-target="me" x-target-head="t016" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="have.tested.me" x-translit="niy" xml:lang=