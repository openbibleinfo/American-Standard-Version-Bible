	<para style="p"><verse number="26" style="v" x-ref="PSA.18.26" sid="PSA 18:26" /><char style="w" x-id="WLC.PSA.18.26.001" x-align="PSA.18.26.a001" x-target-ids="t001" x-target="With" x-target-head="t001" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo" x-source-ref="PSA.18.27">עִם</char>־<char style="w" x-id="WLC.PSA.18.26.002" x-align="PSA.18.26.a002" x-target-ids="t002 t003" x-target="the pure" x-target-head="t003" x-head="true" lemma="בָּרַר" strong="H1305" x-morph="VNrmsa" x-gloss="[one.who].purifies.himself" x-translit="nāḇār" xml:lang="hbo" x-source-ref="PSA.18.27">נָבָ֥ר</char> <char style="w" x-id="WLC.PSA.18.26.003" x-align="PSA.18.26.a003" x-target-ids="t004 t005 t006 t007 t008" x-target="thou wilt show thyself pure" x-target-head="t008" x-head="true" lemma="בָּרַר" strong="H1305" x-morph="Vti2ms" x-gloss="you.show.yourself.pure" x-translit="tiṯbārār" xml:lang="hbo" x-source-ref="PSA.18.27">תִּתְבָּרָ֑ר</char> <char style="w" x-id="WLC.PSA.18.26.004" x-align="PSA.18.26.a004" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.27">וְ</char><char style="w" x-id="WLC.PSA.18.26.005" x-align="PSA.18.26.a005" x-target-ids="t010" x-target="with" x-target-head="t010" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo" x-source-ref="PSA.18.27">עִם</char>־<char style="w" x-id="WLC.PSA.18.26.006" x-align="PSA.18.26.a006" x-target-ids="t011 t012" x-target="the perverse" x-target-head="t012" x-head="true" lemma="עִקֵּשׁ" strong="H6141" x-morph="Aamsa" x-gloss="a.perverse.[person]" x-translit="ʿiqqēš" xml:lang="hbo" x-source-ref="PSA.18.27">עִ֝קֵּ֗שׁ</char> <char style="w" x-id="WLC.PSA.18.26.007" x-align="PSA.18.26.a007" x-target-ids="t013 t014 t015 t016 t017" x-target="thou wilt show thyself froward" x-target-head="t017" x-head="true" lemma="פָּתַ