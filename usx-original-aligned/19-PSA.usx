	<para style="p"><verse number="45" style="v" x-ref="PSA.89.45" sid="PSA 89:45" /><char style="w" x-id="WLC.PSA.89.45.001" x-align="PSA.89.45.a001" x-target-ids="t006 t007 t008" x-target="hast thou shortened" x-target-head="t008" x-head="true" lemma="קָצֵר" strong="H7114a" x-morph="Vhp2ms" x-gloss="you.have.cut.short" x-translit="hiqṣartā" xml:lang="hbo" x-source-ref="PSA.89.46">הִ֭קְצַרְתָּ</char> <char style="w" x-id="WLC.PSA.89.45.002" x-align="PSA.89.45.a002" x-target-ids="t001 t002" x-target="The days" x-target-head="t002" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="the.days" x-translit="yəmēy" xml:lang="hbo" x-source-ref="PSA.89.46">יְמֵ֣י</char> <char style="w" x-id="WLC.PSA.89.45.003" x-align="PSA.89.45.a003" x-target-ids="t003 t005" x-target="of youth" x-target-head="t005" x-head="true" lemma="עָלוּמִים" strong="H5934" x-morph="Ncmpc" x-gloss="his.youth(s)" x-translit="ʿălûmāy" xml:lang="hbo" x-source-ref="PSA.89.46">עֲלוּמָ֑י</char><char style="w" x-id="WLC.PSA.89.45.004" x-align="PSA.89.45.a004" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="PSA.89.46">ו</char> <char style="w" x-id="WLC.PSA.89.45.005" x-align="PSA.89.45.a005" x-target-ids="t009 t010 t011" x-target="Thou hast covered" x-target-head="t011" x-head="true" lemma="עָטָה" strong="H5844" x-morph="Vhp2ms" x-gloss="you.have.wrapped" x-translit="heʿĕṭiyṯā" xml:lang="hbo" x-source-ref="PSA.89.46">הֶֽעֱטִ֨יתָ</char> <char style="w" x-id="WLC.PSA.89.45.006" x-align="PSA.89.45.a006" x-target-ids="t013" x-target="with" x-target-head="t013" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿālāy" xml:lang="hbo" x-source-ref="PSA.89.46">עָלָ֖י</char><char style="w" x-id="WLC.PSA.89.45.007" x-align="PSA.89.45.a007" x-target-ids="t012" x-target="him" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-glo