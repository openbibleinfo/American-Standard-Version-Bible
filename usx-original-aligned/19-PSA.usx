	<para style="p"><verse number="12" style="v" x-ref="PSA.31.12" sid="PSA 31:12" /><char style="w" x-id="WLC.PSA.31.12.001" x-align="PSA.31.12.a001" x-target-ids="t001 t002 t003" x-target="I am forgotten" x-target-head="t003" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="VNp1cs" x-gloss="I.have.been.forgotten" x-translit="niškaḥtî" xml:lang="hbo" x-source-ref="PSA.31.13">נִ֭שְׁכַּחְתִּי</char> <char style="w" x-id="WLC.PSA.31.12.002" x-align="PSA.31.12.a002" x-target-ids="t004" x-target="as" x-target-head="t004" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo" x-source-ref="PSA.31.13">כְּ</char><char style="w" x-id="WLC.PSA.31.12.003" x-align="PSA.31.12.a003" x-target-ids="t005 t006 t007" x-target="a dead man" x-target-head="t006" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqrmsa" x-gloss="a.dead.[person]" x-translit="mēṯ" xml:lang="hbo" x-source-ref="PSA.31.13">מֵ֣ת</char> <char style="w" x-id="WLC.PSA.31.12.004" x-align="PSA.31.12.a004" x-target-ids="t008 t009" x-target="out of" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.31.13">מִ</char><char style="w" x-id="WLC.PSA.31.12.005" x-align="PSA.31.12.a005" x-target-ids="t010" x-target="mind" x-target-head="t010" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="heart" x-translit="llēḇ" xml:lang="hbo" x-source-ref="PSA.31.13">לֵּ֑ב</char> <char style="w" x-id="WLC.PSA.31.12.006" x-align="PSA.31.12.a006" x-target-ids="t011 t012" x-target="I am" x-target-head="t012" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cs" x-gloss="I.have.become" x-translit="hāyiyṯî" xml:lang="hbo" x-source-ref="PSA.31.13">הָ֝יִ֗יתִי</char> <char style="w" x-id="WLC.PSA.31.12.007" x-align="PSA.31.12.a007" x-target-ids="t013" x-target="like" x-target-head="t013" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ki" xml:lang="hbo