	<para style="p"><verse number="1" style="v" x-ref="PSA.35.1" x-added-alignments="PSA.35.1.a001" x-added-target-ids="t001 t002" x-added-target="A Psalm" sid="PSA 35:1" /><char style="w" x-id="WLC.PSA.35.1.001" x-align="PSA.35.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.35.1.002" x-align="PSA.35.1.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָוִ֨ד</char><char style="w" x-id="WLC.PSA.35.1.003" x-align="PSA.35.1.a004" x-target-ids="t005 t006" x-target="Strive thou" x-target-head="t005" x-head="true" lemma="רִיב" strong="H7378" x-morph="Vqv2ms" x-gloss="contend" x-translit="riyḇ" xml:lang="hbo">רִיבָ֣</char><char style="w" x-id="WLC.PSA.35.1.004" x-align="PSA.35.1.a005" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PSA.35.1.005" x-align="PSA.35.1.a006" x-target-ids="t007 t008" x-target="O Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.35.1.006" x-align="PSA.35.1.a007" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="אֵת" strong="H854" x-morph="To" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.35.1.007" x-align="PSA.35.1.a008" x-target-ids="t010 t011 t012 t013" x-target="them that strive with" x-target-head="t012" x-head="true" lemma="יָרִיב" strong="H3401" x-morph="Ncmpc" x-gloss="opponents" x-translit="yəriyḇ" xml:lang="hbo">יְרִיבַ֑</char><char style="w" x-id="WLC.PSA.35.1.008" x-align="PSA.35.1.a009" x-target-ids="t014" x-target="me" x-target-head="t014" x-head="true" lemma="הוּא" strong="H2