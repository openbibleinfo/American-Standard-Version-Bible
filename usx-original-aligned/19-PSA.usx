	<para style="p"><verse number="20" style="v" x-ref="PSA.139.20" x-added-alignments="PSA.139.20.a005 PSA.139.20.a007" x-added-target-ids="t007 t011 t012" x-added-target="And | thy name" sid="PSA 139:20" /><char style="w" x-id="WLC.PSA.139.20.001" x-align="PSA.139.20.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[those].who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.PSA.139.20.002" x-align="PSA.139.20.a002" x-target-ids="t002 t003 t004" x-target="they speak against" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3mp" x-gloss="they" x-translit="yōʾmru" xml:lang="hbo">יֹ֭אמְרֻ</char><char style="w" x-id="WLC.PSA.139.20.003" x-align="PSA.139.20.a003" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="speak.of.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.139.20.004" x-align="PSA.139.20.a004" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.139.20.005" x-align="PSA.139.20.a004" x-target-ids="t006" x-target="wickedly" x-target-head="t006" x-head="true" lemma="מְזִמָּה" strong="H4209" x-morph="Ncfsa" x-gloss="wickedness" x-translit="məzimmāh" xml:lang="hbo">מְזִמָּ֑ה</char> <char style="w" x-id="WLC.PSA.139.20.006" x-align="PSA.139.20.a006" x-target-ids="t010" x-target="take" x-target-head="t010" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqp3cp" x-gloss="they.lift.up" x-translit="nāśuʾ" xml:lang="hbo">נָשֻׂ֖א</char> <char style="w" x-id="WLC.PSA.139.20.007" x-align="PSA.139.20.a008" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.139.20.008" x-align="PSA.139.20.a009" x-status="unrepresented" x-head="true" le