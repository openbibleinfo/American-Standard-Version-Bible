	<para style="p"><verse number="8" style="v" x-ref="PSA.104.8" sid="PSA 104:8" /><char style="w" x-id="WLC.PSA.104.8.001" x-align="PSA.104.8.a001" x-target-ids="t003" x-target="rose" x-target-head="t003" x-head="true" lemma="עָלָה" strong="H5927" x-morph="Vqi3mp" x-gloss="they.went.up" x-translit="yaʿălû" xml:lang="hbo">יַעֲל֣וּ</char> <char style="w" x-id="WLC.PSA.104.8.002" x-align="PSA.104.8.a002" x-target-ids="t001 t002" x-target="The mountains" x-target-head="t002" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpa" x-gloss="mountains" x-translit="hārîm" xml:lang="hbo">הָ֭רִים</char> <char style="w" x-id="WLC.PSA.104.8.003" x-align="PSA.104.8.a003" x-target-ids="t006 t007" x-target="sank down" x-target-head="t006" x-head="true" lemma="יָרַד" strong="H3381" x-morph="Vqi3mp" x-gloss="they.went.down" x-translit="yērəḏû" xml:lang="hbo">יֵרְד֣וּ</char> <char style="w" x-id="WLC.PSA.104.8.004" x-align="PSA.104.8.a004" x-target-ids="t004 t005" x-target="the valleys" x-target-head="t005" x-head="true" lemma="בִּקְעָה" strong="H1237" x-morph="Ncfpa" x-gloss="valleys" x-translit="ḇəqāʿôṯ" xml:lang="hbo">בְקָע֑וֹת</char> <char style="w" x-id="WLC.PSA.104.8.005" x-align="PSA.104.8.a005" x-target-ids="t008" x-target="Unto" x-target-head="t008" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.PSA.104.8.006" x-align="PSA.104.8.a006" x-target-ids="t009 t010" x-target="the place" x-target-head="t010" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsc" x-gloss="the.place" x-translit="məqôm" xml:lang="hbo">מְ֝ק֗וֹם</char> <char style="w" x-id="WLC.PSA.104.8.007" x-align="PSA.104.8.a007" x-target-ids="t011" x-target="which" x-target-head="t011" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="(of).which" x-translit="zeh" xml:lang="hbo">זֶ֤ה</char>׀<char style="w" x-id="WLC.PSA.104.8.008" x-align="PSA.104.8.a008" x-target-ids="t012 t013 t014" x-target="thou hadst foun