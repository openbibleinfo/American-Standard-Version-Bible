	<para style="p"><verse number="75" style="v" x-ref="PSA.119.75" sid="PSA 119:75" /><char style="w" x-id="WLC.PSA.119.75.001" x-align="PSA.119.75.a001" x-target-ids="t001 t002" x-target="I know" x-target-head="t002" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿətî" xml:lang="hbo">יָדַ֣עְתִּי</char> <char style="w" x-id="WLC.PSA.119.75.002" x-align="PSA.119.75.a002" x-target-ids="t003 t004" x-target="O Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.119.75.003" x-align="PSA.119.75.a003" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.119.75.004" x-align="PSA.119.75.a006" x-target-ids="t008 t009" x-target="are righteous" x-target-head="t009" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="[are].righteousness" x-translit="ṣeḏeq" xml:lang="hbo">צֶ֣דֶק</char> <char style="w" x-id="WLC.PSA.119.75.005" x-align="PSA.119.75.a005" x-target-ids="t007" x-target="judgments" x-target-head="t007" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmpc" x-gloss="judgments" x-translit="mišpāṭey" xml:lang="hbo">מִשְׁפָּטֶ֑י</char><char style="w" x-id="WLC.PSA.119.75.006" x-align="PSA.119.75.a004" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.75.007" x-align="PSA.119.75.a007" x-target-ids="t010 t011" x-target="And that" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="we" xml:lang="hbo">וֶ֝</char><char style="w" x-id="WLC.PSA.119.75.008" x-align="PSA.119.75.a008" x-target-ids="t012 t013" x-target="in faithfulness" x-tar