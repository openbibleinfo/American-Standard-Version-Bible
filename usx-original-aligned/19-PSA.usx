	<para style="p"><verse number="38" style="v" x-ref="PSA.18.38" sid="PSA 18:38" /><char style="w" x-id="WLC.PSA.18.38.001" x-align="PSA.18.38.a001" x-target-ids="t001 t002 t003 t005" x-target="I will smite through" x-target-head="t003" x-head="true" lemma="מָחַץ" strong="H4272" x-morph="Vqi1cs" x-gloss="I" x-translit="ʾemḥāṣ" xml:lang="hbo" x-source-ref="PSA.18.39">אֶ֭מְחָצֵ</char><char style="w" x-id="WLC.PSA.18.38.002" x-align="PSA.18.38.a002" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="smashed.them" x-translit="ēm" xml:lang="hbo" x-source-ref="PSA.18.39">ם</char> <char style="w" x-id="WLC.PSA.18.38.003" x-align="PSA.18.38.a003" x-target-ids="t006 t007" x-target="so that" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.39">וְ</char><char style="w" x-id="WLC.PSA.18.38.004" x-align="PSA.18.38.a004" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.18.39">לֹא</char>־<char style="w" x-id="WLC.PSA.18.38.005" x-align="PSA.18.38.a005" x-target-ids="t008 t009 t011 t012" x-target="they shall be able" x-target-head="t012" x-head="true" lemma="יָכֹל" strong="H3201" x-morph="Vqi3mp" x-gloss="they.were.able" x-translit="yuḵəlû" xml:lang="hbo" x-source-ref="PSA.18.39">יֻ֣כְלוּ</char> <char style="w" x-id="WLC.PSA.18.38.006" x-align="PSA.18.38.a006" x-target-ids="t013 t014" x-target="to rise" x-target-head="t014" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqc" x-gloss="to.rise" x-translit="qûm" xml:lang="hbo" x-source-ref="PSA.18.39">ק֑וּם</char> <char style="w" x-id="WLC.PSA.18.38.007" x-align="PSA.18.38.a007" x-target-ids="t015 t016 t017" x-target="They shall fall" x-target-head="t017" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3mp" x-gloss="they.fell" x-translit="