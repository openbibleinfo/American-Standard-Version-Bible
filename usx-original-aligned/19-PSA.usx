	<para style="p"><verse number="11" style="v" x-ref="PSA.57.11" sid="PSA 57:11" /><char style="w" x-id="WLC.PSA.57.11.001" x-align="PSA.57.11.a001" x-target-ids="t001 t002 t003" x-target="Be thou exalted" x-target-head="t003" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vqv2ms" x-gloss="be" x-translit="rûm" xml:lang="hbo" x-source-ref="PSA.57.12">ר֣וּמָ</char><char style="w" x-id="WLC.PSA.57.11.002" x-align="PSA.57.11.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-gloss="exalted" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.57.12">ה</char> <char style="w" x-id="WLC.PSA.57.11.003" x-align="PSA.57.11.a004" x-target-ids="t006" x-target="above" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="above" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.57.12">עַל</char>־<char style="w" x-id="WLC.PSA.57.11.004" x-align="PSA.57.11.a005" x-target-ids="t007 t008" x-target="the heavens" x-target-head="t008" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="[the].heavens" x-translit="šāmayim" xml:lang="hbo" x-source-ref="PSA.57.12">שָׁמַ֣יִם</char> <char style="w" x-id="WLC.PSA.57.11.005" x-align="PSA.57.11.a003" x-target-ids="t004 t005" x-target="O God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.57.12">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.57.11.006" x-align="PSA.57.11.a006" x-target-ids="t009 t012 t013" x-target="Let be above" x-target-italic-ids="t009 t012" x-target-head="t013" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="[be].over" x-translit="ʿal" xml:lang="hbo" x-source-ref="PSA.57.12">עַ֖ל</char> <char style="w" x-id="WLC.PSA.57.11.007" x-align="PSA.57.11.a009" x-target-ids="t014" x-target="all" x-target-head="t014" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA