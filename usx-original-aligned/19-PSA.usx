	<para style="p"><verse number="17" style="v" x-ref="PSA.119.17" sid="PSA 119:17" /><char style="w" x-id="WLC.PSA.119.17.001" x-align="PSA.119.17.a001" x-target-ids="t001 t002" x-target="Deal bountifully" x-target-head="t001" x-head="true" lemma="גָּמַל" strong="H1580" x-morph="Vqv2ms" x-gloss="deal.bountifully" x-translit="gəmōl" xml:lang="hbo">גְּמֹ֖ל</char> <char style="w" x-id="WLC.PSA.119.17.002" x-align="PSA.119.17.a002" x-target-ids="t003" x-target="with" x-target-head="t003" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="towards" x-translit="ʿal-" xml:lang="hbo">עַֽל</char>־<char style="w" x-id="WLC.PSA.119.17.003" x-align="PSA.119.17.a003" x-target-ids="t005" x-target="servant" x-target-head="t005" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo">עַבְדְּ</char><char style="w" x-id="WLC.PSA.119.17.004" x-align="PSA.119.17.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PSA.119.17.005" x-align="PSA.119.17.a005" x-target-ids="t006 t007 t008 t009" x-target="that I may live" x-target-head="t009" x-head="true" lemma="חָיָה" strong="H2421" x-morph="Vqh1cs" x-gloss="I.will.live" x-translit="ʾeḥəyeh" xml:lang="hbo">אֶֽחְיֶ֗ה</char> <char style="w" x-id="WLC.PSA.119.17.006" x-align="PSA.119.17.a006" x-target-ids="t010" x-target="So" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.119.17.007" x-align="PSA.119.17.a007" x-target-ids="t011 t012 t013" x-target="will I observe" x-target-head="t013" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqh1cs" x-gloss="I.will.keep" x-translit="ʾešmərāh" xml:lang="hbo">אֶשְׁמְרָ֥ה</char> <char style="w" x-id="WLC.PSA.119.17.008" x-align="PSA.119.17.a008" x-target-ids="t015" x-target="word"