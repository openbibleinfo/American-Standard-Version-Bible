	<para style="p"><verse number="2" style="v" x-ref="PSA.85.2" sid="PSA 85:2" /><char style="w" x-id="WLC.PSA.85.2.001" x-align="PSA.85.2.a001" x-target-ids="t001 t002 t003" x-target="Thou hast forgiven" x-target-head="t003" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqp2ms" x-gloss="you.forgave" x-translit="nāśāʾṯā" xml:lang="hbo" x-source-ref="PSA.85.3">נָ֭שָׂאתָ</char> <char style="w" x-id="WLC.PSA.85.2.002" x-align="PSA.85.2.a002" x-target-ids="t004 t005" x-target="the iniquity" x-target-head="t005" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsc" x-gloss="the.iniquity" x-translit="ʿăwōn" xml:lang="hbo" x-source-ref="PSA.85.3">עֲוֺ֣ן</char> <char style="w" x-id="WLC.PSA.85.2.003" x-align="PSA.85.2.a003" x-target-ids="t006 t008" x-target="of people" x-target-head="t008" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="your.people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="PSA.85.3">עַמֶּ֑</char><char style="w" x-id="WLC.PSA.85.2.004" x-align="PSA.85.2.a004" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.85.3">ךָ</char> <char style="w" x-id="WLC.PSA.85.2.005" x-align="PSA.85.2.a005" x-target-ids="t009 t010 t011" x-target="Thou hast covered" x-target-head="t011" x-head="true" lemma="כָּסָה" strong="H3680" x-morph="Vpp2ms" x-gloss="you.covered" x-translit="kissiyṯā" xml:lang="hbo" x-source-ref="PSA.85.3">כִּסִּ֖יתָ</char> <char style="w" x-id="WLC.PSA.85.2.006" x-align="PSA.85.2.a006" x-target-ids="t012" x-target="all" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.85.3">כָל</char>־<char style="w" x-id="WLC.PSA.85.2.007" x-align="PSA.85.2.a008" x-target-ids="t014" x-target="sin" x-target-head="t014" x-head="true" lemma="חַטָּאת" strong="H2403" x-morph="Ncfsc" x-gloss="sin" x-translit="ḥaṭṭāʾṯ" xml:la