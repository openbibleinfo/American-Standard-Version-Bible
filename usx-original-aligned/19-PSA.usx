	<para style="p"><verse number="2" style="v" x-ref="PSA.98.2" sid="PSA 98:2" /><char style="w" x-id="WLC.PSA.98.2.001" x-align="PSA.98.2.a001" x-target-ids="t002 t003 t004" x-target="hath made known" x-target-head="t004" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vhp3ms" x-gloss="he.has.made.known" x-translit="hôḏiyᵃʿ" xml:lang="hbo">הוֹדִ֣יעַ</char> <char style="w" x-id="WLC.PSA.98.2.002" x-align="PSA.98.2.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.98.2.003" x-align="PSA.98.2.a003" x-target-ids="t006" x-target="salvation" x-target-head="t006" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsc" x-gloss="salvation" x-translit="yəšûʿāṯ" xml:lang="hbo">יְשׁוּעָת֑</char><char style="w" x-id="WLC.PSA.98.2.004" x-align="PSA.98.2.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.98.2.005" x-align="PSA.98.2.a005" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.98.2.006" x-align="PSA.98.2.a006" x-target-ids="t014 t015" x-target="the sight" x-target-head="t015" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="the.eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֥י</char> <char style="w" x-id="WLC.PSA.98.2.007" x-align="PSA.98.2.a007" x-target-ids="t017" x-target="the" x-target-head="t017" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַ֝</char><char style="w" x-id="WLC.PSA.98.2.008" x-align="PSA.98.2.a008" x-target-ids="t016 t018" x-target="of nations" x-target-head="t018" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmp