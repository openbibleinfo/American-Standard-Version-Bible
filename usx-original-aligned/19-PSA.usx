	<para style="p"><verse number="12" style="v" x-ref="PSA.50.12" sid="PSA 50:12" /><char style="w" x-id="WLC.PSA.50.12.001" x-align="PSA.50.12.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PSA.50.12.002" x-align="PSA.50.12.a002" x-target-ids="t002 t003 t004" x-target="I were hungry" x-target-head="t004" x-head="true" lemma="רָעֵב" strong="H7456" x-morph="Vqi1cs" x-gloss="I.will.be.hungry" x-translit="ʾerʿaḇ" xml:lang="hbo">אֶ֭רְעַב</char> <char style="w" x-id="WLC.PSA.50.12.003" x-align="PSA.50.12.a003" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.50.12.004" x-align="PSA.50.12.a004" x-target-ids="t005 t006 t008" x-target="I would tell" x-target-head="t008" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi1cs" x-gloss="I.will.tell" x-translit="ʾōmar" xml:lang="hbo">אֹ֣מַר</char> <char style="w" x-id="WLC.PSA.50.12.005" x-align="PSA.50.12.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ֑</char><char style="w" x-id="WLC.PSA.50.12.006" x-align="PSA.50.12.a006" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.PSA.50.12.007" x-align="PSA.50.12.a007" x-target-ids="t010" x-target="For" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.50.12.008" x-align="PSA.50.12.a008" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belong].to" x-translit="l" xml:lang="hbo">לִ֥</char><char style="w" x-id="WLC.PSA.50.12.009" x-align="PSA.50.12.a008" x-