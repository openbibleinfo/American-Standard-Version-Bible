	<para style="p"><verse number="12" style="v" x-ref="PSA.60.12" x-added-alignments="PSA.60.12.a007" x-added-target-ids="t009 t010 t011" x-added-target="it is that" sid="PSA 60:12" /><char style="w" x-id="WLC.PSA.60.12.001" x-align="PSA.60.12.a001" x-target-ids="t001" x-target="Through" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bē" xml:lang="hbo" x-source-ref="PSA.60.14">בֵּֽ</char><char style="w" x-id="WLC.PSA.60.12.002" x-align="PSA.60.12.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾlōhiym" xml:lang="hbo" x-source-ref="PSA.60.14">אלֹהִ֥ים</char> <char style="w" x-id="WLC.PSA.60.12.003" x-align="PSA.60.12.a003" x-target-ids="t003 t004 t005" x-target="we shall do" x-target-head="t005" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi1cp" x-gloss="we.will.do" x-translit="naʿăśeh-" xml:lang="hbo" x-source-ref="PSA.60.14">נַעֲשֶׂה</char>־<char style="w" x-id="WLC.PSA.60.12.004" x-align="PSA.60.12.a004" x-target-ids="t006" x-target="valiantly" x-target-head="t006" x-head="true" lemma="חַיִל" strong="H2428" x-morph="Ncmsa" x-gloss="strength" x-translit="ḥāyil" xml:lang="hbo" x-source-ref="PSA.60.14">חָ֑יִל</char> <char style="w" x-id="WLC.PSA.60.12.005" x-align="PSA.60.12.a005" x-target-ids="t007" x-target="For" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.60.14">וְ֝</char><char style="w" x-id="WLC.PSA.60.12.006" x-align="PSA.60.12.a006" x-target-ids="t008" x-target="he" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo" x-source-ref="PSA.60.14">ה֗וּא</char> <char style="w" x-id="WLC.PSA.60.12.007" x-align="PSA.60.12.a008" x-target-ids="t012 t013 t014" x-target="will tread down" x-target-head="t013" x-head="true" lemma="בּוּס" strong="H947" x-m