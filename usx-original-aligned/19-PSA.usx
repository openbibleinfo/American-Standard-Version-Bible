	<para style="p"><verse number="36" style="v" x-ref="PSA.89.36" sid="PSA 89:36" /><char style="w" x-id="WLC.PSA.89.36.001" x-align="PSA.89.36.a001" x-target-ids="t002" x-target="seed" x-target-head="t002" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsc" x-gloss="offspring" x-translit="zarʿ" xml:lang="hbo" x-source-ref="PSA.89.37">זַ֭רְע</char><char style="w" x-id="WLC.PSA.89.36.002" x-align="PSA.89.36.a002" x-target-ids="t001" x-target="His" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.89.37">וֹ</char> <char style="w" x-id="WLC.PSA.89.36.003" x-align="PSA.89.36.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.89.37">לְ</char><char style="w" x-id="WLC.PSA.89.36.004" x-align="PSA.89.36.a004" x-target-ids="t006" x-target="ever" x-target-head="t006" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo" x-source-ref="PSA.89.37">עוֹלָ֣ם</char> <char style="w" x-id="WLC.PSA.89.36.005" x-align="PSA.89.36.a005" x-target-ids="t003 t004" x-target="shall endure" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="it.will.be" x-translit="yihyeh" xml:lang="hbo" x-source-ref="PSA.89.37">יִהְיֶ֑ה</char> <char style="w" x-id="WLC.PSA.89.36.006" x-align="PSA.89.36.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.89.37">וְ</char><char style="w" x-id="WLC.PSA.89.36.007" x-align="PSA.89.36.a007" x-target-ids="t009" x-target="throne" x-target-head="t009" x-head="true" lemma="כִּסֵּא" strong="H3678" x-morph="Ncmsc" x-gloss="throne" x-translit="ḵisʾ" xml:lang="hbo" x-source-ref="PSA.89.37">כִסְא֖</char><char style="w" x-id="WLC