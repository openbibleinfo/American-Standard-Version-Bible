	<para style="p"><verse number="7" style="v" x-ref="PSA.105.7" sid="PSA 105:7" /><char style="w" x-id="WLC.PSA.105.7.001" x-align="PSA.105.7.a001" x-target-ids="t001" x-target="He" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֭וּא</char> <char style="w" x-id="WLC.PSA.105.7.002" x-align="PSA.105.7.a002" x-target-ids="t002 t003" x-target="is Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="[is].Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.105.7.003" x-align="PSA.105.7.a003" x-target-ids="t005" x-target="God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōhēy" xml:lang="hbo">אֱלֹהֵ֑י</char><char style="w" x-id="WLC.PSA.105.7.004" x-align="PSA.105.7.a004" x-target-ids="t004" x-target="our" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.PSA.105.7.005" x-align="PSA.105.7.a005" x-target-ids="t008 t009" x-target="are in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.105.7.006" x-align="PSA.105.7.a006" x-target-ids="t010" x-target="all" x-target-head="t010" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.105.7.007" x-align="PSA.105.7.a007" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ֝</char><char style="w" x-id="WLC.PSA.105.7.008" x-align="PSA.105.7.a008" x-target-ids="t012" x-target="earth" x-target-head="t012" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ" xml:lan