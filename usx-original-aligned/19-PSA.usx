	<para style="p"><verse number="3" style="v" x-ref="PSA.112.3" sid="PSA 112:3" /><char style="w" x-id="WLC.PSA.112.3.001" x-align="PSA.112.3.a001" x-target-ids="t001" x-target="Wealth" x-target-head="t001" x-head="true" lemma="הוֹן" strong="H1952" x-morph="Ncmsa" x-gloss="wealth" x-translit="hôn-" xml:lang="hbo">הוֹן</char>־<char style="w" x-id="WLC.PSA.112.3.002" x-align="PSA.112.3.a002" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PSA.112.3.003" x-align="PSA.112.3.a003" x-target-ids="t003" x-target="riches" x-target-head="t003" x-head="true" lemma="עֹשֶׁר" strong="H6239" x-morph="Ncmsa" x-gloss="rich[es]" x-translit="ʿōšer" xml:lang="hbo">עֹ֥שֶׁר</char> <char style="w" x-id="WLC.PSA.112.3.004" x-align="PSA.112.3.a004" x-target-ids="t004 t005" x-target="are in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.112.3.005" x-align="PSA.112.3.a006" x-target-ids="t007" x-target="house" x-target-head="t007" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="ḇēyṯ" xml:lang="hbo">בֵית֑</char><char style="w" x-id="WLC.PSA.112.3.006" x-align="PSA.112.3.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.112.3.007" x-align="PSA.112.3.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.112.3.008" x-align="PSA.112.3.a009" x-target-ids="t010" x-target="righteousness" x-target-head="t010" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsc" x-gloss="righteousness" x-translit="ṣiḏqāṯ" xm