	<para style="p"><verse number="25" style="v" x-ref="PSA.102.25" sid="PSA 102:25" /><char style="w" x-id="WLC.PSA.102.25.001" x-align="PSA.102.25.a001" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="formerly" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.102.26">לְ֭</char><char style="w" x-id="WLC.PSA.102.25.002" x-align="PSA.102.25.a001" x-target-ids="t001 t002" x-target="Of old" x-target-head="t002" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpa" x-translit="p̄ānîm" xml:lang="hbo" x-source-ref="PSA.102.26">פָנִים</char> <char style="w" x-id="WLC.PSA.102.25.003" x-align="PSA.102.25.a002" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.102.26">הָ</char><char style="w" x-id="WLC.PSA.102.25.004" x-align="PSA.102.25.a003" x-target-ids="t010" x-target="earth" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ" xml:lang="hbo" x-source-ref="PSA.102.26">אָ֣רֶץ</char> <char style="w" x-id="WLC.PSA.102.25.005" x-align="PSA.102.25.a004" x-target-ids="t003 t004 t005 t006 t007 t008" x-target="didst thou lay the foundation of" x-target-head="t007" x-head="true" lemma="יָסַד" strong="H3245" x-morph="Vqp2ms" x-gloss="you.founded" x-translit="yāsaḏətā" xml:lang="hbo" x-source-ref="PSA.102.26">יָסַ֑דְתָּ</char> <char style="w" x-id="WLC.PSA.102.25.006" x-align="PSA.102.25.a005" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[were]" x-translit="û" xml:lang="hbo" x-source-ref="PSA.102.26">וּֽ</char><char style="w" x-id="WLC.PSA.102.25.007" x-align="PSA.102.25.a006" x-target-ids="t014 t015 t016" x-target="are the work" x-target-head="t016" x-head="true" lemma="מַעֲשֶׂה" strong="H4639" x-morph="Ncmsc" x-gloss="the.work" x-translit="maʿăśēh" xml:lang="hbo" x-source-ref="PSA.102.26">מַעֲשֵׂ֖ה</char> <char style="w" 