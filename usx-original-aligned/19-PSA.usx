	<para style="p"><verse number="2" style="v" x-ref="PSA.70.2" sid="PSA 70:2" /><char style="w" x-id="WLC.PSA.70.2.001" x-align="PSA.70.2.a001" x-target-ids="t001 t002 t003 t004 t005 t006" x-target="Let them be put to shame" x-target-head="t006" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi3mp" x-gloss="may.they.be.ashamed" x-translit="yēḇōšû" xml:lang="hbo" x-source-ref="PSA.70.3">יֵבֹ֣שׁוּ</char> <char style="w" x-id="WLC.PSA.70.2.002" x-align="PSA.70.2.a002" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.70.3">וְ</char><char style="w" x-id="WLC.PSA.70.2.003" x-align="PSA.70.2.a003" x-target-ids="t008" x-target="confounded" x-target-head="t008" x-head="true" lemma="חָפֵר" strong="H2659" x-morph="Vqi3mp" x-gloss="may.they.be.abashed" x-translit="yaḥpərû" xml:lang="hbo" x-source-ref="PSA.70.3">יַחְפְּרוּ֮</char> <char style="w" x-id="WLC.PSA.70.2.004" x-align="PSA.70.2.a004" x-target-ids="t009 t010 t011" x-target="That seek after" x-target-head="t010" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vprmpc" x-gloss="[those.who].seek" x-translit="məḇaqšēy" xml:lang="hbo" x-source-ref="PSA.70.3">מְבַקְשֵׁ֪י</char> <char style="w" x-id="WLC.PSA.70.2.005" x-align="PSA.70.2.a005" x-target-ids="t013" x-target="soul" x-target-head="t013" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="life" x-translit="nap̄š" xml:lang="hbo" x-source-ref="PSA.70.3">נַ֫פְשִׁ֥</char><char style="w" x-id="WLC.PSA.70.2.006" x-align="PSA.70.2.a006" x-target-ids="t012" x-target="my" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="(of).my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.70.3">י</char> <char style="w" x-id="WLC.PSA.70.2.007" x-align="PSA.70.2.a007" x-target-ids="t014 t015 t016 t017" x-target="Let them be turned" x-target-head="t017" x-head="true" lemma="סוּג" strong="H5472" x-morph="