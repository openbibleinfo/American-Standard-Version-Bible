	<para style="p"><verse number="1" style="v" x-ref="PSA.88.1" x-added-alignments="PSA.88.1.a007" x-added-target-ids="t012" x-added-target="and" sid="PSA 88:1" /><char style="w" x-id="WLC.PSA.88.1.001" x-align="PSA.88.1.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.88.2">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.88.1.002" x-align="PSA.88.1.a002" x-target-ids="t003 t004" x-target="the God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="the.God" x-translit="ʾĕlōhēy" xml:lang="hbo" x-source-ref="PSA.88.2">אֱלֹהֵ֣י</char> <char style="w" x-id="WLC.PSA.88.1.003" x-align="PSA.88.1.a003" x-target-ids="t005 t007" x-target="of salvation" x-target-head="t007" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsc" x-gloss="my.salvation" x-translit="yəšûʿāṯ" xml:lang="hbo" x-source-ref="PSA.88.2">יְשׁוּעָתִ֑</char><char style="w" x-id="WLC.PSA.88.1.004" x-align="PSA.88.1.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.88.2">י</char> <char style="w" x-id="WLC.PSA.88.1.005" x-align="PSA.88.1.a005" x-target-ids="t011" x-target="day" x-target-head="t011" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yôm-" xml:lang="hbo" x-source-ref="PSA.88.2">יוֹם</char>־<char style="w" x-id="WLC.PSA.88.1.006" x-align="PSA.88.1.a006" x-target-ids="t008 t009 t010" x-target="I have cried" x-target-head="t010" x-head="true" lemma="צָעַק" strong="H6817" x-morph="Vqp1cs" x-gloss="I.have.cried.out" x-translit="ṣāʿaqətî" xml:lang="hbo" x-source-ref="PSA.88.2">צָעַ֖קְתִּי</char> <char style="w" x-id="WLC.PSA.88.1.007" x-align="PSA.88.1.a008" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-