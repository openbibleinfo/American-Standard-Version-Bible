	<para style="p"><verse number="1" style="v" x-ref="PSA.9.1" sid="PSA 9:1" /><char style="w" x-id="WLC.PSA.9.1.001" x-align="PSA.9.1.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="I will give thanks unto" x-target-head="t004" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I.will.give.thanks.to" x-translit="ʾôḏeh" xml:lang="hbo" x-source-ref="PSA.9.2">אוֹדֶ֣ה</char> <char style="w" x-id="WLC.PSA.9.1.002" x-align="PSA.9.1.a002" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.9.2">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.9.1.003" x-align="PSA.9.1.a003" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.9.2">בְּ</char><char style="w" x-id="WLC.PSA.9.1.004" x-align="PSA.9.1.a004" x-target-ids="t009" x-target="whole" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.9.2">כָל</char>־<char style="w" x-id="WLC.PSA.9.1.005" x-align="PSA.9.1.a005" x-target-ids="t010" x-target="heart" x-target-head="t010" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo" x-source-ref="PSA.9.2">לִבִּ֑</char><char style="w" x-id="WLC.PSA.9.1.006" x-align="PSA.9.1.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.9.2">י</char> <char style="w" x-id="WLC.PSA.9.1.007" x-align="PSA.9.1.a007" x-target-ids="t011 t012 t013 t014" x-target="I will show forth" x-target-head="t013" x-head="true" lemma="סָפַר" strong="H5608" x-morph="Vph1cs" x-gloss="I.will.recount" x-translit="ʾăsappərāh" xml:lang="hbo" x-source-ref="PSA.9.2">אֲ֝סַפְּרָ֗ה</char