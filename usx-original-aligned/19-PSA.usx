	<para style="p"><verse number="6" style="v" x-ref="PSA.14.6" sid="PSA 14:6" /><char style="w" x-id="WLC.PSA.14.6.001" x-align="PSA.14.6.a002" x-target-ids="t005 t006" x-target="the counsel" x-target-head="t006" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsc" x-gloss="[the].plan" x-translit="ʿăṣaṯ-" xml:lang="hbo">עֲצַת</char>־<char style="w" x-id="WLC.PSA.14.6.002" x-align="PSA.14.6.a003" x-target-ids="t007 t008 t009" x-target="of the poor" x-target-head="t009" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aamsa" x-gloss="of.[the].poor" x-translit="ʿāniy" xml:lang="hbo">עָנִ֥י</char> <char style="w" x-id="WLC.PSA.14.6.003" x-align="PSA.14.6.a001" x-target-ids="t001 t002 t003 t004" x-target="Ye put to shame" x-target-head="t004" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vhi2mp" x-gloss="you.will.put.to.shame" x-translit="ṯāḇiyšû" xml:lang="hbo">תָבִ֑ישׁוּ</char> <char style="w" x-id="WLC.PSA.14.6.004" x-align="PSA.14.6.a004" x-target-ids="t010" x-target="Because" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֖י</char> <char style="w" x-id="WLC.PSA.14.6.005" x-align="PSA.14.6.a005" x-target-ids="t011" x-target="Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.14.6.006" x-align="PSA.14.6.a006" x-target-ids="t012 t014" x-target="is refuge" x-target-head="t014" x-head="true" lemma="מַחְסֶּה" strong="H4268" x-morph="Ncmsc" x-gloss="refuge" x-translit="maḥs" xml:lang="hbo">מַחְסֵֽ</char><char style="w" x-id="WLC.PSA.14.6.007" x-align="PSA.14.6.a007" x-target-ids="t013" x-target="his" x-target-head="t013" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="[is].his" x-translit="ēhû" xml:lang="hbo">הוּ</char>׃<verse eid="PSA 14:6" /></para>
	<para style="p"><verse number="7" style="v" x-ref="PSA.14.7" x-added-alignments="PSA.14.7.a012 PSA.14.7.a015" x-added-target-ids="t021 t025" x-added-target="Then | and" sid="PSA 14:7" /><char style="w" x-id="WLC.PSA.14.7.001" x-align="PSA.14.7.a001" x-status="noncompositional" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo">מִ֥י</char> <char style="w" x-id="WLC.PSA.14.7.002" x-align="PSA.14.7.a001" x-status="noncompositional" x-target-ids="t001 t002 t007 t008" x-target="Oh that were come" x-target-head="t008" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="will.he.give" x-translit="yittēn" xml:lang="hbo">יִתֵּ֣ן</char> <char style="w" x-id="WLC.PSA.14.7.003" x-align="PSA.14.7.a002" x-target-ids="t009 t010" x-target="out of" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="[will" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.14.7.004" x-align="PSA.14.7.a003" x-target-ids="t011" x-target="Zion" x-target-head="t011" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="be].from.Zion" x-translit="ṣṣiyyôn" xml:lang="hbo">צִּיּוֹן֮</char> <char style="w" x-id="WLC.PSA.14.7.005" x-align="PSA.14.7.a004" x-target-ids="t003 t004" x-target="the salvation" x-target-head="t004" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsc" x-gloss="the.salvation" x-translit="yəšûʿaṯ" xml:lang="hbo">יְשׁוּעַ֪ת</char> <char style="w" x-id="WLC.PSA.14.7.006" x-align="PSA.14.7.a005" x-target-ids="t005 t006" x-target="of Israel" x-target-head="t006" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָ֫אֵ֥ל</char> <char style="w" x-id="WLC.PSA.14.7.007" x-align="PSA.14.7.a006" x-target-ids="t012" x-target="When" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.14.7.008" x-al