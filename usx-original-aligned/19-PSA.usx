	<para style="p"><verse number="9" style="v" x-ref="PSA.51.9" sid="PSA 51:9" /><char style="w" x-id="WLC.PSA.51.9.001" x-align="PSA.51.9.a001" x-target-ids="t001" x-target="Hide" x-target-head="t001" x-head="true" lemma="סָתַר" strong="H5641" x-morph="Vhv2ms" x-gloss="hide" x-translit="hastēr" xml:lang="hbo" x-source-ref="PSA.51.11">הַסְתֵּ֣ר</char> <char style="w" x-id="WLC.PSA.51.9.002" x-align="PSA.51.9.a002" x-target-ids="t003" x-target="face" x-target-head="t003" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="face" x-translit="pāney" xml:lang="hbo" x-source-ref="PSA.51.11">פָּ֭נֶי</char><char style="w" x-id="WLC.PSA.51.9.003" x-align="PSA.51.9.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.51.11">ךָ</char> <char style="w" x-id="WLC.PSA.51.9.004" x-align="PSA.51.9.a004" x-target-ids="t004" x-target="from" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.51.11">מֵ</char><char style="w" x-id="WLC.PSA.51.9.005" x-align="PSA.51.9.a005" x-target-ids="t006" x-target="sins" x-target-head="t006" x-head="true" lemma="חֵטְא" strong="H2399" x-morph="Ncmpc" x-gloss="sins" x-translit="ḥăṭāʾ" xml:lang="hbo" x-source-ref="PSA.51.11">חֲטָאָ֑</char><char style="w" x-id="WLC.PSA.51.9.006" x-align="PSA.51.9.a006" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.51.11">י</char> <char style="w" x-id="WLC.PSA.51.9.007" x-align="PSA.51.9.a007" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.51.11">וְֽ</char><char style="w" x-id="WLC.PSA.51.9.008" x-align="PSA.51.9.a008" x-target-ids="t010" x-ta