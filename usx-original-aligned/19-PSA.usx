	<para style="p"><verse number="6" style="v" x-ref="PSA.6.6" sid="PSA 6:6" /><char style="w" x-id="WLC.PSA.6.6.001" x-align="PSA.6.6.a001" x-target-ids="t001 t002 t003" x-target="I am weary" x-target-head="t003" x-head="true" lemma="יָגֵעַ" strong="H3021" x-morph="Vqp1cs" x-gloss="I.have.become.weary" x-translit="yāḡaʿətî" xml:lang="hbo" x-source-ref="PSA.6.7">יָגַ֤עְתִּי</char>׀<char style="w" x-id="WLC.PSA.6.6.002" x-align="PSA.6.6.a002" x-target-ids="t004" x-target="with" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.6.7">בְּֽ</char><char style="w" x-id="WLC.PSA.6.6.003" x-align="PSA.6.6.a003" x-target-ids="t006" x-target="groaning" x-target-head="t006" x-head="true" lemma="אֲנָחָה" strong="H585" x-morph="Ncfsc" x-gloss="groaning" x-translit="ʾanḥāṯ" xml:lang="hbo" x-source-ref="PSA.6.7">אַנְחָתִ֗</char><char style="w" x-id="WLC.PSA.6.6.004" x-align="PSA.6.6.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.6.7">י</char> <char style="w" x-id="WLC.PSA.6.6.005" x-align="PSA.6.6.a005" x-target-ids="t009 t010 t013 t014" x-target="make I to swim" x-target-head="t014" x-head="true" lemma="שָׂחָה" strong="H7811" x-morph="Vhi1cs" x-gloss="I.make.swim" x-translit="ʾaśḥeh" xml:lang="hbo" x-source-ref="PSA.6.7">אַשְׂחֶ֣ה</char> <char style="w" x-id="WLC.PSA.6.6.006" x-align="PSA.6.6.a006" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.6.7">בְ</char><char style="w" x-id="WLC.PSA.6.6.007" x-align="PSA.6.6.a007" x-target-ids="t007" x-target="Every" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.6.7">כָל</char>־<char style="w" x-id="WLC.PSA.6.6.008" x-align="PSA.6.6.a008"