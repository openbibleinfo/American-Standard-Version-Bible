	<para style="p"><verse number="1" style="v" x-ref="PSA.50.1" sid="PSA 50:1" /><char style="w" x-id="WLC.PSA.50.1.001" x-align="PSA.50.1.a001" x-target-ids="t001 t002" x-target="A Psalm" x-target-head="t002" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo">מִזְמ֗וֹר</char> <char style="w" x-id="WLC.PSA.50.1.002" x-align="PSA.50.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.50.1.003" x-align="PSA.50.1.a003" x-target-ids="t004" x-target="Asaph" x-target-head="t004" x-head="true" lemma="אָסָף" strong="H623" x-morph="Np" x-gloss="Asaph" x-translit="ʾāsāp̄" xml:lang="hbo">אָ֫סָ֥ף</char><char style="w" x-id="WLC.PSA.50.1.004" x-align="PSA.50.1.a004" x-target-ids="t005 t006 t007" x-target="The Mighty One" x-target-head="t006" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsc" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֤ל</char>׀<char style="w" x-id="WLC.PSA.50.1.005" x-align="PSA.50.1.a005" x-target-ids="t008" x-target="God" x-target-head="t008" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo">אֱֽלֹהִ֡ים</char> <char style="w" x-id="WLC.PSA.50.1.006" x-align="PSA.50.1.a006" x-target-ids="t009" x-target="Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.50.1.007" x-align="PSA.50.1.a007" x-target-ids="t010 t011" x-target="hath spoken" x-target-head="t011" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpp3ms" x-gloss="he.has.spoken" x-translit="dibber" xml:lang="hbo">דִּבֶּ֥ר</char> <char style="w" x-id="WLC.PSA.50.1.008" x-align="PSA.50.1.a008" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" 