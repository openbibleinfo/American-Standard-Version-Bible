	<para style="p"><verse number="5" style="v" x-ref="PSA.104.5" x-added-alignments="PSA.104.5.a002 PSA.104.5.a007" x-added-target-ids="t001 t008" x-added-target="Who | That" sid="PSA 104:5" /><char style="w" x-id="WLC.PSA.104.5.001" x-align="PSA.104.5.a001" x-target-ids="t002" x-target="laid" x-target-head="t002" x-head="true" lemma="יָסַד" strong="H3245" x-morph="Vqp3ms" x-gloss="he.established" x-translit="yāsaḏ-" xml:lang="hbo">יָֽסַד</char>־<char style="w" x-id="WLC.PSA.104.5.002" x-align="PSA.104.5.a003" x-target-ids="t005 t006 t007" x-target="of the earth" x-target-head="t007" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].earth" x-translit="ʾereṣ" xml:lang="hbo">אֶ֭רֶץ</char> <char style="w" x-id="WLC.PSA.104.5.003" x-align="PSA.104.5.a004" x-status="unrepresented" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.104.5.004" x-align="PSA.104.5.a005" x-target-ids="t003 t004" x-target="the foundations" x-target-head="t004" x-head="true" lemma="מָכוֹן" strong="H4349" x-morph="Ncmpc" x-gloss="foundations" x-translit="məḵôney" xml:lang="hbo">מְכוֹנֶ֑י</char><char style="w" x-id="WLC.PSA.104.5.005" x-align="PSA.104.5.a006" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PSA.104.5.006" x-align="PSA.104.5.a008" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PSA.104.5.007" x-align="PSA.104.5.a009" x-target-ids="t009 t010 t012 t013" x-target="it should be moved" x-target-head="t013" x-head="true" lemma="מוֹט" strong="H4131" x-morph="VNi3fs" x-gloss="it.will.be.shaken" x-translit="timmôṭ" xml:lang="hbo">תִּ֝מּ֗וֹט</char> <char style="w" x-id="WLC.PSA.104.5.008" x-align="PSA.104.5.a010" x-target-i