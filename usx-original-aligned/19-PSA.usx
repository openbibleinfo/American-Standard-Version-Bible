	<para style="p"><verse number="2" style="v" x-ref="PSA.119.2" sid="PSA 119:2" /><char style="w" x-id="WLC.PSA.119.2.001" x-align="PSA.119.2.a001" x-target-ids="t001 t002" x-target="Blessed are" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrê" xml:lang="hbo">אַ֭שְׁרֵי</char> <char style="w" x-id="WLC.PSA.119.2.002" x-align="PSA.119.2.a002" x-target-ids="t003 t004 t005" x-target="they that keep" x-target-head="t005" x-head="true" lemma="נָצַר" strong="H5341" x-morph="Vqrmpc" x-gloss="[are.those.who].observe" x-translit="nōṣərēy" xml:lang="hbo">נֹצְרֵ֥י</char> <char style="w" x-id="WLC.PSA.119.2.003" x-align="PSA.119.2.a003" x-target-ids="t007" x-target="testimonies" x-target-head="t007" x-head="true" lemma="עֵדוּת" strong="H5715" x-morph="Ncfpc" x-gloss="testimonies" x-translit="ʿēḏōṯāy" xml:lang="hbo">עֵדֹתָ֗י</char><char style="w" x-id="WLC.PSA.119.2.004" x-align="PSA.119.2.a004" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="(of).his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.119.2.005" x-align="PSA.119.2.a005" x-target-ids="t011" x-target="with" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.2.006" x-align="PSA.119.2.a006" x-target-ids="t013" x-target="whole" x-target-head="t013" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.119.2.007" x-align="PSA.119.2.a007" x-target-ids="t012 t014" x-target="the heart" x-target-head="t014" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="[the].heart" x-translit="lēḇ" xml:lang="hbo">לֵ֥ב</char> <char style="w" x-id="WLC.PSA.119.2.008" x-align="PSA.119.2.a008" x-target-ids="t008 t009" x-target="That seek" x-target-head="t009