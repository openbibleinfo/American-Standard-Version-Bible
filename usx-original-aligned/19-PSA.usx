	<para style="p"><verse number="74" style="v" x-ref="PSA.119.74" sid="PSA 119:74" /><char style="w" x-id="WLC.PSA.119.74.001" x-align="PSA.119.74.a001" x-target-ids="t001 t002 t003" x-target="They that fear" x-target-head="t003" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aampc" x-gloss="[those].fearing" x-translit="yərēʾey" xml:lang="hbo">יְ֭רֵאֶי</char><char style="w" x-id="WLC.PSA.119.74.002" x-align="PSA.119.74.a002" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.74.003" x-align="PSA.119.74.a003" x-target-ids="t005 t006" x-target="shall see" x-target-head="t006" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi3mp" x-gloss="may" x-translit="yirʾû" xml:lang="hbo">יִרְא֣וּ</char><char style="w" x-id="WLC.PSA.119.74.004" x-align="PSA.119.74.a004" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="they.see.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.74.005" x-align="PSA.119.74.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.119.74.006" x-align="PSA.119.74.a006" x-target-ids="t009 t010" x-target="be glad" x-target-head="t010" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3mp" x-gloss="may.they.rejoice" x-translit="yiśmāḥû" xml:lang="hbo">יִשְׂמָ֑חוּ</char> <char style="w" x-id="WLC.PSA.119.74.007" x-align="PSA.119.74.a007" x-target-ids="t011" x-target="Because" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֖י</char> <char style="w" x-id="WLC.PSA.119.74.008" x-align="PSA.119.74.a008" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma