	<para style="p"><verse number="15" style="v" x-ref="PSA.92.15" sid="PSA 92:15" /><char style="w" x-id="WLC.PSA.92.15.001" x-align="PSA.92.15.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.92.16">לְ֭</char><char style="w" x-id="WLC.PSA.92.15.002" x-align="PSA.92.15.a002" x-target-ids="t002" x-target="show" x-target-head="t002" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhc" x-gloss="declare" x-translit="haggîḏ" xml:lang="hbo" x-source-ref="PSA.92.16">הַגִּיד</char> <char style="w" x-id="WLC.PSA.92.15.003" x-align="PSA.92.15.a003" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.92.16">כִּֽי</char>־<char style="w" x-id="WLC.PSA.92.15.004" x-align="PSA.92.15.a004" x-target-ids="t005 t006" x-target="is upright" x-target-head="t006" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aamsa" x-gloss="[is].upright" x-translit="yāšār" xml:lang="hbo" x-source-ref="PSA.92.16">יָשָׁ֣ר</char> <char style="w" x-id="WLC.PSA.92.15.005" x-align="PSA.92.15.a005" x-target-ids="t004 t007" x-target="Jehovah He" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.92.16">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.92.15.006" x-align="PSA.92.15.a006" x-target-ids="t008 t010" x-target="is rock" x-target-head="t010" x-head="true" lemma="צוּר" strong="H6697" x-morph="Ncmsc" x-gloss="rock" x-translit="ṣûr" xml:lang="hbo" x-source-ref="PSA.92.16">צ֝וּרִ֗</char><char style="w" x-id="WLC.PSA.92.15.007" x-align="PSA.92.15.a007" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.92.16">י</char> <char style="w" x-i