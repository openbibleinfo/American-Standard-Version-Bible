	<para style="p"><verse number="23" style="v" x-ref="PSA.50.23" x-added-alignments="PSA.50.23.a008 PSA.50.23.a009" x-added-target-ids="t014 t016" x-added-target="his | aright" sid="PSA 50:23" /><char style="w" x-id="WLC.PSA.50.23.001" x-align="PSA.50.23.a001" x-target-ids="t001 t002" x-target="Whoso offereth" x-target-head="t002" x-head="true" lemma="זָבַח" strong="H2076" x-morph="Vqrmsa" x-gloss="[one.who].sacrifices" x-translit="zōḇēᵃḥ" xml:lang="hbo">זֹבֵ֥חַ</char> <char style="w" x-id="WLC.PSA.50.23.002" x-align="PSA.50.23.a002" x-target-ids="t003 t004 t005 t006" x-target="the sacrifice of thanksgiving" x-target-head="t006" x-head="true" lemma="תּוֹדָה" strong="H8426" x-morph="Ncfsa" x-gloss="a.thank-offering" x-translit="tôḏāh" xml:lang="hbo">תּוֹדָ֗ה</char> <char style="w" x-id="WLC.PSA.50.23.003" x-align="PSA.50.23.a003" x-target-ids="t007" x-target="glorifieth" x-target-head="t007" x-head="true" lemma="כָּבֵד" strong="H3513" x-morph="Vpi3ms" x-gloss="he" x-translit="yəḵabbəḏ" xml:lang="hbo">יְֽכַ֫בְּדָ֥</char><char style="w" x-id="WLC.PSA.50.23.004" x-align="PSA.50.23.a004" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="honors.me" x-translit="ānəniy" xml:lang="hbo">נְנִי</char> <char style="w" x-id="WLC.PSA.50.23.005" x-align="PSA.50.23.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.50.23.006" x-align="PSA.50.23.a006" x-target-ids="t012 t013" x-target="that ordereth" x-target-head="t013" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqrmsa" x-gloss="[one.who].sets" x-translit="śām" xml:lang="hbo">שָׂ֥ם</char> <char style="w" x-id="WLC.PSA.50.23.007" x-align="PSA.50.23.a007" x-target-ids="t015" x-target="way" x-target-head="t015" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="a.way" x-translit="dereḵ" xml:la