	<para style="p"><verse number="7" style="v" x-ref="PSA.91.7" x-added-alignments="PSA.91.7.a011" x-added-target-ids="t015" x-added-target="But" sid="PSA 91:7" /><char style="w" x-id="WLC.PSA.91.7.001" x-align="PSA.91.7.a001" x-target-ids="t003 t004" x-target="shall fall" x-target-head="t004" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="it.will.fall" x-translit="yippōl" xml:lang="hbo">יִפֹּ֤ל</char> <char style="w" x-id="WLC.PSA.91.7.002" x-align="PSA.91.7.a002" x-target-ids="t005" x-target="at" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.91.7.003" x-align="PSA.91.7.a003" x-target-ids="t007" x-target="side" x-target-head="t007" x-head="true" lemma="צַד" strong="H6654" x-morph="Ncmsc" x-gloss="side" x-translit="ṣṣidd" xml:lang="hbo">צִּדְּ</char><char style="w" x-id="WLC.PSA.91.7.004" x-align="PSA.91.7.a004" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֨</char>׀<char style="w" x-id="WLC.PSA.91.7.005" x-align="PSA.91.7.a005" x-target-ids="t001 t002" x-target="A thousand" x-target-head="t002" x-head="true" lemma="אֶלֶף" strong="H505" x-morph="Acbsa" x-gloss="a.thousand" x-translit="ʾelep̄" xml:lang="hbo">אֶ֗לֶף</char> <char style="w" x-id="WLC.PSA.91.7.006" x-align="PSA.91.7.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.91.7.007" x-align="PSA.91.7.a007" x-target-ids="t009 t010" x-target="ten thousand" x-target-head="t010" x-head="true" lemma="רְבָבָה" strong="H7233" x-morph="Ncfsa" x-gloss="ten.thousand" x-translit="rəḇāḇāh" xml:lang="hbo">רְבָבָ֥ה</char> <char style="w" x-id="WLC.PSA.91.7.008" x-align="PSA.91.7.a008" x-target-ids="t011" x-target="at" x-target-head="t