	<para style="p"><verse number="34" style="v" x-ref="PSA.89.34" sid="PSA 89:34" /><char style="w" x-id="WLC.PSA.89.34.001" x-align="PSA.89.34.a001" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.89.35">לֹא</char>־<char style="w" x-id="WLC.PSA.89.34.002" x-align="PSA.89.34.a002" x-target-ids="t003 t004 t006" x-target="will I break" x-target-head="t006" x-head="true" lemma="חָלַל" strong="H2490" x-morph="Vpi1cs" x-gloss="I.will.violate" x-translit="ʾăḥallēl" xml:lang="hbo" x-source-ref="PSA.89.35">אֲחַלֵּ֥ל</char> <char style="w" x-id="WLC.PSA.89.34.003" x-align="PSA.89.34.a003" x-target-ids="t002" x-target="covenant" x-target-head="t002" x-head="true" lemma="בְּרִית" strong="H1285" x-morph="Ncfsc" x-gloss="covenant" x-translit="bəriyṯ" xml:lang="hbo" x-source-ref="PSA.89.35">בְּרִיתִ֑</char><char style="w" x-id="WLC.PSA.89.34.004" x-align="PSA.89.34.a004" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.89.35">י</char> <char style="w" x-id="WLC.PSA.89.34.005" x-align="PSA.89.34.a005" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.89.35">וּ</char><char style="w" x-id="WLC.PSA.89.34.006" x-align="PSA.89.34.a006" x-target-ids="t009 t010 t011 t012 t013 t014" x-target="the thing that is gone out" x-target-head="t013" x-head="true" lemma="מוֹצָא" strong="H4161" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="môṣāʾ" xml:lang="hbo" x-source-ref="PSA.89.35">מוֹצָ֥א</char> <char style="w" x-id="WLC.PSA.89.34.007" x-align="PSA.89.34.a007" x-target-ids="t015 t017" x-target="of lips" x-target-head="t017" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="my.lips" x-translit="śəp̄āṯ" xml:lang="hbo" x-source-ref="PSA.89.35">שְׂ֝פ