	<para style="p"><verse number="13" style="v" x-ref="PSA.102.13" x-added-alignments="PSA.102.13.a003 PSA.102.13.a007" x-added-target-ids="t004 t010" x-added-target="and | it" sid="PSA 102:13" /><char style="w" x-id="WLC.PSA.102.13.001" x-align="PSA.102.13.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.102.14">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.102.13.002" x-align="PSA.102.13.a002" x-target-ids="t002 t003" x-target="wilt arise" x-target-head="t003" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi2ms" x-gloss="you.will.arise" x-translit="ṯāqûm" xml:lang="hbo" x-source-ref="PSA.102.14">תָ֭קוּם</char> <char style="w" x-id="WLC.PSA.102.13.003" x-align="PSA.102.13.a004" x-target-ids="t005 t006 t007" x-target="have mercy upon" x-target-head="t006" x-head="true" lemma="רָחַם" strong="H7355" x-morph="Vpi2ms" x-gloss="you.will.have.compassion.on" x-translit="təraḥēm" xml:lang="hbo" x-source-ref="PSA.102.14">תְּרַחֵ֣ם</char> <char style="w" x-id="WLC.PSA.102.13.004" x-align="PSA.102.13.a005" x-target-ids="t008" x-target="Zion" x-target-head="t008" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="Zion" x-translit="ṣiyyôn" xml:lang="hbo" x-source-ref="PSA.102.14">צִיּ֑וֹן</char> <char style="w" x-id="WLC.PSA.102.13.005" x-align="PSA.102.13.a006" x-target-ids="t009" x-target="For" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo" x-source-ref="PSA.102.14">כִּי</char>־<char style="w" x-id="WLC.PSA.102.13.006" x-align="PSA.102.13.a008" x-target-ids="t011 t012" x-target="is time" x-target-head="t012" x-head="true" lemma="עֵת" strong="H6256" x-morph="Ncbsa" x-gloss="[it.is].the.time" x-translit="ʿēṯ" xml:lang="hbo" x-source-ref="PSA.102.14">עֵ֥ת</char> <char style="w" x-id="WLC.PSA.102.13.007" x-align="PSA.102.13.a009" x-target-ids="t013" x