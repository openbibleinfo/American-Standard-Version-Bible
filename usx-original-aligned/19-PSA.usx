	<para style="p"><verse number="2" style="v" x-ref="PSA.9.2" sid="PSA 9:2" /><char style="w" x-id="WLC.PSA.9.2.001" x-align="PSA.9.2.a001" x-target-ids="t001 t002 t003 t004" x-target="I will be glad" x-target-head="t004" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqh1cs" x-gloss="I.will.rejoice" x-translit="ʾeśməḥāh" xml:lang="hbo" x-source-ref="PSA.9.3">אֶשְׂמְחָ֣ה</char> <char style="w" x-id="WLC.PSA.9.2.002" x-align="PSA.9.2.a002" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.9.3">וְ</char><char style="w" x-id="WLC.PSA.9.2.003" x-align="PSA.9.2.a003" x-target-ids="t006" x-target="exult" x-target-head="t006" x-head="true" lemma="עָלַץ" strong="H5970" x-morph="Vqh1cs" x-gloss="I.will.exult" x-translit="ʾeʿelṣāh" xml:lang="hbo" x-source-ref="PSA.9.3">אֶעֶלְצָ֣ה</char> <char style="w" x-id="WLC.PSA.9.2.004" x-align="PSA.9.2.a004" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇ" xml:lang="hbo" x-source-ref="PSA.9.3">בָ֑</char><char style="w" x-id="WLC.PSA.9.2.005" x-align="PSA.9.2.a005" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo" x-source-ref="PSA.9.3">ךְ</char> <char style="w" x-id="WLC.PSA.9.2.006" x-align="PSA.9.2.a006" x-target-ids="t009 t010 t011 t012 t013" x-target="I will sing praise to" x-target-head="t012" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vph1cs" x-gloss="I.will.sing.praises.to" x-translit="ʾăzammərāh" xml:lang="hbo" x-source-ref="PSA.9.3">אֲזַמְּרָ֖ה</char> <char style="w" x-id="WLC.PSA.9.2.007" x-align="PSA.9.2.a007" x-target-ids="t015" x-target="name" x-target-head="t015" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šim" xml:lang="hbo" x-source-ref="PSA.9.3">שִׁמְ<