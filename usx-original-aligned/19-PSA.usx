	<para style="p"><verse number="2" style="v" x-ref="PSA.128.2" sid="PSA 128:2" /><char style="w" x-id="WLC.PSA.128.2.001" x-align="PSA.128.2.a003" x-target-ids="t005 t006" x-target="the labor" x-target-head="t006" x-head="true" lemma="יְגִיעַ" strong="H3018" x-morph="Ncmsc" x-gloss="the.toil" x-translit="yəḡiyᵃʿ" xml:lang="hbo">יְגִ֣יעַ</char> <char style="w" x-id="WLC.PSA.128.2.002" x-align="PSA.128.2.a004" x-target-ids="t007 t009" x-target="of hands" x-target-head="t009" x-head="true" lemma="כַּף" strong="H3709" x-morph="Ncfdc" x-gloss="your.hands" x-translit="kappey" xml:lang="hbo">כַּ֭פֶּי</char><char style="w" x-id="WLC.PSA.128.2.003" x-align="PSA.128.2.a005" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.128.2.004" x-align="PSA.128.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PSA.128.2.005" x-align="PSA.128.2.a002" x-target-ids="t002 t003 t004" x-target="thou shalt eat" x-target-head="t004" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqi2ms" x-gloss="you.will.eat" x-translit="ṯōʾḵēl" xml:lang="hbo">תֹאכֵ֑ל</char> <char style="w" x-id="WLC.PSA.128.2.006" x-align="PSA.128.2.a006" x-target-ids="t010 t011 t013" x-target="Happy shalt be" x-target-head="t010" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpc" x-gloss="how" x-translit="ʾašrey" xml:lang="hbo">אַ֝שְׁרֶ֗י</char><char style="w" x-id="WLC.PSA.128.2.007" x-align="PSA.128.2.a007" x-target-ids="t012" x-target="thou" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="blessed.[are].you!" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.128.2.008" x-align="PSA.128.2.a008" x-target-ids="t014" x-target="and" x-target-head="t014" x-