	<para style="p"><verse number="32" style="v" x-ref="PSA.106.32" x-added-alignments="PSA.106.32.a003" x-added-target-ids="t003" x-added-target="him" sid="PSA 106:32" /><char style="w" x-id="WLC.PSA.106.32.001" x-align="PSA.106.32.a001" x-target-ids="t004" x-target="also" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֭</char><char style="w" x-id="WLC.PSA.106.32.002" x-align="PSA.106.32.a002" x-target-ids="t001 t002" x-target="They angered" x-target-head="t002" x-head="true" lemma="קָצַף" strong="H7107" x-morph="Vhw3mp" x-gloss="they.provoked.[him].to.anger" x-translit="yyaqṣîp̄û" xml:lang="hbo">יַּקְצִיפוּ</char> <char style="w" x-id="WLC.PSA.106.32.003" x-align="PSA.106.32.a004" x-target-ids="t005" x-target="at" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="at" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.106.32.004" x-align="PSA.106.32.a005" x-target-ids="t006 t007" x-target="the waters" x-target-head="t007" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpc" x-gloss="the.waters" x-translit="mēy" xml:lang="hbo">מֵ֥י</char> <char style="w" x-id="WLC.PSA.106.32.005" x-align="PSA.106.32.a006" x-target-ids="t008 t009" x-target="of Meribah" x-target-head="t009" x-head="true" lemma="מְרִיבָה" strong="H4809" x-morph="Np" x-gloss="of.Meribah" x-translit="mərîḇāh" xml:lang="hbo">מְרִיבָ֑ה</char> <char style="w" x-id="WLC.PSA.106.32.006" x-align="PSA.106.32.a007" x-target-ids="t010 t011" x-target="So that" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.106.32.007" x-align="PSA.106.32.a008" x-target-ids="t012 t013 t014" x-target="it went ill" x-target-head="t014" x-head="true" lemma="רָעַע" strong="H7489" x-morph="Vqw3ms" x-gloss="it.was.bad" x-translit="yyēraʿ" xml:lang="hbo">יֵּ֥רַע</char> <char style="w" x-id="WLC.PSA.