	<para style="p"><verse number="21" style="v" x-ref="PSA.73.21" sid="PSA 73:21" /><char style="w" x-id="WLC.PSA.73.21.001" x-align="PSA.73.21.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּ֭י</char> <char style="w" x-id="WLC.PSA.73.21.002" x-align="PSA.73.21.a004" x-target-ids="t004 t005" x-target="was grieved" x-target-head="t005" x-head="true" lemma="חָמֵץ" strong="H2556" x-morph="Vti3ms" x-gloss="it.was.embittered" x-translit="yiṯḥammēṣ" xml:lang="hbo">יִתְחַמֵּ֣ץ</char> <char style="w" x-id="WLC.PSA.73.21.003" x-align="PSA.73.21.a003" x-target-ids="t003" x-target="soul" x-target-head="t003" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsc" x-gloss="heart" x-translit="ləḇāḇ" xml:lang="hbo">לְבָבִ֑</char><char style="w" x-id="WLC.PSA.73.21.004" x-align="PSA.73.21.a002" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.73.21.005" x-align="PSA.73.21.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.73.21.006" x-align="PSA.73.21.a007" x-target-ids="t010 t012" x-target="in heart" x-target-head="t012" x-head="true" lemma="כִּלְיָה" strong="H3629" x-morph="Ncfpc" x-gloss="kidneys" x-translit="ḵilyôṯ" xml:lang="hbo">כִלְיוֹתַ֗</char><char style="w" x-id="WLC.PSA.73.21.007" x-align="PSA.73.21.a008" x-target-ids="t011" x-target="my" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.73.21.008" x-align="PSA.73.21.a006" x-target-ids="t007 t008 t009" x-target="I was pricked" x-target-head="t009" x-head="true" lemma="שָׁנַן" strong="H8150" x-morph="Vr