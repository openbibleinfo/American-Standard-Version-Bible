	<para style="p"><verse number="10" style="v" x-ref="PSA.57.10" sid="PSA 57:10" /><char style="w" x-id="WLC.PSA.57.10.001" x-align="PSA.57.10.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.57.11">כִּֽי</char>־<char style="w" x-id="WLC.PSA.57.10.002" x-align="PSA.57.10.a004" x-target-ids="t004 t005" x-target="is great" x-target-head="t005" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="[is].great" x-translit="ḡāḏōl" xml:lang="hbo" x-source-ref="PSA.57.11">גָדֹ֣ל</char> <char style="w" x-id="WLC.PSA.57.10.003" x-align="PSA.57.10.a005" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="to" x-translit="ʿaḏ-" xml:lang="hbo" x-source-ref="PSA.57.11">עַד</char>־<char style="w" x-id="WLC.PSA.57.10.004" x-align="PSA.57.10.a006" x-target-ids="t007 t008" x-target="the heavens" x-target-head="t008" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="[the].heavens" x-translit="šāmayim" xml:lang="hbo" x-source-ref="PSA.57.11">שָׁמַ֣יִם</char> <char style="w" x-id="WLC.PSA.57.10.005" x-align="PSA.57.10.a003" x-target-ids="t003" x-target="lovingkindness" x-target-head="t003" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo" x-source-ref="PSA.57.11">חַסְדֶּ֑</char><char style="w" x-id="WLC.PSA.57.10.006" x-align="PSA.57.10.a002" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.covenant" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.57.11">ךָ</char> <char style="w" x-id="WLC.PSA.57.10.007" x-align="PSA.57.10.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.57.11">וְֽ</char><c