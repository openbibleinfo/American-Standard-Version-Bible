	<para style="p"><verse number="1" style="v" x-ref="PSA.80.1" sid="PSA 80:1" /><char style="w" x-id="WLC.PSA.80.1.001" x-align="PSA.80.1.a001" x-target-ids="t003 t004" x-target="O Shepherd" x-target-head="t004" x-head="true" lemma="רָעָה" strong="H7473" x-morph="Vqrmsc" x-gloss="O.shepherd" x-translit="rōʿēh" xml:lang="hbo" x-source-ref="PSA.80.2">רֹ֘עֵ֤ה</char> <char style="w" x-id="WLC.PSA.80.1.002" x-align="PSA.80.1.a002" x-target-ids="t005 t006" x-target="of Israel" x-target-head="t006" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo" x-source-ref="PSA.80.2">יִשְׂרָאֵ֨ל</char>׀<char style="w" x-id="WLC.PSA.80.1.003" x-align="PSA.80.1.a003" x-target-ids="t001 t002" x-target="Give ear" x-target-head="t002" x-head="true" lemma="אָזַן" strong="H238" x-morph="Vhv2ms" x-gloss="give" x-translit="haʾăziyn" xml:lang="hbo" x-source-ref="PSA.80.2">הַאֲזִ֗ינָ</char><char style="w" x-id="WLC.PSA.80.1.004" x-align="PSA.80.1.a004" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-gloss="ear" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.80.2">ה</char> <char style="w" x-id="WLC.PSA.80.1.005" x-align="PSA.80.1.a005" x-target-ids="t007 t008 t009" x-target="Thou that leadest" x-target-head="t009" x-head="true" lemma="נָהַג" strong="H5090" x-morph="Vqrmsa" x-gloss="O.[you.who].lead" x-translit="nōhēḡ" xml:lang="hbo" x-source-ref="PSA.80.2">נֹהֵ֣ג</char> <char style="w" x-id="WLC.PSA.80.1.006" x-align="PSA.80.1.a006" x-target-ids="t011" x-target="like" x-target-head="t011" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ka" xml:lang="hbo" x-source-ref="PSA.80.2">כַּ</char><char style="w" x-id="WLC.PSA.80.1.007" x-align="PSA.80.1.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.80.2">[הַ]</char><char style="w" x-id="WLC.PSA.80.1.008" x-align="PSA.80