	<para style="p"><verse number="1" style="v" x-ref="PSA.58.1" sid="PSA 58:1" /><char style="w" x-id="WLC.PSA.58.1.001" x-align="PSA.58.1.a001" x-target-ids="t001 t008" x-target="Do Do" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.58.2">הַֽ</char><char style="w" x-id="WLC.PSA.58.1.002" x-align="PSA.58.1.a002" x-target-ids="t003" x-target="indeed" x-target-head="t003" x-head="true" lemma="אֻמְנָם" strong="H552" x-morph="D" x-gloss="really" x-translit="ʾumnām" xml:lang="hbo" x-source-ref="PSA.58.2">אֻמְנָ֗ם</char> <char style="w" x-id="WLC.PSA.58.1.003" x-align="PSA.58.1.a003" x-target-ids="t004 t005" x-target="in silence" x-target-head="t005" x-head="true" lemma="אֵלֶם" strong="H482" x-morph="Ncmsa" x-gloss="silence" x-translit="ʾēlem" xml:lang="hbo" x-source-ref="PSA.58.2">אֵ֣לֶם</char> <char style="w" x-id="WLC.PSA.58.1.004" x-align="PSA.58.1.a004" x-target-ids="t007" x-target="righteousness" x-target-head="t007" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="of.righteousness" x-translit="ṣeḏeq" xml:lang="hbo" x-source-ref="PSA.58.2">צֶ֭דֶק</char> <char style="w" x-id="WLC.PSA.58.1.005" x-align="PSA.58.1.a005" x-target-ids="t002 t006" x-target="ye speak" x-target-head="t006" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpi2mp" x-gloss="do" x-translit="təḏabbērû" xml:lang="hbo" x-source-ref="PSA.58.2">תְּדַבֵּר֑וּ</char><char style="w" x-id="WLC.PSA.58.1.006" x-align="PSA.58.1.a006" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="you.speak" x-translit="n" xml:lang="hbo" x-source-ref="PSA.58.2">ן</char> <char style="w" x-id="WLC.PSA.58.1.007" x-align="PSA.58.1.a007" x-target-ids="t011" x-target="uprightly" x-target-head="t011" x-head="true" lemma="מֵישָׁרִים" strong="H4339" x-morph="Ncmpa" x-gloss="uprightness(es)" x-translit="mêšāriym" xml:lang="hbo" x-source-ref="PSA.58.2">מֵישָׁרִ֥ים</char> <char style="w" x-i