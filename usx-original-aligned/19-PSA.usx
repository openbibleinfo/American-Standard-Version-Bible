	<para style="p"><verse number="33" style="v" x-ref="PSA.107.33" sid="PSA 107:33" /><char style="w" x-id="WLC.PSA.107.33.001" x-align="PSA.107.33.a001" x-target-ids="t001 t002" x-target="He turneth" x-target-head="t002" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqi3ms" x-gloss="he.made" x-translit="yāśēm" xml:lang="hbo">יָשֵׂ֣ם</char> <char style="w" x-id="WLC.PSA.107.33.002" x-align="PSA.107.33.a002" x-target-ids="t003" x-target="rivers" x-target-head="t003" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmpa" x-gloss="rivers" x-translit="nəhārôṯ" xml:lang="hbo">נְהָר֣וֹת</char> <char style="w" x-id="WLC.PSA.107.33.003" x-align="PSA.107.33.a003" x-target-ids="t004" x-target="into" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="into" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.107.33.004" x-align="PSA.107.33.a004" x-target-ids="t005 t006" x-target="a wilderness" x-target-head="t006" x-head="true" lemma="מִדְבָּר" strong="H4057" x-morph="Ncmsa" x-gloss="a.wilderness" x-translit="miḏbār" xml:lang="hbo">מִדְבָּ֑ר</char> <char style="w" x-id="WLC.PSA.107.33.005" x-align="PSA.107.33.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.107.33.006" x-align="PSA.107.33.a006" x-status="noncompositional" x-target-ids="t008" x-target="watersprings" x-target-head="t008" x-head="true" lemma="מוֹצָא" strong="H4161" x-morph="Ncmpc" x-gloss="springs" x-translit="mōṣāʾê" xml:lang="hbo">מֹצָ֥אֵי</char> <char style="w" x-id="WLC.PSA.107.33.007" x-align="PSA.107.33.a006" x-status="noncompositional" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="of.water" x-translit="mayim" xml:lang="hbo">מַ֝֗יִם</char> <char style="w" x-id="WLC.PSA.107.33.008" x-align="PSA.107.33.a007" x-target-ids="t009" x-target="into" x-target-head="t009" x-head="true" lemma="לְ" strong="H38