	<para style="p"><verse number="4" style="v" x-ref="PSA.138.4" sid="PSA 138:4" /><char style="w" x-id="WLC.PSA.138.4.001" x-align="PSA.138.4.a001" x-target-ids="t007 t008 t010" x-target="shall give thanks" x-target-head="t010" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi3mp" x-gloss="they" x-translit="yôḏû" xml:lang="hbo">יוֹד֣וּ</char><char style="w" x-id="WLC.PSA.138.4.002" x-align="PSA.138.4.a002" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.138.4.003" x-align="PSA.138.4.a003" x-target-ids="t011 t012" x-target="O Jehovah" x-target-head="t012" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.138.4.004" x-align="PSA.138.4.a004" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.138.4.005" x-align="PSA.138.4.a005" x-target-ids="t002 t003" x-target="the kings" x-target-head="t003" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmpc" x-gloss="[the].kings" x-translit="malḵê-" xml:lang="hbo">מַלְכֵי</char>־<char style="w" x-id="WLC.PSA.138.4.006" x-align="PSA.138.4.a006" x-target-ids="t004 t005 t006" x-target="of the earth" x-target-head="t006" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.[the].earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.PSA.138.4.007" x-align="PSA.138.4.a007" x-target-ids="t013" x-target="For" x-target-head="t013" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.PSA.138.4.008" x-align="PSA.138.4.a008" x-target-ids="t014 t015 t016" x-target="they have heard" x-ta