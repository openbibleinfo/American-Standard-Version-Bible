	<para style="p"><verse number="176" style="v" x-ref="PSA.119.176" sid="PSA 119:176" /><char style="w" x-id="WLC.PSA.119.176.001" x-align="PSA.119.176.a001" x-target-ids="t001 t002 t003 t004" x-target="I have gone astray" x-target-head="t004" x-head="true" lemma="תָּעָה" strong="H8582" x-morph="Vqp1cs" x-gloss="I.have.gone.astray" x-translit="tāʿiyṯî" xml:lang="hbo">תָּעִ֗יתִי</char> <char style="w" x-id="WLC.PSA.119.176.002" x-align="PSA.119.176.a002" x-target-ids="t005" x-target="like" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.PSA.119.176.003" x-align="PSA.119.176.a003" x-target-ids="t006 t008" x-target="a sheep" x-target-head="t008" x-head="true" lemma="שֶׂה" strong="H7716" x-morph="Ncbsa" x-gloss="a.sheep" x-translit="śeh" xml:lang="hbo">שֶׂ֣ה</char> <char style="w" x-id="WLC.PSA.119.176.004" x-align="PSA.119.176.a004" x-target-ids="t007" x-target="lost" x-target-head="t007" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqrmsa" x-gloss="lost" x-translit="ʾōḇēḏ" xml:lang="hbo">אֹ֭בֵד</char> <char style="w" x-id="WLC.PSA.119.176.005" x-align="PSA.119.176.a005" x-target-ids="t009" x-target="seek" x-target-head="t009" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vpv2ms" x-gloss="seek" x-translit="baqqēš" xml:lang="hbo">בַּקֵּ֣שׁ</char> <char style="w" x-id="WLC.PSA.119.176.006" x-align="PSA.119.176.a006" x-target-ids="t011" x-target="servant" x-target-head="t011" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo">עַבְדֶּ֑</char><char style="w" x-id="WLC.PSA.119.176.007" x-align="PSA.119.176.a007" x-target-ids="t010" x-target="thy" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.176.008" x-align="PSA.119.176.a008" x-target-ids="t012" x-target="For" x-target-head="