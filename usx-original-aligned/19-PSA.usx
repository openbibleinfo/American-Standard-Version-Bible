	<para style="p"><verse number="1" style="v" x-ref="PSA.66.1" sid="PSA 66:1" /><char style="w" x-id="WLC.PSA.66.1.001" x-align="PSA.66.1.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ֭</char><char style="w" x-id="WLC.PSA.66.1.002" x-align="PSA.66.1.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.66.1.003" x-align="PSA.66.1.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo">מְנַצֵּחַ</char> <char style="w" x-id="WLC.PSA.66.1.004" x-align="PSA.66.1.a004" x-target-ids="t005 t006" x-target="A Song" x-target-head="t006" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsa" x-gloss="a.song" x-translit="šiyr" xml:lang="hbo">שִׁ֣יר</char> <char style="w" x-id="WLC.PSA.66.1.005" x-align="PSA.66.1.a005" x-target-ids="t007 t008" x-target="a Psalm" x-target-head="t008" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo">מִזְמ֑וֹר</char><char style="w" x-id="WLC.PSA.66.1.006" x-align="PSA.66.1.a006" x-target-ids="t009 t010 t011 t012" x-target="Make a joyful noise" x-target-head="t012" x-head="true" lemma="רוּעַ" strong="H7321" x-morph="Vhv2mp" x-gloss="shout.for.joy" x-translit="hāriyʿû" xml:lang="hbo">הָרִ֥יעוּ</char> <char style="w" x-id="WLC.PSA.66.1.007" x-align="PSA.66.1.a007" x-target-ids="t013" x-target="unto" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo">לֵ֝</char><char style="w" x-id="WLC.PSA.66.1.008" x-align="PSA.66.1.a008" x-target-ids="t014" x-target="God" x-target-head="t014" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾlōhîm" xml:lang="hbo">אלֹהִים</char> <char style="w" x-id="WLC.PSA.66.1.009" x-align="PSA.66.1.a009" x-target-ids="t015" x-target="all" x-target-head="t015" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="O.all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.66.1.010" x-align="PSA.66.1.a010" x-target-ids="t016" x-target="the" x-target-head="t016" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.PSA.66.1.011" x-align="PSA.66.1.a011" x-target-ids="t017" x-target="earth" x-target-head="t017" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ:" xml:lang="hbo">אָֽרֶץ</char>׃<verse eid="PSA 66:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="PSA.66.2" sid="PSA 66:2" /><char style="w" x-id="WLC.PSA.66.2.001" x-align="PSA.66.2.a001" x-target-ids="t001 t002" x-target="Sing forth" x-target-head="t001" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vpv2mp" x-gloss="sing.praises" x-translit="zammərû" xml:lang="hbo">זַמְּר֥וּ</char> <char style="w" x-id="WLC.PSA.66.2.002" x-align="PSA.66.2.a002" x-target-ids="t003 t004" x-target="the glory" x-target-head="t004" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="the.glory" x-translit="ḵəḇôḏ-" xml:lang="hbo">כְבֽוֹד</char>־<char style="w" x-id="WLC.PSA.66.2.003" x-align="PSA.66.2.a003" x-target-ids="t005 t007" x-target="of name" x-target-head="t007" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="his.name" x-translit="šəm" xml:lang="hbo">שְׁמ֑</char><char style="w" x-id="WLC.PSA.66.2.004" x-align="PSA.66.2.a004" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.66.2.005" x-align="PSA.66.2.a005" x-target-ids="t008" x-target="Make" x-target-head="t008" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqv2mp" x-gloss="make" x-translit="śiymû" xml:lang="hbo">שִׂ֥ימוּ</char> <char style="w" x-id="WLC.PSA.66.2.006" x-align="PSA.66.2.a006" x-target-ids="t011" x-target="glorious" x-target-head="t011" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="glory" x-translit="ḵāḇôḏ" xml:lang="hbo">כָ֝ב֗וֹד</char> <char style="w" x-id="WLC.PSA.66.2.007" x-align="PSA.66.2.a007" x-target-ids="t010" x-target="praise" x-target-head="t010" x-head="true" lemma="תְּהִלָּה" strong="H8416" x-morph="Ncfsc" x-gloss="praise" x-translit="təhillāṯ" xml:lang="hbo">תְּהִלָּתֽ</char><char style="w" x-id="WLC.PSA.66.2.008" x-align="PSA.66.2.a008" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong=