	<para style="p"><verse number="8" style="v" x-ref="PSA.76.8" sid="PSA 76:8" /><char style="w" x-id="WLC.PSA.76.8.001" x-align="PSA.76.8.a003" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.76.9">מִ֭</char><char style="w" x-id="WLC.PSA.76.8.002" x-align="PSA.76.8.a004" x-target-ids="t009" x-target="heaven" x-target-head="t009" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heaven" x-translit="ššāmayim" xml:lang="hbo" x-source-ref="PSA.76.9">שָּׁמַיִם</char> <char style="w" x-id="WLC.PSA.76.8.003" x-align="PSA.76.8.a001" x-target-ids="t001 t002 t003 t005 t006 t007" x-target="Thou didst cause to be heard" x-target-head="t007" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vhp2ms" x-gloss="you.proclaimed" x-translit="hišmaʿətā" xml:lang="hbo" x-source-ref="PSA.76.9">הִשְׁמַ֣עְתָּ</char> <char style="w" x-id="WLC.PSA.76.8.004" x-align="PSA.76.8.a002" x-target-ids="t004" x-target="sentence" x-target-head="t004" x-head="true" lemma="דִּין" strong="H1779" x-morph="Ncmsa" x-gloss="judgment" x-translit="diyn" xml:lang="hbo" x-source-ref="PSA.76.9">דִּ֑ין</char> <char style="w" x-id="WLC.PSA.76.8.005" x-align="PSA.76.8.a005" x-target-ids="t010 t011" x-target="The earth" x-target-head="t011" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].earth" x-translit="ʾereṣ" xml:lang="hbo" x-source-ref="PSA.76.9">אֶ֖רֶץ</char> <char style="w" x-id="WLC.PSA.76.8.006" x-align="PSA.76.8.a006" x-target-ids="t012" x-target="feared" x-target-head="t012" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqp3fs" x-gloss="it.was.afraid" x-translit="yārəʾāh" xml:lang="hbo" x-source-ref="PSA.76.9">יָֽרְאָ֣ה</char> <char style="w" x-id="WLC.PSA.76.8.007" x-align="PSA.76.8.a007" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml: