	<para style="p"><verse number="3" style="v" x-ref="PSA.26.3" sid="PSA 26:3" /><char style="w" x-id="WLC.PSA.26.3.001" x-align="PSA.26.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.26.3.002" x-align="PSA.26.3.a002" x-target-ids="t003" x-target="lovingkindness" x-target-head="t003" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo">חַ֭סְדְּ</char><char style="w" x-id="WLC.PSA.26.3.003" x-align="PSA.26.3.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.covenant" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.26.3.004" x-align="PSA.26.3.a004" x-target-ids="t004 t005" x-target="is before" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.26.3.005" x-align="PSA.26.3.a004" lemma="נֶגֶד" strong="H5048" x-morph="R" x-gloss="before" x-translit="neḡeḏ" xml:lang="hbo">נֶ֣גֶד</char> <char style="w" x-id="WLC.PSA.26.3.006" x-align="PSA.26.3.a005" x-target-ids="t007" x-target="eyes" x-target-head="t007" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿēyn" xml:lang="hbo">עֵינָ֑</char><char style="w" x-id="WLC.PSA.26.3.007" x-align="PSA.26.3.a006" x-target-ids="t006" x-target="mine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.26.3.008" x-align="PSA.26.3.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.26.3.009" x-align="PSA.26.3.a008" x-targe