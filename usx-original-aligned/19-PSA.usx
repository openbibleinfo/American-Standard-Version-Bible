	<para style="p"><verse number="1" style="v" x-ref="PSA.37.1" x-added-alignments="PSA.37.1.a001" x-added-target-ids="t001 t002" x-added-target="A Psalm" sid="PSA 37:1" /><char style="w" x-id="WLC.PSA.37.1.001" x-align="PSA.37.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.37.1.002" x-align="PSA.37.1.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָוִ֨ד</char><char style="w" x-id="WLC.PSA.37.1.003" x-align="PSA.37.1.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PSA.37.1.004" x-align="PSA.37.1.a005" x-target-ids="t005 t007" x-target="Fret thyself" x-target-head="t005" x-head="true" lemma="חָרָה" strong="H2734" x-morph="Vtj2ms" x-gloss="fret.yourself" x-translit="tiṯḥar" xml:lang="hbo">תִּתְחַ֥ר</char> <char style="w" x-id="WLC.PSA.37.1.005" x-align="PSA.37.1.a006" x-target-ids="t008 t009" x-target="because of" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.37.1.006" x-align="PSA.37.1.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.37.1.007" x-align="PSA.37.1.a008" x-target-ids="t010 t011" x-target="evil doers" x-target-head="t010" x-head="true" lemma="רָעַע" strong="H7489" x-morph="Vhrmpa" x-gloss="evil-doers" x-translit="mmərēʿiym" xml:lang="hbo">מְּרֵעִ֑ים</char> <char style="w" x-id="WLC.PSA.37.1.008" x-align="PSA.37.1.a009" x-target-ids="t012" x-target="Neither" x-target-head="t012" x-head="true" lemma="אַל"