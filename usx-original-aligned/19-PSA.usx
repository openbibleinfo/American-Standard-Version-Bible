	<para style="p"><verse number="23" style="v" x-ref="PSA.89.23" sid="PSA 89:23" /><char style="w" x-id="WLC.PSA.89.23.001" x-align="PSA.89.23.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.89.24">וְ</char><char style="w" x-id="WLC.PSA.89.23.002" x-align="PSA.89.23.a002" x-target-ids="t002 t003 t004 t005" x-target="I will beat down" x-target-head="t004" x-head="true" lemma="כָּתַת" strong="H3807" x-morph="Vqp1cs" x-gloss="I.will.crush" x-translit="ḵattôṯiy" xml:lang="hbo" x-source-ref="PSA.89.24">כַתּוֹתִ֣י</char> <char style="w" x-id="WLC.PSA.89.23.003" x-align="PSA.89.23.a003" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.89.24">מִ</char><char style="w" x-id="WLC.PSA.89.23.004" x-align="PSA.89.23.a003" x-target-ids="t008" x-target="before" x-target-head="t008" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="before" x-translit="pānāy" xml:lang="hbo" x-source-ref="PSA.89.24">פָּנָ֣י</char><char style="w" x-id="WLC.PSA.89.23.005" x-align="PSA.89.23.a004" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="w" xml:lang="hbo" x-source-ref="PSA.89.24">ו</char> <char style="w" x-id="WLC.PSA.89.23.006" x-align="PSA.89.23.a005" x-target-ids="t007" x-target="adversaries" x-target-head="t007" x-head="true" lemma="צַר" strong="H6862a" x-morph="Ncmpc" x-gloss="foes" x-translit="ṣārāy" xml:lang="hbo" x-source-ref="PSA.89.24">צָרָ֑י</char><char style="w" x-id="WLC.PSA.89.23.007" x-align="PSA.89.23.a006" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="PSA.89.24">ו</char> <char style="w" x-id="WLC.PSA.89.23.008" x-align="PSA.89.23.a007" x-target-ids="t010" x-target="A