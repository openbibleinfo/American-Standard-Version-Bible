	<para style="p"><verse number="7" style="v" x-ref="PSA.31.7" sid="PSA 31:7" /><char style="w" x-id="WLC.PSA.31.7.001" x-align="PSA.31.7.a001" x-target-ids="t001 t002 t003 t004" x-target="I will be glad" x-target-head="t004" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqh1cs" x-gloss="I.will.be.glad" x-translit="ʾāḡiylâ" xml:lang="hbo" x-source-ref="PSA.31.8">אָגִ֥ילָה</char> <char style="w" x-id="WLC.PSA.31.7.002" x-align="PSA.31.7.a002" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.31.8">וְ</char><char style="w" x-id="WLC.PSA.31.7.003" x-align="PSA.31.7.a003" x-target-ids="t006" x-target="rejoice" x-target-head="t006" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqh1cs" x-gloss="I.will.rejoice" x-translit="ʾeśməḥāh" xml:lang="hbo" x-source-ref="PSA.31.8">אֶשְׂמְחָ֗ה</char> <char style="w" x-id="WLC.PSA.31.7.004" x-align="PSA.31.7.a004" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.31.8">בְּ</char><char style="w" x-id="WLC.PSA.31.7.005" x-align="PSA.31.7.a005" x-target-ids="t009" x-target="lovingkindness" x-target-head="t009" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="your.covenant" x-translit="ḥasd" xml:lang="hbo" x-source-ref="PSA.31.8">חַ֫סְדֶּ֥</char><char style="w" x-id="WLC.PSA.31.7.006" x-align="PSA.31.7.a006" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="loyalty" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.31.8">ךָ</char> <char style="w" x-id="WLC.PSA.31.7.007" x-align="PSA.31.7.a007" x-target-ids="t010" x-target="For" x-target-head="t010" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="that" x-translit="ʾăšer" xml:lang="hbo" x-source-ref="PSA.31.8">אֲשֶׁ֣ר</char> <char st