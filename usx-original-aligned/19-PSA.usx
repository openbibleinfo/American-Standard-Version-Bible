	<para style="p"><verse number="3" style="v" x-ref="PSA.52.3" x-added-alignments="PSA.52.3.a005" x-added-target-ids="t007" x-added-target="And" sid="PSA 52:3" /><char style="w" x-id="WLC.PSA.52.3.001" x-align="PSA.52.3.a001" x-target-ids="t001 t002" x-target="Thou lovest" x-target-head="t002" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqp2ms" x-gloss="you.love" x-translit="ʾāhaḇətā" xml:lang="hbo" x-source-ref="PSA.52.5">אָהַ֣בְתָּ</char> <char style="w" x-id="WLC.PSA.52.3.002" x-align="PSA.52.3.a002" x-target-ids="t003" x-target="evil" x-target-head="t003" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="evil" x-translit="rrāʿ" xml:lang="hbo" x-source-ref="PSA.52.5">רָּ֣ע</char> <char style="w" x-id="WLC.PSA.52.3.003" x-align="PSA.52.3.a003" x-target-ids="t004 t005" x-target="more than" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.52.5">מִ</char><char style="w" x-id="WLC.PSA.52.3.004" x-align="PSA.52.3.a004" x-target-ids="t006" x-target="good" x-target-head="t006" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="than.good" x-translit="ṭṭôḇ" xml:lang="hbo" x-source-ref="PSA.52.5">טּ֑וֹב</char> <char style="w" x-id="WLC.PSA.52.3.005" x-align="PSA.52.3.a006" x-target-ids="t008" x-target="lying" x-target-head="t008" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="falsehood" x-translit="šeqer" xml:lang="hbo" x-source-ref="PSA.52.5">שֶׁ֓קֶר</char>׀<char style="w" x-id="WLC.PSA.52.3.006" x-align="PSA.52.3.a007" x-target-ids="t009 t010" x-target="rather than" x-target-head="t010" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.52.5">מִ</char><char style="w" x-id="WLC.PSA.52.3.007" x-align="PSA.52.3.a008" x-target-ids="t011 t012" x-target="to speak" x-target-head="t012" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpc" x-gloss="than.speaking" x-