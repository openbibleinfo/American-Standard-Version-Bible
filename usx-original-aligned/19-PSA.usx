	<para style="p"><verse number="24" style="v" x-ref="PSA.118.24" x-added-alignments="PSA.118.24.a004" x-added-target-ids="t005" x-added-target="which" sid="PSA 118:24" /><char style="w" x-id="WLC.PSA.118.24.001" x-align="PSA.118.24.a001" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh-" xml:lang="hbo">זֶה</char>־<char style="w" x-id="WLC.PSA.118.24.002" x-align="PSA.118.24.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[is].the" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PSA.118.24.003" x-align="PSA.118.24.a003" x-target-ids="t002 t004" x-target="is day" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּוֹם</char> <char style="w" x-id="WLC.PSA.118.24.004" x-align="PSA.118.24.a005" x-target-ids="t007 t008" x-target="hath made" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3ms" x-gloss="[which].he.has.made" x-translit="ʿāśāh" xml:lang="hbo">עָשָׂ֣ה</char> <char style="w" x-id="WLC.PSA.118.24.005" x-align="PSA.118.24.a006" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.118.24.006" x-align="PSA.118.24.a007" x-target-ids="t009 t010 t011" x-target="We will rejoice" x-target-head="t011" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqh1cp" x-gloss="let.us.be.glad" x-translit="nāḡiylâ" xml:lang="hbo">נָגִ֖ילָה</char> <char style="w" x-id="WLC.PSA.118.24.007" x-align="PSA.118.24.a008" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.118.24.008" x-align="PSA.118.24