	<para style="p"><verse number="7" style="v" x-ref="PSA.119.7" sid="PSA 119:7" /><char style="w" x-id="WLC.PSA.119.7.001" x-align="PSA.119.7.a001" x-target-ids="t001 t002 t003 t004" x-target="I will give thanks" x-target-head="t003" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo">א֭וֹדְ</char><char style="w" x-id="WLC.PSA.119.7.002" x-align="PSA.119.7.a002" x-target-ids="t005 t006" x-target="unto thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.7.003" x-align="PSA.119.7.a003" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.7.004" x-align="PSA.119.7.a004" x-target-ids="t008" x-target="uprightness" x-target-head="t008" x-head="true" lemma="יֹשֶׁר" strong="H3476" x-morph="Ncmsc" x-gloss="uprightness" x-translit="yōšer" xml:lang="hbo">יֹ֣שֶׁר</char> <char style="w" x-id="WLC.PSA.119.7.005" x-align="PSA.119.7.a005" x-target-ids="t009 t010" x-target="of heart" x-target-head="t010" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇāḇ" xml:lang="hbo">לֵבָ֑ב</char> <char style="w" x-id="WLC.PSA.119.7.006" x-align="PSA.119.7.a006" x-target-ids="t011" x-target="When" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ֝</char><char style="w" x-id="WLC.PSA.119.7.007" x-align="PSA.119.7.a007" x-target-ids="t013" x-target="learn" x-target-head="t013" x-head="true" lemma="לָמַד" strong="H3925" x-morph="Vqc" x-gloss="learn" x-translit="lāməḏ" xml:lang="hbo">לָמְדִ֗</char><char style="w" x-id="WLC.PSA.119.7.008" x-align="PSA.119.7.a008" x-target-ids="t012" x-target="I" x-target-head="t012" x-head="true" lemma="הוּא" strong="