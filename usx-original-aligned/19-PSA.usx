	<para style="p"><verse number="5" style="v" x-ref="PSA.72.5" sid="PSA 72:5" /><char style="w" x-id="WLC.PSA.72.5.001" x-align="PSA.72.5.a001" x-target-ids="t001 t002 t003" x-target="They shall fear" x-target-head="t003" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqi3mp" x-gloss="people" x-translit="yiyrāʾû" xml:lang="hbo">יִֽירָא֥וּ</char><char style="w" x-id="WLC.PSA.72.5.002" x-align="PSA.72.5.a002" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.fear.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.72.5.003" x-align="PSA.72.5.a003" x-target-ids="t005 t008" x-target="while endureth" x-target-head="t005" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.PSA.72.5.004" x-align="PSA.72.5.a004" x-target-ids="t006 t007" x-target="the sun" x-target-head="t007" x-head="true" lemma="שֶׁמֶשׁ" strong="H8121" x-morph="Ncbsa" x-gloss="[the].sun" x-translit="šāmeš" xml:lang="hbo">שָׁ֑מֶשׁ</char> <char style="w" x-id="WLC.PSA.72.5.005" x-align="PSA.72.5.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.72.5.006" x-align="PSA.72.5.a006" lemma="לְ" strong="H3807a" x-morph="R" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.72.5.007" x-align="PSA.72.5.a006" x-target-ids="t010 t011 t012" x-target="so long as" x-target-head="t011" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="before" x-translit="p̄ənēy" xml:lang="hbo">פְנֵ֥י</char> <char style="w" x-id="WLC.PSA.72.5.008" x-align="PSA.72.5.a007" x-target-ids="t013 t014" x-target="the moon" x-target-head="t014" x-head="true" lemma="יָרֵחַ" strong="H3394" x-morph="Ncmsa" x-gloss="[the].moon" x-translit="yārēᵃḥ" xml:lang="hbo">יָ֝רֵ֗חַ</char> <