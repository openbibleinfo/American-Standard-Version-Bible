	<para style="p"><verse number="6" style="v" x-ref="PSA.116.6" sid="PSA 116:6" /><char style="w" x-id="WLC.PSA.116.6.001" x-align="PSA.116.6.a001" x-target-ids="t002" x-target="preserveth" x-target-head="t002" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[is].protecting" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֣ר</char> <char style="w" x-id="WLC.PSA.116.6.002" x-align="PSA.116.6.a002" x-target-ids="t003 t004" x-target="the simple" x-target-head="t004" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmpa" x-gloss="simple.people" x-translit="pəṯāʾyim" xml:lang="hbo">פְּתָאיִ֣ם</char> <char style="w" x-id="WLC.PSA.116.6.003" x-align="PSA.116.6.a003" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhōwāh" xml:lang="hbo">יְהֹוָ֑ה</char> <char style="w" x-id="WLC.PSA.116.6.004" x-align="PSA.116.6.a004" x-target-ids="t005 t006 t007 t008" x-target="I was brought low" x-target-head="t008" x-head="true" lemma="דָּלַל" strong="H1809" x-morph="Vqp1cs" x-gloss="I.had.become.low" x-translit="dallôṯiy" xml:lang="hbo">דַּ֝לּוֹתִ֗י</char> <char style="w" x-id="WLC.PSA.116.6.005" x-align="PSA.116.6.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.116.6.006" x-align="PSA.116.6.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="l" xml:lang="hbo">לִ֣</char><char style="w" x-id="WLC.PSA.116.6.007" x-align="PSA.116.6.a007" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.116.6.008" x-align="PSA.116.6.a008" x-target-ids="t010 t011" x-target="he saved" x-target-head="t011" x-head="true" lemma="יָשַׁע" strong="H3467