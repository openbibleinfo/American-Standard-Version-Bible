	<para style="p"><verse number="2" style="v" x-ref="PSA.65.2" sid="PSA 65:2" /><char style="w" x-id="WLC.PSA.65.2.001" x-align="PSA.65.2.a001" x-target-ids="t001 t002 t003 t004" x-target="O thou that hearest" x-target-head="t004" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqrmsc" x-gloss="O.[you.who].hear" x-translit="šōmēᵃʿ" xml:lang="hbo" x-source-ref="PSA.65.3">שֹׁמֵ֥עַ</char> <char style="w" x-id="WLC.PSA.65.2.002" x-align="PSA.65.2.a002" x-target-ids="t005" x-target="prayer" x-target-head="t005" x-head="true" lemma="תְּפִלָּה" strong="H8605" x-morph="Ncfsa" x-gloss="prayer" x-translit="təp̄illāh" xml:lang="hbo" x-source-ref="PSA.65.3">תְּפִלָּ֑ה</char> <char style="w" x-id="WLC.PSA.65.2.003" x-align="PSA.65.2.a003" x-target-ids="t006" x-target="Unto" x-target-head="t006" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="to" x-translit="ʿāḏey" xml:lang="hbo" x-source-ref="PSA.65.3">עָ֝דֶ֗י</char><char style="w" x-id="WLC.PSA.65.2.004" x-align="PSA.65.2.a004" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.65.3">ךָ</char> <char style="w" x-id="WLC.PSA.65.2.005" x-align="PSA.65.2.a005" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.65.3">כָּל</char>־<char style="w" x-id="WLC.PSA.65.2.006" x-align="PSA.65.2.a006" x-target-ids="t010" x-target="flesh" x-target-head="t010" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmsa" x-gloss="flesh" x-translit="bāśār" xml:lang="hbo" x-source-ref="PSA.65.3">בָּשָׂ֥ר</char> <char style="w" x-id="WLC.PSA.65.2.007" x-align="PSA.65.2.a007" x-target-ids="t008 t011" x-target="shall come" x-target-head="t011" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3mp" x-gloss="they.will.come" x-translit="yāḇōʾû:" xml:lang="hbo" x-source-ref="PSA.65