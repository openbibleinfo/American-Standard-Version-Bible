	<para style="p"><verse number="2" style="v" x-ref="PSA.146.2" sid="PSA 146:2" /><char style="w" x-id="WLC.PSA.146.2.001" x-align="PSA.146.2.a004" x-target-ids="t004 t005 t006" x-target="will I praise" x-target-head="t006" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vph1cs" x-gloss="I.will.praise" x-translit="ʾăhaləlāh" xml:lang="hbo">אֲהַלְלָ֣ה</char> <char style="w" x-id="WLC.PSA.146.2.002" x-align="PSA.146.2.a005" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.146.2.003" x-align="PSA.146.2.a001" x-target-ids="t001" x-target="While" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.146.2.004" x-align="PSA.146.2.a003" x-target-ids="t003" x-target="live" x-target-head="t003" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpc" x-gloss="life" x-translit="ḥay" xml:lang="hbo">חַיָּ֑</char><char style="w" x-id="WLC.PSA.146.2.005" x-align="PSA.146.2.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.146.2.006" x-align="PSA.146.2.a006" x-target-ids="t008 t009 t010 t011" x-target="I will sing praises" x-target-head="t010" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vph1cs" x-gloss="I.will.sing.praises" x-translit="ʾăzammərāh" xml:lang="hbo">אֲזַמְּרָ֖ה</char> <char style="w" x-id="WLC.PSA.146.2.007" x-align="PSA.146.2.a007" x-target-ids="t012" x-target="unto" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo">לֵֽ</char><char style="w" x-id="WLC.PSA.146.2.008" x-align="PSA.146.2.a008" x-target-ids="t014" x-target="God" x-target-head="t014" x-head="true" lemma="אֱלֹהִי