	<para style="p"><verse number="9" style="v" x-ref="PSA.109.9" sid="PSA 109:9" /><char style="w" x-id="WLC.PSA.109.9.001" x-align="PSA.109.9.a001" x-target-ids="t001 t004" x-target="Let be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3mp" x-gloss="may.they.be" x-translit="yihəyû-" xml:lang="hbo">יִֽהְיוּ</char>־<char style="w" x-id="WLC.PSA.109.9.002" x-align="PSA.109.9.a002" x-target-ids="t003" x-target="children" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="ḇānāy" xml:lang="hbo">בָנָ֥י</char><char style="w" x-id="WLC.PSA.109.9.003" x-align="PSA.109.9.a003" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.109.9.004" x-align="PSA.109.9.a004" x-target-ids="t005" x-target="fatherless" x-target-head="t005" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmpa" x-gloss="fatherless.ones" x-translit="yəṯômiym" xml:lang="hbo">יְתוֹמִ֑ים</char> <char style="w" x-id="WLC.PSA.109.9.005" x-align="PSA.109.9.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.109.9.006" x-align="PSA.109.9.a006" x-target-ids="t008" x-target="wife" x-target-head="t008" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsc" x-gloss="wife" x-translit="ʾišt" xml:lang="hbo">אִשְׁתּ</char><char style="w" x-id="WLC.PSA.109.9.007" x-align="PSA.109.9.a007" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.109.9.008" x-align="PSA.109.9.a008" x-target-ids="t009 t010" x-target="a widow" x-target-head="t010" x-head="true" lemma="אַלְמָנָה" strong="H490" x-morph="Ncfs