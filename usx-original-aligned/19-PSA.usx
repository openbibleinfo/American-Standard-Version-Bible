	<para style="p"><verse number="60" style="v" x-ref="PSA.119.60" sid="PSA 119:60" /><char style="w" x-id="WLC.PSA.119.60.001" x-align="PSA.119.60.a001" x-target-ids="t001 t002 t003" x-target="I made haste" x-target-head="t003" x-head="true" lemma="חוּשׁ" strong="H2363" x-morph="Vqp1cs" x-gloss="I.have.made.haste" x-translit="ḥaštî" xml:lang="hbo">חַ֭שְׁתִּי</char> <char style="w" x-id="WLC.PSA.119.60.002" x-align="PSA.119.60.a002" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.119.60.003" x-align="PSA.119.60.a003" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PSA.119.60.004" x-align="PSA.119.60.a004" x-target-ids="t005" x-target="delayed" x-target-head="t005" x-head="true" lemma="מָהַהּ" strong="H4102" x-morph="Vfp1cs" x-gloss="I.have.delayed" x-translit="hiṯmahmāhətî" xml:lang="hbo">הִתְמַהְמָ֑הְתִּי</char> <char style="w" x-id="WLC.PSA.119.60.005" x-align="PSA.119.60.a005" x-target-ids="t007" x-target="To" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ֝</char><char style="w" x-id="WLC.PSA.119.60.006" x-align="PSA.119.60.a006" x-target-ids="t008" x-target="observe" x-target-head="t008" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqc" x-gloss="keep" x-translit="šəmōr" xml:lang="hbo">שְׁמֹ֗ר</char> <char style="w" x-id="WLC.PSA.119.60.007" x-align="PSA.119.60.a007" x-target-ids="t010" x-target="commandments" x-target-head="t010" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfpc" x-gloss="commandments" x-translit="miṣôṯey" xml:lang="hbo">מִצְוֺתֶֽי</char><char style="w" x-id="WLC.PSA.119.60.008" x-align="PSA.119.60.a008" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true