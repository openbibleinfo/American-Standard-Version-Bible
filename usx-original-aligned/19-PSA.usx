	<para style="p"><verse number="3" style="v" x-ref="PSA.18.3" sid="PSA 18:3" /><char style="w" x-id="WLC.PSA.18.3.001" x-align="PSA.18.3.a001" x-target-ids="t006 t007 t008 t009 t010 t011" x-target="who is worthy to be praised" x-target-head="t011" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="VPsmsa" x-gloss="[the.one.who.is].to.be.praised" x-translit="məhullāl" xml:lang="hbo" x-source-ref="PSA.18.4">מְ֭הֻלָּל</char> <char style="w" x-id="WLC.PSA.18.3.002" x-align="PSA.18.3.a002" x-target-ids="t001 t002 t003 t004" x-target="I will call upon" x-target-head="t003" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi1cs" x-gloss="I.call.out.to" x-translit="ʾeqrāʾ" xml:lang="hbo" x-source-ref="PSA.18.4">אֶקְרָ֣א</char> <char style="w" x-id="WLC.PSA.18.3.003" x-align="PSA.18.3.a003" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.18.4">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.18.3.004" x-align="PSA.18.3.a004" x-target-ids="t012" x-target="So" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.18.4">וּ</char><char style="w" x-id="WLC.PSA.18.3.005" x-align="PSA.18.3.a005" x-target-ids="t017" x-target="from" x-target-head="t017" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="min-" xml:lang="hbo" x-source-ref="PSA.18.4">מִן</char>־<char style="w" x-id="WLC.PSA.18.3.006" x-align="PSA.18.3.a006" x-target-ids="t019" x-target="enemies" x-target-head="t019" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾōyəḇ" xml:lang="hbo" x-source-ref="PSA.18.4">אֹ֝יְבַ֗</char><char style="w" x-id="WLC.PSA.18.3.007" x-align="PSA.18.3.a007" x-target-ids="t018" x-target="mine" x-target-head="t018" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:la