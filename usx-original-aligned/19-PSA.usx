	<para style="p"><verse number="1" style="v" x-ref="PSA.104.1" sid="PSA 104:1" /><char style="w" x-id="WLC.PSA.104.1.001" x-align="PSA.104.1.a001" x-target-ids="t001" x-target="Bless" x-target-head="t001" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpv2fs" x-gloss="bless" x-translit="bārăḵiy" xml:lang="hbo">בָּרֲכִ֥י</char> <char style="w" x-id="WLC.PSA.104.1.002" x-align="PSA.104.1.a002" x-target-ids="t003 t005" x-target="O soul" x-target-head="t005" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="my.self" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ֗</char><char style="w" x-id="WLC.PSA.104.1.003" x-align="PSA.104.1.a003" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.104.1.004" x-align="PSA.104.1.a004" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.104.1.005" x-align="PSA.104.1.a005" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְה֫וָ֥ה</char> <char style="w" x-id="WLC.PSA.104.1.006" x-align="PSA.104.1.a006" x-target-ids="t006 t007" x-target="O Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.104.1.007" x-align="PSA.104.1.a007" x-target-ids="t009" x-target="God" x-target-head="t009" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōh" xml:lang="hbo">אֱ֭לֹהַ</char><char style="w" x-id="WLC.PSA.104.1.008" x-align="PSA.104.1.a008" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="h