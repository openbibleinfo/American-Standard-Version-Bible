	<para style="p"><verse number="41" style="v" x-ref="PSA.89.41" sid="PSA 89:41" /><char style="w" x-id="WLC.PSA.89.41.001" x-align="PSA.89.41.a001" x-target-ids="t007" x-target="rob" x-target-head="t007" x-head="true" lemma="שָׁסַס" strong="H8155" x-morph="Vqp3cp" x-gloss="they" x-translit="šassu" xml:lang="hbo" x-source-ref="PSA.89.42">שַׁ֭סֻּ</char><char style="w" x-id="WLC.PSA.89.41.002" x-align="PSA.89.41.a002" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="have.plundered.him" x-translit="hû" xml:lang="hbo" x-source-ref="PSA.89.42">הוּ</char> <char style="w" x-id="WLC.PSA.89.41.003" x-align="PSA.89.41.a003" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.89.42">כָּל</char>־<char style="w" x-id="WLC.PSA.89.41.004" x-align="PSA.89.41.a004" x-target-ids="t002 t003 t004" x-target="that pass by" x-target-head="t003" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqrmpc" x-gloss="[those.who].pass.by" x-translit="ʿōḇərê" xml:lang="hbo" x-source-ref="PSA.89.42">עֹ֣בְרֵי</char> <char style="w" x-id="WLC.PSA.89.41.005" x-align="PSA.89.41.a005" x-target-ids="t005 t006" x-target="the way" x-target-head="t006" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="of.[the].road" x-translit="ḏāreḵ" xml:lang="hbo" x-source-ref="PSA.89.42">דָ֑רֶךְ</char> <char style="w" x-id="WLC.PSA.89.41.006" x-align="PSA.89.41.a006" x-target-ids="t009 t010 t011" x-target="He is become" x-target-head="t011" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3ms" x-gloss="he.has.become" x-translit="hāyāh" xml:lang="hbo" x-source-ref="PSA.89.42">הָיָ֥ה</char> <char style="w" x-id="WLC.PSA.89.41.007" x-align="PSA.89.41.a007" x-target-ids="t012 t013" x-target="a reproach" x-target-head="t013" x-head="true" lemma="חֶרְפָּה" strong="H2781" x-morph="Ncfsa" x-gloss="a.repr