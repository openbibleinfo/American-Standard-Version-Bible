	<para style="p"><verse number="8" style="v" x-ref="PSA.109.8" x-added-alignments="PSA.109.8.a009" x-added-target-ids="t006" x-added-target="And" sid="PSA 109:8" /><char style="w" x-id="WLC.PSA.109.8.001" x-align="PSA.109.8.a001" x-target-ids="t001 t004" x-target="Let be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3mp" x-gloss="may.they.be" x-translit="yihəyû-" xml:lang="hbo">יִֽהְיֽוּ</char>־<char style="w" x-id="WLC.PSA.109.8.002" x-align="PSA.109.8.a002" x-target-ids="t003" x-target="days" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="days" x-translit="yāmāy" xml:lang="hbo">יָמָ֥י</char><char style="w" x-id="WLC.PSA.109.8.003" x-align="PSA.109.8.a003" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.109.8.004" x-align="PSA.109.8.a004" x-target-ids="t005" x-target="few" x-target-head="t005" x-head="true" lemma="מְעַט" strong="H4592" x-morph="Aampa" x-gloss="few" x-translit="məʿaṭṭiym" xml:lang="hbo">מְעַטִּ֑ים</char> <char style="w" x-id="WLC.PSA.109.8.005" x-align="PSA.109.8.a005" x-target-ids="t011" x-target="office" x-target-head="t011" x-head="true" lemma="פְּקֻדָּה" strong="H6486" x-morph="Ncfsc" x-gloss="office" x-translit="pəquddāṯ" xml:lang="hbo">פְּ֝קֻדָּת֗</char><char style="w" x-id="WLC.PSA.109.8.006" x-align="PSA.109.8.a006" x-target-ids="t010" x-target="his" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.109.8.007" x-align="PSA.109.8.a007" x-target-ids="t007 t009" x-target="let take" x-target-head="t009" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqi3ms" x-gloss="may.he.take" x-translit="yiqqaḥ" xml:lang="hbo">יִקַּ֥ח</char> <char style="w" x-id="WLC.PSA.109.8.008" x-align="PSA.109.8.a008" x-target-ids="t008