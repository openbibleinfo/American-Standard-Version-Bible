	<para style="p"><verse number="1" style="v" x-ref="PSA.4.1" x-added-alignments="PSA.4.1.a017" x-added-target-ids="t017 t018 t019" x-added-target="when I was" sid="PSA 4:1" /><char style="w" x-id="WLC.PSA.4.1.001" x-align="PSA.4.1.a001" x-target-ids="t003" x-target="when" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.4.2">בְּ</char><char style="w" x-id="WLC.PSA.4.1.002" x-align="PSA.4.1.a002" x-target-ids="t005" x-target="call" x-target-head="t005" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqc" x-gloss="call" x-translit="qārəʾ" xml:lang="hbo" x-source-ref="PSA.4.2">קָרְאִ֡</char><char style="w" x-id="WLC.PSA.4.1.003" x-align="PSA.4.1.a003" x-target-ids="t004" x-target="I" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="I" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.4.2">י</char> <char style="w" x-id="WLC.PSA.4.1.004" x-align="PSA.4.1.a004" x-target-ids="t001" x-target="Answer" x-target-head="t001" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqv2ms" x-gloss="answer" x-translit="ʿăn" xml:lang="hbo" x-source-ref="PSA.4.2">עֲנֵ֤</char><char style="w" x-id="WLC.PSA.4.1.005" x-align="PSA.4.1.a005" x-target-ids="t002" x-target="me" x-target-head="t002" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo" x-source-ref="PSA.4.2">נִי</char>׀<char style="w" x-id="WLC.PSA.4.1.006" x-align="PSA.4.1.a006" x-target-ids="t006 t007" x-target="O God" x-target-head="t007" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="O.God" x-translit="ʾĕlōhēy" xml:lang="hbo" x-source-ref="PSA.4.2">אֱלֹ֘הֵ֤י</char> <char style="w" x-id="WLC.PSA.4.1.007" x-align="PSA.4.1.a007" x-target-ids="t008 t010" x-target="of righteousness" x-target-head="t010" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsc" x-gloss="my.righteousness" x-translit="ṣiḏq" xml:lang="hbo" x-source