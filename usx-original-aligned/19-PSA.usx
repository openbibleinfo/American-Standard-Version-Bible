	<para style="p"><verse number="12" style="v" x-ref="PSA.116.12" sid="PSA 116:12" /><char style="w" x-id="WLC.PSA.116.12.001" x-align="PSA.116.12.a001" x-target-ids="t001" x-target="What" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh-" xml:lang="hbo">מָֽה</char>־<char style="w" x-id="WLC.PSA.116.12.002" x-align="PSA.116.12.a002" x-target-ids="t002 t003 t004" x-target="shall I render" x-target-head="t004" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhi1cs" x-gloss="will.I.return" x-translit="ʾāšiyḇ" xml:lang="hbo">אָשִׁ֥יב</char> <char style="w" x-id="WLC.PSA.116.12.003" x-align="PSA.116.12.a003" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.116.12.004" x-align="PSA.116.12.a004" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֑ה</char> <char style="w" x-id="WLC.PSA.116.12.005" x-align="PSA.116.12.a005" x-target-ids="t007 t008" x-target="For all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kāl-" xml:lang="hbo">כָּֽל</char>־<char style="w" x-id="WLC.PSA.116.12.006" x-align="PSA.116.12.a006" x-target-ids="t010" x-target="benefits" x-target-head="t010" x-head="true" lemma="תַּגְמוּל" strong="H8408" x-morph="Ncmpc" x-gloss="benefits" x-translit="taḡmûlô" xml:lang="hbo">תַּגְמוּל֥וֹ</char><char style="w" x-id="WLC.PSA.116.12.007" x-align="PSA.116.12.a007" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1958a" x-morph="Sp3ms" x-gloss="his" x-translit="hiy" xml:lang="hbo">הִי</char> <char style="w" x-id="WLC.PSA.116.12.008" x-align="PSA.116.12.a008" x-target-ids="t011" x-target="toward" x-target-head="t011" x-head="true" lemma="עַל" strong=