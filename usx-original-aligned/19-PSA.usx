	<para style="p"><verse number="44" style="v" x-ref="PSA.89.44" sid="PSA 89:44" /><char style="w" x-id="WLC.PSA.89.44.001" x-align="PSA.89.44.a001" x-target-ids="t001 t002 t003 t006 t007" x-target="Thou hast made to cease" x-target-head="t007" x-head="true" lemma="שָׁבַת" strong="H7673" x-morph="Vhp2ms" x-gloss="you.have.made.cease" x-translit="hišbatā" xml:lang="hbo" x-source-ref="PSA.89.45">הִשְׁבַּ֥תָּ</char> <char style="w" x-id="WLC.PSA.89.44.002" x-align="PSA.89.44.a002" x-status="unrepresented" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.89.45">מִ</char><char style="w" x-id="WLC.PSA.89.44.003" x-align="PSA.89.44.a003" x-target-ids="t005" x-target="brightness" x-target-head="t005" x-head="true" lemma="טֳהָר" strong="H2892a" x-morph="Ncmsc" x-gloss="luster" x-translit="ṭṭəhār" xml:lang="hbo" x-source-ref="PSA.89.45">טְּהָר֑</char><char style="w" x-id="WLC.PSA.89.44.004" x-align="PSA.89.44.a004" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.89.45">וֹ</char> <char style="w" x-id="WLC.PSA.89.44.005" x-align="PSA.89.44.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.89.45">וְ֝</char><char style="w" x-id="WLC.PSA.89.44.006" x-align="PSA.89.44.a006" x-target-ids="t011" x-target="throne" x-target-head="t011" x-head="true" lemma="כִּסֵּא" strong="H3678" x-morph="Ncmsc" x-gloss="throne" x-translit="ḵisʾ" xml:lang="hbo" x-source-ref="PSA.89.45">כִסְא֗</char><char style="w" x-id="WLC.PSA.89.44.007" x-align="PSA.89.44.a007" x-target-ids="t010" x-target="his" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.89.45">וֹ</char> <char style="w" x-id="WLC.PSA.8