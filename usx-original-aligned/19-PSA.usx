	<para style="p"><verse number="19" style="v" x-ref="PSA.34.19" sid="PSA 34:19" /><char style="w" x-id="WLC.PSA.34.19.001" x-align="PSA.34.19.a001" x-target-ids="t001 t002" x-target="Many are" x-target-head="t001" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafpa" x-gloss="[are].many" x-translit="rabbôṯ" xml:lang="hbo" x-source-ref="PSA.34.20">רַ֭בּוֹת</char> <char style="w" x-id="WLC.PSA.34.19.002" x-align="PSA.34.19.a002" x-target-ids="t003 t004" x-target="the afflictions" x-target-head="t004" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfpc" x-gloss="[the].troubles" x-translit="rāʿôṯ" xml:lang="hbo" x-source-ref="PSA.34.20">רָע֣וֹת</char> <char style="w" x-id="WLC.PSA.34.19.003" x-align="PSA.34.19.a003" x-target-ids="t005 t006 t007" x-target="of the righteous" x-target-head="t007" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.a.righteous.[person]" x-translit="ṣaddiyq" xml:lang="hbo" x-source-ref="PSA.34.20">צַדִּ֑יק</char> <char style="w" x-id="WLC.PSA.34.19.004" x-align="PSA.34.19.a004" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.34.20">וּ֝</char><char style="w" x-id="WLC.PSA.34.19.005" x-align="PSA.34.19.a005" x-target-ids="t012 t013" x-target="out of" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.34.20">מִ</char><char style="w" x-id="WLC.PSA.34.19.006" x-align="PSA.34.19.a006" x-target-ids="t015" x-target="all" x-target-head="t015" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kull" xml:lang="hbo" x-source-ref="PSA.34.20">כֻּלָּ֗</char><char style="w" x-id="WLC.PSA.34.19.007" x-align="PSA.34.19.a007" x-target-ids="t014" x-target="them" x-target-head="t014" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="of.them" x-translit="ām" xml:lang="hbo" x-s