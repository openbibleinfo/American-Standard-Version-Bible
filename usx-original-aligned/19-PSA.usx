	<para style="p"><verse number="13" style="v" x-ref="PSA.50.13" sid="PSA 50:13" /><char style="w" x-id="WLC.PSA.50.13.001" x-align="PSA.50.13.a001" x-target-ids="t001" x-target="Will" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="do" x-translit="ha" xml:lang="hbo">הַֽ֭</char><char style="w" x-id="WLC.PSA.50.13.002" x-align="PSA.50.13.a002" x-target-ids="t002 t003" x-target="I eat" x-target-head="t003" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqi1cs" x-gloss="I.eat?" x-translit="ʾôḵal" xml:lang="hbo">אוֹכַל</char> <char style="w" x-id="WLC.PSA.50.13.003" x-align="PSA.50.13.a003" x-target-ids="t004 t005" x-target="the flesh" x-target-head="t005" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmsc" x-gloss="[the].flesh" x-translit="bəśar" xml:lang="hbo">בְּשַׂ֣ר</char> <char style="w" x-id="WLC.PSA.50.13.004" x-align="PSA.50.13.a004" x-target-ids="t006 t007" x-target="of bulls" x-target-head="t007" x-head="true" lemma="אַבִּיר" strong="H47" x-morph="Aampa" x-gloss="of.mighty.[bulls]" x-translit="ʾabbîriym" xml:lang="hbo">אַבִּירִ֑ים</char> <char style="w" x-id="WLC.PSA.50.13.005" x-align="PSA.50.13.a005" x-target-ids="t008" x-target="Or" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.50.13.006" x-align="PSA.50.13.a006" x-target-ids="t010 t011" x-target="the blood" x-target-head="t011" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmsc" x-gloss="blood" x-translit="ḏam" xml:lang="hbo">דַ֖ם</char> <char style="w" x-id="WLC.PSA.50.13.007" x-align="PSA.50.13.a007" x-target-ids="t012 t013" x-target="of goats" x-target-head="t013" x-head="true" lemma="עַתּוּד" strong="H6260" x-morph="Ncmpa" x-gloss="of.goats" x-translit="ʿattûḏiym" xml:lang="hbo">עַתּוּדִ֣ים</char> <char style="w" x-id="WLC.PSA.50.13.008" x-align="PSA.50.13.a008" x-target-ids="t009" x-target="drink" x-target-head="t009" x-head="true"