	<para style="p"><verse number="15" style="v" x-ref="PSA.40.15" sid="PSA 40:15" /><char style="w" x-id="WLC.PSA.40.15.001" x-align="PSA.40.15.a001" x-target-ids="t001 t002 t003 t004" x-target="Let them be desolate" x-target-head="t004" x-head="true" lemma="שָׁמֵם" strong="H8074" x-morph="Vqi3mp" x-gloss="may.they.be.appalled" x-translit="yāšōmmû" xml:lang="hbo" x-source-ref="PSA.40.16">יָ֭שֹׁמּוּ</char> <char style="w" x-id="WLC.PSA.40.15.002" x-align="PSA.40.15.a002" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.40.16">עַל</char>־<char style="w" x-id="WLC.PSA.40.15.003" x-align="PSA.40.15.a002" x-target-ids="t005 t006 t007" x-target="by reason of" x-target-head="t006" x-head="true" lemma="עֵקֶב" strong="H6118" x-morph="Ncmsc" x-gloss="the.consequence" x-translit="ʿēqeḇ" xml:lang="hbo" x-source-ref="PSA.40.16">עֵ֣קֶב</char> <char style="w" x-id="WLC.PSA.40.15.004" x-align="PSA.40.15.a003" x-target-ids="t009" x-target="shame" x-target-head="t009" x-head="true" lemma="בֹּשֶׁת" strong="H1322" x-morph="Ncfsc" x-gloss="their.shame" x-translit="bāšətt" xml:lang="hbo" x-source-ref="PSA.40.16">בָּשְׁתָּ֑</char><char style="w" x-id="WLC.PSA.40.15.005" x-align="PSA.40.15.a004" x-target-ids="t008" x-target="their" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="PSA.40.16">ם</char> <char style="w" x-id="WLC.PSA.40.15.006" x-align="PSA.40.15.a005" x-target-ids="t010" x-target="That" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.40.16">הָ</char><char style="w" x-id="WLC.PSA.40.15.007" x-align="PSA.40.15.a006" x-target-ids="t011" x-target="say" x-target-head="t011" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqrmpa" x-gloss="who].say" x-translit="ʾōməriym" xml:lang="hbo" x-source-ref="PSA.40.16">אֹמְרִ֥ים</char> <char style="w" x-id=