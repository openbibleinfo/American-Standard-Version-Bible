	<para style="p"><verse number="11" style="v" x-ref="PSA.50.11" sid="PSA 50:11" /><char style="w" x-id="WLC.PSA.50.11.001" x-align="PSA.50.11.a001" x-target-ids="t001 t002" x-target="I know" x-target-head="t002" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp1cs" x-gloss="I.know" x-translit="yāḏaʿtî" xml:lang="hbo">יָ֭דַעְתִּי</char> <char style="w" x-id="WLC.PSA.50.11.002" x-align="PSA.50.11.a002" x-target-ids="t003" x-target="all" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.50.11.003" x-align="PSA.50.11.a003" x-target-ids="t004 t005" x-target="the birds" x-target-head="t005" x-head="true" lemma="עוֹף" strong="H5775" x-morph="Ncmsc" x-gloss="bird" x-translit="ʿôp̄" xml:lang="hbo">ע֣וֹף</char> <char style="w" x-id="WLC.PSA.50.11.004" x-align="PSA.50.11.a004" x-target-ids="t006 t007 t008" x-target="of the mountains" x-target-head="t008" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpa" x-gloss="of.[the].mountains" x-translit="hāriym" xml:lang="hbo">הָרִ֑ים</char> <char style="w" x-id="WLC.PSA.50.11.005" x-align="PSA.50.11.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.50.11.006" x-align="PSA.50.11.a006" x-target-ids="t010 t011 t012" x-target="the wild beasts" x-target-head="t012" x-head="true" lemma="זִיז" strong="H2123" x-morph="Ncmsc" x-gloss="moving.creature[s]" x-translit="ziyz" xml:lang="hbo">זִ֥יז</char> <char style="w" x-id="WLC.PSA.50.11.007" x-align="PSA.50.11.a007" x-target-ids="t013 t014 t015" x-target="of the field" x-target-head="t015" x-head="true" lemma="שָׂדַי" strong="H7704a" x-morph="Ncmsa" x-gloss="of.[the].field" x-translit="śāḏay" xml:lang="hbo">שָׂ֝דַ֗י</char> <char style="w" x-id="WLC.PSA.50.11.008" x-align="PSA.50.11.a008" lemma="עִמָּד" strong="H5978" x-m