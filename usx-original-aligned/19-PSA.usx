	<para style="p"><verse number="28" style="v" x-ref="PSA.118.28" sid="PSA 118:28" /><char style="w" x-id="WLC.PSA.118.28.001" x-align="PSA.118.28.a001" x-target-ids="t002 t004" x-target="art God" x-target-head="t004" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsc" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵלִ֣</char><char style="w" x-id="WLC.PSA.118.28.002" x-align="PSA.118.28.a002" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[are].my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.118.28.003" x-align="PSA.118.28.a003" x-target-ids="t001 t012" x-target="Thou Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.118.28.004" x-align="PSA.118.28.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.118.28.005" x-align="PSA.118.28.a005" x-target-ids="t006 t007 t008 t009 t010" x-target="I will give thanks unto" x-target-head="t009" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo">אוֹדֶ֑</char><char style="w" x-id="WLC.PSA.118.28.006" x-align="PSA.118.28.a006" x-target-ids="t011" x-target="thee" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.PSA.118.28.007" x-align="PSA.118.28.a007" x-target-ids="t013 t015" x-target="art God" x-target-head="t015" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="my.God" x-translit="ʾĕlōh" xml:lang="hbo">אֱ֝לֹהַ֗</char><char style="w" x-id="WLC.PSA.118.28.008" x-align="PSA.118.28.a008" x-target-ids="t014" x-target="my" x-target-head="t014" x-head="true"