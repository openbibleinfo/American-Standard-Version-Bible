	<para style="p"><verse number="13" style="v" x-ref="PSA.65.13" sid="PSA 65:13" /><char style="w" x-id="WLC.PSA.65.13.001" x-align="PSA.65.13.a001" x-target-ids="t003 t004 t005" x-target="are clothed with" x-target-head="t004" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqp3cp" x-gloss="they.are.clothed" x-translit="lāḇəšû" xml:lang="hbo" x-source-ref="PSA.65.14">לָבְשׁ֬וּ</char> <char style="w" x-id="WLC.PSA.65.13.002" x-align="PSA.65.13.a002" x-target-ids="t001 t002" x-target="The pastures" x-target-head="t002" x-head="true" lemma="כַּר" strong="H3733a" x-morph="Ncmpa" x-gloss="[the].pastures" x-translit="ḵāriym" xml:lang="hbo" x-source-ref="PSA.65.14">כָרִ֨ים</char>׀<char style="w" x-id="WLC.PSA.65.13.003" x-align="PSA.65.13.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.65.14">הַ</char><char style="w" x-id="WLC.PSA.65.13.004" x-align="PSA.65.13.a004" x-target-ids="t006" x-target="flocks" x-target-head="t006" x-head="true" lemma="צֹאן" strong="H6629" x-morph="Ncbsa" x-gloss="flock[s]" x-translit="ṣṣōʾn" xml:lang="hbo" x-source-ref="PSA.65.14">צֹּ֗אן</char> <char style="w" x-id="WLC.PSA.65.13.005" x-align="PSA.65.13.a005" x-target-ids="t009" x-target="also" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.65.14">וַ</char><char style="w" x-id="WLC.PSA.65.13.006" x-align="PSA.65.13.a006" x-target-ids="t007 t008" x-target="The valleys" x-target-head="t008" x-head="true" lemma="עֵמֶק" strong="H6010" x-morph="Ncmpa" x-gloss="valleys" x-translit="ʿămāqiym" xml:lang="hbo" x-source-ref="PSA.65.14">עֲמָקִ֥ים</char> <char style="w" x-id="WLC.PSA.65.13.007" x-align="PSA.65.13.a007" x-target-ids="t010 t011 t012 t013" x-target="are covered over with" x-target-head="t011" x-head="true" lemma="עָטַף" strong="H5848" x-morph="Vqi3mp" x-gloss="they.cover.themselves" x-translit="y