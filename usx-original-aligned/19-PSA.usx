	<para style="p"><verse number="4" style="v" x-ref="PSA.10.4" x-added-alignments="PSA.10.4.a006 PSA.10.4.a009" x-added-target-ids="t009 t014" x-added-target="saith | it" sid="PSA 10:4" /><char style="w" x-id="WLC.PSA.10.4.001" x-align="PSA.10.4.a001" x-target-ids="t001 t002" x-target="The wicked" x-target-head="t002" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֗ע</char> <char style="w" x-id="WLC.PSA.10.4.002" x-align="PSA.10.4.a002" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="according" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.PSA.10.4.003" x-align="PSA.10.4.a003" x-target-ids="t004 t005" x-target="the pride" x-target-head="t005" x-head="true" lemma="גֹּבַהּ" strong="H1363" x-morph="Ncmsc" x-gloss="to.the.haughtiness" x-translit="ḡōḇaẖ" xml:lang="hbo">גֹ֣בַהּ</char> <char style="w" x-id="WLC.PSA.10.4.004" x-align="PSA.10.4.a004" x-target-ids="t006 t008" x-target="of countenance" x-target-head="t008" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsc" x-gloss="his.nose" x-translit="ʾapp" xml:lang="hbo">אַ֭פּ</char><char style="w" x-id="WLC.PSA.10.4.005" x-align="PSA.10.4.a005" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.10.4.006" x-align="PSA.10.4.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PSA.10.4.007" x-align="PSA.10.4.a008" x-target-ids="t010 t011 t013" x-target="He will require" x-target-head="t013" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqi3ms" x-gloss="he.seeks" x-translit="yiḏrōš" xml:lang="hbo">יִדְרֹ֑שׁ</char> <char style="w" x-id="WLC.PSA.10.4.008" x