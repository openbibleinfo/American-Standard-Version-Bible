	<para style="p"><verse number="8" style="v" x-ref="PSA.113.8" x-added-alignments="PSA.113.8.a003 PSA.113.8.a006" x-added-target-ids="t005 t008" x-added-target="him | Even" sid="PSA 113:8" /><char style="w" x-id="WLC.PSA.113.8.001" x-align="PSA.113.8.a001" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.113.8.002" x-align="PSA.113.8.a002" x-target-ids="t002 t003 t004" x-target="he may set" x-target-head="t004" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vhc" x-gloss="make.[him].sit" x-translit="hôšîḇiy" xml:lang="hbo">הוֹשִׁיבִ֥י</char> <char style="w" x-id="WLC.PSA.113.8.003" x-align="PSA.113.8.a004" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.PSA.113.8.004" x-align="PSA.113.8.a005" x-target-ids="t007" x-target="princes" x-target-head="t007" x-head="true" lemma="נָדִיב" strong="H5081" x-morph="Aampa" x-gloss="noble.[people]" x-translit="nəḏîḇiym" xml:lang="hbo">נְדִיבִ֑ים</char> <char style="w" x-id="WLC.PSA.113.8.005" x-align="PSA.113.8.a007" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim" xml:lang="hbo">עִ֝֗ם</char> <char style="w" x-id="WLC.PSA.113.8.006" x-align="PSA.113.8.a008" x-target-ids="t010 t011" x-target="the princes" x-target-head="t011" x-head="true" lemma="נָדִיב" strong="H5081" x-morph="Aampc" x-gloss="the.noble.[people]" x-translit="nəḏîḇēy" xml:lang="hbo">נְדִיבֵ֥י</char> <char style="w" x-id="WLC.PSA.113.8.007" x-align="PSA.113.8.a009" x-target-ids="t012 t014" x-target="of people" x-target-head="t014" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="his.people" x-translit="ʿamm" xml:lang="hbo">עַמּֽ</char><char style="w" x-id="WLC.PSA.113