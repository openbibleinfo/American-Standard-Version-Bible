	<para style="p"><verse number="2" style="v" x-ref="PSA.53.2" sid="PSA 53:2" /><char style="w" x-id="WLC.PSA.53.2.001" x-align="PSA.53.2.a001" x-target-ids="t001" x-target="God" x-target-head="t001" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.53.3">אֱֽלֹהִ֗ים</char> <char style="w" x-id="WLC.PSA.53.2.002" x-align="PSA.53.2.a003" x-target-ids="t004" x-target="from" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.53.3">מִ</char><char style="w" x-id="WLC.PSA.53.2.003" x-align="PSA.53.2.a004" x-target-ids="t005" x-target="heaven" x-target-head="t005" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heaven" x-translit="ššāmayim" xml:lang="hbo" x-source-ref="PSA.53.3">שָּׁמַיִם֮</char> <char style="w" x-id="WLC.PSA.53.2.004" x-align="PSA.53.2.a002" x-target-ids="t002 t003" x-target="looked down" x-target-head="t002" x-head="true" lemma="שָׁקַף" strong="H8259" x-morph="Vhp3ms" x-gloss="he.looks.down" x-translit="hišqiyp̄" xml:lang="hbo" x-source-ref="PSA.53.3">הִשְׁקִ֪יף</char> <char style="w" x-id="WLC.PSA.53.2.005" x-align="PSA.53.2.a005" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.53.3">עַֽל</char>־<char style="w" x-id="WLC.PSA.53.2.006" x-align="PSA.53.2.a006" x-target-ids="t007 t008" x-target="the children" x-target-head="t008" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="[the].children" x-translit="bənēy" xml:lang="hbo" x-source-ref="PSA.53.3">בְּנֵ֫י</char> <char style="w" x-id="WLC.PSA.53.2.007" x-align="PSA.53.2.a007" x-target-ids="t009 t010" x-target="of men" x-target-head="t010" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.humankind" x-translit="ʾāḏām" xml:lang="hbo" x-source-ref="PSA.53.3">אָד