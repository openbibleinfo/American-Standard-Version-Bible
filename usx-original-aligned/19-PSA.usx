	<para style="p"><verse number="20" style="v" x-ref="PSA.34.20" x-added-alignments="PSA.34.20.a001" x-added-target-ids="t001" x-added-target="He" sid="PSA 34:20" /><char style="w" x-id="WLC.PSA.34.20.001" x-align="PSA.34.20.a002" x-target-ids="t002" x-target="keepeth" x-target-head="t002" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[he.is].keeping" x-translit="šōmēr" xml:lang="hbo" x-source-ref="PSA.34.21">שֹׁמֵ֥ר</char> <char style="w" x-id="WLC.PSA.34.20.002" x-align="PSA.34.20.a003" x-target-ids="t003" x-target="all" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.34.21">כָּל</char>־<char style="w" x-id="WLC.PSA.34.20.003" x-align="PSA.34.20.a004" x-target-ids="t005" x-target="bones" x-target-head="t005" x-head="true" lemma="עֶצֶם" strong="H6106" x-morph="Ncfpc" x-gloss="bones" x-translit="ʿaṣmôṯāy" xml:lang="hbo" x-source-ref="PSA.34.21">עַצְמוֹתָ֑י</char><char style="w" x-id="WLC.PSA.34.20.004" x-align="PSA.34.20.a005" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="PSA.34.21">ו</char> <char style="w" x-id="WLC.PSA.34.20.005" x-align="PSA.34.20.a006" x-target-ids="t007" x-target="one" x-target-head="t007" x-head="true" lemma="אֶחָד" strong="H259" x-morph="Acfsa" x-gloss="one" x-translit="ʾaḥaṯ" xml:lang="hbo" x-source-ref="PSA.34.21">אַחַ֥ת</char> <char style="w" x-id="WLC.PSA.34.20.006" x-align="PSA.34.20.a007" x-target-ids="t008" x-target="of" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="of" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.34.21">מֵ֝</char><char style="w" x-id="WLC.PSA.34.20.007" x-align="PSA.34.20.a008" x-target-ids="t009" x-target="them" x-target-head="t009" x-head="true" lemma="הֵנָּה" strong="H2007" x-morph="Pp3fp" x-gloss="them" x-translit="hēnnâ" xml:lang="