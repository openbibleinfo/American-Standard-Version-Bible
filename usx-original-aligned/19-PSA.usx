	<para style="p"><verse number="7" style="v" x-ref="PSA.2.7" sid="PSA 2:7" /><char style="w" x-id="WLC.PSA.2.7.001" x-align="PSA.2.7.a001" x-target-ids="t001 t002 t003" x-target="I will tell" x-target-head="t003" x-head="true" lemma="סָפַר" strong="H5608" x-morph="Vph1cs" x-gloss="I.will.recount" x-translit="ʾăsappərāh" xml:lang="hbo">אֲסַפְּרָ֗ה</char> <char style="w" x-id="WLC.PSA.2.7.002" x-align="PSA.2.7.a002" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="concerning" x-translit="ʾel" xml:lang="hbo">אֶֽ֫ל</char> <char style="w" x-id="WLC.PSA.2.7.003" x-align="PSA.2.7.a003" x-target-ids="t005 t006" x-target="the decree" x-target-head="t006" x-head="true" lemma="חֹק" strong="H2706" x-morph="Ncmsc" x-gloss="[the].decree" x-translit="ḥōq" xml:lang="hbo">חֹ֥ק</char> <char style="w" x-id="WLC.PSA.2.7.004" x-align="PSA.2.7.a004" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.2.7.005" x-align="PSA.2.7.a005" x-target-ids="t008" x-target="said" x-target-head="t008" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.said" x-translit="ʾāmar" xml:lang="hbo">אָמַ֘ר</char> <char style="w" x-id="WLC.PSA.2.7.006" x-align="PSA.2.7.a006" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלַ֥</char><char style="w" x-id="WLC.PSA.2.7.007" x-align="PSA.2.7.a007" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.2.7.008" x-align="PSA.2.7.a008" x-target-ids="t012 t014" x-target="art son" x-target-head="t014" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="son" x-translit