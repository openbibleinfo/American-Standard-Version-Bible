	<para style="p"><verse number="32" style="v" x-ref="PSA.119.32" x-added-alignments="PSA.119.32.a009" x-added-target-ids="t015 t016" x-added-target="ה He" sid="PSA 119:32" /><char style="w" x-id="WLC.PSA.119.32.001" x-align="PSA.119.32.a002" x-target-ids="t004 t005" x-target="the way" x-target-head="t005" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="the.way" x-translit="dereḵ-" xml:lang="hbo">דֶּֽרֶךְ</char>־<char style="w" x-id="WLC.PSA.119.32.002" x-align="PSA.119.32.a003" x-target-ids="t006 t008" x-target="of commandments" x-target-head="t008" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfpc" x-gloss="your.commandments" x-translit="miṣôṯey" xml:lang="hbo">מִצְוֺתֶ֥י</char><char style="w" x-id="WLC.PSA.119.32.003" x-align="PSA.119.32.a004" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.32.004" x-align="PSA.119.32.a001" x-target-ids="t001 t002 t003" x-target="I will run" x-target-head="t003" x-head="true" lemma="רוּץ" strong="H7323" x-morph="Vqi1cs" x-gloss="I.run" x-translit="ʾārûṣ" xml:lang="hbo">אָר֑וּץ</char> <char style="w" x-id="WLC.PSA.119.32.005" x-align="PSA.119.32.a005" x-target-ids="t009" x-target="When" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֖י</char> <char style="w" x-id="WLC.PSA.119.32.006" x-align="PSA.119.32.a006" x-target-ids="t010 t011 t012" x-target="thou shalt enlarge" x-target-head="t012" x-head="true" lemma="רָחַב" strong="H7337" x-morph="Vhi2ms" x-gloss="you.enlarge" x-translit="ṯarḥiyḇ" xml:lang="hbo">תַרְחִ֣יב</char> <char style="w" x-id="WLC.PSA.119.32.007" x-align="PSA.119.32.a007" x-target-ids="t014" x-target="heart" x-target-head="t014" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּֽ</char><char st