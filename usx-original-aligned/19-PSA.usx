	<para style="p"><verse number="8" style="v" x-ref="PSA.57.8" sid="PSA 57:8" /><char style="w" x-id="WLC.PSA.57.8.001" x-align="PSA.57.8.a001" x-target-ids="t001 t002" x-target="Awake up" x-target-head="t001" x-head="true" lemma="עוּר" strong="H5782" x-morph="Vqv2ms" x-gloss="awake" x-translit="ʿûr" xml:lang="hbo" x-source-ref="PSA.57.9">ע֤וּרָ</char><char style="w" x-id="WLC.PSA.57.8.002" x-align="PSA.57.8.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.57.9">ה</char> <char style="w" x-id="WLC.PSA.57.8.003" x-align="PSA.57.8.a004" x-target-ids="t004" x-target="glory" x-target-head="t004" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="my.honor" x-translit="ḵəḇôḏ" xml:lang="hbo" x-source-ref="PSA.57.9">כְבוֹדִ֗</char><char style="w" x-id="WLC.PSA.57.8.004" x-align="PSA.57.8.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.57.9">י</char> <char style="w" x-id="WLC.PSA.57.8.005" x-align="PSA.57.8.a005" x-target-ids="t005" x-target="awake" x-target-head="t005" x-head="true" lemma="עוּר" strong="H5782" x-morph="Vqv2ms" x-gloss="awake" x-translit="ʿûr" xml:lang="hbo" x-source-ref="PSA.57.9">ע֭וּרָֽ</char><char style="w" x-id="WLC.PSA.57.8.006" x-align="PSA.57.8.a006" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.57.9">ה</char> <char style="w" x-id="WLC.PSA.57.8.007" x-align="PSA.57.8.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="O" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.57.9">הַ</char><char style="w" x-id="WLC.PSA.57.8.008" x-align="PSA.57.8.a008" x-target-ids="t006" x-target="psaltery" x-target-head="t006" x-head="true" lemma="נֵבֶל" strong="H5035a" x-morph="Ncmsa" x-gloss="lyre" x-translit="nnēḇel"