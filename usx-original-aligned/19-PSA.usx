	<para style="p"><verse number="29" style="v" x-ref="PSA.118.29" sid="PSA 118:29" /><char style="w" x-id="WLC.PSA.118.29.001" x-align="PSA.118.29.a001" x-target-ids="t001 t002 t003" x-target="Oh give thanks" x-target-head="t003" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhv2mp" x-gloss="give.thanks" x-translit="hôḏû" xml:lang="hbo">הוֹד֣וּ</char> <char style="w" x-id="WLC.PSA.118.29.002" x-align="PSA.118.29.a002" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.118.29.003" x-align="PSA.118.29.a003" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֣ה</char> <char style="w" x-id="WLC.PSA.118.29.004" x-align="PSA.118.29.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.118.29.005" x-align="PSA.118.29.a005" x-target-ids="t007 t008 t009" x-target="he is good" x-target-head="t009" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[he.is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PSA.118.29.006" x-align="PSA.118.29.a006" x-target-ids="t010" x-target="For" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֖י</char> <char style="w" x-id="WLC.PSA.118.29.007" x-align="PSA.118.29.a007" x-target-ids="t013 t014" x-target="endureth for" x-target-italic-ids="t013" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.118.29.008" x-align="PSA.118.29.a008" x-target-ids="t015" x-target="ever" x-target-head="t015" x-head="true" lemma="ע