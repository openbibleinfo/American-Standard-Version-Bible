	<para style="p"><verse number="1" style="v" x-ref="PSA.23.1" sid="PSA 23:1" /><char style="w" x-id="WLC.PSA.23.1.001" x-align="PSA.23.1.a001" x-target-ids="t001 t002" x-target="A Psalm" x-target-head="t002" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.23.1.002" x-align="PSA.23.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.23.1.003" x-align="PSA.23.1.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָוִ֑ד</char><char style="w" x-id="WLC.PSA.23.1.004" x-align="PSA.23.1.a004" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֥ה</char> <char style="w" x-id="WLC.PSA.23.1.005" x-align="PSA.23.1.a005" x-target-ids="t006 t008" x-target="is shepherd" x-target-head="t008" x-head="true" lemma="רָעָה" strong="H7473" x-morph="Vqrmsc" x-gloss="[is].my" x-translit="rōʿ" xml:lang="hbo">רֹ֝עִ֗</char><char style="w" x-id="WLC.PSA.23.1.006" x-align="PSA.23.1.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="shepherd" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.23.1.007" x-align="PSA.23.1.a007" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PSA.23.1.008" x-align="PSA.23.1.a008" x-target-ids="t009 t010 t012" x-target="I shall want" x-target-head="t012" x-head="true" lemma="חָסֵר" strong="H2637" x-morph="Vqi1cs" x-gloss="I.lack" x-tran