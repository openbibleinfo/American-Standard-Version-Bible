	<para style="p"><verse number="2" style="v" x-ref="PSA.113.2" sid="PSA 113:2" /><char style="w" x-id="WLC.PSA.113.2.001" x-align="PSA.113.2.a001" x-target-ids="t002" x-target="be" x-target-head="t002" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="may.it.be" x-translit="yəhiy" xml:lang="hbo">יְהִ֤י</char> <char style="w" x-id="WLC.PSA.113.2.002" x-align="PSA.113.2.a002" x-target-ids="t003 t004" x-target="the name" x-target-head="t004" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="the.name" x-translit="šēm" xml:lang="hbo">שֵׁ֣ם</char> <char style="w" x-id="WLC.PSA.113.2.003" x-align="PSA.113.2.a003" x-target-ids="t005 t006" x-target="of Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.113.2.004" x-align="PSA.113.2.a004" x-target-ids="t001" x-target="Blessed" x-target-head="t001" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="VPsmsa" x-gloss="blessed" x-translit="məḇōrāḵ" xml:lang="hbo">מְבֹרָ֑ךְ</char> <char style="w" x-id="WLC.PSA.113.2.005" x-align="PSA.113.2.a005" x-target-ids="t007" x-target="From" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ֝</char><char style="w" x-id="WLC.PSA.113.2.006" x-align="PSA.113.2.a006" x-target-ids="t008 t009 t010" x-target="this time forth" x-target-head="t009" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֗ה</char> <char style="w" x-id="WLC.PSA.113.2.007" x-align="PSA.113.2.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.113.2.008" x-align="PSA.113.2.a008" x-target-ids="t012" x-target="for" x-target-head="t012" x-head="true" lemma="עַד" strong="H5704" x-morph="