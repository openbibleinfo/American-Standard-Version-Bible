	<para style="p"><verse number="41" style="v" x-ref="PSA.18.41" x-added-alignments="PSA.18.41.a005" x-added-target-ids="t009" x-added-target="Even" sid="PSA 18:41" /><char style="w" x-id="WLC.PSA.18.41.001" x-align="PSA.18.41.a001" x-target-ids="t001 t002" x-target="They cried" x-target-head="t002" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpi3mp" x-gloss="they.cried.for.help" x-translit="yəšawwəʿû" xml:lang="hbo" x-source-ref="PSA.18.42">יְשַׁוְּע֥וּ</char> <char style="w" x-id="WLC.PSA.18.41.002" x-align="PSA.18.41.a002" x-target-ids="t003" x-target="but" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.42">וְ</char><char style="w" x-id="WLC.PSA.18.41.003" x-align="PSA.18.41.a003" x-target-ids="t004 t005 t006" x-target="there was none" x-target-head="t006" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[was].not" x-translit="ʾên-" xml:lang="hbo" x-source-ref="PSA.18.42">אֵין</char>־<char style="w" x-id="WLC.PSA.18.41.004" x-align="PSA.18.41.a004" x-target-ids="t007 t008" x-target="to save" x-target-head="t008" x-head="true" lemma="יָשַׁע" strong="H3467a" x-morph="Vhrmsa" x-gloss="a.deliverer" x-translit="môšiyᵃʿ" xml:lang="hbo" x-source-ref="PSA.18.42">מוֹשִׁ֑יעַ</char> <char style="w" x-id="WLC.PSA.18.41.005" x-align="PSA.18.41.a006" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="to" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.18.42">עַל</char>־<char style="w" x-id="WLC.PSA.18.41.006" x-align="PSA.18.41.a007" x-target-ids="t011" x-target="Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.18.42">יְ֝הוָ֗ה</char> <char style="w" x-id="WLC.PSA.18.41.007" x-align="PSA.18.41.a008" x-target-ids="t012" x-target="but" x-target-head="t012" x-head="true" lemma="וְ" stron