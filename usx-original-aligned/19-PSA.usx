	<para style="p"><verse number="12" style="v" x-ref="PSA.73.12" sid="PSA 73:12" /><char style="w" x-id="WLC.PSA.73.12.001" x-align="PSA.73.12.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh-" xml:lang="hbo">הִנֵּה</char>־<char style="w" x-id="WLC.PSA.73.12.002" x-align="PSA.73.12.a002" x-target-ids="t002" x-target="these" x-target-head="t002" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these" x-translit="ʾēlleh" xml:lang="hbo">אֵ֥לֶּה</char> <char style="w" x-id="WLC.PSA.73.12.003" x-align="PSA.73.12.a003" x-target-ids="t003 t004 t005" x-target="are the wicked" x-target-head="t005" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="[are].wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֑ים</char> <char style="w" x-id="WLC.PSA.73.12.004" x-align="PSA.73.12.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[people]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.73.12.005" x-align="PSA.73.12.a005" x-target-ids="t007 t009 t010" x-target="being at ease" x-target-head="t010" x-head="true" lemma="שָׁלֵיו" strong="H7961" x-morph="Aampc" x-gloss="at.ease" x-translit="šalwēy" xml:lang="hbo">שַׁלְוֵ֥י</char> <char style="w" x-id="WLC.PSA.73.12.006" x-align="PSA.73.12.a006" x-target-ids="t008" x-target="alway" x-target-head="t008" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">ע֝וֹלָ֗ם</char> <char style="w" x-id="WLC.PSA.73.12.007" x-align="PSA.73.12.a007" x-target-ids="t011 t012 t013" x-target="they increase in" x-target-head="t012" x-head="true" lemma="שָׂגָה" strong="H7685" x-morph="Vhp3cp" x-gloss="they.increase" x-translit="hiśgû-" xml:lang="hbo">הִשְׂגּוּ</char>־<char style="w" x-id="WLC.PSA.73.12.008" x-align="PSA.73.12.a008" x-target-ids="