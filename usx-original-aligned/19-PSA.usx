	<para style="p"><verse number="1" style="v" x-ref="PSA.2.1" sid="PSA 2:1" /><char style="w" x-id="WLC.PSA.2.1.001" x-align="PSA.2.1.a001" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo">לָ֭</char><char style="w" x-id="WLC.PSA.2.1.002" x-align="PSA.2.1.a001" x-target-ids="t001" x-target="Why" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ" xml:lang="hbo">מָּה</char> <char style="w" x-id="WLC.PSA.2.1.003" x-align="PSA.2.1.a002" x-target-ids="t002 t005" x-target="do rage" x-target-head="t005" x-head="true" lemma="רָגַשׁ" strong="H7283" x-morph="Vqp3cp" x-gloss="do.they.plot" x-translit="rāḡəšû" xml:lang="hbo">רָגְשׁ֣וּ</char> <char style="w" x-id="WLC.PSA.2.1.004" x-align="PSA.2.1.a003" x-target-ids="t003 t004" x-target="the nations" x-target-head="t004" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="ḡôyim" xml:lang="hbo">גוֹיִ֑ם</char> <char style="w" x-id="WLC.PSA.2.1.005" x-align="PSA.2.1.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PSA.2.1.006" x-align="PSA.2.1.a005" x-target-ids="t007 t008" x-target="the peoples" x-target-head="t008" x-head="true" lemma="לְאֹם" strong="H3816" x-morph="Ncmpa" x-gloss="peoples" x-translit="ləʾummiym" xml:lang="hbo">לְאֻמִּ֗ים</char> <char style="w" x-id="WLC.PSA.2.1.007" x-align="PSA.2.1.a006" x-target-ids="t009" x-target="meditate" x-target-head="t009" x-head="true" lemma="הָגָה" strong="H1897" x-morph="Vqi3mp" x-gloss="do.they.devise?" x-translit="yehgû-" xml:lang="hbo">יֶהְגּוּ</char>־<char style="w" x-id="WLC.PSA.2.1.008" x-align="PSA.2.1.a007" x-target-ids="t010 t011 t012" x-target="a vain thing" x-target-head="t011" x-head="true" lemma="רִיק" strong="H7385" x-morph="Ncmsa" x-gloss="emptiness" x-translit="riyq:" xml:lang="hbo">רִֽיק</char>׃<verse eid="PSA 