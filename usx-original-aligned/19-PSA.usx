	<para style="p"><verse number="4" style="v" x-ref="PSA.112.4" x-added-alignments="PSA.112.4.a009" x-added-target-ids="t010" x-added-target="He" sid="PSA 112:4" /><char style="w" x-id="WLC.PSA.112.4.001" x-align="PSA.112.4.a004" x-target-ids="t004 t005" x-target="there ariseth" x-target-head="t005" x-head="true" lemma="זָרַח" strong="H2224" x-morph="Vqp3ms" x-gloss="it.rises" x-translit="zāraḥ" xml:lang="hbo">זָ֘רַ֤ח</char> <char style="w" x-id="WLC.PSA.112.4.002" x-align="PSA.112.4.a006" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.112.4.003" x-align="PSA.112.4.a007" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.112.4.004" x-align="PSA.112.4.a008" x-target-ids="t009" x-target="darkness" x-target-head="t009" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֣שֶׁךְ</char> <char style="w" x-id="WLC.PSA.112.4.005" x-align="PSA.112.4.a005" x-target-ids="t006" x-target="light" x-target-head="t006" x-head="true" lemma="אוֹר" strong="H216" x-morph="Ncbsa" x-gloss="light" x-translit="ʾôr" xml:lang="hbo">א֭וֹר</char><char style="w" x-id="WLC.PSA.112.4.006" x-align="PSA.112.4.a001" x-target-ids="t001" x-target="Unto" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.112.4.007" x-align="PSA.112.4.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.upright" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.112.4.008" x-align="PSA.112.4.a003" x-target-ids="t003" x-target="upright" x-target-head="t003" x-head="true