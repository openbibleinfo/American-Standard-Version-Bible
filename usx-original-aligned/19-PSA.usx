	<para style="p"><verse number="20" style="v" x-ref="PSA.35.20" sid="PSA 35:20" /><char style="w" x-id="WLC.PSA.35.20.001" x-align="PSA.35.20.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PSA.35.20.002" x-align="PSA.35.20.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.PSA.35.20.003" x-align="PSA.35.20.a003" x-target-ids="t005" x-target="peace" x-target-head="t005" x-head="true" lemma="שָׁלוֹם" strong="H7965" x-morph="Ncmsa" x-gloss="peace" x-translit="šālôm" xml:lang="hbo">שָׁל֗וֹם</char> <char style="w" x-id="WLC.PSA.35.20.004" x-align="PSA.35.20.a004" x-target-ids="t002 t003" x-target="they speak" x-target-head="t003" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpi3mp" x-gloss="they.speak" x-translit="yəḏabērû" xml:lang="hbo">יְדַ֫בֵּ֥רוּ</char> <char style="w" x-id="WLC.PSA.35.20.005" x-align="PSA.35.20.a005" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.35.20.006" x-align="PSA.35.20.a006" x-target-ids="t011" x-target="against" x-target-head="t011" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal" xml:lang="hbo">עַ֥ל</char> <char style="w" x-id="WLC.PSA.35.20.007" x-align="PSA.35.20.a007" x-target-ids="t012 t013 t014 t015" x-target="them that are quiet" x-target-head="t015" x-head="true" lemma="רָגֵעַ" strong="H7282" x-morph="Aampc" x-gloss="[the].quiet.[people]" x-translit="riḡʿê-" xml:lang="hbo">רִגְעֵי</char>־<char style="w" x-id="WLC.PSA.35.20.008" x-align="PSA.35.20.a008" x-target-ids="t016 t017 t018" x-target="in the land" x-target-head="t018" x-head="true" lemma="אֶרֶץ