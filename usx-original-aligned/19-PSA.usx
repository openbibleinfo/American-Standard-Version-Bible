	<para style="p"><verse number="13" style="v" x-ref="PSA.45.13" x-added-alignments="PSA.45.13.a006" x-added-target-ids="t005 t006" x-added-target="the palace" sid="PSA 45:13" /><char style="w" x-id="WLC.PSA.45.13.001" x-align="PSA.45.13.a001" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="[is].all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.45.14">כָּל</char>־<char style="w" x-id="WLC.PSA.45.13.002" x-align="PSA.45.13.a002" x-target-ids="t007 t009" x-target="is glorious" x-target-head="t009" x-head="true" lemma="כְּבוּדָּה" strong="H3520" x-morph="Ncfsa" x-gloss="glorious" x-translit="kəḇûdāh" xml:lang="hbo" x-source-ref="PSA.45.14">כְּבוּדָּ֣ה</char> <char style="w" x-id="WLC.PSA.45.13.003" x-align="PSA.45.13.a003" x-target-ids="t003" x-target="daughter" x-target-head="t003" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfsc" x-gloss="a.daughter" x-translit="ḇaṯ-" xml:lang="hbo" x-source-ref="PSA.45.14">בַת</char>־<char style="w" x-id="WLC.PSA.45.13.004" x-align="PSA.45.13.a004" x-target-ids="t001 t002" x-target="The king’s" x-target-head="t002" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="of.a.king" x-translit="meleḵ" xml:lang="hbo" x-source-ref="PSA.45.14">מֶ֣לֶךְ</char> <char style="w" x-id="WLC.PSA.45.13.005" x-align="PSA.45.13.a005" x-target-ids="t004" x-target="within" x-target-head="t004" x-head="true" lemma="פְּנִימָה" strong="H6441" x-morph="D" x-gloss="within" x-translit="pəniymâ" xml:lang="hbo" x-source-ref="PSA.45.14">פְּנִ֑ימָה</char> <char style="w" x-id="WLC.PSA.45.13.006" x-align="PSA.45.13.a007" x-target-ids="t014" x-target="with" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="[is].from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.45.14">מִֽ</char><char style="w" x-id="WLC.PSA.45.13.007" x-align="PSA.45.13.a008" x-target-ids="t012 t013" x-target="is inwrought" x-target-head="t013" x-head="true" l