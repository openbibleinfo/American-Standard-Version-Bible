	<para style="p"><verse number="10" style="v" x-ref="PSA.112.10" x-added-alignments="PSA.112.10.a003" x-added-target-ids="t005" x-added-target="it" sid="PSA 112:10" /><char style="w" x-id="WLC.PSA.112.10.001" x-align="PSA.112.10.a001" x-target-ids="t001 t002" x-target="The wicked" x-target-head="t002" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָ֘שָׁ֤ע</char> <char style="w" x-id="WLC.PSA.112.10.002" x-align="PSA.112.10.a002" x-target-ids="t003 t004" x-target="shall see" x-target-head="t004" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi3ms" x-gloss="he.will.see" x-translit="yirʾeh" xml:lang="hbo">יִרְאֶ֨ה</char>׀<char style="w" x-id="WLC.PSA.112.10.003" x-align="PSA.112.10.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.112.10.004" x-align="PSA.112.10.a005" x-target-ids="t007 t008" x-target="be grieved" x-target-head="t008" x-head="true" lemma="כָּעַס" strong="H3707" x-morph="Vqq3ms" x-gloss="he.will.be.angry" x-translit="ḵāʿās" xml:lang="hbo">כָעָ֗ס</char> <char style="w" x-id="WLC.PSA.112.10.005" x-align="PSA.112.10.a008" x-target-ids="t014" x-target="teeth" x-target-head="t014" x-head="true" lemma="שֵׁן" strong="H8127" x-morph="Ncbdc" x-gloss="teeth" x-translit="šinnāy" xml:lang="hbo">שִׁנָּ֣י</char><char style="w" x-id="WLC.PSA.112.10.006" x-align="PSA.112.10.a007" x-target-ids="t013" x-target="his" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.112.10.007" x-align="PSA.112.10.a006" x-target-ids="t009 t010 t011 t012" x-target="He shall gnash with" x-target-head="t011" x-head="true" lemma="חָרַק" strong="H2786" x-morph="Vqi3ms" x-gloss="he.will.gnash" x-translit="yaḥărōq" xml:lang="hbo">יַחֲרֹ֣ק</char> <char style