	<para style="p"><verse number="17" style="v" x-ref="PSA.73.17" x-added-alignments="PSA.73.17.a006" x-added-target-ids="t009" x-added-target="And" sid="PSA 73:17" /><char style="w" x-id="WLC.PSA.73.17.001" x-align="PSA.73.17.a001" x-target-ids="t001" x-target="Until" x-target-head="t001" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PSA.73.17.002" x-align="PSA.73.17.a002" x-target-ids="t002 t003" x-target="I went" x-target-head="t003" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi1cs" x-gloss="I.went" x-translit="ʾāḇôʾ" xml:lang="hbo">אָ֭בוֹא</char> <char style="w" x-id="WLC.PSA.73.17.003" x-align="PSA.73.17.a003" x-target-ids="t004" x-target="into" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="into" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.PSA.73.17.004" x-align="PSA.73.17.a004" x-target-ids="t005 t006" x-target="the sanctuary" x-target-head="t006" x-head="true" lemma="מִקְדָּשׁ" strong="H4720" x-morph="Ncmpc" x-gloss="the.sanctuari(es)" x-translit="miqdəšê-" xml:lang="hbo">מִקְדְּשֵׁי</char>־<char style="w" x-id="WLC.PSA.73.17.005" x-align="PSA.73.17.a005" x-target-ids="t007 t008" x-target="of God" x-target-head="t008" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="of.God" x-translit="ʾēl" xml:lang="hbo">אֵ֑ל</char> <char style="w" x-id="WLC.PSA.73.17.006" x-align="PSA.73.17.a007" x-target-ids="t010" x-target="considered" x-target-head="t010" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqh1cs" x-gloss="I.considered" x-translit="ʾāḇiynâ" xml:lang="hbo">אָ֝בִ֗ינָה</char> <char style="w" x-id="WLC.PSA.73.17.007" x-align="PSA.73.17.a008" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.73.17.008" x-align="PSA.73.17.a010" x-target-ids="t012 t013" x-target="latter end" x