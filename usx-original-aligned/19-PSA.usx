	<para style="p"><verse number="4" style="v" x-ref="PSA.30.4" sid="PSA 30:4" /><char style="w" x-id="WLC.PSA.30.4.001" x-align="PSA.30.4.a001" x-target-ids="t001 t002" x-target="Sing praise" x-target-head="t001" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vpv2mp" x-gloss="sing.praises" x-translit="zammərû" xml:lang="hbo" x-source-ref="PSA.30.5">זַמְּר֣וּ</char> <char style="w" x-id="WLC.PSA.30.4.002" x-align="PSA.30.4.a002" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.30.5">לַ</char><char style="w" x-id="WLC.PSA.30.4.003" x-align="PSA.30.4.a003" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo" x-source-ref="PSA.30.5">יהוָ֣ה</char> <char style="w" x-id="WLC.PSA.30.4.004" x-align="PSA.30.4.a004" x-target-ids="t005 t006 t007" x-target="O ye saints" x-target-head="t007" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aampc" x-gloss="O" x-translit="ḥăsiyḏāy" xml:lang="hbo" x-source-ref="PSA.30.5">חֲסִידָ֑י</char><char style="w" x-id="WLC.PSA.30.4.005" x-align="PSA.30.4.a005" x-target-ids="t008 t009" x-target="of his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.faithful.[people]" x-translit="w" xml:lang="hbo" x-source-ref="PSA.30.5">ו</char> <char style="w" x-id="WLC.PSA.30.4.006" x-align="PSA.30.4.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.30.5">וְ֝</char><char style="w" x-id="WLC.PSA.30.4.007" x-align="PSA.30.4.a007" x-target-ids="t011 t012" x-target="give thanks" x-target-head="t012" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhv2mp" x-gloss="give.thanks" x-translit="hôḏû" xml:lang="hbo" x-source-ref="PSA.30.5">הוֹד֗וּ</char> <