	<para style="p"><verse number="2" style="v" x-ref="PSA.35.2" sid="PSA 35:2" /><char style="w" x-id="WLC.PSA.35.2.001" x-align="PSA.35.2.a001" x-target-ids="t001 t002 t003" x-target="Take hold of" x-target-head="t002" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vhv2ms" x-gloss="take.hold.of" x-translit="haḥăzēq" xml:lang="hbo">הַחֲזֵ֣ק</char> <char style="w" x-id="WLC.PSA.35.2.002" x-align="PSA.35.2.a002" x-target-ids="t004" x-target="shield" x-target-head="t004" x-head="true" lemma="מָגֵן" strong="H4043" x-morph="Ncbsa" x-gloss="shield" x-translit="māḡēn" xml:lang="hbo">מָגֵ֣ן</char> <char style="w" x-id="WLC.PSA.35.2.003" x-align="PSA.35.2.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.35.2.004" x-align="PSA.35.2.a004" x-target-ids="t006" x-target="buckler" x-target-head="t006" x-head="true" lemma="צִנָּה" strong="H6793a" x-morph="Ncfsa" x-gloss="body.shield" x-translit="ṣinnāh" xml:lang="hbo">צִנָּ֑ה</char> <char style="w" x-id="WLC.PSA.35.2.005" x-align="PSA.35.2.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.35.2.006" x-align="PSA.35.2.a006" x-target-ids="t008 t009" x-target="stand up" x-target-head="t008" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqv2ms" x-gloss="arise" x-translit="qûm" xml:lang="hbo">ק֗וּמָ</char><char style="w" x-id="WLC.PSA.35.2.007" x-align="PSA.35.2.a007" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PSA.35.2.008" x-align="PSA.35.2.a008" x-target-ids="t010" x-target="for" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in)" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.P