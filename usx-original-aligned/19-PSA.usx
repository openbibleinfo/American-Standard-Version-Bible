	<para style="p"><verse number="5" style="v" x-ref="PSA.51.5" sid="PSA 51:5" /><char style="w" x-id="WLC.PSA.51.5.001" x-align="PSA.51.5.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="here!" x-translit="hēn-" xml:lang="hbo" x-source-ref="PSA.51.7">הֵן</char>־<char style="w" x-id="WLC.PSA.51.5.002" x-align="PSA.51.5.a002" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.51.7">בְּ</char><char style="w" x-id="WLC.PSA.51.5.003" x-align="PSA.51.5.a003" x-target-ids="t007" x-target="iniquity" x-target-head="t007" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsa" x-gloss="iniquity" x-translit="ʿāwôn" xml:lang="hbo" x-source-ref="PSA.51.7">עָו֥וֹן</char> <char style="w" x-id="WLC.PSA.51.5.004" x-align="PSA.51.5.a004" x-target-ids="t002 t003 t004 t005" x-target="I was brought forth" x-target-head="t004" x-head="true" lemma="חיל" strong="H2342a" x-morph="VOp1cs" x-gloss="I.was.brought.forth" x-translit="ḥôlālətî" xml:lang="hbo" x-source-ref="PSA.51.7">חוֹלָ֑לְתִּי</char> <char style="w" x-id="WLC.PSA.51.5.005" x-align="PSA.51.5.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.51.7">וּ֝</char><char style="w" x-id="WLC.PSA.51.5.006" x-align="PSA.51.5.a006" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.51.7">בְ</char><char style="w" x-id="WLC.PSA.51.5.007" x-align="PSA.51.5.a007" x-target-ids="t010" x-target="sin" x-target-head="t010" x-head="true" lemma="חֵטְא" strong="H2399" x-morph="Ncmsa" x-gloss="sin" x-translit="ḥēṭəʾ" xml:lang="hbo" x-source-ref="PSA.51.7">חֵ֗טְא</char> <char style="w" x-id="WLC.PSA.51.5.008" x-align=