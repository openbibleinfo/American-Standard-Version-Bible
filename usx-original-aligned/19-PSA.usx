	<para style="d" x-ref="PSA.30.0" x-added-alignments="PSA.30.0.a006" x-added-target-ids="t011 t012" x-added-target="A Psalm"><char style="w" x-id="WLC.PSA.30.0.001" x-align="PSA.30.0.a001" x-target-ids="t001 t002" x-target="A Psalm" x-target-head="t002" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.30.1">מִזְמ֡וֹר</char> <char style="w" x-id="WLC.PSA.30.0.002" x-align="PSA.30.0.a002" x-target-ids="t003 t004" x-target="a Song" x-target-head="t004" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsc" x-gloss="the.song" x-translit="šîr-" xml:lang="hbo" x-source-ref="PSA.30.1">שִׁיר</char>־<char style="w" x-id="WLC.PSA.30.0.003" x-align="PSA.30.0.a003" x-target-ids="t005 t006 t007" x-target="at the Dedication" x-target-head="t007" x-head="true" lemma="חֲנֻכָּה" strong="H2598" x-morph="Ncfsc" x-gloss="of.the.dedication" x-translit="ḥănukkaṯ" xml:lang="hbo" x-source-ref="PSA.30.1">חֲנֻכַּ֖ת</char> <char style="w" x-id="WLC.PSA.30.0.004" x-align="PSA.30.0.a004" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.30.1">הַ</char><char style="w" x-id="WLC.PSA.30.0.005" x-align="PSA.30.0.a005" x-target-ids="t008 t010" x-target="of House" x-target-head="t010" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsa" x-gloss="the.house" x-translit="bayiṯ" xml:lang="hbo" x-source-ref="PSA.30.1">בַּ֣יִת</char> <char style="w" x-id="WLC.PSA.30.0.006" x-align="PSA.30.0.a007" x-target-ids="t013" x-target="of" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.30.1">לְ</char><char style="w" x-id="WLC.PSA.30.0.007" x-align="PSA.30.0.a008" x-target-ids="t014" x-target="David" x-target-head="t014" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ:" xml: