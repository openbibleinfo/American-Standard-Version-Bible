	<para style="p"><verse number="21" style="v" x-ref="PSA.94.21" sid="PSA 94:21" /><char style="w" x-id="WLC.PSA.94.21.001" x-align="PSA.94.21.a001" x-target-ids="t001 t002 t003 t004" x-target="They gather themselves together" x-target-head="t002" x-head="true" lemma="גָּדַד" strong="H1413" x-morph="Vqi3mp" x-gloss="they.band.together" x-translit="yāḡôdû" xml:lang="hbo">יָ֭גוֹדּוּ</char> <char style="w" x-id="WLC.PSA.94.21.002" x-align="PSA.94.21.a002" x-target-ids="t005" x-target="against" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.94.21.003" x-align="PSA.94.21.a003" x-target-ids="t006 t007" x-target="the soul" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="[the].life" x-translit="nep̄eš" xml:lang="hbo">נֶ֣פֶשׁ</char> <char style="w" x-id="WLC.PSA.94.21.004" x-align="PSA.94.21.a004" x-target-ids="t008 t009 t010" x-target="of the righteous" x-target-head="t010" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PSA.94.21.005" x-align="PSA.94.21.a005" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.94.21.006" x-align="PSA.94.21.a007" x-target-ids="t013 t015" x-target="the blood" x-target-head="t015" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmsa" x-gloss="blood" x-translit="ḏām" xml:lang="hbo">דָ֖ם</char> <char style="w" x-id="WLC.PSA.94.21.007" x-align="PSA.94.21.a008" x-target-ids="t014" x-target="innocent" x-target-head="t014" x-head="true" lemma="נָקִי" strong="H5355" x-morph="Aamsa" x-gloss="innocent" x-translit="nāqiy" xml:lang="hbo">נָקִ֣י</char> <char style="w" x-id="WLC.PSA.94.21.008" x-align="PSA.94.21.a006" x-target-ids="t012" x-tar