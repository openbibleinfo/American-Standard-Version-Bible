	<para style="p"><verse number="19" style="v" x-ref="PSA.147.19" sid="PSA 147:19" /><char style="w" x-id="WLC.PSA.147.19.001" x-align="PSA.147.19.a001" x-target-ids="t001 t002" x-target="He showeth" x-target-head="t002" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhrmsa" x-gloss="[the.one.who].declares" x-translit="maggiyḏ" xml:lang="hbo">מַגִּ֣יד</char> <char style="w" x-id="WLC.PSA.147.19.v001.r01.001" x-align="PSA.147.19.a003" x-target-ids="t004" x-target="word" x-target-head="t004" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-translit="ḏḇr" xml:lang="hbo">דבר</char><char style="w" x-id="WLC.PSA.147.19.v001.r01.002" x-align="PSA.147.19.a002" x-target-ids="t003" x-target="his" x-target-head="t003" x-head="true" x-morph="Sp3ms" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.147.19.004" x-align="PSA.147.19.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.147.19.005" x-align="PSA.147.19.a005" x-target-ids="t006" x-target="Jacob" x-target-head="t006" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֑ב</char> <char style="w" x-id="WLC.PSA.147.19.006" x-align="PSA.147.19.a007" x-target-ids="t008" x-target="statutes" x-target-head="t008" x-head="true" lemma="חֹק" strong="H2706" x-morph="Ncmpc" x-gloss="decrees" x-translit="ḥuqqāy" xml:lang="hbo">חֻקָּ֥י</char><char style="w" x-id="WLC.PSA.147.19.007" x-align="PSA.147.19.a006" x-target-ids="t007" x-target="His" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.147.19.008" x-align="PSA.147.19.a008" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝<