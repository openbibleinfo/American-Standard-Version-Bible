	<para style="p"><verse number="29" style="v" x-ref="PSA.69.29" sid="PSA 69:29" /><char style="w" x-id="WLC.PSA.69.29.001" x-align="PSA.69.29.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.69.30">וַ֭</char><char style="w" x-id="WLC.PSA.69.29.002" x-align="PSA.69.29.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾănî" xml:lang="hbo" x-source-ref="PSA.69.30">אֲנִי</char> <char style="w" x-id="WLC.PSA.69.29.003" x-align="PSA.69.29.a003" x-target-ids="t003 t004" x-target="am poor" x-target-head="t004" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aamsa" x-gloss="[am].afflicted" x-translit="ʿāniy" xml:lang="hbo" x-source-ref="PSA.69.30">עָנִ֣י</char> <char style="w" x-id="WLC.PSA.69.29.004" x-align="PSA.69.29.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[am]" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.69.30">וְ</char><char style="w" x-id="WLC.PSA.69.29.005" x-align="PSA.69.29.a005" x-target-ids="t006" x-target="sorrowful" x-target-head="t006" x-head="true" lemma="כָּאַב" strong="H3510" x-morph="Vqrmsa" x-gloss="in.pain" x-translit="ḵôʾēḇ" xml:lang="hbo" x-source-ref="PSA.69.30">כוֹאֵ֑ב</char> <char style="w" x-id="WLC.PSA.69.29.006" x-align="PSA.69.29.a008" x-target-ids="t009" x-target="salvation" x-target-head="t009" x-head="true" lemma="יְשׁוּעָה" strong="H3444" x-morph="Ncfsc" x-gloss="salvation" x-translit="yəšûʿāṯ" xml:lang="hbo" x-source-ref="PSA.69.30">יְשׁוּעָתְ</char><char style="w" x-id="WLC.PSA.69.29.007" x-align="PSA.69.29.a007" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.69.30">ךָ֖</char> <char style="w" x-id=