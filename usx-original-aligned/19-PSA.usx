	<para style="p"><verse number="3" style="v" x-ref="PSA.82.3" sid="PSA 82:3" /><char style="w" x-id="WLC.PSA.82.3.001" x-align="PSA.82.3.a001" x-target-ids="t001" x-target="Judge" x-target-head="t001" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vqv2mp" x-gloss="give.judgment.for" x-translit="šip̄ṭû-" xml:lang="hbo">שִׁפְטוּ</char>־<char style="w" x-id="WLC.PSA.82.3.002" x-align="PSA.82.3.a002" x-target-ids="t002 t003" x-target="the poor" x-target-head="t003" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="[the].poor" x-translit="ḏal" xml:lang="hbo">דַ֥ל</char> <char style="w" x-id="WLC.PSA.82.3.003" x-align="PSA.82.3.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.82.3.004" x-align="PSA.82.3.a004" x-target-ids="t005" x-target="fatherless" x-target-head="t005" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmsa" x-gloss="fatherless" x-translit="yāṯôm" xml:lang="hbo">יָת֑וֹם</char> <char style="w" x-id="WLC.PSA.82.3.005" x-align="PSA.82.3.a006" x-target-ids="t009 t010" x-target="the afflicted" x-target-head="t010" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aamsa" x-gloss="[the].afflicted" x-translit="ʿāniy" xml:lang="hbo">עָנִ֖י</char> <char style="w" x-id="WLC.PSA.82.3.006" x-align="PSA.82.3.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PSA.82.3.007" x-align="PSA.82.3.a008" x-target-ids="t012" x-target="destitute" x-target-head="t012" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="poor" x-translit="rāš" xml:lang="hbo">רָ֣שׁ</char> <char style="w" x-id="WLC.PSA.82.3.008" x-align="PSA.82.3.a005" x-target-ids="t006 t007 t008" x-target="Do justice to" x-target-head="t007" x-head="true" lemma="צָדֵק" 