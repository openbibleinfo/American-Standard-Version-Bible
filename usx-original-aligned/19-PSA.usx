	<para style="p"><verse number="3" style="v" x-ref="PSA.89.3" sid="PSA 89:3" /><char style="w" x-id="WLC.PSA.89.3.001" x-align="PSA.89.3.a001" x-target-ids="t001 t002 t003" x-target="I have made" x-target-head="t003" x-head="true" lemma="כָּרַת" strong="H3772" x-morph="Vqp1cs" x-gloss="I.have.made" x-translit="kāratiy" xml:lang="hbo" x-source-ref="PSA.89.4">כָּרַ֣תִּֽי</char> <char style="w" x-id="WLC.PSA.89.3.002" x-align="PSA.89.3.a002" x-target-ids="t004 t005" x-target="a covenant" x-target-head="t005" x-head="true" lemma="בְּרִית" strong="H1285" x-morph="Ncfsa" x-gloss="a.covenant" x-translit="ḇərîṯ" xml:lang="hbo" x-source-ref="PSA.89.4">בְ֭רִית</char> <char style="w" x-id="WLC.PSA.89.3.003" x-align="PSA.89.3.a003" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="PSA.89.4">לִ</char><char style="w" x-id="WLC.PSA.89.3.004" x-align="PSA.89.3.a004" x-target-ids="t008" x-target="chosen" x-target-head="t008" x-head="true" lemma="בָּחִיר" strong="H972" x-morph="Aamsc" x-gloss="my.chosen" x-translit="ḇəḥiyr" xml:lang="hbo" x-source-ref="PSA.89.4">בְחִירִ֑</char><char style="w" x-id="WLC.PSA.89.3.005" x-align="PSA.89.3.a005" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="one" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.89.4">י</char> <char style="w" x-id="WLC.PSA.89.3.006" x-align="PSA.89.3.a006" x-target-ids="t009 t010 t011" x-target="I have sworn" x-target-head="t011" x-head="true" lemma="שָׁבַע" strong="H7650" x-morph="VNp1cs" x-gloss="I.have.sworn.an.oath" x-translit="nišbaʿətî" xml:lang="hbo" x-source-ref="PSA.89.4">נִ֝שְׁבַּ֗עְתִּי</char> <char style="w" x-id="WLC.PSA.89.3.007" x-align="PSA.89.3.a007" x-target-ids="t012" x-target="unto" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="P