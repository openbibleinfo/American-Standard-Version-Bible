	<para style="p"><verse number="12" style="v" x-ref="PSA.9.12" sid="PSA 9:12" /><char style="w" x-id="WLC.PSA.9.12.001" x-align="PSA.9.12.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.9.13">כִּֽי</char>־<char style="w" x-id="WLC.PSA.9.12.002" x-align="PSA.9.12.a002" x-target-ids="t002 t003 t004 t005" x-target="he that maketh inquisition" x-target-head="t005" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqrmsa" x-gloss="[one.who].seeks" x-translit="ḏōrēš" xml:lang="hbo" x-source-ref="PSA.9.13">דֹרֵ֣שׁ</char> <char style="w" x-id="WLC.PSA.9.12.003" x-align="PSA.9.12.a003" x-target-ids="t006 t007" x-target="for blood" x-target-head="t007" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmpa" x-gloss="blood(s)" x-translit="dāmîm" xml:lang="hbo" x-source-ref="PSA.9.13">דָּ֭מִים</char> <char style="w" x-id="WLC.PSA.9.12.004" x-align="PSA.9.12.a004" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾôṯ" xml:lang="hbo" x-source-ref="PSA.9.13">אוֹתָ֣</char><char style="w" x-id="WLC.PSA.9.12.005" x-align="PSA.9.12.a005" x-target-ids="t009" x-target="them" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="ām" xml:lang="hbo" x-source-ref="PSA.9.13">ם</char> <char style="w" x-id="WLC.PSA.9.12.006" x-align="PSA.9.12.a006" x-target-ids="t008" x-target="remembereth" x-target-head="t008" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqp3ms" x-gloss="he.has.remembered" x-translit="zāḵār" xml:lang="hbo" x-source-ref="PSA.9.13">זָכָ֑ר</char> <char style="w" x-id="WLC.PSA.9.12.007" x-align="PSA.9.12.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.9.13">לֹֽא</char>־<char style="w" x-id="WLC.PSA.9.12.008" x-ali