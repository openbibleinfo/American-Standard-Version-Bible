	<para style="p"><verse number="6" style="v" x-ref="PSA.63.6" x-added-alignments="PSA.63.6.a009" x-added-target-ids="t008" x-added-target="And" sid="PSA 63:6" /><char style="w" x-id="WLC.PSA.63.6.001" x-align="PSA.63.6.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="PSA.63.7">אִם</char>־<char style="w" x-id="WLC.PSA.63.6.002" x-align="PSA.63.6.a002" x-target-ids="t002 t003" x-target="I remember" x-target-head="t003" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqp1cs" x-gloss="I" x-translit="zəḵartiy" xml:lang="hbo" x-source-ref="PSA.63.7">זְכַרְתִּ֥י</char><char style="w" x-id="WLC.PSA.63.6.003" x-align="PSA.63.6.a003" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="have.remembered.you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.63.7">ךָ</char> <char style="w" x-id="WLC.PSA.63.6.004" x-align="PSA.63.6.a004" x-target-ids="t005" x-target="upon" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.63.7">עַל</char>־<char style="w" x-id="WLC.PSA.63.6.005" x-align="PSA.63.6.a005" x-target-ids="t007" x-target="bed" x-target-head="t007" x-head="true" lemma="יָצוּעַ" strong="H3326" x-morph="Ncmpc" x-gloss="beds" x-translit="yəṣûʿ" xml:lang="hbo" x-source-ref="PSA.63.7">יְצוּעָ֑</char><char style="w" x-id="WLC.PSA.63.6.006" x-align="PSA.63.6.a006" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.63.7">י</char> <char style="w" x-id="WLC.PSA.63.6.007" x-align="PSA.63.6.a007" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.63.7">בּ