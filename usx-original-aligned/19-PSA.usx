	<para style="p"><verse number="14" style="v" x-ref="PSA.45.14" sid="PSA 45:14" /><char style="w" x-id="WLC.PSA.45.14.001" x-align="PSA.45.14.a001" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="PSA.45.15">לִ</char><char style="w" x-id="WLC.PSA.45.14.002" x-align="PSA.45.14.a002" x-target-ids="t009 t010" x-target="broidered work" x-target-head="t009" x-head="true" lemma="רִקְמָה" strong="H7553" x-morph="Ncfpa" x-gloss="multicolored.material" x-translit="rəqāmôṯ" xml:lang="hbo" x-source-ref="PSA.45.15">רְקָמוֹת֮</char> <char style="w" x-id="WLC.PSA.45.14.003" x-align="PSA.45.14.a003" x-target-ids="t001 t002 t003 t004" x-target="She shall be led" x-target-head="t004" x-head="true" lemma="יָבַל" strong="H2986" x-morph="VHi3fs" x-gloss="she.is.brought" x-translit="tûḇal" xml:lang="hbo" x-source-ref="PSA.45.15">תּוּבַ֪ל</char> <char style="w" x-id="WLC.PSA.45.14.004" x-align="PSA.45.14.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.45.15">לַ֫</char><char style="w" x-id="WLC.PSA.45.14.005" x-align="PSA.45.14.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.45.15">[הַ]</char><char style="w" x-id="WLC.PSA.45.14.006" x-align="PSA.45.14.a006" x-target-ids="t007" x-target="king" x-target-head="t007" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="king" x-translit="mmeleḵ" xml:lang="hbo" x-source-ref="PSA.45.15">מֶּ֥לֶךְ</char> <char style="w" x-id="WLC.PSA.45.14.007" x-align="PSA.45.14.a007" x-target-ids="t011 t012" x-target="The virgins" x-target-head="t012" x-head="true" lemma="בְּתוּלָה" strong="H1330" x-morph="Ncfpa" x-gloss="virgins" x-translit="bəṯûlôṯ" xml:lang="hbo" x-sour