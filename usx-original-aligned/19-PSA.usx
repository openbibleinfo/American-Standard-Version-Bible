	<para style="p"><verse number="19" style="v" x-ref="PSA.35.19" sid="PSA 35:19" /><char style="w" x-id="WLC.PSA.35.19.001" x-align="PSA.35.19.a001" x-target-ids="t002 t012" x-target="not Neither" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.PSA.35.19.002" x-align="PSA.35.19.a002" x-target-ids="t001 t009" x-target="Let rejoice" x-target-head="t009" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqj3mp" x-gloss="may.they.rejoice" x-translit="yiśməḥû-" xml:lang="hbo">יִשְׂמְחוּ</char>־<char style="w" x-id="WLC.PSA.35.19.003" x-align="PSA.35.19.a003" x-target-ids="t010" x-target="over" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֣</char><char style="w" x-id="WLC.PSA.35.19.004" x-align="PSA.35.19.a004" x-target-ids="t011" x-target="me" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.35.19.005" x-align="PSA.35.19.a005" x-target-ids="t003 t004 t005 t007" x-target="them that are enemies" x-target-head="t007" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾōyəḇ" xml:lang="hbo">אֹיְבַ֣</char><char style="w" x-id="WLC.PSA.35.19.006" x-align="PSA.35.19.a006" x-target-ids="t006" x-target="mine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.35.19.007" x-align="PSA.35.19.a007" x-target-ids="t008" x-target="wrongfully" x-target-head="t008" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="falsehood" x-translit="šeqer" xml:lang="hbo">שֶׁ֑קֶר</char> <char style="w" x-id="WLC.PSA.35.19.008" x-align="PSA.35.19.a008" x-target-ids="t014 t019 t020" x-target="them that hate" x-target-head="t020" x-head="true" l