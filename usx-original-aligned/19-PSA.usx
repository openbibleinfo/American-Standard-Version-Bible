	<para style="p"><verse number="4" style="v" x-ref="PSA.60.4" sid="PSA 60:4" /><char style="w" x-id="WLC.PSA.60.4.001" x-align="PSA.60.4.a001" x-target-ids="t001 t002 t003" x-target="Thou hast given" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp2ms" x-gloss="you.have.set.up" x-translit="nāṯatâ" xml:lang="hbo" x-source-ref="PSA.60.6">נָ֘תַ֤תָּה</char> <char style="w" x-id="WLC.PSA.60.4.002" x-align="PSA.60.4.a003" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for.[those]" x-translit="lli" xml:lang="hbo" x-source-ref="PSA.60.6">לִּ</char><char style="w" x-id="WLC.PSA.60.4.003" x-align="PSA.60.4.a004" x-target-ids="t007 t008 t009" x-target="them that fear" x-target-head="t009" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aampc" x-gloss="fearing" x-translit="yrēʾey" xml:lang="hbo" x-source-ref="PSA.60.6">ירֵאֶ֣י</char><char style="w" x-id="WLC.PSA.60.4.004" x-align="PSA.60.4.a005" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.60.6">ךָ</char> <char style="w" x-id="WLC.PSA.60.4.005" x-align="PSA.60.4.a002" x-target-ids="t004 t005" x-target="a banner" x-target-head="t005" x-head="true" lemma="נֵס" strong="H5251" x-morph="Ncmsa" x-gloss="a.standard" x-translit="nnēs" xml:lang="hbo" x-source-ref="PSA.60.6">נֵּ֭ס</char> <char style="w" x-id="WLC.PSA.60.4.006" x-align="PSA.60.4.a006" x-target-ids="t011" x-target="That" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.60.6">לְ</char><char style="w" x-id="WLC.PSA.60.4.007" x-align="PSA.60.4.a007" x-target-ids="t012 t013 t014 t015" x-target="it may be displayed" x-target-head="t015" x-head="true" lemma="נסס" strong="H5264" x-morph="Vrc" x-gloss="be.displayed" x-translit="hiṯnôsēs" xml:lang="hbo" x-source-re