	<para style="p"><verse number="9" style="v" x-ref="PSA.104.9" x-added-alignments="PSA.104.9.a003 PSA.104.9.a007" x-added-target-ids="t006 t012" x-added-target="that | That" sid="PSA 104:9" /><char style="w" x-id="WLC.PSA.104.9.001" x-align="PSA.104.9.a001" x-target-ids="t004 t005" x-target="a bound" x-target-head="t005" x-head="true" lemma="גְּבוּל" strong="H1366" x-morph="Ncmsa" x-gloss="a.boundary" x-translit="gəḇûl-" xml:lang="hbo">גְּֽבוּל</char>־<char style="w" x-id="WLC.PSA.104.9.002" x-align="PSA.104.9.a002" x-target-ids="t001 t002 t003" x-target="Thou hast set" x-target-head="t003" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqp2ms" x-gloss="you.set" x-translit="śamtā" xml:lang="hbo">שַׂ֭מְתָּ</char> <char style="w" x-id="WLC.PSA.104.9.003" x-align="PSA.104.9.a004" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PSA.104.9.004" x-align="PSA.104.9.a005" x-target-ids="t007 t008 t010 t011" x-target="they may pass over" x-target-head="t010" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqi3mp" x-gloss="they" x-translit="yaʿăḇōrû" xml:lang="hbo">יַֽעֲבֹר֑וּ</char><char style="w" x-id="WLC.PSA.104.9.005" x-align="PSA.104.9.a006" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="will.pass" x-translit="n" xml:lang="hbo">ן</char> <char style="w" x-id="WLC.PSA.104.9.006" x-align="PSA.104.9.a008" x-target-ids="t015" x-target="not" x-target-head="t015" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PSA.104.9.007" x-align="PSA.104.9.a009" x-target-ids="t013 t014 t016" x-target="they turn again" x-target-head="t014" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi3mp" x-gloss="they" x-translit="yəšûḇû" xml:lang="hbo">יְ֝שׁוּב֗וּ</char><char style="w" x-id="WLC.PSA.104.9.008" x-al