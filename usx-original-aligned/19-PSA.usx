	<para style="p"><verse number="4" style="v" x-ref="PSA.129.4" sid="PSA 129:4" /><char style="w" x-id="WLC.PSA.129.4.001" x-align="PSA.129.4.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֥ה</char> <char style="w" x-id="WLC.PSA.129.4.002" x-align="PSA.129.4.a002" x-target-ids="t002 t003" x-target="is righteous" x-target-head="t003" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="[is].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PSA.129.4.003" x-align="PSA.129.4.a003" x-target-ids="t004 t005 t006 t007" x-target="He hath cut asunder" x-target-head="t006" x-head="true" lemma="קָצַץ" strong="H7112" x-morph="Vpp3ms" x-gloss="he.has.cut.off" x-translit="qiṣṣēṣ" xml:lang="hbo">קִ֝צֵּ֗ץ</char> <char style="w" x-id="WLC.PSA.129.4.004" x-align="PSA.129.4.a004" x-target-ids="t008 t009" x-target="the cords" x-target-head="t009" x-head="true" lemma="עֲבֹת" strong="H5688" x-morph="Ncbsc" x-gloss="[the].rope" x-translit="ʿăḇôṯ" xml:lang="hbo">עֲב֣וֹת</char> <char style="w" x-id="WLC.PSA.129.4.005" x-align="PSA.129.4.a005" x-target-ids="t010 t011 t012" x-target="of the wicked" x-target-head="t012" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym:" xml:lang="hbo">רְשָׁעִֽים</char>׃<verse eid="PSA 129:4" /></para>
