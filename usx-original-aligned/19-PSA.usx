	<para style="p"><verse number="30" style="v" x-ref="PSA.109.30" sid="PSA 109:30" /><char style="w" x-id="WLC.PSA.109.30.001" x-align="PSA.109.30.a001" x-target-ids="t001 t002 t003 t005 t006" x-target="I will give thanks unto" x-target-head="t005" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I.will.give.thanks.to" x-translit="ʾôḏeh" xml:lang="hbo">א֘וֹדֶ֤ה</char> <char style="w" x-id="WLC.PSA.109.30.002" x-align="PSA.109.30.a002" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.109.30.003" x-align="PSA.109.30.a003" x-target-ids="t004" x-target="great" x-target-head="t004" x-head="true" lemma="מְאֹד" strong="H3966" x-morph="D" x-gloss="exceedingly" x-translit="məʾōḏ" xml:lang="hbo">מְאֹ֣ד</char> <char style="w" x-id="WLC.PSA.109.30.004" x-align="PSA.109.30.a004" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.109.30.005" x-align="PSA.109.30.a005" x-target-ids="t010" x-target="mouth" x-target-head="t010" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄" xml:lang="hbo">פִ֑</char><char style="w" x-id="WLC.PSA.109.30.006" x-align="PSA.109.30.a006" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.109.30.007" x-align="PSA.109.30.a007" x-target-ids="t011" x-target="Yea" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.109.30.008" x-align="PSA.109.30.a008" lemma="בְּ" strong="H871a" x-morph="R" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="