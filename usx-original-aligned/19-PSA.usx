	<para style="p"><verse number="10" style="v" x-ref="PSA.91.10" sid="PSA 91:10" /><char style="w" x-id="WLC.PSA.91.10.001" x-align="PSA.91.10.a001" x-target-ids="t003" x-target="no" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PSA.91.10.002" x-align="PSA.91.10.a002" x-target-ids="t001 t002 t005" x-target="There shall befall" x-target-head="t005" x-head="true" lemma="אָנָה" strong="H579" x-morph="VPi3fs" x-gloss="it.will.happen" x-translit="ṯəʾunneh" xml:lang="hbo">תְאֻנֶּ֣ה</char> <char style="w" x-id="WLC.PSA.91.10.003" x-align="PSA.91.10.a003" x-status="unrepresented" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēley" xml:lang="hbo">אֵלֶ֣י</char><char style="w" x-id="WLC.PSA.91.10.004" x-align="PSA.91.10.a004" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.91.10.005" x-align="PSA.91.10.a005" x-target-ids="t004" x-target="evil" x-target-head="t004" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="harm" x-translit="rāʿāh" xml:lang="hbo">רָעָ֑ה</char> <char style="w" x-id="WLC.PSA.91.10.006" x-align="PSA.91.10.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.91.10.007" x-align="PSA.91.10.a007" x-target-ids="t009 t010" x-target="any plague" x-target-head="t010" x-head="true" lemma="נֶגַע" strong="H5061" x-morph="Ncmsa" x-gloss="plague" x-translit="neḡaʿ" xml:lang="hbo">נֶ֗גַע</char> <char style="w" x-id="WLC.PSA.91.10.008" x-align="PSA.91.10.a006" x-target-ids="t007" x-target="Neither" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.91.10.009" x-align="PSA.91.