	<para style="d" x-ref="PSA.58.0" x-added-alignments="PSA.58.0.a004 PSA.58.0.a007" x-added-target-ids="t005 t006 t009 t010" x-added-target="set to | A Psalm"><char style="w" x-id="WLC.PSA.58.0.001" x-align="PSA.58.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.58.1">לַ</char><char style="w" x-id="WLC.PSA.58.0.002" x-align="PSA.58.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.58.1">[הַ]</char><char style="w" x-id="WLC.PSA.58.0.003" x-align="PSA.58.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.58.1">מְנַצֵּ֥חַ</char> <char style="w" x-id="WLC.PSA.58.0.004" x-align="PSA.58.0.a005" x-target-ids="t007" x-target="Al" x-target-head="t007" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="al-" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.58.1">אַל</char>־<char style="w" x-id="WLC.PSA.58.0.005" x-align="PSA.58.0.a006" x-target-ids="t008" x-target="tashheth" x-target-head="t008" x-head="true" lemma="שׁחת" strong="H7843" x-morph="Vhi2ms" x-gloss="tashcheth" x-translit="tašḥēṯ" xml:lang="hbo" x-source-ref="PSA.58.1">תַּשְׁחֵ֗ת</char> <char style="w" x-id="WLC.PSA.58.0.006" x-align="PSA.58.0.a008" x-target-ids="t011" x-target="of" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.58.1">לְ</char><char style="w" x-id="WLC.PSA.58.0.007" x-align="PSA.58.0.a009" x-target-ids="t012" x-target="David" x-target-head="t012" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo" x-source-ref="PSA.58.1">