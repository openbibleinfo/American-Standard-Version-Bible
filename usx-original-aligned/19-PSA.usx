	<para style="p"><verse number="5" style="v" x-ref="PSA.64.5" sid="PSA 64:5" /><char style="w" x-id="WLC.PSA.64.5.001" x-align="PSA.64.5.a001" x-target-ids="t001 t002 t004" x-target="They encourage in" x-target-head="t002" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vpi3mp" x-gloss="they.strengthen" x-translit="yəḥazzəqû-" xml:lang="hbo" x-source-ref="PSA.64.6">יְחַזְּקוּ</char>־<char style="w" x-id="WLC.PSA.64.5.002" x-align="PSA.64.5.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807z" x-morph="R" x-gloss="(for" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.64.6">לָ֨</char><char style="w" x-id="WLC.PSA.64.5.003" x-align="PSA.64.5.a003" x-target-ids="t003" x-target="themselves" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="themselves" x-translit="mô" xml:lang="hbo" x-source-ref="PSA.64.6">מוֹ</char>׀<char style="w" x-id="WLC.PSA.64.5.004" x-align="PSA.64.5.a004" x-target-ids="t005 t007" x-target="an purpose" x-target-head="t007" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsa" x-gloss="a.matter" x-translit="dāḇār" xml:lang="hbo" x-source-ref="PSA.64.6">דָּ֘בָ֤ר</char> <char style="w" x-id="WLC.PSA.64.5.005" x-align="PSA.64.5.a005" x-target-ids="t006" x-target="evil" x-target-head="t006" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="evil" x-translit="rāʿ" xml:lang="hbo" x-source-ref="PSA.64.6">רָ֗ע</char> <char style="w" x-id="WLC.PSA.64.5.006" x-align="PSA.64.5.a006" x-target-ids="t008 t009" x-target="They commune" x-target-head="t009" x-head="true" lemma="סָפַר" strong="H5608" x-morph="Vpi3mp" x-gloss="they.speak" x-translit="yəsappərû" xml:lang="hbo" x-source-ref="PSA.64.6">יְֽ֭סַפְּרוּ</char> <char style="w" x-id="WLC.PSA.64.5.007" x-align="PSA.64.5.a007" x-target-ids="t010" x-target="of" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="PSA.64.6">לִ</char><char style="w" x-id="W