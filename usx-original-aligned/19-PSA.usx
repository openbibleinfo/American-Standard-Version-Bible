	<para style="d" x-ref="PSA.89.0"><char style="w" x-id="WLC.PSA.89.0.001" x-align="PSA.89.0.a001" x-target-ids="t001" x-target="Maschil" x-target-head="t001" x-head="true" lemma="מַשְׂכִּיל" strong="H4905" x-morph="Ncmsa" x-gloss="a.poem" x-translit="maśkiyl" xml:lang="hbo" x-source-ref="PSA.89.1">מַ֝שְׂכִּ֗יל</char> <char style="w" x-id="WLC.PSA.89.0.002" x-align="PSA.89.0.a002" x-target-ids="t002" x-target="of" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.89.1">לְ</char><char style="w" x-id="WLC.PSA.89.0.003" x-align="PSA.89.0.a003" x-target-ids="t003" x-target="Ethan" x-target-head="t003" x-head="true" lemma="אֵיתָן" strong="H387" x-morph="Np" x-gloss="Ethan" x-translit="ʾêṯān" xml:lang="hbo" x-source-ref="PSA.89.1">אֵיתָ֥ן</char> <char style="w" x-id="WLC.PSA.89.0.004" x-align="PSA.89.0.a004" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.89.1">הָֽ</char><char style="w" x-id="WLC.PSA.89.0.005" x-align="PSA.89.0.a005" x-target-ids="t005" x-target="Ezrahite" x-target-head="t005" x-head="true" lemma="אֶזְרָחִי" strong="H250" x-morph="Ngmsa" x-gloss="Ezrachite" x-translit="ʾezrāḥiy:" xml:lang="hbo" x-source-ref="PSA.89.1">אֶזְרָחִֽי</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.89.1" sid="PSA 89:1" /><char style="w" x-id="WLC.PSA.89.1.001" x-align="PSA.89.1.a001" x-target-ids="t004 t005 t006" x-target="of the lovingkindness" x-target-head="t006" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmpc" x-gloss="the.covenant.loyalti(es)" x-translit="ḥasəḏēy" xml:lang="hbo" x-source-ref="PSA.89.2">חַֽסְדֵ֣י</char> <char style="w" x-id="WLC.PSA.89.1.002" x-align="PSA.89.1.a002" x-target-ids="t007 t008" x-target="of Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.89.2">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.89.1.003" x-align="PSA.89.1.a003" x-target-ids="t009 t010" x-target="for ever" x-target-head="t010" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="forever" x-translit="ʿôlām" xml:lang="hbo" x-source-ref="PSA.89.2">עוֹלָ֣ם</char> <char style="w" x-id="WLC.PSA.89.1.004" x-align="PSA.89.1.a004" x-target-ids="t001 t002 t003" x-target="I will sing" x-target-head="t003" x-head="true" lemma="שִׁיר" strong="H7891" x-morph="Vqh1cs" x-gloss="I.will.sing" x-translit="ʾāšiyrâ" xml:lang="hbo" x-source-ref="PSA.89.2">אָשִׁ֑ירָה</char> <char style="w" x-id="WLC.PSA.89.1.005" x-align="PSA.89.1.a005" x-target-ids="t020" x-target="to" x-target-head="t020" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.89.2">לְ</char><char style="w" x-id="WLC.PSA.89.1.006" x-align="PSA.89.1.a006" x-status="unrepresented" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsa" x-gloss="a.generation" x-translit="ḏōr" xml:lang="hbo" x-source-ref="PSA.89.2">דֹ֥ר</char> <char style="w" x-id="WLC.PSA.89.1.007" x-align="PSA.89.1.a007" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo" x-source-ref="PSA.89.2">וָ</char><char style="w" x-id="WLC.PSA.89.1.0