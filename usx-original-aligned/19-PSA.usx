	<para style="p"><verse number="3" style="v" x-ref="PSA.98.3" sid="PSA 98:3" /><char style="w" x-id="WLC.PSA.98.3.001" x-align="PSA.98.3.a001" x-target-ids="t001 t002 t003" x-target="He hath remembered" x-target-head="t003" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqp3ms" x-gloss="he.has.remembered" x-translit="zāḵar" xml:lang="hbo">זָ֘כַ֤ר</char> <char style="w" x-id="WLC.PSA.98.3.002" x-align="PSA.98.3.a002" x-target-ids="t005" x-target="lovingkindness" x-target-head="t005" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo">חַסְדּ֨</char><char style="w" x-id="WLC.PSA.98.3.003" x-align="PSA.98.3.a003" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.covenant" x-translit="ô" xml:lang="hbo">וֹ</char>׀<char style="w" x-id="WLC.PSA.98.3.004" x-align="PSA.98.3.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="we" xml:lang="hbo">וֶֽ</char><char style="w" x-id="WLC.PSA.98.3.005" x-align="PSA.98.3.a005" x-target-ids="t008" x-target="faithfulness" x-target-head="t008" x-head="true" lemma="אֱמוּנָה" strong="H530" x-morph="Ncfsc" x-gloss="faithfulness" x-translit="ʾĕmûnāṯ" xml:lang="hbo">אֱֽמוּנָת</char><char style="w" x-id="WLC.PSA.98.3.006" x-align="PSA.98.3.a006" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ֮</char> <char style="w" x-id="WLC.PSA.98.3.007" x-align="PSA.98.3.a007" x-target-ids="t009" x-target="toward" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.98.3.008" x-align="PSA.98.3.a008" x-target-ids="t010 t011" x-target="the house" x-target-head="t011" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Nc