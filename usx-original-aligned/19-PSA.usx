	<para style="p"><verse number="14" style="v" x-ref="PSA.92.14" sid="PSA 92:14" /><char style="w" x-id="WLC.PSA.92.14.001" x-align="PSA.92.14.a001" x-target-ids="t003" x-target="still" x-target-head="t003" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="still" x-translit="ʿôḏ" xml:lang="hbo" x-source-ref="PSA.92.15">ע֭וֹד</char> <char style="w" x-id="WLC.PSA.92.14.002" x-align="PSA.92.14.a002" x-target-ids="t001 t002 t004 t005 t006" x-target="They shall bring forth fruit" x-target-head="t006" x-head="true" lemma="נוּב" strong="H5107" x-morph="Vqi3mp" x-gloss="they" x-translit="yənûḇû" xml:lang="hbo" x-source-ref="PSA.92.15">יְנוּב֣וּ</char><char style="w" x-id="WLC.PSA.92.14.003" x-align="PSA.92.14.a003" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="will.bear.fruit" x-translit="n" xml:lang="hbo" x-source-ref="PSA.92.15">ן</char> <char style="w" x-id="WLC.PSA.92.14.004" x-align="PSA.92.14.a004" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.92.15">בְּ</char><char style="w" x-id="WLC.PSA.92.14.005" x-align="PSA.92.14.a005" x-target-ids="t008 t009" x-target="old age" x-target-head="t008" x-head="true" lemma="שֵׂיבָה" strong="H7872" x-morph="Ncfsa" x-gloss="old.age" x-translit="śêḇāh" xml:lang="hbo" x-source-ref="PSA.92.15">שֵׂיבָ֑ה</char> <char style="w" x-id="WLC.PSA.92.14.006" x-align="PSA.92.14.a006" x-target-ids="t013 t014 t015" x-target="full of sap" x-target-head="t013" x-head="true" lemma="דָּשֵׁן" strong="H1879" x-morph="Aampa" x-gloss="fat" x-translit="dəšēniym" xml:lang="hbo" x-source-ref="PSA.92.15">דְּשֵׁנִ֖ים</char> <char style="w" x-id="WLC.PSA.92.14.007" x-align="PSA.92.14.a007" x-target-ids="t016" x-target="and" x-target-head="t016" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.92.15">וְ</char><char style="w"