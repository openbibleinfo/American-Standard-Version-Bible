	<para style="p"><verse number="1" style="v" x-ref="PSA.93.1" x-added-alignments="PSA.93.1.a009 PSA.93.1.a013" x-added-target-ids="t017 t023" x-added-target="therewith | that" sid="PSA 93:1" /><char style="w" x-id="WLC.PSA.93.1.001" x-align="PSA.93.1.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.93.1.002" x-align="PSA.93.1.a002" x-target-ids="t002" x-target="reigneth" x-target-head="t002" x-head="true" lemma="מָלַךְ" strong="H4427" x-morph="Vqp3ms" x-gloss="he.reigns" x-translit="mālāḵə" xml:lang="hbo">מָלָךְ֮</char> <char style="w" x-id="WLC.PSA.93.1.003" x-align="PSA.93.1.a004" x-target-ids="t007" x-target="majesty" x-target-head="t007" x-head="true" lemma="גֵּאוּת" strong="H1348" x-morph="Ncfsa" x-gloss="majesty" x-translit="gēʾûṯ" xml:lang="hbo">גֵּא֪וּת</char> <char style="w" x-id="WLC.PSA.93.1.004" x-align="PSA.93.1.a003" x-target-ids="t003 t004 t005 t006" x-target="he is clothed with" x-target-head="t005" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqp3ms" x-gloss="he.is.clothed" x-translit="lāḇēš" xml:lang="hbo">לָ֫בֵ֥שׁ</char> <char style="w" x-id="WLC.PSA.93.1.005" x-align="PSA.93.1.a006" x-target-ids="t009 t010 t011" x-target="is clothed with" x-target-head="t010" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqp3ms" x-gloss="he.is.clothed" x-translit="lāḇēš" xml:lang="hbo">לָבֵ֣שׁ</char> <char style="w" x-id="WLC.PSA.93.1.006" x-align="PSA.93.1.a005" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.93.1.007" x-align="PSA.93.1.a007" x-target-ids="t012" x-target="strength" x-target-head="t012" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsa" x-gloss="strength" x-translit="ʿōz" xml:lang="hbo">עֹ֣ז</char> <c