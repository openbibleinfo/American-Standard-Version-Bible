	<para style="p"><verse number="3" style="v" x-ref="PSA.68.3" sid="PSA 68:3" /><char style="w" x-id="WLC.PSA.68.3.001" x-align="PSA.68.3.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.68.4">וְֽ</char><char style="w" x-id="WLC.PSA.68.3.002" x-align="PSA.68.3.a002" x-target-ids="t003 t004" x-target="the righteous" x-target-head="t004" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo" x-source-ref="PSA.68.4">צַדִּיקִ֗ים</char> <char style="w" x-id="WLC.PSA.68.3.003" x-align="PSA.68.3.a003" x-target-ids="t002 t005 t006" x-target="let be glad" x-target-head="t006" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3mp" x-gloss="may.they.rejoice" x-translit="yiśməḥû" xml:lang="hbo" x-source-ref="PSA.68.4">יִשְׂמְח֣וּ</char> <char style="w" x-id="WLC.PSA.68.3.004" x-align="PSA.68.3.a004" x-target-ids="t007 t008 t009" x-target="let them exult" x-target-head="t009" x-head="true" lemma="עָלַץ" strong="H5970" x-morph="Vqi3mp" x-gloss="may.they.exult" x-translit="yaʿalṣû" xml:lang="hbo" x-source-ref="PSA.68.4">יַֽ֭עַלְצוּ</char> <char style="w" x-id="WLC.PSA.68.3.005" x-align="PSA.68.3.a005" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="li" xml:lang="hbo" x-source-ref="PSA.68.4">לִ</char><char style="w" x-id="WLC.PSA.68.3.006" x-align="PSA.68.3.a005" x-target-ids="t010" x-target="before" x-target-head="t010" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ənēy" xml:lang="hbo" x-source-ref="PSA.68.4">פְנֵ֥י</char> <char style="w" x-id="WLC.PSA.68.3.007" x-align="PSA.68.3.a006" x-target-ids="t011" x-target="God" x-target-head="t011" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.68.4">אֱלֹהִ֗ים</char> <char style="w" x-id="WLC.PSA.68.3.008" 