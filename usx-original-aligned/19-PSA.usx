	<para style="p"><verse number="14" style="v" x-ref="PSA.73.14" sid="PSA 73:14" /><char style="w" x-id="WLC.PSA.73.14.001" x-align="PSA.73.14.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PSA.73.14.002" x-align="PSA.73.14.a005" x-target-ids="t006 t007 t008" x-target="have I been" x-target-head="t008" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw1cs" x-gloss="I.have.been" x-translit="ʾĕhiy" xml:lang="hbo">אֱהִ֣י</char> <char style="w" x-id="WLC.PSA.73.14.003" x-align="PSA.73.14.a006" x-target-ids="t009" x-target="plagued" x-target-head="t009" x-head="true" lemma="נָגַע" strong="H5060" x-morph="Vqsmsa" x-gloss="stricken" x-translit="nāḡûᵃʿ" xml:lang="hbo">נָ֭גוּעַ</char> <char style="w" x-id="WLC.PSA.73.14.004" x-align="PSA.73.14.a002" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.73.14.005" x-align="PSA.73.14.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PSA.73.14.006" x-align="PSA.73.14.a004" x-target-ids="t004 t005" x-target="day long" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּ֑וֹם</char> <char style="w" x-id="WLC.PSA.73.14.007" x-align="PSA.73.14.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.73.14.008" x-align="PSA.73.14.a008" x-target-ids="t011" x-target="chastened" x-target-head="t011" x-head="true" lemma="תּוֹכַחַת" strong="H8433a" x-morph="Ncfsc" x-gloss="rebuke" x-tr