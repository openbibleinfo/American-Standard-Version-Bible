	<para style="p"><verse number="31" style="v" x-ref="PSA.69.31" x-added-alignments="PSA.69.31.a007 PSA.69.31.a010" x-added-target-ids="t010 t016" x-added-target="Or | and" sid="PSA 69:31" /><char style="w" x-id="WLC.PSA.69.31.001" x-align="PSA.69.31.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.69.32">וְ</char><char style="w" x-id="WLC.PSA.69.31.002" x-align="PSA.69.31.a002" x-target-ids="t002 t003 t004" x-target="it will please" x-target-head="t004" x-head="true" lemma="יָטַב" strong="H3190" x-morph="Vqi3fs" x-gloss="it.will.be.good" x-translit="ṯîṭaḇ" xml:lang="hbo" x-source-ref="PSA.69.32">תִיטַ֣ב</char> <char style="w" x-id="WLC.PSA.69.31.003" x-align="PSA.69.31.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.69.32">לַֽ֭</char><char style="w" x-id="WLC.PSA.69.31.004" x-align="PSA.69.31.a004" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwâ" xml:lang="hbo" x-source-ref="PSA.69.32">יהוָה</char> <char style="w" x-id="WLC.PSA.69.31.005" x-align="PSA.69.31.a005" x-target-ids="t006 t007" x-target="better than" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.69.32">מִ</char><char style="w" x-id="WLC.PSA.69.31.006" x-align="PSA.69.31.a006" x-target-ids="t008 t009" x-target="an ox" x-target-head="t009" x-head="true" lemma="שׁוֹר" strong="H7794" x-morph="Ncmsa" x-gloss="than.an.ox" x-translit="ššôr" xml:lang="hbo" x-source-ref="PSA.69.32">שּׁ֥וֹר</char> <char style="w" x-id="WLC.PSA.69.31.007" x-align="PSA.69.31.a008" x-target-ids="t011 t012" x-target="a bullock" x-target-head="t012" x-head="true" lemma="פַּר" strong="H6499" x-morph="Ncmsa" x-gloss="a.young.bu