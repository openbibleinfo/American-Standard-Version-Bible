	<para style="p"><verse number="7" style="v" x-ref="PSA.44.7" sid="PSA 44:7" /><char style="w" x-id="WLC.PSA.44.7.001" x-align="PSA.44.7.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.44.8">כִּ֣י</char> <char style="w" x-id="WLC.PSA.44.7.002" x-align="PSA.44.7.a002" x-target-ids="t002 t003 t004" x-target="thou hast saved" x-target-head="t004" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="Vhp2ms" x-gloss="you" x-translit="hôšaʿtā" xml:lang="hbo" x-source-ref="PSA.44.8">ה֭וֹשַׁעְתָּ</char><char style="w" x-id="WLC.PSA.44.7.003" x-align="PSA.44.7.a003" x-target-ids="t005" x-target="us" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="have.saved.us" x-translit="nû" xml:lang="hbo" x-source-ref="PSA.44.8">נוּ</char> <char style="w" x-id="WLC.PSA.44.7.004" x-align="PSA.44.7.a004" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.44.8">מִ</char><char style="w" x-id="WLC.PSA.44.7.005" x-align="PSA.44.7.a005" x-target-ids="t008" x-target="adversaries" x-target-head="t008" x-head="true" lemma="צַר" strong="H6862a" x-morph="Ncmpc" x-gloss="foes" x-translit="ṣṣārēy" xml:lang="hbo" x-source-ref="PSA.44.8">צָּרֵ֑י</char><char style="w" x-id="WLC.PSA.44.7.006" x-align="PSA.44.7.a006" x-target-ids="t007" x-target="our" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo" x-source-ref="PSA.44.8">נוּ</char> <char style="w" x-id="WLC.PSA.44.7.007" x-align="PSA.44.7.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.44.8">וּ</char><char style="w" x-id="WLC.PSA.44.7.008" x-align="PSA.44.7.a008"