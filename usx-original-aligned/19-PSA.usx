	<para style="p"><verse number="45" style="v" x-ref="PSA.18.45" sid="PSA 18:45" /><char style="w" x-id="WLC.PSA.18.45.001" x-align="PSA.18.45.a001" x-target-ids="t001 t002" x-target="The foreigners" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="sons" x-translit="bənê-" xml:lang="hbo" x-source-ref="PSA.18.46">בְּנֵי</char>־<char style="w" x-id="WLC.PSA.18.45.002" x-align="PSA.18.45.a001" lemma="נֵכָר" strong="H5236" x-morph="Ncmsa" x-gloss="of.foreignness" x-translit="nēḵār" xml:lang="hbo" x-source-ref="PSA.18.46">נֵכָ֥ר</char> <char style="w" x-id="WLC.PSA.18.45.003" x-align="PSA.18.45.a002" x-target-ids="t003 t004 t005" x-target="shall fade away" x-target-head="t004" x-head="true" lemma="נָבֵל" strong="H5034" x-morph="Vqi3mp" x-gloss="they.withered" x-translit="yibbōlû" xml:lang="hbo" x-source-ref="PSA.18.46">יִבֹּ֑לוּ</char> <char style="w" x-id="WLC.PSA.18.45.004" x-align="PSA.18.45.a003" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.46">וְ֝</char><char style="w" x-id="WLC.PSA.18.45.005" x-align="PSA.18.45.a004" x-target-ids="t007 t008 t009" x-target="shall come trembling" x-target-head="t009" x-head="true" lemma="חָרַג" strong="H2727" x-morph="Vqi3mp" x-gloss="they.came.trembling" x-translit="yaḥrəḡû" xml:lang="hbo" x-source-ref="PSA.18.46">יַחְרְג֗וּ</char> <char style="w" x-id="WLC.PSA.18.45.006" x-align="PSA.18.45.a005" x-target-ids="t010 t011" x-target="out of" x-target-head="t010" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.18.46">מִֽ</char><char style="w" x-id="WLC.PSA.18.45.007" x-align="PSA.18.45.a007" x-target-ids="t013 t014" x-target="close places" x-target-head="t013" x-head="true" lemma="מִסְגֶּרֶת" strong="H4526" x-morph="Ncfpc" x-gloss="strongholds" x-translit="mmisgərôṯēy" xml:lang="hbo" x-source-ref="PSA.18