	<para style="p"><verse number="16" style="v" x-ref="PSA.10.16" sid="PSA 10:16" /><char style="w" x-id="WLC.PSA.10.16.001" x-align="PSA.10.16.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.10.16.002" x-align="PSA.10.16.a002" x-target-ids="t002 t003" x-target="is King" x-target-head="t003" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsc" x-gloss="[is].king" x-translit="meleḵ" xml:lang="hbo">מֶ֭לֶךְ</char> <char style="w" x-id="WLC.PSA.10.16.003" x-align="PSA.10.16.a003" x-target-ids="t004 t005" x-target="for ever" x-target-head="t005" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="forever" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֣ם</char> <char style="w" x-id="WLC.PSA.10.16.004" x-align="PSA.10.16.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PSA.10.16.005" x-align="PSA.10.16.a005" x-target-ids="t007" x-target="ever" x-target-head="t007" x-head="true" lemma="עַד" strong="H5703" x-morph="Ncmsa" x-gloss="ever" x-translit="ʿeḏ" xml:lang="hbo">עֶ֑ד</char> <char style="w" x-id="WLC.PSA.10.16.006" x-align="PSA.10.16.a006" x-target-ids="t010 t011" x-target="are perished" x-target-head="t011" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqp3cp" x-gloss="they.have.perished" x-translit="ʾāḇəḏû" xml:lang="hbo">אָבְד֥וּ</char> <char style="w" x-id="WLC.PSA.10.16.007" x-align="PSA.10.16.a007" x-target-ids="t008 t009" x-target="The nations" x-target-head="t009" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="[the].nations" x-translit="ḡôyim" xml:lang="hbo">ג֝וֹיִ֗ם</char> <char style="w" x-id="WLC.PSA.10.16.008" x-align="PSA.10.16.a008" x-target-ids="t012 t013" x-target="out of" x-target-head="t012" x-head="true