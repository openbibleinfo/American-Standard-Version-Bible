	<para style="p"><verse number="2" style="v" x-ref="PSA.89.2" sid="PSA 89:2" /><char style="w" x-id="WLC.PSA.89.2.001" x-align="PSA.89.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.89.3">כִּֽי</char>־<char style="w" x-id="WLC.PSA.89.2.002" x-align="PSA.89.2.a002" x-target-ids="t002 t003 t004" x-target="I have said" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp1cs" x-gloss="I.have.said" x-translit="ʾāmarətî" xml:lang="hbo" x-source-ref="PSA.89.3">אָמַ֗רְתִּי</char> <char style="w" x-id="WLC.PSA.89.2.003" x-align="PSA.89.2.a003" x-target-ids="t010 t011" x-target="for ever" x-target-head="t011" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="forever" x-translit="ʿôlām" xml:lang="hbo" x-source-ref="PSA.89.3">ע֭וֹלָם</char> <char style="w" x-id="WLC.PSA.89.2.004" x-align="PSA.89.2.a004" x-target-ids="t005" x-target="Mercy" x-target-head="t005" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsa" x-gloss="covenant.loyalty" x-translit="ḥeseḏ" xml:lang="hbo" x-source-ref="PSA.89.3">חֶ֣סֶד</char> <char style="w" x-id="WLC.PSA.89.2.005" x-align="PSA.89.2.a005" x-target-ids="t006 t007 t008 t009" x-target="shall be built up" x-target-head="t008" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="VNi3ms" x-gloss="it.will.be.built" x-translit="yibbāneh" xml:lang="hbo" x-source-ref="PSA.89.3">יִבָּנֶ֑ה</char> <char style="w" x-id="WLC.PSA.89.2.006" x-align="PSA.89.2.a006" x-target-ids="t018 t019 t020" x-target="the very heavens" x-target-head="t020" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="[the].heavens" x-translit="šāmayim" xml:lang="hbo" x-source-ref="PSA.89.3">שָׁמַ֓יִם</char>׀<char style="w" x-id="WLC.PSA.89.2.007" x-align="PSA.89.2.a007" x-target-ids="t014 t015 t016" x-target="wilt thou establish" x-target-head="t016" x-head="true" lemma="כּוּן" strong=