	<para style="p"><verse number="11" style="v" x-ref="PSA.77.11" sid="PSA 77:11" /><char style="w" x-id="WLC.PSA.77.11.v002.r01.001" x-align="PSA.77.11.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="I will make mention of" x-target-head="t004" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vhi1cs" x-translit="ʾzḵyr" xml:lang="hbo">אזכיר</char> <char style="w" x-id="WLC.PSA.77.11.002" x-align="PSA.77.11.a002" x-target-ids="t006 t007" x-target="the deeds" x-target-head="t007" x-head="true" lemma="מַעֲלָל" strong="H4611" x-morph="Ncmpc" x-gloss="the.deeds" x-translit="maʿaləlê-" xml:lang="hbo" x-source-ref="PSA.77.12">מַֽעַלְלֵי</char>־<char style="w" x-id="WLC.PSA.77.11.003" x-align="PSA.77.11.a003" x-target-ids="t008 t009" x-target="of Jehovah" x-target-head="t009" x-head="true" lemma="יָהּ" strong="H3050" x-morph="Np" x-gloss="of.Yahweh" x-translit="yāẖ" xml:lang="hbo" x-source-ref="PSA.77.12">יָ֑הּ</char> <char style="w" x-id="WLC.PSA.77.11.004" x-align="PSA.77.11.a004" x-target-ids="t010" x-target="For" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.77.12">כִּֽי</char>־<char style="w" x-id="WLC.PSA.77.11.005" x-align="PSA.77.11.a005" x-target-ids="t011 t012 t013" x-target="I will remember" x-target-head="t013" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqh1cs" x-gloss="I.will.remember" x-translit="ʾezkərāh" xml:lang="hbo" x-source-ref="PSA.77.12">אֶזְכְּרָ֖ה</char> <char style="w" x-id="WLC.PSA.77.11.006" x-align="PSA.77.11.a006" x-target-ids="t016" x-target="of" x-target-head="t016" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.77.12">מִ</char><char style="w" x-id="WLC.PSA.77.11.007" x-align="PSA.77.11.a007" x-target-ids="t017" x-target="old" x-target-head="t017" x-head="true" lemma="קֶדֶם" strong="H6924" x-morph="Ncmsa" x-gloss="antiquity" x-translit="qqeḏem" xml:lang="hbo" x-s