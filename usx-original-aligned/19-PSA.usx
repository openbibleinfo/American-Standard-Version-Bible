	<para style="p"><verse number="42" style="v" x-ref="PSA.89.42" sid="PSA 89:42" /><char style="w" x-id="WLC.PSA.89.42.001" x-align="PSA.89.42.a001" x-target-ids="t001 t002 t003" x-target="Thou hast exalted" x-target-head="t003" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vhp2ms" x-gloss="you.have.exalted" x-translit="hărîmôṯā" xml:lang="hbo" x-source-ref="PSA.89.43">הֲ֭רִימוֹתָ</char> <char style="w" x-id="WLC.PSA.89.42.002" x-align="PSA.89.42.a002" x-target-ids="t004 t005 t006" x-target="the right hand" x-target-head="t005" x-head="true" lemma="יָמִין" strong="H3225" x-morph="Ncfsc" x-gloss="the.right.hand" x-translit="yəmiyn" xml:lang="hbo" x-source-ref="PSA.89.43">יְמִ֣ין</char> <char style="w" x-id="WLC.PSA.89.42.003" x-align="PSA.89.42.a003" x-target-ids="t007 t009" x-target="of adversaries" x-target-head="t009" x-head="true" lemma="צַר" strong="H6862a" x-morph="Ncmpc" x-gloss="his.foes" x-translit="ṣārāy" xml:lang="hbo" x-source-ref="PSA.89.43">צָרָ֑י</char><char style="w" x-id="WLC.PSA.89.42.004" x-align="PSA.89.42.a004" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="PSA.89.43">ו</char> <char style="w" x-id="WLC.PSA.89.42.005" x-align="PSA.89.42.a005" x-target-ids="t010 t011 t012 t016 t017" x-target="Thou hast made to rejoice" x-target-head="t017" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vhp2ms" x-gloss="you.have.allowed.to.rejoice" x-translit="hiśmaḥətā" xml:lang="hbo" x-source-ref="PSA.89.43">הִ֝שְׂמַ֗חְתָּ</char> <char style="w" x-id="WLC.PSA.89.42.006" x-align="PSA.89.42.a006" x-target-ids="t013" x-target="all" x-target-head="t013" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.89.43">כָּל</char>־<char style="w" x-id="WLC.PSA.89.42.007" x-align="PSA.89.42.a007" x-target-ids="t015" x-target="enemies" x-target-head="t015" x-head="true" lemm