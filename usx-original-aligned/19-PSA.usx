	<para style="p"><verse number="9" style="v" x-ref="PSA.95.9" sid="PSA 95:9" /><char style="w" x-id="WLC.PSA.95.9.001" x-align="PSA.95.9.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="when" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.PSA.95.9.002" x-align="PSA.95.9.a002" x-target-ids="t004" x-target="tempted" x-target-head="t004" x-head="true" lemma="נָסָה" strong="H5254" x-morph="Vpp3cp" x-gloss="they" x-translit="nissû" xml:lang="hbo">נִ֭סּוּ</char><char style="w" x-id="WLC.PSA.95.9.003" x-align="PSA.95.9.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="put.me.to.the.test" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.95.9.004" x-align="PSA.95.9.a004" x-target-ids="t003" x-target="fathers" x-target-head="t003" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmpc" x-gloss="ancestors" x-translit="ʾăḇôṯēy" xml:lang="hbo">אֲבוֹתֵי</char><char style="w" x-id="WLC.PSA.95.9.005" x-align="PSA.95.9.a005" x-target-ids="t002" x-target="your" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.PSA.95.9.006" x-align="PSA.95.9.a006" x-target-ids="t006" x-target="Proved" x-target-head="t006" x-head="true" lemma="בָּחַן" strong="H974" x-morph="Vqp3cp" x-gloss="they" x-translit="bəḥānû" xml:lang="hbo">בְּ֝חָנ֗וּ</char><char style="w" x-id="WLC.PSA.95.9.007" x-align="PSA.95.9.a007" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="tested.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.95.9.008" x-align="PSA.95.9.a008" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="ga