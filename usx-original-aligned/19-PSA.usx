	<para style="p"><verse number="14" style="v" x-ref="PSA.77.14" sid="PSA 77:14" /><char style="w" x-id="WLC.PSA.77.14.001" x-align="PSA.77.14.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.77.15">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.77.14.002" x-align="PSA.77.14.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[are].the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.77.15">הָ֭</char><char style="w" x-id="WLC.PSA.77.14.003" x-align="PSA.77.14.a003" x-target-ids="t002 t004" x-target="art God" x-target-head="t004" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo" x-source-ref="PSA.77.15">אֵל</char> <char style="w" x-id="WLC.PSA.77.14.004" x-align="PSA.77.14.a004" x-target-ids="t005 t006" x-target="that doest" x-target-head="t006" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[who].does" x-translit="ʿōśēh" xml:lang="hbo" x-source-ref="PSA.77.15">עֹ֣שֵׂה</char> <char style="w" x-id="WLC.PSA.77.14.005" x-align="PSA.77.14.a005" x-target-ids="t007" x-target="wonders" x-target-head="t007" x-head="true" lemma="פֶּלֶא" strong="H6382" x-morph="Ncmsa" x-gloss="(of).wonder[s]" x-translit="p̄eleʾ" xml:lang="hbo" x-source-ref="PSA.77.15">פֶ֑לֶא</char> <char style="w" x-id="WLC.PSA.77.14.006" x-align="PSA.77.14.a006" x-target-ids="t008 t009 t010 t011" x-target="Thou hast made known" x-target-head="t011" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vhp2ms" x-gloss="you.have.made.known" x-translit="hôḏaʿətā" xml:lang="hbo" x-source-ref="PSA.77.15">הוֹדַ֖עְתָּ</char> <char style="w" x-id="WLC.PSA.77.14.007" x-align="PSA.77.14.a007" x-target-ids="t014" x-target="among" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ḇā" xml:la