	<para style="p"><verse number="2" style="v" x-ref="PSA.30.2" sid="PSA 30:2" /><char style="w" x-id="WLC.PSA.30.2.001" x-align="PSA.30.2.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.30.3">יְהוָ֥ה</char> <char style="w" x-id="WLC.PSA.30.2.002" x-align="PSA.30.2.a002" x-target-ids="t004" x-target="God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōh" xml:lang="hbo" x-source-ref="PSA.30.3">אֱלֹהָ֑</char><char style="w" x-id="WLC.PSA.30.2.003" x-align="PSA.30.2.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.30.3">י</char> <char style="w" x-id="WLC.PSA.30.2.004" x-align="PSA.30.2.a004" x-target-ids="t005 t006" x-target="I cried" x-target-head="t006" x-head="true" lemma="שָׁוַע" strong="H7768" x-morph="Vpp1cs" x-gloss="I.cried.for.help" x-translit="šiwwaʿətî" xml:lang="hbo" x-source-ref="PSA.30.3">שִׁוַּ֥עְתִּי</char> <char style="w" x-id="WLC.PSA.30.2.005" x-align="PSA.30.2.a005" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēley" xml:lang="hbo" x-source-ref="PSA.30.3">אֵ֝לֶ֗י</char><char style="w" x-id="WLC.PSA.30.2.006" x-align="PSA.30.2.a006" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.30.3">ךָ</char> <char style="w" x-id="WLC.PSA.30.2.007" x-align="PSA.30.2.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.30.3">וַ</char><char style="w" x-id="WLC.PSA.30.2.008" x-align="PSA