	<para style="p"><verse number="5" style="v" x-ref="PSA.18.5" sid="PSA 18:5" /><char style="w" x-id="WLC.PSA.18.5.001" x-align="PSA.18.5.a001" x-target-ids="t001 t002" x-target="The cords" x-target-head="t002" x-head="true" lemma="חֶבֶל" strong="H2256" x-morph="Ncbpc" x-gloss="the.cords" x-translit="ḥeḇlēy" xml:lang="hbo" x-source-ref="PSA.18.6">חֶבְלֵ֣י</char> <char style="w" x-id="WLC.PSA.18.5.002" x-align="PSA.18.5.a002" x-target-ids="t003 t004" x-target="of Sheol" x-target-head="t004" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="of.Sheol" x-translit="šəʾôl" xml:lang="hbo" x-source-ref="PSA.18.6">שְׁא֣וֹל</char> <char style="w" x-id="WLC.PSA.18.5.003" x-align="PSA.18.5.a003" x-target-ids="t005 t006 t007" x-target="were round about" x-target-head="t006" x-head="true" lemma="סָבַב" strong="H5437" x-morph="Vqp3cp" x-gloss="they" x-translit="səḇāḇû" xml:lang="hbo" x-source-ref="PSA.18.6">סְבָב֑וּ</char><char style="w" x-id="WLC.PSA.18.5.004" x-align="PSA.18.5.a004" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="surrounded.me" x-translit="niy" xml:lang="hbo" x-source-ref="PSA.18.6">נִי</char> <char style="w" x-id="WLC.PSA.18.5.005" x-align="PSA.18.5.a005" x-target-ids="t013 t014" x-target="came upon" x-target-head="t013" x-head="true" lemma="קָדַם" strong="H6923" x-morph="Vpp3cp" x-gloss="they" x-translit="qiddəmû" xml:lang="hbo" x-source-ref="PSA.18.6">קִ֝דְּמ֗וּ</char><char style="w" x-id="WLC.PSA.18.5.006" x-align="PSA.18.5.a006" x-target-ids="t015" x-target="me" x-target-head="t015" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="confronted.me" x-translit="niy" xml:lang="hbo" x-source-ref="PSA.18.6">נִי</char> <char style="w" x-id="WLC.PSA.18.5.007" x-align="PSA.18.5.a007" x-target-ids="t009 t010" x-target="The snares" x-target-head="t010" x-head="true" lemma="מוֹקֵשׁ" strong="H4170" x-morph="Ncmpc" x-gloss="snares" x-translit="môqəšê" xml:lang="hb