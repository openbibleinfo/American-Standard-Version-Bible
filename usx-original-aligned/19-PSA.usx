	<para style="p"><verse number="3" style="v" x-ref="PSA.61.3" sid="PSA 61:3" /><char style="w" x-id="WLC.PSA.61.3.001" x-align="PSA.61.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.61.4">כִּֽי</char>־<char style="w" x-id="WLC.PSA.61.3.002" x-align="PSA.61.3.a002" x-target-ids="t002 t003 t004" x-target="thou hast been" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp2ms" x-gloss="you.have.been" x-translit="hāyiyṯā" xml:lang="hbo" x-source-ref="PSA.61.4">הָיִ֣יתָ</char> <char style="w" x-id="WLC.PSA.61.3.003" x-align="PSA.61.3.a003" x-target-ids="t005 t006" x-target="a refuge" x-target-head="t006" x-head="true" lemma="מַחְסֶּה" strong="H4268" x-morph="Ncmsa" x-gloss="a.refuge" x-translit="maḥseh" xml:lang="hbo" x-source-ref="PSA.61.4">מַחְסֶ֣ה</char> <char style="w" x-id="WLC.PSA.61.3.004" x-align="PSA.61.3.a004" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-translit="l" xml:lang="hbo" x-source-ref="PSA.61.4">לִ֑</char><char style="w" x-id="WLC.PSA.61.3.005" x-align="PSA.61.3.a005" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.61.4">י</char> <char style="w" x-id="WLC.PSA.61.3.006" x-align="PSA.61.3.a006" x-target-ids="t009 t011" x-target="A tower" x-target-head="t011" x-head="true" lemma="מִגְדָּל" strong="H4026" x-morph="Ncbsc" x-gloss="a.tower" x-translit="miḡdal-" xml:lang="hbo" x-source-ref="PSA.61.4">מִגְדַּל</char>־<char style="w" x-id="WLC.PSA.61.3.007" x-align="PSA.61.3.a007" x-target-ids="t010" x-target="strong" x-target-head="t010" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsa" x-gloss="of.strength" x-translit="ʿōz" xml:lang="hbo" x-source-ref="PSA.61.4">עֹ֝֗ז</char> <char style="w" x-id="WLC.P