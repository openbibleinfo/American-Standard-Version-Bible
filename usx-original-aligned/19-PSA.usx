	<para style="p"><verse number="1" style="v" x-ref="PSA.137.1" sid="PSA 137:1" /><char style="w" x-id="WLC.PSA.137.1.001" x-align="PSA.137.1.a001" x-target-ids="t001" x-target="By" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="at" x-translit="ʿal" xml:lang="hbo">עַ֥ל</char> <char style="w" x-id="WLC.PSA.137.1.002" x-align="PSA.137.1.a002" x-target-ids="t002 t003" x-target="the rivers" x-target-head="t003" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmpc" x-gloss="the.rivers" x-translit="nahărôṯ" xml:lang="hbo">נַהֲר֨וֹת</char>׀<char style="w" x-id="WLC.PSA.137.1.003" x-align="PSA.137.1.a003" x-target-ids="t004 t005" x-target="of Babylon" x-target-head="t005" x-head="true" lemma="בָּבֶל" strong="H894" x-morph="Np" x-gloss="of.Babylon" x-translit="bāḇel" xml:lang="hbo">בָּבֶ֗ל</char> <char style="w" x-id="WLC.PSA.137.1.004" x-align="PSA.137.1.a004" x-target-ids="t006" x-target="There" x-target-head="t006" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="there" x-translit="šām" xml:lang="hbo">שָׁ֣ם</char> <char style="w" x-id="WLC.PSA.137.1.005" x-align="PSA.137.1.a005" x-target-ids="t007 t008 t009" x-target="we sat down" x-target-head="t008" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqp1cp" x-gloss="we.sat" x-translit="yāšaḇnû" xml:lang="hbo">יָ֭שַׁבְנוּ</char> <char style="w" x-id="WLC.PSA.137.1.006" x-align="PSA.137.1.a006" x-target-ids="t010" x-target="yea" x-target-head="t010" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.PSA.137.1.007" x-align="PSA.137.1.a007" x-target-ids="t011 t012" x-target="we wept" x-target-head="t012" x-head="true" lemma="בָּכָה" strong="H1058" x-morph="Vqp1cp" x-gloss="we.wept" x-translit="bāḵiynû" xml:lang="hbo">בָּכִ֑ינוּ</char> <char style="w" x-id="WLC.PSA.137.1.008" x-align="PSA.137.1.a008" x-target-ids="t013" x-target="When" x-target-head="t013" x-head="true" lemma="בְּ"