	<para style="p"><verse number="9" style="v" x-ref="PSA.2.9" sid="PSA 2:9" /><char style="w" x-id="WLC.PSA.2.9.001" x-align="PSA.2.9.a001" x-target-ids="t001 t002 t003" x-target="Thou shalt break" x-target-head="t003" x-head="true" lemma="רָעַע" strong="H7489a" x-morph="Vqi2ms" x-gloss="you" x-translit="tərōʿ" xml:lang="hbo">תְּ֭רֹעֵ</char><char style="w" x-id="WLC.PSA.2.9.002" x-align="PSA.2.9.a002" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="will.break.them" x-translit="ēm" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.2.9.003" x-align="PSA.2.9.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.2.9.004" x-align="PSA.2.9.a004" x-target-ids="t006 t007" x-target="a rod" x-target-head="t007" x-head="true" lemma="שֵׁבֶט" strong="H7626" x-morph="Ncmsc" x-gloss="a.rod" x-translit="šēḇeṭ" xml:lang="hbo">שֵׁ֣בֶט</char> <char style="w" x-id="WLC.PSA.2.9.005" x-align="PSA.2.9.a005" x-target-ids="t008 t009" x-target="of iron" x-target-head="t009" x-head="true" lemma="בַּרְזֶל" strong="H1270" x-morph="Ncmsa" x-gloss="of.iron" x-translit="barzel" xml:lang="hbo">בַּרְזֶ֑ל</char> <char style="w" x-id="WLC.PSA.2.9.006" x-align="PSA.2.9.a006" x-target-ids="t016" x-target="like" x-target-head="t016" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.PSA.2.9.007" x-align="PSA.2.9.a007" x-target-ids="t017 t019" x-target="a vessel" x-target-head="t019" x-head="true" lemma="כְּלִי" strong="H3627" x-morph="Ncmsc" x-gloss="a.vessel" x-translit="ḵəliy" xml:lang="hbo">כְלִ֖י</char> <char style="w" x-id="WLC.PSA.2.9.008" x-align="PSA.2.9.a008" x-target-ids="t018" x-target="potter’s" x-target-head="t018" x-head="true" lemma="יֹוצֵר" strong="H3335a" x-morph="Ncmsa" x-gloss="