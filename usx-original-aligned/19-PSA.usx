	<para style="p"><verse number="17" style="v" x-ref="PSA.51.17" sid="PSA 51:17" /><char style="w" x-id="WLC.PSA.51.17.001" x-align="PSA.51.17.a001" x-target-ids="t001 t002" x-target="The sacrifices" x-target-head="t002" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmpc" x-gloss="the.sacrifices" x-translit="ziḇəḥēy" xml:lang="hbo" x-source-ref="PSA.51.19">זִֽבְחֵ֣י</char> <char style="w" x-id="WLC.PSA.51.17.002" x-align="PSA.51.17.a002" x-target-ids="t003 t004" x-target="of God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="of.God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.51.19">אֱלֹהִים֮</char> <char style="w" x-id="WLC.PSA.51.17.003" x-align="PSA.51.17.a003" x-target-ids="t005 t006 t008" x-target="are a spirit" x-target-head="t008" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="[are].a.spirit" x-translit="rûᵃḥ" xml:lang="hbo" x-source-ref="PSA.51.19">ר֪וּחַ</char> <char style="w" x-id="WLC.PSA.51.17.004" x-align="PSA.51.17.a004" x-target-ids="t007" x-target="broken" x-target-head="t007" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="VNrfsa" x-gloss="broken" x-translit="nišbārāh" xml:lang="hbo" x-source-ref="PSA.51.19">נִשְׁבָּ֫רָ֥ה</char> <char style="w" x-id="WLC.PSA.51.17.005" x-align="PSA.51.17.a005" x-target-ids="t009 t012 t014" x-target="A a heart" x-target-head="t014" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="a.heart" x-translit="lēḇ-" xml:lang="hbo" x-source-ref="PSA.51.19">לֵב</char>־<char style="w" x-id="WLC.PSA.51.17.006" x-align="PSA.51.17.a006" x-target-ids="t010" x-target="broken" x-target-head="t010" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="VNrmsa" x-gloss="broken" x-translit="nišbār" xml:lang="hbo" x-source-ref="PSA.51.19">נִשְׁבָּ֥ר</char> <char style="w" x-id="WLC.PSA.51.17.007" x-align="PSA.51.17.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="an