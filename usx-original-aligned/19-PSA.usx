	<para style="p"><verse number="150" style="v" x-ref="PSA.119.150" sid="PSA 119:150" /><char style="w" x-id="WLC.PSA.119.150.001" x-align="PSA.119.150.a001" x-target-ids="t001 t002 t003" x-target="They draw nigh" x-target-head="t002" x-head="true" lemma="קָרַב" strong="H7126" x-morph="Vqp3cp" x-gloss="they.draw.near" x-translit="qārəḇû" xml:lang="hbo">קָ֭רְבוּ</char> <char style="w" x-id="WLC.PSA.119.150.002" x-align="PSA.119.150.a002" x-target-ids="t004 t005" x-target="that follow" x-target-head="t005" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vqrmpc" x-gloss="[those.who].pursue" x-translit="rōḏəp̄ēy" xml:lang="hbo">רֹדְפֵ֣י</char> <char style="w" x-id="WLC.PSA.119.150.003" x-align="PSA.119.150.a003" x-target-ids="t006 t007" x-target="after wickedness" x-target-head="t007" x-head="true" lemma="זִמָּה" strong="H2154" x-morph="Ncfsa" x-gloss="(of).wickedness" x-translit="zimmāh" xml:lang="hbo">זִמָּ֑ה</char> <char style="w" x-id="WLC.PSA.119.150.004" x-align="PSA.119.150.a004" x-target-ids="t011" x-target="from" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.119.150.005" x-align="PSA.119.150.a005" x-target-ids="t013" x-target="law" x-target-head="t013" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="law" x-translit="tôrāṯ" xml:lang="hbo">תּוֹרָתְ</char><char style="w" x-id="WLC.PSA.119.150.006" x-align="PSA.119.150.a006" x-target-ids="t012" x-target="thy" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PSA.119.150.007" x-align="PSA.119.150.a007" x-target-ids="t008 t009 t010" x-target="They are far" x-target-head="t010" x-head="true" lemma="רָחַק" strong="H7368" x-morph="Vqp3cp" x-gloss="they.are.distant" x-translit="rāḥāqû:" xml:lang="hbo">רָחָֽקוּ</char>׃<verse eid="PSA 119:150" /></para>
	<para style="p"><verse number="151" style="v" x-ref="PSA.119.151" sid="PSA 119:151" /><char style="w" x-id="WLC.PSA.119.151.001" x-align="PSA.119.151.a001" x-target-ids="t002 t003" x-target="art nigh" x-target-head="t003" x-head="true" lemma="קָרֹוב" strong="H7138" x-morph="Aamsa" x-gloss="[are].near" x-translit="qārôḇ" xml:lang="hbo">קָר֣וֹב</char> <char style="w" x-id="WLC.PSA.119.151.002" x-align="PSA.119.151.a002" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.119.151.003" x-align="PSA.119.151.a003" x-target-ids="t004 t005" x-target="O Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.119.151.004" x-align="PSA.119.151.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.119.151.005" x-align="PSA.119.151.a005" x-target-ids="t007" x-target="all" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.119.151.006" x-align="PSA.119.151.a006" x-target-ids="t009" x-target="commandments" x-target-head="t009" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfpc" x-gloss="commandments" x-translit="miṣôṯey" xml:lang="hbo">מִצְוֺתֶ֥י</char><char style="w" x-id="WLC.PSA.119.151.007" x-align="PSA.119.151.a007" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.151.008" x-align="PSA.119.151.a008" x-target-ids="t010 t011" x-target="are truth" x-target-head="t011" x-head="true" lemma="אֱמֶת" strong="H571" x-morph="Ncfsa" x-gloss="[are].truth" x-translit="ʾĕmeṯ:" xml:lang="hbo">אֱמֶֽת</char>׃<verse eid="PSA 119:151" /></para>
