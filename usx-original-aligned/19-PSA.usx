	<para style="p"><verse number="40" style="v" x-ref="PSA.89.40" sid="PSA 89:40" /><char style="w" x-id="WLC.PSA.89.40.001" x-align="PSA.89.40.a001" x-target-ids="t001 t002 t003 t004" x-target="Thou hast broken down" x-target-head="t003" x-head="true" lemma="פָּרַץ" strong="H6555" x-morph="Vqp2ms" x-gloss="you.have.broken.through" x-translit="pāraṣətā" xml:lang="hbo" x-source-ref="PSA.89.41">פָּרַ֥צְתָּ</char> <char style="w" x-id="WLC.PSA.89.40.002" x-align="PSA.89.40.a002" x-target-ids="t005" x-target="all" x-target-head="t005" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.89.41">כָל</char>־<char style="w" x-id="WLC.PSA.89.40.003" x-align="PSA.89.40.a003" x-target-ids="t007" x-target="hedges" x-target-head="t007" x-head="true" lemma="גְּדֵרָה" strong="H1448" x-morph="Ncfpc" x-gloss="walls" x-translit="gəḏērōṯāy" xml:lang="hbo" x-source-ref="PSA.89.41">גְּדֵרֹתָ֑י</char><char style="w" x-id="WLC.PSA.89.40.004" x-align="PSA.89.40.a004" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="PSA.89.41">ו</char> <char style="w" x-id="WLC.PSA.89.40.005" x-align="PSA.89.40.a005" x-target-ids="t008 t009 t010" x-target="Thou hast brought" x-target-head="t010" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqp2ms" x-gloss="you.have.made" x-translit="śamətā" xml:lang="hbo" x-source-ref="PSA.89.41">שַׂ֖מְתָּ</char> <char style="w" x-id="WLC.PSA.89.40.006" x-align="PSA.89.40.a006" x-target-ids="t012" x-target="strongholds" x-target-head="t012" x-head="true" lemma="מִבְצָר" strong="H4013" x-morph="Ncmpc" x-gloss="strongholds" x-translit="miḇṣārāy" xml:lang="hbo" x-source-ref="PSA.89.41">מִבְצָרָ֣י</char><char style="w" x-id="WLC.PSA.89.40.007" x-align="PSA.89.40.a007" x-target-ids="t011" x-target="his" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-