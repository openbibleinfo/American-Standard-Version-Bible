	<para style="p"><verse number="5" style="v" x-ref="PSA.5.5" sid="PSA 5:5" /><char style="w" x-id="WLC.PSA.5.5.001" x-align="PSA.5.5.a001" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.5.6">לֹֽא</char>־<char style="w" x-id="WLC.PSA.5.5.002" x-align="PSA.5.5.a002" x-target-ids="t003 t005" x-target="shall stand" x-target-head="t005" x-head="true" lemma="יָצַב" strong="H3320" x-morph="Vti3mp" x-gloss="they.will.take.their.stand" x-translit="yiṯyaṣṣəḇû" xml:lang="hbo" x-source-ref="PSA.5.6">יִתְיַצְּב֣וּ</char> <char style="w" x-id="WLC.PSA.5.5.003" x-align="PSA.5.5.a003" x-target-ids="t001 t002" x-target="The arrogant" x-target-head="t002" x-head="true" lemma="הָלַל" strong="H1984b" x-morph="Vqrmpa" x-gloss="[those.who].boast" x-translit="hôləlîm" xml:lang="hbo" x-source-ref="PSA.5.6">הֽ֭וֹלְלִים</char> <char style="w" x-id="WLC.PSA.5.5.004" x-align="PSA.5.5.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.5.6">לְ</char><char style="w" x-id="WLC.PSA.5.5.005" x-align="PSA.5.5.a005" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="נֶגֶד" strong="H5048" x-morph="R" x-gloss="before" x-translit="neḡeḏ" xml:lang="hbo" x-source-ref="PSA.5.6">נֶ֣גֶד</char> <char style="w" x-id="WLC.PSA.5.5.006" x-align="PSA.5.5.a006" x-target-ids="t008" x-target="sight" x-target-head="t008" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="eyes" x-translit="ʿēyney" xml:lang="hbo" x-source-ref="PSA.5.6">עֵינֶ֑י</char><char style="w" x-id="WLC.PSA.5.5.007" x-align="PSA.5.5.a007" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.5.6">ךָ</char> <char style="w" x-id="WLC.PSA.5.5.008" x-align="PSA.5.5.a008"