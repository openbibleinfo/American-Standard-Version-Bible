	<para style="p"><verse number="2" style="v" x-ref="PSA.81.2" sid="PSA 81:2" /><char style="w" x-id="WLC.PSA.81.2.001" x-align="PSA.81.2.a001" x-target-ids="t001" x-target="Raise" x-target-head="t001" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqv2mp" x-gloss="lift.up" x-translit="śəʾû-" xml:lang="hbo" x-source-ref="PSA.81.3">שְֽׂאוּ</char>־<char style="w" x-id="WLC.PSA.81.2.002" x-align="PSA.81.2.a002" x-target-ids="t002 t003" x-target="a song" x-target-head="t003" x-head="true" lemma="זִמְרָה" strong="H2172" x-morph="Ncfsa" x-gloss="music" x-translit="zimrâ" xml:lang="hbo" x-source-ref="PSA.81.3">זִ֭מְרָה</char> <char style="w" x-id="WLC.PSA.81.2.003" x-align="PSA.81.2.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.81.3">וּ</char><char style="w" x-id="WLC.PSA.81.2.004" x-align="PSA.81.2.a004" x-target-ids="t005 t006" x-target="bring hither" x-target-head="t005" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqv2mp" x-gloss="beat" x-translit="ṯənû-" xml:lang="hbo" x-source-ref="PSA.81.3">תְנוּ</char>־<char style="w" x-id="WLC.PSA.81.2.005" x-align="PSA.81.2.a005" x-target-ids="t007 t008" x-target="the timbrel" x-target-head="t008" x-head="true" lemma="תֹּף" strong="H8596" x-morph="Ncmsa" x-gloss="a.tambourine" x-translit="ṯōp̄" xml:lang="hbo" x-source-ref="PSA.81.3">תֹ֑ף</char> <char style="w" x-id="WLC.PSA.81.2.006" x-align="PSA.81.2.a006" x-target-ids="t009 t011" x-target="The harp" x-target-head="t011" x-head="true" lemma="כִּנּוֹר" strong="H3658" x-morph="Ncmsa" x-gloss="a.harp" x-translit="kinnôr" xml:lang="hbo" x-source-ref="PSA.81.3">כִּנּ֖וֹר</char> <char style="w" x-id="WLC.PSA.81.2.007" x-align="PSA.81.2.a007" x-target-ids="t010" x-target="pleasant" x-target-head="t010" x-head="true" lemma="נָעִים" strong="H5273" x-morph="Aamsa" x-gloss="pleasant" x-translit="nāʿiym" xml:lang="hbo" x-source-ref="PSA.81.3">נָעִ֣ים