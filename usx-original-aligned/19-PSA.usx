	<para style="p"><verse number="1" style="v" x-ref="PSA.56.1" sid="PSA 56:1" /><char style="w" x-id="WLC.PSA.56.1.001" x-align="PSA.56.1.a001" x-target-ids="t001 t002 t003" x-target="Be merciful unto" x-target-head="t002" x-head="true" lemma="חָנַן" strong="H2603" x-morph="Vqv2ms" x-gloss="show" x-translit="ḥānn" xml:lang="hbo" x-source-ref="PSA.56.2">חָנֵּ֣</char><char style="w" x-id="WLC.PSA.56.1.002" x-align="PSA.56.1.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="favor.to.me" x-translit="ēniy" xml:lang="hbo" x-source-ref="PSA.56.2">נִי</char> <char style="w" x-id="WLC.PSA.56.1.003" x-align="PSA.56.1.a003" x-target-ids="t005 t006" x-target="O God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.56.2">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.56.1.004" x-align="PSA.56.1.a004" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.56.2">כִּֽי</char>־<char style="w" x-id="WLC.PSA.56.1.005" x-align="PSA.56.1.a005" x-target-ids="t009 t010 t012" x-target="would swallow up" x-target-head="t010" x-head="true" lemma="שָׁאַף" strong="H7602a" x-morph="Vqp3ms" x-gloss="he" x-translit="šəʾāp̄" xml:lang="hbo" x-source-ref="PSA.56.2">שְׁאָפַ֣</char><char style="w" x-id="WLC.PSA.56.1.006" x-align="PSA.56.1.a006" x-target-ids="t011" x-target="me" x-target-head="t011" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.trampled.on.me" x-translit="aniy" xml:lang="hbo" x-source-ref="PSA.56.2">נִי</char> <char style="w" x-id="WLC.PSA.56.1.007" x-align="PSA.56.1.a007" x-target-ids="t008" x-target="man" x-target-head="t008" x-head="true" lemma="אֱנוֹשׁ" strong="H582" x-morph="Ncmsa" x-gloss="man" x-translit="ʾĕnôš" xml:lang="hbo" x-source-ref="PSA.56.2">אֱנ֑וֹ