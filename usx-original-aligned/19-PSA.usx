	<para style="p"><verse number="4" style="v" x-ref="PSA.54.4" sid="PSA 54:4" /><char style="w" x-id="WLC.PSA.54.4.001" x-align="PSA.54.4.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo" x-source-ref="PSA.54.6">הִנֵּ֣ה</char> <char style="w" x-id="WLC.PSA.54.4.002" x-align="PSA.54.4.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.54.6">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.54.4.003" x-align="PSA.54.4.a003" x-target-ids="t003 t005" x-target="is helper" x-target-head="t005" x-head="true" lemma="עָזַר" strong="H5826" x-morph="Vqrmsa" x-gloss="[is].a.helper" x-translit="ʿōzēr" xml:lang="hbo" x-source-ref="PSA.54.6">עֹזֵ֣ר</char> <char style="w" x-id="WLC.PSA.54.4.004" x-align="PSA.54.4.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-translit="l" xml:lang="hbo" x-source-ref="PSA.54.6">לִ֑</char><char style="w" x-id="WLC.PSA.54.4.005" x-align="PSA.54.4.a005" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.54.6">י</char> <char style="w" x-id="WLC.PSA.54.4.006" x-align="PSA.54.4.a006" x-target-ids="t006 t007" x-target="The Lord" x-target-head="t007" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo" x-source-ref="PSA.54.6">אֲ֝דֹנָ֗</char><char style="w" x-id="WLC.PSA.54.4.007" x-align="PSA.54.4.a007" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="[the]" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.54.6">י</char> <char style="w" x-id="WLC.PSA.54.4.008" x-align="PSA.54.4.a008" x-target-ids="t008 t009" x-target="is of" x-target-head="t009