	<para style="p"><verse number="2" style="v" x-ref="PSA.24.2" sid="PSA 24:2" /><char style="w" x-id="WLC.PSA.24.2.001" x-align="PSA.24.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.24.2.002" x-align="PSA.24.2.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֭וּא</char><char style="w" x-id="WLC.PSA.24.2.003" x-align="PSA.24.2.a003" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.24.2.004" x-align="PSA.24.2.a004" x-target-ids="t007 t008" x-target="the seas" x-target-head="t008" x-head="true" lemma="יָם" strong="H3220" x-morph="Ncmpa" x-gloss="[the].seas" x-translit="yammiym" xml:lang="hbo">יַמִּ֣ים</char> <char style="w" x-id="WLC.PSA.24.2.005" x-align="PSA.24.2.a005" x-target-ids="t003 t004" x-target="hath founded" x-target-head="t004" x-head="true" lemma="יָסַד" strong="H3245" x-morph="Vqp3ms" x-gloss="he" x-translit="yəsāḏ" xml:lang="hbo">יְסָדָ֑</char><char style="w" x-id="WLC.PSA.24.2.006" x-align="PSA.24.2.a006" x-target-ids="t005" x-target="it" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="founded.it" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PSA.24.2.007" x-align="PSA.24.2.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.24.2.008" x-align="PSA.24.2.a008" x-target-ids="t012" x-target="upon" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char sty