	<para style="p"><verse number="10" style="v" x-ref="PSA.119.10" sid="PSA 119:10" /><char style="w" x-id="WLC.PSA.119.10.001" x-align="PSA.119.10.a001" x-target-ids="t001" x-target="With" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.10.002" x-align="PSA.119.10.a002" x-target-ids="t003" x-target="whole" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.119.10.003" x-align="PSA.119.10.a003" x-target-ids="t004" x-target="heart" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֥</char><char style="w" x-id="WLC.PSA.119.10.004" x-align="PSA.119.10.a004" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.10.005" x-align="PSA.119.10.a005" x-target-ids="t005 t006 t007" x-target="have I sought" x-target-head="t007" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqp1cs" x-gloss="I" x-translit="ḏəraštiy" xml:lang="hbo">דְרַשְׁתִּ֑י</char><char style="w" x-id="WLC.PSA.119.10.006" x-align="PSA.119.10.a006" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="seek.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.10.007" x-align="PSA.119.10.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PSA.119.10.008" x-align="PSA.119.10.a008" x-target-ids="t009 t010 t013" x-target="Oh let wander" x-target-head="t013" x-head="true" lemma="שָׁגָה" strong="H7686" x-morph="Vhj2ms"