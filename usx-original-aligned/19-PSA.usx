	<para style="p"><verse number="30" style="v" x-ref="PSA.119.30" sid="PSA 119:30" /><char style="w" x-id="WLC.PSA.119.30.001" x-align="PSA.119.30.a002" x-target-ids="t004 t005" x-target="the way" x-target-head="t005" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="a.way" x-translit="dereḵ-" xml:lang="hbo">דֶּֽרֶךְ</char>־<char style="w" x-id="WLC.PSA.119.30.002" x-align="PSA.119.30.a003" x-target-ids="t006 t007" x-target="of faithfulness" x-target-head="t007" x-head="true" lemma="אֱמוּנָה" strong="H530" x-morph="Ncfsa" x-gloss="of.faithfulness" x-translit="ʾĕmûnāh" xml:lang="hbo">אֱמוּנָ֥ה</char> <char style="w" x-id="WLC.PSA.119.30.003" x-align="PSA.119.30.a001" x-target-ids="t001 t002 t003" x-target="I have chosen" x-target-head="t003" x-head="true" lemma="בָּחַר" strong="H977" x-morph="Vqp1cs" x-gloss="I.have.chosen" x-translit="ḇāḥārətî" xml:lang="hbo">בָחָ֑רְתִּי</char> <char style="w" x-id="WLC.PSA.119.30.004" x-align="PSA.119.30.a005" x-target-ids="t009" x-target="ordinances" x-target-head="t009" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmpc" x-gloss="judgments" x-translit="mišpāṭey" xml:lang="hbo">מִשְׁפָּטֶ֥י</char><char style="w" x-id="WLC.PSA.119.30.005" x-align="PSA.119.30.a004" x-target-ids="t008" x-target="Thine" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.30.006" x-align="PSA.119.30.a006" x-target-ids="t010 t011 t012 t013 t014" x-target="have I set before me" x-target-italic-ids="t013 t014" x-target-head="t012" x-head="true" lemma="שָׁוָה" strong="H7737a" x-morph="Vpp1cs" x-gloss="I.have.placed" x-translit="šiwwiyṯî:" xml:lang="hbo">שִׁוִּֽיתִי</char>׃<verse eid="PSA 119:30" /></para>
	<para style="p"><verse number="31" style="v" x-ref="PSA.119.31" sid="PSA 119:31" /><char style="w" x-id="WLC.PSA.119.31.001" x-align="PSA.119.31.a001" x-target-ids="t001 t002" x-target="I cleave" x-target-head="t002" x-head="true" lemma="דָּבַק" strong="H1692" x-morph="Vqp1cs" x-gloss="I.have.clung" x-translit="dāḇaqətî" xml:lang="hbo">דָּבַ֥קְתִּי</char> <char style="w" x-id="WLC.PSA.119.31.002" x-align="PSA.119.31.a002" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="to" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PSA.119.31.003" x-align="PSA.119.31.a003" x-target-ids="t005" x-target="testimonies" x-target-head="t005" x-head="true" lemma="עֵדוּת" strong="H5715" x-morph="Ncfpc" x-gloss="testimonies" x-translit="ʿēḏəôṯey" xml:lang="hbo">עֵֽדְוֺתֶ֑י</char><char style="w" x-id="WLC.PSA.119.31.004" x-align="PSA.119.31.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.31.005" x-align="PSA.119.31.a005" x-target-ids="t006 t007" x-target="O Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְ֝הוָ֗ה</char> <char style="w" x-id="WLC.PSA.119.31.006" x-align="PSA.119.31.a006" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PSA.119.31.007" x-align="PSA.119.31.a007" x-target-ids="t008 t011 t012" x-target="put to shame" x-target-head="t012" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vhj2ms" x-gloss="put" x-translit="təḇiyš" xml:lang="hbo">תְּבִישֵֽׁ</char><char style="w" x-id="WLC.PSA.119.31.008" x-align="PSA.119.31.a008" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true