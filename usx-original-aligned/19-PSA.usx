	<para style="p"><verse number="11" style="v" x-ref="PSA.109.11" sid="PSA 109:11" /><char style="w" x-id="WLC.PSA.109.11.001" x-align="PSA.109.11.a001" x-target-ids="t001 t004" x-target="Let catch" x-target-head="t004" x-head="true" lemma="נָקַשׁ" strong="H5367" x-morph="Vpi3ms" x-gloss="may.he.strike" x-translit="yənaqqēš" xml:lang="hbo">יְנַקֵּ֣שׁ</char> <char style="w" x-id="WLC.PSA.109.11.002" x-align="PSA.109.11.a002" x-target-ids="t002 t003" x-target="the extortioner" x-target-head="t003" x-head="true" lemma="נשׁא" strong="H5378" x-morph="Vqrmsa" x-gloss="a.creditor" x-translit="nôšeh" xml:lang="hbo">נ֭וֹשֶׁה</char> <char style="w" x-id="WLC.PSA.109.11.003" x-align="PSA.109.11.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.109.11.004" x-align="PSA.109.11.a004" x-target-ids="t005" x-target="all" x-target-head="t005" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.109.11.005" x-align="PSA.109.11.a005" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="that" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.PSA.109.11.006" x-align="PSA.109.11.a006" x-target-ids="t008" x-target="hath" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belongs].to" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.PSA.109.11.007" x-align="PSA.109.11.a007" x-target-ids="t007" x-target="he" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.109.11.008" x-align="PSA.109.11.a008" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml