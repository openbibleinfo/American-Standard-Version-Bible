	<para style="p"><verse number="28" style="v" x-ref="PSA.22.28" sid="PSA 22:28" /><char style="w" x-id="WLC.PSA.22.28.001" x-align="PSA.22.28.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.22.29">כִּ֣י</char> <char style="w" x-id="WLC.PSA.22.28.002" x-align="PSA.22.28.a002" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belongs].to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.22.29">לַ֭</char><char style="w" x-id="WLC.PSA.22.28.003" x-align="PSA.22.28.a002" x-target-ids="t004 t005 t007" x-target="is Jehovah’s he" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwâ" xml:lang="hbo" x-source-ref="PSA.22.29">יהוָה</char> <char style="w" x-id="WLC.PSA.22.28.004" x-align="PSA.22.28.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.22.29">הַ</char><char style="w" x-id="WLC.PSA.22.28.005" x-align="PSA.22.28.a004" x-target-ids="t003" x-target="kingdom" x-target-head="t003" x-head="true" lemma="מְלוּכָה" strong="H4410" x-morph="Ncfsa" x-gloss="kingship" x-translit="mməlûḵāh" xml:lang="hbo" x-source-ref="PSA.22.29">מְּלוּכָ֑ה</char> <char style="w" x-id="WLC.PSA.22.28.006" x-align="PSA.22.28.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.22.29">וּ֝</char><char style="w" x-id="WLC.PSA.22.28.007" x-align="PSA.22.28.a006" x-target-ids="t008 t009 t010" x-target="is the ruler" x-target-head="t010" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vqrmsa" x-gloss="[he.is].ruling" x-translit="mōšēl" xml:lang="hbo" x-source-ref="PSA.22.29">מֹשֵׁ֗ל</char> <char style="w" x-id="WLC.PSA.22.28.008" x-align="PSA.22.28.a007" x-target-ids=