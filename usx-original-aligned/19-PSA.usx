	<para style="p"><verse number="31" style="v" x-ref="PSA.107.31" x-added-alignments="PSA.107.31.a002" x-added-target-ids="t003" x-added-target="men" sid="PSA 107:31" /><char style="w" x-id="WLC.PSA.107.31.001" x-align="PSA.107.31.a001" x-target-ids="t001 t002 t004 t005" x-target="Oh that would praise" x-target-head="t005" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhj3mp" x-gloss="let.them.give.thanks" x-translit="yôḏû" xml:lang="hbo">יוֹד֣וּ</char> <char style="w" x-id="WLC.PSA.107.31.002" x-align="PSA.107.31.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.107.31.003" x-align="PSA.107.31.a004" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֣ה</char> <char style="w" x-id="WLC.PSA.107.31.004" x-align="PSA.107.31.a006" x-target-ids="t007 t009" x-target="for lovingkindness" x-target-head="t009" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo">חַסְדּ֑</char><char style="w" x-id="WLC.PSA.107.31.005" x-align="PSA.107.31.a005" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.covenant" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.107.31.006" x-align="PSA.107.31.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.107.31.007" x-align="PSA.107.31.a009" x-target-ids="t011 t013 t014" x-target="for wonderful works" x-target-head="t013" x-head="true" lemma="פָּלָא" strong="H6381" x-morph="VNrfpc" x-gloss="wonders" x-translit="nip̄ləʾôṯāy" xml:lang="hbo">נִפְלְאוֹתָ֗י</char><char style="w" x-id="WLC.PSA.107.31.008" x-align="PSA.