	<para style="p"><verse number="122" style="v" x-ref="PSA.119.122" sid="PSA 119:122" /><char style="w" x-id="WLC.PSA.119.122.001" x-align="PSA.119.122.a001" x-target-ids="t001 t002 t003" x-target="Be surety for" x-target-head="t002" x-head="true" lemma="עָרַב" strong="H6148" x-morph="Vqv2ms" x-gloss="stand.surety.for" x-translit="ʿărōḇ" xml:lang="hbo">עֲרֹ֣ב</char> <char style="w" x-id="WLC.PSA.119.122.002" x-align="PSA.119.122.a002" x-target-ids="t005" x-target="servant" x-target-head="t005" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="servant" x-translit="ʿaḇd" xml:lang="hbo">עַבְדְּ</char><char style="w" x-id="WLC.PSA.119.122.003" x-align="PSA.119.122.a003" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֣</char> <char style="w" x-id="WLC.PSA.119.122.004" x-align="PSA.119.122.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.119.122.005" x-align="PSA.119.122.a005" x-target-ids="t007" x-target="good" x-target-head="t007" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PSA.119.122.006" x-align="PSA.119.122.a006" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.PSA.119.122.007" x-align="PSA.119.122.a007" x-target-ids="t008 t012" x-target="Let oppress" x-target-head="t012" x-head="true" lemma="עָשַׁק" strong="H6231" x-morph="Vqj3mp" x-gloss="may" x-translit="yaʿašqu" xml:lang="hbo">יַעַשְׁקֻ֥</char><char style="w" x-id="WLC.PSA.119.122.008" x-align="PSA.119.122.a008" x-target-ids="t013" x-target="me" x-target-head="t013" x-head="true" lemma="הוּא" 