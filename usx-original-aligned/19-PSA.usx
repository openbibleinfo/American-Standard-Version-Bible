	<para style="p"><verse number="21" style="v" x-ref="PSA.18.21" sid="PSA 18:21" /><char style="w" x-id="WLC.PSA.18.21.001" x-align="PSA.18.21.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.18.22">כִּֽי</char>־<char style="w" x-id="WLC.PSA.18.21.002" x-align="PSA.18.21.a002" x-target-ids="t002 t003 t004" x-target="I have kept" x-target-head="t004" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqp1cs" x-gloss="I.have.kept" x-translit="šāmartî" xml:lang="hbo" x-source-ref="PSA.18.22">שָׁ֭מַרְתִּי</char> <char style="w" x-id="WLC.PSA.18.21.003" x-align="PSA.18.21.a003" x-target-ids="t005 t006" x-target="the ways" x-target-head="t006" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="the.ways" x-translit="darḵēy" xml:lang="hbo" x-source-ref="PSA.18.22">דַּרְכֵ֣י</char> <char style="w" x-id="WLC.PSA.18.21.004" x-align="PSA.18.21.a004" x-target-ids="t007 t008" x-target="of Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.18.22">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.18.21.005" x-align="PSA.18.21.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.22">וְ</char><char style="w" x-id="WLC.PSA.18.21.006" x-align="PSA.18.21.a006" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.18.22">לֹֽא</char>־<char style="w" x-id="WLC.PSA.18.21.007" x-align="PSA.18.21.a007" x-target-ids="t010 t012 t013" x-target="have wickedly departed" x-target-head="t013" x-head="true" lemma="רָשַׁע" strong="H7561" x-morph="Vqp1cs" x-gloss="I.have.acted.wickedly" x-translit="rāšaʿətî"