	<para style="p"><verse number="5" style="v" x-ref="PSA.8.5" sid="PSA 8:5" /><char style="w" x-id="WLC.PSA.8.5.001" x-align="PSA.8.5.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.8.6">וַ</char><char style="w" x-id="WLC.PSA.8.5.002" x-align="PSA.8.5.a002" x-target-ids="t002 t003 t004 t008" x-target="thou hast made lower" x-target-head="t008" x-head="true" lemma="חָסֵר" strong="H2637" x-morph="Vpw2ms" x-gloss="you" x-translit="təḥassər" xml:lang="hbo" x-source-ref="PSA.8.6">תְּחַסְּרֵ֣</char><char style="w" x-id="WLC.PSA.8.5.003" x-align="PSA.8.5.a003" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="have.made.him.lack" x-translit="ēhû" xml:lang="hbo" x-source-ref="PSA.8.6">הוּ</char> <char style="w" x-id="WLC.PSA.8.5.004" x-align="PSA.8.5.a004" x-target-ids="t006 t007" x-target="but little" x-target-head="t007" x-head="true" lemma="מְעַט" strong="H4592" x-morph="Ncmsa" x-gloss="little" x-translit="mməʿaṭ" xml:lang="hbo" x-source-ref="PSA.8.6">מְּ֭עַט</char> <char style="w" x-id="WLC.PSA.8.5.005" x-align="PSA.8.5.a005" x-target-ids="t009" x-target="than" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.8.6">מֵ</char><char style="w" x-id="WLC.PSA.8.5.006" x-align="PSA.8.5.a006" x-target-ids="t010" x-target="God" x-target-head="t010" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.8.6">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.8.5.007" x-align="PSA.8.5.a007" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.8.6">וְ</char><char style="w" x-id="WLC.PSA.8.5.008" x-align="PSA.8.