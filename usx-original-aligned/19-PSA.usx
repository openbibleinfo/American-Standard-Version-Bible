	<para style="p"><verse number="6" style="v" x-ref="PSA.17.6" x-added-alignments="PSA.17.6.a013" x-added-target-ids="t018" x-added-target="and" sid="PSA 17:6" /><char style="w" x-id="WLC.PSA.17.6.001" x-align="PSA.17.6.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy-" xml:lang="hbo">אֲנִֽי</char>־<char style="w" x-id="WLC.PSA.17.6.002" x-align="PSA.17.6.a002" x-target-ids="t002 t003" x-target="have called" x-target-head="t003" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqp1cs" x-gloss="I" x-translit="qərāʾṯiy" xml:lang="hbo">קְרָאתִ֣י</char><char style="w" x-id="WLC.PSA.17.6.003" x-align="PSA.17.6.a003" x-target-ids="t004 t005" x-target="upon thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="call.out.to.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.17.6.004" x-align="PSA.17.6.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="ḵiy-" xml:lang="hbo">כִֽי</char>־<char style="w" x-id="WLC.PSA.17.6.005" x-align="PSA.17.6.a005" x-target-ids="t007 t008 t009" x-target="thou wilt answer" x-target-head="t009" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi2ms" x-gloss="you" x-translit="ṯaʿăn" xml:lang="hbo">תַעֲנֵ֣</char><char style="w" x-id="WLC.PSA.17.6.006" x-align="PSA.17.6.a006" x-target-ids="t010" x-target="me" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.answer.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.17.6.007" x-align="PSA.17.6.a007" x-target-ids="t011 t012" x-target="O God" x-target-head="t012" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="O.God" x-translit="ʾēl" xml:lang="hbo">אֵ֑ל</char> <char style="w" x-id="WLC.PSA.17.6.008" x-align="PSA.17.6.a008" x-target-ids="t013" x-target="Incl