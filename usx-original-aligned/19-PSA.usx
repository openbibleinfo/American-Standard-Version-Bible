	<para style="p"><verse number="28" style="v" x-ref="PSA.107.28" sid="PSA 107:28" /><char style="w" x-id="WLC.PSA.107.28.001" x-align="PSA.107.28.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.107.28.002" x-align="PSA.107.28.a002" x-target-ids="t002 t003" x-target="they cry" x-target-head="t003" x-head="true" lemma="צָעַק" strong="H6817" x-morph="Vqw3mp" x-gloss="they.cried.out" x-translit="yyiṣʿăqû" xml:lang="hbo">יִּצְעֲק֣וּ</char> <char style="w" x-id="WLC.PSA.107.28.003" x-align="PSA.107.28.a003" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.PSA.107.28.004" x-align="PSA.107.28.a004" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.107.28.005" x-align="PSA.107.28.a005" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.107.28.006" x-align="PSA.107.28.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.107.28.007" x-align="PSA.107.28.a008" x-target-ids="t008" x-target="trouble" x-target-head="t008" x-head="true" lemma="צַר" strong="H6862" x-morph="Aamsa" x-gloss="distress" x-translit="ṣṣar" xml:lang="hbo">צַּ֣ר</char> <char style="w" x-id="WLC.PSA.107.28.008" x-align="PSA.107.28.a009" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-translit="l" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PSA.107.28.009" x-align="PSA