	<para style="d" x-ref="PSA.60.0" x-added-alignments="PSA.60.0.a012" x-added-target-ids="t014 t015 t016 t017 t018 t019 t020 t021 t022 t023 t024 t025 t026 t027 t028 t029 t030 t031 t032 t033 t034 t035 t036 t037" x-added-target="when he strove with Aram naharaim and with Aram zobah and Joab returned and smote of Edom in the Valley of Salt twelve thousand"><char style="w" x-id="WLC.PSA.60.0.001" x-align="PSA.60.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.60.1">לַ֭</char><char style="w" x-id="WLC.PSA.60.0.002" x-align="PSA.60.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.60.1">[הַ]</char><char style="w" x-id="WLC.PSA.60.0.003" x-align="PSA.60.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.60.1">מְנַצֵּחַ</char> <char style="w" x-id="WLC.PSA.60.0.004" x-align="PSA.60.0.a004" x-target-ids="t005 t006" x-target="set to" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.60.1">עַל</char>־<char style="w" x-id="WLC.PSA.60.0.005" x-align="PSA.60.0.a005" x-target-ids="t007" x-target="Shushan" x-target-head="t007" x-head="true" lemma="שׁוּשַׁן" strong="H7799" x-morph="Ncmsc" x-gloss="shushan-" x-translit="šûšan" xml:lang="hbo" x-source-ref="PSA.60.1">שׁוּשַׁ֣ן</char> <char style="w" x-id="WLC.PSA.60.0.006" x-align="PSA.60.0.a006" x-target-ids="t008" x-target="Eduth" x-target-head="t008" x-head="true" lemma="עֵדוּת" strong="H5715" x-morph="Ncfsa" x-gloss="eduth" x-translit="ʿēḏûṯ" xml:lang="hbo" x-source-ref="PSA.60.1">עֵד֑וּת</char> <char style="w" x-id="WLC.P