	<para style="p"><verse number="9" style="v" x-ref="PSA.8.9" sid="PSA 8:9" /><char style="w" x-id="WLC.PSA.8.9.001" x-align="PSA.8.9.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.8.10">יְהוָ֥ה</char> <char style="w" x-id="WLC.PSA.8.9.002" x-align="PSA.8.9.a002" x-target-ids="t004" x-target="Lord" x-target-head="t004" x-head="true" lemma="אָדוֹן" strong="H113" x-morph="Ncmpc" x-gloss="lord(s)" x-translit="ʾăḏōnēy" xml:lang="hbo" x-source-ref="PSA.8.10">אֲדֹנֵ֑י</char><char style="w" x-id="WLC.PSA.8.9.003" x-align="PSA.8.9.a003" x-target-ids="t003" x-target="our" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo" x-source-ref="PSA.8.10">נוּ</char> <char style="w" x-id="WLC.PSA.8.9.004" x-align="PSA.8.9.a004" x-target-ids="t005" x-target="How" x-target-head="t005" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="how!" x-translit="māh-" xml:lang="hbo" x-source-ref="PSA.8.10">מָֽה</char>־<char style="w" x-id="WLC.PSA.8.9.005" x-align="PSA.8.9.a005" x-target-ids="t006 t007" x-target="excellent is" x-target-head="t006" x-head="true" lemma="אַדִּיר" strong="H117" x-morph="Aamsa" x-gloss="majestic" x-translit="ʾaddiyr" xml:lang="hbo" x-source-ref="PSA.8.10">אַדִּ֥יר</char> <char style="w" x-id="WLC.PSA.8.9.006" x-align="PSA.8.9.a006" x-target-ids="t009" x-target="name" x-target-head="t009" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šim" xml:lang="hbo" x-source-ref="PSA.8.10">שִׁ֝מְ</char><char style="w" x-id="WLC.PSA.8.9.007" x-align="PSA.8.9.a007" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="[is].your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.8.10">ךָ֗</char> <char style="w" x-id="WLC.PSA.8.9.008" x-align="PS