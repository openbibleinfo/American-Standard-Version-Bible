	<para style="p"><verse number="1" style="v" x-ref="PSA.18.1" sid="PSA 18:1" /><char style="w" x-id="WLC.PSA.18.1.001" x-align="PSA.18.1.a001" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.18.2">וַ</char><char style="w" x-id="WLC.PSA.18.1.002" x-align="PSA.18.1.a002" x-status="unrepresented" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmar" xml:lang="hbo" x-source-ref="PSA.18.2">יֹּאמַ֡ר</char> <char style="w" x-id="WLC.PSA.18.1.003" x-align="PSA.18.1.a003" x-target-ids="t001 t002" x-target="I love" x-target-head="t002" x-head="true" lemma="רָחַם" strong="H7355" x-morph="Vqi1cs" x-gloss="I" x-translit="ʾerḥām" xml:lang="hbo" x-source-ref="PSA.18.2">אֶרְחָמְ</char><char style="w" x-id="WLC.PSA.18.1.004" x-align="PSA.18.1.a004" x-target-ids="t003" x-target="thee" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="love.you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.18.2">ךָ֖</char> <char style="w" x-id="WLC.PSA.18.1.005" x-align="PSA.18.1.a005" x-target-ids="t004 t005" x-target="O Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.18.2">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.18.1.006" x-align="PSA.18.1.a006" x-target-ids="t007" x-target="strength" x-target-head="t007" x-head="true" lemma="חֵזֶק" strong="H2391" x-morph="Ncmsc" x-gloss="strength" x-translit="ḥizq" xml:lang="hbo" x-source-ref="PSA.18.2">חִזְקִֽ</char><char style="w" x-id="WLC.PSA.18.1.007" x-align="PSA.18.1.a007" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.18.2">י</char>׃<verse eid="PSA 18:1" /></para>
