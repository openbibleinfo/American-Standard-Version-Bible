	<para style="p"><verse number="39" style="v" x-ref="PSA.89.39" x-added-alignments="PSA.89.39.a011" x-added-target-ids="t014 t015 t016" x-added-target="by casting it" sid="PSA 89:39" /><char style="w" x-id="WLC.PSA.89.39.001" x-align="PSA.89.39.a001" x-target-ids="t001 t002 t003" x-target="Thou hast abhorred" x-target-head="t003" x-head="true" lemma="נָאַר" strong="H5010" x-morph="Vpp2ms" x-gloss="you.have.repudiated" x-translit="nēʾartâ" xml:lang="hbo" x-source-ref="PSA.89.40">נֵ֭אַרְתָּה</char> <char style="w" x-id="WLC.PSA.89.39.002" x-align="PSA.89.39.a002" x-target-ids="t004 t005" x-target="the covenant" x-target-head="t005" x-head="true" lemma="בְּרִית" strong="H1285" x-morph="Ncfsc" x-gloss="the.covenant" x-translit="bəriyṯ" xml:lang="hbo" x-source-ref="PSA.89.40">בְּרִ֣ית</char> <char style="w" x-id="WLC.PSA.89.39.003" x-align="PSA.89.39.a003" x-target-ids="t006 t008" x-target="of servant" x-target-head="t008" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="your.servant" x-translit="ʿaḇd" xml:lang="hbo" x-source-ref="PSA.89.40">עַבְדֶּ֑</char><char style="w" x-id="WLC.PSA.89.39.004" x-align="PSA.89.39.a004" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.89.40">ךָ</char> <char style="w" x-id="WLC.PSA.89.39.005" x-align="PSA.89.39.a005" x-target-ids="t009 t010 t011" x-target="Thou hast profaned" x-target-head="t011" x-head="true" lemma="חָלַל" strong="H2490" x-morph="Vpp2ms" x-gloss="you.have.profaned" x-translit="ḥillalətā" xml:lang="hbo" x-source-ref="PSA.89.40">חִלַּ֖לְתָּ</char> <char style="w" x-id="WLC.PSA.89.39.006" x-align="PSA.89.39.a006" x-target-ids="t017" x-target="to" x-target-head="t017" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.89.40">לָ</char><char style="w" x-id="WLC.PSA.89.39.007" x-align="PSA.89.39.a007" x-target-ids="