	<para style="p"><verse number="6" style="v" x-ref="PSA.9.6" sid="PSA 9:6" /><char style="w" x-id="WLC.PSA.9.6.001" x-align="PSA.9.6.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.9.7">הָֽ</char><char style="w" x-id="WLC.PSA.9.6.002" x-align="PSA.9.6.a002" x-target-ids="t002" x-target="enemy" x-target-head="t002" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmsa" x-gloss="enemy" x-translit="ʾôyēḇ" xml:lang="hbo" x-source-ref="PSA.9.7">אוֹיֵ֨ב</char>׀<char style="w" x-id="WLC.PSA.9.6.003" x-align="PSA.9.6.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="are come to an end" x-target-head="t007" x-head="true" lemma="תָּמַם" strong="H8552" x-morph="Vqp3cp" x-gloss="they.have.come.to.an.end" x-translit="tammû" xml:lang="hbo" x-source-ref="PSA.9.7">תַּ֥מּוּ</char> <char style="w" x-id="WLC.PSA.9.6.004" x-align="PSA.9.6.a004" x-target-ids="t008 t009 t010" x-target="they are desolate" x-target-head="t010" x-head="true" lemma="חׇרְבָּה" strong="H2723" x-morph="Ncfpa" x-gloss="ruins" x-translit="ḥŏrāḇôṯ" xml:lang="hbo" x-source-ref="PSA.9.7">חֳרָב֗וֹת</char> <char style="w" x-id="WLC.PSA.9.6.005" x-align="PSA.9.6.a005" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.9.7">לָ֫</char><char style="w" x-id="WLC.PSA.9.6.006" x-align="PSA.9.6.a006" x-target-ids="t012" x-target="ever" x-target-head="t012" x-head="true" lemma="נֵצַח" strong="H5331" x-morph="Ncmsa" x-gloss="perpetuity" x-translit="neṣaḥ" xml:lang="hbo" x-source-ref="PSA.9.7">נֶ֥צַח</char> <char style="w" x-id="WLC.PSA.9.6.007" x-align="PSA.9.6.a007" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.9.7">וְ</char><char style="w" x-id="