	<para style="p"><verse number="21" style="v" x-ref="PSA.35.21" x-added-alignments="PSA.35.21.a011" x-added-target-ids="t017" x-added-target="it" sid="PSA 35:21" /><char style="w" x-id="WLC.PSA.35.21.001" x-align="PSA.35.21.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.35.21.002" x-align="PSA.35.21.a002" x-target-ids="t002 t003 t006" x-target="they opened wide" x-target-head="t006" x-head="true" lemma="רָחַב" strong="H7337" x-morph="Vhw3mp" x-gloss="they.have.opened.wide" x-translit="yyarḥiyḇû" xml:lang="hbo">יַּרְחִ֥יבוּ</char> <char style="w" x-id="WLC.PSA.35.21.003" x-align="PSA.35.21.a003" x-target-ids="t007" x-target="against" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāl" xml:lang="hbo">עָלַ֗</char><char style="w" x-id="WLC.PSA.35.21.004" x-align="PSA.35.21.a004" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.35.21.005" x-align="PSA.35.21.a005" x-target-ids="t005" x-target="mouth" x-target-head="t005" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="piy" xml:lang="hbo">פִּ֫י</char><char style="w" x-id="WLC.PSA.35.21.006" x-align="PSA.35.21.a006" x-target-ids="t004" x-target="their" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hbo">הֶ֥ם</char> <char style="w" x-id="WLC.PSA.35.21.007" x-align="PSA.35.21.a007" x-target-ids="t009 t010" x-target="They said" x-target-head="t010" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3cp" x-gloss="they.have.said" x-translit="ʾāmərû" xml:lang="hbo">אָ֭מְרוּ</char> <char style="w" x-id="WLC.PSA.35.21.008" x-align="PSA.35.21.a008" x-target-ids="t011" x-ta