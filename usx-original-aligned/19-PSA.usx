	<para style="p"><verse number="79" style="v" x-ref="PSA.119.79" sid="PSA 119:79" /><char style="w" x-id="WLC.PSA.119.79.001" x-align="PSA.119.79.a001" x-target-ids="t001 t006" x-target="Let turn" x-target-head="t006" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi3mp" x-gloss="let.them.turn" x-translit="yāšûḇû" xml:lang="hbo">יָשׁ֣וּבוּ</char> <char style="w" x-id="WLC.PSA.119.79.002" x-align="PSA.119.79.a002" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֣</char><char style="w" x-id="WLC.PSA.119.79.003" x-align="PSA.119.79.a003" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.79.004" x-align="PSA.119.79.a004" x-target-ids="t002 t003 t004" x-target="those that fear" x-target-head="t004" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aampc" x-gloss="[those].fearing" x-translit="yərēʾey" xml:lang="hbo">יְרֵאֶ֑י</char><char style="w" x-id="WLC.PSA.119.79.005" x-align="PSA.119.79.a005" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.79.v001.r01.001" x-align="PSA.119.79.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" x-morph="C" x-translit="w" xml:lang="hbo">ו</char><char style="w" x-id="WLC.PSA.119.79.v001.r01.002" x-align="PSA.119.79.a007" x-target-ids="t010 t011 t012" x-target="they shall know" x-target-head="t012" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqq3cp" x-translit="yḏʿw" xml:lang="hbo">ידעו</char> <char style="w" x-id="WLC.PSA.119.79.008" x-align="PSA.119.79.a008" x-target-ids="t014" x-target="testimonies" x-target-head="t014" x-head="true" lemma="עֵדוּת" strong="H5715" x-morph="Ncfpc