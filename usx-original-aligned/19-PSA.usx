	<para style="p"><verse number="11" style="v" x-ref="PSA.80.11" sid="PSA 80:11" /><char style="w" x-id="WLC.PSA.80.11.001" x-align="PSA.80.11.a001" x-target-ids="t001 t002 t003" x-target="It sent out" x-target-head="t002" x-head="true" lemma="שָׁלַח" strong="H7971" x-morph="Vpi3fs" x-gloss="it.stretched.out" x-translit="təšallaḥ" xml:lang="hbo" x-source-ref="PSA.80.12">תְּשַׁלַּ֣ח</char> <char style="w" x-id="WLC.PSA.80.11.002" x-align="PSA.80.11.a002" x-target-ids="t005" x-target="branches" x-target-head="t005" x-head="true" lemma="קָצִיר" strong="H7105a" x-morph="Ncmpc" x-gloss="branch[es]" x-translit="qəṣiyr" xml:lang="hbo" x-source-ref="PSA.80.12">קְצִירֶ֣</char><char style="w" x-id="WLC.PSA.80.11.003" x-align="PSA.80.11.a003" x-target-ids="t004" x-target="its" x-target-head="t004" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="ehā" xml:lang="hbo" x-source-ref="PSA.80.12">הָ</char> <char style="w" x-id="WLC.PSA.80.11.004" x-align="PSA.80.11.a004" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="to" x-translit="ʿaḏ-" xml:lang="hbo" x-source-ref="PSA.80.12">עַד</char>־<char style="w" x-id="WLC.PSA.80.11.005" x-align="PSA.80.11.a005" x-target-ids="t007 t008" x-target="the sea" x-target-head="t008" x-head="true" lemma="יָם" strong="H3220" x-morph="Ncmsa" x-gloss="[the].sea" x-translit="yām" xml:lang="hbo" x-source-ref="PSA.80.12">יָ֑ם</char> <char style="w" x-id="WLC.PSA.80.11.006" x-align="PSA.80.11.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.80.12">וְ</char><char style="w" x-id="WLC.PSA.80.11.007" x-align="PSA.80.11.a007" x-target-ids="t012" x-target="unto" x-target-head="t012" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo" x-source-ref="PSA.80.12">אֶל</char>־<char style="w" x