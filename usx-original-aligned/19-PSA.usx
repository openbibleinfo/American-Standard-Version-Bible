	<para style="p"><verse number="18" style="v" x-ref="PSA.38.18" sid="PSA 38:18" /><char style="w" x-id="WLC.PSA.38.18.001" x-align="PSA.38.18.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.38.19">כִּֽי</char>־<char style="w" x-id="WLC.PSA.38.18.002" x-align="PSA.38.18.a002" x-target-ids="t006" x-target="iniquity" x-target-head="t006" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsc" x-gloss="iniquity" x-translit="ʿăôn" xml:lang="hbo" x-source-ref="PSA.38.19">עֲוֺנִ֥</char><char style="w" x-id="WLC.PSA.38.18.003" x-align="PSA.38.18.a003" x-target-ids="t005" x-target="mine" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.38.19">י</char> <char style="w" x-id="WLC.PSA.38.18.004" x-align="PSA.38.18.a004" x-target-ids="t002 t003 t004" x-target="I will declare" x-target-head="t004" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhi1cs" x-gloss="I.tell" x-translit="ʾaggiyḏ" xml:lang="hbo" x-source-ref="PSA.38.19">אַגִּ֑יד</char> <char style="w" x-id="WLC.PSA.38.18.005" x-align="PSA.38.18.a005" x-target-ids="t007 t008 t009 t010" x-target="I will be sorry" x-target-head="t010" x-head="true" lemma="דָּאַג" strong="H1672" x-morph="Vqi1cs" x-gloss="I.am.anxious" x-translit="ʾeḏʾaḡ" xml:lang="hbo" x-source-ref="PSA.38.19">אֶ֝דְאַ֗ג</char> <char style="w" x-id="WLC.PSA.38.18.006" x-align="PSA.38.18.a006" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.38.19">מֵֽ</char><char style="w" x-id="WLC.PSA.38.18.007" x-align="PSA.38.18.a007" x-target-ids="t013" x-target="sin" x-target-head="t013" x-head="true" lemma="חַטָּאת" strong="H2403" x-morph="Ncfsc" x-gloss="sin" x-translit="ḥaṭṭāʾṯ" xml:lang="hbo" x-source-ref="PSA.38.19