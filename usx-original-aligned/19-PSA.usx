	<para style="p"><verse number="2" style="v" x-ref="PSA.110.2" sid="PSA 110:2" /><char style="w" x-id="WLC.PSA.110.2.001" x-align="PSA.110.2.a001" x-target-ids="t005 t006" x-target="the rod" x-target-head="t006" x-head="true" lemma="מַטֶּה" strong="H4294" x-morph="Ncmsc" x-gloss="the.staff" x-translit="maṭṭēh-" xml:lang="hbo">מַטֵּֽה</char>־<char style="w" x-id="WLC.PSA.110.2.002" x-align="PSA.110.2.a002" x-target-ids="t007 t009" x-target="of strength" x-target-head="t009" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsc" x-gloss="your.strength" x-translit="ʿuzz" xml:lang="hbo">עֻזְּ</char><char style="w" x-id="WLC.PSA.110.2.003" x-align="PSA.110.2.a003" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֗</char> <char style="w" x-id="WLC.PSA.110.2.004" x-align="PSA.110.2.a004" x-target-ids="t002 t003 t004" x-target="will send forth" x-target-head="t003" x-head="true" lemma="שָׁלַח" strong="H7971" x-morph="Vqi3ms" x-gloss="he.will.stretch.out" x-translit="yišlaḥ" xml:lang="hbo">יִשְׁלַ֣ח</char> <char style="w" x-id="WLC.PSA.110.2.005" x-align="PSA.110.2.a005" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.110.2.006" x-align="PSA.110.2.a006" x-target-ids="t010 t011" x-target="out of" x-target-head="t010" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.110.2.007" x-align="PSA.110.2.a007" x-target-ids="t012" x-target="Zion" x-target-head="t012" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="Zion" x-translit="ṣṣiyyôn" xml:lang="hbo">צִּיּ֑וֹן</char> <char style="w" x-id="WLC.PSA.110.2.008" x-align="PSA.110.2.a008" x-target-ids="t013 t014" x-target="Rule thou" x-target-head="t013" x-he