	<para style="p"><verse number="12" style="v" x-ref="PSA.25.12" x-added-alignments="PSA.25.12.a011" x-added-target-ids="t015" x-added-target="that" sid="PSA 25:12" /><char style="w" x-id="WLC.PSA.25.12.001" x-align="PSA.25.12.a001" x-target-ids="t001 t003" x-target="What is" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="mî-" xml:lang="hbo">מִי</char>־<char style="w" x-id="WLC.PSA.25.12.002" x-align="PSA.25.12.a002" x-target-ids="t004" x-target="he" x-target-head="t004" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo">זֶ֣ה</char> <char style="w" x-id="WLC.PSA.25.12.003" x-align="PSA.25.12.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[is].the" x-translit="hā" xml:lang="hbo">הָ֭</char><char style="w" x-id="WLC.PSA.25.12.004" x-align="PSA.25.12.a004" x-target-ids="t002" x-target="man" x-target-head="t002" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="person" x-translit="ʾîš" xml:lang="hbo">אִישׁ</char> <char style="w" x-id="WLC.PSA.25.12.005" x-align="PSA.25.12.a005" x-target-ids="t005 t006" x-target="that feareth" x-target-head="t006" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aamsc" x-gloss="(the).fearing" x-translit="yərēʾ" xml:lang="hbo">יְרֵ֣א</char> <char style="w" x-id="WLC.PSA.25.12.006" x-align="PSA.25.12.a006" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="(of).Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.25.12.007" x-align="PSA.25.12.a007" x-target-ids="t009 t010 t011" x-target="shall he instruct" x-target-head="t011" x-head="true" lemma="יָרָה" strong="H3384b" x-morph="Vhi3ms" x-gloss="he" x-translit="yôr" xml:lang="hbo">י֝וֹרֶ֗</char><char style="w" x-id="WLC.PSA.25.12.008" x-align="PSA.25.12.a008" x-target-ids="t008" x-target="Him" x-target-head="t008"