	<para style="d" x-ref="PSA.42.0"><char style="w" x-id="WLC.PSA.42.0.001" x-align="PSA.42.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.42.1">לַ</char><char style="w" x-id="WLC.PSA.42.0.002" x-align="PSA.42.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.42.1">[הַ]</char><char style="w" x-id="WLC.PSA.42.0.003" x-align="PSA.42.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.42.1">מְנַצֵּ֗חַ</char> <char style="w" x-id="WLC.PSA.42.0.004" x-align="PSA.42.0.a004" x-target-ids="t005" x-target="Maschil" x-target-head="t005" x-head="true" lemma="מַשְׂכִּיל" strong="H4905" x-morph="Ncmsa" x-gloss="a.poem" x-translit="maśkiyl" xml:lang="hbo" x-source-ref="PSA.42.1">מַשְׂכִּ֥יל</char> <char style="w" x-id="WLC.PSA.42.0.005" x-align="PSA.42.0.a005" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="li" xml:lang="hbo" x-source-ref="PSA.42.1">לִ</char><char style="w" x-id="WLC.PSA.42.0.006" x-align="PSA.42.0.a006" x-target-ids="t007 t008" x-target="the sons" x-target-head="t008" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.sons" x-translit="ḇənê-" xml:lang="hbo" x-source-ref="PSA.42.1">בְנֵי</char>־<char style="w" x-id="WLC.PSA.42.0.007" x-align="PSA.42.0.a007" x-target-ids="t009 t010" x-target="of Korah" x-target-head="t010" x-head="true" lemma="קֹרַח" strong="H7141" x-morph="Np" x-gloss="of.Korah" x-translit="qōraḥ:" xml:lang="hbo" x-source-ref="PSA.42.1">קֹֽרַח</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.42.1" sid="PSA 42:1" /><char style="w" x-id="WLC.PSA.42.1.001" x-align="PSA.42.1.a001" x-target-ids="t001" x-target="As" x-target-head="t001" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo" x-source-ref="PSA.42.2">כְּ</char><char style="w" x-id="WLC.PSA.42.1.002" x-align="PSA.42.1.a002" x-target-ids="t002 t003" x-target="the hart" x-target-head="t003" x-head="true" lemma="אַיָּל" strong="H354" x-morph="Ncbsa" x-gloss="a.deer" x-translit="ʾayyāl" xml:lang="hbo" x-source-ref="PSA.42.2">אַיָּ֗ל</char> <char style="w" x-id="WLC.PSA.42.1.003" x-align="PSA.42.1.a003" x-target-ids="t004" x-target="panteth" x-target-head="t004" x-head="true" lemma="עָרַג" strong="H6165" x-morph="Vqi3fs" x-gloss="[which].it.pants" x-translit="taʿărōḡ" xml:lang="hbo" x-source-ref="PSA.42.2">תַּעֲרֹ֥ג</char> <char style="w" x-id="WLC.PSA.42.1.004" x-align="PSA.42.1.a004" x-target-ids="t005" x-target="after" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="towards" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.42.2">עַל</char>־<char style="w" x-id="WLC.PSA.42.1.005" x-align="PSA.42.1.a005" x-target-ids="t006 t008" x-target="the brooks" x-target-head="t008" x-head="true" lemma="אָפִיק" strong="H650" x-morph="Ncmpc" x-gloss="channels" x-translit="ʾăp̄iyqê-" xml:lang="hbo" x-source-ref="PSA.42.2">אֲפִֽיקֵי</char>־<char style="w" x-id="WLC.PSA.42.1.006" x-align="PSA.42.1.a006" x-target-ids="t007" x-target="water" x-target-head="t007" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="of.water" x-translit="māyim" xml:lang="hbo" x-source-ref="PSA.42.2">מָ֑יִם</char> <char style="w" x-id="WLC.PSA.42.1.007" x-align="PSA.42.1.a007" x-target-ids="t009" x-target="So" x-target-head="t009" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-gloss="so" x-translit="kēn" xml:lang="hbo" x-source-ref="PSA.42.2">כֵּ֤ן</char> <char style="w" x-id="