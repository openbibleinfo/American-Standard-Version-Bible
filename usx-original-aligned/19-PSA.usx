	<para style="p"><verse number="13" style="v" x-ref="PSA.73.13" sid="PSA 73:13" /><char style="w" x-id="WLC.PSA.73.13.001" x-align="PSA.73.13.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.PSA.73.13.002" x-align="PSA.73.13.a002" x-target-ids="t002 t003" x-target="in vain" x-target-head="t003" x-head="true" lemma="רִיק" strong="H7385" x-morph="Ncmsa" x-gloss="emptiness" x-translit="rîq" xml:lang="hbo">רִ֭יק</char> <char style="w" x-id="WLC.PSA.73.13.003" x-align="PSA.73.13.a003" x-target-ids="t004 t005 t006" x-target="have I cleansed" x-target-head="t006" x-head="true" lemma="זָכָה" strong="H2135" x-morph="Vpp1cs" x-gloss="I.have.kept.pure" x-translit="zikkiyṯî" xml:lang="hbo">זִכִּ֣יתִי</char> <char style="w" x-id="WLC.PSA.73.13.004" x-align="PSA.73.13.a005" x-target-ids="t008" x-target="heart" x-target-head="t008" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsc" x-gloss="heart" x-translit="ləḇāḇ" xml:lang="hbo">לְבָבִ֑</char><char style="w" x-id="WLC.PSA.73.13.005" x-align="PSA.73.13.a004" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.73.13.006" x-align="PSA.73.13.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PSA.73.13.007" x-align="PSA.73.13.a007" x-target-ids="t010" x-target="washed" x-target-head="t010" x-head="true" lemma="רָחַץ" strong="H7364" x-morph="Vqw1cs" x-gloss="I.have.washed" x-translit="ʾerḥaṣ" xml:lang="hbo">אֶרְחַ֖ץ</char> <char style="w" x-id="WLC.PSA.73.13.008" x-align="PSA.73.13.a010" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morp