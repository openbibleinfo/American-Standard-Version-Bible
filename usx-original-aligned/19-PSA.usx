	<para style="p"><verse number="22" style="v" x-ref="PSA.44.22" sid="PSA 44:22" /><char style="w" x-id="WLC.PSA.44.22.001" x-align="PSA.44.22.a001" x-target-ids="t001" x-target="Yea" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.44.23">כִּֽי</char>־<char style="w" x-id="WLC.PSA.44.22.002" x-align="PSA.44.22.a002" x-target-ids="t002 t004" x-target="for sake" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāley" xml:lang="hbo" x-source-ref="PSA.44.23">עָ֭לֶי</char><char style="w" x-id="WLC.PSA.44.22.003" x-align="PSA.44.22.a003" x-target-ids="t003" x-target="thy" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.44.23">ךָ</char> <char style="w" x-id="WLC.PSA.44.22.004" x-align="PSA.44.22.a004" x-target-ids="t005 t006 t007" x-target="are we killed" x-target-head="t007" x-head="true" lemma="הָרַג" strong="H2026" x-morph="VQp1cp" x-gloss="we.have.been.killed" x-translit="hōraḡənû" xml:lang="hbo" x-source-ref="PSA.44.23">הֹרַ֣גְנוּ</char> <char style="w" x-id="WLC.PSA.44.22.005" x-align="PSA.44.22.a005" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.44.23">כָל</char>־<char style="w" x-id="WLC.PSA.44.22.006" x-align="PSA.44.22.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.44.23">הַ</char><char style="w" x-id="WLC.PSA.44.22.007" x-align="PSA.44.22.a007" x-target-ids="t010 t011" x-target="day long" x-target-head="t010" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo" x-source-ref="PSA.44.23">יּ֑וֹם</char> <char style="w" x-i