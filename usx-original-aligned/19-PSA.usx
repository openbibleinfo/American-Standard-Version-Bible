	<para style="p"><verse number="10" style="v" x-ref="PSA.51.10" sid="PSA 51:10" /><char style="w" x-id="WLC.PSA.51.10.001" x-align="PSA.51.10.a001" x-target-ids="t004 t006" x-target="a heart" x-target-head="t006" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="a.heart" x-translit="lēḇ" xml:lang="hbo" x-source-ref="PSA.51.12">לֵ֣ב</char> <char style="w" x-id="WLC.PSA.51.10.002" x-align="PSA.51.10.a002" x-target-ids="t005" x-target="clean" x-target-head="t005" x-head="true" lemma="טָהֹר" strong="H2889" x-morph="Aamsa" x-gloss="pure" x-translit="ṭāhôr" xml:lang="hbo" x-source-ref="PSA.51.12">טָ֭הוֹר</char> <char style="w" x-id="WLC.PSA.51.10.003" x-align="PSA.51.10.a003" x-target-ids="t001" x-target="Create" x-target-head="t001" x-head="true" lemma="בָּרָא" strong="H1254" x-morph="Vqv2ms" x-gloss="create" x-translit="bərāʾ-" xml:lang="hbo" x-source-ref="PSA.51.12">בְּרָא</char>־<char style="w" x-id="WLC.PSA.51.10.004" x-align="PSA.51.10.a004" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo" x-source-ref="PSA.51.12">לִ֣</char><char style="w" x-id="WLC.PSA.51.10.005" x-align="PSA.51.10.a005" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.51.12">י</char> <char style="w" x-id="WLC.PSA.51.10.006" x-align="PSA.51.10.a006" x-target-ids="t007 t008" x-target="O God" x-target-head="t008" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.51.12">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.51.10.007" x-align="PSA.51.10.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.51.12">וְ</char><char style="w" x-id="WLC.PSA.51.10.008" x-a