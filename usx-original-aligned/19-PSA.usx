	<para style="p"><verse number="6" style="v" x-ref="PSA.2.6" sid="PSA 2:6" /><char style="w" x-id="WLC.PSA.2.6.001" x-align="PSA.2.6.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֭</char><char style="w" x-id="WLC.PSA.2.6.002" x-align="PSA.2.6.a002" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾănî" xml:lang="hbo">אֲנִי</char> <char style="w" x-id="WLC.PSA.2.6.003" x-align="PSA.2.6.a003" x-target-ids="t003 t004" x-target="have set" x-target-head="t004" x-head="true" lemma="נָסַךְ" strong="H5258" x-morph="Vqp1cs" x-gloss="I.have.installed" x-translit="nāsaḵətî" xml:lang="hbo">נָסַ֣כְתִּי</char> <char style="w" x-id="WLC.PSA.2.6.004" x-align="PSA.2.6.a004" x-target-ids="t006" x-target="king" x-target-head="t006" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsc" x-gloss="king" x-translit="malk" xml:lang="hbo">מַלְכִּ֑</char><char style="w" x-id="WLC.PSA.2.6.005" x-align="PSA.2.6.a005" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.2.6.006" x-align="PSA.2.6.a006" x-target-ids="t007" x-target="Upon" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.2.6.007" x-align="PSA.2.6.a007" x-target-ids="t011 t012" x-target="of Zion" x-target-head="t012" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="Zion" x-translit="ṣiyyôn" xml:lang="hbo">צִ֝יּ֗וֹן</char> <char style="w" x-id="WLC.PSA.2.6.008" x-align="PSA.2.6.a008" x-target-ids="t010" x-target="hill" x-target-head="t010" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmsc" x-gloss="the.mountain" x-translit="har-" xml:lang="hbo">הַר</char