	<para style="p"><verse number="11" style="v" x-ref="PSA.119.11" sid="PSA 119:11" /><char style="w" x-id="WLC.PSA.119.11.001" x-align="PSA.119.11.a001" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PSA.119.11.002" x-align="PSA.119.11.a002" x-target-ids="t009" x-target="heart" x-target-head="t009" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ</char><char style="w" x-id="WLC.PSA.119.11.003" x-align="PSA.119.11.a003" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.11.004" x-align="PSA.119.11.a004" x-target-ids="t003 t004 t005 t006" x-target="have I laid up" x-target-head="t005" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqp1cs" x-gloss="I.have.hidden" x-translit="ṣāp̄anətî" xml:lang="hbo">צָפַ֣נְתִּי</char> <char style="w" x-id="WLC.PSA.119.11.005" x-align="PSA.119.11.a005" x-target-ids="t002" x-target="word" x-target-head="t002" x-head="true" lemma="אִמְרָה" strong="H565" x-morph="Ncfsc" x-gloss="word" x-translit="ʾimrāṯ" xml:lang="hbo">אִמְרָתֶ֑</char><char style="w" x-id="WLC.PSA.119.11.006" x-align="PSA.119.11.a006" x-target-ids="t001" x-target="Thy" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.11.007" x-align="PSA.119.11.a007" x-target-ids="t010" x-target="That" x-target-head="t010" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="so.that" x-translit="ləmaʿan" xml:lang="hbo">לְ֝מַ֗עַן</char> <char style="w" x-id="WLC.PSA.119.11.008" x-align="PSA.119.11.a008" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morp