	<para style="p"><verse number="4" style="v" x-ref="PSA.82.4" x-added-alignments="PSA.82.4.a006" x-added-target-ids="t007" x-added-target="them" sid="PSA 82:4" /><char style="w" x-id="WLC.PSA.82.4.001" x-align="PSA.82.4.a001" x-target-ids="t001" x-target="Rescue" x-target-head="t001" x-head="true" lemma="פָּלַט" strong="H6403" x-morph="Vpv2mp" x-gloss="deliver" x-translit="palləṭû-" xml:lang="hbo">פַּלְּטוּ</char>־<char style="w" x-id="WLC.PSA.82.4.002" x-align="PSA.82.4.a002" x-target-ids="t002 t003" x-target="the poor" x-target-head="t003" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="[the].poor" x-translit="ḏal" xml:lang="hbo">דַ֥ל</char> <char style="w" x-id="WLC.PSA.82.4.003" x-align="PSA.82.4.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.82.4.004" x-align="PSA.82.4.a004" x-target-ids="t005" x-target="needy" x-target-head="t005" x-head="true" lemma="אֶבְיוֹן" strong="H34" x-morph="Aamsa" x-gloss="needy" x-translit="ʾeḇyôn" xml:lang="hbo">אֶבְי֑וֹן</char> <char style="w" x-id="WLC.PSA.82.4.005" x-align="PSA.82.4.a007" x-target-ids="t008 t009" x-target="out of" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.82.4.006" x-align="PSA.82.4.a008" x-target-ids="t010 t011" x-target="the hand" x-target-head="t011" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yyaḏ" xml:lang="hbo">יַּ֖ד</char> <char style="w" x-id="WLC.PSA.82.4.007" x-align="PSA.82.4.a009" x-target-ids="t012 t013 t014" x-target="of the wicked" x-target-head="t014" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PSA.82.4.008" x-align="PSA.82.4.a005" x-target