	<para style="p"><verse number="15" style="v" x-ref="PSA.45.15" sid="PSA 45:15" /><char style="w" x-id="WLC.PSA.45.15.001" x-align="PSA.45.15.a001" x-target-ids="t005 t006 t007 t008" x-target="shall they be led" x-target-head="t008" x-head="true" lemma="יָבַל" strong="H2986" x-morph="VHi3fp" x-gloss="they.are.brought" x-translit="tûḇalnâ" xml:lang="hbo" x-source-ref="PSA.45.16">תּ֭וּבַלְנָה</char><char style="w" x-id="WLC.PSA.45.15.002" x-align="PSA.45.15.a002" x-target-ids="t001" x-target="With" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:lang="hbo" x-source-ref="PSA.45.16">בִּ</char><char style="w" x-id="WLC.PSA.45.15.003" x-align="PSA.45.15.a003" x-target-ids="t002" x-target="gladness" x-target-head="t002" x-head="true" lemma="שִׂמְחָה" strong="H8057" x-morph="Ncfpa" x-gloss="joy(s)" x-translit="śəmāḥōṯ" xml:lang="hbo" x-source-ref="PSA.45.16">שְׂמָחֹ֣ת</char> <char style="w" x-id="WLC.PSA.45.15.004" x-align="PSA.45.15.a004" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo" x-source-ref="PSA.45.16">וָ</char><char style="w" x-id="WLC.PSA.45.15.005" x-align="PSA.45.15.a005" x-target-ids="t004" x-target="rejoicing" x-target-head="t004" x-head="true" lemma="גִּיל" strong="H1524" x-morph="Ncmsa" x-gloss="rejoicing" x-translit="ḡiyl" xml:lang="hbo" x-source-ref="PSA.45.16">גִ֑יל</char> <char style="w" x-id="WLC.PSA.45.15.006" x-align="PSA.45.15.a006" x-target-ids="t009 t010 t011" x-target="They shall enter" x-target-head="t011" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3fp" x-gloss="they.go" x-translit="təḇōʾeynâ" xml:lang="hbo" x-source-ref="PSA.45.16">תְּ֝בֹאֶ֗ינָה</char> <char style="w" x-id="WLC.PSA.45.15.007" x-align="PSA.45.15.a007" x-target-ids="t012" x-target="into" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="