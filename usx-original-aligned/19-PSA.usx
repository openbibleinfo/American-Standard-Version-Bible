	<para style="p"><verse number="1" style="v" x-ref="PSA.102.1" sid="PSA 102:1" /><char style="w" x-id="WLC.PSA.102.1.001" x-align="PSA.102.1.a001" x-target-ids="t004 t005" x-target="O Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.102.2">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.102.1.002" x-align="PSA.102.1.a002" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="hear" x-translit="šimʿ" xml:lang="hbo" x-source-ref="PSA.102.2">שִׁמְעָ֣</char><char style="w" x-id="WLC.PSA.102.1.003" x-align="PSA.102.1.a003" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo" x-source-ref="PSA.102.2">ה</char> <char style="w" x-id="WLC.PSA.102.1.004" x-align="PSA.102.1.a004" x-target-ids="t003" x-target="prayer" x-target-head="t003" x-head="true" lemma="תְּפִלָּה" strong="H8605" x-morph="Ncfsc" x-gloss="prayer" x-translit="ṯəp̄illāṯ" xml:lang="hbo" x-source-ref="PSA.102.2">תְפִלָּתִ֑</char><char style="w" x-id="WLC.PSA.102.1.005" x-align="PSA.102.1.a005" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.102.2">י</char> <char style="w" x-id="WLC.PSA.102.1.006" x-align="PSA.102.1.a006" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.102.2">וְ֝</char><char style="w" x-id="WLC.PSA.102.1.007" x-align="PSA.102.1.a007" x-target-ids="t009" x-target="cry" x-target-head="t009" x-head="true" lemma="שַׁוְעָה" strong="H7775" x-morph="Ncfsc" x-gloss="my.cry" x-translit="šawʿāṯ" xml:lang="hbo" x-source-ref="PSA.102.2">שַׁוְעָתִ֗</char><char style="w" x-id="WLC.PSA.102.1.008" x-align="PSA.102.1.a008" x-target-ids="t0