	<para style="p"><verse number="7" style="v" x-ref="PSA.49.7" x-added-alignments="PSA.49.7.a002 PSA.49.7.a004" x-added-target-ids="t009 t002 t003" x-added-target="his | of them" sid="PSA 49:7" /><char style="w" x-id="WLC.PSA.49.7.001" x-align="PSA.49.7.a001" x-target-ids="t010" x-target="brother" x-target-head="t010" x-head="true" lemma="אָח" strong="H251" x-morph="Ncmsa" x-gloss="a.brother" x-translit="ʾāḥ" xml:lang="hbo" x-source-ref="PSA.49.8">אָ֗ח</char> <char style="w" x-id="WLC.PSA.49.7.002" x-align="PSA.49.7.a003" x-target-ids="t001" x-target="None" x-target-head="t001" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.49.8">לֹא</char>־<char style="w" x-id="WLC.PSA.49.7.003" x-align="PSA.49.7.a005" x-target-ids="t005 t006 t007" x-target="by any means" x-target-head="t007" x-head="true" lemma="פָּדָה" strong="H6299" x-morph="Vqa" x-gloss="certainly.(ransom)" x-translit="p̄āḏōh" xml:lang="hbo" x-source-ref="PSA.49.8">פָדֹ֣ה</char> <char style="w" x-id="WLC.PSA.49.7.004" x-align="PSA.49.7.a006" x-target-ids="t004 t008" x-target="can redeem" x-target-head="t008" x-head="true" lemma="פָּדָה" strong="H6299" x-morph="Vqi3ms" x-gloss="he.will.ransom" x-translit="yip̄deh" xml:lang="hbo" x-source-ref="PSA.49.8">יִפְדֶּ֣ה</char> <char style="w" x-id="WLC.PSA.49.7.005" x-align="PSA.49.7.a003" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾiyš" xml:lang="hbo" x-source-ref="PSA.49.8">אִ֑ישׁ</char> <char style="w" x-id="WLC.PSA.49.7.006" x-align="PSA.49.7.a007" x-target-ids="t011" x-target="Nor" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.49.8">לֹא</char>־<char style="w" x-id="WLC.PSA.49.7.007" x-align="PSA.49.7.a008" x-target-ids="t012" x-target="give" x-target-head="t012" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="he.will.give" x-translit="yittēn" xml:lang="