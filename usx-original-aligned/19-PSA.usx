	<para style="p"><verse number="10" style="v" x-ref="PSA.2.10" sid="PSA 2:10" /><char style="w" x-id="WLC.PSA.2.10.001" x-align="PSA.2.10.a001" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.PSA.2.10.002" x-align="PSA.2.10.a002" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="therefore" x-translit="ʿattâ" xml:lang="hbo">עַתָּה</char> <char style="w" x-id="WLC.PSA.2.10.003" x-align="PSA.2.10.a003" x-target-ids="t005 t006 t007" x-target="O ye kings" x-target-head="t007" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmpa" x-gloss="O.kings" x-translit="məlāḵiym" xml:lang="hbo">מְלָכִ֣ים</char> <char style="w" x-id="WLC.PSA.2.10.004" x-align="PSA.2.10.a004" x-target-ids="t003 t004" x-target="be wise" x-target-head="t004" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vhv2mp" x-gloss="act.prudently" x-translit="haśkiylû" xml:lang="hbo">הַשְׂכִּ֑ילוּ</char> <char style="w" x-id="WLC.PSA.2.10.005" x-align="PSA.2.10.a005" x-target-ids="t008 t009" x-target="Be instructed" x-target-head="t009" x-head="true" lemma="יָסַר" strong="H3256" x-morph="VNv2mp" x-gloss="let.yourselves.be.instructed" x-translit="hiwwāsərû" xml:lang="hbo">הִ֝וָּסְר֗וּ</char> <char style="w" x-id="WLC.PSA.2.10.006" x-align="PSA.2.10.a006" x-target-ids="t010 t011" x-target="ye judges" x-target-head="t011" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vqrmpc" x-gloss="O.rulers" x-translit="šōp̄əṭê" xml:lang="hbo">שֹׁ֣פְטֵי</char> <char style="w" x-id="WLC.PSA.2.10.007" x-align="PSA.2.10.a007" x-target-ids="t012 t013 t014" x-target="of the earth" x-target-head="t014" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.[the].earth" x-translit="ʾāreṣ:" xml:lang="hbo">אָֽרֶץ</char>׃<verse eid="PSA 2:10" /></para>
