	<para style="p"><verse number="5" style="v" x-ref="PSA.14.5" sid="PSA 14:5" /><char style="w" x-id="WLC.PSA.14.5.001" x-align="PSA.14.5.a001" x-target-ids="t001" x-target="There" x-target-head="t001" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="there" x-translit="šām" xml:lang="hbo">שָׁ֤ם</char>׀<char style="w" x-id="WLC.PSA.14.5.002" x-align="PSA.14.5.a002" x-target-ids="t002 t003" x-target="were they" x-target-head="t002" x-head="true" lemma="פָּחַד" strong="H6342" x-morph="Vqp3cp" x-gloss="they.fear" x-translit="pāḥăḏû" xml:lang="hbo">פָּ֣חֲדוּ</char> <char style="w" x-id="WLC.PSA.14.5.003" x-align="PSA.14.5.a003" x-target-ids="t004 t005 t006" x-target="in great fear" x-target-head="t006" x-head="true" lemma="פַּחַד" strong="H6343" x-morph="Ncmsa" x-gloss="a.fear" x-translit="p̄āḥaḏ" xml:lang="hbo">פָ֑חַד</char> <char style="w" x-id="WLC.PSA.14.5.004" x-align="PSA.14.5.a004" x-target-ids="t007" x-target="For" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.14.5.005" x-align="PSA.14.5.a005" x-target-ids="t008" x-target="God" x-target-head="t008" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo">אֱ֝לֹהִ֗ים</char> <char style="w" x-id="WLC.PSA.14.5.006" x-align="PSA.14.5.a006" x-target-ids="t009 t010" x-target="is in" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.14.5.007" x-align="PSA.14.5.a007" x-target-ids="t011 t012" x-target="the generation" x-target-head="t012" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsa" x-gloss="a.generation" x-translit="ḏôr" xml:lang="hbo">ד֣וֹר</char> <char style="w" x-id="WLC.PSA.14.5.008" x-align="PSA.14.5.a008" x-target-ids="t013 t014 t015" x-target="of the righteous" x-target-head="t015" x-head="true" lemma="צ