	<para style="p"><verse number="4" style="v" x-ref="PSA.119.4" x-added-alignments="PSA.119.4.a008 PSA.119.4.a009" x-added-target-ids="t004 t011" x-added-target="us | them" sid="PSA 119:4" /><char style="w" x-id="WLC.PSA.119.4.001" x-align="PSA.119.4.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattâ" xml:lang="hbo">אַ֭תָּה</char> <char style="w" x-id="WLC.PSA.119.4.002" x-align="PSA.119.4.a002" x-target-ids="t002 t003" x-target="hast commanded" x-target-head="t003" x-head="true" lemma="צָוָה" strong="H6680" x-morph="Vpp2ms" x-gloss="you.have.commanded" x-translit="ṣiwwiyṯâ" xml:lang="hbo">צִוִּ֥יתָה</char> <char style="w" x-id="WLC.PSA.119.4.003" x-align="PSA.119.4.a003" x-target-ids="t006" x-target="precepts" x-target-head="t006" x-head="true" lemma="פִּקּוּדִים" strong="H6490" x-morph="Ncmpc" x-gloss="precepts" x-translit="p̄iqquḏey" xml:lang="hbo">פִקֻּדֶ֗י</char><char style="w" x-id="WLC.PSA.119.4.004" x-align="PSA.119.4.a004" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.4.005" x-align="PSA.119.4.a005" x-target-ids="t007" x-target="That" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.119.4.006" x-align="PSA.119.4.a006" x-target-ids="t008 t009 t010" x-target="we should observe" x-target-head="t010" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqc" x-gloss="keep" x-translit="šəmōr" xml:lang="hbo">שְׁמֹ֥ר</char> <char style="w" x-id="WLC.PSA.119.4.007" x-align="PSA.119.4.a007" x-target-ids="t012" x-target="diligently" x-target-head="t012" x-head="true" lemma="מְאֹד" strong="H3966" x-morph="D" x-gloss="exceedingly" x-translit="məʾōḏ:" xml:lang="hbo">מְאֹֽד</char>׃<verse eid="PSA 119:4" /></pa