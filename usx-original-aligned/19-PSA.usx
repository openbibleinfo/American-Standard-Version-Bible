	<para style="p"><verse number="5" style="v" x-ref="PSA.26.5" sid="PSA 26:5" /><char style="w" x-id="WLC.PSA.26.5.001" x-align="PSA.26.5.a001" x-target-ids="t001 t002" x-target="I hate" x-target-head="t002" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqp1cs" x-gloss="I.hate" x-translit="śānēʾṯî" xml:lang="hbo">שָׂ֭נֵאתִי</char> <char style="w" x-id="WLC.PSA.26.5.002" x-align="PSA.26.5.a002" x-target-ids="t003 t004" x-target="the assembly" x-target-head="t004" x-head="true" lemma="קָהָל" strong="H6951" x-morph="Ncmsc" x-gloss="[the].assembly" x-translit="qəhal" xml:lang="hbo">קְהַ֣ל</char> <char style="w" x-id="WLC.PSA.26.5.003" x-align="PSA.26.5.a003" x-target-ids="t005 t006 t007" x-target="of evil doers" x-target-head="t006" x-head="true" lemma="רָעַע" strong="H7489" x-morph="Vhrmpa" x-gloss="of.evil-doers" x-translit="mərēʿiym" xml:lang="hbo">מְרֵעִ֑ים</char> <char style="w" x-id="WLC.PSA.26.5.004" x-align="PSA.26.5.a004" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.26.5.005" x-align="PSA.26.5.a005" x-target-ids="t012" x-target="with" x-target-head="t012" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.PSA.26.5.006" x-align="PSA.26.5.a006" x-target-ids="t013 t014" x-target="the wicked" x-target-head="t014" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְ֝שָׁעִ֗ים</char> <char style="w" x-id="WLC.PSA.26.5.007" x-align="PSA.26.5.a007" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PSA.26.5.008" x-align="PSA.26.5.a008" x-target-ids="t009 t011" x-target="will sit" x-target-head="t011" x-head="true" lemma="