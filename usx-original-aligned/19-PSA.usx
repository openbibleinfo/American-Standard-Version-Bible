	<para style="p"><verse number="4" style="v" x-ref="PSA.61.4" sid="PSA 61:4" /><char style="w" x-id="WLC.PSA.61.4.001" x-align="PSA.61.4.a001" x-target-ids="t001 t002 t003" x-target="I will dwell" x-target-head="t003" x-head="true" lemma="גּוּר" strong="H1481" x-morph="Vqh1cs" x-gloss="let.me.sojourn" x-translit="ʾāḡûrâ" xml:lang="hbo" x-source-ref="PSA.61.5">אָג֣וּרָה</char> <char style="w" x-id="WLC.PSA.61.4.002" x-align="PSA.61.4.a002" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.61.5">בְ֭</char><char style="w" x-id="WLC.PSA.61.4.003" x-align="PSA.61.4.a003" x-target-ids="t006" x-target="tabernacle" x-target-head="t006" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmsc" x-gloss="tent" x-translit="ʾāhāl" xml:lang="hbo" x-source-ref="PSA.61.5">אָהָלְ</char><char style="w" x-id="WLC.PSA.61.4.004" x-align="PSA.61.4.a004" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.61.5">ךָ</char> <char style="w" x-id="WLC.PSA.61.4.005" x-align="PSA.61.4.a005" x-target-ids="t007 t008" x-target="for ever" x-target-head="t008" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmpa" x-gloss="forever" x-translit="ʿôlāmiym" xml:lang="hbo" x-source-ref="PSA.61.5">עוֹלָמִ֑ים</char> <char style="w" x-id="WLC.PSA.61.4.006" x-align="PSA.61.4.a006" x-target-ids="t009 t010 t011 t012" x-target="I will take refuge" x-target-head="t012" x-head="true" lemma="חָסָה" strong="H2620" x-morph="Vqi1cs" x-gloss="let.me.take.refuge" x-translit="ʾeḥĕseh" xml:lang="hbo" x-source-ref="PSA.61.5">אֶֽחֱסֶ֨ה</char> <char style="w" x-id="WLC.PSA.61.4.007" x-align="PSA.61.4.a007" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.61.