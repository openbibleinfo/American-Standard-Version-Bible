	<para style="p"><verse number="43" style="v" x-ref="PSA.18.43" x-added-alignments="PSA.18.43.a012" x-added-target-ids="t022" x-added-target="whom" sid="PSA 18:43" /><char style="w" x-id="WLC.PSA.18.43.001" x-align="PSA.18.43.a001" x-target-ids="t001 t002 t003" x-target="Thou hast delivered" x-target-head="t003" x-head="true" lemma="פָּלַט" strong="H6403" x-morph="Vpi2ms" x-gloss="you" x-translit="təp̄alləṭ" xml:lang="hbo" x-source-ref="PSA.18.44">תְּפַלְּטֵ</char><char style="w" x-id="WLC.PSA.18.43.002" x-align="PSA.18.43.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="delivered.me" x-translit="ēniy" xml:lang="hbo" x-source-ref="PSA.18.44">נִי֮</char> <char style="w" x-id="WLC.PSA.18.43.003" x-align="PSA.18.43.a003" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo" x-source-ref="PSA.18.44">מֵ</char><char style="w" x-id="WLC.PSA.18.43.004" x-align="PSA.18.43.a004" x-target-ids="t006 t007" x-target="the strivings" x-target-head="t007" x-head="true" lemma="רִיב" strong="H7379" x-morph="Ncbpc" x-gloss="strifes" x-translit="riyḇēy" xml:lang="hbo" x-source-ref="PSA.18.44">רִ֪יבֵ֫י</char> <char style="w" x-id="WLC.PSA.18.43.005" x-align="PSA.18.43.a005" x-target-ids="t008 t009 t010" x-target="of the people" x-target-head="t010" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="of.a.people" x-translit="ʿām" xml:lang="hbo" x-source-ref="PSA.18.44">עָ֥ם</char> <char style="w" x-id="WLC.PSA.18.43.006" x-align="PSA.18.43.a006" x-target-ids="t011 t012 t013" x-target="Thou hast made" x-target-head="t013" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqi2ms" x-gloss="you" x-translit="təśiym" xml:lang="hbo" x-source-ref="PSA.18.44">תְּ֭שִׂימֵ</char><char style="w" x-id="WLC.PSA.18.43.007" x-align="PSA.18.43.a007" x-target-ids="t014" x-target="me" x-target-head="t014" x-h