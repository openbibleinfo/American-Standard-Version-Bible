	<para style="p"><verse number="4" style="v" x-ref="PSA.83.4" sid="PSA 83:4" /><char style="w" x-id="WLC.PSA.83.4.001" x-align="PSA.83.4.a001" x-target-ids="t001 t002 t003" x-target="They have said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3cp" x-gloss="they.have.said" x-translit="ʾāmərû" xml:lang="hbo" x-source-ref="PSA.83.5">אָמְר֗וּ</char> <char style="w" x-id="WLC.PSA.83.4.002" x-align="PSA.83.4.a002" x-target-ids="t004" x-target="Come" x-target-head="t004" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2mp" x-gloss="come" x-translit="ləḵû" xml:lang="hbo" x-source-ref="PSA.83.5">לְ֭כוּ</char> <char style="w" x-id="WLC.PSA.83.4.003" x-align="PSA.83.4.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.83.5">וְ</char><char style="w" x-id="WLC.PSA.83.4.004" x-align="PSA.83.4.a004" x-target-ids="t006 t007 t008 t010" x-target="let us cut off" x-target-head="t008" x-head="true" lemma="כָּחַד" strong="H3582" x-morph="Vhi1cp" x-gloss="let" x-translit="naḵḥiyḏ" xml:lang="hbo" x-source-ref="PSA.83.5">נַכְחִידֵ֣</char><char style="w" x-id="WLC.PSA.83.4.005" x-align="PSA.83.4.a005" x-target-ids="t009" x-target="them" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="us.annihilate.them" x-translit="ēm" xml:lang="hbo" x-source-ref="PSA.83.5">ם</char> <char style="w" x-id="WLC.PSA.83.4.006" x-align="PSA.83.4.a006" x-target-ids="t011" x-target="from" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.83.5">מִ</char><char style="w" x-id="WLC.PSA.83.4.007" x-align="PSA.83.4.a007" x-target-ids="t012 t013 t014" x-target="being a nation" x-target-head="t014" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="a.nation" x-translit="gôy" xml:lang="hbo" x-source-ref="PSA.83.5">גּ֑וֹי