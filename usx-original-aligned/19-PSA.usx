	<para style="p"><verse number="76" style="v" x-ref="PSA.119.76" sid="PSA 119:76" /><char style="w" x-id="WLC.PSA.119.76.001" x-align="PSA.119.76.a001" x-target-ids="t001 t007" x-target="Let be" x-target-head="t007" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqj3ms" x-gloss="let.it.be" x-translit="yəhî-" xml:lang="hbo">יְהִי</char>־<char style="w" x-id="WLC.PSA.119.76.002" x-align="PSA.119.76.a002" x-target-ids="t002 t003 t004" x-target="I pray thee" x-target-head="t003" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֣א</char> <char style="w" x-id="WLC.PSA.119.76.003" x-align="PSA.119.76.a003" x-target-ids="t006" x-target="lovingkindness" x-target-head="t006" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo">חַסְדְּ</char><char style="w" x-id="WLC.PSA.119.76.004" x-align="PSA.119.76.a004" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.covenant" x-translit="əḵā" xml:lang="hbo">ךָ֣</char> <char style="w" x-id="WLC.PSA.119.76.005" x-align="PSA.119.76.a005" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.119.76.006" x-align="PSA.119.76.a006" x-target-ids="t010" x-target="comfort" x-target-head="t010" x-head="true" lemma="נָחַם" strong="H5162" x-morph="Vpc" x-gloss="comfort" x-translit="naḥăm" xml:lang="hbo">נַחֲמֵ֑</char><char style="w" x-id="WLC.PSA.119.76.007" x-align="PSA.119.76.a007" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.76.008" x-align="PSA.119.76.a008" x-target-ids="t011 t012" x-target="According to" x-target-head="t011" x-head="true" lemma="כְּ" strong=