	<para style="p"><verse number="6" style="v" x-ref="PSA.132.6" sid="PSA 132:6" /><char style="w" x-id="WLC.PSA.132.6.001" x-align="PSA.132.6.a001" x-target-ids="t001" x-target="Lo" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh-" xml:lang="hbo">הִנֵּֽה</char>־<char style="w" x-id="WLC.PSA.132.6.002" x-align="PSA.132.6.a002" x-target-ids="t002 t003 t004" x-target="we heard of" x-target-head="t003" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp1cp" x-gloss="we" x-translit="šəmaʿănû" xml:lang="hbo">שְׁמַֽעֲנ֥וּ</char><char style="w" x-id="WLC.PSA.132.6.003" x-align="PSA.132.6.a003" x-target-ids="t005" x-target="it" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="heard.of.it" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PSA.132.6.004" x-align="PSA.132.6.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PSA.132.6.005" x-align="PSA.132.6.a005" x-target-ids="t007" x-target="Ephrathah" x-target-head="t007" x-head="true" lemma="אֶפְרָתָה" strong="H672b" x-morph="Np" x-gloss="Ephrathah" x-translit="ʾep̄rāṯâ" xml:lang="hbo">אֶפְרָ֑תָה</char> <char style="w" x-id="WLC.PSA.132.6.006" x-align="PSA.132.6.a006" x-target-ids="t008 t009" x-target="We found" x-target-head="t009" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqp1cp" x-gloss="we" x-translit="məṣāʾnû" xml:lang="hbo">מְ֝צָאנ֗וּ</char><char style="w" x-id="WLC.PSA.132.6.007" x-align="PSA.132.6.a007" x-target-ids="t010" x-target="it" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="found.it" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PSA.132.6.008" x-align="PSA.132.6.a008" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R"