	<para style="p"><verse number="2" style="v" x-ref="PSA.1.2" sid="PSA 1:2" /><char style="w" x-id="WLC.PSA.1.2.001" x-align="PSA.1.2.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PSA.1.2.002" x-align="PSA.1.2.a001" lemma="אִם" strong="H518" x-morph="C" x-gloss="(if)" x-translit="ʾim" xml:lang="hbo">אִ֥ם</char> <char style="w" x-id="WLC.PSA.1.2.003" x-align="PSA.1.2.a002" x-target-ids="t004 t005" x-target="is in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.1.2.004" x-align="PSA.1.2.a003" x-target-ids="t006 t007" x-target="the law" x-target-head="t007" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="the.law" x-translit="ṯôraṯ" xml:lang="hbo">תוֹרַ֥ת</char> <char style="w" x-id="WLC.PSA.1.2.005" x-align="PSA.1.2.a004" x-target-ids="t008 t009" x-target="of Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.PSA.1.2.006" x-align="PSA.1.2.a005" x-target-ids="t003" x-target="delight" x-target-head="t003" x-head="true" lemma="חֵפֶץ" strong="H2656" x-morph="Ncmsc" x-gloss="delight" x-translit="ḥep̄ṣ" xml:lang="hbo">חֶ֫פְצ֥</char><char style="w" x-id="WLC.PSA.1.2.007" x-align="PSA.1.2.a006" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PSA.1.2.008" x-align="PSA.1.2.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.PSA.1.2.009" x-align="PSA.1.2.a008" x-target-ids="t011" 