	<para style="p"><verse number="8" style="v" x-ref="PSA.16.8" sid="PSA 16:8" /><char style="w" x-id="WLC.PSA.16.8.001" x-align="PSA.16.8.a001" x-target-ids="t001 t002 t003" x-target="I have set" x-target-head="t003" x-head="true" lemma="שָׁוָה" strong="H7737a" x-morph="Vpp1cs" x-gloss="I.have.placed" x-translit="šiwwiyṯî" xml:lang="hbo">שִׁוִּ֬יתִי</char> <char style="w" x-id="WLC.PSA.16.8.002" x-align="PSA.16.8.a002" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.16.8.003" x-align="PSA.16.8.a004" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.16.8.004" x-align="PSA.16.8.a004" x-target-ids="t006" x-target="before" x-target-head="t006" x-head="true" lemma="נֶגֶד" strong="H5048" x-morph="R" x-gloss="before" x-translit="neḡd" xml:lang="hbo">נֶגְדִּ֣</char><char style="w" x-id="WLC.PSA.16.8.005" x-align="PSA.16.8.a005" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.16.8.006" x-align="PSA.16.8.a003" x-target-ids="t005" x-target="always" x-target-head="t005" x-head="true" lemma="תָּמִיד" strong="H8548" x-morph="Ncmsa" x-gloss="continually" x-translit="ṯāmiyḏ" xml:lang="hbo">תָמִ֑יד</char> <char style="w" x-id="WLC.PSA.16.8.007" x-align="PSA.16.8.a006" x-target-ids="t008" x-target="Because" x-target-head="t008" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.PSA.16.8.008" x-align="PSA.16.8.a007" x-target-ids="t009 t010 t011" x-target="he is at" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="[he" x-translit="mi" xml:lang="hbo">מִֽ֝</char><char style="w" x-id="WLC.PS