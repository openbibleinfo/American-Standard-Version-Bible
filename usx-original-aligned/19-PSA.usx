	<para style="p"><verse number="42" style="v" x-ref="PSA.18.42" sid="PSA 18:42" /><char style="w" x-id="WLC.PSA.18.42.001" x-align="PSA.18.42.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.43">וְֽ</char><char style="w" x-id="WLC.PSA.18.42.002" x-align="PSA.18.42.a002" x-target-ids="t002 t003 t004 t006" x-target="did I beat small" x-target-head="t006" x-head="true" lemma="שָׁחַק" strong="H7833" x-morph="Vqi1cs" x-gloss="I" x-translit="ʾešḥāq" xml:lang="hbo" x-source-ref="PSA.18.43">אֶשְׁחָקֵ֗</char><char style="w" x-id="WLC.PSA.18.42.003" x-align="PSA.18.42.a003" x-target-ids="t005" x-target="them" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="beat.them.fine" x-translit="ēm" xml:lang="hbo" x-source-ref="PSA.18.43">ם</char> <char style="w" x-id="WLC.PSA.18.42.004" x-align="PSA.18.42.a004" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo" x-source-ref="PSA.18.43">כְּ</char><char style="w" x-id="WLC.PSA.18.42.005" x-align="PSA.18.42.a005" x-target-ids="t008 t009" x-target="the dust" x-target-head="t009" x-head="true" lemma="עָפָר" strong="H6083" x-morph="Ncmsa" x-gloss="dust" x-translit="ʿāp̄ār" xml:lang="hbo" x-source-ref="PSA.18.43">עָפָ֥ר</char> <char style="w" x-id="WLC.PSA.18.42.006" x-align="PSA.18.42.a006" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.18.43">עַל</char>־<char style="w" x-id="WLC.PSA.18.42.007" x-align="PSA.18.42.a006" x-target-ids="t010" x-target="before" x-target-head="t010" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="[the].face" x-translit="pənê-" xml:lang="hbo" x-source-ref="PSA.18.43">פְּנֵי</char>־<char style="w" x-id="WLC.PSA.18.42.008" x-align="PSA.18.42.a007" x-target-ids="t011 t01