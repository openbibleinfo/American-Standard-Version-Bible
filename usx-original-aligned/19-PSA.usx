	<para style="p"><verse number="49" style="v" x-ref="PSA.18.49" sid="PSA 18:49" /><char style="w" x-id="WLC.PSA.18.49.001" x-align="PSA.18.49.a001" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.18.50">עַל</char>־<char style="w" x-id="WLC.PSA.18.49.002" x-align="PSA.18.49.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo" x-source-ref="PSA.18.50">כֵּ֤ן</char>׀<char style="w" x-id="WLC.PSA.18.49.003" x-align="PSA.18.49.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="I will give thanks unto" x-target-head="t005" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo" x-source-ref="PSA.18.50">אוֹדְ</char><char style="w" x-id="WLC.PSA.18.49.004" x-align="PSA.18.49.a003" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.18.50">ךָ֖</char> <char style="w" x-id="WLC.PSA.18.49.005" x-align="PSA.18.49.a004" x-target-ids="t010" x-target="among" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ḇa" xml:lang="hbo" x-source-ref="PSA.18.50">בַ</char><char style="w" x-id="WLC.PSA.18.49.006" x-align="PSA.18.49.a005" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.18.50">[הַ]</char><char style="w" x-id="WLC.PSA.18.49.007" x-align="PSA.18.49.a006" x-target-ids="t012" x-target="nations" x-target-head="t012" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="gôyim" xml:lang="hbo" x-source-ref="PSA.18.50">גּוֹיִ֥ם</char>׀<char style="w" x-id="WLC.PSA.18.49.008" x-align="PSA.18.49.a007" x-target-ids="t008 t00