	<para style="p"><verse number="4" style="v" x-ref="PSA.33.4" x-added-alignments="PSA.33.4.a010" x-added-target-ids="t013" x-added-target="done" sid="PSA 33:4" /><char style="w" x-id="WLC.PSA.33.4.001" x-align="PSA.33.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.33.4.002" x-align="PSA.33.4.a002" x-target-ids="t006 t007" x-target="is right" x-target-head="t007" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aamsa" x-gloss="[is].upright" x-translit="yāšār" xml:lang="hbo">יָשָׁ֥ר</char> <char style="w" x-id="WLC.PSA.33.4.003" x-align="PSA.33.4.a003" x-target-ids="t002 t003" x-target="the word" x-target-head="t003" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="the.word" x-translit="dəḇar-" xml:lang="hbo">דְּבַר</char>־<char style="w" x-id="WLC.PSA.33.4.004" x-align="PSA.33.4.a004" x-target-ids="t004 t005" x-target="of Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.33.4.005" x-align="PSA.33.4.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.33.4.006" x-align="PSA.33.4.a006" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.33.4.007" x-align="PSA.33.4.a007" x-target-ids="t011" x-target="work" x-target-head="t011" x-head="true" lemma="מַעֲשֶׂה" strong="H4639" x-morph="Ncmsc" x-gloss="work" x-translit="maʿăś" xml:lang="hbo">מַ֝עֲשֵׂ֗</char><char style="w" x-id="WLC.PSA.33.4.008" x-align="PSA.33.4.a008" x-target-ids="t010" x-target="his" x-target-head="t