	<para style="p"><verse number="19" style="v" x-ref="PSA.37.19" sid="PSA 37:19" /><char style="w" x-id="WLC.PSA.37.19.001" x-align="PSA.37.19.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PSA.37.19.002" x-align="PSA.37.19.a002" x-target-ids="t001 t002 t004 t005 t006 t007" x-target="They shall be put to shame" x-target-head="t007" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi3mp" x-gloss="they.will.be.ashamed" x-translit="yēḇōšû" xml:lang="hbo">יֵ֭בֹשׁוּ</char> <char style="w" x-id="WLC.PSA.37.19.003" x-align="PSA.37.19.a003" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.37.19.004" x-align="PSA.37.19.a004" x-target-ids="t009 t010" x-target="the time" x-target-head="t010" x-head="true" lemma="עֵת" strong="H6256" x-morph="Ncbsc" x-gloss="a.time" x-translit="ʿēṯ" xml:lang="hbo">עֵ֣ת</char> <char style="w" x-id="WLC.PSA.37.19.005" x-align="PSA.37.19.a005" x-target-ids="t011 t012" x-target="of evil" x-target-head="t012" x-head="true" lemma="רָעָה" strong="H7451" x-morph="Ncmsa" x-gloss="of.evil" x-translit="rāʿāh" xml:lang="hbo">רָעָ֑ה</char> <char style="w" x-id="WLC.PSA.37.19.006" x-align="PSA.37.19.a006" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.37.19.007" x-align="PSA.37.19.a007" x-target-ids="t014" x-target="in" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.PSA.37.19.008" x-align="PSA.37.19.a008" x-target-ids="t015 t016" x-target="the days" x-target-head="t016" x-head="true" lemma="יוֹם" strong="H3117" x-morph