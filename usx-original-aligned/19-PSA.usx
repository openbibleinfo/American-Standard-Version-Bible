	<para style="p"><verse number="10" style="v" x-ref="PSA.139.10" sid="PSA 139:10" /><char style="w" x-id="WLC.PSA.139.10.001" x-align="PSA.139.10.a001" x-target-ids="t001" x-target="Even" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.PSA.139.10.002" x-align="PSA.139.10.a002" x-target-ids="t002" x-target="there" x-target-head="t002" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="there" x-translit="šām" xml:lang="hbo">שָׁ֭ם</char> <char style="w" x-id="WLC.PSA.139.10.003" x-align="PSA.139.10.a003" x-target-ids="t005" x-target="hand" x-target-head="t005" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָדְ</char><char style="w" x-id="WLC.PSA.139.10.004" x-align="PSA.139.10.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֣</char> <char style="w" x-id="WLC.PSA.139.10.005" x-align="PSA.139.10.a005" x-target-ids="t003 t006" x-target="shall lead" x-target-head="t006" x-head="true" lemma="נָחָה" strong="H5148" x-morph="Vhi3fs" x-gloss="it" x-translit="ṯanḥ" xml:lang="hbo">תַנְחֵ֑</char><char style="w" x-id="WLC.PSA.139.10.006" x-align="PSA.139.10.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.lead.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.139.10.007" x-align="PSA.139.10.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.139.10.008" x-align="PSA.139.10.a008" x-target-ids="t012 t013" x-target="shall hold" x-target-head="t013" x-head="true" lemma="אָחַז" strong="H270" x-morph="Vqi3fs" x-gloss="it" x-transli