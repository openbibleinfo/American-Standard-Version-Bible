	<para style="p"><verse number="20" style="v" x-ref="PSA.49.20" x-added-alignments="PSA.49.20.a002 PSA.49.20.a011" x-added-target-ids="t002 t013" x-added-target="that | that" sid="PSA 49:20" /><char style="w" x-id="WLC.PSA.49.20.001" x-align="PSA.49.20.a001" x-target-ids="t001" x-target="Man" x-target-head="t001" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="humankind" x-translit="ʾāḏām" xml:lang="hbo" x-source-ref="PSA.49.21">אָדָ֣ם</char> <char style="w" x-id="WLC.PSA.49.20.002" x-align="PSA.49.20.a003" x-target-ids="t003 t004" x-target="is in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bi" xml:lang="hbo" x-source-ref="PSA.49.21">בִּ֭</char><char style="w" x-id="WLC.PSA.49.20.003" x-align="PSA.49.20.a004" x-target-ids="t005" x-target="honor" x-target-head="t005" x-head="true" lemma="יְקָר" strong="H3366" x-morph="Ncmsa" x-gloss="honor" x-translit="yqār" xml:lang="hbo" x-source-ref="PSA.49.21">יקָר</char> <char style="w" x-id="WLC.PSA.49.20.004" x-align="PSA.49.20.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[who]" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.49.21">וְ</char><char style="w" x-id="WLC.PSA.49.20.005" x-align="PSA.49.20.a006" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.49.21">לֹ֣א</char> <char style="w" x-id="WLC.PSA.49.20.006" x-align="PSA.49.20.a007" x-target-ids="t007" x-target="understandeth" x-target-head="t007" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi3ms" x-gloss="he.understands" x-translit="yāḇiyn" xml:lang="hbo" x-source-ref="PSA.49.21">יָבִ֑ין</char> <char style="w" x-id="WLC.PSA.49.20.007" x-align="PSA.49.20.a008" x-target-ids="t009 t010" x-target="Is like" x-target-head="t010" x-head="true" lemma="מָשַׁל" strong="H4911" x-morph="VNp3ms"