	<para style="p"><verse number="10" style="v" x-ref="PSA.76.10" sid="PSA 76:10" /><char style="w" x-id="WLC.PSA.76.10.001" x-align="PSA.76.10.a001" x-target-ids="t001" x-target="Surely" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.76.11">כִּֽי</char>־<char style="w" x-id="WLC.PSA.76.10.002" x-align="PSA.76.10.a002" x-target-ids="t002 t003" x-target="the wrath" x-target-head="t003" x-head="true" lemma="חֵמָה" strong="H2534" x-morph="Ncfsc" x-gloss="[the].anger" x-translit="ḥămaṯ" xml:lang="hbo" x-source-ref="PSA.76.11">חֲמַ֣ת</char> <char style="w" x-id="WLC.PSA.76.10.003" x-align="PSA.76.10.a003" x-target-ids="t004 t005" x-target="of man" x-target-head="t005" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.humankind" x-translit="ʾāḏām" xml:lang="hbo" x-source-ref="PSA.76.11">אָדָ֣ם</char> <char style="w" x-id="WLC.PSA.76.10.004" x-align="PSA.76.10.a004" x-target-ids="t006 t007" x-target="shall praise" x-target-head="t007" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi3fs" x-gloss="it" x-translit="tôḏ" xml:lang="hbo" x-source-ref="PSA.76.11">תּוֹדֶ֑</char><char style="w" x-id="WLC.PSA.76.10.005" x-align="PSA.76.10.a005" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.praise.you" x-translit="ekkā" xml:lang="hbo" x-source-ref="PSA.76.11">ךָּ</char> <char style="w" x-id="WLC.PSA.76.10.006" x-align="PSA.76.10.a006" x-target-ids="t009 t010" x-target="The residue" x-target-head="t010" x-head="true" lemma="שְׁאֵרִית" strong="H7611" x-morph="Ncfsc" x-gloss="[the].remainder" x-translit="šəʾēriyṯ" xml:lang="hbo" x-source-ref="PSA.76.11">שְׁאֵרִ֖ית</char> <char style="w" x-id="WLC.PSA.76.10.007" x-align="PSA.76.10.a007" x-target-ids="t011 t012" x-target="of wrath" x-target-head="t012" x-head="true" lemma="חֵמָה" strong="H2534" x-morph="Ncfpa" x-gloss="of.anger(s)" x-transl