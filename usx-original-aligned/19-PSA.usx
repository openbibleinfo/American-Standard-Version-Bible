	<para style="p"><verse number="7" style="v" x-ref="PSA.17.7" x-added-alignments="PSA.17.7.a006 PSA.17.7.a007 PSA.17.7.a013 PSA.17.7.a014" x-added-target-ids="t017 t018 t024 t025" x-added-target="in | thee | against | them" sid="PSA 17:7" /><char style="w" x-id="WLC.PSA.17.7.001" x-align="PSA.17.7.a001" x-target-ids="t001 t003" x-target="Show marvellous" x-target-head="t003" x-head="true" lemma="פלא" strong="H6381" x-morph="Vhv2ms" x-gloss="make.wonderful" x-translit="hap̄lēh" xml:lang="hbo">הַפְלֵ֣ה</char> <char style="w" x-id="WLC.PSA.17.7.002" x-align="PSA.17.7.a002" x-target-ids="t004" x-target="lovingkindness" x-target-head="t004" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmpc" x-gloss="loyalti(es)" x-translit="ḥăsāḏey" xml:lang="hbo">חֲ֭סָדֶי</char><char style="w" x-id="WLC.PSA.17.7.003" x-align="PSA.17.7.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.covenant" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.17.7.004" x-align="PSA.17.7.a004" x-target-ids="t005 t006 t007 t008" x-target="O thou that savest" x-target-head="t008" x-head="true" lemma="יָשַׁע" strong="H3467a" x-morph="Vhrmsa" x-gloss="O.deliverer" x-translit="môšiyᵃʿ" xml:lang="hbo">מוֹשִׁ֣יעַ</char> <char style="w" x-id="WLC.PSA.17.7.005" x-align="PSA.17.7.a005" x-target-ids="t013 t014 t015 t016" x-target="them that take refuge" x-target-head="t016" x-head="true" lemma="חָסָה" strong="H2620" x-morph="Vqrmpa" x-gloss="of.[those.who].take.refuge" x-translit="ḥôsiym" xml:lang="hbo">חוֹסִ֑ים</char> <char style="w" x-id="WLC.PSA.17.7.006" x-align="PSA.17.7.a008" x-target-ids="t019" x-target="From" x-target-head="t019" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ֝</char><char style="w" x-id="WLC.PSA.17.7.007" x-align="PSA.17.7.a009" x-target-ids="t020 t021 t022 t023" x-target="those that rise up" x-target-head="t022" x-head="tru