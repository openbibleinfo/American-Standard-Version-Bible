	<para style="p"><verse number="13" style="v" x-ref="PSA.71.13" x-added-alignments="PSA.71.13.a002" x-added-target-ids="t007" x-added-target="and" sid="PSA 71:13" /><char style="w" x-id="WLC.PSA.71.13.001" x-align="PSA.71.13.a001" x-target-ids="t001 t002 t003 t004 t005 t006" x-target="Let them be put to shame" x-target-head="t006" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi3mp" x-gloss="may.they.be.ashamed" x-translit="yēḇōšû" xml:lang="hbo">יֵבֹ֣שׁוּ</char> <char style="w" x-id="WLC.PSA.71.13.002" x-align="PSA.71.13.a003" x-target-ids="t008" x-target="consumed" x-target-head="t008" x-head="true" lemma="כָּלָה" strong="H3615" x-morph="Vqi3mp" x-gloss="may.they.come.to.an.end" x-translit="yiḵlû" xml:lang="hbo">יִכְלוּ֮</char> <char style="w" x-id="WLC.PSA.71.13.003" x-align="PSA.71.13.a004" x-target-ids="t009 t010 t011" x-target="that are adversaries" x-target-head="t011" x-head="true" lemma="שָׂטַן" strong="H7853" x-morph="Vqrmpc" x-gloss="[those.who].accuse" x-translit="śōṭənēy" xml:lang="hbo">שֹׂטְנֵ֪י</char> <char style="w" x-id="WLC.PSA.71.13.004" x-align="PSA.71.13.a005" x-target-ids="t012 t014" x-target="to soul" x-target-head="t014" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַ֫פְשִׁ֥</char><char style="w" x-id="WLC.PSA.71.13.005" x-align="PSA.71.13.a006" x-target-ids="t013" x-target="my" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="(of).my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.71.13.006" x-align="PSA.71.13.a007" x-target-ids="t015 t016 t017 t018 t019" x-target="Let them be covered with" x-target-head="t018" x-head="true" lemma="עָטָה" strong="H5844" x-morph="Vqi3mp" x-gloss="may.they.be.covered" x-translit="yaʿăṭû" xml:lang="hbo">יַֽעֲט֣וּ</char> <char style="w" x-id="WLC.PSA.71.13.007" x-align="PSA.71.13.a008" x-target-ids="t020" x-target="reproach" x-target-head="t020" x-head="true" lemma="חֶרְפָּה" stro