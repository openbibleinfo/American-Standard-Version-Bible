	<para style="p"><verse number="8" style="v" x-ref="PSA.80.8" sid="PSA 80:8" /><char style="w" x-id="WLC.PSA.80.8.001" x-align="PSA.80.8.a001" x-target-ids="t003 t004" x-target="a vine" x-target-head="t004" x-head="true" lemma="גֶּפֶן" strong="H1612" x-morph="Ncbsa" x-gloss="a.vine" x-translit="gep̄en" xml:lang="hbo" x-source-ref="PSA.80.9">גֶּ֭פֶן</char> <char style="w" x-id="WLC.PSA.80.8.002" x-align="PSA.80.8.a002" x-target-ids="t005 t006" x-target="out of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.80.9">מִ</char><char style="w" x-id="WLC.PSA.80.8.003" x-align="PSA.80.8.a003" x-target-ids="t007" x-target="Egypt" x-target-head="t007" x-head="true" lemma="מִצְרַיִם" strong="H4714" x-morph="Np" x-gloss="Egypt" x-translit="mmiṣrayim" xml:lang="hbo" x-source-ref="PSA.80.9">מִּצְרַ֣יִם</char> <char style="w" x-id="WLC.PSA.80.8.004" x-align="PSA.80.8.a004" x-target-ids="t001 t002" x-target="Thou broughtest" x-target-head="t002" x-head="true" lemma="נָסַע" strong="H5265" x-morph="Vhi2ms" x-gloss="you.uprooted" x-translit="tassiyᵃʿ" xml:lang="hbo" x-source-ref="PSA.80.9">תַּסִּ֑יעַ</char> <char style="w" x-id="WLC.PSA.80.8.005" x-align="PSA.80.8.a005" x-target-ids="t008 t009 t010 t011" x-target="Thou didst drive out" x-target-head="t010" x-head="true" lemma="גָּרַשׁ" strong="H1644" x-morph="Vpi2ms" x-gloss="you.drove.out" x-translit="təḡārēš" xml:lang="hbo" x-source-ref="PSA.80.9">תְּגָרֵ֥שׁ</char> <char style="w" x-id="WLC.PSA.80.8.006" x-align="PSA.80.8.a006" x-target-ids="t012 t013" x-target="the nations" x-target-head="t013" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="gôyim" xml:lang="hbo" x-source-ref="PSA.80.9">גּ֝וֹיִ֗ם</char> <char style="w" x-id="WLC.PSA.80.8.007" x-align="PSA.80.8.a007" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" 