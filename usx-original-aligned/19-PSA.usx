	<para style="p"><verse number="6" style="v" x-ref="PSA.119.6" sid="PSA 119:6" /><char style="w" x-id="WLC.PSA.119.6.001" x-align="PSA.119.6.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֥ז</char> <char style="w" x-id="WLC.PSA.119.6.002" x-align="PSA.119.6.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.119.6.003" x-align="PSA.119.6.a003" x-target-ids="t002 t003 t005 t006 t007 t008" x-target="shall I be put to shame" x-target-head="t008" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi1cs" x-gloss="I.will.be.ashamed" x-translit="ʾēḇôš" xml:lang="hbo">אֵב֑וֹשׁ</char> <char style="w" x-id="WLC.PSA.119.6.004" x-align="PSA.119.6.a004" x-target-ids="t009" x-target="When" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ֝</char><char style="w" x-id="WLC.PSA.119.6.005" x-align="PSA.119.6.a005" x-target-ids="t011 t012" x-target="have respect" x-target-head="t012" x-head="true" lemma="נָבַט" strong="H5027" x-morph="Vhc" x-gloss="look" x-translit="habbiyṭ" xml:lang="hbo">הַבִּיטִ֗</char><char style="w" x-id="WLC.PSA.119.6.006" x-align="PSA.119.6.a006" x-target-ids="t010" x-target="I" x-target-head="t010" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="I" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.6.007" x-align="PSA.119.6.a007" x-target-ids="t013" x-target="unto" x-target-head="t013" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.PSA.119.6.008" x-align="PSA.119.6.a008" x-target-ids="t014" x-target="all" x-target-head="t014" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="a