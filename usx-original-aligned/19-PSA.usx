	<para style="p"><verse number="19" style="v" x-ref="PSA.51.19" sid="PSA 51:19" /><char style="w" x-id="WLC.PSA.51.19.001" x-align="PSA.51.19.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo" x-source-ref="PSA.51.21">אָ֤ז</char> <char style="w" x-id="WLC.PSA.51.19.002" x-align="PSA.51.19.a002" x-target-ids="t002 t003 t004 t005" x-target="wilt thou delight in" x-target-head="t004" x-head="true" lemma="חָפֵץ" strong="H2654" x-morph="Vqi2ms" x-gloss="you.will.delight.in" x-translit="taḥpōṣ" xml:lang="hbo" x-source-ref="PSA.51.21">תַּחְפֹּ֣ץ</char> <char style="w" x-id="WLC.PSA.51.19.003" x-align="PSA.51.19.a003" x-target-ids="t006 t007" x-target="the sacrifices" x-target-head="t007" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmpc" x-gloss="sacrifices" x-translit="ziḇḥê-" xml:lang="hbo" x-source-ref="PSA.51.21">זִבְחֵי</char>־<char style="w" x-id="WLC.PSA.51.19.004" x-align="PSA.51.19.a004" x-target-ids="t008 t009" x-target="of righteousness" x-target-head="t009" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="of.righteousness" x-translit="ṣeḏeq" xml:lang="hbo" x-source-ref="PSA.51.21">צֶ֭דֶק</char> <char style="w" x-id="WLC.PSA.51.19.005" x-align="PSA.51.19.a005" x-target-ids="t010 t011 t012" x-target="In burnt offering" x-target-head="t011" x-head="true" lemma="עֹלָה" strong="H5930" x-morph="Ncfsa" x-gloss="burnt.offering" x-translit="ʿôlāh" xml:lang="hbo" x-source-ref="PSA.51.21">עוֹלָ֣ה</char> <char style="w" x-id="WLC.PSA.51.19.006" x-align="PSA.51.19.a006" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.51.21">וְ</char><char style="w" x-id="WLC.PSA.51.19.007" x-align="PSA.51.19.a007" x-target-ids="t014 t015 t016" x-target="whole burnt offering" x-target-head="t014" x-head="true" lemma="כָּלִיל" strong="