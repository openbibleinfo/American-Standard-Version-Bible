	<para style="p"><verse number="4" style="v" x-ref="PSA.18.4" sid="PSA 18:4" /><char style="w" x-id="WLC.PSA.18.4.001" x-align="PSA.18.4.a001" x-target-ids="t005" x-target="compassed" x-target-head="t005" x-head="true" lemma="אָפַף" strong="H661" x-morph="Vqp3cp" x-gloss="they" x-translit="ʾăp̄āp̄û" xml:lang="hbo" x-source-ref="PSA.18.5">אֲפָפ֥וּ</char><char style="w" x-id="WLC.PSA.18.4.002" x-align="PSA.18.4.a002" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="encompassed.me" x-translit="niy" xml:lang="hbo" x-source-ref="PSA.18.5">נִי</char> <char style="w" x-id="WLC.PSA.18.4.003" x-align="PSA.18.4.a003" x-target-ids="t001 t002" x-target="The cords" x-target-head="t002" x-head="true" lemma="חֶבֶל" strong="H2256" x-morph="Ncbpc" x-gloss="cords" x-translit="ḥeḇlê-" xml:lang="hbo" x-source-ref="PSA.18.5">חֶבְלֵי</char>־<char style="w" x-id="WLC.PSA.18.4.004" x-align="PSA.18.4.a004" x-target-ids="t003 t004" x-target="of death" x-target-head="t004" x-head="true" lemma="מָוֶת" strong="H4194" x-morph="Ncmsa" x-gloss="of.death" x-translit="māweṯ" xml:lang="hbo" x-source-ref="PSA.18.5">מָ֑וֶת</char> <char style="w" x-id="WLC.PSA.18.4.005" x-align="PSA.18.4.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.18.5">וְֽ</char><char style="w" x-id="WLC.PSA.18.4.006" x-align="PSA.18.4.a006" x-target-ids="t008 t009" x-target="the floods" x-target-head="t009" x-head="true" lemma="נַחַל" strong="H5158" x-morph="Ncmpc" x-gloss="torrents" x-translit="naḥălēy" xml:lang="hbo" x-source-ref="PSA.18.5">נַחֲלֵ֖י</char> <char style="w" x-id="WLC.PSA.18.4.007" x-align="PSA.18.4.a007" x-target-ids="t010 t011" x-target="of ungodliness" x-target-head="t011" x-head="true" lemma="בְּלִיַּעַל" strong="H1100" x-morph="Ncmsa" x-gloss="of.worthlessness" x-translit="ḇəliyyaʿal" xml:lang="hbo" x-source-r