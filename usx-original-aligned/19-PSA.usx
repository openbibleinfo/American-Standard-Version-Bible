	<para style="p"><verse number="6" style="v" x-ref="PSA.94.6" sid="PSA 94:6" /><char style="w" x-id="WLC.PSA.94.6.001" x-align="PSA.94.6.a002" x-target-ids="t003 t004" x-target="the widow" x-target-head="t004" x-head="true" lemma="אַלְמָנָה" strong="H490" x-morph="Ncfsa" x-gloss="[the].widow" x-translit="ʾalmānâ" xml:lang="hbo">אַ֭לְמָנָה</char> <char style="w" x-id="WLC.PSA.94.6.002" x-align="PSA.94.6.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.94.6.003" x-align="PSA.94.6.a004" x-target-ids="t006 t007" x-target="the sojourner" x-target-head="t007" x-head="true" lemma="גֵּר" strong="H1616" x-morph="Ncmsa" x-gloss="sojourner" x-translit="ḡēr" xml:lang="hbo">גֵ֣ר</char> <char style="w" x-id="WLC.PSA.94.6.004" x-align="PSA.94.6.a001" x-target-ids="t001 t002" x-target="They slay" x-target-head="t002" x-head="true" lemma="הָרַג" strong="H2026" x-morph="Vqi3mp" x-gloss="they.kill" x-translit="yahărōḡû" xml:lang="hbo">יַהֲרֹ֑גוּ</char> <char style="w" x-id="WLC.PSA.94.6.005" x-align="PSA.94.6.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִֽ</char><char style="w" x-id="WLC.PSA.94.6.006" x-align="PSA.94.6.a007" x-target-ids="t010 t011" x-target="the fatherless" x-target-head="t011" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmpa" x-gloss="fatherless.ones" x-translit="yṯômiym" xml:lang="hbo">יתוֹמִ֣ים</char> <char style="w" x-id="WLC.PSA.94.6.007" x-align="PSA.94.6.a006" x-target-ids="t009" x-target="murder" x-target-head="t009" x-head="true" lemma="רָצַח" strong="H7523" x-morph="Vpi3mp" x-gloss="they.murder" x-translit="yəraṣṣēḥû:" xml:lang="hbo">יְרַצֵּֽחוּ</char>׃<verse eid="PSA 94:6" /></para>
	<para style="p"><verse number="7" style="v" x-ref="PSA.94.7" sid="PSA 94:7" /><char style="w" x-id="WLC.PSA.94.7.001" x-align="PSA.94.7.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֭</char><char style="w" x-id="WLC.PSA.94.7.002" x-align="PSA.94.7.a002" x-target-ids="t002 t003" x-target="they say" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3mp" x-gloss="they.said" x-translit="yyōʾmərû" xml:lang="hbo">יֹּ֣אמְרוּ</char> <char style="w" x-id="WLC.PSA.94.7.003" x-align="PSA.94.7.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PSA.94.7.004" x-align="PSA.94.7.a005" x-target-ids="t005 t007" x-target="will see" x-target-head="t007" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi3ms" x-gloss="he.will.see" x-translit="yirʾeh-" xml:lang="hbo">יִרְאֶה</char>־<char style="w" x-id="WLC.PSA.94.7.005" x-align="PSA.94.7.a003" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יָהּ" strong="H3050" x-morph="Np" x-gloss="Yahweh" x-translit="yyāẖ" xml:lang="hbo">יָּ֑הּ</char> <char style="w" x-id="WLC.PSA.94.7.006" x-align="PSA.94.7.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.94.7.007" x-align="PSA.94.7.a006" x-target-ids="t008" x-target="Neither" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.94.7.008" x-align="PSA.94.7.a007" x-target-ids="t009 t014" x-target="will consider" x-target-head="t014" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi3ms" x-gloss="he.will.perceive" x-translit="yāḇiyn" xml:lang="hbo">יָ֝בִ֗ין</char> <char style="w" x-id="WLC