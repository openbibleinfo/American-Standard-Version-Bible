	<para style="p"><verse number="2" style="v" x-ref="PSA.101.2" sid="PSA 101:2" /><char style="w" x-id="WLC.PSA.101.2.001" x-align="PSA.101.2.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="I will behave myself wisely" x-target-head="t005" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vhh1cs" x-gloss="I.will.give.attention" x-translit="ʾaśkiylāh" xml:lang="hbo">אַשְׂכִּ֤ילָה</char>׀<char style="w" x-id="WLC.PSA.101.2.002" x-align="PSA.101.2.a002" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="to" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.101.2.003" x-align="PSA.101.2.a003" x-target-ids="t007 t009" x-target="a way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="a.way" x-translit="ḏereḵ" xml:lang="hbo">דֶ֬רֶךְ</char> <char style="w" x-id="WLC.PSA.101.2.004" x-align="PSA.101.2.a004" x-target-ids="t008" x-target="perfect" x-target-head="t008" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aamsa" x-gloss="blameless" x-translit="tāmiym" xml:lang="hbo">תָּמִ֗ים</char> <char style="w" x-id="WLC.PSA.101.2.005" x-align="PSA.101.2.a005" x-target-ids="t010 t011" x-target="Oh when" x-target-head="t011" x-head="true" lemma="מָתַי" strong="H4970" x-morph="Ti" x-gloss="when?" x-translit="māṯay" xml:lang="hbo">מָ֭תַי</char> <char style="w" x-id="WLC.PSA.101.2.006" x-align="PSA.101.2.a006" x-target-ids="t012 t013 t014" x-target="wilt thou come" x-target-head="t014" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi2ms" x-gloss="will.you.come" x-translit="tāḇôʾ" xml:lang="hbo">תָּב֣וֹא</char> <char style="w" x-id="WLC.PSA.101.2.007" x-align="PSA.101.2.a007" x-target-ids="t015" x-target="unto" x-target-head="t015" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלָ֑</char><char style="w" x-id="WLC.PSA.101.2.008" x-align="PSA.101.2.a008" x-target-ids="t016" x-target="me" x