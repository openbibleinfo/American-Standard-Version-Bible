	<para style="p"><verse number="1" style="v" x-ref="PSA.149.1" x-added-alignments="PSA.149.1.a008" x-added-target-ids="t010" x-added-target="And" sid="PSA 149:1" /><char style="w" x-id="WLC.PSA.149.1.001" x-align="PSA.149.1.a001" x-target-ids="t001 t002" x-target="Praise ye" x-target-head="t001" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpv2mp" x-gloss="praise" x-translit="haləlû" xml:lang="hbo">הַ֥לְלוּ</char> <char style="w" x-id="WLC.PSA.149.1.002" x-align="PSA.149.1.a002" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יָהּ" strong="H3050" x-morph="Np" x-gloss="Yahweh" x-translit="yāhh" xml:lang="hbo">יָ֨הּ</char>׀<char style="w" x-id="WLC.PSA.149.1.003" x-align="PSA.149.1.a003" x-target-ids="t004" x-target="Sing" x-target-head="t004" x-head="true" lemma="שִׁיר" strong="H7891" x-morph="Vqv2mp" x-gloss="sing" x-translit="šiyrû" xml:lang="hbo">שִׁ֣ירוּ</char> <char style="w" x-id="WLC.PSA.149.1.004" x-align="PSA.149.1.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַֽ֭</char><char style="w" x-id="WLC.PSA.149.1.005" x-align="PSA.149.1.a005" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwâ" xml:lang="hbo">יהוָה</char> <char style="w" x-id="WLC.PSA.149.1.006" x-align="PSA.149.1.a006" x-target-ids="t007 t009" x-target="a song" x-target-head="t009" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsa" x-gloss="a.song" x-translit="šiyr" xml:lang="hbo">שִׁ֣יר</char> <char style="w" x-id="WLC.PSA.149.1.007" x-align="PSA.149.1.a007" x-target-ids="t008" x-target="new" x-target-head="t008" x-head="true" lemma="חָדָשׁ" strong="H2319" x-morph="Aamsa" x-gloss="new" x-translit="ḥāḏāš" xml:lang="hbo">חָדָ֑שׁ</char> <char style="w" x-id="WLC.PSA.149.1.008" x-align="PSA.149.1.a009" x-target-ids="t012" x-target="praise" x-tar