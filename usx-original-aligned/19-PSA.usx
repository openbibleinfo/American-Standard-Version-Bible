	<para style="p"><verse number="21" style="v" x-ref="PSA.119.21" sid="PSA 119:21" /><char style="w" x-id="WLC.PSA.119.21.001" x-align="PSA.119.21.a001" x-target-ids="t001 t002 t003" x-target="Thou hast rebuked" x-target-head="t003" x-head="true" lemma="גָּעַר" strong="H1605" x-morph="Vqp2ms" x-gloss="you.rebuke" x-translit="gāʿartā" xml:lang="hbo">גָּ֭עַרְתָּ</char> <char style="w" x-id="WLC.PSA.119.21.002" x-align="PSA.119.21.a002" x-target-ids="t004 t005" x-target="the proud" x-target-head="t005" x-head="true" lemma="זֵד" strong="H2086" x-morph="Aampa" x-gloss="arrogant.[people]" x-translit="zēḏiym" xml:lang="hbo">זֵדִ֣ים</char> <char style="w" x-id="WLC.PSA.119.21.003" x-align="PSA.119.21.a003" x-target-ids="t006 t007 t008" x-target="that are cursed" x-target-head="t008" x-head="true" lemma="אָרַר" strong="H779" x-morph="Vqsmpa" x-gloss="cursed.[people]" x-translit="ʾărûriym" xml:lang="hbo">אֲרוּרִ֑ים</char> <char style="w" x-id="WLC.PSA.119.21.004" x-align="PSA.119.21.a004" x-target-ids="t009" x-target="That" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[who].go" x-translit="ha" xml:lang="hbo">הַ֝</char><char style="w" x-id="WLC.PSA.119.21.005" x-align="PSA.119.21.a005" x-target-ids="t010 t011" x-target="do wander" x-target-head="t011" x-head="true" lemma="שָׁגָה" strong="H7686" x-morph="Vqrmpa" x-gloss="astray" x-translit="ššōḡîm" xml:lang="hbo">שֹּׁגִים</char> <char style="w" x-id="WLC.PSA.119.21.006" x-align="PSA.119.21.a006" x-target-ids="t012" x-target="from" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.119.21.007" x-align="PSA.119.21.a007" x-target-ids="t014" x-target="commandments" x-target-head="t014" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfpc" x-gloss="commandments" x-translit="mmiṣôṯey" xml:lang="hbo">מִּצְוֺתֶֽי</char><char style="w" x-id="WLC.PSA.119.21.008" x-align="PSA.119.21.a008"