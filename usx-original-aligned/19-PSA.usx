	<para style="p"><verse number="77" style="v" x-ref="PSA.119.77" sid="PSA 119:77" /><char style="w" x-id="WLC.PSA.119.77.001" x-align="PSA.119.77.a001" x-target-ids="t001 t005" x-target="Let come" x-target-head="t005" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3mp" x-gloss="let" x-translit="yəḇōʾû" xml:lang="hbo">יְבֹא֣וּ</char><char style="w" x-id="WLC.PSA.119.77.002" x-align="PSA.119.77.a002" x-target-ids="t006 t007" x-target="unto me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="them.come.to.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.77.003" x-align="PSA.119.77.a003" x-target-ids="t003 t004" x-target="tender mercies" x-target-head="t004" x-head="true" lemma="רַחֲמִים" strong="H7356" x-morph="Ncmpc" x-gloss="compassion(s)" x-translit="raḥămey" xml:lang="hbo">רַחֲמֶ֣י</char><char style="w" x-id="WLC.PSA.119.77.004" x-align="PSA.119.77.a004" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.77.005" x-align="PSA.119.77.a005" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="so" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.119.77.006" x-align="PSA.119.77.a006" x-target-ids="t009 t010 t011" x-target="I may live" x-target-head="t011" x-head="true" lemma="חָיָה" strong="H2421" x-morph="Vqi1cs" x-gloss="that.I.may.live" x-translit="ʾeḥəyeh" xml:lang="hbo">אֶֽחְיֶ֑ה</char> <char style="w" x-id="WLC.PSA.119.77.007" x-align="PSA.119.77.a007" x-target-ids="t012" x-target="For" x-target-head="t012" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.119.77.008" x-align="PSA.119.77.a008" x-target-ids="t014" x-target="law" x-target-head="t014" x-head="tr