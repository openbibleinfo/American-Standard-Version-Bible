	<para style="p"><verse number="3" style="v" x-ref="PSA.14.3" sid="PSA 14:3" /><char style="w" x-id="WLC.PSA.14.3.001" x-align="PSA.14.3.a001" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PSA.14.3.002" x-align="PSA.14.3.a002" x-target-ids="t001 t003" x-target="They all" x-target-head="t003" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="everyone" x-translit="kōl" xml:lang="hbo">כֹּ֥ל</char> <char style="w" x-id="WLC.PSA.14.3.003" x-align="PSA.14.3.a003" x-target-ids="t002 t004 t005" x-target="are gone aside" x-target-head="t004" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vqp3ms" x-gloss="he.turns.aside" x-translit="sār" xml:lang="hbo">סָר֮</char> <char style="w" x-id="WLC.PSA.14.3.004" x-align="PSA.14.3.a004" x-target-ids="t008" x-target="together" x-target-head="t008" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="all.together" x-translit="yaḥdāw" xml:lang="hbo">יַחְדָּ֪ו</char> <char style="w" x-id="WLC.PSA.14.3.005" x-align="PSA.14.3.a005" x-target-ids="t006 t007 t009 t010" x-target="they are become filthy" x-target-head="t010" x-head="true" lemma="אָלַח" strong="H444" x-morph="VNp3cp" x-gloss="they.are.corrupt" x-translit="neʾĕlāḥû" xml:lang="hbo">נֶ֫אֱלָ֥חוּ</char> <char style="w" x-id="WLC.PSA.14.3.006" x-align="PSA.14.3.a006" x-target-ids="t011 t012 t013" x-target="There is none" x-target-head="t013" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֤ין</char> <char style="w" x-id="WLC.PSA.14.3.007" x-align="PSA.14.3.a007" x-target-ids="t014 t015" x-target="that doeth" x-target-head="t015" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[one.who].does" x-translit="ʿōśēh-" xml:lang="hbo">עֹֽשֵׂה</char>־<char style="w" x-id="WLC.PSA.14.3.008" x-align="PSA.14.3.a008" x-target-ids="t016" x-target="good" x-target-hea