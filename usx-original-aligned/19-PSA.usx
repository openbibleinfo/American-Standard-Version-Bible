	<para style="p"><verse number="3" style="v" x-ref="PSA.60.3" sid="PSA 60:3" /><char style="w" x-id="WLC.PSA.60.3.001" x-align="PSA.60.3.a001" x-target-ids="t001 t002 t003" x-target="Thou hast showed" x-target-head="t003" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vhp2ms" x-gloss="you.have.made.see" x-translit="hirʾiyṯâ" xml:lang="hbo" x-source-ref="PSA.60.5">הִרְאִ֣יתָה</char> <char style="w" x-id="WLC.PSA.60.3.002" x-align="PSA.60.3.a003" x-target-ids="t005" x-target="people" x-target-head="t005" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="PSA.60.5">עַמְּ</char><char style="w" x-id="WLC.PSA.60.3.003" x-align="PSA.60.3.a002" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.60.5">ךָ֣</char> <char style="w" x-id="WLC.PSA.60.3.004" x-align="PSA.60.3.a004" x-target-ids="t006 t007" x-target="hard things" x-target-head="t006" x-head="true" lemma="קָשֶׁה" strong="H7186" x-morph="Aafsa" x-gloss="a.hard.[thing]" x-translit="qāšāh" xml:lang="hbo" x-source-ref="PSA.60.5">קָשָׁ֑ה</char> <char style="w" x-id="WLC.PSA.60.3.005" x-align="PSA.60.3.a005" x-target-ids="t008 t009 t010 t012 t013" x-target="Thou hast made to drink" x-target-head="t013" x-head="true" lemma="שָׁקָה" strong="H8248" x-morph="Vhp2ms" x-gloss="you" x-translit="hišqiyṯā" xml:lang="hbo" x-source-ref="PSA.60.5">הִ֝שְׁקִיתָ֗</char><char style="w" x-id="WLC.PSA.60.3.006" x-align="PSA.60.3.a006" x-target-ids="t011" x-target="us" x-target-head="t011" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="have.made.us.drink" x-translit="nû" xml:lang="hbo" x-source-ref="PSA.60.5">נוּ</char> <char style="w" x-id="WLC.PSA.60.3.007" x-align="PSA.60.3.a007" x-target-ids="t014 t015" x-target="the wine" x-target-head="t015" x-head="true" lemma="יַיִן" strong="H3196" x-morph="Ncmsa" x-gloss="wine" 