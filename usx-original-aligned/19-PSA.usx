	<para style="p"><verse number="3" style="v" x-ref="PSA.48.3" sid="PSA 48:3" /><char style="w" x-id="WLC.PSA.48.3.001" x-align="PSA.48.3.a001" x-target-ids="t001" x-target="God" x-target-head="t001" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.48.4">אֱלֹהִ֥ים</char> <char style="w" x-id="WLC.PSA.48.3.002" x-align="PSA.48.3.a002" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.48.4">בְּ</char><char style="w" x-id="WLC.PSA.48.3.003" x-align="PSA.48.3.a003" x-target-ids="t008" x-target="palaces" x-target-head="t008" x-head="true" lemma="אַרְמוֹן" strong="H759" x-morph="Ncmpc" x-gloss="fortresses" x-translit="ʾarmənôṯey" xml:lang="hbo" x-source-ref="PSA.48.4">אַרְמְנוֹתֶ֗י</char><char style="w" x-id="WLC.PSA.48.3.004" x-align="PSA.48.3.a004" x-target-ids="t007" x-target="her" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.48.4">הָ</char> <char style="w" x-id="WLC.PSA.48.3.005" x-align="PSA.48.3.a005" x-target-ids="t002 t003 t004 t005" x-target="hath made himself known" x-target-head="t005" x-head="true" lemma="יָדַע" strong="H3045" x-morph="VNp3ms" x-gloss="he.has.made.himself.known" x-translit="nôḏaʿ" xml:lang="hbo" x-source-ref="PSA.48.4">נוֹדַ֥ע</char> <char style="w" x-id="WLC.PSA.48.3.006" x-align="PSA.48.3.a006" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.48.4">לְ</char><char style="w" x-id="WLC.PSA.48.3.007" x-align="PSA.48.3.a007" x-target-ids="t010 t011" x-target="a refuge" x-target-head="t011" x-head="true" lemma="מִשְׂגָּב" strong="H4869" x-morph="Ncmsa" x-gloss="a.refuge" x-translit="miśgāḇ:" xml:lang="hbo" x-source-ref="PSA.48.4">