	<para style="p"><verse number="12" style="v" x-ref="PSA.77.12" sid="PSA 77:12" /><char style="w" x-id="WLC.PSA.77.12.001" x-align="PSA.77.12.a001" x-target-ids="t004" x-target="also" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.77.13">וְ</char><char style="w" x-id="WLC.PSA.77.12.002" x-align="PSA.77.12.a002" x-target-ids="t001 t002 t003" x-target="I will meditate" x-target-head="t003" x-head="true" lemma="הָגָה" strong="H1897" x-morph="Vqq1cs" x-gloss="I.will.meditate" x-translit="hāḡiyṯî" xml:lang="hbo" x-source-ref="PSA.77.13">הָגִ֥יתִי</char> <char style="w" x-id="WLC.PSA.77.12.003" x-align="PSA.77.12.a003" x-target-ids="t005" x-target="upon" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.77.13">בְ</char><char style="w" x-id="WLC.PSA.77.12.004" x-align="PSA.77.12.a004" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo" x-source-ref="PSA.77.13">כָל</char>־<char style="w" x-id="WLC.PSA.77.12.005" x-align="PSA.77.12.a005" x-target-ids="t008" x-target="work" x-target-head="t008" x-head="true" lemma="פֹּעַל" strong="H6467" x-morph="Ncmsc" x-gloss="work" x-translit="pāʿŏl" xml:lang="hbo" x-source-ref="PSA.77.13">פָּעֳלֶ֑</char><char style="w" x-id="WLC.PSA.77.12.006" x-align="PSA.77.12.a006" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="PSA.77.13">ךָ</char> <char style="w" x-id="WLC.PSA.77.12.007" x-align="PSA.77.12.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.77.13">וּֽ</char><char style="w" x-id="WLC.PSA.77.12.008" x-align=