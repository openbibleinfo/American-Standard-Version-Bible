	<para style="p"><verse number="4" style="v" x-ref="PSA.79.4" sid="PSA 79:4" /><char style="w" x-id="WLC.PSA.79.4.001" x-align="PSA.79.4.a001" x-target-ids="t001 t002 t003" x-target="We are become" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cp" x-gloss="we.have.become" x-translit="hāyiynû" xml:lang="hbo">הָיִ֣ינוּ</char> <char style="w" x-id="WLC.PSA.79.4.002" x-align="PSA.79.4.a002" x-target-ids="t004 t005" x-target="a reproach" x-target-head="t005" x-head="true" lemma="חֶרְפָּה" strong="H2781" x-morph="Ncfsa" x-gloss="a.reproach" x-translit="ḥerpâ" xml:lang="hbo">חֶ֭רְפָּה</char> <char style="w" x-id="WLC.PSA.79.4.003" x-align="PSA.79.4.a003" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.79.4.004" x-align="PSA.79.4.a005" x-target-ids="t008" x-target="neighbors" x-target-head="t008" x-head="true" lemma="שָׁכֵן" strong="H7934" x-morph="Aampc" x-gloss="neighbors" x-translit="šəḵēnēy" xml:lang="hbo">שְׁכֵנֵ֑י</char><char style="w" x-id="WLC.PSA.79.4.005" x-align="PSA.79.4.a004" x-target-ids="t007" x-target="our" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.PSA.79.4.006" x-align="PSA.79.4.a006" x-target-ids="t009 t010" x-target="A scoffing" x-target-head="t010" x-head="true" lemma="לַעַג" strong="H3933" x-morph="Ncmsa" x-gloss="mockery" x-translit="laʿaḡ" xml:lang="hbo">לַ֥עַג</char> <char style="w" x-id="WLC.PSA.79.4.007" x-align="PSA.79.4.a007" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ֝</char><char style="w" x-id="WLC.PSA.79.4.008" x-align="PSA.79.4.a008" x-target-ids="t012" x-target="derision" x-target-head="t012" x-head="true" lemma="קֶלֶס" strong="H7047" x-morp