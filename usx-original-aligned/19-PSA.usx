	<para style="p"><verse number="2" style="v" x-ref="PSA.102.2" sid="PSA 102:2" /><char style="w" x-id="WLC.PSA.102.2.001" x-align="PSA.102.2.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.102.3">אַל</char>־<char style="w" x-id="WLC.PSA.102.2.002" x-align="PSA.102.2.a002" x-target-ids="t001" x-target="Hide" x-target-head="t001" x-head="true" lemma="סָתַר" strong="H5641" x-morph="Vhj2ms" x-gloss="hide" x-translit="tastēr" xml:lang="hbo" x-source-ref="PSA.102.3">תַּסְתֵּ֬ר</char> <char style="w" x-id="WLC.PSA.102.2.003" x-align="PSA.102.2.a003" x-target-ids="t004" x-target="face" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="face" x-translit="pāney" xml:lang="hbo" x-source-ref="PSA.102.3">פָּנֶ֨י</char><char style="w" x-id="WLC.PSA.102.2.004" x-align="PSA.102.2.a004" x-target-ids="t003" x-target="thy" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.102.3">ךָ</char>׀<char style="w" x-id="WLC.PSA.102.2.005" x-align="PSA.102.2.a005" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" xml:lang="hbo" x-source-ref="PSA.102.3">מִמֶּ</char><char style="w" x-id="WLC.PSA.102.2.006" x-align="PSA.102.2.a006" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="enniy" xml:lang="hbo" x-source-ref="PSA.102.3">נִּי֮</char> <char style="w" x-id="WLC.PSA.102.2.007" x-align="PSA.102.2.a007" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on.[the]" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.102.3">בְּ</char><char style="w" x-id="WLC.PSA.102.2.008" x-align="PSA.102.2.a008