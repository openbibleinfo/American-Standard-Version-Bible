	<para style="p"><verse number="1" style="v" x-ref="PSA.108.1" sid="PSA 108:1" /><char style="w" x-id="WLC.PSA.108.1.001" x-align="PSA.108.1.a003" x-target-ids="t003 t004" x-target="is fixed" x-target-head="t004" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNrmsa" x-gloss="[is].steadfast" x-translit="nāḵôn" xml:lang="hbo" x-source-ref="PSA.108.2">נָכ֣וֹן</char> <char style="w" x-id="WLC.PSA.108.1.002" x-align="PSA.108.1.a002" x-target-ids="t002" x-target="heart" x-target-head="t002" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo" x-source-ref="PSA.108.2">לִבִּ֣</char><char style="w" x-id="WLC.PSA.108.1.003" x-align="PSA.108.1.a001" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.108.2">י</char> <char style="w" x-id="WLC.PSA.108.1.004" x-align="PSA.108.1.a004" x-target-ids="t005 t006" x-target="O God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.108.2">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.108.1.005" x-align="PSA.108.1.a005" x-target-ids="t007 t008 t009" x-target="I will sing" x-target-head="t009" x-head="true" lemma="שִׁיר" strong="H7891" x-morph="Vqh1cs" x-gloss="I.will.sing" x-translit="ʾāšiyrâ" xml:lang="hbo" x-source-ref="PSA.108.2">אָשִׁ֥ירָה</char> <char style="w" x-id="WLC.PSA.108.1.006" x-align="PSA.108.1.a006" x-target-ids="t010" x-target="yea" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.108.2">וַ֝</char><char style="w" x-id="WLC.PSA.108.1.007" x-align="PSA.108.1.a007" x-target-ids="t011 t012 t013 t014" x-target="I will sing praises" x-target-head="t014" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vph1cs" x-gloss="I.will.sing.praises" x-translit="ʾăzamm