	<para style="p"><verse number="4" style="v" x-ref="PSA.77.4" sid="PSA 77:4" /><char style="w" x-id="WLC.PSA.77.4.001" x-align="PSA.77.4.a001" x-target-ids="t001 t002" x-target="Thou holdest" x-target-head="t002" x-head="true" lemma="אָחַז" strong="H270" x-morph="Vqp2ms" x-gloss="you.held" x-translit="ʾāḥaztā" xml:lang="hbo" x-source-ref="PSA.77.5">אָ֭חַזְתָּ</char> <char style="w" x-id="WLC.PSA.77.4.002" x-align="PSA.77.4.a002" x-target-ids="t005" x-target="watching" x-target-head="t005" x-head="true" lemma="שְׁמֻרָה" strong="H8109" x-morph="Ncfpc" x-gloss="the.eyelids" x-translit="šəmurôṯ" xml:lang="hbo" x-source-ref="PSA.77.5">שְׁמֻר֣וֹת</char> <char style="w" x-id="WLC.PSA.77.4.003" x-align="PSA.77.4.a003" x-target-ids="t004" x-target="eyes" x-target-head="t004" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="my.eyes" x-translit="ʿēyn" xml:lang="hbo" x-source-ref="PSA.77.5">עֵינָ֑</char><char style="w" x-id="WLC.PSA.77.4.004" x-align="PSA.77.4.a004" x-target-ids="t003" x-target="mine" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.77.5">י</char> <char style="w" x-id="WLC.PSA.77.4.005" x-align="PSA.77.4.a005" x-target-ids="t006 t007 t009" x-target="I am troubled" x-target-head="t009" x-head="true" lemma="פָּעַם" strong="H6470" x-morph="VNp1cs" x-gloss="I.was.troubled" x-translit="nip̄ʿamətî" xml:lang="hbo" x-source-ref="PSA.77.5">נִ֝פְעַ֗מְתִּי</char> <char style="w" x-id="WLC.PSA.77.4.006" x-align="PSA.77.4.a006" x-target-ids="t008 t010" x-target="so that" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.77.5">וְ</char><char style="w" x-id="WLC.PSA.77.4.007" x-align="PSA.77.4.a007" x-target-ids="t012" x-target="cannot" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.77.5">ל