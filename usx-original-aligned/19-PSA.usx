	<para style="p"><verse number="18" style="v" x-ref="PSA.102.18" sid="PSA 102:18" /><char style="w" x-id="WLC.PSA.102.18.001" x-align="PSA.102.18.a001" x-target-ids="t002 t003 t004" x-target="shall be written" x-target-head="t004" x-head="true" lemma="כָּתַב" strong="H3789" x-morph="VNi3fs" x-gloss="let.it.be.written" x-translit="tikkāṯeḇ" xml:lang="hbo" x-source-ref="PSA.102.19">תִּכָּ֣תֶב</char> <char style="w" x-id="WLC.PSA.102.18.002" x-align="PSA.102.18.a002" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo" x-source-ref="PSA.102.19">זֹ֭את</char> <char style="w" x-id="WLC.PSA.102.18.003" x-align="PSA.102.18.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.102.19">לְ</char><char style="w" x-id="WLC.PSA.102.18.004" x-align="PSA.102.18.a004" x-target-ids="t006 t007" x-target="the generation" x-target-head="t007" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsa" x-gloss="a.generation" x-translit="ḏôr" xml:lang="hbo" x-source-ref="PSA.102.19">ד֣וֹר</char> <char style="w" x-id="WLC.PSA.102.18.005" x-align="PSA.102.18.a005" x-target-ids="t008 t009" x-target="to come" x-target-head="t009" x-head="true" lemma="אַחֲרוֹן" strong="H314" x-morph="Aamsa" x-gloss="later" x-translit="ʾaḥărôn" xml:lang="hbo" x-source-ref="PSA.102.19">אַחֲר֑וֹן</char> <char style="w" x-id="WLC.PSA.102.18.006" x-align="PSA.102.18.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.102.19">וְ</char><char style="w" x-id="WLC.PSA.102.18.007" x-align="PSA.102.18.a007" x-target-ids="t011 t012" x-target="a people" x-target-head="t012" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿam" xml:la