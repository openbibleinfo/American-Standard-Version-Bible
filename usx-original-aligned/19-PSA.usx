	<para style="p"><verse number="7" style="v" x-ref="PSA.132.7" sid="PSA 132:7" /><char style="w" x-id="WLC.PSA.132.7.001" x-align="PSA.132.7.a001" x-target-ids="t001 t002 t003" x-target="We will go" x-target-head="t003" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqh1cp" x-gloss="let.us.go" x-translit="nāḇôʾâ" xml:lang="hbo">נָב֥וֹאָה</char> <char style="w" x-id="WLC.PSA.132.7.002" x-align="PSA.132.7.a002" x-target-ids="t004" x-target="into" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.132.7.003" x-align="PSA.132.7.a003" x-target-ids="t006" x-target="tabernacles" x-target-head="t006" x-head="true" lemma="מִשְׁכָּן" strong="H4908" x-morph="Ncmpc" x-gloss="his.dwelling" x-translit="miškənôṯāy" xml:lang="hbo">מִשְׁכְּנוֹתָ֑י</char><char style="w" x-id="WLC.PSA.132.7.004" x-align="PSA.132.7.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="place(s)" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.132.7.005" x-align="PSA.132.7.a005" x-target-ids="t007 t008 t009" x-target="We will worship" x-target-head="t009" x-head="true" lemma="חוה" strong="H7812a" x-morph="Vvh1cp" x-gloss="let.us.bow.down" x-translit="ništaḥăweh" xml:lang="hbo">נִ֝שְׁתַּחֲוֶ֗ה</char> <char style="w" x-id="WLC.PSA.132.7.006" x-align="PSA.132.7.a006" x-target-ids="t010" x-target="at" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.132.7.007" x-align="PSA.132.7.a007" x-target-ids="t012" x-target="footstool" x-target-head="t012" x-head="true" lemma="הֲדֹם" strong="H1916" x-morph="Ncmsc" x-gloss="the.footstool" x-translit="hăḏōm" xml:lang="hbo">הֲדֹ֥ם</char> <char style="w" x-id="WLC.PSA.132.7.008" x-align="PSA.132.7.a007" lemma="רֶגֶל" strong="H7272" x-morph="Ncfdc" x-gloss="his.fee