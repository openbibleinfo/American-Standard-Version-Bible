	<para style="p"><verse number="12" style="v" x-ref="PSA.80.12" sid="PSA 80:12" /><char style="w" x-id="WLC.PSA.80.12.001" x-align="PSA.80.12.a001" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.80.13">לָ֭</char><char style="w" x-id="WLC.PSA.80.12.002" x-align="PSA.80.12.a001" x-target-ids="t001" x-target="Why" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ" xml:lang="hbo" x-source-ref="PSA.80.13">מָּה</char> <char style="w" x-id="WLC.PSA.80.12.003" x-align="PSA.80.12.a002" x-target-ids="t002 t003 t004 t005" x-target="hast thou broken down" x-target-head="t004" x-head="true" lemma="פָּרַץ" strong="H6555" x-morph="Vqp2ms" x-gloss="have.you.broken.down" x-translit="pāraṣətā" xml:lang="hbo" x-source-ref="PSA.80.13">פָּרַ֣צְתָּ</char> <char style="w" x-id="WLC.PSA.80.12.004" x-align="PSA.80.12.a003" x-target-ids="t007" x-target="walls" x-target-head="t007" x-head="true" lemma="גָּדֵר" strong="H1447" x-morph="Ncmpc" x-gloss="walls" x-translit="ḡəḏērey" xml:lang="hbo" x-source-ref="PSA.80.13">גְדֵרֶ֑י</char><char style="w" x-id="WLC.PSA.80.12.005" x-align="PSA.80.12.a004" x-target-ids="t006" x-target="its" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.80.13">הָ</char> <char style="w" x-id="WLC.PSA.80.12.006" x-align="PSA.80.12.a005" x-target-ids="t008 t009" x-target="So that" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.80.13">וְ֝</char><char style="w" x-id="WLC.PSA.80.12.007" x-align="PSA.80.12.a006" x-target-ids="t017 t018" x-target="do pluck" x-target-head="t018" x-head="true" lemma="אָרָה" strong="H717" x-morph="Vqq3cp" x-gloss="they" x-translit="ʾārû" xml:lang="hbo" x-source-ref="PSA.80.13">אָר֗וּ</char><char style="w" x-id="WLC.PSA.80.12.008" x-align="PSA.80.12.a007" x-target-ids