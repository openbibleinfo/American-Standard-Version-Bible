	<para style="p"><verse number="2" style="v" x-ref="PSA.137.2" sid="PSA 137:2" /><char style="w" x-id="WLC.PSA.137.2.001" x-align="PSA.137.2.a001" x-target-ids="t001" x-target="Upon" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַֽל</char>־<char style="w" x-id="WLC.PSA.137.2.002" x-align="PSA.137.2.a002" x-target-ids="t002 t003" x-target="the willows" x-target-head="t003" x-head="true" lemma="עֲרָבָה" strong="H6155" x-morph="Ncfpa" x-gloss="poplars" x-translit="ʿărāḇiym" xml:lang="hbo">עֲרָבִ֥ים</char> <char style="w" x-id="WLC.PSA.137.2.003" x-align="PSA.137.2.a003" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.137.2.004" x-align="PSA.137.2.a004" x-target-ids="t005 t006" x-target="the midst" x-target-head="t006" x-head="true" lemma="תָּוֶךְ" strong="H8432" x-morph="Ncmsc" x-gloss="the.midst" x-translit="ṯôḵ" xml:lang="hbo">תוֹכָ֑</char><char style="w" x-id="WLC.PSA.137.2.005" x-align="PSA.137.2.a005" x-target-ids="t007" x-target="thereof" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="of.it" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PSA.137.2.006" x-align="PSA.137.2.a006" x-target-ids="t008 t009 t010" x-target="We hanged up" x-target-head="t009" x-head="true" lemma="תָּלָה" strong="H8518" x-morph="Vqp1cp" x-gloss="we.hung.up" x-translit="tāliynû" xml:lang="hbo">תָּ֝לִ֗ינוּ</char> <char style="w" x-id="WLC.PSA.137.2.007" x-align="PSA.137.2.a007" x-target-ids="t012" x-target="harps" x-target-head="t012" x-head="true" lemma="כִּנּוֹר" strong="H3658" x-morph="Ncmpc" x-gloss="harps" x-translit="kinnōrôṯēy" xml:lang="hbo">כִּנֹּרוֹתֵֽי</char><char style="w" x-id="WLC.PSA.137.2.008" x-align="PSA.137.2.a008" x-target-ids="t011" x-target="our" x-target-head="t011" x-head="true" lemma="הוּא"