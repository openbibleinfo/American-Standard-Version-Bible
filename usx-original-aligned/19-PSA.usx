	<para style="p"><verse number="16" style="v" x-ref="PSA.44.16" sid="PSA 44:16" /><char style="w" x-id="WLC.PSA.44.16.001" x-align="PSA.44.16.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.44.17">מִ֭</char><char style="w" x-id="WLC.PSA.44.16.002" x-align="PSA.44.16.a002" x-target-ids="t002 t003" x-target="the voice" x-target-head="t003" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="the.sound" x-translit="qqôl" xml:lang="hbo" x-source-ref="PSA.44.17">קּוֹל</char> <char style="w" x-id="WLC.PSA.44.16.003" x-align="PSA.44.16.a003" x-target-ids="t004 t005 t006 t007" x-target="of him that reproacheth" x-target-head="t007" x-head="true" lemma="חָרַף" strong="H2778" x-morph="Vprmsa" x-gloss="of.[one.who].taunts" x-translit="məḥārēp̄" xml:lang="hbo" x-source-ref="PSA.44.17">מְחָרֵ֣ף</char> <char style="w" x-id="WLC.PSA.44.16.004" x-align="PSA.44.16.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.44.17">וּ</char><char style="w" x-id="WLC.PSA.44.16.005" x-align="PSA.44.16.a005" x-target-ids="t009" x-target="blasphemeth" x-target-head="t009" x-head="true" lemma="גָּדַף" strong="H1442" x-morph="Vprmsa" x-gloss="[one.who].reviles" x-translit="məḡaddēp̄" xml:lang="hbo" x-source-ref="PSA.44.17">מְגַדֵּ֑ף</char> <char style="w" x-id="WLC.PSA.44.16.006" x-align="PSA.44.16.a006" lemma="מִן" strong="H4480" x-morph="R" x-gloss="because" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.44.17">מִ</char><char style="w" x-id="WLC.PSA.44.16.007" x-align="PSA.44.16.a006" x-target-ids="t010 t011 t012" x-target="By reason of" x-target-head="t011" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="of" x-translit="pənēy" xml:lang="hbo" x-source-ref="PSA.44.17">פְּנֵ֥י</char> <char style="w" x-id="WLC.P