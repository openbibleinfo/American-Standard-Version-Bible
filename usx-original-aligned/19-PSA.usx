	<para style="p"><verse number="11" style="v" x-ref="PSA.9.11" sid="PSA 9:11" /><char style="w" x-id="WLC.PSA.9.11.001" x-align="PSA.9.11.a001" x-target-ids="t001 t002" x-target="Sing praises" x-target-head="t002" x-head="true" lemma="זָמַר" strong="H2167" x-morph="Vpv2mp" x-gloss="sing.praises" x-translit="zammərû" xml:lang="hbo" x-source-ref="PSA.9.12">זַמְּר֗וּ</char> <char style="w" x-id="WLC.PSA.9.11.002" x-align="PSA.9.11.a002" x-target-ids="t003" x-target="to" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.9.12">לַ֭</char><char style="w" x-id="WLC.PSA.9.11.003" x-align="PSA.9.11.a003" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwâ" xml:lang="hbo" x-source-ref="PSA.9.12">יהוָה</char> <char style="w" x-id="WLC.PSA.9.11.004" x-align="PSA.9.11.a004" x-target-ids="t005 t006 t007" x-target="who dwelleth in" x-target-head="t006" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqrmsc" x-gloss="[who].dwells" x-translit="yōšēḇ" xml:lang="hbo" x-source-ref="PSA.9.12">יֹשֵׁ֣ב</char> <char style="w" x-id="WLC.PSA.9.11.005" x-align="PSA.9.11.a005" x-target-ids="t008" x-target="Zion" x-target-head="t008" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="Zion" x-translit="ṣiyyôn" xml:lang="hbo" x-source-ref="PSA.9.12">צִיּ֑וֹן</char> <char style="w" x-id="WLC.PSA.9.11.006" x-align="PSA.9.11.a006" x-target-ids="t009" x-target="Declare" x-target-head="t009" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhv2mp" x-gloss="declare" x-translit="haggiyḏû" xml:lang="hbo" x-source-ref="PSA.9.12">הַגִּ֥ידוּ</char> <char style="w" x-id="WLC.PSA.9.11.007" x-align="PSA.9.11.a007" x-target-ids="t010" x-target="among" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ḇā" xml:lang="hbo" x-source-ref="PSA.9.12">בָ֝</char><cha