	<para style="p"><verse number="9" style="v" x-ref="PSA.76.9" sid="PSA 76:9" /><char style="w" x-id="WLC.PSA.76.9.001" x-align="PSA.76.9.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.76.10">בְּ</char><char style="w" x-id="WLC.PSA.76.9.002" x-align="PSA.76.9.a003" x-target-ids="t003" x-target="arose" x-target-head="t003" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqc" x-gloss="arose" x-translit="qûm-" xml:lang="hbo" x-source-ref="PSA.76.10">קוּם</char>־<char style="w" x-id="WLC.PSA.76.9.003" x-align="PSA.76.9.a004" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo" x-source-ref="PSA.76.10">לַ</char><char style="w" x-id="WLC.PSA.76.9.004" x-align="PSA.76.9.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.76.10">[הַ]</char><char style="w" x-id="WLC.PSA.76.9.005" x-align="PSA.76.9.a006" x-target-ids="t005" x-target="judgment" x-target-head="t005" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="judgment" x-translit="mmišpāṭ" xml:lang="hbo" x-source-ref="PSA.76.10">מִּשְׁפָּ֥ט</char> <char style="w" x-id="WLC.PSA.76.9.006" x-align="PSA.76.9.a002" x-target-ids="t002" x-target="God" x-target-head="t002" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.76.10">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.76.9.007" x-align="PSA.76.9.a007" x-target-ids="t006" x-target="To" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.76.10">לְ</char><char style="w" x-id="WLC.PSA.76.9.008" x-align="PSA.76.9.a008" x-target-ids="t007" x-target="save" x-target-he