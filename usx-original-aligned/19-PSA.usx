	<para style="d" x-ref="PSA.51.0" x-added-alignments="PSA.51.0.a007" x-added-target-ids="t009 t010 t011 t012 t013 t014 t015 t016 t017 t018 t019 t020 t021 t022 t023" x-added-target="when Nathan the prophet came unto him after he had gone in to Bath sheba"><char style="w" x-id="WLC.PSA.51.0.001" x-align="PSA.51.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.51.1">לַ</char><char style="w" x-id="WLC.PSA.51.0.002" x-align="PSA.51.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.51.1">[הַ]</char><char style="w" x-id="WLC.PSA.51.0.003" x-align="PSA.51.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.51.1">מְנַצֵּ֗חַ</char> <char style="w" x-id="WLC.PSA.51.0.004" x-align="PSA.51.0.a004" x-target-ids="t005 t006" x-target="A Psalm" x-target-head="t006" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.51.1">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.51.0.005" x-align="PSA.51.0.a005" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.51.1">לְ</char><char style="w" x-id="WLC.PSA.51.0.006" x-align="PSA.51.0.a006" x-target-ids="t008" x-target="David" x-target-head="t008" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ:" xml:lang="hbo" x-source-ref="PSA.51.1">דָוִֽד</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.51.1" sid="PSA 51:1" /><char style="w" x-id="WLC.PSA.51.1.001" x-align="PSA.51.1.a001" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.51.2">בְּֽ</char><char style="w" x-id="WLC.PSA.51.1.002" x-align="PSA.51.1.a002" x-status="unrepresented" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqc" x-gloss="came" x-translit="ḇôʾ-" xml:lang="hbo" x-source-ref="PSA.51.2">בוֹא</char>־<char style="w" x-id="WLC.PSA.51.1.003" x-align="PSA.51.1.a003" x-status="unrepresented" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēlāy" xml:lang="hbo" x-source-ref="PSA.51.2">אֵ֭לָי</char><char style="w" x-id="WLC.PSA.51.1.004" x-align="PSA.51.1.a004" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="w" xml:lang="hbo" x-source-ref="PSA.51.2">ו</char> <char style="w" x-id="WLC.PSA.51.1.005" x-align="PSA.51.1.a005" x-status="unrepresented" x-head="true" lemma="נָתָן" strong="H5416" x-morph="Np" x-gloss="Nathan" x-translit="nāṯān" xml:lang="hbo" x-source-ref="PSA.51.2">נָתָ֣ן</char> <char style="w" x-id="WLC.PSA.51.1.006" x-align="PSA.51.1.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.51.2">הַ</char><char style="w" x-id="WLC.PSA.51.1.007" x-align="PSA.51.1.a007" x-status="unrepresented" x-head="true" lemma="נָבִיא" strong="H5030" x-morph="Ncmsa" x-gloss="prophet" x-translit="nnāḇiyʾ" xml:lang="hbo" x-source-ref="PSA.51.2">נָּבִ֑יא</char> <char style="w" x-id="WLC.PSA.51.1.008" x-align="PSA.51.1.a008" x-status="unrepresented" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="when" x-translit="ka" xml:lang="hbo" x-source-ref="PSA.51.2">כַּֽ</char><char style="w" x-id="WLC.PSA.51.1.009" x-align="PSA.51.1.a009" x-status="unrepresented" x-head="