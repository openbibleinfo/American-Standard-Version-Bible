	<para style="p"><verse number="2" style="v" x-ref="PSA.23.2" sid="PSA 23:2" /><char style="w" x-id="WLC.PSA.23.2.001" x-align="PSA.23.2.a003" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PSA.23.2.002" x-align="PSA.23.2.a004" x-target-ids="t009" x-target="pastures" x-target-head="t009" x-head="true" lemma="נָוָה" strong="H4999" x-morph="Ncfpc" x-gloss="pastures" x-translit="nəʾôṯ" xml:lang="hbo">נְא֣וֹת</char> <char style="w" x-id="WLC.PSA.23.2.003" x-align="PSA.23.2.a005" x-target-ids="t008" x-target="green" x-target-head="t008" x-head="true" lemma="דֶּשֶׁא" strong="H1877" x-morph="Ncmsa" x-gloss="of.fresh.grass" x-translit="dešeʾ" xml:lang="hbo">דֶּ֭שֶׁא</char> <char style="w" x-id="WLC.PSA.23.2.004" x-align="PSA.23.2.a001" x-target-ids="t001 t002 t004 t005 t006" x-target="He maketh to lie down" x-target-head="t005" x-head="true" lemma="רָבַץ" strong="H7257" x-morph="Vhi3ms" x-gloss="he" x-translit="yarbiyṣ" xml:lang="hbo">יַרְבִּיצֵ֑</char><char style="w" x-id="WLC.PSA.23.2.005" x-align="PSA.23.2.a002" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="makes.me.lie.down" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.23.2.006" x-align="PSA.23.2.a008" x-target-ids="t013" x-target="beside" x-target-head="t013" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="at" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.23.2.007" x-align="PSA.23.2.a009" x-target-ids="t015" x-target="waters" x-target-head="t015" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpc" x-gloss="waters" x-translit="mēy" xml:lang="hbo">מֵ֖י</char> <char style="w" x-id="WLC.PSA.23.2.008" x-align="PSA.23.2.a010" x-target-ids="t014" x-target="still" x-target-head="t014" x-head="true" lemma="מְנוּחָה" strong="H4496" x-morp