	<para style="p"><verse number="1" style="v" x-ref="PSA.15.1" sid="PSA 15:1" /><char style="w" x-id="WLC.PSA.15.1.001" x-align="PSA.15.1.a001" x-target-ids="t001 t002" x-target="A Psalm" x-target-head="t002" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo">מִזְמ֗וֹר</char> <char style="w" x-id="WLC.PSA.15.1.002" x-align="PSA.15.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.15.1.003" x-align="PSA.15.1.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָ֫וִ֥ד</char><char style="w" x-id="WLC.PSA.15.1.004" x-align="PSA.15.1.a004" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הֹוָה</char> <char style="w" x-id="WLC.PSA.15.1.005" x-align="PSA.15.1.a005" x-target-ids="t006" x-target="who" x-target-head="t006" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="mî-" xml:lang="hbo">מִי</char>־<char style="w" x-id="WLC.PSA.15.1.006" x-align="PSA.15.1.a006" x-target-ids="t007 t008" x-target="shall sojourn" x-target-head="t008" x-head="true" lemma="גּוּר" strong="H1481" x-morph="Vqi3ms" x-gloss="will.he.sojourn" x-translit="yāḡûr" xml:lang="hbo">יָג֣וּר</char> <char style="w" x-id="WLC.PSA.15.1.007" x-align="PSA.15.1.a007" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.15.1.008" x-align="PSA.15.1.a008" x-target-ids="t011" x-target="tabernacle" x-target-head="t011" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmsc" x-gloss="tent" x-translit="ʾāhŏl