	<para style="p"><verse number="9" style="v" x-ref="PSA.86.9" sid="PSA 86:9" /><char style="w" x-id="WLC.PSA.86.9.001" x-align="PSA.86.9.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.86.9.002" x-align="PSA.86.9.a002" x-target-ids="t002" x-target="nations" x-target-head="t002" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="[the].nations" x-translit="gôyim" xml:lang="hbo">גּוֹיִ֤ם</char>׀<char style="w" x-id="WLC.PSA.86.9.003" x-align="PSA.86.9.a003" x-target-ids="t003" x-target="whom" x-target-head="t003" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="which" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֥ר</char> <char style="w" x-id="WLC.PSA.86.9.004" x-align="PSA.86.9.a004" x-target-ids="t004 t005 t006" x-target="thou hast made" x-target-head="t006" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp2ms" x-gloss="you.have.made" x-translit="ʿāśiyṯā" xml:lang="hbo">עָשִׂ֗יתָ</char> <char style="w" x-id="WLC.PSA.86.9.005" x-align="PSA.86.9.a005" x-target-ids="t007 t008" x-target="shall come" x-target-head="t008" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3mp" x-gloss="they.will.come" x-translit="yāḇôʾû" xml:lang="hbo">יָב֤וֹאוּ</char>׀<char style="w" x-id="WLC.PSA.86.9.006" x-align="PSA.86.9.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.86.9.007" x-align="PSA.86.9.a007" x-target-ids="t010" x-target="worship" x-target-head="t010" x-head="true" lemma="חוה" strong="H7812a" x-morph="Vvi3mp" x-gloss="they.will.bow.down" x-translit="yištaḥăwû" xml:lang="hbo">יִשְׁתַּחֲו֣וּ</char> <char style="w" x-id="WLC.PSA.86.9.008" x-align="PSA.86.9.a008" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="lə" xml