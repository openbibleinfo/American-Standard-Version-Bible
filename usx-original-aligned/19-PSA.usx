	<para style="p"><verse number="14" style="v" x-ref="PSA.88.14" sid="PSA 88:14" /><char style="w" x-id="WLC.PSA.88.14.001" x-align="PSA.88.14.a001" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.88.15">לָ</char><char style="w" x-id="WLC.PSA.88.14.002" x-align="PSA.88.14.a001" x-target-ids="t002 t008" x-target="why Why" x-target-head="t002" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="māh" xml:lang="hbo" x-source-ref="PSA.88.15">מָ֣ה</char> <char style="w" x-id="WLC.PSA.88.14.003" x-align="PSA.88.14.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.88.15">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.88.14.004" x-align="PSA.88.14.a003" x-target-ids="t003 t004 t005" x-target="castest thou off" x-target-head="t003" x-head="true" lemma="זָנַח" strong="H2186" x-morph="Vqi2ms" x-gloss="do.you.reject" x-translit="tiznaḥ" xml:lang="hbo" x-source-ref="PSA.88.15">תִּזְנַ֣ח</char> <char style="w" x-id="WLC.PSA.88.14.005" x-align="PSA.88.14.a004" x-target-ids="t007" x-target="soul" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo" x-source-ref="PSA.88.15">נַפְשִׁ֑</char><char style="w" x-id="WLC.PSA.88.14.006" x-align="PSA.88.14.a005" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.88.15">י</char> <char style="w" x-id="WLC.PSA.88.14.007" x-align="PSA.88.14.a006" x-target-ids="t009 t010" x-target="hidest thou" x-target-head="t009" x-head="true" lemma="סָתַר" strong="H5641" x-morph="Vhi2ms" x-gloss="do.you.hide?" x-translit="tastiyr" xml:lang="hbo" x-source-ref="PSA.88.15">תַּסְתִּ֖יר</char> <char style="w" x-id="WLC.PSA.88.14.008" x-align="PSA.88.14.a007" x-t