	<para style="p"><verse number="47" style="v" x-ref="PSA.18.47" x-added-alignments="PSA.18.47.a001" x-added-target-ids="t001" x-added-target="Even" sid="PSA 18:47" /><char style="w" x-id="WLC.PSA.18.47.001" x-align="PSA.18.47.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo" x-source-ref="PSA.18.48">הָ</char><char style="w" x-id="WLC.PSA.18.47.002" x-align="PSA.18.47.a003" x-target-ids="t003" x-target="God" x-target-head="t003" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo" x-source-ref="PSA.18.48">אֵ֗ל</char> <char style="w" x-id="WLC.PSA.18.47.003" x-align="PSA.18.47.a004" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[who]" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.18.48">הַ</char><char style="w" x-id="WLC.PSA.18.47.004" x-align="PSA.18.47.a005" x-target-ids="t005" x-target="executeth" x-target-head="t005" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqrmsa" x-gloss="gives" x-translit="nnôṯēn" xml:lang="hbo" x-source-ref="PSA.18.48">נּוֹתֵ֣ן</char> <char style="w" x-id="WLC.PSA.18.47.005" x-align="PSA.18.47.a006" x-target-ids="t006" x-target="vengeance" x-target-head="t006" x-head="true" lemma="נְקָמָה" strong="H5360" x-morph="Ncfpa" x-gloss="vengeance(s)" x-translit="nəqāmôṯ" xml:lang="hbo" x-source-ref="PSA.18.48">נְקָמ֣וֹת</char> <char style="w" x-id="WLC.PSA.18.47.006" x-align="PSA.18.47.a007" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo" x-source-ref="PSA.18.48">לִ֑</char><char style="w" x-id="WLC.PSA.18.47.007" x-align="PSA.18.47.a008" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref=