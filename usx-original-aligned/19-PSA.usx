	<para style="p"><verse number="12" style="v" x-ref="PSA.147.12" sid="PSA 147:12" /><char style="w" x-id="WLC.PSA.147.12.001" x-align="PSA.147.12.a001" x-target-ids="t001" x-target="Praise" x-target-head="t001" x-head="true" lemma="שָׁבַח" strong="H7623" x-morph="Vpv2fs" x-gloss="extol" x-translit="šabbəḥiy" xml:lang="hbo">שַׁבְּחִ֣י</char> <char style="w" x-id="WLC.PSA.147.12.002" x-align="PSA.147.12.a004" x-target-ids="t003 t004" x-target="O Jerusalem" x-target-head="t004" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389" x-morph="Np" x-gloss="O.Jerusalem" x-translit="yərûšālaim" xml:lang="hbo">יְ֭רוּשָׁלִַם</char> <char style="w" x-id="WLC.PSA.147.12.003" x-align="PSA.147.12.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.147.12.004" x-align="PSA.147.12.a003" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.147.12.005" x-align="PSA.147.12.a005" x-target-ids="t005" x-target="Praise" x-target-head="t005" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpv2fs" x-gloss="praise" x-translit="haləliy" xml:lang="hbo">הַֽלְלִ֖י</char> <char style="w" x-id="WLC.PSA.147.12.006" x-align="PSA.147.12.a007" x-target-ids="t007" x-target="God" x-target-head="t007" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōhay" xml:lang="hbo">אֱלֹהַ֣יִ</char><char style="w" x-id="WLC.PSA.147.12.007" x-align="PSA.147.12.a006" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="iḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.PSA.147.12.008" x-align="PSA.147.12.a008" x-target-ids="t008 t009" x-target="O Zion" x-target-head="t009" x-head="true" lemma="צִיּוֹן" strong="H