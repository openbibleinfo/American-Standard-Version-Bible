	<para style="p"><verse number="56" style="v" x-ref="PSA.119.56" x-added-alignments="PSA.119.56.a009" x-added-target-ids="t011 t012" x-added-target="ח Hheth" sid="PSA 119:56" /><char style="w" x-id="WLC.PSA.119.56.001" x-align="PSA.119.56.a001" x-target-ids="t001" x-target="This" x-target-head="t001" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֥את</char> <char style="w" x-id="WLC.PSA.119.56.002" x-align="PSA.119.56.a002" x-target-ids="t003 t004" x-target="have had" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp3fs" x-gloss="it.has.belonged" x-translit="hāyəṯâ-" xml:lang="hbo">הָֽיְתָה</char>־<char style="w" x-id="WLC.PSA.119.56.003" x-align="PSA.119.56.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="ll" xml:lang="hbo">לִּ֑</char><char style="w" x-id="WLC.PSA.119.56.004" x-align="PSA.119.56.a004" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.56.005" x-align="PSA.119.56.a005" x-target-ids="t005" x-target="Because" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(cmp)" x-translit="kiy" xml:lang="hbo">כִּ֖י</char> <char style="w" x-id="WLC.PSA.119.56.006" x-align="PSA.119.56.a006" x-target-ids="t010" x-target="precepts" x-target-head="t010" x-head="true" lemma="פִּקּוּדִים" strong="H6490" x-morph="Ncmpc" x-gloss="precepts" x-translit="p̄iqquḏey" xml:lang="hbo">פִקֻּדֶ֣י</char><char style="w" x-id="WLC.PSA.119.56.007" x-align="PSA.119.56.a007" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.56.008" x-align="PSA.119.56.a008" x-target-ids="t006 t007 t008" x-target="I have kept" x-