	<para style="p"><verse number="78" style="v" x-ref="PSA.119.78" x-added-alignments="PSA.119.78.a007" x-added-target-ids="t014" x-added-target="But" sid="PSA 119:78" /><char style="w" x-id="WLC.PSA.119.78.001" x-align="PSA.119.78.a001" x-target-ids="t001 t004 t005 t006 t007" x-target="Let be put to shame" x-target-head="t007" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqi3mp" x-gloss="let.them.be.ashamed" x-translit="yēḇōšû" xml:lang="hbo">יֵבֹ֣שׁוּ</char> <char style="w" x-id="WLC.PSA.119.78.002" x-align="PSA.119.78.a002" x-target-ids="t002 t003" x-target="the proud" x-target-head="t003" x-head="true" lemma="זֵד" strong="H2086" x-morph="Aampa" x-gloss="arrogant.[people]" x-translit="zēḏîm" xml:lang="hbo">זֵ֭דִים</char> <char style="w" x-id="WLC.PSA.119.78.003" x-align="PSA.119.78.a003" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.119.78.004" x-align="PSA.119.78.a004" x-target-ids="t013" x-target="wrongfully" x-target-head="t013" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="falsehood" x-translit="šeqer" xml:lang="hbo">שֶׁ֣קֶר</char> <char style="w" x-id="WLC.PSA.119.78.005" x-align="PSA.119.78.a005" x-target-ids="t009 t010 t011" x-target="they have overthrown" x-target-head="t011" x-head="true" lemma="עָוַת" strong="H5791" x-morph="Vpp3cp" x-gloss="they" x-translit="ʿiwwəṯû" xml:lang="hbo">עִוְּת֑וּ</char><char style="w" x-id="WLC.PSA.119.78.006" x-align="PSA.119.78.a006" x-target-ids="t012" x-target="me" x-target-head="t012" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="have.subverted.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.78.007" x-align="PSA.119.78.a008" x-target-ids="t015" x-target="I" x-target-head="t015" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲ֝נִ֗י