	<para style="p"><verse number="1" style="v" x-ref="PSA.138.1" x-added-alignments="PSA.138.1.a001" x-added-target-ids="t001 t002" x-added-target="A Psalm" sid="PSA 138:1" /><char style="w" x-id="WLC.PSA.138.1.001" x-align="PSA.138.1.a002" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.138.1.002" x-align="PSA.138.1.a003" x-target-ids="t004" x-target="David" x-target-head="t004" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="David" x-translit="ḏāwiḏ" xml:lang="hbo">דָוִ֨ד</char>׀<char style="w" x-id="WLC.PSA.138.1.003" x-align="PSA.138.1.a004" x-target-ids="t005 t006 t007 t009" x-target="I will give thanks" x-target-head="t009" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo">אוֹדְ</char><char style="w" x-id="WLC.PSA.138.1.004" x-align="PSA.138.1.a005" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PSA.138.1.005" x-align="PSA.138.1.a006" x-target-ids="t010" x-target="with" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PSA.138.1.006" x-align="PSA.138.1.a007" x-target-ids="t012" x-target="whole" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.138.1.007" x-align="PSA.138.1.a008" x-target-ids="t013" x-target="heart" x-target-head="t013" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֑</char><char style="w" x-id="WLC.PSA.138.1.008" x-align="PSA.138.1.a009" x-target-ids="t011" x-target="my" x-target-head=