	<para style="p"><verse number="22" style="v" x-ref="PSA.89.22" sid="PSA 89:22" /><char style="w" x-id="WLC.PSA.89.22.001" x-align="PSA.89.22.a001" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.89.23">לֹֽא</char>־<char style="w" x-id="WLC.PSA.89.22.002" x-align="PSA.89.22.a002" x-target-ids="t003 t005" x-target="shall exact" x-target-head="t005" x-head="true" lemma="נָשָׁא" strong="H7722b" x-morph="Vhi3ms" x-gloss="he.will.deceive" x-translit="yaššiʾ" xml:lang="hbo" x-source-ref="PSA.89.23">יַשִּׁ֣א</char> <char style="w" x-id="WLC.PSA.89.22.003" x-align="PSA.89.22.a003" x-target-ids="t001 t002" x-target="The enemy" x-target-head="t002" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmsa" x-gloss="an.enemy" x-translit="ʾôyēḇ" xml:lang="hbo" x-source-ref="PSA.89.23">אוֹיֵ֣ב</char> <char style="w" x-id="WLC.PSA.89.22.004" x-align="PSA.89.22.a004" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in)" x-translit="b" xml:lang="hbo" x-source-ref="PSA.89.23">בּ֑</char><char style="w" x-id="WLC.PSA.89.22.005" x-align="PSA.89.22.a005" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.89.23">וֹ</char> <char style="w" x-id="WLC.PSA.89.22.006" x-align="PSA.89.22.a006" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.89.23">וּ</char><char style="w" x-id="WLC.PSA.89.22.007" x-align="PSA.89.22.a007" x-target-ids="t009 t010" x-target="the son" x-target-head="t010" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="a.son" x-translit="ḇen-" xml:lang="hbo" x-source-ref="PSA.89.23">בֶן</char>־<char style="w" x-id="WLC.PSA.89.22.008" x-align="PSA.89.22.a008" x-targe