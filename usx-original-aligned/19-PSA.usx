	<para style="p"><verse number="119" style="v" x-ref="PSA.119.119" sid="PSA 119:119" /><char style="w" x-id="WLC.PSA.119.119.001" x-align="PSA.119.119.a001" x-target-ids="t010 t011" x-target="like dross" x-target-head="t011" x-head="true" lemma="סִיג" strong="H5509" x-morph="Ncmpa" x-gloss="dross(es)" x-translit="siḡiym" xml:lang="hbo">סִגִ֗ים</char> <char style="w" x-id="WLC.PSA.119.119.002" x-align="PSA.119.119.a002" x-target-ids="t001 t002 t003" x-target="Thou puttest away" x-target-head="t002" x-head="true" lemma="שָׁבַת" strong="H7673" x-morph="Vhp2ms" x-gloss="you.cause.to.cease" x-translit="hišbatā" xml:lang="hbo">הִשְׁבַּ֥תָּ</char> <char style="w" x-id="WLC.PSA.119.119.003" x-align="PSA.119.119.a003" x-target-ids="t004" x-target="all" x-target-head="t004" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.119.119.004" x-align="PSA.119.119.a004" x-target-ids="t005 t006" x-target="the wicked" x-target-head="t006" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampc" x-gloss="[the].wicked.[people]" x-translit="rišʿê-" xml:lang="hbo">רִשְׁעֵי</char>־<char style="w" x-id="WLC.PSA.119.119.005" x-align="PSA.119.119.a005" x-target-ids="t007 t008 t009" x-target="of the earth" x-target-head="t009" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.[the].earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.PSA.119.119.006" x-align="PSA.119.119.a006" x-target-ids="t012" x-target="Therefore" x-target-head="t012" x-head="true" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ֝</char><char style="w" x-id="WLC.PSA.119.119.007" x-align="PSA.119.119.a006" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֗ן</char> <char style="w" x-id="WLC.PSA.119.119.008" x-align="PSA.119.119.a007" x-target-ids="t013 t014" x-target="I love" x-target-head="t014" x-head="true" l