	<para style="p"><verse number="2" style="v" x-ref="PSA.149.2" sid="PSA 149:2" /><char style="w" x-id="WLC.PSA.149.2.001" x-align="PSA.149.2.a001" x-target-ids="t001 t003" x-target="Let rejoice" x-target-head="t003" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3ms" x-gloss="let.it.rejoice" x-translit="yiśmaḥ" xml:lang="hbo">יִשְׂמַ֣ח</char> <char style="w" x-id="WLC.PSA.149.2.002" x-align="PSA.149.2.a002" x-target-ids="t002" x-target="Israel" x-target-head="t002" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֣ל</char> <char style="w" x-id="WLC.PSA.149.2.003" x-align="PSA.149.2.a003" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.149.2.004" x-align="PSA.149.2.a004" x-target-ids="t005 t006 t007" x-target="him that made" x-target-head="t007" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmpc" x-gloss="its" x-translit="ʿōśāy" xml:lang="hbo">עֹשָׂ֑י</char><char style="w" x-id="WLC.PSA.149.2.005" x-align="PSA.149.2.a005" x-target-ids="t008" x-target="him" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="maker(s)" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PSA.149.2.006" x-align="PSA.149.2.a006" x-target-ids="t010 t011" x-target="the children" x-target-head="t011" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.children" x-translit="bənēy-" xml:lang="hbo">בְּנֵֽי</char>־<char style="w" x-id="WLC.PSA.149.2.007" x-align="PSA.149.2.a007" x-target-ids="t012 t013" x-target="of Zion" x-target-head="t013" x-head="true" lemma="צִיּוֹן" strong="H6726" x-morph="Np" x-gloss="of.Zion" x-translit="ṣiyyôn" xml:lang="hbo">צִ֝יּ֗וֹן</char> <char style="w" x-id="WLC.PSA.149.2.008" x-align="PSA.149.2.a008" x-target-ids="t009 t014 t015" x-target="Let be joyful" x-target