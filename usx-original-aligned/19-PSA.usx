	<para style="p"><verse number="6" style="v" x-ref="PSA.31.6" sid="PSA 31:6" /><char style="w" x-id="WLC.PSA.31.6.001" x-align="PSA.31.6.a001" x-target-ids="t001 t002" x-target="I hate" x-target-head="t002" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqp1cs" x-gloss="I.hate" x-translit="śānēʾṯî" xml:lang="hbo" x-source-ref="PSA.31.7">שָׂנֵ֗אתִי</char> <char style="w" x-id="WLC.PSA.31.6.002" x-align="PSA.31.6.a002" x-target-ids="t003 t004" x-target="them that" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.31.7">הַ</char><char style="w" x-id="WLC.PSA.31.6.003" x-align="PSA.31.6.a003" x-target-ids="t005" x-target="regard" x-target-head="t005" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmpa" x-gloss="who].keep" x-translit="ššōməriym" xml:lang="hbo" x-source-ref="PSA.31.7">שֹּׁמְרִ֥ים</char> <char style="w" x-id="WLC.PSA.31.6.004" x-align="PSA.31.6.a004" x-target-ids="t007" x-target="vanities" x-target-head="t007" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmpc" x-gloss="vanities" x-translit="haḇlê-" xml:lang="hbo" x-source-ref="PSA.31.7">הַבְלֵי</char>־<char style="w" x-id="WLC.PSA.31.6.005" x-align="PSA.31.6.a005" x-target-ids="t006" x-target="lying" x-target-head="t006" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāwəʾ" xml:lang="hbo" x-source-ref="PSA.31.7">שָׁ֑וְא</char> <char style="w" x-id="WLC.PSA.31.6.006" x-align="PSA.31.6.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.31.7">וַ֝</char><char style="w" x-id="WLC.PSA.31.6.007" x-align="PSA.31.6.a007" x-target-ids="t009" x-target="I" x-target-head="t009" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo" x-source-ref="PSA.31.7">אֲנִ֗י</char> <char style="w" x-i