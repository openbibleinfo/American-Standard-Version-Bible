	<para style="d" x-ref="PSA.44.0" x-added-alignments="PSA.44.0.a004" x-added-target-ids="t005 t006" x-added-target="A Psalm"><char style="w" x-id="WLC.PSA.44.0.001" x-align="PSA.44.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.44.1">לַ</char><char style="w" x-id="WLC.PSA.44.0.002" x-align="PSA.44.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.44.1">[הַ]</char><char style="w" x-id="WLC.PSA.44.0.003" x-align="PSA.44.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.44.1">מְנַצֵּ֬חַ</char> <char style="w" x-id="WLC.PSA.44.0.004" x-align="PSA.44.0.a005" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="li" xml:lang="hbo" x-source-ref="PSA.44.1">לִ</char><char style="w" x-id="WLC.PSA.44.0.005" x-align="PSA.44.0.a006" x-target-ids="t008 t009" x-target="the sons" x-target-head="t009" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="the.sons" x-translit="ḇənê-" xml:lang="hbo" x-source-ref="PSA.44.1">בְנֵי</char>־<char style="w" x-id="WLC.PSA.44.0.006" x-align="PSA.44.0.a007" x-target-ids="t010 t011" x-target="of Korah" x-target-head="t011" x-head="true" lemma="קֹרַח" strong="H7141" x-morph="Np" x-gloss="of.Korah" x-translit="qōraḥ" xml:lang="hbo" x-source-ref="PSA.44.1">קֹ֬רַח</char> <char style="w" x-id="WLC.PSA.44.0.007" x-align="PSA.44.0.a008" x-target-ids="t012" x-target="Maschil" x-target-head="t012" x-head="true" lemma="מַשְׂכִּיל" strong="H4905" x-morph="Ncmsa" x-gloss="a.poem" x-translit="maśkiyl:" xml:lang="hbo" x-source-ref="PSA.44.1">