	<para style="p"><verse number="6" style="v" x-ref="PSA.56.6" sid="PSA 56:6" /><char style="w" x-id="WLC.PSA.56.6.001" x-align="PSA.56.6.a001" x-target-ids="t001 t002 t003 t004" x-target="They gather themselves together" x-target-head="t002" x-head="true" lemma="גּוּר" strong="H1481a" x-morph="Vqi3mp" x-gloss="they.stir.up.trouble" x-translit="yāḡûrû" xml:lang="hbo" x-source-ref="PSA.56.7">יָג֤וּרוּ</char>׀<char style="w" x-id="WLC.PSA.56.6.002" x-align="PSA.56.6.a002" x-target-ids="t005 t006 t007" x-target="they hide themselves" x-target-head="t006" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqi3mp" x-gloss="they.lie.hidden" x-translit="**yiṣpônû" xml:lang="hbo" x-source-ref="PSA.56.7">יִצְפּ֗וֹנוּ</char> <char style="w" x-id="WLC.PSA.56.6.003" x-align="PSA.56.6.a003" x-target-ids="t008" x-target="They" x-target-head="t008" x-head="true" lemma="הֵמָּה" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēmmâ" xml:lang="hbo" x-source-ref="PSA.56.7">הֵ֭מָּה</char> <char style="w" x-id="WLC.PSA.56.6.004" x-align="PSA.56.6.a004" x-target-ids="t011" x-target="steps" x-target-head="t011" x-head="true" lemma="עָקֵב" strong="H6119" x-morph="Ncmpc" x-gloss="heels" x-translit="ʿăqēḇ" xml:lang="hbo" x-source-ref="PSA.56.7">עֲקֵבַ֣</char><char style="w" x-id="WLC.PSA.56.6.005" x-align="PSA.56.6.a005" x-target-ids="t010" x-target="my" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo" x-source-ref="PSA.56.7">י</char> <char style="w" x-id="WLC.PSA.56.6.006" x-align="PSA.56.6.a006" x-target-ids="t009" x-target="mark" x-target-head="t009" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqi3mp" x-gloss="they.watch.for" x-translit="yišmōrû" xml:lang="hbo" x-source-ref="PSA.56.7">יִשְׁמֹ֑רוּ</char> <char style="w" x-id="WLC.PSA.56.6.007" x-align="PSA.56.6.a007" x-target-ids="t012 t013" x-target="Even as" x-target-head="t013" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="just