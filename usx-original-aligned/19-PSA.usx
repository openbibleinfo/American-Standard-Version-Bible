	<para style="p"><verse number="3" style="v" x-ref="PSA.77.3" sid="PSA 77:3" /><char style="w" x-id="WLC.PSA.77.3.001" x-align="PSA.77.3.a001" x-target-ids="t001 t002" x-target="I remember" x-target-head="t002" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqh1cs" x-gloss="I.will.remember" x-translit="ʾezkərāh" xml:lang="hbo" x-source-ref="PSA.77.4">אֶזְכְּרָ֣ה</char> <char style="w" x-id="WLC.PSA.77.3.002" x-align="PSA.77.3.a002" x-target-ids="t003" x-target="God" x-target-head="t003" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.77.4">אֱלֹהִ֣ים</char> <char style="w" x-id="WLC.PSA.77.3.003" x-align="PSA.77.3.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.77.4">וְ</char><char style="w" x-id="WLC.PSA.77.3.004" x-align="PSA.77.3.a004" x-target-ids="t005 t006" x-target="am disquieted" x-target-head="t006" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqh1cs" x-gloss="I.will.murmur" x-translit="ʾehĕmāyāh" xml:lang="hbo" x-source-ref="PSA.77.4">אֶֽהֱמָיָ֑ה</char> <char style="w" x-id="WLC.PSA.77.3.005" x-align="PSA.77.3.a005" x-target-ids="t007 t008" x-target="I complain" x-target-head="t008" x-head="true" lemma="שִׂיחַ" strong="H7878" x-morph="Vqh1cs" x-gloss="I.will.complain" x-translit="ʾāśiyḥāh" xml:lang="hbo" x-source-ref="PSA.77.4">אָשִׂ֓יחָה</char>׀<char style="w" x-id="WLC.PSA.77.3.006" x-align="PSA.77.3.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.77.4">וְ</char><char style="w" x-id="WLC.PSA.77.3.007" x-align="PSA.77.3.a007" x-target-ids="t012 t013" x-target="is overwhelmed" x-target-head="t013" x-head="true" lemma="עָטַף" strong="H5848a" x-morph="Vti3fs" x-gloss="it.will.faint.away" x-translit="ṯiṯʿaṭṭēp̄" 