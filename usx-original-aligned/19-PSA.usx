	<para style="p"><verse number="21" style="v" x-ref="PSA.34.21" sid="PSA 34:21" /><char style="w" x-id="WLC.PSA.34.21.001" x-align="PSA.34.21.a001" x-target-ids="t002 t003" x-target="shall slay" x-target-head="t003" x-head="true" lemma="מוּת" strong="H4191" x-morph="Voi3fs" x-gloss="it.will.kill" x-translit="təmôṯēṯ" xml:lang="hbo" x-source-ref="PSA.34.22">תְּמוֹתֵ֣ת</char> <char style="w" x-id="WLC.PSA.34.21.002" x-align="PSA.34.21.a002" x-target-ids="t004 t005" x-target="the wicked" x-target-head="t005" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="[the].wicked" x-translit="rāšāʿ" xml:lang="hbo" x-source-ref="PSA.34.22">רָשָׁ֣ע</char> <char style="w" x-id="WLC.PSA.34.21.003" x-align="PSA.34.21.a003" x-target-ids="t001" x-target="Evil" x-target-head="t001" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="evil" x-translit="rāʿāh" xml:lang="hbo" x-source-ref="PSA.34.22">רָעָ֑ה</char> <char style="w" x-id="WLC.PSA.34.21.004" x-align="PSA.34.21.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.34.22">וְ</char><char style="w" x-id="WLC.PSA.34.21.005" x-align="PSA.34.21.a005" x-target-ids="t007 t008 t009" x-target="they that hate" x-target-head="t009" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmpc" x-gloss="[those.who].hate" x-translit="śōnʾēy" xml:lang="hbo" x-source-ref="PSA.34.22">שֹׂנְאֵ֖י</char> <char style="w" x-id="WLC.PSA.34.21.006" x-align="PSA.34.21.a006" x-target-ids="t010 t011" x-target="the righteous" x-target-head="t011" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="(of).[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo" x-source-ref="PSA.34.22">צַדִּ֣יק</char> <char style="w" x-id="WLC.PSA.34.21.007" x-align="PSA.34.21.a007" x-target-ids="t012 t013 t014" x-target="shall be condemned" x-target-head="t014" x-head="true" lemma="אָשַׁם" strong="H816" x-m