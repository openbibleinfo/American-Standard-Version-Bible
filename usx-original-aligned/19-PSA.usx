	<para style="p"><verse number="21" style="v" x-ref="PSA.50.21" x-added-alignments="PSA.50.21.a006 PSA.50.21.a011 PSA.50.21.a016" x-added-target-ids="t012 t021 t028" x-added-target="that | But | them" sid="PSA 50:21" /><char style="w" x-id="WLC.PSA.50.21.001" x-align="PSA.50.21.a001" x-target-ids="t001 t002" x-target="These things" x-target-head="t001" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo">אֵ֤לֶּה</char> <char style="w" x-id="WLC.PSA.50.21.002" x-align="PSA.50.21.a002" x-target-ids="t003 t004 t005" x-target="hast thou done" x-target-head="t005" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp2ms" x-gloss="you.have.done" x-translit="ʿāśiyṯā" xml:lang="hbo">עָשִׂ֨יתָ</char>׀<char style="w" x-id="WLC.PSA.50.21.003" x-align="PSA.50.21.a003" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.50.21.004" x-align="PSA.50.21.a004" x-target-ids="t007 t008 t009" x-target="I kept silence" x-target-head="t009" x-head="true" lemma="חָרֵשׁ" strong="H2790a" x-morph="Vhq1cs" x-gloss="I.kept.silent" x-translit="heḥĕrašətî" xml:lang="hbo">הֶחֱרַ֗שְׁתִּי</char> <char style="w" x-id="WLC.PSA.50.21.005" x-align="PSA.50.21.a005" x-target-ids="t010 t011" x-target="Thou thoughtest" x-target-head="t011" x-head="true" lemma="דָּמָה" strong="H1819" x-morph="Vpp2ms" x-gloss="you.imagined" x-translit="dimmiyṯā" xml:lang="hbo">דִּמִּ֗יתָ</char> <char style="w" x-id="WLC.PSA.50.21.006" x-align="PSA.50.21.a007" x-target-ids="t015" x-target="altogether" x-target-head="t015" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqc" x-gloss="exactly.(be)" x-translit="hĕyôṯ-" xml:lang="hbo">הֱֽיוֹת</char>־<char style="w" x-id="WLC.PSA.50.21.007" x-align="PSA.50.21.a008" x-target-ids="t013 t014" x-target="I was" x-target-head="t014" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi1cs" x-gloss="I.am" x-translit="ʾehəyeh" xml:lang="hbo">אֶֽהְיֶ֥ה</char> <char style="w" x-id="WLC.PSA.50.21.008" x-align="PSA.50.21.a009" x-target-ids="t016 t017 t018 t019" x-target="such a one as" x-target-head="t019" x-head="true" lemma="כְּמוֹ" strong="H3644" x-morph="R" x-gloss="like" x-translit="ḵāmô" xml:lang="hbo">כָמ֑וֹ</char><char style="w" x-id="WLC.PSA.50.21.009" x-align="PSA.50.21.a010" x-target-ids="t020" x-target="thyself" x-target-head="t020" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.50.21.010" x-align="PSA.50.21.a012" x-target-ids="t022 t023 t024" x-target="I will reprove" x-target-head="t024" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḵiyḥ" xml:lang="hbo">אוֹכִיחֲ</char><char style="w" x-id="WLC.PSA.50.21.011" x-align="PSA.50.21.a013" x-target-ids="t025" x-target="thee" x-target-head="t025" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.rebuke.you" x-translit="ăḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.PSA.50.21.012" x-align="PSA.50.21.a014" x-target-ids="t026" x-target="and" x-target-head="t026" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.50.21.013" x-align="PSA.50.21.a015" x-target-ids="t027 t029 t030" x-target="set in order" x-target-head="t030" x-head="true" lemma="עָרַךְ" strong="H6186" x-morph="Vqh1cs" x-gloss="I.will.arrange" x-translit="ʾeʿerḵāh" xml:lang="hbo">אֶֽעֶרְכָ֣ה</char> <char style="w" x-id="WLC.PSA.50.21.014" x-align="PSA.50.21.a017" x-target-ids="t031" x-target="before" x-target-head="t031" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.50.21.015" x-align="PSA.50.21.a018" x-target-ids="t033" x-target="eyes" x-target-head="t033" x-head="true" lemma="עַיִן" st