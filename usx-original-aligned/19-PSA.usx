	<para style="p"><verse number="13" style="v" x-ref="PSA.80.13" sid="PSA 80:13" /><char style="w" x-id="WLC.PSA.80.13.001" x-align="PSA.80.13.a001" x-target-ids="t007 t008" x-target="doth ravage" x-target-head="t008" x-head="true" lemma="כִּרְסֵם" strong="H3765" x-morph="Vpi3ms" x-gloss="it" x-translit="yəḵarsəm" xml:lang="hbo" x-source-ref="PSA.80.14">יְכַרְסְמֶ֣</char><char style="w" x-id="WLC.PSA.80.13.002" x-align="PSA.80.13.a002" x-target-ids="t009" x-target="it" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5089a" x-morph="Sp3fs" x-gloss="eats.it.away" x-translit="ennāh" xml:lang="hbo" x-source-ref="PSA.80.14">נָּֽה</char> <char style="w" x-id="WLC.PSA.80.13.003" x-align="PSA.80.13.a003" x-target-ids="t001 t002" x-target="The boar" x-target-head="t002" x-head="true" lemma="חֲזִיר" strong="H2386" x-morph="Ncmsa" x-gloss="wild.boar" x-translit="ḥăziyr" xml:lang="hbo" x-source-ref="PSA.80.14">חֲזִ֣יר</char> <char style="w" x-id="WLC.PSA.80.13.004" x-align="PSA.80.13.a004" x-target-ids="t003 t004" x-target="out of" x-target-head="t003" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo" x-source-ref="PSA.80.14">מִ</char><char style="w" x-id="WLC.PSA.80.13.005" x-align="PSA.80.13.a005" x-target-ids="t005 t006" x-target="the wood" x-target-head="t006" x-head="true" lemma="יַעַר" strong="H3293" x-morph="Ncmsa" x-gloss="forest" x-translit="yyāʿar" xml:lang="hbo" x-source-ref="PSA.80.14">יָּ֑עַר</char><char style="w" x-id="WLC.PSA.80.13.006" x-align="PSA.80.13.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.80.14">וְ</char><char style="w" x-id="WLC.PSA.80.13.007" x-align="PSA.80.13.a007" x-target-ids="t011 t012 t013" x-target="the wild beasts" x-target-head="t013" x-head="true" lemma="זִיז" strong="H2123" x-morph="Ncmsc" x-gloss="moving.creature[s]" x-translit="ziyz" xml:lang="h