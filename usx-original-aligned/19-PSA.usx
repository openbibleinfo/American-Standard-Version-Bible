	<para style="p"><verse number="16" style="v" x-ref="PSA.9.16" sid="PSA 9:16" /><char style="w" x-id="WLC.PSA.9.16.001" x-align="PSA.9.16.a001" x-target-ids="t002 t003 t004 t005" x-target="hath made himself known" x-target-head="t005" x-head="true" lemma="יָדַע" strong="H3045" x-morph="VNp3ms" x-gloss="he.has.made.himself.known" x-translit="nôḏaʿ" xml:lang="hbo" x-source-ref="PSA.9.17">נ֤וֹדַ֨ע</char>׀<char style="w" x-id="WLC.PSA.9.16.002" x-align="PSA.9.16.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.9.17">יְהוָה֮</char> <char style="w" x-id="WLC.PSA.9.16.003" x-align="PSA.9.16.a003" x-target-ids="t009" x-target="judgment" x-target-head="t009" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="justice" x-translit="mišpāṭ" xml:lang="hbo" x-source-ref="PSA.9.17">מִשְׁפָּ֪ט</char> <char style="w" x-id="WLC.PSA.9.16.004" x-align="PSA.9.16.a004" x-target-ids="t006 t007 t008" x-target="he hath executed" x-target-head="t008" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3ms" x-gloss="he.has.done" x-translit="ʿāśāh" xml:lang="hbo" x-source-ref="PSA.9.17">עָ֫שָׂ֥ה</char> <char style="w" x-id="WLC.PSA.9.16.005" x-align="PSA.9.16.a005" x-target-ids="t014" x-target="in" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.9.17">בְּ</char><char style="w" x-id="WLC.PSA.9.16.006" x-align="PSA.9.16.a006" x-target-ids="t015 t016" x-target="the work" x-target-head="t016" x-head="true" lemma="פֹּעַל" strong="H6467" x-morph="Ncmsc" x-gloss="the.work" x-translit="p̄ōʿal" xml:lang="hbo" x-source-ref="PSA.9.17">פֹ֣עַל</char> <char style="w" x-id="WLC.PSA.9.16.007" x-align="PSA.9.16.a007" x-target-ids="t017 t020" x-target="of hands" x-target-head="t020" x-head="true" lemma="כַּף" strong="H3709" x-morph="Ncfdc" x-gloss="his.hands" x-tr