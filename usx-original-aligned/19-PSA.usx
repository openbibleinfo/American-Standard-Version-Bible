	<para style="p"><verse number="21" style="v" x-ref="PSA.74.21" sid="PSA 74:21" /><char style="w" x-id="WLC.PSA.74.21.001" x-align="PSA.74.21.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PSA.74.21.002" x-align="PSA.74.21.a002" x-target-ids="t001 t002 t006" x-target="Oh let return" x-target-head="t006" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqj3ms" x-gloss="let.him.turn.back" x-translit="yāšōḇ" xml:lang="hbo">יָשֹׁ֣ב</char> <char style="w" x-id="WLC.PSA.74.21.003" x-align="PSA.74.21.a003" x-target-ids="t004 t005" x-target="the oppressed" x-target-head="t005" x-head="true" lemma="דַּךְ" strong="H1790" x-morph="Aamsa" x-gloss="[the].oppressed" x-translit="daḵ" xml:lang="hbo">דַּ֣ךְ</char> <char style="w" x-id="WLC.PSA.74.21.004" x-align="PSA.74.21.a004" x-target-ids="t007" x-target="ashamed" x-target-head="t007" x-head="true" lemma="כָּלַם" strong="H3637" x-morph="VNrmsa" x-gloss="humiliated" x-translit="niḵlām" xml:lang="hbo">נִכְלָ֑ם</char> <char style="w" x-id="WLC.PSA.74.21.005" x-align="PSA.74.21.a005" x-target-ids="t009 t010" x-target="the poor" x-target-head="t010" x-head="true" lemma="עָנִי" strong="H6041" x-morph="Aamsa" x-gloss="[the].poor" x-translit="ʿāniy" xml:lang="hbo">עָנִ֥י</char> <char style="w" x-id="WLC.PSA.74.21.006" x-align="PSA.74.21.a006" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.74.21.007" x-align="PSA.74.21.a007" x-target-ids="t012" x-target="needy" x-target-head="t012" x-head="true" lemma="אֶבְיוֹן" strong="H34" x-morph="Aamsa" x-gloss="needy" x-translit="ʾeḇyôn" xml:lang="hbo">אֶבְי֗וֹן</char> <char style="w" x-id="WLC.PSA.74.21.008" x-align="PSA.74.21.a008" x-target-ids="t008 t013" x-target="Let praise" x-target-head="t01