	<para style="p"><verse number="18" style="v" x-ref="PSA.37.18" sid="PSA 37:18" /><char style="w" x-id="WLC.PSA.37.18.001" x-align="PSA.37.18.a001" x-target-ids="t002" x-target="knoweth" x-target-head="t002" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqrmsa" x-gloss="[is].knowing" x-translit="yôḏēᵃʿ" xml:lang="hbo">יוֹדֵ֣עַ</char> <char style="w" x-id="WLC.PSA.37.18.002" x-align="PSA.37.18.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.37.18.003" x-align="PSA.37.18.a003" x-target-ids="t003 t004" x-target="the days" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="[the].days" x-translit="yəmēy" xml:lang="hbo">יְמֵ֣י</char> <char style="w" x-id="WLC.PSA.37.18.004" x-align="PSA.37.18.a004" x-target-ids="t005 t006 t007" x-target="of the perfect" x-target-head="t007" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aampa" x-gloss="of.blameless.[people]" x-translit="ṯəmîmim" xml:lang="hbo">תְמִימִ֑ם</char> <char style="w" x-id="WLC.PSA.37.18.005" x-align="PSA.37.18.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.37.18.006" x-align="PSA.37.18.a006" x-target-ids="t010" x-target="inheritance" x-target-head="t010" x-head="true" lemma="נַחֲלָה" strong="H5159" x-morph="Ncfsc" x-gloss="inheritance" x-translit="naḥălāṯ" xml:lang="hbo">נַחֲלָתָ֗</char><char style="w" x-id="WLC.PSA.37.18.007" x-align="PSA.37.18.a007" x-target-ids="t009" x-target="their" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.37.18.008" x-align="PSA.37.18.a008" x-target-ids="t013" x-target="for" x-target-head="t013" x-head="