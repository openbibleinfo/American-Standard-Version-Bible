	<para style="p"><verse number="9" style="v" x-ref="PSA.139.9" x-added-alignments="PSA.139.9.a001 PSA.139.9.a005" x-added-target-ids="t001 t009" x-added-target="If | And" sid="PSA 139:9" /><char style="w" x-id="WLC.PSA.139.9.001" x-align="PSA.139.9.a002" x-target-ids="t002 t003" x-target="I take" x-target-head="t003" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi1cs" x-gloss="I.will.rise.up" x-translit="ʾeśśāʾ" xml:lang="hbo">אֶשָּׂ֥א</char> <char style="w" x-id="WLC.PSA.139.9.002" x-align="PSA.139.9.a003" x-target-ids="t004 t005" x-target="the wings" x-target-head="t005" x-head="true" lemma="כָּנָף" strong="H3671" x-morph="Ncfdc" x-gloss="[the].wings" x-translit="ḵanp̄ê-" xml:lang="hbo">כַנְפֵי</char>־<char style="w" x-id="WLC.PSA.139.9.003" x-align="PSA.139.9.a004" x-target-ids="t006 t007 t008" x-target="of the morning" x-target-head="t008" x-head="true" lemma="שַׁחַר" strong="H7837" x-morph="Ncmsa" x-gloss="of.dawn" x-translit="šāḥar" xml:lang="hbo">שָׁ֑חַר</char> <char style="w" x-id="WLC.PSA.139.9.004" x-align="PSA.139.9.a006" x-target-ids="t010" x-target="dwell" x-target-head="t010" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqh1cs" x-gloss="I.dwell" x-translit="ʾeškənāh" xml:lang="hbo">אֶ֝שְׁכְּנָ֗ה</char> <char style="w" x-id="WLC.PSA.139.9.005" x-align="PSA.139.9.a007" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.139.9.006" x-align="PSA.139.9.a008" x-target-ids="t012 t013 t014" x-target="the uttermost parts" x-target-head="t013" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="end" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִ֥ית</char> <char style="w" x-id="WLC.PSA.139.9.007" x-align="PSA.139.9.a009" x-target-ids="t015 t016 t017" x-target="of the sea" x-target-head="t017" x-head="true" lemma="יָם" strong="H3220" x-morph="Ncmsa" x-gloss="of.[the].sea" x-translit="yām:"