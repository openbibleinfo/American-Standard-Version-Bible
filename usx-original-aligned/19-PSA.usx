	<para style="p"><verse number="20" style="v" x-ref="PSA.147.20" x-added-alignments="PSA.147.20.a009 PSA.147.20.a010" x-added-target-ids="t010 t011 t012" x-added-target="as for | his" sid="PSA 147:20" /><char style="w" x-id="WLC.PSA.147.20.001" x-align="PSA.147.20.a002" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֘א</char> <char style="w" x-id="WLC.PSA.147.20.002" x-align="PSA.147.20.a001" x-target-ids="t001 t002 t004" x-target="He hath dealt" x-target-head="t004" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3ms" x-gloss="he.has.done" x-translit="ʿāśâ" xml:lang="hbo">עָ֤שָׂה</char> <char style="w" x-id="WLC.PSA.147.20.003" x-align="PSA.147.20.a003" x-target-ids="t005" x-target="so" x-target-head="t005" x-head="true" lemma="כֵּן" strong="H3651" x-morph="D" x-gloss="thus" x-translit="ḵēn" xml:lang="hbo">כֵ֨ן</char>׀<char style="w" x-id="WLC.PSA.147.20.004" x-align="PSA.147.20.a004" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.147.20.005" x-align="PSA.147.20.a005" x-target-ids="t007" x-target="any" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="any" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PSA.147.20.006" x-align="PSA.147.20.a006" x-target-ids="t008" x-target="nation" x-target-head="t008" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="nation" x-translit="gôy" xml:lang="hbo">גּ֗וֹי</char> <char style="w" x-id="WLC.PSA.147.20.007" x-align="PSA.147.20.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.147.20.008" x-align="PSA.147.20.a008" x-target-ids="t013" x-target="o