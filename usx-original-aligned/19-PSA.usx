	<para style="p"><verse number="14" style="v" x-ref="PSA.37.14" sid="PSA 37:14" /><char style="w" x-id="WLC.PSA.37.14.001" x-align="PSA.37.14.a001" x-target-ids="t006 t007" x-target="the sword" x-target-head="t007" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="a.sword" x-translit="ḥereḇ" xml:lang="hbo">חֶ֤רֶב</char>׀<char style="w" x-id="WLC.PSA.37.14.002" x-align="PSA.37.14.a002" x-target-ids="t003 t004 t005" x-target="have drawn out" x-target-head="t004" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="Vqp3cp" x-gloss="they.have.drawn" x-translit="pāṯəḥû" xml:lang="hbo">פָּֽתְח֣וּ</char> <char style="w" x-id="WLC.PSA.37.14.003" x-align="PSA.37.14.a003" x-target-ids="t001 t002" x-target="The wicked" x-target-head="t002" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="wicked.[people]" x-translit="rəšāʿîm" xml:lang="hbo">רְשָׁעִים֮</char> <char style="w" x-id="WLC.PSA.37.14.004" x-align="PSA.37.14.a004" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.37.14.005" x-align="PSA.37.14.a005" x-target-ids="t009 t010" x-target="have bent" x-target-head="t010" x-head="true" lemma="דָּרַךְ" strong="H1869" x-morph="Vqp3cp" x-gloss="they.have.bent" x-translit="ḏārəḵû" xml:lang="hbo">דָרְכ֪וּ</char> <char style="w" x-id="WLC.PSA.37.14.006" x-align="PSA.37.14.a006" x-target-ids="t012" x-target="bow" x-target-head="t012" x-head="true" lemma="קֶשֶׁת" strong="H7198" x-morph="Ncfsc" x-gloss="bow" x-translit="qašt" xml:lang="hbo">קַ֫שְׁתָּ֥</char><char style="w" x-id="WLC.PSA.37.14.007" x-align="PSA.37.14.a007" x-target-ids="t011" x-target="their" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.37.14.008" x-align="PSA.37.14.a008" x-target-ids="t013" x-target="To" x-target-head="t01