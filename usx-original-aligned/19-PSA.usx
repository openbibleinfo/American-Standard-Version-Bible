	<para style="p"><verse number="1" style="v" x-ref="PSA.128.1" sid="PSA 128:1" /><char style="w" x-id="WLC.PSA.128.1.001" x-align="PSA.128.1.a001" x-target-ids="t001 t002" x-target="A Song" x-target-head="t002" x-head="true" lemma="שִׁיר" strong="H7892" x-morph="Ncbsc" x-gloss="the.song" x-translit="šiyr" xml:lang="hbo">שִׁ֗יר</char> <char style="w" x-id="WLC.PSA.128.1.002" x-align="PSA.128.1.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo">הַֽ</char><char style="w" x-id="WLC.PSA.128.1.003" x-align="PSA.128.1.a003" x-target-ids="t003 t004" x-target="of Ascents" x-target-head="t004" x-head="true" lemma="מַעֲלָה" strong="H4609" x-morph="Ncfpa" x-gloss="the.ascents" x-translit="mmaʿălôṯ" xml:lang="hbo">מַּ֫עֲל֥וֹת</char><char style="w" x-id="WLC.PSA.128.1.004" x-align="PSA.128.1.a004" x-target-ids="t005 t006" x-target="Blessed is" x-target-head="t005" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrê" xml:lang="hbo">אַ֭שְׁרֵי</char> <char style="w" x-id="WLC.PSA.128.1.005" x-align="PSA.128.1.a005" x-target-ids="t007 t008" x-target="every one" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="[is].every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PSA.128.1.006" x-align="PSA.128.1.a006" x-target-ids="t009 t010" x-target="that feareth" x-target-head="t010" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aamsc" x-gloss="[one].fearing" x-translit="yərēʾ" xml:lang="hbo">יְרֵ֣א</char> <char style="w" x-id="WLC.PSA.128.1.007" x-align="PSA.128.1.a007" x-target-ids="t011" x-target="Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="(of).Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.128.1.008" x-align="PSA.128.1.a008" x-target-ids="t012" x-target="That" x-target-head="t012" x-head="true" lemma="הַ" 