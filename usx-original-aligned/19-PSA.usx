	<para style="p"><verse number="8" style="v" x-ref="PSA.60.8" sid="PSA 60:8" /><char style="w" x-id="WLC.PSA.60.8.001" x-align="PSA.60.8.a001" x-target-ids="t001" x-target="Moab" x-target-head="t001" x-head="true" lemma="מוֹאָב" strong="H4124" x-morph="Np" x-gloss="Moab" x-translit="môʾāḇ" xml:lang="hbo" x-source-ref="PSA.60.10">מוֹאָ֤ב</char>׀<char style="w" x-id="WLC.PSA.60.8.002" x-align="PSA.60.8.a002" x-target-ids="t002 t004" x-target="is washpot" x-target-head="t004" x-head="true" lemma="סִיר" strong="H5518" x-morph="Ncbsc" x-gloss="[is].the.pot" x-translit="siyr" xml:lang="hbo" x-source-ref="PSA.60.10">סִ֬יר</char> <char style="w" x-id="WLC.PSA.60.8.003" x-align="PSA.60.8.a002" lemma="רַחַץ" strong="H7366" x-morph="Ncmsc" x-gloss="my.washing" x-translit="raḥṣ" xml:lang="hbo" x-source-ref="PSA.60.10">רַחְצִ֗</char><char style="w" x-id="WLC.PSA.60.8.004" x-align="PSA.60.8.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.60.10">י</char> <char style="w" x-id="WLC.PSA.60.8.005" x-align="PSA.60.8.a004" x-target-ids="t005" x-target="Upon" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.60.10">עַל</char>־<char style="w" x-id="WLC.PSA.60.8.006" x-align="PSA.60.8.a005" x-target-ids="t006" x-target="Edom" x-target-head="t006" x-head="true" lemma="אֱדוֹם" strong="H123" x-morph="Np" x-gloss="Edom" x-translit="ʾĕḏôm" xml:lang="hbo" x-source-ref="PSA.60.10">אֱ֭דוֹם</char> <char style="w" x-id="WLC.PSA.60.8.007" x-align="PSA.60.8.a006" x-target-ids="t007 t008 t009" x-target="will I cast" x-target-head="t009" x-head="true" lemma="שָׁלַךְ" strong="H7993" x-morph="Vhi1cs" x-gloss="I.throw" x-translit="ʾašliyḵ" xml:lang="hbo" x-source-ref="PSA.60.10">אַשְׁלִ֣יךְ</char> <char style="w" x-id="WLC.PSA.60.8.008" x-align="PSA.60.8.a008" x-target-ids="t011" x-targ