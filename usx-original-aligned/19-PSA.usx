	<para style="p"><verse number="10" style="v" x-ref="PSA.77.10" x-added-alignments="PSA.77.10.a006" x-added-target-ids="t008 t009 t010 t011" x-added-target="But I will remember" sid="PSA 77:10" /><char style="w" x-id="WLC.PSA.77.10.001" x-align="PSA.77.10.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo" x-source-ref="PSA.77.11">וָ֭</char><char style="w" x-id="WLC.PSA.77.10.002" x-align="PSA.77.10.a002" x-target-ids="t002 t003" x-target="I said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw1cs" x-gloss="I.said" x-translit="ʾōmar" xml:lang="hbo" x-source-ref="PSA.77.11">אֹמַר</char> <char style="w" x-id="WLC.PSA.77.10.003" x-align="PSA.77.10.a003" x-target-ids="t005 t007" x-target="is infirmity" x-target-head="t007" x-head="true" lemma="חָלָה" strong="H2490a" x-morph="Vqc" x-gloss="[is].my" x-translit="ḥallôṯ" xml:lang="hbo" x-source-ref="PSA.77.11">חַלּ֣וֹתִ</char><char style="w" x-id="WLC.PSA.77.10.004" x-align="PSA.77.10.a004" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="wounding" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.77.11">י</char> <char style="w" x-id="WLC.PSA.77.10.005" x-align="PSA.77.10.a005" x-target-ids="t004" x-target="This" x-target-head="t004" x-head="true" lemma="הִיא" strong="H1931a" x-morph="Pp3fs" x-gloss="it" x-translit="hiyʾ" xml:lang="hbo" x-source-ref="PSA.77.11">הִ֑יא</char> <char style="w" x-id="WLC.PSA.77.10.006" x-align="PSA.77.10.a007" x-target-ids="t012 t013" x-target="the years" x-target-head="t013" x-head="true" lemma="שָׁנָה" strong="H8138" x-morph="Vqc" x-gloss="the.changing" x-translit="šənôṯ" xml:lang="hbo" x-source-ref="PSA.77.11">שְׁ֝נ֗וֹת</char> <char style="w" x-id="WLC.PSA.77.10.007" x-align="PSA.77.10.a008" x-target-ids="t014 t015 t016 t017" x-target="of the right hand" x-target-head="t017" x-head="true