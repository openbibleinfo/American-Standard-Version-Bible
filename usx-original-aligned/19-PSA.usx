	<para style="p"><verse number="3" style="v" x-ref="PSA.8.3" sid="PSA 8:3" /><char style="w" x-id="WLC.PSA.8.3.001" x-align="PSA.8.3.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.8.4">כִּֽי</char>־<char style="w" x-id="WLC.PSA.8.3.002" x-align="PSA.8.3.a002" x-target-ids="t002 t003" x-target="I consider" x-target-head="t003" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqi1cs" x-gloss="I.will.see" x-translit="ʾerʾeh" xml:lang="hbo" x-source-ref="PSA.8.4">אֶרְאֶ֣ה</char> <char style="w" x-id="WLC.PSA.8.3.003" x-align="PSA.8.3.a003" x-target-ids="t005" x-target="heavens" x-target-head="t005" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpc" x-gloss="heavens" x-translit="šāmey" xml:lang="hbo" x-source-ref="PSA.8.4">שָׁ֭מֶי</char><char style="w" x-id="WLC.PSA.8.3.004" x-align="PSA.8.3.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.8.4">ךָ</char> <char style="w" x-id="WLC.PSA.8.3.005" x-align="PSA.8.3.a005" x-target-ids="t006 t007" x-target="the work" x-target-head="t007" x-head="true" lemma="מַעֲשֶׂה" strong="H4639" x-morph="Ncmpc" x-gloss="the.works" x-translit="maʿăśēy" xml:lang="hbo" x-source-ref="PSA.8.4">מַעֲשֵׂ֣י</char> <char style="w" x-id="WLC.PSA.8.3.006" x-align="PSA.8.3.a006" x-target-ids="t008 t010" x-target="of fingers" x-target-head="t010" x-head="true" lemma="אֶצְבַּע" strong="H676" x-morph="Ncfpc" x-gloss="fingers" x-translit="ʾeṣbəʿōṯey" xml:lang="hbo" x-source-ref="PSA.8.4">אֶצְבְּעֹתֶ֑י</char><char style="w" x-id="WLC.PSA.8.3.007" x-align="PSA.8.3.a007" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.8.4">ךָ</char> <char style="w" x-i