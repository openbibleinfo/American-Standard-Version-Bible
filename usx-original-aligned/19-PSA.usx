	<para style="p"><verse number="4" style="v" x-ref="PSA.34.4" sid="PSA 34:4" /><char style="w" x-id="WLC.PSA.34.4.001" x-align="PSA.34.4.a001" x-target-ids="t001 t002" x-target="I sought" x-target-head="t002" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqp1cs" x-gloss="I.sought" x-translit="dārašətî" xml:lang="hbo" x-source-ref="PSA.34.5">דָּרַ֣שְׁתִּי</char> <char style="w" x-id="WLC.PSA.34.4.002" x-align="PSA.34.4.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="PSA.34.5">אֶת</char>־<char style="w" x-id="WLC.PSA.34.4.003" x-align="PSA.34.4.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.34.5">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.34.4.004" x-align="PSA.34.4.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.34.5">וְ</char><char style="w" x-id="WLC.PSA.34.4.005" x-align="PSA.34.4.a005" x-target-ids="t005 t006" x-target="he answered" x-target-head="t006" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqp3ms" x-gloss="he" x-translit="ʿān" xml:lang="hbo" x-source-ref="PSA.34.5">עָנָ֑</char><char style="w" x-id="WLC.PSA.34.4.006" x-align="PSA.34.4.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="answered.me" x-translit="āniy" xml:lang="hbo" x-source-ref="PSA.34.5">נִי</char> <char style="w" x-id="WLC.PSA.34.4.007" x-align="PSA.34.4.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.34.5">וּ</char><char style="w" x-id="WLC.PSA.34.4.008" x-align="PSA.34.4.a008" x-target-ids="t011" x-targ