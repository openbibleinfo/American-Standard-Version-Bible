	<para style="p"><verse number="5" style="v" x-ref="PSA.119.5" sid="PSA 119:5" /><char style="w" x-id="WLC.PSA.119.5.001" x-align="PSA.119.5.a001" x-target-ids="t001 t002" x-target="Oh that" x-target-head="t002" x-head="true" lemma="אַחֲלַי" strong="H305" x-morph="Tj" x-gloss="would.that!" x-translit="ʾaḥălay" xml:lang="hbo">אַ֭חֲלַי</char> <char style="w" x-id="WLC.PSA.119.5.002" x-align="PSA.119.5.a004" x-target-ids="t005 t006" x-target="were established" x-target-head="t006" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNi3mp" x-gloss="they.will.be.steadfast" x-translit="yikkōnû" xml:lang="hbo">יִכֹּ֥נוּ</char> <char style="w" x-id="WLC.PSA.119.5.003" x-align="PSA.119.5.a003" x-target-ids="t004" x-target="ways" x-target-head="t004" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="ḏərāḵ" xml:lang="hbo">דְרָכָ֗</char><char style="w" x-id="WLC.PSA.119.5.004" x-align="PSA.119.5.a002" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.5.005" x-align="PSA.119.5.a005" x-target-ids="t007" x-target="To" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.119.5.006" x-align="PSA.119.5.a006" x-target-ids="t008" x-target="observe" x-target-head="t008" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqc" x-gloss="keep" x-translit="šəmōr" xml:lang="hbo">שְׁמֹ֥ר</char> <char style="w" x-id="WLC.PSA.119.5.007" x-align="PSA.119.5.a008" x-target-ids="t010" x-target="statutes" x-target-head="t010" x-head="true" lemma="חֹק" strong="H2706" x-morph="Ncmpc" x-gloss="decrees" x-translit="ḥuqqey" xml:lang="hbo">חֻקֶּֽי</char><char style="w" x-id="WLC.PSA.119.5.008" x-align="PSA.119.5.a007" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" 