	<para style="p"><verse number="3" style="v" x-ref="PSA.83.3" sid="PSA 83:3" /><char style="w" x-id="WLC.PSA.83.3.001" x-align="PSA.83.3.a001" x-target-ids="t005" x-target="against" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.83.4">עַֽל</char>־<char style="w" x-id="WLC.PSA.83.3.002" x-align="PSA.83.3.a002" x-target-ids="t007" x-target="people" x-target-head="t007" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="PSA.83.4">עַ֭מְּ</char><char style="w" x-id="WLC.PSA.83.3.003" x-align="PSA.83.3.a003" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.83.4">ךָ</char> <char style="w" x-id="WLC.PSA.83.3.004" x-align="PSA.83.3.a004" x-target-ids="t001 t002 t003" x-target="They take crafty" x-target-head="t003" x-head="true" lemma="עָרֹם" strong="H6191" x-morph="Vhi3mp" x-gloss="they.make.crafty" x-translit="yaʿăriymû" xml:lang="hbo" x-source-ref="PSA.83.4">יַעֲרִ֣ימוּ</char> <char style="w" x-id="WLC.PSA.83.3.005" x-align="PSA.83.3.a005" x-target-ids="t004" x-target="counsel" x-target-head="t004" x-head="true" lemma="סוֹד" strong="H5475" x-morph="Ncmsa" x-gloss="counsel" x-translit="sôḏ" xml:lang="hbo" x-source-ref="PSA.83.4">ס֑וֹד</char> <char style="w" x-id="WLC.PSA.83.3.006" x-align="PSA.83.3.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.83.4">וְ֝</char><char style="w" x-id="WLC.PSA.83.3.007" x-align="PSA.83.3.a007" x-target-ids="t009 t010" x-target="consult together" x-target-head="t009" x-head="true" lemma="יָעַץ" strong="H3289" x-morph="Vti3mp" x-gloss="they.consult.together" x-translit="yiṯyāʿăṣû" xml:lang="hbo" x-source-ref="PSA.83.4">יִתְיָעֲצ֗ו