	<para style="p"><verse number="5" style="v" x-ref="PSA.61.5" x-added-alignments="PSA.61.5.a009" x-added-target-ids="t012" x-added-target="me" sid="PSA 61:5" /><char style="w" x-id="WLC.PSA.61.5.001" x-align="PSA.61.5.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.61.6">כִּֽי</char>־<char style="w" x-id="WLC.PSA.61.5.002" x-align="PSA.61.5.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.61.6">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.61.5.003" x-align="PSA.61.5.a003" x-target-ids="t003 t004" x-target="O God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.61.6">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.61.5.004" x-align="PSA.61.5.a004" x-target-ids="t005 t006" x-target="hast heard" x-target-head="t006" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp2ms" x-gloss="you.have.listened" x-translit="šāmaʿətā" xml:lang="hbo" x-source-ref="PSA.61.6">שָׁמַ֣עְתָּ</char> <char style="w" x-id="WLC.PSA.61.5.005" x-align="PSA.61.5.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo" x-source-ref="PSA.61.6">לִ</char><char style="w" x-id="WLC.PSA.61.5.006" x-align="PSA.61.5.a006" x-target-ids="t008" x-target="vows" x-target-head="t008" x-head="true" lemma="נֶדֶר" strong="H5088" x-morph="Ncmpc" x-gloss="vows" x-translit="nəḏār" xml:lang="hbo" x-source-ref="PSA.61.6">נְדָרָ֑</char><char style="w" x-id="WLC.PSA.61.5.007" x-align="PSA.61.5.a007" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.61.6"