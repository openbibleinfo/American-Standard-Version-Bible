	<para style="d" x-ref="PSA.5.0"><char style="w" x-id="WLC.PSA.5.0.001" x-align="PSA.5.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.5.1">לַ</char><char style="w" x-id="WLC.PSA.5.0.002" x-align="PSA.5.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.5.1">[הַ]</char><char style="w" x-id="WLC.PSA.5.0.003" x-align="PSA.5.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t003" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēᵃḥ" xml:lang="hbo" x-source-ref="PSA.5.1">מְנַצֵּ֥חַ</char> <char style="w" x-id="WLC.PSA.5.0.004" x-align="PSA.5.0.a004" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo" x-source-ref="PSA.5.1">אֶֽל</char>־<char style="w" x-id="WLC.PSA.5.0.005" x-align="PSA.5.0.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.5.1">הַ</char><char style="w" x-id="WLC.PSA.5.0.006" x-align="PSA.5.0.a006" x-target-ids="t007" x-target="Nehiloth" x-target-head="t007" x-head="true" lemma="נְחִילֹות" strong="H5155" x-morph="Np" x-gloss="flutes" x-translit="nnəḥîlôṯ" xml:lang="hbo" x-source-ref="PSA.5.1">נְּחִיל֗וֹת</char> <char style="w" x-id="WLC.PSA.5.0.007" x-align="PSA.5.0.a007" x-target-ids="t008 t009" x-target="A Psalm" x-target-head="t009" x-head="true" lemma="מִזְמוֹר" strong="H4210" x-morph="Ncmsa" x-gloss="a.psalm" x-translit="mizmôr" xml:lang="hbo" x-source-ref="PSA.5.1">מִזְמ֥וֹר</char> <char style="w" x-id="WLC.PSA.5.0.008" x-align="PSA.5.0.a008" x-target-ids="t010" x-target="of" x-target-head