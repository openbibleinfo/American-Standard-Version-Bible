	<para style="p"><verse number="18" style="v" x-ref="PSA.74.18" x-added-alignments="PSA.74.18.a003" x-added-target-ids="t003" x-added-target="that" sid="PSA 74:18" /><char style="w" x-id="WLC.PSA.74.18.001" x-align="PSA.74.18.a001" x-target-ids="t001" x-target="Remember" x-target-head="t001" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqv2ms" x-gloss="remember" x-translit="zəḵār-" xml:lang="hbo">זְכָר</char>־<char style="w" x-id="WLC.PSA.74.18.002" x-align="PSA.74.18.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="זֹאת" strong="H2063" x-morph="Pdxfs" x-gloss="this" x-translit="zōʾṯ" xml:lang="hbo">זֹ֗את</char> <char style="w" x-id="WLC.PSA.74.18.003" x-align="PSA.74.18.a004" x-target-ids="t004 t005" x-target="the enemy" x-target-head="t005" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmsa" x-gloss="[the].enemy" x-translit="ʾôyēḇ" xml:lang="hbo">א֭וֹיֵב</char> <char style="w" x-id="WLC.PSA.74.18.004" x-align="PSA.74.18.a005" x-target-ids="t006 t007" x-target="hath reproached" x-target-head="t007" x-head="true" lemma="חָרַף" strong="H2778" x-morph="Vpp3ms" x-gloss="he.taunted" x-translit="ḥērēp̄" xml:lang="hbo">חֵרֵ֣ף</char>׀<char style="w" x-id="WLC.PSA.74.18.005" x-align="PSA.74.18.a006" x-target-ids="t008 t009" x-target="O Jehovah" x-target-head="t009" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.74.18.006" x-align="PSA.74.18.a007" x-target-ids="t010 t011" x-target="And that" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.74.18.007" x-align="PSA.74.18.a008" x-target-ids="t012 t014" x-target="a people" x-target-head="t014" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿam" xml:lang="hbo">עַ֥ם</char> <char style="w" x-id="WLC.PSA.74.18.008" x-align="PSA.74.1