	<para style="p"><verse number="7" style="v" x-ref="PSA.61.7" x-added-alignments="PSA.61.7.a009" x-added-target-ids="t013" x-added-target="that" sid="PSA 61:7" /><char style="w" x-id="WLC.PSA.61.7.001" x-align="PSA.61.7.a001" x-target-ids="t001 t002 t003" x-target="He shall abide" x-target-head="t003" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi3ms" x-gloss="may.he.sit" x-translit="yēšēḇ" xml:lang="hbo" x-source-ref="PSA.61.8">יֵשֵׁ֣ב</char> <char style="w" x-id="WLC.PSA.61.7.002" x-align="PSA.61.7.a002" x-target-ids="t006 t007" x-target="for ever" x-target-head="t007" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="forever" x-translit="ʿôlām" xml:lang="hbo" x-source-ref="PSA.61.8">ע֭וֹלָם</char> <char style="w" x-id="WLC.PSA.61.7.003" x-align="PSA.61.7.a003" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="li" xml:lang="hbo" x-source-ref="PSA.61.8">לִ</char><char style="w" x-id="WLC.PSA.61.7.004" x-align="PSA.61.7.a003" x-target-ids="t004" x-target="before" x-target-head="t004" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ənēy" xml:lang="hbo" x-source-ref="PSA.61.8">פְנֵ֣י</char> <char style="w" x-id="WLC.PSA.61.7.005" x-align="PSA.61.7.a004" x-target-ids="t005" x-target="God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.61.8">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.61.7.006" x-align="PSA.61.7.a005" x-target-ids="t010" x-target="lovingkindness" x-target-head="t010" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsa" x-gloss="covenant.loyalty" x-translit="ḥeseḏ" xml:lang="hbo" x-source-ref="PSA.61.8">חֶ֥סֶד</char> <char style="w" x-id="WLC.PSA.61.7.007" x-align="PSA.61.7.a006" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="we" xml:lang="hbo" x-source-ref="PSA.61.8">וֶ֝</char><char s