	<para style="p"><verse number="1" style="v" x-ref="PSA.46.1" sid="PSA 46:1" /><char style="w" x-id="WLC.PSA.46.1.001" x-align="PSA.46.1.a001" x-target-ids="t001" x-target="God" x-target-head="t001" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.46.2">אֱלֹהִ֣ים</char> <char style="w" x-id="WLC.PSA.46.1.002" x-align="PSA.46.1.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lā" xml:lang="hbo" x-source-ref="PSA.46.2">לָ֭</char><char style="w" x-id="WLC.PSA.46.1.003" x-align="PSA.46.1.a003" x-target-ids="t003" x-target="our" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="nû" xml:lang="hbo" x-source-ref="PSA.46.2">נוּ</char> <char style="w" x-id="WLC.PSA.46.1.004" x-align="PSA.46.1.a004" x-target-ids="t002 t004" x-target="is refuge" x-target-head="t004" x-head="true" lemma="מַחְסֶּה" strong="H4268" x-morph="Ncmsa" x-gloss="[is].a.refuge" x-translit="maḥăseh" xml:lang="hbo" x-source-ref="PSA.46.2">מַחֲסֶ֣ה</char> <char style="w" x-id="WLC.PSA.46.1.005" x-align="PSA.46.1.a005" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo" x-source-ref="PSA.46.2">וָ</char><char style="w" x-id="WLC.PSA.46.1.006" x-align="PSA.46.1.a006" x-target-ids="t006" x-target="strength" x-target-head="t006" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsa" x-gloss="strength" x-translit="ʿōz" xml:lang="hbo" x-source-ref="PSA.46.2">עֹ֑ז</char> <char style="w" x-id="WLC.PSA.46.1.007" x-align="PSA.46.1.a007" x-target-ids="t007 t010" x-target="A help" x-target-head="t010" x-head="true" lemma="עֶזְרָה" strong="H5833" x-morph="Ncfsa" x-gloss="a.help" x-translit="ʿezrāh" xml:lang="hbo" x-source-ref="PSA.46.2">עֶזְרָ֥ה</char> <char style="w" x-id="WLC.PSA.46.1.008" x-align="PSA.46.1.a008" x-target-id