	<para style="p"><verse number="15" style="v" x-ref="PSA.9.15" sid="PSA 9:15" /><char style="w" x-id="WLC.PSA.9.15.001" x-align="PSA.9.15.a001" x-target-ids="t003 t004 t005" x-target="are sunk down" x-target-head="t004" x-head="true" lemma="טָבַע" strong="H2883" x-morph="Vqp3cp" x-gloss="they.have.sunk" x-translit="ṭāḇʿû" xml:lang="hbo" x-source-ref="PSA.9.16">טָבְע֣וּ</char> <char style="w" x-id="WLC.PSA.9.15.002" x-align="PSA.9.15.a002" x-target-ids="t001 t002" x-target="The nations" x-target-head="t002" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="ḡôyim" xml:lang="hbo" x-source-ref="PSA.9.16">ג֭וֹיִם</char> <char style="w" x-id="WLC.PSA.9.15.003" x-align="PSA.9.15.a003" x-target-ids="t006 t007" x-target="in the" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.9.16">בְּ</char><char style="w" x-id="WLC.PSA.9.15.004" x-align="PSA.9.15.a004" x-target-ids="t008" x-target="pit" x-target-head="t008" x-head="true" lemma="שַׁחַת" strong="H7845" x-morph="Ncfsa" x-gloss="pit" x-translit="šaḥaṯ" xml:lang="hbo" x-source-ref="PSA.9.16">שַׁ֣חַת</char> <char style="w" x-id="WLC.PSA.9.15.005" x-align="PSA.9.15.a005" x-target-ids="t009 t010 t011" x-target="that they made" x-target-head="t011" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3cp" x-gloss="[which].they.made" x-translit="ʿāśû" xml:lang="hbo" x-source-ref="PSA.9.16">עָשׂ֑וּ</char> <char style="w" x-id="WLC.PSA.9.15.006" x-align="PSA.9.15.a006" x-target-ids="t012 t013" x-target="In the" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.9.16">בְּ</char><char style="w" x-id="WLC.PSA.9.15.007" x-align="PSA.9.15.a007" x-target-ids="t014" x-target="net" x-target-head="t014" x-head="true" lemma="רֶשֶׁת" strong="H7568" x-morph="Ncfsa" x-gloss="net" x-translit="rešeṯ-" xml:lang="hbo" x-source-r