	<para style="p"><verse number="8" style="v" x-ref="PSA.95.8" sid="PSA 95:8" /><char style="w" x-id="WLC.PSA.95.8.001" x-align="PSA.95.8.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PSA.95.8.002" x-align="PSA.95.8.a002" x-target-ids="t001" x-target="Harden" x-target-head="t001" x-head="true" lemma="קָשָׁה" strong="H7185" x-morph="Vhj2mp" x-gloss="harden" x-translit="taqšû" xml:lang="hbo">תַּקְשׁ֣וּ</char> <char style="w" x-id="WLC.PSA.95.8.003" x-align="PSA.95.8.a003" x-target-ids="t004" x-target="heart" x-target-head="t004" x-head="true" lemma="לֵבָב" strong="H3824" x-morph="Ncmsc" x-gloss="heart" x-translit="ləḇaḇ" xml:lang="hbo">לְ֭בַבְ</char><char style="w" x-id="WLC.PSA.95.8.004" x-align="PSA.95.8.a004" x-target-ids="t003" x-target="your" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="əḵem" xml:lang="hbo">כֶם</char> <char style="w" x-id="WLC.PSA.95.8.005" x-align="PSA.95.8.a005" x-target-ids="t005 t006" x-target="as at" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.PSA.95.8.006" x-align="PSA.95.8.a006" x-target-ids="t007" x-target="Meribah" x-target-head="t007" x-head="true" lemma="מְרִיבָה" strong="H4809" x-morph="Np" x-gloss="Meribah" x-translit="mərîḇāh" xml:lang="hbo">מְרִיבָ֑ה</char> <char style="w" x-id="WLC.PSA.95.8.007" x-align="PSA.95.8.a007" x-target-ids="t008 t009" x-target="As in" x-target-head="t008" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.PSA.95.8.008" x-align="PSA.95.8.a008" x-target-ids="t010 t011" x-target="the day" x-target-head="t011" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsc" x-gloss="the.day" x-translit="yôm" 