	<para style="p"><verse number="3" style="v" x-ref="PSA.65.3" x-added-alignments="PSA.65.3.a005" x-added-target-ids="t005 t006" x-added-target="As for" sid="PSA 65:3" /><char style="w" x-id="WLC.PSA.65.3.001" x-align="PSA.65.3.a001" lemma="דָּבָר" strong="H1697" x-morph="Ncmpc" x-gloss="things" x-translit="diḇrēy" xml:lang="hbo" x-source-ref="PSA.65.4">דִּבְרֵ֣י</char> <char style="w" x-id="WLC.PSA.65.3.002" x-align="PSA.65.3.a001" x-target-ids="t001" x-target="Iniquities" x-target-head="t001" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbpa" x-gloss="of.iniquities" x-translit="ʿăwōnōṯ" xml:lang="hbo" x-source-ref="PSA.65.4">עֲ֭וֺנֹת</char> <char style="w" x-id="WLC.PSA.65.3.003" x-align="PSA.65.3.a002" x-target-ids="t002" x-target="prevail" x-target-head="t002" x-head="true" lemma="גָּבַר" strong="H1396" x-morph="Vqp3cp" x-gloss="they.are.[too].strong" x-translit="gāḇərû" xml:lang="hbo" x-source-ref="PSA.65.4">גָּ֣בְרוּ</char> <char style="w" x-id="WLC.PSA.65.3.004" x-align="PSA.65.3.a003" x-target-ids="t003" x-target="against" x-target-head="t003" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="for" x-translit="menn" xml:lang="hbo" x-source-ref="PSA.65.4">מֶ֑נִּ</char><char style="w" x-id="WLC.PSA.65.3.005" x-align="PSA.65.3.a004" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.65.4">י</char> <char style="w" x-id="WLC.PSA.65.3.006" x-align="PSA.65.3.a006" x-target-ids="t008" x-target="transgressions" x-target-head="t008" x-head="true" lemma="פֶּשַׁע" strong="H6588" x-morph="Ncmpc" x-gloss="transgressions" x-translit="pəšāʿēy" xml:lang="hbo" x-source-ref="PSA.65.4">פְּ֝שָׁעֵ֗י</char><char style="w" x-id="WLC.PSA.65.3.007" x-align="PSA.65.3.a007" x-target-ids="t007" x-target="our" x-target-head="t007" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="nû" xml:lang="hbo" x-source-ref="