	<para style="p"><verse number="2" style="v" x-ref="PSA.15.2" sid="PSA 15:2" /><char style="w" x-id="WLC.PSA.15.2.001" x-align="PSA.15.2.a001" x-target-ids="t001 t002 t003" x-target="He that walketh" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[one.who].walks" x-translit="hôlēḵ" xml:lang="hbo">הוֹלֵ֣ךְ</char> <char style="w" x-id="WLC.PSA.15.2.002" x-align="PSA.15.2.a002" x-target-ids="t004" x-target="uprightly" x-target-head="t004" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aamsa" x-gloss="blameless" x-translit="tāmîm" xml:lang="hbo">תָּ֭מִים</char> <char style="w" x-id="WLC.PSA.15.2.003" x-align="PSA.15.2.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PSA.15.2.004" x-align="PSA.15.2.a004" x-target-ids="t006" x-target="worketh" x-target-head="t006" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqrmsa" x-gloss="[one.who].does" x-translit="p̄ōʿēl" xml:lang="hbo">פֹעֵ֥ל</char> <char style="w" x-id="WLC.PSA.15.2.005" x-align="PSA.15.2.a005" x-target-ids="t007" x-target="righteousness" x-target-head="t007" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="righteousness" x-translit="ṣeḏeq" xml:lang="hbo">צֶ֑דֶק</char> <char style="w" x-id="WLC.PSA.15.2.006" x-align="PSA.15.2.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.15.2.007" x-align="PSA.15.2.a007" x-target-ids="t009" x-target="speaketh" x-target-head="t009" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vqrmsa" x-gloss="[one.who].speaks" x-translit="ḏōḇēr" xml:lang="hbo">דֹבֵ֥ר</char> <char style="w" x-id="WLC.PSA.15.2.008" x-align="PSA.15.2.a008" x-target-ids="t010" x-target="truth" x-target-head="t010" x-head="true" lemma="אֱמֶת" st