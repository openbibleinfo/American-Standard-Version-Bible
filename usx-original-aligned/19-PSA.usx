	<para style="p"><verse number="12" style="v" x-ref="PSA.66.12" sid="PSA 66:12" /><char style="w" x-id="WLC.PSA.66.12.001" x-align="PSA.66.12.a001" x-target-ids="t001 t002 t003 t005 t006" x-target="Thou didst cause to ride" x-target-head="t006" x-head="true" lemma="רָכַב" strong="H7392" x-morph="Vhp2ms" x-gloss="you.have.made.ride" x-translit="hirkaḇətā" xml:lang="hbo">הִרְכַּ֥בְתָּ</char> <char style="w" x-id="WLC.PSA.66.12.002" x-align="PSA.66.12.a002" x-target-ids="t004" x-target="men" x-target-head="t004" x-head="true" lemma="אֱנוֹשׁ" strong="H582" x-morph="Ncmsa" x-gloss="a.man" x-translit="ʾĕnôš" xml:lang="hbo">אֱנ֗וֹשׁ</char> <char style="w" x-id="WLC.PSA.66.12.003" x-align="PSA.66.12.a003" x-target-ids="t007" x-target="over" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.66.12.004" x-align="PSA.66.12.a004" x-target-ids="t009" x-target="heads" x-target-head="t009" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsc" x-gloss="head" x-translit="rōʾš" xml:lang="hbo">רֹ֫אשֵׁ֥</char><char style="w" x-id="WLC.PSA.66.12.005" x-align="PSA.66.12.a005" x-target-ids="t008" x-target="our" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.PSA.66.12.006" x-align="PSA.66.12.a006" x-target-ids="t010 t011" x-target="We went" x-target-head="t011" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqp1cp" x-gloss="we.have.gone" x-translit="bāʾnû-" xml:lang="hbo">בָּֽאנוּ</char>־<char style="w" x-id="WLC.PSA.66.12.007" x-align="PSA.66.12.a007" x-target-ids="t012" x-target="through" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ḇā" xml:lang="hbo">בָ</char><char style="w" x-id="WLC.PSA.66.12.008" x-align="PSA.66.12.a008" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gl