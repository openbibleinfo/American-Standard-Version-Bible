	<para style="p"><verse number="30" style="v" x-ref="PSA.107.30" sid="PSA 107:30" /><char style="w" x-id="WLC.PSA.107.30.001" x-align="PSA.107.30.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.107.30.002" x-align="PSA.107.30.a002" x-target-ids="t002 t003 t004" x-target="are they glad" x-target-head="t004" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqw3mp" x-gloss="they.rejoiced" x-translit="yyiśməḥû" xml:lang="hbo">יִּשְׂמְח֥וּ</char> <char style="w" x-id="WLC.PSA.107.30.003" x-align="PSA.107.30.a003" x-target-ids="t005" x-target="because" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="ḵiy-" xml:lang="hbo">כִֽי</char>־<char style="w" x-id="WLC.PSA.107.30.004" x-align="PSA.107.30.a004" x-target-ids="t006 t007 t008" x-target="they are quiet" x-target-head="t008" x-head="true" lemma="שָׁתַק" strong="H8367" x-morph="Vqi3mp" x-gloss="they.were.quiet" x-translit="yištōqû" xml:lang="hbo">יִשְׁתֹּ֑קוּ</char> <char style="w" x-id="WLC.PSA.107.30.005" x-align="PSA.107.30.a005" x-target-ids="t009" x-target="So" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝</char><char style="w" x-id="WLC.PSA.107.30.006" x-align="PSA.107.30.a006" x-target-ids="t010 t011" x-target="he bringeth" x-target-head="t011" x-head="true" lemma="נָחָה" strong="H5148" x-morph="Vhw3ms" x-gloss="he" x-translit="yyanḥ" xml:lang="hbo">יַּנְחֵ֗</char><char style="w" x-id="WLC.PSA.107.30.007" x-align="PSA.107.30.a007" x-target-ids="t012" x-target="them" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="guided.them" x-translit="ēm" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.107.30.008" x-align="PSA.107.30.a008" x-target-ids="t013" x-target="unto" x-target-head="t013" x-head=