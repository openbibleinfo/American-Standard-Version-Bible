	<para style="p"><verse number="72" style="v" x-ref="PSA.119.72" x-added-alignments="PSA.119.72.a012" x-added-target-ids="t016 t017" x-added-target="י Yodh" sid="PSA 119:72" /><char style="w" x-id="WLC.PSA.119.72.001" x-align="PSA.119.72.a001" x-target-ids="t006 t007" x-target="is better" x-target-head="t007" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ-" xml:lang="hbo">טֽוֹב</char>־<char style="w" x-id="WLC.PSA.119.72.002" x-align="PSA.119.72.a002" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֥</char><char style="w" x-id="WLC.PSA.119.72.003" x-align="PSA.119.72.a003" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.72.004" x-align="PSA.119.72.a004" x-target-ids="t001 t002" x-target="The law" x-target-head="t002" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="the.law" x-translit="ṯôraṯ-" xml:lang="hbo">תֽוֹרַת</char>־<char style="w" x-id="WLC.PSA.119.72.005" x-align="PSA.119.72.a005" x-target-ids="t003 t005" x-target="of mouth" x-target-head="t005" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="your.mouth" x-translit="piy" xml:lang="hbo">פִּ֑י</char><char style="w" x-id="WLC.PSA.119.72.006" x-align="PSA.119.72.a006" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.72.007" x-align="PSA.119.72.a007" x-target-ids="t010" x-target="Than" x-target-head="t010" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mē" xml:lang="hbo">מֵ֝</char><char style="w" x-id="WLC.PSA.119.72.008" x-align="PSA.119.72.a008" x-target-ids="t011" x-target="thousands