	<para style="p"><verse number="14" style="v" x-ref="PSA.91.14" sid="PSA 91:14" /><char style="w" x-id="WLC.PSA.91.14.001" x-align="PSA.91.14.a001" x-target-ids="t001" x-target="Because" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PSA.91.14.002" x-align="PSA.91.14.a002" x-target-ids="t007" x-target="upon" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in)" x-translit="ḇ" xml:lang="hbo">בִ֣</char><char style="w" x-id="WLC.PSA.91.14.003" x-align="PSA.91.14.a003" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.91.14.004" x-align="PSA.91.14.a004" x-target-ids="t002 t003 t004 t005 t006" x-target="he hath set his love" x-target-head="t006" x-head="true" lemma="חָשַׁק" strong="H2836" x-morph="Vqp3ms" x-gloss="he.loves" x-translit="ḥāšaq" xml:lang="hbo">חָ֭שַׁק</char> <char style="w" x-id="WLC.PSA.91.14.005" x-align="PSA.91.14.a005" x-target-ids="t009" x-target="therefore" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.91.14.006" x-align="PSA.91.14.a006" x-target-ids="t010 t011 t012" x-target="will I deliver" x-target-head="t012" x-head="true" lemma="פָּלַט" strong="H6403" x-morph="Vpi1cs" x-gloss="I" x-translit="ʾăp̄alləṭ" xml:lang="hbo">אֲפַלְּטֵ֑</char><char style="w" x-id="WLC.PSA.91.14.007" x-align="PSA.91.14.a007" x-target-ids="t013" x-target="him" x-target-head="t013" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="will.deliver.him" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PSA.91.14.008" x-align="PSA.91.14.a008" x-target-ids="t014 t015 t016 t018 t019" x-target="I will set on high" x-target-head="t019" x-head="true