	<para style="p"><verse number="4" style="v" x-ref="PSA.46.4" sid="PSA 46:4" /><char style="w" x-id="WLC.PSA.46.4.001" x-align="PSA.46.4.a001" x-target-ids="t001 t002 t003 t004" x-target="There is a river" x-target-head="t004" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmsa" x-gloss="a.river" x-translit="nāhār" xml:lang="hbo" x-source-ref="PSA.46.5">נָהָ֗ר</char> <char style="w" x-id="WLC.PSA.46.4.002" x-align="PSA.46.4.a002" x-target-ids="t005 t006" x-target="the streams" x-target-head="t006" x-head="true" lemma="פֶּלֶג" strong="H6388" x-morph="Ncmpc" x-gloss="streams" x-translit="pəlāḡāy" xml:lang="hbo" x-source-ref="PSA.46.5">פְּלָגָ֗י</char><char style="w" x-id="WLC.PSA.46.4.003" x-align="PSA.46.4.a003" x-target-ids="t007" x-target="whereof" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="its" x-translit="w" xml:lang="hbo" x-source-ref="PSA.46.5">ו</char> <char style="w" x-id="WLC.PSA.46.4.004" x-align="PSA.46.4.a004" x-target-ids="t008 t009" x-target="make glad" x-target-head="t009" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vpi3mp" x-gloss="they.make.glad" x-translit="yəśamməḥû" xml:lang="hbo" x-source-ref="PSA.46.5">יְשַׂמְּח֥וּ</char> <char style="w" x-id="WLC.PSA.46.4.005" x-align="PSA.46.4.a005" x-target-ids="t010 t011" x-target="the city" x-target-head="t011" x-head="true" lemma="עִיר" strong="H5892" x-morph="Ncfsc" x-gloss="the.city" x-translit="ʿîr-" xml:lang="hbo" x-source-ref="PSA.46.5">עִיר</char>־<char style="w" x-id="WLC.PSA.46.4.006" x-align="PSA.46.4.a006" x-target-ids="t012 t013" x-target="of God" x-target-head="t013" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="of.God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="PSA.46.5">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.PSA.46.4.007" x-align="PSA.46.4.a007" x-target-ids="t014 t015 t016" x-target="The holy place" x-target-head="t015" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aamsc" x-gloss="the.hol