	<para style="p"><verse number="7" style="v" x-ref="PSA.57.7" sid="PSA 57:7" /><char style="w" x-id="WLC.PSA.57.7.001" x-align="PSA.57.7.a003" x-target-ids="t003 t004" x-target="is fixed" x-target-head="t004" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNrmsa" x-gloss="[is].steadfast" x-translit="nāḵôn" xml:lang="hbo" x-source-ref="PSA.57.8">נָ֘כ֤וֹן</char> <char style="w" x-id="WLC.PSA.57.7.002" x-align="PSA.57.7.a002" x-target-ids="t002" x-target="heart" x-target-head="t002" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo" x-source-ref="PSA.57.8">לִבִּ֣</char><char style="w" x-id="WLC.PSA.57.7.003" x-align="PSA.57.7.a001" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.57.8">י</char> <char style="w" x-id="WLC.PSA.57.7.004" x-align="PSA.57.7.a004" x-target-ids="t005 t006" x-target="O God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="O.God" x-translit="ʾĕlōhîm" xml:lang="hbo" x-source-ref="PSA.57.8">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PSA.57.7.005" x-align="PSA.57.7.a007" x-target-ids="t009 t010" x-target="is fixed" x-target-head="t010" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNrmsa" x-gloss="[is].steadfast" x-translit="nāḵôn" xml:lang="hbo" x-source-ref="PSA.57.8">נָכ֣וֹן</char> <char style="w" x-id="WLC.PSA.57.7.006" x-align="PSA.57.7.a006" x-target-ids="t008" x-target="heart" x-target-head="t008" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo" x-source-ref="PSA.57.8">לִבִּ֑</char><char style="w" x-id="WLC.PSA.57.7.007" x-align="PSA.57.7.a005" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.57.8">י</char> <char style="w" x-id="W