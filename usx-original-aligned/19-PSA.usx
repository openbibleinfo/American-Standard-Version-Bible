	<para style="p"><verse number="4" style="v" x-ref="PSA.65.4" x-added-alignments="PSA.65.4.a005 PSA.65.4.a006" x-added-target-ids="t012 t013 t014" x-added-target="unto thee | That" sid="PSA 65:4" /><char style="w" x-id="WLC.PSA.65.4.001" x-align="PSA.65.4.a001" x-target-ids="t001 t002" x-target="Blessed is" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrēy" xml:lang="hbo" x-source-ref="PSA.65.5">אַשְׁרֵ֤י</char>׀<char style="w" x-id="WLC.PSA.65.4.002" x-align="PSA.65.4.a002" x-target-ids="t003 t004 t005 t006 t007" x-target="the man whom thou choosest" x-target-head="t007" x-head="true" lemma="בָּחַר" strong="H977" x-morph="Vqi2ms" x-gloss="[is.the.one.whom].you.choose" x-translit="tiḇəḥar" xml:lang="hbo" x-source-ref="PSA.65.5">תִּֽבְחַ֣ר</char> <char style="w" x-id="WLC.PSA.65.4.003" x-align="PSA.65.4.a003" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[whom]" x-translit="û" xml:lang="hbo" x-source-ref="PSA.65.5">וּ</char><char style="w" x-id="WLC.PSA.65.4.004" x-align="PSA.65.4.a004" x-target-ids="t009 t010 t011" x-target="causest to approach" x-target-head="t011" x-head="true" lemma="קָרַב" strong="H7126" x-morph="Vpi2ms" x-gloss="you.bring.near" x-translit="ṯəqārēḇ" xml:lang="hbo" x-source-ref="PSA.65.5">תְקָרֵב֮</char> <char style="w" x-id="WLC.PSA.65.4.005" x-align="PSA.65.4.a007" x-target-ids="t015 t016 t017" x-target="he may dwell" x-target-head="t017" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqi3ms" x-gloss="he.dwells" x-translit="yiškōn" xml:lang="hbo" x-source-ref="PSA.65.5">יִשְׁכֹּ֪ן</char> <char style="w" x-id="WLC.PSA.65.4.006" x-align="PSA.65.4.a008" x-target-ids="t018 t020" x-target="in courts" x-target-head="t020" x-head="true" lemma="חָצֵר" strong="H2691" x-morph="Ncbpc" x-gloss="courts" x-translit="ḥăṣērey" xml:lang="hbo" x-source-ref="PSA.65.5">חֲצֵ֫רֶ֥י</char><char style="w" x-id="WLC.P