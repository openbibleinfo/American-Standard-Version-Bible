	<para style="p"><verse number="20" style="v" x-ref="PSA.37.20" sid="PSA 37:20" /><char style="w" x-id="WLC.PSA.37.20.001" x-align="PSA.37.20.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PSA.37.20.002" x-align="PSA.37.20.a002" x-target-ids="t002 t003" x-target="the wicked" x-target-head="t003" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֨ים</char>׀<char style="w" x-id="WLC.PSA.37.20.003" x-align="PSA.37.20.a003" x-target-ids="t004 t005" x-target="shall perish" x-target-head="t005" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqi3mp" x-gloss="they.will.perish" x-translit="yōʾḇēḏû" xml:lang="hbo">יֹאבֵ֗דוּ</char> <char style="w" x-id="WLC.PSA.37.20.004" x-align="PSA.37.20.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.37.20.005" x-align="PSA.37.20.a005" x-target-ids="t007 t008" x-target="the enemies" x-target-head="t008" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="the.enemies" x-translit="ʾōyəḇēy" xml:lang="hbo">אֹיְבֵ֣י</char> <char style="w" x-id="WLC.PSA.37.20.006" x-align="PSA.37.20.a006" x-target-ids="t009 t010" x-target="of Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.37.20.007" x-align="PSA.37.20.a007" x-target-ids="t011 t012 t013" x-target="shall be as" x-target-head="t013" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="[will" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.PSA.37.20.008" x-align="PSA.37.20.a008" x-target-ids="t014 t015" x-target="the fat" x-target-head="t015