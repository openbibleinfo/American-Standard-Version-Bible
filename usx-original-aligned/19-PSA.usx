	<para style="p"><verse number="16" style="v" x-ref="PSA.45.16" sid="PSA 45:16" /><char style="w" x-id="WLC.PSA.45.16.001" x-align="PSA.45.16.a001" x-target-ids="t001 t002" x-target="Instead of" x-target-head="t001" x-head="true" lemma="תַּחַת" strong="H8478" x-morph="R" x-gloss="in.place.of" x-translit="taḥaṯ" xml:lang="hbo" x-source-ref="PSA.45.17">תַּ֣חַת</char> <char style="w" x-id="WLC.PSA.45.16.002" x-align="PSA.45.16.a002" x-target-ids="t004" x-target="fathers" x-target-head="t004" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmpc" x-gloss="ancestors" x-translit="ʾăḇōṯey" xml:lang="hbo" x-source-ref="PSA.45.17">אֲ֭בֹתֶי</char><char style="w" x-id="WLC.PSA.45.16.003" x-align="PSA.45.16.a003" x-target-ids="t003" x-target="thy" x-target-head="t003" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.45.17">ךָ</char> <char style="w" x-id="WLC.PSA.45.16.004" x-align="PSA.45.16.a004" x-target-ids="t005 t006" x-target="shall be" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3mp" x-gloss="they.will.be" x-translit="yihyû" xml:lang="hbo" x-source-ref="PSA.45.17">יִהְי֣וּ</char> <char style="w" x-id="WLC.PSA.45.16.005" x-align="PSA.45.16.a005" x-target-ids="t008" x-target="children" x-target-head="t008" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="ḇāney" xml:lang="hbo" x-source-ref="PSA.45.17">בָנֶ֑י</char><char style="w" x-id="WLC.PSA.45.16.006" x-align="PSA.45.16.a006" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.45.17">ךָ</char> <char style="w" x-id="WLC.PSA.45.16.007" x-align="PSA.45.16.a007" x-target-ids="t010 t011 t012" x-target="thou shalt make" x-target-head="t012" x-head="true" lemma="שִׁית" strong="H7896" x-morph="Vqi2ms" x-gloss="you" x-translit="təšiyṯ" xml:lang="hbo" x-source-ref=