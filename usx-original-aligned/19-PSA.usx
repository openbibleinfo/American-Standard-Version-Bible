	<para style="p"><verse number="3" style="v" x-ref="PSA.9.3" sid="PSA 9:3" /><char style="w" x-id="WLC.PSA.9.3.001" x-align="PSA.9.3.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.9.4">בְּ</char><char style="w" x-id="WLC.PSA.9.3.002" x-align="PSA.9.3.a002" x-target-ids="t004" x-target="turn" x-target-head="t004" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqc" x-gloss="turn" x-translit="šûḇ-" xml:lang="hbo" x-source-ref="PSA.9.4">שׁוּב</char>־<char style="w" x-id="WLC.PSA.9.3.003" x-align="PSA.9.3.a003" x-target-ids="t003" x-target="enemies" x-target-head="t003" x-head="true" lemma="אָיַב" strong="H341" x-morph="Vqrmpc" x-gloss="enemies" x-translit="ʾôyəḇ" xml:lang="hbo" x-source-ref="PSA.9.4">אוֹיְבַ֥</char><char style="w" x-id="WLC.PSA.9.3.004" x-align="PSA.9.3.a004" x-target-ids="t002" x-target="mine" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo" x-source-ref="PSA.9.4">י</char> <char style="w" x-id="WLC.PSA.9.3.005" x-align="PSA.9.3.a005" x-target-ids="t005" x-target="back" x-target-head="t005" x-head="true" lemma="אָחוֹר" strong="H268" x-morph="Ncmsa" x-gloss="backwards" x-translit="ʾāḥôr" xml:lang="hbo" x-source-ref="PSA.9.4">אָח֑וֹר</char> <char style="w" x-id="WLC.PSA.9.3.006" x-align="PSA.9.3.a006" x-target-ids="t006 t007" x-target="They stumble" x-target-head="t007" x-head="true" lemma="כָּשַׁל" strong="H3782" x-morph="VNi3mp" x-gloss="they.stumble" x-translit="yikkāšəlû" xml:lang="hbo" x-source-ref="PSA.9.4">יִכָּשְׁל֥וּ</char> <char style="w" x-id="WLC.PSA.9.3.007" x-align="PSA.9.3.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.9.4">וְ֝</char><char style="w" x-id="WLC.PSA.9.3.008" x-align="PSA.9.3.a008" x-target