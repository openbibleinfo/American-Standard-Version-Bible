	<para style="p"><verse number="5" style="v" x-ref="PSA.4.5" sid="PSA 4:5" /><char style="w" x-id="WLC.PSA.4.5.001" x-align="PSA.4.5.a001" x-target-ids="t001" x-target="Offer" x-target-head="t001" x-head="true" lemma="זָבַח" strong="H2076" x-morph="Vqv2mp" x-gloss="sacrifice" x-translit="ziḇḥû" xml:lang="hbo" x-source-ref="PSA.4.6">זִבְח֥וּ</char> <char style="w" x-id="WLC.PSA.4.5.002" x-align="PSA.4.5.a002" x-target-ids="t002 t003" x-target="the sacrifices" x-target-head="t003" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmpc" x-gloss="sacrifices" x-translit="ziḇḥê-" xml:lang="hbo" x-source-ref="PSA.4.6">זִבְחֵי</char>־<char style="w" x-id="WLC.PSA.4.5.003" x-align="PSA.4.5.a003" x-target-ids="t004 t005" x-target="of righteousness" x-target-head="t005" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="of.righteousness" x-translit="ṣeḏeq" xml:lang="hbo" x-source-ref="PSA.4.6">צֶ֑דֶק</char> <char style="w" x-id="WLC.PSA.4.5.004" x-align="PSA.4.5.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.4.6">וּ֝</char><char style="w" x-id="WLC.PSA.4.5.005" x-align="PSA.4.5.a005" x-target-ids="t007 t008 t009" x-target="put your trust" x-target-head="t009" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqv2mp" x-gloss="trust" x-translit="ḇiṭḥû" xml:lang="hbo" x-source-ref="PSA.4.6">בִטְח֗וּ</char> <char style="w" x-id="WLC.PSA.4.5.006" x-align="PSA.4.5.a006" x-target-ids="t010" x-target="in" x-target-head="t010" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo" x-source-ref="PSA.4.6">אֶל</char>־<char style="w" x-id="WLC.PSA.4.5.007" x-align="PSA.4.5.a007" x-target-ids="t011" x-target="Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh:" xml:lang="hbo" x-source-ref="PSA.4.6">יְהוָֽה</char>׃<verse eid="PSA 4