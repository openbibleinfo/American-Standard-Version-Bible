	<para style="p"><verse number="15" style="v" x-ref="PSA.81.15" sid="PSA 81:15" /><char style="w" x-id="WLC.PSA.81.15.001" x-align="PSA.81.15.a001" x-target-ids="t001 t002" x-target="The haters" x-target-head="t002" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vprmpc" x-gloss="[those.who].hate" x-translit="məśanʾēy" xml:lang="hbo" x-source-ref="PSA.81.16">מְשַׂנְאֵ֣י</char> <char style="w" x-id="WLC.PSA.81.15.002" x-align="PSA.81.15.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="(of).Yahweh" x-translit="yhwh" xml:lang="hbo" x-source-ref="PSA.81.16">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.81.15.003" x-align="PSA.81.15.a003" x-target-ids="t005 t006 t007" x-target="should submit themselves" x-target-head="t006" x-head="true" lemma="כָּחַשׁ" strong="H3584" x-morph="Vpi3mp" x-gloss="they.will.cringe" x-translit="yəḵaḥăšû-" xml:lang="hbo" x-source-ref="PSA.81.16">יְכַֽחֲשׁוּ</char>־<char style="w" x-id="WLC.PSA.81.15.004" x-align="PSA.81.15.a004" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo" x-source-ref="PSA.81.16">ל֑</char><char style="w" x-id="WLC.PSA.81.15.005" x-align="PSA.81.15.a005" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.81.16">וֹ</char> <char style="w" x-id="WLC.PSA.81.15.006" x-align="PSA.81.15.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo" x-source-ref="PSA.81.16">וִ</char><char style="w" x-id="WLC.PSA.81.15.007" x-align="PSA.81.15.a009" x-target-ids="t013 t014" x-target="should endure" x-target-head="t014" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqj3ms" x-gloss="may.it.be" x-translit="yhiy" xml:l