	<para style="p"><verse number="21" style="v" x-ref="PSA.89.21" sid="PSA 89:21" /><char style="w" x-id="WLC.PSA.89.21.001" x-align="PSA.89.21.a001" x-target-ids="t002" x-target="whom" x-target-head="t002" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="whom" x-translit="ʾăšer" xml:lang="hbo" x-source-ref="PSA.89.22">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.PSA.89.21.002" x-align="PSA.89.21.a002" x-target-ids="t004" x-target="hand" x-target-head="t004" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo" x-source-ref="PSA.89.22">יָ֭דִ</char><char style="w" x-id="WLC.PSA.89.21.003" x-align="PSA.89.21.a003" x-target-ids="t003" x-target="my" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.89.22">י</char> <char style="w" x-id="WLC.PSA.89.21.004" x-align="PSA.89.21.a004" x-target-ids="t005 t006 t007" x-target="shall be established" x-target-head="t007" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNi3fs" x-gloss="it.will.be.steadfast" x-translit="tikôn" xml:lang="hbo" x-source-ref="PSA.89.22">תִּכּ֣וֹן</char> <char style="w" x-id="WLC.PSA.89.21.005" x-align="PSA.89.21.a005" x-target-ids="t001" x-target="With" x-target-head="t001" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿimm" xml:lang="hbo" x-source-ref="PSA.89.22">עִמּ֑</char><char style="w" x-id="WLC.PSA.89.21.006" x-align="PSA.89.21.a006" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo" x-source-ref="PSA.89.22">וֹ</char> <char style="w" x-id="WLC.PSA.89.21.007" x-align="PSA.89.21.a007" x-target-ids="t010" x-target="also" x-target-head="t010" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo" x-source-ref="PSA.89.22">אַף</char>־<char style="w" x-id="WLC.PSA.89.21.008" x-align="PSA.89.21.a