	<para style="p"><verse number="5" style="v" x-ref="PSA.9.5" sid="PSA 9:5" /><char style="w" x-id="WLC.PSA.9.5.001" x-align="PSA.9.5.a001" x-target-ids="t001 t002 t003" x-target="Thou hast rebuked" x-target-head="t003" x-head="true" lemma="גָּעַר" strong="H1605" x-morph="Vqp2ms" x-gloss="you.have.rebuked" x-translit="gāʿarətā" xml:lang="hbo" x-source-ref="PSA.9.6">גָּעַ֣רְתָּ</char> <char style="w" x-id="WLC.PSA.9.5.002" x-align="PSA.9.5.a002" x-target-ids="t004 t005" x-target="the nations" x-target-head="t005" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="ḡôyim" xml:lang="hbo" x-source-ref="PSA.9.6">ג֭וֹיִם</char> <char style="w" x-id="WLC.PSA.9.5.003" x-align="PSA.9.5.a003" x-target-ids="t006 t007 t008" x-target="thou hast destroyed" x-target-head="t008" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vpp2ms" x-gloss="you.have.destroyed" x-translit="ʾibbaḏətā" xml:lang="hbo" x-source-ref="PSA.9.6">אִבַּ֣דְתָּ</char> <char style="w" x-id="WLC.PSA.9.5.004" x-align="PSA.9.5.a004" x-target-ids="t009 t010" x-target="the wicked" x-target-head="t010" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="[the].wicked" x-translit="rāšāʿ" xml:lang="hbo" x-source-ref="PSA.9.6">רָשָׁ֑ע</char> <char style="w" x-id="WLC.PSA.9.5.005" x-align="PSA.9.5.a005" x-target-ids="t016" x-target="name" x-target-head="t016" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šəm" xml:lang="hbo" x-source-ref="PSA.9.6">שְׁמָ֥</char><char style="w" x-id="WLC.PSA.9.5.006" x-align="PSA.9.5.a006" x-target-ids="t015" x-target="their" x-target-head="t015" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="PSA.9.6">ם</char> <char style="w" x-id="WLC.PSA.9.5.007" x-align="PSA.9.5.a007" x-target-ids="t011 t012 t013 t014" x-target="Thou hast blotted out" x-target-head="t013" x-head="true" lemma="מָחָה" strong="H4229" x-morph="Vqp2ms" x-gloss="y