	<para style="p"><verse number="51" style="v" x-ref="PSA.119.51" x-added-alignments="PSA.119.51.a010" x-added-target-ids="t009" x-added-target="Yet" sid="PSA 119:51" /><char style="w" x-id="WLC.PSA.119.51.001" x-align="PSA.119.51.a001" x-target-ids="t001 t002" x-target="The proud" x-target-head="t002" x-head="true" lemma="זֵד" strong="H2086" x-morph="Aampa" x-gloss="arrogant.[people]" x-translit="zēḏîm" xml:lang="hbo">זֵ֭דִים</char> <char style="w" x-id="WLC.PSA.119.51.002" x-align="PSA.119.51.a002" x-target-ids="t003 t004 t007 t008" x-target="have had in derision" x-target-head="t008" x-head="true" lemma="לִיץ" strong="H3887b" x-morph="Vhp3cp" x-gloss="they" x-translit="hĕliyṣu" xml:lang="hbo">הֱלִיצֻ֣</char><char style="w" x-id="WLC.PSA.119.51.003" x-align="PSA.119.51.a003" x-target-ids="t005" x-target="me" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="have.mocked.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.119.51.004" x-align="PSA.119.51.a004" lemma="עַד" strong="H5704" x-morph="R" x-gloss="up.to" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PSA.119.51.005" x-align="PSA.119.51.a004" x-target-ids="t006" x-target="greatly" x-target-head="t006" x-head="true" lemma="מְאֹד" strong="H3966" x-morph="D" x-gloss="muchness" x-translit="məʾōḏ" xml:lang="hbo">מְאֹ֑ד</char> <char style="w" x-id="WLC.PSA.119.51.006" x-align="PSA.119.51.a005" x-target-ids="t014" x-target="from" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ֝</char><char style="w" x-id="WLC.PSA.119.51.007" x-align="PSA.119.51.a006" x-target-ids="t016" x-target="law" x-target-head="t016" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="law" x-translit="tôrāṯ" xml:lang="hbo">תּֽוֹרָתְ</char><char style="w" x-id="WLC.PSA.119.51.008" x-align="PSA.119.51.a007" x-target-ids="t015" x-target="thy" x-target-head="t015" x-head=