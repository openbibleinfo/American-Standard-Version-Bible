	<para style="p"><verse number="4" style="v" x-ref="PSA.5.4" sid="PSA 5:4" /><char style="w" x-id="WLC.PSA.5.4.001" x-align="PSA.5.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="PSA.5.5">כִּ֤י</char>׀<char style="w" x-id="WLC.PSA.5.4.002" x-align="PSA.5.4.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.5.5">לֹ֤א</char> <char style="w" x-id="WLC.PSA.5.4.003" x-align="PSA.5.4.a003" x-target-ids="t003 t005 t006" x-target="art a God" x-target-head="t006" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="[are].a.God" x-translit="ʾēl-" xml:lang="hbo" x-source-ref="PSA.5.5">אֵֽל</char>־<char style="w" x-id="WLC.PSA.5.4.004" x-align="PSA.5.4.a004" x-target-ids="t007 t008 t009" x-target="that hath pleasure" x-target-head="t009" x-head="true" lemma="חָפֵץ" strong="H2655" x-morph="Aamsc" x-gloss="desiring" x-translit="ḥāp̄ēṣ" xml:lang="hbo" x-source-ref="PSA.5.5">חָפֵ֘ץ</char> <char style="w" x-id="WLC.PSA.5.4.005" x-align="PSA.5.4.a005" x-target-ids="t010 t011" x-target="in wickedness" x-target-head="t011" x-head="true" lemma="רֶשַׁע" strong="H7562" x-morph="Ncmsa" x-gloss="wickedness" x-translit="rešaʿ" xml:lang="hbo" x-source-ref="PSA.5.5">רֶ֥שַׁע</char>׀<char style="w" x-id="WLC.PSA.5.4.006" x-align="PSA.5.4.a006" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾātâ" xml:lang="hbo" x-source-ref="PSA.5.5">אָ֑תָּה</char> <char style="w" x-id="WLC.PSA.5.4.007" x-align="PSA.5.4.a007" x-target-ids="t014" x-target="not" x-target-head="t014" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="PSA.5.5">לֹ֖א</char> <char style="w" x-id="WLC.PSA.5.4.008" x