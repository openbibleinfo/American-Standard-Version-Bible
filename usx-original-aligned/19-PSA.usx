	<para style="p"><verse number="11" style="v" x-ref="PSA.25.11" sid="PSA 25:11" /><char style="w" x-id="WLC.PSA.25.11.001" x-align="PSA.25.11.a001" x-target-ids="t001 t004" x-target="For sake" x-target-head="t004" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="for.the.sake.of" x-translit="ləmaʿan-" xml:lang="hbo">לְמַֽעַן</char>־<char style="w" x-id="WLC.PSA.25.11.002" x-align="PSA.25.11.a002" x-target-ids="t003" x-target="name’s" x-target-head="t003" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šim" xml:lang="hbo">שִׁמְ</char><char style="w" x-id="WLC.PSA.25.11.003" x-align="PSA.25.11.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PSA.25.11.004" x-align="PSA.25.11.a004" x-target-ids="t005 t006" x-target="O Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.25.11.005" x-align="PSA.25.11.a005" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="(and).you" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.25.11.006" x-align="PSA.25.11.a006" x-target-ids="t007" x-target="Pardon" x-target-head="t007" x-head="true" lemma="סָלַח" strong="H5545" x-morph="Vqp2ms" x-gloss="will.forgive" x-translit="sālaḥtā" xml:lang="hbo">סָלַחְתָּ֥</char> <char style="w" x-id="WLC.PSA.25.11.007" x-align="PSA.25.11.a007" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="la" xml:lang="hbo">לַ֝</char><char style="w" x-id="WLC.PSA.25.11.008" x-align="PSA.25.11.a008" x-target-ids="t009" x-target="iniquity" x-target-head="t009" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbsc" x-gloss="iniquity" x-translit="ʿăôn" xml:lang="hbo">עֲוֺנִ֗