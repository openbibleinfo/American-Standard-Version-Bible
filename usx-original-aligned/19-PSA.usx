	<para style="p"><verse number="7" style="v" x-ref="PSA.5.7" sid="PSA 5:7" /><char style="w" x-id="WLC.PSA.5.7.001" x-align="PSA.5.7.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="PSA.5.8">וַ</char><char style="w" x-id="WLC.PSA.5.7.002" x-align="PSA.5.7.a002" x-target-ids="t002 t003 t004" x-target="as for me" x-target-head="t004" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo" x-source-ref="PSA.5.8">אֲנִ֗י</char> <char style="w" x-id="WLC.PSA.5.7.003" x-align="PSA.5.7.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.5.8">בְּ</char><char style="w" x-id="WLC.PSA.5.7.004" x-align="PSA.5.7.a004" x-target-ids="t006 t007" x-target="the abundance" x-target-head="t007" x-head="true" lemma="רֹב" strong="H7230" x-morph="Ncbsc" x-gloss="the.greatness" x-translit="rōḇ" xml:lang="hbo" x-source-ref="PSA.5.8">רֹ֣ב</char> <char style="w" x-id="WLC.PSA.5.7.005" x-align="PSA.5.7.a005" x-target-ids="t008 t010" x-target="of lovingkindness" x-target-head="t010" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="your.covenant.loyalty" x-translit="ḥasd" xml:lang="hbo" x-source-ref="PSA.5.8">חַ֭סְדְּ</char><char style="w" x-id="WLC.PSA.5.7.006" x-align="PSA.5.7.a006" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.5.8">ךָ</char> <char style="w" x-id="WLC.PSA.5.7.007" x-align="PSA.5.7.a007" x-target-ids="t011 t012 t013" x-target="will I come" x-target-head="t013" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi1cs" x-gloss="I.will.enter" x-translit="ʾāḇôʾ" xml:lang="hbo" x-source-ref="PSA.5.8">אָב֣וֹא</char> <char style="w" x-id="WLC.