	<para style="p"><verse number="7" style="v" x-ref="PSA.16.7" sid="PSA 16:7" /><char style="w" x-id="WLC.PSA.16.7.001" x-align="PSA.16.7.a001" x-target-ids="t001 t002 t003" x-target="I will bless" x-target-head="t003" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vpi1cs" x-gloss="I.will.bless" x-translit="ʾăḇārēḵ" xml:lang="hbo">אֲבָרֵ֗ךְ</char> <char style="w" x-id="WLC.PSA.16.7.002" x-align="PSA.16.7.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.16.7.003" x-align="PSA.16.7.a003" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PSA.16.7.004" x-align="PSA.16.7.a004" x-target-ids="t005" x-target="who" x-target-head="t005" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.PSA.16.7.005" x-align="PSA.16.7.a005" x-target-ids="t006 t007 t009" x-target="hath given counsel" x-target-head="t009" x-head="true" lemma="יָעַץ" strong="H3289" x-morph="Vqp3ms" x-gloss="he" x-translit="yəʿāṣ" xml:lang="hbo">יְעָצָ֑</char><char style="w" x-id="WLC.PSA.16.7.006" x-align="PSA.16.7.a006" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="has.counseled.me" x-translit="āniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.16.7.007" x-align="PSA.16.7.a007" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml:lang="hbo">אַף</char>־<char style="w" x-id="WLC.PSA.16.7.008" x-align="PSA.16.7.a008" x-target-ids="t015 t016 t017 t018" x-target="in the night seasons" x-target-head="t017" x-head="true" lemma="לַיְלָה" strong="H3915" x-morph="Ncmpa"