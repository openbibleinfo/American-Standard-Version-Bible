	<para style="p"><verse number="12" style="v" x-ref="PSA.76.12" x-added-alignments="PSA.76.12.a004" x-added-target-ids="t009" x-added-target="He" sid="PSA 76:12" /><char style="w" x-id="WLC.PSA.76.12.001" x-align="PSA.76.12.a001" x-target-ids="t001 t002 t003 t004" x-target="He will cut off" x-target-head="t003" x-head="true" lemma="בָּצַר" strong="H1219a" x-morph="Vqi3ms" x-gloss="he.humbles" x-translit="yiḇṣōr" xml:lang="hbo" x-source-ref="PSA.76.13">יִ֭בְצֹר</char> <char style="w" x-id="WLC.PSA.76.12.002" x-align="PSA.76.12.a002" x-target-ids="t005 t006" x-target="the spirit" x-target-head="t006" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="[the].spirit" x-translit="rûᵃḥ" xml:lang="hbo" x-source-ref="PSA.76.13">ר֣וּחַ</char> <char style="w" x-id="WLC.PSA.76.12.003" x-align="PSA.76.12.a003" x-target-ids="t007 t008" x-target="of princes" x-target-head="t008" x-head="true" lemma="נָגִיד" strong="H5057" x-morph="Ncmpa" x-gloss="of.rulers" x-translit="nəḡîḏiym" xml:lang="hbo" x-source-ref="PSA.76.13">נְגִידִ֑ים</char> <char style="w" x-id="WLC.PSA.76.12.004" x-align="PSA.76.12.a005" x-target-ids="t010 t011" x-target="is terrible" x-target-head="t011" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="VNrmsa" x-gloss="[he.is].to.be.feared" x-translit="nôrāʾ" xml:lang="hbo" x-source-ref="PSA.76.13">נ֝וֹרָ֗א</char> <char style="w" x-id="WLC.PSA.76.12.005" x-align="PSA.76.12.a006" x-target-ids="t012" x-target="to" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="by.[the]" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.76.13">לְ</char><char style="w" x-id="WLC.PSA.76.12.006" x-align="PSA.76.12.a007" x-target-ids="t013 t014" x-target="the kings" x-target-head="t014" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmpc" x-gloss="kings" x-translit="malḵê-" xml:lang="hbo" x-source-ref="PSA.76.13">מַלְכֵי</char>־<char style="w" x-id="WLC.PSA.76.12.007" x-align="PSA.76.12.a008" x-target-ids="t015 t016 t017" x-targe