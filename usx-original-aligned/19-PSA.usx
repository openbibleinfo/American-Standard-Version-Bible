	<para style="p"><verse number="7" style="v" x-ref="PSA.27.7" x-added-alignments="PSA.27.7.a005" x-added-target-ids="t004" x-added-target="when" sid="PSA 27:7" /><char style="w" x-id="WLC.PSA.27.7.001" x-align="PSA.27.7.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="hear" x-translit="šəmaʿ-" xml:lang="hbo">שְׁמַע</char>־<char style="w" x-id="WLC.PSA.27.7.002" x-align="PSA.27.7.a002" x-target-ids="t002 t003" x-target="O Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.PSA.27.7.003" x-align="PSA.27.7.a003" x-target-ids="t007 t009" x-target="with voice" x-target-head="t009" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="voice" x-translit="qôl" xml:lang="hbo">קוֹלִ֥</char><char style="w" x-id="WLC.PSA.27.7.004" x-align="PSA.27.7.a004" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.27.7.005" x-align="PSA.27.7.a006" x-target-ids="t005 t006" x-target="I cry" x-target-head="t006" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi1cs" x-gloss="I.call.out" x-translit="ʾeqrāʾ" xml:lang="hbo">אֶקְרָ֗א</char> <char style="w" x-id="WLC.PSA.27.7.006" x-align="PSA.27.7.a007" x-target-ids="t012" x-target="also" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.27.7.007" x-align="PSA.27.7.a008" x-target-ids="t010 t011 t013" x-target="Have mercy upon" x-target-head="t011" x-head="true" lemma="חָנַן" strong="H2603" x-morph="Vqv2ms" x-gloss="show" x-translit="ḥānn" xml:lang="hbo">חָנֵּ֥</char><char style="w" x-id="WLC.PSA.27.7.008" x-align="PSA.27.7.a009" x-target-ids="t014" x-target="me" x-targe