	<para style="p"><verse number="6" style="v" x-ref="PSA.5.6" sid="PSA 5:6" /><char style="w" x-id="WLC.PSA.5.6.001" x-align="PSA.5.6.a001" x-target-ids="t001 t002 t003" x-target="Thou wilt destroy" x-target-head="t003" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vpi2ms" x-gloss="you.destroy" x-translit="təʾabbēḏ" xml:lang="hbo" x-source-ref="PSA.5.7">תְּאַבֵּד֮</char> <char style="w" x-id="WLC.PSA.5.6.002" x-align="PSA.5.6.a002" x-target-ids="t004 t005 t006" x-target="them that speak" x-target-head="t006" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vqrmpc" x-gloss="[those.who].speak" x-translit="dōḇərēy" xml:lang="hbo" x-source-ref="PSA.5.7">דֹּבְרֵ֪י</char> <char style="w" x-id="WLC.PSA.5.6.003" x-align="PSA.5.6.a003" x-target-ids="t007" x-target="lies" x-target-head="t007" x-head="true" lemma="כָּזָב" strong="H3577" x-morph="Ncmsa" x-gloss="(of).falsehood" x-translit="ḵāzāḇ" xml:lang="hbo" x-source-ref="PSA.5.7">כָ֫זָ֥ב</char> <char style="w" x-id="WLC.PSA.5.6.004" x-align="PSA.5.6.a004" x-target-ids="t010 t015" x-target="the man" x-target-head="t015" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="everyone" x-translit="ʾîš-" xml:lang="hbo" x-source-ref="PSA.5.7">אִישׁ</char>־<char style="w" x-id="WLC.PSA.5.6.005" x-align="PSA.5.6.a005" x-target-ids="t011 t012" x-target="blood thirsty" x-target-head="t011" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmpa" x-gloss="of.blood(s)" x-translit="dāmiym" xml:lang="hbo" x-source-ref="PSA.5.7">דָּמִ֥ים</char> <char style="w" x-id="WLC.PSA.5.6.006" x-align="PSA.5.6.a006" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="PSA.5.7">וּ</char><char style="w" x-id="WLC.PSA.5.6.007" x-align="PSA.5.6.a007" x-target-ids="t014" x-target="deceitful" x-target-head="t014" x-head="true" lemma="מִרְמָה" strong="H4820" x-morph="Ncfsa" x-gloss="deceit" x-translit="mirmāh" xml:lang="hbo" 