	<para style="p"><verse number="6" style="v" x-ref="PSA.61.6" sid="PSA 61:6" /><char style="w" x-id="WLC.PSA.61.6.001" x-align="PSA.61.6.a001" x-status="unrepresented" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="days" x-translit="yāmiym" xml:lang="hbo" x-source-ref="PSA.61.7">יָמִ֣ים</char> <char style="w" x-id="WLC.PSA.61.6.002" x-align="PSA.61.6.a002" x-status="unrepresented" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="to" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.61.7">עַל</char>־<char style="w" x-id="WLC.PSA.61.6.003" x-align="PSA.61.6.a003" x-target-ids="t006" x-target="life" x-target-head="t006" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="[the].days" x-translit="yəmê-" xml:lang="hbo" x-source-ref="PSA.61.7">יְמֵי</char>־<char style="w" x-id="WLC.PSA.61.6.004" x-align="PSA.61.6.a004" x-target-ids="t004 t005" x-target="the king’s" x-target-head="t005" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="of.[the].king" x-translit="meleḵ" xml:lang="hbo" x-source-ref="PSA.61.7">מֶ֣לֶךְ</char> <char style="w" x-id="WLC.PSA.61.6.005" x-align="PSA.61.6.a005" x-target-ids="t001 t002 t003" x-target="Thou wilt prolong" x-target-head="t003" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhi2ms" x-gloss="you.will.add" x-translit="tôsiyp̄" xml:lang="hbo" x-source-ref="PSA.61.7">תּוֹסִ֑יף</char> <char style="w" x-id="WLC.PSA.61.6.006" x-align="PSA.61.6.a006" x-target-ids="t008" x-target="years" x-target-head="t008" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncfpc" x-gloss="years" x-translit="šənôṯāy" xml:lang="hbo" x-source-ref="PSA.61.7">שְׁ֝נוֹתָ֗י</char><char style="w" x-id="WLC.PSA.61.6.007" x-align="PSA.61.6.a007" x-target-ids="t007" x-target="His" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="PSA.61.7">ו</char> <char style="w" x-id="WLC.PSA.61.6.008" x-align="PSA.61.6.a008" x-