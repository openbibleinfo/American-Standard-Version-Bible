	<para style="p"><verse number="23" style="v" x-ref="PSA.22.23" sid="PSA 22:23" /><char style="w" x-id="WLC.PSA.22.23.001" x-align="PSA.22.23.a001" x-target-ids="t001 t002 t003" x-target="Ye that fear" x-target-head="t003" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aampc" x-gloss="O.[those].fearing" x-translit="yirʾēy" xml:lang="hbo" x-source-ref="PSA.22.24">יִרְאֵ֤י</char> <char style="w" x-id="WLC.PSA.22.23.002" x-align="PSA.22.23.a002" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="(of).Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.22.24">יְהוָ֨ה</char>׀<char style="w" x-id="WLC.PSA.22.23.003" x-align="PSA.22.23.a003" x-target-ids="t005" x-target="praise" x-target-head="t005" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpv2mp" x-gloss="praise" x-translit="hallû" xml:lang="hbo" x-source-ref="PSA.22.24">הַֽלְל֗וּ</char><char style="w" x-id="WLC.PSA.22.23.004" x-align="PSA.22.23.a004" x-target-ids="t006" x-target="him" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="him" x-translit="hû" xml:lang="hbo" x-source-ref="PSA.22.24">הוּ</char> <char style="w" x-id="WLC.PSA.22.23.005" x-align="PSA.22.23.a005" x-target-ids="t007" x-target="All" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="O.all" x-translit="kol-" xml:lang="hbo" x-source-ref="PSA.22.24">כָּל</char>־<char style="w" x-id="WLC.PSA.22.23.006" x-align="PSA.22.23.a006" x-target-ids="t008 t009 t010" x-target="ye the seed" x-target-head="t010" x-head="true" lemma="זֶרַע" strong="H2233" x-morph="Ncmsc" x-gloss="the.offspring" x-translit="zeraʿ" xml:lang="hbo" x-source-ref="PSA.22.24">זֶ֣רַע</char> <char style="w" x-id="WLC.PSA.22.23.007" x-align="PSA.22.23.a007" x-target-ids="t011 t012" x-target="of Jacob" x-target-head="t012" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="of.Jacob" x-translit="yaʿăqōḇ" xml: