	<para style="p"><verse number="93" style="v" x-ref="PSA.119.93" sid="PSA 119:93" /><char style="w" x-id="WLC.PSA.119.93.001" x-align="PSA.119.93.a001" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ֭</char><char style="w" x-id="WLC.PSA.119.93.002" x-align="PSA.119.93.a001" x-target-ids="t003" x-target="never" x-target-head="t003" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָם</char> <char style="w" x-id="WLC.PSA.119.93.003" x-align="PSA.119.93.a001" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PSA.119.93.004" x-align="PSA.119.93.a002" x-target-ids="t001 t002 t004" x-target="I will forget" x-target-head="t004" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqi1cs" x-gloss="I.will.forget" x-translit="ʾeškaḥ" xml:lang="hbo">אֶשְׁכַּ֣ח</char> <char style="w" x-id="WLC.PSA.119.93.005" x-align="PSA.119.93.a003" x-target-ids="t006" x-target="precepts" x-target-head="t006" x-head="true" lemma="פִּקּוּדִים" strong="H6490" x-morph="Ncmpc" x-gloss="precepts" x-translit="piqqûḏey" xml:lang="hbo">פִּקּוּדֶ֑י</char><char style="w" x-id="WLC.PSA.119.93.006" x-align="PSA.119.93.a004" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.93.007" x-align="PSA.119.93.a005" x-target-ids="t007" x-target="For" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.PSA.119.93.008" x-align="PSA.119.93.a006" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇā" xml:lang="hbo">בָ֝֗</char><char style="w" x-id="WLC.PSA.119.93.009" x-align="PSA.119.93.a007