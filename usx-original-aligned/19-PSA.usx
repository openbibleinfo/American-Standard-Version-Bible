	<para style="p"><verse number="35" style="v" x-ref="PSA.89.35" sid="PSA 89:35" /><char style="w" x-id="WLC.PSA.89.35.001" x-align="PSA.89.35.a001" x-target-ids="t001" x-target="Once" x-target-head="t001" x-head="true" lemma="אֶחָד" strong="H259" x-morph="Acfsa" x-gloss="one.[time]" x-translit="ʾaḥaṯ" xml:lang="hbo" x-source-ref="PSA.89.36">אַ֭חַת</char> <char style="w" x-id="WLC.PSA.89.35.002" x-align="PSA.89.35.a002" x-target-ids="t002 t003 t004" x-target="have I sworn" x-target-head="t004" x-head="true" lemma="שָׁבַע" strong="H7650" x-morph="VNp1cs" x-gloss="I.have.sworn.an.oath" x-translit="nišbaʿətî" xml:lang="hbo" x-source-ref="PSA.89.36">נִשְׁבַּ֣עְתִּי</char> <char style="w" x-id="WLC.PSA.89.35.003" x-align="PSA.89.35.a003" x-target-ids="t005" x-target="by" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo" x-source-ref="PSA.89.36">בְ</char><char style="w" x-id="WLC.PSA.89.35.004" x-align="PSA.89.35.a004" x-target-ids="t007" x-target="holiness" x-target-head="t007" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsc" x-gloss="holiness" x-translit="qāḏəš" xml:lang="hbo" x-source-ref="PSA.89.36">קָדְשִׁ֑</char><char style="w" x-id="WLC.PSA.89.35.005" x-align="PSA.89.35.a005" x-target-ids="t006" x-target="my" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.89.36">י</char> <char style="w" x-id="WLC.PSA.89.35.006" x-align="PSA.89.35.a006" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="PSA.89.36">אִֽם</char>־<char style="w" x-id="WLC.PSA.89.35.007" x-align="PSA.89.35.a007" x-target-ids="t012" x-target="unto" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.89.36">לְ</char><char style="w" x-id="W