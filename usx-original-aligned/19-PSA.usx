	<para style="p"><verse number="18" style="v" x-ref="PSA.10.18" sid="PSA 10:18" /><char style="w" x-id="WLC.PSA.10.18.001" x-align="PSA.10.18.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PSA.10.18.002" x-align="PSA.10.18.a002" x-target-ids="t002" x-target="judge" x-target-head="t002" x-head="true" lemma="שָׁפַט" strong="H8199" x-morph="Vqc" x-gloss="vindicate" x-translit="šəpōṭ" xml:lang="hbo">שְׁפֹּ֥ט</char> <char style="w" x-id="WLC.PSA.10.18.003" x-align="PSA.10.18.a003" x-target-ids="t003 t004" x-target="the fatherless" x-target-head="t004" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmsa" x-gloss="[the].fatherless" x-translit="yāṯôm" xml:lang="hbo">יָת֗וֹם</char> <char style="w" x-id="WLC.PSA.10.18.004" x-align="PSA.10.18.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wā" xml:lang="hbo">וָ֫</char><char style="w" x-id="WLC.PSA.10.18.005" x-align="PSA.10.18.a005" x-target-ids="t006 t007" x-target="the oppressed" x-target-head="t007" x-head="true" lemma="דַּךְ" strong="H1790" x-morph="Aamsa" x-gloss="oppressed" x-translit="ḏāḵ" xml:lang="hbo">דָ֥ךְ</char> <char style="w" x-id="WLC.PSA.10.18.006" x-align="PSA.10.18.a006" x-target-ids="t018" x-target="no" x-target-head="t018" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PSA.10.18.007" x-align="PSA.10.18.a007" x-target-ids="t015 t019" x-target="may more" x-target-head="t019" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhi3ms" x-gloss="he.will.repeat" x-translit="yôsiyp̄" xml:lang="hbo">יוֹסִ֥יף</char> <char style="w" x-id="WLC.PSA.10.18.008" x-align="PSA.10.18.a008" x-status="unrepresented" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="again" x-t