	<para style="p"><verse number="2" style="v" x-ref="PSA.14.2" sid="PSA 14:2" /><char style="w" x-id="WLC.PSA.14.2.001" x-align="PSA.14.2.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.14.2.002" x-align="PSA.14.2.a003" x-target-ids="t004" x-target="from" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.14.2.003" x-align="PSA.14.2.a004" x-target-ids="t005" x-target="heaven" x-target-head="t005" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heaven" x-translit="ššāmayim" xml:lang="hbo">שָּׁמַיִם֮</char> <char style="w" x-id="WLC.PSA.14.2.004" x-align="PSA.14.2.a002" x-target-ids="t002 t003" x-target="looked down" x-target-head="t002" x-head="true" lemma="שָׁקַף" strong="H8259" x-morph="Vhp3ms" x-gloss="he.looks.down" x-translit="hišqiyp̄" xml:lang="hbo">הִשְׁקִ֪יף</char> <char style="w" x-id="WLC.PSA.14.2.005" x-align="PSA.14.2.a005" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַֽל</char>־<char style="w" x-id="WLC.PSA.14.2.006" x-align="PSA.14.2.a006" x-target-ids="t007 t008" x-target="the children" x-target-head="t008" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="[the].children" x-translit="bənê-" xml:lang="hbo">בְּנֵי</char>־<char style="w" x-id="WLC.PSA.14.2.007" x-align="PSA.14.2.a007" x-target-ids="t009 t010" x-target="of men" x-target-head="t010" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.humankind" x-translit="ʾāḏām" xml:lang="hbo">אָ֫דָ֥ם</char> <char style="w" x-id="WLC.PSA.14.2.008" x-align="PSA.14.2.a008" x-target-ids="t011" x-target="To" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" 