	<para style="p"><verse number="6" style="v" x-ref="PSA.16.6" sid="PSA 16:6" /><char style="w" x-id="WLC.PSA.16.6.001" x-align="PSA.16.6.a001" x-target-ids="t001 t002" x-target="The lines" x-target-head="t002" x-head="true" lemma="חֶבֶל" strong="H2256" x-morph="Ncbpa" x-gloss="boundary.lines" x-translit="ḥăḇāliym" xml:lang="hbo">חֲבָלִ֣ים</char> <char style="w" x-id="WLC.PSA.16.6.002" x-align="PSA.16.6.a002" x-target-ids="t003 t004" x-target="are fallen" x-target-head="t004" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqp3cp" x-gloss="they.have.fallen" x-translit="nāp̄əlû-" xml:lang="hbo">נָֽפְלוּ</char>־<char style="w" x-id="WLC.PSA.16.6.003" x-align="PSA.16.6.a003" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ֭</char><char style="w" x-id="WLC.PSA.16.6.004" x-align="PSA.16.6.a004" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="y" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.16.6.005" x-align="PSA.16.6.a005" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in.(the)" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PSA.16.6.006" x-align="PSA.16.6.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="pleasant" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PSA.16.6.007" x-align="PSA.16.6.a007" x-target-ids="t008 t009" x-target="pleasant places" x-target-head="t008" x-head="true" lemma="נָעִים" strong="H5273" x-morph="Aampa" x-gloss="[places]" x-translit="nnəʿimiym" xml:lang="hbo">נְּעִמִ֑ים</char> <char style="w" x-id="WLC.PSA.16.6.008" x-align="PSA.16.6.a008" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="also" x-translit="ʾap̄-" xml: