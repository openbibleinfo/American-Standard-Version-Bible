	<para style="p"><verse number="13" style="v" x-ref="PSA.91.13" sid="PSA 91:13" /><char style="w" x-id="WLC.PSA.91.13.001" x-align="PSA.91.13.a001" x-target-ids="t004" x-target="upon" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.91.13.002" x-align="PSA.91.13.a002" x-target-ids="t005 t006" x-target="the lion" x-target-head="t006" x-head="true" lemma="שַׁחַל" strong="H7826" x-morph="Ncmsa" x-gloss="a.lion" x-translit="šaḥal" xml:lang="hbo">שַׁ֣חַל</char> <char style="w" x-id="WLC.PSA.91.13.003" x-align="PSA.91.13.a003" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PSA.91.13.004" x-align="PSA.91.13.a004" x-target-ids="t008" x-target="adder" x-target-head="t008" x-head="true" lemma="פֶּתֶן" strong="H6620" x-morph="Ncmsa" x-gloss="a.cobra" x-translit="p̄eṯen" xml:lang="hbo">פֶ֣תֶן</char> <char style="w" x-id="WLC.PSA.91.13.005" x-align="PSA.91.13.a005" x-target-ids="t001 t002 t003" x-target="Thou shalt tread" x-target-head="t003" x-head="true" lemma="דָּרַךְ" strong="H1869" x-morph="Vqi2ms" x-gloss="you.will.tread" x-translit="tiḏrōḵ" xml:lang="hbo">תִּדְרֹ֑ךְ</char> <char style="w" x-id="WLC.PSA.91.13.006" x-align="PSA.91.13.a006" x-target-ids="t015 t016 t017 t018 t019" x-target="shalt thou trample under foot" x-target-head="t017" x-head="true" lemma="רָמַס" strong="H7429" x-morph="Vqi2ms" x-gloss="you.will.trample" x-translit="tirmōs" xml:lang="hbo">תִּרְמֹ֖ס</char> <char style="w" x-id="WLC.PSA.91.13.007" x-align="PSA.91.13.a007" x-target-ids="t009 t010 t011" x-target="The young lion" x-target-head="t011" x-head="true" lemma="כְּפִיר" strong="H3715" x-morph="Ncmsa" x-gloss="a.young.lion" x-translit="kəp̄iyr" xml:lang="hbo">כְּפִ֣יר</char> <char style="w" x-id="WLC.PSA.91.13.008" x-align="PSA.91.13.a008" x-target-i