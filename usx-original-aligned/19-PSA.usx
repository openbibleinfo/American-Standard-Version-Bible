	<para style="p"><verse number="5" style="v" x-ref="PSA.149.5" sid="PSA 149:5" /><char style="w" x-id="WLC.PSA.149.5.001" x-align="PSA.149.5.a001" x-target-ids="t001 t004" x-target="Let exult" x-target-head="t004" x-head="true" lemma="עָלַז" strong="H5937" x-morph="Vqi3mp" x-gloss="let.them.exult" x-translit="yaʿləzû" xml:lang="hbo">יַעְלְז֣וּ</char> <char style="w" x-id="WLC.PSA.149.5.002" x-align="PSA.149.5.a002" x-target-ids="t002 t003" x-target="the saints" x-target-head="t003" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aampa" x-gloss="faithful.[people]" x-translit="ḥăsîḏiym" xml:lang="hbo">חֲסִידִ֣ים</char> <char style="w" x-id="WLC.PSA.149.5.003" x-align="PSA.149.5.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.149.5.004" x-align="PSA.149.5.a004" x-target-ids="t006" x-target="glory" x-target-head="t006" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="honor" x-translit="ḵāḇôḏ" xml:lang="hbo">כָב֑וֹד</char> <char style="w" x-id="WLC.PSA.149.5.005" x-align="PSA.149.5.a005" x-target-ids="t007 t008 t009 t010 t011" x-target="Let them sing for joy" x-target-head="t009" x-head="true" lemma="רָנַן" strong="H7442" x-morph="Vpi3mp" x-gloss="let.them.sing.for.joy" x-translit="yərannənû" xml:lang="hbo">יְ֝רַנְּנ֗וּ</char> <char style="w" x-id="WLC.PSA.149.5.006" x-align="PSA.149.5.a006" x-target-ids="t012" x-target="upon" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PSA.149.5.007" x-align="PSA.149.5.a007" x-target-ids="t014" x-target="beds" x-target-head="t014" x-head="true" lemma="מִשְׁכָּב" strong="H4904" x-morph="Ncmpc" x-gloss="beds" x-translit="miškəḇôṯ" xml:lang="hbo">מִשְׁכְּבוֹתָֽ</char><char style="w" x-id="WLC.PSA.149.5.008" x-align="PSA.149.5.a008" x-target-ids="t013" x-ta