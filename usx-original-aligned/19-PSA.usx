	<para style="p"><verse number="1" style="v" x-ref="PSA.119.1" sid="PSA 119:1" /><char style="w" x-id="WLC.PSA.119.1.001" x-align="PSA.119.1.a001" x-target-ids="t001 t002" x-target="Blessed are" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrēy" xml:lang="hbo">אַשְׁרֵ֥י</char> <char style="w" x-id="WLC.PSA.119.1.002" x-align="PSA.119.1.a002" x-target-ids="t003 t004 t005 t006" x-target="they that are perfect" x-target-head="t006" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aampc" x-gloss="[are.people].blameless" x-translit="ṯəmiymê-" xml:lang="hbo">תְמִֽימֵי</char>־<char style="w" x-id="WLC.PSA.119.1.003" x-align="PSA.119.1.a003" x-target-ids="t007 t008 t009" x-target="in the way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="of.way" x-translit="ḏāreḵ" xml:lang="hbo">דָ֑רֶךְ</char> <char style="w" x-id="WLC.PSA.119.1.004" x-align="PSA.119.1.a004" x-target-ids="t010" x-target="Who" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[who]" x-translit="ha" xml:lang="hbo">הַֽ֝</char><char style="w" x-id="WLC.PSA.119.1.005" x-align="PSA.119.1.a005" x-target-ids="t011" x-target="walk" x-target-head="t011" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmpa" x-gloss="walk" x-translit="hōləḵiym" xml:lang="hbo">הֹלְכִ֗ים</char> <char style="w" x-id="WLC.PSA.119.1.006" x-align="PSA.119.1.a006" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.1.007" x-align="PSA.119.1.a007" x-target-ids="t013 t014" x-target="the law" x-target-head="t014" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="the.law" x-translit="ṯôraṯ" xml:lang="hbo">תוֹרַ֥ת</char> <char style="w" x-id="WLC.PSA.119.1.008" x-align="PSA.119.1.a008" x-target-ids="t015 t016" x-target="of Je