	<para style="p"><verse number="25" style="v" x-ref="PSA.18.25" sid="PSA 18:25" /><char style="w" x-id="WLC.PSA.18.25.001" x-align="PSA.18.25.a001" x-target-ids="t001" x-target="With" x-target-head="t001" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo" x-source-ref="PSA.18.26">עִם</char>־<char style="w" x-id="WLC.PSA.18.25.002" x-align="PSA.18.25.a002" x-target-ids="t002 t003" x-target="the merciful" x-target-head="t003" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aamsa" x-gloss="a.faithful.[person]" x-translit="ḥāsiyḏ" xml:lang="hbo" x-source-ref="PSA.18.26">חָסִ֥יד</char> <char style="w" x-id="WLC.PSA.18.25.003" x-align="PSA.18.25.a003" x-target-ids="t004 t005 t006 t007 t008" x-target="thou wilt show thyself merciful" x-target-head="t008" x-head="true" lemma="חָסַד" strong="H2616" x-morph="Vti2ms" x-gloss="you.show.yourself.faithful" x-translit="tiṯḥassāḏ" xml:lang="hbo" x-source-ref="PSA.18.26">תִּתְחַסָּ֑ד</char> <char style="w" x-id="WLC.PSA.18.25.004" x-align="PSA.18.25.a004" x-target-ids="t009" x-target="With" x-target-head="t009" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo" x-source-ref="PSA.18.26">עִם</char>־<char style="w" x-id="WLC.PSA.18.25.005" x-align="PSA.18.25.a005" x-target-ids="t010 t012" x-target="the man" x-target-head="t012" x-head="true" lemma="גֶּבֶר" strong="H1397" x-morph="Ncmsa" x-gloss="a.man" x-translit="gəḇar" xml:lang="hbo" x-source-ref="PSA.18.26">גְּבַ֥ר</char> <char style="w" x-id="WLC.PSA.18.25.006" x-align="PSA.18.25.a006" x-target-ids="t011" x-target="perfect" x-target-head="t011" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aamsa" x-gloss="blameless" x-translit="tāmiym" xml:lang="hbo" x-source-ref="PSA.18.26">תָּ֝מִ֗ים</char> <char style="w" x-id="WLC.PSA.18.25.007" x-align="PSA.18.25.a007" x-target-ids="t013 t014 t015 t016 t017" x-target="thou wilt show thyself perfect" x-target-head="t017" x-head="true"