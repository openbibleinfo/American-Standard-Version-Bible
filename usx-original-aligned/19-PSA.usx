	<para style="p"><verse number="3" style="v" x-ref="PSA.30.3" sid="PSA 30:3" /><char style="w" x-id="WLC.PSA.30.3.001" x-align="PSA.30.3.a001" x-target-ids="t001 t002" x-target="O Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="O.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.30.4">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PSA.30.3.002" x-align="PSA.30.3.a002" x-target-ids="t003 t004 t005 t006" x-target="thou hast brought up" x-target-head="t005" x-head="true" lemma="עָלָה" strong="H5927" x-morph="Vhp2ms" x-gloss="you.brought.up" x-translit="heʿĕliyṯā" xml:lang="hbo" x-source-ref="PSA.30.4">הֶֽעֱלִ֣יתָ</char> <char style="w" x-id="WLC.PSA.30.3.003" x-align="PSA.30.3.a003" x-target-ids="t009" x-target="from" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="min-" xml:lang="hbo" x-source-ref="PSA.30.4">מִן</char>־<char style="w" x-id="WLC.PSA.30.3.004" x-align="PSA.30.3.a004" x-target-ids="t010" x-target="Sheol" x-target-head="t010" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="Sheol" x-translit="šəʾôl" xml:lang="hbo" x-source-ref="PSA.30.4">שְׁא֣וֹל</char> <char style="w" x-id="WLC.PSA.30.3.005" x-align="PSA.30.3.a005" x-target-ids="t008" x-target="soul" x-target-head="t008" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="life" x-translit="nap̄š" xml:lang="hbo" x-source-ref="PSA.30.4">נַפְשִׁ֑</char><char style="w" x-id="WLC.PSA.30.3.006" x-align="PSA.30.3.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.30.4">י</char> <char style="w" x-id="WLC.PSA.30.3.007" x-align="PSA.30.3.a007" x-target-ids="t011 t012 t013 t015" x-target="Thou hast kept alive" x-target-head="t015" x-head="true" lemma="חָיָה" strong="H2421" x-morph="Vpp2ms" x-gloss="you" x-translit="ḥiyyiyṯa" xml:lang="hbo" x-source-