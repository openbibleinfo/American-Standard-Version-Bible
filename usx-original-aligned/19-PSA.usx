	<para style="p"><verse number="11" style="v" x-ref="PSA.76.11" sid="PSA 76:11" /><char style="w" x-id="WLC.PSA.76.11.001" x-align="PSA.76.11.a001" x-target-ids="t001" x-target="Vow" x-target-head="t001" x-head="true" lemma="נָדַר" strong="H5087" x-morph="Vqv2mp" x-gloss="make.vows" x-translit="niḏărû" xml:lang="hbo" x-source-ref="PSA.76.12">נִֽדֲר֣וּ</char> <char style="w" x-id="WLC.PSA.76.11.002" x-align="PSA.76.11.a002" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.76.12">וְ</char><char style="w" x-id="WLC.PSA.76.11.003" x-align="PSA.76.11.a003" x-target-ids="t003" x-target="pay" x-target-head="t003" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="Vpv2mp" x-gloss="pay.[them]" x-translit="šalləmû" xml:lang="hbo" x-source-ref="PSA.76.12">שַׁלְּמוּ֮</char> <char style="w" x-id="WLC.PSA.76.11.004" x-align="PSA.76.11.a004" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.76.12">לַ</char><char style="w" x-id="WLC.PSA.76.11.005" x-align="PSA.76.11.a005" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo" x-source-ref="PSA.76.12">יהוָ֪ה</char> <char style="w" x-id="WLC.PSA.76.11.006" x-align="PSA.76.11.a006" x-target-ids="t007" x-target="God" x-target-head="t007" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="God" x-translit="ʾĕlōhēy" xml:lang="hbo" x-source-ref="PSA.76.12">אֱֽלֹהֵ֫י</char><char style="w" x-id="WLC.PSA.76.11.007" x-align="PSA.76.11.a007" x-target-ids="t006" x-target="your" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo" x-source-ref="PSA.76.12">כֶ֥ם</char> <char style="w" x-id="WLC.PSA.76.11.0