	<para style="d" x-ref="PSA.81.0" x-added-alignments="PSA.81.0.a007" x-added-target-ids="t009 t010" x-added-target="A Psalm"><char style="w" x-id="WLC.PSA.81.0.001" x-align="PSA.81.0.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo" x-source-ref="PSA.81.1">לַ</char><char style="w" x-id="WLC.PSA.81.0.002" x-align="PSA.81.0.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.81.1">[הַ]</char><char style="w" x-id="WLC.PSA.81.0.003" x-align="PSA.81.0.a003" x-target-ids="t003 t004" x-target="Chief Musician" x-target-head="t004" x-head="true" lemma="נָצַח" strong="H5329" x-morph="Vprmsa" x-gloss="choirmaster" x-translit="mənaṣṣēḥa" xml:lang="hbo" x-source-ref="PSA.81.1">מְנַצֵּ֬חַ</char>׀<char style="w" x-id="WLC.PSA.81.0.004" x-align="PSA.81.0.a004" x-target-ids="t005 t006" x-target="set to" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="PSA.81.1">עַֽל</char>־<char style="w" x-id="WLC.PSA.81.0.005" x-align="PSA.81.0.a005" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.81.1">הַ</char><char style="w" x-id="WLC.PSA.81.0.006" x-align="PSA.81.0.a006" x-target-ids="t008" x-target="Gittith" x-target-head="t008" x-head="true" lemma="גִּתִּית" strong="H1665" x-morph="Ncfsa" x-gloss="Gittith" x-translit="gittiyṯ" xml:lang="hbo" x-source-ref="PSA.81.1">גִּתִּ֬ית</char> <char style="w" x-id="WLC.PSA.81.0.007" x-align="PSA.81.0.a008" x-target-ids="t011" x-target="of" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="of" x-translit="lə" xml:lang="hbo" x-source-ref="PSA.81.1">לְ</char><char style="w" x-id="WLC.PSA.81.0.008" x-align="PSA.81.0.a009" x-target-ids="t012" x-target="Asaph" x-target-head="t012" x-head="true" lemma="אָסָף" strong="H623" x-morph="Np" x-gloss="Asaph" x-translit="ʾāsāp̄:" xml:lang="hbo" x-source-ref="PSA.81.1">אָסָֽף</char>׃</para>
	<para style="p"><verse number="1" style="v" x-ref="PSA.81.1" sid="PSA 81:1" /><char style="w" x-id="WLC.PSA.81.1.001" x-align="PSA.81.1.a001" x-target-ids="t001 t002" x-target="Sing aloud" x-target-head="t001" x-head="true" lemma="רָנַן" strong="H7442" x-morph="Vhv2mp" x-gloss="sing.for.joy" x-translit="harnînû" xml:lang="hbo" x-source-ref="PSA.81.2">הַ֭רְנִינוּ</char> <char style="w" x-id="WLC.PSA.81.1.002" x-align="PSA.81.1.a002" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo" x-source-ref="PSA.81.2">לֵ</char><char style="w" x-id="WLC.PSA.81.1.003" x-align="PSA.81.1.a003" x-target-ids="t004" x-target="God" x-target-head="t004" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾlōhiym" xml:lang="hbo" x-source-ref="PSA.81.2">אלֹהִ֣ים</char> <char style="w" x-id="WLC.PSA.81.1.004" x-align="PSA.81.1.a005" x-target-ids="t006" x-target="strength" x-target-head="t006" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsc" x-gloss="strength" x-translit="ʿûzz" xml:lang="hbo" x-source-ref="PSA.81.2">עוּזֵּ֑</char><char style="w" x-id="WLC.PSA.81.1.005" x-align="PSA.81.1.a004" x-target-ids="t005" x-target="our" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="our" x-translit="ēnû" xml:lang="hbo" x-source-ref="PSA.81.2">נוּ</char> <char style="w" x-id="WLC.PSA.81.1.006" x-align="PSA.81.1.a006" x-target-ids="t007 t008 t009 t010" x-target="Make a joyful noise" x-target-head="t010" x-head="true" lemma="רוּעַ" strong="H7321" x-morph="Vhv2mp" x-gloss="shout.for.joy" x-translit="hāriyʿû" xml:lang="hbo" x-source-ref="PSA.81.2">הָ֝רִ֗יעוּ</char> <char style="w" x-id="WLC.PSA.81.1.007" x-align="PSA.81.1.a007" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo" x-source-ref="PSA.81.2">לֵ</char><char sty