	<para style="p"><verse number="16" style="v" x-ref="PSA.119.16" x-added-alignments="PSA.119.16.a009" x-added-target-ids="t014 t015" x-added-target="ג Gimel" sid="PSA 119:16" /><char style="w" x-id="WLC.PSA.119.16.001" x-align="PSA.119.16.a001" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PSA.119.16.002" x-align="PSA.119.16.a002" x-target-ids="t007" x-target="statutes" x-target-head="t007" x-head="true" lemma="חֻקָּה" strong="H2708" x-morph="Ncbpc" x-gloss="statutes" x-translit="ḥuqqōṯey" xml:lang="hbo">חֻקֹּתֶ֥י</char><char style="w" x-id="WLC.PSA.119.16.003" x-align="PSA.119.16.a003" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.119.16.004" x-align="PSA.119.16.a004" x-target-ids="t001 t002 t003 t004" x-target="I will delight myself" x-target-head="t003" x-head="true" lemma="שָׁעַע" strong="H8173a" x-morph="Vfi1cs" x-gloss="I.will.delight.myself" x-translit="ʾešətaʿăšāʿ" xml:lang="hbo">אֶֽשְׁתַּעֲשָׁ֑ע</char> <char style="w" x-id="WLC.PSA.119.16.005" x-align="PSA.119.16.a005" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֭א</char> <char style="w" x-id="WLC.PSA.119.16.006" x-align="PSA.119.16.a006" x-target-ids="t008 t009 t011" x-target="I will forget" x-target-head="t011" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqi1cs" x-gloss="I.will.forget" x-translit="ʾeškaḥ" xml:lang="hbo">אֶשְׁכַּ֣ח</char> <char style="w" x-id="WLC.PSA.119.16.007" x-align="PSA.119.16.a007" x-target-ids="t013" x-target="word" x-target-head="t013" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="word" x-translit="dəḇār" xml:lang="hbo">דְּבָרֶֽ</char><char style