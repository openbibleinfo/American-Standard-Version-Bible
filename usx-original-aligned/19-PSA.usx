	<para style="p"><verse number="12" style="v" x-ref="PSA.36.12" sid="PSA 36:12" /><char style="w" x-id="WLC.PSA.36.12.001" x-align="PSA.36.12.a001" x-target-ids="t001" x-target="There" x-target-head="t001" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="there" x-translit="šām" xml:lang="hbo" x-source-ref="PSA.36.13">שָׁ֣ם</char> <char style="w" x-id="WLC.PSA.36.12.002" x-align="PSA.36.12.a002" x-target-ids="t002 t007" x-target="are fallen" x-target-head="t007" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqp3cp" x-gloss="they.have.fallen" x-translit="nāp̄əlû" xml:lang="hbo" x-source-ref="PSA.36.13">נָ֭פְלוּ</char> <char style="w" x-id="WLC.PSA.36.12.003" x-align="PSA.36.12.a003" x-target-ids="t003 t004" x-target="the workers" x-target-head="t004" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqrmpc" x-gloss="[those.who].do" x-translit="pōʿălê" xml:lang="hbo" x-source-ref="PSA.36.13">פֹּ֣עֲלֵי</char> <char style="w" x-id="WLC.PSA.36.12.004" x-align="PSA.36.12.a004" x-target-ids="t005 t006" x-target="of iniquity" x-target-head="t006" x-head="true" lemma="אָוֶן" strong="H205" x-morph="Ncmsa" x-gloss="(of).wickedness" x-translit="ʾāwen" xml:lang="hbo" x-source-ref="PSA.36.13">אָ֑וֶן</char> <char style="w" x-id="WLC.PSA.36.12.005" x-align="PSA.36.12.a005" x-target-ids="t008 t009 t010 t011" x-target="They are thrust down" x-target-head="t010" x-head="true" lemma="דָּחָה" strong="H1760" x-morph="VPp3cp" x-gloss="they.were.pushed.down" x-translit="dōḥû" xml:lang="hbo" x-source-ref="PSA.36.13">דֹּ֝ח֗וּ</char> <char style="w" x-id="WLC.PSA.36.12.006" x-align="PSA.36.12.a006" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.36.13">וְ</char><char style="w" x-id="WLC.PSA.36.12.007" x-align="PSA.36.12.a007" x-target-ids="t014" x-target="not" x-target-head="t014" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="PSA.36.13">לֹא</char>־<char style="w" x-id="WLC.PSA.36.12.008" x-align="PSA.36.12.a008" x-target-ids="t013 t015 t016" x-target="shall be able" x-target-head="t016" x-head="true" lemma="יָכֹל" strong="H3201" x-morph="Vqp3cp" x-gloss="they.were.able" x-translit="yāḵəlû" xml:lang="hbo" x-source-ref="PSA.36.13">יָ֥כְלוּ</char> <char style="w" x-id="WLC.PSA.36.12.009" x-align="PSA.36.12.a009" x-target-ids="t017 t018" x-target="to rise" x-target-head="t018" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqc" x-gloss="to.rise" x-translit="qûm:" xml:lang="hbo" x-source-ref="PSA.36.13">קֽוּם</char>׃<verse eid="PSA 36:12" /></para>
