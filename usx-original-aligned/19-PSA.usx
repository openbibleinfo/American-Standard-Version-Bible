	<para style="p"><verse number="7" style="v" x-ref="PSA.79.7" sid="PSA 79:7" /><char style="w" x-id="WLC.PSA.79.7.001" x-align="PSA.79.7.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî" xml:lang="hbo">כִּ֭י</char> <char style="w" x-id="WLC.PSA.79.7.002" x-align="PSA.79.7.a002" x-target-ids="t002 t003 t004" x-target="they have devoured" x-target-head="t004" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqp3ms" x-gloss="it.has.consumed" x-translit="ʾāḵal" xml:lang="hbo">אָכַ֣ל</char> <char style="w" x-id="WLC.PSA.79.7.003" x-align="PSA.79.7.a003" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶֽת</char>־<char style="w" x-id="WLC.PSA.79.7.004" x-align="PSA.79.7.a004" x-target-ids="t005" x-target="Jacob" x-target-head="t005" x-head="true" lemma="יַעֲקֹב" strong="H3290" x-morph="Np" x-gloss="Jacob" x-translit="yaʿăqōḇ" xml:lang="hbo">יַעֲקֹ֑ב</char> <char style="w" x-id="WLC.PSA.79.7.005" x-align="PSA.79.7.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PSA.79.7.006" x-align="PSA.79.7.a009" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PSA.79.7.007" x-align="PSA.79.7.a008" x-target-ids="t010" x-target="habitation" x-target-head="t010" x-head="true" lemma="נָוֶה" strong="H5116" x-morph="Ncbsc" x-gloss="habitation" x-translit="nāw" xml:lang="hbo">נָוֵ֥</char><char style="w" x-id="WLC.PSA.79.7.008" x-align="PSA.79.7.a007" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="its" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PSA.79.7.009" x-al