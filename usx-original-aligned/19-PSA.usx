	<para style="p"><verse number="2" style="v" x-ref="PSA.107.2" x-added-alignments="PSA.107.2.a004" x-added-target-ids="t007" x-added-target="so" sid="PSA 107:2" /><char style="w" x-id="WLC.PSA.107.2.001" x-align="PSA.107.2.a001" x-target-ids="t001 t006" x-target="Let say" x-target-head="t006" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3mp" x-gloss="let.them.say" x-translit="yōʾmərû" xml:lang="hbo">יֹ֭אמְרוּ</char> <char style="w" x-id="WLC.PSA.107.2.002" x-align="PSA.107.2.a002" x-target-ids="t002 t003" x-target="the redeemed" x-target-head="t003" x-head="true" lemma="גָּאַל" strong="H1350" x-morph="Vqsmpc" x-gloss="[those].redeemed" x-translit="gəʾûlēy" xml:lang="hbo">גְּאוּלֵ֣י</char> <char style="w" x-id="WLC.PSA.107.2.003" x-align="PSA.107.2.a003" x-target-ids="t004 t005" x-target="of Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PSA.107.2.004" x-align="PSA.107.2.a005" x-target-ids="t008" x-target="Whom" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="whom" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֥ר</char> <char style="w" x-id="WLC.PSA.107.2.005" x-align="PSA.107.2.a006" x-target-ids="t009 t010 t011" x-target="he hath redeemed" x-target-head="t011" x-head="true" lemma="גָּאַל" strong="H1350" x-morph="Vqp3ms" x-gloss="he" x-translit="gəʾāl" xml:lang="hbo">גְּ֝אָלָ֗</char><char style="w" x-id="WLC.PSA.107.2.006" x-align="PSA.107.2.a007" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="has.redeemed.them" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PSA.107.2.007" x-align="PSA.107.2.a008" x-target-ids="t012" x-target="from" x-target-head="t012" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.107.2.008" x-align="PSA.107.2.a009" x