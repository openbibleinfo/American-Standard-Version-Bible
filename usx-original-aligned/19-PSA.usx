	<para style="p"><verse number="8" style="v" x-ref="PSA.19.8" sid="PSA 19:8" /><char style="w" x-id="WLC.PSA.19.8.001" x-align="PSA.19.8.a001" x-target-ids="t001 t002" x-target="The precepts" x-target-head="t002" x-head="true" lemma="פִּקּוּדִים" strong="H6490" x-morph="Ncmpc" x-gloss="the.precepts" x-translit="piqqûḏēy" xml:lang="hbo" x-source-ref="PSA.19.9">פִּקּ֘וּדֵ֤י</char> <char style="w" x-id="WLC.PSA.19.8.002" x-align="PSA.19.8.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.19.9">יְהוָ֣ה</char> <char style="w" x-id="WLC.PSA.19.8.003" x-align="PSA.19.8.a003" x-target-ids="t005 t006" x-target="are right" x-target-head="t006" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aampa" x-gloss="[are].upright" x-translit="yəšārîm" xml:lang="hbo" x-source-ref="PSA.19.9">יְ֭שָׁרִים</char> <char style="w" x-id="WLC.PSA.19.8.004" x-align="PSA.19.8.a004" x-target-ids="t007" x-target="rejoicing" x-target-head="t007" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vprmpc" x-gloss="making.glad" x-translit="məśamməḥê-" xml:lang="hbo" x-source-ref="PSA.19.9">מְשַׂמְּחֵי</char>־<char style="w" x-id="WLC.PSA.19.8.005" x-align="PSA.19.8.a005" x-target-ids="t008 t009" x-target="the heart" x-target-head="t009" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="(of).[the].heart" x-translit="lēḇ" xml:lang="hbo" x-source-ref="PSA.19.9">לֵ֑ב</char> <char style="w" x-id="WLC.PSA.19.8.006" x-align="PSA.19.8.a006" x-target-ids="t010 t011" x-target="The commandment" x-target-head="t011" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfsc" x-gloss="the.commandment" x-translit="miṣwaṯ" xml:lang="hbo" x-source-ref="PSA.19.9">מִצְוַ֥ת</char> <char style="w" x-id="WLC.PSA.19.8.007" x-align="PSA.19.8.a007" x-target-ids="t012 t013" x-target="of Jehovah" x-target-head="t013" x-head="true" lemma="יהוה" strong="H306