	<para style="p"><verse number="23" style="v" x-ref="PSA.31.23" sid="PSA 31:23" /><char style="w" x-id="WLC.PSA.31.23.001" x-align="PSA.31.23.a001" x-target-ids="t001 t002" x-target="Oh love" x-target-head="t002" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqv2mp" x-gloss="love" x-translit="ʾehĕḇû" xml:lang="hbo" x-source-ref="PSA.31.24">אֶֽהֱב֥וּ</char> <char style="w" x-id="WLC.PSA.31.23.002" x-align="PSA.31.23.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="PSA.31.24">אֶת</char>־<char style="w" x-id="WLC.PSA.31.23.003" x-align="PSA.31.23.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="PSA.31.24">יְהוָ֗ה</char> <char style="w" x-id="WLC.PSA.31.23.004" x-align="PSA.31.23.a004" x-target-ids="t004" x-target="all" x-target-head="t004" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="O.all" x-translit="kāl-" xml:lang="hbo" x-source-ref="PSA.31.24">כָּֽל</char>־<char style="w" x-id="WLC.PSA.31.23.005" x-align="PSA.31.23.a005" x-target-ids="t005 t007" x-target="ye saints" x-target-head="t007" x-head="true" lemma="חָסִיד" strong="H2623" x-morph="Aampc" x-gloss="his.faithful" x-translit="ḥăsiyḏāy" xml:lang="hbo" x-source-ref="PSA.31.24">חֲסִ֫ידָ֥י</char><char style="w" x-id="WLC.PSA.31.23.006" x-align="PSA.31.23.a006" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="[people]" x-translit="w" xml:lang="hbo" x-source-ref="PSA.31.24">ו</char> <char style="w" x-id="WLC.PSA.31.23.007" x-align="PSA.31.23.a007" x-target-ids="t010 t011" x-target="the faithful" x-target-head="t011" x-head="true" lemma="אֱמוּן" strong="H529a" x-morph="Aampa" x-gloss="faithful.[people]" x-translit="ʾĕmûnîm" xml:lang="hbo" x-source-ref="PSA.31.24">אֱ֭מוּנִים</char> <char 