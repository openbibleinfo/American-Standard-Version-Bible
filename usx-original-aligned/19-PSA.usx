	<para style="p"><verse number="10" style="v" x-ref="PSA.86.10" sid="PSA 86:10" /><char style="w" x-id="WLC.PSA.86.10.001" x-align="PSA.86.10.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PSA.86.10.002" x-align="PSA.86.10.a002" x-target-ids="t003 t004" x-target="art great" x-target-head="t004" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="[are].great" x-translit="ḡāḏôl" xml:lang="hbo">גָד֣וֹל</char> <char style="w" x-id="WLC.PSA.86.10.003" x-align="PSA.86.10.a003" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattâ" xml:lang="hbo">אַ֭תָּה</char> <char style="w" x-id="WLC.PSA.86.10.004" x-align="PSA.86.10.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.86.10.005" x-align="PSA.86.10.a005" x-target-ids="t006" x-target="doest" x-target-head="t006" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="[you.are].doing" x-translit="ʿōśēh" xml:lang="hbo">עֹשֵׂ֣ה</char> <char style="w" x-id="WLC.PSA.86.10.006" x-align="PSA.86.10.a006" x-target-ids="t007 t008" x-target="wondrous things" x-target-head="t007" x-head="true" lemma="פָּלָא" strong="H6381" x-morph="VNrfpa" x-gloss="(of).wonders" x-translit="nip̄lāʾôṯ" xml:lang="hbo">נִפְלָא֑וֹת</char> <char style="w" x-id="WLC.PSA.86.10.007" x-align="PSA.86.10.a007" x-target-ids="t009" x-target="Thou" x-target-head="t009" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֖ה</char> <char style="w" x-id="WLC.PSA.86.10.008" x-align="PSA.86.10.a008" x-target-ids="t010 t011" x-target="art God" x-target-head="t011" x-head="true" lemma="אֱלֹ