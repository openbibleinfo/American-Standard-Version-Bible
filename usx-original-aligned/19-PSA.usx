	<para style="p"><verse number="1" style="v" x-ref="PSA.106.1" x-added-alignments="PSA.106.1.a013" x-added-target-ids="t016" x-added-target="endureth" sid="PSA 106:1" /><char style="w" x-id="WLC.PSA.106.1.001" x-align="PSA.106.1.a001" x-target-ids="t001 t002" x-target="Praise ye" x-target-head="t001" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpv2mp" x-gloss="praise" x-translit="haləlû" xml:lang="hbo">הַֽלְלוּ</char> <char style="w" x-id="WLC.PSA.106.1.002" x-align="PSA.106.1.a002" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יָהּ" strong="H3050" x-morph="Np" x-gloss="Yahweh" x-translit="yāhh" xml:lang="hbo">יָ֨הּ</char><char style="w" x-id="WLC.PSA.106.1.003" x-align="PSA.106.1.a003" x-target-ids="t004 t005 t006" x-target="Oh give thanks" x-target-head="t006" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhv2mp" x-gloss="give.thanks" x-translit="hôḏû" xml:lang="hbo">הוֹד֣וּ</char> <char style="w" x-id="WLC.PSA.106.1.004" x-align="PSA.106.1.a004" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PSA.106.1.005" x-align="PSA.106.1.a005" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֣ה</char> <char style="w" x-id="WLC.PSA.106.1.006" x-align="PSA.106.1.a006" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PSA.106.1.007" x-align="PSA.106.1.a007" x-target-ids="t010 t011 t012" x-target="he is good" x-target-head="t012" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[he.is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PSA.106.1.008" x-align="PSA.106.1.a008" x-target-ids