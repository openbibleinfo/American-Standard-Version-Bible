	<para style="p"><verse number="9" style="v" x-ref="PSA.57.9" sid="PSA 57:9" /><char style="w" x-id="WLC.PSA.57.9.001" x-align="PSA.57.9.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="I will give thanks unto" x-target-head="t004" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾôḏ" xml:lang="hbo" x-source-ref="PSA.57.10">אוֹדְ</char><char style="w" x-id="WLC.PSA.57.9.002" x-align="PSA.57.9.a002" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.thanks.to.you" x-translit="əḵā" xml:lang="hbo" x-source-ref="PSA.57.10">ךָ֖</char> <char style="w" x-id="WLC.PSA.57.9.003" x-align="PSA.57.9.a005" x-target-ids="t009" x-target="among" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="among" x-translit="ḇā" xml:lang="hbo" x-source-ref="PSA.57.10">בָ</char><char style="w" x-id="WLC.PSA.57.9.004" x-align="PSA.57.9.a006" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="PSA.57.10">[הַ]</char><char style="w" x-id="WLC.PSA.57.9.005" x-align="PSA.57.9.a007" x-target-ids="t011" x-target="peoples" x-target-head="t011" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmpa" x-gloss="peoples" x-translit="ʿammiym" xml:lang="hbo" x-source-ref="PSA.57.10">עַמִּ֥ים</char>׀<char style="w" x-id="WLC.PSA.57.9.006" x-align="PSA.57.9.a003" x-target-ids="t007 t008" x-target="O Lord" x-target-head="t008" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo" x-source-ref="PSA.57.10">אֲדֹנָ֑</char><char style="w" x-id="WLC.PSA.57.9.007" x-align="PSA.57.9.a004" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="āy" xml:lang="hbo" x-source-ref="PSA.57.10">י</char> <char style="w" x-id="WLC.PSA.57.9.008" x-alig