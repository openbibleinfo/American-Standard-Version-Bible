	<para style="p"><verse number="4" style="v" x-ref="PSA.9.4" sid="PSA 9:4" /><char style="w" x-id="WLC.PSA.9.4.001" x-align="PSA.9.4.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo" x-source-ref="PSA.9.5">כִּֽי</char>־<char style="w" x-id="WLC.PSA.9.4.002" x-align="PSA.9.4.a002" x-target-ids="t002 t003 t004" x-target="thou hast maintained" x-target-head="t004" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp2ms" x-gloss="you.have.done" x-translit="ʿāśîṯā" xml:lang="hbo" x-source-ref="PSA.9.5">עָ֭שִׂיתָ</char> <char style="w" x-id="WLC.PSA.9.4.003" x-align="PSA.9.4.a003" x-target-ids="t006" x-target="right" x-target-head="t006" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsc" x-gloss="justice" x-translit="mišpāṭ" xml:lang="hbo" x-source-ref="PSA.9.5">מִשְׁפָּטִ֣</char><char style="w" x-id="WLC.PSA.9.4.004" x-align="PSA.9.4.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.9.5">י</char> <char style="w" x-id="WLC.PSA.9.4.005" x-align="PSA.9.4.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.9.5">וְ</char><char style="w" x-id="WLC.PSA.9.4.006" x-align="PSA.9.4.a006" x-target-ids="t009" x-target="cause" x-target-head="t009" x-head="true" lemma="דִּין" strong="H1779" x-morph="Ncmsc" x-gloss="cause" x-translit="ḏiyn" xml:lang="hbo" x-source-ref="PSA.9.5">דִינִ֑</char><char style="w" x-id="WLC.PSA.9.4.007" x-align="PSA.9.4.a007" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.9.5">י</char> <char style="w" x-id="WLC.PSA.9.4.008" x-align="PSA.9.4.a008" x-targe