	<para style="p"><verse number="9" style="v" x-ref="PSA.16.9" sid="PSA 16:9" /><char style="w" x-id="WLC.PSA.16.9.001" x-align="PSA.16.9.a001" lemma="לָכֵן" strong="H3807a" x-morph="R" x-gloss="therefore" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PSA.16.9.002" x-align="PSA.16.9.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="D" x-translit="ḵēn" xml:lang="hbo">כֵ֤ן</char>׀<char style="w" x-id="WLC.PSA.16.9.003" x-align="PSA.16.9.a002" x-target-ids="t004 t005" x-target="is glad" x-target-head="t005" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqp3ms" x-gloss="it.rejoices" x-translit="śāmaḥ" xml:lang="hbo">שָׂמַ֣ח</char> <char style="w" x-id="WLC.PSA.16.9.004" x-align="PSA.16.9.a003" x-target-ids="t003" x-target="heart" x-target-head="t003" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִ֭בִּ</char><char style="w" x-id="WLC.PSA.16.9.005" x-align="PSA.16.9.a004" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.16.9.006" x-align="PSA.16.9.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PSA.16.9.007" x-align="PSA.16.9.a006" x-target-ids="t009" x-target="rejoiceth" x-target-head="t009" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqw3ms" x-gloss="it.was.glad" x-translit="yyāḡel" xml:lang="hbo">יָּ֣גֶל</char> <char style="w" x-id="WLC.PSA.16.9.008" x-align="PSA.16.9.a007" x-target-ids="t008" x-target="glory" x-target-head="t008" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="honor" x-translit="kəḇôḏ" xml:lang="hbo">כְּבוֹדִ֑</char><char style="w" x-id="WLC.PSA.16.9.009" x-align="PSA.16.9.a008" 