	<para style="p"><verse number="9" style="v" x-ref="PSA.89.9" sid="PSA 89:9" /><char style="w" x-id="WLC.PSA.89.9.001" x-align="PSA.89.9.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo" x-source-ref="PSA.89.10">אַתָּ֣ה</char> <char style="w" x-id="WLC.PSA.89.9.002" x-align="PSA.89.9.a002" x-target-ids="t002" x-target="rulest" x-target-head="t002" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vqrmsa" x-gloss="[are].ruling" x-translit="môšēl" xml:lang="hbo" x-source-ref="PSA.89.10">מ֭וֹשֵׁל</char> <char style="w" x-id="WLC.PSA.89.9.003" x-align="PSA.89.9.a003" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="over" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.89.10">בְּ</char><char style="w" x-id="WLC.PSA.89.9.004" x-align="PSA.89.9.a004" x-target-ids="t003 t004" x-target="the pride" x-target-head="t004" x-head="true" lemma="גֵּאוּת" strong="H1348" x-morph="Ncfsc" x-gloss="the.rising.up" x-translit="ḡēʾûṯ" xml:lang="hbo" x-source-ref="PSA.89.10">גֵא֣וּת</char> <char style="w" x-id="WLC.PSA.89.9.005" x-align="PSA.89.9.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo" x-source-ref="PSA.89.10">הַ</char><char style="w" x-id="WLC.PSA.89.9.006" x-align="PSA.89.9.a006" x-target-ids="t005 t007" x-target="of sea" x-target-head="t007" x-head="true" lemma="יָם" strong="H3220" x-morph="Ncmsa" x-gloss="the.sea" x-translit="yyām" xml:lang="hbo" x-source-ref="PSA.89.10">יָּ֑ם</char> <char style="w" x-id="WLC.PSA.89.9.007" x-align="PSA.89.9.a007" x-target-ids="t008" x-target="When" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo" x-source-ref="PSA.89.10">בְּ</char><char style="w" x-id="WLC.PSA.89.9.008" x-align="PSA.89.9.a008" x-target-ids