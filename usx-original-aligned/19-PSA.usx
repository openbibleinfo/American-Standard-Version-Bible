	<para style="p"><verse number="2" style="v" x-ref="PSA.141.2" sid="PSA 141:2" /><char style="w" x-id="WLC.PSA.141.2.001" x-align="PSA.141.2.a001" x-target-ids="t001 t004 t005 t006" x-target="Let be set forth" x-target-head="t005" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNi3fs" x-gloss="may.it.be.established" x-translit="tikôn" xml:lang="hbo">תִּכּ֤וֹן</char> <char style="w" x-id="WLC.PSA.141.2.002" x-align="PSA.141.2.a002" x-target-ids="t003" x-target="prayer" x-target-head="t003" x-head="true" lemma="תְּפִלָּה" strong="H8605" x-morph="Ncfsc" x-gloss="prayer" x-translit="təp̄illāṯ" xml:lang="hbo">תְּפִלָּתִ֣</char><char style="w" x-id="WLC.PSA.141.2.003" x-align="PSA.141.2.a003" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.141.2.004" x-align="PSA.141.2.a004" x-target-ids="t007 t008" x-target="as incense" x-target-head="t008" x-head="true" lemma="קְטֹרֶת" strong="H7004" x-morph="Ncfsa" x-gloss="incense" x-translit="qəṭōreṯ" xml:lang="hbo">קְטֹ֣רֶת</char> <char style="w" x-id="WLC.PSA.141.2.005" x-align="PSA.141.2.a005" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PSA.141.2.006" x-align="PSA.141.2.a005" x-target-ids="t009" x-target="before" x-target-head="t009" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄āney" xml:lang="hbo">פָנֶ֑י</char><char style="w" x-id="WLC.PSA.141.2.007" x-align="PSA.141.2.a006" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PSA.141.2.008" x-align="PSA.141.2.a007" x-target-ids="t011 t012 t013" x-target="The lifting up" x-target-head="t012" x-head="true" lemma="מַשְׂאֵת" strong="H4864" x-morph="Ncfsc" x-gloss="the.raising" x-transl