	<para style="p"><verse number="120" style="v" x-ref="PSA.119.120" x-added-alignments="PSA.119.120.a012" x-added-target-ids="t015 t016" x-added-target="ע Ayin" sid="PSA 119:120" /><char style="w" x-id="WLC.PSA.119.120.001" x-align="PSA.119.120.a001" x-target-ids="t003" x-target="trembleth" x-target-head="t003" x-head="true" lemma="סָמַר" strong="H5568" x-morph="Vqp3ms" x-gloss="it.bristles.up" x-translit="sāmar" xml:lang="hbo">סָמַ֣ר</char> <char style="w" x-id="WLC.PSA.119.120.002" x-align="PSA.119.120.a002" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PSA.119.120.003" x-align="PSA.119.120.a003" x-target-ids="t005" x-target="fear" x-target-head="t005" x-head="true" lemma="פַּחַד" strong="H6343" x-morph="Ncmsc" x-gloss="dread" x-translit="paḥd" xml:lang="hbo">פַּחְדְּ</char><char style="w" x-id="WLC.PSA.119.120.004" x-align="PSA.119.120.a004" x-target-ids="t006 t007" x-target="of thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="of.you" x-translit="əḵā" xml:lang="hbo">ךָ֣</char> <char style="w" x-id="WLC.PSA.119.120.005" x-align="PSA.119.120.a005" x-target-ids="t002" x-target="flesh" x-target-head="t002" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmsc" x-gloss="flesh" x-translit="ḇəśār" xml:lang="hbo">בְשָׂרִ֑</char><char style="w" x-id="WLC.PSA.119.120.006" x-align="PSA.119.120.a006" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PSA.119.120.007" x-align="PSA.119.120.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.PSA.119.120.008" x-align="PSA.119.120.a008" x-target-ids="t012" x-