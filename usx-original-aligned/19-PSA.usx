	<para style="p"><verse number="5" style="v" x-ref="PSA.43.5" x-added-alignments="PSA.43.5.a017" x-added-target-ids="t026" x-added-target="Who" sid="PSA 43:5" /><char style="w" x-id="WLC.PSA.43.5.001" x-align="PSA.43.5.a001" x-target-ids="t001" x-target="Why" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.PSA.43.5.002" x-align="PSA.43.5.a002" x-target-ids="t002 t003 t004 t005" x-target="art thou cast down" x-target-head="t004" x-head="true" lemma="שׁיח" strong="H7817a" x-morph="Vri2fs" x-gloss="are.you.bowed.down" x-translit="tištôḥăḥiy" xml:lang="hbo">תִּשְׁתּ֬וֹחֲחִ֨י</char>׀<char style="w" x-id="WLC.PSA.43.5.003" x-align="PSA.43.5.a003" x-target-ids="t006 t008" x-target="O soul" x-target-head="t008" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="my.soul" x-translit="nap̄š" xml:lang="hbo">נַפְשִׁ</char><char style="w" x-id="WLC.PSA.43.5.004" x-align="PSA.43.5.a004" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י֮</char> <char style="w" x-id="WLC.PSA.43.5.005" x-align="PSA.43.5.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.PSA.43.5.006" x-align="PSA.43.5.a006" x-target-ids="t010" x-target="why" x-target-head="t010" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.PSA.43.5.007" x-align="PSA.43.5.a007" x-target-ids="t011 t012 t013" x-target="art thou disquieted" x-target-head="t013" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqi2fs" x-gloss="are.you.in.turmoil" x-translit="tehĕmiy" xml:lang="hbo">תֶּהֱמִ֪י</char> <char style="w" x-id="WLC.PSA.43.5.008" x-align="PSA.43.5.a008" x-tar