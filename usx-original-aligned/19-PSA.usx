	<para style="p"><verse number="6" style="v" x-ref="PSA.69.6" sid="PSA 69:6" /><char style="w" x-id="WLC.PSA.69.6.001" x-align="PSA.69.6.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="not" x-translit="ʾal-" xml:lang="hbo" x-source-ref="PSA.69.7">אַל</char>־<char style="w" x-id="WLC.PSA.69.6.002" x-align="PSA.69.6.a002" x-target-ids="t001 t008 t009 t010 t011" x-target="Let be put to shame" x-target-head="t011" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqj3mp" x-gloss="let.them.be.ashamed" x-translit="yēḇōšû" xml:lang="hbo" x-source-ref="PSA.69.7">יֵ֘בֹ֤שׁוּ</char> <char style="w" x-id="WLC.PSA.69.6.003" x-align="PSA.69.6.a005" x-target-ids="t012" x-target="through" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇ" xml:lang="hbo" x-source-ref="PSA.69.7">בִ֨</char><char style="w" x-id="WLC.PSA.69.6.004" x-align="PSA.69.6.a006" x-target-ids="t013" x-target="me" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo" x-source-ref="PSA.69.7">י</char>׀<char style="w" x-id="WLC.PSA.69.6.005" x-align="PSA.69.6.a003" x-target-ids="t003 t004 t005 t006" x-target="them that wait for" x-target-head="t005" x-head="true" lemma="קָוָה" strong="H6960" x-morph="Vqrmpc" x-gloss="[those" x-translit="qōwey" xml:lang="hbo" x-source-ref="PSA.69.7">קֹוֶי</char><char style="w" x-id="WLC.PSA.69.6.006" x-align="PSA.69.6.a004" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="who].wait.for.you" x-translit="ḵā" xml:lang="hbo" x-source-ref="PSA.69.7">ךָ֮</char> <char style="w" x-id="WLC.PSA.69.6.007" x-align="PSA.69.6.a007" x-target-ids="t014 t015" x-target="O Lord" x-target-head="t015" x-head="true" lemma="אֲדֹנָי" strong="H136" x-morph="Ncmpc" x-gloss="Lord" x-translit="ʾăḏōn" xml:lang="hbo" x-source-ref="PSA.69.7">אֲ