	<para style="p"><verse number="8" style="v" x-ref="PSA.2.8" x-added-alignments="PSA.2.8.a006" x-added-target-ids="t008" x-added-target="thee" sid="PSA 2:8" /><char style="w" x-id="WLC.PSA.2.8.001" x-align="PSA.2.8.a001" x-target-ids="t001" x-target="Ask" x-target-head="t001" x-head="true" lemma="שָׁאַל" strong="H7592" x-morph="Vqv2ms" x-gloss="ask" x-translit="šəʾal" xml:lang="hbo">שְׁאַ֤ל</char> <char style="w" x-id="WLC.PSA.2.8.002" x-align="PSA.2.8.a002" x-target-ids="t002" x-target="of" x-target-head="t002" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" xml:lang="hbo">מִמֶּ֗</char><char style="w" x-id="WLC.PSA.2.8.003" x-align="PSA.2.8.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="enniy" xml:lang="hbo">נִּי</char> <char style="w" x-id="WLC.PSA.2.8.004" x-align="PSA.2.8.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PSA.2.8.005" x-align="PSA.2.8.a005" x-target-ids="t005 t006 t007" x-target="I will give" x-target-head="t007" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqh1cs" x-gloss="I.will.make" x-translit="ʾettənāh" xml:lang="hbo">אֶתְּנָ֣ה</char> <char style="w" x-id="WLC.PSA.2.8.006" x-align="PSA.2.8.a007" x-target-ids="t009 t010" x-target="the nations" x-target-head="t010" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmpa" x-gloss="nations" x-translit="ḡôyim" xml:lang="hbo">ג֭וֹיִם</char> <char style="w" x-id="WLC.PSA.2.8.007" x-align="PSA.2.8.a008" x-target-ids="t011 t013" x-target="for inheritance" x-target-head="t013" x-head="true" lemma="נַחֲלָה" strong="H5159" x-morph="Ncfsc" x-gloss="inheritance" x-translit="naḥălāṯ" xml:lang="hbo">נַחֲלָתֶ֑</char><char style="w" x-id="WLC.PSA.2.8.008" x-align="PSA.2.8.a009" x-target-ids="t012" x-target="thine" x-target-h