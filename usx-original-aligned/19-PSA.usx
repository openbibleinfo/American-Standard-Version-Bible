	<para style="p"><verse number="11" style="v" x-ref="PSA.139.11" sid="PSA 139:11" /><char style="w" x-id="WLC.PSA.139.11.001" x-align="PSA.139.11.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ֭</char><char style="w" x-id="WLC.PSA.139.11.002" x-align="PSA.139.11.a002" x-target-ids="t002 t003" x-target="I say" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw1cs" x-gloss="I.said" x-translit="ʾōmar" xml:lang="hbo">אֹמַר</char> <char style="w" x-id="WLC.PSA.139.11.003" x-align="PSA.139.11.a003" x-target-ids="t004" x-target="Surely" x-target-head="t004" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="surely" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.PSA.139.11.004" x-align="PSA.139.11.a004" x-target-ids="t005 t006" x-target="the darkness" x-target-head="t006" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo">חֹ֣שֶׁךְ</char> <char style="w" x-id="WLC.PSA.139.11.005" x-align="PSA.139.11.a005" x-target-ids="t007 t008" x-target="shall overwhelm" x-target-head="t008" x-head="true" lemma="שׁוּף" strong="H7779" x-morph="Vqi3ms" x-gloss="it" x-translit="yəšûp̄" xml:lang="hbo">יְשׁוּפֵ֑</char><char style="w" x-id="WLC.PSA.139.11.006" x-align="PSA.139.11.a006" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.crush.me" x-translit="ēniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PSA.139.11.007" x-align="PSA.139.11.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PSA.139.11.008" x-align="PSA.139.11.a008" x-target-ids="t015 t016 t017" x-target="shall be night" x-target-head="t017" x-head="true" lemma="לַיְלָה