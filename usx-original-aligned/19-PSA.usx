	<para style="p"><verse number="12" style="v" x-ref="PSA.65.12" sid="PSA 65:12" /><char style="w" x-id="WLC.PSA.65.12.001" x-align="PSA.65.12.a001" x-target-ids="t001 t002" x-target="They drop" x-target-head="t002" x-head="true" lemma="רָעַף" strong="H7491" x-morph="Vqi3mp" x-gloss="they.drip" x-translit="yirʿăp̄û" xml:lang="hbo" x-source-ref="PSA.65.13">יִ֭רְעֲפוּ</char> <char style="w" x-id="WLC.PSA.65.12.002" x-align="PSA.65.12.a002" x-target-ids="t003 t004 t005" x-target="upon the pastures" x-target-head="t005" x-head="true" lemma="נָוָה" strong="H4999" x-morph="Ncfpc" x-gloss="[the].pastures" x-translit="nəʾôṯ" xml:lang="hbo" x-source-ref="PSA.65.13">נְא֣וֹת</char> <char style="w" x-id="WLC.PSA.65.12.003" x-align="PSA.65.12.a003" x-target-ids="t006 t007 t008" x-target="of the wilderness" x-target-head="t008" x-head="true" lemma="מִדְבָּר" strong="H4057" x-morph="Ncmsa" x-gloss="of.[the].wilderness" x-translit="miḏbār" xml:lang="hbo" x-source-ref="PSA.65.13">מִדְבָּ֑ר</char> <char style="w" x-id="WLC.PSA.65.12.004" x-align="PSA.65.12.a004" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="PSA.65.13">וְ֝</char><char style="w" x-id="WLC.PSA.65.12.005" x-align="PSA.65.12.a005" x-target-ids="t015" x-target="joy" x-target-head="t015" x-head="true" lemma="גִּיל" strong="H1524" x-morph="Ncmsa" x-gloss="rejoicing" x-translit="ḡiyl" xml:lang="hbo" x-source-ref="PSA.65.13">גִ֗יל</char> <char style="w" x-id="WLC.PSA.65.12.006" x-align="PSA.65.12.a006" x-target-ids="t010 t011" x-target="the hills" x-target-head="t011" x-head="true" lemma="גִּבְעָה" strong="H1389" x-morph="Ncfpa" x-gloss="[the].hills" x-translit="gəḇāʿôṯ" xml:lang="hbo" x-source-ref="PSA.65.13">גְּבָע֥וֹת</char> <char style="w" x-id="WLC.PSA.65.12.007" x-align="PSA.65.12.a007" x-target-ids="t012 t013 t014" x-target="are girded with" x-target-head="t013" x-head="true" lemma="חָגַר" strong="H22