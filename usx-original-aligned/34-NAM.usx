	<para style="p"><verse number="13" style="v" x-ref="NAM.1.13" sid="NAM 1:13" /><char style="w" x-id="WLC.NAM.1.13.001" x-align="NAM.1.13.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NAM.1.13.002" x-align="NAM.1.13.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="now" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֕ה</char> <char style="w" x-id="WLC.NAM.1.13.003" x-align="NAM.1.13.a003" x-target-ids="t003 t004 t005" x-target="will I break" x-target-head="t005" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="Vqi1cs" x-gloss="I.will.break" x-translit="ʾešbōr" xml:lang="hbo">אֶשְׁבֹּ֥ר</char> <char style="w" x-id="WLC.NAM.1.13.004" x-align="NAM.1.13.a004" x-target-ids="t007" x-target="yoke" x-target-head="t007" x-head="true" lemma="מוֹט" strong="H4132" x-morph="Ncmsc" x-gloss="yoke-bar" x-translit="mōṭ" xml:lang="hbo">מֹטֵ֖</char><char style="w" x-id="WLC.NAM.1.13.005" x-align="NAM.1.13.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.NAM.1.13.006" x-align="NAM.1.13.a006" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.NAM.1.13.007" x-align="NAM.1.13.a007" x-target-ids="t009" x-target="off" x-target-head="t009" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿālāy" xml:lang="hbo">עָלָ֑יִ</char><char style="w" x-id="WLC.NAM.1.13.008" x-align="NAM.1.13.a008" x-target-ids="t010" x-target="thee" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="you" x-translit="iḵ" xml:lang="hbo">ךְ</char> 