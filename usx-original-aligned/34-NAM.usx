" x-morph="Vpa" x-gloss="certainly.(leave.unpunished)" x-translit="naqqēh" xml:lang="hbo">נַקֵּ֖ה</char> <char style="w" x-id="WLC.NAM.1.3.009" x-align="NAM.1.3.a008" x-status="noncompositional" x-target-ids="t012 t013 t014" x-target="by no means" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.NAM.1.3.010" x-align="NAM.1.3.a009" x-target-ids="t011 t015" x-target="will clear" x-target-head="t015" x-head="true" lemma="נָקָה" strong="H5352" x-morph="Vpi3ms" x-gloss="he.will.leave.unpunished" x-translit="yənaqqeh" xml:lang="hbo">יְנַקֶּ֑ה</char> <char style="w" x-id="WLC.NAM.1.3.011" x-align="NAM.1.3.a011" x-target-ids="t018" x-target="Jehovah" x-target-head="t018" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.NAM.1.3.012" x-align="NAM.1.3.a012" x-target-ids="t022" x-target="in" x-target-head="t022" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.NAM.1.3.013" x-align="NAM.1.3.a013" x-target-ids="t023 t024" x-target="the whirlwind" x-target-head="t024" x-head="true" lemma="סוּפָה" strong="H5492" x-morph="Ncfsa" x-gloss="storm-wind" x-translit="sûp̄āh" xml:lang="hbo">סוּפָ֤ה</char> <char style="w" x-id="WLC.NAM.1.3.014" x-align="NAM.1.3.a014" x-target-ids="t025" x-target="and" x-target-head="t025" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.NAM.1.3.015" x-align="NAM.1.3.a015" x-target-ids="t026" x-target="in" x-target-head="t026" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.NAM.1.3.016" x-align="NAM.1.3.a016" x-target-ids="t027 t028" x-target="the storm" x-target-head="t028" x-head="true" lemma="שְׂעָר