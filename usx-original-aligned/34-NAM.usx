	<para style="p"><verse number="11" style="v" x-ref="NAM.3.11" sid="NAM 3:11" /><char style="w" x-id="WLC.NAM.3.11.001" x-align="NAM.3.11.a001" x-target-ids="t002" x-target="also" x-target-head="t002" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.NAM.3.11.002" x-align="NAM.3.11.a002" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתְּ" strong="H859b" x-morph="Pp2fs" x-gloss="you" x-translit="ʾatə" xml:lang="hbo">אַ֣תְּ</char> <char style="w" x-id="WLC.NAM.3.11.003" x-align="NAM.3.11.a003" x-target-ids="t003 t004 t005" x-target="shalt be drunken" x-target-head="t005" x-head="true" lemma="שָׁכַר" strong="H7937" x-morph="Vqi2fs" x-gloss="you.will.become.drunk" x-translit="tiškəriy" xml:lang="hbo">תִּשְׁכְּרִ֔י</char> <char style="w" x-id="WLC.NAM.3.11.004" x-align="NAM.3.11.a004" x-target-ids="t006 t007 t008" x-target="thou shalt be" x-target-head="t008" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3fs" x-gloss="it.will.be" x-translit="təhiy" xml:lang="hbo">תְּהִ֖י</char> <char style="w" x-id="WLC.NAM.3.11.005" x-align="NAM.3.11.a005" x-target-ids="t009" x-target="hid" x-target-head="t009" x-head="true" lemma="עָלַם" strong="H5956" x-morph="VNsfsa" x-gloss="hidden" x-translit="naʿălāmāh" xml:lang="hbo">נַֽעֲלָמָ֑ה</char> <char style="w" x-id="WLC.NAM.3.11.006" x-align="NAM.3.11.a006" x-target-ids="t011" x-target="also" x-target-head="t011" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.NAM.3.11.007" x-align="NAM.3.11.a007" x-target-ids="t010" x-target="thou" x-target-head="t010" x-head="true" lemma="אַתְּ" strong="H859b" x-morph="Pp2fs" x-gloss="you" x-translit="ʾatə" xml:lang="hbo">אַ֛תְּ</char> <char style="w" x-id="WLC.NAM.3.11.008" x-align="NAM.3.11.a008" x-target-ids="t012 t013" x-target="shalt seek" x-target-head="t013" x-head="true" le