	<para style="p"><verse number="14" style="v" x-ref="NAM.1.14" x-added-alignments="NAM.1.14.a003" x-added-target-ids="t008" x-added-target="that" sid="NAM 1:14" /><char style="w" x-id="WLC.NAM.1.14.001" x-align="NAM.1.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.NAM.1.14.002" x-align="NAM.1.14.a002" x-target-ids="t003 t004 t005" x-target="hath given commandment" x-target-head="t005" x-head="true" lemma="צָוָה" strong="H6680" x-morph="Vpp3ms" x-gloss="he.has.commanded" x-translit="ṣiwwāh" xml:lang="hbo">צִוָּ֤ה</char> <char style="w" x-id="WLC.NAM.1.14.003" x-align="NAM.1.14.a004" x-target-ids="t006" x-target="concerning" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāley" xml:lang="hbo">עָלֶ֨י</char><char style="w" x-id="WLC.NAM.1.14.004" x-align="NAM.1.14.a005" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="ḵā" xml:lang="hbo">ךָ֙</char> <char style="w" x-id="WLC.NAM.1.14.005" x-align="NAM.1.14.a006" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֔ה</char> <char style="w" x-id="WLC.NAM.1.14.006" x-align="NAM.1.14.a007" x-target-ids="t009" x-target="no" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.NAM.1.14.007" x-align="NAM.1.14.a008" x-target-ids="t014 t015" x-target="be sown" x-target-head="t015" x-head="true" lemma="זָרַע" strong="H2232" x-morph="VNi3ms" x-gloss="it.will.be.sown" x-translit="yizzāraʿ" xml:lang="hbo">יִזָּרַ֥ע</char> <char style="w" x-id="WLC.NAM.1.14.008" x-align="NAM.1.14.a009" x-target-ids="t011" x-target="of" x-t