	<para style="p"><verse number="5" style="v" x-ref="NAM.2.5" sid="NAM 2:5" /><char style="w" x-id="WLC.NAM.2.5.001" x-align="NAM.2.5.a001" x-target-ids="t001 t002" x-target="He remembereth" x-target-head="t002" x-head="true" lemma="זָכַר" strong="H2142" x-morph="Vqi3ms" x-gloss="he.remembers" x-translit="yizkōr" xml:lang="hbo" x-source-ref="NAM.2.6">יִזְכֹּר֙</char> <char style="w" x-id="WLC.NAM.2.5.002" x-align="NAM.2.5.a002" x-target-ids="t004" x-target="nobles" x-target-head="t004" x-head="true" lemma="אַדִּיר" strong="H117" x-morph="Aampc" x-gloss="his" x-translit="ʾaddiyrāy" xml:lang="hbo" x-source-ref="NAM.2.6">אַדִּירָ֔י</char><char style="w" x-id="WLC.NAM.2.5.003" x-align="NAM.2.5.a003" x-target-ids="t003" x-target="his" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="nobles" x-translit="w" xml:lang="hbo" x-source-ref="NAM.2.6">ו</char> <char style="w" x-id="WLC.NAM.2.5.004" x-align="NAM.2.5.a004" x-target-ids="t005 t006" x-target="they stumble" x-target-head="t006" x-head="true" lemma="כָּשַׁל" strong="H3782" x-morph="VNi3mp" x-gloss="they.stumble" x-translit="yikkāšəlû" xml:lang="hbo" x-source-ref="NAM.2.6">יִכָּשְׁל֖וּ</char> <char style="w" x-id="WLC.NAM.2.5.005" x-align="NAM.2.5.a005" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="**ba" xml:lang="hbo" x-source-ref="NAM.2.6">בַּ</char><char style="w" x-id="WLC.NAM.2.5.006" x-align="NAM.2.5.a006" x-target-ids="t009" x-target="march" x-target-head="t009" x-head="true" lemma="הֲלִיכָה" strong="H1979" x-morph="Ncfsc" x-gloss="going" x-translit="hăliyḵāṯ" xml:lang="hbo" x-source-ref="NAM.2.6">הֲלִֽיכָתָ֑</char><char style="w" x-id="WLC.NAM.2.5.007" x-align="NAM.2.5.a007" x-target-ids="t008" x-target="their" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="NAM.2.6">ם</char> <char style="w" x-id=