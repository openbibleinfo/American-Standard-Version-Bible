	<para style="p"><verse number="6" style="v" x-ref="NAM.2.6" sid="NAM 2:6" /><char style="w" x-id="WLC.NAM.2.6.001" x-align="NAM.2.6.a001" x-target-ids="t001 t002" x-target="The gates" x-target-head="t002" x-head="true" lemma="שַׁעַר" strong="H8179" x-morph="Ncmpc" x-gloss="the.gates" x-translit="šaʿărēy" xml:lang="hbo" x-source-ref="NAM.2.7">שַׁעֲרֵ֥י</char> <char style="w" x-id="WLC.NAM.2.6.002" x-align="NAM.2.6.a002" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="ha" xml:lang="hbo" x-source-ref="NAM.2.7">הַ</char><char style="w" x-id="WLC.NAM.2.6.003" x-align="NAM.2.6.a003" x-target-ids="t003 t005" x-target="of rivers" x-target-head="t005" x-head="true" lemma="נָהָר" strong="H5104" x-morph="Ncmpa" x-gloss="the.rivers" x-translit="nnəhārôṯ" xml:lang="hbo" x-source-ref="NAM.2.7">נְּהָר֖וֹת</char> <char style="w" x-id="WLC.NAM.2.6.004" x-align="NAM.2.6.a004" x-target-ids="t006 t007" x-target="are opened" x-target-head="t007" x-head="true" lemma="פָּתַח" strong="H6605" x-morph="VNp3cp" x-gloss="they.have.been.opened" x-translit="nip̄tāḥû" xml:lang="hbo" x-source-ref="NAM.2.7">נִפְתָּ֑חוּ</char> <char style="w" x-id="WLC.NAM.2.6.005" x-align="NAM.2.6.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="NAM.2.7">וְ</char><char style="w" x-id="WLC.NAM.2.6.006" x-align="NAM.2.6.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo" x-source-ref="NAM.2.7">הַֽ</char><char style="w" x-id="WLC.NAM.2.6.007" x-align="NAM.2.6.a007" x-target-ids="t010" x-target="palace" x-target-head="t010" x-head="true" lemma="הֵיכָל" strong="H1964" x-morph="Ncmsa" x-gloss="palace" x-translit="hêḵāl" xml:lang="hbo" x-source-ref="NAM.2.7">הֵיכָ֖ל</char> <char style="w" x-id="WLC.NAM.2.6