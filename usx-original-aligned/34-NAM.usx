	<para style="p"><verse number="15" style="v" x-ref="NAM.1.15" sid="NAM 1:15" /><char style="w" x-id="WLC.NAM.1.15.001" x-align="NAM.1.15.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo" x-source-ref="NAM.2.1">הִנֵּ֨ה</char> <char style="w" x-id="WLC.NAM.1.15.002" x-align="NAM.1.15.a002" x-target-ids="t002" x-target="upon" x-target-head="t002" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo" x-source-ref="NAM.2.1">עַל</char>־<char style="w" x-id="WLC.NAM.1.15.003" x-align="NAM.1.15.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="he" xml:lang="hbo" x-source-ref="NAM.2.1">הֶ</char><char style="w" x-id="WLC.NAM.1.15.004" x-align="NAM.1.15.a004" x-target-ids="t004" x-target="mountains" x-target-head="t004" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpa" x-gloss="mountains" x-translit="hāriym" xml:lang="hbo" x-source-ref="NAM.2.1">הָרִ֜ים</char> <char style="w" x-id="WLC.NAM.1.15.005" x-align="NAM.1.15.a005" x-target-ids="t005 t006" x-target="the feet" x-target-head="t006" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfdc" x-gloss="[the].feet" x-translit="raḡlēy" xml:lang="hbo" x-source-ref="NAM.2.1">רַגְלֵ֤י</char> <char style="w" x-id="WLC.NAM.1.15.006" x-align="NAM.1.15.a006" x-target-ids="t007 t008 t009 t010 t011 t012" x-target="of him that bringeth good tidings" x-target-head="t012" x-head="true" lemma="בָּשַׂר" strong="H1319" x-morph="Vprmsa" x-gloss="of.[one.who].bears.news" x-translit="məḇaśśēr" xml:lang="hbo" x-source-ref="NAM.2.1">מְבַשֵּׂר֙</char> <char style="w" x-id="WLC.NAM.1.15.007" x-align="NAM.1.15.a007" x-target-ids="t013 t014" x-target="that publisheth" x-target-head="t014" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vhrmsa" x-gloss="[one.who].proclaims" x-transl