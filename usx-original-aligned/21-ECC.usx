	<para style="p"><verse number="22" style="v" x-ref="ECC.7.22" sid="ECC 7:22" /><char style="w" x-id="WLC.ECC.7.22.001" x-align="ECC.7.22.a001" x-target-ids="t001" x-target="for" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֛י</char> <char style="w" x-id="WLC.ECC.7.22.002" x-align="ECC.7.22.a003" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.ECC.7.22.003" x-align="ECC.7.22.a002" x-status="noncompositional" x-target-ids="t002" x-target="oftentimes" x-target-head="t002" x-head="true" lemma="פַּעַם" strong="H6471" x-morph="Ncfpa" x-gloss="times" x-translit="pəʿāmiym" xml:lang="hbo">פְּעָמִ֥ים</char> <char style="w" x-id="WLC.ECC.7.22.004" x-align="ECC.7.22.a002" x-status="noncompositional" lemma="רַב" strong="H7227" x-morph="Aafpa" x-gloss="many" x-translit="rabôṯ" xml:lang="hbo">רַבּ֖וֹת</char> <char style="w" x-id="WLC.ECC.7.22.005" x-align="ECC.7.22.a006" x-target-ids="t007" x-target="knoweth" x-target-head="t007" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3ms" x-gloss="it.knows" x-translit="yāḏaʿ" xml:lang="hbo">יָדַ֣ע</char> <char style="w" x-id="WLC.ECC.7.22.006" x-align="ECC.7.22.a005" x-target-ids="t006" x-target="heart" x-target-head="t006" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבֶּ֑</char><char style="w" x-id="WLC.ECC.7.22.007" x-align="ECC.7.22.a004" x-target-ids="t004 t005" x-target="thine own" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.ECC.7.22.008" x-align="ECC.7.22.a007" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="(cmp)" x-translit="ʾăšer" xml:lang="hbo