	<para style="p"><verse number="10" style="v" x-ref="ECC.10.10" sid="ECC 10:10" /><char style="w" x-id="WLC.ECC.10.10.001" x-align="ECC.10.10.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.ECC.10.10.002" x-align="ECC.10.10.a004" x-target-ids="t004 t005" x-target="be blunt" x-target-head="t005" x-head="true" lemma="קָהָה" strong="H6949" x-morph="Vpp3ms" x-gloss="it.is.blunt" x-translit="qēhāh" xml:lang="hbo">קֵהָ֣ה</char> <char style="w" x-id="WLC.ECC.10.10.003" x-align="ECC.10.10.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.iron" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ECC.10.10.004" x-align="ECC.10.10.a003" x-target-ids="t003" x-target="iron" x-target-head="t003" x-head="true" lemma="בַּרְזֶל" strong="H1270" x-morph="Ncmsa" x-gloss="[axe]" x-translit="barzel" xml:lang="hbo">בַּרְזֶ֗ל</char> <char style="w" x-id="WLC.ECC.10.10.005" x-align="ECC.10.10.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ECC.10.10.006" x-align="ECC.10.10.a006" x-target-ids="t007" x-target="one" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">הוּא֙</char> <char style="w" x-id="WLC.ECC.10.10.007" x-align="ECC.10.10.a007" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.ECC.10.10.008" x-align="ECC.10.10.a009" x-target-ids="t011 t012" x-target="the edge" x-target-head="t012" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpa" x-gloss="faces" x-translit="p̄āniym" xml:lang