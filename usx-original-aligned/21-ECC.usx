	<para style="p"><verse number="10" style="v" x-ref="ECC.5.10" sid="ECC 5:10" /><char style="w" x-id="WLC.ECC.5.10.001" x-align="ECC.5.10.a001" x-target-ids="t001 t002 t003" x-target="He that loveth" x-target-head="t003" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[one.who].loves" x-translit="ʾōhēḇ" xml:lang="hbo" x-source-ref="ECC.5.9">אֹהֵ֥ב</char> <char style="w" x-id="WLC.ECC.5.10.002" x-align="ECC.5.10.a002" x-target-ids="t004" x-target="silver" x-target-head="t004" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="silver" x-translit="kesep̄" xml:lang="hbo" x-source-ref="ECC.5.9">כֶּ֨סֶף֙</char> <char style="w" x-id="WLC.ECC.5.10.003" x-align="ECC.5.10.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="ECC.5.9">לֹא</char>־<char style="w" x-id="WLC.ECC.5.10.004" x-align="ECC.5.10.a003" x-target-ids="t005 t007 t008 t009" x-target="shall be satisfied with" x-target-head="t008" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqi3ms" x-gloss="he.will.be.satisfied" x-translit="yiśbaʿ" xml:lang="hbo" x-source-ref="ECC.5.9">יִשְׂבַּ֣ע</char> <char style="w" x-id="WLC.ECC.5.10.005" x-align="ECC.5.10.a005" x-target-ids="t010" x-target="silver" x-target-head="t010" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="silver" x-translit="kesep̄" xml:lang="hbo" x-source-ref="ECC.5.9">כֶּ֔סֶף</char> <char style="w" x-id="WLC.ECC.5.10.006" x-align="ECC.5.10.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo" x-source-ref="ECC.5.9">וּ</char><char style="w" x-id="WLC.ECC.5.10.007" x-align="ECC.5.10.a007" x-target-ids="t012" x-target="he" x-target-head="t012" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="whoever" x-translit="miy-" xml:lang="hbo" x-source-ref="ECC.5.9">מִֽי</char>־<char style="w" x-id="WLC.ECC.5.10.008" x-align="ECC.5.10.a008" x-target-ids="t013 t014" x-target="that loveth" x-target-head="t014" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[is].loving" x-translit="ʾōhēḇ" xml:lang="hbo" x-source-ref="ECC.5.9">אֹהֵ֥ב</char> <char style="w" x-id="WLC.ECC.5.10.009" x-align="ECC.5.10.a009" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="(in" x-translit="be" xml:lang="hbo" x-source-ref="ECC.5.9">בֶּ</char><char style="w" x-id="WLC.ECC.5.10.010" x-align="ECC.5.10.a010" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="ECC.5.9">[הַ]</char><char style="w" x-id="WLC.ECC.5.10.011" x-align="ECC.5.10.a011" x-target-ids="t015" x-target="abundance" x-target-head="t015" x-head="true" lemma="הָמוֹן" strong="H1995" x-morph="Ncmsa" x-gloss="wealth" x-translit="hāmôn" xml:lang="hbo" x-source-ref="ECC.5.9">הָמ֖וֹן</char> <char style="w" x-id="WLC.ECC.5.10.012" x-align="ECC.5.10.a006" x-target-ids="t011" x-target="nor" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="ECC.5.9">לֹ֣א</char> <char style="w" x-id="WLC.ECC.5.10.013" x-align="ECC.5.10.a012" x-target-ids="t016 t017" x-target="with increase" x-target-head="t017" x-head="true" lemma="תְּבוּאָה" strong="H8393" x-morph="Ncfsa" x-gloss="income" x-translit="ṯəḇûʾāh" xml:lang="hbo" x-source-ref="ECC.5.9">תְבוּאָ֑ה</char> <char style="w" x-id="WLC.ECC.5.10.014" x-align="ECC.5.10.a014" x-target-ids="t019" x-target="also" x-target-head="t019" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo" x-source-ref="ECC.5.9">גַּם</char>־<char style="w" x-id="WLC.ECC.5.10.015" x-align="ECC.5.10.a013" x-target-ids="t018" x-target="this" x-target-head="t018" x-head="true" lemma="זֶה" strong="H2088" x-morph="Pdxms" x-gloss="this" x-translit="zeh" xml:lang="hbo" x-source-ref="ECC.5.9">ז