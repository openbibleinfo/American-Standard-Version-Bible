	<para style="p"><verse number="12" style="v" x-ref="ECC.1.12" sid="ECC 1:12" /><char style="w" x-id="WLC.ECC.1.12.001" x-align="ECC.1.12.a001" x-target-ids="t001" x-target="I" x-target-head="t001" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֣י</char> <char style="w" x-id="WLC.ECC.1.12.002" x-align="ECC.1.12.a002" x-target-ids="t002 t003" x-target="the Preacher" x-target-head="t003" x-head="true" lemma="קֹהֶלֶת" strong="H6953" x-morph="Ncmsa" x-gloss="Teacher" x-translit="qōheleṯ" xml:lang="hbo">קֹהֶ֗לֶת</char> <char style="w" x-id="WLC.ECC.1.12.003" x-align="ECC.1.12.a003" x-target-ids="t004" x-target="was" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cs" x-gloss="I.was" x-translit="hāyiyṯî" xml:lang="hbo">הָיִ֥יתִי</char> <char style="w" x-id="WLC.ECC.1.12.004" x-align="ECC.1.12.a004" x-target-ids="t005" x-target="king" x-target-head="t005" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="king" x-translit="meleḵ" xml:lang="hbo">מֶ֛לֶךְ</char> <char style="w" x-id="WLC.ECC.1.12.005" x-align="ECC.1.12.a005" x-target-ids="t006" x-target="over" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.ECC.1.12.006" x-align="ECC.1.12.a006" x-target-ids="t007" x-target="Israel" x-target-head="t007" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֖ל</char> <char style="w" x-id="WLC.ECC.1.12.007" x-align="ECC.1.12.a007" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.ECC.1.12.008" x-align="ECC.1.12.a008" x-target-ids="t009" x-target="Jerusalem" x-target-head="t009" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389" x-morph="Np" x-gloss="Jerusalem"