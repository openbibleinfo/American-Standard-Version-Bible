	<para style="p"><verse number="17" style="v" x-ref="ECC.5.17" sid="ECC 5:17" /><char style="w" x-id="WLC.ECC.5.17.001" x-align="ECC.5.17.a004" x-target-ids="t004" x-target="also" x-target-head="t004" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam" xml:lang="hbo" x-source-ref="ECC.5.16">גַּ֥ם</char> <char style="w" x-id="WLC.ECC.5.17.002" x-align="ECC.5.17.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo" x-source-ref="ECC.5.16">כָּל</char>־<char style="w" x-id="WLC.ECC.5.17.003" x-align="ECC.5.17.a003" x-target-ids="t003" x-target="days" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="days" x-translit="yāmāy" xml:lang="hbo" x-source-ref="ECC.5.16">יָמָ֖י</char><char style="w" x-id="WLC.ECC.5.17.004" x-align="ECC.5.17.a002" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo" x-source-ref="ECC.5.16">ו</char> <char style="w" x-id="WLC.ECC.5.17.005" x-align="ECC.5.17.a006" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo" x-source-ref="ECC.5.16">בַּ</char><char style="w" x-id="WLC.ECC.5.17.006" x-align="ECC.5.17.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo" x-source-ref="ECC.5.16">[הַ]</char><char style="w" x-id="WLC.ECC.5.17.007" x-align="ECC.5.17.a008" x-target-ids="t008" x-target="darkness" x-target-head="t008" x-head="true" lemma="חֹשֶׁךְ" strong="H2822" x-morph="Ncmsa" x-gloss="darkness" x-translit="ḥōšeḵ" xml:lang="hbo" x-source-ref="ECC.5.16">חֹ֣שֶׁךְ</char> <char style="w" x-id="WLC.ECC.5.17.008" x-align="ECC.5.17.a005" x-target-ids="t005 t006" x-target="he eateth" x-target-he