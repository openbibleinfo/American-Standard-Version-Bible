ēr" xml:lang="hbo">חִקֵּ֔ר</char> <char style="w" x-id="WLC.ECC.12.9.017" x-align="ECC.12.9.a017" x-target-ids="t021 t022 t023" x-target="set in order" x-target-head="t023" x-head="true" lemma="תָּקַן" strong="H8626" x-morph="Vpp3ms" x-gloss="he.arranged.in.order" x-translit="tiqqēn" xml:lang="hbo">תִּקֵּ֖ן</char> <char style="w" x-id="WLC.ECC.12.9.018" x-align="ECC.12.9.a018" x-target-ids="t025" x-target="proverbs" x-target-head="t025" x-head="true" lemma="מָשָׁל" strong="H4912" x-morph="Ncmpa" x-gloss="proverbs" x-translit="məšāliym" xml:lang="hbo">מְשָׁלִ֥ים</char> <char style="w" x-id="WLC.ECC.12.9.019" x-align="ECC.12.9.a019" x-target-ids="t024" x-target="many" x-target-head="t024" x-head="true" lemma="רָבָה" strong="H7235b" x-morph="Vha" x-gloss="many" x-translit="harbēh:" xml:lang="hbo">הַרְבֵּֽה</char>׃<verse eid="ECC 12:9" /></para>
