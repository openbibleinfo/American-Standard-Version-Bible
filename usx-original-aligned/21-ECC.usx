	<para style="p"><verse number="7" style="v" x-ref="ECC.4.7" sid="ECC 4:7" /><char style="w" x-id="WLC.ECC.4.7.001" x-align="ECC.4.7.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ECC.4.7.002" x-align="ECC.4.7.a002" x-target-ids="t003" x-target="returned" x-target-head="t003" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqp1cs" x-gloss="I.returned" x-translit="šaḇətî" xml:lang="hbo">שַׁ֧בְתִּי</char> <char style="w" x-id="WLC.ECC.4.7.003" x-align="ECC.4.7.a003" x-target-ids="t002" x-target="I" x-target-head="t002" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֛י</char> <char style="w" x-id="WLC.ECC.4.7.004" x-align="ECC.4.7.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.ECC.4.7.005" x-align="ECC.4.7.a005" x-target-ids="t005" x-target="saw" x-target-head="t005" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqw1cs" x-gloss="I.saw" x-translit="ʾerʾeh" xml:lang="hbo">אֶרְאֶ֥ה</char> <char style="w" x-id="WLC.ECC.4.7.006" x-align="ECC.4.7.a006" x-target-ids="t006" x-target="vanity" x-target-head="t006" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsa" x-gloss="futility" x-translit="heḇel" xml:lang="hbo">הֶ֖בֶל</char> <char style="w" x-id="WLC.ECC.4.7.007" x-align="ECC.4.7.a007" x-target-ids="t007" x-target="under" x-target-head="t007" x-head="true" lemma="תַּחַת" strong="H8478" x-morph="R" x-gloss="under" x-translit="taḥaṯ" xml:lang="hbo">תַּ֥חַת</char> <char style="w" x-id="WLC.ECC.4.7.008" x-align="ECC.4.7.a008" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="