	<para style="p"><verse number="9" style="v" x-ref="ECC.5.9" sid="ECC 5:9" /><char style="w" x-id="WLC.ECC.5.9.001" x-align="ECC.5.9.a001" x-target-ids="t001" x-target="Moreover" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo" x-source-ref="ECC.5.8">וְ</char><char style="w" x-id="WLC.ECC.5.9.002" x-align="ECC.5.9.a002" x-target-ids="t002 t003" x-target="the profit" x-target-head="t003" x-head="true" lemma="יִתְרוֹן" strong="H3504" x-morph="Ncmsc" x-gloss="profit" x-translit="yiṯrôn" xml:lang="hbo" x-source-ref="ECC.5.8">יִתְר֥וֹן</char> <char style="w" x-id="WLC.ECC.5.9.003" x-align="ECC.5.9.a003" x-target-ids="t004 t005 t006" x-target="of the earth" x-target-head="t006" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.a.land" x-translit="ʾereṣ" xml:lang="hbo" x-source-ref="ECC.5.8">אֶ֖רֶץ</char> <char style="w" x-id="WLC.ECC.5.9.004" x-align="ECC.5.9.a004" x-target-ids="t007 t008" x-target="is for" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="[is].in" x-translit="ba" xml:lang="hbo" x-source-ref="ECC.5.8">בַּ</char><char style="w" x-id="WLC.ECC.5.9.005" x-align="ECC.5.9.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo" x-source-ref="ECC.5.8">[הַ]</char><char style="w" x-id="WLC.ECC.5.9.006" x-align="ECC.5.9.a006" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="everything" x-translit="kōl" xml:lang="hbo" x-source-ref="ECC.5.8">כֹּ֣ל</char> <char style="w" x-id="WLC.ECC.5.9.007" x-align="ECC.5.9.a008" x-target-ids="t012" x-target="himself" x-target-italic-ids="t012" x-target-head="t012" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="**hûʾ" xml:lang="hbo" x-source-ref="ECC.5.8">ה֑וּא</char> <char style="w" x-id="WLC.ECC.5.9.008" x-align="ECC.5