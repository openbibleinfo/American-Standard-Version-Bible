	<para style="p"><verse number="5" style="v" x-ref="ECC.5.5" x-added-alignments="ECC.5.5.a002" x-added-target-ids="t003" x-added-target="it" sid="ECC 5:5" /><char style="w" x-id="WLC.ECC.5.5.001" x-align="ECC.5.5.a001" x-target-ids="t001 t002" x-target="Better is" x-target-head="t001" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo" x-source-ref="ECC.5.4">ט֖וֹב</char> <char style="w" x-id="WLC.ECC.5.5.002" x-align="ECC.5.5.a003" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="(cmp)" x-translit="ʾăšer" xml:lang="hbo" x-source-ref="ECC.5.4">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.ECC.5.5.003" x-align="ECC.5.5.a005" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="ECC.5.4">לֹֽא</char>־<char style="w" x-id="WLC.ECC.5.5.004" x-align="ECC.5.5.a004" x-target-ids="t005 t006 t008" x-target="thou shouldest vow" x-target-head="t008" x-head="true" lemma="נָדַר" strong="H5087" x-morph="Vqi2ms" x-gloss="you.will.vow" x-translit="ṯiddōr" xml:lang="hbo" x-source-ref="ECC.5.4">תִדֹּ֑ר</char> <char style="w" x-id="WLC.ECC.5.5.005" x-align="ECC.5.5.a006" x-target-ids="t009" x-target="than" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo" x-source-ref="ECC.5.4">מִ</char><char style="w" x-id="WLC.ECC.5.5.006" x-align="ECC.5.5.a007" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="שֶׁ" strong="H7578a" x-morph="Tr" x-gloss="than.(cmp)" x-translit="še" xml:lang="hbo" x-source-ref="ECC.5.4">שֶׁ</char><char style="w" x-id="WLC.ECC.5.5.007" x-align="ECC.5.5.a008" x-target-ids="t011 t012 t013" x-target="thou shouldest vow" x-target-head="t013" x-head="true" lemma="נָדַר" strong="H5087" x-morph="Vqi2ms" x-gloss="you.will.vow" x-translit="tidôr