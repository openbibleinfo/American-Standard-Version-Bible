	<para style="p"><verse number="6" style="v" x-ref="ECC.4.6" sid="ECC 4:6" /><char style="w" x-id="WLC.ECC.4.6.001" x-align="ECC.4.6.a001" x-target-ids="t001 t002" x-target="Better is" x-target-head="t001" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֕וֹב</char> <char style="w" x-id="WLC.ECC.4.6.002" x-align="ECC.4.6.a002" x-target-ids="t003 t004" x-target="a handful" x-target-head="t004" x-head="true" lemma="מְלֹא" strong="H4393" x-morph="Ncmsc" x-gloss="[the].fullness" x-translit="məlōʾ" xml:lang="hbo">מְלֹ֥א</char> <char style="w" x-id="WLC.ECC.4.6.003" x-align="ECC.4.6.a002" lemma="כַּף" strong="H3709" x-morph="Ncfsc" x-gloss="of.a.palm" x-translit="ḵap̄" xml:lang="hbo">כַ֖ף</char> <char style="w" x-id="WLC.ECC.4.6.004" x-align="ECC.4.6.a003" x-target-ids="t005 t006" x-target="with quietness" x-target-head="t006" x-head="true" lemma="נַחַת" strong="H5183a" x-morph="Ncfsa" x-gloss="of.quietness" x-translit="nāḥaṯ" xml:lang="hbo">נָ֑חַת</char> <char style="w" x-id="WLC.ECC.4.6.005" x-align="ECC.4.6.a004" x-target-ids="t007" x-target="than" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.ECC.4.6.006" x-align="ECC.4.6.a005" x-target-ids="t008 t009" x-target="two handfuls" x-target-head="t009" x-head="true" lemma="מְלֹא" strong="H4393" x-morph="Ncmsc" x-gloss="than.[the].fullness" x-translit="mməlōʾ" xml:lang="hbo">מְּלֹ֥א</char> <char style="w" x-id="WLC.ECC.4.6.007" x-align="ECC.4.6.a005" lemma="חֹפֶן" strong="H2651" x-morph="Ncmda" x-gloss="of.[the].hollow.of.hands" x-translit="ḥāp̄ənayim" xml:lang="hbo">חָפְנַ֛יִם</char> <char style="w" x-id="WLC.ECC.4.6.008" x-align="ECC.4.6.a006" x-target-ids="t010 t011" x-target="with labor" x-target-head="t011" x-head="true" lemma="עָמָל" strong="H5999" x-morph="Ncbsa" x-gloss="toil" x-translit="ʿāmāl" xml:lang="hbo">עָמָ֖ל</char> <char style="w" x-id="WLC