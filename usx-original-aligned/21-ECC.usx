	<para style="p"><verse number="1" style="v" x-ref="ECC.1.1" sid="ECC 1:1" /><char style="w" x-id="WLC.ECC.1.1.001" x-align="ECC.1.1.a001" x-target-ids="t001 t002" x-target="The words" x-target-head="t002" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpc" x-gloss="the.words" x-translit="diḇrê" xml:lang="hbo">דִּבְרֵי֙</char> <char style="w" x-id="WLC.ECC.1.1.002" x-align="ECC.1.1.a002" x-target-ids="t003 t004 t005" x-target="of the Preacher" x-target-head="t005" x-head="true" lemma="קֹהֶלֶת" strong="H6953" x-morph="Ncmsa" x-gloss="of.Teacher" x-translit="qōheleṯ" xml:lang="hbo">קֹהֶ֣לֶת</char> <char style="w" x-id="WLC.ECC.1.1.003" x-align="ECC.1.1.a003" x-target-ids="t006 t007" x-target="the son" x-target-head="t007" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="the.son" x-translit="ben-" xml:lang="hbo">בֶּן</char>־<char style="w" x-id="WLC.ECC.1.1.004" x-align="ECC.1.1.a004" x-target-ids="t008 t009" x-target="of David" x-target-head="t009" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="of.David" x-translit="dāwiḏ" xml:lang="hbo">דָּוִ֔ד</char> <char style="w" x-id="WLC.ECC.1.1.005" x-align="ECC.1.1.a005" x-target-ids="t010" x-target="king" x-target-head="t010" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="king" x-translit="meleḵ" xml:lang="hbo">מֶ֖לֶךְ</char> <char style="w" x-id="WLC.ECC.1.1.006" x-align="ECC.1.1.a006" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.ECC.1.1.007" x-align="ECC.1.1.a007" x-target-ids="t012" x-target="Jerusalem" x-target-head="t012" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389" x-morph="Np" x-gloss="Jerusalem" x-translit="yrûšālāim:" xml:lang="hbo">ירוּשָׁלִָֽם</char>׃<verse eid="ECC 1:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="ECC.1.2" sid="ECC 1:2" /><char style="w" x-id="WLC.ECC.1.2.001" x-align="ECC.1.2.a001" x-target-ids="t001" x-target="Vanity" x-target-head="t001" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsc" x-gloss="futility" x-translit="hăḇēl" xml:lang="hbo">הֲבֵ֤ל</char> <char style="w" x-id="WLC.ECC.1.2.002" x-align="ECC.1.2.a002" x-target-ids="t002 t003" x-target="of vanities" x-target-head="t003" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmpa" x-gloss="of.futilities" x-translit="hăḇālîm" xml:lang="hbo">הֲבָלִים֙</char> <char style="w" x-id="WLC.ECC.1.2.003" x-align="ECC.1.2.a003" x-target-ids="t004" x-target="saith" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.said" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.ECC.1.2.004" x-align="ECC.1.2.a004" x-target-ids="t005 t006" x-target="the Preacher" x-target-head="t006" x-head="true" lemma="קֹהֶלֶת" strong="H6953" x-morph="Ncmsa" x-gloss="Teacher" x-translit="qōheleṯ" xml:lang="hbo">קֹהֶ֔לֶת</char> <char style="w" x-id="WLC.ECC.1.2.005" x-align="ECC.1.2.a005" x-target-ids="t007" x-target="vanity" x-target-head="t007" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsc" x-gloss="futility" x-translit="hăḇēl" xml:lang="hbo">הֲבֵ֥ל</char> <char style="w" x-id="WLC.ECC.1.2.006" x-align="ECC.1.2.a006" x-target-ids="t008 t009" x-target="of vanities" x-target-head="t009" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmpa" x-gloss="of.futilities" x-translit="hăḇāliym" xml:lang="hbo">הֲבָלִ֖ים</char> <char style="w" x-id="WLC.ECC.1.2.007" x-align="ECC.1.2.a007" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.ECC.1.2.008" x-align="ECC.1.2.a008" x-target-ids="t010" x-target="all" x-target-head="t010" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="everything" x-translit="kōl" xml:lang="hbo">כֹּ֥ל</char> <char style="w" x-id="WLC.ECC.1.2.009" x-align="ECC.1.2.a009" x-target-ids="t011 t012" x-target="is vanity" x-target-head="t012" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsa" x-gloss="[is].futility" x-translit="hāḇel:" xml:lang="hbo">הָֽבֶל</char>׃<verse eid="ECC 1:2" /></para>
	<para style="p"><verse number="3" style="v" x-ref="ECC.1.3" sid="ECC 1:3" /><char style="w" x-id="WLC.ECC.1.3.001" x-align="ECC.1.3.a001" x-target-ids="t001" x-target="What" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.ECC.1.3.002" x-align="ECC.1.3.a002" x-target-ids="t002" x-target="profit" x-target-head="t002" x-head="true" lemma="יִתְרוֹן" strong="H3504" x-morph="Ncmsa" x-gloss="advantage" x-translit="yyiṯrôn" xml:lang="hbo">יִּתְר֖וֹן</char> <char style="w" x-id="WLC.ECC.1.3.003" x-align="ECC.1.3.a003" x-target-ids="t003" x-target="hath" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="[belongs].to" x-translit="lā" xml:lang="hbo">לָֽ</char><char style="w" x-id="WLC.ECC.1.3.004" x-align="ECC.1.3.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.ECC.1.3.005" x-align="ECC.1.3.a005" x-target-ids="t004" x-target="man" x-target-head="t004" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="humankind" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֑ם</char> <char style="w" x-id="WLC.ECC.1.3.006" x-align="ECC.1.3.a006" x-target-ids="t005" x-target="of" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.ECC.1.3.007" x-align="ECC.1.3.a007" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.ECC.1.3.008" x-align="ECC.1.3.a008" x-target-ids="t008" x-target="labor" x-target-head="t008" x-head="true" lemma="עָמָל" strong="H5999" x-morph="Ncbsc" x-gloss="toil" x-translit="ʿămāl" xml:lang="hbo">עֲמָל֔</char><char style="w" x-id="WLC.ECC.1.3.009" x-align="ECC.