	<para style="p"><verse number="8" style="v" x-ref="ECC.4.8" x-added-alignments="ECC.4.8.a005 ECC.4.8.a030" x-added-target-ids="t008 t039 t040" x-added-target="he | saith he" sid="ECC 4:8" /><char style="w" x-id="WLC.ECC.4.8.001" x-align="ECC.4.8.a001" x-target-ids="t001 t002" x-target="There is" x-target-head="t002" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[was]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.ECC.4.8.002" x-align="ECC.4.8.a002" x-target-ids="t003 t004 t005 t006" x-target="one that is alone" x-target-head="t003" x-head="true" lemma="אֶחָד" strong="H259" x-morph="Acmsa" x-gloss="one.[person]" x-translit="ʾeḥāḏ" xml:lang="hbo">אֶחָד֩</char> <char style="w" x-id="WLC.ECC.4.8.003" x-align="ECC.4.8.a003" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ECC.4.8.004" x-align="ECC.4.8.a004" x-target-ids="t009 t010" x-target="hath not" x-target-head="t010" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[was].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֨ין</char> <char style="w" x-id="WLC.ECC.4.8.005" x-align="ECC.4.8.a006" x-target-ids="t011 t012" x-target="a second" x-target-head="t012" x-head="true" lemma="שֵׁנִי" strong="H8145" x-morph="Aomsa" x-gloss="a.second.[person]" x-translit="šēniy" xml:lang="hbo">שֵׁנִ֜י</char> <char style="w" x-id="WLC.ECC.4.8.006" x-align="ECC.4.8.a007" x-target-ids="t013" x-target="yea" x-target-head="t013" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam" xml:lang="hbo">גַּ֣ם</char> <char style="w" x-id="WLC.ECC.4.8.007" x-align="ECC.4.8.a008" x-target-ids="t017" x-target="son" x-target-head="t017" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="a.son" x-translit="bēn" xml:lang="hbo">בֵּ֧ן</char> <char style="w" x-id="WLC.ECC.4.8.008" x-align="ECC.4.8.a009" x-targ