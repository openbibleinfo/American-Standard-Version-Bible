	<para style="p"><verse number="4" style="v" x-ref="ECC.1.4" sid="ECC 1:4" /><char style="w" x-id="WLC.ECC.1.4.001" x-align="ECC.1.4.a001" x-target-ids="t001 t002" x-target="One generation" x-target-head="t002" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsa" x-gloss="a.generation" x-translit="dôr" xml:lang="hbo">דּ֤וֹר</char> <char style="w" x-id="WLC.ECC.1.4.002" x-align="ECC.1.4.a002" x-target-ids="t003" x-target="goeth" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[is].going" x-translit="hōlēḵə" xml:lang="hbo">הֹלֵךְ֙</char> <char style="w" x-id="WLC.ECC.1.4.003" x-align="ECC.1.4.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ECC.1.4.004" x-align="ECC.1.4.a004" x-target-ids="t005 t006" x-target="another generation" x-target-head="t006" x-head="true" lemma="דּוֹר" strong="H1755" x-morph="Ncmsa" x-gloss="a.generation" x-translit="ḏôr" xml:lang="hbo">ד֣וֹר</char> <char style="w" x-id="WLC.ECC.1.4.005" x-align="ECC.1.4.a005" x-target-ids="t007" x-target="cometh" x-target-head="t007" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqrmsa" x-gloss="[is].coming" x-translit="bāʾ" xml:lang="hbo">בָּ֔א</char> <char style="w" x-id="WLC.ECC.1.4.006" x-align="ECC.1.4.a006" x-target-ids="t008" x-target="but" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.ECC.1.4.007" x-align="ECC.1.4.a007" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.ECC.1.4.008" x-align="ECC.1.4.a008" x-target-ids="t010" x-target="earth" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ" xml:lang