	<para style="p"><verse number="13" style="v" x-ref="JER.30.13" sid="JER 30:13" /><char style="w" x-id="WLC.JER.30.13.001" x-align="JER.30.13.a001" x-target-ids="t001 t002 t003" x-target="There is none" x-target-head="t003" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn-" xml:lang="hbo">אֵֽין</char>־<char style="w" x-id="WLC.JER.30.13.002" x-align="JER.30.13.a002" x-target-ids="t004 t005" x-target="to plead" x-target-head="t005" x-head="true" lemma="דִּין" strong="H1777" x-morph="Vqrmsa" x-gloss="[one.who].pleads" x-translit="dān" xml:lang="hbo">דָּ֥ן</char> <char style="w" x-id="WLC.JER.30.13.003" x-align="JER.30.13.a003" x-target-ids="t007" x-target="cause" x-target-head="t007" x-head="true" lemma="דִּין" strong="H1779" x-morph="Ncmsc" x-gloss="cause" x-translit="diyn" xml:lang="hbo">דִּינֵ֖</char><char style="w" x-id="WLC.JER.30.13.004" x-align="JER.30.13.a004" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="ēḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.JER.30.13.005" x-align="JER.30.13.a005" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JER.30.13.006" x-align="JER.30.13.a006" x-target-ids="t009 t010 t011 t012 t013" x-target="thou mayest be bound up" x-target-head="t012" x-head="true" lemma="מָזוֹר" strong="H4205" x-morph="Ncmsa" x-gloss="a.sore" x-translit="māzôr" xml:lang="hbo">מָז֑וֹר</char> <char style="w" x-id="WLC.JER.30.13.007" x-align="JER.30.13.a007" x-target-ids="t018" x-target="medicines" x-target-head="t018" x-head="true" lemma="רְפוּאָה" strong="H7499" x-morph="Ncfpc" x-gloss="medications" x-translit="rəp̄uʾôṯ" xml:lang="hbo">רְפֻא֥וֹת</char> <char style="w" x-id="WLC.JER.30.13.008" x-align="JER.30.13.a008" x-target-ids="t017" x-target="healing" x-target-head=