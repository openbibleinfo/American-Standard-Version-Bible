	<para style="p"><verse number="12" style="v" x-ref="JER.30.12" x-added-alignments="JER.30.12.a012" x-added-target-ids="t009" x-added-target="and" sid="JER 30:12" /><char style="w" x-id="WLC.JER.30.12.001" x-align="JER.30.12.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.JER.30.12.002" x-align="JER.30.12.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="ḵōh" xml:lang="hbo">כֹ֥ה</char> <char style="w" x-id="WLC.JER.30.12.003" x-align="JER.30.12.a003" x-target-ids="t003" x-target="saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֛ר</char> <char style="w" x-id="WLC.JER.30.12.004" x-align="JER.30.12.a004" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.JER.30.12.005" x-align="JER.30.12.a005" x-target-ids="t007 t008" x-target="is incurable" x-target-head="t008" x-head="true" lemma="אָנוּשׁ" strong="H605a" x-morph="Aamsa" x-gloss="[is].incurable" x-translit="ʾānûš" xml:lang="hbo">אָנ֣וּשׁ</char> <char style="w" x-id="WLC.JER.30.12.006" x-align="JER.30.12.a006" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JER.30.12.007" x-align="JER.30.12.a007" x-target-ids="t006" x-target="hurt" x-target-head="t006" x-head="true" lemma="שֶׁבֶר" strong="H7667" x-morph="Ncmsc" x-gloss="fracture" x-translit="šiḇr" xml:lang="hbo">שִׁבְרֵ֑</char><char style="w" x-id="WLC.JER.30.12.008" x-align="JER.30.12.a008" x-target-ids="t005" x-target="Thy" x-target-head="t005" x-head="true" lemma="הו