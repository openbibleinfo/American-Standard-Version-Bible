	<para style="p"><verse number="15" style="v" x-ref="JER.30.15" x-added-alignments="JER.30.15.a020" x-added-target-ids="t017" x-added-target="because" sid="JER 30:15" /><char style="w" x-id="WLC.JER.30.15.001" x-align="JER.30.15.a001" x-target-ids="t001" x-target="Why" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.JER.30.15.002" x-align="JER.30.15.a002" x-target-ids="t002 t003" x-target="criest thou" x-target-head="t002" x-head="true" lemma="זָעַק" strong="H2199" x-morph="Vqi2ms" x-gloss="do.you.cry.out" x-translit="tizʿaq" xml:lang="hbo">תִּזְעַק֙</char> <char style="w" x-id="WLC.JER.30.15.003" x-align="JER.30.15.a003" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JER.30.15.004" x-align="JER.30.15.a004" x-target-ids="t006" x-target="hurt" x-target-head="t006" x-head="true" lemma="שֶׁבֶר" strong="H7667" x-morph="Ncmsc" x-gloss="fracture" x-translit="šiḇr" xml:lang="hbo">שִׁבְרֵ֔</char><char style="w" x-id="WLC.JER.30.15.005" x-align="JER.30.15.a005" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509c" x-morph="Sp2fs" x-gloss="your" x-translit="ēḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.JER.30.15.006" x-align="JER.30.15.a006" x-target-ids="t009 t010" x-target="is incurable" x-target-head="t010" x-head="true" lemma="אָנוּשׁ" strong="H605a" x-morph="Aamsa" x-gloss="[is].incurable" x-translit="ʾānûš" xml:lang="hbo">אָנ֖וּשׁ</char> <char style="w" x-id="WLC.JER.30.15.007" x-align="JER.30.15.a007" x-target-ids="t008" x-target="pain" x-target-head="t008" x-head="true" lemma="מַכְאוֹב" strong="H4341" x-morph="Ncmsc" x-gloss="pain" x-translit="maḵʾōḇ" xml:lang="hbo">מַכְאֹבֵ֑</char><char style="w" x-id="WLC.JER.30.15.008" x-align="JER.30.15.a008" x-target-ids="t0