	<para style="p"><verse number="5" style="v" x-ref="JER.30.5" sid="JER 30:5" /><char style="w" x-id="WLC.JER.30.5.001" x-align="JER.30.5.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JER.30.5.002" x-align="JER.30.5.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="ḵōh" xml:lang="hbo">כֹה֙</char> <char style="w" x-id="WLC.JER.30.5.003" x-align="JER.30.5.a003" x-target-ids="t003" x-target="saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.JER.30.5.004" x-align="JER.30.5.a004" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֔ה</char> <char style="w" x-id="WLC.JER.30.5.005" x-align="JER.30.5.a005" x-target-ids="t008 t009" x-target="a voice" x-target-head="t009" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="a.voice" x-translit="qôl" xml:lang="hbo">ק֥וֹל</char> <char style="w" x-id="WLC.JER.30.5.006" x-align="JER.30.5.a006" x-target-ids="t010 t011" x-target="of trembling" x-target-head="t011" x-head="true" lemma="חֲרָדָה" strong="H2731" x-morph="Ncfsa" x-gloss="of.trembling" x-translit="ḥărāḏāh" xml:lang="hbo">חֲרָדָ֖ה</char> <char style="w" x-id="WLC.JER.30.5.007" x-align="JER.30.5.a007" x-target-ids="t005 t006 t007" x-target="We have heard" x-target-head="t007" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp1cp" x-gloss="we.have.heard" x-translit="šāmāʿənû" xml:lang="hbo">שָׁמָ֑עְנוּ</char> <char style="w" x-id="WLC.JER.30.5.008" x-align="JER.30.5.a008" x-target-ids="t012 t013" x-target="of fear" x-target-head="t013" x-head="true" lemma="פַּחַד" st