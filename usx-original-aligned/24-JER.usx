	<para style="p"><verse number="20" style="v" x-ref="JER.8.20" sid="JER 8:20" /><char style="w" x-id="WLC.JER.8.20.001" x-align="JER.8.20.a001" x-target-ids="t003 t004" x-target="is past" x-target-head="t004" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqp3ms" x-gloss="it.has.passed" x-translit="ʿāḇar" xml:lang="hbo">עָבַ֥ר</char> <char style="w" x-id="WLC.JER.8.20.002" x-align="JER.8.20.a002" x-target-ids="t001 t002" x-target="The harvest" x-target-head="t002" x-head="true" lemma="קָצִיר" strong="H7105" x-morph="Ncmsa" x-gloss="harvest" x-translit="qāṣiyr" xml:lang="hbo">קָצִ֖יר</char> <char style="w" x-id="WLC.JER.8.20.003" x-align="JER.8.20.a003" x-target-ids="t007 t008" x-target="is ended" x-target-head="t008" x-head="true" lemma="כָּלָה" strong="H3615" x-morph="Vqp3ms" x-gloss="it.has.come.to.an.end" x-translit="kālâ" xml:lang="hbo">כָּ֣לָה</char> <char style="w" x-id="WLC.JER.8.20.004" x-align="JER.8.20.a004" x-target-ids="t005 t006" x-target="the summer" x-target-head="t006" x-head="true" lemma="קַיִץ" strong="H7019" x-morph="Ncmsa" x-gloss="summer" x-translit="qāyiṣ" xml:lang="hbo">קָ֑יִץ</char> <char style="w" x-id="WLC.JER.8.20.005" x-align="JER.8.20.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.JER.8.20.006" x-align="JER.8.20.a006" x-target-ids="t010" x-target="we" x-target-head="t010" x-head="true" lemma="אֲנַחְנוּ" strong="H587" x-morph="Pp1cp" x-gloss="we" x-translit="ʾănaḥənû" xml:lang="hbo">אֲנַ֖חְנוּ</char> <char style="w" x-id="WLC.JER.8.20.007" x-align="JER.8.20.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lôʾ" xml:lang="hbo">ל֥וֹא</char> <char style="w" x-id="WLC.JER.8.20.008" x-align="JER.8.20.a008" x-target-ids="t011 t013" x-target="are saved" x-target-head="t013" x-head="true" lemma="יָשַׁע" st