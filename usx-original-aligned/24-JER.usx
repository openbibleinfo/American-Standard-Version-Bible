	<para style="p"><verse number="25" style="v" x-ref="JER.31.25" sid="JER 31:25" /><char style="w" x-id="WLC.JER.31.25.001" x-align="JER.31.25.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.JER.31.25.002" x-align="JER.31.25.a002" x-target-ids="t002 t003 t004" x-target="I have satiated" x-target-head="t004" x-head="true" lemma="רָוָה" strong="H7301" x-morph="Vhp1cs" x-gloss="I.give.water.to" x-translit="hirwēyṯî" xml:lang="hbo">הִרְוֵ֖יתִי</char> <char style="w" x-id="WLC.JER.31.25.003" x-align="JER.31.25.a004" x-target-ids="t005 t007" x-target="the soul" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsa" x-gloss="[the].throat" x-translit="nep̄eš" xml:lang="hbo">נֶ֣פֶשׁ</char> <char style="w" x-id="WLC.JER.31.25.004" x-align="JER.31.25.a003" x-target-ids="t006" x-target="weary" x-target-head="t006" x-head="true" lemma="עָיֵף" strong="H5889" x-morph="Aafsa" x-gloss="of.[the].weary" x-translit="ʿăyēp̄āh" xml:lang="hbo">עֲיֵפָ֑ה</char> <char style="w" x-id="WLC.JER.31.25.005" x-align="JER.31.25.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.31.25.006" x-align="JER.31.25.a006" x-target-ids="t009" x-target="every" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.JER.31.25.007" x-align="JER.31.25.a008" x-target-ids="t011" x-target="soul" x-target-head="t011" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsa" x-gloss="person" x-translit="nep̄eš" xml:lang="hbo">נֶ֥פֶשׁ</char> <char style="w" x-id="WLC.JER.31.25.008" x-align="JER.31.25.a007" x-target-ids="t010" x-target="sorrowful" x-target-head="t010" x-head="true" lemma="