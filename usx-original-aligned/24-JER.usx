	<para style="p"><verse number="1" style="v" x-ref="JER.4.1" x-added-alignments="JER.4.1.a006" x-added-target-ids="t009" x-added-target="if" sid="JER 4:1" /><char style="w" x-id="WLC.JER.4.1.001" x-align="JER.4.1.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JER.4.1.002" x-align="JER.4.1.a002" x-target-ids="t002 t003 t004" x-target="thou wilt return" x-target-head="t004" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi2ms" x-gloss="you.will.return" x-translit="tāšûḇ" xml:lang="hbo">תָּשׁ֨וּב</char> <char style="w" x-id="WLC.JER.4.1.003" x-align="JER.4.1.a003" x-target-ids="t005 t006" x-target="O Israel" x-target-head="t006" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="O.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֧ל</char>׀<char style="w" x-id="WLC.JER.4.1.004" x-align="JER.4.1.a004" x-target-ids="t007" x-target="saith" x-target-head="t007" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum-" xml:lang="hbo">נְאֻם</char>־<char style="w" x-id="WLC.JER.4.1.005" x-align="JER.4.1.a005" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֛ה</char> <char style="w" x-id="WLC.JER.4.1.006" x-align="JER.4.1.a008" x-target-ids="t013" x-target="unto" x-target-head="t013" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלַ֖</char><char style="w" x-id="WLC.JER.4.1.007" x-align="JER.4.1.a009" x-target-ids="t014" x-target="me" x-target-head="t014" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JER.4.1.008" x-align="JER.4.1.a007" x-target-ids="t010 t011 t012" x-target="thou wilt return" 