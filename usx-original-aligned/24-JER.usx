	<para style="p"><verse number="17" style="v" x-ref="JER.1.17" sid="JER 1:17" /><char style="w" x-id="WLC.JER.1.17.001" x-align="JER.1.17.a001" x-target-ids="t002" x-target="therefore" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.1.17.002" x-align="JER.1.17.a002" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּה֙</char> <char style="w" x-id="WLC.JER.1.17.003" x-align="JER.1.17.a003" x-target-ids="t003 t004" x-target="gird up" x-target-head="t003" x-head="true" lemma="אָזַר" strong="H247" x-morph="Vqi2ms" x-gloss="you.will.gird.up" x-translit="teʾzōr" xml:lang="hbo">תֶּאְזֹ֣ר</char> <char style="w" x-id="WLC.JER.1.17.004" x-align="JER.1.17.a004" x-target-ids="t006" x-target="loins" x-target-head="t006" x-head="true" lemma="מׇתְנַיִם" strong="H4975" x-morph="Ncmdc" x-gloss="loins" x-translit="māṯəney" xml:lang="hbo">מָתְנֶ֔י</char><char style="w" x-id="WLC.JER.1.17.005" x-align="JER.1.17.a005" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JER.1.17.006" x-align="JER.1.17.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.1.17.007" x-align="JER.1.17.a007" x-target-ids="t008" x-target="arise" x-target-head="t008" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqq2ms" x-gloss="you.will.arise" x-translit="qamtā" xml:lang="hbo">קַמְתָּ֙</char> <char style="w" x-id="WLC.JER.1.17.008" x-align="JER.1.17.a008" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml