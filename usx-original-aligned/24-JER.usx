	<para style="p"><verse number="1" style="v" x-ref="JER.5.1" sid="JER 5:1" /><char style="w" x-id="WLC.JER.5.1.001" x-align="JER.5.1.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="Run ye to and fro" x-target-head="t001" x-head="true" lemma="שׁוּט" strong="H7751" x-morph="Vov2mp" x-gloss="rove.about" x-translit="šôṭəṭû" xml:lang="hbo">שׁוֹטְט֞וּ</char> <char style="w" x-id="WLC.JER.5.1.002" x-align="JER.5.1.a002" x-target-ids="t006" x-target="through" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JER.5.1.003" x-align="JER.5.1.a003" x-target-ids="t007 t008" x-target="the streets" x-target-head="t008" x-head="true" lemma="חוּץ" strong="H2351" x-morph="Ncmpc" x-gloss="the.streets" x-translit="ḥûṣôṯ" xml:lang="hbo">חוּצ֣וֹת</char> <char style="w" x-id="WLC.JER.5.1.004" x-align="JER.5.1.a004" x-target-ids="t009 t010" x-target="of Jerusalem" x-target-head="t010" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389" x-morph="Np" x-gloss="of.Jerusalem" x-translit="yərûšālaim" xml:lang="hbo">יְרוּשָׁלִַ֗ם</char> <char style="w" x-id="WLC.JER.5.1.005" x-align="JER.5.1.a005" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JER.5.1.006" x-align="JER.5.1.a006" x-target-ids="t012" x-target="see" x-target-head="t012" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqv2mp" x-gloss="see" x-translit="rəʾû-" xml:lang="hbo">רְאוּ</char>־<char style="w" x-id="WLC.JER.5.1.007" x-align="JER.5.1.a007" x-target-ids="t013" x-target="now" x-target-head="t013" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֤א</char> <char style="w" x-id="WLC.JER.5.1.008" x-align="JER.5.1.a008" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x