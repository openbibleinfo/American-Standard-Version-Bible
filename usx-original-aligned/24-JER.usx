	<para style="p"><verse number="3" style="v" x-ref="JER.51.3" sid="JER 51:3" /><char style="w" x-id="WLC.JER.51.3.001" x-align="JER.51.3.a001" x-target-ids="t001" x-target="Against" x-target-head="t001" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶֽל</char>־<char style="w" x-id="WLC.JER.51.3.002" x-align="JER.51.3.a002" x-target-ids="t002 t003 t004" x-target="him that bendeth" x-target-italic-ids="t002 t003" x-target-head="t004" x-head="true" lemma="דָּרַךְ" strong="H1869" x-morph="Vqi3ms" x-gloss="let.him.bend" x-translit="yiḏrōḵ" xml:lang="hbo">יִדְרֹ֤ךְ</char> <char style="w" x-id="WLC.JER.51.3.v001.r01.001" x-align="JER.51.3.a003" x-target-ids="t005 t008" x-target="let bend" x-target-head="t008" x-head="true" lemma="דָּרַךְ" strong="H1869" x-morph="Vqi3ms" x-translit="yḏrḵ" xml:lang="hbo">ידרך</char><char style="w" x-id="WLC.JER.51.3.003" x-align="JER.51.3.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.[one" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JER.51.3.004" x-align="JER.51.3.a005" x-target-ids="t007" x-target="archer" x-target-head="t007" x-head="true" lemma="דָּרַךְ" strong="H1869" x-morph="Vqrmsa" x-gloss="who].bends" x-translit="dōrēḵə" xml:lang="hbo">דֹּרֵךְ֙</char> <char style="w" x-id="WLC.JER.51.3.005" x-align="JER.51.3.a006" x-target-ids="t010" x-target="bow" x-target-head="t010" x-head="true" lemma="קֶשֶׁת" strong="H7198" x-morph="Ncfsc" x-gloss="bow" x-translit="qašt" xml:lang="hbo">קַשְׁתּ֔</char><char style="w" x-id="WLC.JER.51.3.006" x-align="JER.51.3.a007" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JER.51.3.007" x-align="JER.51.3.a008" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-mo