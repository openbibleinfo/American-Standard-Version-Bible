	<para style="p"><verse number="14" style="v" x-ref="JER.10.14" x-added-alignments="JER.10.14.a006 JER.10.14.a012" x-added-target-ids="t006 t017" x-added-target="and | his" sid="JER 10:14" /><char style="w" x-id="WLC.JER.10.14.001" x-align="JER.10.14.a001" x-target-ids="t003 t004 t005" x-target="is become brutish" x-target-head="t005" x-head="true" lemma="בָּעַר" strong="H1197b" x-morph="VNp3ms" x-gloss="he.is.stupid" x-translit="niḇʿar" xml:lang="hbo">נִבְעַ֤ר</char> <char style="w" x-id="WLC.JER.10.14.002" x-align="JER.10.14.a002" x-target-ids="t001" x-target="Every" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.JER.10.14.003" x-align="JER.10.14.a003" x-target-ids="t002" x-target="man" x-target-head="t002" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="person" x-translit="ʾāḏām" xml:lang="hbo">אָדָם֙</char> <char style="w" x-id="WLC.JER.10.14.004" x-align="JER.10.14.a004" x-target-ids="t007 t008" x-target="is without" x-target-italic-ids="t007" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.JER.10.14.005" x-align="JER.10.14.a005" x-target-ids="t009" x-target="knowledge" x-target-head="t009" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="daʿaṯ" xml:lang="hbo">דַּ֔עַת</char> <char style="w" x-id="WLC.JER.10.14.006" x-align="JER.10.14.a007" x-target-ids="t012 t013 t014 t015" x-target="is put to shame" x-target-head="t015" x-head="true" lemma="יָבֵשׁ" strong="H954" x-morph="Vhp3ms" x-gloss="he.is.put.to.shame" x-translit="hōḇiyš" xml:lang="hbo">הֹבִ֥ישׁ</char> <char style="w" x-id="WLC.JER.10.14.007" x-align="JER.10.14.a008" x-target-ids="t010" x-target="every" x-target-head="t010" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang