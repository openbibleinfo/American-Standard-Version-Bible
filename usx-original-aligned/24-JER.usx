	<para style="p"><verse number="12" style="v" x-ref="JER.8.12" sid="JER 8:12" /><char style="w" x-id="WLC.JER.8.12.001" x-align="JER.8.12.a001" x-target-ids="t001 t002 t003" x-target="Were they ashamed" x-target-head="t003" x-head="true" lemma="יָבֵשׁ" strong="H954" x-morph="Vhp3cp" x-gloss="are.they.ashamed?" x-translit="hōḇišû" xml:lang="hbo">הֹבִ֕שׁוּ</char> <char style="w" x-id="WLC.JER.8.12.002" x-align="JER.8.12.a002" x-target-ids="t004" x-target="when" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.JER.8.12.003" x-align="JER.8.12.a003" x-target-ids="t008" x-target="abomination" x-target-head="t008" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsa" x-gloss="an.abomination" x-translit="ṯôʿēḇāh" xml:lang="hbo">תוֹעֵבָ֖ה</char> <char style="w" x-id="WLC.JER.8.12.004" x-align="JER.8.12.a004" x-target-ids="t005 t006 t007" x-target="they had committed" x-target-head="t007" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3cp" x-gloss="they.have.done" x-translit="ʿāśû" xml:lang="hbo">עָשׂ֑וּ</char> <char style="w" x-id="WLC.JER.8.12.005" x-align="JER.8.12.a005" x-target-ids="t009" x-target="nay" x-target-head="t009" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.JER.8.12.006" x-align="JER.8.12.a006" x-target-ids="t013 t014" x-target="at all" x-target-head="t014" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqa" x-gloss="at.all.(ashamed)" x-translit="bôš" xml:lang="hbo">בּ֣וֹשׁ</char> <char style="w" x-id="WLC.JER.8.12.007" x-align="JER.8.12.a007" x-target-ids="t012" x-target="not" x-target-head="t012" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.JER.8.12.008" x-align="JER.8.12.a008" x-target-ids="t010 t011 t015" x-target="they were ashamed