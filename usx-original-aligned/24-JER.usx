	<para style="p"><verse number="51" style="v" x-ref="JER.51.51" sid="JER 51:51" /><char style="w" x-id="WLC.JER.51.51.001" x-align="JER.51.51.a001" x-target-ids="t001 t002 t003" x-target="We are confounded" x-target-head="t003" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vqp1cp" x-gloss="we.are.ashamed" x-translit="bōšənû" xml:lang="hbo">בֹּ֚שְׁנוּ</char> <char style="w" x-id="WLC.JER.51.51.002" x-align="JER.51.51.a002" x-target-ids="t004" x-target="because" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.JER.51.51.003" x-align="JER.51.51.a003" x-target-ids="t005 t006 t007" x-target="we have heard" x-target-head="t007" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqp1cp" x-gloss="we.have.heard" x-translit="šāmaʿənû" xml:lang="hbo">שָׁמַ֣עְנוּ</char> <char style="w" x-id="WLC.JER.51.51.004" x-align="JER.51.51.a004" x-target-ids="t008" x-target="reproach" x-target-head="t008" x-head="true" lemma="חֶרְפָּה" strong="H2781" x-morph="Ncfsa" x-gloss="scorn" x-translit="ḥerpāh" xml:lang="hbo">חֶרְפָּ֔ה</char> <char style="w" x-id="WLC.JER.51.51.005" x-align="JER.51.51.a005" x-target-ids="t010 t011" x-target="hath covered" x-target-head="t011" x-head="true" lemma="כָּסָה" strong="H3680" x-morph="Vpp3fs" x-gloss="it.has.covered" x-translit="kissəṯāh" xml:lang="hbo">כִּסְּתָ֥ה</char> <char style="w" x-id="WLC.JER.51.51.006" x-align="JER.51.51.a006" x-target-ids="t009" x-target="confusion" x-target-head="t009" x-head="true" lemma="כְּלִמָּה" strong="H3639" x-morph="Ncfsa" x-gloss="ignominy" x-translit="ḵəlimmāh" xml:lang="hbo">כְלִמָּ֖ה</char> <char style="w" x-id="WLC.JER.51.51.007" x-align="JER.51.51.a007" x-target-ids="t013" x-target="faces" x-target-head="t013" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="faces" x-translit="pānēy" xml:lang="hbo">פָּנֵ֑י</char><char style="w" x-id="WLC.JER.51.51.008" x-align="JER.51.51.a008