	<para style="p"><verse number="18" style="v" x-ref="JER.8.18" sid="JER 8:18" /><char style="w" x-id="WLC.JER.8.18.001" x-align="JER.8.18.a001" x-target-ids="t001 t002 t004 t005" x-target="Oh that could comfort" x-target-head="t005" x-head="true" lemma="מַבְלִיגִית" strong="H4010" x-morph="Ncfsc" x-gloss="cheerfulness" x-translit="maḇliyḡiyṯ" xml:lang="hbo">מַבְלִ֥יגִיתִ֖</char><char style="w" x-id="WLC.JER.8.18.002" x-align="JER.8.18.a002" x-target-ids="t003 t006" x-target="I myself" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JER.8.18.003" x-align="JER.8.18.a003" x-target-ids="t007" x-target="against" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿălēy" xml:lang="hbo">עֲלֵ֣י</char> <char style="w" x-id="WLC.JER.8.18.004" x-align="JER.8.18.a004" x-target-ids="t008" x-target="sorrow" x-target-head="t008" x-head="true" lemma="יָגוֹן" strong="H3015" x-morph="Ncmsa" x-gloss="sorrow" x-translit="yāḡôn" xml:lang="hbo">יָג֑וֹן</char> <char style="w" x-id="WLC.JER.8.18.005" x-align="JER.8.18.a005" x-target-ids="t013" x-target="within" x-target-head="t013" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿāl" xml:lang="hbo">עָלַ֖</char><char style="w" x-id="WLC.JER.8.18.006" x-align="JER.8.18.a006" x-target-ids="t014" x-target="me" x-target-head="t014" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JER.8.18.007" x-align="JER.8.18.a007" x-target-ids="t010" x-target="heart" x-target-head="t010" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבִּ֥</char><char style="w" x-id="WLC.JER.8.18.008" x-align="JER.8.18.a008" x-target-ids="t009" x-target="my" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss