	<para style="p"><verse number="14" style="v" x-ref="JER.51.14" x-added-alignments="JER.51.14.a006" x-added-target-ids="t008" x-added-target="saying" sid="JER 51:14" /><char style="w" x-id="WLC.JER.51.14.001" x-align="JER.51.14.a001" x-target-ids="t004 t005" x-target="hath sworn" x-target-head="t005" x-head="true" lemma="שָׁבַע" strong="H7650" x-morph="VNp3ms" x-gloss="he.swears" x-translit="nišbaʿ" xml:lang="hbo">נִשְׁבַּ֛ע</char> <char style="w" x-id="WLC.JER.51.14.002" x-align="JER.51.14.a002" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֥ה</char> <char style="w" x-id="WLC.JER.51.14.003" x-align="JER.51.14.a003" x-target-ids="t002 t003" x-target="of hosts" x-target-head="t003" x-head="true" lemma="צָבָא" strong="H6635" x-morph="Ncbpa" x-gloss="of.hosts" x-translit="ṣəḇāʾôṯ" xml:lang="hbo">צְבָא֖וֹת</char> <char style="w" x-id="WLC.JER.51.14.004" x-align="JER.51.14.a004" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.JER.51.14.005" x-align="JER.51.14.a005" x-target-ids="t007" x-target="himself" x-target-head="t007" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשׁ֑</char><char style="w" x-id="WLC.JER.51.14.006" x-align="JER.51.14.a005" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.JER.51.14.007" x-align="JER.51.14.a007" x-target-ids="t009" x-target="Surely" x-target-head="t009" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.JER.51.14.008" x-align="JER.51.14.a007" lemma="אִם" strong="H518" x-morph="C" x-gloss="(if)" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char sty