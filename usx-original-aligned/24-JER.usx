	<para style="p"><verse number="14" style="v" x-ref="JER.8.14" sid="JER 8:14" /><char style="w" x-id="WLC.JER.8.14.001" x-align="JER.8.14.a001" lemma="עַל" strong="H5921" x-morph="R" x-gloss="concerning" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JER.8.14.002" x-align="JER.8.14.a001" x-target-ids="t001" x-target="Why" x-target-head="t001" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="māh" xml:lang="hbo">מָה֙</char> <char style="w" x-id="WLC.JER.8.14.003" x-align="JER.8.14.a002" x-target-ids="t003" x-target="we" x-target-head="t003" x-head="true" lemma="אֲנַחְנוּ" strong="H587" x-morph="Pp1cp" x-gloss="[are].we" x-translit="ʾănaḥənû" xml:lang="hbo">אֲנַ֣חְנוּ</char> <char style="w" x-id="WLC.JER.8.14.004" x-align="JER.8.14.a003" x-target-ids="t002 t004 t005" x-target="do sit still" x-target-head="t004" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqrmpa" x-gloss="sitting" x-translit="yōšəḇiym" xml:lang="hbo">יֹֽשְׁבִ֔ים</char> <char style="w" x-id="WLC.JER.8.14.005" x-align="JER.8.14.a004" x-target-ids="t006 t007" x-target="assemble yourselves" x-target-head="t006" x-head="true" lemma="אָסַף" strong="H622" x-morph="VNv2mp" x-gloss="gather.yourselves" x-translit="hēʾāsəp̄û" xml:lang="hbo">הֵֽאָסְפ֗וּ</char> <char style="w" x-id="WLC.JER.8.14.006" x-align="JER.8.14.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.8.14.007" x-align="JER.8.14.a006" x-target-ids="t009 t010 t011" x-target="let us enter" x-target-head="t011" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqh1cp" x-gloss="let.us.go" x-translit="nāḇôʾ" xml:lang="hbo">נָב֛וֹא</char> <char style="w" x-id="WLC.JER.8.14.008" x-align="JER.8.14.a007" x-target-ids="t012" x-target="into" x-target-head="t012" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="into" x-translit="ʾel-" xml: