	<para style="p"><verse number="21" style="v" x-ref="JER.10.21" sid="JER 10:21" /><char style="w" x-id="WLC.JER.10.21.001" x-align="JER.10.21.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.JER.10.21.002" x-align="JER.10.21.a002" x-target-ids="t004 t005 t006" x-target="are become brutish" x-target-head="t006" x-head="true" lemma="בָּעַר" strong="H1197b" x-morph="VNp3cp" x-gloss="they.are.stupid" x-translit="niḇʿărû" xml:lang="hbo">נִבְעֲרוּ֙</char> <char style="w" x-id="WLC.JER.10.21.003" x-align="JER.10.21.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָֽ</char><char style="w" x-id="WLC.JER.10.21.004" x-align="JER.10.21.a004" x-target-ids="t003" x-target="shepherds" x-target-head="t003" x-head="true" lemma="רָעָה" strong="H7473" x-morph="Vqrmpa" x-gloss="shepherds" x-translit="rōʿiym" xml:lang="hbo">רֹעִ֔ים</char> <char style="w" x-id="WLC.JER.10.21.005" x-align="JER.10.21.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.10.21.006" x-align="JER.10.21.a006" x-target-ids="t011" x-target="of" x-target-head="t011" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.JER.10.21.007" x-align="JER.10.21.a007" x-target-ids="t012" x-target="Jehovah" x-target-head="t012" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.JER.10.21.008" x-align="JER.10.21.a008" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-tr