	<para style="p"><verse number="6" style="v" x-ref="JER.30.6" sid="JER 30:6" /><char style="w" x-id="WLC.JER.30.6.001" x-align="JER.30.6.a001" x-target-ids="t001 t002" x-target="Ask ye" x-target-head="t001" x-head="true" lemma="שָׁאַל" strong="H7592" x-morph="Vqv2mp" x-gloss="ask" x-translit="šaʾălû-" xml:lang="hbo">שַׁאֲלוּ</char>־<char style="w" x-id="WLC.JER.30.6.002" x-align="JER.30.6.a002" x-target-ids="t003" x-target="now" x-target-head="t003" x-head="true" lemma="נָא" strong="H4994" x-morph="Te" x-gloss="please" x-translit="nāʾ" xml:lang="hbo">נָ֣א</char> <char style="w" x-id="WLC.JER.30.6.003" x-align="JER.30.6.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.JER.30.6.004" x-align="JER.30.6.a004" x-target-ids="t005" x-target="see" x-target-head="t005" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqv2mp" x-gloss="see" x-translit="rəʾû" xml:lang="hbo">רְא֔וּ</char> <char style="w" x-id="WLC.JER.30.6.005" x-align="JER.30.6.a005" x-target-ids="t006" x-target="whether" x-target-head="t006" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.JER.30.6.006" x-align="JER.30.6.a006" x-target-ids="t009 t010 t011 t012" x-target="doth travail with child" x-target-head="t010" x-head="true" lemma="יָלַד" strong="H3205" x-morph="Vqrmsa" x-gloss="[is].giving.birth" x-translit="yōlēḏ" xml:lang="hbo">יֹלֵ֖ד</char> <char style="w" x-id="WLC.JER.30.6.007" x-align="JER.30.6.a007" x-target-ids="t007 t008" x-target="a man" x-target-head="t008" x-head="true" lemma="זָכָר" strong="H2145" x-morph="Aamsa" x-gloss="a.male" x-translit="zāḵār" xml:lang="hbo">זָכָ֑ר</char> <char style="w" x-id="WLC.JER.30.6.008" x-align="JER.30.6.a008" x-target-ids="t013" x-target="wherefore" x-target-head="t013" x-head="true" lemma="מַדּוּעַ" strong="H4069" x-morph="Ti" x-gl