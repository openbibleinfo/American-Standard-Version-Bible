	<para style="p"><verse number="25" style="v" x-ref="JER.5.25" sid="JER 5:25" /><char style="w" x-id="WLC.JER.5.25.001" x-align="JER.5.25.a002" x-target-ids="t002" x-target="iniquities" x-target-head="t002" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbpc" x-gloss="iniquities" x-translit="ʿăônôṯēy" xml:lang="hbo">עֲוֺנוֹתֵי</char><char style="w" x-id="WLC.JER.5.25.002" x-align="JER.5.25.a001" x-target-ids="t001" x-target="Your" x-target-head="t001" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶ֖ם</char> <char style="w" x-id="WLC.JER.5.25.003" x-align="JER.5.25.a003" x-target-ids="t003 t004 t005" x-target="have turned away" x-target-head="t004" x-head="true" lemma="נָטָה" strong="H5186" x-morph="Vhp3cp" x-gloss="they.have.turned.aside" x-translit="hiṭṭû-" xml:lang="hbo">הִטּוּ</char>־<char style="w" x-id="WLC.JER.5.25.004" x-align="JER.5.25.a004" x-target-ids="t006 t007" x-target="these things" x-target-head="t006" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these.[things]" x-translit="ʾēlleh" xml:lang="hbo">אֵ֑לֶּה</char> <char style="w" x-id="WLC.JER.5.25.005" x-align="JER.5.25.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.5.25.006" x-align="JER.5.25.a007" x-target-ids="t010" x-target="sins" x-target-head="t010" x-head="true" lemma="חַטָּאת" strong="H2403" x-morph="Ncfpc" x-gloss="sins" x-translit="ḥaṭṭōʾwṯēy" xml:lang="hbo">חַטֹּ֣אותֵי</char><char style="w" x-id="WLC.JER.5.25.007" x-align="JER.5.25.a006" x-target-ids="t009" x-target="your" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶ֔ם</char> <char style="w" x-id="WLC.JER.5.25.008" x-align="JER.5.25.a008" x-target-ids="t011 t012" x-target="have withholden" x-target-head="t012" x-head="tr