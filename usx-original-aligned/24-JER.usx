	<para style="p"><verse number="22" style="v" x-ref="JER.30.22" sid="JER 30:22" /><char style="w" x-id="WLC.JER.30.22.001" x-align="JER.30.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִ</char><char style="w" x-id="WLC.JER.30.22.002" x-align="JER.30.22.a002" x-target-ids="t002 t003 t004" x-target="ye shall be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq2mp" x-gloss="you.will.become" x-translit="həyiyṯem" xml:lang="hbo">הְיִ֥יתֶם</char> <char style="w" x-id="WLC.JER.30.22.003" x-align="JER.30.22.a003" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">לִ֖</char><char style="w" x-id="WLC.JER.30.22.004" x-align="JER.30.22.a003" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JER.30.22.005" x-align="JER.30.22.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(into).a" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.JER.30.22.006" x-align="JER.30.22.a005" x-target-ids="t006" x-target="people" x-target-head="t006" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="people" x-translit="ʿām" xml:lang="hbo">עָ֑ם</char> <char style="w" x-id="WLC.JER.30.22.007" x-align="JER.30.22.a006" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.30.22.008" x-align="JER.30.22.a007" x-target-ids="t008" x-target="I" x-target-head="t008" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָ֣נֹכִ֔י</char> <char style="w" x-id="WLC.JER.30.22.009" x-align="JER.30.22.a008" x-target-ids="t009 t010" x-targ