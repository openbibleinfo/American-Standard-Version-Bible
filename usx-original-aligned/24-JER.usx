	<para style="p"><verse number="27" style="v" x-ref="JER.31.27" sid="JER 31:27" /><char style="w" x-id="WLC.JER.31.27.001" x-align="JER.31.27.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֛ה</char> <char style="w" x-id="WLC.JER.31.27.002" x-align="JER.31.27.a002" x-target-ids="t002 t003" x-target="the days" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="days" x-translit="yāmiym" xml:lang="hbo">יָמִ֥ים</char> <char style="w" x-id="WLC.JER.31.27.003" x-align="JER.31.27.a003" x-target-ids="t004" x-target="come" x-target-head="t004" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqrmpa" x-gloss="[are].coming" x-translit="bāʾiym" xml:lang="hbo">בָּאִ֖ים</char> <char style="w" x-id="WLC.JER.31.27.004" x-align="JER.31.27.a004" x-target-ids="t005" x-target="saith" x-target-head="t005" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum-" xml:lang="hbo">נְאֻם</char>־<char style="w" x-id="WLC.JER.31.27.005" x-align="JER.31.27.a005" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.JER.31.27.006" x-align="JER.31.27.a006" x-target-ids="t007" x-target="that" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.31.27.007" x-align="JER.31.27.a007" x-target-ids="t008 t009 t010" x-target="I will sow" x-target-head="t010" x-head="true" lemma="זָרַע" strong="H2232" x-morph="Vqq1cs" x-gloss="I.will.sow" x-translit="zāraʿtiy" xml:lang="hbo">זָרַעְתִּ֗י</char> <char style="w" x-id="WLC.JER.31.27.008" x-align="JER.31.27.a008" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-g