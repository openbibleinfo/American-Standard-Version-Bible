	<para style="p"><verse number="13" style="v" x-ref="JER.51.13" sid="JER 51:13" /><char style="w" x-id="WLC.JER.51.13.001" x-align="JER.51.13.a001" x-target-ids="t001 t002 t003 t004" x-target="O thou that dwellest" x-target-head="t004" x-head="true" lemma="שָׁכַן" strong="H7931" x-morph="Vqrfsc" x-gloss="O.[you.who].dwell" x-translit="**šōḵantə" xml:lang="hbo">שֹׁכַנְתְּ֙</char> <char style="w" x-id="WLC.JER.51.13.002" x-align="JER.51.13.a002" x-target-ids="t005" x-target="upon" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="at" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.JER.51.13.003" x-align="JER.51.13.a003" x-target-ids="t007" x-target="waters" x-target-head="t007" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="waters" x-translit="mayim" xml:lang="hbo">מַ֣יִם</char> <char style="w" x-id="WLC.JER.51.13.004" x-align="JER.51.13.a004" x-target-ids="t006" x-target="many" x-target-head="t006" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many" x-translit="rabbiym" xml:lang="hbo">רַבִּ֔ים</char> <char style="w" x-id="WLC.JER.51.13.005" x-align="JER.51.13.a005" x-target-ids="t008" x-target="abundant" x-target-head="t008" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafsc" x-gloss="greatness" x-translit="rabbaṯ" xml:lang="hbo">רַבַּ֖ת</char> <char style="w" x-id="WLC.JER.51.13.006" x-align="JER.51.13.a006" x-target-ids="t009 t010" x-target="in treasures" x-target-head="t010" x-head="true" lemma="אוֹצָר" strong="H214" x-morph="Ncmpa" x-gloss="of.treasures" x-translit="ʾôṣārōṯ" xml:lang="hbo">אֽוֹצָרֹ֑ת</char> <char style="w" x-id="WLC.JER.51.13.007" x-align="JER.51.13.a007" x-target-ids="t013 t014" x-target="is come" x-target-head="t014" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqp3ms" x-gloss="it.has.come" x-translit="bāʾ" xml:lang="hbo">בָּ֥א</char> <char style="w" x-id="WLC.JER.51.13.008" x-align="JER.51.13.a008" x-target-ids="t012" x-target="end" x-tar