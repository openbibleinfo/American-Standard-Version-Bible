	<para style="p"><verse number="12" style="v" x-ref="JER.17.12" x-added-alignments="JER.17.12.a003" x-added-target-ids="t004" x-added-target="set" sid="JER 17:12" /><char style="w" x-id="WLC.JER.17.12.001" x-align="JER.17.12.a001" x-target-ids="t001 t003 t010" x-target="A throne is" x-target-head="t003" x-head="true" lemma="כִּסֵּא" strong="H3678" x-morph="Ncmsc" x-gloss="[is].a.throne" x-translit="kissēʾ" xml:lang="hbo">כִּסֵּ֣א</char> <char style="w" x-id="WLC.JER.17.12.002" x-align="JER.17.12.a002" x-target-ids="t002" x-target="glorious" x-target-head="t002" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="of.glory" x-translit="ḵāḇôḏ" xml:lang="hbo">כָב֔וֹד</char> <char style="w" x-id="WLC.JER.17.12.003" x-align="JER.17.12.a004" x-target-ids="t005 t006" x-target="on high" x-target-head="t006" x-head="true" lemma="מָרוֹם" strong="H4791" x-morph="Ncmsa" x-gloss="a.high.place" x-translit="mārôm" xml:lang="hbo">מָר֖וֹם</char> <char style="w" x-id="WLC.JER.17.12.004" x-align="JER.17.12.a005" x-target-ids="t007" x-target="from" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵֽ</char><char style="w" x-id="WLC.JER.17.12.005" x-align="JER.17.12.a006" x-target-ids="t008 t009" x-target="the beginning" x-target-head="t009" x-head="true" lemma="רִאשׁוֹן" strong="H7223" x-morph="Aamsa" x-gloss="first.[time]" x-translit="riʾšôn" xml:lang="hbo">רִאשׁ֑וֹן</char> <char style="w" x-id="WLC.JER.17.12.006" x-align="JER.17.12.a007" x-target-ids="t011 t012" x-target="the place" x-target-head="t012" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsc" x-gloss="the.place" x-translit="məqôm" xml:lang="hbo">מְק֖וֹם</char> <char style="w" x-id="WLC.JER.17.12.007" x-align="JER.17.12.a008" x-target-ids="t013 t015" x-target="of sanctuary" x-target-head="t015" x-head="true" lemma="מִקְדָּשׁ" strong="H4720" x-morph="Ncmsc" x-gloss="our.sanctuary" x-translit="miqdāš" xml:lang="hbo">מִקְדָּשֵֽׁ</c