	<para style="p"><verse number="12" style="v" x-ref="JER.49.12" sid="JER 49:12" /><char style="w" x-id="WLC.JER.49.12.001" x-align="JER.49.12.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.JER.49.12.002" x-align="JER.49.12.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="ḵōh" xml:lang="hbo">כֹ֣ה</char>׀<char style="w" x-id="WLC.JER.49.12.003" x-align="JER.49.12.a003" x-target-ids="t003" x-target="saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.JER.49.12.004" x-align="JER.49.12.a004" x-target-ids="t004" x-target="Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֗ה</char> <char style="w" x-id="WLC.JER.49.12.005" x-align="JER.49.12.a005" x-target-ids="t005" x-target="Behold" x-target-head="t005" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="there!" x-translit="hinnēh" xml:lang="hbo">הִ֠נֵּה</char> <char style="w" x-id="WLC.JER.49.12.006" x-align="JER.49.12.a006" x-target-ids="t006 t007 t008" x-target="they to whom" x-target-head="t008" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[those].who" x-translit="ʾăšer-" xml:lang="hbo">אֲשֶׁר</char>־<char style="w" x-id="WLC.JER.49.12.007" x-align="JER.49.12.a007" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="not" x-translit="ʾēyn" xml:lang="hbo">אֵ֨ין</char> <char style="w" x-id="WLC.JER.49.12.008" x-align="JER.49.12.a008" x-target-ids="t009 t010" x-target="it pertained" x-target-head="t010" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncms