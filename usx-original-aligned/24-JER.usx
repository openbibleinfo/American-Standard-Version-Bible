	<para style="p"><verse number="7" style="v" x-ref="JER.30.7" sid="JER 30:7" /><char style="w" x-id="WLC.JER.30.7.001" x-align="JER.30.7.a001" x-target-ids="t001" x-target="Alas" x-target-head="t001" x-head="true" lemma="הוֹי" strong="H1945" x-morph="Tj" x-gloss="woe!" x-translit="hôy" xml:lang="hbo">ה֗וֹי</char> <char style="w" x-id="WLC.JER.30.7.002" x-align="JER.30.7.a002" x-target-ids="t002" x-target="for" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.JER.30.7.003" x-align="JER.30.7.a003" x-target-ids="t005 t006" x-target="is great" x-target-head="t006" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="[will.be].great" x-translit="ḡāḏôl" xml:lang="hbo">גָד֛וֹל</char> <char style="w" x-id="WLC.JER.30.7.004" x-align="JER.30.7.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JER.30.7.005" x-align="JER.30.7.a005" x-target-ids="t004" x-target="day" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּ֥וֹם</char> <char style="w" x-id="WLC.JER.30.7.006" x-align="JER.30.7.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.JER.30.7.007" x-align="JER.30.7.a007" x-target-ids="t003" x-target="that" x-target-head="t003" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="that" x-translit="hûʾ" xml:lang="hbo">ה֖וּא</char> <char style="w" x-id="WLC.JER.30.7.008" x-align="JER.30.7.a008" x-target-ids="t007 t008" x-target="so that" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.JER.30.7.009" x-align="JER.30.7.a009" x-target-i