	<para style="p"><verse number="2" style="v" x-ref="JER.12.2" sid="JER 12:2" /><char style="w" x-id="WLC.JER.12.2.001" x-align="JER.12.2.a001" x-target-ids="t001 t002 t003" x-target="Thou hast planted" x-target-head="t003" x-head="true" lemma="נָטַע" strong="H5193" x-morph="Vqp2ms" x-gloss="you" x-translit="nəṭaʿtā" xml:lang="hbo">נְטַעְתָּ</char><char style="w" x-id="WLC.JER.12.2.002" x-align="JER.12.2.a002" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="have.planted.them" x-translit="m" xml:lang="hbo">ם֙</char> <char style="w" x-id="WLC.JER.12.2.003" x-align="JER.12.2.a003" x-target-ids="t005" x-target="yea" x-target-head="t005" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.JER.12.2.004" x-align="JER.12.2.a004" x-target-ids="t006 t007 t008 t009" x-target="they have taken root" x-target-head="t009" x-head="true" lemma="שָׁרַשׁ" strong="H8327" x-morph="VMp3cp" x-gloss="they.have.taken.root" x-translit="šōrāšû" xml:lang="hbo">שֹׁרָ֔שׁוּ</char> <char style="w" x-id="WLC.JER.12.2.005" x-align="JER.12.2.a005" x-target-ids="t010 t011" x-target="they grow" x-target-head="t011" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi3mp" x-gloss="they.walk" x-translit="yēləḵû" xml:lang="hbo">יֵלְכ֖וּ</char> <char style="w" x-id="WLC.JER.12.2.006" x-align="JER.12.2.a006" x-target-ids="t012" x-target="yea" x-target-head="t012" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.JER.12.2.007" x-align="JER.12.2.a007" x-target-ids="t013 t014 t015" x-target="they bring forth" x-target-head="t014" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3cp" x-gloss="they.have.produced" x-translit="ʿāśû" xml:lang="hbo">עָ֣שׂוּ</char> <char style="w" x-id="WLC.JER.12.2.008" x-align="JER.12.2.a008" x-target-ids="t016" x-target="