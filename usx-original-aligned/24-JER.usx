	<para style="p"><verse number="13" style="v" x-ref="JER.8.13" sid="JER 8:13" /><char style="w" x-id="WLC.JER.8.13.001" x-align="JER.8.13.a001" x-target-ids="t003" x-target="utterly" x-target-head="t003" x-head="true" lemma="אָסַף" strong="H622" x-morph="Vqa" x-gloss="surely.(gather)" x-translit="ʾāsōp̄" xml:lang="hbo">אָסֹ֥ף</char> <char style="w" x-id="WLC.JER.8.13.002" x-align="JER.8.13.a002" x-target-ids="t001 t002 t004" x-target="I will consume" x-target-head="t004" x-head="true" lemma="אסף" strong="H5486" x-morph="Vhi1cs" x-gloss="I" x-translit="ʾăsiyp̄" xml:lang="hbo">אֲסִיפֵ֖</char><char style="w" x-id="WLC.JER.8.13.003" x-align="JER.8.13.a003" x-target-ids="t005" x-target="them" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="will.bring.them.to.an.end" x-translit="ēm" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.JER.8.13.004" x-align="JER.8.13.a004" x-target-ids="t006" x-target="saith" x-target-head="t006" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum-" xml:lang="hbo">נְאֻם</char>־<char style="w" x-id="WLC.JER.8.13.005" x-align="JER.8.13.a005" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhōwāh" xml:lang="hbo">יְהֹוָ֑ה</char> <char style="w" x-id="WLC.JER.8.13.006" x-align="JER.8.13.a006" x-target-ids="t008 t009 t010 t011" x-target="there shall be no" x-target-head="t011" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[will].not.[be]" x-translit="ʾên" xml:lang="hbo">אֵין֩</char> <char style="w" x-id="WLC.JER.8.13.007" x-align="JER.8.13.a007" x-target-ids="t012" x-target="grapes" x-target-head="t012" x-head="true" lemma="עֵנָב" strong="H6025" x-morph="Ncmpa" x-gloss="grapes" x-translit="ʿănāḇiym" xml:lang="hbo">עֲנָבִ֨ים</char> <char style="w" x-id="WLC.JER.8.13.008" x-align="JER.8.13.a008" x-target-ids="t013" x-target="on" x-target-he