	<para style="p"><verse number="6" style="v" x-ref="JER.15.6" sid="JER 15:6" /><char style="w" x-id="WLC.JER.15.6.001" x-align="JER.15.6.a001" x-target-ids="t001" x-target="Thou" x-target-head="t001" x-head="true" lemma="אַתְּ" strong="H859b" x-morph="Pp2fs" x-gloss="you" x-translit="ʾatə" xml:lang="hbo">אַ֣תְּ</char> <char style="w" x-id="WLC.JER.15.6.002" x-align="JER.15.6.a002" x-target-ids="t002 t003" x-target="hast rejected" x-target-head="t003" x-head="true" lemma="נָטַשׁ" strong="H5203" x-morph="Vqp2fs" x-gloss="you.abandoned" x-translit="nāṭaštə" xml:lang="hbo">נָטַ֥שְׁתְּ</char> <char style="w" x-id="WLC.JER.15.6.003" x-align="JER.15.6.a003" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾōṯ" xml:lang="hbo">אֹתִ֛</char><char style="w" x-id="WLC.JER.15.6.004" x-align="JER.15.6.a004" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.JER.15.6.005" x-align="JER.15.6.a005" x-target-ids="t005" x-target="saith" x-target-head="t005" x-head="true" lemma="נְאֻם" strong="H5002" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="nəʾum-" xml:lang="hbo">נְאֻם</char>־<char style="w" x-id="WLC.JER.15.6.006" x-align="JER.15.6.a006" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.JER.15.6.007" x-align="JER.15.6.a007" x-target-ids="t010" x-target="backward" x-target-head="t010" x-head="true" lemma="אָחוֹר" strong="H268" x-morph="Ncmsa" x-gloss="backwards" x-translit="ʾāḥôr" xml:lang="hbo">אָח֣וֹר</char> <char style="w" x-id="WLC.JER.15.6.008" x-align="JER.15.6.a008" x-target-ids="t007 t008 t009" x-target="thou art gone" x-target-head="t009" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi2fs" x-gloss="you.go" x-translit="tēlēḵî