	<para style="p"><verse number="13" style="v" x-ref="JER.34.13" sid="JER 34:13" /><char style="w" x-id="WLC.JER.34.13.001" x-align="JER.34.13.a001" x-target-ids="t001" x-target="Thus" x-target-head="t001" x-head="true" lemma="כֹּה" strong="H3541" x-morph="D" x-gloss="thus" x-translit="kōh-" xml:lang="hbo">כֹּֽה</char>־<char style="w" x-id="WLC.JER.34.13.002" x-align="JER.34.13.a002" x-target-ids="t002" x-target="saith" x-target-head="t002" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֥ר</char> <char style="w" x-id="WLC.JER.34.13.003" x-align="JER.34.13.a003" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.JER.34.13.004" x-align="JER.34.13.a004" x-target-ids="t004 t005" x-target="the God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="the.God" x-translit="ʾĕlōhēy" xml:lang="hbo">אֱלֹהֵ֣י</char> <char style="w" x-id="WLC.JER.34.13.005" x-align="JER.34.13.a005" x-target-ids="t006 t007" x-target="of Israel" x-target-head="t007" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֑ל</char> <char style="w" x-id="WLC.JER.34.13.006" x-align="JER.34.13.a006" x-target-ids="t008" x-target="I" x-target-head="t008" x-head="true" lemma="אָנֹכִי" strong="H595" x-morph="Pp1cs" x-gloss="I" x-translit="ʾānōḵiy" xml:lang="hbo">אָנֹכִ֗י</char> <char style="w" x-id="WLC.JER.34.13.007" x-align="JER.34.13.a007" x-target-ids="t009" x-target="made" x-target-head="t009" x-head="true" lemma="כָּרַת" strong="H3772" x-morph="Vqp1cs" x-gloss="I.made" x-translit="kāratiy" xml:lang="hbo">כָּרַ֤תִּֽי</char> <char style="w" x-id="WLC.JER.34.13.008" x-align="JER.34.13.a008" x-target-ids="t010 t011" x-target="a covenant" x-target-head="t011" x-head="true" lem