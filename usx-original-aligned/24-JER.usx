	<para style="p"><verse number="11" style="v" x-ref="JER.49.11" x-added-alignments="JER.49.11.a007" x-added-target-ids="t008" x-added-target="them" sid="JER 49:11" /><char style="w" x-id="WLC.JER.49.11.001" x-align="JER.49.11.a001" x-target-ids="t001" x-target="Leave" x-target-head="t001" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqv2ms" x-gloss="leave" x-translit="ʿāzəḇ" xml:lang="hbo">עָזְבָ֥</char><char style="w" x-id="WLC.JER.49.11.002" x-align="JER.49.11.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.JER.49.11.003" x-align="JER.49.11.a003" x-target-ids="t003 t004" x-target="fatherless children" x-target-head="t003" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmpc" x-gloss="fatherless" x-translit="yəṯōmey" xml:lang="hbo">יְתֹמֶ֖י</char><char style="w" x-id="WLC.JER.49.11.004" x-align="JER.49.11.a004" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.JER.49.11.005" x-align="JER.49.11.a005" x-target-ids="t005" x-target="I" x-target-head="t005" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֣י</char> <char style="w" x-id="WLC.JER.49.11.006" x-align="JER.49.11.a006" x-target-ids="t006 t007 t009" x-target="will preserve alive" x-target-head="t009" x-head="true" lemma="חָיָה" strong="H2421" x-morph="Vpi1cs" x-gloss="I.will.preserve.[them].alive" x-translit="ʾăḥayyeh" xml:lang="hbo">אֲחַיֶּ֑ה</char> <char style="w" x-id="WLC.JER.49.11.007" x-align="JER.49.11.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.JER.49.11.008" x-align="JER.49.11.a009" x-target-ids="t013" x-target="widows" x-target-head="t01