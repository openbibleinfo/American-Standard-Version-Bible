	<para style="p"><verse number="40" style="v" x-ref="LUK.22.40" sid="LUK 22:40" /><char style="w" x-id="SBLGNT.LUK.22.40.001" x-align="LUK.22.40.a001" x-target-ids="t002 t003 t004" x-target="when he was" x-target-head="t004" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2ADP-NSM" x-gloss="Having come" x-translit="genomenos" xml:lang="grc">γενόμενος</char> <char style="w" x-id="SBLGNT.LUK.22.40.002" x-align="LUK.22.40.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.40.003" x-align="LUK.22.40.a003" x-target-ids="t005" x-target="at" x-target-head="t005" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="to" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.LUK.22.40.004" x-align="LUK.22.40.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="the" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.22.40.005" x-align="LUK.22.40.a005" x-target-ids="t007" x-target="place" x-target-head="t007" x-head="true" lemma="τόπος" strong="G5117" x-morph="N-GSM" x-gloss="place" x-translit="topou" xml:lang="grc">τόπου</char> <char style="w" x-id="SBLGNT.LUK.22.40.006" x-align="LUK.22.40.a006" x-target-ids="t008 t009" x-target="he said" x-target-head="t009" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.22.40.007" x-align="LUK.22.40.a007" x-target-ids="t010 t011" x-target="unto them" x-target-head="t011" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.LUK.22.40.008" x-align="LUK.22.40.a008" x-target-ids="t012" x-target="Pray" x-target-head="t012" x-head="true" lemma="προσεύχομαι" strong="G4336" x-morph="V-PNM-2P" x-gloss="Pray" x-translit="Proseuchesthe" xml:lang="grc">Προσεύχεσθε</char> <char style="w" x-id="SBLGNT.LUK.22.40.009" x-align="LUK.22.40.a009" x-target-ids="t016" x-target="not" x-target-head="t016" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.22.40.010" x-align="LUK.22.40.a010" x-target-ids="t013 t014 t015" x-target="that ye enter" x-target-head="t015" x-head="true" lemma="εἰσέρχομαι" strong="G1525" x-morph="V-2AAN" x-gloss="to enter" x-translit="eiselthein" xml:lang="grc">εἰσελθεῖν</char> <char style="w" x-id="SBLGNT.LUK.22.40.011" x-align="LUK.22.40.a011" x-target-ids="t017" x-target="into" x-target-head="t017" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="into" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.22.40.012" x-align="LUK.22.40.a012" x-target-ids="t018" x-target="temptation" x-target-head="t018" x-head="true" lemma="πειρασμός" strong="G3986" x-morph="N-ASM" x-gloss="temptation" x-translit="peirasmon" xml:lang="grc">πειρασμόν</char>.<verse eid="LUK 22:40" /></para>
	<para style="p"><verse number="41" style="v" x-ref="LUK.22.41" sid="LUK 22:41" /><char style="w" x-id="SBLGNT.LUK.22.41.001" x-align="LUK.22.41.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.41.002" x-align="LUK.22.41.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NSM" x-gloss="He" x-translit="autos" xml:lang="grc">αὐτὸς</char> <char style="w" x-id="SBLGNT.LUK.22.41.003" x-align="LUK.22.41.a003" x-target-ids="t003 t004" x-target="was parted" x-target-head="t004" x-head="true" lemma="ἀποσπάω" strong="G645" x-morph="V-API-3S" x-gloss="withdrew" x-translit="apespasthē" xml:lang="grc">ἀπεσπάσθη</char> <char style="w" x-id="SBLGNT.LUK.22.41.004" x-align="LUK.22.41.a004" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="ap" xml:lang="grc">ἀπ</char>ʼ<char style="w" x-id="SBLGNT.LUK.22.41.005" x-align="LUK.22.41.a005" x-target-ids="t006" x-target="them" x-target-head="t006" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="them" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.LUK.22.41.006" x-align="LUK.22.41.a006" x-target-ids="t007" x-target="about" x-target-head="t007" x-head="true" lemma="ὡσεί" strong="G5616" x-morph="ADV" x-gloss="about" x-translit="hōsei" xml:lang="grc">ὡσεὶ</char> <char style="w" x-id="SBLGNT.LUK.22.41.007" x-align="LUK.22.41.a007" x-target-ids="t008 t009" x-target="a stone’s" x-target-head="t009" x-head="true" lemma="λίθος" strong="G3037" x-morph="N-GSM" x-gloss="a stone’s" x-translit="lithou" xml:lang="grc">λίθου</char> <char style="w" x-id="SBLGNT.LUK.22.41.008" x-align="LUK.22.41.a008" x-target-ids="t010" x-target="cast" x-target-head="t010" x-head="true" lemma="βολή" strong="G1000" x-mo