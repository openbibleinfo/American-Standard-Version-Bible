	<para style="p"><verse number="4" style="v" x-ref="LUK.14.4" sid="LUK 14:4" /><char style="w" x-id="SBLGNT.LUK.14.4.001" x-align="LUK.14.4.a001" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.14.4.002" x-align="LUK.14.4.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="But" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.14.4.003" x-align="LUK.14.4.a003" x-target-ids="t003 t004 t005" x-target="held their peace" x-target-head="t005" x-head="true" lemma="ἡσυχάζω" strong="G2270" x-morph="V-AAI-3P" x-gloss="they were silent" x-translit="hēsychasan" xml:lang="grc">ἡσύχασαν</char>.<char style="w" x-id="SBLGNT.LUK.14.4.004" x-align="LUK.14.4.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.14.4.005" x-align="LUK.14.4.a005" x-target-ids="t007 t008 t009" x-target="he took him" x-target-head="t008" x-head="true" lemma="ἐπιλαμβάνομαι" strong="G1949" x-morph="V-2ADP-NSM" x-gloss="having taken hold [of him]" x-translit="epilabomenos" xml:lang="grc">ἐπιλαβόμενος</char> <char style="w" x-id="SBLGNT.LUK.14.4.006" x-align="LUK.14.4.a006" x-target-ids="t010 t011" x-target="and healed" x-target-head="t011" x-head="true" lemma="ἰάομαι" strong="G2390" x-morph="V-ADI-3S" x-gloss="He healed" x-translit="iasato" xml:lang="grc">ἰάσατο</char> <char style="w" x-id="SBLGNT.LUK.14.4.007" x-align="LUK.14.4.a007" x-target-ids="t012" x-target="him" x-target-head="t012" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="him" x-translit="auton" xml:lang="grc">αὐτὸν</char> <char style="w" x-id="SBLGNT.LUK.14.4.008" x-align="LUK.14.4.a008" x-target-ids="t013" x-target="and" x-tar