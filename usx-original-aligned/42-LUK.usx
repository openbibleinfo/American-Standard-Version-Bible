	<para style="p"><verse number="24" style="v" x-ref="LUK.7.24" sid="LUK 7:24" /><char style="w" x-id="SBLGNT.LUK.7.24.001" x-align="LUK.7.24.a001" x-target-ids="t002 t007 t008" x-target="when were departed" x-target-head="t008" x-head="true" lemma="ἀπέρχομαι" strong="G565" x-morph="V-2AAP-GPM" x-gloss="Having departed" x-translit="Apelthontōn" xml:lang="grc">Ἀπελθόντων</char> <char style="w" x-id="SBLGNT.LUK.7.24.002" x-align="LUK.7.24.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.7.24.003" x-align="LUK.7.24.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.LUK.7.24.004" x-align="LUK.7.24.a004" x-target-ids="t004" x-target="messengers" x-target-head="t004" x-head="true" lemma="ἄγγελος" strong="G32" x-morph="N-GPM" x-gloss="messengers" x-translit="angelōn" xml:lang="grc">ἀγγέλων</char> <char style="w" x-id="SBLGNT.LUK.7.24.005" x-align="LUK.7.24.a005" x-target-ids="t005 t006" x-target="of John" x-target-head="t006" x-head="true" lemma="Ἰωάννης" strong="G2491" x-morph="N-GSM" x-gloss="of John" x-translit="Iōannou" xml:lang="grc">Ἰωάννου</char> <char style="w" x-id="SBLGNT.LUK.7.24.006" x-align="LUK.7.24.a006" x-target-ids="t009 t010" x-target="he began" x-target-head="t010" x-head="true" lemma="ἄρχω" strong="G756" x-morph="V-ADI-3S" x-gloss="He began" x-translit="ērxato" xml:lang="grc">ἤρξατο</char> <char style="w" x-id="SBLGNT.LUK.7.24.007" x-align="LUK.7.24.a007" x-target-ids="t011 t012" x-target="to say" x-target-head="t012" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAN" x-gloss="to speak" x-translit="legein" xml:lang="grc">λέγειν</char> <char style="w" x-id="SBLGNT.LUK.7.24.008" x-align="LUK.7.24.a008" x-target-ids="t013" x-target="unto" x-target