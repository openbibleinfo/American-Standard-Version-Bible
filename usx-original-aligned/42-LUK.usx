	<para style="p"><verse number="38" style="v" x-ref="LUK.18.38" sid="LUK 18:38" /><char style="w" x-id="SBLGNT.LUK.18.38.001" x-align="LUK.18.38.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.18.38.002" x-align="LUK.18.38.a002" x-target-ids="t002 t003" x-target="he cried" x-target-head="t003" x-head="true" lemma="βοάω" strong="G994" x-morph="V-AAI-3S" x-gloss="he called out" x-translit="eboēsen" xml:lang="grc">ἐβόησεν</char> <char style="w" x-id="SBLGNT.LUK.18.38.003" x-align="LUK.18.38.a003" x-target-ids="t004" x-target="saying" x-target-head="t004" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.LUK.18.38.004" x-align="LUK.18.38.a004" x-target-ids="t005" x-target="Jesus" x-target-head="t005" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-VSM" x-gloss="Jesus" x-translit="Iēsou" xml:lang="grc">Ἰησοῦ</char> <char style="w" x-id="SBLGNT.LUK.18.38.005" x-align="LUK.18.38.a005" x-target-ids="t006 t007" x-target="thou son" x-target-head="t007" x-head="true" lemma="υἱός" strong="G5207" x-morph="N-VSM" x-gloss="Son" x-translit="huie" xml:lang="grc">υἱὲ</char> <char style="w" x-id="SBLGNT.LUK.18.38.006" x-align="LUK.18.38.a006" x-target-ids="t008 t009" x-target="of David" x-target-head="t009" x-head="true" lemma="Δαυίδ" strong="G1138" x-morph="N-PRI" x-gloss="of David" x-translit="Dauid" xml:lang="grc">Δαυίδ</char>,<char style="w" x-id="SBLGNT.LUK.18.38.007" x-align="LUK.18.38.a007" x-target-ids="t010 t011" x-target="have mercy" x-target-head="t011" x-head="true" lemma="ἐλεάω" strong="G1653" x-morph="V-AAM-2S" x-gloss="have mercy on" x-translit="eleēson" xml:lang="grc">ἐλέησόν</char> <char style="w" x-id="SBLGNT.LUK.18.38.008" x-align="LUK.18.38.a008" x-target-ids="t012 t013" x-target="on me" x-target-h