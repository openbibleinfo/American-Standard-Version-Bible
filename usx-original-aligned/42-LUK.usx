	<para style="p"><verse number="4" style="v" x-ref="LUK.1.4" sid="LUK 1:4" /><char style="w" x-id="SBLGNT.LUK.1.4.001" x-align="LUK.1.4.a001" x-target-ids="t001" x-target="that" x-target-head="t001" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.LUK.1.4.002" x-align="LUK.1.4.a002" x-target-ids="t002 t003 t004" x-target="thou mightest know" x-target-head="t004" x-head="true" lemma="ἐπιγινώσκω" strong="G1921" x-morph="V-2AAS-2S" x-gloss="you may know" x-translit="epignōis" xml:lang="grc">ἐπιγνῷς</char> <char style="w" x-id="SBLGNT.LUK.1.4.003" x-align="LUK.1.4.a003" x-target-ids="t007" x-target="concerning" x-target-head="t007" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="concerning" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.LUK.1.4.004" x-align="LUK.1.4.a004" x-target-ids="t010" x-target="wherein" x-target-head="t010" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-GPM" x-gloss="which" x-translit="hōn" xml:lang="grc">ὧν</char> <char style="w" x-id="SBLGNT.LUK.1.4.005" x-align="LUK.1.4.a005" x-target-ids="t011 t012 t013" x-target="thou wast instructed" x-target-head="t013" x-head="true" lemma="κατηχέω" strong="G2727" x-morph="V-API-2S" x-gloss="you were instructed" x-translit="katēchēthēs" xml:lang="grc">κατηχήθης</char> <char style="w" x-id="SBLGNT.LUK.1.4.006" x-align="LUK.1.4.a006" x-target-ids="t008 t009" x-target="the things" x-target-head="t009" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-GPM" x-gloss="[of the] things" x-translit="logōn" xml:lang="grc">λόγων</char> <char style="w" x-id="SBLGNT.LUK.1.4.007" x-align="LUK.1.4.a007" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="the" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.LUK.1.4.008" x-align="LUK.1.4.a008" x-target-ids="t006" x-target="certainty" x