	<para style="p"><verse number="28" style="v" x-ref="LUK.19.28" sid="LUK 19:28" /><char style="w" x-id="SBLGNT.LUK.19.28.001" x-align="LUK.19.28.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.28.002" x-align="LUK.19.28.a002" x-target-ids="t002 t003 t004 t006" x-target="when he had spoken" x-target-head="t006" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAP-NSM" x-gloss="having said" x-translit="eipōn" xml:lang="grc">εἰπὼν</char> <char style="w" x-id="SBLGNT.LUK.19.28.003" x-align="LUK.19.28.a003" x-target-ids="t005" x-target="thus" x-target-head="t005" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="these things" x-translit="tauta" xml:lang="grc">ταῦτα</char> <char style="w" x-id="SBLGNT.LUK.19.28.004" x-align="LUK.19.28.a004" x-target-ids="t007 t008 t009" x-target="he went on" x-target-head="t008" x-head="true" lemma="πορεύομαι" strong="G4198" x-morph="V-INI-3S" x-gloss="He went on" x-translit="eporeueto" xml:lang="grc">ἐπορεύετο</char> <char style="w" x-id="SBLGNT.LUK.19.28.005" x-align="LUK.19.28.a005" x-target-ids="t010" x-target="before" x-target-head="t010" x-head="true" lemma="ἔμπροσθεν" strong="G1715" x-morph="ADV" x-gloss="ahead" x-translit="emprosthen" xml:lang="grc">ἔμπροσθεν</char> <char style="w" x-id="SBLGNT.LUK.19.28.006" x-align="LUK.19.28.a006" x-target-ids="t011 t012" x-target="going up" x-target-head="t011" x-head="true" lemma="ἀναβαίνω" strong="G305" x-morph="V-PAP-NSM" x-gloss="going up" x-translit="anabainōn" xml:lang="grc">ἀναβαίνων</char> <char style="w" x-id="SBLGNT.LUK.19.28.007" x-align="LUK.19.28.a007" x-target-ids="t013" x-target="to" x-target-head="t013" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.19.28.008" x-align="LUK.19.28.a008" x-target-ids="