	<para style="p"><verse number="3" style="v" x-ref="LUK.10.3" sid="LUK 10:3" /><char style="w" x-id="SBLGNT.LUK.10.3.001" x-align="LUK.10.3.a001" x-target-ids="t001 t002 t003" x-target="Go your ways" x-target-head="t001" x-head="true" lemma="ὑπάγω" strong="G5217" x-morph="V-PAM-2P" x-gloss="Go" x-translit="hypagete" xml:lang="grc">ὑπάγετε</char>·<char style="w" x-id="SBLGNT.LUK.10.3.002" x-align="LUK.10.3.a002" x-target-ids="t004" x-target="behold" x-target-head="t004" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.LUK.10.3.003" x-align="LUK.10.3.a003" x-target-ids="t005 t006 t008" x-target="I send forth" x-target-head="t006" x-head="true" lemma="ἀποστέλλω" strong="G649" x-morph="V-PAI-1S" x-gloss="I send forth" x-translit="apostellō" xml:lang="grc">ἀποστέλλω</char> <char style="w" x-id="SBLGNT.LUK.10.3.004" x-align="LUK.10.3.a004" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.LUK.10.3.005" x-align="LUK.10.3.a005" x-target-ids="t009" x-target="as" x-target-head="t009" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.LUK.10.3.006" x-align="LUK.10.3.a006" x-target-ids="t010" x-target="lambs" x-target-head="t010" x-head="true" lemma="ἀρήν" strong="G704" x-morph="N-APM" x-gloss="lambs" x-translit="arnas" xml:lang="grc">ἄρνας</char> <char style="w" x-id="SBLGNT.LUK.10.3.007" x-align="LUK.10.3.a007" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.10.3.008" x-align="LUK.10.3.a008" x-target-ids="t012 t013" x-target="the midst" x-target-head="t013" x-head="true" lemma="μέσος" strong="G