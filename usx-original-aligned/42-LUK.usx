	<para style="p"><verse number="31" style="v" x-ref="LUK.6.31" sid="LUK 6:31" /><char style="w" x-id="SBLGNT.LUK.6.31.001" x-align="LUK.6.31.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.6.31.002" x-align="LUK.6.31.a002" x-target-ids="t002" x-target="as" x-target-head="t002" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="as" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.LUK.6.31.003" x-align="LUK.6.31.a003" x-target-ids="t003 t004" x-target="ye would" x-target-head="t004" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-PAI-2P" x-gloss="you desire" x-translit="thelete" xml:lang="grc">θέλετε</char> <char style="w" x-id="SBLGNT.LUK.6.31.004" x-align="LUK.6.31.a004" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.LUK.6.31.005" x-align="LUK.6.31.a005" x-target-ids="t007 t008" x-target="should do" x-target-head="t008" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-PAS-3P" x-gloss="should do" x-translit="poiōsin" xml:lang="grc">ποιῶσιν</char> <char style="w" x-id="SBLGNT.LUK.6.31.006" x-align="LUK.6.31.a006" x-target-ids="t009 t010" x-target="to you" x-target-head="t010" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.LUK.6.31.007" x-align="LUK.6.31.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.6.31.008" x-align="LUK.6.31.a008" x-target-ids="t006" x-target="men" x-target-head="t006" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-NPM" x-gloss="men" x-translit="anthrōpoi" x