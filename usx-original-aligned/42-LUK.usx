	<para style="p"><verse number="42" style="v" x-ref="LUK.23.42" sid="LUK 23:42" /><char style="w" x-id="SBLGNT.LUK.23.42.001" x-align="LUK.23.42.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.23.42.002" x-align="LUK.23.42.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-IAI-3S" x-gloss="he was saying" x-translit="elegen" xml:lang="grc">ἔλεγεν</char>·<char style="w" x-id="SBLGNT.LUK.23.42.003" x-align="LUK.23.42.a003" x-target-ids="t004" x-target="Jesus" x-target-head="t004" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-VSM" x-gloss="Jesus" x-translit="Iēsou" xml:lang="grc">Ἰησοῦ</char>,<char style="w" x-id="SBLGNT.LUK.23.42.004" x-align="LUK.23.42.a004" x-target-ids="t005" x-target="remember" x-target-head="t005" x-head="true" lemma="μιμνῄσκομαι" strong="G3415" x-morph="V-APM-2S" x-gloss="remember" x-translit="mnēsthēti" xml:lang="grc">μνήσθητί</char> <char style="w" x-id="SBLGNT.LUK.23.42.005" x-align="LUK.23.42.a005" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="me" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.LUK.23.42.006" x-align="LUK.23.42.a006" x-target-ids="t007" x-target="when" x-target-head="t007" x-head="true" lemma="ὅταν" strong="G3752" x-morph="CONJ" x-gloss="when" x-translit="hotan" xml:lang="grc">ὅταν</char> <char style="w" x-id="SBLGNT.LUK.23.42.007" x-align="LUK.23.42.a007" x-target-ids="t008 t009" x-target="thou comest" x-target-head="t009" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAS-2S" x-gloss="You come" x-translit="elthēis" xml:lang="grc">ἔλθῃς</char> <char style="w" x-id="SBLGNT.LUK.23.42.008" x-align="LUK.23.42.a008" x-target-ids="t010" x-target="in" x-target-head="t010" x-head="true" l