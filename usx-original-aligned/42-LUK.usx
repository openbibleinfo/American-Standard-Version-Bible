	<para style="p"><verse number="8" style="v" x-ref="LUK.4.8" sid="LUK 4:8" /><char style="w" x-id="SBLGNT.LUK.4.8.001" x-align="LUK.4.8.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.4.8.002" x-align="LUK.4.8.a004" x-target-ids="t003" x-target="answered" x-target-head="t003" x-head="true" lemma="ἀποκρίνομαι" strong="G611" x-morph="V-AOP-NSM" x-gloss="answering" x-translit="apokritheis" xml:lang="grc">ἀποκριθεὶς</char> <char style="w" x-id="SBLGNT.LUK.4.8.003" x-align="LUK.4.8.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.4.8.004" x-align="LUK.4.8.a002" x-target-ids="t002" x-target="Jesus" x-target-head="t002" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.LUK.4.8.005" x-align="LUK.4.8.a005" x-target-ids="t004 t005" x-target="and said" x-target-head="t005" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.4.8.006" x-align="LUK.4.8.a006" x-target-ids="t006 t007" x-target="unto him" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.4.8.007" x-align="LUK.4.8.a007" x-target-ids="t008 t009 t010" x-target="It is written" x-target-head="t010" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-RPI-3S" x-gloss="It has been written" x-translit="Gegraptai" xml:lang="grc">Γέγραπται</char>·<char style="w" x-id="SBLGNT.LUK.4.8.008" x-align="LUK.4.8.a009" x-target-ids="t014 t015" x-target="the Lord" x-target-head="t015" x-head="true" lemma="κύριος" strong="G2962" x-