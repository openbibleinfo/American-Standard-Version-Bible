	<para style="p"><verse number="54" style="v" x-ref="LUK.1.54" sid="LUK 1:54" /><char style="w" x-id="SBLGNT.LUK.1.54.001" x-align="LUK.1.54.a001" x-target-ids="t001 t002 t003 t004" x-target="He hath given help" x-target-head="t004" x-head="true" lemma="ἀντιλαμβάνομαι" strong="G482" x-morph="V-2ADI-3S" x-gloss="He has helped" x-translit="antelabeto" xml:lang="grc">ἀντελάβετο</char> <char style="w" x-id="SBLGNT.LUK.1.54.002" x-align="LUK.1.54.a002" x-target-ids="t005 t006" x-target="to Israel" x-target-head="t006" x-head="true" lemma="Ἰσραήλ" strong="G2474" x-morph="N-PRI" x-gloss="Israel" x-translit="Israēl" xml:lang="grc">Ἰσραὴλ</char> <char style="w" x-id="SBLGNT.LUK.1.54.003" x-align="LUK.1.54.a003" x-target-ids="t008" x-target="servant" x-target-head="t008" x-head="true" lemma="παῖς" strong="G3816" x-morph="N-GSM" x-gloss="[the] servant" x-translit="paidos" xml:lang="grc">παιδὸς</char> <char style="w" x-id="SBLGNT.LUK.1.54.004" x-align="LUK.1.54.a004" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char>,<char style="w" x-id="SBLGNT.LUK.1.54.005" x-align="LUK.1.54.a005" x-target-ids="t009 t010 t011 t012" x-target="That he might remember" x-target-head="t012" x-head="true" lemma="μιμνῄσκομαι" strong="G3415" x-morph="V-APN" x-gloss="remembering" x-translit="mnēsthēnai" xml:lang="grc">μνησθῆναι</char> <char style="w" x-id="SBLGNT.LUK.1.54.006" x-align="LUK.1.54.a006" x-target-ids="t013" x-target="mercy" x-target-head="t013" x-head="true" lemma="ἔλεος" strong="G1656" x-morph="N-GSN" x-gloss="mercy" x-translit="eleous" xml:lang="grc">ἐλέους</char>,<verse eid="LUK 1:54" /></para>
