	<para style="p"><verse number="17" style="v" x-ref="LUK.21.17" sid="LUK 21:17" /><char style="w" x-id="SBLGNT.LUK.21.17.001" x-align="LUK.21.17.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.21.17.002" x-align="LUK.21.17.a002" x-target-ids="t002 t003 t004" x-target="ye shall be" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2071" x-morph="V-FDI-2P" x-gloss="you will be" x-translit="esesthe" xml:lang="grc">ἔσεσθε</char> <char style="w" x-id="SBLGNT.LUK.21.17.003" x-align="LUK.21.17.a003" x-target-ids="t005" x-target="hated" x-target-head="t005" x-head="true" lemma="μισέω" strong="G3404" x-morph="V-PPP-NPM" x-gloss="hated" x-translit="misoumenoi" xml:lang="grc">μισούμενοι</char> <char style="w" x-id="SBLGNT.LUK.21.17.004" x-align="LUK.21.17.a004" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="ὑπό" strong="G5259" x-morph="PREP" x-gloss="by" x-translit="hypo" xml:lang="grc">ὑπὸ</char> <char style="w" x-id="SBLGNT.LUK.21.17.005" x-align="LUK.21.17.a005" x-target-ids="t007 t008" x-target="all men" x-target-head="t007" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-GPM" x-gloss="all" x-translit="pantōn" xml:lang="grc">πάντων</char> <char style="w" x-id="SBLGNT.LUK.21.17.006" x-align="LUK.21.17.a006" x-target-ids="t009 t012" x-target="for sake" x-target-head="t009" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="because of" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.LUK.21.17.007" x-align="LUK.21.17.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.21.17.008" x-align="LUK.21.17.a009" x-target-ids="t011" x-target="name’s" x-target-head="t011" x-head="true" lemma="ὄνομα" strong="G3686" x-morph="N-ASN" x-gl