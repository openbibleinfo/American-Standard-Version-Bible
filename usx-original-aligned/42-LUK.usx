	<para style="p"><verse number="47" style="v" x-ref="LUK.22.47" sid="LUK 22:47" /><char style="w" x-id="SBLGNT.LUK.22.47.001" x-align="LUK.22.47.a001" x-target-ids="t003" x-target="yet" x-target-head="t003" x-head="true" lemma="ἔτι" strong="G2089" x-morph="ADV" x-gloss="While still" x-translit="Eti" xml:lang="grc">Ἔτι</char> <char style="w" x-id="SBLGNT.LUK.22.47.002" x-align="LUK.22.47.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.LUK.22.47.003" x-align="LUK.22.47.a003" x-target-ids="t001 t004" x-target="While spake" x-target-head="t004" x-head="true" lemma="λαλέω" strong="G2980" x-morph="V-PAP-GSM" x-gloss="speaking" x-translit="lalountos" xml:lang="grc">λαλοῦντος</char> <char style="w" x-id="SBLGNT.LUK.22.47.004" x-align="LUK.22.47.a004" x-target-ids="t005" x-target="behold" x-target-head="t005" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.LUK.22.47.005" x-align="LUK.22.47.a005" x-target-ids="t006 t007" x-target="a multitude" x-target-head="t007" x-head="true" lemma="ὄχλος" strong="G3793" x-morph="N-NSM" x-gloss="a crowd" x-translit="ochlos" xml:lang="grc">ὄχλος</char>,<char style="w" x-id="SBLGNT.LUK.22.47.006" x-align="LUK.22.47.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.47.007" x-align="LUK.22.47.a007" x-target-ids="t009" x-target="he" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="he who" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.22.47.008" x-align="LUK.22.47.a008" x-target-ids="t010 t011 t012" x-target="that was called" x-target-head="t012" x-head="true" le