	<para style="p"><verse number="2" style="v" x-ref="LUK.13.2" sid="LUK 13:2" /><char style="w" x-id="SBLGNT.LUK.13.2.001" x-align="LUK.13.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.13.2.002" x-align="LUK.13.2.a002" x-target-ids="t002 t003" x-target="he answered" x-target-head="t003" x-head="true" lemma="ἀποκρίνομαι" strong="G611" x-morph="V-AOP-NSM" x-gloss="answering" x-translit="apokritheis" xml:lang="grc">ἀποκριθεὶς</char> <char style="w" x-id="SBLGNT.LUK.13.2.003" x-align="LUK.13.2.a003" x-target-ids="t004 t005" x-target="and said" x-target-head="t005" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.13.2.004" x-align="LUK.13.2.a004" x-target-ids="t006 t007" x-target="unto them" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.LUK.13.2.005" x-align="LUK.13.2.a005" x-target-ids="t008 t009" x-target="Think ye" x-target-head="t008" x-head="true" lemma="δοκέω" strong="G1380" x-morph="V-PAI-2P" x-gloss="Think you" x-translit="Dokeite" xml:lang="grc">Δοκεῖτε</char> <char style="w" x-id="SBLGNT.LUK.13.2.006" x-align="LUK.13.2.a006" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.LUK.13.2.007" x-align="LUK.13.2.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.13.2.008" x-align="LUK.13.2.a009" x-target-ids="t012" x-target="Galilaeans" x-target-head="t012" x-head="true" lemma="Γαλιλαῖος" strong="G1057" x