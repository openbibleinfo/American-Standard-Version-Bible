	<para style="p"><verse number="7" style="v" x-ref="LUK.22.7" sid="LUK 22:7" /><char style="w" x-id="SBLGNT.LUK.22.7.001" x-align="LUK.22.7.a001" x-target-ids="t007" x-target="came" x-target-head="t007" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAI-3S" x-gloss="Came" x-translit="Ēlthen" xml:lang="grc">Ἦλθεν</char> <char style="w" x-id="SBLGNT.LUK.22.7.002" x-align="LUK.22.7.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.7.003" x-align="LUK.22.7.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.LUK.22.7.004" x-align="LUK.22.7.a004" x-target-ids="t003" x-target="day" x-target-head="t003" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-NSF" x-gloss="day" x-translit="hēmera" xml:lang="grc">ἡμέρα</char> <char style="w" x-id="SBLGNT.LUK.22.7.005" x-align="LUK.22.7.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPN" x-gloss="of" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.LUK.22.7.006" x-align="LUK.22.7.a006" x-target-ids="t004 t005 t006" x-target="of unleavened bread" x-target-head="t005" x-head="true" lemma="ἄζυμος" strong="G106" x-morph="A-GPN" x-gloss="Unleavened [Bread]" x-translit="azymōn" xml:lang="grc">ἀζύμων</char>,<char style="w" x-id="SBLGNT.LUK.22.7.007" x-align="LUK.22.7.a007" x-target-ids="t008 t009" x-target="on which" x-target-head="t009" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-DSF" x-gloss="which" x-translit="hēi" xml:lang="grc">ᾗ</char> <char style="w" x-id="SBLGNT.LUK.22.7.008" x-align="LUK.22.7.a008" x-target-ids="t012" x-target="must" x-target-head="t012" x-head="true" lemma="δεῖ" strong="G1163" x-morph="V-IAI-3S" x-gloss="it was necessary for" x-transli