	<para style="p"><verse number="1" style="v" x-ref="LUK.1.1" sid="LUK 1:1" /><char style="w" x-id="SBLGNT.LUK.1.1.001" x-align="LUK.1.1.a001" x-target-ids="t001 t002" x-target="Forasmuch as" x-target-head="t001" x-head="true" lemma="ἐπειδήπερ" strong="G1895" x-morph="CONJ" x-gloss="Inasmuch as" x-translit="Epeidēper" xml:lang="grc">Ἐπειδήπερ</char> <char style="w" x-id="SBLGNT.LUK.1.1.002" x-align="LUK.1.1.a002" x-target-ids="t003" x-target="many" x-target-head="t003" x-head="true" lemma="πολύς" strong="G4183" x-morph="A-NPM" x-gloss="many" x-translit="polloi" xml:lang="grc">πολλοὶ</char> <char style="w" x-id="SBLGNT.LUK.1.1.003" x-align="LUK.1.1.a003" x-target-ids="t004 t005 t006 t007" x-target="have taken in hand" x-target-head="t005" x-head="true" lemma="ἐπιχειρέω" strong="G2021" x-morph="V-AAI-3P" x-gloss="have undertaken" x-translit="epecheirēsan" xml:lang="grc">ἐπεχείρησαν</char> <char style="w" x-id="SBLGNT.LUK.1.1.004" x-align="LUK.1.1.a004" x-target-ids="t008 t009 t010" x-target="to draw up" x-target-head="t009" x-head="true" lemma="ἀνατάσσομαι" strong="G392" x-morph="V-ADN" x-gloss="to draw up" x-translit="anataxasthai" xml:lang="grc">ἀνατάξασθαι</char> <char style="w" x-id="SBLGNT.LUK.1.1.005" x-align="LUK.1.1.a005" x-target-ids="t011 t012" x-target="a narrative" x-target-head="t012" x-head="true" lemma="διήγησις" strong="G1335" x-morph="N-ASF" x-gloss="a narration" x-translit="diēgēsin" xml:lang="grc">διήγησιν</char> <char style="w" x-id="SBLGNT.LUK.1.1.006" x-align="LUK.1.1.a006" x-target-ids="t013" x-target="concerning" x-target-head="t013" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="concerning" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.LUK.1.1.007" x-align="LUK.1.1.a007" x-target-ids="t014" x-target="those" x-target-head="t014" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPN" x-gloss="the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.LUK.1.1.008" x-align="LUK.1.1.a008" x-target-ids="t016 t017 t018 t019" x-target="which have been fulfilled" x-target-head="t019" x-head="true" lemma="πληροφορέω" strong="G4135" x-morph="V-RPP-GPN" x-gloss="having been accomplished" x-translit="peplērophorēmenōn" xml:lang="grc">πεπληροφορημένων</char> <char style="w" x-id="SBLGNT.LUK.1.1.009" x-align="LUK.1.1.a009" x-target-ids="t020" x-target="among" x-target-head="t020" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="among" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.1.1.010" x-align="LUK.1.1.a010" x-target-ids="t021" x-target="us" x-target-head="t021" x-head="true" lemma="ἐγώ" strong="G2254" x-morph="P-1DP" x-gloss="us" x-translit="hēmin" xml:lang="grc">ἡμῖν</char> <char style="w" x-id="SBLGNT.LUK.1.1.011" x-align="LUK.1.1.a011" x-target-ids="t015" x-target="matters" x-target-head="t015" x-head="true" lemma="πρᾶγμα" strong="G4229" x-morph="N-GPN" x-gloss="things" x-translit="pragmatōn" xml:lang="grc">πραγμάτων</char>,<verse eid="LUK 1:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="LUK.1.2" sid="LUK 1:2" /><char style="w" x-id="SBLGNT.LUK.1.2.001" x-align="LUK.1.2.a001" x-target-ids="t001 t002" x-target="even as" x-target-head="t002" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="as" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.LUK.1.2.002" x-align="LUK.1.2.a002" x-target-ids="t003 t004 t005" x-target="they delivered them" x-target-head="t004" x-head="true" lemma="παραδίδωμι" strong="G3860" x-morph="V-2AAI-3P" x-gloss="delivered [them]" x-translit="paredosan" xml:lang="grc">παρέδοσαν</char> <char style="w" x-id="SBLGNT.LUK.1.2.003" x-align="LUK.1.2.a003" x-target-ids="t006 t007" x-target="unto us" x-target-head="t007" x-head="true" lemma="ἐγώ" strong="G2254" x-morph="P-1DP" x-gloss="to us" x-translit="hēmin" xml:lang="grc">ἡμῖν</char> <char style="w" x-id="SBLGNT.LUK.1.2.004" x-align="LUK.1.2.a004" x-target-ids="t008" x-target="who" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.1.2.005" x-align="LUK.1.2.a005" x-target-ids="t009" x-target="from" x-target-head="t009" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="ap" xml:lang="grc">ἀπ</char>ʼ<char style="w" x-id="SBLGNT.LUK.1.2.006" x-align="LUK.1.2.a006" x-target-ids="t010 t011" x-target="the beginning" x-target-head="t011" x-head="true" lemma="ἀρχή" strong="G746" x-morph="N-GSF" x-gloss="[the] beginning" x-translit="archēs" xml:lang="grc">ἀρχῆς</char> <char style="w" x-id="SBLGNT.LUK.1.2.007" x-align="LUK.1.2.a007" x-target-ids="t013" x-target="eyewitnesses" x-target-head="t013" x-head="true" lemma="αὐτόπτης" strong="G845" x-morph="N-NPM" x-gloss="eyewitnesses" x-translit="autoptai" xml:lang="grc">αὐτόπται</char> <char style="w" x-id="SBLGNT.LUK.1.2.008" x-align="LUK.1.2.a008" x-target-ids="t014" x-target="and" x-target-head="t014" x-head=