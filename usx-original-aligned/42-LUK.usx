	<para style="p"><verse number="3" style="v" x-ref="LUK.1.3" sid="LUK 1:3" /><char style="w" x-id="SBLGNT.LUK.1.3.001" x-align="LUK.1.3.a001" x-target-ids="t001 t002 t003" x-target="it seemed good" x-target-head="t002" x-head="true" lemma="δοκέω" strong="G1380" x-morph="V-AAI-3S" x-gloss="it seemed good" x-translit="edoxe" xml:lang="grc">ἔδοξε</char> <char style="w" x-id="SBLGNT.LUK.1.3.002" x-align="LUK.1.3.a002" x-target-ids="t004 t005 t006" x-target="to me also" x-target-head="t005" x-head="true" lemma="κἀγώ" strong="G2504" x-morph="P-1DS-K" x-gloss="also to me" x-translit="kamoi" xml:lang="grc">κἀμοὶ</char> <char style="w" x-id="SBLGNT.LUK.1.3.003" x-align="LUK.1.3.a003" x-target-ids="t007 t008 t009 t010" x-target="having traced the course" x-target-head="t008" x-head="true" lemma="παρακολουθέω" strong="G3877" x-morph="V-RAP-DSM" x-gloss="having been acquainted" x-translit="parēkolouthēkoti" xml:lang="grc">παρηκολουθηκότι</char> <char style="w" x-id="SBLGNT.LUK.1.3.004" x-align="LUK.1.3.a004" x-target-ids="t015 t016 t017" x-target="from the first" x-target-head="t017" x-head="true" lemma="ἄνωθεν" strong="G509" x-morph="ADV" x-gloss="from the first" x-translit="anōthen" xml:lang="grc">ἄνωθεν</char> <char style="w" x-id="SBLGNT.LUK.1.3.005" x-align="LUK.1.3.a005" x-target-ids="t011 t012 t013" x-target="of all things" x-target-head="t012" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-DPN" x-gloss="with all things" x-translit="pasin" xml:lang="grc">πᾶσιν</char> <char style="w" x-id="SBLGNT.LUK.1.3.006" x-align="LUK.1.3.a006" x-target-ids="t014" x-target="accurately" x-target-head="t014" x-head="true" lemma="ἀκριβῶς" strong="G199" x-morph="ADV" x-gloss="carefully" x-translit="akribōs" xml:lang="grc">ἀκριβῶς</char> <char style="w" x-id="SBLGNT.LUK.1.3.007" x-align="LUK.1.3.a007" x-target-ids="t022 t023" x-target="in order" x-target-head="t023" x-head="true" lemma="καθεξῆς" strong="G2517" x-morph="ADV" x-gloss="with method" x-translit="kathexēs" xml:lang="grc">κα