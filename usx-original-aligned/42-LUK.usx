	<para style="p"><verse number="7" style="v" x-ref="LUK.4.7" sid="LUK 4:7" /><char style="w" x-id="SBLGNT.LUK.4.7.001" x-align="LUK.4.7.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="σύ" strong="G4771" x-morph="P-2NS" x-gloss="You" x-translit="sy" xml:lang="grc">σὺ</char> <char style="w" x-id="SBLGNT.LUK.4.7.002" x-align="LUK.4.7.a003" x-target-ids="t003" x-target="therefore" x-target-head="t003" x-head="true" lemma="οὖν" strong="G3767" x-morph="CONJ" x-gloss="therefore" x-translit="oun" xml:lang="grc">οὖν</char> <char style="w" x-id="SBLGNT.LUK.4.7.003" x-align="LUK.4.7.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.LUK.4.7.004" x-align="LUK.4.7.a004" x-target-ids="t004 t005" x-target="wilt worship" x-target-head="t005" x-head="true" lemma="προσκυνέω" strong="G4352" x-morph="V-AAS-2S" x-gloss="You will worship" x-translit="proskynēsēis" xml:lang="grc">προσκυνήσῃς</char> <char style="w" x-id="SBLGNT.LUK.4.7.005" x-align="LUK.4.7.a005" x-target-ids="t006" x-target="before" x-target-head="t006" x-head="true" lemma="ἐνώπιον" strong="G1799" x-morph="PREP" x-gloss="before" x-translit="enōpion" xml:lang="grc">ἐνώπιον</char> <char style="w" x-id="SBLGNT.LUK.4.7.006" x-align="LUK.4.7.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="ἐγώ" strong="G1473" x-morph="P-1GS" x-gloss="me" x-translit="emou" xml:lang="grc">ἐμοῦ</char>,<char style="w" x-id="SBLGNT.LUK.4.7.007" x-align="LUK.4.7.a007" x-target-ids="t008 t009 t011" x-target="it shall be" x-target-head="t011" x-head="true" lemma="εἰμί" strong="G2071" x-morph="V-FDI-3S" x-gloss="will be" x-translit="estai" xml:lang="grc">ἔσται</char> <char style="w" x-id="SBLGNT.LUK.4.7.008" x-align="LUK.4.7.a009" x-target-ids="t012" x-target="thine" x-target-head="t012" x-head="true" lemma="σύ" strong="G4675" x-morph="