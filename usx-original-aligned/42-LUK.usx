	<para style="p"><verse number="33" style="v" x-ref="LUK.18.33" sid="LUK 18:33" /><char style="w" x-id="SBLGNT.LUK.18.33.001" x-align="LUK.18.33.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.18.33.002" x-align="LUK.18.33.a002" x-target-ids="t002 t003 t004" x-target="they shall scourge" x-target-head="t004" x-head="true" lemma="μαστιγόω" strong="G3146" x-morph="V-AAP-NPM" x-gloss="having flogged [Him]" x-translit="mastigōsantes" xml:lang="grc">μαστιγώσαντες</char> <char style="w" x-id="SBLGNT.LUK.18.33.003" x-align="LUK.18.33.a003" x-target-ids="t005 t006" x-target="and kill" x-target-head="t006" x-head="true" lemma="ἀποκτείνω" strong="G615" x-morph="V-FAI-3P" x-gloss="they will kill" x-translit="apoktenousin" xml:lang="grc">ἀποκτενοῦσιν</char> <char style="w" x-id="SBLGNT.LUK.18.33.004" x-align="LUK.18.33.a004" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτόν</char>,<char style="w" x-id="SBLGNT.LUK.18.33.005" x-align="LUK.18.33.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.18.33.006" x-align="LUK.18.33.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="on the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.LUK.18.33.007" x-align="LUK.18.33.a007" x-target-ids="t011" x-target="day" x-target-head="t011" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-DSF" x-gloss="day" x-translit="hēmerai" xml:lang="grc">ἡμέρᾳ</char> <char style="w" x-id="SBLGNT.LUK.18.33.008" x-align="LUK.18.33.a008" x-status="unrepresented" x-head="true" lemma="ὁ