	<para style="p"><verse number="45" style="v" x-ref="LUK.19.45" sid="LUK 19:45" /><char style="w" x-id="SBLGNT.LUK.19.45.001" x-align="LUK.19.45.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.45.002" x-align="LUK.19.45.a002" x-target-ids="t002 t003" x-target="he entered" x-target-head="t003" x-head="true" lemma="εἰσέρχομαι" strong="G1525" x-morph="V-2AAP-NSM" x-gloss="having entered" x-translit="eiselthōn" xml:lang="grc">εἰσελθὼν</char> <char style="w" x-id="SBLGNT.LUK.19.45.003" x-align="LUK.19.45.a003" x-target-ids="t004" x-target="into" x-target-head="t004" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="into" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.19.45.004" x-align="LUK.19.45.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.19.45.005" x-align="LUK.19.45.a005" x-target-ids="t006" x-target="temple" x-target-head="t006" x-head="true" lemma="ἱερόν" strong="G2411" x-morph="N-ASN" x-gloss="temple" x-translit="hieron" xml:lang="grc">ἱερὸν</char> <char style="w" x-id="SBLGNT.LUK.19.45.006" x-align="LUK.19.45.a006" x-target-ids="t007 t008" x-target="and began" x-target-head="t008" x-head="true" lemma="ἄρχω" strong="G756" x-morph="V-ADI-3S" x-gloss="He began" x-translit="ērxato" xml:lang="grc">ἤρξατο</char> <char style="w" x-id="SBLGNT.LUK.19.45.007" x-align="LUK.19.45.a007" x-target-ids="t009 t010 t011" x-target="to cast out" x-target-head="t010" x-head="true" lemma="ἐκβάλλω" strong="G1544" x-morph="V-PAN" x-gloss="to cast out" x-translit="ekballein" xml:lang="grc">ἐκβάλλειν</char> <char style="w" x-id="SBLGNT.LUK.19.45.008" x-align="LUK.19.45.a008" x-target-ids="t012" x-target="them" x-target-head="t01