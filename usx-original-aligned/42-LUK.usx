	<para style="p"><verse number="16" style="v" x-ref="LUK.22.16" sid="LUK 22:16" /><char style="w" x-id="SBLGNT.LUK.22.16.001" x-align="LUK.22.16.a001" x-target-ids="t002 t003" x-target="I say" x-target-head="t003" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.LUK.22.16.002" x-align="LUK.22.16.a002" x-target-ids="t001" x-target="for" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.LUK.22.16.003" x-align="LUK.22.16.a003" x-target-ids="t004 t005" x-target="unto you" x-target-head="t005" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.LUK.22.16.004" x-align="LUK.22.16.a004" x-status="unrepresented" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.LUK.22.16.005" x-align="LUK.22.16.a005" x-status="noncompositional" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="never" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.LUK.22.16.006" x-align="LUK.22.16.a005" x-status="noncompositional" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.22.16.007" x-align="LUK.22.16.a006" x-target-ids="t006 t007 t009" x-target="I shall eat" x-target-head="t009" x-head="true" lemma="ἐσθίω" strong="G5315" x-morph="V-2AAS-1S" x-gloss="will I eat" x-translit="phagō" xml:lang="grc">φάγω</char> <char style="w" x-id="SBLGNT.LUK.22.16.008" x-align="LUK.22.16.a007" x-target-ids="t010" x-target="it" x-target-head="t010" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASN" x-gloss="thereof" x-translit="auto" xml:lang="grc">αὐτὸ</char> <char style="w" x-id="SBLGNT.LUK.22.16.009" x-align="LUK.22.16.a008" x-target-ids="t011" x-target="until" x-target-head="t011" x-head="true" lemma="ἕως" strong="G2193" x-morph="ADV" x-gloss="until" x-translit="heōs" xml:lang="grc">ἕως</char> <char style="w" x-id="SBLGNT.LUK.22.16.010" x-align="LUK.22.16.a009" x-status="unrepresented" x-head="true" lemma="ὅστις" strong="G3755" x-morph="R-GSN-ATT" x-gloss="when" x-translit="hotou" xml:lang="grc">ὅτου</char> <char style="w" x-id="SBLGNT.LUK.22.16.011" x-align="LUK.22.16.a010" x-target-ids="t012 t013 t014" x-target="it be fulfilled" x-target-head="t014" x-head="true" lemma="πληρόω" strong="G4137" x-morph="V-APS-3S" x-gloss="it is fulfilled" x-translit="plērōthēi" xml:lang="grc">πληρωθῇ</char> <char style="w" x-id="SBLGNT.LUK.22.16.012" x-align="LUK.22.16.a011" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.22.16.013" x-align="LUK.22.16.a012" x-target-ids="t016" x-target="the" x-target-head="t016" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.LUK.22.16.014" x-align="LUK.22.16.a013" x-target-ids="t017" x-target="kingdom" x-target-head="t017" x-head="true" lemma="βασιλεία" strong="G932" x-morph="N-DSF" x-gloss="kingdom" x-translit="basileiai" xml:lang="grc">βασιλείᾳ</char> <char style="w" x-id="SBLGNT.LUK.22.16.015" x-align="LUK.22.16.a014" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="-" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.22.16.016" x-align="LUK.22.16.a015" x-target-ids="t018 t019" x-target="of God" x-target-head="t019" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char>.<verse eid="LUK 22:16" /></para>
	<para style="p"><verse number="17" style="v" x-ref="LUK.22.17" sid="LUK 22:17" /><char style="w" x-id="SBLGNT.LUK.22.17.001" x-align="LUK.22.17.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.17.002" x-align="LUK.22.17.a002" x-target-ids="t002 t003" x-target="he received" x-target-head="t003" x-head="true" lemma="δέχομαι" strong="G1209" x-morph="V-ADP-NSM" x-gloss="having received" x-translit="dexamenos" xml:lang="grc">δεξάμενος</char> <char style="w" x-id="SBLGNT.LUK.22.17.003" x-align="LUK.22.17.a003" x-target-ids="t004 t005" x-target="a cup" x-target-head="t005" x-head="true" lemma="ποτήριον" strong="G4221" x-morph="N-ASN" x-gloss="[the] cup" x-translit="potērion" xml:lang="grc">ποτήριον</char> <char style="w" x-id="SBLGNT.LUK.22.17.004" x-align="LUK.22.17.a004" x-target-ids="t006 t007 t008 t009 t010 t011" x-target="and when he had given thanks" x-target-head="t011" x-head="true" lemma="εὐχαριστέω" strong="G2168" x-morph="V-AAP-NSM" x-gloss="having given thanks" x-translit="eucharistēsas" xml:lang="grc">εὐχαριστήσας</char> <char style="w" x-id="SBLGNT.LUK.22.17.005" x-align="LUK.22.17.a005" x-target-ids="t012 t013" x-target="he said" x-target-head="t013" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char>·<char style="w" x-id="SBLGNT.LUK.22.17.006" x-align="LUK.22.17.a006" x-target-ids="t014" x-target="Take" x-target-head="t014" x-head="true" lemma="λαμβάνω" strong="G2983" x-morph="V-2AAM-2P" x-gloss="Take" x-translit="Labete" xml:lang="grc">Λάβετε</char> <char style="w" x-id="SBLGNT.LUK.22.17.007" x-align="LUK.22.17.a007" x-target-ids="t015" x-target="this" x-target-head="t015" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.LU