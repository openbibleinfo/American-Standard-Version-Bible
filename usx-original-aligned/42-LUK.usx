	<para style="p"><verse number="17" style="v" x-ref="LUK.9.17" sid="LUK 9:17" /><char style="w" x-id="SBLGNT.LUK.9.17.001" x-align="LUK.9.17.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.9.17.002" x-align="LUK.9.17.a002" x-target-ids="t002 t003" x-target="they ate" x-target-head="t003" x-head="true" lemma="ἐσθίω" strong="G5315" x-morph="V-2AAI-3P" x-gloss="they ate" x-translit="ephagon" xml:lang="grc">ἔφαγον</char> <char style="w" x-id="SBLGNT.LUK.9.17.003" x-align="LUK.9.17.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.9.17.004" x-align="LUK.9.17.a004" x-target-ids="t005 t007" x-target="were filled" x-target-head="t007" x-head="true" lemma="χορτάζω" strong="G5526" x-morph="V-API-3P" x-gloss="were satisfied" x-translit="echortasthēsan" xml:lang="grc">ἐχορτάσθησαν</char> <char style="w" x-id="SBLGNT.LUK.9.17.005" x-align="LUK.9.17.a005" x-target-ids="t006" x-target="all" x-target-head="t006" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NPM" x-gloss="all" x-translit="pantes" xml:lang="grc">πάντες</char>,<char style="w" x-id="SBLGNT.LUK.9.17.006" x-align="LUK.9.17.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.9.17.007" x-align="LUK.9.17.a007" x-target-ids="t009 t010 t011 t012" x-target="there was taken up" x-target-head="t011" x-head="true" lemma="αἴρω" strong="G142" x-morph="V-API-3S" x-gloss="was taken up" x-translit="ērthē" xml:lang="grc">ἤρθη</char> <char style="w" x-id="SBLGNT.LUK.9.17.008" x-align="LUK.9.17.a008" x-target-ids="t013" x-target="that" x-target-head="t013" x-head="tr