	<para style="p"><verse number="31" style="v" x-ref="LUK.12.31" sid="LUK 12:31" /><char style="w" x-id="SBLGNT.LUK.12.31.001" x-align="LUK.12.31.a001" x-target-ids="t001" x-target="Yet" x-target-head="t001" x-head="true" lemma="πλήν" strong="G4133" x-morph="ADV" x-gloss="But" x-translit="plēn" xml:lang="grc">πλὴν</char> <char style="w" x-id="SBLGNT.LUK.12.31.002" x-align="LUK.12.31.a002" x-target-ids="t002 t003" x-target="seek ye" x-target-head="t002" x-head="true" lemma="ζητέω" strong="G2212" x-morph="V-PAM-2P" x-gloss="seek you" x-translit="zēteite" xml:lang="grc">ζητεῖτε</char> <char style="w" x-id="SBLGNT.LUK.12.31.003" x-align="LUK.12.31.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="the" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.LUK.12.31.004" x-align="LUK.12.31.a005" x-target-ids="t005" x-target="kingdom" x-target-head="t005" x-head="true" lemma="βασιλεία" strong="G932" x-morph="N-ASF" x-gloss="kingdom" x-translit="basileian" xml:lang="grc">βασιλείαν</char> <char style="w" x-id="SBLGNT.LUK.12.31.005" x-align="LUK.12.31.a004" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char>,<char style="w" x-id="SBLGNT.LUK.12.31.006" x-align="LUK.12.31.a006" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.12.31.007" x-align="LUK.12.31.a007" x-target-ids="t007 t008" x-target="these things" x-target-head="t007" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-NPN" x-gloss="these things" x-translit="tauta" xml:lang="grc">ταῦτα</char> <char style="w" x-id="SBLGNT.LUK.12.31.008" x-align="LUK.12.31.a008" x-target-ids="t009 t010 t011" x-target="shall be added" x-target-head="t011" x-head="true" lemma="προστίθημι" strong="G43