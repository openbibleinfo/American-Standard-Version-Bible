	<para style="p"><verse number="34" style="v" x-ref="LUK.18.34" sid="LUK 18:34" /><char style="w" x-id="SBLGNT.LUK.18.34.001" x-align="LUK.18.34.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.18.34.002" x-align="LUK.18.34.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NPM" x-gloss="they" x-translit="autoi" xml:lang="grc">αὐτοὶ</char> <char style="w" x-id="SBLGNT.LUK.18.34.003" x-align="LUK.18.34.a003" x-target-ids="t004" x-target="none" x-target-head="t004" x-head="true" lemma="οὐδείς" strong="G3762" x-morph="A-ASN-N" x-gloss="none" x-translit="ouden" xml:lang="grc">οὐδὲν</char> <char style="w" x-id="SBLGNT.LUK.18.34.004" x-align="LUK.18.34.a004" x-target-ids="t005 t006 t007" x-target="of these things" x-target-head="t006" x-head="true" lemma="οὗτος" strong="G5130" x-morph="D-GPN" x-gloss="of these things" x-translit="toutōn" xml:lang="grc">τούτων</char> <char style="w" x-id="SBLGNT.LUK.18.34.005" x-align="LUK.18.34.a005" x-target-ids="t003" x-target="understood" x-target-head="t003" x-head="true" lemma="συνίημι" strong="G4920" x-morph="V-AAI-3P" x-gloss="understood" x-translit="synēkan" xml:lang="grc">συνῆκαν</char>,<char style="w" x-id="SBLGNT.LUK.18.34.006" x-align="LUK.18.34.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.18.34.007" x-align="LUK.18.34.a007" x-target-ids="t011" x-target="was" x-target-head="t011" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.LUK.18.34.008" x-align="LUK.18.34.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss