	<para style="p"><verse number="45" style="v" x-ref="LUK.24.45" sid="LUK 24:45" /><char style="w" x-id="SBLGNT.LUK.24.45.001" x-align="LUK.24.45.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="τότε" strong="G5119" x-morph="ADV" x-gloss="Then" x-translit="tote" xml:lang="grc">τότε</char> <char style="w" x-id="SBLGNT.LUK.24.45.002" x-align="LUK.24.45.a002" x-target-ids="t002 t003" x-target="opened he" x-target-head="t002" x-head="true" lemma="διανοίγω" strong="G1272" x-morph="V-AAI-3S" x-gloss="He opened" x-translit="diēnoixen" xml:lang="grc">διήνοιξεν</char> <char style="w" x-id="SBLGNT.LUK.24.45.003" x-align="LUK.24.45.a003" x-target-ids="t004" x-target="their" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="their" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.LUK.24.45.004" x-align="LUK.24.45.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="-" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.LUK.24.45.005" x-align="LUK.24.45.a005" x-target-ids="t005" x-target="mind" x-target-head="t005" x-head="true" lemma="νοῦς" strong="G3563" x-morph="N-ASM" x-gloss="mind" x-translit="noun" xml:lang="grc">νοῦν</char> <char style="w" x-id="SBLGNT.LUK.24.45.006" x-align="LUK.24.45.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSN" x-gloss="-" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.24.45.007" x-align="LUK.24.45.a007" x-target-ids="t006 t007 t008 t009" x-target="that they might understand" x-target-head="t009" x-head="true" lemma="συνίημι" strong="G4920" x-morph="V-PAN" x-gloss="to understand" x-translit="synienai" xml:lang="grc">συνιέναι</char> <char style="w" x-id="SBLGNT.LUK.24.45.008" x-align="LUK.24.45.a008" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APF" x-gloss="the" x-tra