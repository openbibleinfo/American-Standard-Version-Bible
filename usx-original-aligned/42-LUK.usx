	<para style="p"><verse number="32" style="v" x-ref="LUK.19.32" sid="LUK 19:32" /><char style="w" x-id="SBLGNT.LUK.19.32.001" x-align="LUK.19.32.a004" x-target-ids="t006 t007" x-target="went away" x-target-head="t006" x-head="true" lemma="ἀπέρχομαι" strong="G565" x-morph="V-2AAP-NPM" x-gloss="Having departed" x-translit="apelthontes" xml:lang="grc">ἀπελθόντες</char> <char style="w" x-id="SBLGNT.LUK.19.32.002" x-align="LUK.19.32.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.19.32.003" x-align="LUK.19.32.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.19.32.004" x-align="LUK.19.32.a003" x-target-ids="t003 t004 t005" x-target="that were sent" x-target-head="t005" x-head="true" lemma="ἀποστέλλω" strong="G649" x-morph="V-RPP-NPM" x-gloss="having been sent" x-translit="apestalmenoi" xml:lang="grc">ἀπεσταλμένοι</char> <char style="w" x-id="SBLGNT.LUK.19.32.005" x-align="LUK.19.32.a005" x-target-ids="t008 t009" x-target="and found" x-target-head="t009" x-head="true" lemma="εὑρίσκω" strong="G2147" x-morph="V-2AAI-3P" x-gloss="found [it]" x-translit="heuron" xml:lang="grc">εὗρον</char> <char style="w" x-id="SBLGNT.LUK.19.32.006" x-align="LUK.19.32.a006" x-target-ids="t010 t011" x-target="even as" x-target-head="t011" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="as" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.LUK.19.32.007" x-align="LUK.19.32.a007" x-target-ids="t012 t013 t014" x-target="he had said" x-target-head="t014" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He had said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.19.32.008" x-align="LUK.19.