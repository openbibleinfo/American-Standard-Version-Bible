	<para style="p"><verse number="26" style="v" x-ref="LUK.22.26" sid="LUK 22:26" /><char style="w" x-id="SBLGNT.LUK.22.26.001" x-align="LUK.22.26.a001" x-target-ids="t002" x-target="ye" x-target-head="t002" x-head="true" lemma="σύ" strong="G5210" x-morph="P-2NP" x-gloss="You" x-translit="hymeis" xml:lang="grc">ὑμεῖς</char> <char style="w" x-id="SBLGNT.LUK.22.26.002" x-align="LUK.22.26.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.26.003" x-align="LUK.22.26.a003" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouch" xml:lang="grc">οὐχ</char> <char style="w" x-id="SBLGNT.LUK.22.26.004" x-align="LUK.22.26.a004" x-target-ids="t003 t005 t006" x-target="shall be so" x-target-italic-ids="t003 t005" x-target-head="t006" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="thus [shall be]" x-translit="houtōs" xml:lang="grc">οὕτως</char>,<char style="w" x-id="SBLGNT.LUK.22.26.005" x-align="LUK.22.26.a005" x-target-ids="t007" x-target="but" x-target-head="t007" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="Instead" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.LUK.22.26.006" x-align="LUK.22.26.a006" x-target-ids="t008 t009 t010 t011" x-target="he that is the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.22.26.007" x-align="LUK.22.26.a007" x-target-ids="t012" x-target="greater" x-target-head="t012" x-head="true" lemma="μέγας" strong="G3187" x-morph="A-NSM-C" x-gloss="greatest" x-translit="meizōn" xml:lang="grc">μείζων</char> <char style="w" x-id="SBLGNT.LUK.22.26.008" x-align="LUK.22.26.a008" x-target-ids="t013" x-target="among" x-target-head="t013" x-h