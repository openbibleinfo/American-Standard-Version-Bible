	<para style="p"><verse number="39" style="v" x-ref="LUK.18.39" sid="LUK 18:39" /><char style="w" x-id="SBLGNT.LUK.18.39.001" x-align="LUK.18.39.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.18.39.002" x-align="LUK.18.39.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.18.39.003" x-align="LUK.18.39.a003" x-target-ids="t003 t004 t005" x-target="that went before" x-target-head="t004" x-head="true" lemma="προάγω" strong="G4254" x-morph="V-PAP-NPM" x-gloss="going before" x-translit="proagontes" xml:lang="grc">προάγοντες</char> <char style="w" x-id="SBLGNT.LUK.18.39.004" x-align="LUK.18.39.a004" x-target-ids="t006" x-target="rebuked" x-target-head="t006" x-head="true" lemma="ἐπιτιμάω" strong="G2008" x-morph="V-IAI-3P" x-gloss="were rebuking" x-translit="epetimōn" xml:lang="grc">ἐπετίμων</char> <char style="w" x-id="SBLGNT.LUK.18.39.005" x-align="LUK.18.39.a005" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="him" x-translit="autōi" xml:lang="grc">αὐτῷ</char> <char style="w" x-id="SBLGNT.LUK.18.39.006" x-align="LUK.18.39.a006" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.LUK.18.39.007" x-align="LUK.18.39.a007" x-target-ids="t009 t010 t011 t012 t013" x-target="he should hold his peace" x-target-head="t013" x-head="true" lemma="σιγάω" strong="G4601" x-morph="V-AAS-3S" x-gloss="he should be silent" x-translit="sigēsēi" xml:lang="grc">σιγήσῃ</char>·<char style="w" x-id="SBLGNT.LUK.18.39.008" x-align="LUK.18.39.a008" x-target-ids="t01