	<para style="p"><verse number="15" style="v" x-ref="LUK.22.15" sid="LUK 22:15" /><char style="w" x-id="SBLGNT.LUK.22.15.001" x-align="LUK.22.15.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.15.002" x-align="LUK.22.15.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.22.15.003" x-align="LUK.22.15.a003" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.LUK.22.15.004" x-align="LUK.22.15.a004" x-target-ids="t005" x-target="them" x-target-head="t005" x-head="true" lemma="ἑαυτοῦ" strong="G848" x-morph="P-APM" x-gloss="them" x-translit="autous" xml:lang="grc">αὐτούς</char>·<char style="w" x-id="SBLGNT.LUK.22.15.005" x-align="LUK.22.15.a005" x-target-ids="t006 t007" x-target="With desire" x-target-head="t007" x-head="true" lemma="ἐπιθυμία" strong="G1939" x-morph="N-DSF" x-gloss="With desire" x-translit="Epithymiai" xml:lang="grc">Ἐπιθυμίᾳ</char> <char style="w" x-id="SBLGNT.LUK.22.15.006" x-align="LUK.22.15.a006" x-target-ids="t008 t009 t010" x-target="I have desired" x-target-head="t010" x-head="true" lemma="ἐπιθυμέω" strong="G1937" x-morph="V-AAI-1S" x-gloss="I have desired" x-translit="epethymēsa" xml:lang="grc">ἐπεθύμησα</char> <char style="w" x-id="SBLGNT.LUK.22.15.007" x-align="LUK.22.15.a007" x-target-ids="t013" x-target="this" x-target-head="t013" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.LUK.22.15.008" x-align="LUK.22.15.a008" x-status="unrepresented" x-head="true" lemma