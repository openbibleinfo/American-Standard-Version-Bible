	<para style="p"><verse number="29" style="v" x-ref="LUK.2.29" sid="LUK 2:29" /><char style="w" x-id="SBLGNT.LUK.2.29.001" x-align="LUK.2.29.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="νῦν" strong="G3568" x-morph="ADV" x-gloss="Now" x-translit="Nyn" xml:lang="grc">Νῦν</char> <char style="w" x-id="SBLGNT.LUK.2.29.002" x-align="LUK.2.29.a002" x-target-ids="t002 t003 t006" x-target="lettest thou depart" x-target-head="t006" x-head="true" lemma="ἀπολύω" strong="G630" x-morph="V-PAI-2S" x-gloss="You dismiss" x-translit="apolyeis" xml:lang="grc">ἀπολύεις</char> <char style="w" x-id="SBLGNT.LUK.2.29.003" x-align="LUK.2.29.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.LUK.2.29.004" x-align="LUK.2.29.a005" x-target-ids="t005" x-target="servant" x-target-head="t005" x-head="true" lemma="δοῦλος" strong="G1401" x-morph="N-ASM" x-gloss="servant" x-translit="doulon" xml:lang="grc">δοῦλόν</char> <char style="w" x-id="SBLGNT.LUK.2.29.005" x-align="LUK.2.29.a004" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="of You" x-translit="sou" xml:lang="grc">σου</char>,<char style="w" x-id="SBLGNT.LUK.2.29.006" x-align="LUK.2.29.a006" x-target-ids="t007" x-target="Lord" x-target-head="t007" x-head="true" lemma="δεσπότης" strong="G1203" x-morph="N-VSM" x-gloss="Lord" x-translit="despota" xml:lang="grc">δέσποτα</char>,<char style="w" x-id="SBLGNT.LUK.2.29.007" x-align="LUK.2.29.a007" x-target-ids="t008 t009" x-target="According to" x-target-head="t008" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="according to" x-translit="kata" xml:lang="grc">κατὰ</char> <char style="w" x-id="SBLGNT.LUK.2.29.008" x-align="LUK.2.29.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="g