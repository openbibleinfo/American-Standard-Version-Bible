	<para style="p"><verse number="51" style="v" x-ref="LUK.1.51" sid="LUK 1:51" /><char style="w" x-id="SBLGNT.LUK.1.51.001" x-align="LUK.1.51.a001" x-target-ids="t001 t002 t003" x-target="He hath showed" x-target-head="t003" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-AAI-3S" x-gloss="He has shown" x-translit="Epoiēsen" xml:lang="grc">Ἐποίησεν</char> <char style="w" x-id="SBLGNT.LUK.1.51.002" x-align="LUK.1.51.a002" x-target-ids="t004" x-target="strength" x-target-head="t004" x-head="true" lemma="κράτος" strong="G2904" x-morph="N-ASN" x-gloss="strength" x-translit="kratos" xml:lang="grc">κράτος</char> <char style="w" x-id="SBLGNT.LUK.1.51.003" x-align="LUK.1.51.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="with" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.1.51.004" x-align="LUK.1.51.a004" x-target-ids="t007" x-target="arm" x-target-head="t007" x-head="true" lemma="βραχίων" strong="G1023" x-morph="N-DSM" x-gloss="the arm" x-translit="brachioni" xml:lang="grc">βραχίονι</char> <char style="w" x-id="SBLGNT.LUK.1.51.005" x-align="LUK.1.51.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char>,<char style="w" x-id="SBLGNT.LUK.1.51.006" x-align="LUK.1.51.a006" x-target-ids="t008 t009 t010" x-target="He hath scattered" x-target-head="t010" x-head="true" lemma="διασκορπίζω" strong="G1287" x-morph="V-AAI-3S" x-gloss="He has scattered" x-translit="dieskorpisen" xml:lang="grc">διεσκόρπισεν</char> <char style="w" x-id="SBLGNT.LUK.1.51.007" x-align="LUK.1.51.a007" x-target-ids="t011 t012" x-target="the proud" x-target-head="t012" x-head="true" lemma="ὑπερήφανος" strong="G5244" x-morph="A-APM" x-gloss="[the] proud" x-translit="hyperēphanous" xml:lang="grc">ὑπερηφάνους</char> <char style="w" x-id="SBLGNT.LUK.1.51.008" x-align="LUK.1.51.a008" x-target-ids="t013 t014 t015" x-target="in the imagination" x-target-head="t015" x-head="true" lemma="διάνοια" strong="G1271" x-morph="N-DSF" x-gloss="in [the] thought" x-translit="dianoiai" xml:lang="grc">διανοίᾳ</char> <char style="w" x-id="SBLGNT.LUK.1.51.009" x-align="LUK.1.51.a009" x-target-ids="t016 t018" x-target="of heart" x-target-head="t018" x-head="true" lemma="καρδία" strong="G2588" x-morph="N-GSF" x-gloss="of heart" x-translit="kardias" xml:lang="grc">καρδίας</char> <char style="w" x-id="SBLGNT.LUK.1.51.010" x-align="LUK.1.51.a010" x-target-ids="t017" x-target="their" x-target-head="t017" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="of them" x-translit="autōn" xml:lang="grc">αὐτῶν</char>·<verse eid="LUK 1:51" /></para>
	<para style="p"><verse number="52" style="v" x-ref="LUK.1.52" sid="LUK 1:52" /><char style="w" x-id="SBLGNT.LUK.1.52.001" x-align="LUK.1.52.a001" x-target-ids="t001 t002 t003 t004" x-target="He hath put down" x-target-head="t003" x-head="true" lemma="καθαιρέω" strong="G2507" x-morph="V-2AAI-3S" x-gloss="He has brought down" x-translit="katheilen" xml:lang="grc">καθεῖλεν</char> <char style="w" x-id="SBLGNT.LUK.1.52.002" x-align="LUK.1.52.a002" x-target-ids="t005" x-target="princes" x-target-head="t005" x-head="true" lemma="δυνάστης" strong="G1413" x-morph="N-APM" x-gloss="rulers" x-translit="dynastas" xml:lang="grc">δυνάστας</char> <char style="w" x-id="SBLGNT.LUK.1.52.003" x-align="LUK.1.52.a003" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="apo" xml:lang="grc">ἀπὸ</char> <char style="w" x-id="SBLGNT.LUK.1.52.004" x-align="LUK.1.52.a004" x-target-ids="t007 t008" x-target="their thrones" x-target-italic-ids="t007" x-target-head="t008" x-head="true" lemma="θρόνος" strong="G2362" x-morph="N-GPM" x-gloss="thrones" x-translit="thronōn" xml:lang="grc">θρόνων</char> <char style="w" x-id="SBLGNT.LUK.1.52.005" x-align="LUK.1.52.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.1.52.006" x-align="LUK.1.52.a006" x-target-ids="t010 t011" x-target="hath exalted" x-target-head="t011" x-head="true" lemma="ὑψόω" strong="G5312" x-morph="V-AAI-3S" x-gloss="exalted" x-translit="hypsōsen" xml:lang="grc">ὕψωσεν</char> <char style="w" x-id="SBLGNT.LUK.1.52.007" x-align="LUK.1.52.a007" x-target-ids="t012 t013 t014 t015" x-target="them of low degree" x-target-head="t014" x-head="true" lemma="ταπεινός" strong="G5011" x-morph="A-APM" x-gloss="[the] humble" x-translit="tapeinous" xml:lang="grc">ταπεινούς</char>,<verse eid="LUK 1:52" /></para>
	<para style="p"><verse number="53" style="v" x-ref="LUK.1.53" sid="LUK 1:53" /><char style="w" x-id="SBLGNT.LUK.1.53.001" x-align="LUK.1.53.a001" x-target-ids="t001 t002" x-target="The hungry" x-target-head="t002" x-head="true" lemma="πεινάω" strong="G3983" x-morph="V-PAP-APM" x-gloss="[Those] hungering" x-translit="peinōntas" xml:lang="grc">πεινῶντας</char> <char style="w" x-id="SBLGNT.LUK.1.53.002" x-align="LUK.1.53.a002" x-target-ids="t003 t004 t005" x-target="he hath filled" x-target-head="t005" x-head="true" lemma="ἐμπίμπλημι" strong="G1705" x-morph="V-AAI-3S" x-gloss="He has filled" x-translit="eneplēsen" xml:lang="grc">ἐνέπλησεν</char> <char style="w" x-id="SBLGNT.LUK.1.53.003" x-align="LUK.1.53.a003" x-target-ids="t006 t007 t008" x-target="with good things" x-target-head="t007" x-head="true" lemma="ἀγαθός" strong="G18" x-morph="A-GPM" x-gloss="with good things" x-translit="agathōn" xml:lang="grc">ἀγαθῶν</char> <char style="w" x-id="SBLGNT.LUK.1.53.004" x-align="LUK.1.53.a004" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.1.53.005" x-align="LUK.1.53.a005" x-target-ids="t010 t011" x-target="the rich" x-target-head="t011" x-head="true" lemma="πλουτέω" strong="G4147" x-morph="V-PAP-APM" x-gloss="[those] being rich" x-translit="ploutountas" xml:lang="grc">πλουτοῦντας</char> <char style="w" x-id="SBLGNT.LUK.1.53.006" x-align="LUK.1.53.a006" x-target-ids="t012 t013 t014 t016" x-target="he hath sent away" x-target-head="t014" x-head="true" lemma="ἐξαποστέλλω" strong="G1821" x-morph="V-AAI-3S" x-gloss="He has sent away" x-translit="exapesteilen" xml:lang="grc">ἐξαπέστειλεν</char> <char style="w" x-id="SBLGNT.LUK.1.53.007" x-align="LUK.1.53.a007" x-target-ids="t015" x-target="empty" x-target-head="t015" x-head="true" lemma="κενός" strong="G2756" x-morph="A-APM" x-gloss="empty" x-translit="kenous" xml:lang="grc">κε