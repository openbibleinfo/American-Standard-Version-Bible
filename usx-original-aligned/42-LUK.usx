	<para style="p"><verse number="29" style="v" x-ref="LUK.19.29" sid="LUK 19:29" /><char style="w" x-id="SBLGNT.LUK.19.29.001" x-align="LUK.19.29.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.29.002" x-align="LUK.19.29.a002" x-target-ids="t002 t003 t004 t005" x-target="it came to pass" x-target-head="t003" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2ADI-3S" x-gloss="it came to pass" x-translit="egeneto" xml:lang="grc">ἐγένετο</char> <char style="w" x-id="SBLGNT.LUK.19.29.003" x-align="LUK.19.29.a003" x-target-ids="t006" x-target="when" x-target-head="t006" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.LUK.19.29.004" x-align="LUK.19.29.a004" x-target-ids="t007 t008 t009" x-target="he drew nigh" x-target-head="t008" x-head="true" lemma="ἐγγίζω" strong="G1448" x-morph="V-AAI-3S" x-gloss="He drew near" x-translit="ēngisen" xml:lang="grc">ἤγγισεν</char> <char style="w" x-id="SBLGNT.LUK.19.29.005" x-align="LUK.19.29.a005" x-target-ids="t010" x-target="unto" x-target-head="t010" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.19.29.006" x-align="LUK.19.29.a006" x-target-ids="t011" x-target="Bethphage" x-target-head="t011" x-head="true" lemma="Βηθφαγή" strong="G967" x-morph="N-PRI" x-gloss="Bethphage" x-translit="Bēthphagē" xml:lang="grc">Βηθφαγὴ</char> <char style="w" x-id="SBLGNT.LUK.19.29.007" x-align="LUK.19.29.a007" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.29.008" x-align="LUK.19.29.a008" x-target-ids="t013" x-target="Bethany" x-target-head="t013" x