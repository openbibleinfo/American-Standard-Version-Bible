	<para style="p"><verse number="19" style="v" x-ref="LUK.19.19" sid="LUK 19:19" /><char style="w" x-id="SBLGNT.LUK.19.19.001" x-align="LUK.19.19.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.19.19.002" x-align="LUK.19.19.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.19.19.003" x-align="LUK.19.19.a004" x-target-ids="t006" x-target="also" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.19.004" x-align="LUK.19.19.a003" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="οὗτος" strong="G5129" x-morph="D-DSM" x-gloss="to this one" x-translit="toutōi" xml:lang="grc">τούτῳ</char>·<char style="w" x-id="SBLGNT.LUK.19.19.005" x-align="LUK.19.19.a007" x-target-ids="t009" x-target="also" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.19.006" x-align="LUK.19.19.a006" x-target-ids="t008" x-target="thou" x-target-head="t008" x-head="true" lemma="σύ" strong="G4771" x-morph="P-2NS" x-gloss="you" x-translit="sy" xml:lang="grc">σὺ</char> <char style="w" x-id="SBLGNT.LUK.19.19.007" x-align="LUK.19.19.a008" x-target-ids="t010" x-target="over" x-target-head="t010" x-head="true" lemma="ἐπάνω" strong="G1883" x-morph="ADV" x-gloss="over" x-translit="epanō" xml:lang="grc">ἐπάνω</char> <char style="w" x-id="SBLGNT.LUK.19.19.008" x-align="LUK.19.19.a005" x-target-ids="t007" x-target="Be" x-target-head="t007" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-PNM-2S" x-gloss=