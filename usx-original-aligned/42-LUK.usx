	<para style="p"><verse number="30" style="v" x-ref="LUK.19.30" sid="LUK 19:30" /><char style="w" x-id="SBLGNT.LUK.19.30.001" x-align="LUK.19.30.a001" x-target-ids="t001" x-target="saying" x-target-head="t001" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.LUK.19.30.002" x-align="LUK.19.30.a002" x-target-ids="t002 t003 t004" x-target="Go your way" x-target-head="t002" x-head="true" lemma="ὑπάγω" strong="G5217" x-morph="V-PAM-2P" x-gloss="Go" x-translit="Hypagete" xml:lang="grc">Ὑπάγετε</char> <char style="w" x-id="SBLGNT.LUK.19.30.003" x-align="LUK.19.30.a003" x-target-ids="t005" x-target="into" x-target-head="t005" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="into" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.19.30.004" x-align="LUK.19.30.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="the" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.LUK.19.30.005" x-align="LUK.19.30.a006" x-target-ids="t008 t009 t010" x-target="over against you" x-target-italic-ids="t010" x-target-head="t009" x-head="true" lemma="κατέναντι" strong="G2713" x-morph="ADV" x-gloss="ahead" x-translit="katenanti" xml:lang="grc">κατέναντι</char> <char style="w" x-id="SBLGNT.LUK.19.30.006" x-align="LUK.19.30.a005" x-target-ids="t007" x-target="village" x-target-head="t007" x-head="true" lemma="κώμη" strong="G2968" x-morph="N-ASF" x-gloss="village" x-translit="kōmēn" xml:lang="grc">κώμην</char>,<char style="w" x-id="SBLGNT.LUK.19.30.007" x-align="LUK.19.30.a007" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.19.30.008" x-align="LUK.19.30.a008" x-target-ids="t012" x-target="which" x-target-head="t012