	<para style="p"><verse number="2" style="v" x-ref="LUK.2.2" sid="LUK 2:2" /><char style="w" x-id="SBLGNT.LUK.2.2.001" x-align="LUK.2.2.a001" x-target-ids="t001 t002" x-target="This was" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G3778" x-morph="D-NSF" x-gloss="This" x-translit="hautē" xml:lang="grc">αὕτη</char> <char style="w" x-id="SBLGNT.LUK.2.2.002" x-align="LUK.2.2.a002" x-target-ids="t003 t005" x-target="the enrolment" x-target-head="t005" x-head="true" lemma="ἀπογραφή" strong="G582" x-morph="N-NSF" x-gloss="registration" x-translit="apographē" xml:lang="grc">ἀπογραφὴ</char> <char style="w" x-id="SBLGNT.LUK.2.2.003" x-align="LUK.2.2.a003" x-target-ids="t004" x-target="first" x-target-head="t004" x-head="true" lemma="πρῶτος" strong="G4413" x-morph="A-NSF-S" x-gloss="first" x-translit="prōtē" xml:lang="grc">πρώτη</char> <char style="w" x-id="SBLGNT.LUK.2.2.004" x-align="LUK.2.2.a004" x-target-ids="t006" x-target="made" x-target-head="t006" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2ADI-3S" x-gloss="took place [when]" x-translit="egeneto" xml:lang="grc">ἐγένετο</char> <char style="w" x-id="SBLGNT.LUK.2.2.005" x-align="LUK.2.2.a006" x-target-ids="t007 t009 t010" x-target="when was governor" x-target-head="t010" x-head="true" lemma="ἡγεμονεύω" strong="G2230" x-morph="V-PAP-GSM" x-gloss="was governing" x-translit="hēgemoneuontos" xml:lang="grc">ἡγεμονεύοντος</char> <char style="w" x-id="SBLGNT.LUK.2.2.006" x-align="LUK.2.2.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="-" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.LUK.2.2.007" x-align="LUK.2.2.a008" x-target-ids="t011 t012" x-target="of Syria" x-target-head="t012" x-head="true" lemma="Συρία" strong="G4947" x-morph="N-GSF" x-gloss="Syria" x-translit="Syrias" xml:lang="grc">Συρίας</char> <char style="w" x-id="SBLGNT.LUK.2.2.008" x-align="LUK.2.2.a005" x-target-ids="t008" x-target="Quirinius" x-target-head="t008" x-