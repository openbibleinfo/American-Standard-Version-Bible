	<para style="p"><verse number="26" style="v" x-ref="LUK.23.26" sid="LUK 23:26" /><char style="w" x-id="SBLGNT.LUK.23.26.001" x-align="LUK.23.26.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.23.26.002" x-align="LUK.23.26.a002" x-target-ids="t002" x-target="when" x-target-head="t002" x-head="true" lemma="ὡς" strong="G5613" x-morph="ADV" x-gloss="as" x-translit="hōs" xml:lang="grc">ὡς</char> <char style="w" x-id="SBLGNT.LUK.23.26.003" x-align="LUK.23.26.a003" x-target-ids="t003 t004 t006" x-target="they led away" x-target-head="t004" x-head="true" lemma="ἀπάγω" strong="G520" x-morph="V-2AAI-3P" x-gloss="they led away" x-translit="apēgagon" xml:lang="grc">ἀπήγαγον</char> <char style="w" x-id="SBLGNT.LUK.23.26.004" x-align="LUK.23.26.a004" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτόν</char>,<char style="w" x-id="SBLGNT.LUK.23.26.005" x-align="LUK.23.26.a005" x-target-ids="t007 t008 t009 t010" x-target="they laid hold upon" x-target-head="t009" x-head="true" lemma="ἐπιλαμβάνομαι" strong="G1949" x-morph="V-2ADP-NPM" x-gloss="having laid hold on" x-translit="epilabomenoi" xml:lang="grc">ἐπιλαβόμενοι</char> <char style="w" x-id="SBLGNT.LUK.23.26.006" x-align="LUK.23.26.a007" x-target-ids="t012" x-target="Simon" x-target-head="t012" x-head="true" lemma="Σίμων" strong="G4613" x-morph="N-ASM" x-gloss="Simon" x-translit="Simōna" xml:lang="grc">Σίμωνά</char> <char style="w" x-id="SBLGNT.LUK.23.26.007" x-align="LUK.23.26.a006" x-target-ids="t011" x-target="one" x-target-head="t011" x-head="true" lemma="τις" strong="G5100" x-morph="X-ASM" x-gloss="a certain" x-translit="tina" xml:lang="grc">τινα</char> <char style="w" x-id="SBLGNT.LUK.23.26.008" x-align="LUK.23.26.a008" x-target-ids="t013 t014" x-targ