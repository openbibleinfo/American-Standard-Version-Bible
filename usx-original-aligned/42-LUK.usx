	<para style="p"><verse number="20" style="v" x-ref="LUK.19.20" sid="LUK 19:20" /><char style="w" x-id="SBLGNT.LUK.19.20.001" x-align="LUK.19.20.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.20.002" x-align="LUK.19.20.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.19.20.003" x-align="LUK.19.20.a003" x-target-ids="t002" x-target="another" x-target-head="t002" x-head="true" lemma="ἕτερος" strong="G2087" x-morph="A-NSM" x-gloss="another" x-translit="heteros" xml:lang="grc">ἕτερος</char> <char style="w" x-id="SBLGNT.LUK.19.20.004" x-align="LUK.19.20.a004" x-target-ids="t003" x-target="came" x-target-head="t003" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAI-3S" x-gloss="came" x-translit="ēlthen" xml:lang="grc">ἦλθεν</char> <char style="w" x-id="SBLGNT.LUK.19.20.005" x-align="LUK.19.20.a005" x-target-ids="t004" x-target="saying" x-target-head="t004" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.LUK.19.20.006" x-align="LUK.19.20.a006" x-target-ids="t005" x-target="Lord" x-target-head="t005" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-VSM" x-gloss="Lord" x-translit="Kyrie" xml:lang="grc">Κύριε</char>,<char style="w" x-id="SBLGNT.LUK.19.20.007" x-align="LUK.19.20.a007" x-target-ids="t006 t007 t008" x-target="behold here is" x-target-italic-ids="t007 t008" x-target-head="t006" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.LUK.19.20.008" x-align="LUK.19.20.a009" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x