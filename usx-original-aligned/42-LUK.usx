	<para style="p"><verse number="39" style="v" x-ref="LUK.22.39" sid="LUK 22:39" /><char style="w" x-id="SBLGNT.LUK.22.39.001" x-align="LUK.22.39.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.39.002" x-align="LUK.22.39.a002" x-target-ids="t002 t003 t004" x-target="he came out" x-target-head="t003" x-head="true" lemma="ἐξέρχομαι" strong="G1831" x-morph="V-2AAP-NSM" x-gloss="having gone forth" x-translit="exelthōn" xml:lang="grc">ἐξελθὼν</char> <char style="w" x-id="SBLGNT.LUK.22.39.003" x-align="LUK.22.39.a003" x-target-ids="t005 t006" x-target="and went" x-target-head="t006" x-head="true" lemma="πορεύομαι" strong="G4198" x-morph="V-AOI-3S" x-gloss="He went" x-translit="eporeuthē" xml:lang="grc">ἐπορεύθη</char> <char style="w" x-id="SBLGNT.LUK.22.39.004" x-align="LUK.22.39.a004" x-target-ids="t007 t010" x-target="as was" x-target-head="t007" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="according to" x-translit="kata" xml:lang="grc">κατὰ</char> <char style="w" x-id="SBLGNT.LUK.22.39.005" x-align="LUK.22.39.a005" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.22.39.006" x-align="LUK.22.39.a006" x-target-ids="t009" x-target="custom" x-target-head="t009" x-head="true" lemma="ἔθος" strong="G1485" x-morph="N-ASN" x-gloss="custom" x-translit="ethos" xml:lang="grc">ἔθος</char> <char style="w" x-id="SBLGNT.LUK.22.39.007" x-align="LUK.22.39.a007" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.22.39.008" x-align="LUK.22.39.a008" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="tru