	<para style="p"><verse number="1" style="v" x-ref="LUK.19.1" sid="LUK 19:1" /><char style="w" x-id="SBLGNT.LUK.19.1.001" x-align="LUK.19.1.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.1.002" x-align="LUK.19.1.a002" x-target-ids="t002 t003" x-target="he entered" x-target-head="t003" x-head="true" lemma="εἰσέρχομαι" strong="G1525" x-morph="V-2AAP-NSM" x-gloss="having entered" x-translit="eiselthōn" xml:lang="grc">εἰσελθὼν</char> <char style="w" x-id="SBLGNT.LUK.19.1.003" x-align="LUK.19.1.a003" x-target-ids="t004 t005 t006 t007" x-target="and was passing through" x-target-head="t006" x-head="true" lemma="διέρχομαι" strong="G1330" x-morph="V-INI-3S" x-gloss="He was passing through" x-translit="diērcheto" xml:lang="grc">διήρχετο</char> <char style="w" x-id="SBLGNT.LUK.19.1.004" x-align="LUK.19.1.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="-" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.LUK.19.1.005" x-align="LUK.19.1.a005" x-target-ids="t008" x-target="Jericho" x-target-head="t008" x-head="true" lemma="Ἰεριχώ" strong="G2410" x-morph="N-PRI" x-gloss="Jericho" x-translit="Ierichō" xml:lang="grc">Ἰεριχώ</char>.<verse eid="LUK 19:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="LUK.19.2" sid="LUK 19:2" /><char style="w" x-id="SBLGNT.LUK.19.2.001" x-align="LUK.19.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.2.002" x-align="LUK.19.2.a002" x-target-ids="t002" x-target="behold" x-target-head="t002" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.LUK.19.2.003" x-align="LUK.19.2.a003" x-target-ids="t003 t004" x-target="a man" x-target-head="t004" x-head="true" lemma="ἀνήρ" strong="G435" x-morph="N-NSM" x-gloss="a man" x-translit="anēr" xml:lang="grc">ἀνὴρ</char> <char style="w" x-id="SBLGNT.LUK.19.2.004" x-align="LUK.19.2.a005" x-target-ids="t006 t007" x-target="by name" x-target-head="t007" x-head="true" lemma="ὄνομα" strong="G3686" x-morph="N-DSN" x-gloss="by name" x-translit="onomati" xml:lang="grc">ὀνόματι</char> <char style="w" x-id="SBLGNT.LUK.19.2.005" x-align="LUK.19.2.a004" x-target-ids="t005" x-target="called" x-target-head="t005" x-head="true" lemma="καλέω" strong="G2564" x-morph="V-PPP-NSM" x-gloss="called" x-translit="kaloumenos" xml:lang="grc">καλούμενος</char> <char style="w" x-id="SBLGNT.LUK.19.2.006" x-align="LUK.19.2.a006" x-target-ids="t008" x-target="Zacchaeus" x-target-head="t008" x-head="true" lemma="Ζακχαῖος" strong="G2195" x-morph="N-NSM" x-gloss="Zacchaeus" x-translit="Zakchaios" xml:lang="grc">Ζακχαῖος</char>,<char style="w" x-id="SBLGNT.LUK.19.2.007" x-align="LUK.19.2.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.2.008" x-align="LUK.19.2.a008" x-target-ids="t010" x-target="he" x-target-head="t010" x-head="true" lemma="αὐτός" strong="G846"