	<para style="p"><verse number="6" style="v" x-ref="LUK.20.6" sid="LUK 20:6" /><char style="w" x-id="SBLGNT.LUK.20.6.001" x-align="LUK.20.6.a001" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="If" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.LUK.20.6.002" x-align="LUK.20.6.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.20.6.003" x-align="LUK.20.6.a003" x-target-ids="t003 t004 t005" x-target="we shall say" x-target-head="t005" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAS-1P" x-gloss="we should say" x-translit="eipōmen" xml:lang="grc">εἴπωμεν</char>·<char style="w" x-id="SBLGNT.LUK.20.6.004" x-align="LUK.20.6.a004" x-target-ids="t006" x-target="From" x-target-head="t006" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="From" x-translit="Ex" xml:lang="grc">Ἐξ</char> <char style="w" x-id="SBLGNT.LUK.20.6.005" x-align="LUK.20.6.a005" x-target-ids="t007" x-target="men" x-target-head="t007" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-GPM" x-gloss="men" x-translit="anthrōpōn" xml:lang="grc">ἀνθρώπων</char>,<char style="w" x-id="SBLGNT.LUK.20.6.006" x-align="LUK.20.6.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.20.6.007" x-align="LUK.20.6.a007" x-target-ids="t010" x-target="people" x-target-head="t010" x-head="true" lemma="λαός" strong="G2992" x-morph="N-NSM" x-gloss="people" x-translit="laos" xml:lang="grc">λαὸς</char> <char style="w" x-id="SBLGNT.LUK.20.6.008" x-align="LUK.20.6.a008" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="ἅπας" strong="G537" x-morph="A-NSM" x-gloss="all" x-translit="