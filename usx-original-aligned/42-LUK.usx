	<para style="p"><verse number="45" style="v" x-ref="LUK.23.45" sid="LUK 23:45" /><char style="w" x-id="SBLGNT.LUK.23.45.001" x-align="LUK.23.45.a001" x-target-ids="t001" x-target="the" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="The" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.23.45.002" x-align="LUK.23.45.a002" x-target-ids="t002 t003" x-target="sun’s light" x-target-head="t002" x-head="true" lemma="ἥλιος" strong="G2246" x-morph="N-GSM" x-gloss="sun" x-translit="hēliou" xml:lang="grc">ἡλίου</char> <char style="w" x-id="SBLGNT.LUK.23.45.003" x-align="LUK.23.45.a003" x-target-ids="t004" x-target="failing" x-target-head="t004" x-head="true" lemma="ἐκλείπω" strong="G1587" x-morph="V-PAP-GSM" x-gloss="was darkened" x-translit="eklipontos" xml:lang="grc">ἐκλιπόντος</char>,<char style="w" x-id="SBLGNT.LUK.23.45.004" x-align="LUK.23.45.a009" x-target-ids="t011 t012" x-target="was rent" x-target-head="t012" x-head="true" lemma="σχίζω" strong="G4977" x-morph="V-API-3S" x-gloss="was torn" x-translit="eschisthē" xml:lang="grc">ἐσχίσθη</char> <char style="w" x-id="SBLGNT.LUK.23.45.005" x-align="LUK.23.45.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.23.45.006" x-align="LUK.23.45.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.23.45.007" x-align="LUK.23.45.a006" x-target-ids="t007" x-target="veil" x-target-head="t007" x-head="true" lemma="καταπέτασμα" strong="G2665" x-morph="N-NSN" x-gloss="veil" x-translit="katapetasma" xml:lang="grc">καταπέτασμα</char> <char style="w" x-id="SBLGNT.LUK.23.45.008" x-align="LUK.23.45.a007" x-target-ids="t008 t009" x-target="of the" x-target-head="t009" x-head="tr