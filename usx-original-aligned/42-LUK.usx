	<para style="p"><verse number="13" style="v" x-ref="LUK.22.13" sid="LUK 22:13" /><char style="w" x-id="SBLGNT.LUK.22.13.001" x-align="LUK.22.13.a001" x-target-ids="t002 t003" x-target="they went" x-target-head="t003" x-head="true" lemma="ἀπέρχομαι" strong="G565" x-morph="V-2AAP-NPM" x-gloss="Having gone" x-translit="apelthontes" xml:lang="grc">ἀπελθόντες</char> <char style="w" x-id="SBLGNT.LUK.22.13.002" x-align="LUK.22.13.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.13.003" x-align="LUK.22.13.a003" x-target-ids="t004 t005" x-target="and found" x-target-head="t005" x-head="true" lemma="εὑρίσκω" strong="G2147" x-morph="V-2AAI-3P" x-gloss="they found [it]" x-translit="heuron" xml:lang="grc">εὗρον</char> <char style="w" x-id="SBLGNT.LUK.22.13.004" x-align="LUK.22.13.a004" x-target-ids="t006" x-target="as" x-target-head="t006" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="as" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.LUK.22.13.005" x-align="LUK.22.13.a005" x-target-ids="t007 t008 t009" x-target="he had said" x-target-head="t009" x-head="true" lemma="λέγω" strong="G2046" x-morph="V-LAI-3S-ATT" x-gloss="He had said" x-translit="eirēkei" xml:lang="grc">εἰρήκει</char> <char style="w" x-id="SBLGNT.LUK.22.13.006" x-align="LUK.22.13.a006" x-target-ids="t010 t011" x-target="unto them" x-target-head="t011" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>,<char style="w" x-id="SBLGNT.LUK.22.13.007" x-align="LUK.22.13.a007" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.13.008" x-align="LUK.22.13.a008" x-target-ids="t013 t014 t015" x-t