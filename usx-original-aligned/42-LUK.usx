	<para style="p"><verse number="6" style="v" x-ref="LUK.14.6" sid="LUK 14:6" /><char style="w" x-id="SBLGNT.LUK.14.6.001" x-align="LUK.14.6.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.14.6.002" x-align="LUK.14.6.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.LUK.14.6.003" x-align="LUK.14.6.a003" x-target-ids="t002 t003" x-target="they could" x-target-head="t003" x-head="true" lemma="ἰσχύω" strong="G2480" x-morph="V-AAI-3P" x-gloss="they were able" x-translit="ischysan" xml:lang="grc">ἴσχυσαν</char> <char style="w" x-id="SBLGNT.LUK.14.6.004" x-align="LUK.14.6.a004" x-target-ids="t005 t006" x-target="answer again" x-target-head="t005" x-head="true" lemma="ἀνταποκρίνομαι" strong="G470" x-morph="V-AON" x-gloss="to reply" x-translit="antapokrithēnai" xml:lang="grc">ἀνταποκριθῆναι</char> <char style="w" x-id="SBLGNT.LUK.14.6.005" x-align="LUK.14.6.a005" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.LUK.14.6.006" x-align="LUK.14.6.a006" x-target-ids="t008 t009" x-target="these things" x-target-head="t008" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="these things" x-translit="tauta" xml:lang="grc">ταῦτα</char>.<verse eid="LUK 14:6" /></para>
