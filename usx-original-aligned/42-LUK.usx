	<para style="p"><verse number="12" style="v" x-ref="LUK.22.12" sid="LUK 22:12" /><char style="w" x-id="SBLGNT.LUK.22.12.001" x-align="LUK.22.12.a001" x-target-ids="t001 t002" x-target="And he" x-target-head="t002" x-head="true" lemma="κἀκεῖνος" strong="G2548" x-morph="D-NSM-K" x-gloss="And he" x-translit="kakeinos" xml:lang="grc">κἀκεῖνος</char> <char style="w" x-id="SBLGNT.LUK.22.12.002" x-align="LUK.22.12.a002" x-target-ids="t005" x-target="you" x-target-head="t005" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.LUK.22.12.003" x-align="LUK.22.12.a003" x-target-ids="t003 t004" x-target="will show" x-target-head="t004" x-head="true" lemma="δείκνυμι" strong="G1166" x-morph="V-FAI-3S" x-gloss="will show" x-translit="deixei" xml:lang="grc">δείξει</char> <char style="w" x-id="SBLGNT.LUK.22.12.004" x-align="LUK.22.12.a004" x-target-ids="t006 t008 t009" x-target="a upper room" x-target-head="t009" x-head="true" lemma="ἀνάγαιον" strong="G508" x-morph="N-ASN" x-gloss="an upper room" x-translit="anagaion" xml:lang="grc">ἀνάγαιον</char> <char style="w" x-id="SBLGNT.LUK.22.12.005" x-align="LUK.22.12.a005" x-target-ids="t007" x-target="large" x-target-head="t007" x-head="true" lemma="μέγας" strong="G3173" x-morph="A-ASN" x-gloss="large" x-translit="mega" xml:lang="grc">μέγα</char> <char style="w" x-id="SBLGNT.LUK.22.12.006" x-align="LUK.22.12.a006" x-target-ids="t010" x-target="furnished" x-target-head="t010" x-head="true" lemma="στρώννυμι" strong="G4766" x-morph="V-RPP-ASN" x-gloss="furnished" x-translit="estrōmenon" xml:lang="grc">ἐστρωμένον</char>·<char style="w" x-id="SBLGNT.LUK.22.12.007" x-align="LUK.22.12.a007" x-target-ids="t011" x-target="there" x-target-head="t011" x-head="true" lemma="ἐκεῖ" strong="G1563" x-morph="ADV" x-gloss="there" x-translit="ekei" xml:lang="grc">ἐκεῖ</char> <char style="w" x-id="SBLGNT.LUK.22.12.008" x-align="LUK.22.12.a008" x-target-ids="t012 t013