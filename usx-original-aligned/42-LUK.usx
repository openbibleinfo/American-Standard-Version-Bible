	<para style="p"><verse number="6" style="v" x-ref="LUK.3.6" sid="LUK 3:6" /><char style="w" x-id="SBLGNT.LUK.3.6.001" x-align="LUK.3.6.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.3.6.002" x-align="LUK.3.6.a004" x-target-ids="t004 t005" x-target="shall see" x-target-head="t005" x-head="true" lemma="ὁράω" strong="G3708" x-morph="V-FDI-3S" x-gloss="will see" x-translit="opsetai" xml:lang="grc">ὄψεται</char> <char style="w" x-id="SBLGNT.LUK.3.6.003" x-align="LUK.3.6.a002" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NSF" x-gloss="all" x-translit="pasa" xml:lang="grc">πᾶσα</char> <char style="w" x-id="SBLGNT.LUK.3.6.004" x-align="LUK.3.6.a003" x-target-ids="t003" x-target="flesh" x-target-head="t003" x-head="true" lemma="σάρξ" strong="G4561" x-morph="N-NSF" x-gloss="flesh" x-translit="sarx" xml:lang="grc">σὰρξ</char> <char style="w" x-id="SBLGNT.LUK.3.6.005" x-align="LUK.3.6.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.3.6.006" x-align="LUK.3.6.a006" x-target-ids="t007" x-target="salvation" x-target-head="t007" x-head="true" lemma="σωτήριος" strong="G4992" x-morph="A-ASN" x-gloss="salvation" x-translit="sōtērion" xml:lang="grc">σωτήριον</char> <char style="w" x-id="SBLGNT.LUK.3.6.007" x-align="LUK.3.6.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="-" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.3.6.008" x-align="LUK.3.6.a008" x-target-ids="t008 t009" x-target="of God" x-target-head="t009" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char>.<vers