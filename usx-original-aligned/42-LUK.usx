	<para style="p"><verse number="30" style="v" x-ref="LUK.6.30" sid="LUK 6:30" /><char style="w" x-id="SBLGNT.LUK.6.30.001" x-align="LUK.6.30.a001" x-target-ids="t002 t003 t004" x-target="to every one" x-target-head="t003" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-DSM" x-gloss="To everyone" x-translit="panti" xml:lang="grc">παντὶ</char> <char style="w" x-id="SBLGNT.LUK.6.30.002" x-align="LUK.6.30.a002" x-target-ids="t005 t006" x-target="that asketh" x-target-head="t006" x-head="true" lemma="αἰτέω" strong="G154" x-morph="V-PAP-DSM" x-gloss="asking" x-translit="aitounti" xml:lang="grc">αἰτοῦντί</char> <char style="w" x-id="SBLGNT.LUK.6.30.003" x-align="LUK.6.30.a003" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.LUK.6.30.004" x-align="LUK.6.30.a004" x-target-ids="t001" x-target="Give" x-target-head="t001" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-PAM-2S" x-gloss="give" x-translit="didou" xml:lang="grc">δίδου</char>,<char style="w" x-id="SBLGNT.LUK.6.30.005" x-align="LUK.6.30.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.6.30.006" x-align="LUK.6.30.a006" x-target-ids="t009" x-target="of" x-target-head="t009" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="apo" xml:lang="grc">ἀπὸ</char> <char style="w" x-id="SBLGNT.LUK.6.30.007" x-align="LUK.6.30.a007" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="the [one]" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.6.30.008" x-align="LUK.6.30.a008" x-target-ids="t011 t012 t013" x-target="that taketh away" x-target-head="t012" x-head="true" lemma="αἴρω" strong="G142" x