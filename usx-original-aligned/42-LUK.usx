	<para style="p"><verse number="32" style="v" x-ref="LUK.23.32" sid="LUK 23:32" /><char style="w" x-id="SBLGNT.LUK.23.32.001" x-align="LUK.23.32.a002" x-target-ids="t002 t003 t008" x-target="there were led" x-target-head="t008" x-head="true" lemma="ἄγω" strong="G71" x-morph="V-IPI-3P" x-gloss="Were being led away" x-translit="Ēgonto" xml:lang="grc">Ἤγοντο</char> <char style="w" x-id="SBLGNT.LUK.23.32.002" x-align="LUK.23.32.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.23.32.003" x-align="LUK.23.32.a003" x-target-ids="t004" x-target="also" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.23.32.004" x-align="LUK.23.32.a005" x-target-ids="t006" x-target="others" x-target-head="t006" x-head="true" lemma="ἕτερος" strong="G2087" x-morph="A-NPM" x-gloss="other" x-translit="heteroi" xml:lang="grc">ἕτεροι</char> <char style="w" x-id="SBLGNT.LUK.23.32.005" x-align="LUK.23.32.a006" x-target-ids="t007" x-target="malefactors" x-target-head="t007" x-head="true" lemma="κακοῦργος" strong="G2557" x-morph="A-NPM" x-gloss="criminals" x-translit="kakourgoi" xml:lang="grc">κακοῦργοι</char> <char style="w" x-id="SBLGNT.LUK.23.32.006" x-align="LUK.23.32.a004" x-target-ids="t005" x-target="two" x-target-head="t005" x-head="true" lemma="δύο" strong="G1417" x-morph="A-NUI" x-gloss="two" x-translit="dyo" xml:lang="grc">δύο</char> <char style="w" x-id="SBLGNT.LUK.23.32.007" x-align="LUK.23.32.a007" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="σύν" strong="G4862" x-morph="PREP" x-gloss="with" x-translit="syn" xml:lang="grc">σὺν</char> <char style="w" x-id="SBLGNT.LUK.23.32.008" x-align="LUK.23.32.a008" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="αὐτός" str