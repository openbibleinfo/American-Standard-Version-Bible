	<para style="p"><verse number="27" style="v" x-ref="LUK.19.27" sid="LUK 19:27" /><char style="w" x-id="SBLGNT.LUK.19.27.001" x-align="LUK.19.27.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="πλήν" strong="G4133" x-morph="ADV" x-gloss="Furthermore" x-translit="plēn" xml:lang="grc">πλὴν</char> <char style="w" x-id="SBLGNT.LUK.19.27.002" x-align="LUK.19.27.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="the" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.LUK.19.27.003" x-align="LUK.19.27.a005" x-target-ids="t004" x-target="enemies" x-target-head="t004" x-head="true" lemma="ἐχθρός" strong="G2190" x-morph="A-APM" x-gloss="enemies" x-translit="echthrous" xml:lang="grc">ἐχθρούς</char> <char style="w" x-id="SBLGNT.LUK.19.27.004" x-align="LUK.19.27.a003" x-target-ids="t003" x-target="mine" x-target-head="t003" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="of mine" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.LUK.19.27.005" x-align="LUK.19.27.a002" x-target-ids="t002" x-target="these" x-target-head="t002" x-head="true" lemma="οὗτος" strong="G5128" x-morph="D-APM" x-gloss="these" x-translit="toutous" xml:lang="grc">τούτους</char> <char style="w" x-id="SBLGNT.LUK.19.27.006" x-align="LUK.19.27.a006" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="those" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.LUK.19.27.007" x-align="LUK.19.27.a008" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.19.27.008" x-align="LUK.19.27.a007" x-target-ids="t005 t006" x-target="that would" x-target-head="t006" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-AAP-APM" x-gloss="having been willing [for]" x-translit="thelēsantas"