	<para style="p"><verse number="21" style="v" x-ref="LUK.19.21" sid="LUK 19:21" /><char style="w" x-id="SBLGNT.LUK.19.21.001" x-align="LUK.19.21.a002" x-target-ids="t002 t003" x-target="I feared" x-target-head="t003" x-head="true" lemma="φοβέομαι" strong="G5399" x-morph="V-INI-1S" x-gloss="I was afraid" x-translit="ephoboumēn" xml:lang="grc">ἐφοβούμην</char> <char style="w" x-id="SBLGNT.LUK.19.21.002" x-align="LUK.19.21.a001" x-target-ids="t001" x-target="for" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γάρ</char> <char style="w" x-id="SBLGNT.LUK.19.21.003" x-align="LUK.19.21.a003" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="of you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.LUK.19.21.004" x-align="LUK.19.21.a004" x-target-ids="t005" x-target="because" x-target-head="t005" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="because" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.LUK.19.21.005" x-align="LUK.19.21.a007" x-target-ids="t008 t010" x-target="an man" x-target-head="t010" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-NSM" x-gloss="a man" x-translit="anthrōpos" xml:lang="grc">ἄνθρωπος</char> <char style="w" x-id="SBLGNT.LUK.19.21.006" x-align="LUK.19.21.a006" x-target-ids="t009" x-target="austere" x-target-head="t009" x-head="true" lemma="αὐστηρός" strong="G840" x-morph="A-NSM" x-gloss="harsh" x-translit="austēros" xml:lang="grc">αὐστηρὸς</char> <char style="w" x-id="SBLGNT.LUK.19.21.007" x-align="LUK.19.21.a005" x-target-ids="t006 t007" x-target="thou art" x-target-head="t007" x-head="true" lemma="εἰμί" strong="G1488" x-morph="V-PAI-2S" x-gloss="you are" x-translit="ei" xml:lang="grc">εἶ</char>,<char style="w" x-id="SBLGNT.LUK.19.21.008" x-align="LUK.19.21.a008" x-target-ids="t011 t012 t013" x-target="thou takest up" x-target-he