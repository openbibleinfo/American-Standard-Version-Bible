	<para style="p"><verse number="16" style="v" x-ref="LUK.5.16" sid="LUK 5:16" /><char style="w" x-id="SBLGNT.LUK.5.16.001" x-align="LUK.5.16.a001" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NSM" x-gloss="He Himself" x-translit="autos" xml:lang="grc">αὐτὸς</char> <char style="w" x-id="SBLGNT.LUK.5.16.002" x-align="LUK.5.16.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.5.16.003" x-align="LUK.5.16.a003" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.LUK.5.16.004" x-align="LUK.5.16.a003" x-target-ids="t003 t004" x-target="withdrew himself" x-target-head="t003" x-head="true" lemma="ὑποχωρέω" strong="G5298" x-morph="V-PAP-NSM" x-gloss="withdrawing" x-translit="hypochōrōn" xml:lang="grc">ὑποχωρῶν</char> <char style="w" x-id="SBLGNT.LUK.5.16.005" x-align="LUK.5.16.a004" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="into" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.5.16.006" x-align="LUK.5.16.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPF" x-gloss="the" x-translit="tais" xml:lang="grc">ταῖς</char> <char style="w" x-id="SBLGNT.LUK.5.16.007" x-align="LUK.5.16.a006" x-target-ids="t007" x-target="deserts" x-target-head="t007" x-head="true" lemma="ἔρημος" strong="G2048" x-morph="A-DPF" x-gloss="wilderness" x-translit="erēmois" xml:lang="grc">ἐρήμοις</char> <char style="w" x-id="SBLGNT.LUK.5.16.008" x-align="LUK.5.16.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id=