28" x-morph="PRT" x-gloss="or" x-translit="ē" xml:lang="grc">ἢ</char> <char style="w" x-id="SBLGNT.LUK.16.13.017" x-align="LUK.16.13.a017" x-target-ids="t023 t024" x-target="to one" x-target-head="t024" x-head="true" lemma="εἷς" strong="G1520" x-morph="A-GSM" x-gloss="one" x-translit="henos" xml:lang="grc">ἑνὸς</char> <char style="w" x-id="SBLGNT.LUK.16.13.018" x-align="LUK.16.13.a018" x-target-ids="t020 t021 t022" x-target="he will hold" x-target-head="t022" x-head="true" lemma="ἀντέχομαι" strong="G472" x-morph="V-FDI-3S" x-gloss="he will be devoted to" x-translit="anthexetai" xml:lang="grc">ἀνθέξεται</char> <char style="w" x-id="SBLGNT.LUK.16.13.019" x-align="LUK.16.13.a019" x-target-ids="t025" x-target="and" x-target-head="t025" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.16.13.020" x-align="LUK.16.13.a020" x-target-ids="t027" x-target="the" x-target-head="t027" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="the" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.LUK.16.13.021" x-align="LUK.16.13.a021" x-target-ids="t028" x-target="other" x-target-head="t028" x-head="true" lemma="ἕτερος" strong="G2087" x-morph="A-GSM" x-gloss="other" x-translit="heterou" xml:lang="grc">ἑτέρου</char> <char style="w" x-id="SBLGNT.LUK.16.13.022" x-align="LUK.16.13.a022" x-target-ids="t026" x-target="despise" x-target-head="t026" x-head="true" lemma="καταφρονέω" strong="G2706" x-morph="V-FAI-3S" x-gloss="he will despise" x-translit="kataphronēsei" xml:lang="grc">καταφρονήσει</char>.<char style="w" x-id="SBLGNT.LUK.16.13.023" x-align="LUK.16.13.a023" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="Not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.LUK.16.13.024" x-align="LUK.16.13.a023" x-target-ids="t029 t030" x-target="Ye cannot" x-target-head="t030" x-head="true" lemma="δύναμαι" strong="G1410" x-morph="V-PNI-2P" x-glo