	<para style="p"><verse number="18" style="v" x-ref="LUK.21.18" sid="LUK 21:18" /><char style="w" x-id="SBLGNT.LUK.21.18.001" x-align="LUK.21.18.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="But" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.21.18.002" x-align="LUK.21.18.a003" x-target-ids="t003 t004" x-target="a hair" x-target-head="t004" x-head="true" lemma="θρίξ" strong="G2359" x-morph="N-NSF" x-gloss="a hair" x-translit="thrix" xml:lang="grc">θρὶξ</char> <char style="w" x-id="SBLGNT.LUK.21.18.003" x-align="LUK.21.18.a004" x-target-ids="t005" x-target="of" x-target-head="t005" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="of" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.LUK.21.18.004" x-align="LUK.21.18.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.LUK.21.18.005" x-align="LUK.21.18.a007" x-target-ids="t007" x-target="head" x-target-head="t007" x-head="true" lemma="κεφαλή" strong="G2776" x-morph="N-GSF" x-gloss="head" x-translit="kephalēs" xml:lang="grc">κεφαλῆς</char> <char style="w" x-id="SBLGNT.LUK.21.18.006" x-align="LUK.21.18.a006" x-target-ids="t006" x-target="your" x-target-head="t006" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="of you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char> <char style="w" x-id="SBLGNT.LUK.21.18.007" x-align="LUK.21.18.a002" x-status="noncompositional" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="no" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.LUK.21.18.008" x-align="LUK.21.18.a002" x-status="noncompositional" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK