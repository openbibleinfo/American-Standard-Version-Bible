	<para style="p"><verse number="2" style="v" x-ref="LUK.20.2" sid="LUK 20:2" /><char style="w" x-id="SBLGNT.LUK.20.2.001" x-align="LUK.20.2.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.20.2.002" x-align="LUK.20.2.a002" x-target-ids="t002 t003" x-target="they spake" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3P" x-gloss="spoke" x-translit="eipan" xml:lang="grc">εἶπαν</char> <char style="w" x-id="SBLGNT.LUK.20.2.003" x-align="LUK.20.2.a003" x-target-ids="t004" x-target="saying" x-target-head="t004" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NPM" x-gloss="saying" x-translit="legontes" xml:lang="grc">λέγοντες</char> <char style="w" x-id="SBLGNT.LUK.20.2.004" x-align="LUK.20.2.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.LUK.20.2.005" x-align="LUK.20.2.a005" x-target-ids="t006" x-target="him" x-target-head="t006" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτόν</char>·<char style="w" x-id="SBLGNT.LUK.20.2.006" x-align="LUK.20.2.a006" x-target-ids="t007" x-target="Tell" x-target-head="t007" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAM-2S" x-gloss="Tell" x-translit="Eipon" xml:lang="grc">Εἰπὸν</char> <char style="w" x-id="SBLGNT.LUK.20.2.007" x-align="LUK.20.2.a007" x-target-ids="t008" x-target="us" x-target-head="t008" x-head="true" lemma="ἐγώ" strong="G2254" x-morph="P-1DP" x-gloss="us" x-translit="hēmin" xml:lang="grc">ἡμῖν</char> <char style="w" x-id="SBLGNT.LUK.20.2.008" x-align="LUK.20.2.a008" x-target-ids="t009" x-target="By" x-target-head="t009" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="by" x-translit