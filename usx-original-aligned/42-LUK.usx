	<para style="p"><verse number="50" style="v" x-ref="LUK.8.50" sid="LUK 8:50" /><char style="w" x-id="SBLGNT.LUK.8.50.001" x-align="LUK.8.50.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.8.50.002" x-align="LUK.8.50.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="But" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.8.50.003" x-align="LUK.8.50.a003" x-target-ids="t002" x-target="Jesus" x-target-head="t002" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.LUK.8.50.004" x-align="LUK.8.50.a004" x-target-ids="t003 t004" x-target="hearing it" x-target-head="t003" x-head="true" lemma="ἀκούω" strong="G191" x-morph="V-AAP-NSM" x-gloss="having heard" x-translit="akousas" xml:lang="grc">ἀκούσας</char> <char style="w" x-id="SBLGNT.LUK.8.50.005" x-align="LUK.8.50.a005" x-target-ids="t005" x-target="answered" x-target-head="t005" x-head="true" lemma="ἀποκρίνομαι" strong="G611" x-morph="V-ADI-3S" x-gloss="answered" x-translit="apekrithē" xml:lang="grc">ἀπεκρίθη</char> <char style="w" x-id="SBLGNT.LUK.8.50.006" x-align="LUK.8.50.a006" x-target-ids="t006" x-target="him" x-target-head="t006" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.8.50.007" x-align="LUK.8.50.a008" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="Not" x-translit="Mē" xml:lang="grc">Μὴ</char> <char style="w" x-id="SBLGNT.LUK.8.50.008" x-align="LUK.8.50.a007" x-target-ids="t007" x-target="Fear" x-target-head="t007" x-head="true" lemma="φοβέομαι" strong="G5399" x-morph="V-PNM-2S" x-gloss="fear" x-translit="phobou" 