	<para style="p"><verse number="43" style="v" x-ref="LUK.23.43" sid="LUK 23:43" /><char style="w" x-id="SBLGNT.LUK.23.43.001" x-align="LUK.23.43.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.23.43.002" x-align="LUK.23.43.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.23.43.003" x-align="LUK.23.43.a003" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.23.43.004" x-align="LUK.23.43.a004" x-target-ids="t006" x-target="Verily" x-target-head="t006" x-head="true" lemma="ἀμήν" strong="G281" x-morph="HEB" x-gloss="Truly" x-translit="Amēn" xml:lang="grc">Ἀμήν</char> <char style="w" x-id="SBLGNT.LUK.23.43.005" x-align="LUK.23.43.a006" x-target-ids="t009 t010" x-target="unto thee" x-target-head="t010" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="to you" x-translit="soi" xml:lang="grc">σοι</char> <char style="w" x-id="SBLGNT.LUK.23.43.006" x-align="LUK.23.43.a005" x-target-ids="t007 t008" x-target="I say" x-target-head="t008" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.LUK.23.43.007" x-align="LUK.23.43.a007" x-target-ids="t011 t012" x-target="To day" x-target-head="t012" x-head="true" lemma="σήμερον" strong="G4594" x-morph="ADV" x-gloss="today" x-translit="sēmeron" xml:lang="grc">σήμερον</char> <char style="w" x-id="SBLGNT.LUK.23.43.008" x-align="LUK.23.43.a009" x-target-ids="t016" x-target="with" x-target-head="t016" x-head="true" lemma="μετά" s