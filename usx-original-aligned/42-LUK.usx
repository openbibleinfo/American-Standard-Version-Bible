	<para style="p"><verse number="3" style="v" x-ref="LUK.20.3" sid="LUK 20:3" /><char style="w" x-id="SBLGNT.LUK.20.3.001" x-align="LUK.20.3.a001" x-target-ids="t002 t003" x-target="he answered" x-target-head="t003" x-head="true" lemma="ἀποκρίνομαι" strong="G611" x-morph="V-AOP-NSM" x-gloss="Answering" x-translit="apokritheis" xml:lang="grc">ἀποκριθεὶς</char> <char style="w" x-id="SBLGNT.LUK.20.3.002" x-align="LUK.20.3.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.20.3.003" x-align="LUK.20.3.a003" x-target-ids="t004 t005" x-target="and said" x-target-head="t005" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.20.3.004" x-align="LUK.20.3.a004" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.LUK.20.3.005" x-align="LUK.20.3.a005" x-target-ids="t007" x-target="them" x-target-head="t007" x-head="true" lemma="ἑαυτοῦ" strong="G848" x-morph="P-APM" x-gloss="them" x-translit="autous" xml:lang="grc">αὐτούς</char>·<char style="w" x-id="SBLGNT.LUK.20.3.006" x-align="LUK.20.3.a006" x-target-ids="t010 t011" x-target="will ask" x-target-head="t011" x-head="true" lemma="ἐρωτάω" strong="G2065" x-morph="V-FAI-1S" x-gloss="Will ask" x-translit="Erōtēsō" xml:lang="grc">Ἐρωτήσω</char> <char style="w" x-id="SBLGNT.LUK.20.3.007" x-align="LUK.20.3.a007" x-target-ids="t012" x-target="you" x-target-head="t012" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.LUK.20.3.008" x-align="LUK.20.3.a008" x-target-ids="t008 t009" x-target="I also" x-target-head="t008" x-head="true" lemma="κἀγ