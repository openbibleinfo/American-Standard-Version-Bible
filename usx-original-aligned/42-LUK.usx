	<para style="p"><verse number="64" style="v" x-ref="LUK.22.64" sid="LUK 22:64" /><char style="w" x-id="SBLGNT.LUK.22.64.001" x-align="LUK.22.64.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.64.002" x-align="LUK.22.64.a002" x-target-ids="t002 t003" x-target="they blindfolded" x-target-head="t003" x-head="true" lemma="περικαλύπτω" strong="G4028" x-morph="V-AAP-NPM" x-gloss="having blindfolded" x-translit="perikalypsantes" xml:lang="grc">περικαλύψαντες</char> <char style="w" x-id="SBLGNT.LUK.22.64.003" x-align="LUK.22.64.a003" x-target-ids="t004" x-target="him" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτὸν</char> <char style="w" x-id="SBLGNT.LUK.22.64.004" x-align="LUK.22.64.a004" x-target-ids="t005 t006 t007" x-target="and asked him" x-target-head="t006" x-head="true" lemma="ἐπερωτάω" strong="G1905" x-morph="V-IAI-3P" x-gloss="they were questioning [Him]" x-translit="epērōtōn" xml:lang="grc">ἐπηρώτων</char> <char style="w" x-id="SBLGNT.LUK.22.64.005" x-align="LUK.22.64.a005" x-target-ids="t008" x-target="saying" x-target-head="t008" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NPM" x-gloss="saying" x-translit="legontes" xml:lang="grc">λέγοντες</char>·<char style="w" x-id="SBLGNT.LUK.22.64.006" x-align="LUK.22.64.a006" x-target-ids="t009" x-target="Prophesy" x-target-head="t009" x-head="true" lemma="προφητεύω" strong="G4395" x-morph="V-AAM-2S" x-gloss="Prophesy" x-translit="Prophēteuson" xml:lang="grc">Προφήτευσον</char>,<char style="w" x-id="SBLGNT.LUK.22.64.007" x-align="LUK.22.64.a007" x-target-ids="t010" x-target="who" x-target-head="t010" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSM" x-gloss="who" x-translit="tis" xml:lang="grc">τίς</char> <char style="w" x-id="SBLGNT.LUK.22.64.008" x-align="L