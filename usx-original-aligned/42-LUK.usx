	<para style="p"><verse number="9" style="v" x-ref="LUK.22.9" sid="LUK 22:9" /><char style="w" x-id="SBLGNT.LUK.22.9.001" x-align="LUK.22.9.a001" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="-" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.22.9.002" x-align="LUK.22.9.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.9.003" x-align="LUK.22.9.a003" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3P" x-gloss="they said" x-translit="eipan" xml:lang="grc">εἶπαν</char> <char style="w" x-id="SBLGNT.LUK.22.9.004" x-align="LUK.22.9.a004" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to Him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.22.9.005" x-align="LUK.22.9.a005" x-target-ids="t006" x-target="Where" x-target-head="t006" x-head="true" lemma="ποῦ" strong="G4226" x-morph="ADV-I" x-gloss="Where" x-translit="Pou" xml:lang="grc">Ποῦ</char> <char style="w" x-id="SBLGNT.LUK.22.9.006" x-align="LUK.22.9.a006" x-target-ids="t007 t008" x-target="wilt thou" x-target-head="t007" x-head="true" lemma="θέλω" strong="G2309" x-morph="V-PAI-2S" x-gloss="will You" x-translit="theleis" xml:lang="grc">θέλεις</char> <char style="w" x-id="SBLGNT.LUK.22.9.007" x-align="LUK.22.9.a007" x-target-ids="t009 t010 t011 t012" x-target="that we make ready" x-target-head="t012" x-head="true" lemma="ἑτοιμάζω" strong="G2090" x-morph="V-AAS-1P" x-gloss="we should prepare" x-translit="hetoimasōmen" xml:lang="grc">ἑτοιμάσωμεν</char>;<verse eid="LUK 22:9" /></para>
