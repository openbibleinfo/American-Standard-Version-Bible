042" x-head="true" lemma="πτωχός" strong="G4434" x-morph="A-NPM" x-gloss="poor" x-translit="ptōchoi" xml:lang="grc">πτωχοὶ</char> <char style="w" x-id="SBLGNT.LUK.7.22.023" x-align="LUK.7.22.a024" x-target-ids="t043 t044 t045 t046 t047 t048" x-target="have good tidings preached to them" x-target-head="t045" x-head="true" lemma="εὐαγγελίζω" strong="G2097" x-morph="V-PPI-3P" x-gloss="are gospelized" x-translit="euangelizontai" xml:lang="grc">εὐαγγελίζονται</char>·<verse eid="LUK 7:22" /></para>
	<para style="p"><verse number="23" style="v" x-ref="LUK.7.23" sid="LUK 7:23" /><char style="w" x-id="SBLGNT.LUK.7.23.001" x-align="LUK.7.23.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.7.23.002" x-align="LUK.7.23.a002" x-target-ids="t002" x-target="blessed" x-target-head="t002" x-head="true" lemma="μακάριος" strong="G3107" x-morph="A-NSM" x-gloss="blessed" x-translit="makarios" xml:lang="grc">μακάριός</char> <char style="w" x-id="SBLGNT.LUK.7.23.003" x-align="LUK.7.23.a003" x-target-ids="t003" x-target="is" x-target-head="t003" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="is" x-translit="estin" xml:lang="grc">ἐστιν</char> <char style="w" x-id="SBLGNT.LUK.7.23.004" x-align="LUK.7.23.a004" x-target-ids="t004 t005" x-target="he whosoever" x-target-head="t005" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-NSM" x-gloss="who" x-translit="hos" xml:lang="grc">ὃς</char> <char style="w" x-id="SBLGNT.LUK.7.23.005" x-align="LUK.7.23.a004" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.LUK.7.23.006" x-align="LUK.7.23.a005" x-target-ids="t008" x-target="no" x-target-head="t008" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.7.23.007" x-align="LUK.7.23.a006" x-target-ids="t006 t007 t009 t010 t011" x-target="shall find occasion of stumbling" x-target-head="t011" x-head="true" lemma="σκανδαλίζω" strong="G4624" x-morph="V-APS-3S" x-gloss="shall be offended" x-translit="skandalisthēi" xml:lang="grc">σκανδαλισθῇ</char> <char style="w" x-id="SBLGNT.LUK.7.23.008" x-align="LUK.7.23.a007" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" 