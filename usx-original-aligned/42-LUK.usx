	<para style="p"><verse number="33" style="v" x-ref="LUK.1.33" sid="LUK 1:33" /><char style="w" x-id="SBLGNT.LUK.1.33.001" x-align="LUK.1.33.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.1.33.002" x-align="LUK.1.33.a002" x-target-ids="t002 t003 t004" x-target="he shall reign" x-target-head="t004" x-head="true" lemma="βασιλεύω" strong="G936" x-morph="V-FAI-3S" x-gloss="He will reign" x-translit="basileusei" xml:lang="grc">βασιλεύσει</char> <char style="w" x-id="SBLGNT.LUK.1.33.003" x-align="LUK.1.33.a003" x-target-ids="t005" x-target="over" x-target-head="t005" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="over" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.LUK.1.33.004" x-align="LUK.1.33.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.LUK.1.33.005" x-align="LUK.1.33.a005" x-target-ids="t007" x-target="house" x-target-head="t007" x-head="true" lemma="οἶκος" strong="G3624" x-morph="N-ASM" x-gloss="house" x-translit="oikon" xml:lang="grc">οἶκον</char> <char style="w" x-id="SBLGNT.LUK.1.33.006" x-align="LUK.1.33.a006" x-target-ids="t008 t009" x-target="of Jacob" x-target-head="t009" x-head="true" lemma="Ἰακώβ" strong="G2384" x-morph="N-PRI" x-gloss="of Jacob" x-translit="Iakōb" xml:lang="grc">Ἰακὼβ</char> <char style="w" x-id="SBLGNT.LUK.1.33.007" x-align="LUK.1.33.a007" x-target-ids="t010" x-target="for" x-target-head="t010" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.1.33.008" x-align="LUK.1.33.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="the" x-translit="tous" xml