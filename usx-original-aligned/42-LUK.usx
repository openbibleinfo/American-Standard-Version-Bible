	<para style="p"><verse number="8" style="v" x-ref="LUK.22.8" sid="LUK 22:8" /><char style="w" x-id="SBLGNT.LUK.22.8.001" x-align="LUK.22.8.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.8.002" x-align="LUK.22.8.a002" x-target-ids="t002 t003" x-target="he sent" x-target-head="t003" x-head="true" lemma="ἀποστέλλω" strong="G649" x-morph="V-AAI-3S" x-gloss="He sent" x-translit="apesteilen" xml:lang="grc">ἀπέστειλεν</char> <char style="w" x-id="SBLGNT.LUK.22.8.003" x-align="LUK.22.8.a003" x-target-ids="t004" x-target="Peter" x-target-head="t004" x-head="true" lemma="Πέτρος" strong="G4074" x-morph="N-ASM" x-gloss="Peter" x-translit="Petron" xml:lang="grc">Πέτρον</char> <char style="w" x-id="SBLGNT.LUK.22.8.004" x-align="LUK.22.8.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.8.005" x-align="LUK.22.8.a005" x-target-ids="t006" x-target="John" x-target-head="t006" x-head="true" lemma="Ἰωάννης" strong="G2491" x-morph="N-ASM" x-gloss="John" x-translit="Iōannēn" xml:lang="grc">Ἰωάννην</char> <char style="w" x-id="SBLGNT.LUK.22.8.006" x-align="LUK.22.8.a006" x-target-ids="t007" x-target="saying" x-target-head="t007" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAP-NSM" x-gloss="having said" x-translit="eipōn" xml:lang="grc">εἰπών</char>·<char style="w" x-id="SBLGNT.LUK.22.8.007" x-align="LUK.22.8.a007" x-target-ids="t008" x-target="Go" x-target-head="t008" x-head="true" lemma="πορεύομαι" strong="G4198" x-morph="V-AOP-NPM" x-gloss="Having gone" x-translit="Poreuthentes" xml:lang="grc">Πορευθέντες</char> <char style="w" x-id="SBLGNT.LUK.22.8.008" x-align="LUK.22.8.a008" x-target-ids="t009 t010 t011" x-target="and make ready" x-target-head="t011" x-h