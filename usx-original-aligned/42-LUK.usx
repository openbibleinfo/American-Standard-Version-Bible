	<para style="p"><verse number="14" style="v" x-ref="LUK.22.14" sid="LUK 22:14" /><char style="w" x-id="SBLGNT.LUK.22.14.001" x-align="LUK.22.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.14.002" x-align="LUK.22.14.a002" x-target-ids="t002" x-target="when" x-target-head="t002" x-head="true" lemma="ὅτε" strong="G3753" x-morph="ADV" x-gloss="when" x-translit="hote" xml:lang="grc">ὅτε</char> <char style="w" x-id="SBLGNT.LUK.22.14.003" x-align="LUK.22.14.a003" x-target-ids="t005 t006" x-target="was come" x-target-head="t006" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2ADI-3S" x-gloss="was come" x-translit="egeneto" xml:lang="grc">ἐγένετο</char> <char style="w" x-id="SBLGNT.LUK.22.14.004" x-align="LUK.22.14.a004" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.LUK.22.14.005" x-align="LUK.22.14.a005" x-target-ids="t004" x-target="hour" x-target-head="t004" x-head="true" lemma="ὥρα" strong="G5610" x-morph="N-NSF" x-gloss="hour" x-translit="hōra" xml:lang="grc">ὥρα</char>,<char style="w" x-id="SBLGNT.LUK.22.14.006" x-align="LUK.22.14.a006" x-target-ids="t007 t008 t009" x-target="he sat down" x-target-head="t008" x-head="true" lemma="ἀναπίπτω" strong="G377" x-morph="V-2AAI-3S" x-gloss="He reclined" x-translit="anepesen" xml:lang="grc">ἀνέπεσεν</char> <char style="w" x-id="SBLGNT.LUK.22.14.007" x-align="LUK.22.14.a007" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.14.008" x-align="LUK.22.14.a008" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="