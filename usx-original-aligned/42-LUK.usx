	<para style="p"><verse number="24" style="v" x-ref="LUK.19.24" sid="LUK 19:24" /><char style="w" x-id="SBLGNT.LUK.19.24.001" x-align="LUK.19.24.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.24.002" x-align="LUK.19.24.a003" x-target-ids="t004 t005" x-target="unto them" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM" x-gloss="to those" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.LUK.19.24.003" x-align="LUK.19.24.a004" x-target-ids="t006 t007 t008" x-target="that stood by" x-target-head="t007" x-head="true" lemma="παρίστημι" strong="G3936" x-morph="V-RAP-DPM" x-gloss="standing by" x-translit="parestōsin" xml:lang="grc">παρεστῶσιν</char> <char style="w" x-id="SBLGNT.LUK.19.24.004" x-align="LUK.19.24.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="he said" x-translit="eipen" xml:lang="grc">εἶπεν</char>·<char style="w" x-id="SBLGNT.LUK.19.24.005" x-align="LUK.19.24.a005" x-target-ids="t009 t010" x-target="Take away" x-target-head="t009" x-head="true" lemma="αἴρω" strong="G142" x-morph="V-AAM-2P" x-gloss="Take" x-translit="Arate" xml:lang="grc">Ἄρατε</char> <char style="w" x-id="SBLGNT.LUK.19.24.006" x-align="LUK.19.24.a006" x-target-ids="t011" x-target="from" x-target-head="t011" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="ap" xml:lang="grc">ἀπ</char>ʼ<char style="w" x-id="SBLGNT.LUK.19.24.007" x-align="LUK.19.24.a007" x-target-ids="t012" x-target="him" x-target-head="t012" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.LUK.19.24.008" x-align="LUK.19.24.a008" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="t