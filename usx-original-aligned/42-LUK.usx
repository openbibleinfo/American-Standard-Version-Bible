	<para style="p"><verse number="48" style="v" x-ref="LUK.22.48" sid="LUK 22:48" /><char style="w" x-id="SBLGNT.LUK.22.48.001" x-align="LUK.22.48.a001" x-target-ids="t002" x-target="Jesus" x-target-head="t002" x-head="true" lemma="Ἰησοῦς" strong="G2424" x-morph="N-NSM" x-gloss="Jesus" x-translit="Iēsous" xml:lang="grc">Ἰησοῦς</char> <char style="w" x-id="SBLGNT.LUK.22.48.002" x-align="LUK.22.48.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.48.003" x-align="LUK.22.48.a003" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.22.48.004" x-align="LUK.22.48.a004" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.22.48.005" x-align="LUK.22.48.a005" x-target-ids="t006" x-target="Judas" x-target-head="t006" x-head="true" lemma="Ἰούδας" strong="G2455" x-morph="N-VSM" x-gloss="Judas" x-translit="Iouda" xml:lang="grc">Ἰούδα</char>,<char style="w" x-id="SBLGNT.LUK.22.48.006" x-align="LUK.22.48.a006" x-target-ids="t013 t014 t015" x-target="with a kiss" x-target-head="t015" x-head="true" lemma="φίλημα" strong="G5370" x-morph="N-DSN" x-gloss="with a kiss" x-translit="philēmati" xml:lang="grc">φιλήματι</char> <char style="w" x-id="SBLGNT.LUK.22.48.007" x-align="LUK.22.48.a007" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.LUK.22.48.008" x-align="LUK.22.48.a008" x-target-ids="t010" x-target="Son" x-target-head="t010" x-head="true" lemma="υἱός" strong