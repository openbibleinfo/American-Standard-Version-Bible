	<para style="p"><verse number="12" style="v" x-ref="LUK.12.12" sid="LUK 12:12" /><char style="w" x-id="SBLGNT.LUK.12.12.001" x-align="LUK.12.12.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.12.12.002" x-align="LUK.12.12.a001" x-target-ids="t001" x-target="for" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.LUK.12.12.003" x-align="LUK.12.12.a003" x-target-ids="t003" x-target="Holy" x-target-head="t003" x-head="true" lemma="ἅγιος" strong="G40" x-morph="A-NSN" x-gloss="Holy" x-translit="hagion" xml:lang="grc">ἅγιον</char> <char style="w" x-id="SBLGNT.LUK.12.12.004" x-align="LUK.12.12.a004" x-target-ids="t004" x-target="Spirit" x-target-head="t004" x-head="true" lemma="πνεῦμα" strong="G4151" x-morph="N-NSN" x-gloss="Spirit" x-translit="pneuma" xml:lang="grc">πνεῦμα</char> <char style="w" x-id="SBLGNT.LUK.12.12.005" x-align="LUK.12.12.a005" x-target-ids="t005 t006" x-target="shall teach" x-target-head="t006" x-head="true" lemma="διδάσκω" strong="G1321" x-morph="V-FAI-3S" x-gloss="will teach" x-translit="didaxei" xml:lang="grc">διδάξει</char> <char style="w" x-id="SBLGNT.LUK.12.12.006" x-align="LUK.12.12.a006" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.LUK.12.12.007" x-align="LUK.12.12.a007" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.LUK.12.12.008" x-align="LUK.12.12.a009" x-target-ids="t010" x-target="very" x-target-head="t010" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSF" x-gloss="same