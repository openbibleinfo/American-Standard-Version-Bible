	<para style="p"><verse number="8" style="v" x-ref="LUK.17.8" sid="LUK 17:8" /><char style="w" x-id="SBLGNT.LUK.17.8.001" x-align="LUK.17.8.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.LUK.17.8.002" x-align="LUK.17.8.a003" x-target-ids="t003 t004" x-target="not rather" x-target-head="t003" x-head="true" lemma="οὐχί" strong="G3780" x-morph="PRT-I" x-gloss="not" x-translit="ouchi" xml:lang="grc">οὐχὶ</char> <char style="w" x-id="SBLGNT.LUK.17.8.003" x-align="LUK.17.8.a002" x-target-ids="t002 t005" x-target="will say" x-target-head="t005" x-head="true" lemma="λέγω" strong="G2046" x-morph="V-FAI-3S" x-gloss="will he say" x-translit="erei" xml:lang="grc">ἐρεῖ</char> <char style="w" x-id="SBLGNT.LUK.17.8.004" x-align="LUK.17.8.a004" x-target-ids="t006 t007" x-target="unto him" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.17.8.005" x-align="LUK.17.8.a005" x-target-ids="t008 t009" x-target="Make ready" x-target-head="t009" x-head="true" lemma="ἑτοιμάζω" strong="G2090" x-morph="V-AAM-2S" x-gloss="Prepare" x-translit="Hetoimason" xml:lang="grc">Ἑτοίμασον</char> <char style="w" x-id="SBLGNT.LUK.17.8.006" x-align="LUK.17.8.a006" x-target-ids="t010" x-target="wherewith" x-target-head="t010" x-head="true" lemma="τίς" strong="G5101" x-morph="I-ASN" x-gloss="what" x-translit="ti" xml:lang="grc">τί</char> <char style="w" x-id="SBLGNT.LUK.17.8.007" x-align="LUK.17.8.a007" x-target-ids="t011 t012 t013" x-target="I may sup" x-target-head="t013" x-head="true" lemma="δειπνέω" strong="G1172" x-morph="V-AAS-1S" x-gloss="I may eat" x-translit="deipnēsō" xml:lang="grc">δειπνήσω</char> <char style="w" x-id="SBLGNT.LUK.17.8.008" x-align="LUK.17.8.a008" x-target-ids="t014" x-target="and" x-target-head="t014" x-