	<para style="p"><verse number="23" style="v" x-ref="LUK.12.23" sid="LUK 12:23" /><char style="w" x-id="SBLGNT.LUK.12.23.001" x-align="LUK.12.23.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="The" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.LUK.12.23.002" x-align="LUK.12.23.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.LUK.12.23.003" x-align="LUK.12.23.a003" x-target-ids="t003" x-target="life" x-target-head="t003" x-head="true" lemma="ψυχή" strong="G5590" x-morph="N-NSF" x-gloss="life" x-translit="psychē" xml:lang="grc">ψυχὴ</char> <char style="w" x-id="SBLGNT.LUK.12.23.004" x-align="LUK.12.23.a005" x-target-ids="t005" x-target="more" x-target-head="t005" x-head="true" lemma="πολύς" strong="G4119" x-morph="A-NSN-C" x-gloss="more than" x-translit="pleion" xml:lang="grc">πλεῖόν</char> <char style="w" x-id="SBLGNT.LUK.12.23.005" x-align="LUK.12.23.a004" x-target-ids="t004" x-target="is" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="is" x-translit="estin" xml:lang="grc">ἐστιν</char> <char style="w" x-id="SBLGNT.LUK.12.23.006" x-align="LUK.12.23.a006" x-target-ids="t006 t007" x-target="than the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.LUK.12.23.007" x-align="LUK.12.23.a007" x-target-ids="t008" x-target="food" x-target-head="t008" x-head="true" lemma="τροφή" strong="G5160" x-morph="N-GSF" x-gloss="food" x-translit="trophēs" xml:lang="grc">τροφῆς</char> <char style="w" x-id="SBLGNT.LUK.12.23.008" x-align="LUK.12.23.a008" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-trans