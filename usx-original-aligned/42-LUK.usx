	<para style="p"><verse number="28" style="v" x-ref="LUK.6.28" sid="LUK 6:28" /><char style="w" x-id="SBLGNT.LUK.6.28.001" x-align="LUK.6.28.a001" x-target-ids="t001" x-target="bless" x-target-head="t001" x-head="true" lemma="εὐλογέω" strong="G2127" x-morph="V-PAM-2P" x-gloss="bless" x-translit="eulogeite" xml:lang="grc">εὐλογεῖτε</char> <char style="w" x-id="SBLGNT.LUK.6.28.002" x-align="LUK.6.28.a002" x-target-ids="t002" x-target="them" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="those" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.LUK.6.28.003" x-align="LUK.6.28.a003" x-target-ids="t003 t004" x-target="that curse" x-target-head="t004" x-head="true" lemma="καταράομαι" strong="G2672" x-morph="V-PNP-APM" x-gloss="cursing" x-translit="katarōmenous" xml:lang="grc">καταρωμένους</char> <char style="w" x-id="SBLGNT.LUK.6.28.004" x-align="LUK.6.28.a004" x-target-ids="t005" x-target="you" x-target-head="t005" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char>,<char style="w" x-id="SBLGNT.LUK.6.28.005" x-align="LUK.6.28.a005" x-target-ids="t006" x-target="pray" x-target-head="t006" x-head="true" lemma="προσεύχομαι" strong="G4336" x-morph="V-PNM-2P" x-gloss="pray" x-translit="proseuchesthe" xml:lang="grc">προσεύχεσθε</char> <char style="w" x-id="SBLGNT.LUK.6.28.006" x-align="LUK.6.28.a006" x-target-ids="t007" x-target="for" x-target-head="t007" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="for" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.LUK.6.28.007" x-align="LUK.6.28.a007" x-target-ids="t008" x-target="them" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="those" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.LUK.6.28.008" x-align="LUK.6.28.a008" x-target-ids="t009 t010 t011" x-target="that despitefully use" x-target-head="t010" x-h