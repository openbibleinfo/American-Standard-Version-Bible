	<para style="p"><verse number="2" style="v" x-ref="LUK.14.2" sid="LUK 14:2" /><char style="w" x-id="SBLGNT.LUK.14.2.001" x-align="LUK.14.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.14.2.002" x-align="LUK.14.2.a002" x-target-ids="t002" x-target="behold" x-target-head="t002" x-head="true" lemma="ἰδού" strong="G2400" x-morph="V-2AMM-2S" x-gloss="behold" x-translit="idou" xml:lang="grc">ἰδοὺ</char> <char style="w" x-id="SBLGNT.LUK.14.2.003" x-align="LUK.14.2.a003" x-target-ids="t007 t009" x-target="a man" x-target-head="t009" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-NSM" x-gloss="a man" x-translit="anthrōpos" xml:lang="grc">ἄνθρωπός</char> <char style="w" x-id="SBLGNT.LUK.14.2.004" x-align="LUK.14.2.a004" x-target-ids="t008" x-target="certain" x-target-head="t008" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="certain" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.LUK.14.2.005" x-align="LUK.14.2.a005" x-target-ids="t003 t004" x-target="there was" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="there was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.LUK.14.2.006" x-align="LUK.14.2.a006" x-target-ids="t010 t011 t012 t013" x-target="that had the dropsy" x-target-head="t013" x-head="true" lemma="ὑδρωπικός" strong="G5203" x-morph="A-NSM" x-gloss="with dropsy" x-translit="hydrōpikos" xml:lang="grc">ὑδρωπικὸς</char> <char style="w" x-id="SBLGNT.LUK.14.2.007" x-align="LUK.14.2.a007" x-target-ids="t005" x-target="before" x-target-head="t005" x-head="true" lemma="ἔμπροσθεν" strong="G1715" x-morph="PREP" x-gloss="before" x-translit="emprosthen" xml:lang="grc">ἔμπροσθεν</char> <char style="w" x-id="SBLGNT.LUK.14.2.008" x-align="LUK.14.2.a008" x-target-ids="t006" x-target="him" x-target-head="