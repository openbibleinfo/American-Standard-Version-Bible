	<para style="p"><verse number="9" style="v" x-ref="LUK.17.9" sid="LUK 17:9" /><char style="w" x-id="SBLGNT.LUK.17.9.001" x-align="LUK.17.9.a001" x-status="unrepresented" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="Not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.17.9.002" x-align="LUK.17.9.a002" lemma="ἔχω" strong="G2192" x-morph="V-PAI-3S" x-gloss="is he" x-translit="echei" xml:lang="grc">ἔχει</char> <char style="w" x-id="SBLGNT.LUK.17.9.003" x-align="LUK.17.9.a002" x-target-ids="t001 t002 t003" x-target="Doth he thank" x-target-head="t003" x-head="true" lemma="χάρις" strong="G5485" x-morph="N-ASF" x-gloss="thankful" x-translit="charin" xml:lang="grc">χάριν</char> <char style="w" x-id="SBLGNT.LUK.17.9.004" x-align="LUK.17.9.a003" x-target-ids="t004" x-target="the" x-target-head="t004" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="to the" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.LUK.17.9.005" x-align="LUK.17.9.a004" x-target-ids="t005" x-target="servant" x-target-head="t005" x-head="true" lemma="δοῦλος" strong="G1401" x-morph="N-DSM" x-gloss="servant" x-translit="doulōi" xml:lang="grc">δούλῳ</char> <char style="w" x-id="SBLGNT.LUK.17.9.006" x-align="LUK.17.9.a005" x-target-ids="t006" x-target="because" x-target-head="t006" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="because" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.LUK.17.9.007" x-align="LUK.17.9.a006" x-target-ids="t007 t008" x-target="he did" x-target-head="t008" x-head="true" lemma="ποιέω" strong="G4160" x-morph="V-AAI-3S" x-gloss="he did" x-translit="epoiēsen" xml:lang="grc">ἐποίησεν</char> <char style="w" x-id="SBLGNT.LUK.17.9.008" x-align="LUK.17.9.a007" x-target-ids="t009 t010" x-target="the things" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-gloss="the things" x-translit="ta" xml:lang="grc">τὰ</char> <char style="w" x-id="SB