	<para style="p"><verse number="25" style="v" x-ref="LUK.19.25" sid="LUK 19:25" /><char style="w" x-id="SBLGNT.LUK.19.25.001" x-align="LUK.19.25.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.25.002" x-align="LUK.19.25.a002" x-target-ids="t002 t003" x-target="they said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3P" x-gloss="they said" x-translit="eipan" xml:lang="grc">εἶπαν</char> <char style="w" x-id="SBLGNT.LUK.19.25.003" x-align="LUK.19.25.a003" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.19.25.004" x-align="LUK.19.25.a004" x-target-ids="t006" x-target="Lord" x-target-head="t006" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-VSM" x-gloss="Master" x-translit="Kyrie" xml:lang="grc">Κύριε</char>,<char style="w" x-id="SBLGNT.LUK.19.25.005" x-align="LUK.19.25.a005" x-target-ids="t007 t008" x-target="he hath" x-target-head="t008" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAI-3S" x-gloss="he has" x-translit="echei" xml:lang="grc">ἔχει</char> <char style="w" x-id="SBLGNT.LUK.19.25.006" x-align="LUK.19.25.a006" x-target-ids="t009" x-target="ten" x-target-head="t009" x-head="true" lemma="δέκα" strong="G1176" x-morph="A-NUI" x-gloss="ten" x-translit="deka" xml:lang="grc">δέκα</char> <char style="w" x-id="SBLGNT.LUK.19.25.007" x-align="LUK.19.25.a007" x-target-ids="t010" x-target="pounds" x-target-head="t010" x-head="true" lemma="μνᾶ" strong="G3414" x-morph="N-APF" x-gloss="minas" x-translit="mnas" xml:lang="grc">μνᾶς</char> <verse eid="LUK 19:25" /></para>
	<para style="p"><verse number="26" style="v" x-ref="LUK.19.26" sid="LUK 19:26" /><char style="w" x-id="SBLGNT.LUK.19.26.001" x-align="LUK.19.26.a001" x-target-ids="t001 t002" x-target="I say" x-target-head="t002" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.LUK.19.26.002" x-align="LUK.19.26.a002" x-target-ids="t003 t004" x-target="unto you" x-target-head="t004" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.LUK.19.26.003" x-align="LUK.19.26.a003" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.LUK.19.26.004" x-align="LUK.19.26.a004" x-target-ids="t006 t007" x-target="unto every" x-target-head="t007" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-DSM" x-gloss="to everyone" x-translit="panti" xml:lang="grc">παντὶ</char> <char style="w" x-id="SBLGNT.LUK.19.26.005" x-align="LUK.19.26.a005" x-target-ids="t008" x-target="one" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="-" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.LUK.19.26.006" x-align="LUK.19.26.a006" x-target-ids="t009 t010" x-target="that hath" x-target-head="t010" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAP-DSM" x-gloss="having" x-translit="echonti" xml:lang="grc">ἔχοντι</char> <char style="w" x-id="SBLGNT.LUK.19.26.007" x-align="LUK.19.26.a007" x-target-ids="t011 t012 t013" x-target="shall be given" x-target-head="t013" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-FPI-3S" x-gloss="will be given" x-translit="dothēsetai" xml:lang="grc">δοθήσεται</char>,<char style="w" x-id="SBLGNT.LUK.19.26.008" x-align="LUK.19.26.a009" x-target-ids="t015" x-target="from" x-target-head=