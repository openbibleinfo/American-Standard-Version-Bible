	<para style="p"><verse number="25" style="v" x-ref="LUK.22.25" sid="LUK 22:25" /><char style="w" x-id="SBLGNT.LUK.22.25.001" x-align="LUK.22.25.a001" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.22.25.002" x-align="LUK.22.25.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.25.003" x-align="LUK.22.25.a003" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.22.25.004" x-align="LUK.22.25.a004" x-target-ids="t004 t005" x-target="unto them" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.LUK.22.25.005" x-align="LUK.22.25.a005" x-target-ids="t006" x-target="The" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="The" x-translit="Hoi" xml:lang="grc">Οἱ</char> <char style="w" x-id="SBLGNT.LUK.22.25.006" x-align="LUK.22.25.a006" x-target-ids="t007" x-target="kings" x-target-head="t007" x-head="true" lemma="βασιλεύς" strong="G935" x-morph="N-NPM" x-gloss="kings" x-translit="basileis" xml:lang="grc">βασιλεῖς</char> <char style="w" x-id="SBLGNT.LUK.22.25.007" x-align="LUK.22.25.a007" x-target-ids="t008 t009" x-target="of the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPN" x-gloss="of the" x-translit="tōn" xml:lang="grc">τῶν</char> <char style="w" x-id="SBLGNT.LUK.22.25.008" x-align="LUK.22.25.a008" x-target-ids="t010" x-target="Gentiles" x-target-head="t010" x-head="true" lemma="ἔθνος" strong="G1484" x-morph="N-GPN" x-gloss=