	<para style="p"><verse number="31" style="v" x-ref="LUK.19.31" sid="LUK 19:31" /><char style="w" x-id="SBLGNT.LUK.19.31.001" x-align="LUK.19.31.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.31.002" x-align="LUK.19.31.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐάν</char> <char style="w" x-id="SBLGNT.LUK.19.31.003" x-align="LUK.19.31.a003" x-target-ids="t003 t004" x-target="any one" x-target-head="t003" x-head="true" lemma="τις" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τις</char> <char style="w" x-id="SBLGNT.LUK.19.31.004" x-align="LUK.19.31.a005" x-target-ids="t006" x-target="you" x-target-head="t006" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.LUK.19.31.005" x-align="LUK.19.31.a004" x-target-ids="t005" x-target="ask" x-target-head="t005" x-head="true" lemma="ἐρωτάω" strong="G2065" x-morph="V-PAS-3S" x-gloss="asks" x-translit="erōtai" xml:lang="grc">ἐρωτᾷ</char>·<char style="w" x-id="SBLGNT.LUK.19.31.006" x-align="LUK.19.31.a006" x-status="noncompositional" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="Because of" x-translit="Dia" xml:lang="grc">Διὰ</char> <char style="w" x-id="SBLGNT.LUK.19.31.007" x-align="LUK.19.31.a006" x-status="noncompositional" x-target-ids="t007" x-target="Why" x-target-head="t007" x-head="true" lemma="τίς" strong="G5101" x-morph="I-ASN" x-gloss="why" x-translit="ti" xml:lang="grc">τί</char> <char style="w" x-id="SBLGNT.LUK.19.31.008" x-align="LUK.19.31.a007" x-target-ids="t008 t009 t010 t011" x-target="do ye loose him" x-target-head="t010" x-head="true" lemma="λύω" strong="G3089" x-morph="V-PAI-2P" x-gloss="do you untie