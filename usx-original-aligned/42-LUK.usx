	<para style="p"><verse number="49" style="v" x-ref="LUK.12.49" sid="LUK 12:49" /><char style="w" x-id="SBLGNT.LUK.12.49.001" x-align="LUK.12.49.a003" x-target-ids="t005" x-target="fire" x-target-head="t005" x-head="true" lemma="πῦρ" strong="G4442" x-morph="N-ASN" x-gloss="Fire" x-translit="Pyr" xml:lang="grc">Πῦρ</char> <char style="w" x-id="SBLGNT.LUK.12.49.002" x-align="LUK.12.49.a001" x-target-ids="t001 t002" x-target="I came" x-target-head="t002" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAI-1S" x-gloss="I came" x-translit="ēlthon" xml:lang="grc">ἦλθον</char> <char style="w" x-id="SBLGNT.LUK.12.49.003" x-align="LUK.12.49.a002" x-target-ids="t003 t004" x-target="to cast" x-target-head="t004" x-head="true" lemma="βάλλω" strong="G906" x-morph="V-2AAN" x-gloss="to cast" x-translit="balein" xml:lang="grc">βαλεῖν</char> <char style="w" x-id="SBLGNT.LUK.12.49.004" x-align="LUK.12.49.a004" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="upon" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.LUK.12.49.005" x-align="LUK.12.49.a005" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASF" x-gloss="the" x-translit="tēn" xml:lang="grc">τὴν</char> <char style="w" x-id="SBLGNT.LUK.12.49.006" x-align="LUK.12.49.a006" x-target-ids="t008" x-target="earth" x-target-head="t008" x-head="true" lemma="γῆ" strong="G1093" x-morph="N-ASF" x-gloss="earth" x-translit="gēn" xml:lang="grc">γῆν</char>,<char style="w" x-id="SBLGNT.LUK.12.49.007" x-align="LUK.12.49.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.12.49.008" x-align="LUK.12.49.a008" x-target-ids="t010" x-target="what" x-target-head="t010" x-head="true" lemma="τίς" strong="G5101" x-morph="I-ASN" x-gloss="how" 