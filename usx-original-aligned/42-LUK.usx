	<para style="p"><verse number="43" style="v" x-ref="LUK.22.43" sid="LUK 22:43" /><char style="w" x-id="SBLGNT.LUK.22.43.001" x-align="LUK.22.43.a001" x-target-ids="t002 t003" x-target="there appeared" x-target-head="t003" x-head="true" lemma="ὁράω" strong="G3708" x-morph="V-API-3S" x-gloss="Appeared" x-translit="ōphthē" xml:lang="grc">ὤφθη</char> <char style="w" x-id="SBLGNT.LUK.22.43.002" x-align="LUK.22.43.a002" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.43.003" x-align="LUK.22.43.a003" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to Him" x-translit="autōi" xml:lang="grc">αὐτῷ</char> <char style="w" x-id="SBLGNT.LUK.22.43.004" x-align="LUK.22.43.a004" x-target-ids="t006 t007" x-target="an angel" x-target-head="t007" x-head="true" lemma="ἄγγελος" strong="G32" x-morph="N-NSM" x-gloss="an angel" x-translit="angelos" xml:lang="grc">ἄγγελος</char> <char style="w" x-id="SBLGNT.LUK.22.43.005" x-align="LUK.22.43.a005" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="ap" xml:lang="grc">ἀπ</char>ʼ<char style="w" x-id="SBLGNT.LUK.22.43.006" x-align="LUK.22.43.a006" x-target-ids="t009" x-target="heaven" x-target-head="t009" x-head="true" lemma="οὐρανός" strong="G3772" x-morph="N-GSM" x-gloss="heaven" x-translit="ouranou" xml:lang="grc">οὐρανοῦ</char> <char style="w" x-id="SBLGNT.LUK.22.43.007" x-align="LUK.22.43.a007" x-target-ids="t010" x-target="strengthening" x-target-head="t010" x-head="true" lemma="ἐνισχύω" strong="G1765" x-morph="V-PAP-NSM" x-gloss="strengthening" x-translit="enischyōn" xml:lang="grc">ἐνισχύων</char> <char style="w" x-id="SBLGNT.LUK.22.43.008" x-align="LUK.22.43.a008" x-target-ids="t011" x-target="him" x-target-head="t01