	<para style="p"><verse number="59" style="v" x-ref="LUK.12.59" sid="LUK 12:59" /><char style="w" x-id="SBLGNT.LUK.12.59.001" x-align="LUK.12.59.a001" x-target-ids="t001 t002" x-target="I say" x-target-head="t002" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.LUK.12.59.002" x-align="LUK.12.59.a002" x-target-ids="t003 t004" x-target="unto thee" x-target-head="t004" x-head="true" lemma="σύ" strong="G4671" x-morph="P-2DS" x-gloss="to you" x-translit="soi" xml:lang="grc">σοι</char>,<char style="w" x-id="SBLGNT.LUK.12.59.003" x-align="LUK.12.59.a003" x-status="noncompositional" x-target-ids="t007 t008 t009" x-target="by no means" x-target-head="t008" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="no" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.LUK.12.59.004" x-align="LUK.12.59.a003" x-status="noncompositional" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.12.59.005" x-align="LUK.12.59.a004" x-target-ids="t005 t006 t010 t011" x-target="Thou shalt come out" x-target-head="t010" x-head="true" lemma="ἐξέρχομαι" strong="G1831" x-morph="V-2AAS-2S" x-gloss="shall you come out" x-translit="exelthēis" xml:lang="grc">ἐξέλθῃς</char> <char style="w" x-id="SBLGNT.LUK.12.59.006" x-align="LUK.12.59.a005" x-target-ids="t012" x-target="thence" x-target-head="t012" x-head="true" lemma="ἐκεῖθεν" strong="G1564" x-morph="ADV" x-gloss="from there" x-translit="ekeithen" xml:lang="grc">ἐκεῖθεν</char> <char style="w" x-id="SBLGNT.LUK.12.59.007" x-align="LUK.12.59.a006" x-target-ids="t013" x-target="till" x-target-head="t013" x-head="true" lemma="ἕως" strong="G2193" x-morph="ADV" x-gloss="until" x-translit="heōs" xml:lang="grc">ἕως</char> <char style="w" x-id="SBLGNT.LUK.12.59.008" x-align="LUK.12.59.a009" x-target-ids="t018" x-target="very" x-target-head="t018" x-hea