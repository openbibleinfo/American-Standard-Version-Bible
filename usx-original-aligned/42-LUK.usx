	<para style="p"><verse number="11" style="v" x-ref="LUK.22.11" sid="LUK 22:11" /><char style="w" x-id="SBLGNT.LUK.22.11.001" x-align="LUK.22.11.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.11.002" x-align="LUK.22.11.a002" x-target-ids="t002 t003 t004" x-target="ye shall say" x-target-head="t004" x-head="true" lemma="λέγω" strong="G2046" x-morph="V-FAI-2P" x-gloss="you shall say" x-translit="ereite" xml:lang="grc">ἐρεῖτε</char> <char style="w" x-id="SBLGNT.LUK.22.11.003" x-align="LUK.22.11.a003" x-target-ids="t005 t006" x-target="unto the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="to the" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.LUK.22.11.004" x-align="LUK.22.11.a004" x-target-ids="t007" x-target="master" x-target-head="t007" x-head="true" lemma="οἰκοδεσπότης" strong="G3617" x-morph="N-DSM" x-gloss="master" x-translit="oikodespotēi" xml:lang="grc">οἰκοδεσπότῃ</char> <char style="w" x-id="SBLGNT.LUK.22.11.005" x-align="LUK.22.11.a005" x-target-ids="t008 t009" x-target="of the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="of the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.LUK.22.11.006" x-align="LUK.22.11.a006" x-target-ids="t010" x-target="house" x-target-head="t010" x-head="true" lemma="οἰκία" strong="G3614" x-morph="N-GSF" x-gloss="house" x-translit="oikias" xml:lang="grc">οἰκίας</char>·<char style="w" x-id="SBLGNT.LUK.22.11.007" x-align="LUK.22.11.a007" x-target-ids="t013" x-target="saith" x-target-head="t013" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-3S" x-gloss="Says" x-translit="Legei" xml:lang="grc">Λέγει</char> <char style="w" x-id="SBLGNT.LUK.22.11.008" x-align="LUK.22.11.a008" x-target-ids="t014 t015" x-target="unto thee" x-target-head="t01