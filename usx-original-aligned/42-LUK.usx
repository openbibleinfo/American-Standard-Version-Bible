	<para style="p"><verse number="44" style="v" x-ref="LUK.23.44" sid="LUK 23:44" /><char style="w" x-id="SBLGNT.LUK.23.44.001" x-align="LUK.23.44.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="Kai" xml:lang="grc">Καὶ</char> <char style="w" x-id="SBLGNT.LUK.23.44.002" x-align="LUK.23.44.a002" x-target-ids="t002 t003" x-target="it was" x-target-head="t003" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="it was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.LUK.23.44.003" x-align="LUK.23.44.a003" x-target-ids="t004" x-target="now" x-target-head="t004" x-head="true" lemma="ἤδη" strong="G2235" x-morph="ADV" x-gloss="now" x-translit="ēdē" xml:lang="grc">ἤδη</char> <char style="w" x-id="SBLGNT.LUK.23.44.004" x-align="LUK.23.44.a004" x-target-ids="t005" x-target="about" x-target-head="t005" x-head="true" lemma="ὡσεί" strong="G5616" x-morph="ADV" x-gloss="about" x-translit="hōsei" xml:lang="grc">ὡσεὶ</char> <char style="w" x-id="SBLGNT.LUK.23.44.005" x-align="LUK.23.44.a005" x-target-ids="t006 t008" x-target="the hour" x-target-head="t008" x-head="true" lemma="ὥρα" strong="G5610" x-morph="N-NSF" x-gloss="[the] hour" x-translit="hōra" xml:lang="grc">ὥρα</char> <char style="w" x-id="SBLGNT.LUK.23.44.006" x-align="LUK.23.44.a006" x-target-ids="t007" x-target="sixth" x-target-head="t007" x-head="true" lemma="ἕκτος" strong="G1623" x-morph="A-NSF" x-gloss="sixth" x-translit="hektē" xml:lang="grc">ἕκτη</char> <char style="w" x-id="SBLGNT.LUK.23.44.007" x-align="LUK.23.44.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.23.44.008" x-align="LUK.23.44.a008" x-target-ids="t010 t011" x-target="a darkness" x-target-head="t011" x-head="true" lemma="σκότος" strong="G4655" x-morph="N-NSN" x-glos