	<para style="p"><verse number="15" style="v" x-ref="LUK.16.15" sid="LUK 16:15" /><char style="w" x-id="SBLGNT.LUK.16.15.001" x-align="LUK.16.15.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.16.15.002" x-align="LUK.16.15.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.16.15.003" x-align="LUK.16.15.a003" x-target-ids="t004 t005" x-target="unto them" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.LUK.16.15.004" x-align="LUK.16.15.a004" x-target-ids="t006" x-target="Ye" x-target-head="t006" x-head="true" lemma="σύ" strong="G5210" x-morph="P-2NP" x-gloss="You" x-translit="Hymeis" xml:lang="grc">Ὑμεῖς</char> <char style="w" x-id="SBLGNT.LUK.16.15.005" x-align="LUK.16.15.a005" x-target-ids="t007" x-target="are" x-target-head="t007" x-head="true" lemma="εἰμί" strong="G2075" x-morph="V-PAI-2P" x-gloss="are" x-translit="este" xml:lang="grc">ἐστε</char> <char style="w" x-id="SBLGNT.LUK.16.15.006" x-align="LUK.16.15.a006" x-target-ids="t008" x-target="they" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.16.15.007" x-align="LUK.16.15.a007" x-target-ids="t009 t010" x-target="that justify" x-target-head="t010" x-head="true" lemma="δικαιόω" strong="G1344" x-morph="V-PAP-NPM" x-gloss="justifying" x-translit="dikaiountes" xml:lang="grc">δικαιοῦντες</char> <char style="w" x-id="SBLGNT.LUK.16.15.008" x-align="LUK.16.15.a008" x-target-ids="t011" x-target="yourselves" x-target-head="t011" x-head="true" le