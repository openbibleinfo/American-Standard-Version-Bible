	<para style="p"><verse number="16" style="v" x-ref="LUK.21.16" sid="LUK 21:16" /><char style="w" x-id="SBLGNT.LUK.21.16.001" x-align="LUK.21.16.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="ye shall be delivered up" x-target-head="t005" x-head="true" lemma="παραδίδωμι" strong="G3860" x-morph="V-FPI-2P" x-gloss="You will be betrayed" x-translit="paradothēsesthe" xml:lang="grc">παραδοθήσεσθε</char> <char style="w" x-id="SBLGNT.LUK.21.16.002" x-align="LUK.21.16.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.21.16.003" x-align="LUK.21.16.a003" x-target-ids="t007" x-target="even" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="even" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.21.16.004" x-align="LUK.21.16.a004" x-target-ids="t008" x-target="by" x-target-head="t008" x-head="true" lemma="ὑπό" strong="G5259" x-morph="PREP" x-gloss="by" x-translit="hypo" xml:lang="grc">ὑπὸ</char> <char style="w" x-id="SBLGNT.LUK.21.16.005" x-align="LUK.21.16.a005" x-target-ids="t009" x-target="parents" x-target-head="t009" x-head="true" lemma="γονεύς" strong="G1118" x-morph="N-GPM" x-gloss="parents" x-translit="goneōn" xml:lang="grc">γονέων</char> <char style="w" x-id="SBLGNT.LUK.21.16.006" x-align="LUK.21.16.a006" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.21.16.007" x-align="LUK.21.16.a007" x-target-ids="t011" x-target="brethren" x-target-head="t011" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-GPM" x-gloss="brothers" x-translit="adelphōn" xml:lang="grc">ἀδελφῶν</char> <char style="w" x-id="SBLGNT.LUK.21.16.008" x-align="LUK.21.16.a008" x-target-ids="t012" x-target="and" x-target-head="t01