	<para style="p"><verse number="42" style="v" x-ref="LUK.7.42" sid="LUK 7:42" /><char style="w" x-id="SBLGNT.LUK.7.42.001" x-align="LUK.7.42.a001" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="Nothing" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.7.42.002" x-align="LUK.7.42.a002" x-target-ids="t001 t003 t005" x-target="When had wherewith" x-target-italic-ids="t005" x-target-head="t003" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAP-GPM" x-gloss="having" x-translit="echontōn" xml:lang="grc">ἐχόντων</char> <char style="w" x-id="SBLGNT.LUK.7.42.003" x-align="LUK.7.42.a003" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GPM" x-gloss="they" x-translit="autōn" xml:lang="grc">αὐτῶν</char> <char style="w" x-id="SBLGNT.LUK.7.42.004" x-align="LUK.7.42.a004" x-target-ids="t006 t007" x-target="to pay" x-target-head="t007" x-head="true" lemma="ἀποδίδωμι" strong="G591" x-morph="V-2AAN" x-gloss="to pay" x-translit="apodounai" xml:lang="grc">ἀποδοῦναι</char> <char style="w" x-id="SBLGNT.LUK.7.42.005" x-align="LUK.7.42.a005" x-target-ids="t010 t011" x-target="them both" x-target-head="t011" x-head="true" lemma="ἀμφότεροι" strong="G297" x-morph="A-DPM" x-gloss="both" x-translit="amphoterois" xml:lang="grc">ἀμφοτέροις</char> <char style="w" x-id="SBLGNT.LUK.7.42.006" x-align="LUK.7.42.a006" x-target-ids="t008 t009" x-target="he forgave" x-target-head="t009" x-head="true" lemma="χαρίζομαι" strong="G5483" x-morph="V-ADI-3S" x-gloss="he forgave" x-translit="echarisato" xml:lang="grc">ἐχαρίσατο</char>.<char style="w" x-id="SBLGNT.LUK.7.42.007" x-align="LUK.7.42.a007" x-target-ids="t012" x-target="Which" x-target-head="t012" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSM" x-gloss="Which" x-translit="tis" xml:lang="grc">τίς</char> <char style="w" x-id="SBLGNT.LUK.7.42.008" x-align="LUK.7.42.a008" x-target-ids