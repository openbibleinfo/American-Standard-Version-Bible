	<para style="p"><verse number="18" style="v" x-ref="LUK.19.18" sid="LUK 19:18" /><char style="w" x-id="SBLGNT.LUK.19.18.001" x-align="LUK.19.18.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.19.18.002" x-align="LUK.19.18.a004" x-target-ids="t004" x-target="came" x-target-head="t004" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAI-3S" x-gloss="came" x-translit="ēlthen" xml:lang="grc">ἦλθεν</char> <char style="w" x-id="SBLGNT.LUK.19.18.003" x-align="LUK.19.18.a002" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.19.18.004" x-align="LUK.19.18.a003" x-target-ids="t003" x-target="second" x-target-head="t003" x-head="true" lemma="δεύτερος" strong="G1208" x-morph="A-NSM" x-gloss="second" x-translit="deuteros" xml:lang="grc">δεύτερος</char> <char style="w" x-id="SBLGNT.LUK.19.18.005" x-align="LUK.19.18.a005" x-target-ids="t005" x-target="saying" x-target-head="t005" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.LUK.19.18.006" x-align="LUK.19.18.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="The" x-translit="Hē" xml:lang="grc">Ἡ</char> <char style="w" x-id="SBLGNT.LUK.19.18.007" x-align="LUK.19.18.a008" x-target-ids="t007" x-target="pound" x-target-head="t007" x-head="true" lemma="μνᾶ" strong="G3414" x-morph="N-NSF" x-gloss="mina" x-translit="mna" xml:lang="grc">μνᾶ</char> <char style="w" x-id="SBLGNT.LUK.19.18.008" x-align="LUK.19.18.a006" x-target-ids="t006" x-target="Thy" x-target-head="t006" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="of you" x-translit="sou" xml:lang="grc">σου