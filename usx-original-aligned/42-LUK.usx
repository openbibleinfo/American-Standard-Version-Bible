	<para style="p"><verse number="50" style="v" x-ref="LUK.1.50" sid="LUK 1:50" /><char style="w" x-id="SBLGNT.LUK.1.50.001" x-align="LUK.1.50.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.1.50.002" x-align="LUK.1.50.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.1.50.003" x-align="LUK.1.50.a003" x-target-ids="t003" x-target="mercy" x-target-head="t003" x-head="true" lemma="ἔλεος" strong="G1656" x-morph="N-NSN" x-gloss="mercy" x-translit="eleos" xml:lang="grc">ἔλεος</char> <char style="w" x-id="SBLGNT.LUK.1.50.004" x-align="LUK.1.50.a004" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.LUK.1.50.005" x-align="LUK.1.50.a005" x-target-ids="t004 t005" x-target="is unto" x-target-head="t005" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="[is] to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.1.50.006" x-align="LUK.1.50.a006" x-target-ids="t006" x-target="generations" x-target-head="t006" x-head="true" lemma="γενεά" strong="G1074" x-morph="N-APF" x-gloss="generations" x-translit="geneas" xml:lang="grc">γενεὰς</char> <char style="w" x-id="SBLGNT.LUK.1.50.007" x-align="LUK.1.50.a007" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.1.50.008" x-align="LUK.1.50.a008" x-target-ids="t008" x-target="generations" x-target-head="t008" x-head="true" lemma="γενεά" strong="G1074" x-morph="N-APF" x-gloss="generations" x-translit="geneas" xml:lang="gr