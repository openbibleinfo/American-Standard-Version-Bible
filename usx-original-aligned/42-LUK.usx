	<para style="p"><verse number="65" style="v" x-ref="LUK.22.65" sid="LUK 22:65" /><char style="w" x-id="SBLGNT.LUK.22.65.001" x-align="LUK.22.65.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.65.002" x-align="LUK.22.65.a002" x-target-ids="t003 t004" x-target="other things" x-target-head="t003" x-head="true" lemma="ἕτερος" strong="G2087" x-morph="A-APN" x-gloss="other things" x-translit="hetera" xml:lang="grc">ἕτερα</char> <char style="w" x-id="SBLGNT.LUK.22.65.003" x-align="LUK.22.65.a003" x-target-ids="t002" x-target="many" x-target-head="t002" x-head="true" lemma="πολύς" strong="G4183" x-morph="A-APN" x-gloss="many" x-translit="polla" xml:lang="grc">πολλὰ</char> <char style="w" x-id="SBLGNT.LUK.22.65.004" x-align="LUK.22.65.a004" x-target-ids="t009" x-target="reviling" x-target-head="t009" x-head="true" lemma="βλασφημέω" strong="G987" x-morph="V-PAP-NPM" x-gloss="blaspheming" x-translit="blasphēmountes" xml:lang="grc">βλασφημοῦντες</char> <char style="w" x-id="SBLGNT.LUK.22.65.005" x-align="LUK.22.65.a005" x-target-ids="t005 t006" x-target="spake they" x-target-head="t005" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-IAI-3P" x-gloss="they were saying" x-translit="elegon" xml:lang="grc">ἔλεγον</char> <char style="w" x-id="SBLGNT.LUK.22.65.006" x-align="LUK.22.65.a006" x-target-ids="t007" x-target="against" x-target-head="t007" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="to" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.LUK.22.65.007" x-align="LUK.22.65.a007" x-target-ids="t008 t010" x-target="him him" x-target-head="t008" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-ASM" x-gloss="Him" x-translit="auton" xml:lang="grc">αὐτόν</char>.<verse eid="LUK 22:65" /></para>
