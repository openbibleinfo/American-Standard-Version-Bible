	<para style="p"><verse number="53" style="v" x-ref="LUK.11.53" sid="LUK 11:53" /><char style="w" x-id="SBLGNT.LUK.11.53.001" x-align="LUK.11.53.a001" x-target-ids="t001 t007 t008" x-target="And from thence" x-target-head="t008" x-head="true" lemma="κἀκεῖθεν" strong="G2547" x-morph="ADV-K" x-gloss="From there" x-translit="Kakeithen" xml:lang="grc">Κἀκεῖθεν</char> <char style="w" x-id="SBLGNT.LUK.11.53.002" x-align="LUK.11.53.a002" x-target-ids="t002 t004 t005 t006" x-target="when was come out" x-target-head="t005" x-head="true" lemma="ἐξέρχομαι" strong="G1831" x-morph="V-2AAP-GSM" x-gloss="having gone forth" x-translit="exelthontos" xml:lang="grc">ἐξελθόντος</char> <char style="w" x-id="SBLGNT.LUK.11.53.003" x-align="LUK.11.53.a003" x-target-ids="t003" x-target="he" x-target-head="t003" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.LUK.11.53.004" x-align="LUK.11.53.a009" x-target-ids="t014" x-target="began" x-target-head="t014" x-head="true" lemma="ἄρχω" strong="G756" x-morph="V-ADI-3P" x-gloss="began" x-translit="ērxanto" xml:lang="grc">ἤρξαντο</char> <char style="w" x-id="SBLGNT.LUK.11.53.005" x-align="LUK.11.53.a004" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.LUK.11.53.006" x-align="LUK.11.53.a005" x-target-ids="t010" x-target="scribes" x-target-head="t010" x-head="true" lemma="γραμματεύς" strong="G1122" x-morph="N-NPM" x-gloss="scribes" x-translit="grammateis" xml:lang="grc">γραμματεῖς</char> <char style="w" x-id="SBLGNT.LUK.11.53.007" x-align="LUK.11.53.a006" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.11.53.008" x-align="LUK.11.53.a007" x-target-ids="t