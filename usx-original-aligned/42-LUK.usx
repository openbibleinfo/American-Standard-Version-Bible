	<para style="p"><verse number="68" style="v" x-ref="LUK.22.68" sid="LUK 22:68" /><char style="w" x-id="SBLGNT.LUK.22.68.001" x-align="LUK.22.68.a001" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.LUK.22.68.002" x-align="LUK.22.68.a002" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="then" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.22.68.003" x-align="LUK.22.68.a003" x-target-ids="t003 t004 t005" x-target="I ask you" x-target-italic-ids="t005" x-target-head="t004" x-head="true" lemma="ἐρωτάω" strong="G2065" x-morph="V-AAS-1S" x-gloss="I should ask [you]" x-translit="erōtēsō" xml:lang="grc">ἐρωτήσω</char>,<char style="w" x-id="SBLGNT.LUK.22.68.004" x-align="LUK.22.68.a004" x-status="noncompositional" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="no" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.LUK.22.68.005" x-align="LUK.22.68.a004" x-status="noncompositional" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.22.68.006" x-align="LUK.22.68.a005" x-target-ids="t006 t007 t009" x-target="ye will answer" x-target-head="t009" x-head="true" lemma="ἀποκρίνομαι" strong="G611" x-morph="V-AOS-2P" x-gloss="would you answer" x-translit="apokrithēte" xml:lang="grc">ἀποκριθῆτε</char>.<verse eid="LUK 22:68" /></para>
