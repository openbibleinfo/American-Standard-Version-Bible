	<para style="p"><verse number="9" style="v" x-ref="LUK.15.9" sid="LUK 15:9" /><char style="w" x-id="SBLGNT.LUK.15.9.001" x-align="LUK.15.9.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.15.9.002" x-align="LUK.15.9.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="when she hath found it" x-target-head="t005" x-head="true" lemma="εὑρίσκω" strong="G2147" x-morph="V-2AAP-NSF" x-gloss="having found [it]" x-translit="heurousa" xml:lang="grc">εὑροῦσα</char> <char style="w" x-id="SBLGNT.LUK.15.9.003" x-align="LUK.15.9.a003" x-target-ids="t007 t008 t009" x-target="she calleth together" x-target-head="t008" x-head="true" lemma="συγκαλέω" strong="G4779" x-morph="V-PAI-3S" x-gloss="she calls together" x-translit="synkalei" xml:lang="grc">συγκαλεῖ</char> <char style="w" x-id="SBLGNT.LUK.15.9.004" x-align="LUK.15.9.a004" x-target-ids="t010" x-target="her" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APF" x-gloss="the" x-translit="tas" xml:lang="grc">τὰς</char> <char style="w" x-id="SBLGNT.LUK.15.9.005" x-align="LUK.15.9.a005" x-target-ids="t011" x-target="friends" x-target-head="t011" x-head="true" lemma="φίλος" strong="G5384" x-morph="N-APF" x-gloss="friends" x-translit="philas" xml:lang="grc">φίλας</char> <char style="w" x-id="SBLGNT.LUK.15.9.006" x-align="LUK.15.9.a006" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.15.9.007" x-align="LUK.15.9.a007" x-target-ids="t013" x-target="neighbors" x-target-head="t013" x-head="true" lemma="γείτων" strong="G1069" x-morph="N-APF" x-gloss="neighbors" x-translit="geitonas" xml:lang="grc">γείτονας</char> <char style="w" x-id="SBLGNT.LUK.15.9.008" x-align="LUK.15.9.a008" x-target-ids="t014" x-target