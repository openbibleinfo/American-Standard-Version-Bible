	<para style="p"><verse number="45" style="v" x-ref="LUK.22.45" sid="LUK 22:45" /><char style="w" x-id="SBLGNT.LUK.22.45.001" x-align="LUK.22.45.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.45.002" x-align="LUK.22.45.a002" x-target-ids="t002 t003 t004 t005" x-target="when he rose up" x-target-head="t004" x-head="true" lemma="ἀνίστημι" strong="G450" x-morph="V-2AAP-NSM" x-gloss="having risen up" x-translit="anastas" xml:lang="grc">ἀναστὰς</char> <char style="w" x-id="SBLGNT.LUK.22.45.003" x-align="LUK.22.45.a003" x-target-ids="t006" x-target="from" x-target-head="t006" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="from" x-translit="apo" xml:lang="grc">ἀπὸ</char> <char style="w" x-id="SBLGNT.LUK.22.45.004" x-align="LUK.22.45.a004" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.LUK.22.45.005" x-align="LUK.22.45.a005" x-target-ids="t008" x-target="prayer" x-target-head="t008" x-head="true" lemma="προσευχή" strong="G4335" x-morph="N-GSF" x-gloss="prayer" x-translit="proseuchēs" xml:lang="grc">προσευχῆς</char> <char style="w" x-id="SBLGNT.LUK.22.45.006" x-align="LUK.22.45.a006" x-target-ids="t009 t010" x-target="he came" x-target-head="t010" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-2AAP-NSM" x-gloss="having come" x-translit="elthōn" xml:lang="grc">ἐλθὼν</char> <char style="w" x-id="SBLGNT.LUK.22.45.007" x-align="LUK.22.45.a007" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="to" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.LUK.22.45.008" x-align="LUK.22.45.a008" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="tr