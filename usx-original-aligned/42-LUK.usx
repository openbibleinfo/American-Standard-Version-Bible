	<para style="p"><verse number="46" style="v" x-ref="LUK.24.46" sid="LUK 24:46" /><char style="w" x-id="SBLGNT.LUK.24.46.001" x-align="LUK.24.46.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.24.46.002" x-align="LUK.24.46.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-AAI-3S" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.24.46.003" x-align="LUK.24.46.a003" x-target-ids="t004 t005" x-target="unto them" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-translit="autois" xml:lang="grc">αὐτοῖς</char> <char style="w" x-id="SBLGNT.LUK.24.46.004" x-align="LUK.24.46.a004" x-status="unrepresented" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="-" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.LUK.24.46.005" x-align="LUK.24.46.a005" x-target-ids="t006" x-target="Thus" x-target-head="t006" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="Thus" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.LUK.24.46.006" x-align="LUK.24.46.a006" x-target-ids="t007 t008 t009" x-target="it is written" x-target-head="t009" x-head="true" lemma="γράφω" strong="G1125" x-morph="V-RPI-3S" x-gloss="it has been written" x-translit="gegraptai" xml:lang="grc">γέγραπται</char> <char style="w" x-id="SBLGNT.LUK.24.46.007" x-align="LUK.24.46.a007" x-target-ids="t010 t013 t014" x-target="that should suffer" x-target-head="t014" x-head="true" lemma="πάσχω" strong="G3958" x-morph="V-2AAN" x-gloss="Was to suffer" x-translit="pathein" xml:lang="grc">παθεῖν</char> <char style="w" x-id="SBLGNT.LUK.24.46.008" x-align="LUK.24.46.a008" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM"