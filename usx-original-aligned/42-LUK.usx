	<para style="p"><verse number="30" style="v" x-ref="LUK.21.30" sid="LUK 21:30" /><char style="w" x-id="SBLGNT.LUK.21.30.001" x-align="LUK.21.30.a001" x-target-ids="t001" x-target="when" x-target-head="t001" x-head="true" lemma="ὅταν" strong="G3752" x-morph="CONJ" x-gloss="When" x-translit="hotan" xml:lang="grc">ὅταν</char> <char style="w" x-id="SBLGNT.LUK.21.30.002" x-align="LUK.21.30.a002" x-target-ids="t002 t004 t005" x-target="they shoot forth" x-target-head="t004" x-head="true" lemma="προβάλλω" strong="G4261" x-morph="V-2AAS-3P" x-gloss="they sprout" x-translit="probalōsin" xml:lang="grc">προβάλωσιν</char> <char style="w" x-id="SBLGNT.LUK.21.30.003" x-align="LUK.21.30.a003" x-target-ids="t003" x-target="now" x-target-head="t003" x-head="true" lemma="ἤδη" strong="G2235" x-morph="ADV" x-gloss="already" x-translit="ēdē" xml:lang="grc">ἤδη</char>,<char style="w" x-id="SBLGNT.LUK.21.30.004" x-align="LUK.21.30.a004" x-target-ids="t006 t007 t008" x-target="ye see it" x-target-head="t007" x-head="true" lemma="βλέπω" strong="G991" x-morph="V-PAP-NPM" x-gloss="looking [on them]" x-translit="blepontes" xml:lang="grc">βλέποντες</char> <char style="w" x-id="SBLGNT.LUK.21.30.005" x-align="LUK.21.30.a006" x-target-ids="t011" x-target="of" x-target-head="t011" x-head="true" lemma="ἀπό" strong="G575" x-morph="PREP" x-gloss="for" x-translit="aph" xml:lang="grc">ἀφ</char>ʼ<char style="w" x-id="SBLGNT.LUK.21.30.006" x-align="LUK.21.30.a007" x-target-ids="t012 t013 t014" x-target="your own selves" x-target-head="t014" x-head="true" lemma="ἑαυτοῦ" strong="G1438" x-morph="F-2GPM" x-gloss="yourselves" x-translit="heautōn" xml:lang="grc">ἑαυτῶν</char> <char style="w" x-id="SBLGNT.LUK.21.30.007" x-align="LUK.21.30.a005" x-target-ids="t009 t010" x-target="and know" x-target-head="t010" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-PAI-2P" x-gloss="you know" x-translit="ginōskete" xml:lang="grc">γινώσκετε</char> <char style="w" x-id="SBLGNT.LUK.21.30.008" x-align="LUK.21.30.a008