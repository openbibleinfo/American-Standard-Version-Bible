	<para style="p"><verse number="46" style="v" x-ref="LUK.22.46" sid="LUK 22:46" /><char style="w" x-id="SBLGNT.LUK.22.46.001" x-align="LUK.22.46.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.LUK.22.46.002" x-align="LUK.22.46.a002" x-target-ids="t002" x-target="said" x-target-head="t002" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.22.46.003" x-align="LUK.22.46.a003" x-target-ids="t003 t004" x-target="unto them" x-target-head="t004" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPM" x-gloss="to them" x-translit="autois" xml:lang="grc">αὐτοῖς</char>·<char style="w" x-id="SBLGNT.LUK.22.46.004" x-align="LUK.22.46.a004" x-target-ids="t005" x-target="Why" x-target-head="t005" x-head="true" lemma="τίς" strong="G5101" x-morph="I-ASN" x-gloss="Why" x-translit="Ti" xml:lang="grc">Τί</char> <char style="w" x-id="SBLGNT.LUK.22.46.005" x-align="LUK.22.46.a005" x-target-ids="t006 t007" x-target="sleep ye" x-target-head="t006" x-head="true" lemma="καθεύδω" strong="G2518" x-morph="V-PAI-2P" x-gloss="are you sleeping" x-translit="katheudete" xml:lang="grc">καθεύδετε</char>;<char style="w" x-id="SBLGNT.LUK.22.46.006" x-align="LUK.22.46.a006" x-target-ids="t008" x-target="rise" x-target-head="t008" x-head="true" lemma="ἀνίστημι" strong="G450" x-morph="V-2AAP-NPM" x-gloss="Having risen up" x-translit="anastantes" xml:lang="grc">ἀναστάντες</char> <char style="w" x-id="SBLGNT.LUK.22.46.007" x-align="LUK.22.46.a007" x-target-ids="t009 t010" x-target="and pray" x-target-head="t010" x-head="true" lemma="προσεύχομαι" strong="G4336" x-morph="V-PNM-2P" x-gloss="pray" x-translit="proseuchesthe" xml:lang="grc">προσεύχεσθε</char>,<char style="w" x-id="SBLGNT.LUK.22.46.008" x-align="LUK.22.46.a008" x-target-ids="t011" x-ta