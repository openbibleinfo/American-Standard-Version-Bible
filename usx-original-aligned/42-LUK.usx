	<para style="p"><verse number="3" style="v" x-ref="LUK.13.3" sid="LUK 13:3" /><char style="w" x-id="SBLGNT.LUK.13.3.001" x-align="LUK.13.3.a003" x-target-ids="t004" x-target="Nay" x-target-head="t004" x-head="true" lemma="οὐχί" strong="G3780" x-morph="PRT-N" x-gloss="No" x-translit="ouchi" xml:lang="grc">οὐχί</char>,<char style="w" x-id="SBLGNT.LUK.13.3.002" x-align="LUK.13.3.a001" x-target-ids="t001 t002" x-target="I tell" x-target-head="t002" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-1S" x-gloss="I say" x-translit="legō" xml:lang="grc">λέγω</char> <char style="w" x-id="SBLGNT.LUK.13.3.003" x-align="LUK.13.3.a002" x-target-ids="t003" x-target="you" x-target-head="t003" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char>,<char style="w" x-id="SBLGNT.LUK.13.3.004" x-align="LUK.13.3.a004" x-target-ids="t005" x-target="but" x-target-head="t005" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.LUK.13.3.005" x-align="LUK.13.3.a005" x-status="noncompositional" x-target-ids="t006" x-target="except" x-target-head="t006" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.LUK.13.3.006" x-align="LUK.13.3.a005" x-status="noncompositional" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.LUK.13.3.007" x-align="LUK.13.3.a006" x-target-ids="t007 t008" x-target="ye repent" x-target-head="t008" x-head="true" lemma="μετανοέω" strong="G3340" x-morph="V-PAS-2P" x-gloss="you repent" x-translit="metanoēte" xml:lang="grc">μετανοῆτε</char> <char style="w" x-id="SBLGNT.LUK.13.3.008" x-align="LUK.13.3.a007" x-target-ids="t011" x-target="all" x-target-head="t011" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NPM" x-gloss="all" x-translit="pantes" xml