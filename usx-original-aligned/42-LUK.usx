	<para style="p"><verse number="42" style="v" x-ref="LUK.22.42" sid="LUK 22:42" /><char style="w" x-id="SBLGNT.LUK.22.42.001" x-align="LUK.22.42.a001" x-target-ids="t001" x-target="saying" x-target-head="t001" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.LUK.22.42.002" x-align="LUK.22.42.a002" x-target-ids="t002" x-target="Father" x-target-head="t002" x-head="true" lemma="πατήρ" strong="G3962" x-morph="N-VSM" x-gloss="Father" x-translit="Pater" xml:lang="grc">Πάτερ</char>,<char style="w" x-id="SBLGNT.LUK.22.42.003" x-align="LUK.22.42.a003" x-target-ids="t003" x-target="if" x-target-head="t003" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἰ</char> <char style="w" x-id="SBLGNT.LUK.22.42.004" x-align="LUK.22.42.a004" x-target-ids="t004 t005 t006" x-target="thou be willing" x-target-head="t006" x-head="true" lemma="βούλομαι" strong="G1014" x-morph="V-PNI-2S" x-gloss="You are willing" x-translit="boulei" xml:lang="grc">βούλει</char> <char style="w" x-id="SBLGNT.LUK.22.42.005" x-align="LUK.22.42.a005" x-target-ids="t007" x-target="remove" x-target-head="t007" x-head="true" lemma="παραφέρω" strong="G3911" x-morph="V-2AAM-2S" x-gloss="take away" x-translit="parenenke" xml:lang="grc">παρένεγκε</char> <char style="w" x-id="SBLGNT.LUK.22.42.006" x-align="LUK.22.42.a006" x-target-ids="t008" x-target="this" x-target-head="t008" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.LUK.22.42.007" x-align="LUK.22.42.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.LUK.22.42.008" x-align="LUK.22.42.a008" x-target-ids="t009" x-target="cup" x-target-head="t009" x-head="true" lemma="ποτήριον" strong="G4221" x-mo