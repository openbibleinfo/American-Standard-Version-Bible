	<para style="p"><verse number="14" style="v" x-ref="LUK.12.14" sid="LUK 12:14" /><char style="w" x-id="SBLGNT.LUK.12.14.001" x-align="LUK.12.14.a002" x-target-ids="t002" x-target="he" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.LUK.12.14.002" x-align="LUK.12.14.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="And" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.LUK.12.14.003" x-align="LUK.12.14.a003" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="λέγω" strong="G2036" x-morph="V-2AAI-3S" x-gloss="He said" x-translit="eipen" xml:lang="grc">εἶπεν</char> <char style="w" x-id="SBLGNT.LUK.12.14.004" x-align="LUK.12.14.a004" x-target-ids="t004 t005" x-target="unto him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="to him" x-translit="autōi" xml:lang="grc">αὐτῷ</char>·<char style="w" x-id="SBLGNT.LUK.12.14.005" x-align="LUK.12.14.a005" x-target-ids="t006" x-target="Man" x-target-head="t006" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-VSM" x-gloss="Man" x-translit="Anthrōpe" xml:lang="grc">Ἄνθρωπε</char>,<char style="w" x-id="SBLGNT.LUK.12.14.006" x-align="LUK.12.14.a006" x-target-ids="t007" x-target="who" x-target-head="t007" x-head="true" lemma="τίς" strong="G5101" x-morph="I-NSM" x-gloss="who" x-translit="tis" xml:lang="grc">τίς</char> <char style="w" x-id="SBLGNT.LUK.12.14.007" x-align="LUK.12.14.a008" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="ἐγώ" strong="G3165" x-morph="P-1AS" x-gloss="Me" x-translit="me" xml:lang="grc">με</char> <char style="w" x-id="SBLGNT.LUK.12.14.008" x-align="LUK.12.14.a007" x-target-ids="t008" x-target="made" x-target-head="t008" x-head="true" lemma="καθίστημι" strong="G2525" x-morph="V-AAI-3S" x-gloss="appointed" x-tra