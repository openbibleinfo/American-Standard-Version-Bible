	<para style="p"><verse number="2" style="v" x-ref="TIT.1.2" sid="TIT 1:2" /><char style="w" x-id="SBLGNT.TIT.1.2.001" x-align="TIT.1.2.a001" x-target-ids="t001" x-target="in" x-target-head="t001" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="in" x-translit="ep" xml:lang="grc">ἐπ</char>ʼ<char style="w" x-id="SBLGNT.TIT.1.2.002" x-align="TIT.1.2.a002" x-target-ids="t002" x-target="hope" x-target-head="t002" x-head="true" lemma="ἐλπίς" strong="G1680" x-morph="N-DSF" x-gloss="[the] hope" x-translit="elpidi" xml:lang="grc">ἐλπίδι</char> <char style="w" x-id="SBLGNT.TIT.1.2.003" x-align="TIT.1.2.a003" x-target-ids="t003 t005" x-target="of life" x-target-head="t005" x-head="true" lemma="ζωή" strong="G2222" x-morph="N-GSF" x-gloss="of life" x-translit="zōēs" xml:lang="grc">ζωῆς</char> <char style="w" x-id="SBLGNT.TIT.1.2.004" x-align="TIT.1.2.a004" x-target-ids="t004" x-target="eternal" x-target-head="t004" x-head="true" lemma="αἰώνιος" strong="G166" x-morph="A-GSF" x-gloss="eternal" x-translit="aiōniou" xml:lang="grc">αἰωνίου</char>,<char style="w" x-id="SBLGNT.TIT.1.2.005" x-align="TIT.1.2.a005" x-target-ids="t006" x-target="which" x-target-head="t006" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-ASF" x-gloss="which" x-translit="hēn" xml:lang="grc">ἣν</char> <char style="w" x-id="SBLGNT.TIT.1.2.006" x-align="TIT.1.2.a006" x-target-ids="t011" x-target="promised" x-target-head="t011" x-head="true" lemma="ἐπαγγέλλομαι" strong="G1861" x-morph="V-ADI-3S" x-gloss="promised" x-translit="epēngeilato" xml:lang="grc">ἐπηγγείλατο</char> <char style="w" x-id="SBLGNT.TIT.1.2.007" x-align="TIT.1.2.a007" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.TIT.1.2.008" x-align="TIT.1.2.a008" x-target-ids="t008 t009 t010" x-target="who cannot lie" x-target-head="t010" x-head="true" lemma="ἀψευδής" strong="G893" x-morph="A-NSM" x-gloss="who cannot lie" x-tr