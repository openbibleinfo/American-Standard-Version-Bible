	<para style="p"><verse number="15" style="v" x-ref="TIT.2.15" sid="TIT 2:15" /><char style="w" x-id="SBLGNT.TIT.2.15.001" x-align="TIT.2.15.a001" x-target-ids="t001 t002" x-target="These things" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="These things" x-translit="Tauta" xml:lang="grc">Ταῦτα</char> <char style="w" x-id="SBLGNT.TIT.2.15.002" x-align="TIT.2.15.a002" x-target-ids="t003" x-target="speak" x-target-head="t003" x-head="true" lemma="λαλέω" strong="G2980" x-morph="V-PAM-2S" x-gloss="speak" x-translit="lalei" xml:lang="grc">λάλει</char> <char style="w" x-id="SBLGNT.TIT.2.15.003" x-align="TIT.2.15.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.TIT.2.15.004" x-align="TIT.2.15.a004" x-target-ids="t005" x-target="exhort" x-target-head="t005" x-head="true" lemma="παρακαλέω" strong="G3870" x-morph="V-PAM-2S" x-gloss="exhort" x-translit="parakalei" xml:lang="grc">παρακάλει</char> <char style="w" x-id="SBLGNT.TIT.2.15.005" x-align="TIT.2.15.a005" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.TIT.2.15.006" x-align="TIT.2.15.a006" x-target-ids="t007" x-target="reprove" x-target-head="t007" x-head="true" lemma="ἐλέγχω" strong="G1651" x-morph="V-PAM-2S" x-gloss="rebuke" x-translit="elenche" xml:lang="grc">ἔλεγχε</char> <char style="w" x-id="SBLGNT.TIT.2.15.007" x-align="TIT.2.15.a007" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="μετά" strong="G3326" x-morph="PREP" x-gloss="with" x-translit="meta" xml:lang="grc">μετὰ</char> <char style="w" x-id="SBLGNT.TIT.2.15.008" x-align="TIT.2.15.a008" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="πᾶς" strong="G3956" x-morp