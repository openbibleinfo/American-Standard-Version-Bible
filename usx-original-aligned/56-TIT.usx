	<para style="p"><verse number="6" style="v" x-ref="TIT.1.6" sid="TIT 1:6" /><char style="w" x-id="SBLGNT.TIT.1.6.001" x-align="TIT.1.6.a001" x-target-ids="t001" x-target="if" x-target-head="t001" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="if" x-translit="ei" xml:lang="grc">εἴ</char> <char style="w" x-id="SBLGNT.TIT.1.6.002" x-align="TIT.1.6.a002" x-target-ids="t002 t003" x-target="any man" x-target-head="t002" x-head="true" lemma="τίς" strong="G5100" x-morph="X-NSM" x-gloss="anyone" x-translit="tis" xml:lang="grc">τίς</char> <char style="w" x-id="SBLGNT.TIT.1.6.003" x-align="TIT.1.6.a003" x-target-ids="t004" x-target="is" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="is" x-translit="estin" xml:lang="grc">ἐστιν</char> <char style="w" x-id="SBLGNT.TIT.1.6.004" x-align="TIT.1.6.a004" x-target-ids="t005" x-target="blameless" x-target-head="t005" x-head="true" lemma="ἀνέγκλητος" strong="G410" x-morph="A-NSM" x-gloss="blameless" x-translit="anenklētos" xml:lang="grc">ἀνέγκλητος</char>,<char style="w" x-id="SBLGNT.TIT.1.6.005" x-align="TIT.1.6.a005" x-target-ids="t009" x-target="one" x-target-head="t009" x-head="true" lemma="εἷς" strong="G3391" x-morph="A-GSF" x-gloss="of one" x-translit="mias" xml:lang="grc">μιᾶς</char> <char style="w" x-id="SBLGNT.TIT.1.6.006" x-align="TIT.1.6.a006" x-target-ids="t008 t010" x-target="of wife" x-target-head="t010" x-head="true" lemma="γυνή" strong="G1135" x-morph="N-GSF" x-gloss="wife" x-translit="gynaikos" xml:lang="grc">γυναικὸς</char> <char style="w" x-id="SBLGNT.TIT.1.6.007" x-align="TIT.1.6.a007" x-target-ids="t006 t007" x-target="the husband" x-target-head="t007" x-head="true" lemma="ἀνήρ" strong="G435" x-morph="N-NSM" x-gloss="[the] husband" x-translit="anēr" xml:lang="grc">ἀνήρ</char>,<char style="w" x-id="SBLGNT.TIT.1.6.008" x-align="TIT.1.6.a008" x-target-ids="t012" x-target="children" x-target-head="t012" x-head="true" lemma="τέκνον" strong="G5043" x-morph="N-AP