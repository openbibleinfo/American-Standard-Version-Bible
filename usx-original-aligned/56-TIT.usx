	<para style="p"><verse number="3" style="v" x-ref="TIT.1.3" sid="TIT 1:3" /><char style="w" x-id="SBLGNT.TIT.1.3.001" x-align="TIT.1.3.a001" x-target-ids="t006" x-target="manifested" x-target-head="t006" x-head="true" lemma="φανερόω" strong="G5319" x-morph="V-AAI-3S" x-gloss="He revealed" x-translit="ephanerōsen" xml:lang="grc">ἐφανέρωσεν</char> <char style="w" x-id="SBLGNT.TIT.1.3.002" x-align="TIT.1.3.a002" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.TIT.1.3.003" x-align="TIT.1.3.a003" x-target-ids="t002 t005" x-target="in seasons" x-target-head="t005" x-head="true" lemma="καιρός" strong="G2540" x-morph="N-DPM" x-gloss="[in] seasons" x-translit="kairois" xml:lang="grc">καιροῖς</char> <char style="w" x-id="SBLGNT.TIT.1.3.004" x-align="TIT.1.3.a004" x-target-ids="t003 t004" x-target="his own" x-target-head="t004" x-head="true" lemma="ἴδιος" strong="G2398" x-morph="A-DPM" x-gloss="[His] own" x-translit="idiois" xml:lang="grc">ἰδίοις</char>,<char style="w" x-id="SBLGNT.TIT.1.3.005" x-align="TIT.1.3.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="in the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.TIT.1.3.006" x-align="TIT.1.3.a006" x-target-ids="t008" x-target="word" x-target-head="t008" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-ASM" x-gloss="word" x-translit="logon" xml:lang="grc">λόγον</char> <char style="w" x-id="SBLGNT.TIT.1.3.007" x-align="TIT.1.3.a007" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-GSM" x-gloss="of Him" x-translit="autou" xml:lang="grc">αὐτοῦ</char> <char style="w" x-id="SBLGNT.TIT.1.3.008" x-align="TIT.1.3.a008" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" 