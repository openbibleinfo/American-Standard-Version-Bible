	<para style="p"><verse number="8" style="v" x-ref="TIT.3.8" sid="TIT 3:8" /><char style="w" x-id="SBLGNT.TIT.3.8.001" x-align="TIT.3.8.a001" x-target-ids="t001 t002" x-target="Faithful is" x-target-head="t001" x-head="true" lemma="πιστός" strong="G4103" x-morph="A-NSM" x-gloss="Trustworthy [is]" x-translit="Pistos" xml:lang="grc">Πιστὸς</char> <char style="w" x-id="SBLGNT.TIT.3.8.002" x-align="TIT.3.8.a002" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.TIT.3.8.003" x-align="TIT.3.8.a003" x-target-ids="t004" x-target="saying" x-target-head="t004" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-NSM" x-gloss="saying" x-translit="logos" xml:lang="grc">λόγος</char>,<char style="w" x-id="SBLGNT.TIT.3.8.004" x-align="TIT.3.8.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.TIT.3.8.005" x-align="TIT.3.8.a005" x-target-ids="t006" x-target="concerning" x-target-head="t006" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="concerning" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.TIT.3.8.006" x-align="TIT.3.8.a006" x-target-ids="t007 t008" x-target="these things" x-target-head="t007" x-head="true" lemma="οὗτος" strong="G5130" x-morph="D-GPN" x-gloss="these things" x-translit="toutōn" xml:lang="grc">τούτων</char> <char style="w" x-id="SBLGNT.TIT.3.8.007" x-align="TIT.3.8.a007" x-target-ids="t009 t010" x-target="I desire" x-target-head="t010" x-head="true" lemma="βούλομαι" strong="G1014" x-morph="V-PNI-1S" x-gloss="I want" x-translit="boulomai" xml:lang="grc">βούλομαί</char> <char style="w" x-id="SBLGNT.TIT.3.8.008" x-align="TIT.3.8.a008" x-target-ids="t012" x-target="thou" x-target-head="t012" x-head="true" lemma="σύ" strong="G457