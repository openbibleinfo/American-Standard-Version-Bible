	<para style="p"><verse number="6" style="v" x-ref="TIT.2.6" sid="TIT 2:6" /><char style="w" x-id="SBLGNT.TIT.2.6.001" x-align="TIT.2.6.a001" x-target-ids="t001" x-target="the" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="The" x-translit="Tous" xml:lang="grc">Τοὺς</char> <char style="w" x-id="SBLGNT.TIT.2.6.002" x-align="TIT.2.6.a002" x-target-ids="t002 t003" x-target="younger men" x-target-head="t002" x-head="true" lemma="νέος" strong="G3501" x-morph="A-APM-C" x-gloss="younger [men]" x-translit="neōterous" xml:lang="grc">νεωτέρους</char> <char style="w" x-id="SBLGNT.TIT.2.6.003" x-align="TIT.2.6.a003" x-target-ids="t004" x-target="likewise" x-target-head="t004" x-head="true" lemma="ὡσαύτως" strong="G5615" x-morph="ADV" x-gloss="likewise" x-translit="hōsautōs" xml:lang="grc">ὡσαύτως</char> <char style="w" x-id="SBLGNT.TIT.2.6.004" x-align="TIT.2.6.a004" x-target-ids="t005" x-target="exhort" x-target-head="t005" x-head="true" lemma="παρακαλέω" strong="G3870" x-morph="V-PAM-2S" x-gloss="exhort" x-translit="parakalei" xml:lang="grc">παρακάλει</char> <char style="w" x-id="SBLGNT.TIT.2.6.005" x-align="TIT.2.6.a005" x-target-ids="t006 t007 t008 t009" x-target="to be sober minded" x-target-head="t008" x-head="true" lemma="σωφρονέω" strong="G4993" x-morph="V-PAN" x-gloss="to be self-controlled" x-translit="sōphronein" xml:lang="grc">σωφρονεῖν</char>·<verse eid="TIT 2:6" /></para>
