	<para style="p"><verse number="1" style="v" x-ref="TIT.3.1" sid="TIT 3:1" /><char style="w" x-id="SBLGNT.TIT.3.1.001" x-align="TIT.3.1.a001" x-target-ids="t001 t003 t004" x-target="Put in mind" x-target-head="t004" x-head="true" lemma="ὑπομιμνῄσκω" strong="G5279" x-morph="V-PAM-2S" x-gloss="Remind" x-translit="Hypomimnēiske" xml:lang="grc">Ὑπομίμνῃσκε</char> <char style="w" x-id="SBLGNT.TIT.3.1.002" x-align="TIT.3.1.a002" x-target-ids="t002" x-target="them" x-target-head="t002" x-head="true" lemma="ἑαυτοῦ" strong="G848" x-morph="P-APM" x-gloss="them" x-translit="autous" xml:lang="grc">αὐτοὺς</char> <char style="w" x-id="SBLGNT.TIT.3.1.003" x-align="TIT.3.1.a004" x-target-ids="t009 t010" x-target="to rulers" x-target-head="t010" x-head="true" lemma="ἀρχή" strong="G746" x-morph="N-DPF" x-gloss="to rulers" x-translit="archais" xml:lang="grc">ἀρχαῖς</char> <char style="w" x-id="SBLGNT.TIT.3.1.004" x-align="TIT.3.1.a005" x-target-ids="t011 t012" x-target="to authorities" x-target-head="t012" x-head="true" lemma="ἐξουσία" strong="G1849" x-morph="N-DPF" x-gloss="to authorities" x-translit="exousiais" xml:lang="grc">ἐξουσίαις</char> <char style="w" x-id="SBLGNT.TIT.3.1.005" x-align="TIT.3.1.a003" x-target-ids="t005 t006 t007 t008" x-target="to be in subjection" x-target-head="t008" x-head="true" lemma="ὑποτάσσω" strong="G5293" x-morph="V-PMN" x-gloss="to be subject" x-translit="hypotassesthai" xml:lang="grc">ὑποτάσσεσθαι</char> <char style="w" x-id="SBLGNT.TIT.3.1.006" x-align="TIT.3.1.a006" x-target-ids="t013 t014 t015" x-target="to be obedient" x-target-head="t015" x-head="true" lemma="πειθαρχέω" strong="G3980" x-morph="V-PAN" x-gloss="to be obedient" x-translit="peitharchein" xml:lang="grc">πειθαρχεῖν</char>,<char style="w" x-id="SBLGNT.TIT.3.1.007" x-align="TIT.3.1.a009" x-target-ids="t019" x-target="unto" x-target-head="t019" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="for" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT