	<para style="p"><verse number="1" style="v" x-ref="TIT.2.1" sid="TIT 2:1" /><char style="w" x-id="SBLGNT.TIT.2.1.001" x-align="TIT.2.1.a001" x-target-ids="t003" x-target="thou" x-target-head="t003" x-head="true" lemma="σύ" strong="G4771" x-morph="P-2NS" x-gloss="You" x-translit="Sy" xml:lang="grc">Σὺ</char> <char style="w" x-id="SBLGNT.TIT.2.1.002" x-align="TIT.2.1.a002" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="however" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.TIT.2.1.003" x-align="TIT.2.1.a003" x-target-ids="t002" x-target="speak" x-target-head="t002" x-head="true" lemma="λαλέω" strong="G2980" x-morph="V-PAM-2S" x-gloss="speak" x-translit="lalei" xml:lang="grc">λάλει</char> <char style="w" x-id="SBLGNT.TIT.2.1.004" x-align="TIT.2.1.a004" x-target-ids="t004 t005 t006" x-target="the things which" x-target-head="t005" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-NPN" x-gloss="the things that" x-translit="ha" xml:lang="grc">ἃ</char> <char style="w" x-id="SBLGNT.TIT.2.1.005" x-align="TIT.2.1.a005" x-target-ids="t007" x-target="befit" x-target-head="t007" x-head="true" lemma="πρέπω" strong="G4241" x-morph="V-PAI-3S" x-gloss="are consistent with" x-translit="prepei" xml:lang="grc">πρέπει</char> <char style="w" x-id="SBLGNT.TIT.2.1.006" x-align="TIT.2.1.a006" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="-" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.TIT.2.1.007" x-align="TIT.2.1.a007" x-target-ids="t009" x-target="sound" x-target-head="t009" x-head="true" lemma="ὑγιαίνω" strong="G5198" x-morph="V-PAP-DSF" x-gloss="sound" x-translit="hygiainousēi" xml:lang="grc">ὑγιαινούσῃ</char> <char style="w" x-id="SBLGNT.TIT.2.1.008" x-align="TIT.2.1.a008" x-target-ids="t010" x-target="doctrine" x-target-head="t010" x-head="true" lemma="διδασκαλία" strong="G1319" x-morph="N