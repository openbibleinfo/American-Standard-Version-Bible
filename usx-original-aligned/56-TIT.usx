	<para style="p"><verse number="2" style="v" x-ref="TIT.3.2" sid="TIT 3:2" /><char style="w" x-id="SBLGNT.TIT.3.2.001" x-align="TIT.3.2.a001" x-target-ids="t005 t006" x-target="no man" x-target-head="t005" x-head="true" lemma="μηδείς" strong="G3367" x-morph="A-ASM-N" x-gloss="no one" x-translit="mēdena" xml:lang="grc">μηδένα</char> <char style="w" x-id="SBLGNT.TIT.3.2.002" x-align="TIT.3.2.a002" x-target-ids="t001 t002 t003 t004" x-target="to speak evil of" x-target-head="t002" x-head="true" lemma="βλασφημέω" strong="G987" x-morph="V-PAN" x-gloss="to speak evil of" x-translit="blasphēmein" xml:lang="grc">βλασφημεῖν</char>,<char style="w" x-id="SBLGNT.TIT.3.2.003" x-align="TIT.3.2.a003" x-target-ids="t007 t010" x-target="not contentious" x-target-head="t010" x-head="true" lemma="ἄμαχος" strong="G269" x-morph="A-APM" x-gloss="peaceable" x-translit="amachous" xml:lang="grc">ἀμάχους</char> <char style="w" x-id="SBLGNT.TIT.3.2.004" x-align="TIT.3.2.a004" x-target-ids="t008 t009" x-target="to be" x-target-head="t009" x-head="true" lemma="εἰμί" strong="G1511" x-morph="V-PAN" x-gloss="to be" x-translit="einai" xml:lang="grc">εἶναι</char>,<char style="w" x-id="SBLGNT.TIT.3.2.005" x-align="TIT.3.2.a005" x-target-ids="t011 t012 t013" x-target="to be gentle" x-target-head="t013" x-head="true" lemma="ἐπιεικής" strong="G1933" x-morph="A-APM" x-gloss="gentle" x-translit="epieikeis" xml:lang="grc">ἐπιεικεῖς</char>,<char style="w" x-id="SBLGNT.TIT.3.2.006" x-align="TIT.3.2.a006" x-target-ids="t015" x-target="all" x-target-head="t015" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-ASF" x-gloss="all" x-translit="pasan" xml:lang="grc">πᾶσαν</char> <char style="w" x-id="SBLGNT.TIT.3.2.007" x-align="TIT.3.2.a007" x-target-ids="t014" x-target="showing" x-target-head="t014" x-head="true" lemma="ἐνδείκνυμι" strong="G1731" x-morph="V-PMP-APM" x-gloss="showing" x-translit="endeiknymenous" xml:lang="grc">ἐνδεικνυμένους</char> <char style="w" x-id="SBLGNT.TIT.3.2.008" x-align="TIT.3.2.a008