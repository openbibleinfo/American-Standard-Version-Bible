	<para style="p"><verse number="20" style="v" x-ref="EXO.21.20" sid="EXO 21:20" /><char style="w" x-id="WLC.EXO.21.20.001" x-align="EXO.21.20.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.21.20.002" x-align="EXO.21.20.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="ḵiy-" xml:lang="hbo">כִֽי</char>־<char style="w" x-id="WLC.EXO.21.20.003" x-align="EXO.21.20.a003" x-target-ids="t005" x-target="smite" x-target-head="t005" x-head="true" lemma="נָכָה" strong="H5221" x-morph="Vhi3ms" x-gloss="he.will.strike" x-translit="yakkeh" xml:lang="hbo">יַכֶּה֩</char> <char style="w" x-id="WLC.EXO.21.20.004" x-align="EXO.21.20.a004" x-target-ids="t003 t004" x-target="a man" x-target-head="t004" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾiyš" xml:lang="hbo">אִ֨ישׁ</char> <char style="w" x-id="WLC.EXO.21.20.005" x-align="EXO.21.20.a005" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.EXO.21.20.006" x-align="EXO.21.20.a006" x-target-ids="t007" x-target="servant" x-target-head="t007" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="slave" x-translit="ʿaḇd" xml:lang="hbo">עַבְדּ֜</char><char style="w" x-id="WLC.EXO.21.20.007" x-align="EXO.21.20.a007" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.[male]" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.EXO.21.20.008" x-align="EXO.21.20.a008" x-target-ids="t008" x-target="or" x-target-head="t008" x-head="true" lemma="אוֹ" strong="H176" x-morph="C" x-gloss="or" x-translit="ʾô" xml:lang="hbo">א֤וֹ</char> <char style="w" x-id="