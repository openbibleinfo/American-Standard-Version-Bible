	<para style="p"><verse number="17" style="v" x-ref="EXO.22.17" sid="EXO 22:17" /><char style="w" x-id="WLC.EXO.22.17.001" x-align="EXO.22.17.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="EXO.22.16">אִם</char>־<char style="w" x-id="WLC.EXO.22.17.002" x-align="EXO.22.17.a002" x-target-ids="t004" x-target="utterly" x-target-head="t004" x-head="true" lemma="מָאֵן" strong="H3985" x-morph="Vpa" x-gloss="absolutely.(refuse)" x-translit="māʾēn" xml:lang="hbo" x-source-ref="EXO.22.16">מָאֵ֧ן</char> <char style="w" x-id="WLC.EXO.22.17.003" x-align="EXO.22.17.a003" x-target-ids="t005" x-target="refuse" x-target-head="t005" x-head="true" lemma="מָאֵן" strong="H3985" x-morph="Vpi3ms" x-gloss="he.will.refuse" x-translit="yəmāʾēn" xml:lang="hbo" x-source-ref="EXO.22.16">יְמָאֵ֛ן</char> <char style="w" x-id="WLC.EXO.22.17.004" x-align="EXO.22.17.a004" x-target-ids="t003" x-target="father" x-target-head="t003" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="father" x-translit="ʾāḇiy" xml:lang="hbo" x-source-ref="EXO.22.16">אָבִ֖י</char><char style="w" x-id="WLC.EXO.22.17.005" x-align="EXO.22.17.a005" x-target-ids="t002" x-target="her" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo" x-source-ref="EXO.22.16">הָ</char> <char style="w" x-id="WLC.EXO.22.17.006" x-align="EXO.22.17.a006" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="EXO.22.16">לְ</char><char style="w" x-id="WLC.EXO.22.17.007" x-align="EXO.22.17.a007" x-target-ids="t007" x-target="give" x-target-head="t007" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqc" x-gloss="give" x-translit="ṯitt" xml:lang="hbo" x-source-ref="EXO.22.16">תִתָּ֣</char><char style="w" x-id="WLC.EXO.22.17.008" x-