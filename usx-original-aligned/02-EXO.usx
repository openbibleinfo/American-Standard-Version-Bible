	<para style="p"><verse number="3" style="v" x-ref="EXO.35.3" sid="EXO 35:3" /><char style="w" x-id="WLC.EXO.35.3.001" x-align="EXO.35.3.a001" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.EXO.35.3.002" x-align="EXO.35.3.a002" x-target-ids="t001 t002 t003" x-target="Ye shall kindle" x-target-head="t003" x-head="true" lemma="בָּעַר" strong="H1197" x-morph="Vpi2mp" x-gloss="you.must.kindle" x-translit="ṯəḇaʿărû" xml:lang="hbo">תְבַעֲר֣וּ</char> <char style="w" x-id="WLC.EXO.35.3.003" x-align="EXO.35.3.a003" x-target-ids="t005" x-target="fire" x-target-head="t005" x-head="true" lemma="אֵשׁ" strong="H784" x-morph="Ncbsa" x-gloss="fire" x-translit="ʾēš" xml:lang="hbo">אֵ֔שׁ</char> <char style="w" x-id="WLC.EXO.35.3.004" x-align="EXO.35.3.a004" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.EXO.35.3.005" x-align="EXO.35.3.a004" x-target-ids="t006" x-target="throughout" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵōl" xml:lang="hbo">כֹ֖ל</char> <char style="w" x-id="WLC.EXO.35.3.006" x-align="EXO.35.3.a005" x-target-ids="t008" x-target="habitations" x-target-head="t008" x-head="true" lemma="מוֹשָׁב" strong="H4186" x-morph="Ncmpc" x-gloss="places" x-translit="mōšəḇōṯēy" xml:lang="hbo">מֹשְׁבֹֽתֵי</char><char style="w" x-id="WLC.EXO.35.3.007" x-align="EXO.35.3.a006" x-target-ids="t007" x-target="your" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your.dwelling" x-translit="ḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.EXO.35.3.008" x-align="EXO.35.3.a007" x-target-ids="t009" x-target="upon" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.EXO.