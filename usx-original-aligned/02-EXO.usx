	<para style="p"><verse number="12" style="v" x-ref="EXO.13.12" sid="EXO 13:12" /><char style="w" x-id="WLC.EXO.13.12.001" x-align="EXO.13.12.a001" x-target-ids="t001" x-target="that" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.13.12.002" x-align="EXO.13.12.a002" x-target-ids="t002 t003 t004 t005" x-target="thou shalt set apart" x-target-head="t004" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vhq2ms" x-gloss="you.will.dedicate" x-translit="haʿăḇartā" xml:lang="hbo">הַעֲבַרְתָּ֥</char> <char style="w" x-id="WLC.EXO.13.12.003" x-align="EXO.13.12.a003" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.EXO.13.12.004" x-align="EXO.13.12.a004" x-target-ids="t009 t010" x-target="that openeth" x-target-head="t010" x-head="true" lemma="פֶּטֶר" strong="H6363" x-morph="Ncmsc" x-gloss="firstborn" x-translit="peṭer-" xml:lang="hbo">פֶּֽטֶר</char>־<char style="w" x-id="WLC.EXO.13.12.005" x-align="EXO.13.12.a005" x-target-ids="t011 t012" x-target="the womb" x-target-head="t012" x-head="true" lemma="רֶחֶם" strong="H7358" x-morph="Ncmsa" x-gloss="of.a.womb" x-translit="reḥem" xml:lang="hbo">רֶ֖חֶם</char> <char style="w" x-id="WLC.EXO.13.12.006" x-align="EXO.13.12.a006" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.EXO.13.12.007" x-align="EXO.13.12.a007" x-target-ids="t007" x-target="Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhōwāh" xml:lang="hbo">יהֹוָ֑ה</char> <char style="w" x-id="WLC.EXO.13.12.008" x-align="EXO.13.12.a008" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ