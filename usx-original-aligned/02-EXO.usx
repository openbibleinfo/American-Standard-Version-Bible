	<para style="p"><verse number="7" style="v" x-ref="EXO.15.7" sid="EXO 15:7" /><char style="w" x-id="WLC.EXO.15.7.001" x-align="EXO.15.7.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.EXO.15.7.002" x-align="EXO.15.7.a002" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.EXO.15.7.003" x-align="EXO.15.7.a003" x-target-ids="t003 t004" x-target="the greatness" x-target-head="t004" x-head="true" lemma="רֹב" strong="H7230" x-morph="Ncbsc" x-gloss="the.greatness" x-translit="rōḇ" xml:lang="hbo">רֹ֥ב</char> <char style="w" x-id="WLC.EXO.15.7.004" x-align="EXO.15.7.a004" x-target-ids="t005 t007" x-target="of excellency" x-target-head="t007" x-head="true" lemma="גָּאוֹן" strong="H1347" x-morph="Ncmsc" x-gloss="your.majesty" x-translit="gəʾôn" xml:lang="hbo">גְּאוֹנְ</char><char style="w" x-id="WLC.EXO.15.7.005" x-align="EXO.15.7.a005" x-target-ids="t006" x-target="thine" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.EXO.15.7.006" x-align="EXO.15.7.a006" x-target-ids="t008 t009" x-target="thou overthrowest" x-target-head="t009" x-head="true" lemma="הָרַס" strong="H2040" x-morph="Vqi2ms" x-gloss="you.threw.down" x-translit="tahărōs" xml:lang="hbo">תַּהֲרֹ֣ס</char> <char style="w" x-id="WLC.EXO.15.7.007" x-align="EXO.15.7.a007" x-target-ids="t010 t011 t012 t013 t014" x-target="them that rise up against" x-target-head="t012" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqrmpc" x-gloss="[those" x-translit="qāmey" xml:lang="hbo">קָמֶ֑י</char><char style="w" x-id="WLC.EXO.15.7.008" x-align="EXO.15.7.a008" x-target-ids="t015" x-target="thee" x-target-head="t015" x-head="true" lemma=