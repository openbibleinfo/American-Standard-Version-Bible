	<para style="p"><verse number="1" style="v" x-ref="EXO.23.1" sid="EXO 23:1" /><char style="w" x-id="WLC.EXO.23.1.001" x-align="EXO.23.1.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.EXO.23.1.002" x-align="EXO.23.1.a002" x-target-ids="t001 t002 t004 t005" x-target="Thou shalt take up" x-target-head="t004" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqi2ms" x-gloss="you.must.bear" x-translit="ṯiśśāʾ" xml:lang="hbo">תִשָּׂ֖א</char> <char style="w" x-id="WLC.EXO.23.1.003" x-align="EXO.23.1.a003" x-target-ids="t006 t008" x-target="a report" x-target-head="t008" x-head="true" lemma="שֵׁמַע" strong="H8088" x-morph="Ncmsc" x-gloss="a.report" x-translit="šēmaʿ" xml:lang="hbo">שֵׁ֣מַע</char> <char style="w" x-id="WLC.EXO.23.1.004" x-align="EXO.23.1.a004" x-target-ids="t007" x-target="false" x-target-head="t007" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāwəʾ" xml:lang="hbo">שָׁ֑וְא</char> <char style="w" x-id="WLC.EXO.23.1.005" x-align="EXO.23.1.a005" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.EXO.23.1.006" x-align="EXO.23.1.a006" x-target-ids="t009" x-target="put" x-target-head="t009" x-head="true" lemma="שִׁית" strong="H7896" x-morph="Vqj2ms" x-gloss="put" x-translit="tāšeṯ" xml:lang="hbo">תָּ֤שֶׁת</char> <char style="w" x-id="WLC.EXO.23.1.007" x-align="EXO.23.1.a007" x-target-ids="t012" x-target="hand" x-target-head="t012" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָֽדְ</char><char style="w" x-id="WLC.EXO.23.1.008" x-align="EXO.23.1.a008" x-target-ids="t011" x-target="thy" x-target-head="t011" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2m