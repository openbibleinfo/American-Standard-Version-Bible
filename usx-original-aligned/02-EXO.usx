	<para style="p"><verse number="13" style="v" x-ref="EXO.22.13" sid="EXO 22:13" /><char style="w" x-id="WLC.EXO.22.13.001" x-align="EXO.22.13.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="EXO.22.12">אִם</char>־<char style="w" x-id="WLC.EXO.22.13.002" x-align="EXO.22.13.a002" x-status="unrepresented" x-head="true" lemma="טָרַף" strong="H2963" x-morph="Vqa" x-gloss="actually.(tear)" x-translit="ṭārōp̄" xml:lang="hbo" x-source-ref="EXO.22.12">טָרֹ֥ף</char> <char style="w" x-id="WLC.EXO.22.13.003" x-align="EXO.22.13.a003" x-target-ids="t002 t003 t004 t005 t006" x-target="it be torn in pieces" x-target-head="t004" x-head="true" lemma="טָרַף" strong="H2963" x-morph="VNi3ms" x-gloss="it.will.be.torn.in.pieces" x-translit="yiṭṭārēp̄" xml:lang="hbo" x-source-ref="EXO.22.12">יִטָּרֵ֖ף</char> <char style="w" x-id="WLC.EXO.22.13.004" x-align="EXO.22.13.a004" x-target-ids="t007 t008 t009" x-target="let him bring" x-target-head="t009" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vhi3ms" x-gloss="he" x-translit="yəḇiʾ" xml:lang="hbo" x-source-ref="EXO.22.12">יְבִאֵ֣</char><char style="w" x-id="WLC.EXO.22.13.005" x-align="EXO.22.13.a005" x-target-ids="t010" x-target="it" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="will.bring.it" x-translit="ēhû" xml:lang="hbo" x-source-ref="EXO.22.12">הוּ</char> <char style="w" x-id="WLC.EXO.22.13.006" x-align="EXO.22.13.a006" x-target-ids="t011 t012" x-target="for witness" x-target-head="t012" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsa" x-gloss="evidence" x-translit="ʿēḏ" xml:lang="hbo" x-source-ref="EXO.22.12">עֵ֑ד</char> <char style="w" x-id="WLC.EXO.22.13.007" x-align="EXO.22.13.a007" x-target-ids="t018 t019" x-target="that which" x-target-head="t018" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.torn" x-translit="ha" xml:lang="hbo" x-s