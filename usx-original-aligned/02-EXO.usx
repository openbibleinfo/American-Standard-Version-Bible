	<para style="p"><verse number="25" style="v" x-ref="EXO.34.25" sid="EXO 34:25" /><char style="w" x-id="WLC.EXO.34.25.001" x-align="EXO.34.25.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.EXO.34.25.002" x-align="EXO.34.25.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt offer" x-target-head="t004" x-head="true" lemma="שָׁחַט" strong="H7819" x-morph="Vqi2ms" x-gloss="you.must.slaughter" x-translit="ṯišḥaṭ" xml:lang="hbo">תִשְׁחַ֥ט</char> <char style="w" x-id="WLC.EXO.34.25.003" x-align="EXO.34.25.a003" x-target-ids="t010" x-target="with" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="with" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.EXO.34.25.004" x-align="EXO.34.25.a004" x-target-ids="t011 t012" x-target="leavened bread" x-target-head="t011" x-head="true" lemma="חָמֵץ" strong="H2557" x-morph="Ncmsa" x-gloss="leaven" x-translit="ḥāmēṣ" xml:lang="hbo">חָמֵ֖ץ</char> <char style="w" x-id="WLC.EXO.34.25.005" x-align="EXO.34.25.a005" x-target-ids="t005 t006" x-target="the blood" x-target-head="t006" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmsc" x-gloss="the.blood" x-translit="dam-" xml:lang="hbo">דַּם</char>־<char style="w" x-id="WLC.EXO.34.25.006" x-align="EXO.34.25.a006" x-target-ids="t007 t009" x-target="of sacrifice" x-target-head="t009" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmsc" x-gloss="my.sacrifice" x-translit="ziḇḥ" xml:lang="hbo">זִבְחִ֑</char><char style="w" x-id="WLC.EXO.34.25.007" x-align="EXO.34.25.a007" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.EXO.34.25.008" x-align="EXO.34.25.a008" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and