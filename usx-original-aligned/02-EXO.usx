	<para style="p"><verse number="25" style="v" x-ref="EXO.22.25" sid="EXO 22:25" /><char style="w" x-id="WLC.EXO.22.25.001" x-align="EXO.22.25.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="EXO.22.24">אִם</char>־<char style="w" x-id="WLC.EXO.22.25.002" x-align="EXO.22.25.a002" x-target-ids="t004" x-target="money" x-target-head="t004" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="money" x-translit="kesep̄" xml:lang="hbo" x-source-ref="EXO.22.24">כֶּ֣סֶף</char>׀<char style="w" x-id="WLC.EXO.22.25.003" x-align="EXO.22.25.a003" x-target-ids="t002 t003" x-target="thou lend" x-target-head="t003" x-head="true" lemma="לָוָה" strong="H3867a" x-morph="Vhi2ms" x-gloss="you.will.lend.to" x-translit="talweh" xml:lang="hbo" x-source-ref="EXO.22.24">תַּלְוֶ֣ה</char> <char style="w" x-id="WLC.EXO.22.25.004" x-align="EXO.22.25.a004" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="EXO.22.24">אֶת</char>־<char style="w" x-id="WLC.EXO.22.25.005" x-align="EXO.22.25.a005" x-target-ids="t006 t007 t009" x-target="any of people" x-target-head="t009" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="EXO.22.24">עַמִּ֗</char><char style="w" x-id="WLC.EXO.22.25.006" x-align="EXO.22.25.a006" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo" x-source-ref="EXO.22.24">י</char> <char style="w" x-id="WLC.EXO.22.25.007" x-align="EXO.22.25.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="EXO.22.24">אֶת</char>־<char style="w" x-id="WLC.EXO.22.25.008" x-align="EXO.22.25