	<para style="p"><verse number="22" style="v" x-ref="EXO.22.22" sid="EXO 22:22" /><char style="w" x-id="WLC.EXO.22.22.001" x-align="EXO.22.22.a001" x-target-ids="t005" x-target="any" x-target-head="t005" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="any" x-translit="kol-" xml:lang="hbo" x-source-ref="EXO.22.21">כָּל</char>־<char style="w" x-id="WLC.EXO.22.22.002" x-align="EXO.22.22.a002" x-target-ids="t006" x-target="widow" x-target-head="t006" x-head="true" lemma="אַלְמָנָה" strong="H490" x-morph="Ncfsa" x-gloss="widow" x-translit="ʾalmānāh" xml:lang="hbo" x-source-ref="EXO.22.21">אַלְמָנָ֥ה</char> <char style="w" x-id="WLC.EXO.22.22.003" x-align="EXO.22.22.a003" x-target-ids="t007" x-target="or" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="EXO.22.21">וְ</char><char style="w" x-id="WLC.EXO.22.22.004" x-align="EXO.22.22.a004" x-target-ids="t008 t009" x-target="fatherless child" x-target-head="t008" x-head="true" lemma="יָתוֹם" strong="H3490" x-morph="Ncmsa" x-gloss="a.fatherless.one" x-translit="yāṯôm" xml:lang="hbo" x-source-ref="EXO.22.21">יָת֖וֹם</char> <char style="w" x-id="WLC.EXO.22.22.005" x-align="EXO.22.22.a005" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="EXO.22.21">לֹ֥א</char> <char style="w" x-id="WLC.EXO.22.22.006" x-align="EXO.22.22.a006" x-target-ids="t001 t002 t004" x-target="Ye shall afflict" x-target-head="t004" x-head="true" lemma="עָנָה" strong="H6031" x-morph="Vpi2mp" x-gloss="you" x-translit="ṯəʿannû" xml:lang="hbo" x-source-ref="EXO.22.21">תְעַנּֽוּ</char><char style="w" x-id="WLC.EXO.22.22.007" x-align="EXO.22.22.a007" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="must.afflict" x-translit="n" xml:lang="hbo" x-source-ref="EXO.22.21">ן</char>׃<verse eid="EXO 22:22" /></para>
	<para style="p"><verse number="23" style="v" x-ref="EXO.22.23" sid="EXO 22:23" /><char style="w" x-id="WLC.EXO.22.23.001" x-align="EXO.22.23.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="EXO.22.22">אִם</char>־<char style="w" x-id="WLC.EXO.22.23.002" x-align="EXO.22.23.a002" x-target-ids="t005 t006" x-target="at all" x-target-head="t006" x-head="true" lemma="עָנָה" strong="H6031" x-morph="Vpa" x-gloss="indeed.(afflict)" x-translit="ʿannēh" xml:lang="hbo" x-source-ref="EXO.22.22">עַנֵּ֥ה</char> <char style="w" x-id="WLC.EXO.22.23.003" x-align="EXO.22.23.a003" x-target-ids="t002 t003" x-target="thou afflict" x-target-head="t003" x-head="true" lemma="עָנָה" strong="H6031" x-morph="Vpi2ms" x-gloss="you.will.afflict" x-translit="ṯəʿanneh" xml:lang="hbo" x-source-ref="EXO.22.22">תְעַנֶּ֖ה</char> <char style="w" x-id="WLC.EXO.22.23.004" x-align="EXO.22.23.a004" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾōṯ" xml:lang="hbo" x-source-ref="EXO.22.22">אֹת֑</char><char style="w" x-id="WLC.EXO.22.23.005" x-align="EXO.22.23.a005" x-target-ids="t004" x-target="them" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo" x-source-ref="EXO.22.22">וֹ</char> <char style="w" x-id="WLC.EXO.22.23.006" x-align="EXO.22.23.a006" x-status="noncompositional" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo" x-source-ref="EXO.22.22">כִּ֣י</char> <char style="w" x-id="WLC.EXO.22.23.007" x-align="EXO.22.23.a006" x-status="noncompositional" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="EXO.22.22">אִם</char>־<char style="w" x-id="WLC.EXO.22.23.008" x-align="EXO.22.23.a007" x-target-ids="t010 t011" x-tar