	<para style="p"><verse number="29" style="v" x-ref="EXO.21.29" sid="EXO 21:29" /><char style="w" x-id="WLC.EXO.21.29.001" x-align="EXO.21.29.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.21.29.002" x-align="EXO.21.29.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim" xml:lang="hbo">אִ֡ם</char> <char style="w" x-id="WLC.EXO.21.29.003" x-align="EXO.21.29.a003" x-target-ids="t003 t004" x-target="the ox" x-target-head="t004" x-head="true" lemma="שׁוֹר" strong="H7794" x-morph="Ncmsa" x-gloss="[will.be].an.ox" x-translit="šôr" xml:lang="hbo">שׁוֹר֩</char> <char style="w" x-id="WLC.EXO.21.29.004" x-align="EXO.21.29.a004" x-target-ids="t005 t006 t007 t008" x-target="was wont to gore" x-target-head="t008" x-head="true" lemma="נַגָּח" strong="H5056" x-morph="Aamsa" x-gloss="prone.to.gore" x-translit="naggāḥ" xml:lang="hbo">נַגָּ֨ח</char> <char style="w" x-id="WLC.EXO.21.29.005" x-align="EXO.21.29.a005" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="hûʾ" xml:lang="hbo">ה֜וּא</char> <char style="w" x-id="WLC.EXO.21.29.006" x-align="EXO.21.29.a006" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.EXO.21.29.007" x-align="EXO.21.29.a007" x-status="noncompositional" x-target-ids="t010 t011" x-target="time past" x-target-head="t011" x-head="true" lemma="תְּמוֹל" strong="H8543" x-morph="D" x-gloss="yesterday" x-translit="təmōl" xml:lang="hbo">תְּמֹ֣ל</char> <char style="w" x-id="WLC.EXO.21.29.008" x-align="EXO.21.29.a007" x-status="noncompositional" lemma="שִׁלְשֹׁום" strong="H8032" x-morph="D" x-gloss="three.days.ago" x-translit="šilšōm" xml:la