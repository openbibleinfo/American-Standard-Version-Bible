	<para style="p"><verse number="3" style="v" x-ref="EXO.23.3" sid="EXO 23:3" /><char style="w" x-id="WLC.EXO.23.3.001" x-align="EXO.23.3.a001" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.23.3.002" x-align="EXO.23.3.a002" x-target-ids="t005 t006 t007" x-target="a poor man" x-target-head="t006" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="a.poor.[person]" x-translit="ḏāl" xml:lang="hbo">דָ֕ל</char> <char style="w" x-id="WLC.EXO.23.3.003" x-align="EXO.23.3.a001" x-status="noncompositional" x-target-ids="t001" x-target="neither" x-target-head="t001" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.EXO.23.3.004" x-align="EXO.23.3.a003" x-target-ids="t002 t003 t004" x-target="shalt thou favor" x-target-head="t004" x-head="true" lemma="הָדַר" strong="H1921" x-morph="Vqi2ms" x-gloss="you.must.honor" x-translit="ṯehdar" xml:lang="hbo">תֶהְדַּ֖ר</char> <char style="w" x-id="WLC.EXO.23.3.005" x-align="EXO.23.3.a004" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.EXO.23.3.006" x-align="EXO.23.3.a005" x-target-ids="t010" x-target="cause" x-target-head="t010" x-head="true" lemma="רִיב" strong="H7379" x-morph="Ncbsc" x-gloss="his.case" x-translit="riyḇ" xml:lang="hbo">רִיבֽ</char><char style="w" x-id="WLC.EXO.23.3.007" x-align="EXO.23.3.a006" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="at.law" x-translit="ô" xml:lang="hbo">וֹ</char>׃ס<verse eid="EXO 23:3" /></para>
