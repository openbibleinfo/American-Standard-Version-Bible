	<para style="p"><verse number="9" style="v" x-ref="EXO.1.9" sid="EXO 1:9" /><char style="w" x-id="WLC.EXO.1.9.001" x-align="EXO.1.9.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.EXO.1.9.002" x-align="EXO.1.9.a002" x-target-ids="t002 t003" x-target="he said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmer" xml:lang="hbo">יֹּ֖אמֶר</char> <char style="w" x-id="WLC.EXO.1.9.003" x-align="EXO.1.9.a003" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.EXO.1.9.004" x-align="EXO.1.9.a004" x-target-ids="t006" x-target="people" x-target-head="t006" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo">עַמּ֑</char><char style="w" x-id="WLC.EXO.1.9.005" x-align="EXO.1.9.a005" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.EXO.1.9.006" x-align="EXO.1.9.a006" x-target-ids="t007" x-target="Behold" x-target-head="t007" x-head="true" lemma="הִנֵּה" strong="H2009" x-morph="Tm" x-gloss="here!" x-translit="hinnēh" xml:lang="hbo">הִנֵּ֗ה</char> <char style="w" x-id="WLC.EXO.1.9.007" x-align="EXO.1.9.a007" x-target-ids="t008 t009" x-target="the people" x-target-head="t009" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="the.people" x-translit="ʿam" xml:lang="hbo">עַ֚ם</char> <char style="w" x-id="WLC.EXO.1.9.008" x-align="EXO.1.9.a008" x-target-ids="t010 t011 t012" x-target="of the children" x-target-head="t012" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="of.the.people" x-translit="bənēy" xml:la