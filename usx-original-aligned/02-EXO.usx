	<para style="p"><verse number="18" style="v" x-ref="EXO.22.18" sid="EXO 22:18" /><char style="w" x-id="WLC.EXO.22.18.001" x-align="EXO.22.18.a001" x-target-ids="t005 t006" x-target="a sorceress" x-target-head="t006" x-head="true" lemma="כָּשַׁף" strong="H3784" x-morph="Vprfsa" x-gloss="a.sorceress" x-translit="məḵaššēp̄āh" xml:lang="hbo" x-source-ref="EXO.22.17">מְכַשֵּׁפָ֖ה</char> <char style="w" x-id="WLC.EXO.22.18.002" x-align="EXO.22.18.a002" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="EXO.22.17">לֹ֥א</char> <char style="w" x-id="WLC.EXO.22.18.003" x-align="EXO.22.18.a003" x-target-ids="t001 t002 t004 t007 t008" x-target="Thou shalt suffer to live" x-target-head="t008" x-head="true" lemma="חָיָה" strong="H2421" x-morph="Vpi2ms" x-gloss="you.will.let.live" x-translit="ṯəḥayyeh:" xml:lang="hbo" x-source-ref="EXO.22.17">תְחַיֶּֽה</char>׃ס<verse eid="EXO 22:18" /></para>
	<para style="p"><verse number="19" style="v" x-ref="EXO.22.19" sid="EXO 22:19" /><char style="w" x-id="WLC.EXO.22.19.001" x-align="EXO.22.19.a001" x-target-ids="t001" x-target="Whosoever" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="any" x-translit="kol-" xml:lang="hbo" x-source-ref="EXO.22.18">כָּל</char>־<char style="w" x-id="WLC.EXO.22.19.002" x-align="EXO.22.19.a002" x-target-ids="t002" x-target="lieth" x-target-head="t002" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqrmsa" x-gloss="[one.who].lies" x-translit="šōḵēḇ" xml:lang="hbo" x-source-ref="EXO.22.18">שֹׁכֵ֥ב</char> <char style="w" x-id="WLC.EXO.22.19.003" x-align="EXO.22.19.a003" x-target-ids="t003" x-target="with" x-target-head="t003" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo" x-source-ref="EXO.22.18">עִם</char>־<char style="w" x-id="WLC.EXO.22.19.004" x-align="EXO.22.19.a004" x-target-ids="t004 t005" x-target="a beast" x-target-head="t005" x-head="true" lemma="בְּהֵמָה" strong="H929" x-morph="Ncfsa" x-gloss="an.animal" x-translit="bəhēmāh" xml:lang="hbo" x-source-ref="EXO.22.18">בְּהֵמָ֖ה</char> <char style="w" x-id="WLC.EXO.22.19.005" x-align="EXO.22.19.a005" x-target-ids="t007" x-target="surely" x-target-head="t007" x-head="true" lemma="מוּת" strong="H4191" x-morph="Vqa" x-gloss="surely.(die)" x-translit="môṯ" xml:lang="hbo" x-source-ref="EXO.22.18">מ֥וֹת</char> <char style="w" x-id="WLC.EXO.22.19.006" x-align="EXO.22.19.a006" x-target-ids="t006 t008 t009 t010 t011" x-target="shall be put to death" x-target-head="t011" x-head="true" lemma="מוּת" strong="H4191" x-morph="VHi3ms" x-gloss="he.will.be.put.to.death" x-translit="yûmāṯ:" xml:lang="hbo" x-source-ref="EXO.22.18">יוּמָֽת</char>׃ס<verse eid="EXO 22:19" /></para>
	<para style="p"><verse number="20" style="v" x-ref="EXO.22.20" sid="EXO 22:20" /><char style="w" x-id="WLC.EXO.22.20.001" x-align="EXO.22.20.a001" x-target-ids="t001 t002 t003" x-target="He that sacrificeth" x-target-head="t003" x-head="true" lemma="זָבַח" strong="H2076" x-morph="Vqrmsa" x-gloss="[one.who].sacrifices" x-translit="zōḇēᵃḥ" xml:lang="hbo" x-source-ref="EXO.22.19">זֹבֵ֥חַ</char> <char style="w" x-id="WLC.EXO.22.20.002" x-align="EXO.22.20.a002" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo" x-source-ref="EXO.22.19">לָ</char><char style="w" x-id="WLC.EXO.22.20.003" x-align="EXO.22.20.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo" x-source-ref="EXO.22.19">[הַ]</char><char style="w" x-id="WLC.EXO.22.20.004" x-align="EXO.22.20.a004" x-target-ids="t005 t006" x-target="any god" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="gods" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="EXO.22.19">אֱלֹהִ֖ים</char> <char style="w" x-id="WLC.EXO.22.20.005" x-align="EXO.22.20.a005" x-target-ids="t011 t012 t013 t014" x-target="shall be utterly destroyed" x-target-head="t014" x-head="true" lemma="חָרַם" strong="H2763" x-morph="VHi3ms" x-gloss="he.will.be.dedicated.to.destruction" x-translit="yāḥŏrām" xml:lang="hbo" x-source-ref="EXO.22.19">יָֽחֳרָ֑ם</char> <char style="w" x-id="WLC.EXO.22.20.006" x-align="EXO.22.20.a006" x-target-ids="t007" x-target="save" x-target-head="t007" x-head="true" lemma="בֵּלֶת" strong="H1115" x-morph="C" x-gloss="except" x-translit="biltiy" xml:lang="hbo" x-source-ref="EXO.22.19">בִּלְתִּ֥י</char> <char style="w" x-id="WLC.EXO.22.20.007" x-align="EXO.22.20.a007" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hb