	<para style="p"><verse number="10" style="v" x-ref="EXO.21.10" sid="EXO 21:10" /><char style="w" x-id="WLC.EXO.21.10.001" x-align="EXO.21.10.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.EXO.21.10.002" x-align="EXO.21.10.a002" x-target-ids="t005 t006" x-target="another wife" x-target-italic-ids="t006" x-target-head="t005" x-head="true" lemma="אַחֵר" strong="H312" x-morph="Aafsa" x-gloss="another.[woman]" x-translit="ʾaḥereṯ" xml:lang="hbo">אַחֶ֖רֶת</char> <char style="w" x-id="WLC.EXO.21.10.003" x-align="EXO.21.10.a003" x-target-ids="t002 t003" x-target="he take" x-target-head="t003" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqi3ms" x-gloss="he.will.take" x-translit="yiqqaḥ-" xml:lang="hbo">יִֽקַּֽח</char>־<char style="w" x-id="WLC.EXO.21.10.004" x-align="EXO.21.10.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.EXO.21.10.005" x-align="EXO.21.10.a005" x-target-ids="t004" x-target="him" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="himself" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.EXO.21.10.006" x-align="EXO.21.10.a006" x-target-ids="t008" x-target="food" x-target-head="t008" x-head="true" lemma="שְׁאֵר" strong="H7607" x-morph="Ncmsc" x-gloss="food" x-translit="šəʾēr" xml:lang="hbo">שְׁאֵרָ֛</char><char style="w" x-id="WLC.EXO.21.10.007" x-align="EXO.21.10.a007" x-target-ids="t007" x-target="her" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.EXO.21.10.008" x-align="EXO.21.10.a008" x-target-ids="t010" x-target="raiment" x-target-head="t010" x-head="true" lemma="כְּסוּת" strong="H3682" x-morph="Ncfsc" x-gloss="coverin