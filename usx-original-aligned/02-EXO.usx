	<para style="p"><verse number="26" style="v" x-ref="EXO.22.26" sid="EXO 22:26" /><char style="w" x-id="WLC.EXO.22.26.001" x-align="EXO.22.26.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo" x-source-ref="EXO.22.25">אִם</char>־<char style="w" x-id="WLC.EXO.22.26.002" x-align="EXO.22.26.a002" x-target-ids="t003 t004" x-target="at all" x-target-head="t004" x-head="true" lemma="חָבַל" strong="H2254" x-morph="Vqa" x-gloss="actually.(take.as.pledge)" x-translit="ḥāḇōl" xml:lang="hbo" x-source-ref="EXO.22.25">חָבֹ֥ל</char> <char style="w" x-id="WLC.EXO.22.26.003" x-align="EXO.22.26.a003" x-target-ids="t002 t005 t009 t010" x-target="thou take to pledge" x-target-head="t010" x-head="true" lemma="חָבַל" strong="H2254" x-morph="Vqi2ms" x-gloss="you.will.take.as.pledge" x-translit="taḥbōl" xml:lang="hbo" x-source-ref="EXO.22.25">תַּחְבֹּ֖ל</char> <char style="w" x-id="WLC.EXO.22.26.004" x-align="EXO.22.26.a004" x-target-ids="t008" x-target="garment" x-target-head="t008" x-head="true" lemma="שַׂלְמָה" strong="H8008" x-morph="Ncfsc" x-gloss="the.cloak" x-translit="śalmaṯ" xml:lang="hbo" x-source-ref="EXO.22.25">שַׂלְמַ֣ת</char> <char style="w" x-id="WLC.EXO.22.26.005" x-align="EXO.22.26.a005" x-target-ids="t007" x-target="neighbor’s" x-target-head="t007" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="your.neighbor" x-translit="rēʿ" xml:lang="hbo" x-source-ref="EXO.22.25">רֵעֶ֑</char><char style="w" x-id="WLC.EXO.22.26.006" x-align="EXO.22.26.a006" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo" x-source-ref="EXO.22.25">ךָ</char> <char style="w" x-id="WLC.EXO.22.26.007" x-align="EXO.22.26.a007" x-target-ids="t017" x-target="before" x-target-head="t017" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xm