	<para style="p"><verse number="6" style="v" x-ref="EXO.23.6" x-added-alignments="EXO.23.6.a004" x-added-target-ids="t007" x-added-target="due" sid="EXO 23:6" /><char style="w" x-id="WLC.EXO.23.6.001" x-align="EXO.23.6.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֥א</char> <char style="w" x-id="WLC.EXO.23.6.002" x-align="EXO.23.6.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt wrest" x-target-head="t004" x-head="true" lemma="נָטָה" strong="H5186" x-morph="Vhi2ms" x-gloss="you.must.turn.aside" x-translit="ṯaṭṭeh" xml:lang="hbo">תַטֶּ֛ה</char> <char style="w" x-id="WLC.EXO.23.6.003" x-align="EXO.23.6.a003" x-target-ids="t005 t006" x-target="the justice" x-target-head="t006" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsc" x-gloss="the.justice" x-translit="mišpaṭ" xml:lang="hbo">מִשְׁפַּ֥ט</char> <char style="w" x-id="WLC.EXO.23.6.004" x-align="EXO.23.6.a005" x-target-ids="t008 t010" x-target="to poor" x-target-head="t010" x-head="true" lemma="אֶבְיוֹן" strong="H34" x-morph="Aamsc" x-gloss="of" x-translit="ʾeḇyōn" xml:lang="hbo">אֶבְיֹנְ</char><char style="w" x-id="WLC.EXO.23.6.005" x-align="EXO.23.6.a006" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.needy.[person]" x-translit="əḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.EXO.23.6.006" x-align="EXO.23.6.a007" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.EXO.23.6.007" x-align="EXO.23.6.a008" x-target-ids="t013" x-target="cause" x-target-head="t013" x-head="true" lemma="רִיב" strong="H7379" x-morph="Ncbsc" x-gloss="his.case" x-translit="riyḇ" xml:lang="hbo">רִיבֽ</char><char style="w" x-id="WLC.EXO.23.6.008" x-align="EXO.23.6.a009" x-target-ids="t