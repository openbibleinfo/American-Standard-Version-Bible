	<para style="p"><verse number="21" style="v" x-ref="EXO.21.21" sid="EXO 21:21" /><char style="w" x-id="WLC.EXO.21.21.001" x-align="EXO.21.21.a001" x-target-ids="t001" x-target="Notwithstanding" x-target-head="t001" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="nevertheless" x-translit="ʾaḵ" xml:lang="hbo">אַ֥ךְ</char> <char style="w" x-id="WLC.EXO.21.21.002" x-align="EXO.21.21.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.EXO.21.21.003" x-align="EXO.21.21.a003" x-target-ids="t005 t006" x-target="a day" x-target-head="t006" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="a.day" x-translit="yôm" xml:lang="hbo">י֛וֹם</char> <char style="w" x-id="WLC.EXO.21.21.004" x-align="EXO.21.21.a004" x-target-ids="t007" x-target="or" x-target-head="t007" x-head="true" lemma="אוֹ" strong="H176" x-morph="C" x-gloss="or" x-translit="ʾô" xml:lang="hbo">א֥וֹ</char> <char style="w" x-id="WLC.EXO.21.21.005" x-align="EXO.21.21.a005" x-target-ids="t008" x-target="two" x-target-head="t008" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmda" x-gloss="two.days" x-translit="yômayim" xml:lang="hbo">יוֹמַ֖יִם</char> <char style="w" x-id="WLC.EXO.21.21.006" x-align="EXO.21.21.a006" x-target-ids="t003 t004" x-target="he continue" x-target-head="t004" x-head="true" lemma="עָמַד" strong="H5975" x-morph="Vqi3ms" x-gloss="he.will.remain" x-translit="yaʿămōḏ" xml:lang="hbo">יַעֲמֹ֑ד</char> <char style="w" x-id="WLC.EXO.21.21.007" x-align="EXO.21.21.a007" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.EXO.21.21.008" x-align="EXO.21.21.a008" x-target-ids="t009 t010 t012 t013" x-target="he shall be punished" x-target-head="t013" x-head="true" lemma="נָקַם" strong="H5358" 