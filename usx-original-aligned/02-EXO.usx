	<para style="p"><verse number="32" style="v" x-ref="EXO.23.32" sid="EXO 23:32" /><char style="w" x-id="WLC.EXO.23.32.001" x-align="EXO.23.32.a001" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.EXO.23.32.002" x-align="EXO.23.32.a002" x-target-ids="t001 t002 t003" x-target="Thou shalt make" x-target-head="t003" x-head="true" lemma="כָּרַת" strong="H3772" x-morph="Vqi2ms" x-gloss="you.must.make" x-translit="ṯiḵrōṯ" xml:lang="hbo">תִכְרֹ֥ת</char> <char style="w" x-id="WLC.EXO.23.32.003" x-align="EXO.23.32.a003" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.EXO.23.32.004" x-align="EXO.23.32.a004" x-target-ids="t007" x-target="them" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="āhem" xml:lang="hbo">הֶ֛ם</char> <char style="w" x-id="WLC.EXO.23.32.005" x-align="EXO.23.32.a005" x-target-ids="t008" x-target="nor" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.23.32.006" x-align="EXO.23.32.a006" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lē" xml:lang="hbo">לֵ</char><char style="w" x-id="WLC.EXO.23.32.007" x-align="EXO.23.32.a007" x-target-ids="t011" x-target="gods" x-target-head="t011" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpc" x-gloss="gods" x-translit="ʾlōhēy" xml:lang="hbo">אלֹֽהֵי</char><char style="w" x-id="WLC.EXO.23.32.008" x-align="EXO.23.32.a008" x-target-ids="t010" x-target="their" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="hem" xml:lang="hb