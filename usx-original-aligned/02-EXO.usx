	<para style="p"><verse number="21" style="v" x-ref="EXO.22.21" sid="EXO 22:21" /><char style="w" x-id="WLC.EXO.22.21.001" x-align="EXO.22.21.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="EXO.22.20">וְ</char><char style="w" x-id="WLC.EXO.22.21.002" x-align="EXO.22.21.a002" x-target-ids="t002 t003" x-target="a sojourner" x-target-head="t003" x-head="true" lemma="גֵּר" strong="H1616" x-morph="Ncmsa" x-gloss="a.sojourner" x-translit="ḡēr" xml:lang="hbo" x-source-ref="EXO.22.20">גֵ֥ר</char> <char style="w" x-id="WLC.EXO.22.21.003" x-align="EXO.22.21.a003" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="EXO.22.20">לֹא</char>־<char style="w" x-id="WLC.EXO.22.21.004" x-align="EXO.22.21.a004" x-target-ids="t004 t005 t007" x-target="shalt thou wrong" x-target-head="t007" x-head="true" lemma="יָנָה" strong="H3238" x-morph="Vhi2ms" x-gloss="you.must.maltreat" x-translit="ṯôneh" xml:lang="hbo" x-source-ref="EXO.22.20">תוֹנֶ֖ה</char> <char style="w" x-id="WLC.EXO.22.21.005" x-align="EXO.22.21.a005" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="EXO.22.20">וְ</char><char style="w" x-id="WLC.EXO.22.21.006" x-align="EXO.22.21.a005" x-target-ids="t008" x-target="neither" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="EXO.22.20">לֹ֣א</char> <char style="w" x-id="WLC.EXO.22.21.007" x-align="EXO.22.21.a006" x-target-ids="t009 t010 t011" x-target="shalt thou oppress" x-target-head="t011" x-head="true" lemma="לָחַץ" strong="H3905" x-morph="Vqi2ms" x-gloss="you" x-translit="ṯilḥāṣ" xml:lang="hbo" x-source-ref="EXO.22.20">תִלְחָצֶ֑</char><char style="w" x-id="WLC.EXO.22.21.008" x-align="EXO.22.21.a007" x-ta