	<para style="p"><verse number="2" style="v" x-ref="EXO.23.2" x-added-alignments="EXO.23.2.a005 EXO.23.2.a017" x-added-target-ids="t008 t025" x-added-target="do | justice" sid="EXO 23:2" /><char style="w" x-id="WLC.EXO.23.2.001" x-align="EXO.23.2.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.EXO.23.2.002" x-align="EXO.23.2.a002" x-status="noncompositional" x-target-ids="t001 t002 t004" x-target="Thou shalt follow" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi2ms" x-gloss="you.must.be" x-translit="ṯihyeh" xml:lang="hbo">תִהְיֶ֥ה</char> <char style="w" x-id="WLC.EXO.23.2.003" x-align="EXO.23.2.a002" x-status="noncompositional" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="after" x-translit="ʾaḥărēy-" xml:lang="hbo">אַחֲרֵֽי</char>־<char style="w" x-id="WLC.EXO.23.2.004" x-align="EXO.23.2.a003" x-target-ids="t005 t006" x-target="a multitude" x-target-head="t006" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbiym" xml:lang="hbo">רַבִּ֖ים</char> <char style="w" x-id="WLC.EXO.23.2.005" x-align="EXO.23.2.a004" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.EXO.23.2.006" x-align="EXO.23.2.a006" x-target-ids="t009" x-target="evil" x-target-head="t009" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfpa" x-gloss="wicked.deeds" x-translit="rāʿōṯ" xml:lang="hbo">רָעֹ֑ת</char> <char style="w" x-id="WLC.EXO.23.2.007" x-align="EXO.23.2.a007" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.23.2.008" x-align="EXO.23.2.a007" x-status="noncompositional" x-target-ids="t010" x-target="neither" x-target-head