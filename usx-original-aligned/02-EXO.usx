	<para style="p"><verse number="28" style="v" x-ref="EXO.22.28" sid="EXO 22:28" /><char style="w" x-id="WLC.EXO.22.28.001" x-align="EXO.22.28.a001" x-target-ids="t005" x-target="God" x-target-head="t005" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo" x-source-ref="EXO.22.27">אֱלֹהִ֖ים</char> <char style="w" x-id="WLC.EXO.22.28.002" x-align="EXO.22.28.a002" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo" x-source-ref="EXO.22.27">לֹ֣א</char> <char style="w" x-id="WLC.EXO.22.28.003" x-align="EXO.22.28.a003" x-target-ids="t001 t002 t004" x-target="Thou shalt revile" x-target-head="t004" x-head="true" lemma="קָלַל" strong="H7043" x-morph="Vpi2ms" x-gloss="you.must.curse" x-translit="ṯəqallēl" xml:lang="hbo" x-source-ref="EXO.22.27">תְקַלֵּ֑ל</char> <char style="w" x-id="WLC.EXO.22.28.004" x-align="EXO.22.28.a004" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="EXO.22.27">וְ</char><char style="w" x-id="WLC.EXO.22.28.005" x-align="EXO.22.28.a005" x-target-ids="t008 t009" x-target="a ruler" x-target-head="t009" x-head="true" lemma="נָשִׂיא" strong="H5387" x-morph="Ncmsa" x-gloss="a.leader" x-translit="nāśiyʾ" xml:lang="hbo" x-source-ref="EXO.22.27">נָשִׂ֥יא</char> <char style="w" x-id="WLC.EXO.22.28.006" x-align="EXO.22.28.a006" x-target-ids="t010" x-target="of" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="among" x-translit="ḇə" xml:lang="hbo" x-source-ref="EXO.22.27">בְ</char><char style="w" x-id="WLC.EXO.22.28.007" x-align="EXO.22.28.a007" x-target-ids="t012" x-target="people" x-target-head="t012" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsc" x-gloss="people" x-translit="ʿamm" xml:lang="hbo" x-source-ref="EXO.22.27">עַמְּ</char><char style="w" x-id="WLC.EXO.22.28.008" x-align="EXO.22.28.a008" x-target-ids