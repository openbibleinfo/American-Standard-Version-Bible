	<para style="p"><verse number="30" style="v" x-ref="EXO.21.30" sid="EXO 21:30" /><char style="w" x-id="WLC.EXO.21.30.001" x-align="EXO.21.30.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.EXO.21.30.002" x-align="EXO.21.30.a002" x-target-ids="t007 t008" x-target="a ransom" x-target-head="t008" x-head="true" lemma="כֹּפֶר" strong="H3724c" x-morph="Ncmsa" x-gloss="a.ransom" x-translit="kōp̄er" xml:lang="hbo">כֹּ֖פֶר</char> <char style="w" x-id="WLC.EXO.21.30.003" x-align="EXO.21.30.a003" x-target-ids="t002 t003 t004" x-target="there be laid" x-target-head="t004" x-head="true" lemma="שִׁית" strong="H7896" x-morph="VHi3ms" x-gloss="it.will.be.imposed" x-translit="yûšaṯ" xml:lang="hbo">יוּשַׁ֣ת</char> <char style="w" x-id="WLC.EXO.21.30.004" x-align="EXO.21.30.a004" x-target-ids="t005" x-target="on" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿālāy" xml:lang="hbo">עָלָ֑י</char><char style="w" x-id="WLC.EXO.21.30.005" x-align="EXO.21.30.a005" x-target-ids="t006" x-target="him" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.EXO.21.30.006" x-align="EXO.21.30.a006" x-target-ids="t009" x-target="then" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EXO.21.30.007" x-align="EXO.21.30.a007" x-target-ids="t010 t011 t012" x-target="he shall give" x-target-head="t012" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqq3ms" x-gloss="he.will.give" x-translit="nāṯan" xml:lang="hbo">נָתַן֙</char> <char style="w" x-id="WLC.EXO.21.30.008" x-align="EXO.21.30.a008" x-target-ids="t013 t014 t015" x-target="for the redemption" x-target-head="t015" x-head="true" lemma="פִּדְי