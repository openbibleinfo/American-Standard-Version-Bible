	<para style="p"><verse number="14" style="v" x-ref="EXO.23.14" sid="EXO 23:14" /><char style="w" x-id="WLC.EXO.23.14.001" x-align="EXO.23.14.a001" x-target-ids="t001" x-target="Three" x-target-head="t001" x-head="true" lemma="שָׁלֹשׁ" strong="H7969" x-morph="Acfsa" x-gloss="three" x-translit="šālōš" xml:lang="hbo">שָׁלֹ֣שׁ</char> <char style="w" x-id="WLC.EXO.23.14.002" x-align="EXO.23.14.a002" x-target-ids="t002" x-target="times" x-target-head="t002" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfpa" x-gloss="feet" x-translit="rəḡāliym" xml:lang="hbo">רְגָלִ֔ים</char> <char style="w" x-id="WLC.EXO.23.14.003" x-align="EXO.23.14.a003" x-target-ids="t003 t004 t005 t006 t007" x-target="thou shalt keep a feast" x-target-head="t007" x-head="true" lemma="חָגַג" strong="H2287" x-morph="Vqi2ms" x-gloss="you.will.celebrate.a.festival" x-translit="tāḥōḡ" xml:lang="hbo">תָּחֹ֥ג</char> <char style="w" x-id="WLC.EXO.23.14.004" x-align="EXO.23.14.a004" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לִ֖</char><char style="w" x-id="WLC.EXO.23.14.005" x-align="EXO.23.14.a005" x-target-ids="t009" x-target="me" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.EXO.23.14.006" x-align="EXO.23.14.a006" x-target-ids="t010" x-target="in" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.EXO.23.14.007" x-align="EXO.23.14.a007" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.EXO.23.14.008" x-align="EXO.23.14.a008" x-target-ids="t012" x-target="year" x-target-head="t012" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncf