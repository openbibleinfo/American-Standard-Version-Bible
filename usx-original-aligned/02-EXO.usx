	<para style="p"><verse number="29" style="v" x-ref="EXO.10.29" sid="EXO 10:29" /><char style="w" x-id="WLC.EXO.10.29.001" x-align="EXO.10.29.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.EXO.10.29.002" x-align="EXO.10.29.a002" x-target-ids="t003" x-target="said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqw3ms" x-gloss="he.said" x-translit="yyōʾmer" xml:lang="hbo">יֹּ֥אמֶר</char> <char style="w" x-id="WLC.EXO.10.29.003" x-align="EXO.10.29.a003" x-target-ids="t002" x-target="Moses" x-target-head="t002" x-head="true" lemma="מֹשֶׁה" strong="H4872" x-morph="Np" x-gloss="Moses" x-translit="mōšeh" xml:lang="hbo">מֹשֶׁ֖ה</char> <char style="w" x-id="WLC.EXO.10.29.004" x-align="EXO.10.29.a004" x-target-ids="t007" x-target="well" x-target-head="t007" x-head="true" lemma="כֵּן" strong="H3651a" x-morph="Tm" x-gloss="right" x-translit="kēn" xml:lang="hbo">כֵּ֣ן</char> <char style="w" x-id="WLC.EXO.10.29.005" x-align="EXO.10.29.a005" x-target-ids="t004 t005 t006" x-target="Thou hast spoken" x-target-head="t006" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpp2ms" x-gloss="you.have.spoken" x-translit="dibbarətā" xml:lang="hbo">דִּבַּ֑רְתָּ</char> <char style="w" x-id="WLC.EXO.10.29.006" x-align="EXO.10.29.a006" x-status="noncompositional" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.EXO.10.29.007" x-align="EXO.10.29.a006" x-status="noncompositional" x-target-ids="t014 t015" x-target="no more" x-target-head="t015" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhi1cs" x-gloss="I.will.repeat" x-translit="ʾōsip̄" xml:lang="hbo">אֹסִ֥ף</char> <char style="w" x-id="WLC.EXO.10.29.008" x-align="EXO.10.29.a007" x-target-ids="t013" x-target="again" x-target-head="t013" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" 