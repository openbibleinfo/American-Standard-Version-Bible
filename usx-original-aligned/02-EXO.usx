	<para style="p"><verse number="8" style="v" x-ref="EXO.1.8" sid="EXO 1:8" /><char style="w" x-id="WLC.EXO.1.8.001" x-align="EXO.1.8.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.EXO.1.8.002" x-align="EXO.1.8.a002" x-target-ids="t002 t003" x-target="there arose" x-target-head="t003" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqw3ms" x-gloss="he.arose" x-translit="yyāqām" xml:lang="hbo">יָּ֥קָם</char> <char style="w" x-id="WLC.EXO.1.8.003" x-align="EXO.1.8.a003" x-target-ids="t004 t006" x-target="a king" x-target-head="t006" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="a.king" x-translit="meleḵ-" xml:lang="hbo">מֶֽלֶךְ</char>־<char style="w" x-id="WLC.EXO.1.8.004" x-align="EXO.1.8.a004" x-target-ids="t005" x-target="new" x-target-head="t005" x-head="true" lemma="חָדָשׁ" strong="H2319" x-morph="Aamsa" x-gloss="new" x-translit="ḥāḏāš" xml:lang="hbo">חָדָ֖שׁ</char> <char style="w" x-id="WLC.EXO.1.8.005" x-align="EXO.1.8.a005" x-target-ids="t007" x-target="over" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="over" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.EXO.1.8.006" x-align="EXO.1.8.a006" x-target-ids="t008" x-target="Egypt" x-target-head="t008" x-head="true" lemma="מִצְרַיִם" strong="H4714" x-morph="Np" x-gloss="Egypt" x-translit="miṣrāyim" xml:lang="hbo">מִצְרָ֑יִם</char> <char style="w" x-id="WLC.EXO.1.8.007" x-align="EXO.1.8.a007" x-target-ids="t009" x-target="who" x-target-head="t009" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="who" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֥ר</char> <char style="w" x-id="WLC.EXO.1.8.008" x-align="EXO.1.8.a008" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</c