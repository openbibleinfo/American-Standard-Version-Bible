	<para style="p"><verse number="4" style="v" x-ref="DAN.12.4" sid="DAN 12:4" /><char style="w" x-id="WLC.DAN.12.4.001" x-align="DAN.12.4.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.DAN.12.4.002" x-align="DAN.12.4.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֣ה</char> <char style="w" x-id="WLC.DAN.12.4.003" x-align="DAN.12.4.a003" x-target-ids="t003 t004" x-target="O Daniel" x-target-head="t004" x-head="true" lemma="דָּנִיֵּאל" strong="H1840" x-morph="Np" x-gloss="O.Daniel" x-translit="ḏāniyyēʾl" xml:lang="hbo">דָֽנִיֵּ֗אל</char> <char style="w" x-id="WLC.DAN.12.4.004" x-align="DAN.12.4.a004" x-target-ids="t005 t006" x-target="shut up" x-target-head="t005" x-head="true" lemma="סָתַם" strong="H5640" x-morph="Vqv2ms" x-gloss="keep.secret" x-translit="səṯōm" xml:lang="hbo">סְתֹ֧ם</char> <char style="w" x-id="WLC.DAN.12.4.005" x-align="DAN.12.4.a005" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.DAN.12.4.006" x-align="DAN.12.4.a006" x-target-ids="t008" x-target="words" x-target-head="t008" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpa" x-gloss="words" x-translit="dəḇāriym" xml:lang="hbo">דְּבָרִ֛ים</char> <char style="w" x-id="WLC.DAN.12.4.007" x-align="DAN.12.4.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.DAN.12.4.008" x-align="DAN.12.4.a008" x-target-ids="t010" x-target="seal" x-target-head="t010" x-head="true" lemma="חָתַם" strong="H2856" x-morph="Vqv2ms" x-gloss="seal.up" x-translit="ḥăṯōm