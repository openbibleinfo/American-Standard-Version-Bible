	<para style="p"><verse number="17" style="v" x-ref="HEB.9.17" sid="HEB 9:17" /><char style="w" x-id="SBLGNT.HEB.9.17.001" x-align="HEB.9.17.a002" x-target-ids="t002 t003" x-target="a testament" x-target-head="t003" x-head="true" lemma="διαθήκη" strong="G1242" x-morph="N-NSF" x-gloss="A will" x-translit="diathēkē" xml:lang="grc">διαθήκη</char> <char style="w" x-id="SBLGNT.HEB.9.17.002" x-align="HEB.9.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.9.17.003" x-align="HEB.9.17.a004" x-target-ids="t007 t008 t009 t010" x-target="where there hath been" x-target-head="t007" x-head="true" lemma="ἐπί" strong="G1909" x-morph="PREP" x-gloss="after" x-translit="epi" xml:lang="grc">ἐπὶ</char> <char style="w" x-id="SBLGNT.HEB.9.17.004" x-align="HEB.9.17.a005" x-target-ids="t011" x-target="death" x-target-head="t011" x-head="true" lemma="νεκρός" strong="G3498" x-morph="A-DPM" x-gloss="death" x-translit="nekrois" xml:lang="grc">νεκροῖς</char> <char style="w" x-id="SBLGNT.HEB.9.17.005" x-align="HEB.9.17.a003" x-target-ids="t004 t005 t006" x-target="is of force" x-target-head="t006" x-head="true" lemma="βέβαιος" strong="G949" x-morph="A-NSF" x-gloss="[is] affirmed" x-translit="bebaia" xml:lang="grc">βεβαία</char>,<char style="w" x-id="SBLGNT.HEB.9.17.006" x-align="HEB.9.17.a006" x-target-ids="t012" x-target="for" x-target-head="t012" x-head="true" lemma="ἐπεί" strong="G1893" x-morph="CONJ" x-gloss="since" x-translit="epei" xml:lang="grc">ἐπεὶ</char> <char style="w" x-id="SBLGNT.HEB.9.17.007" x-align="HEB.9.17.a008" x-target-ids="t015" x-target="never" x-target-head="t015" x-head="true" lemma="μήποτε" strong="G3379" x-morph="ADV" x-translit="mēpote" xml:lang="grc">μήποτε</char> <char style="w" x-id="SBLGNT.HEB.9.17.008" x-align="HEB.9.17.a007" x-target-ids="t013 t014 t016" x-target="it doth avail" x-target-head="t016" x-hea