	<para style="p"><verse number="15" style="v" x-ref="HEB.6.15" sid="HEB 6:15" /><char style="w" x-id="SBLGNT.HEB.6.15.001" x-align="HEB.6.15.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.6.15.002" x-align="HEB.6.15.a002" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="thus" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.HEB.6.15.003" x-align="HEB.6.15.a003" x-target-ids="t003 t004 t005" x-target="having patiently endured" x-target-head="t004" x-head="true" lemma="μακροθυμέω" strong="G3114" x-morph="V-AAP-NSM" x-gloss="having waited patiently" x-translit="makrothymēsas" xml:lang="grc">μακροθυμήσας</char> <char style="w" x-id="SBLGNT.HEB.6.15.004" x-align="HEB.6.15.a004" x-target-ids="t006 t007" x-target="he obtained" x-target-head="t007" x-head="true" lemma="ἐπιτυγχάνω" strong="G2013" x-morph="V-2AAI-3S" x-gloss="he obtained" x-translit="epetychen" xml:lang="grc">ἐπέτυχεν</char> <char style="w" x-id="SBLGNT.HEB.6.15.005" x-align="HEB.6.15.a005" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.HEB.6.15.006" x-align="HEB.6.15.a006" x-target-ids="t009" x-target="promise" x-target-head="t009" x-head="true" lemma="ἐπαγγελία" strong="G1860" x-morph="N-GSF" x-gloss="promise" x-translit="epangelias" xml:lang="grc">ἐπαγγελίας</char>.<verse eid="HEB 6:15" /></para>
