	<para style="p"><verse number="28" style="v" x-ref="HEB.9.28" sid="HEB 9:28" /><char style="w" x-id="SBLGNT.HEB.9.28.001" x-align="HEB.9.28.a001" x-target-ids="t001" x-target="so" x-target-head="t001" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="so" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.HEB.9.28.002" x-align="HEB.9.28.a002" x-target-ids="t003" x-target="also" x-target-head="t003" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="also" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.9.28.003" x-align="HEB.9.28.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.HEB.9.28.004" x-align="HEB.9.28.a004" x-target-ids="t002" x-target="Christ" x-target-head="t002" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-NSM" x-gloss="Christ" x-translit="Christos" xml:lang="grc">Χριστός</char>,<char style="w" x-id="SBLGNT.HEB.9.28.005" x-align="HEB.9.28.a005" x-target-ids="t006" x-target="once" x-target-head="t006" x-head="true" lemma="ἅπαξ" strong="G530" x-morph="ADV" x-gloss="once" x-translit="hapax" xml:lang="grc">ἅπαξ</char> <char style="w" x-id="SBLGNT.HEB.9.28.006" x-align="HEB.9.28.a006" x-target-ids="t004 t005 t007" x-target="having been offered" x-target-head="t007" x-head="true" lemma="προσφέρω" strong="G4374" x-morph="V-APP-NSM" x-gloss="having been offered" x-translit="prosenechtheis" xml:lang="grc">προσενεχθεὶς</char> <char style="w" x-id="SBLGNT.HEB.9.28.007" x-align="HEB.9.28.a007" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="in order" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.HEB.9.28.008" x-align="HEB.9.28.a008" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</cha