	<para style="p"><verse number="1" style="v" x-ref="HEB.11.1" sid="HEB 11:1" /><char style="w" x-id="SBLGNT.HEB.11.1.001" x-align="HEB.11.1.a003" x-target-ids="t003" x-target="is" x-target-head="t003" x-head="true" lemma="εἰμί" strong="G2076" x-morph="V-PAI-3S" x-gloss="Is" x-translit="Estin" xml:lang="grc">Ἔστιν</char> <char style="w" x-id="SBLGNT.HEB.11.1.002" x-align="HEB.11.1.a001" x-target-ids="t001" x-target="Now" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.HEB.11.1.003" x-align="HEB.11.1.a002" x-target-ids="t002" x-target="faith" x-target-head="t002" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-NSF" x-gloss="faith" x-translit="pistis" xml:lang="grc">πίστις</char> <char style="w" x-id="SBLGNT.HEB.11.1.004" x-align="HEB.11.1.a005" x-target-ids="t005 t006 t007 t008" x-target="of things hoped for" x-target-italic-ids="t006" x-target-head="t007" x-head="true" lemma="ἐλπίζω" strong="G1679" x-morph="V-PPP-GPN" x-gloss="of [things] hoped for" x-translit="elpizomenōn" xml:lang="grc">ἐλπιζομένων</char> <char style="w" x-id="SBLGNT.HEB.11.1.005" x-align="HEB.11.1.a004" x-target-ids="t004" x-target="assurance" x-target-head="t004" x-head="true" lemma="ὑπόστασις" strong="G5287" x-morph="N-NSF" x-gloss="[the] assurance" x-translit="hypostasis" xml:lang="grc">ὑπόστασις</char>,<char style="w" x-id="SBLGNT.HEB.11.1.006" x-align="HEB.11.1.a007" x-target-ids="t011 t012" x-target="of things" x-target-head="t012" x-head="true" lemma="πρᾶγμα" strong="G4229" x-morph="N-GPN" x-gloss="of things" x-translit="pragmatōn" xml:lang="grc">πραγμάτων</char> <char style="w" x-id="SBLGNT.HEB.11.1.007" x-align="HEB.11.1.a006" x-target-ids="t009 t010" x-target="a conviction" x-target-head="t010" x-head="true" lemma="ἔλεγχος" strong="G1650" x-morph="N-NSM" x-gloss="[the] conviction" x-translit="elenchos" xml:lang="grc">ἔλεγχος</char> <char style="w" x-id="SBLGNT.HEB.11.1.008" x-align="HEB.11.1.a008" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.HEB.11.1.009" x-align="HEB.11.1.a009" x-target-ids="t014" x-target="seen" x-target-head="t014" x-head="true" lemma="βλέπω" strong="G991" x-morph="V-PPP-GPN" x-gloss="being seen" x-translit="blepomenōn" xml:lang="grc">βλεπομένων</char>·<verse eid="HEB 11:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="HEB.11.2" sid="HEB 11:2" /><char style="w" x-id="SBLGNT.HEB.11.2.001" x-align="HEB.11.2.a002" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="In" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.HEB.11.2.002" x-align="HEB.11.2.a002" x-target-ids="t002" x-target="therein" x-target-head="t002" x-head="true" lemma="οὗτος" strong="G5026" x-morph="D-DSF" x-gloss="this" x-translit="tautēi" xml:lang="grc">ταύτῃ</char> <char style="w" x-id="SBLGNT.HEB.11.2.003" x-align="HEB.11.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.11.2.004" x-align="HEB.11.2.a005" x-target-ids="t005 t006 t007 t008 t009" x-target="had witness borne to them" x-target-head="t006" x-head="true" lemma="μαρτυρέω" strong="G3140" x-morph="V-API-3P" x-gloss="were commended" x-translit="emartyrēthēsan" xml:lang="grc">ἐμαρτυρήθησαν</char> <char style="w" x-id="SBLGNT.HEB.11.2.005" x-align="HEB.11.2.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="the" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.HEB.11.2.006" x-align="HEB.11.2.a004" x-target-ids="t004" x-target="elders" x-target-head="t004" x-head="true" lemma="πρεσβύτερος" strong="G4245" x-morph="A-NPM-C" x-gloss="ancients" x-translit="presbyteroi" xml:lang="grc">πρεσβύτεροι</char>.<verse eid="HEB 11:2" /></para>
	<para style="p"><verse number="3" style="v" x-ref="HEB.11.3" sid="HEB 11:3" /><char style="w" x-id="SBLGNT.HEB.11.3.001" x-align="HEB.11.3.a001" x-target-ids="t001 t002" x-target="By faith" x-target-head="t002" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-DSF" x-gloss="By faith" x-translit="pistei" xml:lang="grc">πίστει</char> <char style="w" x-id="SBLGNT.HEB.11.3.002" x-align="HEB.11.3.a002" x-target-ids="t003 t004" x-target="we understand" x-target-head="t004" x-head="true" lemma="νοέω" strong="G3539" x-morph="V-PAI-1P" x-gloss="we understand" x-translit="nooumen" xml:lang="grc">νοοῦμεν</char> <char style="w" x-id="SBLGNT.HEB.11.3.003" x-align="HEB.11.3.a003" x-target-ids="t005 t008 t009 t010" x-target="that have been framed" x-target-head="t010" x-head="true" lemma="καταρτίζω" strong="G2675" x-morph="V-RPN" x-gloss="to have been formed" x-translit="katērtisthai" xml:lang="grc">κατηρτίσθαι</char> <char style="w" x-id="SBLGNT.HEB.11.3.004" x-align="HEB.11.3.a004" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APM" x-gloss="the" x-translit="tous" xml:lang="grc">τοὺς</char> <char style="w" x-id="SBLGNT.HEB.11.3.005" x-align="HEB.11.3.a005" x-target-ids="t007" x-target="worlds" x-target-head="t007" x-head="true" lemma="αἰών" strong="G165" x-morph="N-APM" x-gloss="universe" x-translit="aiōnas" xml:lang="grc">αἰῶνας</char> <char style="w" x-id="SBLGNT.HEB.11.3.006" x-align="HEB.11.3.a006" x-target-ids="t011 t012 t013" x-target="by the word" x-target-head="t013" x-head="true" lemma="ῥῆμα" strong="G4487" x-morph="N-DSN" x-gloss="by [the] word" x-translit="rhēmati" xml:lang="grc">ῥήματι</char> <char style="w" x-id="SBLGNT.HEB.11.3.007" x-align="HEB.11.3.a007" x-target-ids="t014 t015" x-target="of God" x-target-head="t015" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char>,<char style="w" x-id="SBLGNT.HEB.11.3.008" x-align="HEB.11.3.a008" x-target-ids="t016 t017" x-target="so that" x-target-head="t016" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="so that" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.HEB.11.3.009" x-align="HEB.11.3.a009" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="which" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.HEB.11.3.010" x-align="HEB.11.3.a013" x-target-ids="t022" x-target="not" x-target-head="t022" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.HEB.11.3.011" x-align="HEB.11.3.a014" x-target-ids="t025 t026" x-target="out of" x-target-head="t025" x-head="true" lemma="ἐκ" strong="G1537" x-morph="PREP" x-gloss="from [things]" x-translit="ek" xml:lang="grc">ἐκ</char> <char style="w" x-id="SBLGNT.HEB.11.3.012" x-align="HEB.11.3.a015" x-target-ids="t027 t028 t029" x-target="things which appear" x-target-head="t029" x-head="true" lemma="φαίνω" strong="G5316" x-morph="V-PEP-GPN" x-gloss="being visible" x-translit="phainomenōn" xml:lang="grc">φαινομένων</char> <char style="w" x-id="SBLGNT.HEB.11.3.013" x-align="HEB.11.3.a010" x-target-ids="t018" x-target="what" x-target-head="t018" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="the things" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.HEB.11.3.014" x-align="HEB.11.3.a011" x-target-ids="t019 t020" x-target="is seen" x-target-head="t020" x-head="true" lemma="βλέπω" strong="G991" x-morph="V-PPP-ASN" x-gloss="being seen" x-translit="blepomenon" xml:lang="grc">βλεπόμενον</char> <char style="w" x-id="SBLGNT.HEB.11.3.015" x-align="HEB.11.3.a012" x-target-ids="t021 t023 t024" x-target="hath been made" x-target-head="t024" x-head="true" lemma="γίνομαι" strong="G1096" x-morph="V-2RAN" x-gloss="have been made" x-translit="gegonenai" xml:lang="grc">γεγονέναι</char>.<verse eid="HEB 11:3" /></para>
	<para style="p"><verse number="4" style="v" x-ref="HEB.11.4" sid="HEB 11:4" /><char style="w" x-id="SBLGNT.HEB.11.4.001" x-align="HEB.11.4.a001" x-target-ids="t001 t002" x-target="By faith" x-target-head="t002" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-DSF" x-gloss="By faith" x-translit="Pistei" xml:lang="grc">Πίστει</char> <char style="w" x-id="SBLGNT.HEB.11.4.002" x-align="HEB.11.4.a006" x-target-ids="t008 t009" x-target="more excellent" x-target-head="t009" x-head="true" lemma="πολύς" strong="G4119" x-morph="A-ASF-C" x-gloss="a more excellent" x-translit="pleiona" xml:lang="grc">πλείονα</char> <char style="w" x-id="SBLGNT.HEB.11.4.003" x-align="HEB.11.4.a007" x-target-ids="t007 t010" x-target="a sacrifice" x-target-head="t010" x-head="true" lemma="θυσία" strong="G2378" x-morph="N-ASF" x-gloss="sacrifice" x-translit="thysian" xml:lang="grc">θυσίαν</char> <char style="w" x-id="SBLGNT.HEB.11.4.004" x-align="HEB.11.4.a002" x-target-ids="t003" x-target="Abel" x-target-head="t003" x-head="true" lemma="Ἅβελ" strong="G6" x-morph="N-PRI" x-gloss="Abel" x-translit="Habel" xml:lang="grc">Ἅβελ</char> <char style="w" x-id="SBLGNT.HEB.11.4.005" x-align="HEB.11.4.a008" x-target-ids="t011" x-target="than" x-target-head="t011" x-head="true" lemma="παρά" strong="G3844" x-morph="PREP" x-gloss="than" x-translit="para" xml:lang="grc">παρὰ</char> <char style="w" x-id="SBLGNT.HEB.11.4.006" x-align="HEB.11.4.a009" x-target-ids="t012" x-target="Cain" x-target-head="t012" x-head="true" lemma="Κάϊν" strong="G2535" x-morph="N-PRI" x-gloss="Cain" x-translit="Kain" xml:lang="grc">Κάϊν</char> <char style="w" x-id="SBLGNT.HEB.11.4.007" x-align="HEB.11.4.a003" x-target-ids="t004" x-target="offered" x-target-head="t004" x-head="true" lemma="προσφέρω" strong="G4374" x-morph="V-AAI-3S" x-gloss="offered" x-translit="prosēnenken" xml:lang="grc">προσήνεγκεν</char> <char style="w" x-id="SBLGNT.HEB.11.4.008" x-align="HEB.11.4.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G