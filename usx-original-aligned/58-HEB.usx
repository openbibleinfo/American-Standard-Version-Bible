	<para style="p"><verse number="10" style="v" x-ref="HEB.10.10" sid="HEB 10:10" /><char style="w" x-id="SBLGNT.HEB.10.10.001" x-align="HEB.10.10.a001" x-target-ids="t001" x-target="By" x-target-head="t001" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="By" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.HEB.10.10.002" x-align="HEB.10.10.a002" x-target-ids="t002" x-target="which" x-target-head="t002" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-DSN" x-gloss="that" x-translit="hōi" xml:lang="grc">ᾧ</char> <char style="w" x-id="SBLGNT.HEB.10.10.003" x-align="HEB.10.10.a003" x-target-ids="t003" x-target="will" x-target-head="t003" x-head="true" lemma="θέλημα" strong="G2307" x-morph="N-DSN" x-gloss="will" x-translit="thelēmati" xml:lang="grc">θελήματι</char> <char style="w" x-id="SBLGNT.HEB.10.10.004" x-align="HEB.10.10.a005" x-target-ids="t005 t006 t007" x-target="have been sanctified" x-target-head="t007" x-head="true" lemma="ἁγιάζω" strong="G37" x-morph="V-RPP-NPM" x-gloss="having been sanctified" x-translit="hēgiasmenoi" xml:lang="grc">ἡγιασμένοι</char> <char style="w" x-id="SBLGNT.HEB.10.10.005" x-align="HEB.10.10.a004" x-target-ids="t004" x-target="we" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2070" x-morph="V-PAI-1P" x-gloss="we are" x-translit="esmen" xml:lang="grc">ἐσμὲν</char> <char style="w" x-id="SBLGNT.HEB.10.10.006" x-align="HEB.10.10.a006" x-target-ids="t008" x-target="through" x-target-head="t008" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="through" x-translit="dia" xml:lang="grc">διὰ</char> <char style="w" x-id="SBLGNT.HEB.10.10.007" x-align="HEB.10.10.a007" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSF" x-gloss="the" x-translit="tēs" xml:lang="grc">τῆς</char> <char style="w" x-id="SBLGNT.HEB.10.10.008" x-align="HEB.10.10.a008" x-target-ids="t010" x-target="offering" x-target-head="t010" x-head="true" lemma="προ