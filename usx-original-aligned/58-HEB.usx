	<para style="p"><verse number="27" style="v" x-ref="HEB.9.27" sid="HEB 9:27" /><char style="w" x-id="SBLGNT.HEB.9.27.001" x-align="HEB.9.27.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.9.27.002" x-align="HEB.9.27.a002" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="in" x-translit="kath" xml:lang="grc">καθ</char>ʼ<char style="w" x-id="SBLGNT.HEB.9.27.003" x-align="HEB.9.27.a002" x-target-ids="t002 t003" x-target="inasmuch as" x-target-head="t002" x-head="true" lemma="ὅσος" strong="G3745" x-morph="K-ASN" x-gloss="as much as" x-translit="hoson" xml:lang="grc">ὅσον</char> <char style="w" x-id="SBLGNT.HEB.9.27.004" x-align="HEB.9.27.a003" x-target-ids="t004 t005 t006" x-target="it is appointed" x-target-head="t006" x-head="true" lemma="ἀπόκειμαι" strong="G606" x-morph="V-PNI-3S" x-gloss="it is apportioned" x-translit="apokeitai" xml:lang="grc">ἀπόκειται</char> <char style="w" x-id="SBLGNT.HEB.9.27.005" x-align="HEB.9.27.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPM" x-gloss="-" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.HEB.9.27.006" x-align="HEB.9.27.a005" x-target-ids="t007 t008" x-target="unto men" x-target-head="t008" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-DPM" x-gloss="to men" x-translit="anthrōpois" xml:lang="grc">ἀνθρώποις</char> <char style="w" x-id="SBLGNT.HEB.9.27.007" x-align="HEB.9.27.a006" x-target-ids="t009" x-target="once" x-target-head="t009" x-head="true" lemma="ἅπαξ" strong="G530" x-morph="ADV" x-gloss="once" x-translit="hapax" xml:lang="grc">ἅπαξ</char> <char style="w" x-id="SBLGNT.HEB.9.27.008" x-align="HEB.9.27.a007" x-target-ids="t010 t011" x-target="to die" x-target-head="t011" x-head="true" lemma="ἀποθνῄσκω" strong="G599" x-morph="V-2AAN" x-gloss="to die" x-translit="apothanein" xml:lang="grc">ἀπ