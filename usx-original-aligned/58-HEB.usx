	<para style="p"><verse number="14" style="v" x-ref="HEB.6.14" sid="HEB 6:14" /><char style="w" x-id="SBLGNT.HEB.6.14.001" x-align="HEB.6.14.a001" x-target-ids="t001" x-target="saying" x-target-head="t001" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NSM" x-gloss="saying" x-translit="legōn" xml:lang="grc">λέγων</char>·<char style="w" x-id="SBLGNT.HEB.6.14.002" x-align="HEB.6.14.a002" lemma="εἰ" strong="G2229" x-morph="COND" x-gloss="If" x-translit="Ei" xml:lang="grc">Εἰ</char> <char style="w" x-id="SBLGNT.HEB.6.14.003" x-align="HEB.6.14.a002" x-target-ids="t002" x-target="Surely" x-target-head="t002" x-head="true" lemma="μήν" strong="G3375" x-morph="PRT" x-gloss="surely" x-translit="mēn" xml:lang="grc">μὴν</char> <char style="w" x-id="SBLGNT.HEB.6.14.004" x-align="HEB.6.14.a003" x-target-ids="t003" x-target="blessing" x-target-head="t003" x-head="true" lemma="εὐλογέω" strong="G2127" x-morph="V-PAP-NSM" x-gloss="blessing" x-translit="eulogōn" xml:lang="grc">εὐλογῶν</char> <char style="w" x-id="SBLGNT.HEB.6.14.005" x-align="HEB.6.14.a004" x-target-ids="t004 t005 t006" x-target="I will bless" x-target-head="t006" x-head="true" lemma="εὐλογέω" strong="G2127" x-morph="V-FAI-1S" x-gloss="I will bless" x-translit="eulogēsō" xml:lang="grc">εὐλογήσω</char> <char style="w" x-id="SBLGNT.HEB.6.14.006" x-align="HEB.6.14.a005" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.HEB.6.14.007" x-align="HEB.6.14.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.6.14.008" x-align="HEB.6.14.a007" x-target-ids="t009" x-target="multiplying" x-target-head="t009" x-head="true" lemma="πληθύνω" strong="G4129" x-morph="V-PAP-NSM" x-gloss="multiplying" x-translit="plēthynōn" xml:lang