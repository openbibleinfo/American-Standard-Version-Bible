	<para style="p"><verse number="14" style="v" x-ref="HEB.11.14" sid="HEB 11:14" /><char style="w" x-id="SBLGNT.HEB.11.14.001" x-align="HEB.11.14.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="Those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.HEB.11.14.002" x-align="HEB.11.14.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.11.14.003" x-align="HEB.11.14.a004" x-target-ids="t005 t006" x-target="such things" x-target-head="t005" x-head="true" lemma="τοιοῦτος" strong="G5108" x-morph="D-APN" x-gloss="such things" x-translit="toiauta" xml:lang="grc">τοιαῦτα</char> <char style="w" x-id="SBLGNT.HEB.11.14.004" x-align="HEB.11.14.a003" x-target-ids="t003 t004" x-target="that say" x-target-head="t004" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAP-NPM" x-gloss="saying" x-translit="legontes" xml:lang="grc">λέγοντες</char> <char style="w" x-id="SBLGNT.HEB.11.14.005" x-align="HEB.11.14.a005" x-target-ids="t007 t008 t009" x-target="make it manifest" x-target-head="t009" x-head="true" lemma="ἐμφανίζω" strong="G1718" x-morph="V-PAI-3P" x-gloss="make manifest" x-translit="emphanizousin" xml:lang="grc">ἐμφανίζουσιν</char> <char style="w" x-id="SBLGNT.HEB.11.14.006" x-align="HEB.11.14.a006" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that [their]" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.HEB.11.14.007" x-align="HEB.11.14.a008" x-target-ids="t015 t016 t017 t018 t019" x-target="a country of their own" x-target-head="t016" x-head="true" lemma="πατρίς" strong="G3968" x-morph="N-ASF" x-gloss="own country" x-translit="patrida" xml:lang="grc">πατρίδα</char> <char style="w" x-id="SBLGNT.HEB.11.14.008" x-align="HEB