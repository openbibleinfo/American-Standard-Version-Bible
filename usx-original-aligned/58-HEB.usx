	<para style="p"><verse number="22" style="v" x-ref="HEB.12.22" sid="HEB 12:22" /><char style="w" x-id="SBLGNT.HEB.12.22.001" x-align="HEB.12.22.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.HEB.12.22.002" x-align="HEB.12.22.a002" x-target-ids="t002 t003 t004" x-target="ye are come" x-target-head="t004" x-head="true" lemma="προσέρχομαι" strong="G4334" x-morph="V-2RAI-2P" x-gloss="you have come to" x-translit="proselēlythate" xml:lang="grc">προσεληλύθατε</char> <char style="w" x-id="SBLGNT.HEB.12.22.003" x-align="HEB.12.22.a003" x-target-ids="t007" x-target="Zion" x-target-head="t007" x-head="true" lemma="Σιών" strong="G4622" x-morph="N-PRI" x-gloss="Zion" x-translit="Siōn" xml:lang="grc">Σιὼν</char> <char style="w" x-id="SBLGNT.HEB.12.22.004" x-align="HEB.12.22.a004" x-target-ids="t005 t006" x-target="unto mount" x-target-head="t006" x-head="true" lemma="ὄρος" strong="G3735" x-morph="N-DSN" x-gloss="Mount" x-translit="orei" xml:lang="grc">ὄρει</char> <char style="w" x-id="SBLGNT.HEB.12.22.005" x-align="HEB.12.22.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.12.22.006" x-align="HEB.12.22.a006" x-target-ids="t009 t010 t011" x-target="unto the city" x-target-head="t011" x-head="true" lemma="πόλις" strong="G4172" x-morph="N-DSF" x-gloss="[the] city" x-translit="polei" xml:lang="grc">πόλει</char> <char style="w" x-id="SBLGNT.HEB.12.22.007" x-align="HEB.12.22.a007" x-target-ids="t012 t013 t015" x-target="of the God" x-target-head="t015" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.HEB.12.22.008" x-align="HEB.12.22.a008" x-target-ids="t014" x-target="liv