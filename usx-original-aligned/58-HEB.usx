	<para style="p"><verse number="3" style="v" x-ref="HEB.10.3" sid="HEB 10:3" /><char style="w" x-id="SBLGNT.HEB.10.3.001" x-align="HEB.10.3.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.HEB.10.3.002" x-align="HEB.10.3.a002" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.HEB.10.3.003" x-align="HEB.10.3.a003" x-target-ids="t003 t004" x-target="those sacrifices" x-target-italic-ids="t004" x-target-head="t003" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DPF" x-gloss="these" x-translit="autais" xml:lang="grc">αὐταῖς</char> <char style="w" x-id="SBLGNT.HEB.10.3.004" x-align="HEB.10.3.a004" x-target-ids="t005 t006 t007 t008 t009" x-target="there is a remembrance made" x-target-head="t008" x-head="true" lemma="ἀνάμνησις" strong="G364" x-morph="N-NSF" x-gloss="[there is] a reminder" x-translit="anamnēsis" xml:lang="grc">ἀνάμνησις</char> <char style="w" x-id="SBLGNT.HEB.10.3.005" x-align="HEB.10.3.a005" x-target-ids="t010 t011" x-target="of sins" x-target-head="t011" x-head="true" lemma="ἁμαρτία" strong="G266" x-morph="N-GPF" x-gloss="of sins" x-translit="hamartiōn" xml:lang="grc">ἁμαρτιῶν</char> <char style="w" x-id="SBLGNT.HEB.10.3.006" x-align="HEB.10.3.a006" x-target-ids="t013" x-target="by" x-target-head="t013" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="every" x-translit="kat" xml:lang="grc">κατ</char>ʼ<char style="w" x-id="SBLGNT.HEB.10.3.007" x-align="HEB.10.3.a007" x-target-ids="t012 t014" x-target="year year" x-target-head="t012" x-head="true" lemma="ἐνιαυτός" strong="G1763" x-morph="N-ASM" x-gloss="year" x-translit="eniauton" xml:lang="grc">ἐνιαυτόν</char>,<verse eid="HEB 10:3" /></para>
