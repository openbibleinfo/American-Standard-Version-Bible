	<para style="p"><verse number="31" style="v" x-ref="HEB.10.31" sid="HEB 10:31" /><char style="w" x-id="SBLGNT.HEB.10.31.001" x-align="HEB.10.31.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="It is a fearful thing" x-target-head="t004" x-head="true" lemma="φοβερός" strong="G5398" x-morph="A-NSN" x-gloss="[It is] a fearful thing" x-translit="phoberon" xml:lang="grc">φοβερὸν</char> <char style="w" x-id="SBLGNT.HEB.10.31.002" x-align="HEB.10.31.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="-" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.HEB.10.31.003" x-align="HEB.10.31.a003" x-target-ids="t006 t007" x-target="to fall" x-target-head="t007" x-head="true" lemma="ἐμπίπτω" strong="G1706" x-morph="V-2AAN" x-gloss="to fall" x-translit="empesein" xml:lang="grc">ἐμπεσεῖν</char> <char style="w" x-id="SBLGNT.HEB.10.31.004" x-align="HEB.10.31.a004" x-target-ids="t008" x-target="into" x-target-head="t008" x-head="true" lemma="εἰς" strong="G1519" x-morph="PREP" x-gloss="into" x-translit="eis" xml:lang="grc">εἰς</char> <char style="w" x-id="SBLGNT.HEB.10.31.005" x-align="HEB.10.31.a005" x-target-ids="t009 t010" x-target="the hands" x-target-head="t010" x-head="true" lemma="χείρ" strong="G5495" x-morph="N-APF" x-gloss="[the] hands" x-translit="cheiras" xml:lang="grc">χεῖρας</char> <char style="w" x-id="SBLGNT.HEB.10.31.006" x-align="HEB.10.31.a006" x-target-ids="t011 t012 t014" x-target="of the God" x-target-head="t014" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.HEB.10.31.007" x-align="HEB.10.31.a007" x-target-ids="t013" x-target="living" x-target-head="t013" x-head="true" lemma="ζάω" strong="G2198" x-morph="V-PAP-GSM" x-gloss="[the] living" x-translit="zōntos" xml:lang="grc">ζῶντος</char>.<verse eid="HEB 10:31" /></para>
