	<para style="p"><verse number="1" style="v" x-ref="HEB.2.1" sid="HEB 2:1" /><char style="w" x-id="SBLGNT.HEB.2.1.001" x-align="HEB.2.1.a001" x-status="noncompositional" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="Because of" x-translit="Dia" xml:lang="grc">Διὰ</char> <char style="w" x-id="SBLGNT.HEB.2.1.002" x-align="HEB.2.1.a001" x-status="noncompositional" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.HEB.2.1.003" x-align="HEB.2.1.a003" x-target-ids="t003" x-target="ought" x-target-head="t003" x-head="true" lemma="δέω" strong="G1210" x-morph="V-PAI-3S" x-gloss="it behooves" x-translit="dei" xml:lang="grc">δεῖ</char> <char style="w" x-id="SBLGNT.HEB.2.1.004" x-align="HEB.2.1.a005" x-target-ids="t006 t007 t008" x-target="the more earnest" x-target-head="t007" x-head="true" lemma="περισσοτέρως" strong="G4056" x-morph="ADV-C" x-gloss="more abundantly" x-translit="perissoterōs" xml:lang="grc">περισσοτέρως</char> <char style="w" x-id="SBLGNT.HEB.2.1.005" x-align="HEB.2.1.a004" x-target-ids="t004 t005 t009" x-target="to give heed" x-target-head="t009" x-head="true" lemma="προσέχω" strong="G4337" x-morph="V-PAN" x-gloss="to give heed" x-translit="prosechein" xml:lang="grc">προσέχειν</char> <char style="w" x-id="SBLGNT.HEB.2.1.006" x-align="HEB.2.1.a002" x-target-ids="t002" x-target="we" x-target-head="t002" x-head="true" lemma="ἐγώ" strong="G2248" x-morph="P-1AP" x-gloss="us" x-translit="hēmas" xml:lang="grc">ἡμᾶς</char> <char style="w" x-id="SBLGNT.HEB.2.1.007" x-align="HEB.2.1.a006" x-target-ids="t010 t011 t012" x-target="to the things" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPN" x-gloss="to the things" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.HEB.2.1.008" x-align="HEB.2.1.a007" x-target-ids="t013 t014 t015" x-target="that were heard" 