	<para style="p"><verse number="2" style="v" x-ref="HEB.4.2" sid="HEB 4:2" /><char style="w" x-id="SBLGNT.HEB.4.2.001" x-align="HEB.4.2.a001" x-target-ids="t002" x-target="indeed" x-target-head="t002" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.4.2.002" x-align="HEB.4.2.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γάρ</char> <char style="w" x-id="SBLGNT.HEB.4.2.003" x-align="HEB.4.2.a003" x-target-ids="t003 t004" x-target="we have" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2070" x-morph="V-PAI-1P" x-gloss="we are [those]" x-translit="esmen" xml:lang="grc">ἐσμεν</char> <char style="w" x-id="SBLGNT.HEB.4.2.004" x-align="HEB.4.2.a004" x-target-ids="t005 t006 t007 t008 t009 t010" x-target="had good tidings preached unto us" x-target-head="t008" x-head="true" lemma="εὐαγγελίζω" strong="G2097" x-morph="V-RPP-NPM" x-gloss="having had the gospel preached" x-translit="euēngelismenoi" xml:lang="grc">εὐηγγελισμένοι</char> <char style="w" x-id="SBLGNT.HEB.4.2.005" x-align="HEB.4.2.a005" x-target-ids="t011 t012" x-target="even as" x-target-head="t012" x-head="true" lemma="καθάπερ" strong="G2509" x-morph="ADV" x-gloss="just as" x-translit="kathaper" xml:lang="grc">καθάπερ</char> <char style="w" x-id="SBLGNT.HEB.4.2.006" x-align="HEB.4.2.a006" x-target-ids="t013 t014" x-target="also they" x-target-head="t014" x-head="true" lemma="κἀκεῖνος" strong="G2548" x-morph="D-NPM-K" x-gloss="they [did]" x-translit="kakeinoi" xml:lang="grc">κἀκεῖνοι</char>,<char style="w" x-id="SBLGNT.HEB.4.2.007" x-align="HEB.4.2.a007" x-target-ids="t015" x-target="but" x-target-head="t015" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="but" x-translit="all" xml:lang="grc">ἀλλ</char>ʼ<char style="w" x-id="SBLGNT.HEB.4.2.008" x-align="HEB.4.2.a008" x-target-id