	<para style="p"><verse number="6" style="v" x-ref="HEB.11.6" sid="HEB 11:6" /><char style="w" x-id="SBLGNT.HEB.11.6.001" x-align="HEB.11.6.a002" x-target-ids="t002" x-target="without" x-target-head="t002" x-head="true" lemma="χωρίς" strong="G5565" x-morph="ADV" x-gloss="Without" x-translit="chōris" xml:lang="grc">χωρὶς</char> <char style="w" x-id="SBLGNT.HEB.11.6.002" x-align="HEB.11.6.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="now" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.HEB.11.6.003" x-align="HEB.11.6.a003" x-target-ids="t003" x-target="faith" x-target-head="t003" x-head="true" lemma="πίστις" strong="G4102" x-morph="N-GSF" x-gloss="faith" x-translit="pisteōs" xml:lang="grc">πίστεως</char> <char style="w" x-id="SBLGNT.HEB.11.6.004" x-align="HEB.11.6.a004" x-target-ids="t004 t005 t006" x-target="it is impossible" x-target-head="t006" x-head="true" lemma="ἀδύνατος" strong="G102" x-morph="A-NSN" x-gloss="[it is] impossible" x-translit="adynaton" xml:lang="grc">ἀδύνατον</char> <char style="w" x-id="SBLGNT.HEB.11.6.005" x-align="HEB.11.6.a005" x-target-ids="t007 t008 t009 t010 t011 t012" x-target="to be well pleasing unto him" x-target-italic-ids="t011 t012" x-target-head="t010" x-head="true" lemma="εὐαρεστέω" strong="G2100" x-morph="V-AAN" x-gloss="to please [Him]" x-translit="euarestēsai" xml:lang="grc">εὐαρεστῆσαι</char>,<char style="w" x-id="SBLGNT.HEB.11.6.006" x-align="HEB.11.6.a012" x-target-ids="t020" x-target="believe" x-target-head="t020" x-head="true" lemma="πιστεύω" strong="G4100" x-morph="V-AAN" x-gloss="To believe" x-translit="pisteusai" xml:lang="grc">πιστεῦσαι</char> <char style="w" x-id="SBLGNT.HEB.11.6.007" x-align="HEB.11.6.a006" x-target-ids="t013" x-target="for" x-target-head="t013" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.11.6.008" x