ue" lemma="ἅγιος" strong="G40" x-morph="A-GSN" x-gloss="Holy" x-translit="hagiou" xml:lang="grc">ἁγίου</char> <verse eid="HEB 6:4" /></para>
	<para style="p"><verse number="5" style="v" x-ref="HEB.6.5" sid="HEB 6:5" /><char style="w" x-id="SBLGNT.HEB.6.5.001" x-align="HEB.6.5.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.6.5.002" x-align="HEB.6.5.a003" x-target-ids="t004" x-target="good" x-target-head="t004" x-head="true" lemma="καλός" strong="G2570" x-morph="A-ASN" x-gloss="[the] goodness" x-translit="kalon" xml:lang="grc">καλὸν</char> <char style="w" x-id="SBLGNT.HEB.6.5.003" x-align="HEB.6.5.a002" x-target-ids="t002" x-target="tasted" x-target-head="t002" x-head="true" lemma="γεύομαι" strong="G1089" x-morph="V-ADP-APM" x-gloss="having tasted" x-translit="geusamenous" xml:lang="grc">γευσαμένους</char> <char style="w" x-id="SBLGNT.HEB.6.5.004" x-align="HEB.6.5.a005" x-target-ids="t006 t007" x-target="of God" x-target-head="t007" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God’s" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.HEB.6.5.005" x-align="HEB.6.5.a004" x-target-ids="t003 t005" x-target="the word" x-target-head="t005" x-head="true" lemma="ῥῆμα" strong="G4487" x-morph="N-ASN" x-gloss="word" x-translit="rhēma" xml:lang="grc">ῥῆμα</char> <char style="w" x-id="SBLGNT.HEB.6.5.006" x-align="HEB.6.5.a007" x-target-ids="t009 t010" x-target="the powers" x-target-head="t010" x-head="true" lemma="δύναμις" strong="G1411" x-morph="N-APF" x-gloss="[the] power" x-translit="dynameis" xml:lang="grc">δυνάμεις</char> <char style="w" x-id="SBLGNT.HEB.6.5.007" x-align="HEB.6.5.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="τέ" strong="G5037" x-morph="PRT" x-gloss="also" x-translit="te" xml:lang="grc">τε</char> <char style="w" x-id="SBLGNT.HEB.6.5.008" x-align="HEB.6.5.a009" x-target-ids="t014 t015" x-target="to come" x-target-head="t015" x-head="true" lemma="μέλλω" stro