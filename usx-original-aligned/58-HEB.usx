	<para style="p"><verse number="19" style="v" x-ref="HEB.12.19" x-added-alignments="HEB.12.19.a008" x-added-target-ids="t013" x-added-target="voice" sid="HEB 12:19" /><char style="w" x-id="SBLGNT.HEB.12.19.001" x-align="HEB.12.19.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.12.19.002" x-align="HEB.12.19.a003" x-target-ids="t004 t005 t006" x-target="of a trumpet" x-target-head="t006" x-head="true" lemma="σάλπιγξ" strong="G4536" x-morph="N-GSF" x-gloss="of a trumpet" x-translit="salpingos" xml:lang="grc">σάλπιγγος</char> <char style="w" x-id="SBLGNT.HEB.12.19.003" x-align="HEB.12.19.a002" x-target-ids="t002 t003" x-target="the sound" x-target-head="t003" x-head="true" lemma="ἦχος" strong="G2279" x-morph="N-DSM" x-gloss="to [the] sound" x-translit="ēchōi" xml:lang="grc">ἤχῳ</char> <char style="w" x-id="SBLGNT.HEB.12.19.004" x-align="HEB.12.19.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.12.19.005" x-align="HEB.12.19.a005" x-target-ids="t008 t009" x-target="the voice" x-target-head="t009" x-head="true" lemma="φωνή" strong="G5456" x-morph="N-DSF" x-gloss="to a voice" x-translit="phōnēi" xml:lang="grc">φωνῇ</char> <char style="w" x-id="SBLGNT.HEB.12.19.006" x-align="HEB.12.19.a006" x-target-ids="t010 t011" x-target="of words" x-target-head="t011" x-head="true" lemma="ῥῆμα" strong="G4487" x-morph="N-GPN" x-gloss="of words" x-translit="rhēmatōn" xml:lang="grc">ῥημάτων</char>,<char style="w" x-id="SBLGNT.HEB.12.19.007" x-align="HEB.12.19.a007" x-target-ids="t012" x-target="which" x-target-head="t012" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-GSF" x-gloss="which" x-translit="hēs" xml:lang="grc">ἧς</char> <char style="w" x-id="SBLGNT.HEB.12.19.008"