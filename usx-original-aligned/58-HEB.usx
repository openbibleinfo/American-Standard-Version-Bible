	<para style="p"><verse number="3" style="v" x-ref="HEB.5.3" sid="HEB 5:3" /><char style="w" x-id="SBLGNT.HEB.5.3.001" x-align="HEB.5.3.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.5.3.002" x-align="HEB.5.3.a002" x-target-ids="t002 t003" x-target="by reason" x-target-head="t003" x-head="true" lemma="διά" strong="G1223" x-morph="PREP" x-gloss="because of" x-translit="di" xml:lang="grc">δι</char>ʼ<char style="w" x-id="SBLGNT.HEB.5.3.003" x-align="HEB.5.3.a003" x-target-ids="t004" x-target="thereof" x-target-head="t004" x-head="true" lemma="ἑαυτοῦ" strong="G848" x-morph="P-ASF" x-gloss="this" x-translit="autēn" xml:lang="grc">αὐτὴν</char> <char style="w" x-id="SBLGNT.HEB.5.3.004" x-align="HEB.5.3.a004" x-target-ids="t005 t006" x-target="is bound" x-target-head="t006" x-head="true" lemma="ὀφείλω" strong="G3784" x-morph="V-PAI-3S" x-gloss="he is obligated" x-translit="opheilei" xml:lang="grc">ὀφείλει</char>,<char style="w" x-id="SBLGNT.HEB.5.3.005" x-align="HEB.5.3.a005" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="just as" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.HEB.5.3.006" x-align="HEB.5.3.a006" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="for" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.HEB.5.3.007" x-align="HEB.5.3.a007" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="the" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.HEB.5.3.008" x-align="HEB.5.3.a008" x-target-ids="t010" x-target="people" x-target-head="t010" x-head="true" lemma="λαός" strong="G2992" x-morph="N-GSM" x-gloss="people" x-transli