	<para style="p"><verse number="13" style="v" x-ref="HEB.6.13" sid="HEB 6:13" /><char style="w" x-id="SBLGNT.HEB.6.13.001" x-align="HEB.6.13.a002" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="-" x-translit="Tōi" xml:lang="grc">Τῷ</char> <char style="w" x-id="SBLGNT.HEB.6.13.002" x-align="HEB.6.13.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="For" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.6.13.003" x-align="HEB.6.13.a003" x-target-ids="t006 t007" x-target="to Abraham" x-target-head="t007" x-head="true" lemma="Ἀβραάμ" strong="G11" x-morph="N-PRI" x-gloss="to Abraham" x-translit="Abraam" xml:lang="grc">Ἀβραὰμ</char> <char style="w" x-id="SBLGNT.HEB.6.13.004" x-align="HEB.6.13.a004" x-target-ids="t002 t004 t005" x-target="when made promise" x-target-head="t005" x-head="true" lemma="ἐπαγγέλλομαι" strong="G1861" x-morph="V-ADP-NSM" x-gloss="having made His promise" x-translit="epangeilamenos" xml:lang="grc">ἐπαγγειλάμενος</char> <char style="w" x-id="SBLGNT.HEB.6.13.005" x-align="HEB.6.13.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.HEB.6.13.006" x-align="HEB.6.13.a006" x-target-ids="t003" x-target="God" x-target-head="t003" x-head="true" lemma="θεός" strong="G2316" x-morph="N-NSM" x-gloss="God" x-translit="theos" xml:lang="grc">θεός</char>,<char style="w" x-id="SBLGNT.HEB.6.13.007" x-align="HEB.6.13.a007" x-target-ids="t008" x-target="since" x-target-head="t008" x-head="true" lemma="ἐπεί" strong="G1893" x-morph="CONJ" x-gloss="since" x-translit="epei" xml:lang="grc">ἐπεὶ</char> <char style="w" x-id="SBLGNT.HEB.6.13.008" x-align="HEB.6.13.a010" x-target-ids="t012" x-target="by" x-target-head="t012" x-head="true" lemma="κατά" strong="G2596" x-morph="PREP" x-gloss="by" x-translit="kat" xml:lang="gr