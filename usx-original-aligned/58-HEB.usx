	<para style="p"><verse number="20" style="v" x-ref="HEB.12.20" sid="HEB 12:20" /><char style="w" x-id="SBLGNT.HEB.12.20.001" x-align="HEB.12.20.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.HEB.12.20.002" x-align="HEB.12.20.a003" x-target-ids="t002 t003 t005" x-target="they could endure" x-target-head="t005" x-head="true" lemma="φέρω" strong="G5342" x-morph="V-IAI-3P" x-gloss="they could bear" x-translit="epheron" xml:lang="grc">ἔφερον</char> <char style="w" x-id="SBLGNT.HEB.12.20.003" x-align="HEB.12.20.a001" x-target-ids="t001" x-target="for" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.12.20.004" x-align="HEB.12.20.a004" x-target-ids="t006" x-target="that" x-target-head="t006" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="that" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.HEB.12.20.005" x-align="HEB.12.20.a005" x-target-ids="t007 t008 t009" x-target="which was enjoined" x-target-head="t009" x-head="true" lemma="διαστέλλομαι" strong="G1291" x-morph="V-PPP-ASN" x-gloss="being commanded" x-translit="diastellomenon" xml:lang="grc">διαστελλόμενον</char>·<char style="w" x-id="SBLGNT.HEB.12.20.006" x-align="HEB.12.20.a006" x-target-ids="t010 t011" x-target="If even" x-target-head="t010" x-head="true" lemma="κἄν" strong="G2579" x-morph="COND-K" x-gloss="If even" x-translit="Kan" xml:lang="grc">Κἂν</char> <char style="w" x-id="SBLGNT.HEB.12.20.007" x-align="HEB.12.20.a007" x-target-ids="t012 t013" x-target="a beast" x-target-head="t013" x-head="true" lemma="θηρίον" strong="G2342" x-morph="N-NSN" x-gloss="a beast" x-translit="thērion" xml:lang="grc">θηρίον</char> <char style="w" x-id="SBLGNT.HEB.12.20.008" x-align="HEB.12.20.a008" x-target-ids="t014" x-ta