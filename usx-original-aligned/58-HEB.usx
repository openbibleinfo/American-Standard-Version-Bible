	<para style="p"><verse number="18" style="v" x-ref="HEB.12.18" sid="HEB 12:18" /><char style="w" x-id="SBLGNT.HEB.12.18.001" x-align="HEB.12.18.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="Not" x-translit="Ou" xml:lang="grc">Οὐ</char> <char style="w" x-id="SBLGNT.HEB.12.18.002" x-align="HEB.12.18.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.HEB.12.18.003" x-align="HEB.12.18.a003" x-target-ids="t002 t003 t005" x-target="ye are come" x-target-head="t005" x-head="true" lemma="προσέρχομαι" strong="G4334" x-morph="V-2RAI-2P" x-gloss="you have come to" x-translit="proselēlythate" xml:lang="grc">προσεληλύθατε</char> <char style="w" x-id="SBLGNT.HEB.12.18.004" x-align="HEB.12.18.a004" x-target-ids="t006 t007 t008 t009 t010 t011 t012" x-target="unto a mount that might be touched" x-target-italic-ids="t007 t008" x-target-head="t012" x-head="true" lemma="ψηλαφάω" strong="G5584" x-morph="V-PPP-DSN" x-gloss="[that] being touched" x-translit="psēlaphōmenōi" xml:lang="grc">ψηλαφωμένῳ</char> <char style="w" x-id="SBLGNT.HEB.12.18.005" x-align="HEB.12.18.a005" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.HEB.12.18.006" x-align="HEB.12.18.a006" x-target-ids="t014 t015" x-target="that burned" x-target-head="t015" x-head="true" lemma="καίω" strong="G2545" x-morph="V-RPP-DSN" x-gloss="having been kindled" x-translit="kekaumenōi" xml:lang="grc">κεκαυμένῳ</char> <char style="w" x-id="SBLGNT.HEB.12.18.007" x-align="HEB.12.18.a007" x-target-ids="t016 t017" x-target="with fire" x-target-head="t017" x-head="true" lemma="πῦρ" strong="G4442" x-morph="N-DSN" x-gloss="with fire" x-translit="pyri" xml:lang="gr