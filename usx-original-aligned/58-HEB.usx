	<para style="p"><verse number="21" style="v" x-ref="HEB.12.21" x-added-alignments="HEB.12.21.a007" x-added-target-ids="t007" x-added-target="that" sid="HEB 12:21" /><char style="w" x-id="SBLGNT.HEB.12.21.001" x-align="HEB.12.21.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καί</char>,<char style="w" x-id="SBLGNT.HEB.12.21.002" x-align="HEB.12.21.a002" x-target-ids="t002" x-target="so" x-target-head="t002" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="so" x-translit="houtō" xml:lang="grc">οὕτω</char> <char style="w" x-id="SBLGNT.HEB.12.21.003" x-align="HEB.12.21.a003" x-target-ids="t003" x-target="fearful" x-target-head="t003" x-head="true" lemma="φοβερός" strong="G5398" x-morph="A-NSN" x-gloss="fearful" x-translit="phoberon" xml:lang="grc">φοβερὸν</char> <char style="w" x-id="SBLGNT.HEB.12.21.004" x-align="HEB.12.21.a004" x-target-ids="t004" x-target="was" x-target-head="t004" x-head="true" lemma="εἰμί" strong="G2258" x-morph="V-IAI-3S" x-gloss="was" x-translit="ēn" xml:lang="grc">ἦν</char> <char style="w" x-id="SBLGNT.HEB.12.21.005" x-align="HEB.12.21.a005" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSN" x-gloss="the thing" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.HEB.12.21.006" x-align="HEB.12.21.a006" x-target-ids="t006" x-target="appearance" x-target-head="t006" x-head="true" lemma="φαντάζομαι" strong="G5324" x-morph="V-PPP-NSN" x-gloss="appearing [that]" x-translit="phantazomenon" xml:lang="grc">φανταζόμενον</char>,<char style="w" x-id="SBLGNT.HEB.12.21.007" x-align="HEB.12.21.a008" x-target-ids="t008" x-target="Moses" x-target-head="t008" x-head="true" lemma="Μωϋσῆς" strong="G3475" x-morph="N-NSM" x-gloss="Moses" x-translit="Mōysēs" xml:lang="grc">Μωϋσῆς</char> <char style="w" x-id="SBLGNT.HEB.12.21.008" x-align="HEB.12.21.a009" x-