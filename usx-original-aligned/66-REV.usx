ω" strong="G3195" x-morph="V-IAI-3P" x-gloss="are about" x-translit="emellon" xml:lang="grc">ἔμελλον</char> <char style="w" x-id="SBLGNT.REV.3.2.009" x-align="REV.3.2.a009" x-target-ids="t013 t014" x-target="to die" x-target-head="t014" x-head="true" lemma="ἀποθνῄσκω" strong="G599" x-morph="V-2AAN" x-gloss="to die" x-translit="apothanein" xml:lang="grc">ἀποθανεῖν</char>,<char style="w" x-id="SBLGNT.REV.3.2.010" x-align="REV.3.2.a010" x-target-ids="t019" x-target="no" x-target-head="t019" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.REV.3.2.011" x-align="REV.3.2.a011" x-target-ids="t015" x-target="for" x-target-head="t015" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.REV.3.2.012" x-align="REV.3.2.a012" x-target-ids="t016 t017 t018" x-target="I have found" x-target-head="t018" x-head="true" lemma="εὑρίσκω" strong="G2147" x-morph="V-RAI-1S" x-gloss="I have found" x-translit="heurēka" xml:lang="grc">εὕρηκά</char> <char style="w" x-id="SBLGNT.REV.3.2.013" x-align="REV.3.2.a013" x-target-ids="t021 t022" x-target="of thine" x-target-head="t022" x-head="true" lemma="σύ" strong="G4675" x-morph="P-2GS" x-gloss="your" x-translit="sou" xml:lang="grc">σου</char> <char style="w" x-id="SBLGNT.REV.3.2.014" x-align="REV.3.2.a014" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-translit="ta" xml:lang="grc">τὰ</char> <char style="w" x-id="SBLGNT.REV.3.2.015" x-align="REV.3.2.a015" x-target-ids="t020" x-target="works" x-target-head="t020" x-head="true" lemma="ἔργον" strong="G2041" x-morph="N-APN" x-gloss="works" x-translit="erga" xml:lang="grc">ἔργα</char> <char style="w" x-id="SBLGNT.REV.3.2.016" x-align="REV.3.2.a016" x-target-ids="t023" x-target="perfected" x-target-head="t023" x-head="true" lemma="πληρόω" strong="G4137" x-morph="V-RPP-APN" x-gloss="having been