	<para style="p"><verse number="20" style="v" x-ref="REV.22.20" sid="REV 22:20" /><char style="w" x-id="SBLGNT.REV.22.20.001" x-align="REV.22.20.a001" x-target-ids="t006" x-target="saith" x-target-head="t006" x-head="true" lemma="λέγω" strong="G3004" x-morph="V-PAI-3S" x-gloss="Says" x-translit="Legei" xml:lang="grc">Λέγει</char> <char style="w" x-id="SBLGNT.REV.22.20.002" x-align="REV.22.20.a002" x-target-ids="t001" x-target="He" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="the [One]" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.REV.22.20.003" x-align="REV.22.20.a003" x-target-ids="t002 t003" x-target="who testifieth" x-target-head="t003" x-head="true" lemma="μαρτυρέω" strong="G3140" x-morph="V-PAP-NSM" x-gloss="testifying" x-translit="martyrōn" xml:lang="grc">μαρτυρῶν</char> <char style="w" x-id="SBLGNT.REV.22.20.004" x-align="REV.22.20.a004" x-target-ids="t004 t005" x-target="these things" x-target-head="t004" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="these things" x-translit="tauta" xml:lang="grc">ταῦτα</char>·<char style="w" x-id="SBLGNT.REV.22.20.005" x-align="REV.22.20.a005" x-target-ids="t007" x-target="Yea" x-target-head="t007" x-head="true" lemma="ναί" strong="G3483" x-morph="PRT" x-gloss="Yes" x-translit="Nai" xml:lang="grc">Ναί</char>·<char style="w" x-id="SBLGNT.REV.22.20.006" x-align="REV.22.20.a006" x-target-ids="t008 t009" x-target="I come" x-target-head="t009" x-head="true" lemma="ἔρχομαι" strong="G2064" x-morph="V-PNI-1S" x-gloss="I am coming" x-translit="erchomai" xml:lang="grc">ἔρχομαι</char> <char style="w" x-id="SBLGNT.REV.22.20.007" x-align="REV.22.20.a007" x-target-ids="t010" x-target="quickly" x-target-head="t010" x-head="true" lemma="ταχύ" strong="G5035" x-morph="ADV" x-gloss="quickly" x-translit="tachy" xml:lang="grc">ταχύ</char>.<char style="w" x-id="SBLGNT.REV.22.20.008" x-align="REV.22.20.a008" x-target-ids="t011" x-target="Amen" x-target-head="t01