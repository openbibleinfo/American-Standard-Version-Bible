	<para style="p"><verse number="6" style="v" x-ref="REV.2.6" sid="REV 2:6" /><char style="w" x-id="SBLGNT.REV.2.6.001" x-align="REV.2.6.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="ἀλλά" strong="G235" x-morph="CONJ" x-gloss="But" x-translit="alla" xml:lang="grc">ἀλλὰ</char> <char style="w" x-id="SBLGNT.REV.2.6.002" x-align="REV.2.6.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.REV.2.6.003" x-align="REV.2.6.a003" x-target-ids="t003 t004" x-target="thou hast" x-target-head="t004" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAI-2S" x-gloss="you have" x-translit="echeis" xml:lang="grc">ἔχεις</char> <char style="w" x-id="SBLGNT.REV.2.6.004" x-align="REV.2.6.a004" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.REV.2.6.005" x-align="REV.2.6.a005" x-target-ids="t006 t007" x-target="thou hatest" x-target-head="t007" x-head="true" lemma="μισέω" strong="G3404" x-morph="V-PAI-2S" x-gloss="you hate" x-translit="miseis" xml:lang="grc">μισεῖς</char> <char style="w" x-id="SBLGNT.REV.2.6.006" x-align="REV.2.6.a006" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-APN" x-gloss="the" x-translit="ta" xml:lang="grc">τὰ</char> <char style="w" x-id="SBLGNT.REV.2.6.007" x-align="REV.2.6.a007" x-target-ids="t009" x-target="works" x-target-head="t009" x-head="true" lemma="ἔργον" strong="G2041" x-morph="N-APN" x-gloss="works" x-translit="erga" xml:lang="grc">ἔργα</char> <char style="w" x-id="SBLGNT.REV.2.6.008" x-align="REV.2.6.a008" x-target-ids="t010 t011" x-target="of the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GPM" x-gloss="of the" x-transli