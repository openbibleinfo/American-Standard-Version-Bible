	<para style="p"><verse number="2" style="v" x-ref="REV.1.2" x-added-alignments="REV.1.2.a013" x-added-target-ids="t016" x-added-target="even" sid="REV 1:2" /><char style="w" x-id="SBLGNT.REV.1.2.001" x-align="REV.1.2.a001" x-target-ids="t001" x-target="who" x-target-head="t001" x-head="true" lemma="ὅς" strong="G3739" x-morph="R-NSM" x-gloss="who" x-translit="hos" xml:lang="grc">ὃς</char> <char style="w" x-id="SBLGNT.REV.1.2.002" x-align="REV.1.2.a002" x-target-ids="t002 t003" x-target="bare witness" x-target-head="t003" x-head="true" lemma="μαρτυρέω" strong="G3140" x-morph="V-AAI-3S" x-gloss="testified" x-translit="emartyrēsen" xml:lang="grc">ἐμαρτύρησεν</char> <char style="w" x-id="SBLGNT.REV.1.2.003" x-align="REV.1.2.a003" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASM" x-gloss="to the" x-translit="ton" xml:lang="grc">τὸν</char> <char style="w" x-id="SBLGNT.REV.1.2.004" x-align="REV.1.2.a004" x-target-ids="t004 t006" x-target="of word" x-target-head="t006" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-ASM" x-gloss="word" x-translit="logon" xml:lang="grc">λόγον</char> <char style="w" x-id="SBLGNT.REV.1.2.005" x-align="REV.1.2.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="-" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.REV.1.2.006" x-align="REV.1.2.a006" x-target-ids="t007 t008" x-target="of God" x-target-head="t008" x-head="true" lemma="θεός" strong="G2316" x-morph="N-GSM" x-gloss="of God" x-translit="theou" xml:lang="grc">θεοῦ</char> <char style="w" x-id="SBLGNT.REV.1.2.007" x-align="REV.1.2.a007" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.REV.1.2.008" x-align="REV.1.2.a008" x-target-ids="t011" x-target="the" x-target-head="t011" x-head="true" lemma="ὁ" strong="G3588