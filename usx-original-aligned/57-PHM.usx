	<para style="p"><verse number="23" style="v" x-ref="PHM.1.23" sid="PHM 1:23" /><char style="w" x-id="SBLGNT.PHM.1.23.001" x-align="PHM.1.23.a001" x-target-ids="t008" x-target="saluteth" x-target-head="t008" x-head="true" lemma="ἀσπάζομαι" strong="G782" x-morph="V-PNI-3S" x-gloss="Greets" x-translit="Aspazetai" xml:lang="grc">Ἀσπάζεταί</char> <char style="w" x-id="SBLGNT.PHM.1.23.002" x-align="PHM.1.23.a002" x-target-ids="t009" x-target="thee" x-target-head="t009" x-head="true" lemma="σύ" strong="G4571" x-morph="P-2AS" x-gloss="you" x-translit="se" xml:lang="grc">σε</char> <char style="w" x-id="SBLGNT.PHM.1.23.003" x-align="PHM.1.23.a003" x-target-ids="t001" x-target="Epaphras" x-target-head="t001" x-head="true" lemma="Ἐπαφρᾶς" strong="G1889" x-morph="N-NSM" x-gloss="Epaphras" x-translit="Epaphras" xml:lang="grc">Ἐπαφρᾶς</char> <char style="w" x-id="SBLGNT.PHM.1.23.004" x-align="PHM.1.23.a004" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.PHM.1.23.005" x-align="PHM.1.23.a005" x-target-ids="t003 t004" x-target="fellow prisoner" x-target-head="t004" x-head="true" lemma="συναιχμάλωτος" strong="G4869" x-morph="A-NSM" x-gloss="fellow prisoner" x-translit="synaichmalōtos" xml:lang="grc">συναιχμάλωτός</char> <char style="w" x-id="SBLGNT.PHM.1.23.006" x-align="PHM.1.23.a006" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="ἐγώ" strong="G3450" x-morph="P-1GS" x-gloss="my" x-translit="mou" xml:lang="grc">μου</char> <char style="w" x-id="SBLGNT.PHM.1.23.007" x-align="PHM.1.23.a007" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.PHM.1.23.008" x-align="PHM.1.23.a008" x-target-ids="t006" x-target="Christ" x-target-head="t006" x-head="true" lemma="Χριστός" strong="G5547" x-morph="N-DSM" x-gloss="Ch