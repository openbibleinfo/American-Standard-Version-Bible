	<para style="p"><verse number="6" style="v" x-ref="2PE.2.6" sid="2PE 2:6" /><char style="w" x-id="SBLGNT.2PE.2.6.001" x-align="2PE.2.6.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2PE.2.6.002" x-align="2PE.2.6.a002" x-target-ids="t003 t004" x-target="the cities" x-target-head="t004" x-head="true" lemma="πόλις" strong="G4172" x-morph="N-APF" x-gloss="[the] cities" x-translit="poleis" xml:lang="grc">πόλεις</char> <char style="w" x-id="SBLGNT.2PE.2.6.003" x-align="2PE.2.6.a003" x-target-ids="t005 t006" x-target="of Sodom" x-target-head="t006" x-head="true" lemma="Σόδομα" strong="G4670" x-morph="N-GPN" x-gloss="of Sodom" x-translit="Sodomōn" xml:lang="grc">Σοδόμων</char> <char style="w" x-id="SBLGNT.2PE.2.6.004" x-align="2PE.2.6.a004" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2PE.2.6.005" x-align="2PE.2.6.a005" x-target-ids="t008" x-target="Gomorrah" x-target-head="t008" x-head="true" lemma="Γόμορρα" strong="G1116" x-morph="N-GSF" x-gloss="Gomorrah" x-translit="Gomorras" xml:lang="grc">Γομόρρας</char> <char style="w" x-id="SBLGNT.2PE.2.6.006" x-align="2PE.2.6.a006" x-target-ids="t002 t009 t010" x-target="turning into ashes" x-target-head="t010" x-head="true" lemma="τεφρόω" strong="G5077" x-morph="V-AAP-NSM" x-gloss="having reduced to ashes" x-translit="tephrōsas" xml:lang="grc">τεφρώσας</char> <char style="w" x-id="SBLGNT.2PE.2.6.007" x-align="2PE.2.6.a007" x-target-ids="t013 t014 t015" x-target="with an overthrow" x-target-head="t015" x-head="true" lemma="καταστροφή" strong="G2692" x-morph="N-DSF" x-gloss="to destruction" x-translit="katastrophēi" xml:lang="grc">καταστροφῇ</char> <char style="w" x-id="SBLGNT.2PE.2.6.008" x-align="2PE.2.6.a008" x-target-ids="t