" x-morph="N-PRI" x-gloss="Noah" x-translit="Nōe" xml:lang="grc">Νῶε</char> <char style="w" x-id="SBLGNT.2PE.2.5.009" x-align="2PE.2.5.a011" x-target-ids="t015 t016" x-target="of righteousness" x-target-head="t016" x-head="true" lemma="δικαιοσύνη" strong="G1343" x-morph="N-GSF" x-gloss="of righteousness" x-translit="dikaiosynēs" xml:lang="grc">δικαιοσύνης</char> <char style="w" x-id="SBLGNT.2PE.2.5.010" x-align="2PE.2.5.a010" x-target-ids="t013 t014" x-target="a preacher" x-target-head="t014" x-head="true" lemma="κῆρυξ" strong="G2783" x-morph="N-ASM" x-gloss="a herald" x-translit="kēryka" xml:lang="grc">κήρυκα</char> <char style="w" x-id="SBLGNT.2PE.2.5.011" x-align="2PE.2.5.a007" x-target-ids="t008" x-target="preserved" x-target-head="t008" x-head="true" lemma="φυλάσσω" strong="G5442" x-morph="V-AAI-3S" x-gloss="preserved" x-translit="ephylaxen" xml:lang="grc">ἐφύλαξεν</char>,<char style="w" x-id="SBLGNT.2PE.2.5.012" x-align="2PE.2.5.a013" x-target-ids="t020 t021" x-target="a flood" x-target-head="t021" x-head="true" lemma="κατακλυσμός" strong="G2627" x-morph="N-ASM" x-gloss="[the] flood upon" x-translit="kataklysmon" xml:lang="grc">κατακλυσμὸν</char> <char style="w" x-id="SBLGNT.2PE.2.5.013" x-align="2PE.2.5.a014" x-target-ids="t022 t023 t024" x-target="upon the world" x-target-head="t024" x-head="true" lemma="κόσμος" strong="G2889" x-morph="N-DSM" x-gloss="[the] world" x-translit="kosmōi" xml:lang="grc">κόσμῳ</char> <char style="w" x-id="SBLGNT.2PE.2.5.014" x-align="2PE.2.5.a015" x-target-ids="t025 t026 t027" x-target="of the ungodly" x-target-head="t027" x-head="true" lemma="ἀσεβής" strong="G765" x-morph="A-GPM" x-gloss="of [the] ungodly" x-translit="asebōn" xml:lang="grc">ἀσεβῶν</char> <char style="w" x-id="SBLGNT.2PE.2.5.015" x-align="2PE.2.5.a012" x-target-ids="t017 t018 t019" x-target="when he brought" x-target-head="t019" x-head="true" lemma="ἐπάγω" strong="G1863" x-morph="V-AAP-NSM" x-gloss="having brought in" x-translit="epaxas" xml:lang="grc">ἐπάξας</cha