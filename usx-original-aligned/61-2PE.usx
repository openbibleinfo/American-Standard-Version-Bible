	<para style="p"><verse number="21" style="v" x-ref="2PE.1.21" sid="2PE 1:21" /><char style="w" x-id="SBLGNT.2PE.1.21.001" x-align="2PE.1.21.a002" x-target-ids="t002" x-target="no" x-target-head="t002" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="Not" x-translit="ou" xml:lang="grc">οὐ</char> <char style="w" x-id="SBLGNT.2PE.1.21.002" x-align="2PE.1.21.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2PE.1.21.003" x-align="2PE.1.21.a006" x-target-ids="t006 t007 t008" x-target="by the will" x-target-head="t008" x-head="true" lemma="θέλημα" strong="G2307" x-morph="N-DSN" x-gloss="by [the] will" x-translit="thelēmati" xml:lang="grc">θελήματι</char> <char style="w" x-id="SBLGNT.2PE.1.21.004" x-align="2PE.1.21.a007" x-target-ids="t009 t010" x-target="of man" x-target-head="t010" x-head="true" lemma="ἄνθρωπος" strong="G444" x-morph="N-GSM" x-gloss="of man" x-translit="anthrōpou" xml:lang="grc">ἀνθρώπου</char> <char style="w" x-id="SBLGNT.2PE.1.21.005" x-align="2PE.1.21.a005" x-target-ids="t005" x-target="came" x-target-head="t005" x-head="true" lemma="φέρω" strong="G5342" x-morph="V-API-3S" x-gloss="was brought" x-translit="ēnechthē" xml:lang="grc">ἠνέχθη</char> <char style="w" x-id="SBLGNT.2PE.1.21.006" x-align="2PE.1.21.a003" x-target-ids="t003" x-target="prophecy" x-target-head="t003" x-head="true" lemma="προφητεία" strong="G4394" x-morph="N-NSF" x-gloss="prophecy" x-translit="prophēteia" xml:lang="grc">προφητεία</char> <char style="w" x-id="SBLGNT.2PE.1.21.007" x-align="2PE.1.21.a004" x-target-ids="t004" x-target="ever" x-target-head="t004" x-head="true" lemma="ποτέ" strong="G4218" x-morph="PRT" x-gloss="at any time" x-translit="pote" xml:lang="grc">ποτέ</char>,<char style="w" x-id="SBLGNT.2PE.1.21.008" x-align="2PE.1.21.a008" x-target-ids="t011" x-target="but" x-target-head="t011" x-head="true" l