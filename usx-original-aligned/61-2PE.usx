	<para style="p"><verse number="4" style="v" x-ref="2PE.2.4" sid="2PE 2:4" /><char style="w" x-id="SBLGNT.2PE.2.4.001" x-align="2PE.2.4.a001" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="εἰ" strong="G1487" x-morph="COND" x-gloss="If" x-translit="Ei" xml:lang="grc">Εἰ</char> <char style="w" x-id="SBLGNT.2PE.2.4.002" x-align="2PE.2.4.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2PE.2.4.003" x-align="2PE.2.4.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSM" x-gloss="-" x-translit="ho" xml:lang="grc">ὁ</char> <char style="w" x-id="SBLGNT.2PE.2.4.004" x-align="2PE.2.4.a004" x-target-ids="t003" x-target="God" x-target-head="t003" x-head="true" lemma="θεός" strong="G2316" x-morph="N-NSM" x-gloss="God" x-translit="theos" xml:lang="grc">θεὸς</char> <char style="w" x-id="SBLGNT.2PE.2.4.005" x-align="2PE.2.4.a005" x-target-ids="t006" x-target="angels" x-target-head="t006" x-head="true" lemma="ἄγγελος" strong="G32" x-morph="N-GPM" x-gloss="[the] angels" x-translit="angelōn" xml:lang="grc">ἀγγέλων</char> <char style="w" x-id="SBLGNT.2PE.2.4.006" x-align="2PE.2.4.a006" x-target-ids="t007 t008 t009" x-target="when they sinned" x-target-head="t009" x-head="true" lemma="ἁμαρτάνω" strong="G264" x-morph="V-AAP-GPM" x-gloss="having sinned" x-translit="hamartēsantōn" xml:lang="grc">ἁμαρτησάντων</char> <char style="w" x-id="SBLGNT.2PE.2.4.007" x-align="2PE.2.4.a007" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="οὐ" strong="G3756" x-morph="PRT-N" x-gloss="not" x-translit="ouk" xml:lang="grc">οὐκ</char> <char style="w" x-id="SBLGNT.2PE.2.4.008" x-align="2PE.2.4.a008" x-target-ids="t004" x-target="spared" x-target-head="t004" x-head="true" lemma="φείδομαι" strong="G5339" x-morph="V-ADI-3S" x-gloss="spared" x-translit="epheisato" xml:lang=