	<para style="p"><verse number="11" style="v" x-ref="2PE.1.11" sid="2PE 1:11" /><char style="w" x-id="SBLGNT.2PE.1.11.001" x-align="2PE.1.11.a001" x-target-ids="t002" x-target="thus" x-target-head="t002" x-head="true" lemma="οὕτω(ς)" strong="G3779" x-morph="ADV" x-gloss="In this way" x-translit="houtōs" xml:lang="grc">οὕτως</char> <char style="w" x-id="SBLGNT.2PE.1.11.002" x-align="2PE.1.11.a002" x-target-ids="t001" x-target="for" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2PE.1.11.003" x-align="2PE.1.11.a003" x-target-ids="t005" x-target="richly" x-target-head="t005" x-head="true" lemma="πλουσίως" strong="G4146" x-morph="ADV" x-gloss="richly" x-translit="plousiōs" xml:lang="grc">πλουσίως</char> <char style="w" x-id="SBLGNT.2PE.1.11.004" x-align="2PE.1.11.a004" x-target-ids="t003 t004 t006" x-target="shall be supplied" x-target-head="t006" x-head="true" lemma="ἐπιχορηγέω" strong="G2023" x-morph="V-FPI-3S" x-gloss="will be supplied" x-translit="epichorēgēthēsetai" xml:lang="grc">ἐπιχορηγηθήσεται</char> <char style="w" x-id="SBLGNT.2PE.1.11.005" x-align="2PE.1.11.a005" x-target-ids="t007 t008" x-target="unto you" x-target-head="t008" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.2PE.1.11.006" x-align="2PE.1.11.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NSF" x-gloss="the" x-translit="hē" xml:lang="grc">ἡ</char> <char style="w" x-id="SBLGNT.2PE.1.11.007" x-align="2PE.1.11.a007" x-target-ids="t010" x-target="entrance" x-target-head="t010" x-head="true" lemma="εἴσοδος" strong="G1529" x-morph="N-NSF" x-gloss="entrance" x-translit="eisodos" xml:lang="grc">εἴσοδος</char> <char style="w" x-id="SBLGNT.2PE.1.11.008" x-align="2PE.1.11.a008" x-target-ids="t011" x-target="into" x-target-head="t0