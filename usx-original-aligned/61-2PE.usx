	<para style="p"><verse number="3" style="v" x-ref="2PE.2.3" sid="2PE 2:3" /><char style="w" x-id="SBLGNT.2PE.2.3.001" x-align="2PE.2.3.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2PE.2.3.002" x-align="2PE.2.3.a002" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="through" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.2PE.2.3.003" x-align="2PE.2.3.a003" x-target-ids="t003" x-target="covetousness" x-target-head="t003" x-head="true" lemma="πλεονεξία" strong="G4124" x-morph="N-DSF" x-gloss="covetousness" x-translit="pleonexiai" xml:lang="grc">πλεονεξίᾳ</char> <char style="w" x-id="SBLGNT.2PE.2.3.004" x-align="2PE.2.3.a004" x-target-ids="t007" x-target="feigned" x-target-head="t007" x-head="true" lemma="πλαστός" strong="G4112" x-morph="A-DPM" x-gloss="with fabricated" x-translit="plastois" xml:lang="grc">πλαστοῖς</char> <char style="w" x-id="SBLGNT.2PE.2.3.005" x-align="2PE.2.3.a005" x-target-ids="t006 t008" x-target="with words" x-target-head="t008" x-head="true" lemma="λόγος" strong="G3056" x-morph="N-DPM" x-gloss="words" x-translit="logois" xml:lang="grc">λόγοις</char> <char style="w" x-id="SBLGNT.2PE.2.3.006" x-align="2PE.2.3.a007" x-target-ids="t011 t012" x-target="of you" x-target-head="t012" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.2PE.2.3.007" x-align="2PE.2.3.a006" x-target-ids="t004 t005 t009 t010" x-target="shall they make merchandise" x-target-head="t010" x-head="true" lemma="ἐμπορεύομαι" strong="G1710" x-morph="V-FDI-3P" x-gloss="they will exploit" x-translit="emporeusontai" xml:lang="grc">ἐμπορεύσονται</char>·<char style="w" x-id="SBLGNT.2PE.2.3.008" x-align="2PE.2.3.a008" x-target-ids="t013" x-target="wh