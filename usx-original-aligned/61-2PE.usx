	<para style="p"><verse number="20" style="v" x-ref="2PE.1.20" sid="2PE 1:20" /><char style="w" x-id="SBLGNT.2PE.1.20.001" x-align="2PE.1.20.a002" x-target-ids="t002" x-target="this" x-target-head="t002" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.2PE.1.20.002" x-align="2PE.1.20.a003" x-target-ids="t003" x-target="first" x-target-head="t003" x-head="true" lemma="πρῶτος" strong="G4412" x-morph="ADV-S" x-gloss="first" x-translit="prōton" xml:lang="grc">πρῶτον</char> <char style="w" x-id="SBLGNT.2PE.1.20.003" x-align="2PE.1.20.a001" x-target-ids="t001" x-target="knowing" x-target-head="t001" x-head="true" lemma="γινώσκω" strong="G1097" x-morph="V-PAP-NPM" x-gloss="knowing" x-translit="ginōskontes" xml:lang="grc">γινώσκοντες</char> <char style="w" x-id="SBLGNT.2PE.1.20.004" x-align="2PE.1.20.a004" x-target-ids="t004" x-target="that" x-target-head="t004" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.2PE.1.20.005" x-align="2PE.1.20.a005" x-target-ids="t005" x-target="no" x-target-head="t005" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NSF" x-gloss="any" x-translit="pasa" xml:lang="grc">πᾶσα</char> <char style="w" x-id="SBLGNT.2PE.1.20.006" x-align="2PE.1.20.a006" x-target-ids="t006" x-target="prophecy" x-target-head="t006" x-head="true" lemma="προφητεία" strong="G4394" x-morph="N-NSF" x-gloss="prophecy" x-translit="prophēteia" xml:lang="grc">προφητεία</char> <char style="w" x-id="SBLGNT.2PE.1.20.007" x-align="2PE.1.20.a007" x-target-ids="t007 t008" x-target="of scripture" x-target-head="t008" x-head="true" lemma="γραφή" strong="G1124" x-morph="N-GSF" x-gloss="of Scripture" x-translit="graphēs" xml:lang="grc">γραφῆς</char> <char style="w" x-id="SBLGNT.2PE.1.20.008" x-align="2PE.1.20.a010" x-target-ids="t011" x-target="private" x-target-head="t011" x-head="true" lem