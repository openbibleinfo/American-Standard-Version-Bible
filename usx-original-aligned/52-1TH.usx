	<para style="p"><verse number="10" style="v" x-ref="1TH.5.10" sid="1TH 5:10" /><char style="w" x-id="SBLGNT.1TH.5.10.001" x-align="1TH.5.10.a001" x-target-ids="t001" x-target="who" x-target-head="t001" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSM" x-gloss="the [One]" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.1TH.5.10.002" x-align="1TH.5.10.a002" x-target-ids="t002" x-target="died" x-target-head="t002" x-head="true" lemma="ἀποθνῄσκω" strong="G599" x-morph="V-2AAP-GSM" x-gloss="having died" x-translit="apothanontos" xml:lang="grc">ἀποθανόντος</char> <char style="w" x-id="SBLGNT.1TH.5.10.003" x-align="1TH.5.10.a003" x-target-ids="t003" x-target="for" x-target-head="t003" x-head="true" lemma="περί" strong="G5228" x-morph="PREP" x-gloss="for" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.1TH.5.10.004" x-align="1TH.5.10.a004" x-target-ids="t004" x-target="us" x-target-head="t004" x-head="true" lemma="ἐγώ" strong="G2257" x-morph="P-1GP" x-gloss="us" x-translit="hēmōn" xml:lang="grc">ἡμῶν</char> <char style="w" x-id="SBLGNT.1TH.5.10.005" x-align="1TH.5.10.a005" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.1TH.5.10.006" x-align="1TH.5.10.a006" x-target-ids="t006" x-target="whether" x-target-head="t006" x-head="true" lemma="εἴτε" strong="G1535" x-morph="CONJ" x-gloss="whether" x-translit="eite" xml:lang="grc">εἴτε</char> <char style="w" x-id="SBLGNT.1TH.5.10.007" x-align="1TH.5.10.a007" x-target-ids="t007 t008" x-target="we wake" x-target-head="t008" x-head="true" lemma="γρηγορέω" strong="G1127" x-morph="V-PAS-1P" x-gloss="we might watch" x-translit="grēgorōmen" xml:lang="grc">γρηγορῶμεν</char> <char style="w" x-id="SBLGNT.1TH.5.10.008" x-align="1TH.5.10.a008" x-target-ids="t009" x-target="or" x-target-head="t009" x-head="true" lemma="εἴτε" strong="G153