	<para style="p"><verse number="3" style="v" x-ref="1TH.3.3" sid="1TH 3:3" /><char style="w" x-id="SBLGNT.1TH.3.3.001" x-align="1TH.3.3.a001" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-ASN" x-gloss="that" x-translit="to" xml:lang="grc">τὸ</char> <char style="w" x-id="SBLGNT.1TH.3.3.002" x-align="1TH.3.3.a002" x-target-ids="t002 t003" x-target="no man" x-target-head="t002" x-head="true" lemma="μηδείς" strong="G3367" x-morph="A-ASM-N" x-gloss="no one" x-translit="mēdena" xml:lang="grc">μηδένα</char> <char style="w" x-id="SBLGNT.1TH.3.3.003" x-align="1TH.3.3.a003" x-target-ids="t001 t004 t005" x-target="that be moved" x-target-head="t005" x-head="true" lemma="σαίνομαι" strong="G4525" x-morph="V-PPN" x-gloss="be moved" x-translit="sainesthai" xml:lang="grc">σαίνεσθαι</char> <char style="w" x-id="SBLGNT.1TH.3.3.004" x-align="1TH.3.3.a004" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.1TH.3.3.005" x-align="1TH.3.3.a005" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPF" x-gloss="the" x-translit="tais" xml:lang="grc">ταῖς</char> <char style="w" x-id="SBLGNT.1TH.3.3.006" x-align="1TH.3.3.a006" x-target-ids="t008" x-target="afflictions" x-target-head="t008" x-head="true" lemma="θλῖψις" strong="G2347" x-morph="N-DPF" x-gloss="tribulations" x-translit="thlipsesin" xml:lang="grc">θλίψεσιν</char> <char style="w" x-id="SBLGNT.1TH.3.3.007" x-align="1TH.3.3.a007" x-target-ids="t007" x-target="these" x-target-head="t007" x-head="true" lemma="οὗτος" strong="G5025" x-morph="D-DPF" x-gloss="these" x-translit="tautais" xml:lang="grc">ταύταις</char>.<char style="w" x-id="SBLGNT.1TH.3.3.008" x-align="1TH.3.3.a008" x-target-ids="t010" x-target="yourselves" x-target-head="t010" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NPM" x-gloss="Yourselves" x-translit="autoi" xml:lang="gr