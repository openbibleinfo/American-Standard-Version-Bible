	<para style="p"><verse number="2" style="v" x-ref="1TH.5.2" sid="1TH 5:2" /><char style="w" x-id="SBLGNT.1TH.5.2.001" x-align="1TH.5.2.a001" x-target-ids="t002" x-target="yourselves" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NPM" x-gloss="Yourselves" x-translit="autoi" xml:lang="grc">αὐτοὶ</char> <char style="w" x-id="SBLGNT.1TH.5.2.002" x-align="1TH.5.2.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.1TH.5.2.003" x-align="1TH.5.2.a003" x-target-ids="t004" x-target="perfectly" x-target-head="t004" x-head="true" lemma="ἀκριβῶς" strong="G199" x-morph="ADV" x-gloss="fully" x-translit="akribōs" xml:lang="grc">ἀκριβῶς</char> <char style="w" x-id="SBLGNT.1TH.5.2.004" x-align="1TH.5.2.a004" x-target-ids="t003" x-target="know" x-target-head="t003" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAI-2P" x-gloss="you know" x-translit="oidate" xml:lang="grc">οἴδατε</char> <char style="w" x-id="SBLGNT.1TH.5.2.005" x-align="1TH.5.2.a005" x-target-ids="t005" x-target="that" x-target-head="t005" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gloss="that" x-translit="hoti" xml:lang="grc">ὅτι</char> <char style="w" x-id="SBLGNT.1TH.5.2.006" x-align="1TH.5.2.a006" x-target-ids="t006 t007" x-target="the day" x-target-head="t007" x-head="true" lemma="ἡμέρα" strong="G2250" x-morph="N-NSF" x-gloss="[the] day" x-translit="hēmera" xml:lang="grc">ἡμέρα</char> <char style="w" x-id="SBLGNT.1TH.5.2.007" x-align="1TH.5.2.a007" x-target-ids="t008 t009 t010" x-target="of the Lord" x-target-head="t010" x-head="true" lemma="κύριος" strong="G2962" x-morph="N-GSM" x-gloss="of [the] Lord" x-translit="kyriou" xml:lang="grc">κυρίου</char> <char style="w" x-id="SBLGNT.1TH.5.2.008" x-align="1TH.5.2.a008" x-target-ids="t013" x-target="as" x-target-head="t013" x-head="true" lemma="ὡς" strong="G5613" x-morp