	<para style="p"><verse number="4" style="v" x-ref="1TH.3.4" sid="1TH 3:4" /><char style="w" x-id="SBLGNT.1TH.3.4.001" x-align="1TH.3.4.a001" x-target-ids="t002" x-target="verily" x-target-head="t002" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="And" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.1TH.3.4.002" x-align="1TH.3.4.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="indeed" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.1TH.3.4.003" x-align="1TH.3.4.a003" x-target-ids="t003" x-target="when" x-target-head="t003" x-head="true" lemma="ὅτε" strong="G3753" x-morph="ADV" x-gloss="when" x-translit="hote" xml:lang="grc">ὅτε</char> <char style="w" x-id="SBLGNT.1TH.3.4.004" x-align="1TH.3.4.a004" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="with" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.1TH.3.4.005" x-align="1TH.3.4.a005" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char> <char style="w" x-id="SBLGNT.1TH.3.4.006" x-align="1TH.3.4.a006" x-target-ids="t004 t005" x-target="we were" x-target-head="t005" x-head="true" lemma="εἰμί" strong="G2252" x-morph="V-IAI-1P" x-gloss="we were" x-translit="ēmen" xml:lang="grc">ἦμεν</char>,<char style="w" x-id="SBLGNT.1TH.3.4.007" x-align="1TH.3.4.a007" x-target-ids="t008 t009 t011" x-target="we told beforehand" x-target-head="t009" x-head="true" lemma="προλέγω" strong="G4302" x-morph="V-IAI-1P" x-gloss="we were telling beforehand" x-translit="proelegomen" xml:lang="grc">προελέγομεν</char> <char style="w" x-id="SBLGNT.1TH.3.4.008" x-align="1TH.3.4.a008" x-target-ids="t010" x-target="you" x-target-head="t010" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" 