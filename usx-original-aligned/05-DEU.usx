	<para style="p"><verse number="24" style="v" x-ref="DEU.12.24" sid="DEU 12:24" /><char style="w" x-id="WLC.DEU.12.24.001" x-align="DEU.12.24.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֖א</char> <char style="w" x-id="WLC.DEU.12.24.002" x-align="DEU.12.24.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt eat" x-target-head="t004" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqi2ms" x-gloss="you" x-translit="tōʾḵl" xml:lang="hbo">תֹּאכְלֶ֑</char><char style="w" x-id="WLC.DEU.12.24.003" x-align="DEU.12.24.a003" x-target-ids="t005" x-target="it" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="must.eat.it" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.DEU.12.24.004" x-align="DEU.12.24.a004" x-target-ids="t011" x-target="upon" x-target-head="t011" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.DEU.12.24.005" x-align="DEU.12.24.a005" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.DEU.12.24.006" x-align="DEU.12.24.a006" x-target-ids="t013" x-target="earth" x-target-head="t013" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="ground" x-translit="ʾāreṣ" xml:lang="hbo">אָ֥רֶץ</char> <char style="w" x-id="WLC.DEU.12.24.007" x-align="DEU.12.24.a007" x-target-ids="t006 t007 t008 t010" x-target="thou shalt pour out" x-target-head="t008" x-head="true" lemma="שָׁפַךְ" strong="H8210" x-morph="Vqi2ms" x-gloss="you" x-translit="tišpəḵ" xml:lang="hbo">תִּשְׁפְּכֶ֖</char><char style="w" x-id="WLC.DEU.12.24.008" x-align="DEU.12.24.a008" x-target-ids="t009" x-target="it" x-target-head="t009" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms