	<para style="p"><verse number="26" style="v" x-ref="DEU.33.26" sid="DEU 33:26" /><char style="w" x-id="WLC.DEU.33.26.001" x-align="DEU.33.26.a001" x-target-ids="t001 t002 t003" x-target="There is none" x-target-head="t003" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֥ין</char> <char style="w" x-id="WLC.DEU.33.26.002" x-align="DEU.33.26.a002" x-target-ids="t004 t005" x-target="like unto" x-target-head="t004" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="kā" xml:lang="hbo">כָּ</char><char style="w" x-id="WLC.DEU.33.26.003" x-align="DEU.33.26.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.DEU.33.26.004" x-align="DEU.33.26.a004" x-target-ids="t006" x-target="God" x-target-head="t006" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֖ל</char> <char style="w" x-id="WLC.DEU.33.26.005" x-align="DEU.33.26.a005" x-target-ids="t007 t008" x-target="O Jeshurun" x-target-head="t008" x-head="true" lemma="יְשֻׁרוּן" strong="H3484" x-morph="Np" x-gloss="O.Jeshurun" x-translit="yəšurûn" xml:lang="hbo">יְשֻׁר֑וּן</char> <char style="w" x-id="WLC.DEU.33.26.006" x-align="DEU.33.26.a006" x-target-ids="t009 t010" x-target="Who rideth" x-target-head="t010" x-head="true" lemma="רָכַב" strong="H7392" x-morph="Vqrmsa" x-gloss="[who].rides" x-translit="rōḵēḇ" xml:lang="hbo">רֹכֵ֤ב</char> <char style="w" x-id="WLC.DEU.33.26.007" x-align="DEU.33.26.a007" x-target-ids="t011 t012 t013" x-target="upon the heavens" x-target-head="t013" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="heaven" x-translit="šāmayim" xml:lang="hbo">שָׁמַ֨יִם֙</char> <char style="w" x-id="WLC.DEU.33.26.008" x-align="DEU.33.26.a008" x-target-ids="t014" x-target="for" x-target-head="t014" x-head="true" lemma="בְּ" strong