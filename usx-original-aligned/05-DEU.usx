	<para style="p"><verse number="19" style="v" x-ref="DEU.23.19" sid="DEU 23:19" /><char style="w" x-id="WLC.DEU.23.19.001" x-align="DEU.23.19.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="DEU.23.20">לֹא</char>־<char style="w" x-id="WLC.DEU.23.19.002" x-align="DEU.23.19.a002" x-target-ids="t001 t002 t004 t005 t006" x-target="Thou shalt lend upon interest" x-target-head="t004" x-head="true" lemma="נָשַׁךְ" strong="H5391a" x-morph="Vhi2ms" x-gloss="you.will.charge.interest" x-translit="ṯaššiyḵ" xml:lang="hbo" x-source-ref="DEU.23.20">תַשִּׁ֣יךְ</char> <char style="w" x-id="WLC.DEU.23.19.003" x-align="DEU.23.19.a003" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo" x-source-ref="DEU.23.20">לְ</char><char style="w" x-id="WLC.DEU.23.19.004" x-align="DEU.23.19.a004" x-target-ids="t009" x-target="brother" x-target-head="t009" x-head="true" lemma="אָח" strong="H251" x-morph="Ncmsc" x-gloss="countryman" x-translit="ʾāḥiy" xml:lang="hbo" x-source-ref="DEU.23.20">אָחִ֔י</char><char style="w" x-id="WLC.DEU.23.19.005" x-align="DEU.23.19.a005" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="DEU.23.20">ךָ</char> <char style="w" x-id="WLC.DEU.23.19.006" x-align="DEU.23.19.a006" x-target-ids="t010" x-target="interest" x-target-head="t010" x-head="true" lemma="נֶשֶׁךְ" strong="H5392" x-morph="Ncmsc" x-gloss="interest" x-translit="nešeḵ" xml:lang="hbo" x-source-ref="DEU.23.20">נֶ֥שֶׁךְ</char> <char style="w" x-id="WLC.DEU.23.19.007" x-align="DEU.23.19.a007" x-target-ids="t011 t012" x-target="of money" x-target-head="t012" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="of.money" x-translit="kesep̄" xml:lang="hb