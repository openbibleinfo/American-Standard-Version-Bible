	<para style="p"><verse number="10" style="v" x-ref="DEU.22.10" sid="DEU 22:10" /><char style="w" x-id="WLC.DEU.22.10.001" x-align="DEU.22.10.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.DEU.22.10.002" x-align="DEU.22.10.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt plow" x-target-head="t004" x-head="true" lemma="חָרַשׁ" strong="H2790" x-morph="Vqi2ms" x-gloss="you.will.plow" x-translit="ṯaḥărōš" xml:lang="hbo">תַחֲרֹ֥שׁ</char> <char style="w" x-id="WLC.DEU.22.10.003" x-align="DEU.22.10.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.DEU.22.10.004" x-align="DEU.22.10.a004" x-target-ids="t006 t007" x-target="an ox" x-target-head="t007" x-head="true" lemma="שׁוֹר" strong="H7794" x-morph="Ncmsa" x-gloss="an.ox" x-translit="šôr-" xml:lang="hbo">שׁוֹר</char>־<char style="w" x-id="WLC.DEU.22.10.005" x-align="DEU.22.10.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.DEU.22.10.006" x-align="DEU.22.10.a006" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇa" xml:lang="hbo">בַ</char><char style="w" x-id="WLC.DEU.22.10.007" x-align="DEU.22.10.a007" x-target-ids="t009 t010" x-target="an ass" x-target-head="t010" x-head="true" lemma="חֲמוֹר" strong="H2543" x-morph="Ncbsa" x-gloss="a.donkey" x-translit="ḥămōr" xml:lang="hbo">חֲמֹ֖ר</char> <char style="w" x-id="WLC.DEU.22.10.008" x-align="DEU.22.10.a008" x-target-ids="t011" x-target="together" x-target-head="t011" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="together" x-translit="yaḥdāw:" xml:lang=