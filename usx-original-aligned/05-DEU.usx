	<para style="p"><verse number="16" style="v" x-ref="DEU.32.16" sid="DEU 32:16" /><char style="w" x-id="WLC.DEU.32.16.001" x-align="DEU.32.16.a001" x-target-ids="t001 t002 t004 t005" x-target="They moved to jealousy" x-target-head="t005" x-head="true" lemma="קָנָא" strong="H7065" x-morph="Vhi3mp" x-gloss="they" x-translit="yaqniʾu" xml:lang="hbo">יַקְנִאֻ֖</char><char style="w" x-id="WLC.DEU.32.16.002" x-align="DEU.32.16.a002" x-target-ids="t003" x-target="him" x-target-head="t003" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="made.him.jealous" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.DEU.32.16.003" x-align="DEU.32.16.a003" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.DEU.32.16.004" x-align="DEU.32.16.a004" x-target-ids="t007 t008" x-target="strange gods" x-target-italic-ids="t008" x-target-head="t007" x-head="true" lemma="זָר" strong="H2114b" x-morph="Aampa" x-gloss="strange.[gods]" x-translit="zāriym" xml:lang="hbo">זָרִ֑ים</char> <char style="w" x-id="WLC.DEU.32.16.005" x-align="DEU.32.16.a005" x-target-ids="t009" x-target="With" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.DEU.32.16.006" x-align="DEU.32.16.a006" x-target-ids="t010" x-target="abominations" x-target-head="t010" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfpa" x-gloss="abominations" x-translit="ṯôʿēḇōṯ" xml:lang="hbo">תוֹעֵבֹ֖ת</char> <char style="w" x-id="WLC.DEU.32.16.007" x-align="DEU.32.16.a007" x-target-ids="t011 t012 t014 t015" x-target="provoked they to anger" x-target-head="t015" x-head="true" lemma="כָּעַס" strong="H3707" x-morph="Vhi3mp" x-gloss="they" x-translit="yaḵʿiysu" xml:lang="hbo">יַכְעִיסֻֽ</char><char style="w" x-id="WLC.DEU.32.16.008" x-align="DEU.32.16.a008" x-targe