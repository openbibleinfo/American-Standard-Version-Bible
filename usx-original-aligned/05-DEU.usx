	<para style="p"><verse number="22" style="v" x-ref="DEU.22.22" sid="DEU 22:22" /><char style="w" x-id="WLC.DEU.22.22.001" x-align="DEU.22.22.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.DEU.22.22.002" x-align="DEU.22.22.a002" x-target-ids="t004 t005" x-target="be found" x-target-head="t005" x-head="true" lemma="מָצָא" strong="H4672" x-morph="VNi3ms" x-gloss="he.will.be.found" x-translit="yimmāṣēʾ" xml:lang="hbo">יִמָּצֵ֨א</char> <char style="w" x-id="WLC.DEU.22.22.003" x-align="DEU.22.22.a003" x-target-ids="t002 t003" x-target="a man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="a.man" x-translit="ʾiyš" xml:lang="hbo">אִ֜ישׁ</char> <char style="w" x-id="WLC.DEU.22.22.004" x-align="DEU.22.22.a004" x-target-ids="t006" x-target="lying" x-target-head="t006" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqrmsa" x-gloss="lying" x-translit="šōḵēḇ" xml:lang="hbo">שֹׁכֵ֣ב</char>׀<char style="w" x-id="WLC.DEU.22.22.005" x-align="DEU.22.22.a005" x-target-ids="t007" x-target="with" x-target-head="t007" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿim-" xml:lang="hbo">עִם</char>־<char style="w" x-id="WLC.DEU.22.22.006" x-align="DEU.22.22.a006" x-target-ids="t008 t009" x-target="a woman" x-target-head="t009" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsa" x-gloss="a.woman" x-translit="ʾiššāh" xml:lang="hbo">אִשָּׁ֣ה</char> <char style="w" x-id="WLC.DEU.22.22.007" x-align="DEU.22.22.a007" x-target-ids="t010" x-target="married" x-target-head="t010" x-head="true" lemma="בָּעַל" strong="H1166" x-morph="Vqsfsc" x-gloss="married" x-translit="ḇəʿulaṯ-" xml:lang="hbo">בְעֻֽלַת</char>־<char style="w" x-id="WLC.DEU.22.22.008" x-align="DEU.22.22.a008" x-target-ids="t011 t012 t013" x-target="to a husband" x-target-head="t013" x-head="true" l