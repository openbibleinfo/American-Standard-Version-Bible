	<para style="p"><verse number="23" style="v" x-ref="DEU.23.23" sid="DEU 23:23" /><char style="w" x-id="WLC.DEU.23.23.001" x-align="DEU.23.23.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="That which is gone out" x-target-head="t004" x-head="true" lemma="מוֹצָא" strong="H4161" x-morph="Ncmsc" x-gloss="the.utterance" x-translit="môṣāʾ" xml:lang="hbo" x-source-ref="DEU.23.24">מוֹצָ֥א</char> <char style="w" x-id="WLC.DEU.23.23.002" x-align="DEU.23.23.a002" x-target-ids="t006 t008" x-target="of lips" x-target-head="t008" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="your.lips" x-translit="śəp̄āṯey" xml:lang="hbo" x-source-ref="DEU.23.24">שְׂפָתֶ֖י</char><char style="w" x-id="WLC.DEU.23.23.003" x-align="DEU.23.23.a003" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo" x-source-ref="DEU.23.24">ךָ</char> <char style="w" x-id="WLC.DEU.23.23.004" x-align="DEU.23.23.a004" x-target-ids="t009 t010 t011" x-target="thou shalt observe" x-target-head="t011" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqi2ms" x-gloss="you.will.take.care" x-translit="tišmōr" xml:lang="hbo" x-source-ref="DEU.23.24">תִּשְׁמֹ֣ר</char> <char style="w" x-id="WLC.DEU.23.23.005" x-align="DEU.23.23.a005" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="DEU.23.24">וְ</char><char style="w" x-id="WLC.DEU.23.23.006" x-align="DEU.23.23.a006" x-target-ids="t013" x-target="do" x-target-head="t013" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqq2ms" x-gloss="you.will.do" x-translit="ʿāśiyṯā" xml:lang="hbo" x-source-ref="DEU.23.24">עָשִׂ֑יתָ</char> <char style="w" x-id="WLC.DEU.23.23.007" x-align="DEU.23.23.a007" x-target-ids="t014 t015" x-target="according as" x-target-head="t015" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss