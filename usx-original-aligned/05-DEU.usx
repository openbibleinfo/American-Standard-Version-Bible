	<para style="p"><verse number="25" style="v" x-ref="DEU.11.25" sid="DEU 11:25" /><char style="w" x-id="WLC.DEU.11.25.001" x-align="DEU.11.25.a001" x-target-ids="t003" x-target="no" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.DEU.11.25.002" x-align="DEU.11.25.a002" x-target-ids="t001 t002 t005 t006 t007 t008" x-target="There shall be able to stand" x-target-head="t008" x-head="true" lemma="יָצַב" strong="H3320" x-morph="Vti3ms" x-gloss="he.will.stand" x-translit="yiṯyaṣṣēḇ" xml:lang="hbo">יִתְיַצֵּ֥ב</char> <char style="w" x-id="WLC.DEU.11.25.003" x-align="DEU.11.25.a003" x-target-ids="t004" x-target="man" x-target-head="t004" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾiyš" xml:lang="hbo">אִ֖ישׁ</char> <char style="w" x-id="WLC.DEU.11.25.004" x-align="DEU.11.25.a004" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.DEU.11.25.005" x-align="DEU.11.25.a004" x-target-ids="t009" x-target="before" x-target-head="t009" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="faces" x-translit="p̄ənēy" xml:lang="hbo">פְנֵי</char><char style="w" x-id="WLC.DEU.11.25.006" x-align="DEU.11.25.a005" x-target-ids="t010" x-target="you" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="ḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.DEU.11.25.007" x-align="DEU.11.25.a006" x-target-ids="t016 t017" x-target="the fear" x-target-head="t017" x-head="true" lemma="פַּחַד" strong="H6343" x-morph="Ncmsc" x-gloss="dread" x-translit="paḥd" xml:lang="hbo">פַּחְדְּ</char><char style="w" x-id="WLC.DEU.11.25.008" x-align="DEU.11.25.a007" x-target-ids="t018 t019" x-target="of you" x-target-head="t019" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="your" x-translit="əḵem" xml