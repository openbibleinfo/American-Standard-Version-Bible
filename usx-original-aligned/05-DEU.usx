	<para style="p"><verse number="22" style="v" x-ref="DEU.21.22" sid="DEU 21:22" /><char style="w" x-id="WLC.DEU.21.22.001" x-align="DEU.21.22.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.DEU.21.22.002" x-align="DEU.21.22.a002" x-target-ids="t002" x-target="if" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="ḵiy-" xml:lang="hbo">כִֽי</char>־<char style="w" x-id="WLC.DEU.21.22.003" x-align="DEU.21.22.a003" x-target-ids="t005 t006" x-target="have committed" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3ms" x-gloss="it.will.be" x-translit="yihyeh" xml:lang="hbo">יִהְיֶ֣ה</char> <char style="w" x-id="WLC.DEU.21.22.004" x-align="DEU.21.22.a004" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.DEU.21.22.005" x-align="DEU.21.22.a005" x-target-ids="t003 t004" x-target="a man" x-target-head="t004" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾiyš" xml:lang="hbo">אִ֗ישׁ</char> <char style="w" x-id="WLC.DEU.21.22.006" x-align="DEU.21.22.a006" x-target-ids="t007 t008" x-target="a sin" x-target-head="t008" x-head="true" lemma="חֵטְא" strong="H2399" x-morph="Ncmsc" x-gloss="a.sin" x-translit="ḥēṭəʾ" xml:lang="hbo">חֵ֛טְא</char> <char style="w" x-id="WLC.DEU.21.22.007" x-align="DEU.21.22.a007" x-target-ids="t009" x-target="worthy" x-target-head="t009" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsc" x-gloss="of.a.sentence" x-translit="mišpaṭ-" xml:lang="hbo">מִשְׁפַּט</char>־<char style="w" x-id="WLC.DEU.21.22.008" x-align="DEU.21.22.a008" x-target-ids="t010 t011" x-target="of death" x-target-head="t011" x-head="true" lemma="מָוֶת" strong="H4194" x-morph="Ncmsa" x-gloss="of.death" x-transli