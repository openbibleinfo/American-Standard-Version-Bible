	<para style="p"><verse number="19" style="v" x-ref="DEU.32.19" x-added-alignments="DEU.32.19.a004 DEU.32.19.a007" x-added-target-ids="t004 t007" x-added-target="it | them" sid="DEU 32:19" /><char style="w" x-id="WLC.DEU.32.19.001" x-align="DEU.32.19.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.DEU.32.19.002" x-align="DEU.32.19.a002" x-target-ids="t003" x-target="saw" x-target-head="t003" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqw3ms" x-gloss="he.saw" x-translit="yyarəʾ" xml:lang="hbo">יַּ֥רְא</char> <char style="w" x-id="WLC.DEU.32.19.003" x-align="DEU.32.19.a003" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.DEU.32.19.004" x-align="DEU.32.19.a005" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.DEU.32.19.005" x-align="DEU.32.19.a006" x-target-ids="t006" x-target="abhorred" x-target-head="t006" x-head="true" lemma="נָאַץ" strong="H5006" x-morph="Vqw3ms" x-gloss="he.spurned" x-translit="yyinʾāṣ" xml:lang="hbo">יִּנְאָ֑ץ</char> <char style="w" x-id="WLC.DEU.32.19.006" x-align="DEU.32.19.a008" x-target-ids="t008 t009" x-target="Because of" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.DEU.32.19.007" x-align="DEU.32.19.a009" x-target-ids="t010 t011" x-target="the provocation" x-target-head="t011" x-head="true" lemma="כַּעַס" strong="H3708" x-morph="Ncmsc" x-gloss="the.provocation" x-translit="kaʿas" xml:lang="hbo">כַּ֥עַס</char> <char style="w" x-id="WLC.DEU.32.19.008" x-align="DEU.32.19.a010" x-target-id