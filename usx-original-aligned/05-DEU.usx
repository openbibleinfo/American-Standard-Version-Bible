	<para style="p"><verse number="25" style="v" x-ref="DEU.29.25" x-added-alignments="DEU.29.25.a003" x-added-target-ids="t002" x-added-target="men" sid="DEU 29:25" /><char style="w" x-id="WLC.DEU.29.25.001" x-align="DEU.29.25.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="DEU.29.24">וְ</char><char style="w" x-id="WLC.DEU.29.25.002" x-align="DEU.29.25.a002" x-target-ids="t003 t004" x-target="shall say" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq3cp" x-gloss="people.will.say" x-translit="ʾāmərû" xml:lang="hbo" x-source-ref="DEU.29.24">אָ֣מְר֔וּ</char> <char style="w" x-id="WLC.DEU.29.25.003" x-align="DEU.29.25.a004" x-target-ids="t005" x-target="Because" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal" xml:lang="hbo" x-source-ref="DEU.29.24">עַ֚ל</char> <char style="w" x-id="WLC.DEU.29.25.004" x-align="DEU.29.25.a004" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="that" x-translit="ʾăšer" xml:lang="hbo" x-source-ref="DEU.29.24">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.DEU.29.25.005" x-align="DEU.29.25.a005" x-target-ids="t006 t007" x-target="they forsook" x-target-head="t007" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqp3cp" x-gloss="they.forsook" x-translit="ʿāzəḇû" xml:lang="hbo" x-source-ref="DEU.29.24">עָֽזְב֔וּ</char> <char style="w" x-id="WLC.DEU.29.25.006" x-align="DEU.29.25.a006" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo" x-source-ref="DEU.29.24">אֶת</char>־<char style="w" x-id="WLC.DEU.29.25.007" x-align="DEU.29.25.a007" x-target-ids="t008 t009" x-target="the covenant" x-target-head="t009" x-head="true" lemma="בְּרִית" strong="H1285" x-morph="Ncfsc" x-gloss="the.covenant" x-translit="bəriyṯ" xml:lang="hbo" x-source-ref="DEU.29.24">בְּרִ֥ית</char> <char s