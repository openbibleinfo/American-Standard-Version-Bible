	<para style="p"><verse number="18" style="v" x-ref="DEU.32.18" sid="DEU 32:18" /><char style="w" x-id="WLC.DEU.32.18.001" x-align="DEU.32.18.a001" x-target-ids="t001 t002 t003" x-target="Of the Rock" x-target-head="t003" x-head="true" lemma="צוּר" strong="H6697" x-morph="Ncmsa" x-gloss="[the].rock" x-translit="ṣûr" xml:lang="hbo">צ֥וּר</char> <char style="w" x-id="WLC.DEU.32.18.002" x-align="DEU.32.18.a002" x-target-ids="t004 t005" x-target="that begat" x-target-head="t005" x-head="true" lemma="יָלַד" strong="H3205" x-morph="Vqp3ms" x-gloss="[which].he" x-translit="yəlāḏ" xml:lang="hbo">יְלָדְ</char><char style="w" x-id="WLC.DEU.32.18.003" x-align="DEU.32.18.a003" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="fathered.you" x-translit="əḵā" xml:lang="hbo">ךָ֖</char> <char style="w" x-id="WLC.DEU.32.18.004" x-align="DEU.32.18.a004" x-target-ids="t007 t008 t009" x-target="thou art unmindful" x-target-head="t009" x-head="true" lemma="שָׁיָה" strong="H7876" x-morph="Vqi2ms" x-gloss="you.forgot" x-translit="tešî" xml:lang="hbo">תֶּ֑שִׁי</char> <char style="w" x-id="WLC.DEU.32.18.005" x-align="DEU.32.18.a005" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.DEU.32.18.006" x-align="DEU.32.18.a006" x-target-ids="t011 t012" x-target="hast forgotten" x-target-head="t012" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqw2ms" x-gloss="you.forgot" x-translit="tiškaḥ" xml:lang="hbo">תִּשְׁכַּ֖ח</char> <char style="w" x-id="WLC.DEU.32.18.007" x-align="DEU.32.18.a007" x-target-ids="t013" x-target="God" x-target-head="t013" x-head="true" lemma="אֵל" strong="H410" x-morph="Ncmsa" x-gloss="God" x-translit="ʾēl" xml:lang="hbo">אֵ֥ל</char> <char style="w" x-id="WLC.DEU.32.18.008" x-align="DEU.32.18.a008" x-target-ids="t014 t015 t017" x-target="that gave birth" x-ta