	<para style="p"><verse number="17" style="v" x-ref="DEU.32.17" sid="DEU 32:17" /><char style="w" x-id="WLC.DEU.32.17.001" x-align="DEU.32.17.a001" x-target-ids="t001 t002" x-target="They sacrificed" x-target-head="t002" x-head="true" lemma="זָבַח" strong="H2076" x-morph="Vqi3mp" x-gloss="they.sacrificed" x-translit="yizbəḥû" xml:lang="hbo">יִזְבְּח֗וּ</char> <char style="w" x-id="WLC.DEU.32.17.002" x-align="DEU.32.17.a002" x-target-ids="t003" x-target="unto" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.DEU.32.17.003" x-align="DEU.32.17.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.DEU.32.17.004" x-align="DEU.32.17.a004" x-target-ids="t004" x-target="demons" x-target-head="t004" x-head="true" lemma="שֵׁד" strong="H7700" x-morph="Ncmpa" x-gloss="demons" x-translit="ššēḏîm" xml:lang="hbo">שֵּׁדִים֙</char> <char style="w" x-id="WLC.DEU.32.17.005" x-align="DEU.32.17.a005" x-target-ids="t005 t006 t007" x-target="which were no" x-target-italic-ids="t005 t006" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[which].not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.DEU.32.17.006" x-align="DEU.32.17.a006" x-target-ids="t008" x-target="God" x-target-head="t008" x-head="true" lemma="אֱלֹוהַּ" strong="H433" x-morph="Ncmsa" x-gloss="[are].God" x-translit="ʾĕlōᵃh" xml:lang="hbo">אֱלֹ֔הַ</char> <char style="w" x-id="WLC.DEU.32.17.007" x-align="DEU.32.17.a007" x-target-ids="t009 t010" x-target="To gods" x-target-head="t010" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="gods" x-translit="ʾĕlōhiym" xml:lang="hbo">אֱלֹהִ֖ים</char> <char style="w" x-id="WLC.DEU.32.17.008" x-align="DEU.32.17.a008" x-target-ids="t014" x-target="not" x-target-head="t014" x-head="true" lemma="