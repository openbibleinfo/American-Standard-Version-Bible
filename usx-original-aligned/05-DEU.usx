	<para style="p"><verse number="11" style="v" x-ref="DEU.22.11" sid="DEU 22:11" /><char style="w" x-id="WLC.DEU.22.11.001" x-align="DEU.22.11.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֤א</char> <char style="w" x-id="WLC.DEU.22.11.002" x-align="DEU.22.11.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt wear" x-target-head="t004" x-head="true" lemma="לָבֵשׁ" strong="H3847" x-morph="Vqi2ms" x-gloss="you.will.wear" x-translit="ṯilbaš" xml:lang="hbo">תִלְבַּשׁ֙</char> <char style="w" x-id="WLC.DEU.22.11.003" x-align="DEU.22.11.a003" x-target-ids="t005 t006 t007" x-target="a mingled stuff" x-target-head="t006" x-head="true" lemma="שַׁעַטְנֵז" strong="H8162" x-morph="Ncmsa" x-gloss="mixed.stuff" x-translit="šaʿaṭnēz" xml:lang="hbo">שַֽׁעַטְנֵ֔ז</char> <char style="w" x-id="WLC.DEU.22.11.004" x-align="DEU.22.11.a004" x-target-ids="t008" x-target="wool" x-target-head="t008" x-head="true" lemma="צֶמֶר" strong="H6785" x-morph="Ncmsa" x-gloss="wool" x-translit="ṣemer" xml:lang="hbo">צֶ֥מֶר</char> <char style="w" x-id="WLC.DEU.22.11.005" x-align="DEU.22.11.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.DEU.22.11.006" x-align="DEU.22.11.a006" x-target-ids="t010" x-target="linen" x-target-head="t010" x-head="true" lemma="פֵּשֶׁת" strong="H6593" x-morph="Ncmpa" x-gloss="linen(s)" x-translit="p̄ištiym" xml:lang="hbo">פִשְׁתִּ֖ים</char> <char style="w" x-id="WLC.DEU.22.11.007" x-align="DEU.22.11.a007" x-target-ids="t011" x-target="together" x-target-head="t011" x-head="true" lemma="יָחְדָּו" strong="H3162a" x-morph="D" x-gloss="together" x-translit="yaḥdāw:" xml:lang="hbo">יַחְדָּֽו</char>׃ס<verse eid="DEU 22:11" /></para>
	<para style="p"><verse number="12" style="v" x-ref="DEU.22.12" sid="DEU 22:12" /><char style="w" x-id="WLC.DEU.22.12.001" x-align="DEU.22.12.a001" x-target-ids="t005" x-target="fringes" x-target-head="t005" x-head="true" lemma="גָּדִל" strong="H1434" x-morph="Ncmpa" x-gloss="tassels" x-translit="gəḏiliym" xml:lang="hbo">גְּדִלִ֖ים</char> <char style="w" x-id="WLC.DEU.22.12.002" x-align="DEU.22.12.a002" x-target-ids="t001 t002 t003" x-target="Thou shalt make" x-target-head="t003" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi2ms" x-gloss="you.will.make" x-translit="taʿăśeh-" xml:lang="hbo">תַּעֲשֶׂה</char>־<char style="w" x-id="WLC.DEU.22.12.003" x-align="DEU.22.12.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="ll" xml:lang="hbo">לָּ֑</char><char style="w" x-id="WLC.DEU.22.12.004" x-align="DEU.22.12.a004" x-target-ids="t004" x-target="thee" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="yourself" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.DEU.22.12.005" x-align="DEU.22.12.a005" x-target-ids="t006" x-target="upon" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.DEU.22.12.006" x-align="DEU.22.12.a006" x-target-ids="t008" x-target="four" x-target-head="t008" x-head="true" lemma="אַרְבַּע" strong="H702" x-morph="Acfsa" x-gloss="the.four" x-translit="ʾarbaʿ" xml:lang="hbo">אַרְבַּ֛ע</char> <char style="w" x-id="WLC.DEU.22.12.007" x-align="DEU.22.12.a007" x-target-ids="t007 t009" x-target="the borders" x-target-head="t009" x-head="true" lemma="כָּנָף" strong="H3671" x-morph="Ncfpc" x-gloss="the.corners" x-translit="kanp̄ôṯ" xml:lang="hbo">כַּנְפ֥וֹת</char> <char style="w" x-id="WLC.DEU.22.12.008" x-align="DEU.22.12.a008" x-target-ids="t010 t012" x-target="of vesture" x-target-head="t012" x-head="true" lemma="כְּסוּת" strong="H36