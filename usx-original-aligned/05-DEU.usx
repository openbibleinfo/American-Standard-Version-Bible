	<para style="p"><verse number="6" style="v" x-ref="DEU.23.6" sid="DEU 23:6" /><char style="w" x-id="WLC.DEU.23.6.001" x-align="DEU.23.6.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="DEU.23.7">לֹא</char>־<char style="w" x-id="WLC.DEU.23.6.002" x-align="DEU.23.6.a002" x-target-ids="t001 t002 t004" x-target="Thou shalt seek" x-target-head="t004" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqi2ms" x-gloss="you.will.seek" x-translit="ṯiḏrōš" xml:lang="hbo" x-source-ref="DEU.23.7">תִדְרֹ֥שׁ</char> <char style="w" x-id="WLC.DEU.23.6.003" x-align="DEU.23.6.a003" x-target-ids="t006" x-target="peace" x-target-head="t006" x-head="true" lemma="שָׁלוֹם" strong="H7965" x-morph="Ncmsc" x-gloss="peace" x-translit="šəlōm" xml:lang="hbo" x-source-ref="DEU.23.7">שְׁלֹמָ֖</char><char style="w" x-id="WLC.DEU.23.6.004" x-align="DEU.23.6.a004" x-target-ids="t005" x-target="their" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="DEU.23.7">ם</char> <char style="w" x-id="WLC.DEU.23.6.005" x-align="DEU.23.6.a005" x-target-ids="t007" x-target="nor" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="DEU.23.7">וְ</char><char style="w" x-id="WLC.DEU.23.6.006" x-align="DEU.23.6.a006" x-target-ids="t009" x-target="prosperity" x-target-head="t009" x-head="true" lemma="טוֹבָה" strong="H2896b" x-morph="Aafsc" x-gloss="good" x-translit="ṭōḇāṯ" xml:lang="hbo" x-source-ref="DEU.23.7">טֹבָתָ֑</char><char style="w" x-id="WLC.DEU.23.6.007" x-align="DEU.23.6.a007" x-target-ids="t008" x-target="their" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo" x-source-ref="DEU.23.7">ם</char> <char style="w" x-id="WLC.DEU.23.6.008" x