	<para style="p"><verse number="12" style="v" x-ref="DEU.32.12" sid="DEU 32:12" /><char style="w" x-id="WLC.DEU.32.12.001" x-align="DEU.32.12.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.DEU.32.12.002" x-align="DEU.32.12.a002" x-target-ids="t002" x-target="alone" x-target-head="t002" x-head="true" lemma="בָּדָד" strong="H910" x-morph="Ncmsa" x-gloss="alone" x-translit="bāḏāḏ" xml:lang="hbo">בָּדָ֣ד</char> <char style="w" x-id="WLC.DEU.32.12.003" x-align="DEU.32.12.a003" x-target-ids="t003 t004" x-target="did lead" x-target-head="t004" x-head="true" lemma="נָחָה" strong="H5148" x-morph="Vhi3ms" x-gloss="he" x-translit="yanḥ" xml:lang="hbo">יַנְחֶ֑</char><char style="w" x-id="WLC.DEU.32.12.004" x-align="DEU.32.12.a004" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="guided.it" x-translit="ennû" xml:lang="hbo">נּוּ</char> <char style="w" x-id="WLC.DEU.32.12.005" x-align="DEU.32.12.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.DEU.32.12.006" x-align="DEU.32.12.a006" x-target-ids="t007 t008 t009" x-target="there was no" x-target-head="t009" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[was].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֥ין</char> <char style="w" x-id="WLC.DEU.32.12.007" x-align="DEU.32.12.a007" x-target-ids="t012" x-target="with" x-target-head="t012" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x-gloss="with" x-translit="ʿimm" xml:lang="hbo">עִמּ֖</char><char style="w" x-id="WLC.DEU.32.12.008" x-align="DEU.32.12.a008" x-target-ids="t013" x-target="him" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="h