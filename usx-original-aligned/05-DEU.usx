	<para style="p"><verse number="23" style="v" x-ref="DEU.32.23" sid="DEU 32:23" /><char style="w" x-id="WLC.DEU.32.23.001" x-align="DEU.32.23.a001" x-target-ids="t001 t002 t003" x-target="I will heap" x-target-head="t003" x-head="true" lemma="סָפָה" strong="H5595" x-morph="Vhi1cs" x-gloss="I.will.catch.up" x-translit="ʾaspeh" xml:lang="hbo">אַסְפֶּ֥ה</char> <char style="w" x-id="WLC.DEU.32.23.002" x-align="DEU.32.23.a002" x-target-ids="t005" x-target="upon" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿālēy" xml:lang="hbo">עָלֵ֖י</char><char style="w" x-id="WLC.DEU.32.23.003" x-align="DEU.32.23.a003" x-target-ids="t006" x-target="them" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="mô" xml:lang="hbo">מוֹ</char> <char style="w" x-id="WLC.DEU.32.23.004" x-align="DEU.32.23.a004" x-target-ids="t004" x-target="evils" x-target-head="t004" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfpa" x-gloss="calamities" x-translit="rāʿôṯ" xml:lang="hbo">רָע֑וֹת</char> <char style="w" x-id="WLC.DEU.32.23.005" x-align="DEU.32.23.a005" x-target-ids="t011" x-target="arrows" x-target-head="t011" x-head="true" lemma="חֵץ" strong="H2671" x-morph="Ncmpc" x-gloss="arrows" x-translit="ḥiṣṣ" xml:lang="hbo">חִצַּ֖</char><char style="w" x-id="WLC.DEU.32.23.006" x-align="DEU.32.23.a006" x-target-ids="t010" x-target="mine" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.DEU.32.23.007" x-align="DEU.32.23.a007" x-target-ids="t007 t008 t009" x-target="I will spend" x-target-head="t009" x-head="true" lemma="כָּלָה" strong="H3615" x-morph="Vpi1cs" x-gloss="I.will.use.up" x-translit="ʾăḵalleh-" xml:lang="hbo">אֲכַלֶּה</char>־<char style="w" x-id="WLC.DEU.32.23.008" x-align="DEU.32.23.a008" x-target-ids="t012" x-target="upon" x-target-head="t012" x-head="true" lemma="בְּ" st