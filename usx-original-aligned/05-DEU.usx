	<para style="p"><verse number="23" style="v" x-ref="DEU.21.23" sid="DEU 21:23" /><char style="w" x-id="WLC.DEU.21.23.001" x-align="DEU.21.23.a001" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.DEU.21.23.002" x-align="DEU.21.23.a002" x-target-ids="t003 t005 t006 t007" x-target="shall remain all night" x-target-head="t005" x-head="true" lemma="לין" strong="H3885a" x-morph="Vqi3fs" x-gloss="it.will.remain.overnight" x-translit="ṯāliyn" xml:lang="hbo">תָלִ֨ין</char> <char style="w" x-id="WLC.DEU.21.23.003" x-align="DEU.21.23.a003" x-target-ids="t002" x-target="body" x-target-head="t002" x-head="true" lemma="נְבֵלָה" strong="H5038" x-morph="Ncfsc" x-gloss="corpse" x-translit="niḇlāṯ" xml:lang="hbo">נִבְלָת֜</char><char style="w" x-id="WLC.DEU.21.23.004" x-align="DEU.21.23.a004" x-target-ids="t001" x-target="his" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.DEU.21.23.005" x-align="DEU.21.23.a005" x-target-ids="t008" x-target="upon" x-target-head="t008" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.DEU.21.23.006" x-align="DEU.21.23.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.DEU.21.23.007" x-align="DEU.21.23.a007" x-target-ids="t010" x-target="tree" x-target-head="t010" x-head="true" lemma="עֵץ" strong="H6086" x-morph="Ncmsa" x-gloss="tree" x-translit="ʿēṣ" xml:lang="hbo">עֵ֗ץ</char> <char style="w" x-id="WLC.DEU.21.23.008" x-align="DEU.21.23.a008" x-target-ids="t011" x-target="but" x-target-head="t011" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-tra