	<para style="p"><verse number="17" style="v" x-ref="DEU.23.17" sid="DEU 23:17" /><char style="w" x-id="WLC.DEU.23.17.001" x-align="DEU.23.17.a001" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo" x-source-ref="DEU.23.18">לֹא</char>־<char style="w" x-id="WLC.DEU.23.17.002" x-align="DEU.23.17.a002" x-target-ids="t001 t002 t003" x-target="There shall be" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3fs" x-gloss="she.will.be" x-translit="ṯihyeh" xml:lang="hbo" x-source-ref="DEU.23.18">תִהְיֶ֥ה</char> <char style="w" x-id="WLC.DEU.23.17.003" x-align="DEU.23.17.a003" x-target-ids="t005" x-target="prostitute" x-target-head="t005" x-head="true" lemma="קָדֵשׁ" strong="H6945" x-morph="Aafsa" x-gloss="a.female.cult.prostitute" x-translit="qəḏēšāh" xml:lang="hbo" x-source-ref="DEU.23.18">קְדֵשָׁ֖ה</char> <char style="w" x-id="WLC.DEU.23.17.004" x-align="DEU.23.17.a004" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="any" x-translit="mi" xml:lang="hbo" x-source-ref="DEU.23.18">מִ</char><char style="w" x-id="WLC.DEU.23.17.005" x-align="DEU.23.17.a005" x-target-ids="t007 t008" x-target="the daughters" x-target-head="t008" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfpc" x-gloss="of.the.daughters" x-translit="bənôṯ" xml:lang="hbo" x-source-ref="DEU.23.18">בְּנ֣וֹת</char> <char style="w" x-id="WLC.DEU.23.17.006" x-align="DEU.23.17.a006" x-target-ids="t009 t010" x-target="of Israel" x-target-head="t010" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl" xml:lang="hbo" x-source-ref="DEU.23.18">יִשְׂרָאֵ֑ל</char> <char style="w" x-id="WLC.DEU.23.17.007" x-align="DEU.23.17.a007" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="DEU.23.18">וְ</char><char style="w" x-id="WLC.DE