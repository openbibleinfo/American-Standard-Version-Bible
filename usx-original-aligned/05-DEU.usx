	<para style="p"><verse number="11" style="v" x-ref="DEU.15.11" sid="DEU 15:11" /><char style="w" x-id="WLC.DEU.15.11.001" x-align="DEU.15.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֛י</char> <char style="w" x-id="WLC.DEU.15.11.002" x-align="DEU.15.11.a002" x-target-ids="t005" x-target="never" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.DEU.15.11.003" x-align="DEU.15.11.a003" x-target-ids="t004 t006" x-target="will cease" x-target-head="t006" x-head="true" lemma="חָדַל" strong="H2308" x-morph="Vqi3ms" x-gloss="he.will.cease" x-translit="yeḥdal" xml:lang="hbo">יֶחְדַּ֥ל</char> <char style="w" x-id="WLC.DEU.15.11.004" x-align="DEU.15.11.a004" x-target-ids="t002 t003" x-target="the poor" x-target-head="t003" x-head="true" lemma="אֶבְיוֹן" strong="H34" x-morph="Aamsa" x-gloss="[the].needy" x-translit="ʾeḇyôn" xml:lang="hbo">אֶבְי֖וֹן</char> <char style="w" x-id="WLC.DEU.15.11.005" x-align="DEU.15.11.a005" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.DEU.15.11.006" x-align="DEU.15.11.a005" x-target-ids="t007 t008" x-target="out of" x-target-head="t007" x-head="true" lemma="קֶרֶב" strong="H7130" x-morph="Ncmsc" x-gloss="the.midst" x-translit="qqereḇ" xml:lang="hbo">קֶּ֣רֶב</char> <char style="w" x-id="WLC.DEU.15.11.007" x-align="DEU.15.11.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.DEU.15.11.008" x-align="DEU.15.11.a007" x-target-ids="t010" x-target="land" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="the.land" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w