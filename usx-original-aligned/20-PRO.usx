	<para style="p"><verse number="14" style="v" x-ref="PRO.14.14" sid="PRO 14:14" /><char style="w" x-id="WLC.PRO.14.14.001" x-align="PRO.14.14.a001" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.14.14.002" x-align="PRO.14.14.a002" x-target-ids="t011" x-target="ways" x-target-head="t011" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="dərāḵāy" xml:lang="hbo">דְּרָכָ֣י</char><char style="w" x-id="WLC.PRO.14.14.003" x-align="PRO.14.14.a003" x-target-ids="t009 t010" x-target="his own" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.14.14.004" x-align="PRO.14.14.a004" x-target-ids="t005 t006 t007 t016 t017 t018" x-target="shall be filled shall be satisfied" x-target-italic-ids="t016 t017 t018" x-target-head="t007" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqi3ms" x-gloss="he.will.be.satisfied" x-translit="yiśbaʿ" xml:lang="hbo">יִ֭שְׂבַּע</char> <char style="w" x-id="WLC.PRO.14.14.005" x-align="PRO.14.14.a005" x-target-ids="t001 t002" x-target="The backslider" x-target-head="t002" x-head="true" lemma="סוּג" strong="H5472" x-morph="Aamsc" x-gloss="[one.who.is].backslidden" x-translit="sûḡ" xml:lang="hbo">ס֣וּג</char> <char style="w" x-id="WLC.PRO.14.14.006" x-align="PRO.14.14.a006" x-target-ids="t003 t004" x-target="in heart" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.14.14.007" x-align="PRO.14.14.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.14.14.008" x-align="PRO.14.14.a008" x-target-