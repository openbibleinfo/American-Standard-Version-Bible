	<para style="p"><verse number="25" style="v" x-ref="PRO.20.25" x-added-alignments="PRO.20.25.a001 PRO.20.25.a005" x-added-target-ids="t001 t011" x-added-target="It | It" sid="PRO 20:25" /><char style="w" x-id="WLC.PRO.20.25.001" x-align="PRO.20.25.a002" x-target-ids="t002 t003 t004" x-target="is a snare" x-target-head="t004" x-head="true" lemma="מוֹקֵשׁ" strong="H4170" x-morph="Ncmsc" x-gloss="[is].a.snare" x-translit="môqēš" xml:lang="hbo">מוֹקֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.20.25.002" x-align="PRO.20.25.a003" x-target-ids="t005 t006 t007" x-target="to a man" x-target-head="t007" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.PRO.20.25.003" x-align="PRO.20.25.a004" x-target-ids="t008 t009 t010" x-target="rashly to say" x-target-head="t008" x-head="true" lemma="לעע" strong="H3886a" x-morph="Vqi3ms" x-gloss="[one.who].he.will.say.rashly" x-translit="yālaʿ" xml:lang="hbo">יָ֣לַע</char> <char style="w" x-id="WLC.PRO.20.25.004" x-align="PRO.20.25.a006" x-target-ids="t012 t013" x-target="is holy" x-target-italic-ids="t012" x-target-head="t013" x-head="true" lemma="קֹדֶשׁ" strong="H6944" x-morph="Ncmsa" x-gloss="holiness" x-translit="qōḏeš" xml:lang="hbo">קֹ֑דֶשׁ</char> <char style="w" x-id="WLC.PRO.20.25.005" x-align="PRO.20.25.a007" x-target-ids="t014" x-target="And" x-target-head="t014" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.20.25.006" x-align="PRO.20.25.a008" x-target-ids="t015" x-target="after" x-target-head="t015" x-head="true" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="after" x-translit="ʾaḥar" xml:lang="hbo">אַחַ֖ר</char> <char style="w" x-id="WLC.PRO.20.25.007" x-align="PRO.20.25.a009" x-target-ids="t016" x-target="vows" x-target-head="t016" x-head="true" lemma="נֶדֶר" strong="H5088" x-morph="Ncmpa" x-gloss="[the].vows" x-translit="nəḏāriym" xml