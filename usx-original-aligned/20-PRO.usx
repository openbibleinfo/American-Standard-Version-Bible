	<para style="p"><verse number="28" style="v" x-ref="PRO.30.28" x-added-alignments="PRO.30.28.a004" x-added-target-ids="t006" x-added-target="her" sid="PRO 30:28" /><char style="w" x-id="WLC.PRO.30.28.001" x-align="PRO.30.28.a001" x-target-ids="t001 t002" x-target="The lizard" x-target-head="t002" x-head="true" lemma="שְׂמָמִית" strong="H8079" x-morph="Ncfsa" x-gloss="a.lizard" x-translit="śəmāmîṯ" xml:lang="hbo">שְׂ֭מָמִית</char> <char style="w" x-id="WLC.PRO.30.28.002" x-align="PRO.30.28.a002" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.30.28.003" x-align="PRO.30.28.a003" x-target-ids="t007" x-target="hands" x-target-head="t007" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbda" x-gloss="two.hands" x-translit="yāḏayim" xml:lang="hbo">יָדַ֣יִם</char> <char style="w" x-id="WLC.PRO.30.28.004" x-align="PRO.30.28.a005" x-target-ids="t003 t004" x-target="taketh hold" x-target-head="t004" x-head="true" lemma="תָּפַשׂ" strong="H8610" x-morph="Vpi2ms" x-gloss="you.will.grasp" x-translit="təṯappēś" xml:lang="hbo">תְּתַפֵּ֑שׂ</char> <char style="w" x-id="WLC.PRO.30.28.005" x-align="PRO.30.28.a006" x-target-ids="t008" x-target="Yet" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.30.28.006" x-align="PRO.30.28.a007" x-target-ids="t010" x-target="she" x-target-head="t010" x-head="true" lemma="הִיא" strong="H1931a" x-morph="Pp3fs" x-gloss="it" x-translit="hiyʾ" xml:lang="hbo">הִ֗יא</char> <char style="w" x-id="WLC.PRO.30.28.007" x-align="PRO.30.28.a008" x-target-ids="t009 t011" x-target="is in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.30.28.008" x-align="PRO.30.28.a009" x-target-ids="t013" x