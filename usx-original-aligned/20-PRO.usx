	<para style="p"><verse number="11" style="v" x-ref="PRO.11.11" sid="PRO 11:11" /><char style="w" x-id="WLC.PRO.11.11.001" x-align="PRO.11.11.a001" x-target-ids="t001" x-target="By" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.11.11.002" x-align="PRO.11.11.a002" x-target-ids="t002 t003" x-target="the blessing" x-target-head="t003" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfsc" x-gloss="blessing" x-translit="ḇirkaṯ" xml:lang="hbo">בִרְכַּ֣ת</char> <char style="w" x-id="WLC.PRO.11.11.003" x-align="PRO.11.11.a003" x-target-ids="t004 t005 t006" x-target="of the upright" x-target-head="t006" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aampa" x-gloss="of.upright.[people]" x-translit="yəšārîm" xml:lang="hbo">יְ֭שָׁרִים</char> <char style="w" x-id="WLC.PRO.11.11.004" x-align="PRO.11.11.a004" x-target-ids="t009 t010" x-target="is exalted" x-target-head="t010" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vqi3fs" x-gloss="it.is.exalted" x-translit="tārûm" xml:lang="hbo">תָּר֣וּם</char> <char style="w" x-id="WLC.PRO.11.11.005" x-align="PRO.11.11.a005" x-target-ids="t007 t008" x-target="the city" x-target-head="t008" x-head="true" lemma="קֶרֶת" strong="H7176" x-morph="Ncfsa" x-gloss="a.town" x-translit="qāreṯ" xml:lang="hbo">קָ֑רֶת</char> <char style="w" x-id="WLC.PRO.11.11.006" x-align="PRO.11.11.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.11.11.007" x-align="PRO.11.11.a007" x-target-ids="t015" x-target="by" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.11.11.008" x-align="PRO.11.11.a008" x-target-ids="t016 t017" x-target="the mouth" x-target-head="t017" x-head="true" lem