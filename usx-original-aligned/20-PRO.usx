	<para style="p"><verse number="2" style="v" x-ref="PRO.4.2" sid="PRO 4:2" /><char style="w" x-id="WLC.PRO.4.2.001" x-align="PRO.4.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.4.2.002" x-align="PRO.4.2.a006" x-target-ids="t006" x-target="doctrine" x-target-head="t006" x-head="true" lemma="לֶקַח" strong="H3948" x-morph="Ncmsa" x-gloss="teaching" x-translit="leqaḥ" xml:lang="hbo">לֶ֣קַח</char> <char style="w" x-id="WLC.PRO.4.2.003" x-align="PRO.4.2.a005" x-target-ids="t005" x-target="good" x-target-head="t005" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ" xml:lang="hbo">ט֭וֹב</char> <char style="w" x-id="WLC.PRO.4.2.004" x-align="PRO.4.2.a002" x-target-ids="t002 t003" x-target="I give" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqp1cs" x-gloss="I.give" x-translit="nāṯatî" xml:lang="hbo">נָתַ֣תִּי</char> <char style="w" x-id="WLC.PRO.4.2.005" x-align="PRO.4.2.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.4.2.006" x-align="PRO.4.2.a004" x-target-ids="t004" x-target="you" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="āḵem" xml:lang="hbo">כֶ֑ם</char> <char style="w" x-id="WLC.PRO.4.2.007" x-align="PRO.4.2.a010" x-target-ids="t011" x-target="law" x-target-head="t011" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="instruction" x-translit="tôrāṯ" xml:lang="hbo">תּֽ֝וֹרָתִ֗</char><char style="w" x-id="WLC.PRO.4.2.008" x-align="PRO.4.2.a009" x-target-ids="t010" x-target="my" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.4.2.009" x