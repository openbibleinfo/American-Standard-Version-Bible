	<para style="p"><verse number="18" style="v" x-ref="PRO.12.18" sid="PRO 12:18" /><char style="w" x-id="WLC.PRO.12.18.001" x-align="PRO.12.18.a001" x-target-ids="t001 t002" x-target="There is" x-target-head="t002" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.12.18.002" x-align="PRO.12.18.a002" x-target-ids="t003 t004 t005" x-target="that speaketh rashly" x-target-head="t004" x-head="true" lemma="בטא" strong="H981" x-morph="Vqrmsa" x-gloss="[one.who].speaks.rashly" x-translit="bôṭeh" xml:lang="hbo">בּ֭וֹטֶה</char><char style="w" x-id="WLC.PRO.12.18.003" x-align="PRO.12.18.a003" x-target-ids="t006" x-target="like" x-target-head="t006" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּ</char><char style="w" x-id="WLC.PRO.12.18.004" x-align="PRO.12.18.a004" x-target-ids="t007 t008" x-target="the piercings" x-target-head="t008" x-head="true" lemma="מַדְקָרָה" strong="H4094" x-morph="Ncfpc" x-gloss="thrusts" x-translit="maḏqərôṯ" xml:lang="hbo">מַדְקְר֣וֹת</char> <char style="w" x-id="WLC.PRO.12.18.005" x-align="PRO.12.18.a005" x-target-ids="t009 t010 t011" x-target="of a sword" x-target-head="t011" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="of.a.sword" x-translit="ḥāreḇ" xml:lang="hbo">חָ֑רֶב</char> <char style="w" x-id="WLC.PRO.12.18.006" x-align="PRO.12.18.a006" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.12.18.007" x-align="PRO.12.18.a007" x-target-ids="t013 t014" x-target="the tongue" x-target-head="t014" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="tongue" x-translit="ləšôn" xml:lang="hbo">לְשׁ֖וֹן</char> <char style="w" x-id="WLC.PRO.12.18.008" x-align="PRO.12.18.a008" x-target-ids="t015 t016 t017" x-target="