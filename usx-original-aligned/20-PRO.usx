	<para style="p"><verse number="9" style="v" x-ref="PRO.15.9" sid="PRO 15:9" /><char style="w" x-id="WLC.PRO.15.9.001" x-align="PRO.15.9.a003" x-target-ids="t006 t007 t008" x-target="is an abomination" x-target-head="t008" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[is].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.15.9.002" x-align="PRO.15.9.a004" x-target-ids="t009 t010" x-target="to Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.15.9.003" x-align="PRO.15.9.a001" x-target-ids="t001 t002" x-target="The way" x-target-head="t002" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="the.way" x-translit="dereḵ" xml:lang="hbo">דֶּ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.15.9.004" x-align="PRO.15.9.a002" x-target-ids="t003 t004 t005" x-target="of the wicked" x-target-head="t005" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="of.a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֑ע</char> <char style="w" x-id="WLC.PRO.15.9.005" x-align="PRO.15.9.a005" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.15.9.006" x-align="PRO.15.9.a007" x-target-ids="t014 t015 t016 t017" x-target="him that followeth after" x-target-head="t016" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vprmsa" x-gloss="[one.who].pursues" x-translit="məraddēp̄" xml:lang="hbo">מְרַדֵּ֖ף</char> <char style="w" x-id="WLC.PRO.15.9.007" x-align="PRO.15.9.a008" x-target-ids="t018" x-target="righteousness" x-target-head="t018" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְדָקָ֣ה</char> <char style="w" x-id="WLC.PRO.15.9.008" x-