	<para style="p"><verse number="21" style="v" x-ref="PRO.10.21" sid="PRO 10:21" /><char style="w" x-id="WLC.PRO.10.21.001" x-align="PRO.10.21.a001" x-target-ids="t001 t002" x-target="The lips" x-target-head="t002" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="[the].lips" x-translit="śip̄ṯēy" xml:lang="hbo">שִׂפְתֵ֣י</char> <char style="w" x-id="WLC.PRO.10.21.002" x-align="PRO.10.21.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddîq" xml:lang="hbo">צַ֭דִּיק</char> <char style="w" x-id="WLC.PRO.10.21.003" x-align="PRO.10.21.a003" x-target-ids="t006" x-target="feed" x-target-head="t006" x-head="true" lemma="רָעָה" strong="H7462" x-morph="Vqi3mp" x-gloss="they.feed" x-translit="yirʿû" xml:lang="hbo">יִרְע֣וּ</char> <char style="w" x-id="WLC.PRO.10.21.004" x-align="PRO.10.21.a004" x-target-ids="t007" x-target="many" x-target-head="t007" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="many.[people]" x-translit="rabbiym" xml:lang="hbo">רַבִּ֑ים</char> <char style="w" x-id="WLC.PRO.10.21.005" x-align="PRO.10.21.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="we" xml:lang="hbo">וֶֽ֝</char><char style="w" x-id="WLC.PRO.10.21.006" x-align="PRO.10.21.a006" x-target-ids="t009 t010" x-target="the foolish" x-target-head="t010" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aampa" x-gloss="fools" x-translit="ʾĕwîliym" xml:lang="hbo">אֱוִילִ֗ים</char> <char style="w" x-id="WLC.PRO.10.21.007" x-align="PRO.10.21.a007" x-target-ids="t012" x-target="for" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PRO.10.21.008" x-align="PRO.10.21.a008" x-target-ids="t013" x-target="lack" x-target-head="t013" x-head="t