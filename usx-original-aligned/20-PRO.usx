	<para style="p"><verse number="23" style="v" x-ref="PRO.23.23" x-added-alignments="PRO.23.23.a006 PRO.23.23.a007" x-added-target-ids="t006 t008" x-added-target="it | Yea" sid="PRO 23:23" /><char style="w" x-id="WLC.PRO.23.23.001" x-align="PRO.23.23.a001" x-target-ids="t002 t003" x-target="the truth" x-target-head="t003" x-head="true" lemma="אֱמֶת" strong="H571" x-morph="Ncfsa" x-gloss="truth" x-translit="ʾĕmeṯ" xml:lang="hbo">אֱמֶ֣ת</char> <char style="w" x-id="WLC.PRO.23.23.002" x-align="PRO.23.23.a002" x-target-ids="t001" x-target="Buy" x-target-head="t001" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqv2ms" x-gloss="buy" x-translit="qənēh" xml:lang="hbo">קְ֭נֵה</char> <char style="w" x-id="WLC.PRO.23.23.003" x-align="PRO.23.23.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.23.23.004" x-align="PRO.23.23.a004" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.23.23.005" x-align="PRO.23.23.a005" x-target-ids="t005" x-target="sell" x-target-head="t005" x-head="true" lemma="מָכַר" strong="H4376" x-morph="Vqj2ms" x-gloss="sell.[it]" x-translit="timkōr" xml:lang="hbo">תִּמְכֹּ֑ר</char> <char style="w" x-id="WLC.PRO.23.23.006" x-align="PRO.23.23.a008" x-target-ids="t009" x-target="wisdom" x-target-head="t009" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֖ה</char> <char style="w" x-id="WLC.PRO.23.23.007" x-align="PRO.23.23.a009" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.23.23.008" x-align="PRO.23.23.a010" x-target-ids="t011" x-target="instruction"