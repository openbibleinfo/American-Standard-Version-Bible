	<para style="p"><verse number="15" style="v" x-ref="PRO.13.15" sid="PRO 13:15" /><char style="w" x-id="WLC.PRO.13.15.001" x-align="PRO.13.15.a001" x-target-ids="t002" x-target="understanding" x-target-head="t002" x-head="true" lemma="שֵׂכֶל" strong="H7922" x-morph="Ncmsa" x-gloss="insight" x-translit="śēḵel-" xml:lang="hbo">שֵֽׂכֶל</char>־<char style="w" x-id="WLC.PRO.13.15.002" x-align="PRO.13.15.a002" x-target-ids="t001" x-target="Good" x-target-head="t001" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ" xml:lang="hbo">ט֭וֹב</char> <char style="w" x-id="WLC.PRO.13.15.003" x-align="PRO.13.15.a003" x-target-ids="t003" x-target="giveth" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="it.gives" x-translit="yitten-" xml:lang="hbo">יִתֶּן</char>־<char style="w" x-id="WLC.PRO.13.15.004" x-align="PRO.13.15.a004" x-target-ids="t004" x-target="favor" x-target-head="t004" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="favor" x-translit="ḥēn" xml:lang="hbo">חֵ֑ן</char> <char style="w" x-id="WLC.PRO.13.15.005" x-align="PRO.13.15.a005" x-target-ids="t005" x-target="But" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.15.006" x-align="PRO.13.15.a006" x-target-ids="t006 t007" x-target="the way" x-target-head="t007" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="ḏereḵ" xml:lang="hbo">דֶ֖רֶךְ</char> <char style="w" x-id="WLC.PRO.13.15.007" x-align="PRO.13.15.a007" x-target-ids="t008 t009 t010" x-target="of the transgressor" x-target-head="t010" x-head="true" lemma="בָּגַד" strong="H898" x-morph="Vqrmpa" x-gloss="of.[those.who].act.treacherously" x-translit="bōḡəḏiym" xml:lang="hbo">בֹּגְדִ֣ים</char> <char style="w" x-id="WLC.PRO.13.15.008" x-align="PRO.13.15.a008" x-target-ids="t011 t012" x-target="is hard" x-target-head="t