	<para style="p"><verse number="7" style="v" x-ref="PRO.9.7" sid="PRO 9:7" /><char style="w" x-id="WLC.PRO.9.7.001" x-align="PRO.9.7.a001" x-target-ids="t001 t002 t003" x-target="He that correcteth" x-target-head="t003" x-head="true" lemma="יָסַר" strong="H3256" x-morph="Vqrmsa" x-gloss="[one.who].admonishes" x-translit="yōsēr" xml:lang="hbo">יֹ֤סֵ֨ר</char>׀<char style="w" x-id="WLC.PRO.9.7.002" x-align="PRO.9.7.a002" x-target-ids="t004 t005" x-target="a scoffer" x-target-head="t005" x-head="true" lemma="לֵץ" strong="H3887a" x-morph="Aamsa" x-gloss="a.mocker" x-translit="lēṣ" xml:lang="hbo">לֵ֗ץ</char> <char style="w" x-id="WLC.PRO.9.7.003" x-align="PRO.9.7.a003" x-target-ids="t006 t017" x-target="getteth getteth" x-target-italic-ids="t017" x-target-head="t006" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqrmsa" x-gloss="[is].receiving" x-translit="lōqēḥa" xml:lang="hbo">לֹקֵ֣חַֽ</char> <char style="w" x-id="WLC.PRO.9.7.004" x-align="PRO.9.7.a004" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">ל֣</char><char style="w" x-id="WLC.PRO.9.7.005" x-align="PRO.9.7.a005" x-target-ids="t008" x-target="himself" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="himself" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.9.7.006" x-align="PRO.9.7.a006" x-target-ids="t009" x-target="reviling" x-target-head="t009" x-head="true" lemma="קָלוֹן" strong="H7036" x-morph="Ncmsa" x-gloss="shame" x-translit="qālôn" xml:lang="hbo">קָל֑וֹן</char> <char style="w" x-id="WLC.PRO.9.7.007" x-align="PRO.9.7.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.9.7.008" x-align="PRO.9.7.a008" x-target-ids="t011 t012 t013" x-target="he that reproveth" x-target-head="t013" x-head="true" le