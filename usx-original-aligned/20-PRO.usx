	<para style="p"><verse number="25" style="v" x-ref="PRO.26.25" sid="PRO 26:25" /><char style="w" x-id="WLC.PRO.26.25.001" x-align="PRO.26.25.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.26.25.002" x-align="PRO.26.25.a002" x-status="noncompositional" x-target-ids="t002 t003 t004" x-target="he speaketh fair" x-target-head="t003" x-head="true" lemma="חָנַן" strong="H2603" x-morph="Vpi3ms" x-gloss="he.will.make.favorable" x-translit="yəḥannēn" xml:lang="hbo">יְחַנֵּ֣ן</char> <char style="w" x-id="WLC.PRO.26.25.003" x-align="PRO.26.25.a002" x-status="noncompositional" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="voice" x-translit="qôl" xml:lang="hbo">ק֭וֹל</char><char style="w" x-id="WLC.PRO.26.25.004" x-align="PRO.26.25.a003" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.26.25.005" x-align="PRO.26.25.a004" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.26.25.006" x-align="PRO.26.25.a005" x-target-ids="t005" x-target="believe" x-target-head="t005" x-head="true" lemma="אָמַן" strong="H539" x-morph="Vhj2ms" x-gloss="trust" x-translit="taʾămen-" xml:lang="hbo">תַּֽאֲמֶן</char>־<char style="w" x-id="WLC.PRO.26.25.007" x-align="PRO.26.25.a006" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="b" xml:lang="hbo">בּ֑</char><char style="w" x-id="WLC.PRO.26.25.008" x-align="PRO.26.25.a007" x-target-ids="t006" x-target="him" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.26.25