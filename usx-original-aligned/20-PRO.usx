	<para style="p"><verse number="6" style="v" x-ref="PRO.15.6" sid="PRO 15:6" /><char style="w" x-id="WLC.PRO.15.6.001" x-align="PRO.15.6.a001" x-target-ids="t001 t002 t003" x-target="In the house" x-target-head="t003" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="[is.the].house" x-translit="bēyṯ" xml:lang="hbo">בֵּ֣ית</char> <char style="w" x-id="WLC.PRO.15.6.002" x-align="PRO.15.6.a002" x-target-ids="t004 t005 t006" x-target="of the righteous" x-target-head="t006" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.a.righteous.[person]" x-translit="ṣaddîq" xml:lang="hbo">צַ֭דִּיק</char> <char style="w" x-id="WLC.PRO.15.6.003" x-align="PRO.15.6.a003" x-target-ids="t007 t009" x-target="is treasure" x-target-head="t009" x-head="true" lemma="חֹסֶן" strong="H2633" x-morph="Ncmsa" x-gloss="wealth" x-translit="ḥōsen" xml:lang="hbo">חֹ֣סֶן</char> <char style="w" x-id="WLC.PRO.15.6.004" x-align="PRO.15.6.a004" x-target-ids="t008" x-target="much" x-target-head="t008" x-head="true" lemma="רַב" strong="H7227" x-morph="Aamsa" x-gloss="great" x-translit="rāḇ" xml:lang="hbo">רָ֑ב</char> <char style="w" x-id="WLC.PRO.15.6.005" x-align="PRO.15.6.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.15.6.006" x-align="PRO.15.6.a006" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with.[the]" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.PRO.15.6.007" x-align="PRO.15.6.a007" x-target-ids="t012 t013" x-target="the revenues" x-target-head="t013" x-head="true" lemma="תְּבוּאָה" strong="H8393" x-morph="Ncfsc" x-gloss="income" x-translit="ṯəḇûʾaṯ" xml:lang="hbo">תְבוּאַ֖ת</char> <char style="w" x-id="WLC.PRO.15.6.008" x-align="PRO.15.6.a008" x-target-ids="t014 t015 t016" x-target="of the wicked" x-target-head="t016" 