	<para style="p"><verse number="3" style="v" x-ref="PRO.28.3" x-added-alignments="PRO.28.3.a007 PRO.28.3.a011" x-added-target-ids="t009 t014" x-added-target="like | leaveth" sid="PRO 28:3" /><char style="w" x-id="WLC.PRO.28.3.001" x-align="PRO.28.3.a001" x-target-ids="t001 t003" x-target="A man" x-target-head="t003" x-head="true" lemma="גֶּבֶר" strong="H1397" x-morph="Ncmsa" x-gloss="a.man" x-translit="geḇer" xml:lang="hbo">גֶּ֣בֶר</char> <char style="w" x-id="WLC.PRO.28.3.002" x-align="PRO.28.3.a002" x-target-ids="t002" x-target="needy" x-target-head="t002" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="poor" x-translit="rāš" xml:lang="hbo">רָ֭שׁ</char> <char style="w" x-id="WLC.PRO.28.3.003" x-align="PRO.28.3.a003" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.3.004" x-align="PRO.28.3.a004" x-target-ids="t004 t005" x-target="that oppresseth" x-target-head="t005" x-head="true" lemma="עָשַׁק" strong="H6231" x-morph="Vqrmsa" x-gloss="[one.who].oppresses" x-translit="ʿōšēq" xml:lang="hbo">עֹשֵׁ֣ק</char> <char style="w" x-id="WLC.PRO.28.3.005" x-align="PRO.28.3.a005" x-target-ids="t006 t007" x-target="the poor" x-target-head="t007" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aampa" x-gloss="poor.[people]" x-translit="dalliym" xml:lang="hbo">דַּלִּ֑ים</char> <char style="w" x-id="WLC.PRO.28.3.006" x-align="PRO.28.3.a006" x-target-ids="t008 t010 t012" x-target="Is a rain" x-target-head="t012" x-head="true" lemma="מָטַר" strong="H4306" x-morph="Ncmsa" x-gloss="rain" x-translit="māṭār" xml:lang="hbo">מָטָ֥ר</char> <char style="w" x-id="WLC.PRO.28.3.007" x-align="PRO.28.3.a008" x-target-ids="t011" x-target="sweeping" x-target-head="t011" x-head="true" lemma="סָחַף" strong="H5502" x-morph="Vqrmsa" x-gloss="[which].prostrates" x-translit="sōḥēp̄" xml:lang="hbo">סֹ֝חֵ֗ף</char> <char style="w" x-id="WLC.PRO.28.3.008" x-align="PRO.28