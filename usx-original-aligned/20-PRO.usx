	<para style="p"><verse number="25" style="v" x-ref="PRO.11.25" sid="PRO 11:25" /><char style="w" x-id="WLC.PRO.11.25.001" x-align="PRO.11.25.a001" x-target-ids="t001 t003" x-target="The soul" x-target-head="t003" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="a.person" x-translit="nep̄eš-" xml:lang="hbo">נֶֽפֶשׁ</char>־<char style="w" x-id="WLC.PRO.11.25.002" x-align="PRO.11.25.a002" x-target-ids="t002" x-target="liberal" x-target-head="t002" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfsa" x-gloss="of.blessing" x-translit="bərāḵāh" xml:lang="hbo">בְּרָכָ֥ה</char> <char style="w" x-id="WLC.PRO.11.25.003" x-align="PRO.11.25.a003" x-target-ids="t004 t005 t006 t007" x-target="shall be made fat" x-target-head="t007" x-head="true" lemma="דָּשֵׁן" strong="H1878" x-morph="VPi3fs" x-gloss="he.will.be.made.fat" x-translit="ṯəḏuššān" xml:lang="hbo">תְדֻשָּׁ֑ן</char> <char style="w" x-id="WLC.PRO.11.25.004" x-align="PRO.11.25.a004" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.11.25.005" x-align="PRO.11.25.a005" x-target-ids="t009 t010 t011" x-target="he that watereth" x-target-head="t011" x-head="true" lemma="רָוָה" strong="H7301" x-morph="Vhrmsa" x-gloss="[one.who].gives.water" x-translit="marweh" xml:lang="hbo">מַרְוֶ֗ה</char> <char style="w" x-id="WLC.PRO.11.25.006" x-align="PRO.11.25.a006" x-target-ids="t015" x-target="also" x-target-head="t015" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.PRO.11.25.007" x-align="PRO.11.25.a007" x-target-ids="t016" x-target="himself" x-target-head="t016" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֥וּא</char> <char style="w" x-id="WLC.PRO.11.25.008" x-align="PRO.11.25.a008" x-target-ids="t012 t013 t014" x-