	<para style="p"><verse number="17" style="v" x-ref="PRO.14.17" sid="PRO 14:17" /><char style="w" x-id="WLC.PRO.14.17.001" x-align="PRO.14.17.a001" x-target-ids="t001 t002 t003 t004" x-target="He that is soon" x-target-head="t004" x-head="true" lemma="קָצֵר" strong="H7116" x-morph="Aamsc" x-gloss="[a.person].short" x-translit="qəṣar-" xml:lang="hbo">קְֽצַר</char>־<char style="w" x-id="WLC.PRO.14.17.002" x-align="PRO.14.17.a002" x-target-ids="t005" x-target="angry" x-target-head="t005" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmda" x-gloss="of.anger(s)" x-translit="ʾappayim" xml:lang="hbo">אַ֭פַּיִם</char> <char style="w" x-id="WLC.PRO.14.17.003" x-align="PRO.14.17.a003" x-target-ids="t006 t007" x-target="will deal" x-target-head="t007" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi3ms" x-gloss="he.does" x-translit="yaʿăśeh" xml:lang="hbo">יַעֲשֶׂ֣ה</char> <char style="w" x-id="WLC.PRO.14.17.004" x-align="PRO.14.17.a004" x-target-ids="t008" x-target="foolishly" x-target-head="t008" x-head="true" lemma="אִוֶּלֶת" strong="H200" x-morph="Ncfsa" x-gloss="foolishness" x-translit="ʾiwweleṯ" xml:lang="hbo">אִוֶּ֑לֶת</char> <char style="w" x-id="WLC.PRO.14.17.005" x-align="PRO.14.17.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.17.006" x-align="PRO.14.17.a006" x-target-ids="t010 t011" x-target="a man" x-target-head="t011" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֥ישׁ</char> <char style="w" x-id="WLC.PRO.14.17.007" x-align="PRO.14.17.a007" x-target-ids="t012 t013 t014" x-target="of wicked devices" x-target-head="t014" x-head="true" lemma="מְזִמָּה" strong="H4209" x-morph="Ncfpa" x-gloss="of.evil.devices" x-translit="məzimmôṯ" xml:lang="hbo">מְ֝זִמּ֗וֹת</char> <char style="w" x-id="WLC.PRO.14.17.008" x-align="PRO.14.17.a008" x-target-i