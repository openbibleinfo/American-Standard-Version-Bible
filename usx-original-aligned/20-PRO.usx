	<para style="p"><verse number="1" style="v" x-ref="PRO.24.1" sid="PRO 24:1" /><char style="w" x-id="WLC.PRO.24.1.001" x-align="PRO.24.1.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.24.1.002" x-align="PRO.24.1.a002" x-target-ids="t001 t003 t004" x-target="Be thou envious" x-target-head="t004" x-head="true" lemma="קָנָא" strong="H7065" x-morph="Vpj2ms" x-gloss="be.jealous" x-translit="təqannēʾ" xml:lang="hbo">תְּ֭קַנֵּא</char> <char style="w" x-id="WLC.PRO.24.1.003" x-align="PRO.24.1.a003" x-target-ids="t005" x-target="against" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="of" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.24.1.004" x-align="PRO.24.1.a004" x-target-ids="t007" x-target="men" x-target-head="t007" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmpc" x-gloss="people" x-translit="ʾanšēy" xml:lang="hbo">אַנְשֵׁ֣י</char> <char style="w" x-id="WLC.PRO.24.1.005" x-align="PRO.24.1.a005" x-target-ids="t006" x-target="evil" x-target-head="t006" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="of.evil" x-translit="rāʿāh" xml:lang="hbo">רָעָ֑ה</char> <char style="w" x-id="WLC.PRO.24.1.006" x-align="PRO.24.1.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.24.1.007" x-align="PRO.24.1.a006" x-target-ids="t008" x-target="Neither" x-target-head="t008" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.24.1.008" x-align="PRO.24.1.a007" x-target-ids="t009" x-target="desire" x-target-head="t009" x-head="true" lemma="אָוָה" strong="H183" x-morph="Vtj2ms" x-gloss="desire" x-translit="**tiṯʾāyw" xml:lang="hbo">תִּ֝תְאָ֗יו</char> <char style="w" x-id="WLC.PRO.24.