	<para style="p"><verse number="24" style="v" x-ref="PRO.8.24" sid="PRO 8:24" /><char style="w" x-id="WLC.PRO.8.24.001" x-align="PRO.8.24.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.8.24.002" x-align="PRO.8.24.a002" x-target-ids="t002 t003 t004" x-target="there were no" x-target-head="t004" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[were].not" x-translit="ʾên-" xml:lang="hbo">אֵין</char>־<char style="w" x-id="WLC.PRO.8.24.003" x-align="PRO.8.24.a003" x-target-ids="t005" x-target="depths" x-target-head="t005" x-head="true" lemma="תְּהוֹם" strong="H8415" x-morph="Ncbpa" x-gloss="the.deeps" x-translit="təhōmôṯ" xml:lang="hbo">תְּהֹמ֥וֹת</char> <char style="w" x-id="WLC.PRO.8.24.004" x-align="PRO.8.24.a004" x-target-ids="t006 t007 t008 t009" x-target="I was brought forth" x-target-head="t008" x-head="true" lemma="חיל" strong="H2342a" x-morph="VOp1cs" x-gloss="I.was.brought.forth" x-translit="ḥôlālətî" xml:lang="hbo">חוֹלָ֑לְתִּי</char> <char style="w" x-id="WLC.PRO.8.24.005" x-align="PRO.8.24.a005" x-target-ids="t010" x-target="When" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.8.24.006" x-align="PRO.8.24.a006" x-target-ids="t011 t012 t013" x-target="there were no" x-target-head="t013" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[were].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֥ין</char> <char style="w" x-id="WLC.PRO.8.24.007" x-align="PRO.8.24.a007" x-target-ids="t014" x-target="fountains" x-target-head="t014" x-head="true" lemma="מַעְיָן" strong="H4599" x-morph="Ncmpa" x-gloss="springs" x-translit="maʿyānôṯ" xml:lang="hbo">מַ֝עְיָנ֗וֹת</char> <char style="w" x-id="WLC.PRO.8.24.008" x-align="PRO.8.24.a008" x-target-ids="t015" x-target="abounding" x-t