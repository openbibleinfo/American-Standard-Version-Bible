	<para style="p"><verse number="26" style="v" x-ref="PRO.16.26" sid="PRO 16:26" /><char style="w" x-id="WLC.PRO.16.26.001" x-align="PRO.16.26.a001" x-target-ids="t001 t002" x-target="The appetite" x-target-head="t002" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="[the].appetite" x-translit="nep̄eš" xml:lang="hbo">נֶ֣פֶשׁ</char> <char style="w" x-id="WLC.PRO.16.26.002" x-align="PRO.16.26.a002" x-target-ids="t003 t004 t005 t006" x-target="of the laboring man" x-target-head="t005" x-head="true" lemma="עָמֵל" strong="H6001" x-morph="Aamsa" x-gloss="of.a.laborer" x-translit="ʿāmēl" xml:lang="hbo">עָ֭מֵל</char> <char style="w" x-id="WLC.PRO.16.26.003" x-align="PRO.16.26.a003" x-target-ids="t007" x-target="laboreth" x-target-head="t007" x-head="true" lemma="עָמַל" strong="H5998" x-morph="Vqp3fs" x-gloss="it.toils" x-translit="ʿāməlâ" xml:lang="hbo">עָ֣מְלָה</char> <char style="w" x-id="WLC.PRO.16.26.004" x-align="PRO.16.26.a004" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="ll" xml:lang="hbo">לּ֑</char><char style="w" x-id="WLC.PRO.16.26.005" x-align="PRO.16.26.a005" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.16.26.006" x-align="PRO.16.26.a006" x-target-ids="t010" x-target="For" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.16.26.007" x-align="PRO.16.26.a009" x-target-ids="t013" x-target="urgeth" x-target-head="t013" x-head="true" lemma="אָכַף" strong="H404" x-morph="Vqp3ms" x-gloss="it.presses" x-translit="ʾāḵap̄" xml:lang="hbo">אָכַ֖ף</char> <char style="w" x-id="WLC.PRO.16.26.008" x-align="PRO.16.26.a011" x-target-ids="t015" x-target="thereto" x-target-italic-ids="t015" x-target-head="t015