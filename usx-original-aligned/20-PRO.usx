	<para style="p"><verse number="1" style="v" x-ref="PRO.9.1" sid="PRO 9:1" /><char style="w" x-id="WLC.PRO.9.1.001" x-align="PRO.9.1.a001" x-target-ids="t001" x-target="Wisdom" x-target-head="t001" x-head="true" lemma="חׇכְמוֹת" strong="H2454" x-morph="Ncfpa" x-gloss="wisdom(s)" x-translit="ḥoḵmôṯ" xml:lang="hbo">חָ֭כְמוֹת</char> <char style="w" x-id="WLC.PRO.9.1.002" x-align="PRO.9.1.a002" x-target-ids="t002 t003" x-target="hath builded" x-target-head="t003" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="Vqp3fs" x-gloss="she.has.built" x-translit="bānəṯāh" xml:lang="hbo">בָּנְתָ֣ה</char> <char style="w" x-id="WLC.PRO.9.1.003" x-align="PRO.9.1.a003" x-target-ids="t005" x-target="house" x-target-head="t005" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="ḇēyṯ" xml:lang="hbo">בֵיתָ֑</char><char style="w" x-id="WLC.PRO.9.1.004" x-align="PRO.9.1.a004" x-target-ids="t004" x-target="her" x-target-head="t004" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.9.1.005" x-align="PRO.9.1.a005" x-target-ids="t006 t007 t008 t009" x-target="She hath hewn out" x-target-head="t008" x-head="true" lemma="חָצַב" strong="H2672" x-morph="Vqp3fs" x-gloss="she.has.hewn" x-translit="ḥāṣəḇāh" xml:lang="hbo">חָצְבָ֖ה</char> <char style="w" x-id="WLC.PRO.9.1.006" x-align="PRO.9.1.a006" x-target-ids="t012" x-target="pillars" x-target-head="t012" x-head="true" lemma="עַמּוּד" strong="H5982" x-morph="Ncmpc" x-gloss="pillars" x-translit="ʿammûḏey" xml:lang="hbo">עַמּוּדֶ֣י</char><char style="w" x-id="WLC.PRO.9.1.007" x-align="PRO.9.1.a007" x-target-ids="t010" x-target="her" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.9.1.008" x-align="PRO.9.1.a008" x-target-ids="t011" x-target="seven" x-target-head="t011" x-head="true" lemma="שֶׁבַע" stron