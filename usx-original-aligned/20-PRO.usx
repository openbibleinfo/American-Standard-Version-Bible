	<para style="p"><verse number="21" style="v" x-ref="PRO.16.21" sid="PRO 16:21" /><char style="w" x-id="WLC.PRO.16.21.001" x-align="PRO.16.21.a001" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PRO.16.21.002" x-align="PRO.16.21.a002" x-target-ids="t001 t002" x-target="The wise" x-target-head="t002" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsc" x-gloss="wise" x-translit="ḥăḵam-" xml:lang="hbo">חֲכַם</char>־<char style="w" x-id="WLC.PRO.16.21.003" x-align="PRO.16.21.a003" x-target-ids="t003 t004" x-target="in heart" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֭ב</char> <char style="w" x-id="WLC.PRO.16.21.004" x-align="PRO.16.21.a004" x-target-ids="t005 t006 t007" x-target="shall be called" x-target-head="t007" x-head="true" lemma="קָרָא" strong="H7121" x-morph="VNi3ms" x-gloss="it.is.called" x-translit="yiqqārēʾ" xml:lang="hbo">יִקָּרֵ֣א</char> <char style="w" x-id="WLC.PRO.16.21.005" x-align="PRO.16.21.a005" x-target-ids="t008" x-target="prudent" x-target-head="t008" x-head="true" lemma="בִּין" strong="H995" x-morph="VNrmsa" x-gloss="[one.who].has.understanding" x-translit="nāḇôn" xml:lang="hbo">נָב֑וֹן</char> <char style="w" x-id="WLC.PRO.16.21.006" x-align="PRO.16.21.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.16.21.007" x-align="PRO.16.21.a007" x-target-ids="t010 t011" x-target="the sweetness" x-target-head="t011" x-head="true" lemma="מֶתֶק" strong="H4986" x-morph="Ncmsc" x-gloss="sweetness" x-translit="meṯeq" xml:lang="hbo">מֶ֥תֶק</char> <char style="w" x-id="WLC.PRO.16.21.008" x-align="PRO.16.21.a008" x-target-ids="t012 t013 t014" x-target="of the lips" x-target-head="t014" x-head="true" lemma="שָׂ