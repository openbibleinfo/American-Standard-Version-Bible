	<para style="p"><verse number="6" style="v" x-ref="PRO.10.6" sid="PRO 10:6" /><char style="w" x-id="WLC.PRO.10.6.001" x-align="PRO.10.6.a001" x-target-ids="t001" x-target="Blessings" x-target-head="t001" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfpa" x-gloss="blessings" x-translit="bərāḵôṯ" xml:lang="hbo">בְּ֭רָכוֹת</char> <char style="w" x-id="WLC.PRO.10.6.002" x-align="PRO.10.6.a002" x-target-ids="t002 t003" x-target="are upon" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belong].to.[the]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.10.6.003" x-align="PRO.10.6.a003" x-target-ids="t004 t005" x-target="the head" x-target-head="t005" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsa" x-gloss="head" x-translit="rōʾš" xml:lang="hbo">רֹ֣אשׁ</char> <char style="w" x-id="WLC.PRO.10.6.004" x-align="PRO.10.6.a004" x-target-ids="t006 t007 t008" x-target="of the righteous" x-target-head="t008" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PRO.10.6.005" x-align="PRO.10.6.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.6.006" x-align="PRO.10.6.a006" x-target-ids="t012 t013" x-target="the mouth" x-target-head="t013" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄iy" xml:lang="hbo">פִ֥י</char> <char style="w" x-id="WLC.PRO.10.6.007" x-align="PRO.10.6.a007" x-target-ids="t014 t015 t016" x-target="of the wicked" x-target-head="t016" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְ֝שָׁעִ֗ים</char> <char style="w" x-id="WLC.PRO.10.6.008" x-align="PRO.10.6.a008" x-target-ids="t011" x-target="covereth" x