	<para style="p"><verse number="22" style="v" x-ref="PRO.19.22" sid="PRO 19:22" /><char style="w" x-id="WLC.PRO.19.22.001" x-align="PRO.19.22.a001" x-target-ids="t001 t002 t003 t006 t007 t008" x-target="That which maketh to be desired" x-target-head="t008" x-head="true" lemma="תַּאֲוָה" strong="H8378" x-morph="Ncfsc" x-gloss="[is.the].desire" x-translit="taʾăwaṯ" xml:lang="hbo">תַּאֲוַ֣ת</char> <char style="w" x-id="WLC.PRO.19.22.002" x-align="PRO.19.22.a002" x-target-ids="t004 t005" x-target="a man" x-target-head="t005" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֣ם</char> <char style="w" x-id="WLC.PRO.19.22.003" x-align="PRO.19.22.a003" x-target-ids="t009 t011" x-target="is kindness" x-target-head="t011" x-head="true" lemma="חֶסֶד" strong="H2617" x-morph="Ncmsc" x-gloss="loyalty" x-translit="ḥasd" xml:lang="hbo">חַסְדּ֑</char><char style="w" x-id="WLC.PRO.19.22.004" x-align="PRO.19.22.a004" x-target-ids="t010" x-target="his" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.19.22.005" x-align="PRO.19.22.a005" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.22.006" x-align="PRO.19.22.a007" x-target-ids="t016 t017" x-target="is better" x-target-head="t017" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ-" xml:lang="hbo">טֽוֹב</char>־<char style="w" x-id="WLC.PRO.19.22.007" x-align="PRO.19.22.a006" x-target-ids="t013 t014 t015" x-target="a poor man" x-target-head="t014" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="[one.who.is].poor" x-translit="rāš" xml:lang="hbo">רָ֝שׁ</char> <char style="w" x-id="WLC.PRO.19.22.008" x-align="PRO.19.22.a008" x-target-ids="t018" x-targe