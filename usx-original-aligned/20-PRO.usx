	<para style="p"><verse number="28" style="v" x-ref="PRO.1.28" sid="PRO 1:28" /><char style="w" x-id="WLC.PRO.1.28.001" x-align="PRO.1.28.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֣ז</char> <char style="w" x-id="WLC.PRO.1.28.002" x-align="PRO.1.28.a002" x-target-ids="t002 t003 t004 t005" x-target="will they call upon" x-target-head="t004" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi3mp" x-gloss="they" x-translit="yiqrāʾu" xml:lang="hbo">יִ֭קְרָאֻ</char><char style="w" x-id="WLC.PRO.1.28.003" x-align="PRO.1.28.a003" x-target-ids="t006" x-target="me" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="will.call.to.me" x-translit="nəniy" xml:lang="hbo">נְנִי</char> <char style="w" x-id="WLC.PRO.1.28.004" x-align="PRO.1.28.a004" x-target-ids="t007" x-target="but" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.1.28.005" x-align="PRO.1.28.a006" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PRO.1.28.006" x-align="PRO.1.28.a005" x-target-ids="t008 t009 t011" x-target="I will answer" x-target-head="t011" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi1cs" x-gloss="I.will.answer" x-translit="ʾeʿĕneh" xml:lang="hbo">אֶֽעֱנֶ֑ה</char> <char style="w" x-id="WLC.PRO.1.28.007" x-align="PRO.1.28.a007" x-target-ids="t012 t013 t014 t016" x-target="They will seek diligently" x-target-head="t014" x-head="true" lemma="שָׁחַר" strong="H7836" x-morph="Vpi3mp" x-gloss="they" x-translit="yəšaḥăru" xml:lang="hbo">יְ֝שַׁחֲרֻ֗</char><char style="w" x-id="WLC.PRO.1.28.008" x-align="PRO.1.28.a008" x-target-ids="t015" x-target="me" x-target-head="t015" x-head="true" le