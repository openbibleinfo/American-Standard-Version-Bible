	<para style="p"><verse number="11" style="v" x-ref="PRO.20.11" sid="PRO 20:11" /><char style="w" x-id="WLC.PRO.20.11.001" x-align="PRO.20.11.a001" x-target-ids="t001" x-target="Even" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam" xml:lang="hbo">גַּ֣ם</char> <char style="w" x-id="WLC.PRO.20.11.002" x-align="PRO.20.11.a004" x-target-ids="t007" x-target="by" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.20.11.003" x-align="PRO.20.11.a006" x-target-ids="t009" x-target="doings" x-target-head="t009" x-head="true" lemma="מַעֲלָל" strong="H4611" x-morph="Ncmpc" x-gloss="deeds" x-translit="maʿălālāy" xml:lang="hbo">מַעֲלָלָי</char><char style="w" x-id="WLC.PRO.20.11.004" x-align="PRO.20.11.a005" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.20.11.005" x-align="PRO.20.11.a003" x-target-ids="t004 t005 t006" x-target="maketh himself known" x-target-head="t006" x-head="true" lemma="נָכַר" strong="H5234" x-morph="Vti3ms" x-gloss="he.makes.himself.known" x-translit="yiṯnakker-" xml:lang="hbo">יִתְנַכֶּר</char>־<char style="w" x-id="WLC.PRO.20.11.006" x-align="PRO.20.11.a002" x-target-ids="t002 t003" x-target="a child" x-target-head="t003" x-head="true" lemma="נַעַר" strong="H5288" x-morph="Ncmsa" x-gloss="a.youth" x-translit="nāʿar" xml:lang="hbo">נָ֑עַר</char> <char style="w" x-id="WLC.PRO.20.11.007" x-align="PRO.20.11.a007" x-target-ids="t010" x-target="Whether" x-target-head="t010" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.20.11.008" x-align="PRO.20.11.a010" x-target-ids="t013 t014" x-target="be pure" x-target-head="t014" x-head="true" lemma="זַךְ" strong="H2134