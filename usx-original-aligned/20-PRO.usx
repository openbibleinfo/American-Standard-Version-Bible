	<para style="p"><verse number="15" style="v" x-ref="PRO.24.15" sid="PRO 24:15" /><char style="w" x-id="WLC.PRO.24.15.001" x-align="PRO.24.15.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.24.15.002" x-align="PRO.24.15.a002" x-target-ids="t001 t003" x-target="Lay wait" x-target-head="t003" x-head="true" lemma="אָרַב" strong="H693" x-morph="Vqj2ms" x-gloss="lie.in.wait" x-translit="teʾĕrōḇ" xml:lang="hbo">תֶּאֱרֹ֣ב</char> <char style="w" x-id="WLC.PRO.24.15.003" x-align="PRO.24.15.a003" x-target-ids="t004 t005 t006" x-target="O wicked man" x-target-head="t005" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָ֭שָׁע</char> <char style="w" x-id="WLC.PRO.24.15.004" x-align="PRO.24.15.a004" x-target-ids="t007" x-target="against" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.24.15.005" x-align="PRO.24.15.a005" x-target-ids="t008 t009" x-target="the habitation" x-target-head="t009" x-head="true" lemma="נָוֶה" strong="H5116" x-morph="Ncbsc" x-gloss="habitation" x-translit="nəwēh" xml:lang="hbo">נְוֵ֣ה</char> <char style="w" x-id="WLC.PRO.24.15.006" x-align="PRO.24.15.a006" x-target-ids="t010 t011 t012" x-target="of the righteous" x-target-head="t012" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.a.righteous.[person]" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PRO.24.15.007" x-align="PRO.24.15.a007" x-target-ids="t014" x-target="not" x-target-head="t014" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.PRO.24.15.008" x-align="PRO.24.15.a008" x-target-ids="t013" x-target="Destroy" x-