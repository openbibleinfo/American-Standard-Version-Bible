	<para style="p"><verse number="7" style="v" x-ref="PRO.30.7" x-added-alignments="PRO.30.7.a009" x-added-target-ids="t010" x-added-target="them" sid="PRO 30:7" /><char style="w" x-id="WLC.PRO.30.7.001" x-align="PRO.30.7.a001" x-target-ids="t001 t002" x-target="Two things" x-target-head="t001" x-head="true" lemma="שְׁנַיִם" strong="H8147" x-morph="Acfda" x-gloss="two.[things]" x-translit="šətayim" xml:lang="hbo">שְׁ֭תַּיִם</char> <char style="w" x-id="WLC.PRO.30.7.002" x-align="PRO.30.7.a002" x-target-ids="t003 t004 t005" x-target="have I asked" x-target-head="t005" x-head="true" lemma="שָׁאַל" strong="H7592" x-morph="Vqp1cs" x-gloss="I.ask" x-translit="šāʾalətî" xml:lang="hbo">שָׁאַ֣לְתִּי</char> <char style="w" x-id="WLC.PRO.30.7.003" x-align="PRO.30.7.a003" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.30.7.004" x-align="PRO.30.7.a003" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾitt" xml:lang="hbo">אִתָּ֑</char><char style="w" x-id="WLC.PRO.30.7.005" x-align="PRO.30.7.a004" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2fs" x-gloss="you" x-translit="āḵ" xml:lang="hbo">ךְ</char> <char style="w" x-id="WLC.PRO.30.7.006" x-align="PRO.30.7.a005" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.30.7.007" x-align="PRO.30.7.a006" x-target-ids="t008" x-target="Deny" x-target-head="t008" x-head="true" lemma="מָנַע" strong="H4513" x-morph="Vqj2ms" x-gloss="withhold.[them]" x-translit="timnaʿ" xml:lang="hbo">תִּמְנַ֥ע</char> <char style="w" x-id="WLC.PRO.30.7.008" x-align="PRO.30.7.a007" x-status="unrepresented" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" x