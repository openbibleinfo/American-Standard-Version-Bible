	<para style="p"><verse number="4" style="v" x-ref="PRO.1.4" sid="PRO 1:4" /><char style="w" x-id="WLC.PRO.1.4.001" x-align="PRO.1.4.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.1.4.002" x-align="PRO.1.4.a002" x-target-ids="t002" x-target="give" x-target-head="t002" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqc" x-gloss="give" x-translit="ṯēṯ" xml:lang="hbo">תֵ֣ת</char> <char style="w" x-id="WLC.PRO.1.4.003" x-align="PRO.1.4.a003" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.1.4.004" x-align="PRO.1.4.a004" x-target-ids="t005 t006" x-target="the simple" x-target-head="t006" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmpa" x-gloss="naive.people" x-translit="p̄əṯāʾyim" xml:lang="hbo">פְתָאיִ֣ם</char> <char style="w" x-id="WLC.PRO.1.4.005" x-align="PRO.1.4.a005" x-target-ids="t003" x-target="prudence" x-target-head="t003" x-head="true" lemma="עׇרְמָה" strong="H6195" x-morph="Ncfsa" x-gloss="prudence" x-translit="ʿārəmāh" xml:lang="hbo">עָרְמָ֑ה</char> <char style="w" x-id="WLC.PRO.1.4.006" x-align="PRO.1.4.a006" x-target-ids="t007" x-target="To" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֝</char><char style="w" x-id="WLC.PRO.1.4.007" x-align="PRO.1.4.a007" x-target-ids="t008 t009 t010" x-target="the young man" x-target-head="t009" x-head="true" lemma="נַעַר" strong="H5288" x-morph="Ncmsa" x-gloss="a.youth" x-translit="naʿar" xml:lang="hbo">נַ֗עַר</char> <char style="w" x-id="WLC.PRO.1.4.008" x-align="PRO.1.4.a008" x-target-ids="t011" x-target="knowledge" x-target-head="t011" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="daʿaṯ" xml:lang=