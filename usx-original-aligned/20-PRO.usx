	<para style="p"><verse number="19" style="v" x-ref="PRO.2.19" sid="PRO 2:19" /><char style="w" x-id="WLC.PRO.2.19.001" x-align="PRO.2.19.a001" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PRO.2.19.002" x-align="PRO.2.19.a002" x-target-ids="t002 t003 t004" x-target="that go unto" x-target-head="t003" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqrmpc" x-gloss="[those" x-translit="bāʾey" xml:lang="hbo">בָּ֭אֶי</char><char style="w" x-id="WLC.PRO.2.19.003" x-align="PRO.2.19.a003" x-target-ids="t005" x-target="her" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="who].go.to.her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.2.19.004" x-align="PRO.2.19.a001" x-target-ids="t001" x-target="None" x-target-head="t001" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PRO.2.19.005" x-align="PRO.2.19.a004" x-target-ids="t006 t007" x-target="return again" x-target-head="t006" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vqi3mp" x-gloss="they" x-translit="yəšûḇû" xml:lang="hbo">יְשׁוּב֑וּ</char><char style="w" x-id="WLC.PRO.2.19.006" x-align="PRO.2.19.a005" x-status="unrepresented" x-head="true" lemma="נ" strong="H4993b" x-morph="Sn" x-gloss="return" x-translit="n" xml:lang="hbo">ן</char> <char style="w" x-id="WLC.PRO.2.19.007" x-align="PRO.2.19.a006" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.2.19.008" x-align="PRO.2.19.a006" x-target-ids="t008" x-target="Neither" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.2.19.009" x-align="PRO.2.19.a007" x-target-ids="t009 t010 t011 t012" x-target="do they attain unto" x-target-head="t011" x-head="