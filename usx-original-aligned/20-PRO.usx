	<para style="p"><verse number="17" style="v" x-ref="PRO.29.17" sid="PRO 29:17" /><char style="w" x-id="WLC.PRO.29.17.001" x-align="PRO.29.17.a001" x-target-ids="t001" x-target="Correct" x-target-head="t001" x-head="true" lemma="יָסַר" strong="H3256" x-morph="Vpv2ms" x-gloss="discipline" x-translit="yassēr" xml:lang="hbo">יַסֵּ֣ר</char> <char style="w" x-id="WLC.PRO.29.17.002" x-align="PRO.29.17.a002" x-target-ids="t003" x-target="son" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="son" x-translit="bin" xml:lang="hbo">בִּ֭נְ</char><char style="w" x-id="WLC.PRO.29.17.003" x-align="PRO.29.17.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.29.17.004" x-align="PRO.29.17.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִֽ</char><char style="w" x-id="WLC.PRO.29.17.005" x-align="PRO.29.17.a005" x-target-ids="t005 t006 t007 t009" x-target="he will give rest" x-target-head="t009" x-head="true" lemma="נוּחַ" strong="H5117" x-morph="Vhi3ms" x-gloss="he" x-translit="yniyḥ" xml:lang="hbo">ינִיחֶ֑</char><char style="w" x-id="WLC.PRO.29.17.006" x-align="PRO.29.17.a006" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.give.you.rest" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.29.17.007" x-align="PRO.29.17.a007" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.29.17.008" x-align="PRO.29.17.a008" x-target-ids="t011 t012 t013" x-target="he will give" x-target-head="t013" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms"