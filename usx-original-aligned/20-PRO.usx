	<para style="p"><verse number="21" style="v" x-ref="PRO.13.21" sid="PRO 13:21" /><char style="w" x-id="WLC.PRO.13.21.001" x-align="PRO.13.21.a001" x-target-ids="t003" x-target="sinners" x-target-head="t003" x-head="true" lemma="חַטָּא" strong="H2400" x-morph="Aampa" x-gloss="sinners" x-translit="ḥaṭṭāʾîm" xml:lang="hbo">חַ֭טָּאִים</char> <char style="w" x-id="WLC.PRO.13.21.002" x-align="PRO.13.21.a002" x-target-ids="t002" x-target="pursueth" x-target-head="t002" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vpi3fs" x-gloss="it.pursues" x-translit="təraddēp̄" xml:lang="hbo">תְּרַדֵּ֣ף</char> <char style="w" x-id="WLC.PRO.13.21.003" x-align="PRO.13.21.a003" x-target-ids="t001" x-target="Evil" x-target-head="t001" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="calamity" x-translit="rāʿāh" xml:lang="hbo">רָעָ֑ה</char> <char style="w" x-id="WLC.PRO.13.21.004" x-align="PRO.13.21.a004" x-target-ids="t004" x-target="But" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.21.005" x-align="PRO.13.21.a005" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.13.21.006" x-align="PRO.13.21.a006" x-target-ids="t005 t006" x-target="the righteous" x-target-head="t006" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַ֝דִּיקִ֗ים</char> <char style="w" x-id="WLC.PRO.13.21.007" x-align="PRO.13.21.a007" x-target-ids="t007 t008 t009" x-target="shall be recompensed" x-target-head="t009" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="Vpi3ms" x-gloss="it.rewards" x-translit="yəšallem-" xml:lang="hbo">יְשַׁלֶּם</char>־<char style="w" x-id="WLC.PRO.13.21.008" x-align="PRO.13.21.a008" x-target-ids="t010 t011" x-target="with good" x-target-head="t011" x-head="t