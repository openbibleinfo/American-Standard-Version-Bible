	<para style="p"><verse number="30" style="v" x-ref="PRO.11.30" sid="PRO 11:30" /><char style="w" x-id="WLC.PRO.11.30.001" x-align="PRO.11.30.a001" x-target-ids="t001 t002" x-target="The fruit" x-target-head="t002" x-head="true" lemma="פְּרִי" strong="H6529" x-morph="Ncmsc" x-gloss="[the].fruit" x-translit="pərî-" xml:lang="hbo">פְּֽרִי</char>־<char style="w" x-id="WLC.PRO.11.30.002" x-align="PRO.11.30.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddîq" xml:lang="hbo">צַ֭דִּיק</char> <char style="w" x-id="WLC.PRO.11.30.003" x-align="PRO.11.30.a003" x-target-ids="t006 t007 t008" x-target="is a tree" x-target-head="t008" x-head="true" lemma="עֵץ" strong="H6086" x-morph="Ncmsc" x-gloss="[is].a.tree" x-translit="ʿēṣ" xml:lang="hbo">עֵ֣ץ</char> <char style="w" x-id="WLC.PRO.11.30.004" x-align="PRO.11.30.a004" x-target-ids="t009 t010" x-target="of life" x-target-head="t010" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="of.life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.11.30.005" x-align="PRO.11.30.a005" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.30.006" x-align="PRO.11.30.a006" x-target-ids="t016" x-target="winneth" x-target-head="t016" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqrmsa" x-gloss="[one.who].takes" x-translit="lōqēᵃḥ" xml:lang="hbo">לֹקֵ֖חַ</char> <char style="w" x-id="WLC.PRO.11.30.007" x-align="PRO.11.30.a007" x-target-ids="t017" x-target="souls" x-target-head="t017" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbpa" x-gloss="people" x-translit="nəp̄āśôṯ" xml:lang="hbo">נְפָשׂ֣וֹת</char><char style="w" x-id="WLC.PRO.11.30.008" x-align="PRO.11.30.a008" x-target-ids="t012 t013 t014 t015