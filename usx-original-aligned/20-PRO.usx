	<para style="p"><verse number="24" style="v" x-ref="PRO.16.24" sid="PRO 16:24" /><char style="w" x-id="WLC.PRO.16.24.001" x-align="PRO.16.24.a003" x-target-ids="t003 t004 t005 t006" x-target="are as a honeycomb" x-target-italic-ids="t004" x-target-head="t006" x-head="true" lemma="צוּף" strong="H6688" x-morph="Ncmsc" x-gloss="[are].a.honeycomb" x-translit="ṣûp̄-" xml:lang="hbo">צוּף</char>־<char style="w" x-id="WLC.PRO.16.24.002" x-align="PRO.16.24.a003" lemma="דְּבַשׁ" strong="H1706" x-morph="Ncmsa" x-gloss="of.honey" x-translit="dəḇaš" xml:lang="hbo">דְּ֭בַשׁ</char> <char style="w" x-id="WLC.PRO.16.24.003" x-align="PRO.16.24.a002" x-target-ids="t002" x-target="words" x-target-head="t002" x-head="true" lemma="אֵמֶר" strong="H561" x-morph="Ncmpc" x-gloss="words" x-translit="ʾimrê-" xml:lang="hbo">אִמְרֵי</char>־<char style="w" x-id="WLC.PRO.16.24.004" x-align="PRO.16.24.a001" x-target-ids="t001" x-target="Pleasant" x-target-head="t001" x-head="true" lemma="נֹעַם" strong="H5278" x-morph="Ncmsa" x-gloss="of.kindness" x-translit="nōʿam" xml:lang="hbo">נֹ֑עַם</char> <char style="w" x-id="WLC.PRO.16.24.005" x-align="PRO.16.24.a004" x-target-ids="t007" x-target="Sweet" x-target-head="t007" x-head="true" lemma="מָתוֹק" strong="H4966" x-morph="Aamsa" x-gloss="a.sweet.[thing]" x-translit="māṯôq" xml:lang="hbo">מָת֥וֹק</char> <char style="w" x-id="WLC.PRO.16.24.006" x-align="PRO.16.24.a005" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ֝</char><char style="w" x-id="WLC.PRO.16.24.007" x-align="PRO.16.24.a006" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.16.24.008" x-align="PRO.16.24.a007" x-target-ids="t010" x-target="soul" x-target-head="t010" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsa" x-gloss="soul" x