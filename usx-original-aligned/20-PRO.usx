	<para style="p"><verse number="22" style="v" x-ref="PRO.4.22" sid="PRO 4:22" /><char style="w" x-id="WLC.PRO.4.22.001" x-align="PRO.4.22.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.4.22.002" x-align="PRO.4.22.a003" x-target-ids="t003 t004" x-target="are life" x-target-head="t004" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="[are].life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֣ים</char> <char style="w" x-id="WLC.PRO.4.22.003" x-align="PRO.4.22.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="הֵם" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēm" xml:lang="hbo">הֵ֭ם</char> <char style="w" x-id="WLC.PRO.4.22.004" x-align="PRO.4.22.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.4.22.005" x-align="PRO.4.22.a005" x-target-ids="t006 t007 t008" x-target="those that find" x-target-head="t008" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqrmpc" x-gloss="[those" x-translit="mōṣəʾēy" xml:lang="hbo">מֹצְאֵי</char><char style="w" x-id="WLC.PRO.4.22.006" x-align="PRO.4.22.a006" x-target-ids="t009" x-target="them" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="who].find.them" x-translit="hem" xml:lang="hbo">הֶ֑ם</char> <char style="w" x-id="WLC.PRO.4.22.007" x-align="PRO.4.22.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.PRO.4.22.008" x-align="PRO.4.22.a008" x-target-ids="t012" x-target="to" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="h