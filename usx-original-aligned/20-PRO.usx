	<para style="p"><verse number="5" style="v" x-ref="PRO.14.5" sid="PRO 14:5" /><char style="w" x-id="WLC.PRO.14.5.001" x-align="PRO.14.5.a001" x-target-ids="t001 t003" x-target="A witness" x-target-head="t003" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsc" x-gloss="a.witness" x-translit="ʿēḏ" xml:lang="hbo">עֵ֣ד</char> <char style="w" x-id="WLC.PRO.14.5.002" x-align="PRO.14.5.a002" x-target-ids="t002" x-target="faithful" x-target-head="t002" x-head="true" lemma="אֱמוּן" strong="H529" x-morph="Ncmpa" x-gloss="of.faithfulness(es)" x-translit="ʾĕmûnîm" xml:lang="hbo">אֱ֭מוּנִים</char> <char style="w" x-id="WLC.PRO.14.5.003" x-align="PRO.14.5.a003" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PRO.14.5.004" x-align="PRO.14.5.a004" x-target-ids="t004 t006" x-target="will lie" x-target-head="t006" x-head="true" lemma="כָּזַב" strong="H3576" x-morph="Vpi3ms" x-gloss="he.tells.lies" x-translit="yəḵazzēḇ" xml:lang="hbo">יְכַזֵּ֑ב</char> <char style="w" x-id="WLC.PRO.14.5.005" x-align="PRO.14.5.a005" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.5.006" x-align="PRO.14.5.a006" x-target-ids="t011" x-target="uttereth" x-target-head="t011" x-head="true" lemma="פּוּחַ" strong="H6315a" x-morph="Vhi3ms" x-gloss="he.breathes.out" x-translit="yāp̄iyᵃḥ" xml:lang="hbo">יָפִ֥יחַ</char> <char style="w" x-id="WLC.PRO.14.5.007" x-align="PRO.14.5.a007" x-target-ids="t012" x-target="lies" x-target-head="t012" x-head="true" lemma="כָּזָב" strong="H3577" x-morph="Ncmpa" x-gloss="lies" x-translit="kəzāḇiym" xml:lang="hbo">כְּ֝זָבִ֗ים</char> <char style="w" x-id="WLC.PRO.14.5.008" x-align="PRO.14.5.a008" x-target-ids="t008 t010" x-target="a witness" x-target-head="t010" x-head="true" lemma="עֵד