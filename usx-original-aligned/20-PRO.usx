	<para style="p"><verse number="19" style="v" x-ref="PRO.12.19" x-added-alignments="PRO.12.19.a008" x-added-target-ids="t015" x-added-target="but" sid="PRO 12:19" /><char style="w" x-id="WLC.PRO.12.19.001" x-align="PRO.12.19.a001" x-target-ids="t001 t002" x-target="The lip" x-target-head="t002" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfsc" x-gloss="a.lip" x-translit="śəp̄aṯ-" xml:lang="hbo">שְֽׂפַת</char>־<char style="w" x-id="WLC.PRO.12.19.002" x-align="PRO.12.19.a002" x-target-ids="t003 t004" x-target="of truth" x-target-head="t004" x-head="true" lemma="אֱמֶת" strong="H571" x-morph="Ncfsa" x-gloss="of.reliability" x-translit="ʾĕmeṯ" xml:lang="hbo">אֱ֭מֶת</char> <char style="w" x-id="WLC.PRO.12.19.003" x-align="PRO.12.19.a003" x-target-ids="t005 t006 t007" x-target="shall be established" x-target-head="t007" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNi3fs" x-gloss="it.will.be.established" x-translit="tikôn" xml:lang="hbo">תִּכּ֣וֹן</char> <char style="w" x-id="WLC.PRO.12.19.004" x-align="PRO.12.19.a004" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.12.19.005" x-align="PRO.12.19.a005" x-target-ids="t009" x-target="ever" x-target-head="t009" x-head="true" lemma="עַד" strong="H5703" x-morph="Ncmsa" x-translit="ʿaḏ" xml:lang="hbo">עַ֑ד</char> <char style="w" x-id="WLC.PRO.12.19.006" x-align="PRO.12.19.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.19.007" x-align="PRO.12.19.a007" x-target-ids="t014 t016" x-target="is for" x-target-head="t016" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PRO.12.19.008" x-align="PRO.12.19.a009" x-target-ids="t017 t018" x