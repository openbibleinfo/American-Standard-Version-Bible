	<para style="p"><verse number="20" style="v" x-ref="PRO.29.20" sid="PRO 29:20" /><char style="w" x-id="WLC.PRO.29.20.001" x-align="PRO.29.20.a001" x-target-ids="t001 t002" x-target="Seest thou" x-target-head="t001" x-head="true" lemma="חָזָה" strong="H2372" x-morph="Vqp2ms" x-gloss="do.you.see?" x-translit="ḥāziyṯā" xml:lang="hbo">חָזִ֗יתָ</char> <char style="w" x-id="WLC.PRO.29.20.002" x-align="PRO.29.20.a002" x-target-ids="t003 t004" x-target="a man" x-target-head="t004" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾîš" xml:lang="hbo">אִ֭ישׁ</char> <char style="w" x-id="WLC.PRO.29.20.003" x-align="PRO.29.20.a003" x-target-ids="t005 t006 t007" x-target="that is hasty" x-target-head="t007" x-head="true" lemma="אוּץ" strong="H213" x-morph="Vqrmsa" x-gloss="[who].hastens" x-translit="ʾāṣ" xml:lang="hbo">אָ֣ץ</char> <char style="w" x-id="WLC.PRO.29.20.004" x-align="PRO.29.20.a004" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PRO.29.20.005" x-align="PRO.29.20.a005" x-target-ids="t010" x-target="words" x-target-head="t010" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpc" x-gloss="words" x-translit="ḏəḇārāy" xml:lang="hbo">דְבָרָ֑י</char><char style="w" x-id="WLC.PRO.29.20.006" x-align="PRO.29.20.a006" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.29.20.007" x-align="PRO.29.20.a007" x-target-ids="t011 t012 t014" x-target="There is hope" x-target-head="t014" x-head="true" lemma="תִּקְוָה" strong="H8615" x-morph="Ncfsa" x-gloss="hope" x-translit="tiqwāh" xml:lang="hbo">תִּקְוָ֖ה</char> <char style="w" x-id="WLC.PRO.29.20.008" x-align="PRO.29.20.a008" x-target-ids="t015 t019" x-target="of of" x-target-head="t015" x-head="true" lemma