	<para style="p"><verse number="3" style="v" x-ref="PRO.15.3" sid="PRO 15:3" /><char style="w" x-id="WLC.PRO.15.3.001" x-align="PRO.15.3.a003" x-target-ids="t005 t006" x-target="are in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in" x-translit="bə" xml:lang="hbo">בְּֽ</char><char style="w" x-id="WLC.PRO.15.3.002" x-align="PRO.15.3.a004" x-target-ids="t007" x-target="every" x-target-head="t007" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.15.3.003" x-align="PRO.15.3.a005" x-target-ids="t008" x-target="place" x-target-head="t008" x-head="true" lemma="מָקוֹם" strong="H4725" x-morph="Ncmsa" x-gloss="place" x-translit="māqôm" xml:lang="hbo">מָ֭קוֹם</char> <char style="w" x-id="WLC.PRO.15.3.004" x-align="PRO.15.3.a001" x-target-ids="t001 t002" x-target="The eyes" x-target-head="t002" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="the.eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֣י</char> <char style="w" x-id="WLC.PRO.15.3.005" x-align="PRO.15.3.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.15.3.006" x-align="PRO.15.3.a006" x-target-ids="t009 t010 t011" x-target="Keeping watch upon" x-target-head="t010" x-head="true" lemma="צָפָה" strong="H6822" x-morph="Vqrfpa" x-gloss="[they.are].watching" x-translit="ṣōp̄ôṯ" xml:lang="hbo">צֹ֝פ֗וֹת</char> <char style="w" x-id="WLC.PRO.15.3.007" x-align="PRO.15.3.a007" x-target-ids="t012 t013" x-target="the evil" x-target-head="t013" x-head="true" lemma="רַע" strong="H7451" x-morph="Aampa" x-gloss="evil.[people]" x-translit="rāʿiym" xml:lang="hbo">רָעִ֥ים</char> <char style="w" x-id="WLC.PRO.15.3.008" x-align="PRO.15.3.a008" x-target-ids="t014" x-target="and" x-target-head="t014" x-head="tru