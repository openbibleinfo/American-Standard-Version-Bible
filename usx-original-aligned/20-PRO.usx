	<para style="p"><verse number="23" style="v" x-ref="PRO.19.23" x-added-alignments="PRO.19.23.a006" x-added-target-ids="t010 t011 t012" x-added-target="that hath it" sid="PRO 19:23" /><char style="w" x-id="WLC.PRO.19.23.001" x-align="PRO.19.23.a001" x-target-ids="t001 t002" x-target="The fear" x-target-head="t002" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="the.fear" x-translit="yirʾaṯ" xml:lang="hbo">יִרְאַ֣ת</char> <char style="w" x-id="WLC.PRO.19.23.002" x-align="PRO.19.23.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PRO.19.23.003" x-align="PRO.19.23.a003" x-target-ids="t005 t006" x-target="tendeth to" x-target-italic-ids="t005" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.19.23.004" x-align="PRO.19.23.a004" x-target-ids="t007" x-target="life" x-target-head="t007" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.19.23.005" x-align="PRO.19.23.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.23.006" x-align="PRO.19.23.a008" x-target-ids="t015" x-target="satisfied" x-target-head="t015" x-head="true" lemma="שָׂבֵעַ" strong="H7649" x-morph="Aamsa" x-gloss="satisfied" x-translit="śāḇēᵃʿ" xml:lang="hbo">שָׂבֵ֥עַ</char> <char style="w" x-id="WLC.PRO.19.23.007" x-align="PRO.19.23.a007" x-target-ids="t009 t013 t014" x-target="he shall abide" x-target-head="t014" x-head="true" lemma="לין" strong="H3885a" x-morph="Vqi3ms" x-gloss="he.will.pass.the.night" x-translit="yāliyn" xml:lang="hbo">יָ֝לִ֗ין</ch