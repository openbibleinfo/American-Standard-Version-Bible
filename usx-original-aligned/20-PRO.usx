	<para style="p"><verse number="18" style="v" x-ref="PRO.6.18" sid="PRO 6:18" /><char style="w" x-id="WLC.PRO.6.18.001" x-align="PRO.6.18.a001" x-target-ids="t001 t002" x-target="A heart" x-target-head="t002" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="a.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֗ב</char> <char style="w" x-id="WLC.PRO.6.18.002" x-align="PRO.6.18.a002" x-target-ids="t003 t004" x-target="that deviseth" x-target-head="t004" x-head="true" lemma="חָרַשׁ" strong="H2790" x-morph="Vqrmsa" x-gloss="[which].devises" x-translit="ḥōrēš" xml:lang="hbo">חֹ֭רֵשׁ</char> <char style="w" x-id="WLC.PRO.6.18.003" x-align="PRO.6.18.a003" x-target-ids="t006" x-target="purposes" x-target-head="t006" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpc" x-gloss="plans" x-translit="maḥšəḇôṯ" xml:lang="hbo">מַחְשְׁב֣וֹת</char> <char style="w" x-id="WLC.PRO.6.18.004" x-align="PRO.6.18.a004" x-target-ids="t005" x-target="wicked" x-target-head="t005" x-head="true" lemma="אָוֶן" strong="H205" x-morph="Ncmsa" x-gloss="of.wickedness" x-translit="ʾāwen" xml:lang="hbo">אָ֑וֶן</char> <char style="w" x-id="WLC.PRO.6.18.005" x-align="PRO.6.18.a005" x-target-ids="t007" x-target="Feet" x-target-head="t007" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfda" x-gloss="feet" x-translit="raḡlayim" xml:lang="hbo">רַגְלַ֥יִם</char> <char style="w" x-id="WLC.PRO.6.18.006" x-align="PRO.6.18.a006" x-target-ids="t008 t009 t010" x-target="that are swift" x-target-head="t010" x-head="true" lemma="מָהַר" strong="H4116" x-morph="Vprfpa" x-gloss="[which].hurry" x-translit="məmahărôṯ" xml:lang="hbo">מְ֝מַהֲר֗וֹת</char> <char style="w" x-id="WLC.PRO.6.18.007" x-align="PRO.6.18.a007" x-target-ids="t011" x-target="in" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.6.18.008" x-align="PRO.6.18.a008" x-target-ids="t012" x-target="running" x-target-head="t012" x-he