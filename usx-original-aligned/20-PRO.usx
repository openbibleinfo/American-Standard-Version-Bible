	<para style="p"><verse number="22" style="v" x-ref="PRO.24.22" x-added-alignments="PRO.24.22.a012" x-added-target-ids="t015" x-added-target="it" sid="PRO 24:22" /><char style="w" x-id="WLC.PRO.24.22.001" x-align="PRO.24.22.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.24.22.002" x-align="PRO.24.22.a002" x-target-ids="t006" x-target="suddenly" x-target-head="t006" x-head="true" lemma="פִּתְאֹם" strong="H6597" x-morph="D" x-gloss="suddenly" x-translit="p̄iṯʾōm" xml:lang="hbo">פִ֭תְאֹם</char> <char style="w" x-id="WLC.PRO.24.22.003" x-align="PRO.24.22.a003" x-target-ids="t004 t005" x-target="shall rise" x-target-head="t005" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqi3ms" x-gloss="it.will.arise" x-translit="yāqûm" xml:lang="hbo">יָק֣וּם</char> <char style="w" x-id="WLC.PRO.24.22.004" x-align="PRO.24.22.a004" x-target-ids="t003" x-target="calamity" x-target-head="t003" x-head="true" lemma="אֵיד" strong="H343" x-morph="Ncmsc" x-gloss="calamity" x-translit="ʾēyḏ" xml:lang="hbo">אֵידָ֑</char><char style="w" x-id="WLC.PRO.24.22.005" x-align="PRO.24.22.a005" x-target-ids="t002" x-target="their" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PRO.24.22.006" x-align="PRO.24.22.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.24.22.007" x-align="PRO.24.22.a007" x-target-ids="t008 t009" x-target="the destruction" x-target-head="t009" x-head="true" lemma="פִּיד" strong="H6365" x-morph="Ncmsc" x-gloss="disaster" x-translit="p̄iyḏ" xml:lang="hbo">פִ֥יד</char> <char style="w" x-id="WLC.PRO.24.22.008" x-align="PRO.24.22.a008" x-target-ids="t012" x-tar