	<para style="p"><verse number="16" style="v" x-ref="PRO.6.16" x-added-alignments="PRO.6.16.a003 PRO.6.16.a008" x-added-target-ids="t005 t010" x-added-target="which | which" sid="PRO 6:16" /><char style="w" x-id="WLC.PRO.6.16.001" x-align="PRO.6.16.a001" x-target-ids="t001 t002 t003 t004" x-target="There are six things" x-target-head="t003" x-head="true" lemma="שֵׁשׁ" strong="H8337" x-morph="Acfsa" x-gloss="six.[things]" x-translit="šeš-" xml:lang="hbo">שֶׁשׁ</char>־<char style="w" x-id="WLC.PRO.6.16.002" x-align="PRO.6.16.a002" x-status="unrepresented" x-head="true" lemma="הֵנָּה" strong="H2007" x-morph="Pp3fp" x-gloss="those" x-translit="hēnnâ" xml:lang="hbo">הֵ֭נָּה</char> <char style="w" x-id="WLC.PRO.6.16.003" x-align="PRO.6.16.a004" x-target-ids="t007" x-target="hateth" x-target-head="t007" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqp3ms" x-gloss="he.hates" x-translit="śānēʾ" xml:lang="hbo">שָׂנֵ֣א</char> <char style="w" x-id="WLC.PRO.6.16.004" x-align="PRO.6.16.a005" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.6.16.005" x-align="PRO.6.16.a006" x-target-ids="t008" x-target="Yea" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[are]" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.6.16.006" x-align="PRO.6.16.a007" x-target-ids="t009" x-target="seven" x-target-head="t009" x-head="true" lemma="שֶׁבַע" strong="H7651" x-morph="Acfsa" x-gloss="seven" x-translit="šeḇaʿ" xml:lang="hbo">שֶׁ֗בַע</char> <char style="w" x-id="WLC.PRO.6.16.007" x-align="PRO.6.16.a009" x-target-ids="t011 t012 t013" x-target="are an abomination" x-target-head="t013" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="the.disgusting.thing" x-translit="**tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֥ת</char><char style="w" x-id="WLC.PRO.6.16.008" x-