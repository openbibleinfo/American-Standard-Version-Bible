	<para style="p"><verse number="19" style="v" x-ref="PRO.1.19" sid="PRO 1:19" /><char style="w" x-id="WLC.PRO.1.19.001" x-align="PRO.1.19.a001" x-target-ids="t001 t002" x-target="So are" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-gloss="[are].thus" x-translit="kēn" xml:lang="hbo">כֵּ֗ן</char> <char style="w" x-id="WLC.PRO.1.19.002" x-align="PRO.1.19.a002" x-target-ids="t003 t004" x-target="the ways" x-target-head="t004" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbpc" x-gloss="[the].paths" x-translit="ʾārḥôṯ" xml:lang="hbo">אָ֭רְחוֹת</char> <char style="w" x-id="WLC.PRO.1.19.003" x-align="PRO.1.19.a003" x-target-ids="t005 t006 t007" x-target="of every one" x-target-head="t006" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PRO.1.19.004" x-align="PRO.1.19.a004" x-target-ids="t008 t009 t010 t011" x-target="that is greedy of" x-target-head="t010" x-head="true" lemma="בָּצַע" strong="H1214" x-morph="Vqrmsa" x-gloss="[one.who].gains.unjustly" x-translit="bōṣēᵃʿ" xml:lang="hbo">בֹּ֣צֵֽעַ</char> <char style="w" x-id="WLC.PRO.1.19.005" x-align="PRO.1.19.a005" x-target-ids="t012" x-target="gain" x-target-head="t012" x-head="true" lemma="בֶּצַע" strong="H1215" x-morph="Ncmsa" x-gloss="unjust.gain" x-translit="bāṣaʿ" xml:lang="hbo">בָּ֑צַע</char> <char style="w" x-id="WLC.PRO.1.19.006" x-align="PRO.1.19.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.1.19.007" x-align="PRO.1.19.a008" x-target-ids="t016 t017" x-target="the life" x-target-head="t017" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="the.life" x-translit="nep̄eš" xml:lang="hbo">נֶ֖פֶשׁ</char> <char style="w" x-id="WLC.PRO.1.19.008" x-align="PRO.1.19.a009" x-target-ids="t018 t019 t020" x-target="of the owners" x-target-head="t020"