	<para style="p"><verse number="11" style="v" x-ref="PRO.15.11" sid="PRO 15:11" /><char style="w" x-id="WLC.PRO.15.11.001" x-align="PRO.15.11.a001" x-target-ids="t001" x-target="Sheol" x-target-head="t001" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="Sheol" x-translit="šəʾôl" xml:lang="hbo">שְׁא֣וֹל</char> <char style="w" x-id="WLC.PRO.15.11.002" x-align="PRO.15.11.a002" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֭</char><char style="w" x-id="WLC.PRO.15.11.003" x-align="PRO.15.11.a003" x-target-ids="t003" x-target="Abaddon" x-target-head="t003" x-head="true" lemma="אֲבַדּוֹן" strong="H11" x-morph="Np" x-gloss="Abaddon" x-translit="ʾăḇaddôn" xml:lang="hbo">אֲבַדּוֹן</char> <char style="w" x-id="WLC.PRO.15.11.004" x-align="PRO.15.11.a004" x-target-ids="t004 t005" x-target="are before" x-target-head="t005" x-head="true" lemma="נֶגֶד" strong="H5048" x-morph="R" x-gloss="[are].before" x-translit="neḡeḏ" xml:lang="hbo">נֶ֣גֶד</char> <char style="w" x-id="WLC.PRO.15.11.005" x-align="PRO.15.11.a005" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.15.11.006" x-align="PRO.15.11.a006" x-status="noncompositional" x-target-ids="t007 t008 t009 t010" x-target="How much more then" x-target-head="t009" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="indeed?" x-translit="ʾap̄" xml:lang="hbo">אַ֝֗ף</char> <char style="w" x-id="WLC.PRO.15.11.007" x-align="PRO.15.11.a006" x-status="noncompositional" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.15.11.008" x-align="PRO.15.11.a007" x-target-ids="t011 t012" x-target="the hearts" x-target-head="t012" x-head="true" lemma="לֵב" strong="H3820" x-morph="