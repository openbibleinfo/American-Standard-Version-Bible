	<para style="p"><verse number="23" style="v" x-ref="PRO.30.23" sid="PRO 30:23" /><char style="w" x-id="WLC.PRO.30.23.001" x-align="PRO.30.23.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="תַּחַת" strong="H8478" x-morph="R" x-gloss="under" x-translit="taḥaṯ" xml:lang="hbo">תַּ֣חַת</char> <char style="w" x-id="WLC.PRO.30.23.002" x-align="PRO.30.23.a002" x-target-ids="t002 t003 t004" x-target="an odious woman" x-target-head="t003" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqsfsa" x-gloss="a.[woman.who.is].hated" x-translit="śənûʾâ" xml:lang="hbo">שְׂ֭נוּאָה</char> <char style="w" x-id="WLC.PRO.30.23.003" x-align="PRO.30.23.a003" x-target-ids="t005" x-target="when" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PRO.30.23.004" x-align="PRO.30.23.a004" x-target-ids="t006 t007 t008" x-target="she is married" x-target-head="t008" x-head="true" lemma="בָּעַל" strong="H1166" x-morph="VNi3fs" x-gloss="she.will.be.married" x-translit="ṯibbāʿēl" xml:lang="hbo">תִבָּעֵ֑ל</char> <char style="w" x-id="WLC.PRO.30.23.005" x-align="PRO.30.23.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.30.23.006" x-align="PRO.30.23.a006" x-target-ids="t010 t011" x-target="a handmaid" x-target-head="t011" x-head="true" lemma="שִׁפְחָה" strong="H8198" x-morph="Ncfsa" x-gloss="a.female.servant" x-translit="šip̄ḥāh" xml:lang="hbo">שִׁפְחָ֗ה</char> <char style="w" x-id="WLC.PRO.30.23.007" x-align="PRO.30.23.a007" x-target-ids="t012" x-target="that" x-target-head="t012" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.30.23.008" x-align="PRO.30.23.a008" x-target-ids="t013 t014 t015" x-target="is heir t