	<para style="p"><verse number="10" style="v" x-ref="PRO.1.10" sid="PRO 1:10" /><char style="w" x-id="WLC.PRO.1.10.001" x-align="PRO.1.10.a002" x-target-ids="t002" x-target="son" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="bən" xml:lang="hbo">בְּנִ֡</char><char style="w" x-id="WLC.PRO.1.10.002" x-align="PRO.1.10.a001" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.1.10.003" x-align="PRO.1.10.a003" x-target-ids="t003" x-target="if" x-target-head="t003" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.1.10.004" x-align="PRO.1.10.a005" x-target-ids="t005" x-target="entice" x-target-head="t005" x-head="true" lemma="פָּתָה" strong="H6601" x-morph="Vpi3mp" x-gloss="they" x-translit="yəp̄attû" xml:lang="hbo">יְפַתּ֥וּ</char><char style="w" x-id="WLC.PRO.1.10.005" x-align="PRO.1.10.a006" x-target-ids="t006" x-target="thee" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.entice.you" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.1.10.006" x-align="PRO.1.10.a004" x-target-ids="t004" x-target="sinners" x-target-head="t004" x-head="true" lemma="חַטָּא" strong="H2400" x-morph="Ncmpa" x-gloss="sinners" x-translit="ḥaṭṭāʾiym" xml:lang="hbo">חַ֝טָּאִ֗ים</char> <char style="w" x-id="WLC.PRO.1.10.007" x-align="PRO.1.10.a008" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.1.10.008" x-align="PRO.1.10.a007" x-target-ids="t007 t008" x-target="Consent thou" x-target-head="t007" x-head="true" lemma="אָבָה" strong="H14" x-morph="Vqj2ms" x-gloss="be.willing" x-translit="tōḇē