	<para style="p"><verse number="22" style="v" x-ref="PRO.1.22" sid="PRO 1:22" /><char style="w" x-id="WLC.PRO.1.22.001" x-align="PRO.1.22.a002" x-target-ids="t002" x-target="long" x-target-head="t002" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PRO.1.22.002" x-align="PRO.1.22.a001" x-target-ids="t001" x-target="How" x-target-head="t001" x-head="true" lemma="מָתַי" strong="H4970" x-morph="Ti" x-gloss="when?" x-translit="māṯay" xml:lang="hbo">מָתַ֣י</char>׀<char style="w" x-id="WLC.PRO.1.22.003" x-align="PRO.1.22.a003" x-target-ids="t003 t004 t005" x-target="ye simple ones" x-target-head="t004" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmpa" x-gloss="O.naive.people" x-translit="pəṯāyim" xml:lang="hbo">פְּתָיִם֮</char> <char style="w" x-id="WLC.PRO.1.22.004" x-align="PRO.1.22.a004" x-target-ids="t006 t007 t008" x-target="will ye love" x-target-head="t008" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqi2mp" x-gloss="will.you.love" x-translit="təʾēhăḇû" xml:lang="hbo">תְּֽאֵהֲב֫וּ</char> <char style="w" x-id="WLC.PRO.1.22.005" x-align="PRO.1.22.a005" x-target-ids="t009" x-target="simplicity" x-target-head="t009" x-head="true" lemma="פְּתִי" strong="H6612a" x-morph="Ncmsa" x-gloss="naiveté" x-translit="p̄eṯî" xml:lang="hbo">פֶ֥תִי</char> <char style="w" x-id="WLC.PRO.1.22.006" x-align="PRO.1.22.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.1.22.007" x-align="PRO.1.22.a007" x-target-ids="t011" x-target="scoffers" x-target-head="t011" x-head="true" lemma="לֵץ" strong="H3887a" x-morph="Aampa" x-gloss="mockers" x-translit="lēṣiym" xml:lang="hbo">לֵצִ֗ים</char> <char style="w" x-id="WLC.PRO.1.22.008" x-align="PRO.1.22.a011" x-target-ids="t015" x-target="scoffing" x-target-head="t015" x-head="true" lemma="לָצוֹן" st