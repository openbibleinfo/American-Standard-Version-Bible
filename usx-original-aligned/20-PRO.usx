	<para style="p"><verse number="22" style="v" x-ref="PRO.18.22" sid="PRO 18:22" /><char style="w" x-id="WLC.PRO.18.22.001" x-align="PRO.18.22.a001" x-target-ids="t001 t002" x-target="Whoso findeth" x-target-head="t002" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqp3ms" x-gloss="he.finds" x-translit="māṣāʾ" xml:lang="hbo">מָצָ֣א</char> <char style="w" x-id="WLC.PRO.18.22.002" x-align="PRO.18.22.a002" x-target-ids="t003 t004" x-target="a wife" x-target-head="t004" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsa" x-gloss="a.wife" x-translit="ʾiššâ" xml:lang="hbo">אִ֭שָּׁה</char> <char style="w" x-id="WLC.PRO.18.22.003" x-align="PRO.18.22.a003" x-target-ids="t005" x-target="findeth" x-target-head="t005" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqp3ms" x-gloss="he.finds" x-translit="māṣāʾ" xml:lang="hbo">מָ֣צָא</char> <char style="w" x-id="WLC.PRO.18.22.004" x-align="PRO.18.22.a004" x-target-ids="t006 t007 t008" x-target="a good thing" x-target-head="t007" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="a.good.thing" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PRO.18.22.005" x-align="PRO.18.22.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.18.22.006" x-align="PRO.18.22.a006" x-target-ids="t010" x-target="obtaineth" x-target-head="t010" x-head="true" lemma="פּוּק" strong="H6329" x-morph="Vhw3ms" x-gloss="he.obtained" x-translit="yyāp̄eq" xml:lang="hbo">יָּ֥פֶק</char> <char style="w" x-id="WLC.PRO.18.22.007" x-align="PRO.18.22.a007" x-target-ids="t011" x-target="favor" x-target-head="t011" x-head="true" lemma="רָצוֹן" strong="H7522" x-morph="Ncmsa" x-gloss="pleasure" x-translit="rāṣôn" xml:lang="hbo">רָ֝צ֗וֹן</char> <char style="w" x-id="WLC.PRO.18.22.008" x-align="PRO.18.22.a008" x-target-ids="t012" x-target="of" x-target-head="t012" x-head="true"