	<para style="p"><verse number="10" style="v" x-ref="PRO.9.10" sid="PRO 9:10" /><char style="w" x-id="WLC.PRO.9.10.001" x-align="PRO.9.10.a001" x-target-ids="t005 t006 t007" x-target="is the beginning" x-target-head="t007" x-head="true" lemma="תְּחִלָּה" strong="H8462" x-morph="Ncfsc" x-gloss="[is.the].beginning" x-translit="təḥillaṯ" xml:lang="hbo">תְּחִלַּ֣ת</char> <char style="w" x-id="WLC.PRO.9.10.002" x-align="PRO.9.10.a002" x-target-ids="t008 t009" x-target="of wisdom" x-target-head="t009" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="of.wisdom" x-translit="ḥoḵmâ" xml:lang="hbo">חָ֭כְמָה</char> <char style="w" x-id="WLC.PRO.9.10.003" x-align="PRO.9.10.a003" x-target-ids="t001 t002" x-target="The fear" x-target-head="t002" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="the.fear" x-translit="yirʾaṯ" xml:lang="hbo">יִרְאַ֣ת</char> <char style="w" x-id="WLC.PRO.9.10.004" x-align="PRO.9.10.a004" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.9.10.005" x-align="PRO.9.10.a005" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.9.10.006" x-align="PRO.9.10.a006" x-target-ids="t011 t012" x-target="the knowledge" x-target-head="t012" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsc" x-gloss="knowledge" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֖עַת</char> <char style="w" x-id="WLC.PRO.9.10.007" x-align="PRO.9.10.a007" x-target-ids="t013 t014 t015 t016" x-target="of the Holy One" x-target-head="t015" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aampa" x-gloss="of.[the].holy.[one(s)]" x-translit="qəḏōšiym" xml:lang="hbo">קְדֹשִׁ֣ים</char> <char style="w" x-id="WLC.PRO.9.10.008" x-align="PRO.9.10.