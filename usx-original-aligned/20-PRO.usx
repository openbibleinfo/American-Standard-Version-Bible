	<para style="p"><verse number="4" style="v" x-ref="PRO.15.4" sid="PRO 15:4" /><char style="w" x-id="WLC.PRO.15.4.001" x-align="PRO.15.4.a001" x-target-ids="t001 t002" x-target="A gentle" x-target-head="t002" x-head="true" lemma="מַרְפֵּא" strong="H4832" x-morph="Ncmsc" x-gloss="health" x-translit="marpēʾ" xml:lang="hbo">מַרְפֵּ֣א</char> <char style="w" x-id="WLC.PRO.15.4.002" x-align="PRO.15.4.a002" x-target-ids="t003" x-target="tongue" x-target-head="t003" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsa" x-gloss="of.tongue" x-translit="lāšôn" xml:lang="hbo">לָ֭שׁוֹן</char> <char style="w" x-id="WLC.PRO.15.4.003" x-align="PRO.15.4.a003" x-target-ids="t004 t005 t006" x-target="is a tree" x-target-head="t006" x-head="true" lemma="עֵץ" strong="H6086" x-morph="Ncmsc" x-gloss="[is].a.tree" x-translit="ʿēṣ" xml:lang="hbo">עֵ֣ץ</char> <char style="w" x-id="WLC.PRO.15.4.004" x-align="PRO.15.4.a004" x-target-ids="t007 t008" x-target="of life" x-target-head="t008" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="of.life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.15.4.005" x-align="PRO.15.4.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.15.4.006" x-align="PRO.15.4.a006" x-target-ids="t010" x-target="perverseness" x-target-head="t010" x-head="true" lemma="סֶלֶף" strong="H5558" x-morph="Ncmsa" x-gloss="perverseness" x-translit="selep̄" xml:lang="hbo">סֶ֥לֶף</char> <char style="w" x-id="WLC.PRO.15.4.007" x-align="PRO.15.4.a007" x-target-ids="t011" x-target="therein" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bā" xml:lang="hbo">בָּ֝֗</char><char style="w" x-id="WLC.PRO.15.4.008" x-align="PRO.15.4.a007" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="it" x-translit="hh" xml:lang="hbo">הּ</char> <c