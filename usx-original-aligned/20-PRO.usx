	<para style="p"><verse number="31" style="v" x-ref="PRO.11.31" sid="PRO 11:31" /><char style="w" x-id="WLC.PRO.11.31.001" x-align="PRO.11.31.a001" x-target-ids="t001" x-target="Behold" x-target-head="t001" x-head="true" lemma="הֵן" strong="H2005" x-morph="Tm" x-gloss="there!" x-translit="hēn" xml:lang="hbo">הֵ֣ן</char> <char style="w" x-id="WLC.PRO.11.31.002" x-align="PRO.11.31.a002" x-target-ids="t002 t003" x-target="the righteous" x-target-head="t003" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="a.righteous.[person]" x-translit="ṣaddîq" xml:lang="hbo">צַ֭דִּיק</char> <char style="w" x-id="WLC.PRO.11.31.003" x-align="PRO.11.31.a003" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="on" x-translit="bā" xml:lang="hbo">בָּ</char><char style="w" x-id="WLC.PRO.11.31.004" x-align="PRO.11.31.a004" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.11.31.005" x-align="PRO.11.31.a005" x-target-ids="t009" x-target="earth" x-target-head="t009" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֣רֶץ</char> <char style="w" x-id="WLC.PRO.11.31.006" x-align="PRO.11.31.a006" x-target-ids="t004 t005 t006" x-target="shall be recompensed" x-target-head="t006" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="VPi3ms" x-gloss="he.is.rewarded" x-translit="yəšullām" xml:lang="hbo">יְשֻׁלָּ֑ם</char> <char style="w" x-id="WLC.PRO.11.31.007" x-align="PRO.11.31.a007" x-target-ids="t010 t011 t012" x-target="How much more" x-target-head="t012" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="indeed?" x-translit="ʾap̄" xml:lang="hbo">אַ֝֗ף</char> <char style="w" x-id="WLC.PRO.11.31.008" x-align="PRO.11.31.a007" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" x