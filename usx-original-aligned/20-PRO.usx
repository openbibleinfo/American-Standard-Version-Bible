	<para style="p"><verse number="22" style="v" x-ref="PRO.11.22" x-added-alignments="PRO.11.22.a006" x-added-target-ids="t010" x-added-target="So" sid="PRO 11:22" /><char style="w" x-id="WLC.PRO.11.22.001" x-align="PRO.11.22.a001" x-target-ids="t001 t002 t003 t011" x-target="As a ring is" x-target-italic-ids="t001 t011" x-target-head="t003" x-head="true" lemma="נֶזֶם" strong="H5141" x-morph="Ncmsc" x-gloss="a.ring" x-translit="nezem" xml:lang="hbo">נֶ֣זֶם</char> <char style="w" x-id="WLC.PRO.11.22.002" x-align="PRO.11.22.a002" x-target-ids="t004 t005" x-target="of gold" x-target-head="t005" x-head="true" lemma="זָהָב" strong="H2091" x-morph="Ncmsa" x-gloss="of.gold" x-translit="zāhāḇ" xml:lang="hbo">זָ֭הָב</char> <char style="w" x-id="WLC.PRO.11.22.003" x-align="PRO.11.22.a003" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.11.22.004" x-align="PRO.11.22.a004" x-target-ids="t009" x-target="snout" x-target-head="t009" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsc" x-gloss="nose" x-translit="ʾap̄" xml:lang="hbo">אַ֣ף</char> <char style="w" x-id="WLC.PRO.11.22.005" x-align="PRO.11.22.a005" x-target-ids="t007 t008" x-target="a swine’s" x-target-head="t008" x-head="true" lemma="חֲזִיר" strong="H2386" x-morph="Ncmsa" x-gloss="of.a.pig" x-translit="ḥăziyr" xml:lang="hbo">חֲזִ֑יר</char> <char style="w" x-id="WLC.PRO.11.22.006" x-align="PRO.11.22.a007" x-target-ids="t012 t014" x-target="a woman" x-target-head="t014" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsa" x-gloss="a.woman" x-translit="ʾiššāh" xml:lang="hbo">אִשָּׁ֥ה</char> <char style="w" x-id="WLC.PRO.11.22.007" x-align="PRO.11.22.a008" x-target-ids="t013" x-target="fair" x-target-head="t013" x-head="true" lemma="יָפֶה" strong="H3303" x-morph="Aafsa" x-gloss="beautiful" x-translit="yāp̄āh" xml:lang="hbo">יָ֝פָ֗ה</char> <char style="w" x-id="WLC.PRO.