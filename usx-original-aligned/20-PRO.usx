	<para style="p"><verse number="1" style="v" x-ref="PRO.20.1" sid="PRO 20:1" /><char style="w" x-id="WLC.PRO.20.1.001" x-align="PRO.20.1.a003" x-target-ids="t002 t003 t004" x-target="is a mocker" x-target-head="t004" x-head="true" lemma="לֵץ" strong="H3887a" x-morph="Aamsa" x-gloss="[is].a.mocker" x-translit="lēṣ" xml:lang="hbo">לֵ֣ץ</char> <char style="w" x-id="WLC.PRO.20.1.002" x-align="PRO.20.1.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PRO.20.1.003" x-align="PRO.20.1.a001" x-target-ids="t001" x-target="Wine" x-target-head="t001" x-head="true" lemma="יַיִן" strong="H3196" x-morph="Ncmsa" x-gloss="wine" x-translit="yyayn" xml:lang="hbo">יַּין</char><char style="w" x-id="WLC.PRO.20.1.004" x-align="PRO.20.1.a005" x-target-ids="t007 t008" x-target="a brawler" x-target-head="t008" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqrmsa" x-gloss="[is].noisy" x-translit="hōmeh" xml:lang="hbo">הֹמֶ֣ה</char> <char style="w" x-id="WLC.PRO.20.1.005" x-align="PRO.20.1.a004" x-target-ids="t005 t006" x-target="strong drink" x-target-head="t005" x-head="true" lemma="שֵׁכָר" strong="H7941" x-morph="Ncmsa" x-gloss="strong.drink" x-translit="šēḵār" xml:lang="hbo">שֵׁכָ֑ר</char> <char style="w" x-id="WLC.PRO.20.1.006" x-align="PRO.20.1.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.20.1.007" x-align="PRO.20.1.a007" x-target-ids="t010" x-target="whosoever" x-target-head="t010" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="any" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.20.1.008" x-align="PRO.20.1.a008" x-target-ids="t011" x-target="erreth" x-target-head="t011" x-head="true" lemma="שָׁגָה" strong="H7686" x-morph="Vqrmsa" x-gloss="[one.who].staggers" x-transl