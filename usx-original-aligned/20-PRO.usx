	<para style="p"><verse number="9" style="v" x-ref="PRO.30.9" x-added-alignments="PRO.30.9.a005" x-added-target-ids="t007" x-added-target="thee" sid="PRO 30:9" /><char style="w" x-id="WLC.PRO.30.9.001" x-align="PRO.30.9.a001" x-target-ids="t001" x-target="Lest" x-target-head="t001" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen" xml:lang="hbo">פֶּ֥ן</char> <char style="w" x-id="WLC.PRO.30.9.002" x-align="PRO.30.9.a002" x-target-ids="t002 t003 t004" x-target="I be full" x-target-head="t004" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqi1cs" x-gloss="I.should.be.satisfied" x-translit="ʾeśbaʿ" xml:lang="hbo">אֶשְׂבַּ֨ע</char>׀<char style="w" x-id="WLC.PRO.30.9.003" x-align="PRO.30.9.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.30.9.004" x-align="PRO.30.9.a004" x-target-ids="t006" x-target="deny" x-target-head="t006" x-head="true" lemma="כָּחַשׁ" strong="H3584" x-morph="Vpq1cs" x-gloss="I.will.deny" x-translit="ḵiḥaštî" xml:lang="hbo">כִחַשְׁתִּי֮</char> <char style="w" x-id="WLC.PRO.30.9.005" x-align="PRO.30.9.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.30.9.006" x-align="PRO.30.9.a007" x-target-ids="t009" x-target="say" x-target-head="t009" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqq1cs" x-gloss="I.will.say" x-translit="ʾāmarətî" xml:lang="hbo">אָמַ֗רְתִּי</char> <char style="w" x-id="WLC.PRO.30.9.007" x-align="PRO.30.9.a008" x-target-ids="t010 t011" x-target="Who is" x-target-head="t010" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="miy" xml:lang="hbo">מִ֥י</char> <char style="w" x-id="WLC.PRO.30.9.008" x-align="PRO.30.9.a009" x-target-ids="t012" x-target="Jehovah" x-tar