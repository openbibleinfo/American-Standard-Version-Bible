	<para style="p"><verse number="14" style="v" x-ref="PRO.28.14" sid="PRO 28:14" /><char style="w" x-id="WLC.PRO.28.14.001" x-align="PRO.28.14.a001" x-target-ids="t001 t002" x-target="Happy is" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrēy" xml:lang="hbo">אַשְׁרֵ֣י</char> <char style="w" x-id="WLC.PRO.28.14.002" x-align="PRO.28.14.a002" x-target-ids="t003 t004" x-target="the man" x-target-head="t004" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="[is].a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.PRO.28.14.003" x-align="PRO.28.14.a003" x-target-ids="t005 t006" x-target="that feareth" x-target-head="t006" x-head="true" lemma="פָּחַד" strong="H6342" x-morph="Vprmsa" x-gloss="[who].fears" x-translit="məp̄aḥēḏ" xml:lang="hbo">מְפַחֵ֣ד</char> <char style="w" x-id="WLC.PRO.28.14.004" x-align="PRO.28.14.a004" x-target-ids="t007" x-target="alway" x-target-head="t007" x-head="true" lemma="תָּמִיד" strong="H8548" x-morph="Ncmsa" x-gloss="continually" x-translit="tāmiyḏ" xml:lang="hbo">תָּמִ֑יד</char> <char style="w" x-id="WLC.PRO.28.14.005" x-align="PRO.28.14.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.28.14.006" x-align="PRO.28.14.a006" x-target-ids="t009 t010 t011" x-target="he that hardeneth" x-target-head="t011" x-head="true" lemma="קָשָׁה" strong="H7185" x-morph="Vhrmsa" x-gloss="[one.who].hardens" x-translit="maqšeh" xml:lang="hbo">מַקְשֶׁ֥ה</char> <char style="w" x-id="WLC.PRO.28.14.007" x-align="PRO.28.14.a008" x-target-ids="t013" x-target="heart" x-target-head="t013" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִ֝בּ֗</char><char style="w" x-id="WLC.PRO.28.14.008" x-align="PRO.28.14.a007" x-target-ids="t012" x-target="his" x