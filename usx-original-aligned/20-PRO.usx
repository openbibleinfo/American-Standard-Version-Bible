	<para style="p"><verse number="16" style="v" x-ref="PRO.18.16" sid="PRO 18:16" /><char style="w" x-id="WLC.PRO.18.16.001" x-align="PRO.18.16.a002" x-target-ids="t003" x-target="gift" x-target-head="t003" x-head="true" lemma="מַתָּן" strong="H4976" x-morph="Ncmsc" x-gloss="[the].gift" x-translit="mattān" xml:lang="hbo">מַתָּ֣ן</char> <char style="w" x-id="WLC.PRO.18.16.002" x-align="PRO.18.16.a001" x-target-ids="t001 t002" x-target="A man’s" x-target-head="t002" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.PRO.18.16.003" x-align="PRO.18.16.a003" x-target-ids="t004 t005" x-target="maketh room" x-target-head="t005" x-head="true" lemma="רָחַב" strong="H7337" x-morph="Vhi3ms" x-gloss="it.makes.space" x-translit="yarḥiyḇ" xml:lang="hbo">יַרְחִ֣יב</char> <char style="w" x-id="WLC.PRO.18.16.004" x-align="PRO.18.16.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="l" xml:lang="hbo">ל֑</char><char style="w" x-id="WLC.PRO.18.16.005" x-align="PRO.18.16.a005" x-target-ids="t007" x-target="him" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.18.16.006" x-align="PRO.18.16.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.18.16.007" x-align="PRO.18.16.a009" lemma="לְ" strong="H3807a" x-morph="R" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.18.16.008" x-align="PRO.18.16.a009" x-target-ids="t011" x-target="before" x-target-head="t011" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-gloss="before" x-translit="p̄ənēy" xml:lang="hbo">פְנֵ֖י</char> <char style="w" x-id="WLC.PRO.18.16.009" x-a