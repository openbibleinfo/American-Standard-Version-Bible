	<para style="p"><verse number="4" style="v" x-ref="PRO.2.4" sid="PRO 2:4" /><char style="w" x-id="WLC.PRO.2.4.001" x-align="PRO.2.4.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.2.4.002" x-align="PRO.2.4.a002" x-target-ids="t002 t003" x-target="thou seek" x-target-head="t003" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vpi2ms" x-gloss="you" x-translit="təḇaqš" xml:lang="hbo">תְּבַקְשֶׁ֥</char><char style="w" x-id="WLC.PRO.2.4.003" x-align="PRO.2.4.a003" x-target-ids="t004" x-target="her" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5089a" x-morph="Sp3fs" x-gloss="will.seek.it" x-translit="ennāh" xml:lang="hbo">נָּה</char> <char style="w" x-id="WLC.PRO.2.4.004" x-align="PRO.2.4.a004" x-target-ids="t005" x-target="as" x-target-head="t005" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ḵa" xml:lang="hbo">כַ</char><char style="w" x-id="WLC.PRO.2.4.005" x-align="PRO.2.4.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.2.4.006" x-align="PRO.2.4.a006" x-target-ids="t006" x-target="silver" x-target-head="t006" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="silver" x-translit="kāsep̄" xml:lang="hbo">כָּ֑סֶף</char> <char style="w" x-id="WLC.PRO.2.4.007" x-align="PRO.2.4.a007" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.2.4.008" x-align="PRO.2.4.a010" x-target-ids="t011" x-target="as" x-target-head="t011" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like.(the)" x-translit="ḵa" xml:lang="hbo">כַ</char><char style="w" x-id="WLC.PRO.2.4.009" x-align="PRO.2.4.a0