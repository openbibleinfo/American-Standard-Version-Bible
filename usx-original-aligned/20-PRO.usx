	<para style="p"><verse number="21" style="v" x-ref="PRO.28.21" sid="PRO 28:21" /><char style="w" x-id="WLC.PRO.28.21.001" x-align="PRO.28.21.a001" x-target-ids="t001 t002 t003 t004" x-target="To have respect of" x-target-head="t003" x-head="true" lemma="נָכַר" strong="H5234" x-morph="Vha" x-gloss="to.pay.regard.to" x-translit="hakēr-" xml:lang="hbo">הַֽכֵּר</char>־<char style="w" x-id="WLC.PRO.28.21.002" x-align="PRO.28.21.a002" x-target-ids="t005" x-target="persons" x-target-head="t005" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpa" x-gloss="faces" x-translit="pāniym" xml:lang="hbo">פָּנִ֥ים</char> <char style="w" x-id="WLC.PRO.28.21.003" x-align="PRO.28.21.a003" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.28.21.004" x-align="PRO.28.21.a004" x-target-ids="t006 t008" x-target="is good" x-target-head="t008" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PRO.28.21.005" x-align="PRO.28.21.a005" x-target-ids="t009 t010" x-target="Neither that" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.21.006" x-align="PRO.28.21.a008" x-target-ids="t015" x-target="for" x-target-head="t015" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.28.21.007" x-align="PRO.28.21.a009" x-target-ids="t016 t017" x-target="a piece" x-target-head="t017" x-head="true" lemma="פַּת" strong="H6595" x-morph="Ncfsc" x-gloss="a.piece" x-translit="paṯ-" xml:lang="hbo">פַּת</char>־<char style="w" x-id="WLC.PRO.28.21.008" x-align="PRO.28.21.a010" x-target-ids="t018 t019" x-target="of bread" x-target-head="t019" x-head="true" lemma="לֶחֶם" stro