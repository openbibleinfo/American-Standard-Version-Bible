	<para style="p"><verse number="23" style="v" x-ref="PRO.18.23" sid="PRO 18:23" /><char style="w" x-id="WLC.PRO.18.23.001" x-align="PRO.18.23.a003" x-target-ids="t004" x-target="entreaties" x-target-head="t004" x-head="true" lemma="תַּחֲנוּן" strong="H8469" x-morph="Ncmpa" x-gloss="supplications" x-translit="taḥănûniym" xml:lang="hbo">תַּחֲנוּנִ֥ים</char> <char style="w" x-id="WLC.PRO.18.23.002" x-align="PRO.18.23.a002" x-target-ids="t003" x-target="useth" x-target-head="t003" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpi3ms" x-gloss="he.speaks" x-translit="yəḏabber-" xml:lang="hbo">יְדַבֶּר</char>־<char style="w" x-id="WLC.PRO.18.23.003" x-align="PRO.18.23.a001" x-target-ids="t001 t002" x-target="The poor" x-target-head="t002" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="[one.who.is].poor" x-translit="rāš" xml:lang="hbo">רָ֑שׁ</char> <char style="w" x-id="WLC.PRO.18.23.004" x-align="PRO.18.23.a004" x-target-ids="t005" x-target="But" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.18.23.005" x-align="PRO.18.23.a005" x-target-ids="t006 t007" x-target="the rich" x-target-head="t007" x-head="true" lemma="עָשִׁיר" strong="H6223" x-morph="Aamsa" x-gloss="a.rich.[person]" x-translit="ʿāšiyr" xml:lang="hbo">עָשִׁ֗יר</char> <char style="w" x-id="WLC.PRO.18.23.006" x-align="PRO.18.23.a006" x-target-ids="t008" x-target="answereth" x-target-head="t008" x-head="true" lemma="עָנָה" strong="H6030" x-morph="Vqi3ms" x-gloss="he.answers" x-translit="yaʿăneh" xml:lang="hbo">יַעֲנֶ֥ה</char> <char style="w" x-id="WLC.PRO.18.23.007" x-align="PRO.18.23.a007" x-target-ids="t009" x-target="roughly" x-target-head="t009" x-head="true" lemma="עַז" strong="H5794" x-morph="Aafpa" x-gloss="strong.[words]" x-translit="ʿazzôṯ:" xml:lang="hbo">עַזּֽוֹת</char>׃<verse eid="PRO 18:23" /></para>
