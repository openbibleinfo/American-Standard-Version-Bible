	<para style="p"><verse number="19" style="v" x-ref="PRO.20.19" sid="PRO 20:19" /><char style="w" x-id="WLC.PRO.20.19.001" x-align="PRO.20.19.a003" x-target-ids="t009" x-target="revealeth" x-target-head="t009" x-head="true" lemma="גָּלָה" strong="H1540" x-morph="Vqrmsa" x-gloss="[is].uncovering" x-translit="gôleh-" xml:lang="hbo">גּֽוֹלֶה</char>־<char style="w" x-id="WLC.PRO.20.19.002" x-align="PRO.20.19.a004" x-target-ids="t010" x-target="secrets" x-target-head="t010" x-head="true" lemma="סוֹד" strong="H5475" x-morph="Ncmsa" x-gloss="secret.counsel" x-translit="ssôḏ" xml:lang="hbo">סּ֭וֹד</char> <char style="w" x-id="WLC.PRO.20.19.003" x-align="PRO.20.19.a001" x-target-ids="t001 t002 t003 t004" x-target="He that goeth about" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsc" x-gloss="[one.who].goes.about" x-translit="hôlēḵ" xml:lang="hbo">הוֹלֵ֣ךְ</char> <char style="w" x-id="WLC.PRO.20.19.004" x-align="PRO.20.19.a002" x-target-ids="t005 t006 t007 t008" x-target="as a tale bearer" x-target-head="t007" x-head="true" lemma="רָכִיל" strong="H7400" x-morph="Ncmsa" x-gloss="slander" x-translit="rāḵiyl" xml:lang="hbo">רָכִ֑יל</char> <char style="w" x-id="WLC.PRO.20.19.005" x-align="PRO.20.19.a005" x-target-ids="t011" x-target="Therefore" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.20.19.006" x-align="PRO.20.19.a008" x-target-ids="t014" x-target="with" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.20.19.007" x-align="PRO.20.19.a009" x-target-ids="t015 t016 t017 t018" x-target="him that openeth wide" x-target-head="t017" x-head="true" lemma="פָּתָה" strong="H6601" x-morph="Vqrmsa" x-gloss="[one.who].opens" x-translit="p̄ōṯeh" xml:lang="hbo">פֹתֶ֥ה</char> <char style="w" x-id="WLC.PRO.20.19.008" x-align="PRO.20.19.a011" x-t