	<para style="p"><verse number="33" style="v" x-ref="PRO.3.33" sid="PRO 3:33" /><char style="w" x-id="WLC.PRO.3.33.001" x-align="PRO.3.33.a001" x-target-ids="t001 t002" x-target="The curse" x-target-head="t002" x-head="true" lemma="מְאֵרָה" strong="H3994" x-morph="Ncfsc" x-gloss="the.curse" x-translit="məʾēraṯ" xml:lang="hbo">מְאֵרַ֣ת</char> <char style="w" x-id="WLC.PRO.3.33.002" x-align="PRO.3.33.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.3.33.003" x-align="PRO.3.33.a003" x-target-ids="t005 t006" x-target="is in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].on.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.3.33.004" x-align="PRO.3.33.a004" x-target-ids="t007 t008" x-target="the house" x-target-head="t008" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="ḇēyṯ" xml:lang="hbo">בֵ֣ית</char> <char style="w" x-id="WLC.PRO.3.33.005" x-align="PRO.3.33.a005" x-target-ids="t009 t010 t011" x-target="of the wicked" x-target-head="t011" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="of.[the].wicked" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֑ע</char> <char style="w" x-id="WLC.PRO.3.33.006" x-align="PRO.3.33.a006" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.3.33.007" x-align="PRO.3.33.a007" x-target-ids="t015 t016" x-target="the habitation" x-target-head="t016" x-head="true" lemma="נָוֶה" strong="H5116" x-morph="Ncbsc" x-gloss="habitation" x-translit="nəwēh" xml:lang="hbo">נְוֵ֖ה</char> <char style="w" x-id="WLC.PRO.3.33.008" x-align="PRO.3.33.a008" x-target-ids="t017 t018 t019" x-target="of the righteous" x-target-h