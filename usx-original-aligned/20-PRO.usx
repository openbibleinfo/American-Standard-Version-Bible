	<para style="p"><verse number="3" style="v" x-ref="PRO.21.3" sid="PRO 21:3" /><char style="w" x-id="WLC.PRO.21.3.001" x-align="PRO.21.3.a001" x-target-ids="t001 t002" x-target="To do" x-target-head="t002" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqc" x-gloss="to.do" x-translit="ʿăśōh" xml:lang="hbo">עֲ֭שֹׂה</char> <char style="w" x-id="WLC.PRO.21.3.002" x-align="PRO.21.3.a002" x-target-ids="t003" x-target="righteousness" x-target-head="t003" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְדָקָ֣ה</char> <char style="w" x-id="WLC.PRO.21.3.003" x-align="PRO.21.3.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.21.3.004" x-align="PRO.21.3.a004" x-target-ids="t005" x-target="justice" x-target-head="t005" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="justice" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּ֑ט</char> <char style="w" x-id="WLC.PRO.21.3.005" x-align="PRO.21.3.a005" x-target-ids="t006 t008" x-target="Is acceptable" x-target-head="t008" x-head="true" lemma="בָּחַר" strong="H977" x-morph="VNrmsa" x-gloss="[is].chosen" x-translit="niḇḥār" xml:lang="hbo">נִבְחָ֖ר</char> <char style="w" x-id="WLC.PRO.21.3.006" x-align="PRO.21.3.a006" x-target-ids="t009" x-target="to" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="by" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PRO.21.3.007" x-align="PRO.21.3.a007" x-target-ids="t010" x-target="Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֣ה</char> <char style="w" x-id="WLC.PRO.21.3.008" x-align="PRO.21.3.a008" x-target-ids="t007 t011" x-target="more than" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R"