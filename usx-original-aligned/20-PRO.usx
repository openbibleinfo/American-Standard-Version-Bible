	<para style="p"><verse number="21" style="v" x-ref="PRO.19.21" sid="PRO 19:21" /><char style="w" x-id="WLC.PRO.19.21.001" x-align="PRO.19.21.a001" x-target-ids="t001 t002 t003" x-target="There are many" x-target-head="t003" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafpa" x-gloss="many" x-translit="rabôṯ" xml:lang="hbo">רַבּ֣וֹת</char> <char style="w" x-id="WLC.PRO.19.21.002" x-align="PRO.19.21.a002" x-target-ids="t004" x-target="devices" x-target-head="t004" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpa" x-gloss="plans" x-translit="maḥăšāḇôṯ" xml:lang="hbo">מַחֲשָׁב֣וֹת</char> <char style="w" x-id="WLC.PRO.19.21.003" x-align="PRO.19.21.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.19.21.004" x-align="PRO.19.21.a004" x-target-ids="t008" x-target="heart" x-target-head="t008" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="leḇ-" xml:lang="hbo">לֶב</char>־<char style="w" x-id="WLC.PRO.19.21.005" x-align="PRO.19.21.a005" x-target-ids="t006 t007" x-target="a man’s" x-target-head="t007" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֑ישׁ</char> <char style="w" x-id="WLC.PRO.19.21.006" x-align="PRO.19.21.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.19.21.007" x-align="PRO.19.21.a007" x-target-ids="t010 t011" x-target="the counsel" x-target-head="t011" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsc" x-gloss="purpose" x-translit="ʿăṣaṯ" xml:lang="hbo">עֲצַ֥ת</char> <char style="w" x-id="WLC.PRO.19.21.008" x-align="PRO.19.21.a008" x-target-ids="t012 t013" x-target="of Jehovah" x-target-head="t013" x-head="true" lemma="