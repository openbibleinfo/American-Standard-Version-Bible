	<para style="p"><verse number="15" style="v" x-ref="PRO.19.15" sid="PRO 19:15" /><char style="w" x-id="WLC.PRO.19.15.001" x-align="PRO.19.15.a001" x-target-ids="t001" x-target="Slothfulness" x-target-head="t001" x-head="true" lemma="עַצְלָה" strong="H6103" x-morph="Ncfsa" x-gloss="laziness" x-translit="ʿaṣlâ" xml:lang="hbo">עַ֭צְלָה</char> <char style="w" x-id="WLC.PRO.19.15.002" x-align="PRO.19.15.a002" x-target-ids="t002 t003" x-target="casteth into" x-target-head="t002" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vhi3fs" x-gloss="it.makes.fall" x-translit="tappiyl" xml:lang="hbo">תַּפִּ֣יל</char> <char style="w" x-id="WLC.PRO.19.15.003" x-align="PRO.19.15.a003" x-target-ids="t004 t005 t006" x-target="a deep sleep" x-target-head="t005" x-head="true" lemma="תַּרְדֵּמָה" strong="H8639" x-morph="Ncfsa" x-gloss="deep.sleep" x-translit="tardēmāh" xml:lang="hbo">תַּרְדֵּמָ֑ה</char> <char style="w" x-id="WLC.PRO.19.15.004" x-align="PRO.19.15.a004" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.15.005" x-align="PRO.19.15.a005" x-target-ids="t008 t010" x-target="the soul" x-target-head="t010" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="a.person" x-translit="nep̄eš" xml:lang="hbo">נֶ֖פֶשׁ</char> <char style="w" x-id="WLC.PRO.19.15.006" x-align="PRO.19.15.a006" x-target-ids="t009" x-target="idle" x-target-head="t009" x-head="true" lemma="רְמִיָּה" strong="H7423" x-morph="Ncfsa" x-gloss="of.slackness" x-translit="rəmiyyāh" xml:lang="hbo">רְמִיָּ֣ה</char> <char style="w" x-id="WLC.PRO.19.15.007" x-align="PRO.19.15.a007" x-target-ids="t011 t012 t013" x-target="shall suffer hunger" x-target-head="t013" x-head="true" lemma="רָעֵב" strong="H7456" x-morph="Vqi3fs" x-gloss="he.will.be.hungry" x-translit="ṯirʿāḇ:" xml:lang="hbo">תִרְעָֽב</char>׃<verse eid="PRO 19:15" /></para>
	<para style="p"><verse number="16" style="v" x-ref="PRO.19.16" x-added-alignments="PRO.19.16.a006" x-added-target-ids="t009" x-added-target="But" sid="PRO 19:16" /><char style="w" x-id="WLC.PRO.19.16.001" x-align="PRO.19.16.a001" x-target-ids="t001 t002 t003" x-target="He that keepeth" x-target-head="t003" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsc" x-gloss="[one.who].keeps" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֣ר</char> <char style="w" x-id="WLC.PRO.19.16.002" x-align="PRO.19.16.a002" x-target-ids="t004 t005" x-target="the commandment" x-target-head="t005" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfsa" x-gloss="a.commandment" x-translit="miṣwâ" xml:lang="hbo">מִ֭צְוָה</char> <char style="w" x-id="WLC.PRO.19.16.003" x-align="PRO.19.16.a003" x-target-ids="t006" x-target="keepeth" x-target-head="t006" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsc" x-gloss="[is].guarding" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֣ר</char> <char style="w" x-id="WLC.PRO.19.16.004" x-align="PRO.19.16.a004" x-target-ids="t008" x-target="soul" x-target-head="t008" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="life" x-translit="nap̄š" xml:lang="hbo">נַפְשׁ֑</char><char style="w" x-id="WLC.PRO.19.16.005" x-align="PRO.19.16.a005" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.19.16.006" x-align="PRO.19.16.a007" x-target-ids="t010 t011 t012 t013 t014" x-target="he that is careless of" x-target-head="t013" x-head="true" lemma="בָּזָה" strong="H959" x-morph="Vqrmsc" x-gloss="the.[one.who].despises" x-translit="bôzēh" xml:lang="hbo">בּוֹזֵ֖ה</char> <char style="w" x-id="WLC.PRO.19.16.007" x-align="PRO.19.16.a008" x-target-ids="t016" x-target="ways" x-target-head="t016" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="ḏərāḵāy" xml:lang="hbo">ד