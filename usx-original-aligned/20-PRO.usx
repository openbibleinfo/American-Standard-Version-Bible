	<para style="p"><verse number="10" style="v" x-ref="PRO.15.10" x-added-alignments="PRO.15.10.a006" x-added-target-ids="t011" x-added-target="And" sid="PRO 15:10" /><char style="w" x-id="WLC.PRO.15.10.001" x-align="PRO.15.10.a001" x-target-ids="t001 t002 t004" x-target="There is correction" x-target-head="t004" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsa" x-gloss="discipline" x-translit="mûsār" xml:lang="hbo">מוּסָ֣ר</char> <char style="w" x-id="WLC.PRO.15.10.002" x-align="PRO.15.10.a002" x-target-ids="t003" x-target="grievous" x-target-head="t003" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="bad" x-translit="rāʿ" xml:lang="hbo">רָ֭ע</char> <char style="w" x-id="WLC.PRO.15.10.003" x-align="PRO.15.10.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.15.10.004" x-align="PRO.15.10.a004" x-target-ids="t006 t007 t008" x-target="him that forsaketh" x-target-head="t008" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqrmsc" x-gloss="[one.who].forsakes" x-translit="ʿōzēḇ" xml:lang="hbo">עֹזֵ֣ב</char> <char style="w" x-id="WLC.PRO.15.10.005" x-align="PRO.15.10.a005" x-target-ids="t009 t010" x-target="the way" x-target-head="t010" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbsa" x-gloss="(of).[the].path" x-translit="ʾōraḥ" xml:lang="hbo">אֹ֑רַח</char> <char style="w" x-id="WLC.PRO.15.10.006" x-align="PRO.15.10.a007" x-target-ids="t012 t013 t014" x-target="he that hateth" x-target-head="t014" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[one.who].hates" x-translit="śônēʾ" xml:lang="hbo">שׂוֹנֵ֖א</char> <char style="w" x-id="WLC.PRO.15.10.007" x-align="PRO.15.10.a008" x-target-ids="t015" x-target="reproof" x-target-head="t015" x-head="true" lemma="תּוֹכַחַת" strong="H8433a" x-morph="Ncfsa" x-gloss="correction" x-translit="ṯôḵaḥaṯ" xml:lang="hbo">תוֹכַ֣ח