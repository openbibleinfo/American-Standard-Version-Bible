	<para style="p"><verse number="2" style="v" x-ref="PRO.17.2" sid="PRO 17:2" /><char style="w" x-id="WLC.PRO.17.2.001" x-align="PRO.17.2.a001" x-target-ids="t001 t002" x-target="A servant" x-target-head="t002" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsa" x-gloss="a.servant" x-translit="ʿeḇeḏ-" xml:lang="hbo">עֶֽבֶד</char>־<char style="w" x-id="WLC.PRO.17.2.002" x-align="PRO.17.2.a002" x-target-ids="t003 t004 t005" x-target="that dealeth wisely" x-target-head="t005" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vhrmsa" x-gloss="[who].acts.prudently" x-translit="maśkiyl" xml:lang="hbo">מַשְׂכִּ֗יל</char> <char style="w" x-id="WLC.PRO.17.2.003" x-align="PRO.17.2.a003" x-target-ids="t006 t007 t008" x-target="shall have rule" x-target-head="t008" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vqi3ms" x-gloss="he.will.rule" x-translit="yimšōl" xml:lang="hbo">יִ֭מְשֹׁל</char> <char style="w" x-id="WLC.PRO.17.2.004" x-align="PRO.17.2.a004" x-target-ids="t009" x-target="over" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="over" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.17.2.005" x-align="PRO.17.2.a005" x-target-ids="t010 t011" x-target="a son" x-target-head="t011" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="a.son" x-translit="ḇēn" xml:lang="hbo">בֵ֣ן</char> <char style="w" x-id="WLC.PRO.17.2.006" x-align="PRO.17.2.a006" x-target-ids="t012 t013 t014" x-target="that causeth shame" x-target-head="t014" x-head="true" lemma="בּוֹשׁ" strong="H954" x-morph="Vhrmsa" x-gloss="[who].acts.shamefully" x-translit="mēḇiyš" xml:lang="hbo">מֵבִ֑ישׁ</char> <char style="w" x-id="WLC.PRO.17.2.007" x-align="PRO.17.2.a007" x-target-ids="t015" x-target="And" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.17.2.008" x-align="PRO.17.2.a010" lemma="בְּ" strong="H871a" x-morph="R"