	<para style="p"><verse number="23" style="v" x-ref="PRO.13.23" sid="PRO 13:23" /><char style="w" x-id="WLC.PRO.13.23.001" x-align="PRO.13.23.a001" x-target-ids="t001" x-target="Much" x-target-head="t001" x-head="true" lemma="רֹב" strong="H7230" x-morph="Ncbsc" x-gloss="abundance" x-translit="rāḇ-" xml:lang="hbo">רָב</char>־<char style="w" x-id="WLC.PRO.13.23.002" x-align="PRO.13.23.a002" x-target-ids="t002" x-target="food" x-target-head="t002" x-head="true" lemma="אֹכֶל" strong="H400" x-morph="Ncmsa" x-gloss="of.food" x-translit="ʾōḵel" xml:lang="hbo">אֹ֭כֶל</char> <char style="w" x-id="WLC.PRO.13.23.003" x-align="PRO.13.23.a003" x-target-ids="t003 t004 t005 t006" x-target="is in the tillage" x-target-italic-ids="t003 t004" x-target-head="t006" x-head="true" lemma="נִיר" strong="H5215" x-morph="Ncmsc" x-gloss="[the].unplowed.ground" x-translit="niyr" xml:lang="hbo">נִ֣יר</char> <char style="w" x-id="WLC.PRO.13.23.004" x-align="PRO.13.23.a004" x-target-ids="t007 t008 t009" x-target="of the poor" x-target-head="t009" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmpa" x-gloss="of.[those.who.are].poor" x-translit="rāʾšiym" xml:lang="hbo">רָאשִׁ֑ים</char> <char style="w" x-id="WLC.PRO.13.23.005" x-align="PRO.13.23.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.23.006" x-align="PRO.13.23.a006" x-target-ids="t011 t012" x-target="there is" x-target-head="t012" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֥שׁ</char> <char style="w" x-id="WLC.PRO.13.23.007" x-align="PRO.13.23.a007" x-target-ids="t013 t014 t015" x-target="that is destroyed" x-target-head="t015" x-head="true" lemma="סָפָה" strong="H5595" x-morph="VNrmsa" x-gloss="[that.which].is.swept.away" x-translit="nispeh" xml:lang="hbo">נִ֝סְפֶּ֗ה</char> <char style="w" x-id="WLC.PRO.13.23.008" x-