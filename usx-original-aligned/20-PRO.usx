	<para style="p"><verse number="17" style="v" x-ref="PRO.19.17" sid="PRO 19:17" /><char style="w" x-id="WLC.PRO.19.17.001" x-align="PRO.19.17.a003" x-target-ids="t008" x-target="lendeth" x-target-head="t008" x-head="true" lemma="לָוָה" strong="H3867a" x-morph="Vhrmsc" x-gloss="[is].lending" x-translit="malwēh" xml:lang="hbo">מַלְוֵ֣ה</char> <char style="w" x-id="WLC.PRO.19.17.002" x-align="PRO.19.17.a004" x-target-ids="t009 t010" x-target="unto Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.19.17.003" x-align="PRO.19.17.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="He that hath pity upon" x-target-head="t004" x-head="true" lemma="חָנַן" strong="H2603" x-morph="Vqrmsa" x-gloss="[one.who].shows.favor.to" x-translit="ḥônēn" xml:lang="hbo">ח֣וֹנֵֽן</char> <char style="w" x-id="WLC.PRO.19.17.004" x-align="PRO.19.17.a002" x-target-ids="t006 t007" x-target="the poor" x-target-head="t007" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="a.poor.[person]" x-translit="dāl" xml:lang="hbo">דָּ֑ל</char> <char style="w" x-id="WLC.PRO.19.17.005" x-align="PRO.19.17.a005" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.19.17.006" x-align="PRO.19.17.a006" x-target-ids="t013 t014" x-target="good deed" x-target-head="t014" x-head="true" lemma="גְּמוּל" strong="H1576" x-morph="Ncmsc" x-gloss="recompense" x-translit="ḡəmul" xml:lang="hbo">גְמֻל֗</char><char style="w" x-id="WLC.PRO.19.17.007" x-align="PRO.19.17.a007" x-target-ids="t012" x-target="his" x-target-head="t012" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.19.17.008" x-align="PRO.19.17.a008" x-target-ids="t015 t016 t017 t019" x-ta