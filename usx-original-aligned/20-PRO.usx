	<para style="p"><verse number="15" style="v" x-ref="PRO.18.15" sid="PRO 18:15" /><char style="w" x-id="WLC.PRO.18.15.001" x-align="PRO.18.15.a001" x-target-ids="t001 t002" x-target="The heart" x-target-head="t002" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="a.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֣ב</char> <char style="w" x-id="WLC.PRO.18.15.002" x-align="PRO.18.15.a002" x-target-ids="t003 t004 t005" x-target="of the prudent" x-target-head="t005" x-head="true" lemma="בִּין" strong="H995" x-morph="VNrmsa" x-gloss="discerning" x-translit="nāḇôn" xml:lang="hbo">נָ֭בוֹן</char> <char style="w" x-id="WLC.PRO.18.15.003" x-align="PRO.18.15.a003" x-target-ids="t006" x-target="getteth" x-target-head="t006" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqi3ms" x-gloss="it.acquires" x-translit="yiqneh-" xml:lang="hbo">יִקְנֶה</char>־<char style="w" x-id="WLC.PRO.18.15.004" x-align="PRO.18.15.a004" x-target-ids="t007" x-target="knowledge" x-target-head="t007" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="dāʿaṯ" xml:lang="hbo">דָּ֑עַת</char> <char style="w" x-id="WLC.PRO.18.15.005" x-align="PRO.18.15.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.18.15.006" x-align="PRO.18.15.a006" x-target-ids="t009 t010" x-target="the ear" x-target-head="t010" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsc" x-gloss="ear" x-translit="ʾōzen" xml:lang="hbo">אֹ֥זֶן</char> <char style="w" x-id="WLC.PRO.18.15.007" x-align="PRO.18.15.a007" x-target-ids="t011 t012 t013" x-target="of the wise" x-target-head="t013" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="of.wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲ֝כָמִ֗ים</char> <char style="w" x-id="WLC.PRO.18.15.008" x-align="PRO.18.15.a008" x-target-ids="t014" x-target="seeketh" x-targ