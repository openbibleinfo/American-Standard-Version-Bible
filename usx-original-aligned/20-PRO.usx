	<para style="p"><verse number="9" style="v" x-ref="PRO.19.9" sid="PRO 19:9" /><char style="w" x-id="WLC.PRO.19.9.001" x-align="PRO.19.9.a001" x-target-ids="t001 t003" x-target="A witness" x-target-head="t003" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsc" x-gloss="a.witness" x-translit="ʿēḏ" xml:lang="hbo">עֵ֣ד</char> <char style="w" x-id="WLC.PRO.19.9.002" x-align="PRO.19.9.a002" x-target-ids="t002" x-target="false" x-target-head="t002" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmpa" x-gloss="of.lies" x-translit="šəqārîm" xml:lang="hbo">שְׁ֭קָרִים</char> <char style="w" x-id="WLC.PRO.19.9.003" x-align="PRO.19.9.a003" x-target-ids="t005" x-target="not" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PRO.19.9.004" x-align="PRO.19.9.a004" x-target-ids="t004 t006 t007" x-target="shall be unpunished" x-target-head="t007" x-head="true" lemma="נָקָה" strong="H5352" x-morph="VNi3ms" x-gloss="he.will.go.unpunished" x-translit="yinnāqeh" xml:lang="hbo">יִנָּקֶ֑ה</char> <char style="w" x-id="WLC.PRO.19.9.005" x-align="PRO.19.9.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.9.006" x-align="PRO.19.9.a006" x-target-ids="t009 t010 t011" x-target="he that uttereth" x-target-head="t011" x-head="true" lemma="פּוּחַ" strong="H6315a" x-morph="Vhi3ms" x-gloss="he.breathes.out" x-translit="yāp̄iyᵃḥ" xml:lang="hbo">יָפִ֖יחַ</char> <char style="w" x-id="WLC.PRO.19.9.007" x-align="PRO.19.9.a007" x-target-ids="t012" x-target="lies" x-target-head="t012" x-head="true" lemma="כָּזָב" strong="H3577" x-morph="Ncmpa" x-gloss="lies" x-translit="kəzāḇiym" xml:lang="hbo">כְּזָבִ֣ים</char> <char style="w" x-id="WLC.PRO.19.9.008" x-align="PRO.19.9.a008" x-target-ids="t013 t014" x-target="shall perish" x-target-head="t