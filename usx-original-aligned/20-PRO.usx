	<para style="p"><verse number="22" style="v" x-ref="PRO.8.22" sid="PRO 8:22" /><char style="w" x-id="WLC.PRO.8.22.001" x-align="PRO.8.22.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PRO.8.22.002" x-align="PRO.8.22.a002" x-target-ids="t002" x-target="possessed" x-target-head="t002" x-head="true" lemma="קָנָה" strong="H7069a" x-morph="Vqp3ms" x-gloss="he" x-translit="qān" xml:lang="hbo">קָ֭נָ</char><char style="w" x-id="WLC.PRO.8.22.003" x-align="PRO.8.22.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="created.me" x-translit="āniy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PRO.8.22.004" x-align="PRO.8.22.a004" x-target-ids="t004 t005 t006" x-target="in the beginning" x-target-head="t006" x-head="true" lemma="רֵאשִׁית" strong="H7225" x-morph="Ncfsc" x-gloss="the.beginning" x-translit="rēʾšiyṯ" xml:lang="hbo">רֵאשִׁ֣ית</char> <char style="w" x-id="WLC.PRO.8.22.005" x-align="PRO.8.22.a005" x-target-ids="t007 t009" x-target="of way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="his.way" x-translit="dark" xml:lang="hbo">דַּרְכּ֑</char><char style="w" x-id="WLC.PRO.8.22.006" x-align="PRO.8.22.a006" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.8.22.007" x-align="PRO.8.22.a007" x-target-ids="t010" x-target="Before" x-target-head="t010" x-head="true" lemma="קֶדֶם" strong="H6924" x-morph="Ncmsc" x-gloss="the.beginning" x-translit="qeḏem" xml:lang="hbo">קֶ֖דֶם</char> <char style="w" x-id="WLC.PRO.8.22.008" x-align="PRO.8.22.a008" x-target-ids="t012" x-target="works" x-target-head="t012" x-head="true" lemma="מִפְעָל" strong="H4