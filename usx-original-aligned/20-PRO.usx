	<para style="p"><verse number="27" style="v" x-ref="PRO.30.27" sid="PRO 30:27" /><char style="w" x-id="WLC.PRO.30.27.001" x-align="PRO.30.27.a001" x-target-ids="t005" x-target="king" x-target-head="t005" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="a.king" x-translit="meleḵ" xml:lang="hbo">מֶ֭לֶךְ</char> <char style="w" x-id="WLC.PRO.30.27.002" x-align="PRO.30.27.a002" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.PRO.30.27.003" x-align="PRO.30.27.a003" x-target-ids="t003" x-target="have" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.30.27.004" x-align="PRO.30.27.a004" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.30.27.005" x-align="PRO.30.27.a005" x-target-ids="t002" x-target="locusts" x-target-head="t002" x-head="true" lemma="אַרְבֶּה" strong="H697" x-morph="Ncmsa" x-gloss="locust" x-translit="ʾarbeh" xml:lang="hbo">אַרְבֶּ֑ה</char> <char style="w" x-id="WLC.PRO.30.27.006" x-align="PRO.30.27.a006" x-target-ids="t006" x-target="Yet" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.30.27.007" x-align="PRO.30.27.a007" x-target-ids="t007 t008 t009" x-target="go they forth" x-target-head="t007" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqw3ms" x-gloss="it.went.out" x-translit="yyēṣēʾ" xml:lang="hbo">יֵּצֵ֖א</char> <char style="w" x-id="WLC.PRO.30.27.008" x-align="PRO.30.27.a008" x-target-ids="t013 t014" x-target="by bands" x-target-head="t014" x-head="true" lemma="חָצַץ" strong="H2686" x-morph="Vqrmsa" x-glos