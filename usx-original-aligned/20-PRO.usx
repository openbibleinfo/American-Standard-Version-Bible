	<para style="p"><verse number="31" style="v" x-ref="PRO.31.31" sid="PRO 31:31" /><char style="w" x-id="WLC.PRO.31.31.001" x-align="PRO.31.31.a001" x-target-ids="t001" x-target="Give" x-target-head="t001" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqv2mp" x-gloss="give" x-translit="tənû-" xml:lang="hbo">תְּנוּ</char>־<char style="w" x-id="WLC.PRO.31.31.002" x-align="PRO.31.31.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ֭</char><char style="w" x-id="WLC.PRO.31.31.003" x-align="PRO.31.31.a003" x-target-ids="t002" x-target="her" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.31.31.004" x-align="PRO.31.31.a004" x-target-ids="t003" x-target="of" x-target-head="t003" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="some" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.31.31.005" x-align="PRO.31.31.a005" x-target-ids="t004 t005" x-target="the fruit" x-target-head="t005" x-head="true" lemma="פְּרִי" strong="H6529" x-morph="Ncmsc" x-gloss="of.the.fruit" x-translit="pəriy" xml:lang="hbo">פְּרִ֣י</char> <char style="w" x-id="WLC.PRO.31.31.006" x-align="PRO.31.31.a006" x-target-ids="t006 t008" x-target="of hands" x-target-head="t008" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbdc" x-gloss="her.hands" x-translit="yāḏey" xml:lang="hbo">יָדֶ֑י</char><char style="w" x-id="WLC.PRO.31.31.007" x-align="PRO.31.31.a007" x-target-ids="t007" x-target="her" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.31.31.008" x-align="PRO.31.31.a008" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wi" xml:lang="hbo">וִֽ</char><char style="w" x-id="