	<para style="p"><verse number="4" style="v" x-ref="PRO.10.4" sid="PRO 10:4" /><char style="w" x-id="WLC.PRO.10.4.001" x-align="PRO.10.4.a001" x-target-ids="t002 t003" x-target="becometh poor" x-target-head="t003" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Ncmsa" x-gloss="[is].poor" x-translit="rāʾš" xml:lang="hbo">רָ֗אשׁ</char> <char style="w" x-id="WLC.PRO.10.4.002" x-align="PRO.10.4.a002" x-target-ids="t001 t004 t005" x-target="He that worketh" x-target-head="t005" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsa" x-gloss="[one.who].works" x-translit="ʿōśeh" xml:lang="hbo">עֹשֶׂ֥ה</char> <char style="w" x-id="WLC.PRO.10.4.003" x-align="PRO.10.4.a003" x-target-ids="t006 t007 t009" x-target="with a hand" x-target-head="t009" x-head="true" lemma="כַּף" strong="H3709" x-morph="Ncfsc" x-gloss="a.palm" x-translit="ḵap̄-" xml:lang="hbo">כַף</char>־<char style="w" x-id="WLC.PRO.10.4.004" x-align="PRO.10.4.a004" x-target-ids="t008" x-target="slack" x-target-head="t008" x-head="true" lemma="רְמִיָּה" strong="H7423" x-morph="Ncfsa" x-gloss="of.slackness" x-translit="rəmiyyāh" xml:lang="hbo">רְמִיָּ֑ה</char> <char style="w" x-id="WLC.PRO.10.4.005" x-align="PRO.10.4.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.10.4.006" x-align="PRO.10.4.a006" x-target-ids="t011 t012" x-target="the hand" x-target-head="t012" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yaḏ" xml:lang="hbo">יַ֖ד</char> <char style="w" x-id="WLC.PRO.10.4.007" x-align="PRO.10.4.a007" x-target-ids="t013 t014 t015" x-target="of the diligent" x-target-head="t015" x-head="true" lemma="חָרוּץ" strong="H2742e" x-morph="Aampa" x-gloss="of.diligent.[people]" x-translit="ḥārûṣiym" xml:lang="hbo">חָרוּצִ֣ים</char> <char style="w" x-id="WLC.PRO.10.4.008" x-align="PRO.10.4.a008" x-target-ids="t016 t017" x-targ