	<para style="p"><verse number="32" style="v" x-ref="PRO.30.32" x-added-alignments="PRO.30.32.a008 PRO.30.32.a009 PRO.30.32.a012" x-added-target-ids="t016 t017 t020" x-added-target="Lay | thy | thy" sid="PRO 30:32" /><char style="w" x-id="WLC.PRO.30.32.001" x-align="PRO.30.32.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.30.32.002" x-align="PRO.30.32.a002" x-target-ids="t002 t003 t004 t005" x-target="thou hast done foolishly" x-target-head="t005" x-head="true" lemma="נָבַל" strong="H5034a" x-morph="Vqp2ms" x-gloss="you.have.been.foolish" x-translit="nāḇalətā" xml:lang="hbo">נָבַ֥לְתָּ</char> <char style="w" x-id="WLC.PRO.30.32.003" x-align="PRO.30.32.a003" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.30.32.004" x-align="PRO.30.32.a004" x-target-ids="t007 t008 t009" x-target="lifting up thyself" x-target-head="t007" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vtc" x-gloss="exalting.yourself" x-translit="hiṯnaśśēʾ" xml:lang="hbo">הִתְנַשֵּׂ֑א</char> <char style="w" x-id="WLC.PRO.30.32.005" x-align="PRO.30.32.a005" x-target-ids="t010" x-target="Or" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.30.32.006" x-align="PRO.30.32.a006" x-target-ids="t011" x-target="if" x-target-head="t011" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.30.32.007" x-align="PRO.30.32.a007" x-target-ids="t012 t013 t014 t015" x-target="thou hast thought evil" x-target-head="t014" x-head="true" lemma="זָמַם" strong="H2161" x-morph="Vqp2ms" x-gloss="you.have.planned" x-translit="zammôṯā" xml:lan