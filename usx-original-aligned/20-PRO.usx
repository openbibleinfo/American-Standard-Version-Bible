	<para style="p"><verse number="5" style="v" x-ref="PRO.30.5" sid="PRO 30:5" /><char style="w" x-id="WLC.PRO.30.5.001" x-align="PRO.30.5.a001" x-target-ids="t001" x-target="Every" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PRO.30.5.002" x-align="PRO.30.5.a002" x-target-ids="t002" x-target="word" x-target-head="t002" x-head="true" lemma="אִמְרָה" strong="H565" x-morph="Ncfsc" x-gloss="word" x-translit="ʾimraṯ" xml:lang="hbo">אִמְרַ֣ת</char> <char style="w" x-id="WLC.PRO.30.5.003" x-align="PRO.30.5.a003" x-target-ids="t003 t004" x-target="of God" x-target-head="t004" x-head="true" lemma="אֱלֹוהַּ" strong="H433" x-morph="Ncmsa" x-gloss="of.God" x-translit="ʾĕlôᵃẖ" xml:lang="hbo">אֱל֣וֹהַּ</char> <char style="w" x-id="WLC.PRO.30.5.004" x-align="PRO.30.5.a004" x-target-ids="t005 t006" x-target="is tried" x-target-head="t006" x-head="true" lemma="צָרַף" strong="H6884" x-morph="Vqsfsa" x-gloss="[is].refined" x-translit="ṣərûp̄āh" xml:lang="hbo">צְרוּפָ֑ה</char> <char style="w" x-id="WLC.PRO.30.5.005" x-align="PRO.30.5.a005" x-target-ids="t008 t009 t010" x-target="is a shield" x-target-head="t010" x-head="true" lemma="מָגֵן" strong="H4043" x-morph="Ncbsa" x-gloss="[is].a.shield" x-translit="māḡēn" xml:lang="hbo">מָגֵ֥ן</char> <char style="w" x-id="WLC.PRO.30.5.006" x-align="PRO.30.5.a006" x-target-ids="t007" x-target="He" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֝֗וּא</char> <char style="w" x-id="WLC.PRO.30.5.007" x-align="PRO.30.5.a007" x-target-ids="t011" x-target="unto" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.PRO.30.5.008" x-align="PRO.30.5.a008" x-target-ids="t012 t013" x-target="them that" x-target-head="t012" x-head="true" lemma="הַ" strong="H1886a" 