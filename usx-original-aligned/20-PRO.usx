	<para style="p"><verse number="1" style="v" x-ref="PRO.23.1" sid="PRO 23:1" /><char style="w" x-id="WLC.PRO.23.1.001" x-align="PRO.23.1.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.23.1.002" x-align="PRO.23.1.a002" x-target-ids="t002 t003" x-target="thou sittest" x-target-head="t003" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqi2ms" x-gloss="you.will.sit.down" x-translit="ṯēšēḇ" xml:lang="hbo">תֵ֭שֵׁב</char> <char style="w" x-id="WLC.PRO.23.1.003" x-align="PRO.23.1.a003" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.23.1.004" x-align="PRO.23.1.a004" x-target-ids="t005" x-target="eat" x-target-head="t005" x-head="true" lemma="לָחַם" strong="H3898a" x-morph="Vqc" x-gloss="eat" x-translit="ləḥôm" xml:lang="hbo">לְח֣וֹם</char> <char style="w" x-id="WLC.PRO.23.1.005" x-align="PRO.23.1.a005" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.23.1.006" x-align="PRO.23.1.a006" x-target-ids="t007 t008" x-target="a ruler" x-target-head="t008" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vqrmsa" x-gloss="a.ruler" x-translit="môšēl" xml:lang="hbo">מוֹשֵׁ֑ל</char> <char style="w" x-id="WLC.PRO.23.1.007" x-align="PRO.23.1.a007" x-target-ids="t010" x-target="diligently" x-target-head="t010" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqa" x-gloss="carefully.(consider)" x-translit="biyn" xml:lang="hbo">בִּ֥ין</char> <char style="w" x-id="WLC.PRO.23.1.008" x-align="PRO.23.1.a008" x-target-ids="t009" x-target="Consider" x-target-head="t009" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqj2ms" x-gloss="you