	<para style="p"><verse number="23" style="v" x-ref="PRO.24.23" x-added-alignments="PRO.24.23.a011" x-added-target-ids="t004" x-added-target="sayings" sid="PRO 24:23" /><char style="w" x-id="WLC.PRO.24.23.001" x-align="PRO.24.23.a001" x-target-ids="t002" x-target="also" x-target-head="t002" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.PRO.24.23.002" x-align="PRO.24.23.a002" x-target-ids="t001" x-target="These" x-target-head="t001" x-head="true" lemma="אֵלֶּה" strong="H428" x-morph="Pdxcp" x-gloss="these" x-translit="ʾēlleh" xml:lang="hbo">אֵ֥לֶּה</char> <char style="w" x-id="WLC.PRO.24.23.003" x-align="PRO.24.23.a003" x-target-ids="t003 t005" x-target="are of" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belong].to" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.PRO.24.23.004" x-align="PRO.24.23.a004" x-target-ids="t006 t007" x-target="the wise" x-target-head="t007" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֑ים</char> <char style="w" x-id="WLC.PRO.24.23.005" x-align="PRO.24.23.a005" x-target-ids="t008 t009 t010 t011" x-target="To have respect of" x-target-head="t010" x-head="true" lemma="נָכַר" strong="H5234" x-morph="Vha" x-gloss="to.pay.regard.to" x-translit="hakēr-" xml:lang="hbo">הַֽכֵּר</char>־<char style="w" x-id="WLC.PRO.24.23.006" x-align="PRO.24.23.a006" x-target-ids="t012" x-target="persons" x-target-head="t012" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpa" x-gloss="faces" x-translit="pāniym" xml:lang="hbo">פָּנִ֖ים</char> <char style="w" x-id="WLC.PRO.24.23.007" x-align="PRO.24.23.a007" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.24.23.008" x-align="PRO.24.23.a0