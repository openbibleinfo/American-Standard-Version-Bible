	<para style="p"><verse number="30" style="v" x-ref="PRO.10.30" sid="PRO 10:30" /><char style="w" x-id="WLC.PRO.10.30.001" x-align="PRO.10.30.a001" x-target-ids="t001 t002" x-target="The righteous" x-target-head="t002" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֣יק</char> <char style="w" x-id="WLC.PRO.10.30.002" x-align="PRO.10.30.a002" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="forever" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.10.30.003" x-align="PRO.10.30.a002" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="of.perpetuity" x-translit="ʿôlām" xml:lang="hbo">עוֹלָ֣ם</char> <char style="w" x-id="WLC.PRO.10.30.004" x-align="PRO.10.30.a002" x-target-ids="t004" x-target="never" x-target-head="t004" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="bal-" xml:lang="hbo">בַּל</char>־<char style="w" x-id="WLC.PRO.10.30.005" x-align="PRO.10.30.a003" x-target-ids="t003 t005 t006" x-target="shall be removed" x-target-head="t006" x-head="true" lemma="מוֹט" strong="H4131" x-morph="VNi3ms" x-gloss="he.will.be.shaken" x-translit="yimmôṭ" xml:lang="hbo">יִמּ֑וֹט</char> <char style="w" x-id="WLC.PRO.10.30.006" x-align="PRO.10.30.a004" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.10.30.007" x-align="PRO.10.30.a005" x-target-ids="t008 t009" x-target="the wicked" x-target-head="t009" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֗ים</char> <char style="w" x-id="WLC.PRO.10.30.008" x-align="PRO.10.30.a006" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PRO.10.30