	<para style="p"><verse number="29" style="v" x-ref="PRO.15.29" sid="PRO 15:29" /><char style="w" x-id="WLC.PRO.15.29.001" x-align="PRO.15.29.a002" x-target-ids="t002 t003" x-target="is far" x-target-head="t003" x-head="true" lemma="רָחֹוק" strong="H7350" x-morph="Aamsa" x-gloss="[is].far" x-translit="rāḥôq" xml:lang="hbo">רָח֣וֹק</char> <char style="w" x-id="WLC.PRO.15.29.002" x-align="PRO.15.29.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.15.29.003" x-align="PRO.15.29.a003" x-target-ids="t004" x-target="from" x-target-head="t004" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.15.29.004" x-align="PRO.15.29.a004" x-target-ids="t005 t006" x-target="the wicked" x-target-head="t006" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֑ים</char> <char style="w" x-id="WLC.PRO.15.29.005" x-align="PRO.15.29.a005" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.15.29.006" x-align="PRO.15.29.a007" x-target-ids="t010 t011" x-target="the prayer" x-target-head="t011" x-head="true" lemma="תְּפִלָּה" strong="H8605" x-morph="Ncfsc" x-gloss="prayer" x-translit="ṯəp̄illaṯ" xml:lang="hbo">תְפִלַּ֖ת</char> <char style="w" x-id="WLC.PRO.15.29.007" x-align="PRO.15.29.a008" x-target-ids="t012 t013 t014" x-target="of the righteous" x-target-head="t014" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="of.righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַדִּיקִ֣ים</char> <char style="w" x-id="WLC.PRO.15.29.008" x-align="PRO.15.29.a006" x-target-ids="t008 t009" x-target="he hearet