	<para style="p"><verse number="18" style="v" x-ref="PRO.28.18" x-added-alignments="PRO.28.18.a007" x-added-target-ids="t013" x-added-target="his" sid="PRO 28:18" /><char style="w" x-id="WLC.PRO.28.18.001" x-align="PRO.28.18.a001" x-target-ids="t001 t002" x-target="Whoso walketh" x-target-head="t002" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[one.who].walks" x-translit="hôlēḵ" xml:lang="hbo">הוֹלֵ֣ךְ</char> <char style="w" x-id="WLC.PRO.28.18.002" x-align="PRO.28.18.a002" x-target-ids="t003" x-target="uprightly" x-target-head="t003" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aamsa" x-gloss="blameless" x-translit="tāmîm" xml:lang="hbo">תָּ֭מִים</char> <char style="w" x-id="WLC.PRO.28.18.003" x-align="PRO.28.18.a003" x-target-ids="t004 t005 t006" x-target="shall be delivered" x-target-head="t006" x-head="true" lemma="יָשַׁע" strong="H3467" x-morph="VNi3ms" x-gloss="he.will.be.delivered" x-translit="yiwwāšēᵃʿ" xml:lang="hbo">יִוָּשֵׁ֑עַ</char> <char style="w" x-id="WLC.PRO.28.18.004" x-align="PRO.28.18.a004" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.18.005" x-align="PRO.28.18.a005" x-target-ids="t008 t009 t010 t011" x-target="he that is perverse" x-target-head="t011" x-head="true" lemma="עָקַשׁ" strong="H6140" x-morph="VNsmsc" x-gloss="[one.who.is].crooked" x-translit="neʿqaš" xml:lang="hbo">נֶעְקַ֥שׁ</char> <char style="w" x-id="WLC.PRO.28.18.006" x-align="PRO.28.18.a006" x-target-ids="t012 t014" x-target="in ways" x-target-head="t014" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbda" x-gloss="of.two.ways" x-translit="dərāḵayim" xml:lang="hbo">דְּ֝רָכַ֗יִם</char> <char style="w" x-id="WLC.PRO.28.18.007" x-align="PRO.28.18.a008" x-target-ids="t015 t016" x-target="shall fall" x-target-head="t016" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="he.wi