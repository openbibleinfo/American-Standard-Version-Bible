	<para style="p"><verse number="20" style="v" x-ref="PRO.20.20" sid="PRO 20:20" /><char style="w" x-id="WLC.PRO.20.20.001" x-align="PRO.20.20.a001" x-target-ids="t001 t002" x-target="Whoso curseth" x-target-head="t002" x-head="true" lemma="קָלַל" strong="H7043" x-morph="Vprmsa" x-gloss="[one.who].curses" x-translit="məqallēl" xml:lang="hbo">מְ֭קַלֵּל</char> <char style="w" x-id="WLC.PRO.20.20.002" x-align="PRO.20.20.a003" x-target-ids="t004" x-target="father" x-target-head="t004" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="father" x-translit="ʾāḇiy" xml:lang="hbo">אָבִ֣י</char><char style="w" x-id="WLC.PRO.20.20.003" x-align="PRO.20.20.a002" x-target-ids="t003" x-target="his" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.20.20.004" x-align="PRO.20.20.a004" x-target-ids="t005" x-target="or" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.20.20.005" x-align="PRO.20.20.a006" x-target-ids="t007" x-target="mother" x-target-head="t007" x-head="true" lemma="אֵם" strong="H517" x-morph="Ncfsc" x-gloss="mother" x-translit="ʾimm" xml:lang="hbo">אִמּ֑</char><char style="w" x-id="WLC.PRO.20.20.006" x-align="PRO.20.20.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.20.20.007" x-align="PRO.20.20.a009" x-target-ids="t010 t011 t012 t013" x-target="shall be put out" x-target-head="t012" x-head="true" lemma="דָּעַךְ" strong="H1846" x-morph="Vqi3ms" x-gloss="it.will.be.extinguished" x-translit="yiḏəʿaḵ" xml:lang="hbo">יִֽדְעַ֥ךְ</char> <char style="w" x-id="WLC.PRO.20.20.008" x-align="PRO.20.20.a008" x-target-ids="t009" x-target="lamp" x-target-head="t009" x-head="true" lemma="נֵר" strong="