	<para style="p"><verse number="4" style="v" x-ref="PRO.12.4" sid="PRO 12:4" /><char style="w" x-id="WLC.PRO.12.4.001" x-align="PRO.12.4.a001" x-target-ids="t001 t003" x-target="A woman" x-target-head="t003" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsc" x-gloss="a.wife" x-translit="ʾēšeṯ-" xml:lang="hbo">אֵֽשֶׁת</char>־<char style="w" x-id="WLC.PRO.12.4.002" x-align="PRO.12.4.a002" x-target-ids="t002" x-target="worthy" x-target-head="t002" x-head="true" lemma="חַיִל" strong="H2428" x-morph="Ncmsa" x-gloss="of.ability" x-translit="ḥayil" xml:lang="hbo">חַ֭יִל</char> <char style="w" x-id="WLC.PRO.12.4.003" x-align="PRO.12.4.a003" x-target-ids="t004 t005 t006" x-target="is the crown" x-target-head="t006" x-head="true" lemma="עֲטֶרֶת" strong="H5850" x-morph="Ncfsc" x-gloss="[is].the.crown" x-translit="ʿăṭereṯ" xml:lang="hbo">עֲטֶ֣רֶת</char> <char style="w" x-id="WLC.PRO.12.4.004" x-align="PRO.12.4.a004" x-target-ids="t007 t009" x-target="of husband" x-target-head="t009" x-head="true" lemma="בַּעַל" strong="H1167" x-morph="Ncmsc" x-gloss="her.husband" x-translit="baʿl" xml:lang="hbo">בַּעְלָ֑</char><char style="w" x-id="WLC.PRO.12.4.005" x-align="PRO.12.4.a005" x-target-ids="t008" x-target="her" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.12.4.006" x-align="PRO.12.4.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.12.4.007" x-align="PRO.12.4.a007" x-target-ids="t015 t016" x-target="is as" x-target-head="t016" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ḵ" xml:lang="hbo">כְ</char><char style="w" x-id="WLC.PRO.12.4.008" x-align="PRO.12.4.a008" x-target-ids="t017" x-target="rottenness" x-target-head="t017" x-head="true" lemma="רָקָב" strong="H7538" x-mo