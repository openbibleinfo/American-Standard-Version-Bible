	<para style="p"><verse number="14" style="v" x-ref="PRO.27.14" sid="PRO 27:14" /><char style="w" x-id="WLC.PRO.27.14.001" x-align="PRO.27.14.a001" x-target-ids="t001 t002 t003" x-target="He that blesseth" x-target-head="t003" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vprmsa" x-gloss="[one.who].blesses" x-translit="məḇārēḵ" xml:lang="hbo">מְבָ֘רֵ֤ךְ</char> <char style="w" x-id="WLC.PRO.27.14.002" x-align="PRO.27.14.a002" x-target-ids="t005" x-target="friend" x-target-head="t005" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="neighbor" x-translit="rēʿ" xml:lang="hbo">רֵעֵ֨</char><char style="w" x-id="WLC.PRO.27.14.003" x-align="PRO.27.14.a003" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="ēhû" xml:lang="hbo">הוּ</char>׀<char style="w" x-id="WLC.PRO.27.14.004" x-align="PRO.27.14.a004" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.27.14.005" x-align="PRO.27.14.a005" x-target-ids="t007 t009" x-target="a voice" x-target-head="t009" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsa" x-gloss="a.voice" x-translit="qôl" xml:lang="hbo">ק֣וֹל</char> <char style="w" x-id="WLC.PRO.27.14.006" x-align="PRO.27.14.a006" x-target-ids="t008" x-target="loud" x-target-head="t008" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsa" x-gloss="great" x-translit="gāḏôl" xml:lang="hbo">גָּ֭דוֹל</char> <char style="w" x-id="WLC.PRO.27.14.007" x-align="PRO.27.14.a007" x-target-ids="t012" x-target="in" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PRO.27.14.008" x-align="PRO.27.14.a008" x-target-ids="t013" x-target="the" x-target-head="t013" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-glos