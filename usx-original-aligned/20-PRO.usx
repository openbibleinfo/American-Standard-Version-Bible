	<para style="p"><verse number="4" style="v" x-ref="PRO.21.4" x-added-alignments="PRO.21.4.a006" x-added-target-ids="t008" x-added-target="Even" sid="PRO 21:4" /><char style="w" x-id="WLC.PRO.21.4.001" x-align="PRO.21.4.a001" x-target-ids="t002" x-target="high" x-target-head="t002" x-head="true" lemma="רוּם" strong="H7312" x-morph="Ncmsc" x-gloss="haughtiness" x-translit="rûm-" xml:lang="hbo">רוּם</char>־<char style="w" x-id="WLC.PRO.21.4.002" x-align="PRO.21.4.a002" x-target-ids="t001 t003" x-target="A look" x-target-head="t003" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbda" x-gloss="of.eyes" x-translit="ʿênayim" xml:lang="hbo">עֵ֭ינַיִם</char> <char style="w" x-id="WLC.PRO.21.4.003" x-align="PRO.21.4.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.21.4.004" x-align="PRO.21.4.a004" x-target-ids="t006" x-target="proud" x-target-head="t006" x-head="true" lemma="רָחָב" strong="H7342" x-morph="Aamsc" x-gloss="a.[person].wide" x-translit="rəḥaḇ-" xml:lang="hbo">רְחַב</char>־<char style="w" x-id="WLC.PRO.21.4.005" x-align="PRO.21.4.a005" x-target-ids="t005 t007" x-target="a heart" x-target-head="t007" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.21.4.006" x-align="PRO.21.4.a007" x-target-ids="t009 t010" x-target="the lamp" x-target-head="t010" x-head="true" lemma="נִיר" strong="H5216" x-morph="Ncmsc" x-gloss="[the].lamp" x-translit="nir" xml:lang="hbo">נִ֖ר</char> <char style="w" x-id="WLC.PRO.21.4.007" x-align="PRO.21.4.a008" x-target-ids="t011 t012 t013" x-target="of the wicked" x-target-head="t013" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.21.4.008" x-align="PRO.21.4.a009" x-t