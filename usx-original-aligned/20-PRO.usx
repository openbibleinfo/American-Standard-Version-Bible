	<para style="p"><verse number="9" style="v" x-ref="PRO.10.9" sid="PRO 10:9" /><char style="w" x-id="WLC.PRO.10.9.001" x-align="PRO.10.9.a001" x-target-ids="t001 t002 t003" x-target="He that walketh" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[one.who].walks" x-translit="hôlēḵ" xml:lang="hbo">הוֹלֵ֣ךְ</char> <char style="w" x-id="WLC.PRO.10.9.002" x-align="PRO.10.9.a002" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ֭</char><char style="w" x-id="WLC.PRO.10.9.003" x-align="PRO.10.9.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.10.9.004" x-align="PRO.10.9.a002" x-target-ids="t004" x-target="uprightly" x-target-head="t004" x-head="true" lemma="תֹּם" strong="H8537" x-morph="Ncmsa" x-gloss="integrity" x-translit="tōm" xml:lang="hbo">תֹּם</char> <char style="w" x-id="WLC.PRO.10.9.005" x-align="PRO.10.9.a004" x-target-ids="t005" x-target="walketh" x-target-head="t005" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi3ms" x-gloss="he.walks" x-translit="yēleḵ" xml:lang="hbo">יֵ֣לֶךְ</char> <char style="w" x-id="WLC.PRO.10.9.006" x-align="PRO.10.9.a005" x-target-ids="t006" x-target="surely" x-target-head="t006" x-head="true" lemma="בֶּטַח" strong="H983" x-morph="Ncmsa" x-gloss="security" x-translit="beṭaḥ" xml:lang="hbo">בֶּ֑טַח</char> <char style="w" x-id="WLC.PRO.10.9.007" x-align="PRO.10.9.a006" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.9.008" x-align="PRO.10.9.a007" x-target-ids="t008 t009 t010" x-target="he that perverteth" x-target-head="t010" x-head="true" lemma="עָקַשׁ" strong="H6140" x-morph="Vprmsa" x-gloss="[one.who].makes.crooked" x-translit="məʿaqqēš" xml:lang="hbo">מְעַקֵּ֥שׁ</char> <char style