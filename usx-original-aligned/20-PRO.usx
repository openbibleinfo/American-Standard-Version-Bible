	<para style="p"><verse number="19" style="v" x-ref="PRO.7.19" sid="PRO 7:19" /><char style="w" x-id="WLC.PRO.7.19.001" x-align="PRO.7.19.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.7.19.002" x-align="PRO.7.19.a002" x-target-ids="t004 t005" x-target="is not" x-target-head="t005" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.PRO.7.19.003" x-align="PRO.7.19.a003" x-target-ids="t002" x-target="the" x-target-head="t002" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.PRO.7.19.004" x-align="PRO.7.19.a004" x-target-ids="t003" x-target="man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="husband" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.7.19.005" x-align="PRO.7.19.a005" x-target-ids="t006" x-target="at" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.7.19.006" x-align="PRO.7.19.a006" x-target-ids="t007" x-target="home" x-target-head="t007" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="ḇēyṯ" xml:lang="hbo">בֵית֑</char><char style="w" x-id="WLC.PRO.7.19.007" x-align="PRO.7.19.a007" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.7.19.008" x-align="PRO.7.19.a008" x-target-ids="t008 t009 t010" x-target="He is gone" x-target-head="t010" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqp3ms" x-gloss="he.has.gone" x-translit="hālaḵ" xml:lang="hbo">הָ֝לַ֗ךְ</char> <char style="w" x-id="WLC.P