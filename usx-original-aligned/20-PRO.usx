	<para style="p"><verse number="6" style="v" x-ref="PRO.2.6" sid="PRO 2:6" /><char style="w" x-id="WLC.PRO.2.6.001" x-align="PRO.2.6.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.2.6.002" x-align="PRO.2.6.a002" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.2.6.003" x-align="PRO.2.6.a003" x-target-ids="t003" x-target="giveth" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="he.gives" x-translit="yittēn" xml:lang="hbo">יִתֵּ֣ן</char> <char style="w" x-id="WLC.PRO.2.6.004" x-align="PRO.2.6.a004" x-target-ids="t004" x-target="wisdom" x-target-head="t004" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.2.6.005" x-align="PRO.2.6.a005" x-target-ids="t005 t006 t009" x-target="Out of cometh" x-target-italic-ids="t009" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="[are].from" x-translit="mi" xml:lang="hbo">מִ֝</char><char style="w" x-id="WLC.PRO.2.6.006" x-align="PRO.2.6.a006" x-target-ids="t008" x-target="mouth" x-target-head="t008" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="piy" xml:lang="hbo">פִּ֗י</char><char style="w" x-id="WLC.PRO.2.6.007" x-align="PRO.2.6.a007" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.2.6.008" x-align="PRO.2.6.a008" x-target-ids="t010" x-target="knowledge" x-target-head="t010" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowled