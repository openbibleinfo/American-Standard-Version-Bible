	<para style="p"><verse number="15" style="v" x-ref="PRO.12.15" sid="PRO 12:15" /><char style="w" x-id="WLC.PRO.12.15.001" x-align="PRO.12.15.a001" x-target-ids="t001 t002" x-target="The way" x-target-head="t002" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="[the].way" x-translit="dereḵ" xml:lang="hbo">דֶּ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.12.15.002" x-align="PRO.12.15.a002" x-target-ids="t003 t004 t005" x-target="of a fool" x-target-head="t005" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="of.a.fool" x-translit="ʾĕwîl" xml:lang="hbo">אֱ֭וִיל</char> <char style="w" x-id="WLC.PRO.12.15.003" x-align="PRO.12.15.a003" x-target-ids="t006 t007" x-target="is right" x-target-head="t007" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aamsa" x-gloss="[is].right" x-translit="yāšār" xml:lang="hbo">יָשָׁ֣ר</char> <char style="w" x-id="WLC.PRO.12.15.004" x-align="PRO.12.15.a004" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.12.15.005" x-align="PRO.12.15.a005" x-target-ids="t011" x-target="eyes" x-target-head="t011" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="his.own" x-translit="ʿēynāy" xml:lang="hbo">עֵינָ֑י</char><char style="w" x-id="WLC.PRO.12.15.006" x-align="PRO.12.15.a006" x-target-ids="t009 t010" x-target="his own" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="eyes" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.12.15.007" x-align="PRO.12.15.a007" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.15.008" x-align="PRO.12.15.a008" x-target-ids="t017" x-target="hearkeneth" x-target-head="t017" x-head="true" lemma="שָׁמַע" strong="H8085" x-mor