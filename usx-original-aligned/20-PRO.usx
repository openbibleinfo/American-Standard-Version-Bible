	<para style="p"><verse number="1" style="v" x-ref="PRO.12.1" sid="PRO 12:1" /><char style="w" x-id="WLC.PRO.12.1.001" x-align="PRO.12.1.a001" x-target-ids="t001 t002" x-target="Whoso loveth" x-target-head="t002" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[one.who].loves" x-translit="ʾōhēḇ" xml:lang="hbo">אֹהֵ֣ב</char> <char style="w" x-id="WLC.PRO.12.1.002" x-align="PRO.12.1.a002" x-target-ids="t003" x-target="correction" x-target-head="t003" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsa" x-gloss="discipline" x-translit="mûsār" xml:lang="hbo">מ֭וּסָר</char><char style="w" x-id="WLC.PRO.12.1.003" x-align="PRO.12.1.a003" x-target-ids="t004" x-target="loveth" x-target-head="t004" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[is].loving" x-translit="ʾōhēḇ" xml:lang="hbo">אֹ֣הֵֽב</char> <char style="w" x-id="WLC.PRO.12.1.004" x-align="PRO.12.1.a004" x-target-ids="t005" x-target="knowledge" x-target-head="t005" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="dāʿaṯ" xml:lang="hbo">דָּ֑עַת</char> <char style="w" x-id="WLC.PRO.12.1.005" x-align="PRO.12.1.a005" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.1.006" x-align="PRO.12.1.a006" x-target-ids="t007 t008 t009" x-target="he that hateth" x-target-head="t009" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[one.who].hates" x-translit="śōnēʾ" xml:lang="hbo">שֹׂנֵ֖א</char> <char style="w" x-id="WLC.PRO.12.1.007" x-align="PRO.12.1.a007" x-target-ids="t010" x-target="reproof" x-target-head="t010" x-head="true" lemma="תּוֹכַחַת" strong="H8433a" x-morph="Ncfsa" x-gloss="rebuke" x-translit="ṯôḵaḥaṯ" xml:lang="hbo">תוֹכַ֣חַת</char> <char style="w" x-id="WLC.PRO.12.1.008" x-align="PRO.12.1.a008" x-target-ids="t011 t012" x-target="is brutish" x-target-head="t0