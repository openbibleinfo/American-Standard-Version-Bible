	<para style="p"><verse number="16" style="v" x-ref="PRO.7.16" sid="PRO 7:16" /><char style="w" x-id="WLC.PRO.7.16.001" x-align="PRO.7.16.a001" x-target-ids="t007 t008 t009" x-target="carpets of tapestry" x-target-head="t007" x-head="true" lemma="מַרְבַדִּים" strong="H4765" x-morph="Ncmpa" x-gloss="coverings" x-translit="marḇaddîm" xml:lang="hbo">מַ֭רְבַדִּים</char> <char style="w" x-id="WLC.PRO.7.16.002" x-align="PRO.7.16.a002" x-target-ids="t001 t002 t003 t006" x-target="I have spread with" x-target-head="t003" x-head="true" lemma="רָבַד" strong="H7234" x-morph="Vqp1cs" x-gloss="I.have.spread" x-translit="rāḇaḏətî" xml:lang="hbo">רָבַ֣דְתִּי</char> <char style="w" x-id="WLC.PRO.7.16.003" x-align="PRO.7.16.a003" x-target-ids="t005" x-target="couch" x-target-head="t005" x-head="true" lemma="עֶרֶשׂ" strong="H6210" x-morph="Ncfsc" x-gloss="couch" x-translit="ʿarś" xml:lang="hbo">עַרְשִׂ֑</char><char style="w" x-id="WLC.PRO.7.16.004" x-align="PRO.7.16.a004" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.7.16.005" x-align="PRO.7.16.a005" x-target-ids="t010 t011 t012" x-target="With striped cloths" x-target-head="t011" x-head="true" lemma="חטב" strong="H2405" x-morph="Ncfpc" x-gloss="colored.fabrics" x-translit="ḥăṭuḇôṯ" xml:lang="hbo">חֲ֝טֻב֗וֹת</char> <char style="w" x-id="WLC.PRO.7.16.006" x-align="PRO.7.16.a006" x-target-ids="t013 t014 t015" x-target="of the yarn" x-target-head="t015" x-head="true" lemma="אֵטוּן" strong="H330" x-morph="Ncmsc" x-gloss="linen" x-translit="ʾēṭûn" xml:lang="hbo">אֵט֥וּן</char> <char style="w" x-id="WLC.PRO.7.16.007" x-align="PRO.7.16.a007" x-target-ids="t016 t017" x-target="of Egypt" x-target-head="t017" x-head="true" lemma="מִצְרַיִם" strong="H4714" x-morph="Np" x-gloss="of.Egypt" x-translit="miṣrāyim:" xml:lang="hbo">מִצְרָֽיִם</char>׃<verse eid="PRO 7:16" /></para>
	<para style="p"><verse number="17" style="v" x-ref="PRO.7.17" sid="PRO 7:17" /><char style="w" x-id="WLC.PRO.7.17.001" x-align="PRO.7.17.a001" x-target-ids="t001 t002 t003 t006" x-target="I have perfumed With" x-target-head="t003" x-head="true" lemma="נוּף" strong="H5130a" x-morph="Vqp1cs" x-gloss="I.have.sprinkled" x-translit="nap̄ətî" xml:lang="hbo">נַ֥פְתִּי</char> <char style="w" x-id="WLC.PRO.7.17.002" x-align="PRO.7.17.a002" x-target-ids="t005" x-target="bed" x-target-head="t005" x-head="true" lemma="מִשְׁכָּב" strong="H4904" x-morph="Ncmsc" x-gloss="bed" x-translit="miškāḇ" xml:lang="hbo">מִשְׁכָּבִ֑</char><char style="w" x-id="WLC.PRO.7.17.003" x-align="PRO.7.17.a003" x-target-ids="t004" x-target="my" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.7.17.004" x-align="PRO.7.17.a004" x-target-ids="t007" x-target="myrrh" x-target-head="t007" x-head="true" lemma="מֹר" strong="H4753" x-morph="Ncmsa" x-gloss="myrrh" x-translit="mōr" xml:lang="hbo">מֹ֥ר</char> <char style="w" x-id="WLC.PRO.7.17.005" x-align="PRO.7.17.a005" x-target-ids="t008" x-target="aloes" x-target-head="t008" x-head="true" lemma="אָהָל" strong="H174" x-morph="Ncmpa" x-gloss="aloes" x-translit="ʾăhāliym" xml:lang="hbo">אֲ֝הָלִ֗ים</char> <char style="w" x-id="WLC.PRO.7.17.006" x-align="PRO.7.17.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.7.17.007" x-align="PRO.7.17.a007" x-target-ids="t010" x-target="cinnamon" x-target-head="t010" x-head="true" lemma="קִנָּמוֹן" strong="H7076" x-morph="Ncmsa" x-gloss="cinnamon" x-translit="qinnāmôn:" xml:lang="hbo">קִנָּמֽוֹן</char>׃<verse eid="PRO 7:17" /></para>
	<para style="p"><verse number="18" style="v" x-ref="PRO.7.18" sid="PRO 7:18" /><char style="w" x-id="WLC.PRO.7.18.001" x-align="PRO.7.18.a001" x-target-ids="t001" x-target="Come" x-target-head="t001" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2ms" x-gloss="come" x-translit="ləḵ" xml:lang="hbo">לְכָ֤</char><char style="w" x-id="WLC.PRO.7.18.002" x-align="PRO.7.18.a002" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PRO.7.18.003" x-align="PRO.7.18.a003" x-target-ids="t002 t003 t004 t005 t006 t007" x-target="let us take our fill of" x-target-head="t006" x-head="true" lemma="רָוָה" strong="H7301" x-morph="Vqh1cp" x-gloss="let.us.take.our.fill.of" x-translit="nirweh" xml:lang="hbo">נִרְוֶ֣ה</char> <char style="w" x-id="WLC.PRO.7.18.004" x-align="PRO.7.18.a004" x-target-ids="t008" x-target="love" x-target-head="t008" x-head="true" lemma="דּוֹד" strong="H1730" x-morph="Ncmpa" x-gloss="love(s)" x-translit="ḏōḏîm" xml:lang="hbo">דֹ֭דִים</char> <char style="w" x-id="WLC.PRO.7.18.005" x-align="PRO.7.18.a005" x-target-ids="t009" x-target="until" x-target-head="t009" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="until" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PRO.7.18.006" x-align="PRO.7.18.a006" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PRO.7.18.007" x-align="PRO.7.18.a007" x-target-ids="t011" x-target="morning" x-target-head="t011" x-head="true" lemma="בֹּקֶר" strong="H1242" x-morph="Ncmsa" x-gloss="morning" x-translit="bōqer" xml:lang="hbo">בֹּ֑קֶר</char> <char style="w" x-id="WLC.PRO.7.18.008" x-align="PRO.7.18.a008" x-target-ids="t012 t013 t014 t015" x-target="Let us solace ourselves" x-target-head="t014" x-head="true" lemma="עָלַס" strong="H5965" x-morph="Vth1cp" x-gloss="let.u