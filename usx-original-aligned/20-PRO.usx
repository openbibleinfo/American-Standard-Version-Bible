	<para style="p"><verse number="25" style="v" x-ref="PRO.30.25" sid="PRO 30:25" /><char style="w" x-id="WLC.PRO.30.25.001" x-align="PRO.30.25.a001" x-target-ids="t001" x-target="The" x-target-head="t001" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PRO.30.25.002" x-align="PRO.30.25.a002" x-target-ids="t002" x-target="ants" x-target-head="t002" x-head="true" lemma="נְמָלָה" strong="H5244" x-morph="Ncfpa" x-gloss="ants" x-translit="nnəmālîm" xml:lang="hbo">נְּמָלִים</char> <char style="w" x-id="WLC.PRO.30.25.003" x-align="PRO.30.25.a003" x-target-ids="t003 t004 t005" x-target="are a people" x-target-head="t005" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="[are].a.people" x-translit="ʿam" xml:lang="hbo">עַ֣ם</char> <char style="w" x-id="WLC.PRO.30.25.004" x-align="PRO.30.25.a004" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.30.25.005" x-align="PRO.30.25.a005" x-target-ids="t007" x-target="strong" x-target-head="t007" x-head="true" lemma="עַז" strong="H5794" x-morph="Aamsa" x-gloss="strong" x-translit="ʿāz" xml:lang="hbo">עָ֑ז</char> <char style="w" x-id="WLC.PRO.30.25.006" x-align="PRO.30.25.a006" x-target-ids="t008" x-target="Yet" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.30.25.007" x-align="PRO.30.25.a007" x-target-ids="t009 t010" x-target="they provide" x-target-head="t010" x-head="true" lemma="כּוּן" strong="H3559" x-morph="Vhw3mp" x-gloss="they.prepared" x-translit="yyāḵiynû" xml:lang="hbo">יָּכִ֖ינוּ</char> <char style="w" x-id="WLC.PRO.30.25.008" x-align="PRO.30.25.a008" x-target-ids="t013" x-target="in" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in