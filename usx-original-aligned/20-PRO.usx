	<para style="p"><verse number="24" style="v" x-ref="PRO.24.24" sid="PRO 24:24" /><char style="w" x-id="WLC.PRO.24.24.001" x-align="PRO.24.24.a001" x-target-ids="t001 t002 t003" x-target="He that saith" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqrmsa" x-gloss="[one.who].says" x-translit="ʾōmēr" xml:lang="hbo">אֹ֤מֵ֨ר</char>׀<char style="w" x-id="WLC.PRO.24.24.002" x-align="PRO.24.24.a002" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.24.24.003" x-align="PRO.24.24.a003" x-target-ids="t005 t006" x-target="the wicked" x-target-head="t006" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁע֮</char> <char style="w" x-id="WLC.PRO.24.24.004" x-align="PRO.24.24.a004" x-target-ids="t008 t009" x-target="art righteous" x-target-head="t009" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="[are].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֪יק</char> <char style="w" x-id="WLC.PRO.24.24.005" x-align="PRO.24.24.a005" x-target-ids="t007" x-target="Thou" x-target-head="t007" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾātâ" xml:lang="hbo">אָ֥תָּה</char> <char style="w" x-id="WLC.PRO.24.24.006" x-align="PRO.24.24.a006" x-target-ids="t011 t012" x-target="shall curse" x-target-head="t012" x-head="true" lemma="קבב" strong="H6895" x-morph="Vqi3mp" x-gloss="they" x-translit="yiqqəḇu" xml:lang="hbo">יִקְּבֻ֥</char><char style="w" x-id="WLC.PRO.24.24.007" x-align="PRO.24.24.a007" x-target-ids="t013" x-target="him" x-target-head="t013" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="will.curse.him" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.24.24.008" x-align="PRO.24.24.a008" x-target-ids="t010" x-target="Peoples" x-target-he