	<para style="p"><verse number="25" style="v" x-ref="PRO.23.25" sid="PRO 23:25" /><char style="w" x-id="WLC.PRO.23.25.001" x-align="PRO.23.25.a001" x-target-ids="t001 t007 t008" x-target="Let be glad" x-target-head="t008" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqj3ms" x-gloss="may.he.rejoice" x-translit="yiśəmaḥ-" xml:lang="hbo">יִֽשְׂמַח</char>־<char style="w" x-id="WLC.PRO.23.25.002" x-align="PRO.23.25.a002" x-target-ids="t003" x-target="father" x-target-head="t003" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="father" x-translit="ʾāḇiy" xml:lang="hbo">אָבִ֥י</char><char style="w" x-id="WLC.PRO.23.25.003" x-align="PRO.23.25.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.23.25.004" x-align="PRO.23.25.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.23.25.005" x-align="PRO.23.25.a005" x-target-ids="t006" x-target="mother" x-target-head="t006" x-head="true" lemma="אֵם" strong="H517" x-morph="Ncfsc" x-gloss="mother" x-translit="ʾimm" xml:lang="hbo">אִמֶּ֑</char><char style="w" x-id="WLC.PRO.23.25.006" x-align="PRO.23.25.a006" x-target-ids="t005" x-target="thy" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.23.25.007" x-align="PRO.23.25.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.23.25.008" x-align="PRO.23.25.a008" x-target-ids="t010 t015" x-target="let rejoice" x-target-head="t015" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqj3fs" x-gloss="may.she.rejoi