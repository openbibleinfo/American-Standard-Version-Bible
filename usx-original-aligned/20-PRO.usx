	<para style="p"><verse number="33" style="v" x-ref="PRO.6.33" sid="PRO 6:33" /><char style="w" x-id="WLC.PRO.6.33.001" x-align="PRO.6.33.a001" x-target-ids="t001" x-target="Wounds" x-target-head="t001" x-head="true" lemma="נֶגַע" strong="H5061" x-morph="Ncmsa" x-gloss="a.wound" x-translit="neḡaʿ-" xml:lang="hbo">נֶֽגַע</char>־<char style="w" x-id="WLC.PRO.6.33.002" x-align="PRO.6.33.a002" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.6.33.003" x-align="PRO.6.33.a003" x-target-ids="t003" x-target="dishonor" x-target-head="t003" x-head="true" lemma="קָלוֹן" strong="H7036" x-morph="Ncmsa" x-gloss="shame" x-translit="qālôn" xml:lang="hbo">קָל֥וֹן</char> <char style="w" x-id="WLC.PRO.6.33.004" x-align="PRO.6.33.a004" x-target-ids="t004 t005 t006" x-target="shall he get" x-target-head="t006" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqi3ms" x-gloss="he.will.find" x-translit="yimṣāʾ" xml:lang="hbo">יִמְצָ֑א</char> <char style="w" x-id="WLC.PRO.6.33.005" x-align="PRO.6.33.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.6.33.006" x-align="PRO.6.33.a006" x-target-ids="t009" x-target="reproach" x-target-head="t009" x-head="true" lemma="חֶרְפָּה" strong="H2781" x-morph="Ncfsc" x-gloss="reproach" x-translit="ḥerpāṯ" xml:lang="hbo">חֶרְפָּת֗</char><char style="w" x-id="WLC.PRO.6.33.007" x-align="PRO.6.33.a007" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.6.33.008" x-align="PRO.6.33.a008" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ