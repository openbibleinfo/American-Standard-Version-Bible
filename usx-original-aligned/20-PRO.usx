	<para style="p"><verse number="21" style="v" x-ref="PRO.24.21" x-added-alignments="PRO.24.21.a012" x-added-target-ids="t009" x-added-target="And" sid="PRO 24:21" /><char style="w" x-id="WLC.PRO.24.21.001" x-align="PRO.24.21.a001" x-target-ids="t003 t004" x-target="fear thou" x-target-head="t003" x-head="true" lemma="יָרֵא" strong="H3372" x-morph="Vqv2ms" x-gloss="fear" x-translit="yərāʾ-" xml:lang="hbo">יְרָֽא</char>־<char style="w" x-id="WLC.PRO.24.21.002" x-align="PRO.24.21.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.24.21.003" x-align="PRO.24.21.a003" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PRO.24.21.004" x-align="PRO.24.21.a004" x-target-ids="t002" x-target="son" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="bən" xml:lang="hbo">בְּנִ֣</char><char style="w" x-id="WLC.PRO.24.21.005" x-align="PRO.24.21.a005" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.24.21.006" x-align="PRO.24.21.a006" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PRO.24.21.007" x-align="PRO.24.21.a007" x-target-ids="t007 t008" x-target="the king" x-target-head="t008" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="king" x-translit="meleḵ" xml:lang="hbo">מֶ֑לֶךְ</char> <char style="w" x-id="WLC.PRO.24.21.008" x-align="PRO.24.21.a008" x-target-ids="t012" x-target="with" x-target-head="t012" x-head="true" lemma="עִם" strong="H597