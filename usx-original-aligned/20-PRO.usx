	<para style="p"><verse number="20" style="v" x-ref="PRO.28.20" sid="PRO 28:20" /><char style="w" x-id="WLC.PRO.28.20.001" x-align="PRO.28.20.a001" x-target-ids="t001 t003" x-target="A man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.28.20.002" x-align="PRO.28.20.a002" x-target-ids="t002" x-target="faithful" x-target-head="t002" x-head="true" lemma="אֱמוּנָה" strong="H530" x-morph="Ncfpa" x-gloss="of.faithfulness(es)" x-translit="ʾĕmûnôṯ" xml:lang="hbo">אֱ֭מוּנוֹת</char> <char style="w" x-id="WLC.PRO.28.20.003" x-align="PRO.28.20.a003" x-target-ids="t004 t005" x-target="shall abound" x-target-head="t005" x-head="true" lemma="רַב" strong="H7227" x-morph="Aamsc" x-gloss="[will.be].great" x-translit="raḇ-" xml:lang="hbo">רַב</char>־<char style="w" x-id="WLC.PRO.28.20.004" x-align="PRO.28.20.a004" x-target-ids="t006 t007" x-target="with blessings" x-target-head="t007" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfpa" x-gloss="of.blessings" x-translit="bərāḵôṯ" xml:lang="hbo">בְּרָכ֑וֹת</char> <char style="w" x-id="WLC.PRO.28.20.005" x-align="PRO.28.20.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.20.006" x-align="PRO.28.20.a006" x-target-ids="t009 t010 t011 t012" x-target="he that maketh haste" x-target-head="t012" x-head="true" lemma="אוּץ" strong="H213" x-morph="Vqrmsa" x-gloss="[one.who].hastens" x-translit="ʾāṣ" xml:lang="hbo">אָ֥ץ</char> <char style="w" x-id="WLC.PRO.28.20.007" x-align="PRO.28.20.a007" x-target-ids="t013" x-target="to" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֝</char><char style="w" x-id="WLC.PRO.28.20.008" x-align="PRO.28.20.a008" x-target-ids="t014 t015" x-target="be rich" x-