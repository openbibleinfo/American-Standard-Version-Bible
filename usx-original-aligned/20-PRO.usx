	<para style="p"><verse number="17" style="v" x-ref="PRO.1.17" sid="PRO 1:17" /><char style="w" x-id="WLC.PRO.1.17.001" x-align="PRO.1.17.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.1.17.002" x-align="PRO.1.17.a002" x-target-ids="t002 t003" x-target="in vain" x-target-head="t003" x-head="true" lemma="חִנָּם" strong="H2600" x-morph="D" x-gloss="in.vain" x-translit="ḥinnām" xml:lang="hbo">חִ֭נָּם</char> <char style="w" x-id="WLC.PRO.1.17.003" x-align="PRO.1.17.a003" x-target-ids="t004 t007" x-target="is spread" x-target-head="t007" x-head="true" lemma="זָרָה" strong="H2219" x-morph="VPsfsa" x-gloss="[is].spread.out" x-translit="məzōrāh" xml:lang="hbo">מְזֹרָ֣ה</char> <char style="w" x-id="WLC.PRO.1.17.004" x-align="PRO.1.17.a004" x-target-ids="t005" x-target="the" x-target-head="t005" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.PRO.1.17.005" x-align="PRO.1.17.a005" x-target-ids="t006" x-target="net" x-target-head="t006" x-head="true" lemma="רֶשֶׁת" strong="H7568" x-morph="Ncfsa" x-gloss="net" x-translit="rāšeṯ" xml:lang="hbo">רָ֑שֶׁת</char> <char style="w" x-id="WLC.PRO.1.17.006" x-align="PRO.1.17.a006" x-target-ids="t008" x-target="In" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֝</char><char style="w" x-id="WLC.PRO.1.17.007" x-align="PRO.1.17.a007" x-target-ids="t009 t010" x-target="the sight" x-target-head="t010" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="the.eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֗י</char> <char style="w" x-id="WLC.PRO.1.17.008" x-align="PRO.1.17.a008" x-target-ids="t011 t012" x-target="of any" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="of.every" x-