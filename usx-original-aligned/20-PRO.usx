	<para style="p"><verse number="30" style="v" x-ref="PRO.31.30" x-added-alignments="PRO.31.30.a008" x-added-target-ids="t008" x-added-target="But" sid="PRO 31:30" /><char style="w" x-id="WLC.PRO.31.30.001" x-align="PRO.31.30.a001" x-target-ids="t002 t003" x-target="is deceitful" x-target-head="t003" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="[is].deception" x-translit="šeqer" xml:lang="hbo">שֶׁ֣קֶר</char> <char style="w" x-id="WLC.PRO.31.30.002" x-align="PRO.31.30.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PRO.31.30.003" x-align="PRO.31.30.a003" x-target-ids="t001" x-target="Grace" x-target-head="t001" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="grace" x-translit="ḥēn" xml:lang="hbo">חֵן</char> <char style="w" x-id="WLC.PRO.31.30.004" x-align="PRO.31.30.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.31.30.005" x-align="PRO.31.30.a005" x-target-ids="t006 t007" x-target="is vain" x-target-head="t007" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsa" x-gloss="vanity" x-translit="heḇel" xml:lang="hbo">הֶ֣בֶל</char> <char style="w" x-id="WLC.PRO.31.30.006" x-align="PRO.31.30.a006" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PRO.31.30.007" x-align="PRO.31.30.a007" x-target-ids="t005" x-target="beauty" x-target-head="t005" x-head="true" lemma="יֳפִי" strong="H3308" x-morph="Ncmsa" x-gloss="beauty" x-translit="yyōp̄î" xml:lang="hbo">יֹּ֑פִי</char> <char style="w" x-id="WLC.PRO.31.30.008" x-align="PRO.31.30.a009" x-target-ids="t009 t010" x-target="a woman" x-target-head="t010" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph