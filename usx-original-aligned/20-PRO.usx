	<para style="p"><verse number="1" style="v" x-ref="PRO.1.1" sid="PRO 1:1" /><char style="w" x-id="WLC.PRO.1.1.001" x-align="PRO.1.1.a001" x-target-ids="t001 t002" x-target="The proverbs" x-target-head="t002" x-head="true" lemma="מָשָׁל" strong="H4912" x-morph="Ncmpc" x-gloss="the.proverbs" x-translit="mišlê" xml:lang="hbo">מִ֭שְׁלֵי</char> <char style="w" x-id="WLC.PRO.1.1.002" x-align="PRO.1.1.a002" x-target-ids="t003 t004" x-target="of Solomon" x-target-head="t004" x-head="true" lemma="שְׁלֹמֹה" strong="H8010" x-morph="Np" x-gloss="of.Solomon" x-translit="šəlōmōh" xml:lang="hbo">שְׁלֹמֹ֣ה</char> <char style="w" x-id="WLC.PRO.1.1.003" x-align="PRO.1.1.a003" x-target-ids="t005 t006" x-target="the son" x-target-head="t006" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="the.son" x-translit="ḇen-" xml:lang="hbo">בֶן</char>־<char style="w" x-id="WLC.PRO.1.1.004" x-align="PRO.1.1.a004" x-target-ids="t007 t008" x-target="of David" x-target-head="t008" x-head="true" lemma="דָּוִד" strong="H1732" x-morph="Np" x-gloss="of.David" x-translit="dāwiḏ" xml:lang="hbo">דָּוִ֑ד</char> <char style="w" x-id="WLC.PRO.1.1.005" x-align="PRO.1.1.a005" x-target-ids="t009" x-target="king" x-target-head="t009" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsc" x-gloss="the.king" x-translit="meleḵ" xml:lang="hbo">מֶ֝֗לֶךְ</char> <char style="w" x-id="WLC.PRO.1.1.006" x-align="PRO.1.1.a006" x-target-ids="t010 t011" x-target="of Israel" x-target-head="t011" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="of.Israel" x-translit="yiśrāʾēl:" xml:lang="hbo">יִשְׂרָאֵֽל</char>׃<verse eid="PRO 1:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="PRO.1.2" sid="PRO 1:2" /><char style="w" x-id="WLC.PRO.1.2.001" x-align="PRO.1.2.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.1.2.002" x-align="PRO.1.2.a002" x-target-ids="t002" x-target="know" x-target-head="t002" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqc" x-gloss="learn" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֣עַת</char> <char style="w" x-id="WLC.PRO.1.2.003" x-align="PRO.1.2.a003" x-target-ids="t003" x-target="wisdom" x-target-head="t003" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֣ה</char> <char style="w" x-id="WLC.PRO.1.2.004" x-align="PRO.1.2.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.1.2.005" x-align="PRO.1.2.a005" x-target-ids="t005" x-target="instruction" x-target-head="t005" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsa" x-gloss="discipline" x-translit="mûsār" xml:lang="hbo">מוּסָ֑ר</char> <char style="w" x-id="WLC.PRO.1.2.006" x-align="PRO.1.2.a006" x-target-ids="t006" x-target="To" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֝</char><char style="w" x-id="WLC.PRO.1.2.007" x-align="PRO.1.2.a007" x-target-ids="t007" x-target="discern" x-target-head="t007" x-head="true" lemma="בִּין" strong="H995" x-morph="Vhc" x-gloss="teach" x-translit="hāḇiyn" xml:lang="hbo">הָבִ֗ין</char> <char style="w" x-id="WLC.PRO.1.2.008" x-align="PRO.1.2.a008" x-target-ids="t008 t009" x-target="the words" x-target-head="t009" x-head="true" lemma="אֵמֶר" strong="H561" x-morph="Ncmpc" x-gloss="words" x-translit="ʾimrēy" xml:lang="hbo">אִמְרֵ֥י</char> <char st