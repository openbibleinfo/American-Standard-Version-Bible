	<para style="p"><verse number="19" style="v" x-ref="PRO.3.19" sid="PRO 3:19" /><char style="w" x-id="WLC.PRO.3.19.001" x-align="PRO.3.19.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְֽהוָ֗ה</char> <char style="w" x-id="WLC.PRO.3.19.002" x-align="PRO.3.19.a002" x-target-ids="t002" x-target="by" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.3.19.003" x-align="PRO.3.19.a003" x-target-ids="t003" x-target="wisdom" x-target-head="t003" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֥ה</char> <char style="w" x-id="WLC.PRO.3.19.004" x-align="PRO.3.19.a004" x-target-ids="t004" x-target="founded" x-target-head="t004" x-head="true" lemma="יָסַד" strong="H3245" x-morph="Vqp3ms" x-gloss="he.founded" x-translit="yāsaḏ-" xml:lang="hbo">יָֽסַד</char>־<char style="w" x-id="WLC.PRO.3.19.005" x-align="PRO.3.19.a005" x-target-ids="t005 t006" x-target="the earth" x-target-head="t006" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[the].earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.PRO.3.19.006" x-align="PRO.3.19.a006" x-target-ids="t009 t010" x-target="he established" x-target-head="t010" x-head="true" lemma="כּוּן" strong="H3559" x-morph="Vop3ms" x-gloss="he.established" x-translit="kônēn" xml:lang="hbo">כּוֹנֵ֥ן</char> <char style="w" x-id="WLC.PRO.3.19.007" x-align="PRO.3.19.a007" x-target-ids="t011 t012" x-target="the heavens" x-target-head="t012" x-head="true" lemma="שָׁמַיִם" strong="H8064" x-morph="Ncmpa" x-gloss="[the].heavens" x-translit="šāmayim" xml:lang="hbo">שָׁ֝מַ֗יִם</char> <char style="w" x-id="WLC.PRO.3.19.008" x-align="PRO.3.19.a008" x-target-ids="t007" x-target="By" x-target-head="t007" x-head="true" lemma