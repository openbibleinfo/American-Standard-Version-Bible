	<para style="p"><verse number="14" style="v" x-ref="PRO.8.14" sid="PRO 8:14" /><char style="w" x-id="WLC.PRO.8.14.001" x-align="PRO.8.14.a001" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belong].to" x-translit="l" xml:lang="hbo">לִֽ</char><char style="w" x-id="WLC.PRO.8.14.002" x-align="PRO.8.14.a001" x-target-ids="t002 t003" x-target="is mine" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="iy-" xml:lang="hbo">י</char>־<char style="w" x-id="WLC.PRO.8.14.003" x-align="PRO.8.14.a002" x-target-ids="t001" x-target="Counsel" x-target-head="t001" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsa" x-gloss="counsel" x-translit="ʿēṣâ" xml:lang="hbo">עֵ֭צָה</char> <char style="w" x-id="WLC.PRO.8.14.004" x-align="PRO.8.14.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.8.14.005" x-align="PRO.8.14.a004" x-target-ids="t005 t006" x-target="sound knowledge" x-target-head="t006" x-head="true" lemma="תּוּשִׁיָּה" strong="H8454" x-morph="Ncfsa" x-gloss="sound.wisdom" x-translit="ṯûšiyyāh" xml:lang="hbo">תוּשִׁיָּ֑ה</char> <char style="w" x-id="WLC.PRO.8.14.006" x-align="PRO.8.14.a005" x-target-ids="t007" x-target="I" x-target-head="t007" x-head="true" lemma="אֲנִי" strong="H589" x-morph="Pp1cs" x-gloss="I" x-translit="ʾăniy" xml:lang="hbo">אֲנִ֥י</char> <char style="w" x-id="WLC.PRO.8.14.007" x-align="PRO.8.14.a006" x-target-ids="t008 t009" x-target="am understanding" x-target-head="t009" x-head="true" lemma="בִּינָה" strong="H998" x-morph="Ncfsa" x-gloss="[am].understanding" x-translit="ḇînāh" xml:lang="hbo">בִ֝ינָ֗ה</char> <char style="w" x-id="WLC.PRO.8.14.008" x-align="PRO.8.14.a007" x-target-ids="t011" x-target="have" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[belongs].to" x-translit="l" xml:lang="hbo">לִ֣</char><char s