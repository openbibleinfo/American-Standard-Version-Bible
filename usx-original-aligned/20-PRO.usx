	<para style="p"><verse number="31" style="v" x-ref="PRO.15.31" sid="PRO 15:31" /><char style="w" x-id="WLC.PRO.15.31.001" x-align="PRO.15.31.a001" x-target-ids="t001 t002" x-target="The ear" x-target-head="t002" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsa" x-gloss="an.ear" x-translit="ʾōzen" xml:lang="hbo">אֹ֗זֶן</char> <char style="w" x-id="WLC.PRO.15.31.002" x-align="PRO.15.31.a002" x-target-ids="t003 t004 t005" x-target="that hearkeneth to" x-target-head="t004" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqrfsc" x-gloss="[which].hears" x-translit="šōmaʿaṯ" xml:lang="hbo">שֹׁ֭מַעַת</char><char style="w" x-id="WLC.PRO.15.31.003" x-align="PRO.15.31.a003" x-target-ids="t006 t007" x-target="the reproof" x-target-head="t007" x-head="true" lemma="תּוֹכַחַת" strong="H8433a" x-morph="Ncfsc" x-gloss="correction" x-translit="tôḵaḥaṯ" xml:lang="hbo">תּוֹכַ֣חַת</char> <char style="w" x-id="WLC.PRO.15.31.004" x-align="PRO.15.31.a004" x-target-ids="t008 t009" x-target="of life" x-target-head="t009" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="of.life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.15.31.005" x-align="PRO.15.31.a006" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.15.31.006" x-align="PRO.15.31.a006" x-target-ids="t012" x-target="among" x-target-head="t012" x-head="true" lemma="קֶרֶב" strong="H7130" x-morph="Ncmsc" x-gloss="midst" x-translit="qereḇ" xml:lang="hbo">קֶ֖רֶב</char> <char style="w" x-id="WLC.PRO.15.31.007" x-align="PRO.15.31.a007" x-target-ids="t013 t014" x-target="the wise" x-target-head="t014" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="of.wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֣ים</char> <char style="w" x-id="WLC.PRO.15.31.008" x-align="PRO.15.31.a005" x-target-ids="t010 t011" x-target="Shall abide" x-target-head="t011" x-head="true" lemma="לין"