	<para style="p"><verse number="19" style="v" x-ref="PRO.24.19" sid="PRO 24:19" /><char style="w" x-id="WLC.PRO.24.19.001" x-align="PRO.24.19.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.24.19.002" x-align="PRO.24.19.a002" x-target-ids="t001 t003" x-target="Fret thyself" x-target-head="t001" x-head="true" lemma="חָרָה" strong="H2734" x-morph="Vtj2ms" x-gloss="fret.yourself" x-translit="tiṯḥar" xml:lang="hbo">תִּתְחַ֥ר</char> <char style="w" x-id="WLC.PRO.24.19.003" x-align="PRO.24.19.a003" x-target-ids="t004 t005" x-target="because of" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="by" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PRO.24.19.004" x-align="PRO.24.19.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.24.19.005" x-align="PRO.24.19.a005" x-target-ids="t006 t007" x-target="evil doers" x-target-head="t006" x-head="true" lemma="רָעַע" strong="H7489" x-morph="Vhrmpa" x-gloss="evil-doers" x-translit="mmərēʿiym" xml:lang="hbo">מְּרֵעִ֑ים</char> <char style="w" x-id="WLC.PRO.24.19.006" x-align="PRO.24.19.a006" x-target-ids="t008" x-target="Neither" x-target-head="t008" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.24.19.007" x-align="PRO.24.19.a007" x-target-ids="t009 t010 t011" x-target="be thou envious" x-target-head="t011" x-head="true" lemma="קָנָא" strong="H7065" x-morph="Vpj2ms" x-gloss="be.jealous" x-translit="təqannēʾ" xml:lang="hbo">תְּ֝קַנֵּ֗א</char> <char style="w" x-id="WLC.PRO.24.19.008" x-align="PRO.24.19.a008" x-target-ids="t012" x-target="at" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="