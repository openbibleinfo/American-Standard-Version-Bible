	<para style="p"><verse number="17" style="v" x-ref="PRO.3.17" sid="PRO 3:17" /><char style="w" x-id="WLC.PRO.3.17.001" x-align="PRO.3.17.a001" x-target-ids="t002" x-target="ways" x-target-head="t002" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="ways" x-translit="dərāḵey" xml:lang="hbo">דְּרָכֶ֥י</char><char style="w" x-id="WLC.PRO.3.17.002" x-align="PRO.3.17.a002" x-target-ids="t001" x-target="Her" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.3.17.003" x-align="PRO.3.17.a003" x-target-ids="t003 t004" x-target="are ways" x-target-head="t004" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="[are].ways" x-translit="ḏarḵê-" xml:lang="hbo">דַרְכֵי</char>־<char style="w" x-id="WLC.PRO.3.17.004" x-align="PRO.3.17.a004" x-target-ids="t005 t006" x-target="of pleasantness" x-target-head="t006" x-head="true" lemma="נֹעַם" strong="H5278" x-morph="Ncmsa" x-gloss="of.kindness" x-translit="nōʿam" xml:lang="hbo">נֹ֑עַם</char> <char style="w" x-id="WLC.PRO.3.17.005" x-align="PRO.3.17.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.3.17.006" x-align="PRO.3.17.a006" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.3.17.007" x-align="PRO.3.17.a007" x-target-ids="t010" x-target="paths" x-target-head="t010" x-head="true" lemma="נְתִיבָה" strong="H5410" x-morph="Ncbpc" x-gloss="pathways" x-translit="nəṯiyḇôṯey" xml:lang="hbo">נְתִ֖יבוֹתֶ֣י</char><char style="w" x-id="WLC.PRO.3.17.008" x-align="PRO.3.17.a008" x-target-ids="t009" x-target="her" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gl