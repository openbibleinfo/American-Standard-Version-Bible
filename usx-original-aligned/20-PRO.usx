	<para style="p"><verse number="10" style="v" x-ref="PRO.28.10" sid="PRO 28:10" /><char style="w" x-id="WLC.PRO.28.10.001" x-align="PRO.28.10.a001" x-target-ids="t001 t002 t005 t006 t007" x-target="Whoso causeth to go astray" x-target-head="t007" x-head="true" lemma="שָׁגָה" strong="H7686" x-morph="Vhrmsa" x-gloss="[one.who].leads.astray" x-translit="mašgeh" xml:lang="hbo">מַשְׁגֶּ֤ה</char> <char style="w" x-id="WLC.PRO.28.10.002" x-align="PRO.28.10.a002" x-target-ids="t003 t004" x-target="the upright" x-target-head="t004" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aampa" x-gloss="upright.[people]" x-translit="yəšāriym" xml:lang="hbo">יְשָׁרִ֨ים</char>׀<char style="w" x-id="WLC.PRO.28.10.003" x-align="PRO.28.10.a003" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.28.10.004" x-align="PRO.28.10.a004" x-target-ids="t009 t011" x-target="an way" x-target-head="t011" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="a.way" x-translit="ḏereḵ" xml:lang="hbo">דֶ֥רֶךְ</char> <char style="w" x-id="WLC.PRO.28.10.005" x-align="PRO.28.10.a005" x-target-ids="t010" x-target="evil" x-target-head="t010" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="evil" x-translit="rāʿ" xml:lang="hbo">רָ֗ע</char> <char style="w" x-id="WLC.PRO.28.10.006" x-align="PRO.28.10.a008" x-target-ids="t016" x-target="into" x-target-head="t016" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PRO.28.10.007" x-align="PRO.28.10.a010" x-target-ids="t019" x-target="pit" x-target-head="t019" x-head="true" lemma="שְׁחוּת" strong="H7816" x-morph="Ncfsc" x-gloss="his.own" x-translit="šəḥûṯ" xml:lang="hbo">שְׁחוּת֥</char><char style="w" x-id="WLC.PRO.28.10.008" x-align="PRO.28.10.a009" x-target-ids="t017 t018" x-target="his own" x-target-head="t017" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="pit" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.28.10.009" x-align="PRO.28.10.a006" x-target-ids="t012 t015" x-target="He himself" x-target-head="t012" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ-" xml:lang="hbo">הֽוּא</char>־<char style="w" x-id="WLC.PRO.28.10.010" x-align="PRO.28.10.a007" x-target-ids="t013 t014" x-target="shall fall" x-target-head="t014" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="he.will.fall" x-translit="yipôl" xml:lang="hbo">יִפּ֑וֹל</char> <char style="w" x-id="WLC.PRO.28.10.011" x-align="PRO.28.10.a011" x-target-ids="t020" x-target="But" x-target-head="t020" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.28.10.012" x-align="PRO.28.10.a012" x-target-ids="t021 t022" x-target="the perfect" x-target-head="t022" x-head="true" lemma="תָּמִים" strong="H8549" x-morph="Aampa" x-gloss="blameless.[people]" x-translit="ṯəmîmiym" xml:lang="hbo">תְמִימִ֗ים</char> <char style="w" x-id="WLC.PRO.28.10.013" x-align="PRO.28.10.a013" x-target-ids="t023 t024" x-target="shall inherit" x-target-head="t024" x-head="true" lemma="נָחַל" strong="H5157" x-morph="Vqi3mp" x-gloss="they.will.inherit" x-translit="yinḥălû-" xml:lang="hbo">יִנְחֲלוּ</char>־<char style="w" x-id="WLC.PRO.28.10.014" x-align="PRO.28.10.a014" x-target-ids="t025" x-target="good" x-target-head="t025" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ:" xml:lang="hbo">טֽוֹב</char>׃<verse eid="PRO 28:10" /></para>
	<para style="p"><verse number="11" style="v" x-ref="PRO.28.11" sid="PRO 28:11" /><char style="w" x-id="WLC.PRO.28.11.001" x-align="PRO.28.11.a003" x-target-ids="t004 t005" x-target="is wise" x-target-head="t005" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="[is].wise" x-translit="ḥāḵām" xml:lang="hbo">חָכָ֣ם</char> <char style="w" x-id="WLC.PRO.28.11.002" x-align="PRO.28.11.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.28.11.003" x-align="PRO.28.11.a006" x-target-ids="t009" x-target="conceit" x-target-head="t009" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="his.own" x-translit="ʿēynāy" xml:lang="hbo">עֵינָי</char><char style="w" x-id="WLC.PRO.28.11.004" x-align="PRO.28.11.a005" x-target-ids="t007 t008" x-target="his own" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="eyes" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.28.11.005" x-align="PRO.28.11.a001" x-target-ids="t001 t003" x-target="The man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.28.11.006" x-align="PRO.28.11.a002" x-target-ids="t002" x-target="rich" x-target-head="t002" x-head="true" lemma="עָשִׁיר" strong="H6223" x-morph="Aamsa" x-gloss="rich" x-translit="ʿāšiyr" xml:lang="hbo">עָשִׁ֑יר</char> <char style="w" x-id="WLC.PRO.28.11.007" x-align="PRO.28.11.a007" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.11.008" x-align="PRO.28.11.a008" x-target-ids="t011 t012" x-target="the poor" x-target-head="t012" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="a.poor.[person]" x-translit="ḏal" xml:lang="hbo">דַ֖ל</char> <char style="w" x-id="WLC.PRO.28.11.009" x-align="PRO.28.11.a009" x-target-ids="t013 t014 t015" x-target="that hath understanding" x-target-head="t015" x-head="true" lemma="בִּין" strong="H995" x-morph="Vhrmsa" x-gloss="[who].has.understanding" x-translit="mēḇiyn" xml:lang="hbo">מֵבִ֣ין</char> <char style="w" x-id="WLC.PRO.28.11.010" x-align="PRO.28.11.a010" x-target-ids="t016 t018" x-target="searcheth out" x-target-head="t016" x-head="true" lemma="חָקַר" strong="H2713" x-morph="Vqi3ms" x-gloss="he" x-translit="yaḥqər" xml:lang="hbo">יַחְקְרֶֽ</char><char style="w" x-id="WLC.PRO.28.11.011" x-align="PRO.28.11.a011" x-target-ids="t017" x-target="him" x-target-head="t017" x-head="true" lemma="הוּא" strong="H5105b" x-morph="Sp3ms" x-gloss="examines.him.thoroughly" x-translit="ennû" xml:lang="hbo">נּוּ</char>׃<verse eid="PRO 28:11" /></para>
	<para style="p"><verse number="12" style="v" x-ref="PRO.28.12" sid="PRO 28:12" /><char style="w" x-id="WLC.PRO.28.12.001" x-align="PRO.28.12.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PRO.28.12.002" x-align="PRO.28.12.a003" x-target-ids="t004" x-target="triumph" x-target-head="t004" x-head="true" lemma="עָלַץ" strong="H5970" x-morph="Vqc" x-gloss="rejoice" x-translit="ʿălōṣ" xml:lang="hbo">עֲלֹ֣ץ</char> <char style="w" x-id="WLC.PRO.28.12.003" x-align="PRO.28.12.a002" x-target-ids="t002 t003" x-target="the righteous" x-target-head="t003" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="righteous.[people]" x-translit="ṣaddîqîm" xml:lang="hbo">צַ֭דִּיקִים</char> <char style="w" x-id="WLC.PRO.28.12.004" x-align="PRO.28.12.a004" x-target-ids="t005 t006 t007" x-target="there is great" x-target-head="t007" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafsa" x-gloss="great" x-translit="rabbāh" xml:lang="hbo">רַבָּ֣ה</char> <char style="w" x-id="WLC.PRO.28.12.005" x-align="PRO.28.12.a005" x-target-ids="t008" x-target="glory" x-target-head="t008" x-head="true" lemma="תִּפְאֶרֶת" strong="H8597" x-morph="Ncfsa" x-gloss="glory" x-translit="ṯip̄ʾāreṯ" xml:lang="hbo">תִפְאָ֑רֶת</char> <char style="w" x-id="WLC.PRO.28.12.006" x-align="PRO.28.12.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.28.12.007" x-align="PRO.28.12.a007" x-target-ids="t010" x-target="when" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.28.12.008" x-align="PRO.28.12.a009" x-target-ids="t013" x-target="rise" x-target-head="t013" x-head="true" lemma="קוּם" strong="H6965" x-mo