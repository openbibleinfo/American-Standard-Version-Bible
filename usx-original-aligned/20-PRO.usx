	<para style="p"><verse number="13" style="v" x-ref="PRO.21.13" sid="PRO 21:13" /><char style="w" x-id="WLC.PRO.21.13.001" x-align="PRO.21.13.a001" x-target-ids="t001 t002" x-target="Whoso stoppeth" x-target-head="t002" x-head="true" lemma="אָטַם" strong="H331" x-morph="Vqrmsa" x-gloss="[one.who].shuts" x-translit="ʾōṭēm" xml:lang="hbo">אֹטֵ֣ם</char> <char style="w" x-id="WLC.PRO.21.13.002" x-align="PRO.21.13.a002" x-target-ids="t004" x-target="ears" x-target-head="t004" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsc" x-gloss="ear" x-translit="ʾāzən" xml:lang="hbo">אָ֭זְנ</char><char style="w" x-id="WLC.PRO.21.13.003" x-align="PRO.21.13.a003" x-target-ids="t003" x-target="his" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.21.13.004" x-align="PRO.21.13.a004" x-target-ids="t005" x-target="at" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.21.13.005" x-align="PRO.21.13.a005" x-target-ids="t006 t007" x-target="the cry" x-target-head="t007" x-head="true" lemma="זְעָקָה" strong="H2201" x-morph="Ncfsc" x-gloss="cry" x-translit="zzaʿăqaṯ-" xml:lang="hbo">זַּעֲקַת</char>־<char style="w" x-id="WLC.PRO.21.13.006" x-align="PRO.21.13.a006" x-target-ids="t008 t009 t010" x-target="of the poor" x-target-head="t010" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="of.[the].poor" x-translit="dāl" xml:lang="hbo">דָּ֑ל</char> <char style="w" x-id="WLC.PRO.21.13.007" x-align="PRO.21.13.a007" x-target-ids="t012" x-target="also" x-target-head="t012" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּֽם</char>־<char style="w" x-id="WLC.PRO.21.13.008" x-align="PRO.21.13.a008" x-target-ids="t011" x-target="He" x-target-head="t011" x-head="true" lemma="הוּא" strong="H1931" x-morp