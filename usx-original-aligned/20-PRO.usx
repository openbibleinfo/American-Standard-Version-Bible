	<para style="p"><verse number="23" style="v" x-ref="PRO.8.23" sid="PRO 8:23" /><char style="w" x-id="WLC.PRO.8.23.001" x-align="PRO.8.23.a001" x-target-ids="t005" x-target="from" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ֭</char><char style="w" x-id="WLC.PRO.8.23.002" x-align="PRO.8.23.a002" x-target-ids="t006" x-target="everlasting" x-target-head="t006" x-head="true" lemma="עוֹלָם" strong="H5769" x-morph="Ncmsa" x-gloss="long.ago" x-translit="ʿôlām" xml:lang="hbo">עוֹלָם</char> <char style="w" x-id="WLC.PRO.8.23.003" x-align="PRO.8.23.a003" x-target-ids="t001 t002 t003 t004" x-target="I was set up" x-target-head="t003" x-head="true" lemma="נָסַךְ" strong="H5258" x-morph="VNp1cs" x-gloss="I.was.installed" x-translit="nissaḵətî" xml:lang="hbo">נִסַּ֥כְתִּי</char> <char style="w" x-id="WLC.PRO.8.23.004" x-align="PRO.8.23.a004" x-target-ids="t007" x-target="from" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.8.23.005" x-align="PRO.8.23.a005" x-target-ids="t008 t009" x-target="the beginning" x-target-head="t009" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsa" x-gloss="beginning" x-translit="rōʾš" xml:lang="hbo">רֹ֗אשׁ</char> <char style="w" x-id="WLC.PRO.8.23.006" x-align="PRO.8.23.a006" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.8.23.007" x-align="PRO.8.23.a006" x-target-ids="t010 t013" x-target="Before was" x-target-head="t010" x-head="true" lemma="קֶדֶם" strong="H6924" x-morph="Ncmpc" x-gloss="beginnings" x-translit="qqaḏmê-" xml:lang="hbo">קַּדְמֵי</char>־<char style="w" x-id="WLC.PRO.8.23.008" x-align="PRO.8.23.a007" x-target-ids="t011 t012" x-target="the earth" x-target-head="t012" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.[the].earth" x-transl