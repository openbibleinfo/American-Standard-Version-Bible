	<para style="p"><verse number="7" style="v" x-ref="PRO.10.7" sid="PRO 10:7" /><char style="w" x-id="WLC.PRO.10.7.001" x-align="PRO.10.7.a001" x-target-ids="t001 t002" x-target="The memory" x-target-head="t002" x-head="true" lemma="זֵכֶר" strong="H2143" x-morph="Ncmsc" x-gloss="[the].memorial" x-translit="zēḵer" xml:lang="hbo">זֵ֣כֶר</char> <char style="w" x-id="WLC.PRO.10.7.002" x-align="PRO.10.7.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddîq" xml:lang="hbo">צַ֭דִּיק</char> <char style="w" x-id="WLC.PRO.10.7.003" x-align="PRO.10.7.a003" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].for" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.10.7.004" x-align="PRO.10.7.a003" x-target-ids="t006 t007" x-target="is blessed" x-target-head="t007" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfsa" x-gloss="a.blessing" x-translit="ḇərāḵāh" xml:lang="hbo">בְרָכָ֑ה</char> <char style="w" x-id="WLC.PRO.10.7.005" x-align="PRO.10.7.a004" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.10.7.006" x-align="PRO.10.7.a005" x-target-ids="t009 t010" x-target="the name" x-target-head="t010" x-head="true" lemma="שֵׁם" strong="H8034" x-morph="Ncmsc" x-gloss="name" x-translit="šēm" xml:lang="hbo">שֵׁ֖ם</char> <char style="w" x-id="WLC.PRO.10.7.007" x-align="PRO.10.7.a006" x-target-ids="t011 t012 t013" x-target="of the wicked" x-target-head="t013" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.10.7.008" x-align="PRO.10.7.a007" x-target-ids="t014 t015" x-target="shall rot" x-target-head="t015" x-head="true" lemma="רָקֵב" strong="H7537" x-mor