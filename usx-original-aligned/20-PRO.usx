	<para style="p"><verse number="31" style="v" x-ref="PRO.1.31" sid="PRO 1:31" /><char style="w" x-id="WLC.PRO.1.31.001" x-align="PRO.1.31.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ֭</char><char style="w" x-id="WLC.PRO.1.31.002" x-align="PRO.1.31.a002" x-target-ids="t002 t003 t004" x-target="shall they eat" x-target-head="t004" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqi3mp" x-gloss="they.will.eat" x-translit="yōʾḵəlû" xml:lang="hbo">יֹאכְלוּ</char> <char style="w" x-id="WLC.PRO.1.31.003" x-align="PRO.1.31.a003" x-target-ids="t005" x-target="of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.1.31.004" x-align="PRO.1.31.a004" x-target-ids="t006 t007" x-target="the fruit" x-target-head="t007" x-head="true" lemma="פְּרִי" strong="H6529" x-morph="Ncmsc" x-gloss="the.fruit" x-translit="pəriy" xml:lang="hbo">פְּרִ֣י</char> <char style="w" x-id="WLC.PRO.1.31.005" x-align="PRO.1.31.a005" x-target-ids="t008 t011" x-target="of way" x-target-head="t011" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="their.way" x-translit="ḏark" xml:lang="hbo">דַרְכָּ֑</char><char style="w" x-id="WLC.PRO.1.31.006" x-align="PRO.1.31.a006" x-target-ids="t009 t010" x-target="their own" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PRO.1.31.007" x-align="PRO.1.31.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.PRO.1.31.008" x-align="PRO.1.31.a009" x-target-ids="t015" x-target="with" x-target-head="t015" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-t