	<para style="p"><verse number="28" style="v" x-ref="PRO.21.28" sid="PRO 21:28" /><char style="w" x-id="WLC.PRO.21.28.001" x-align="PRO.21.28.a001" x-target-ids="t001 t003" x-target="A witness" x-target-head="t003" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsc" x-gloss="a.witness" x-translit="ʿēḏ-" xml:lang="hbo">עֵד</char>־<char style="w" x-id="WLC.PRO.21.28.002" x-align="PRO.21.28.a002" x-target-ids="t002" x-target="false" x-target-head="t002" x-head="true" lemma="כָּזָב" strong="H3577" x-morph="Ncmpa" x-gloss="of.lies" x-translit="kəzāḇiym" xml:lang="hbo">כְּזָבִ֥ים</char> <char style="w" x-id="WLC.PRO.21.28.003" x-align="PRO.21.28.a003" x-target-ids="t004 t005" x-target="shall perish" x-target-head="t005" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqi3ms" x-gloss="he.will.perish" x-translit="yōʾḇēḏ" xml:lang="hbo">יֹאבֵ֑ד</char> <char style="w" x-id="WLC.PRO.21.28.004" x-align="PRO.21.28.a004" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.21.28.005" x-align="PRO.21.28.a005" x-target-ids="t007 t008" x-target="the man" x-target-head="t008" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֥ישׁ</char> <char style="w" x-id="WLC.PRO.21.28.006" x-align="PRO.21.28.a006" x-target-ids="t009 t010" x-target="that heareth" x-target-head="t010" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqrmsa" x-gloss="[who].listens" x-translit="šômēᵃʿ" xml:lang="hbo">שׁ֝וֹמֵ֗עַ</char> <char style="w" x-id="WLC.PRO.21.28.007" x-align="PRO.21.28.a008" x-target-ids="t013 t014 t015" x-target="so as to" x-target-head="t015" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.21.28.008" x-align="PRO.21.28.a009" x-target-ids="t016" x-target="endure" x-target-head="t016" x-head="true"