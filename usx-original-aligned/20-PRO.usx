	<para style="p"><verse number="4" style="v" x-ref="PRO.20.4" sid="PRO 20:4" /><char style="w" x-id="WLC.PRO.20.4.001" x-align="PRO.20.4.a004" x-target-ids="t006 t007 t008" x-target="by reason of" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ֭</char><char style="w" x-id="WLC.PRO.20.4.002" x-align="PRO.20.4.a005" x-target-ids="t009 t010" x-target="the winter" x-target-head="t010" x-head="true" lemma="חֹרֶף" strong="H2779" x-morph="Ncmsa" x-gloss="winter" x-translit="ḥōrep̄" xml:lang="hbo">חֹרֶף</char> <char style="w" x-id="WLC.PRO.20.4.003" x-align="PRO.20.4.a001" x-target-ids="t001 t002" x-target="The sluggard" x-target-head="t002" x-head="true" lemma="עָצֵל" strong="H6102" x-morph="Aamsa" x-gloss="a.sluggard" x-translit="ʿāṣēl" xml:lang="hbo">עָצֵ֣ל</char> <char style="w" x-id="WLC.PRO.20.4.004" x-align="PRO.20.4.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.20.4.005" x-align="PRO.20.4.a003" x-target-ids="t003 t005" x-target="will plow" x-target-head="t005" x-head="true" lemma="חָרַשׁ" strong="H2790" x-morph="Vqi3ms" x-gloss="he.plows" x-translit="yaḥărōš" xml:lang="hbo">יַחֲרֹ֑שׁ</char> <char style="w" x-id="WLC.PRO.20.4.006" x-align="PRO.20.4.a006" x-target-ids="t011" x-target="Therefore" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.20.4.007" x-align="PRO.20.4.a007" x-target-ids="t012 t013 t014" x-target="he shall beg" x-target-head="t014" x-head="true" lemma="שָׁאַל" strong="H7592" x-morph="Vqq3ms" x-gloss="he.asks" x-translit="**šāʾal" xml:lang="hbo">שָׁאַ֖ל</char> <char style="w" x-id="WLC.PRO.20.4.008" x-align="PRO.20.4.a008" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma="בְּ" strong="H8