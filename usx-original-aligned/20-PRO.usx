	<para style="p"><verse number="1" style="v" x-ref="PRO.17.1" sid="PRO 17:1" /><char style="w" x-id="WLC.PRO.17.1.001" x-align="PRO.17.1.a001" x-target-ids="t001 t002" x-target="Better is" x-target-head="t001" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֤וֹב</char> <char style="w" x-id="WLC.PRO.17.1.002" x-align="PRO.17.1.a002" x-target-ids="t003 t005" x-target="a morsel" x-target-head="t005" x-head="true" lemma="פַּת" strong="H6595" x-morph="Ncfsa" x-gloss="a.piece.[of.bread]" x-translit="paṯ" xml:lang="hbo">פַּ֣ת</char> <char style="w" x-id="WLC.PRO.17.1.003" x-align="PRO.17.1.a003" x-target-ids="t004" x-target="dry" x-target-head="t004" x-head="true" lemma="חָרֵב" strong="H2720" x-morph="Aafsa" x-gloss="dry" x-translit="ḥărēḇâ" xml:lang="hbo">חֲ֭רֵבָה</char> <char style="w" x-id="WLC.PRO.17.1.004" x-align="PRO.17.1.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.17.1.005" x-align="PRO.17.1.a005" x-target-ids="t007" x-target="quietness" x-target-head="t007" x-head="true" lemma="שַׁלְוָה" strong="H7962" x-morph="Ncfsa" x-gloss="security" x-translit="šalwâ-" xml:lang="hbo">שַׁלְוָה</char>־<char style="w" x-id="WLC.PRO.17.1.006" x-align="PRO.17.1.a006" x-target-ids="t008" x-target="therewith" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].with" x-translit="ḇ" xml:lang="hbo">בָ֑</char><char style="w" x-id="WLC.PRO.17.1.007" x-align="PRO.17.1.a006" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="it" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.17.1.008" x-align="PRO.17.1.a007" x-target-ids="t009" x-target="Than" x-target-head="t009" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִ֝</char><char style="w" x-id="WLC.PRO.17.1.009" x-a