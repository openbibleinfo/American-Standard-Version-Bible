	<para style="p"><verse number="3" style="v" x-ref="PRO.30.3" sid="PRO 30:3" /><char style="w" x-id="WLC.PRO.30.3.001" x-align="PRO.30.3.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.30.3.002" x-align="PRO.30.3.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.30.3.003" x-align="PRO.30.3.a003" x-target-ids="t002 t003 t005" x-target="I have learned" x-target-head="t005" x-head="true" lemma="לָמַד" strong="H3925" x-morph="Vqp1cs" x-gloss="I.have.learned" x-translit="lāmaḏətî" xml:lang="hbo">לָמַ֥דְתִּי</char> <char style="w" x-id="WLC.PRO.30.3.004" x-align="PRO.30.3.a004" x-target-ids="t006" x-target="wisdom" x-target-head="t006" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.30.3.005" x-align="PRO.30.3.a005" x-target-ids="t007" x-target="Neither" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.30.3.006" x-align="PRO.30.3.a006" x-target-ids="t010 t011" x-target="the knowledge" x-target-head="t011" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsc" x-gloss="knowledge" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֖עַת</char> <char style="w" x-id="WLC.PRO.30.3.007" x-align="PRO.30.3.a007" x-target-ids="t012 t013 t014 t015" x-target="of the Holy One" x-target-head="t014" x-head="true" lemma="קָדוֹשׁ" strong="H6918" x-morph="Aampa" x-gloss="of.[the].holy.[one(s)]" x-translit="qəḏōšiym" xml:lang="hbo">קְדֹשִׁ֣ים</char> <char style="w" x-id="WLC.PRO.30.3.008" x-align="PRO.30.3.a008" x-target-ids="t008 t009" x-target="have I" x-target-head="t008" x-head="t