	<para style="p"><verse number="8" style="v" x-ref="PRO.19.8" sid="PRO 19:8" /><char style="w" x-id="WLC.PRO.19.8.001" x-align="PRO.19.8.a001" x-target-ids="t001 t002 t003" x-target="He that getteth" x-target-head="t003" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqrmsa" x-gloss="[one.who].acquires" x-translit="qōneh-" xml:lang="hbo">קֹֽנֶה</char>־<char style="w" x-id="WLC.PRO.19.8.002" x-align="PRO.19.8.a002" x-target-ids="t004" x-target="wisdom" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="heart" x-translit="llēḇ" xml:lang="hbo">לֵּ֭ב</char> <char style="w" x-id="WLC.PRO.19.8.003" x-align="PRO.19.8.a003" x-target-ids="t005" x-target="loveth" x-target-head="t005" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[is].loving" x-translit="ʾōhēḇ" xml:lang="hbo">אֹהֵ֣ב</char> <char style="w" x-id="WLC.PRO.19.8.004" x-align="PRO.19.8.a004" x-target-ids="t008" x-target="soul" x-target-head="t008" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַפְשׁ֑</char><char style="w" x-id="WLC.PRO.19.8.005" x-align="PRO.19.8.a005" x-target-ids="t006 t007" x-target="his own" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.own" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.19.8.006" x-align="PRO.19.8.a006" x-target-ids="t009 t010 t011" x-target="He that keepeth" x-target-head="t011" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[one.who].keeps" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֥ר</char> <char style="w" x-id="WLC.PRO.19.8.007" x-align="PRO.19.8.a007" x-target-ids="t012" x-target="understanding" x-target-head="t012" x-head="true" lemma="תְּבוּנָה" strong="H8394" x-morph="Ncfsa" x-gloss="understanding" x-translit="təḇûnāh" xml:lang="hbo">תְּ֝בוּנָ֗ה</char> <char style="w" x-id="WLC.PRO.19.8.008" x-align="PRO.19.8.a008" x-status="unrepresented" x-head="true" lemm