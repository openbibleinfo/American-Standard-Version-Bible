	<para style="p"><verse number="14" style="v" x-ref="PRO.24.14" x-added-alignments="PRO.24.14.a018" x-added-target-ids="t015" x-added-target="it" sid="PRO 24:14" /><char style="w" x-id="WLC.PRO.24.14.001" x-align="PRO.24.14.a001" x-target-ids="t001" x-target="So" x-target-head="t001" x-head="true" lemma="כֵּן" strong="H3651" x-morph="Tm" x-gloss="thus" x-translit="kēn" xml:lang="hbo">כֵּ֤ן</char>׀<char style="w" x-id="WLC.PRO.24.14.002" x-align="PRO.24.14.a002" x-target-ids="t002 t003 t004" x-target="shalt thou know" x-target-head="t004" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqv2ms" x-gloss="know" x-translit="dəʿ" xml:lang="hbo">דְּעֶ֥</char><char style="w" x-id="WLC.PRO.24.14.003" x-align="PRO.24.14.a003" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="eh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PRO.24.14.004" x-align="PRO.24.14.a004" x-target-ids="t005" x-target="wisdom" x-target-head="t005" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֗ה</char> <char style="w" x-id="WLC.PRO.24.14.005" x-align="PRO.24.14.a005" x-target-ids="t006 t007 t008" x-target="to be unto" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.24.14.006" x-align="PRO.24.14.a006" x-target-ids="t010" x-target="soul" x-target-head="t010" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="self" x-translit="nap̄š" xml:lang="hbo">נַ֫פְשֶׁ֥</char><char style="w" x-id="WLC.PRO.24.14.007" x-align="PRO.24.14.a007" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.24.14.008" x-align="PRO.24.14.a008" x-target-ids="t011" x-target="If" x-target-head="t011" x-head="true" lemma="אִם" strong="H518" x-mor