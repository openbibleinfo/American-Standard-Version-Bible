	<para style="p"><verse number="19" style="v" x-ref="PRO.28.19" sid="PRO 28:19" /><char style="w" x-id="WLC.PRO.28.19.001" x-align="PRO.28.19.a001" x-target-ids="t001 t002 t003" x-target="He that tilleth" x-target-head="t003" x-head="true" lemma="עָבַד" strong="H5647" x-morph="Vqrmsc" x-gloss="[one.who].tills" x-translit="ʿōḇēḏ" xml:lang="hbo">עֹבֵ֣ד</char> <char style="w" x-id="WLC.PRO.28.19.002" x-align="PRO.28.19.a003" x-target-ids="t005" x-target="land" x-target-head="t005" x-head="true" lemma="אֲדָמָה" strong="H127" x-morph="Ncfsc" x-gloss="land" x-translit="ʾaḏmāṯ" xml:lang="hbo">אַ֭דְמָת</char><char style="w" x-id="WLC.PRO.28.19.003" x-align="PRO.28.19.a002" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.28.19.004" x-align="PRO.28.19.a004" x-target-ids="t006 t007 t008 t009" x-target="shall have plenty of" x-target-head="t008" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqi3ms" x-gloss="he.will.be.satisfied" x-translit="yiśəbaʿ-" xml:lang="hbo">יִֽשְׂבַּֽע</char>־<char style="w" x-id="WLC.PRO.28.19.005" x-align="PRO.28.19.a005" x-target-ids="t010" x-target="bread" x-target-head="t010" x-head="true" lemma="לֶחֶם" strong="H3899" x-morph="Ncbsa" x-gloss="food" x-translit="lāḥem" xml:lang="hbo">לָ֑חֶם</char> <char style="w" x-id="WLC.PRO.28.19.006" x-align="PRO.28.19.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.28.19.007" x-align="PRO.28.19.a007" x-target-ids="t012 t013 t014 t015" x-target="he that followeth after" x-target-head="t014" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vprmsa" x-gloss="[one.who].pursues" x-translit="məraddēp̄" xml:lang="hbo">מְרַדֵּ֥ף</char> <char style="w" x-id="WLC.PRO.28.19.008" x-align="PRO.28.19.a008" x-target-ids="