	<para style="p"><verse number="17" style="v" x-ref="PRO.9.17" x-added-alignments="PRO.9.17.a006" x-added-target-ids="t007" x-added-target="eaten" sid="PRO 9:17" /><char style="w" x-id="WLC.PRO.9.17.001" x-align="PRO.9.17.a001" x-target-ids="t002" x-target="waters" x-target-head="t002" x-head="true" lemma="מַיִם" strong="H4325" x-morph="Ncmpa" x-gloss="waters" x-translit="mayim-" xml:lang="hbo">מַֽיִם</char>־<char style="w" x-id="WLC.PRO.9.17.002" x-align="PRO.9.17.a002" x-target-ids="t001" x-target="Stolen" x-target-head="t001" x-head="true" lemma="גָּנַב" strong="H1589" x-morph="Vqsmpa" x-gloss="stolen" x-translit="gənûḇiym" xml:lang="hbo">גְּנוּבִ֥ים</char> <char style="w" x-id="WLC.PRO.9.17.003" x-align="PRO.9.17.a003" x-target-ids="t003 t004" x-target="are sweet" x-target-head="t004" x-head="true" lemma="מָתֹק" strong="H4985" x-morph="Vqi3mp" x-gloss="they.are.sweet" x-translit="yimtāqû" xml:lang="hbo">יִמְתָּ֑קוּ</char> <char style="w" x-id="WLC.PRO.9.17.004" x-align="PRO.9.17.a004" x-target-ids="t005" x-target="And" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.9.17.005" x-align="PRO.9.17.a005" x-target-ids="t006" x-target="bread" x-target-head="t006" x-head="true" lemma="לֶחֶם" strong="H3899" x-morph="Ncbsc" x-gloss="bread" x-translit="leḥem" xml:lang="hbo">לֶ֖חֶם</char> <char style="w" x-id="WLC.PRO.9.17.006" x-align="PRO.9.17.a007" x-target-ids="t008 t009" x-target="in secret" x-target-head="t009" x-head="true" lemma="סֵתֶר" strong="H5643" x-morph="Ncmpa" x-gloss="of.secret.places" x-translit="səṯāriym" xml:lang="hbo">סְתָרִ֣ים</char> <char style="w" x-id="WLC.PRO.9.17.007" x-align="PRO.9.17.a008" x-target-ids="t010 t011" x-target="is pleasant" x-target-head="t011" x-head="true" lemma="נָעֵם" strong="H5276" x-morph="Vqi3ms" x-gloss="it.is.pleasant" x-translit="yinʿām:" xml:lang="hbo">יִנְעָֽם</char>׃<verse eid="PRO 9:17" /></para>
	<para style="p"><verse number="18" style="v" x-ref="PRO.9.18" sid="PRO 9:18" /><char style="w" x-id="WLC.PRO.9.18.001" x-align="PRO.9.18.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.9.18.002" x-align="PRO.9.18.a002" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.9.18.003" x-align="PRO.9.18.a003" x-target-ids="t002 t003" x-target="he knoweth" x-target-head="t003" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3ms" x-gloss="he.knows" x-translit="yāḏaʿ" xml:lang="hbo">יָ֭דַע</char> <char style="w" x-id="WLC.PRO.9.18.004" x-align="PRO.9.18.a004" x-target-ids="t005 t010" x-target="that That" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm).that" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.9.18.005" x-align="PRO.9.18.a005" x-target-ids="t006 t007" x-target="the dead" x-target-head="t007" x-head="true" lemma="רְפָאִים" strong="H7496" x-morph="Ncmpa" x-gloss="[the].shades" x-translit="rəp̄āʾiym" xml:lang="hbo">רְפָאִ֣ים</char> <char style="w" x-id="WLC.PRO.9.18.006" x-align="PRO.9.18.a006" x-target-ids="t008 t009" x-target="are there" x-target-head="t009" x-head="true" lemma="שָׁם" strong="H8033" x-morph="D" x-gloss="[are].there" x-translit="šām" xml:lang="hbo">שָׁ֑ם</char> <char style="w" x-id="WLC.PRO.9.18.007" x-align="PRO.9.18.a007" x-target-ids="t013 t014" x-target="are in" x-target-head="t014" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.9.18.008" x-align="PRO.9.18.a008" x-target-ids="t015 t016" x-target="the depths" x-target-head="t016" x-head="true" lemma="עָמֵק" strong="H6011" x-morph="Ncm