	<para style="p"><verse number="14" style="v" x-ref="PRO.7.14" sid="PRO 7:14" /><char style="w" x-id="WLC.PRO.7.14.001" x-align="PRO.7.14.a001" x-target-ids="t001" x-target="Sacrifices" x-target-head="t001" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmpc" x-gloss="sacrifices" x-translit="ziḇḥēy" xml:lang="hbo">זִבְחֵ֣י</char> <char style="w" x-id="WLC.PRO.7.14.002" x-align="PRO.7.14.a002" x-target-ids="t002 t003 t004" x-target="of peace offerings" x-target-head="t003" x-head="true" lemma="שֶׁלֶם" strong="H8002" x-morph="Ncmpa" x-gloss="of.peace.offerings" x-translit="šəlāmiym" xml:lang="hbo">שְׁלָמִ֣ים</char> <char style="w" x-id="WLC.PRO.7.14.003" x-align="PRO.7.14.a003" x-target-ids="t005 t006" x-target="are with" x-target-head="t006" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="[are].on" x-translit="ʿāl" xml:lang="hbo">עָלָ֑</char><char style="w" x-id="WLC.PRO.7.14.004" x-align="PRO.7.14.a004" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="āy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.7.14.005" x-align="PRO.7.14.a005" x-target-ids="t008" x-target="This" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="this" x-translit="ha" xml:lang="hbo">הַ֝</char><char style="w" x-id="WLC.PRO.7.14.006" x-align="PRO.7.14.a006" x-target-ids="t009" x-target="day" x-target-head="t009" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּ֗וֹם</char> <char style="w" x-id="WLC.PRO.7.14.007" x-align="PRO.7.14.a007" x-target-ids="t010 t011 t012" x-target="have I paid" x-target-head="t012" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="Vpp1cs" x-gloss="I.have.paid" x-translit="šillamətî" xml:lang="hbo">שִׁלַּ֥מְתִּי</char> <char style="w" x-id="WLC.PRO.7.14.008" x-align="PRO.7.14.a008" x-target-ids="t014" x-target="vows" x-target-head="t014" x-head="true" lemma="נֶדֶ