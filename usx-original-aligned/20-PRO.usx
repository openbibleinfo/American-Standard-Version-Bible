	<para style="p"><verse number="22" style="v" x-ref="PRO.13.22" x-added-alignments="PRO.13.22.a004" x-added-target-ids="t008" x-added-target="his" sid="PRO 13:22" /><char style="w" x-id="WLC.PRO.13.22.001" x-align="PRO.13.22.a001" x-target-ids="t001 t002 t003" x-target="A good man" x-target-head="t002" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="a.good.[person]" x-translit="ṭôḇ" xml:lang="hbo">ט֗וֹב</char> <char style="w" x-id="WLC.PRO.13.22.002" x-align="PRO.13.22.a002" x-target-ids="t004 t005 t006 t007" x-target="leaveth an inheritance to" x-target-head="t006" x-head="true" lemma="נָחַל" strong="H5157" x-morph="Vhi3ms" x-gloss="he.leaves.an.inheritance.to" x-translit="yanḥiyl" xml:lang="hbo">יַנְחִ֥יל</char> <char style="w" x-id="WLC.PRO.13.22.003" x-align="PRO.13.22.a003" x-target-ids="t010" x-target="children" x-target-head="t010" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpc" x-gloss="children" x-translit="bənēy-" xml:lang="hbo">בְּנֵֽי</char>־<char style="w" x-id="WLC.PRO.13.22.004" x-align="PRO.13.22.a005" x-target-ids="t009" x-target="children’s" x-target-head="t009" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmpa" x-gloss="of.children" x-translit="ḇāniym" xml:lang="hbo">בָנִ֑ים</char> <char style="w" x-id="WLC.PRO.13.22.005" x-align="PRO.13.22.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.22.006" x-align="PRO.13.22.a009" x-target-ids="t017 t018 t019" x-target="is laid up" x-target-head="t018" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqsmsa" x-gloss="stored.up" x-translit="ṣāp̄ûn" xml:lang="hbo">צָפ֥וּן</char> <char style="w" x-id="WLC.PRO.13.22.007" x-align="PRO.13.22.a010" x-target-ids="t020" x-target="for" x-target-head="t020" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo">לַ֝</char><char styl