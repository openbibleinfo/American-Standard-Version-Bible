	<para style="p"><verse number="22" style="v" x-ref="PRO.5.22" sid="PRO 5:22" /><char style="w" x-id="WLC.PRO.5.22.001" x-align="PRO.5.22.a002" x-target-ids="t003" x-target="iniquities" x-target-head="t003" x-head="true" lemma="עָוֺן" strong="H5771" x-morph="Ncbpc" x-gloss="iniquities" x-translit="ʿawônôṯāy" xml:lang="hbo">עַֽווֹנוֹתָ֗י</char><char style="w" x-id="WLC.PRO.5.22.002" x-align="PRO.5.22.a001" x-target-ids="t001 t002" x-target="His own" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char><char style="w" x-id="WLC.PRO.5.22.003" x-align="PRO.5.22.a003" x-target-ids="t004 t005" x-target="shall take" x-target-head="t005" x-head="true" lemma="לָכַד" strong="H3920" x-morph="Vqi3mp" x-gloss="they" x-translit="yilkəḏu" xml:lang="hbo">יִלְכְּדֻ</char><char style="w" x-id="WLC.PRO.5.22.004" x-align="PRO.5.22.a004" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="will.seize.him" x-translit="nô" xml:lang="hbo">נ֥וֹ</char> <char style="w" x-id="WLC.PRO.5.22.005" x-align="PRO.5.22.a005" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.5.22.006" x-align="PRO.5.22.a006" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.wicked" x-translit="hā" xml:lang="hbo">הָ</char><char style="w" x-id="WLC.PRO.5.22.007" x-align="PRO.5.22.a007" x-target-ids="t007" x-target="wicked" x-target-head="t007" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="[person]" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֑ע</char> <char style="w" x-id="WLC.PRO.5.22.008" x-align="PRO.5.22.a008" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.P