	<para style="p"><verse number="15" style="v" x-ref="PRO.6.15" x-added-alignments="PRO.6.15.a009" x-added-target-ids="t015" x-added-target="that" sid="PRO 6:15" /><char style="w" x-id="WLC.PRO.6.15.001" x-align="PRO.6.15.a001" x-status="noncompositional" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.6.15.002" x-align="PRO.6.15.a001" x-status="noncompositional" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֗ן</char> <char style="w" x-id="WLC.PRO.6.15.003" x-align="PRO.6.15.a002" x-target-ids="t006" x-target="suddenly" x-target-head="t006" x-head="true" lemma="פִּתְאֹם" strong="H6597" x-morph="D" x-gloss="suddenly" x-translit="piṯʾōm" xml:lang="hbo">פִּ֭תְאֹם</char> <char style="w" x-id="WLC.PRO.6.15.004" x-align="PRO.6.15.a003" x-target-ids="t002 t005" x-target="shall come" x-target-head="t005" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqi3ms" x-gloss="it.will.come" x-translit="yāḇôʾ" xml:lang="hbo">יָב֣וֹא</char> <char style="w" x-id="WLC.PRO.6.15.005" x-align="PRO.6.15.a004" x-target-ids="t004" x-target="calamity" x-target-head="t004" x-head="true" lemma="אֵיד" strong="H343" x-morph="Ncmsc" x-gloss="disaster" x-translit="ʾēyḏ" xml:lang="hbo">אֵיד֑</char><char style="w" x-id="WLC.PRO.6.15.006" x-align="PRO.6.15.a005" x-target-ids="t003" x-target="his" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.6.15.007" x-align="PRO.6.15.a006" x-target-ids="t007 t008 t009" x-target="On a sudden" x-target-head="t009" x-head="true" lemma="פֶּתַע" strong="H6621" x-morph="D" x-gloss="suddenness" x-translit="peṯaʿ" xml:lang="hbo">פֶּ֥תַע</char> <char style="w" x-id="WLC.PRO.6.15.008" x-align="PRO.6.15.a007" x-target-ids="t010 t011 t012 t013" x-target="shall he be broken"