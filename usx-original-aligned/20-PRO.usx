	<para style="p"><verse number="11" style="v" x-ref="PRO.1.11" sid="PRO 1:11" /><char style="w" x-id="WLC.PRO.1.11.001" x-align="PRO.1.11.a001" x-target-ids="t001" x-target="If" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.1.11.002" x-align="PRO.1.11.a002" x-target-ids="t002 t003" x-target="they say" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqi3mp" x-gloss="they.will.say" x-translit="yōʾmərû" xml:lang="hbo">יֹאמְרוּ֮</char> <char style="w" x-id="WLC.PRO.1.11.003" x-align="PRO.1.11.a003" x-target-ids="t004" x-target="Come" x-target-head="t004" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqv2ms" x-gloss="come" x-translit="ləḵ" xml:lang="hbo">לְכָ֪</char><char style="w" x-id="WLC.PRO.1.11.004" x-align="PRO.1.11.a004" x-status="unrepresented" x-head="true" lemma="ה" strong="H1886j" x-morph="Sh" x-translit="āh" xml:lang="hbo">ה</char> <char style="w" x-id="WLC.PRO.1.11.005" x-align="PRO.1.11.a005" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾitt" xml:lang="hbo">אִ֫תָּ֥</char><char style="w" x-id="WLC.PRO.1.11.006" x-align="PRO.1.11.a006" x-target-ids="t006" x-target="us" x-target-head="t006" x-head="true" lemma="הוּא" strong="H5105a" x-morph="Sp1cp" x-gloss="us" x-translit="ānû" xml:lang="hbo">נוּ</char> <char style="w" x-id="WLC.PRO.1.11.007" x-align="PRO.1.11.a007" x-target-ids="t007 t008 t009 t010" x-target="Let us lay wait" x-target-head="t010" x-head="true" lemma="אָרַב" strong="H693" x-morph="Vqh1cp" x-gloss="let.us.lie.in.wait" x-translit="neʾerḇāh" xml:lang="hbo">נֶאֶרְבָ֥ה</char> <char style="w" x-id="WLC.PRO.1.11.008" x-align="PRO.1.11.a008" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id