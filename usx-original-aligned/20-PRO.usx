	<para style="p"><verse number="24" style="v" x-ref="PRO.19.24" x-added-alignments="PRO.19.24.a008" x-added-target-ids="t009" x-added-target="And" sid="PRO 19:24" /><char style="w" x-id="WLC.PRO.19.24.001" x-align="PRO.19.24.a002" x-target-ids="t003" x-target="burieth" x-target-head="t003" x-head="true" lemma="טָמַן" strong="H2934" x-morph="Vqp3ms" x-gloss="he.hides" x-translit="ṭāman" xml:lang="hbo">טָ֘מַ֤ן</char> <char style="w" x-id="WLC.PRO.19.24.002" x-align="PRO.19.24.a001" x-target-ids="t001 t002" x-target="The sluggard" x-target-head="t002" x-head="true" lemma="עָצֵל" strong="H6102" x-morph="Aamsa" x-gloss="a.sluggard" x-translit="ʿāṣēl" xml:lang="hbo">עָצֵ֣ל</char> <char style="w" x-id="WLC.PRO.19.24.003" x-align="PRO.19.24.a003" x-target-ids="t005" x-target="hand" x-target-head="t005" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָ֭ד</char><char style="w" x-id="WLC.PRO.19.24.004" x-align="PRO.19.24.a004" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.19.24.005" x-align="PRO.19.24.a005" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.PRO.19.24.006" x-align="PRO.19.24.a006" x-target-ids="t007" x-target="the" x-target-head="t007" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.19.24.007" x-align="PRO.19.24.a007" x-target-ids="t008" x-target="dish" x-target-head="t008" x-head="true" lemma="צַלַּחַת" strong="H6745" x-morph="Ncfsa" x-gloss="bowl" x-translit="ṣṣallāḥaṯ" xml:lang="hbo">צַּלָּ֑חַת</char> <char style="w" x-id="WLC.PRO.19.24.008" x-align="PRO.19.24.a009" x-target-ids="t012 t013 t014" x-target="so much as" x-targe