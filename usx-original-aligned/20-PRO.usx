	<para style="p"><verse number="8" style="v" x-ref="PRO.28.8" sid="PRO 28:8" /><char style="w" x-id="WLC.PRO.28.8.001" x-align="PRO.28.8.a001" x-target-ids="t001 t002 t003" x-target="He that augmenteth" x-target-head="t003" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vhrmsa" x-gloss="[one.who].increases" x-translit="marbeh" xml:lang="hbo">מַרְבֶּ֣ה</char> <char style="w" x-id="WLC.PRO.28.8.002" x-align="PRO.28.8.a003" x-target-ids="t005" x-target="substance" x-target-head="t005" x-head="true" lemma="הוֹן" strong="H1952" x-morph="Ncmsc" x-gloss="wealth" x-translit="hôn" xml:lang="hbo">ה֭וֹנ</char><char style="w" x-id="WLC.PRO.28.8.003" x-align="PRO.28.8.a002" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.28.8.004" x-align="PRO.28.8.a004" x-target-ids="t006" x-target="by" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.28.8.005" x-align="PRO.28.8.a005" x-target-ids="t007" x-target="interest" x-target-head="t007" x-head="true" lemma="נֶשֶׁךְ" strong="H5392" x-morph="Ncmsa" x-gloss="interest" x-translit="nešeḵ" xml:lang="hbo">נֶ֣שֶׁךְ</char> <char style="w" x-id="WLC.PRO.28.8.006" x-align="PRO.28.8.a006" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.8.007" x-align="PRO.28.8.a007" x-target-ids="t009" x-target="increase" x-target-head="t009" x-head="true" lemma="תַּרְבִּית" strong="H8636" x-morph="Ncfsa" x-gloss="usury" x-translit="**ṯarbiyṯ" xml:lang="hbo">תַרְבִּ֑ית</char> <char style="w" x-id="WLC.PRO.28.8.008" x-align="PRO.28.8.a010" x-target-ids="t012" x-target="for" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for