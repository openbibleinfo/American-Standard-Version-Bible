	<para style="p"><verse number="17" style="v" x-ref="PRO.26.17" x-added-alignments="PRO.26.17.a002 PRO.26.17.a010" x-added-target-ids="t005 t015" x-added-target="and | like" sid="PRO 26:17" /><char style="w" x-id="WLC.PRO.26.17.001" x-align="PRO.26.17.a009" x-target-ids="t014 t016 t017 t018" x-target="Is one that taketh" x-target-head="t018" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vhrmsa" x-gloss="[one.who].takes.hold" x-translit="maḥăziyq" xml:lang="hbo">מַחֲזִ֥יק</char> <char style="w" x-id="WLC.PRO.26.17.002" x-align="PRO.26.17.a011" x-target-ids="t021" x-target="by" x-target-head="t021" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.26.17.003" x-align="PRO.26.17.a012" x-target-ids="t022 t023" x-target="the ears" x-target-head="t023" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfdc" x-gloss="ears" x-translit="ʾāzənê-" xml:lang="hbo">אָזְנֵי</char>־<char style="w" x-id="WLC.PRO.26.17.004" x-align="PRO.26.17.a013" x-target-ids="t019 t020" x-target="a dog" x-target-head="t020" x-head="true" lemma="כֶּלֶב" strong="H3611" x-morph="Ncmsa" x-gloss="of.a.dog" x-translit="ḵāleḇ" xml:lang="hbo">כָ֑לֶב</char> <char style="w" x-id="WLC.PRO.26.17.005" x-align="PRO.26.17.a001" x-target-ids="t001 t002 t003 t004" x-target="He that passeth by" x-target-head="t003" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqrmsa" x-gloss="[one.who].passes.by" x-translit="ʿōḇēr" xml:lang="hbo">עֹבֵ֥ר</char> <char style="w" x-id="WLC.PRO.26.17.006" x-align="PRO.26.17.a003" x-target-ids="t006 t007" x-target="vexeth himself" x-target-head="t006" x-head="true" lemma="עָבַר" strong="H5674a" x-morph="Vtrmsa" x-gloss="[who].becomes.furious" x-translit="miṯʿabbēr" xml:lang="hbo">מִ֝תְעַבֵּ֗ר</char> <char style="w" x-id="WLC.PRO.26.17.007" x-align="PRO.26.17.a004" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="o