	<para style="p"><verse number="20" style="v" x-ref="PRO.7.20" sid="PRO 7:20" /><char style="w" x-id="WLC.PRO.7.20.001" x-align="PRO.7.20.a001" x-target-ids="t004 t005" x-target="a bag" x-target-head="t005" x-head="true" lemma="צְרוֹר" strong="H6872" x-morph="Ncmsc" x-gloss="the.bag" x-translit="ṣərôr-" xml:lang="hbo">צְֽרוֹר</char>־<char style="w" x-id="WLC.PRO.7.20.002" x-align="PRO.7.20.a002" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of.(the)" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PRO.7.20.003" x-align="PRO.7.20.a003" x-target-ids="t006 t007" x-target="of money" x-target-head="t007" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="money" x-translit="kesep̄" xml:lang="hbo">כֶּסֶף</char> <char style="w" x-id="WLC.PRO.7.20.004" x-align="PRO.7.20.a004" x-target-ids="t001 t002 t003" x-target="He hath taken" x-target-head="t003" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqp3ms" x-gloss="he.has.taken" x-translit="lāqaḥ" xml:lang="hbo">לָקַ֣ח</char> <char style="w" x-id="WLC.PRO.7.20.005" x-align="PRO.7.20.a005" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.7.20.006" x-align="PRO.7.20.a005" x-target-ids="t008" x-target="with" x-target-head="t008" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָד֑</char><char style="w" x-id="WLC.PRO.7.20.007" x-align="PRO.7.20.a006" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.7.20.008" x-align="PRO.7.20.a007" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.7.20.009" x-align="PRO.7.20.a007" x-target-ids="t014" x-target="at" x-target-head="t014" x-head="true" lemma="יוֹם" strong="