	<para style="p"><verse number="32" style="v" x-ref="PRO.3.32" sid="PRO 3:32" /><char style="w" x-id="WLC.PRO.3.32.001" x-align="PRO.3.32.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.3.32.002" x-align="PRO.3.32.a002" x-target-ids="t004 t005 t006" x-target="is an abomination" x-target-head="t006" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[is].(the).abomination" x-translit="ṯôʿăḇaṯ" xml:lang="hbo">תוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.3.32.003" x-align="PRO.3.32.a003" x-target-ids="t007 t008" x-target="to Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PRO.3.32.004" x-align="PRO.3.32.a004" x-target-ids="t002 t003" x-target="the perverse" x-target-head="t003" x-head="true" lemma="לוּז" strong="H3868" x-morph="VNrmsa" x-gloss="[one.who.is].crooked" x-translit="nālôz" xml:lang="hbo">נָל֑וֹז</char> <char style="w" x-id="WLC.PRO.3.32.005" x-align="PRO.3.32.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.3.32.006" x-align="PRO.3.32.a006" x-target-ids="t012 t013" x-target="is with" x-target-head="t013" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.3.32.007" x-align="PRO.3.32.a007" x-target-ids="t014 t015" x-target="the upright" x-target-head="t015" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aampa" x-gloss="upright.[people]" x-translit="yəšāriym" xml:lang="hbo">יְשָׁרִ֥ים</char> <char style="w" x-id="WLC.PRO.3.32.008" x-align="PRO.3.32.a008" x-target-ids="t011" x-target="friendship" x-target-