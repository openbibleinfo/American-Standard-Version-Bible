	<para style="p"><verse number="18" style="v" x-ref="PRO.14.18" sid="PRO 14:18" /><char style="w" x-id="WLC.PRO.14.18.001" x-align="PRO.14.18.a001" x-target-ids="t003" x-target="inherit" x-target-head="t003" x-head="true" lemma="נָחַל" strong="H5157" x-morph="Vqp3cp" x-gloss="they.inherit" x-translit="nāḥălû" xml:lang="hbo">נָחֲל֣וּ</char> <char style="w" x-id="WLC.PRO.14.18.002" x-align="PRO.14.18.a002" x-target-ids="t001 t002" x-target="The simple" x-target-head="t002" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmpa" x-gloss="naive.people" x-translit="p̄əṯāʾyim" xml:lang="hbo">פְתָאיִ֣ם</char> <char style="w" x-id="WLC.PRO.14.18.003" x-align="PRO.14.18.a003" x-target-ids="t004" x-target="folly" x-target-head="t004" x-head="true" lemma="אִוֶּלֶת" strong="H200" x-morph="Ncfsa" x-gloss="foolishness" x-translit="ʾiwweleṯ" xml:lang="hbo">אִוֶּ֑לֶת</char> <char style="w" x-id="WLC.PRO.14.18.004" x-align="PRO.14.18.a004" x-target-ids="t005" x-target="But" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ֝</char><char style="w" x-id="WLC.PRO.14.18.005" x-align="PRO.14.18.a005" x-target-ids="t006 t007" x-target="the prudent" x-target-head="t007" x-head="true" lemma="עָרוּם" strong="H6175" x-morph="Aampa" x-gloss="sensible.[people]" x-translit="ʿărûmiym" xml:lang="hbo">עֲרוּמִ֗ים</char> <char style="w" x-id="WLC.PRO.14.18.006" x-align="PRO.14.18.a006" x-target-ids="t008 t009 t010" x-target="are crowned with" x-target-head="t009" x-head="true" lemma="כָּתַר" strong="H3803b" x-morph="Vhi3mp" x-gloss="they.surround" x-translit="yaḵtirû" xml:lang="hbo">יַכְתִּ֥רוּ</char> <char style="w" x-id="WLC.PRO.14.18.007" x-align="PRO.14.18.a007" x-target-ids="t011" x-target="knowledge" x-target-head="t011" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="ḏāʿaṯ:" xml:lang="hbo">דָֽעַת</char>׃<verse eid="PRO 14:18" /></para>
