	<para style="p"><verse number="16" style="v" x-ref="PRO.24.16" x-added-alignments="PRO.24.16.a012" x-added-target-ids="t011" x-added-target="again" sid="PRO 24:16" /><char style="w" x-id="WLC.PRO.24.16.001" x-align="PRO.24.16.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.24.16.002" x-align="PRO.24.16.a002" x-target-ids="t006 t007" x-target="seven times" x-target-head="t006" x-head="true" lemma="שֶׁבַע" strong="H7651" x-morph="Acfsa" x-gloss="seven.[times]" x-translit="šeḇaʿ" xml:lang="hbo">שֶׁ֨בַע</char>׀<char style="w" x-id="WLC.PRO.24.16.003" x-align="PRO.24.16.a003" x-target-ids="t005" x-target="falleth" x-target-head="t005" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="he.will.fall" x-translit="yipôl" xml:lang="hbo">יִפּ֣וֹל</char> <char style="w" x-id="WLC.PRO.24.16.004" x-align="PRO.24.16.a004" x-target-ids="t002 t003 t004" x-target="a righteous man" x-target-head="t003" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="a.righteous.[person]" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֣יק</char> <char style="w" x-id="WLC.PRO.24.16.005" x-align="PRO.24.16.a005" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PRO.24.16.006" x-align="PRO.24.16.a006" x-target-ids="t009 t010" x-target="riseth up" x-target-head="t009" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqq3ms" x-gloss="he.will.rise" x-translit="qām" xml:lang="hbo">קָ֑ם</char> <char style="w" x-id="WLC.PRO.24.16.007" x-align="PRO.24.16.a007" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.24.16.008" x-align="PRO.24.16.a008"