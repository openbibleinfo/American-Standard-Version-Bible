	<para style="p"><verse number="26" style="v" x-ref="PRO.28.26" sid="PRO 28:26" /><char style="w" x-id="WLC.PRO.28.26.001" x-align="PRO.28.26.a001" x-target-ids="t001 t002 t003" x-target="He that trusteth" x-target-head="t003" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqrmsa" x-gloss="[one.who].trusts" x-translit="bôṭēᵃḥ" xml:lang="hbo">בּוֹטֵ֣חַ</char> <char style="w" x-id="WLC.PRO.28.26.002" x-align="PRO.28.26.a002" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.28.26.003" x-align="PRO.28.26.a004" x-target-ids="t007" x-target="heart" x-target-head="t007" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="his.own" x-translit="libb" xml:lang="hbo">לִבּ</char><char style="w" x-id="WLC.PRO.28.26.004" x-align="PRO.28.26.a003" x-target-ids="t005 t006" x-target="his own" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="heart" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.28.26.005" x-align="PRO.28.26.a005" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֣וּא</char> <char style="w" x-id="WLC.PRO.28.26.006" x-align="PRO.28.26.a006" x-target-ids="t008 t009 t010" x-target="is a fool" x-target-head="t010" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aamsa" x-gloss="[is].a.fool" x-translit="ḵəsiyl" xml:lang="hbo">כְסִ֑יל</char> <char style="w" x-id="WLC.PRO.28.26.007" x-align="PRO.28.26.a007" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.26.008" x-align="PRO.28.26.a008" x-target-ids="t012 t013" x-target="whoso walketh" x-target-head="t013" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[o