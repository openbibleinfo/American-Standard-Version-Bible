	<para style="p"><verse number="29" style="v" x-ref="PRO.10.29" sid="PRO 10:29" /><char style="w" x-id="WLC.PRO.10.29.001" x-align="PRO.10.29.a001" x-target-ids="t005 t006 t007" x-target="is a stronghold" x-target-head="t007" x-head="true" lemma="מָעוֹז" strong="H4581" x-morph="Ncmsa" x-gloss="[is].a.refuge" x-translit="māʿôz" xml:lang="hbo">מָע֣וֹז</char> <char style="w" x-id="WLC.PRO.10.29.002" x-align="PRO.10.29.a002" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo">לַ֭</char><char style="w" x-id="WLC.PRO.10.29.003" x-align="PRO.10.29.a003" x-target-ids="t009" x-target="the" x-target-head="t009" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.10.29.004" x-align="PRO.10.29.a004" x-target-ids="t010" x-target="upright" x-target-head="t010" x-head="true" lemma="תֹּם" strong="H8537" x-morph="Ncmsa" x-gloss="integrity" x-translit="tōm" xml:lang="hbo">תֹּם</char> <char style="w" x-id="WLC.PRO.10.29.005" x-align="PRO.10.29.a005" x-target-ids="t001 t002 t012" x-target="The way it" x-target-head="t002" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="the.way" x-translit="dereḵ" xml:lang="hbo">דֶּ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.10.29.006" x-align="PRO.10.29.a006" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.10.29.007" x-align="PRO.10.29.a007" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.10.29.008" x-align="PRO.10.29.a008" x-target-ids="t013 t014 t015" x-target="is a destruction" x-target-head="t015" x-head="true" lemma="מְחִת