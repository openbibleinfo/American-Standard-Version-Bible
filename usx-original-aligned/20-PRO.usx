	<para style="p"><verse number="16" style="v" x-ref="PRO.13.16" x-added-alignments="PRO.13.16.a009" x-added-target-ids="t011" x-added-target="his" sid="PRO 13:16" /><char style="w" x-id="WLC.PRO.13.16.001" x-align="PRO.13.16.a001" x-target-ids="t001" x-target="Every" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PRO.13.16.002" x-align="PRO.13.16.a002" x-target-ids="t002 t003" x-target="prudent man" x-target-head="t002" x-head="true" lemma="עָרוּם" strong="H6175" x-morph="Aamsa" x-gloss="sensible.[person]" x-translit="ʿārûm" xml:lang="hbo">עָ֭רוּם</char> <char style="w" x-id="WLC.PRO.13.16.003" x-align="PRO.13.16.a003" x-target-ids="t004" x-target="worketh" x-target-head="t004" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqi3ms" x-gloss="he.acts" x-translit="yaʿăśeh" xml:lang="hbo">יַעֲשֶׂ֣ה</char> <char style="w" x-id="WLC.PRO.13.16.004" x-align="PRO.13.16.a004" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.13.16.005" x-align="PRO.13.16.a005" x-target-ids="t006" x-target="knowledge" x-target-head="t006" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="ḏāʿaṯ" xml:lang="hbo">דָ֑עַת</char> <char style="w" x-id="WLC.PRO.13.16.006" x-align="PRO.13.16.a006" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.13.16.007" x-align="PRO.13.16.a007" x-target-ids="t008 t009" x-target="a fool" x-target-head="t009" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aamsa" x-gloss="a.fool" x-translit="ḵəsiyl" xml:lang="hbo">כְסִ֗יל</char> <char style="w" x-id="WLC.PRO.13.16.008" x-align="PRO.13.16.a008" x-target-ids="t010" x-