	<para style="p"><verse number="14" style="v" x-ref="PRO.18.14" sid="PRO 18:14" /><char style="w" x-id="WLC.PRO.18.14.001" x-align="PRO.18.14.a001" x-target-ids="t001 t002" x-target="The spirit" x-target-head="t002" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsc" x-gloss="[the].spirit" x-translit="rûᵃḥ-" xml:lang="hbo">רֽוּחַ</char>־<char style="w" x-id="WLC.PRO.18.14.002" x-align="PRO.18.14.a002" x-target-ids="t003 t004 t005" x-target="of a man" x-target-head="t005" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾîš" xml:lang="hbo">אִ֭ישׁ</char> <char style="w" x-id="WLC.PRO.18.14.003" x-align="PRO.18.14.a003" x-target-ids="t006 t007" x-target="will sustain" x-target-head="t007" x-head="true" lemma="כּוּל" strong="H3557" x-morph="Vli3ms" x-gloss="it.will.endure" x-translit="yəḵalkēl" xml:lang="hbo">יְכַלְכֵּ֣ל</char> <char style="w" x-id="WLC.PRO.18.14.004" x-align="PRO.18.14.a005" x-target-ids="t009" x-target="infirmity" x-target-head="t009" x-head="true" lemma="מַחֲלֶה" strong="H4245a" x-morph="Ncmsc" x-gloss="sickness" x-translit="maḥăl" xml:lang="hbo">מַחֲלֵ֑</char><char style="w" x-id="WLC.PRO.18.14.005" x-align="PRO.18.14.a004" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.18.14.006" x-align="PRO.18.14.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.18.14.007" x-align="PRO.18.14.a007" x-target-ids="t011 t013" x-target="a spirit" x-target-head="t013" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="a.spirit" x-translit="rûᵃḥ" xml:lang="hbo">ר֥וּחַ</char> <char style="w" x-id="WLC.PRO.18.14.008" x-align="PRO.18.14.a008" x-target-ids="t012" x-target="broken" x-target-head="t012" x-head="