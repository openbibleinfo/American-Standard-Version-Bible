	<para style="p"><verse number="8" style="v" x-ref="PRO.13.8" sid="PRO 13:8" /><char style="w" x-id="WLC.PRO.13.8.001" x-align="PRO.13.8.a001" x-target-ids="t001 t002" x-target="The ransom" x-target-head="t002" x-head="true" lemma="כֹּפֶר" strong="H3724c" x-morph="Ncmsc" x-gloss="[the].ransom" x-translit="kōp̄er" xml:lang="hbo">כֹּ֣פֶר</char> <char style="w" x-id="WLC.PRO.13.8.002" x-align="PRO.13.8.a002" x-target-ids="t003 t006" x-target="of life" x-target-head="t006" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="of.[the].life" x-translit="nep̄eš-" xml:lang="hbo">נֶֽפֶשׁ</char>־<char style="w" x-id="WLC.PRO.13.8.003" x-align="PRO.13.8.a003" x-target-ids="t004 t005" x-target="a man’s" x-target-head="t005" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.13.8.004" x-align="PRO.13.8.a004" x-target-ids="t007 t009" x-target="is riches" x-target-head="t009" x-head="true" lemma="עֹשֶׁר" strong="H6239" x-morph="Ncmsc" x-gloss="wealth" x-translit="ʿāšər" xml:lang="hbo">עָשְׁר֑</char><char style="w" x-id="WLC.PRO.13.8.005" x-align="PRO.13.8.a005" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="[is].his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.13.8.006" x-align="PRO.13.8.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.13.8.007" x-align="PRO.13.8.a007" x-target-ids="t011 t012" x-target="the poor" x-target-head="t012" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="[one.who.is].poor" x-translit="rāš" xml:lang="hbo">רָ֗שׁ</char> <char style="w" x-id="WLC.PRO.13.8.008" x-align="PRO.13.8.a008" x-target-ids="t014" x-target="no" x-target-head="t014" x-head="true" lemma="לֹא" stron