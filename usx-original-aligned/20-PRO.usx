	<para style="p"><verse number="29" style="v" x-ref="PRO.1.29" sid="PRO 1:29" /><char style="w" x-id="WLC.PRO.1.29.001" x-align="PRO.1.29.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="תַּחַת" strong="H8478" x-morph="R" x-gloss="because" x-translit="taḥaṯ" xml:lang="hbo">תַּ֭חַת</char> <char style="w" x-id="WLC.PRO.1.29.002" x-align="PRO.1.29.a002" x-target-ids="t002" x-target="that" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.1.29.003" x-align="PRO.1.29.a003" x-target-ids="t003 t004" x-target="they hated" x-target-head="t004" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqp3cp" x-gloss="they.hated" x-translit="śānəʾû" xml:lang="hbo">שָׂ֣נְאוּ</char> <char style="w" x-id="WLC.PRO.1.29.004" x-align="PRO.1.29.a004" x-target-ids="t005" x-target="knowledge" x-target-head="t005" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="ḏāʿaṯ" xml:lang="hbo">דָ֑עַת</char> <char style="w" x-id="WLC.PRO.1.29.005" x-align="PRO.1.29.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.1.29.006" x-align="PRO.1.29.a008" x-target-ids="t010 t011" x-target="the fear" x-target-head="t011" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="the.fear" x-translit="yirʾaṯ" xml:lang="hbo">יִרְאַ֥ת</char> <char style="w" x-id="WLC.PRO.1.29.007" x-align="PRO.1.29.a009" x-target-ids="t012 t013" x-target="of Jehovah" x-target-head="t013" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhōwāh" xml:lang="hbo">יְ֝הֹוָ֗ה</char> <char style="w" x-id="WLC.PRO.1.29.008" x-align="PRO.1.29.a007" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x