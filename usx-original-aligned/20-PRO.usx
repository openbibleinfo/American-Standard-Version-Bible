	<para style="p"><verse number="5" style="v" x-ref="PRO.8.5" sid="PRO 8:5" /><char style="w" x-id="WLC.PRO.8.5.001" x-align="PRO.8.5.a001" x-target-ids="t004" x-target="understand" x-target-head="t004" x-head="true" lemma="בִּין" strong="H995" x-morph="Vhv2mp" x-gloss="understand" x-translit="hāḇiynû" xml:lang="hbo">הָבִ֣ינוּ</char> <char style="w" x-id="WLC.PRO.8.5.002" x-align="PRO.8.5.a002" x-target-ids="t001 t002 t003" x-target="O ye simple" x-target-head="t003" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmpa" x-gloss="O.naive.people" x-translit="p̄əṯāʾyim" xml:lang="hbo">פְתָאיִ֣ם</char> <char style="w" x-id="WLC.PRO.8.5.003" x-align="PRO.8.5.a003" x-target-ids="t005" x-target="prudence" x-target-head="t005" x-head="true" lemma="עׇרְמָה" strong="H6195" x-morph="Ncfsa" x-gloss="prudence" x-translit="ʿārəmāh" xml:lang="hbo">עָרְמָ֑ה</char> <char style="w" x-id="WLC.PRO.8.5.004" x-align="PRO.8.5.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.8.5.005" x-align="PRO.8.5.a005" x-target-ids="t007 t008" x-target="ye fools" x-target-head="t008" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aampa" x-gloss="O.fools" x-translit="ḵəsîliym" xml:lang="hbo">כְסִילִ֗ים</char> <char style="w" x-id="WLC.PRO.8.5.006" x-align="PRO.8.5.a006" x-target-ids="t009 t010 t012" x-target="be of understanding" x-target-head="t012" x-head="true" lemma="בִּין" strong="H995" x-morph="Vhv2mp" x-gloss="understand" x-translit="hāḇiynû" xml:lang="hbo">הָבִ֥ינוּ</char> <char style="w" x-id="WLC.PRO.8.5.007" x-align="PRO.8.5.a007" x-target-ids="t011 t013" x-target="an heart" x-target-head="t013" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="heart" x-translit="lēḇ:" xml:lang="hbo">לֵֽב</char>׃<verse eid="PRO 8:5" /></para>
	<para style="p"><verse number="6" style="v" x-ref="PRO.8.6" sid="PRO 8:6" /><char style="w" x-id="WLC.PRO.8.6.001" x-align="PRO.8.6.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2mp" x-gloss="listen" x-translit="šimʿû" xml:lang="hbo">שִׁ֭מְעוּ</char> <char style="w" x-id="WLC.PRO.8.6.002" x-align="PRO.8.6.a002" x-target-ids="t002" x-target="for" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.8.6.003" x-align="PRO.8.6.a003" x-target-ids="t006 t007" x-target="excellent things" x-target-head="t006" x-head="true" lemma="נָגִיד" strong="H5048" x-morph="Ncmpa" x-gloss="princely.things" x-translit="nəḡîḏiym" xml:lang="hbo">נְגִידִ֣ים</char> <char style="w" x-id="WLC.PRO.8.6.004" x-align="PRO.8.6.a004" x-target-ids="t003 t004 t005" x-target="I will speak" x-target-head="t005" x-head="true" lemma="דָבַר" strong="H1696" x-morph="Vpi1cs" x-gloss="I.will.speak" x-translit="ʾăḏabbēr" xml:lang="hbo">אֲדַבֵּ֑ר</char> <char style="w" x-id="WLC.PRO.8.6.005" x-align="PRO.8.6.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.8.6.006" x-align="PRO.8.6.a006" x-target-ids="t009 t010" x-target="the opening" x-target-head="t010" x-head="true" lemma="מִפְתָּח" strong="H4669" x-morph="Ncmsc" x-gloss="the.opening" x-translit="mip̄taḥ" xml:lang="hbo">מִפְתַּ֥ח</char> <char style="w" x-id="WLC.PRO.8.6.007" x-align="PRO.8.6.a007" x-target-ids="t011 t013" x-target="of lips" x-target-head="t013" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="my.lips" x-translit="śəp̄āṯ" xml:lang="hbo">שְׂ֝פָתַ֗</char><char style="w" x-id="WLC.PRO.8.6.008" x-align="PRO.8.6.a008" x-target-ids="t012" x-target="my" x-target-head="t012" x-head="true" lemma="הוּא"