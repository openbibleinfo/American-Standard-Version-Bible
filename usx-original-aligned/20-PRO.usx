	<para style="p"><verse number="17" style="v" x-ref="PRO.10.17" sid="PRO 10:17" /><char style="w" x-id="WLC.PRO.10.17.001" x-align="PRO.10.17.a001" x-target-ids="t002 t003 t004 t005" x-target="is in the way" x-target-head="t005" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbsa" x-gloss="[is].a.path" x-translit="ʾōraḥ" xml:lang="hbo">אֹ֣רַח</char> <char style="w" x-id="WLC.PRO.10.17.002" x-align="PRO.10.17.a002" x-target-ids="t006" x-target="of" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֭</char><char style="w" x-id="WLC.PRO.10.17.003" x-align="PRO.10.17.a003" x-target-ids="t007" x-target="life" x-target-head="t007" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="life" x-translit="ḥayyîm" xml:lang="hbo">חַיִּים</char> <char style="w" x-id="WLC.PRO.10.17.004" x-align="PRO.10.17.a004" x-target-ids="t001 t008 t009" x-target="He that heedeth" x-target-head="t009" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[one.who].keeps" x-translit="šômēr" xml:lang="hbo">שׁוֹמֵ֣ר</char> <char style="w" x-id="WLC.PRO.10.17.005" x-align="PRO.10.17.a005" x-target-ids="t010" x-target="correction" x-target-head="t010" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsa" x-gloss="discipline" x-translit="mûsār" xml:lang="hbo">מוּסָ֑ר</char> <char style="w" x-id="WLC.PRO.10.17.006" x-align="PRO.10.17.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.10.17.007" x-align="PRO.10.17.a007" x-target-ids="t012 t013 t014" x-target="he that forsaketh" x-target-head="t014" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqrmsa" x-gloss="[one.who].neglects" x-translit="ʿôzēḇ" xml:lang="hbo">עוֹזֵ֖ב</char> <char style="w" x-id="WLC.PRO.10.17.008" x-align="PRO.10.17.a008" x-target-ids="t015" x-target="reproof" x-target