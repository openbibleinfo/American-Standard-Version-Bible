	<para style="p"><verse number="24" style="v" x-ref="PRO.13.24" sid="PRO 13:24" /><char style="w" x-id="WLC.PRO.13.24.001" x-align="PRO.13.24.a001" x-target-ids="t001 t002 t003" x-target="He that spareth" x-target-head="t003" x-head="true" lemma="חָשַׂךְ" strong="H2820" x-morph="Vqrmsa" x-gloss="[one.who].restrains" x-translit="ḥôśēḵ" xml:lang="hbo">חוֹשֵׂ֣ךְ</char> <char style="w" x-id="WLC.PRO.13.24.002" x-align="PRO.13.24.a002" x-target-ids="t005" x-target="rod" x-target-head="t005" x-head="true" lemma="שֵׁבֶט" strong="H7626" x-morph="Ncmsc" x-gloss="rod" x-translit="šiḇṭ" xml:lang="hbo">שִׁ֭בְט</char><char style="w" x-id="WLC.PRO.13.24.003" x-align="PRO.13.24.a003" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.13.24.004" x-align="PRO.13.24.a004" x-target-ids="t006" x-target="hateth" x-target-head="t006" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[is].hating" x-translit="śônēʾ" xml:lang="hbo">שׂוֹנֵ֣א</char> <char style="w" x-id="WLC.PRO.13.24.005" x-align="PRO.13.24.a005" x-target-ids="t008" x-target="son" x-target-head="t008" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="son" x-translit="ḇən" xml:lang="hbo">בְנ֑</char><char style="w" x-id="WLC.PRO.13.24.006" x-align="PRO.13.24.a006" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.13.24.007" x-align="PRO.13.24.a007" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.13.24.008" x-align="PRO.13.24.a008" x-target-ids="t010 t011 t012" x-target="he that loveth" x-target-head="t012" x-head="true" lemma="אָהֵב" strong="H157" x-morph=