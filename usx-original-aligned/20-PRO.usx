	<para style="p"><verse number="35" style="v" x-ref="PRO.23.35" x-added-alignments="PRO.23.35.a003 PRO.23.35.a004 PRO.23.35.a009 PRO.23.35.a012" x-added-target-ids="t005 t006 t007 t008 t017 t020" x-added-target="shalt thou say | and | and | it" sid="PRO 23:35" /><char style="w" x-id="WLC.PRO.23.35.001" x-align="PRO.23.35.a001" x-target-ids="t001 t002 t003" x-target="They have stricken" x-target-head="t003" x-head="true" lemma="נָכָה" strong="H5221" x-morph="Vhp3cp" x-gloss="they" x-translit="hikkû" xml:lang="hbo">הִכּ֥וּ</char><char style="w" x-id="WLC.PRO.23.35.002" x-align="PRO.23.35.a002" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="struck.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PRO.23.35.003" x-align="PRO.23.35.a005" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="ḇal-" xml:lang="hbo">בַל</char>־<char style="w" x-id="WLC.PRO.23.35.004" x-align="PRO.23.35.a006" x-target-ids="t009 t010 t012" x-target="I was hurt" x-target-head="t012" x-head="true" lemma="חָלָה" strong="H2470" x-morph="Vqp1cs" x-gloss="I.am.sick" x-translit="ḥālîṯî" xml:lang="hbo">חָלִיתִי֮</char> <char style="w" x-id="WLC.PRO.23.35.005" x-align="PRO.23.35.a007" x-target-ids="t013 t014 t015" x-target="They have beaten" x-target-head="t015" x-head="true" lemma="הָלַם" strong="H1986" x-morph="Vqp3cp" x-gloss="they" x-translit="hălāmû" xml:lang="hbo">הֲלָמ֗וּ</char><char style="w" x-id="WLC.PRO.23.35.006" x-align="PRO.23.35.a008" x-target-ids="t016" x-target="me" x-target-head="t016" x-head="true" lemma="הוּא" strong="H5204a" x-morph="Sp1cs" x-gloss="struck.me" x-translit="niy" xml:lang="hbo">נִי</char> <char style="w" x-id="WLC.PRO.23.35.007" x-align="PRO.23.35.a010" x-target-ids="t021" x-target="not" x-target-head="t021" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="ba