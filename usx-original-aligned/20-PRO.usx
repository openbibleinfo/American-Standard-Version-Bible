	<para style="p"><verse number="18" style="v" x-ref="PRO.11.18" x-added-alignments="PRO.11.18.a010" x-added-target-ids="t011" x-added-target="hath" sid="PRO 11:18" /><char style="w" x-id="WLC.PRO.11.18.001" x-align="PRO.11.18.a001" x-target-ids="t001 t002" x-target="The wicked" x-target-head="t002" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֗ע</char> <char style="w" x-id="WLC.PRO.11.18.002" x-align="PRO.11.18.a002" x-target-ids="t003" x-target="earneth" x-target-head="t003" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsa" x-gloss="[is].making" x-translit="ʿōśeh" xml:lang="hbo">עֹשֶׂ֥ה</char> <char style="w" x-id="WLC.PRO.11.18.003" x-align="PRO.11.18.a003" x-target-ids="t005" x-target="wages" x-target-head="t005" x-head="true" lemma="פְּעֻלָּה" strong="H6468" x-morph="Ncfsc" x-gloss="wage[s]" x-translit="p̄əʿullaṯ-" xml:lang="hbo">פְעֻלַּת</char>־<char style="w" x-id="WLC.PRO.11.18.004" x-align="PRO.11.18.a004" x-target-ids="t004" x-target="deceitful" x-target-head="t004" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāqer" xml:lang="hbo">שָׁ֑קֶר</char> <char style="w" x-id="WLC.PRO.11.18.005" x-align="PRO.11.18.a005" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.18.006" x-align="PRO.11.18.a006" x-target-ids="t007 t008 t009" x-target="he that soweth" x-target-head="t009" x-head="true" lemma="זָרַע" strong="H2232" x-morph="Vqrmsa" x-gloss="[one.who].sows" x-translit="zōrēᵃʿ" xml:lang="hbo">זֹרֵ֥עַ</char> <char style="w" x-id="WLC.PRO.11.18.007" x-align="PRO.11.18.a007" x-target-ids="t010" x-target="righteousness" x-target-head="t010" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְ֝דָקָ֗ה</char> <char st