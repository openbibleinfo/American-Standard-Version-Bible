	<para style="p"><verse number="2" style="v" x-ref="PRO.10.2" sid="PRO 10:2" /><char style="w" x-id="WLC.PRO.10.2.001" x-align="PRO.10.2.a001" x-target-ids="t005" x-target="nothing" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.10.2.002" x-align="PRO.10.2.a002" x-target-ids="t004" x-target="profit" x-target-head="t004" x-head="true" lemma="יָעַל" strong="H3276" x-morph="Vhi3mp" x-gloss="they.profit" x-translit="yôʿîlû" xml:lang="hbo">י֭וֹעִילוּ</char> <char style="w" x-id="WLC.PRO.10.2.003" x-align="PRO.10.2.a003" x-target-ids="t001" x-target="Treasures" x-target-head="t001" x-head="true" lemma="אוֹצָר" strong="H214" x-morph="Ncmpc" x-gloss="treasures" x-translit="ʾôṣərôṯ" xml:lang="hbo">אוֹצְר֣וֹת</char> <char style="w" x-id="WLC.PRO.10.2.004" x-align="PRO.10.2.a004" x-target-ids="t002 t003" x-target="of wickedness" x-target-head="t003" x-head="true" lemma="רֶשַׁע" strong="H7562" x-morph="Ncmsa" x-gloss="of.wickedness" x-translit="rešaʿ" xml:lang="hbo">רֶ֑שַׁע</char> <char style="w" x-id="WLC.PRO.10.2.005" x-align="PRO.10.2.a005" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.10.2.006" x-align="PRO.10.2.a006" x-target-ids="t007" x-target="righteousness" x-target-head="t007" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְדָקָ֗ה</char> <char style="w" x-id="WLC.PRO.10.2.007" x-align="PRO.10.2.a007" x-target-ids="t008" x-target="delivereth" x-target-head="t008" x-head="true" lemma="נָצַל" strong="H5337" x-morph="Vhi3fs" x-gloss="it.delivers" x-translit="taṣṣiyl" xml:lang="hbo">תַּצִּ֥יל</char> <char style="w" x-id="WLC.PRO.10.2.008" x-align="PRO.10.2.a008" x-target-ids="t009" x-target="from" x-target-head="t009" x-head="true" lemma="מִ