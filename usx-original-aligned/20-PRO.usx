	<para style="p"><verse number="19" style="v" x-ref="PRO.5.19" x-added-alignments="PRO.5.19.a013" x-added-target-ids="t017" x-added-target="And" sid="PRO 5:19" /><char style="w" x-id="WLC.PRO.5.19.001" x-align="PRO.5.19.a001" x-target-ids="t001 t002 t004" x-target="As a hind" x-target-italic-ids="t001" x-target-head="t004" x-head="true" lemma="אַיֶּלֶת" strong="H365" x-morph="Ncfsc" x-gloss="a.doe" x-translit="ʾayyeleṯ" xml:lang="hbo">אַיֶּ֥לֶת</char> <char style="w" x-id="WLC.PRO.5.19.002" x-align="PRO.5.19.a002" x-target-ids="t003" x-target="loving" x-target-head="t003" x-head="true" lemma="אַהַב" strong="H158" x-morph="Ncmpa" x-gloss="of.loves" x-translit="ʾăhāḇiym" xml:lang="hbo">אֲהָבִ֗ים</char> <char style="w" x-id="WLC.PRO.5.19.003" x-align="PRO.5.19.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.5.19.004" x-align="PRO.5.19.a004" x-target-ids="t006 t008" x-target="a doe" x-target-head="t008" x-head="true" lemma="יַעֲלָה" strong="H3280" x-morph="Ncfsc" x-gloss="a.mountain.goat" x-translit="yaʿălaṯ-" xml:lang="hbo">יַעֲלַ֫ת</char>־<char style="w" x-id="WLC.PRO.5.19.005" x-align="PRO.5.19.a005" x-target-ids="t007" x-target="pleasant" x-target-head="t007" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="of.grace" x-translit="ḥēn" xml:lang="hbo">חֵ֥ן</char> <char style="w" x-id="WLC.PRO.5.19.006" x-align="PRO.5.19.a008" x-target-ids="t011" x-target="breasts" x-target-head="t011" x-head="true" lemma="דַּד" strong="H1717" x-morph="Ncmdc" x-gloss="breasts" x-translit="daddey" xml:lang="hbo">דַּ֭דֶּי</char><char style="w" x-id="WLC.PRO.5.19.007" x-align="PRO.5.19.a007" x-target-ids="t010" x-target="her" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.5.19.008" x-align="PRO.5.19.a006" x-