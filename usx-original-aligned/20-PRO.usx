	<para style="p"><verse number="14" style="v" x-ref="PRO.13.14" sid="PRO 13:14" /><char style="w" x-id="WLC.PRO.13.14.001" x-align="PRO.13.14.a001" x-target-ids="t001 t002" x-target="The law" x-target-head="t002" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsc" x-gloss="[the].instruction" x-translit="tôraṯ" xml:lang="hbo">תּוֹרַ֣ת</char> <char style="w" x-id="WLC.PRO.13.14.002" x-align="PRO.13.14.a002" x-target-ids="t003 t004 t005" x-target="of the wise" x-target-head="t005" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="of.a.wise.[person]" x-translit="ḥāḵām" xml:lang="hbo">חָ֭כָם</char> <char style="w" x-id="WLC.PRO.13.14.003" x-align="PRO.13.14.a003" x-target-ids="t006 t007 t008" x-target="is a fountain" x-target-head="t008" x-head="true" lemma="מָקוֹר" strong="H4726" x-morph="Ncmsc" x-gloss="[is].a.fountain" x-translit="məqôr" xml:lang="hbo">מְק֣וֹר</char> <char style="w" x-id="WLC.PRO.13.14.004" x-align="PRO.13.14.a004" x-target-ids="t009 t010" x-target="of life" x-target-head="t010" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="of.life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.13.14.005" x-align="PRO.13.14.a005" x-target-ids="t011" x-target="That" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ֝</char><char style="w" x-id="WLC.PRO.13.14.006" x-align="PRO.13.14.a006" x-target-ids="t012 t013 t014" x-target="one may depart" x-target-head="t014" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vqc" x-gloss="turn.aside" x-translit="sûr" xml:lang="hbo">ס֗וּר</char> <char style="w" x-id="WLC.PRO.13.14.007" x-align="PRO.13.14.a007" x-target-ids="t015" x-target="from" x-target-head="t015" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from.[the]" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.13.14.008" x-align="PRO.13.14.a008" x-target-ids="t016 t017" x-target="