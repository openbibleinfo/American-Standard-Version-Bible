	<para style="p"><verse number="28" style="v" x-ref="PRO.28.28" sid="PRO 28:28" /><char style="w" x-id="WLC.PRO.28.28.001" x-align="PRO.28.28.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.28.28.002" x-align="PRO.28.28.a003" x-target-ids="t004" x-target="rise" x-target-head="t004" x-head="true" lemma="קוּם" strong="H6965" x-morph="Vqc" x-gloss="arise" x-translit="qûm" xml:lang="hbo">ק֣וּם</char> <char style="w" x-id="WLC.PRO.28.28.003" x-align="PRO.28.28.a002" x-target-ids="t002 t003" x-target="the wicked" x-target-head="t003" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="wicked.[people]" x-translit="rəšāʿîm" xml:lang="hbo">רְ֭שָׁעִים</char> <char style="w" x-id="WLC.PRO.28.28.004" x-align="PRO.28.28.a005" x-target-ids="t006 t007" x-target="hide themselves" x-target-head="t006" x-head="true" lemma="סָתַר" strong="H5641" x-morph="VNi3ms" x-gloss="he.hides.himself" x-translit="yissāṯēr" xml:lang="hbo">יִסָּתֵ֣ר</char> <char style="w" x-id="WLC.PRO.28.28.005" x-align="PRO.28.28.a004" x-target-ids="t005" x-target="men" x-target-head="t005" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="everyone" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֑ם</char> <char style="w" x-id="WLC.PRO.28.28.006" x-align="PRO.28.28.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.28.28.007" x-align="PRO.28.28.a007" x-target-ids="t009" x-target="when" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.28.28.008" x-align="PRO.28.28.a009" x-target-ids="t011" x-target="perish" x-target-head="t011" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqc" x-glos