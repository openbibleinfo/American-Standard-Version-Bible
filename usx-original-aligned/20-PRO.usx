	<para style="p"><verse number="28" style="v" x-ref="PRO.19.28" sid="PRO 19:28" /><char style="w" x-id="WLC.PRO.19.28.001" x-align="PRO.19.28.a001" x-target-ids="t001 t003" x-target="A witness" x-target-head="t003" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsc" x-gloss="a.witness" x-translit="ʿēḏ" xml:lang="hbo">עֵ֣ד</char> <char style="w" x-id="WLC.PRO.19.28.002" x-align="PRO.19.28.a002" x-target-ids="t002" x-target="worthless" x-target-head="t002" x-head="true" lemma="בְּלִיַּעַל" strong="H1100" x-morph="Ncmsa" x-gloss="of.worthlessness" x-translit="bəliyyaʿal" xml:lang="hbo">בְּ֭לִיַּעַל</char> <char style="w" x-id="WLC.PRO.19.28.003" x-align="PRO.19.28.a003" x-target-ids="t004 t005" x-target="mocketh at" x-target-head="t004" x-head="true" lemma="לִיץ" strong="H3887b" x-morph="Vhi3ms" x-gloss="he.mocks" x-translit="yāliyṣ" xml:lang="hbo">יָלִ֣יץ</char> <char style="w" x-id="WLC.PRO.19.28.004" x-align="PRO.19.28.a004" x-target-ids="t006" x-target="justice" x-target-head="t006" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="justice" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּ֑ט</char> <char style="w" x-id="WLC.PRO.19.28.005" x-align="PRO.19.28.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.19.28.006" x-align="PRO.19.28.a006" x-target-ids="t008 t009" x-target="the mouth" x-target-head="t009" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄iy" xml:lang="hbo">פִ֥י</char> <char style="w" x-id="WLC.PRO.19.28.007" x-align="PRO.19.28.a007" x-target-ids="t010 t011 t012" x-target="of the wicked" x-target-head="t012" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְ֝שָׁעִ֗ים</char> <char style="w" x-id="WLC.PRO.19.28.008" x-align="PRO.19.28.a008" x-target-ids="t013" x-t