	<para style="p"><verse number="31" style="v" x-ref="PRO.30.31" sid="PRO 30:31" /><char style="w" x-id="WLC.PRO.30.31.001" x-align="PRO.30.31.a001" x-target-ids="t001 t002" x-target="The greyhound" x-target-head="t002" x-head="true" lemma="זַרְזִיר" strong="H2223" x-morph="Ncmsc" x-gloss="a.rooster" x-translit="zarziyr" xml:lang="hbo">זַרְזִ֣יר</char> <char style="w" x-id="WLC.PRO.30.31.002" x-align="PRO.30.31.a001" lemma="מׇתְנַיִם" strong="H4975" x-morph="Ncmda" x-gloss="of.loins" x-translit="māṯənayim" xml:lang="hbo">מָתְנַ֣יִם</char> <char style="w" x-id="WLC.PRO.30.31.003" x-align="PRO.30.31.a002" x-target-ids="t006" x-target="also" x-target-head="t006" x-head="true" lemma="אוֹ" strong="H176" x-morph="C" x-gloss="or" x-translit="ʾô-" xml:lang="hbo">אוֹ</char>־<char style="w" x-id="WLC.PRO.30.31.004" x-align="PRO.30.31.a003" x-target-ids="t003 t004 t005" x-target="the he goat" x-target-head="t005" x-head="true" lemma="תַּיִשׁ" strong="H8495" x-morph="Ncmsa" x-gloss="a.male.goat" x-translit="ṯāyiš" xml:lang="hbo">תָ֑יִשׁ</char> <char style="w" x-id="WLC.PRO.30.31.005" x-align="PRO.30.31.a004" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.30.31.006" x-align="PRO.30.31.a005" x-target-ids="t008 t009" x-target="the king" x-target-head="t009" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="a.king" x-translit="meleḵ" xml:lang="hbo">מֶ֗לֶךְ</char> <char style="w" x-id="WLC.PRO.30.31.007" x-align="PRO.30.31.a006" x-target-ids="t012 t013 t014 t015 t016" x-target="there is no rising up" x-target-head="t015" x-head="true" lemma="אַלְקוּם" strong="H510" x-morph="D" x-gloss="[who].a.band.of.soldiers" x-translit="ʾalqûm" xml:lang="hbo">אַלְק֥וּם</char> <char style="w" x-id="WLC.PRO.30.31.008" x-align="PRO.30.31.a007" x-target-ids="t010" x-target="against" x-target-head="t010" x-head="true" lemma="עִם" strong="H5