	<para style="p"><verse number="6" style="v" x-ref="PRO.4.6" sid="PRO 4:6" /><char style="w" x-id="WLC.PRO.4.6.001" x-align="PRO.4.6.a003" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.4.6.002" x-align="PRO.4.6.a001" x-target-ids="t001" x-target="Forsake" x-target-head="t001" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqj2ms" x-gloss="abandon" x-translit="taʿazḇ" xml:lang="hbo">תַּעַזְבֶ֥</char><char style="w" x-id="WLC.PRO.4.6.003" x-align="PRO.4.6.a002" x-target-ids="t002" x-target="her" x-target-head="t002" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="ehā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.4.6.004" x-align="PRO.4.6.a004" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.4.6.005" x-align="PRO.4.6.a005" x-target-ids="t005 t006 t007" x-target="she will preserve" x-target-head="t007" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqi3fs" x-gloss="she" x-translit="ṯišmər" xml:lang="hbo">תִשְׁמְרֶ֑</char><char style="w" x-id="WLC.PRO.4.6.006" x-align="PRO.4.6.a006" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="will.keep.you" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.PRO.4.6.007" x-align="PRO.4.6.a007" x-target-ids="t009" x-target="Love" x-target-head="t009" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqv2ms" x-gloss="love" x-translit="ʾĕhāḇ" xml:lang="hbo">אֱהָבֶ֥</char><char style="w" x-id="WLC.PRO.4.6.008" x-align="PRO.4.6.a008" x-target-ids="t010" x-target="her" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="ehā" xml:lang="hbo">הָ