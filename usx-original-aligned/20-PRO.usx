	<para style="p"><verse number="30" style="v" x-ref="PRO.1.30" sid="PRO 1:30" /><char style="w" x-id="WLC.PRO.1.30.001" x-align="PRO.1.30.a002" x-target-ids="t003" x-target="none" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.1.30.002" x-align="PRO.1.30.a001" x-target-ids="t001 t002" x-target="They would" x-target-head="t002" x-head="true" lemma="אָבָה" strong="H14" x-morph="Vqp3cp" x-gloss="they.yielded" x-translit="ʾāḇû" xml:lang="hbo">אָב֥וּ</char> <char style="w" x-id="WLC.PRO.1.30.003" x-align="PRO.1.30.a003" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PRO.1.30.004" x-align="PRO.1.30.a005" x-target-ids="t006" x-target="counsel" x-target-head="t006" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsc" x-gloss="advice" x-translit="ʿăṣāṯ" xml:lang="hbo">עֲצָתִ֑</char><char style="w" x-id="WLC.PRO.1.30.005" x-align="PRO.1.30.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.1.30.006" x-align="PRO.1.30.a006" x-target-ids="t007 t008" x-target="They despised" x-target-head="t008" x-head="true" lemma="נָאַץ" strong="H5006" x-morph="Vqp3cp" x-gloss="they.spurned" x-translit="nāʾăṣû" xml:lang="hbo">נָ֝אֲצ֗וּ</char> <char style="w" x-id="WLC.PRO.1.30.007" x-align="PRO.1.30.a007" x-target-ids="t009" x-target="all" x-target-head="t009" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PRO.1.30.008" x-align="PRO.1.30.a009" x-target-ids="t011" x-target="reproof" x-target-head="t011" x-head="true" lemma="תּוֹכַחַת" strong="H8433a" x-morph="Ncfsc" x-gloss="rebuke" x-translit=