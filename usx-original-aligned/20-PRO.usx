	<para style="p"><verse number="12" style="v" x-ref="PRO.3.12" x-added-alignments="PRO.3.12.a013" x-added-target-ids="t014" x-added-target="whom" sid="PRO 3:12" /><char style="w" x-id="WLC.PRO.3.12.001" x-align="PRO.3.12.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.3.12.002" x-align="PRO.3.12.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ" xml:lang="hbo">אֶ֥ת</char> <char style="w" x-id="WLC.PRO.3.12.003" x-align="PRO.3.12.a003" x-target-ids="t002" x-target="whom" x-target-head="t002" x-head="true" lemma="אֲשֶׁר" strong="H834" x-morph="Tr" x-gloss="[the.one].whom" x-translit="ʾăšer" xml:lang="hbo">אֲשֶׁ֣ר</char> <char style="w" x-id="WLC.PRO.3.12.004" x-align="PRO.3.12.a004" x-target-ids="t004" x-target="loveth" x-target-head="t004" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqi3ms" x-gloss="he.loves" x-translit="yeʾĕhaḇ" xml:lang="hbo">יֶאֱהַ֣ב</char> <char style="w" x-id="WLC.PRO.3.12.005" x-align="PRO.3.12.a005" x-target-ids="t003" x-target="Jehovah" x-target-head="t003" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PRO.3.12.006" x-align="PRO.3.12.a006" x-target-ids="t005 t006" x-target="he reproveth" x-target-head="t006" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhi3ms" x-gloss="he.reproves" x-translit="yôḵiyᵃḥ" xml:lang="hbo">יוֹכִ֑יחַ</char> <char style="w" x-id="WLC.PRO.3.12.007" x-align="PRO.3.12.a007" x-target-ids="t007" x-target="Even" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.3.12.008" x-align="PRO.3.12.a008" x-target-ids="t008" x-target="as" x-target-head="t008" x-head="true" lemma="כְּ" strong="H3