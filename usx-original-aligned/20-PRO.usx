	<para style="p"><verse number="16" style="v" x-ref="PRO.12.16" sid="PRO 12:16" /><char style="w" x-id="WLC.PRO.12.16.001" x-align="PRO.12.16.a001" x-target-ids="t001 t002" x-target="A fool’s" x-target-head="t002" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="a.fool" x-translit="ʾĕwiyl" xml:lang="hbo">אֱוִ֗יל</char> <char style="w" x-id="WLC.PRO.12.16.002" x-align="PRO.12.16.a002" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="on" x-translit="ba" xml:lang="hbo">בַּ֭</char><char style="w" x-id="WLC.PRO.12.16.003" x-align="PRO.12.16.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.12.16.004" x-align="PRO.12.16.a002" x-target-ids="t005" x-target="presently" x-target-head="t005" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsa" x-gloss="day" x-translit="yyôm" xml:lang="hbo">יּוֹם</char> <char style="w" x-id="WLC.PRO.12.16.005" x-align="PRO.12.16.a004" x-target-ids="t004 t006" x-target="is known" x-target-head="t006" x-head="true" lemma="יָדַע" strong="H3045" x-morph="VNi3ms" x-gloss="it.is.known" x-translit="yiwwāḏaʿ" xml:lang="hbo">יִוָּדַ֣ע</char> <char style="w" x-id="WLC.PRO.12.16.006" x-align="PRO.12.16.a005" x-target-ids="t003" x-target="vexation" x-target-head="t003" x-head="true" lemma="כַּעַס" strong="H3708" x-morph="Ncmsc" x-gloss="anger" x-translit="kaʿs" xml:lang="hbo">כַּעְס֑</char><char style="w" x-id="WLC.PRO.12.16.007" x-align="PRO.12.16.a006" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.12.16.008" x-align="PRO.12.16.a007" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.16.009" x-align="PRO.12.16.a008" x-target-ids="t011" x-target="con