	<para style="p"><verse number="27" style="v" x-ref="PRO.10.27" sid="PRO 10:27" /><char style="w" x-id="WLC.PRO.10.27.001" x-align="PRO.10.27.a001" x-target-ids="t001 t002" x-target="The fear" x-target-head="t002" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="the.fear" x-translit="yirʾaṯ" xml:lang="hbo">יִרְאַ֣ת</char> <char style="w" x-id="WLC.PRO.10.27.002" x-align="PRO.10.27.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.10.27.003" x-align="PRO.10.27.a003" x-target-ids="t005" x-target="prolongeth" x-target-head="t005" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhi3fs" x-gloss="it.adds" x-translit="tôsiyp̄" xml:lang="hbo">תּוֹסִ֣יף</char> <char style="w" x-id="WLC.PRO.10.27.004" x-align="PRO.10.27.a004" x-target-ids="t006" x-target="days" x-target-head="t006" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="days" x-translit="yāmiym" xml:lang="hbo">יָמִ֑ים</char> <char style="w" x-id="WLC.PRO.10.27.005" x-align="PRO.10.27.a005" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.27.006" x-align="PRO.10.27.a006" x-target-ids="t008 t009" x-target="the years" x-target-head="t009" x-head="true" lemma="שָׁנָה" strong="H8141" x-morph="Ncfpc" x-gloss="years" x-translit="šənôṯ" xml:lang="hbo">שְׁנ֖וֹת</char> <char style="w" x-id="WLC.PRO.10.27.007" x-align="PRO.10.27.a007" x-target-ids="t010 t011 t012" x-target="of the wicked" x-target-head="t012" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.10.27.008" x-align="PRO.10.27.a008" x-target-ids="t013 t014 t015" x-target="shall b