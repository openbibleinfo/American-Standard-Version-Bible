	<para style="p"><verse number="16" style="v" x-ref="PRO.11.16" sid="PRO 11:16" /><char style="w" x-id="WLC.PRO.11.16.001" x-align="PRO.11.16.a001" x-target-ids="t001 t003" x-target="A woman" x-target-head="t003" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsc" x-gloss="a.woman" x-translit="ʾēšeṯ-" xml:lang="hbo">אֵֽשֶׁת</char>־<char style="w" x-id="WLC.PRO.11.16.002" x-align="PRO.11.16.a002" x-target-ids="t002" x-target="gracious" x-target-head="t002" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="of.grace" x-translit="ḥēn" xml:lang="hbo">חֵ֭ן</char> <char style="w" x-id="WLC.PRO.11.16.003" x-align="PRO.11.16.a003" x-target-ids="t004" x-target="obtaineth" x-target-head="t004" x-head="true" lemma="תָּמַךְ" strong="H8551" x-morph="Vqi3fs" x-gloss="she.lays.hold.of" x-translit="tiṯmōḵ" xml:lang="hbo">תִּתְמֹ֣ךְ</char> <char style="w" x-id="WLC.PRO.11.16.004" x-align="PRO.11.16.a004" x-target-ids="t005" x-target="honor" x-target-head="t005" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="honor" x-translit="kāḇôḏ" xml:lang="hbo">כָּב֑וֹד</char> <char style="w" x-id="WLC.PRO.11.16.005" x-align="PRO.11.16.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.11.16.006" x-align="PRO.11.16.a006" x-target-ids="t007 t008" x-target="violent men" x-target-head="t007" x-head="true" lemma="עָרִיץ" strong="H6184" x-morph="Aampa" x-gloss="ruthless.[people]" x-translit="ʿārîṣiym" xml:lang="hbo">עָרִיצִ֗ים</char> <char style="w" x-id="WLC.PRO.11.16.007" x-align="PRO.11.16.a007" x-target-ids="t009" x-target="obtain" x-target-head="t009" x-head="true" lemma="תָּמַךְ" strong="H8551" x-morph="Vqi3mp" x-gloss="they.take.hold.of" x-translit="yiṯməḵû-" xml:lang="hbo">יִתְמְכוּ</char>־<char style="w" x-id="WLC.PRO.11.16.008" x-align="PRO.11.16.a008" x-target-ids="t010" x-target="riches" x-target-h