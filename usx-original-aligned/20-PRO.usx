	<para style="p"><verse number="22" style="v" x-ref="PRO.12.22" sid="PRO 12:22" /><char style="w" x-id="WLC.PRO.12.22.001" x-align="PRO.12.22.a001" x-target-ids="t003 t004 t005" x-target="are an abomination" x-target-head="t005" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[are].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.12.22.002" x-align="PRO.12.22.a002" x-target-ids="t006 t007" x-target="to Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.12.22.003" x-align="PRO.12.22.a003" x-target-ids="t002" x-target="lips" x-target-head="t002" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śip̄ṯê-" xml:lang="hbo">שִׂפְתֵי</char>־<char style="w" x-id="WLC.PRO.12.22.004" x-align="PRO.12.22.a004" x-target-ids="t001" x-target="Lying" x-target-head="t001" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāqer" xml:lang="hbo">שָׁ֑קֶר</char> <char style="w" x-id="WLC.PRO.12.22.005" x-align="PRO.12.22.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.22.006" x-align="PRO.12.22.a006" x-target-ids="t009 t010 t011" x-target="they that deal" x-target-head="t011" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmpc" x-gloss="[those.who].do" x-translit="ʿōśēy" xml:lang="hbo">עֹשֵׂ֖י</char> <char style="w" x-id="WLC.PRO.12.22.007" x-align="PRO.12.22.a007" x-target-ids="t012" x-target="truly" x-target-head="t012" x-head="true" lemma="אֱמוּנָה" strong="H530" x-morph="Ncfsa" x-gloss="(of).faithfulness" x-translit="ʾĕmûnāh" xml:lang="hbo">אֱמוּנָ֣ה</char> <char style="w" x-id="WLC.PRO.12.22.008" x-align="PRO.12.22.a008" x-target-ids="t013