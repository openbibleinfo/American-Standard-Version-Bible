	<para style="p"><verse number="1" style="v" x-ref="PRO.29.1" x-added-alignments="PRO.29.1.a004 PRO.29.1.a009" x-added-target-ids="t007 t014" x-added-target="his | that" sid="PRO 29:1" /><char style="w" x-id="WLC.PRO.29.1.001" x-align="PRO.29.1.a001" x-target-ids="t001" x-target="He" x-target-head="t001" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.29.1.002" x-align="PRO.29.1.a002" x-target-ids="t003 t004 t005" x-target="being often reproved" x-target-head="t005" x-head="true" lemma="תּוֹכַחַת" strong="H8433a" x-morph="Ncfpa" x-gloss="of.rebukes" x-translit="tôḵāḥôṯ" xml:lang="hbo">תּ֭וֹכָחוֹת</char> <char style="w" x-id="WLC.PRO.29.1.003" x-align="PRO.29.1.a003" x-target-ids="t002 t006" x-target="that hardeneth" x-target-head="t006" x-head="true" lemma="קָשָׁה" strong="H7185" x-morph="Vhrmsa" x-gloss="[who].stiffens" x-translit="maqšeh-" xml:lang="hbo">מַקְשֶׁה</char>־<char style="w" x-id="WLC.PRO.29.1.004" x-align="PRO.29.1.a005" x-target-ids="t008" x-target="neck" x-target-head="t008" x-head="true" lemma="עֹרֶף" strong="H6203" x-morph="Ncmsa" x-gloss="a.neck" x-translit="ʿōrep̄" xml:lang="hbo">עֹ֑רֶף</char> <char style="w" x-id="WLC.PRO.29.1.005" x-align="PRO.29.1.a006" x-target-ids="t010" x-target="suddenly" x-target-head="t010" x-head="true" lemma="פֶּתַע" strong="H6621" x-morph="D" x-gloss="suddenness" x-translit="peṯaʿ" xml:lang="hbo">פֶּ֥תַע</char> <char style="w" x-id="WLC.PRO.29.1.006" x-align="PRO.29.1.a007" x-target-ids="t009 t011 t012" x-target="Shall be destroyed" x-target-head="t012" x-head="true" lemma="שָׁבַר" strong="H7665" x-morph="VNi3ms" x-gloss="he.will.be.broken" x-translit="yiššāḇēr" xml:lang="hbo">יִ֝שָּׁבֵ֗ר</char> <char style="w" x-id="WLC.PRO.29.1.007" x-align="PRO.29.1.a008" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</