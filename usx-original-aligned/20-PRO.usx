	<para style="p"><verse number="21" style="v" x-ref="PRO.8.21" sid="PRO 8:21" /><char style="w" x-id="WLC.PRO.8.21.001" x-align="PRO.8.21.a001" x-target-ids="t001 t013" x-target="That that" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.8.21.002" x-align="PRO.8.21.a002" x-target-ids="t002 t003 t004 t009 t010" x-target="I may cause to inherit" x-target-head="t010" x-head="true" lemma="נָחַל" strong="H5157" x-morph="Vhc" x-gloss="give.as.an.inheritance" x-translit="hanḥiyl" xml:lang="hbo">הַנְחִ֖יל</char> <char style="w" x-id="WLC.PRO.8.21.003" x-align="PRO.8.21.a003" x-target-ids="t005 t006 t007" x-target="those that love" x-target-head="t007" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmpc" x-gloss="[those" x-translit="ʾōhăḇ" xml:lang="hbo">אֹהֲבַ֥</char><char style="w" x-id="WLC.PRO.8.21.004" x-align="PRO.8.21.a004" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="who].love.me" x-translit="ay" xml:lang="hbo">י</char>׀<char style="w" x-id="WLC.PRO.8.21.005" x-align="PRO.8.21.a005" x-target-ids="t011" x-target="substance" x-target-head="t011" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="substance" x-translit="yēš" xml:lang="hbo">יֵ֑שׁ</char> <char style="w" x-id="WLC.PRO.8.21.006" x-align="PRO.8.21.a006" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.8.21.007" x-align="PRO.8.21.a007" x-target-ids="t018" x-target="treasuries" x-target-head="t018" x-head="true" lemma="אוֹצָר" strong="H214" x-morph="Ncmpc" x-gloss="treasuries" x-translit="ʾōṣərōṯēy" xml:lang="hbo">אֹצְרֹ֖תֵי</char><char style="w" x-id="WLC.PRO.8.21.008" x-align="PRO.8.21.a008" x-target-ids="t017" x-target="their" x-target-head="t017" x-head="true" lem