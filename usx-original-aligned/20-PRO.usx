	<para style="p"><verse number="11" style="v" x-ref="PRO.22.11" x-added-alignments="PRO.22.11.a004" x-added-target-ids="t007" x-added-target="For" sid="PRO 22:11" /><char style="w" x-id="WLC.PRO.22.11.001" x-align="PRO.22.11.a001" x-target-ids="t001 t002 t003" x-target="He that loveth" x-target-head="t003" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqrmsa" x-gloss="[one.who].loves" x-translit="ʾōhēḇ" xml:lang="hbo">אֹהֵ֥ב</char> <char style="w" x-id="WLC.PRO.22.11.002" x-align="PRO.22.11.a002" x-target-ids="t004" x-target="pureness" x-target-head="t004" x-head="true" lemma="טָהֹר" strong="H2889" x-morph="Aamsc" x-gloss="pure" x-translit="**ṭəhār-" xml:lang="hbo">טְהָר</char>־<char style="w" x-id="WLC.PRO.22.11.003" x-align="PRO.22.11.a003" x-target-ids="t005 t006" x-target="of heart" x-target-head="t006" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.22.11.004" x-align="PRO.22.11.a005" x-target-ids="t008 t009" x-target="the grace" x-target-head="t009" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsc" x-gloss="[who].[are].grace" x-translit="ḥēn" xml:lang="hbo">חֵ֥ן</char> <char style="w" x-id="WLC.PRO.22.11.005" x-align="PRO.22.11.a006" x-target-ids="t010 t012" x-target="of lips" x-target-head="t012" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śəp̄āṯāy" xml:lang="hbo">שְׂ֝פָתָ֗י</char><char style="w" x-id="WLC.PRO.22.11.006" x-align="PRO.22.11.a007" x-target-ids="t011" x-target="his" x-target-head="t011" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.22.11.007" x-align="PRO.22.11.a009" x-target-ids="t015 t016 t018" x-target="will be friend" x-target-head="t018" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="friend" x-translit="rēʿ" xml:lang="hbo">רֵעֵ֥</char><char style="w" x-id="WLC.PRO.22.11.00