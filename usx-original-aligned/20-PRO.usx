	<para style="p"><verse number="33" style="v" x-ref="PRO.14.33" x-added-alignments="PRO.14.33.a007" x-added-target-ids="t012 t013 t014" x-added-target="that which is" sid="PRO 14:33" /><char style="w" x-id="WLC.PRO.14.33.001" x-align="PRO.14.33.a001" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.14.33.002" x-align="PRO.14.33.a002" x-target-ids="t004 t005" x-target="the heart" x-target-head="t005" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="a.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֣ב</char> <char style="w" x-id="WLC.PRO.14.33.003" x-align="PRO.14.33.a003" x-target-ids="t006 t007 t008 t009 t010" x-target="of him that hath understanding" x-target-head="t010" x-head="true" lemma="בִּין" strong="H995" x-morph="VNrmsa" x-gloss="discerning" x-translit="nāḇôn" xml:lang="hbo">נָ֭בוֹן</char> <char style="w" x-id="WLC.PRO.14.33.004" x-align="PRO.14.33.a004" x-target-ids="t002" x-target="resteth" x-target-head="t002" x-head="true" lemma="נוּחַ" strong="H5117" x-morph="Vqi3fs" x-gloss="it.rests" x-translit="tānûᵃḥ" xml:lang="hbo">תָּנ֣וּחַ</char> <char style="w" x-id="WLC.PRO.14.33.005" x-align="PRO.14.33.a005" x-target-ids="t001" x-target="Wisdom" x-target-head="t001" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.14.33.006" x-align="PRO.14.33.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.14.33.007" x-align="PRO.14.33.a008" x-target-ids="t015" x-target="in" x-target-head="t015" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.14.33.008" x-align="PRO.14.33.a009" x-tar