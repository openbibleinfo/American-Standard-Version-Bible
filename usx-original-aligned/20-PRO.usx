	<para style="p"><verse number="24" style="v" x-ref="PRO.22.24" sid="PRO 22:24" /><char style="w" x-id="WLC.PRO.22.24.001" x-align="PRO.22.24.a002" x-target-ids="t002" x-target="no" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.22.24.002" x-align="PRO.22.24.a001" x-target-ids="t001 t003" x-target="Make friendship" x-target-head="t003" x-head="true" lemma="רָעָה" strong="H7462a" x-morph="Vtj2ms" x-gloss="associate" x-translit="tiṯraʿ" xml:lang="hbo">תִּ֭תְרַע</char> <char style="w" x-id="WLC.PRO.22.24.003" x-align="PRO.22.24.a003" x-target-ids="t004" x-target="with" x-target-head="t004" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.22.24.004" x-align="PRO.22.24.a004" x-target-ids="t005 t006 t007 t008 t009 t010" x-target="a man that is given to" x-target-head="t009" x-head="true" lemma="בַּעַל" strong="H1167" x-morph="Ncmsc" x-gloss="a.master" x-translit="baʿal" xml:lang="hbo">בַּ֣עַל</char> <char style="w" x-id="WLC.PRO.22.24.005" x-align="PRO.22.24.a005" x-target-ids="t011" x-target="anger" x-target-head="t011" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsa" x-gloss="of.anger" x-translit="ʾāp̄" xml:lang="hbo">אָ֑ף</char> <char style="w" x-id="WLC.PRO.22.24.006" x-align="PRO.22.24.a006" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.22.24.007" x-align="PRO.22.24.a007" x-target-ids="t013" x-target="with" x-target-head="t013" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.22.24.008" x-align="PRO.22.24.a008" x-target-ids="t014 t016" x-target="a man" x-target-head="t016" x-head="true" lemma="אִישׁ" strong="H376" x-mor