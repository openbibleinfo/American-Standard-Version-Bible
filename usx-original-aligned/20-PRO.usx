	<para style="p"><verse number="27" style="v" x-ref="PRO.26.27" sid="PRO 26:27" /><char style="w" x-id="WLC.PRO.26.27.001" x-align="PRO.26.27.a001" x-target-ids="t001 t002" x-target="Whoso diggeth" x-target-head="t002" x-head="true" lemma="כָּרָה" strong="H3738" x-morph="Vqrmsa" x-gloss="[one.who].digs" x-translit="kōreh-" xml:lang="hbo">כֹּֽרֶה</char>־<char style="w" x-id="WLC.PRO.26.27.002" x-align="PRO.26.27.a002" x-target-ids="t003 t004" x-target="a pit" x-target-head="t004" x-head="true" lemma="שַׁחַת" strong="H7845" x-morph="Ncfsa" x-gloss="a.pit" x-translit="ššaḥaṯ" xml:lang="hbo">שַּׁ֭חַת</char> <char style="w" x-id="WLC.PRO.26.27.003" x-align="PRO.26.27.a003" x-target-ids="t007" x-target="therein" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="b" xml:lang="hbo">בָּ֣</char><char style="w" x-id="WLC.PRO.26.27.004" x-align="PRO.26.27.a003" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="it" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.26.27.005" x-align="PRO.26.27.a004" x-target-ids="t005 t006" x-target="shall fall" x-target-head="t006" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="he.will.fall" x-translit="yippōl" xml:lang="hbo">יִפֹּ֑ל</char> <char style="w" x-id="WLC.PRO.26.27.006" x-align="PRO.26.27.a005" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.26.27.007" x-align="PRO.26.27.a006" x-target-ids="t009 t010 t011" x-target="he that rolleth" x-target-head="t011" x-head="true" lemma="גָּלַל" strong="H1556" x-morph="Vqrmsa" x-gloss="[one.who].rolls" x-translit="ḡōlēl" xml:lang="hbo">גֹ֥לֵ֥ל</char> <char style="w" x-id="WLC.PRO.26.27.008" x-align="PRO.26.27.a007" x-target-ids="t012 t013" x-target="a stone" x-target-head="t013" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="a.stone" x-transl