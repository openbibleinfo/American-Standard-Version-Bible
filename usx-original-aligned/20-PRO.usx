	<para style="p"><verse number="25" style="v" x-ref="PRO.24.25" x-added-alignments="PRO.24.25.a012" x-added-target-ids="t006" x-added-target="him" sid="PRO 24:25" /><char style="w" x-id="WLC.PRO.24.25.001" x-align="PRO.24.25.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.24.25.002" x-align="PRO.24.25.a002" x-target-ids="t002" x-target="to" x-target-head="t002" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PRO.24.25.003" x-align="PRO.24.25.a003" x-target-ids="t003 t004" x-target="them that" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.24.25.004" x-align="PRO.24.25.a004" x-target-ids="t005" x-target="rebuke" x-target-head="t005" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhrmpa" x-gloss="who].rebuke.[him]" x-translit="mmôḵîḥiym" xml:lang="hbo">מּוֹכִיחִ֥ים</char> <char style="w" x-id="WLC.PRO.24.25.005" x-align="PRO.24.25.a005" x-target-ids="t007 t008 t009" x-target="shall be delight" x-target-head="t009" x-head="true" lemma="נָעֵם" strong="H5276" x-morph="Vqi3ms" x-gloss="it.will.be.pleasant" x-translit="yinʿām" xml:lang="hbo">יִנְעָ֑ם</char> <char style="w" x-id="WLC.PRO.24.25.006" x-align="PRO.24.25.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַֽ֝</char><char style="w" x-id="WLC.PRO.24.25.007" x-align="PRO.24.25.a007" x-target-ids="t016" x-target="upon" x-target-head="t016" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿălēy" xml:lang="hbo">עֲלֵי</char><char style="w" x-id="WLC.PRO.24.25.008" x-align="PRO.24.25.a008" x-target-ids="t017" x-target="them" x-tar