	<para style="p"><verse number="13" style="v" x-ref="PRO.9.13" sid="PRO 9:13" /><char style="w" x-id="WLC.PRO.9.13.001" x-align="PRO.9.13.a001" x-target-ids="t001 t003 t006" x-target="The woman She" x-target-italic-ids="t006" x-target-head="t003" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsc" x-gloss="a.woman" x-translit="ʾēšeṯ" xml:lang="hbo">אֵ֣שֶׁת</char> <char style="w" x-id="WLC.PRO.9.13.002" x-align="PRO.9.13.a002" x-target-ids="t002" x-target="foolish" x-target-head="t002" x-head="true" lemma="כְּסִילוּת" strong="H3687" x-morph="Ncfsa" x-gloss="of.folly" x-translit="kəsîlûṯ" xml:lang="hbo">כְּ֭סִילוּת</char> <char style="w" x-id="WLC.PRO.9.13.003" x-align="PRO.9.13.a003" x-target-ids="t004 t005" x-target="is clamorous" x-target-head="t005" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqrfsa" x-gloss="[is].boisterous" x-translit="hōmiyyāh" xml:lang="hbo">הֹֽמִיָּ֑ה</char> <char style="w" x-id="WLC.PRO.9.13.004" x-align="PRO.9.13.a004" x-target-ids="t007 t008" x-target="is simple" x-target-italic-ids="t007" x-target-head="t008" x-head="true" lemma="פְּתַיּוּת" strong="H6615" x-morph="Ncfsa" x-gloss="naiveté" x-translit="pəṯayyûṯ" xml:lang="hbo">פְּ֝תַיּ֗וּת</char> <char style="w" x-id="WLC.PRO.9.13.005" x-align="PRO.9.13.a005" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.9.13.006" x-align="PRO.9.13.a006" x-target-ids="t011" x-target="nothing" x-target-head="t011" x-head="true" lemma="בַּל" strong="H1077" x-morph="Tn" x-gloss="not" x-translit="ḇal-" xml:lang="hbo">בַל</char>־<char style="w" x-id="WLC.PRO.9.13.007" x-align="PRO.9.13.a007" x-target-ids="t010" x-target="knoweth" x-target-head="t010" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqp3fs" x-gloss="she.knows" x-translit="yāḏəʿâ" xml:lang="hbo">יָ֥דְעָה</char> <char style="w" x-id="WLC.PRO.9.13.008" x-align="PRO.9.13.a006" lemma="מָה