	<para style="p"><verse number="2" style="v" x-ref="PRO.16.2" sid="PRO 16:2" /><char style="w" x-id="WLC.PRO.16.2.001" x-align="PRO.16.2.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kāl-" xml:lang="hbo">כָּֽל</char>־<char style="w" x-id="WLC.PRO.16.2.002" x-align="PRO.16.2.a002" x-target-ids="t002 t003" x-target="the ways" x-target-head="t003" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="[the].ways" x-translit="darḵê-" xml:lang="hbo">דַּרְכֵי</char>־<char style="w" x-id="WLC.PRO.16.2.003" x-align="PRO.16.2.a003" x-target-ids="t004 t005 t006" x-target="of a man" x-target-head="t006" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾîš" xml:lang="hbo">אִ֭ישׁ</char> <char style="w" x-id="WLC.PRO.16.2.004" x-align="PRO.16.2.a004" x-target-ids="t007 t008" x-target="are clean" x-target-head="t008" x-head="true" lemma="זַךְ" strong="H2134" x-morph="Aamsa" x-gloss="[are].pure" x-translit="zaḵ" xml:lang="hbo">זַ֣ךְ</char> <char style="w" x-id="WLC.PRO.16.2.005" x-align="PRO.16.2.a005" x-target-ids="t009" x-target="in" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.16.2.006" x-align="PRO.16.2.a007" x-target-ids="t012" x-target="eyes" x-target-head="t012" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="his.own" x-translit="ʿēynāy" xml:lang="hbo">עֵינָ֑י</char><char style="w" x-id="WLC.PRO.16.2.007" x-align="PRO.16.2.a006" x-target-ids="t010 t011" x-target="his own" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="eyes" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.16.2.008" x-align="PRO.16.2.a008" x-target-ids="t013" x-target="But" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is