	<para style="p"><verse number="20" style="v" x-ref="PRO.11.20" x-added-alignments="PRO.11.20.a008" x-added-target-ids="t018" x-added-target="their" sid="PRO 11:20" /><char style="w" x-id="WLC.PRO.11.20.001" x-align="PRO.11.20.a003" x-target-ids="t007 t008 t009" x-target="are an abomination" x-target-head="t009" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[are].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.11.20.002" x-align="PRO.11.20.a004" x-target-ids="t010 t011" x-target="to Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.11.20.003" x-align="PRO.11.20.a001" x-target-ids="t001 t002 t003 t004" x-target="They that are perverse" x-target-head="t004" x-head="true" lemma="עִקֵּשׁ" strong="H6141" x-morph="Aampc" x-gloss="[people].perverse" x-translit="ʿiqqəšê-" xml:lang="hbo">עִקְּשֵׁי</char>־<char style="w" x-id="WLC.PRO.11.20.004" x-align="PRO.11.20.a002" x-target-ids="t005 t006" x-target="in heart" x-target-head="t006" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.11.20.005" x-align="PRO.11.20.a005" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[are]" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.11.20.006" x-align="PRO.11.20.a009" x-target-ids="t020 t022" x-target="are delight" x-target-head="t022" x-head="true" lemma="רָצוֹן" strong="H7522" x-morph="Ncmsc" x-gloss="pleasure" x-translit="rəṣôn" xml:lang="hbo">רְצוֹנ֗</char><char style="w" x-id="WLC.PRO.11.20.007" x-align="PRO.11.20.a010" x-target-ids="t021" x-target="his" x-target-head="t021" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</c