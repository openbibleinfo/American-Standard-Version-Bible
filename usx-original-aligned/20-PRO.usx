	<para style="p"><verse number="28" style="v" x-ref="PRO.11.28" sid="PRO 11:28" /><char style="w" x-id="WLC.PRO.11.28.001" x-align="PRO.11.28.a001" x-target-ids="t001 t002 t003" x-target="He that trusteth" x-target-head="t003" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqrmsa" x-gloss="[one.who].trusts" x-translit="bôṭēᵃḥ" xml:lang="hbo">בּוֹטֵ֣חַ</char> <char style="w" x-id="WLC.PRO.11.28.002" x-align="PRO.11.28.a002" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.11.28.003" x-align="PRO.11.28.a003" x-target-ids="t006" x-target="riches" x-target-head="t006" x-head="true" lemma="עֹשֶׁר" strong="H6239" x-morph="Ncmsc" x-gloss="wealth" x-translit="ʿāšər" xml:lang="hbo">עָשְׁר</char><char style="w" x-id="WLC.PRO.11.28.004" x-align="PRO.11.28.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.11.28.005" x-align="PRO.11.28.a005" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֣וּא</char> <char style="w" x-id="WLC.PRO.11.28.006" x-align="PRO.11.28.a006" x-target-ids="t007 t008" x-target="shall fall" x-target-head="t008" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="he.will.fall" x-translit="yippōl" xml:lang="hbo">יִפֹּ֑ל</char> <char style="w" x-id="WLC.PRO.11.28.007" x-align="PRO.11.28.a007" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.11.28.008" x-align="PRO.11.28.a008" x-target-ids="t014" x-target="as" x-target-head="t014" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like" x-translit="ḵe" xml:lang="