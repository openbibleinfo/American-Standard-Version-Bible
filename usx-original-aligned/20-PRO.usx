	<para style="p"><verse number="13" style="v" x-ref="PRO.10.13" sid="PRO 10:13" /><char style="w" x-id="WLC.PRO.10.13.001" x-align="PRO.10.13.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.10.13.002" x-align="PRO.10.13.a002" x-target-ids="t002 t003" x-target="the lips" x-target-head="t003" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śip̄ṯēy" xml:lang="hbo">שִׂפְתֵ֣י</char> <char style="w" x-id="WLC.PRO.10.13.003" x-align="PRO.10.13.a003" x-target-ids="t004 t005 t006 t007 t008" x-target="of him that hath discernment" x-target-head="t008" x-head="true" lemma="בִּין" strong="H995" x-morph="VNrmsa" x-gloss="of.[one.who].has.understanding" x-translit="nāḇôn" xml:lang="hbo">נָ֭בוֹן</char> <char style="w" x-id="WLC.PRO.10.13.004" x-align="PRO.10.13.a004" x-target-ids="t010 t011" x-target="is found" x-target-head="t011" x-head="true" lemma="מָצָא" strong="H4672" x-morph="VNi3fs" x-gloss="it.is.found" x-translit="timmāṣēʾ" xml:lang="hbo">תִּמָּצֵ֣א</char> <char style="w" x-id="WLC.PRO.10.13.005" x-align="PRO.10.13.a005" x-target-ids="t009" x-target="wisdom" x-target-head="t009" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.10.13.006" x-align="PRO.10.13.a006" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.10.13.007" x-align="PRO.10.13.a007" x-target-ids="t013 t014" x-target="a rod" x-target-head="t014" x-head="true" lemma="שֵׁבֶט" strong="H7626" x-morph="Ncmsa" x-gloss="a.rod" x-translit="šēḇeṭ" xml:lang="hbo">שֵׁ֗בֶט</char> <char style="w" x-id="WLC.PRO.10.13.008" x-align="PRO.10.13.a008" x-target-ids="t015 t016" x-target="