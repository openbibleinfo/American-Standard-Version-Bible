	<para style="p"><verse number="20" style="v" x-ref="PRO.24.20" sid="PRO 24:20" /><char style="w" x-id="WLC.PRO.24.20.001" x-align="PRO.24.20.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char>׀<char style="w" x-id="WLC.PRO.24.20.002" x-align="PRO.24.20.a002" x-target-ids="t005" x-target="no" x-target-head="t005" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.24.20.003" x-align="PRO.24.20.a003" x-target-ids="t002 t003 t004" x-target="there shall be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqi3fs" x-gloss="it.will.belong" x-translit="ṯihyeh" xml:lang="hbo">תִהְיֶ֣ה</char> <char style="w" x-id="WLC.PRO.24.20.004" x-align="PRO.24.20.a004" x-target-ids="t006" x-target="reward" x-target-head="t006" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsa" x-gloss="a.future" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִ֣ית</char> <char style="w" x-id="WLC.PRO.24.20.005" x-align="PRO.24.20.a005" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.24.20.006" x-align="PRO.24.20.a006" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the.evil" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.24.20.007" x-align="PRO.24.20.a007" x-target-ids="t009 t010" x-target="evil man" x-target-head="t009" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="[person]" x-translit="rāʿ" xml:lang="hbo">רָ֑ע</char> <char style="w" x-id="WLC.PRO.24.20.008" x-align="PRO.24.20.a008" x-target-ids="t011 t012" x-target="The lamp" x-target-head="t012" x-head="true" lemma="נֵר" strong="H5216" x-morph="Ncmsc" x-