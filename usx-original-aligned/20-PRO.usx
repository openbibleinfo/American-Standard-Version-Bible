	<para style="p"><verse number="14" style="v" x-ref="PRO.9.14" sid="PRO 9:14" /><char style="w" x-id="WLC.PRO.9.14.001" x-align="PRO.9.14.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ֭</char><char style="w" x-id="WLC.PRO.9.14.002" x-align="PRO.9.14.a002" x-target-ids="t002 t003" x-target="she sitteth" x-target-head="t003" x-head="true" lemma="יָשַׁב" strong="H3427" x-morph="Vqp3fs" x-gloss="she.sits" x-translit="yāšəḇâ" xml:lang="hbo">יָשְׁבָה</char> <char style="w" x-id="WLC.PRO.9.14.003" x-align="PRO.9.14.a003" x-target-ids="t004" x-target="at" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.9.14.004" x-align="PRO.9.14.a004" x-target-ids="t005 t006" x-target="the door" x-target-head="t006" x-head="true" lemma="פֶּתַח" strong="H6607" x-morph="Ncmsc" x-gloss="the.doorway" x-translit="p̄eṯaḥ" xml:lang="hbo">פֶ֣תַח</char> <char style="w" x-id="WLC.PRO.9.14.005" x-align="PRO.9.14.a005" x-target-ids="t007 t009" x-target="of house" x-target-head="t009" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="her.house" x-translit="bēyṯ" xml:lang="hbo">בֵּיתָ֑</char><char style="w" x-id="WLC.PRO.9.14.006" x-align="PRO.9.14.a006" x-target-ids="t008" x-target="her" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.9.14.007" x-align="PRO.9.14.a007" x-target-ids="t010" x-target="On" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.9.14.008" x-align="PRO.9.14.a008" x-target-ids="t011 t012" x-target="a seat" x-target-head="t012" x-head="true" lemma="כִּסֵּא" strong="H3678" x-morph="Ncmsa" x-gloss="a.seat" x-translit="ki