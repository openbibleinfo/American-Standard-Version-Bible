	<para style="p"><verse number="19" style="v" x-ref="PRO.19.19" x-added-alignments="PRO.19.19.a008 PRO.19.19.a012" x-added-target-ids="t014 t018" x-added-target="him | it" sid="PRO 19:19" /><char style="w" x-id="WLC.PRO.19.19.001" x-align="PRO.19.19.a001" x-target-ids="t001 t002 t004" x-target="A man great" x-target-head="t004" x-head="true" lemma="גָּדוֹל" strong="H1419" x-morph="Aamsc" x-gloss="a.[person].great" x-translit="**gəḏāl-" xml:lang="hbo">גְּֽדָל</char>־<char style="w" x-id="WLC.PRO.19.19.002" x-align="PRO.19.19.a002" x-target-ids="t003 t005" x-target="of wrath" x-target-head="t005" x-head="true" lemma="חֵמָה" strong="H2534" x-morph="Ncfsa" x-gloss="of.rage" x-translit="ḥēmâ" xml:lang="hbo">חֵ֭מָה</char> <char style="w" x-id="WLC.PRO.19.19.003" x-align="PRO.19.19.a003" x-target-ids="t006 t007" x-target="shall bear" x-target-head="t007" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqrmsa" x-gloss="[is].bearing" x-translit="nōśēʾ" xml:lang="hbo">נֹ֣שֵׂא</char> <char style="w" x-id="WLC.PRO.19.19.004" x-align="PRO.19.19.a004" x-target-ids="t008 t009" x-target="the penalty" x-target-head="t009" x-head="true" lemma="עֹנֶשׁ" strong="H6066" x-morph="Ncmsa" x-gloss="[the].fine" x-translit="ʿōneš" xml:lang="hbo">עֹ֑נֶשׁ</char> <char style="w" x-id="WLC.PRO.19.19.005" x-align="PRO.19.19.a005" x-target-ids="t010" x-target="For" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֥י</char> <char style="w" x-id="WLC.PRO.19.19.006" x-align="PRO.19.19.a006" x-target-ids="t011" x-target="if" x-target-head="t011" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.19.19.007" x-align="PRO.19.19.a007" x-target-ids="t012 t013" x-target="thou deliver" x-target-head="t013" x-head="true" lemma="נָצַל" strong="H5337" x-morph="Vhi2ms" x-gloss="you.will.rescue" x-translit="taṣṣiyl" xml:lang="hbo">תַּ֝צִּ֗יל</char> <char style="w" x-id="WLC.PRO.19.19.008" x-align="PRO.19.19.a009" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.19.009" x-align="PRO.19.19.a010" x-target-ids="t019" x-target="yet" x-target-head="t019" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="again" x-translit="ʿôḏ" xml:lang="hbo">ע֣וֹד</char> <char style="w" x-id="WLC.PRO.19.19.010" x-align="PRO.19.19.a011" x-target-ids="t015 t016 t017 t020" x-target="thou must do again" x-target-head="t020" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhi2ms" x-gloss="you.will.repeat" x-translit="tôsip̄:" xml:lang="hbo">תּוֹסִֽף</char>׃<verse eid="PRO 19:19" /></para>
	<para style="p"><verse number="20" style="v" x-ref="PRO.19.20" sid="PRO 19:20" /><char style="w" x-id="WLC.PRO.19.20.001" x-align="PRO.19.20.a001" x-target-ids="t001" x-target="Hear" x-target-head="t001" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqv2ms" x-gloss="listen.to" x-translit="šəmaʿ" xml:lang="hbo">שְׁמַ֣ע</char> <char style="w" x-id="WLC.PRO.19.20.002" x-align="PRO.19.20.a002" x-target-ids="t002" x-target="counsel" x-target-head="t002" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsa" x-gloss="counsel" x-translit="ʿēṣâ" xml:lang="hbo">עֵ֭צָה</char> <char style="w" x-id="WLC.PRO.19.20.003" x-align="PRO.19.20.a003" x-target-ids="t003" x-target="and" x-target-head="t003" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.20.004" x-align="PRO.19.20.a004" x-target-ids="t004" x-target="receive" x-target-head="t004" x-head="true" lemma="קָבַל" strong="H6901" x-morph="Vpv2ms" x-gloss="accept" x-translit="qabbēl" xml:lang="hbo">קַבֵּ֣ל</char> <char style="w" x-id="WLC.PRO.19.20.005" x-align="PRO.19.20.a005" x-target-ids="t005" x-target="instruction" x-target-head="t005" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsa" x-gloss="correction" x-translit="mûsār" xml:lang="hbo">מוּסָ֑ר</char> <char style="w" x-id="WLC.PRO.19.20.006" x-align="PRO.19.20.a006" x-target-ids="t006" x-target="That" x-target-head="t006" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="so.that" x-translit="ləmaʿan" xml:lang="hbo">לְ֝מַ֗עַן</char> <char style="w" x-id="WLC.PRO.19.20.007" x-align="PRO.19.20.a007" x-target-ids="t007 t008 t009 t010" x-target="thou mayest be wise" x-target-head="t010" x-head="true" lemma="חָכַם" strong="H2449" x-morph="Vqi2ms" x-gloss="you.may.become.wise" x-translit="teḥkam" xml:lang="hbo">תֶּחְכַּ֥ם</char> <char style="w" x-id="WLC.PRO.19.20.008" x-align="PRO.19.20.a008" x-target-ids="t011" x-target="in" x-target-head="t011" x-hea