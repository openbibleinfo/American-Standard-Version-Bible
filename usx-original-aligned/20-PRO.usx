	<para style="p"><verse number="21" style="v" x-ref="PRO.1.21" sid="PRO 1:21" /><char style="w" x-id="WLC.PRO.1.21.001" x-align="PRO.1.21.a002" x-target-ids="t003" x-target="in" x-target-head="t003" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.1.21.002" x-align="PRO.1.21.a003" x-target-ids="t004 t005 t006" x-target="the chief place" x-target-head="t005" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsc" x-gloss="top" x-translit="rōʾš" xml:lang="hbo">רֹ֥אשׁ</char> <char style="w" x-id="WLC.PRO.1.21.003" x-align="PRO.1.21.a004" x-target-ids="t007 t008" x-target="of concourse" x-target-head="t008" x-head="true" lemma="הָמָה" strong="H1993" x-morph="Vqrfpa" x-gloss="of.noisy.[places]" x-translit="hōmiyyôṯ" xml:lang="hbo">הֹמִיּ֗וֹת</char> <char style="w" x-id="WLC.PRO.1.21.004" x-align="PRO.1.21.a001" x-target-ids="t001 t002" x-target="She crieth" x-target-head="t002" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi3fs" x-gloss="she.calls.out" x-translit="tiqərāʾ" xml:lang="hbo">תִּ֫קְרָ֥א</char> <char style="w" x-id="WLC.PRO.1.21.005" x-align="PRO.1.21.a005" x-target-ids="t009" x-target="At" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.1.21.006" x-align="PRO.1.21.a006" x-target-ids="t010 t011" x-target="the entrance" x-target-head="t011" x-head="true" lemma="פֶּתַח" strong="H6607" x-morph="Ncmpc" x-gloss="entrances" x-translit="p̄iṯḥēy" xml:lang="hbo">פִתְחֵ֖י</char> <char style="w" x-id="WLC.PRO.1.21.007" x-align="PRO.1.21.a007" x-target-ids="t012 t013 t014" x-target="of the gates" x-target-head="t014" x-head="true" lemma="שַׁעַר" strong="H8179" x-morph="Ncmpa" x-gloss="of.[the].gates" x-translit="šəʿāriym" xml:lang="hbo">שְׁעָרִ֥ים</char> <char style="w" x-id="WLC.PRO.1.21.008" x-align="PRO.1.21.a008" x-target-ids="t015" x-target="In" x-ta