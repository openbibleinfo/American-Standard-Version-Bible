	<para style="p"><verse number="30" style="v" x-ref="PRO.14.30" sid="PRO 14:30" /><char style="w" x-id="WLC.PRO.14.30.001" x-align="PRO.14.30.a001" x-target-ids="t004 t005 t006" x-target="is the life" x-target-head="t006" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpc" x-gloss="[is].the.life" x-translit="ḥayyēy" xml:lang="hbo">חַיֵּ֣י</char> <char style="w" x-id="WLC.PRO.14.30.002" x-align="PRO.14.30.a002" x-target-ids="t007 t008 t009" x-target="of the flesh" x-target-head="t009" x-head="true" lemma="בָּשָׂר" strong="H1320" x-morph="Ncmpa" x-gloss="of.bodies" x-translit="ḇəśārîm" xml:lang="hbo">בְ֭שָׂרִים</char> <char style="w" x-id="WLC.PRO.14.30.003" x-align="PRO.14.30.a003" x-target-ids="t001 t003" x-target="A heart" x-target-head="t003" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="a.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֣ב</char> <char style="w" x-id="WLC.PRO.14.30.004" x-align="PRO.14.30.a004" x-target-ids="t002" x-target="tranquil" x-target-head="t002" x-head="true" lemma="מַרְפֵּא" strong="H4832a" x-morph="Ncmsa" x-gloss="of.health" x-translit="marpēʾ" xml:lang="hbo">מַרְפֵּ֑א</char> <char style="w" x-id="WLC.PRO.14.30.005" x-align="PRO.14.30.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.14.30.006" x-align="PRO.14.30.a006" x-target-ids="t012 t013 t014" x-target="is the rottenness" x-target-head="t014" x-head="true" lemma="רָקָב" strong="H7538" x-morph="Ncmsc" x-gloss="rottenness" x-translit="rəqaḇ" xml:lang="hbo">רְקַ֖ב</char> <char style="w" x-id="WLC.PRO.14.30.007" x-align="PRO.14.30.a007" x-target-ids="t015 t016 t017" x-target="of the bones" x-target-head="t017" x-head="true" lemma="עֶצֶם" strong="H6106" x-morph="Ncfpa" x-gloss="of.bones" x-translit="ʿăṣāmôṯ" xml:lang="hbo">עֲצָמ֣וֹת</char> <char style="w" x-id="WLC.PRO.14.30.008" x-align="PRO.14.30.a008" x-target-i