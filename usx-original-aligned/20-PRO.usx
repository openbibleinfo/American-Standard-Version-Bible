	<para style="p"><verse number="31" style="v" x-ref="PRO.10.31" sid="PRO 10:31" /><char style="w" x-id="WLC.PRO.10.31.001" x-align="PRO.10.31.a001" x-target-ids="t001 t002" x-target="The mouth" x-target-head="t002" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="the.mouth" x-translit="piy-" xml:lang="hbo">פִּֽי</char>־<char style="w" x-id="WLC.PRO.10.31.002" x-align="PRO.10.31.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.a.righteous.[person]" x-translit="ṣaddîq" xml:lang="hbo">צַ֭דִּיק</char> <char style="w" x-id="WLC.PRO.10.31.003" x-align="PRO.10.31.a003" x-target-ids="t006 t007" x-target="bringeth forth" x-target-head="t006" x-head="true" lemma="נוּב" strong="H5107" x-morph="Vqi3ms" x-gloss="it.will.bear.fruit" x-translit="yānûḇ" xml:lang="hbo">יָנ֣וּב</char> <char style="w" x-id="WLC.PRO.10.31.004" x-align="PRO.10.31.a004" x-target-ids="t008" x-target="wisdom" x-target-head="t008" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.10.31.005" x-align="PRO.10.31.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.31.006" x-align="PRO.10.31.a006" x-target-ids="t010 t012" x-target="the tongue" x-target-head="t012" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="a.tongue" x-translit="ləšôn" xml:lang="hbo">לְשׁ֥וֹן</char> <char style="w" x-id="WLC.PRO.10.31.007" x-align="PRO.10.31.a007" x-target-ids="t011" x-target="perverse" x-target-head="t011" x-head="true" lemma="תַּהְפֻּכֹות" strong="H8419" x-morph="Ncfpa" x-gloss="of.perversiti(es)" x-translit="tahpuḵôṯ" xml:lang="hbo">תַּ֝הְפֻּכ֗וֹת</char> <char style="w" x-id="WLC.PRO.10.31.008" x-align="PRO.10.31.a008" x-t