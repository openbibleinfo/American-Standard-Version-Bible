	<para style="p"><verse number="28" style="v" x-ref="PRO.16.28" sid="PRO 16:28" /><char style="w" x-id="WLC.PRO.16.28.001" x-align="PRO.16.28.a001" x-target-ids="t001 t003" x-target="A man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.16.28.002" x-align="PRO.16.28.a002" x-target-ids="t002" x-target="perverse" x-target-head="t002" x-head="true" lemma="תַּהְפֻּכֹות" strong="H8419" x-morph="Ncfpa" x-gloss="of.perversiti(es)" x-translit="tahpuḵôṯ" xml:lang="hbo">תַּ֭הְפֻּכוֹת</char> <char style="w" x-id="WLC.PRO.16.28.003" x-align="PRO.16.28.a003" x-target-ids="t004 t005" x-target="scattereth abroad" x-target-head="t004" x-head="true" lemma="שָׁלַח" strong="H7971" x-morph="Vpi3ms" x-gloss="he.sends.out" x-translit="yəšallaḥ" xml:lang="hbo">יְשַׁלַּ֣ח</char> <char style="w" x-id="WLC.PRO.16.28.004" x-align="PRO.16.28.a004" x-target-ids="t006" x-target="strife" x-target-head="t006" x-head="true" lemma="מָדוֹן" strong="H4066" x-morph="Ncmsa" x-gloss="strife" x-translit="māḏôn" xml:lang="hbo">מָד֑וֹן</char> <char style="w" x-id="WLC.PRO.16.28.005" x-align="PRO.16.28.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.16.28.006" x-align="PRO.16.28.a006" x-target-ids="t008 t009" x-target="a whisperer" x-target-head="t009" x-head="true" lemma="רגן" strong="H5372" x-morph="VNrmsa" x-gloss="a.slanderer" x-translit="nirgān" xml:lang="hbo">נִרְגָּ֗ן</char><char style="w" x-id="WLC.PRO.16.28.007" x-align="PRO.16.28.a007" x-target-ids="t010" x-target="separateth" x-target-head="t010" x-head="true" lemma="פָּרַד" strong="H6504" x-morph="Vhrmsa" x-gloss="[is].separating" x-translit="map̄riyḏ" xml:lang="hbo">מַפְרִ֥יד</char> <char style="w" x-id="WLC.PRO.16.28.008" x-align="PRO.16.28.a008" x-target-ids="t011 t012