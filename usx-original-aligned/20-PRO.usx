	<para style="p"><verse number="7" style="v" x-ref="PRO.19.7" x-added-alignments="PRO.19.7.a013 PRO.19.7.a015" x-added-target-ids="t022 t025" x-added-target="them | but" sid="PRO 19:7" /><char style="w" x-id="WLC.PRO.19.7.001" x-align="PRO.19.7.a001" x-target-ids="t001" x-target="All" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="kāl" xml:lang="hbo">כָּ֥ל</char> <char style="w" x-id="WLC.PRO.19.7.002" x-align="PRO.19.7.a002" x-target-ids="t002 t003" x-target="the brethren" x-target-head="t003" x-head="true" lemma="אָח" strong="H251" x-morph="Ncmpc" x-gloss="[the].brothers" x-translit="ʾăḥê-" xml:lang="hbo">אֲחֵי</char>־<char style="w" x-id="WLC.PRO.19.7.003" x-align="PRO.19.7.a003" x-target-ids="t004 t005 t006" x-target="of the poor" x-target-head="t006" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="of.[one.who.is].poor" x-translit="rāš" xml:lang="hbo">רָ֨שׁ</char>׀<char style="w" x-id="WLC.PRO.19.7.004" x-align="PRO.19.7.a004" x-target-ids="t007 t008" x-target="do hate" x-target-head="t008" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqp3cp" x-gloss="they" x-translit="śənēʾu" xml:lang="hbo">שְֽׂנֵאֻ֗</char><char style="w" x-id="WLC.PRO.19.7.005" x-align="PRO.19.7.a005" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="hate.him" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.19.7.006" x-align="PRO.19.7.a006" x-target-ids="t010 t011 t012" x-target="How much more" x-target-head="t012" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="indeed?" x-translit="ʾap̄" xml:lang="hbo">אַ֤ף</char> <char style="w" x-id="WLC.PRO.19.7.007" x-align="PRO.19.7.a006" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PRO.19.7.008" x-align="PRO.19.7.a007" x-target-ids="t015" x-target="friends" x-target-head="t015" 