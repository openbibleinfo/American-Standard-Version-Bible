	<para style="p"><verse number="23" style="v" x-ref="PRO.16.23" sid="PRO 16:23" /><char style="w" x-id="WLC.PRO.16.23.001" x-align="PRO.16.23.a001" x-target-ids="t001 t002" x-target="The heart" x-target-head="t002" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="[the].heart" x-translit="lēḇ" xml:lang="hbo">לֵ֣ב</char> <char style="w" x-id="WLC.PRO.16.23.002" x-align="PRO.16.23.a002" x-target-ids="t003 t004 t005" x-target="of the wise" x-target-head="t005" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="of.a.wise.[person]" x-translit="ḥāḵām" xml:lang="hbo">חָ֭כָם</char> <char style="w" x-id="WLC.PRO.16.23.003" x-align="PRO.16.23.a003" x-target-ids="t006" x-target="instructeth" x-target-head="t006" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vhi3ms" x-gloss="it.gives.insight.to" x-translit="yaśkiyl" xml:lang="hbo">יַשְׂכִּ֣יל</char> <char style="w" x-id="WLC.PRO.16.23.004" x-align="PRO.16.23.a005" x-target-ids="t008" x-target="mouth" x-target-head="t008" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="piy" xml:lang="hbo">פִּ֑י</char><char style="w" x-id="WLC.PRO.16.23.005" x-align="PRO.16.23.a004" x-target-ids="t007" x-target="his" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.16.23.006" x-align="PRO.16.23.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.16.23.007" x-align="PRO.16.23.a009" x-target-ids="t012" x-target="to" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="to" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.16.23.008" x-align="PRO.16.23.a011" x-target-ids="t014" x-target="lips" x-target-head="t014" x-head="true" lemma="שָׂפָה" strong="H8193" x-mo