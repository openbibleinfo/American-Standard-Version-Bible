	<para style="p"><verse number="10" style="v" x-ref="PRO.20.10" x-added-alignments="PRO.20.10.a007" x-added-target-ids="t003" x-added-target="and" sid="PRO 20:10" /><char style="w" x-id="WLC.PRO.20.10.001" x-align="PRO.20.10.a001" x-target-ids="t001 t002" x-target="Diverse weights" x-target-head="t002" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="a.weight" x-translit="ʾeḇen" xml:lang="hbo">אֶ֣בֶן</char> <char style="w" x-id="WLC.PRO.20.10.002" x-align="PRO.20.10.a002" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ֭</char><char style="w" x-id="WLC.PRO.20.10.003" x-align="PRO.20.10.a003" x-status="unrepresented" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="a.weight" x-translit="ʾeḇen" xml:lang="hbo">אֶבֶן</char> <char style="w" x-id="WLC.PRO.20.10.004" x-align="PRO.20.10.a004" x-target-ids="t004 t005" x-target="diverse measures" x-target-head="t005" x-head="true" lemma="אֵיפָה" strong="H374" x-morph="Ncfsa" x-gloss="a.measure" x-translit="ʾêp̄āh" xml:lang="hbo">אֵיפָ֣ה</char> <char style="w" x-id="WLC.PRO.20.10.005" x-align="PRO.20.10.a005" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.20.10.006" x-align="PRO.20.10.a006" x-status="unrepresented" x-head="true" lemma="אֵיפָה" strong="H374" x-morph="Ncfsa" x-gloss="a.measure" x-translit="ʾêp̄āh" xml:lang="hbo">אֵיפָ֑ה</char> <char style="w" x-id="WLC.PRO.20.10.007" x-align="PRO.20.10.a011" x-target-ids="t010 t011 t012" x-target="are an abomination" x-target-head="t012" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[are].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֥ת</char> <char style="w" x-id="WLC.PRO.20.10.008" x-align="PRO.20.10.a012" x-target-ids="t013 t014" x-target="to Jehovah" x-target-head="t014" x-head="true" lemma="יהוה" strong="H3068