	<para style="p"><verse number="21" style="v" x-ref="PRO.20.21" sid="PRO 20:21" /><char style="w" x-id="WLC.PRO.20.21.001" x-align="PRO.20.21.a001" x-target-ids="t001 t002" x-target="An inheritance" x-target-head="t002" x-head="true" lemma="נַחֲלָה" strong="H5159" x-morph="Ncfsa" x-gloss="an.inheritance" x-translit="naḥălâ" xml:lang="hbo">נַ֭חֲלָה</char> <char style="w" x-id="WLC.PRO.20.21.002" x-align="PRO.20.21.a002" x-target-ids="t003 t004 t005 t006" x-target="may be gotten hastily" x-target-italic-ids="t003 t004" x-target-head="t006" x-head="true" lemma="בָּהַל" strong="H926" x-morph="VPsfsa" x-gloss="hastily.gained" x-translit="**məḇōheleṯ" xml:lang="hbo">מְבֹהֶ֣לֶת</char> <char style="w" x-id="WLC.PRO.20.21.003" x-align="PRO.20.21.a003" x-target-ids="t007" x-target="at" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="at" x-translit="bā" xml:lang="hbo">בָּ</char><char style="w" x-id="WLC.PRO.20.21.004" x-align="PRO.20.21.a004" x-target-ids="t008" x-target="the" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.20.21.005" x-align="PRO.20.21.a005" x-target-ids="t009" x-target="beginning" x-target-head="t009" x-head="true" lemma="רִאשׁוֹן" strong="H7223" x-morph="Aafsa" x-gloss="first" x-translit="riʾšōnāh" xml:lang="hbo">רִאשֹׁנָ֑ה</char> <char style="w" x-id="WLC.PRO.20.21.006" x-align="PRO.20.21.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.20.21.007" x-align="PRO.20.21.a007" x-target-ids="t011 t012" x-target="the end" x-target-head="t012" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="end" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִיתָ֗</char><char style="w" x-id="WLC.PRO.20.21.008" x-align="PRO.20.21.a008" x-target-ids="t013" x-target="t