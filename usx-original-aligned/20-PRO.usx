	<chapter number="14" style="c" sid="PRO 14" />
	<para style="p"><verse number="1" style="v" x-ref="PRO.14.1" sid="PRO 14:1" /><char style="w" x-id="WLC.PRO.14.1.001" x-align="PRO.14.1.a001" x-target-ids="t001 t002" x-target="Every wise" x-target-head="t002" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aafpc" x-gloss="wise.[women]" x-translit="ḥaḵmôṯ" xml:lang="hbo">חַכְמ֣וֹת</char> <char style="w" x-id="WLC.PRO.14.1.002" x-align="PRO.14.1.a002" x-target-ids="t003" x-target="woman" x-target-head="t003" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfpa" x-gloss="of.women" x-translit="nāšîm" xml:lang="hbo">נָ֭שִׁים</char> <char style="w" x-id="WLC.PRO.14.1.003" x-align="PRO.14.1.a003" x-target-ids="t004" x-target="buildeth" x-target-head="t004" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="Vqp3fs" x-gloss="she.builds" x-translit="bānəṯāh" xml:lang="hbo">בָּנְתָ֣ה</char> <char style="w" x-id="WLC.PRO.14.1.004" x-align="PRO.14.1.a004" x-target-ids="t006" x-target="house" x-target-head="t006" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="ḇēyṯ" xml:lang="hbo">בֵיתָ֑</char><char style="w" x-id="WLC.PRO.14.1.005" x-align="PRO.14.1.a005" x-target-ids="t005" x-target="her" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.14.1.006" x-align="PRO.14.1.a006" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.14.1.007" x-align="PRO.14.1.a007" x-target-ids="t008 t009" x-target="the foolish" x-target-head="t009" x-head="true" lemma="אִוֶּלֶת" strong="H200" x-morph="Ncfsa" x-gloss="folly" x-translit="ʾiwweleṯ" xml:lang="hbo">אִוֶּ֗לֶת</char> <char style="w" x-id="WLC.PRO.14.1.008" x-align="PRO.14.1.a008" x-target-ids="t013" x-target="with" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R"