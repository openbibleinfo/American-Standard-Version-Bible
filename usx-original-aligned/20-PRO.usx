	<para style="p"><verse number="29" style="v" x-ref="PRO.14.29" sid="PRO 14:29" /><char style="w" x-id="WLC.PRO.14.29.001" x-align="PRO.14.29.a001" x-target-ids="t001 t002 t003 t004" x-target="He that is slow" x-target-head="t004" x-head="true" lemma="אָרֵךְ" strong="H750" x-morph="Aamsc" x-gloss="a.[person].long" x-translit="ʾereḵ" xml:lang="hbo">אֶ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.14.29.002" x-align="PRO.14.29.a002" x-target-ids="t005 t006" x-target="to anger" x-target-head="t006" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmda" x-gloss="of.anger(s)" x-translit="ʾappayim" xml:lang="hbo">אַ֭פַּיִם</char> <char style="w" x-id="WLC.PRO.14.29.003" x-align="PRO.14.29.a003" x-target-ids="t007 t008 t009" x-target="is of great" x-target-head="t009" x-head="true" lemma="רַב" strong="H7227" x-morph="Aamsc" x-gloss="[is].great" x-translit="raḇ-" xml:lang="hbo">רַב</char>־<char style="w" x-id="WLC.PRO.14.29.004" x-align="PRO.14.29.a004" x-target-ids="t010" x-target="understanding" x-target-head="t010" x-head="true" lemma="תְּבוּנָה" strong="H8394" x-morph="Ncfsa" x-gloss="of.understanding" x-translit="təḇûnāh" xml:lang="hbo">תְּבוּנָ֑ה</char> <char style="w" x-id="WLC.PRO.14.29.005" x-align="PRO.14.29.a005" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.14.29.006" x-align="PRO.14.29.a006" x-target-ids="t012 t013 t014 t015" x-target="he that is hasty" x-target-head="t015" x-head="true" lemma="קָצֵר" strong="H7116" x-morph="Aamsc" x-gloss="[a.person].short" x-translit="qəṣar-" xml:lang="hbo">קְצַר</char>־<char style="w" x-id="WLC.PRO.14.29.007" x-align="PRO.14.29.a007" x-target-ids="t016 t017" x-target="of spirit" x-target-head="t017" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="of.spirit" x-translit="rûᵃḥ" xml:lang="hbo">ר֝֗וּחַ</char> <char style="w" x-id="WLC.PRO.14.29.008" x-align="PRO.14.29.a