	<para style="p"><verse number="13" style="v" x-ref="PRO.18.13" sid="PRO 18:13" /><char style="w" x-id="WLC.PRO.18.13.001" x-align="PRO.18.13.a001" x-target-ids="t001 t002 t003" x-target="He that giveth" x-target-head="t003" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhrmsa" x-gloss="[one.who].brings.back" x-translit="mēšiyḇ" xml:lang="hbo">מֵשִׁ֣יב</char> <char style="w" x-id="WLC.PRO.18.13.002" x-align="PRO.18.13.a002" x-target-ids="t004" x-target="answer" x-target-head="t004" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsa" x-gloss="a.word" x-translit="dāḇār" xml:lang="hbo">דָּ֭בָר</char> <char style="w" x-id="WLC.PRO.18.13.003" x-align="PRO.18.13.a003" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="before" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.18.13.004" x-align="PRO.18.13.a003" x-target-ids="t005" x-target="before" x-target-head="t005" x-head="true" lemma="טֶרֶם" strong="H2962" x-morph="D" x-translit="ṭerem" xml:lang="hbo">טֶ֣רֶם</char> <char style="w" x-id="WLC.PRO.18.13.005" x-align="PRO.18.13.a004" x-target-ids="t006 t007" x-target="he heareth" x-target-head="t007" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqi3ms" x-gloss="he.listens" x-translit="yišmāʿ" xml:lang="hbo">יִשְׁמָ֑ע</char> <char style="w" x-id="WLC.PRO.18.13.006" x-align="PRO.18.13.a006" x-target-ids="t009 t010" x-target="is folly" x-target-head="t010" x-head="true" lemma="אִוֶּלֶת" strong="H200" x-morph="Ncfsa" x-gloss="[is].folly" x-translit="ʾiwweleṯ" xml:lang="hbo">אִוֶּ֥לֶת</char> <char style="w" x-id="WLC.PRO.18.13.007" x-align="PRO.18.13.a005" x-target-ids="t008" x-target="It" x-target-head="t008" x-head="true" lemma="הִיא" strong="H1931a" x-morph="Pp3fs" x-gloss="it" x-translit="hîʾ-" xml:lang="hbo">הִיא</char>־<char style="w" x-id="WLC.PRO.18.13.008" x-align="PRO.18.13.a009" x-target-ids="t013" x-target="unto" x-target-head="t013" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hb