	<para style="p"><verse number="9" style="v" x-ref="PRO.9.9" x-added-alignments="PRO.9.9.a002" x-added-target-ids="t002" x-added-target="instruction" sid="PRO 9:9" /><char style="w" x-id="WLC.PRO.9.9.001" x-align="PRO.9.9.a001" x-target-ids="t001" x-target="Give" x-target-head="t001" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqv2ms" x-gloss="give" x-translit="tēn" xml:lang="hbo">תֵּ֣ן</char> <char style="w" x-id="WLC.PRO.9.9.002" x-align="PRO.9.9.a003" x-target-ids="t003" x-target="to" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֭</char><char style="w" x-id="WLC.PRO.9.9.003" x-align="PRO.9.9.a004" x-target-ids="t004 t005 t006" x-target="a wise man" x-target-head="t005" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="a.wise.[person]" x-translit="ḥāḵām" xml:lang="hbo">חָכָם</char> <char style="w" x-id="WLC.PRO.9.9.004" x-align="PRO.9.9.a005" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.9.9.005" x-align="PRO.9.9.a006" x-target-ids="t008 t009 t010 t012" x-target="he will be wiser" x-target-head="t012" x-head="true" lemma="חָכַם" strong="H2449" x-morph="Vqi3ms" x-gloss="he.will.be.wise" x-translit="yeḥkam-" xml:lang="hbo">יֶחְכַּם</char>־<char style="w" x-id="WLC.PRO.9.9.006" x-align="PRO.9.9.a007" x-target-ids="t011" x-target="yet" x-target-head="t011" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="yet" x-translit="ʿôḏ" xml:lang="hbo">ע֑וֹד</char> <char style="w" x-id="WLC.PRO.9.9.007" x-align="PRO.9.9.a008" x-target-ids="t013" x-target="Teach" x-target-head="t013" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vhv2ms" x-gloss="make.known" x-translit="hôḏaʿ" xml:lang="hbo">הוֹדַ֥ע</char> <char style="w" x-id="WLC.PRO.9.9.008" x-align="PRO.9.9.a009" x-status="unrepresented" x-head="true" lemma="לְ" st