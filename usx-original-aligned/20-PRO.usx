	<para style="p"><verse number="13" style="v" x-ref="PRO.28.13" x-added-alignments="PRO.28.13.a010" x-added-target-ids="t014" x-added-target="them" sid="PRO 28:13" /><char style="w" x-id="WLC.PRO.28.13.001" x-align="PRO.28.13.a001" x-target-ids="t001 t002 t003" x-target="He that covereth" x-target-head="t003" x-head="true" lemma="כָּסָה" strong="H3680" x-morph="Vprmsa" x-gloss="[one.who].conceals" x-translit="məḵasseh" xml:lang="hbo">מְכַסֶּ֣ה</char> <char style="w" x-id="WLC.PRO.28.13.002" x-align="PRO.28.13.a003" x-target-ids="t005" x-target="transgressions" x-target-head="t005" x-head="true" lemma="פֶּשַׁע" strong="H6588" x-morph="Ncmpc" x-gloss="transgressions" x-translit="p̄əšāʿāy" xml:lang="hbo">פְ֭שָׁעָי</char><char style="w" x-id="WLC.PRO.28.13.003" x-align="PRO.28.13.a002" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.28.13.004" x-align="PRO.28.13.a004" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ" xml:lang="hbo">לֹ֣א</char> <char style="w" x-id="WLC.PRO.28.13.005" x-align="PRO.28.13.a005" x-target-ids="t006 t008" x-target="shall prosper" x-target-head="t008" x-head="true" lemma="צָלֵחַ" strong="H6743" x-morph="Vhi3ms" x-gloss="he.will.prosper" x-translit="yaṣliyᵃḥ" xml:lang="hbo">יַצְלִ֑יחַ</char> <char style="w" x-id="WLC.PRO.28.13.006" x-align="PRO.28.13.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.28.13.007" x-align="PRO.28.13.a007" x-target-ids="t010 t011" x-target="whoso confesseth" x-target-head="t011" x-head="true" lemma="יָדָה" strong="H3034" x-morph="Vhrmsa" x-gloss="[one.who].confesses" x-translit="môḏeh" xml:lang="hbo">מוֹדֶ֖ה</char> <char style="w" x-i