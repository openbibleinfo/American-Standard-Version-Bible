	<para style="p"><verse number="8" style="v" x-ref="PRO.24.8" x-added-alignments="PRO.24.8.a009" x-added-target-ids="t007" x-added-target="Men" sid="PRO 24:8" /><char style="w" x-id="WLC.PRO.24.8.001" x-align="PRO.24.8.a001" x-target-ids="t001 t002 t003" x-target="He that deviseth" x-target-head="t003" x-head="true" lemma="חָשַׁב" strong="H2803" x-morph="Vprmsa" x-gloss="[one.who].plans" x-translit="məḥaššēḇ" xml:lang="hbo">מְחַשֵּׁ֥ב</char> <char style="w" x-id="WLC.PRO.24.8.002" x-align="PRO.24.8.a002" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.24.8.003" x-align="PRO.24.8.a003" x-target-ids="t005 t006" x-target="do evil" x-target-head="t006" x-head="true" lemma="רָעַע" strong="H7489" x-morph="Vhc" x-gloss="do.evil" x-translit="hārēᵃʿ" xml:lang="hbo">הָרֵ֑עַ</char> <char style="w" x-id="WLC.PRO.24.8.004" x-align="PRO.24.8.a004" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="l" xml:lang="hbo">ל֝֗</char><char style="w" x-id="WLC.PRO.24.8.005" x-align="PRO.24.8.a005" x-target-ids="t010" x-target="him" x-target-head="t010" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="him" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.24.8.006" x-align="PRO.24.8.a006" x-target-ids="t011 t013" x-target="a maker" x-target-head="t013" x-head="true" lemma="בַּעַל" strong="H1167" x-morph="Ncmsc" x-gloss="master" x-translit="baʿal-" xml:lang="hbo">בַּֽעַל</char>־<char style="w" x-id="WLC.PRO.24.8.007" x-align="PRO.24.8.a007" x-target-ids="t012" x-target="mischief" x-target-head="t012" x-head="true" lemma="מְזִמָּה" strong="H4209" x-morph="Ncfpa" x-gloss="of.plots" x-translit="məzimmôṯ" xml:lang="hbo">מְזִמּ֥וֹת</char> <char style="w" x-id="WLC.PRO.24.8.008" x-align="PRO.24.8.a008" x-target-ids="t008 t009" x-target="shall call" x-target-head="t0