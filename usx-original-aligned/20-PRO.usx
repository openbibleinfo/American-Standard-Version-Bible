	<para style="p"><verse number="21" style="v" x-ref="PRO.11.21" x-added-alignments="PRO.11.21.a001 PRO.11.21.a003" x-added-target-ids="t001 t003" x-added-target="Though | join" sid="PRO 11:21" /><char style="w" x-id="WLC.PRO.11.21.001" x-align="PRO.11.21.a002" x-target-ids="t002" x-target="hand" x-target-head="t002" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsa" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָ֣ד</char> <char style="w" x-id="WLC.PRO.11.21.002" x-align="PRO.11.21.a004" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֭</char><char style="w" x-id="WLC.PRO.11.21.003" x-align="PRO.11.21.a005" x-target-ids="t005" x-target="hand" x-target-head="t005" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsa" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָד</char> <char style="w" x-id="WLC.PRO.11.21.004" x-align="PRO.11.21.a007" x-target-ids="t010" x-target="not" x-target-head="t010" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.11.21.005" x-align="PRO.11.21.a008" x-target-ids="t009 t011 t012" x-target="shall be unpunished" x-target-head="t012" x-head="true" lemma="נָקָה" strong="H5352" x-morph="VNi3ms" x-gloss="he.will.go.unpunished" x-translit="yinnāqeh" xml:lang="hbo">יִנָּ֣קֶה</char> <char style="w" x-id="WLC.PRO.11.21.006" x-align="PRO.11.21.a006" x-target-ids="t006 t007 t008" x-target="the evil man" x-target-head="t007" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="an.evil.[person]" x-translit="rrāʿ" xml:lang="hbo">רָּ֑ע</char> <char style="w" x-id="WLC.PRO.11.21.007" x-align="PRO.11.21.a009" x-target-ids="t013" x-target="But" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.21.008" x-align="PRO.11.21.a010" 