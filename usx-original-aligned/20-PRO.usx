	<para style="p"><verse number="5" style="v" x-ref="PRO.28.5" sid="PRO 28:5" /><char style="w" x-id="WLC.PRO.28.5.001" x-align="PRO.28.5.a002" x-target-ids="t002" x-target="men" x-target-head="t002" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmpc" x-gloss="people" x-translit="ʾanšê-" xml:lang="hbo">אַנְשֵׁי</char>־<char style="w" x-id="WLC.PRO.28.5.002" x-align="PRO.28.5.a001" x-target-ids="t001" x-target="Evil" x-target-head="t001" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="of.evil" x-translit="rāʿ" xml:lang="hbo">רָ֭ע</char> <char style="w" x-id="WLC.PRO.28.5.003" x-align="PRO.28.5.a004" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.28.5.004" x-align="PRO.28.5.a003" x-target-ids="t003" x-target="understand" x-target-head="t003" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi3mp" x-gloss="they.understand" x-translit="yāḇiynû" xml:lang="hbo">יָבִ֣ינוּ</char> <char style="w" x-id="WLC.PRO.28.5.005" x-align="PRO.28.5.a005" x-target-ids="t005" x-target="justice" x-target-head="t005" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="justice" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּ֑ט</char> <char style="w" x-id="WLC.PRO.28.5.006" x-align="PRO.28.5.a006" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.28.5.007" x-align="PRO.28.5.a007" x-target-ids="t007 t008 t009" x-target="they that seek" x-target-head="t009" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vprmpc" x-gloss="[those.who].seek" x-translit="məḇaqšēy" xml:lang="hbo">מְבַקְשֵׁ֥י</char> <char style="w" x-id="WLC.PRO.28.5.008" x-align="PRO.28.5.a008" x-target-ids="t010" x-target="Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-