	<para style="p"><verse number="16" style="v" x-ref="PRO.31.16" sid="PRO 31:16" /><char style="w" x-id="WLC.PRO.31.16.001" x-align="PRO.31.16.a001" x-target-ids="t001 t002" x-target="She considereth" x-target-head="t002" x-head="true" lemma="זָמַם" strong="H2161" x-morph="Vqp3fs" x-gloss="she.considers" x-translit="zāməmāh" xml:lang="hbo">זָמְמָ֣ה</char> <char style="w" x-id="WLC.PRO.31.16.002" x-align="PRO.31.16.a002" x-target-ids="t003 t004" x-target="a field" x-target-head="t004" x-head="true" lemma="שָׂדֶה" strong="H7704" x-morph="Ncmsa" x-gloss="a.field" x-translit="śāḏeh" xml:lang="hbo">שָׂ֭דֶה</char> <char style="w" x-id="WLC.PRO.31.16.003" x-align="PRO.31.16.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.31.16.004" x-align="PRO.31.16.a004" x-target-ids="t006" x-target="buyeth" x-target-head="t006" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqw3fs" x-gloss="she" x-translit="tiqqāḥ" xml:lang="hbo">תִּקָּחֵ֑</char><char style="w" x-id="WLC.PRO.31.16.005" x-align="PRO.31.16.a005" x-target-ids="t007" x-target="it" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="took.it" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.31.16.006" x-align="PRO.31.16.a006" x-target-ids="t008" x-target="With" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.31.16.007" x-align="PRO.31.16.a007" x-target-ids="t009 t010" x-target="the fruit" x-target-head="t010" x-head="true" lemma="פְּרִי" strong="H6529" x-morph="Ncmsc" x-gloss="the.fruit" x-translit="pəriy" xml:lang="hbo">פְּרִ֥י</char> <char style="w" x-id="WLC.PRO.31.16.008" x-align="PRO.31.16.a008" x-target-ids="t011 t013" x-target="of hands" x-target-head="t013" x-head="true" lemma="כַּף" strong="H3709