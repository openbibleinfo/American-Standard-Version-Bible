	<para style="p"><verse number="22" style="v" x-ref="PRO.22.22" sid="PRO 22:22" /><char style="w" x-id="WLC.PRO.22.22.001" x-align="PRO.22.22.a002" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.PRO.22.22.002" x-align="PRO.22.22.a001" x-target-ids="t001" x-target="Rob" x-target-head="t001" x-head="true" lemma="גָּזַל" strong="H1497" x-morph="Vqj2ms" x-gloss="rob" x-translit="tiḡzāl-" xml:lang="hbo">תִּגְזָל</char>־<char style="w" x-id="WLC.PRO.22.22.003" x-align="PRO.22.22.a003" x-target-ids="t003 t004" x-target="the poor" x-target-head="t004" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="a.poor.[person]" x-translit="dāl" xml:lang="hbo">דָּ֭ל</char> <char style="w" x-id="WLC.PRO.22.22.004" x-align="PRO.22.22.a004" x-target-ids="t005" x-target="because" x-target-head="t005" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֣י</char> <char style="w" x-id="WLC.PRO.22.22.005" x-align="PRO.22.22.a006" x-target-ids="t007 t008" x-target="is poor" x-target-head="t008" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aamsa" x-gloss="[is].poor" x-translit="ḏal-" xml:lang="hbo">דַל</char>־<char style="w" x-id="WLC.PRO.22.22.006" x-align="PRO.22.22.a005" x-target-ids="t006" x-target="he" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="he" x-translit="hûʾ" xml:lang="hbo">ה֑וּא</char> <char style="w" x-id="WLC.PRO.22.22.007" x-align="PRO.22.22.a007" x-status="noncompositional" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.22.22.008" x-align="PRO.22.22.a007" x-status="noncompositional" x-target-ids="t009" x-target="Neither" x-target-head="t009" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hb