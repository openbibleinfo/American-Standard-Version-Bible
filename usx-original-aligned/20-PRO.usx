	<para style="p"><verse number="12" style="v" x-ref="PRO.14.12" sid="PRO 14:12" /><char style="w" x-id="WLC.PRO.14.12.001" x-align="PRO.14.12.a001" x-target-ids="t001 t002" x-target="There is" x-target-head="t002" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֤שׁ</char> <char style="w" x-id="WLC.PRO.14.12.002" x-align="PRO.14.12.a002" x-target-ids="t003 t004" x-target="a way" x-target-head="t004" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="a.way" x-translit="dereḵ" xml:lang="hbo">דֶּ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.14.12.003" x-align="PRO.14.12.a003" x-target-ids="t005 t006 t007" x-target="which seemeth right" x-target-head="t007" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aamsa" x-gloss="right" x-translit="yāšār" xml:lang="hbo">יָ֭שָׁר</char> <char style="w" x-id="WLC.PRO.14.12.004" x-align="PRO.14.12.a004" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.14.12.005" x-align="PRO.14.12.a004" x-target-ids="t008" x-target="unto" x-target-head="t008" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ənê-" xml:lang="hbo">פְנֵי</char>־<char style="w" x-id="WLC.PRO.14.12.006" x-align="PRO.14.12.a005" x-target-ids="t009 t010" x-target="a man" x-target-head="t010" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֑ישׁ</char> <char style="w" x-id="WLC.PRO.14.12.007" x-align="PRO.14.12.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.14.12.008" x-align="PRO.14.12.a007" x-target-ids="t012 t013" x-target="the end" x-target-head="t013" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="end" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִיתָ֗</char>