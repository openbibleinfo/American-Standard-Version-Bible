	<para style="p"><verse number="5" style="v" x-ref="PRO.4.5" sid="PRO 4:5" /><char style="w" x-id="WLC.PRO.4.5.001" x-align="PRO.4.5.a001" x-target-ids="t001" x-target="Get" x-target-head="t001" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqv2ms" x-gloss="acquire" x-translit="qənēh" xml:lang="hbo">קְנֵ֣ה</char> <char style="w" x-id="WLC.PRO.4.5.002" x-align="PRO.4.5.a002" x-target-ids="t002" x-target="wisdom" x-target-head="t002" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmâ" xml:lang="hbo">חָ֭כְמָה</char> <char style="w" x-id="WLC.PRO.4.5.003" x-align="PRO.4.5.a003" x-target-ids="t003" x-target="get" x-target-head="t003" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqv2ms" x-gloss="acquire" x-translit="qənēh" xml:lang="hbo">קְנֵ֣ה</char> <char style="w" x-id="WLC.PRO.4.5.004" x-align="PRO.4.5.a004" x-target-ids="t004" x-target="understanding" x-target-head="t004" x-head="true" lemma="בִּינָה" strong="H998" x-morph="Ncfsa" x-gloss="understanding" x-translit="ḇînāh" xml:lang="hbo">בִינָ֑ה</char> <char style="w" x-id="WLC.PRO.4.5.005" x-align="PRO.4.5.a006" x-target-ids="t006" x-target="not" x-target-head="t006" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.4.5.006" x-align="PRO.4.5.a005" x-target-ids="t005" x-target="Forget" x-target-head="t005" x-head="true" lemma="שָׁכַח" strong="H7911" x-morph="Vqj2ms" x-gloss="forget" x-translit="tiškaḥ" xml:lang="hbo">תִּשְׁכַּ֥ח</char> <char style="w" x-id="WLC.PRO.4.5.007" x-align="PRO.4.5.a007" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.4.5.008" x-align="PRO.4.5.a007" x-target-ids="t007" x-target="neither" x-target-head="t007" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.4.5.009" x-align="P