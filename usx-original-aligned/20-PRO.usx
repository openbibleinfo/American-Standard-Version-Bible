	<para style="p"><verse number="25" style="v" x-ref="PRO.22.25" sid="PRO 22:25" /><char style="w" x-id="WLC.PRO.22.25.001" x-align="PRO.22.25.a001" x-target-ids="t001" x-target="Lest" x-target-head="t001" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo">פֶּן</char>־<char style="w" x-id="WLC.PRO.22.25.002" x-align="PRO.22.25.a002" x-target-ids="t002 t003" x-target="thou learn" x-target-head="t003" x-head="true" lemma="אָלַף" strong="H502" x-morph="Vqi2ms" x-gloss="you.should.learn" x-translit="teʾĕlap̄" xml:lang="hbo">תֶּאֱלַ֥ף</char> <char style="w" x-id="WLC.PRO.22.25.003" x-align="PRO.22.25.a004" x-target-ids="t005" x-target="ways" x-target-head="t005" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbpc" x-gloss="ways" x-translit="ʾōrəḥōṯāy" xml:lang="hbo">אֹֽרְחֹתָ֑י</char><char style="w" x-id="WLC.PRO.22.25.004" x-align="PRO.22.25.a003" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.22.25.005" x-align="PRO.22.25.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.22.25.006" x-align="PRO.22.25.a006" x-target-ids="t007" x-target="get" x-target-head="t007" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqq2ms" x-gloss="you.will.take" x-translit="lāqaḥtā" xml:lang="hbo">לָקַחְתָּ֖</char> <char style="w" x-id="WLC.PRO.22.25.007" x-align="PRO.22.25.a007" x-target-ids="t008 t009" x-target="a snare" x-target-head="t009" x-head="true" lemma="מוֹקֵשׁ" strong="H4170" x-morph="Ncmsa" x-gloss="a.snare" x-translit="môqēš" xml:lang="hbo">מוֹקֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.22.25.008" x-align="PRO.22.25.a008" x-target-ids="t010" x-target="to" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R