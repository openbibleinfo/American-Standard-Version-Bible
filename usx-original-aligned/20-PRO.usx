	<para style="p"><verse number="15" style="v" x-ref="PRO.10.15" sid="PRO 10:15" /><char style="w" x-id="WLC.PRO.10.15.001" x-align="PRO.10.15.a001" x-target-ids="t004" x-target="wealth" x-target-head="t004" x-head="true" lemma="הוֹן" strong="H1952" x-morph="Ncmsa" x-gloss="[the].wealth" x-translit="hôn" xml:lang="hbo">ה֣וֹן</char> <char style="w" x-id="WLC.PRO.10.15.002" x-align="PRO.10.15.a002" x-target-ids="t001 t002 t003" x-target="The rich man’s" x-target-head="t002" x-head="true" lemma="עָשִׁיר" strong="H6223" x-morph="Aamsa" x-gloss="of.a.rich.[person]" x-translit="ʿāšîr" xml:lang="hbo">עָ֭שִׁיר</char> <char style="w" x-id="WLC.PRO.10.15.003" x-align="PRO.10.15.a003" x-target-ids="t005 t008" x-target="is city" x-target-head="t008" x-head="true" lemma="קִרְיָה" strong="H7151" x-morph="Ncfsc" x-gloss="[is].the.town" x-translit="qiryaṯ" xml:lang="hbo">קִרְיַ֣ת</char> <char style="w" x-id="WLC.PRO.10.15.004" x-align="PRO.10.15.a004" x-target-ids="t007" x-target="strong" x-target-head="t007" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsc" x-gloss="his.strength" x-translit="ʿuzz" xml:lang="hbo">עֻזּ֑</char><char style="w" x-id="WLC.PRO.10.15.005" x-align="PRO.10.15.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.10.15.006" x-align="PRO.10.15.a006" x-target-ids="t009 t010" x-target="The destruction" x-target-head="t010" x-head="true" lemma="מְחִתָּה" strong="H4288" x-morph="Ncfsc" x-gloss="[is.the].ruin" x-translit="məḥittaṯ" xml:lang="hbo">מְחִתַּ֖ת</char> <char style="w" x-id="WLC.PRO.10.15.007" x-align="PRO.10.15.a007" x-target-ids="t011 t012 t013" x-target="of the poor" x-target-head="t013" x-head="true" lemma="דַּל" strong="H1800" x-morph="Aampa" x-gloss="of.poor.[people]" x-translit="dalliym" xml:lang="hbo">דַּלִּ֣ים</char> <char style="w" x-id="WLC.PRO.10.15.008" x-align="PRO.10.15.a008" x-target-