	<para style="p"><verse number="15" style="v" x-ref="PRO.11.15" x-added-alignments="PRO.11.15.a006" x-added-target-ids="t010 t011" x-added-target="for it" sid="PRO 11:15" /><char style="w" x-id="WLC.PRO.11.15.001" x-align="PRO.11.15.a001" x-status="unrepresented" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="harm" x-translit="raʿ-" xml:lang="hbo">רַע</char>־<char style="w" x-id="WLC.PRO.11.15.002" x-align="PRO.11.15.a002" x-target-ids="t001 t008 t009" x-target="He shall smart" x-target-head="t009" x-head="true" lemma="רָעַע" strong="H7489" x-morph="VNi3ms" x-gloss="he.is.harmed" x-translit="yērôᵃʿ" xml:lang="hbo">יֵ֭רוֹעַ</char> <char style="w" x-id="WLC.PRO.11.15.003" x-align="PRO.11.15.a003" x-target-ids="t002" x-target="that" x-target-head="t002" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.11.15.004" x-align="PRO.11.15.a004" x-target-ids="t003 t004 t005" x-target="is surety for" x-target-head="t004" x-head="true" lemma="עָרַב" strong="H6148" x-morph="Vqp3ms" x-gloss="he.stood.surety.for" x-translit="ʿāraḇ" xml:lang="hbo">עָ֣רַב</char> <char style="w" x-id="WLC.PRO.11.15.005" x-align="PRO.11.15.a005" x-target-ids="t006 t007" x-target="a stranger" x-target-head="t007" x-head="true" lemma="זָר" strong="H2114b" x-morph="Aamsa" x-gloss="a.stranger" x-translit="zār" xml:lang="hbo">זָ֑ר</char> <char style="w" x-id="WLC.PRO.11.15.006" x-align="PRO.11.15.a007" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.15.007" x-align="PRO.11.15.a008" x-target-ids="t013 t014 t015" x-target="he that hateth" x-target-head="t015" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[one.who].hates" x-translit="śōnēʾ" xml:lang="hbo">שֹׂנֵ֖א</char> <char style="w" x-id="WLC.PRO.11.15.008" x-align="PRO.11.15.a0