	<para style="p"><verse number="35" style="v" x-ref="PRO.3.35" sid="PRO 3:35" /><char style="w" x-id="WLC.PRO.3.35.001" x-align="PRO.3.35.a001" x-target-ids="t005" x-target="glory" x-target-head="t005" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="honor" x-translit="kāḇôḏ" xml:lang="hbo">כָּ֭בוֹד</char> <char style="w" x-id="WLC.PRO.3.35.002" x-align="PRO.3.35.a002" x-target-ids="t001 t002" x-target="The wise" x-target-head="t002" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֣ים</char> <char style="w" x-id="WLC.PRO.3.35.003" x-align="PRO.3.35.a003" x-target-ids="t003 t004" x-target="shall inherit" x-target-head="t004" x-head="true" lemma="נָחַל" strong="H5157" x-morph="Vqi3mp" x-gloss="they.will.inherit" x-translit="yinḥālû" xml:lang="hbo">יִנְחָ֑לוּ</char> <char style="w" x-id="WLC.PRO.3.35.004" x-align="PRO.3.35.a004" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.3.35.005" x-align="PRO.3.35.a005" x-target-ids="t012 t013" x-target="of fools" x-target-head="t013" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Ncmpa" x-gloss="fools" x-translit="ḵəsîliym" xml:lang="hbo">כְסִילִ֗ים</char> <char style="w" x-id="WLC.PRO.3.35.006" x-align="PRO.3.35.a006" x-target-ids="t008 t009 t010 t011" x-target="shall be the promotion" x-target-head="t011" x-head="true" lemma="רוּם" strong="H7311" x-morph="Vhrmsa" x-gloss="[is].lifting.up" x-translit="mēriym" xml:lang="hbo">מֵרִ֥ים</char> <char style="w" x-id="WLC.PRO.3.35.007" x-align="PRO.3.35.a007" x-target-ids="t007" x-target="shame" x-target-head="t007" x-head="true" lemma="קָלוֹן" strong="H7036" x-morph="Ncmsa" x-gloss="shame" x-translit="qālôn:" xml:lang="hbo">קָלֽוֹן</char>׃פ<verse eid="PRO 3:35" /></para>
