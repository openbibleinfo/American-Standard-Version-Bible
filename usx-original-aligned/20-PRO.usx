	<para style="p"><verse number="15" style="v" x-ref="PRO.7.15" sid="PRO 7:15" /><char style="w" x-id="WLC.PRO.7.15.001" x-align="PRO.7.15.a001" x-target-ids="t001" x-target="Therefore" x-target-head="t001" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="therefore" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.7.15.002" x-align="PRO.7.15.a001" lemma="כֵּן" strong="H3651" x-morph="Tm" x-translit="kēn" xml:lang="hbo">כֵּ֭ן</char> <char style="w" x-id="WLC.PRO.7.15.003" x-align="PRO.7.15.a002" x-target-ids="t002 t003 t004" x-target="came I forth" x-target-head="t002" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vqp1cs" x-gloss="I.have.come.out" x-translit="yāṣāʾṯî" xml:lang="hbo">יָצָ֣אתִי</char> <char style="w" x-id="WLC.PRO.7.15.004" x-align="PRO.7.15.a003" x-target-ids="t005" x-target="to" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.7.15.005" x-align="PRO.7.15.a004" x-target-ids="t006" x-target="meet" x-target-head="t006" x-head="true" lemma="קרא" strong="H7122" x-morph="Vqc" x-gloss="meet" x-translit="qərāʾṯ" xml:lang="hbo">קְרָאתֶ֑</char><char style="w" x-id="WLC.PRO.7.15.006" x-align="PRO.7.15.a005" x-target-ids="t007" x-target="thee" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.7.15.007" x-align="PRO.7.15.a006" x-target-ids="t009" x-target="to" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.7.15.008" x-align="PRO.7.15.a007" x-target-ids="t008 t010" x-target="Diligently seek" x-target-head="t010" x-head="true" lemma="שָׁחַר" strong="H7836" x-morph="Vpc" x-gloss="seek.eagerly" x-translit="šaḥēr" xml:lang="hbo">שַׁחֵ֥ר</char> <char style="w" x-id="WLC.PRO.7.15.009" x-align="PRO.7.