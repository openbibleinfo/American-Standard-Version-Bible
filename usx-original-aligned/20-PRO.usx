	<para style="p"><verse number="20" style="v" x-ref="PRO.10.20" sid="PRO 10:20" /><char style="w" x-id="WLC.PRO.10.20.001" x-align="PRO.10.20.a003" x-target-ids="t006 t007 t009" x-target="is as silver" x-target-italic-ids="t007" x-target-head="t009" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="[is].silver" x-translit="kesep̄" xml:lang="hbo">כֶּ֣סֶף</char> <char style="w" x-id="WLC.PRO.10.20.002" x-align="PRO.10.20.a004" x-target-ids="t008" x-target="choice" x-target-head="t008" x-head="true" lemma="בָּחַר" strong="H977" x-morph="VNrmsa" x-gloss="chosen" x-translit="niḇḥār" xml:lang="hbo">נִ֭בְחָר</char> <char style="w" x-id="WLC.PRO.10.20.003" x-align="PRO.10.20.a001" x-target-ids="t001 t002" x-target="The tongue" x-target-head="t002" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="[the].tongue" x-translit="ləšôn" xml:lang="hbo">לְשׁ֣וֹן</char> <char style="w" x-id="WLC.PRO.10.20.004" x-align="PRO.10.20.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PRO.10.20.005" x-align="PRO.10.20.a005" x-target-ids="t010 t011" x-target="The heart" x-target-head="t011" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="[the].heart" x-translit="lēḇ" xml:lang="hbo">לֵ֖ב</char> <char style="w" x-id="WLC.PRO.10.20.006" x-align="PRO.10.20.a006" x-target-ids="t012 t013 t014" x-target="of the wicked" x-target-head="t014" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.10.20.007" x-align="PRO.10.20.a007" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="[is].like" x-translit="ki" xml:lang="hbo">כִּ</char><char style="w" x-id="WLC.PRO.10.20.008" x-align="PRO.10.20.a007" x-target-ids="t015 t016 t017" x-tar