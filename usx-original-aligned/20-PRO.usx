	<para style="p"><verse number="18" style="v" x-ref="PRO.20.18" sid="PRO 20:18" /><char style="w" x-id="WLC.PRO.20.18.001" x-align="PRO.20.18.a001" x-target-ids="t001 t002" x-target="Every purpose" x-target-head="t002" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpa" x-gloss="plans" x-translit="maḥăšāḇôṯ" xml:lang="hbo">מַ֭חֲשָׁבוֹת</char> <char style="w" x-id="WLC.PRO.20.18.002" x-align="PRO.20.18.a003" x-target-ids="t005" x-target="by" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.20.18.003" x-align="PRO.20.18.a004" x-target-ids="t006" x-target="counsel" x-target-head="t006" x-head="true" lemma="עֵצָה" strong="H6098" x-morph="Ncfsa" x-gloss="counsel" x-translit="ʿēṣāh" xml:lang="hbo">עֵצָ֣ה</char> <char style="w" x-id="WLC.PRO.20.18.004" x-align="PRO.20.18.a002" x-target-ids="t003 t004" x-target="is established" x-target-head="t004" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNi3fs" x-gloss="it.is.established" x-translit="ṯikôn" xml:lang="hbo">תִכּ֑וֹן</char> <char style="w" x-id="WLC.PRO.20.18.005" x-align="PRO.20.18.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.20.18.006" x-align="PRO.20.18.a006" x-target-ids="t008" x-target="by" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.20.18.007" x-align="PRO.20.18.a007" x-target-ids="t009 t010" x-target="wise guidance" x-target-head="t010" x-head="true" lemma="תַּחְבֻּלֹות" strong="H8458" x-morph="Ncfpa" x-gloss="guidance(s)" x-translit="ṯaḥbulôṯ" xml:lang="hbo">תַחְבֻּל֗וֹת</char> <char style="w" x-id="WLC.PRO.20.18.008" x-align="PRO.20.18.a008" x-target-ids="t011 t012" x-target="make thou" x-target-head="t011" x-head="true" lem