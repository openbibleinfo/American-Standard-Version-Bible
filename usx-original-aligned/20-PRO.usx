	<para style="p"><verse number="5" style="v" x-ref="PRO.21.5" x-added-alignments="PRO.21.5.a003 PRO.21.5.a010" x-added-target-ids="t006 t016" x-added-target="tend | hasteth" sid="PRO 21:5" /><char style="w" x-id="WLC.PRO.21.5.001" x-align="PRO.21.5.a001" x-target-ids="t001 t002" x-target="The thoughts" x-target-head="t002" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpc" x-gloss="[the].plans" x-translit="maḥšəḇôṯ" xml:lang="hbo">מַחְשְׁב֣וֹת</char> <char style="w" x-id="WLC.PRO.21.5.002" x-align="PRO.21.5.a002" x-target-ids="t003 t004 t005" x-target="of the diligent" x-target-head="t005" x-head="true" lemma="חָרוּץ" strong="H2742e" x-morph="Aamsa" x-gloss="of.a.diligent.[person]" x-translit="ḥārûṣ" xml:lang="hbo">חָ֭רוּץ</char> <char style="w" x-id="WLC.PRO.21.5.003" x-align="PRO.21.5.a004" x-target-ids="t007" x-target="only" x-target-head="t007" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="[are].only" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.PRO.21.5.004" x-align="PRO.21.5.a005" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.21.5.005" x-align="PRO.21.5.a006" x-target-ids="t009" x-target="plenteousness" x-target-head="t009" x-head="true" lemma="מוֹתָר" strong="H4195" x-morph="Ncmsa" x-gloss="profit" x-translit="môṯār" xml:lang="hbo">מוֹתָ֑ר</char> <char style="w" x-id="WLC.PRO.21.5.006" x-align="PRO.21.5.a007" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.21.5.007" x-align="PRO.21.5.a008" x-target-ids="t011" x-target="every" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.21.5.008" x-align="PRO.21.5.