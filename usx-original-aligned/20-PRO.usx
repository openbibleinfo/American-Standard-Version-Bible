	<para style="p"><verse number="3" style="v" x-ref="PRO.1.3" sid="PRO 1:3" /><char style="w" x-id="WLC.PRO.1.3.001" x-align="PRO.1.3.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ֭</char><char style="w" x-id="WLC.PRO.1.3.002" x-align="PRO.1.3.a002" x-target-ids="t002" x-target="receive" x-target-head="t002" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqc" x-gloss="receive" x-translit="qaḥaṯ" xml:lang="hbo">קַחַת</char> <char style="w" x-id="WLC.PRO.1.3.003" x-align="PRO.1.3.a003" x-target-ids="t003" x-target="instruction" x-target-head="t003" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsc" x-gloss="correction" x-translit="mûsar" xml:lang="hbo">מוּסַ֣ר</char> <char style="w" x-id="WLC.PRO.1.3.004" x-align="PRO.1.3.a004" x-target-ids="t004 t005 t006" x-target="in wise dealing" x-target-head="t005" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vha" x-gloss="of.insight" x-translit="haśkēl" xml:lang="hbo">הַשְׂכֵּ֑ל</char> <char style="w" x-id="WLC.PRO.1.3.005" x-align="PRO.1.3.a005" x-target-ids="t007 t008" x-target="In righteousness" x-target-head="t008" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="righteousness" x-translit="ṣeḏeq" xml:lang="hbo">צֶ֥דֶק</char> <char style="w" x-id="WLC.PRO.1.3.006" x-align="PRO.1.3.a006" x-target-ids="t009" x-target="and" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.1.3.007" x-align="PRO.1.3.a007" x-target-ids="t010" x-target="justice" x-target-head="t010" x-head="true" lemma="מִשְׁפָּט" strong="H4941" x-morph="Ncmsa" x-gloss="justice" x-translit="mišpāṭ" xml:lang="hbo">מִשְׁפָּ֗ט</char> <char style="w" x-id="WLC.PRO.1.3.008" x-align="PRO.1.3.a008" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss=