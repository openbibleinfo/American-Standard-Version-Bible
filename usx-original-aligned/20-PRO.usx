	<para style="p"><verse number="19" style="v" x-ref="PRO.29.19" sid="PRO 29:19" /><char style="w" x-id="WLC.PRO.29.19.001" x-align="PRO.29.19.a001" x-target-ids="t007" x-target="by" x-target-head="t007" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bi" xml:lang="hbo">בִּ֭</char><char style="w" x-id="WLC.PRO.29.19.002" x-align="PRO.29.19.a002" x-target-ids="t008" x-target="words" x-target-head="t008" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpa" x-gloss="words" x-translit="ḏəḇārîm" xml:lang="hbo">דְבָרִים</char> <char style="w" x-id="WLC.PRO.29.19.003" x-align="PRO.29.19.a003" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.29.19.004" x-align="PRO.29.19.a004" x-target-ids="t003 t005 t006" x-target="will be corrected" x-target-head="t006" x-head="true" lemma="יָסַר" strong="H3256" x-morph="VNi3ms" x-gloss="he.will.let.himself.be.instructed" x-translit="yiwwāser" xml:lang="hbo">יִוָּ֣סֶר</char> <char style="w" x-id="WLC.PRO.29.19.005" x-align="PRO.29.19.a005" x-target-ids="t001 t002" x-target="A servant" x-target-head="t002" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsa" x-gloss="a.slave" x-translit="ʿāḇeḏ" xml:lang="hbo">עָ֑בֶד</char> <char style="w" x-id="WLC.PRO.29.19.006" x-align="PRO.29.19.a006" x-target-ids="t009 t010" x-target="For though" x-target-head="t010" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.29.19.007" x-align="PRO.29.19.a007" x-target-ids="t011 t012" x-target="he understand" x-target-head="t012" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi3ms" x-gloss="he.will.understand" x-translit="yāḇiyn" xml:lang="hbo">יָ֝בִ֗ין</char> <char style="w" x-id="WLC.PRO.29.19.008" x-align="PRO.29.19.a008" x-status="unrepresented" x-head="true" lemma="וְ" 