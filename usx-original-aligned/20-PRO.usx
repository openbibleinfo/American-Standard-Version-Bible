	<para style="p"><verse number="16" style="v" x-ref="PRO.3.16" sid="PRO 3:16" /><char style="w" x-id="WLC.PRO.3.16.001" x-align="PRO.3.16.a001" x-target-ids="t001" x-target="Length" x-target-head="t001" x-head="true" lemma="אֹרֶךְ" strong="H753" x-morph="Ncmsc" x-gloss="length" x-translit="ʾōreḵ" xml:lang="hbo">אֹ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.3.16.002" x-align="PRO.3.16.a002" x-target-ids="t002 t003" x-target="of days" x-target-head="t003" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpa" x-gloss="of.days" x-translit="yāmîm" xml:lang="hbo">יָ֭מִים</char> <char style="w" x-id="WLC.PRO.3.16.003" x-align="PRO.3.16.a003" x-target-ids="t004 t005" x-target="is in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bi" xml:lang="hbo">בִּֽ</char><char style="w" x-id="WLC.PRO.3.16.004" x-align="PRO.3.16.a004" x-target-ids="t007 t008" x-target="right hand" x-target-head="t007" x-head="true" lemma="יָמִין" strong="H3225" x-morph="Ncfsc" x-gloss="her.right" x-translit="ymiyn" xml:lang="hbo">ימִינָ֑</char><char style="w" x-id="WLC.PRO.3.16.005" x-align="PRO.3.16.a005" x-target-ids="t006" x-target="her" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="hand" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.3.16.006" x-align="PRO.3.16.a006" x-target-ids="t009 t013" x-target="In are" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in" x-translit="bi" xml:lang="hbo">בִּ֝</char><char style="w" x-id="WLC.PRO.3.16.007" x-align="PRO.3.16.a007" x-target-ids="t011 t012" x-target="left hand" x-target-head="t011" x-head="true" lemma="שְׂמֹאל" strong="H8040" x-morph="Ncmsc" x-gloss="her.left" x-translit="śəmōʾwl" xml:lang="hbo">שְׂמֹאולָ֗</char><char style="w" x-id="WLC.PRO.3.16.008" x-align="PRO.3.16.a008" x-target-ids="t010" x-target="her" x-target-head="t010" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3f