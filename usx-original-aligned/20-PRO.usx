	<para style="p"><verse number="2" style="v" x-ref="PRO.8.2" sid="PRO 8:2" /><char style="w" x-id="WLC.PRO.8.2.001" x-align="PRO.8.2.a001" x-target-ids="t001" x-target="On" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.8.2.002" x-align="PRO.8.2.a002" x-target-ids="t002 t003" x-target="the top" x-target-head="t003" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsc" x-gloss="top" x-translit="rōʾš-" xml:lang="hbo">רֹאשׁ</char>־<char style="w" x-id="WLC.PRO.8.2.003" x-align="PRO.8.2.a003" x-target-ids="t004 t005 t006" x-target="of high places" x-target-head="t005" x-head="true" lemma="מָרוֹם" strong="H4791" x-morph="Ncmpa" x-gloss="of.[the].heights" x-translit="mərômiym" xml:lang="hbo">מְרוֹמִ֥ים</char> <char style="w" x-id="WLC.PRO.8.2.004" x-align="PRO.8.2.a004" x-target-ids="t007" x-target="by" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿălê-" xml:lang="hbo">עֲלֵי</char>־<char style="w" x-id="WLC.PRO.8.2.005" x-align="PRO.8.2.a005" x-target-ids="t008 t009" x-target="the way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="[the].way" x-translit="ḏāreḵ" xml:lang="hbo">דָ֑רֶךְ</char> <char style="w" x-id="WLC.PRO.8.2.006" x-align="PRO.8.2.a006" x-target-ids="t010 t013" x-target="Where meet" x-target-head="t013" x-head="true" lemma="בֵּית" strong="H1004a" x-morph="Ncmsc" x-gloss="between" x-translit="bēyṯ" xml:lang="hbo">בֵּ֖ית</char> <char style="w" x-id="WLC.PRO.8.2.007" x-align="PRO.8.2.a007" x-target-ids="t011 t012" x-target="the paths" x-target-head="t012" x-head="true" lemma="נְתִיבָה" strong="H5410" x-morph="Ncbpa" x-gloss="[the].pathways" x-translit="nəṯîḇôṯ" xml:lang="hbo">נְתִיב֣וֹת</char> <char style="w" x-id="WLC.PRO.8.2.008" x-align="PRO.8.2.a008" x-target-ids="t014 t015" x-target="she standeth" x-target-head="t015" x-head="true" lemma="