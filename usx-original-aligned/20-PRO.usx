	<para style="p"><verse number="3" style="v" x-ref="PRO.8.3" sid="PRO 8:3" /><char style="w" x-id="WLC.PRO.8.3.001" x-align="PRO.8.3.a001" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.8.3.002" x-align="PRO.8.3.a001" x-target-ids="t001" x-target="Beside" x-target-head="t001" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="side" x-translit="yaḏ-" xml:lang="hbo">יַד</char>־<char style="w" x-id="WLC.PRO.8.3.003" x-align="PRO.8.3.a002" x-target-ids="t002 t003" x-target="the gates" x-target-head="t003" x-head="true" lemma="שַׁעַר" strong="H8179" x-morph="Ncmpa" x-gloss="of.[the].gates" x-translit="šəʿāriym" xml:lang="hbo">שְׁעָרִ֥ים</char> <char style="w" x-id="WLC.PRO.8.3.004" x-align="PRO.8.3.a003" x-target-ids="t004" x-target="at" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to.[the]" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.8.3.005" x-align="PRO.8.3.a004" x-target-ids="t005 t006" x-target="the entry" x-target-head="t006" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="opening" x-translit="p̄î-" xml:lang="hbo">פִי</char>־<char style="w" x-id="WLC.PRO.8.3.006" x-align="PRO.8.3.a005" x-target-ids="t007 t008 t009" x-target="of the city" x-target-head="t009" x-head="true" lemma="קֶרֶת" strong="H7176" x-morph="Ncfsa" x-gloss="of.[the].town" x-translit="qāreṯ" xml:lang="hbo">קָ֑רֶת</char> <char style="w" x-id="WLC.PRO.8.3.007" x-align="PRO.8.3.a006" x-target-ids="t010 t011 t012 t013" x-target="At the coming in" x-target-head="t012" x-head="true" lemma="מָבוֹא" strong="H3996" x-morph="Ncmsc" x-gloss="[the].entrance" x-translit="məḇôʾ" xml:lang="hbo">מְב֖וֹא</char> <char style="w" x-id="WLC.PRO.8.3.008" x-align="PRO.8.3.a007" x-target-ids="t014 t015 t016" x-target="at the doors" x-target-head="t016" x-head="true" lemma="פֶּתַח" strong="H6607" x-morph="Ncmpa" x-gloss="of.[the].doorways" x-trans