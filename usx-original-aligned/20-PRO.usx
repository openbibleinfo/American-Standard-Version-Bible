	<para style="p"><verse number="20" style="v" x-ref="PRO.6.20" sid="PRO 6:20" /><char style="w" x-id="WLC.PRO.6.20.001" x-align="PRO.6.20.a001" x-target-ids="t003" x-target="keep" x-target-head="t003" x-head="true" lemma="נָצַר" strong="H5341" x-morph="Vqv2ms" x-gloss="keep" x-translit="nəṣōr" xml:lang="hbo">נְצֹ֣ר</char> <char style="w" x-id="WLC.PRO.6.20.002" x-align="PRO.6.20.a002" x-target-ids="t002" x-target="son" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="bən" xml:lang="hbo">בְּ֭נִ</char><char style="w" x-id="WLC.PRO.6.20.003" x-align="PRO.6.20.a003" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.6.20.004" x-align="PRO.6.20.a004" x-target-ids="t004 t005" x-target="the commandment" x-target-head="t005" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfsc" x-gloss="the.commandment" x-translit="miṣwaṯ" xml:lang="hbo">מִצְוַ֣ת</char> <char style="w" x-id="WLC.PRO.6.20.005" x-align="PRO.6.20.a005" x-target-ids="t006 t008" x-target="of father" x-target-head="t008" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="your.father" x-translit="ʾāḇiy" xml:lang="hbo">אָבִ֑י</char><char style="w" x-id="WLC.PRO.6.20.006" x-align="PRO.6.20.a006" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.6.20.007" x-align="PRO.6.20.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.6.20.008" x-align="PRO.6.20.a008" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:la