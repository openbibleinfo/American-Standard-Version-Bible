	<para style="p"><verse number="1" style="v" x-ref="PRO.15.1" sid="PRO 15:1" /><char style="w" x-id="WLC.PRO.15.1.001" x-align="PRO.15.1.a001" x-target-ids="t001 t003" x-target="A answer" x-target-head="t003" x-head="true" lemma="מַעֲנֶה" strong="H4617" x-morph="Ncmsa" x-gloss="an.answer" x-translit="maʿăneh-" xml:lang="hbo">מַֽעֲנֶה</char>־<char style="w" x-id="WLC.PRO.15.1.002" x-align="PRO.15.1.a002" x-target-ids="t002" x-target="soft" x-target-head="t002" x-head="true" lemma="רַךְ" strong="H7390" x-morph="Aamsa" x-gloss="soft" x-translit="rraḵ" xml:lang="hbo">רַּ֭ךְ</char> <char style="w" x-id="WLC.PRO.15.1.003" x-align="PRO.15.1.a003" x-target-ids="t004 t005" x-target="turneth away" x-target-head="t004" x-head="true" lemma="שׁוּב" strong="H7725" x-morph="Vhi3ms" x-gloss="it.turns.away" x-translit="yāšiyḇ" xml:lang="hbo">יָשִׁ֣יב</char> <char style="w" x-id="WLC.PRO.15.1.004" x-align="PRO.15.1.a004" x-target-ids="t006" x-target="wrath" x-target-head="t006" x-head="true" lemma="חֵמָה" strong="H2534" x-morph="Ncfsa" x-gloss="rage" x-translit="ḥēmāh" xml:lang="hbo">חֵמָ֑ה</char> <char style="w" x-id="WLC.PRO.15.1.005" x-align="PRO.15.1.a005" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.15.1.006" x-align="PRO.15.1.a006" x-target-ids="t008 t010" x-target="a word" x-target-head="t010" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="a.word" x-translit="ḏəḇar-" xml:lang="hbo">דְבַר</char>־<char style="w" x-id="WLC.PRO.15.1.007" x-align="PRO.15.1.a007" x-target-ids="t009" x-target="grievous" x-target-head="t009" x-head="true" lemma="עֶצֶב" strong="H6089a" x-morph="Ncmsa" x-gloss="of.hurt" x-translit="ʿeṣeḇ" xml:lang="hbo">עֶ֝֗צֶב</char> <char style="w" x-id="WLC.PRO.15.1.008" x-align="PRO.15.1.a008" x-target-ids="t011 t012" x-target="stirreth up" x-target-head="t011" x-head="true" lemma="עָלָה" strong="H5927" x-morph="Vhi3ms" x-gloss="it.raises" x-translit="yaʿăleh-" xml:lang="hbo">יַעֲלֶה</char>־<char style="w" x-id="WLC.PRO.15.1.009" x-align="PRO.15.1.a009" x-target-ids="t013" x-target="anger" x-target-head="t013" x-head="true" lemma="אַף" strong="H639" x-morph="Ncmsa" x-gloss="anger" x-translit="ʾāp̄:" xml:lang="hbo">אָֽף</char>׃<verse eid="PRO 15:1" /></para>
	<para style="p"><verse number="2" style="v" x-ref="PRO.15.2" sid="PRO 15:2" /><char style="w" x-id="WLC.PRO.15.2.001" x-align="PRO.15.2.a001" x-target-ids="t001 t002" x-target="The tongue" x-target-head="t002" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="[the].tongue" x-translit="ləšôn" xml:lang="hbo">לְשׁ֣וֹן</char> <char style="w" x-id="WLC.PRO.15.2.002" x-align="PRO.15.2.a002" x-target-ids="t003 t004 t005" x-target="of the wise" x-target-head="t005" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="of.wise.[people]" x-translit="ḥăḵāmîm" xml:lang="hbo">חֲ֭כָמִים</char> <char style="w" x-id="WLC.PRO.15.2.003" x-align="PRO.15.2.a003" x-target-ids="t006 t008" x-target="uttereth aright" x-target-head="t008" x-head="true" lemma="יָטַב" strong="H3190" x-morph="Vhi3fs" x-gloss="it.makes.good" x-translit="têṭiyḇ" xml:lang="hbo">תֵּיטִ֣יב</char> <char style="w" x-id="WLC.PRO.15.2.004" x-align="PRO.15.2.a004" x-target-ids="t007" x-target="knowledge" x-target-head="t007" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="dāʿaṯ" xml:lang="hbo">דָּ֑עַת</char> <char style="w" x-id="WLC.PRO.15.2.005" x-align="PRO.15.2.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.15.2.006" x-align="PRO.15.2.a006" x-target-ids="t010 t011" x-target="the mouth" x-target-head="t011" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄iy" xml:lang="hbo">פִ֥י</char> <char style="w" x-id="WLC.PRO.15.2.007" x-align="PRO.15.2.a007" x-target-ids="t012 t013" x-target="of fools" x-target-head="t013" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aampa" x-gloss="of.fools" x-translit="ḵəsîliym" xml:lang="hbo">כְ֝סִילִ֗ים</char> <char style="w" x-id="WLC.PRO.15.2.008" x-align="PRO.15.2.a008" x-target-ids="t014 t015" x-target="pou