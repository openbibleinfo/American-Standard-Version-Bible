	<para style="p"><verse number="17" style="v" x-ref="PRO.20.17" sid="PRO 20:17" /><char style="w" x-id="WLC.PRO.20.17.001" x-align="PRO.20.17.a003" x-target-ids="t004 t005" x-target="is sweet" x-target-head="t005" x-head="true" lemma="עָרֵב" strong="H6156" x-morph="Aamsa" x-gloss="[is].sweet" x-translit="ʿārēḇ" xml:lang="hbo">עָרֵ֣ב</char> <char style="w" x-id="WLC.PRO.20.17.002" x-align="PRO.20.17.a004" x-target-ids="t006" x-target="to" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ֭</char><char style="w" x-id="WLC.PRO.20.17.003" x-align="PRO.20.17.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.20.17.004" x-align="PRO.20.17.a006" x-target-ids="t007 t008" x-target="a man" x-target-head="t008" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="person" x-translit="ʾîš" xml:lang="hbo">אִישׁ</char> <char style="w" x-id="WLC.PRO.20.17.005" x-align="PRO.20.17.a001" x-target-ids="t001" x-target="Bread" x-target-head="t001" x-head="true" lemma="לֶחֶם" strong="H3899" x-morph="Ncbsc" x-gloss="food" x-translit="leḥem" xml:lang="hbo">לֶ֣חֶם</char> <char style="w" x-id="WLC.PRO.20.17.006" x-align="PRO.20.17.a002" x-target-ids="t002 t003" x-target="of falsehood" x-target-head="t003" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāqer" xml:lang="hbo">שָׁ֑קֶר</char> <char style="w" x-id="WLC.PRO.20.17.007" x-align="PRO.20.17.a007" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.20.17.008" x-align="PRO.20.17.a008" x-target-ids="t010" x-target="afterwards" x-target-head="t010" x-head="true" lemma="אַחַר" strong="H310" x-morph="D" x-gloss="after" x-translit="ʾaḥar" xml:lang="hbo