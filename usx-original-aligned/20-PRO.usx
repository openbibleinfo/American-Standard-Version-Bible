	<para style="p"><verse number="14" style="v" x-ref="PRO.11.14" sid="PRO 11:14" /><char style="w" x-id="WLC.PRO.11.14.001" x-align="PRO.11.14.a001" x-target-ids="t001" x-target="Where" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.11.14.002" x-align="PRO.11.14.a002" x-target-ids="t002 t005" x-target="no is" x-target-head="t002" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.PRO.11.14.003" x-align="PRO.11.14.a003" x-target-ids="t003 t004" x-target="wise guidance" x-target-head="t004" x-head="true" lemma="תַּחְבֻּלֹות" strong="H8458" x-morph="Ncfpa" x-gloss="guidance(s)" x-translit="taḥbulôṯ" xml:lang="hbo">תַּ֭חְבֻּלוֹת</char> <char style="w" x-id="WLC.PRO.11.14.004" x-align="PRO.11.14.a004" x-target-ids="t008" x-target="falleth" x-target-head="t008" x-head="true" lemma="נָפַל" strong="H5307" x-morph="Vqi3ms" x-gloss="it.falls" x-translit="yippāl-" xml:lang="hbo">יִפָּל</char>־<char style="w" x-id="WLC.PRO.11.14.005" x-align="PRO.11.14.a005" x-target-ids="t006 t007" x-target="the people" x-target-head="t007" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿām" xml:lang="hbo">עָ֑ם</char> <char style="w" x-id="WLC.PRO.11.14.006" x-align="PRO.11.14.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.11.14.007" x-align="PRO.11.14.a007" x-target-ids="t017" x-target="safety" x-target-head="t017" x-head="true" lemma="תְּשׁוּעָה" strong="H8668" x-morph="Ncfsa" x-gloss="victory" x-translit="ṯəšûʿāh" xml:lang="hbo">תְשׁוּעָ֗ה</char> <char style="w" x-id="WLC.PRO.11.14.008" x-align="PRO.11.14.a008" x-target-ids="t010 t015 t016" x-target="in there is" x-target-head="t010" x-head="