	<para style="p"><verse number="20" style="v" x-ref="PRO.5.20" sid="PRO 5:20" /><char style="w" x-id="WLC.PRO.5.20.001" x-align="PRO.5.20.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.5.20.002" x-align="PRO.5.20.a002" lemma="לָמָה" strong="H3807a" x-morph="R" x-translit="lā" xml:lang="hbo">לָ֤</char><char style="w" x-id="WLC.PRO.5.20.003" x-align="PRO.5.20.a002" x-target-ids="t002" x-target="why" x-target-head="t002" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="why?" x-translit="mmâ" xml:lang="hbo">מָּה</char> <char style="w" x-id="WLC.PRO.5.20.004" x-align="PRO.5.20.a003" x-target-ids="t003 t004 t007 t008" x-target="shouldest thou be ravished" x-target-head="t008" x-head="true" lemma="שָׁגָה" strong="H7686" x-morph="Vqi2ms" x-gloss="will.you.go.astray" x-translit="ṯišgeh" xml:lang="hbo">תִשְׁגֶּ֣ה</char> <char style="w" x-id="WLC.PRO.5.20.005" x-align="PRO.5.20.a005" x-target-ids="t006" x-target="son" x-target-head="t006" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="ḇən" xml:lang="hbo">בְנִ֣</char><char style="w" x-id="WLC.PRO.5.20.006" x-align="PRO.5.20.a004" x-target-ids="t005" x-target="my" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.5.20.007" x-align="PRO.5.20.a006" x-target-ids="t009" x-target="with" x-target-head="t009" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.5.20.008" x-align="PRO.5.20.a007" x-target-ids="t010 t011 t012" x-target="a strange woman" x-target-head="t011" x-head="true" lemma="זָר" strong="H2114b" x-morph="Aafsa" x-gloss="a.strange.[woman]" x-translit="zārāh" xml:lang="hbo">זָרָ֑ה</char> <char style="w" x-id="WLC.PRO.5.20.00