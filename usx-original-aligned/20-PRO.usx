	<para style="p"><verse number="8" style="v" x-ref="PRO.30.8" sid="PRO 30:8" /><char style="w" x-id="WLC.PRO.30.8.001" x-align="PRO.30.8.a001" x-target-ids="t005" x-target="falsehood" x-target-head="t005" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="deceitfulness" x-translit="šāwəʾ" xml:lang="hbo">שָׁ֤וְא</char>׀<char style="w" x-id="WLC.PRO.30.8.002" x-align="PRO.30.8.a002" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּֽ</char><char style="w" x-id="WLC.PRO.30.8.003" x-align="PRO.30.8.a003" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="a.word" x-translit="ḏəḇar-" xml:lang="hbo">דְבַר</char>־<char style="w" x-id="WLC.PRO.30.8.004" x-align="PRO.30.8.a003" x-target-ids="t007" x-target="lies" x-target-head="t007" x-head="true" lemma="כָּזָב" strong="H3577" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="kāzāḇ" xml:lang="hbo">כָּזָ֡ב</char> <char style="w" x-id="WLC.PRO.30.8.005" x-align="PRO.30.8.a004" x-target-ids="t001 t002" x-target="Remove far" x-target-head="t002" x-head="true" lemma="רָחַק" strong="H7368" x-morph="Vhv2ms" x-gloss="put.far.away" x-translit="harḥēq" xml:lang="hbo">הַרְחֵ֬ק</char> <char style="w" x-id="WLC.PRO.30.8.006" x-align="PRO.30.8.a005" x-target-ids="t003" x-target="from" x-target-head="t003" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mimm" xml:lang="hbo">מִמֶּ֗</char><char style="w" x-id="WLC.PRO.30.8.007" x-align="PRO.30.8.a006" x-target-ids="t004" x-target="me" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="enniy" xml:lang="hbo">נִּי</char> <char style="w" x-id="WLC.PRO.30.8.008" x-align="PRO.30.8.a007" x-target-ids="t011" x-target="poverty" x-target-head="t011" x-head="true" lemma="רֵישׁ" strong="H7389" x-morph="Ncmsa" x-gloss="poverty" x-translit="rēʾš" xml:lang="hbo">רֵ֣אשׁ</char> <char style="w" x-id=