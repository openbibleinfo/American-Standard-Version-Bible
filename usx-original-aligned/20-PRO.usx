	<para style="p"><verse number="3" style="v" x-ref="PRO.24.3" sid="PRO 24:3" /><char style="w" x-id="WLC.PRO.24.3.001" x-align="PRO.24.3.a001" x-target-ids="t001" x-target="Through" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.24.3.002" x-align="PRO.24.3.a002" x-target-ids="t002" x-target="wisdom" x-target-head="t002" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmâ" xml:lang="hbo">חָכְמָה</char> <char style="w" x-id="WLC.PRO.24.3.003" x-align="PRO.24.3.a003" x-target-ids="t003 t006" x-target="is builded" x-target-head="t006" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="VNi3ms" x-gloss="it.is.built" x-translit="yibbāneh" xml:lang="hbo">יִבָּ֣נֶה</char> <char style="w" x-id="WLC.PRO.24.3.004" x-align="PRO.24.3.a004" x-target-ids="t004 t005" x-target="a house" x-target-head="t005" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsa" x-gloss="a.house" x-translit="bāyiṯ" xml:lang="hbo">בָּ֑יִת</char> <char style="w" x-id="WLC.PRO.24.3.005" x-align="PRO.24.3.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.24.3.006" x-align="PRO.24.3.a006" x-target-ids="t008" x-target="by" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇi" xml:lang="hbo">בִ</char><char style="w" x-id="WLC.PRO.24.3.007" x-align="PRO.24.3.a007" x-target-ids="t009" x-target="understanding" x-target-head="t009" x-head="true" lemma="תְּבוּנָה" strong="H8394" x-morph="Ncfsa" x-gloss="understanding" x-translit="ṯəḇûnāh" xml:lang="hbo">תְבוּנָ֗ה</char> <char style="w" x-id="WLC.PRO.24.3.008" x-align="PRO.24.3.a008" x-target-ids="t010 t011 t012" x-target="it is established" x-target-head="t012" x-head="true" lemma="כּוּן" strong="H3559" x-mor