	<para style="p"><verse number="4" style="v" x-ref="PRO.16.4" sid="PRO 16:4" /><char style="w" x-id="WLC.PRO.16.4.001" x-align="PRO.16.4.a003" x-target-ids="t004" x-target="everything" x-target-head="t004" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="everything" x-translit="kōl" xml:lang="hbo">כֹּ֤ל</char><char style="w" x-id="WLC.PRO.16.4.002" x-align="PRO.16.4.a002" x-target-ids="t002 t003" x-target="hath made" x-target-head="t003" x-head="true" lemma="פָּעַל" strong="H6466" x-morph="Vqp3ms" x-gloss="he.makes" x-translit="pāʿal" xml:lang="hbo">פָּעַ֣ל</char> <char style="w" x-id="WLC.PRO.16.4.003" x-align="PRO.16.4.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.16.4.004" x-align="PRO.16.4.a004" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="for" x-translit="la" xml:lang="hbo">לַֽ</char><char style="w" x-id="WLC.PRO.16.4.005" x-align="PRO.16.4.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.16.4.006" x-align="PRO.16.4.a007" x-target-ids="t008" x-target="end" x-target-head="t008" x-head="true" lemma="מַעֲנֶה" strong="H4617a" x-morph="Ncmsc" x-gloss="purpose" x-translit="mmaʿăn" xml:lang="hbo">מַּעֲנֵ֑</char><char style="w" x-id="WLC.PRO.16.4.007" x-align="PRO.16.4.a006" x-target-ids="t006 t007" x-target="its own" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="its" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.16.4.008" x-align="PRO.16.4.a008" x-target-ids="t009" x-target="Yea" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="