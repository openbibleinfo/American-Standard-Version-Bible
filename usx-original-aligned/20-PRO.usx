	<para style="p"><verse number="8" style="v" x-ref="PRO.9.8" sid="PRO 9:8" /><char style="w" x-id="WLC.PRO.9.8.001" x-align="PRO.9.8.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.9.8.002" x-align="PRO.9.8.a002" x-target-ids="t001" x-target="Reprove" x-target-head="t001" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhj2ms" x-gloss="reprove" x-translit="tôḵaḥ" xml:lang="hbo">תּ֣וֹכַח</char> <char style="w" x-id="WLC.PRO.9.8.003" x-align="PRO.9.8.a003" x-target-ids="t003 t004" x-target="a scoffer" x-target-head="t004" x-head="true" lemma="לֵץ" strong="H3887a" x-morph="Aamsa" x-gloss="a.mocker" x-translit="lēṣ" xml:lang="hbo">לֵ֭ץ</char> <char style="w" x-id="WLC.PRO.9.8.004" x-align="PRO.9.8.a004" x-target-ids="t005" x-target="lest" x-target-head="t005" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo">פֶּן</char>־<char style="w" x-id="WLC.PRO.9.8.005" x-align="PRO.9.8.a005" x-target-ids="t006 t007" x-target="he hate" x-target-head="t007" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqi3ms" x-gloss="he" x-translit="yiśnāʾ" xml:lang="hbo">יִשְׂנָאֶ֑</char><char style="w" x-id="WLC.PRO.9.8.006" x-align="PRO.9.8.a006" x-target-ids="t008" x-target="thee" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="should.hate.you" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.PRO.9.8.007" x-align="PRO.9.8.a007" x-target-ids="t009" x-target="Reprove" x-target-head="t009" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhv2ms" x-gloss="reprove" x-translit="hôḵaḥ" xml:lang="hbo">הוֹכַ֥ח</char> <char style="w" x-id="WLC.PRO.9.8.008" x-align="PRO.9.8.a008" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to).a" x-translit="lə" xml:lang="hbo">לְ֝</char><char styl