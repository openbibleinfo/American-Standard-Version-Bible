	<para style="p"><verse number="21" style="v" x-ref="PRO.5.21" sid="PRO 5:21" /><char style="w" x-id="WLC.PRO.5.21.001" x-align="PRO.5.21.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.5.21.002" x-align="PRO.5.21.a004" x-target-ids="t006 t007" x-target="are before" x-target-head="t007" x-head="true" lemma="נֹכַח" strong="H5227" x-morph="R" x-gloss="[are].in.front.of" x-translit="nōḵaḥ" xml:lang="hbo">נֹ֨כַח</char>׀<char style="w" x-id="WLC.PRO.5.21.003" x-align="PRO.5.21.a005" x-target-ids="t008 t009" x-target="the eyes" x-target-head="t009" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="the.eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֣י</char> <char style="w" x-id="WLC.PRO.5.21.004" x-align="PRO.5.21.a006" x-target-ids="t010 t011" x-target="of Jehovah" x-target-head="t011" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.5.21.005" x-align="PRO.5.21.a002" x-target-ids="t002 t003" x-target="the ways" x-target-head="t003" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="the.ways" x-translit="darḵê-" xml:lang="hbo">דַּרְכֵי</char>־<char style="w" x-id="WLC.PRO.5.21.006" x-align="PRO.5.21.a003" x-target-ids="t004 t005" x-target="of man" x-target-head="t005" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="of.a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֑ישׁ</char> <char style="w" x-id="WLC.PRO.5.21.007" x-align="PRO.5.21.a007" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.5.21.008" x-align="PRO.5.21.a009" x-target-ids="t016" x-target="all" x-target-head="t016" x-head="true" lemma="כֹּל" strong="H3605" x-mor