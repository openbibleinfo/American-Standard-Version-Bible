	<para style="p"><verse number="23" style="v" x-ref="PRO.22.23" sid="PRO 22:23" /><char style="w" x-id="WLC.PRO.22.23.001" x-align="PRO.22.23.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.22.23.002" x-align="PRO.22.23.a002" x-target-ids="t002" x-target="Jehovah" x-target-head="t002" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.22.23.003" x-align="PRO.22.23.a003" x-target-ids="t003 t004" x-target="will plead" x-target-head="t004" x-head="true" lemma="רִיב" strong="H7378" x-morph="Vqi3ms" x-gloss="he.will.conduct" x-translit="yāriyḇ" xml:lang="hbo">יָרִ֣יב</char> <char style="w" x-id="WLC.PRO.22.23.004" x-align="PRO.22.23.a005" x-target-ids="t006" x-target="cause" x-target-head="t006" x-head="true" lemma="רִיב" strong="H7379" x-morph="Ncbsc" x-gloss="case" x-translit="riyḇ" xml:lang="hbo">רִיבָ֑</char><char style="w" x-id="WLC.PRO.22.23.005" x-align="PRO.22.23.a004" x-target-ids="t005" x-target="their" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PRO.22.23.006" x-align="PRO.22.23.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.22.23.007" x-align="PRO.22.23.a007" x-target-ids="t008 t009" x-target="despoil of" x-target-head="t008" x-head="true" lemma="קָבַע" strong="H6906" x-morph="Vqq3ms" x-gloss="he.will.rob" x-translit="qāḇaʿ" xml:lang="hbo">קָבַ֖ע</char> <char style="w" x-id="WLC.PRO.22.23.008" x-align="PRO.22.23.a009" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo"