	<para style="p"><verse number="16" style="v" x-ref="PRO.9.16" x-added-alignments="PRO.9.16.a006" x-added-target-ids="t010 t011" x-added-target="as for" sid="PRO 9:16" /><char style="w" x-id="WLC.PRO.9.16.001" x-align="PRO.9.16.a001" x-target-ids="t001" x-target="Whoso" x-target-head="t001" x-head="true" lemma="מִי" strong="H4310" x-morph="Ti" x-gloss="who?" x-translit="mî-" xml:lang="hbo">מִי</char>־<char style="w" x-id="WLC.PRO.9.16.002" x-align="PRO.9.16.a002" x-target-ids="t002 t003" x-target="is simple" x-target-head="t003" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmsa" x-gloss="[is].naive" x-translit="p̄eṯî" xml:lang="hbo">פֶ֭תִי</char> <char style="w" x-id="WLC.PRO.9.16.003" x-align="PRO.9.16.a003" x-target-ids="t004 t005 t006 t007" x-target="let him turn in" x-target-head="t006" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vqj3ms" x-gloss="let.him.turn.aside" x-translit="yāsur" xml:lang="hbo">יָסֻ֣ר</char> <char style="w" x-id="WLC.PRO.9.16.004" x-align="PRO.9.16.a004" x-target-ids="t008" x-target="hither" x-target-head="t008" x-head="true" lemma="הֵנָּה" strong="H2008" x-morph="D" x-gloss="here" x-translit="hēnnâ" xml:lang="hbo">הֵ֑נָּה</char> <char style="w" x-id="WLC.PRO.9.16.005" x-align="PRO.9.16.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[one]" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.9.16.006" x-align="PRO.9.16.a007" x-target-ids="t012 t013 t014 t015" x-target="him that is void" x-target-head="t015" x-head="true" lemma="חָסֵר" strong="H2638" x-morph="Aamsc" x-gloss="lacking" x-translit="ḥăsar-" xml:lang="hbo">חֲסַר</char>־<char style="w" x-id="WLC.PRO.9.16.007" x-align="PRO.9.16.a008" x-target-ids="t016 t017" x-target="of understanding" x-target-head="t017" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֝֗ב</char> <char style="w" x-id="WLC.PRO.9.16.008" x-ali