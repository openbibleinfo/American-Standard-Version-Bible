	<para style="p"><verse number="18" style="v" x-ref="PRO.26.18" sid="PRO 26:18" /><char style="w" x-id="WLC.PRO.26.18.001" x-align="PRO.26.18.a001" x-target-ids="t001" x-target="As" x-target-head="t001" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="kə" xml:lang="hbo">כְּֽ֭</char><char style="w" x-id="WLC.PRO.26.18.002" x-align="PRO.26.18.a002" x-target-ids="t002 t003" x-target="a madman" x-target-head="t003" x-head="true" lemma="להה" strong="H3856" x-morph="Vfrmsa" x-gloss="a.madman" x-translit="miṯlahlēᵃẖ" xml:lang="hbo">מִתְלַהְלֵהַּ</char> <char style="w" x-id="WLC.PRO.26.18.003" x-align="PRO.26.18.a003" x-target-ids="t004" x-target="who" x-target-head="t004" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[who]" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PRO.26.18.004" x-align="PRO.26.18.a004" x-target-ids="t005" x-target="casteth" x-target-head="t005" x-head="true" lemma="יָרָה" strong="H3384" x-morph="Vqrmsa" x-gloss="throws" x-translit="yyōreh" xml:lang="hbo">יֹּרֶ֥ה</char> <char style="w" x-id="WLC.PRO.26.18.005" x-align="PRO.26.18.a005" x-target-ids="t006" x-target="firebrands" x-target-head="t006" x-head="true" lemma="זֵק" strong="H2131b" x-morph="Ncbpa" x-gloss="burning.arrows" x-translit="ziqqiym" xml:lang="hbo">זִקִּ֗ים</char> <char style="w" x-id="WLC.PRO.26.18.006" x-align="PRO.26.18.a006" x-target-ids="t007" x-target="Arrows" x-target-head="t007" x-head="true" lemma="חֵץ" strong="H2671" x-morph="Ncmpa" x-gloss="arrows" x-translit="ḥiṣṣiym" xml:lang="hbo">חִצִּ֥ים</char> <char style="w" x-id="WLC.PRO.26.18.007" x-align="PRO.26.18.a007" x-target-ids="t008" x-target="and" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PRO.26.18.008" x-align="PRO.26.18.a008" x-target-ids="t009" x-target="death" x-target-head="t009" x-head="true" lemma="מָוֶת" strong="H4194" x-morph="Ncmsa" x-g