	<para style="p"><verse number="9" style="v" x-ref="PRO.13.9" sid="PRO 13:9" /><char style="w" x-id="WLC.PRO.13.9.001" x-align="PRO.13.9.a001" x-target-ids="t001 t002" x-target="The light" x-target-head="t002" x-head="true" lemma="אוֹר" strong="H216" x-morph="Ncbsc" x-gloss="[the].light" x-translit="ʾôr-" xml:lang="hbo">אוֹר</char>־<char style="w" x-id="WLC.PRO.13.9.002" x-align="PRO.13.9.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="of.righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַדִּיקִ֥ים</char> <char style="w" x-id="WLC.PRO.13.9.003" x-align="PRO.13.9.a003" x-target-ids="t006" x-target="rejoiceth" x-target-head="t006" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqi3ms" x-gloss="it.rejoices" x-translit="yiśmāḥ" xml:lang="hbo">יִשְׂמָ֑ח</char> <char style="w" x-id="WLC.PRO.13.9.004" x-align="PRO.13.9.a004" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.9.005" x-align="PRO.13.9.a005" x-target-ids="t008 t009" x-target="the lamp" x-target-head="t009" x-head="true" lemma="נֵר" strong="H5216" x-morph="Ncmsc" x-gloss="lamp" x-translit="nēr" xml:lang="hbo">נֵ֖ר</char> <char style="w" x-id="WLC.PRO.13.9.006" x-align="PRO.13.9.a006" x-target-ids="t010 t011 t012" x-target="of the wicked" x-target-head="t012" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.13.9.007" x-align="PRO.13.9.a007" x-target-ids="t013 t014 t015 t016" x-target="shall be put out" x-target-head="t015" x-head="true" lemma="דָּעַךְ" strong="H1846" x-morph="Vqi3ms" x-gloss="it.is.extinguished" x-translit="yiḏʿāḵ:" xml:lang="hbo">יִדְעָֽךְ</char>׃<verse eid="PRO 13:9" /></para>
	<para style="p"><verse number="10" style="v" x-ref="PRO.13.10" sid="PRO 13:10" /><char style="w" x-id="WLC.PRO.13.10.001" x-align="PRO.13.10.a001" x-target-ids="t004" x-target="only" x-target-head="t004" x-head="true" lemma="רַק" strong="H7535" x-morph="Ta" x-gloss="only" x-translit="raq-" xml:lang="hbo">רַק</char>־<char style="w" x-id="WLC.PRO.13.10.002" x-align="PRO.13.10.a002" x-target-ids="t001" x-target="By" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.13.10.003" x-align="PRO.13.10.a003" x-target-ids="t002" x-target="pride" x-target-head="t002" x-head="true" lemma="זָדוֹן" strong="H2087" x-morph="Ncmsa" x-gloss="presumption" x-translit="zāḏôn" xml:lang="hbo">זָדוֹן</char> <char style="w" x-id="WLC.PRO.13.10.004" x-align="PRO.13.10.a004" x-target-ids="t003" x-target="cometh" x-target-head="t003" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="it.gives" x-translit="yittēn" xml:lang="hbo">יִתֵּ֣ן</char> <char style="w" x-id="WLC.PRO.13.10.005" x-align="PRO.13.10.a005" x-target-ids="t005" x-target="contention" x-target-head="t005" x-head="true" lemma="מַצָּה" strong="H4683" x-morph="Ncfsa" x-gloss="contention" x-translit="maṣṣāh" xml:lang="hbo">מַצָּ֑ה</char> <char style="w" x-id="WLC.PRO.13.10.006" x-align="PRO.13.10.a006" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.10.007" x-align="PRO.13.10.a007" x-target-ids="t007 t011" x-target="with is" x-target-head="t007" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.13.10.008" x-align="PRO.13.10.a008" x-target-ids="t008 t009 t010" x-target="the well advised" x-target-head="t010" x-head="true" lemma="יָעַץ" strong="H3289" x-morph="VNrmpa" x-