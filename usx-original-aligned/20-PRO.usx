	<para style="p"><verse number="3" style="v" x-ref="PRO.20.3" x-added-alignments="PRO.20.3.a001" x-added-target-ids="t001" x-added-target="It" sid="PRO 20:3" /><char style="w" x-id="WLC.PRO.20.3.001" x-align="PRO.20.3.a002" x-target-ids="t002 t003 t004" x-target="is an honor" x-target-head="t004" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsa" x-gloss="[is].honor" x-translit="kāḇôḏ" xml:lang="hbo">כָּב֣וֹד</char> <char style="w" x-id="WLC.PRO.20.3.002" x-align="PRO.20.3.a003" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ֭</char><char style="w" x-id="WLC.PRO.20.3.003" x-align="PRO.20.3.a004" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="(the)" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.20.3.004" x-align="PRO.20.3.a005" x-target-ids="t006 t007" x-target="a man" x-target-head="t007" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsa" x-gloss="person" x-translit="ʾîš" xml:lang="hbo">אִישׁ</char> <char style="w" x-id="WLC.PRO.20.3.005" x-align="PRO.20.3.a006" x-target-ids="t008 t009 t010" x-target="to keep aloof" x-target-head="t010" x-head="true" lemma="שֶׁבֶת" strong="H7674" x-morph="Ncfsa" x-gloss="cessation" x-translit="šeḇeṯ" xml:lang="hbo">שֶׁ֣בֶת</char> <char style="w" x-id="WLC.PRO.20.3.006" x-align="PRO.20.3.a007" x-target-ids="t011" x-target="from" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.20.3.007" x-align="PRO.20.3.a008" x-target-ids="t012" x-target="strife" x-target-head="t012" x-head="true" lemma="רִיב" strong="H7379" x-morph="Ncbsa" x-gloss="strife" x-translit="riyḇ" xml:lang="hbo">רִ֑יב</char> <char style="w" x-id="WLC.PRO.20.3.008" x-align="PRO.20.3.a009" x-target-ids="t013" x-target="But" x-target-head="t013" x-head="true" lemma="וְ" stron