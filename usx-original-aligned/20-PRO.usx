	<para style="p"><verse number="2" style="v" x-ref="PRO.5.2" sid="PRO 5:2" /><char style="w" x-id="WLC.PRO.5.2.001" x-align="PRO.5.2.a001" x-target-ids="t001 t007" x-target="That that" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.5.2.002" x-align="PRO.5.2.a002" x-target-ids="t002 t003 t004" x-target="thou mayest preserve" x-target-head="t004" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqc" x-gloss="preserve" x-translit="šəmōr" xml:lang="hbo">שְׁמֹ֥ר</char> <char style="w" x-id="WLC.PRO.5.2.003" x-align="PRO.5.2.a003" x-target-ids="t005" x-target="discretion" x-target-head="t005" x-head="true" lemma="מְזִמָּה" strong="H4209" x-morph="Ncfpa" x-gloss="discretion" x-translit="məzimmôṯ" xml:lang="hbo">מְזִמּ֑וֹת</char> <char style="w" x-id="WLC.PRO.5.2.004" x-align="PRO.5.2.a004" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.5.2.005" x-align="PRO.5.2.a008" x-target-ids="t012" x-target="knowledge" x-target-head="t012" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֗עַת</char> <char style="w" x-id="WLC.PRO.5.2.006" x-align="PRO.5.2.a006" x-target-ids="t009" x-target="lips" x-target-head="t009" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śəp̄āṯey" xml:lang="hbo">שְׂפָתֶ֥י</char><char style="w" x-id="WLC.PRO.5.2.007" x-align="PRO.5.2.a005" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.5.2.008" x-align="PRO.5.2.a007" x-target-ids="t010 t011" x-target="may keep" x-target-head="t011" x-head="true" lemma="נָצַר" strong="H5341" x-morph="Vqi3mp" x-gloss=