	<para style="p"><verse number="24" style="v" x-ref="PRO.3.24" sid="PRO 3:24" /><char style="w" x-id="WLC.PRO.3.24.001" x-align="PRO.3.24.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.3.24.002" x-align="PRO.3.24.a002" x-target-ids="t002 t003 t004" x-target="thou liest down" x-target-head="t003" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqi2ms" x-gloss="you.will.lie.down" x-translit="tiškaḇ" xml:lang="hbo">תִּשְׁכַּ֥ב</char> <char style="w" x-id="WLC.PRO.3.24.003" x-align="PRO.3.24.a003" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.3.24.004" x-align="PRO.3.24.a004" x-target-ids="t005 t006 t008 t009" x-target="thou shalt be afraid" x-target-head="t009" x-head="true" lemma="פָּחַד" strong="H6342" x-morph="Vqi2ms" x-gloss="you.will.fear" x-translit="ṯip̄ḥāḏ" xml:lang="hbo">תִפְחָ֑ד</char> <char style="w" x-id="WLC.PRO.3.24.005" x-align="PRO.3.24.a005" x-target-ids="t010" x-target="Yea" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.3.24.006" x-align="PRO.3.24.a006" x-target-ids="t011 t012 t013 t014" x-target="thou shalt lie down" x-target-head="t013" x-head="true" lemma="שָׁכַב" strong="H7901" x-morph="Vqq2ms" x-gloss="you.will.lie.down" x-translit="šāḵaḇtā" xml:lang="hbo">שָׁכַבְתָּ֗</char> <char style="w" x-id="WLC.PRO.3.24.007" x-align="PRO.3.24.a007" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.3.24.008" x-align="PRO.3.24.a008" x-target-ids="t018 t019 t020" x-target="shall be sweet" x-target-hea