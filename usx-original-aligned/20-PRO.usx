	<para style="p"><verse number="18" style="v" x-ref="PRO.3.18" sid="PRO 3:18" /><char style="w" x-id="WLC.PRO.3.18.001" x-align="PRO.3.18.a001" x-target-ids="t002 t003 t004" x-target="is a tree" x-target-head="t004" x-head="true" lemma="עֵץ" strong="H6086" x-morph="Ncmsc" x-gloss="[is].a.tree" x-translit="ʿēṣ-" xml:lang="hbo">עֵץ</char>־<char style="w" x-id="WLC.PRO.3.18.002" x-align="PRO.3.18.a002" x-target-ids="t005 t006" x-target="of life" x-target-head="t006" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="of.life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֣ים</char> <char style="w" x-id="WLC.PRO.3.18.003" x-align="PRO.3.18.a003" x-target-ids="t001" x-target="She" x-target-head="t001" x-head="true" lemma="הִיא" strong="H1931a" x-morph="Pp3fs" x-gloss="she" x-translit="hîʾ" xml:lang="hbo">הִ֭יא</char> <char style="w" x-id="WLC.PRO.3.18.004" x-align="PRO.3.18.a004" x-target-ids="t007" x-target="to" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="to" x-translit="la" xml:lang="hbo">לַ</char><char style="w" x-id="WLC.PRO.3.18.005" x-align="PRO.3.18.a005" x-target-ids="t008 t009" x-target="them that" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.3.18.006" x-align="PRO.3.18.a006" x-target-ids="t010 t011" x-target="lay hold" x-target-head="t011" x-head="true" lemma="חָזַק" strong="H2388" x-morph="Vhrmpa" x-gloss="who].take.hold" x-translit="mmaḥăzîqiym" xml:lang="hbo">מַּחֲזִיקִ֣ים</char> <char style="w" x-id="WLC.PRO.3.18.007" x-align="PRO.3.18.a007" x-target-ids="t012" x-target="upon" x-target-head="t012" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="b" xml:lang="hbo">בָּ֑</char><char style="w" x-id="WLC.PRO.3.18.008" x-align="PRO.3.18.a008" x-target-ids="t013" x-target="her" x-target-head="t013" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss=