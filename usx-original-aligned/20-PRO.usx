	<para style="p"><verse number="26" style="v" x-ref="PRO.26.26" x-added-alignments="PRO.26.26.a001 PRO.26.26.a002" x-added-target-ids="t001 t002" x-added-target="Though | his" sid="PRO 26:26" /><char style="w" x-id="WLC.PRO.26.26.001" x-align="PRO.26.26.a004" x-target-ids="t004 t005" x-target="cover itself" x-target-head="t004" x-head="true" lemma="כָּסָה" strong="H3680" x-morph="VNi3fs" x-gloss="it.covers.itself" x-translit="tikkasseh" xml:lang="hbo">תִּכַּסֶּ֣ה</char> <char style="w" x-id="WLC.PRO.26.26.002" x-align="PRO.26.26.a003" x-target-ids="t003" x-target="hatred" x-target-head="t003" x-head="true" lemma="שִׂנְאָה" strong="H8135" x-morph="Ncfsa" x-gloss="hatred" x-translit="śinʾâ" xml:lang="hbo">שִׂ֭נְאָה</char> <char style="w" x-id="WLC.PRO.26.26.003" x-align="PRO.26.26.a005" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.26.26.004" x-align="PRO.26.26.a006" x-target-ids="t007" x-target="guile" x-target-head="t007" x-head="true" lemma="מַשָּׁאוֹן" strong="H4860" x-morph="Ncmsa" x-gloss="deception" x-translit="maššāʾôn" xml:lang="hbo">מַשָּׁא֑וֹן</char> <char style="w" x-id="WLC.PRO.26.26.005" x-align="PRO.26.26.a009" x-target-ids="t010 t011 t012 t013" x-target="shall be openly showed" x-target-head="t013" x-head="true" lemma="גָּלָה" strong="H1540" x-morph="VNi3fs" x-gloss="it.will.be.revealed" x-translit="tiggāleh" xml:lang="hbo">תִּגָּלֶ֖ה</char> <char style="w" x-id="WLC.PRO.26.26.006" x-align="PRO.26.26.a007" x-target-ids="t009" x-target="wickedness" x-target-head="t009" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsc" x-gloss="wickedness" x-translit="rāʿāṯ" xml:lang="hbo">רָעָת֣</char><char style="w" x-id="WLC.PRO.26.26.007" x-align="PRO.26.26.a008" x-target-ids="t008" x-target="His" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:l