	<para style="p"><verse number="13" style="v" x-ref="PRO.11.13" sid="PRO 11:13" /><char style="w" x-id="WLC.PRO.11.13.001" x-align="PRO.11.13.a001" x-target-ids="t001 t002 t003 t004" x-target="He that goeth about" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[one.who].goes.about" x-translit="hôlēḵ" xml:lang="hbo">הוֹלֵ֣ךְ</char> <char style="w" x-id="WLC.PRO.11.13.002" x-align="PRO.11.13.a002" x-target-ids="t005 t006 t007 t008" x-target="as a tale bearer" x-target-head="t008" x-head="true" lemma="רָכִיל" strong="H7400" x-morph="Ncmsa" x-gloss="slander" x-translit="rāḵîl" xml:lang="hbo">רָ֭כִיל</char> <char style="w" x-id="WLC.PRO.11.13.003" x-align="PRO.11.13.a003" x-target-ids="t009" x-target="revealeth" x-target-head="t009" x-head="true" lemma="גָּלָה" strong="H1540" x-morph="Vprmsa" x-gloss="[is].revealing" x-translit="məḡalleh-" xml:lang="hbo">מְגַלֶּה</char>־<char style="w" x-id="WLC.PRO.11.13.004" x-align="PRO.11.13.a004" x-target-ids="t010" x-target="secrets" x-target-head="t010" x-head="true" lemma="סוֹד" strong="H5475" x-morph="Ncmsa" x-gloss="a.secret" x-translit="ssôḏ" xml:lang="hbo">סּ֑וֹד</char> <char style="w" x-id="WLC.PRO.11.13.005" x-align="PRO.11.13.a005" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.13.006" x-align="PRO.11.13.a006" x-target-ids="t012 t013 t014 t017" x-target="he that is faithful" x-target-head="t017" x-head="true" lemma="אָמַן" strong="H539" x-morph="VNrmsc" x-gloss="[one.who.is].faithful" x-translit="neʾĕman-" xml:lang="hbo">נֶאֱמַן</char>־<char style="w" x-id="WLC.PRO.11.13.007" x-align="PRO.11.13.a007" x-target-ids="t015 t016 t018" x-target="of a spirit" x-target-head="t018" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="of.spirit" x-translit="rûᵃḥ" xml:lang="hbo">ר֝֗וּחַ</char> <char style="w" x-id="WLC.PRO.11.13.