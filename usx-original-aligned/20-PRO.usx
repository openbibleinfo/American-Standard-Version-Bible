	<para style="p"><verse number="5" style="v" x-ref="PRO.16.5" x-added-alignments="PRO.16.5.a006 PRO.16.5.a008" x-added-target-ids="t013 t015" x-added-target="Though | join" sid="PRO 16:5" /><char style="w" x-id="WLC.PRO.16.5.001" x-align="PRO.16.5.a004" x-target-ids="t008 t009 t010" x-target="is an abomination" x-target-head="t010" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[is].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.16.5.002" x-align="PRO.16.5.a005" x-target-ids="t011 t012" x-target="to Jehovah" x-target-head="t012" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.16.5.003" x-align="PRO.16.5.a001" x-target-ids="t001 t002" x-target="Every one" x-target-head="t001" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="kol-" xml:lang="hbo">כָּל</char>־<char style="w" x-id="WLC.PRO.16.5.004" x-align="PRO.16.5.a002" x-target-ids="t003 t004 t005" x-target="that is proud" x-target-head="t005" x-head="true" lemma="גָּבֹהַּ" strong="H1362" x-morph="Aamsc" x-gloss="[person].haughty" x-translit="gəḇaẖ-" xml:lang="hbo">גְּבַהּ</char>־<char style="w" x-id="WLC.PRO.16.5.005" x-align="PRO.16.5.a003" x-target-ids="t006 t007" x-target="in heart" x-target-head="t007" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.16.5.006" x-align="PRO.16.5.a007" x-target-ids="t014" x-target="hand" x-target-head="t014" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsa" x-gloss="hand" x-translit="yāḏ" xml:lang="hbo">יָ֥ד</char> <char style="w" x-id="WLC.PRO.16.5.007" x-align="PRO.16.5.a009" x-target-ids="t016" x-target="in" x-target-head="t016" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ֝</char><char style="w" x-