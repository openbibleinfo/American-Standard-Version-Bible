	<para style="p"><verse number="2" style="v" x-ref="PRO.18.2" sid="PRO 18:2" /><char style="w" x-id="WLC.PRO.18.2.001" x-align="PRO.18.2.a003" x-target-ids="t004" x-target="no" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.18.2.002" x-align="PRO.18.2.a002" x-target-ids="t003 t005" x-target="hath delight" x-target-head="t005" x-head="true" lemma="חָפֵץ" strong="H2654" x-morph="Vqi3ms" x-gloss="he.delights" x-translit="yaḥpōṣ" xml:lang="hbo">יַחְפֹּ֣ץ</char> <char style="w" x-id="WLC.PRO.18.2.003" x-align="PRO.18.2.a001" x-target-ids="t001 t002" x-target="A fool" x-target-head="t002" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aamsa" x-gloss="a.fool" x-translit="kəsîl" xml:lang="hbo">כְּ֭סִיל</char> <char style="w" x-id="WLC.PRO.18.2.004" x-align="PRO.18.2.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PRO.18.2.005" x-align="PRO.18.2.a005" x-target-ids="t007" x-target="understanding" x-target-head="t007" x-head="true" lemma="תְּבוּנָה" strong="H8394" x-morph="Ncfsa" x-gloss="understanding" x-translit="ṯəḇûnāh" xml:lang="hbo">תְבוּנָ֑ה</char> <char style="w" x-id="WLC.PRO.18.2.006" x-align="PRO.18.2.a006" x-target-ids="t008 t009" x-target="But only" x-target-head="t008" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֝֗י</char> <char style="w" x-id="WLC.PRO.18.2.007" x-align="PRO.18.2.a006" lemma="אִם" strong="H518" x-morph="C" x-gloss="(if)" x-translit="ʾim-" xml:lang="hbo">אִֽם</char>־<char style="w" x-id="WLC.PRO.18.2.008" x-align="PRO.18.2.a007" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.18.2