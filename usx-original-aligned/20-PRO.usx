	<para style="p"><verse number="2" style="v" x-ref="PRO.6.2" sid="PRO 6:2" /><char style="w" x-id="WLC.PRO.6.2.001" x-align="PRO.6.2.a001" x-target-ids="t001 t002 t003" x-target="Thou art snared" x-target-head="t003" x-head="true" lemma="יָקֹשׁ" strong="H3369" x-morph="VNp2ms" x-gloss="you.have.been.ensnared" x-translit="nôqašətā" xml:lang="hbo">נוֹקַ֥שְׁתָּ</char> <char style="w" x-id="WLC.PRO.6.2.002" x-align="PRO.6.2.a002" x-target-ids="t004" x-target="with" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.6.2.003" x-align="PRO.6.2.a003" x-target-ids="t005 t006" x-target="the words" x-target-head="t006" x-head="true" lemma="אֵמֶר" strong="H561" x-morph="Ncmpc" x-gloss="the.words" x-translit="ʾimrê-" xml:lang="hbo">אִמְרֵי</char>־<char style="w" x-id="WLC.PRO.6.2.004" x-align="PRO.6.2.a004" x-target-ids="t007 t009" x-target="of mouth" x-target-head="t009" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="your.mouth" x-translit="p̄iy" xml:lang="hbo">פִ֑י</char><char style="w" x-id="WLC.PRO.6.2.005" x-align="PRO.6.2.a005" x-target-ids="t008" x-target="thy" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.6.2.006" x-align="PRO.6.2.a006" x-target-ids="t010 t011 t012" x-target="Thou art taken" x-target-head="t012" x-head="true" lemma="לָכַד" strong="H3920" x-morph="VNp2ms" x-gloss="you.have.been.caught" x-translit="nilkaḏətā" xml:lang="hbo">נִ֝לְכַּ֗דְתָּ</char> <char style="w" x-id="WLC.PRO.6.2.007" x-align="PRO.6.2.a007" x-target-ids="t013" x-target="with" x-target-head="t013" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.6.2.008" x-align="PRO.6.2.a008" x-target-ids="t014 t015" x-target="the words" x-target-head="t015" x-head="true" lemma="