	<para style="p"><verse number="26" style="v" x-ref="PRO.15.26" sid="PRO 15:26" /><char style="w" x-id="WLC.PRO.15.26.001" x-align="PRO.15.26.a003" x-target-ids="t003 t004 t005" x-target="are an abomination" x-target-head="t005" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[are].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.15.26.002" x-align="PRO.15.26.a004" x-target-ids="t006 t007" x-target="to Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.15.26.003" x-align="PRO.15.26.a002" x-target-ids="t002" x-target="devices" x-target-head="t002" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpc" x-gloss="[the].plans" x-translit="maḥšəḇôṯ" xml:lang="hbo">מַחְשְׁב֣וֹת</char> <char style="w" x-id="WLC.PRO.15.26.004" x-align="PRO.15.26.a001" x-target-ids="t001" x-target="Evil" x-target-head="t001" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="of.an.evil.[person]" x-translit="rāʿ" xml:lang="hbo">רָ֑ע</char> <char style="w" x-id="WLC.PRO.15.26.005" x-align="PRO.15.26.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[are]" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.15.26.006" x-align="PRO.15.26.a008" x-target-ids="t011 t012" x-target="are pure" x-target-italic-ids="t011" x-target-head="t012" x-head="true" lemma="טָהֹר" strong="H2889" x-morph="Aampa" x-gloss="clean" x-translit="ṭəhōriym" xml:lang="hbo">טְהֹרִ֗ים</char> <char style="w" x-id="WLC.PRO.15.26.007" x-align="PRO.15.26.a007" x-target-ids="t010" x-target="words" x-target-head="t010" x-head="true" lemma="אֵמֶר" strong="H561" x-morph="Ncmpc" x-gloss="words" x-translit="ʾimrê-" xml:lang="hbo">אִמְרֵי</char>־<char style="w" x-id="WLC.PRO.15.26.008" x-align="PRO.15.26.a006" x-t