	<para style="p"><verse number="13" style="v" x-ref="PRO.24.13" x-added-alignments="PRO.24.13.a013" x-added-target-ids="t016" x-added-target="which" sid="PRO 24:13" /><char style="w" x-id="WLC.PRO.24.13.001" x-align="PRO.24.13.a001" x-target-ids="t003 t004" x-target="eat thou" x-target-head="t003" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqv2ms" x-gloss="eat" x-translit="ʾĕḵol-" xml:lang="hbo">אֱכָל</char>־<char style="w" x-id="WLC.PRO.24.13.002" x-align="PRO.24.13.a002" x-target-ids="t002" x-target="son" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="bən" xml:lang="hbo">בְּנִ֣</char><char style="w" x-id="WLC.PRO.24.13.003" x-align="PRO.24.13.a003" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.24.13.004" x-align="PRO.24.13.a004" x-target-ids="t005" x-target="honey" x-target-head="t005" x-head="true" lemma="דְּבַשׁ" strong="H1706" x-morph="Ncmsa" x-gloss="honey" x-translit="ḏəḇaš" xml:lang="hbo">דְבַ֣שׁ</char> <char style="w" x-id="WLC.PRO.24.13.005" x-align="PRO.24.13.a005" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.24.13.006" x-align="PRO.24.13.a006" x-target-ids="t007 t008 t009" x-target="it is good" x-target-head="t009" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[it.is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PRO.24.13.007" x-align="PRO.24.13.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.24.13.008" x-align="PRO.24.13.a008" x-target-ids="t011 t012 t013 t014 t015" x-target="the droppi