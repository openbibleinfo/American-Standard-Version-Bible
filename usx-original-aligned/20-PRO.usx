	<para style="p"><verse number="6" style="v" x-ref="PRO.13.6" sid="PRO 13:6" /><char style="w" x-id="WLC.PRO.13.6.001" x-align="PRO.13.6.a001" x-target-ids="t001" x-target="Righteousness" x-target-head="t001" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqâ" xml:lang="hbo">צְ֭דָקָה</char> <char style="w" x-id="WLC.PRO.13.6.002" x-align="PRO.13.6.a002" x-target-ids="t002" x-target="guardeth" x-target-head="t002" x-head="true" lemma="נָצַר" strong="H5341" x-morph="Vqi3fs" x-gloss="it.preserves" x-translit="tiṣṣōr" xml:lang="hbo">תִּצֹּ֣ר</char> <char style="w" x-id="WLC.PRO.13.6.003" x-align="PRO.13.6.a003" x-target-ids="t003 t004 t005 t006" x-target="him that is upright" x-target-head="t006" x-head="true" lemma="תֹּם" strong="H8537" x-morph="Ncmsc" x-gloss="integrity" x-translit="tām-" xml:lang="hbo">תָּם</char>־<char style="w" x-id="WLC.PRO.13.6.004" x-align="PRO.13.6.a004" x-target-ids="t007 t008 t009" x-target="in the way" x-target-head="t009" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="of.way" x-translit="dāreḵ" xml:lang="hbo">דָּ֑רֶךְ</char> <char style="w" x-id="WLC.PRO.13.6.005" x-align="PRO.13.6.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.13.6.006" x-align="PRO.13.6.a006" x-target-ids="t011" x-target="wickedness" x-target-head="t011" x-head="true" lemma="רִשְׁעָה" strong="H7564" x-morph="Ncfsa" x-gloss="wickedness" x-translit="rišʿāh" xml:lang="hbo">רִשְׁעָ֗ה</char> <char style="w" x-id="WLC.PRO.13.6.007" x-align="PRO.13.6.a007" x-target-ids="t012" x-target="overthroweth" x-target-head="t012" x-head="true" lemma="סָלַף" strong="H5557" x-morph="Vpi3fs" x-gloss="it.subverts" x-translit="təsallēp̄" xml:lang="hbo">תְּסַלֵּ֥ף</char> <char style="w" x-id="WLC.PRO.13.6.008" x-align="PRO.13.6.a008" x-target-ids="t013 t014" x-target="t