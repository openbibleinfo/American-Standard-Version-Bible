	<para style="p"><verse number="27" style="v" x-ref="PRO.15.27" sid="PRO 15:27" /><char style="w" x-id="WLC.PRO.15.27.001" x-align="PRO.15.27.a003" x-target-ids="t007" x-target="troubleth" x-target-head="t007" x-head="true" lemma="עָכַר" strong="H5916" x-morph="Vqrmsa" x-gloss="[is].troubling" x-translit="ʿōḵēr" xml:lang="hbo">עֹכֵ֣ר</char> <char style="w" x-id="WLC.PRO.15.27.002" x-align="PRO.15.27.a005" x-target-ids="t010" x-target="house" x-target-head="t010" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="bēyṯ" xml:lang="hbo">בֵּ֭ית</char><char style="w" x-id="WLC.PRO.15.27.003" x-align="PRO.15.27.a004" x-target-ids="t008 t009" x-target="his own" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.own" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.15.27.004" x-align="PRO.15.27.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="He that is greedy of" x-target-head="t004" x-head="true" lemma="בָּצַע" strong="H1214" x-morph="Vqrmsa" x-gloss="[one.who].gains.unjustly" x-translit="bôṣēᵃʿ" xml:lang="hbo">בּוֹצֵ֣עַ</char> <char style="w" x-id="WLC.PRO.15.27.005" x-align="PRO.15.27.a002" x-target-ids="t006" x-target="gain" x-target-head="t006" x-head="true" lemma="בֶּצַע" strong="H1215" x-morph="Ncmsa" x-gloss="unjust.gain" x-translit="bāṣaʿ" xml:lang="hbo">בָּ֑צַע</char> <char style="w" x-id="WLC.PRO.15.27.006" x-align="PRO.15.27.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.15.27.007" x-align="PRO.15.27.a007" x-target-ids="t012 t013 t014" x-target="he that hateth" x-target-head="t014" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[one.who].hates" x-translit="śônēʾ" xml:lang="hbo">שׂוֹנֵ֖א</char> <char style="w" x-id="WLC.PRO.15.27.008" x-align="PRO.15.27.a008" x-target-ids="t015" x-targe