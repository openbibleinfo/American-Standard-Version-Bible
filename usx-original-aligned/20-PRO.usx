	<para style="p"><verse number="7" style="v" x-ref="PRO.13.7" x-added-alignments="PRO.13.7.a007" x-added-target-ids="t017" x-added-target="hath" sid="PRO 13:7" /><char style="w" x-id="WLC.PRO.13.7.001" x-align="PRO.13.7.a001" x-target-ids="t001 t002 t010 t011" x-target="There is There is" x-target-head="t002" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.13.7.002" x-align="PRO.13.7.a002" x-target-ids="t003 t004 t005 t006" x-target="that maketh himself rich" x-target-head="t006" x-head="true" lemma="עָשַׁר" strong="H6238" x-morph="Vtrmsa" x-gloss="[one.who].enriches.himself" x-translit="miṯʿaššēr" xml:lang="hbo">מִ֭תְעַשֵּׁר</char> <char style="w" x-id="WLC.PRO.13.7.003" x-align="PRO.13.7.a003" x-target-ids="t007" x-target="yet" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.7.004" x-align="PRO.13.7.a004" x-target-ids="t008 t009" x-target="hath nothing" x-target-head="t009" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.PRO.13.7.005" x-align="PRO.13.7.a004" lemma="כֹּל" strong="H3605" x-morph="Ncmsa" x-gloss="anything" x-translit="kōl" xml:lang="hbo">כֹּ֑ל</char> <char style="w" x-id="WLC.PRO.13.7.006" x-align="PRO.13.7.a005" x-target-ids="t012 t013 t014 t015" x-target="that maketh himself poor" x-target-head="t015" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vrrmsa" x-gloss="[one.who].impoverishes.himself" x-translit="miṯrôšēš" xml:lang="hbo">מִ֝תְרוֹשֵׁ֗שׁ</char> <char style="w" x-id="WLC.PRO.13.7.007" x-align="PRO.13.7.a006" x-target-ids="t016" x-target="yet" x-target-head="t016" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.7.008" x-align="PRO.1