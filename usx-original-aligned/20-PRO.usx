	<para style="p"><verse number="20" style="v" x-ref="PRO.15.20" sid="PRO 15:20" /><char style="w" x-id="WLC.PRO.15.20.001" x-align="PRO.15.20.a001" x-target-ids="t001 t003" x-target="A son" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="a.son" x-translit="bēn" xml:lang="hbo">בֵּ֣ן</char> <char style="w" x-id="WLC.PRO.15.20.002" x-align="PRO.15.20.a002" x-target-ids="t002" x-target="wise" x-target-head="t002" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="wise" x-translit="ḥāḵām" xml:lang="hbo">חָ֭כָם</char> <char style="w" x-id="WLC.PRO.15.20.003" x-align="PRO.15.20.a003" x-target-ids="t004 t006" x-target="maketh glad" x-target-head="t006" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vpi3ms" x-gloss="he.makes.glad" x-translit="yəśammaḥ-" xml:lang="hbo">יְשַׂמַּח</char>־<char style="w" x-id="WLC.PRO.15.20.004" x-align="PRO.15.20.a004" x-target-ids="t005 t007" x-target="a father" x-target-head="t007" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsa" x-gloss="a.father" x-translit="ʾāḇ" xml:lang="hbo">אָ֑ב</char> <char style="w" x-id="WLC.PRO.15.20.005" x-align="PRO.15.20.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.15.20.006" x-align="PRO.15.20.a006" x-target-ids="t010" x-target="foolish" x-target-head="t010" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aamsa" x-gloss="a.fool" x-translit="ḵəsiyl" xml:lang="hbo">כְסִ֥יל</char> <char style="w" x-id="WLC.PRO.15.20.007" x-align="PRO.15.20.a007" x-target-ids="t009 t011" x-target="a man" x-target-head="t011" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֝דָ֗ם</char> <char style="w" x-id="WLC.PRO.15.20.008" x-align="PRO.15.20.a008" x-target-ids="t012" x-target="despiseth" x-target-head="t012" x-head="true" lemma="בָּזָה" strong=