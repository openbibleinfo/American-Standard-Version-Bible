	<para style="p"><verse number="1" style="v" x-ref="PRO.6.1" sid="PRO 6:1" /><char style="w" x-id="WLC.PRO.6.1.001" x-align="PRO.6.1.a001" x-target-ids="t002" x-target="son" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="bən" xml:lang="hbo">בְּ֭נִ</char><char style="w" x-id="WLC.PRO.6.1.002" x-align="PRO.6.1.a002" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.6.1.003" x-align="PRO.6.1.a003" x-target-ids="t003 t011" x-target="if If" x-target-head="t003" x-head="true" lemma="אִם" strong="H518" x-morph="C" x-gloss="if" x-translit="ʾim-" xml:lang="hbo">אִם</char>־<char style="w" x-id="WLC.PRO.6.1.004" x-align="PRO.6.1.a004" x-target-ids="t004 t005 t006 t007" x-target="thou art become surety" x-target-head="t007" x-head="true" lemma="עָרַב" strong="H6148" x-morph="Vqp2ms" x-gloss="you.have.stood.surety" x-translit="ʿāraḇətā" xml:lang="hbo">עָרַ֣בְתָּ</char> <char style="w" x-id="WLC.PRO.6.1.005" x-align="PRO.6.1.a005" x-target-ids="t008" x-target="for" x-target-head="t008" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.6.1.006" x-align="PRO.6.1.a006" x-target-ids="t010" x-target="neighbor" x-target-head="t010" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="fellow-citizen" x-translit="rēʿ" xml:lang="hbo">רֵעֶ֑</char><char style="w" x-id="WLC.PRO.6.1.007" x-align="PRO.6.1.a007" x-target-ids="t009" x-target="thy" x-target-head="t009" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.6.1.008" x-align="PRO.6.1.a008" x-target-ids="t012 t013 t014" x-target="thou hast stricken" x-target-head="t014" x-head="true" lemma="תָּקַע" strong="H8628" x-morph="Vqp2ms" x-gloss="y