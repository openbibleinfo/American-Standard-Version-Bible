	<para style="p"><verse number="27" style="v" x-ref="PRO.16.27" sid="PRO 16:27" /><char style="w" x-id="WLC.PRO.16.27.001" x-align="PRO.16.27.a001" x-target-ids="t001 t003" x-target="A man" x-target-head="t003" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֣ישׁ</char> <char style="w" x-id="WLC.PRO.16.27.002" x-align="PRO.16.27.a002" x-target-ids="t002" x-target="worthless" x-target-head="t002" x-head="true" lemma="בְּלִיַּעַל" strong="H1100" x-morph="Ncmsa" x-gloss="of.worthlessness" x-translit="bəliyyaʿal" xml:lang="hbo">בְּ֭לִיַּעַל</char> <char style="w" x-id="WLC.PRO.16.27.003" x-align="PRO.16.27.a003" x-target-ids="t004" x-target="deviseth" x-target-head="t004" x-head="true" lemma="כָּרָה" strong="H3738" x-morph="Vqrmsa" x-gloss="[is].digging.up" x-translit="kōreh" xml:lang="hbo">כֹּרֶ֣ה</char> <char style="w" x-id="WLC.PRO.16.27.004" x-align="PRO.16.27.a004" x-target-ids="t005" x-target="mischief" x-target-head="t005" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="evil" x-translit="rāʿāh" xml:lang="hbo">רָעָ֑ה</char> <char style="w" x-id="WLC.PRO.16.27.005" x-align="PRO.16.27.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.16.27.006" x-align="PRO.16.27.a006" x-target-ids="t007" x-target="in" x-target-head="t007" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.16.27.v002.r01.001" x-align="PRO.16.27.a008" x-target-ids="t009" x-target="lips" x-target-head="t009" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-translit="šp̄ṯy" xml:lang="hbo">שפתי</char><char style="w" x-id="WLC.PRO.16.27.v002.r01.002" x-align="PRO.16.27.a007" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" x-morph="Sp3ms" x-translit