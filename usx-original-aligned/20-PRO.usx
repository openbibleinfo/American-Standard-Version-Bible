	<para style="p"><verse number="14" style="v" x-ref="PRO.3.14" sid="PRO 3:14" /><char style="w" x-id="WLC.PRO.3.14.001" x-align="PRO.3.14.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.3.14.002" x-align="PRO.3.14.a002" x-target-ids="t006 t007" x-target="is better" x-target-head="t007" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֣וֹב</char> <char style="w" x-id="WLC.PRO.3.14.003" x-align="PRO.3.14.a003" x-target-ids="t002 t003" x-target="the gaining" x-target-head="t003" x-head="true" lemma="סַחַר" strong="H5504" x-morph="Ncmsc" x-gloss="profit" x-translit="saḥr" xml:lang="hbo">סַ֭חְרָ</char><char style="w" x-id="WLC.PRO.3.14.004" x-align="PRO.3.14.a004" x-target-ids="t004 t005" x-target="of it" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her.trading" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.3.14.005" x-align="PRO.3.14.a005" x-target-ids="t008" x-target="than" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.3.14.006" x-align="PRO.3.14.a006" x-target-ids="t009 t010" x-target="the gaining" x-target-head="t010" x-head="true" lemma="סָחַר" strong="H5504" x-morph="Ncmsc" x-gloss="than.[the].trading.profit" x-translit="ssəḥar-" xml:lang="hbo">סְּחַר</char>־<char style="w" x-id="WLC.PRO.3.14.007" x-align="PRO.3.14.a007" x-target-ids="t011 t012" x-target="of silver" x-target-head="t012" x-head="true" lemma="כֶּסֶף" strong="H3701" x-morph="Ncmsa" x-gloss="of.silver" x-translit="kāsep̄" xml:lang="hbo">כָּ֑סֶף</char> <char style="w" x-id="WLC.PRO.3.14.008" x-align="PRO.3.14.a008" x-target-ids="t013" x-target="And" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050