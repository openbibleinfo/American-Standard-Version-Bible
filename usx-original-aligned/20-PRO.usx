	<para style="p"><verse number="8" style="v" x-ref="PRO.10.8" sid="PRO 10:8" /><char style="w" x-id="WLC.PRO.10.8.001" x-align="PRO.10.8.a001" x-target-ids="t001 t002" x-target="The wise" x-target-head="t002" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsc" x-gloss="a.[person].wise" x-translit="ḥăḵam-" xml:lang="hbo">חֲכַם</char>־<char style="w" x-id="WLC.PRO.10.8.002" x-align="PRO.10.8.a002" x-target-ids="t003 t004" x-target="in heart" x-target-head="t004" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֭ב</char> <char style="w" x-id="WLC.PRO.10.8.003" x-align="PRO.10.8.a003" x-target-ids="t005 t006" x-target="will receive" x-target-head="t006" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqi3ms" x-gloss="he.accepts" x-translit="yiqqaḥ" xml:lang="hbo">יִקַּ֣ח</char> <char style="w" x-id="WLC.PRO.10.8.004" x-align="PRO.10.8.a004" x-target-ids="t007" x-target="commandments" x-target-head="t007" x-head="true" lemma="מִצְוָה" strong="H4687" x-morph="Ncfpa" x-gloss="commandments" x-translit="miṣwōṯ" xml:lang="hbo">מִצְוֺ֑ת</char> <char style="w" x-id="WLC.PRO.10.8.005" x-align="PRO.10.8.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="we" xml:lang="hbo">וֶ</char><char style="w" x-id="WLC.PRO.10.8.006" x-align="PRO.10.8.a006" x-target-ids="t009 t011" x-target="a fool" x-target-head="t011" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="a.fool" x-translit="ʾĕwiyl" xml:lang="hbo">אֱוִ֥יל</char> <char style="w" x-id="WLC.PRO.10.8.007" x-align="PRO.10.8.a007" x-target-ids="t010" x-target="prating" x-target-head="t010" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfda" x-gloss="of.lips" x-translit="śəp̄āṯayim" xml:lang="hbo">שְׂ֝פָתַ֗יִם</char> <char style="w" x-id="WLC.PRO.10.8.008" x-align="PRO.10.8.a008" x-target-ids="t012 t013" x-target="shall fall" x-target-head="t013" x-hea