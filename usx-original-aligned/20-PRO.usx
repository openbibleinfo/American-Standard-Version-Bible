	<para style="p"><verse number="3" style="v" x-ref="PRO.14.3" x-added-alignments="PRO.14.3.a006" x-added-target-ids="t011" x-added-target="his" sid="PRO 14:3" /><char style="w" x-id="WLC.PRO.14.3.001" x-align="PRO.14.3.a001" x-target-ids="t001" x-target="In" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in.[the]" x-translit="bə" xml:lang="hbo">בְּֽ</char><char style="w" x-id="WLC.PRO.14.3.002" x-align="PRO.14.3.a002" x-target-ids="t002 t003" x-target="the mouth" x-target-head="t003" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄î-" xml:lang="hbo">פִי</char>־<char style="w" x-id="WLC.PRO.14.3.003" x-align="PRO.14.3.a003" x-target-ids="t004 t005 t006" x-target="of the foolish" x-target-head="t006" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="of.a.fool" x-translit="ʾĕwîl" xml:lang="hbo">אֱ֭וִיל</char> <char style="w" x-id="WLC.PRO.14.3.004" x-align="PRO.14.3.a004" x-target-ids="t007 t008 t009" x-target="is a rod" x-target-head="t009" x-head="true" lemma="חֹטֵר" strong="H2415" x-morph="Ncmsc" x-gloss="a.rod" x-translit="ḥōṭer" xml:lang="hbo">חֹ֣טֶר</char> <char style="w" x-id="WLC.PRO.14.3.005" x-align="PRO.14.3.a005" x-target-ids="t010 t012" x-target="for pride" x-target-head="t012" x-head="true" lemma="גַּאֲוָה" strong="H1346" x-morph="Ncfsa" x-gloss="of.pride" x-translit="gaʾăwāh" xml:lang="hbo">גַּאֲוָ֑ה</char> <char style="w" x-id="WLC.PRO.14.3.006" x-align="PRO.14.3.a007" x-target-ids="t013" x-target="But" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.3.007" x-align="PRO.14.3.a008" x-target-ids="t014 t015" x-target="the lips" x-target-head="t015" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śip̄ṯēy" xml:lang="hbo">שִׂפְתֵ֥י</char> <char style="w" x-id="WLC.PRO.14.3.008" x-align="PRO.14.3.a009" x-tar