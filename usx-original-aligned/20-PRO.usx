	<para style="p"><verse number="10" style="v" x-ref="PRO.10.10" sid="PRO 10:10" /><char style="w" x-id="WLC.PRO.10.10.001" x-align="PRO.10.10.a001" x-target-ids="t001 t002 t003" x-target="He that winketh" x-target-head="t003" x-head="true" lemma="קָרַץ" strong="H7169" x-morph="Vqrmsa" x-gloss="[one.who].winks" x-translit="qōrēṣ" xml:lang="hbo">קֹ֣רֵֽץ</char><char style="w" x-id="WLC.PRO.10.10.002" x-align="PRO.10.10.a002" x-target-ids="t004 t005 t006" x-target="with the eye" x-target-head="t006" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbsa" x-gloss="an.eye" x-translit="ʿayin" xml:lang="hbo">עַ֭יִן</char> <char style="w" x-id="WLC.PRO.10.10.003" x-align="PRO.10.10.a003" x-target-ids="t007" x-target="causeth" x-target-head="t007" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3ms" x-gloss="he.gives" x-translit="yittēn" xml:lang="hbo">יִתֵּ֣ן</char> <char style="w" x-id="WLC.PRO.10.10.004" x-align="PRO.10.10.a004" x-target-ids="t008" x-target="sorrow" x-target-head="t008" x-head="true" lemma="עַצֶּבֶת" strong="H6094" x-morph="Ncfsa" x-gloss="sorrow" x-translit="ʿaṣṣāḇeṯ" xml:lang="hbo">עַצָּ֑בֶת</char> <char style="w" x-id="WLC.PRO.10.10.005" x-align="PRO.10.10.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="we" xml:lang="hbo">וֶ</char><char style="w" x-id="WLC.PRO.10.10.006" x-align="PRO.10.10.a006" x-target-ids="t010 t012" x-target="a fool" x-target-head="t012" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="a.fool" x-translit="ʾĕwiyl" xml:lang="hbo">אֱוִ֥יל</char> <char style="w" x-id="WLC.PRO.10.10.007" x-align="PRO.10.10.a007" x-target-ids="t011" x-target="prating" x-target-head="t011" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfda" x-gloss="of.lips" x-translit="śəp̄āṯayim" xml:lang="hbo">שְׂ֝פָתַ֗יִם</char> <char style="w" x-id="WLC.PRO.10.10.008" x-align="PRO.10.10.a008" x-target-ids="t013 t014" x-target="shall fall" x