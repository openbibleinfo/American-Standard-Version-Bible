	<para style="p"><verse number="6" style="v" x-ref="PRO.30.6" sid="PRO 30:6" /><char style="w" x-id="WLC.PRO.30.6.001" x-align="PRO.30.6.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.30.6.002" x-align="PRO.30.6.a002" x-target-ids="t001 t002" x-target="Add thou" x-target-head="t001" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhj2ms" x-gloss="add" x-translit="tôspə" xml:lang="hbo">תּ֥וֹסְףְּ</char> <char style="w" x-id="WLC.PRO.30.6.003" x-align="PRO.30.6.a003" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="to" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.30.6.004" x-align="PRO.30.6.a004" x-target-ids="t006" x-target="words" x-target-head="t006" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpc" x-gloss="words" x-translit="dəḇārāy" xml:lang="hbo">דְּבָרָ֑י</char><char style="w" x-id="WLC.PRO.30.6.005" x-align="PRO.30.6.a005" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.30.6.006" x-align="PRO.30.6.a006" x-target-ids="t007" x-target="Lest" x-target-head="t007" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo">פֶּן</char>־<char style="w" x-id="WLC.PRO.30.6.007" x-align="PRO.30.6.a007" x-target-ids="t008 t009" x-target="he reprove" x-target-head="t009" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhi3ms" x-gloss="he.should.rebuke" x-translit="yôḵiyᵃḥ" xml:lang="hbo">יוֹכִ֖יחַ</char> <char style="w" x-id="WLC.PRO.30.6.008" x-align="PRO.30.6.a008" x-status="unrepresented" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="(in)" x-translit="b" xml:lang="hbo">בְּ</char><char style="w