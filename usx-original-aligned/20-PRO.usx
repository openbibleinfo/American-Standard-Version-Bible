	<para style="p"><verse number="25" style="v" x-ref="PRO.15.25" sid="PRO 15:25" /><char style="w" x-id="WLC.PRO.15.25.001" x-align="PRO.15.25.a003" x-target-ids="t005 t006" x-target="the house" x-target-head="t006" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="[the].house" x-translit="bēyṯ" xml:lang="hbo">בֵּ֣ית</char> <char style="w" x-id="WLC.PRO.15.25.002" x-align="PRO.15.25.a004" x-target-ids="t007 t008 t009" x-target="of the proud" x-target-head="t009" x-head="true" lemma="גֵּאֶה" strong="H1343" x-morph="Aampa" x-gloss="of.proud.[people]" x-translit="gēʾîm" xml:lang="hbo">גֵּ֭אִים</char> <char style="w" x-id="WLC.PRO.15.25.003" x-align="PRO.15.25.a002" x-target-ids="t002 t003 t004" x-target="will root up" x-target-head="t003" x-head="true" lemma="נָסַח" strong="H5255" x-morph="Vqi3ms" x-gloss="he.tears.down" x-translit="yissaḥ" xml:lang="hbo">יִסַּ֥ח</char>׀<char style="w" x-id="WLC.PRO.15.25.004" x-align="PRO.15.25.a001" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.15.25.005" x-align="PRO.15.25.a005" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.15.25.006" x-align="PRO.15.25.a006" x-target-ids="t011 t012 t013" x-target="he will establish" x-target-head="t013" x-head="true" lemma="נָצַב" strong="H5324" x-morph="Vhi3ms" x-gloss="he.will.establish" x-translit="yaṣṣēḇ" xml:lang="hbo">יַצֵּ֗ב</char> <char style="w" x-id="WLC.PRO.15.25.007" x-align="PRO.15.25.a007" x-target-ids="t014 t015" x-target="the border" x-target-head="t015" x-head="true" lemma="גְּבוּל" strong="H1366" x-morph="Ncmsc" x-gloss="[the].territory" x-translit="gəḇûl" xml:lang="hbo">גְּב֣וּל</char> <char style="w" x-id="WLC.PRO.15.25.008" x-align="PRO.15.25.a008" x-t