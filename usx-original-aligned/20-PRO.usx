	<para style="p"><verse number="3" style="v" x-ref="PRO.23.3" sid="PRO 23:3" /><char style="w" x-id="WLC.PRO.23.3.001" x-align="PRO.23.3.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.23.3.002" x-align="PRO.23.3.a002" x-target-ids="t001 t003" x-target="Be desirous" x-target-head="t003" x-head="true" lemma="אָוָה" strong="H183" x-morph="Vtj2ms" x-gloss="crave" x-translit="tiṯʾāw" xml:lang="hbo">תִּ֭תְאָו</char><char style="w" x-id="WLC.PRO.23.3.003" x-align="PRO.23.3.a003" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.23.3.004" x-align="PRO.23.3.a004" x-target-ids="t006" x-target="dainties" x-target-head="t006" x-head="true" lemma="מַטְעַמִּים" strong="H4303" x-morph="Ncmpc" x-gloss="his.delicious" x-translit="maṭʿammôṯāy" xml:lang="hbo">מַטְעַמּוֹתָ֑י</char><char style="w" x-id="WLC.PRO.23.3.005" x-align="PRO.23.3.a005" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="food(s)" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.23.3.006" x-align="PRO.23.3.a006" x-target-ids="t007" x-target="Seeing" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.23.3.007" x-align="PRO.23.3.a007" x-target-ids="t008" x-target="they" x-target-head="t008" x-head="true" lemma="הוּא" strong="H1931" x-morph="Pp3ms" x-gloss="it" x-translit="hûʾ" xml:lang="hbo">ה֗וּא</char> <char style="w" x-id="WLC.PRO.23.3.008" x-align="PRO.23.3.a008" x-target-ids="t009 t011" x-target="are food" x-target-head="t011" x-head="true" lemma="לֶחֶם" strong="H3899" x-morph="Ncbsc" x-gloss="[is].food" x-translit="le