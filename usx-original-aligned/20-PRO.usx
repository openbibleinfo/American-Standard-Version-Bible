	<para style="p"><verse number="18" style="v" x-ref="PRO.19.18" sid="PRO 19:18" /><char style="w" x-id="WLC.PRO.19.18.001" x-align="PRO.19.18.a001" x-target-ids="t001" x-target="Chasten" x-target-head="t001" x-head="true" lemma="יָסַר" strong="H3256" x-morph="Vpv2ms" x-gloss="discipline" x-translit="yassēr" xml:lang="hbo">יַסֵּ֣ר</char> <char style="w" x-id="WLC.PRO.19.18.002" x-align="PRO.19.18.a002" x-target-ids="t003" x-target="son" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="son" x-translit="bin" xml:lang="hbo">בִּ֭נְ</char><char style="w" x-id="WLC.PRO.19.18.003" x-align="PRO.19.18.a003" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.19.18.004" x-align="PRO.19.18.a004" x-target-ids="t004" x-target="seeing" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.19.18.005" x-align="PRO.19.18.a005" x-target-ids="t005 t006" x-target="there is" x-target-head="t006" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.19.18.006" x-align="PRO.19.18.a006" x-target-ids="t007" x-target="hope" x-target-head="t007" x-head="true" lemma="תִּקְוָה" strong="H8615" x-morph="Ncfsa" x-gloss="hope" x-translit="tiqwāh" xml:lang="hbo">תִּקְוָ֑ה</char> <char style="w" x-id="WLC.PRO.19.18.007" x-align="PRO.19.18.a007" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.19.18.008" x-align="PRO.19.18.a012" x-target-ids="t013" x-target="on" x-target-head="t013" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang