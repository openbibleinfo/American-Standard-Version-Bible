	<para style="p"><verse number="2" style="v" x-ref="PRO.28.2" x-added-alignments="PRO.28.2.a011 PRO.28.2.a014" x-added-target-ids="t017 t021" x-added-target="and | thereof" sid="PRO 28:2" /><char style="w" x-id="WLC.PRO.28.2.001" x-align="PRO.28.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.28.2.002" x-align="PRO.28.2.a002" x-target-ids="t002 t003" x-target="the transgression" x-target-head="t003" x-head="true" lemma="פֶּשַׁע" strong="H6588" x-morph="Ncmsc" x-gloss="transgression" x-translit="p̄ešaʿ" xml:lang="hbo">פֶ֣שַֽׁע</char> <char style="w" x-id="WLC.PRO.28.2.003" x-align="PRO.28.2.a003" x-target-ids="t004 t005 t006" x-target="of a land" x-target-head="t006" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.a.land" x-translit="ʾereṣ" xml:lang="hbo">אֶ֭רֶץ</char> <char style="w" x-id="WLC.PRO.28.2.004" x-align="PRO.28.2.a004" x-target-ids="t007 t008" x-target="many are" x-target-head="t007" x-head="true" lemma="רַב" strong="H7227" x-morph="Aampa" x-gloss="[are].many" x-translit="rabbiym" xml:lang="hbo">רַבִּ֣ים</char> <char style="w" x-id="WLC.PRO.28.2.005" x-align="PRO.28.2.a005" x-target-ids="t009 t010" x-target="the princes" x-target-head="t010" x-head="true" lemma="שַׂר" strong="H8269" x-morph="Ncmpc" x-gloss="princes" x-translit="śārey" xml:lang="hbo">שָׂרֶ֑י</char><char style="w" x-id="WLC.PRO.28.2.006" x-align="PRO.28.2.a006" x-target-ids="t011" x-target="thereof" x-target-head="t011" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.28.2.007" x-align="PRO.28.2.a007" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.28.2.008" x-align="PRO.28.2.a