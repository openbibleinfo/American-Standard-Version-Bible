	<para style="p"><verse number="14" style="v" x-ref="PRO.6.14" x-added-alignments="PRO.6.14.a008" x-added-target-ids="t010" x-added-target="Who" sid="PRO 6:14" /><char style="w" x-id="WLC.PRO.6.14.001" x-align="PRO.6.14.a001" x-target-ids="t005" x-target="perverseness" x-target-head="t005" x-head="true" lemma="תַּהְפֻּכֹות" strong="H8419" x-morph="Ncfpa" x-gloss="perverse.things" x-translit="tahəpuḵôṯ" xml:lang="hbo">תַּֽהְפֻּכ֨וֹת</char>׀<char style="w" x-id="WLC.PRO.6.14.002" x-align="PRO.6.14.a002" x-target-ids="t001 t004" x-target="In is" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[are].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.6.14.003" x-align="PRO.6.14.a003" x-target-ids="t003" x-target="heart" x-target-head="t003" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבּ֗</char><char style="w" x-id="WLC.PRO.6.14.004" x-align="PRO.6.14.a004" x-target-ids="t002" x-target="whose" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.6.14.005" x-align="PRO.6.14.a005" x-target-ids="t006 t007" x-target="Who deviseth" x-target-head="t007" x-head="true" lemma="חָרַשׁ" strong="H2790" x-morph="Vqrmsa" x-gloss="[he.is].devising" x-translit="ḥōrēš" xml:lang="hbo">חֹרֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.6.14.006" x-align="PRO.6.14.a006" x-target-ids="t008" x-target="evil" x-target-head="t008" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="evil" x-translit="rāʿ" xml:lang="hbo">רָ֣ע</char> <char style="w" x-id="WLC.PRO.6.14.007" x-align="PRO.6.14.a007" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="at" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.6.14.008" x-align="PRO.6.14.a007" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="every" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char sty