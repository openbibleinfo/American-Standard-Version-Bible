	<para style="p"><verse number="12" style="v" x-ref="PRO.11.12" sid="PRO 11:12" /><char style="w" x-id="WLC.PRO.11.12.001" x-align="PRO.11.12.a001" x-target-ids="t001 t002 t003" x-target="He that despiseth" x-target-head="t003" x-head="true" lemma="בּוּז" strong="H936" x-morph="Vqrmsa" x-gloss="[one.who].despises" x-translit="bāz-" xml:lang="hbo">בָּז</char>־<char style="w" x-id="WLC.PRO.11.12.002" x-align="PRO.11.12.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.11.12.003" x-align="PRO.11.12.a003" x-target-ids="t005" x-target="neighbor" x-target-head="t005" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="neighbor" x-translit="rēʿ" xml:lang="hbo">רֵעֵ֥</char><char style="w" x-id="WLC.PRO.11.12.004" x-align="PRO.11.12.a004" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.11.12.005" x-align="PRO.11.12.a005" x-target-ids="t006 t007" x-target="is void" x-target-head="t007" x-head="true" lemma="חָסֵר" strong="H2638" x-morph="Aamsc" x-gloss="[is].lacking" x-translit="ḥăsar-" xml:lang="hbo">חֲסַר</char>־<char style="w" x-id="WLC.PRO.11.12.006" x-align="PRO.11.12.a006" x-target-ids="t008 t009" x-target="of wisdom" x-target-head="t009" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="of.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.11.12.007" x-align="PRO.11.12.a007" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.12.008" x-align="PRO.11.12.a008" x-target-ids="t011 t012" x-target="a man" x-target-head="t012" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-tra