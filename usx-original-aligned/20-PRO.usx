	<para style="p"><verse number="3" style="v" x-ref="PRO.18.3" sid="PRO 18:3" /><char style="w" x-id="WLC.PRO.18.3.001" x-align="PRO.18.3.a001" x-target-ids="t001" x-target="When" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּֽ</char><char style="w" x-id="WLC.PRO.18.3.002" x-align="PRO.18.3.a002" x-target-ids="t004" x-target="cometh" x-target-head="t004" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqc" x-gloss="comes" x-translit="ḇôʾ-" xml:lang="hbo">בוֹא</char>־<char style="w" x-id="WLC.PRO.18.3.003" x-align="PRO.18.3.a003" x-target-ids="t002 t003" x-target="the wicked" x-target-head="t003" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָ֭שָׁע</char> <char style="w" x-id="WLC.PRO.18.3.004" x-align="PRO.18.3.a004" x-target-ids="t005 t006 t012" x-target="there cometh cometh" x-target-italic-ids="t012" x-target-head="t006" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqp3ms" x-gloss="it.comes" x-translit="bāʾ" xml:lang="hbo">בָּ֣א</char> <char style="w" x-id="WLC.PRO.18.3.005" x-align="PRO.18.3.a005" x-target-ids="t007" x-target="also" x-target-head="t007" x-head="true" lemma="גַּם" strong="H1571" x-morph="D" x-gloss="also" x-translit="ḡam-" xml:lang="hbo">גַם</char>־<char style="w" x-id="WLC.PRO.18.3.006" x-align="PRO.18.3.a006" x-target-ids="t008" x-target="contempt" x-target-head="t008" x-head="true" lemma="בּוּז" strong="H937" x-morph="Ncmsa" x-gloss="contempt" x-translit="bûz" xml:lang="hbo">בּ֑וּז</char> <char style="w" x-id="WLC.PRO.18.3.007" x-align="PRO.18.3.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְֽ</char><char style="w" x-id="WLC.PRO.18.3.008" x-align="PRO.18.3.a008" x-target-ids="t010" x-target="with" x-target-head="t010" x-head="true" lemma="עִם" strong="H5973" x-morph="R" x