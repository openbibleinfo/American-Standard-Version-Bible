	<para style="p"><verse number="20" style="v" x-ref="PRO.2.20" sid="PRO 2:20" /><char style="w" x-id="WLC.PRO.2.20.001" x-align="PRO.2.20.a001" x-target-ids="t001" x-target="That" x-target-head="t001" x-head="true" lemma="לְמַעַן" strong="H4616" x-morph="R" x-gloss="so.that" x-translit="ləmaʿan" xml:lang="hbo">לְמַ֗עַן</char> <char style="w" x-id="WLC.PRO.2.20.002" x-align="PRO.2.20.a002" x-target-ids="t002 t003 t004" x-target="thou mayest walk" x-target-head="t004" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi2ms" x-gloss="you.may.walk" x-translit="tēlēḵ" xml:lang="hbo">תֵּ֭לֵךְ</char> <char style="w" x-id="WLC.PRO.2.20.003" x-align="PRO.2.20.a003" x-target-ids="t005" x-target="in" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.2.20.004" x-align="PRO.2.20.a004" x-target-ids="t006 t007" x-target="the way" x-target-head="t007" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="ḏereḵ" xml:lang="hbo">דֶ֣רֶךְ</char> <char style="w" x-id="WLC.PRO.2.20.005" x-align="PRO.2.20.a005" x-target-ids="t008 t009 t010" x-target="of good men" x-target-head="t009" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aampa" x-gloss="of.good.[people]" x-translit="ṭôḇiym" xml:lang="hbo">טוֹבִ֑ים</char> <char style="w" x-id="WLC.PRO.2.20.006" x-align="PRO.2.20.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.2.20.007" x-align="PRO.2.20.a008" x-target-ids="t013 t014" x-target="the paths" x-target-head="t014" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbpc" x-gloss="paths" x-translit="ʾārḥôṯ" xml:lang="hbo">אָרְח֖וֹת</char> <char style="w" x-id="WLC.PRO.2.20.008" x-align="PRO.2.20.a009" x-target-ids="t015 t016 t017" x-target="of the righteous" x-target-head="t017" x-head