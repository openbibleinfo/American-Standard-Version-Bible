	<para style="p"><verse number="11" style="v" x-ref="PRO.8.11" sid="PRO 8:11" /><char style="w" x-id="WLC.PRO.8.11.001" x-align="PRO.8.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.8.11.002" x-align="PRO.8.11.a002" x-target-ids="t003 t004" x-target="is better" x-target-head="t004" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aafsa" x-gloss="[is].good" x-translit="ṭôḇāh" xml:lang="hbo">טוֹבָ֣ה</char> <char style="w" x-id="WLC.PRO.8.11.003" x-align="PRO.8.11.a003" x-target-ids="t002" x-target="wisdom" x-target-head="t002" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmâ" xml:lang="hbo">חָ֭כְמָה</char> <char style="w" x-id="WLC.PRO.8.11.004" x-align="PRO.8.11.a004" x-target-ids="t005" x-target="than" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.8.11.005" x-align="PRO.8.11.a005" x-target-ids="t006" x-target="rubies" x-target-head="t006" x-head="true" lemma="פְּנִינִים" strong="H6443" x-morph="Ncbpa" x-gloss="than.corals" x-translit="pənîniym" xml:lang="hbo">פְּנִינִ֑ים</char> <char style="w" x-id="WLC.PRO.8.11.006" x-align="PRO.8.11.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.8.11.007" x-align="PRO.8.11.a007" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.8.11.008" x-align="PRO.8.11.a008" x-target-ids="t009 t010 t011 t012 t013 t014" x-target="the things that may be desired" x-target-head="t014" x-head="true" lemma="חֵפֶץ" strong="H2656" x-mo