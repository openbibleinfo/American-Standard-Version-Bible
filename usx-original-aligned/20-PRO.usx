	<para style="p"><verse number="24" style="v" x-ref="PRO.11.24" x-added-alignments="PRO.11.24.a010 PRO.11.24.a011" x-added-target-ids="t018 t019 t020" x-added-target="but | it tendeth" sid="PRO 11:24" /><char style="w" x-id="WLC.PRO.11.24.001" x-align="PRO.11.24.a001" x-target-ids="t001 t002 t010 t011" x-target="There is there is" x-target-head="t002" x-head="true" lemma="יֵשׁ" strong="H3426" x-morph="Tm" x-gloss="there.[is]" x-translit="yēš" xml:lang="hbo">יֵ֣שׁ</char> <char style="w" x-id="WLC.PRO.11.24.002" x-align="PRO.11.24.a002" x-target-ids="t003 t004" x-target="that scattereth" x-target-head="t004" x-head="true" lemma="פָּזַר" strong="H6340" x-morph="Vprmsa" x-gloss="[one.who].scatters" x-translit="məp̄azzēr" xml:lang="hbo">מְ֭פַזֵּר</char> <char style="w" x-id="WLC.PRO.11.24.003" x-align="PRO.11.24.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.24.004" x-align="PRO.11.24.a004" x-target-ids="t006" x-target="increaseth" x-target-head="t006" x-head="true" lemma="יָסַף" strong="H3254" x-morph="VNrmsa" x-gloss="[he.is].increased" x-translit="nôsāp̄" xml:lang="hbo">נוֹסָ֥ף</char> <char style="w" x-id="WLC.PRO.11.24.005" x-align="PRO.11.24.a005" x-target-ids="t007 t008" x-target="yet more" x-target-head="t008" x-head="true" lemma="עוֹד" strong="H5750" x-morph="D" x-gloss="still" x-translit="ʿôḏ" xml:lang="hbo">ע֑וֹד</char> <char style="w" x-id="WLC.PRO.11.24.006" x-align="PRO.11.24.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.24.007" x-align="PRO.11.24.a007" x-target-ids="t012 t013" x-target="that withholdeth" x-target-head="t013" x-head="true" lemma="חָשַׂךְ" strong="H2820" x-morph="Vqrmsa" x-gloss="[one.who].withholds" x-translit="ḥôśēḵ" xml:lang="hbo">חוֹ