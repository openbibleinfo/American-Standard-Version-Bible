	<para style="p"><verse number="13" style="v" x-ref="PRO.3.13" x-added-alignments="PRO.3.13.a004 PRO.3.13.a008" x-added-target-ids="t005 t011" x-added-target="that | that" sid="PRO 3:13" /><char style="w" x-id="WLC.PRO.3.13.001" x-align="PRO.3.13.a001" x-target-ids="t001 t002" x-target="Happy is" x-target-head="t001" x-head="true" lemma="אֶשֶׁר" strong="H835a" x-morph="Ncmpa" x-gloss="how.blessed!" x-translit="ʾašrēy" xml:lang="hbo">אַשְׁרֵ֣י</char> <char style="w" x-id="WLC.PRO.3.13.002" x-align="PRO.3.13.a002" x-target-ids="t003 t004" x-target="the man" x-target-head="t004" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="[is].a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.PRO.3.13.003" x-align="PRO.3.13.a003" x-target-ids="t006" x-target="findeth" x-target-head="t006" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqp3ms" x-gloss="[who].he.finds" x-translit="māṣāʾ" xml:lang="hbo">מָצָ֣א</char> <char style="w" x-id="WLC.PRO.3.13.004" x-align="PRO.3.13.a005" x-target-ids="t007" x-target="wisdom" x-target-head="t007" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.3.13.005" x-align="PRO.3.13.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.3.13.006" x-align="PRO.3.13.a007" x-target-ids="t009 t010" x-target="the man" x-target-head="t010" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֗ם</char> <char style="w" x-id="WLC.PRO.3.13.007" x-align="PRO.3.13.a009" x-target-ids="t012" x-target="getteth" x-target-head="t012" x-head="true" lemma="פּוּק" strong="H6329" x-morph="Ncfsa" x-gloss="[who].he.obtains" x-translit="yāp̄iyq" xml:lang="hbo">יָפִ֥יק</char> <char style="w" x-id="WLC.PRO.3.13.