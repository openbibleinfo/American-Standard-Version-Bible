	<para style="p"><verse number="18" style="v" x-ref="PRO.1.18" sid="PRO 1:18" /><char style="w" x-id="WLC.PRO.1.18.001" x-align="PRO.1.18.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.PRO.1.18.002" x-align="PRO.1.18.a002" x-target-ids="t002" x-target="these" x-target-head="t002" x-head="true" lemma="הֵם" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēm" xml:lang="hbo">הֵם</char> <char style="w" x-id="WLC.PRO.1.18.003" x-align="PRO.1.18.a004" x-target-ids="t005" x-target="for" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.1.18.004" x-align="PRO.1.18.a006" x-target-ids="t008" x-target="blood" x-target-head="t008" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmsc" x-gloss="their.own" x-translit="ḏām" xml:lang="hbo">דָמָ֣</char><char style="w" x-id="WLC.PRO.1.18.005" x-align="PRO.1.18.a005" x-target-ids="t006 t007" x-target="their own" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="blood" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PRO.1.18.006" x-align="PRO.1.18.a003" x-target-ids="t003 t004" x-target="lay wait" x-target-head="t004" x-head="true" lemma="אָרַב" strong="H693" x-morph="Vqi3mp" x-gloss="they.lie.in.wait" x-translit="yeʾĕrōḇû" xml:lang="hbo">יֶאֱרֹ֑בוּ</char> <char style="w" x-id="WLC.PRO.1.18.007" x-align="PRO.1.18.a007" x-target-ids="t009 t010 t011" x-target="They lurk privily" x-target-head="t010" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqi3mp" x-gloss="they.lie.hidden" x-translit="yiṣpənû" xml:lang="hbo">יִ֝צְפְּנ֗וּ</char> <char style="w" x-id="WLC.PRO.1.18.008" x-align="PRO.1.18.a008" x-target-ids="t012" x-target="for" x-target-head="t012" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss=