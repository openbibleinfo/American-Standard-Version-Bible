	<para style="p"><verse number="6" style="v" x-ref="PRO.1.6" sid="PRO 1:6" /><char style="w" x-id="WLC.PRO.1.6.001" x-align="PRO.1.6.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.1.6.002" x-align="PRO.1.6.a002" x-target-ids="t002" x-target="understand" x-target-head="t002" x-head="true" lemma="בִּין" strong="H995" x-morph="Vhc" x-gloss="understand" x-translit="hāḇiyn" xml:lang="hbo">הָבִ֣ין</char> <char style="w" x-id="WLC.PRO.1.6.003" x-align="PRO.1.6.a003" x-target-ids="t003 t004" x-target="a proverb" x-target-head="t004" x-head="true" lemma="מָשָׁל" strong="H4912" x-morph="Ncmsa" x-gloss="a.proverb" x-translit="māšāl" xml:lang="hbo">מָ֭שָׁל</char> <char style="w" x-id="WLC.PRO.1.6.004" x-align="PRO.1.6.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.1.6.005" x-align="PRO.1.6.a005" x-target-ids="t006 t007" x-target="a figure" x-target-head="t007" x-head="true" lemma="מְלִיצָה" strong="H4426" x-morph="Ncfsa" x-gloss="a.parable" x-translit="məlîṣāh" xml:lang="hbo">מְלִיצָ֑ה</char> <char style="w" x-id="WLC.PRO.1.6.006" x-align="PRO.1.6.a006" x-target-ids="t008 t009" x-target="The words" x-target-head="t009" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmpc" x-gloss="[the].words" x-translit="diḇrēy" xml:lang="hbo">דִּבְרֵ֥י</char> <char style="w" x-id="WLC.PRO.1.6.007" x-align="PRO.1.6.a007" x-target-ids="t010 t011 t012" x-target="of the wise" x-target-head="t012" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="of.learned.ones" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲ֝כָמִ֗ים</char> <char style="w" x-id="WLC.PRO.1.6.008" x-align="PRO.1.6.a008" x-target-ids="t013" x-target="and" x-target-head="t013" x-head="true" lemma="וְ" strong="H2050b" x-mor