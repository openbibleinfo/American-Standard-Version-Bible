	<para style="p"><verse number="14" style="v" x-ref="PRO.19.14" sid="PRO 19:14" /><char style="w" x-id="WLC.PRO.19.14.001" x-align="PRO.19.14.a001" x-target-ids="t001" x-target="House" x-target-head="t001" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsa" x-gloss="house" x-translit="bayiṯ" xml:lang="hbo">בַּ֣יִת</char> <char style="w" x-id="WLC.PRO.19.14.002" x-align="PRO.19.14.a002" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ֭</char><char style="w" x-id="WLC.PRO.19.14.003" x-align="PRO.19.14.a003" x-target-ids="t003" x-target="riches" x-target-head="t003" x-head="true" lemma="הוֹן" strong="H1952" x-morph="Ncmsa" x-gloss="wealth" x-translit="hôn" xml:lang="hbo">הוֹן</char> <char style="w" x-id="WLC.PRO.19.14.004" x-align="PRO.19.14.a004" x-target-ids="t004 t005 t006" x-target="are an inheritance" x-target-head="t006" x-head="true" lemma="נַחֲלָה" strong="H5159" x-morph="Ncfsc" x-gloss="[are].an.inheritance" x-translit="naḥălaṯ" xml:lang="hbo">נַחֲלַ֣ת</char> <char style="w" x-id="WLC.PRO.19.14.005" x-align="PRO.19.14.a005" x-target-ids="t007 t008" x-target="from fathers" x-target-head="t008" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmpa" x-gloss="of.fathers" x-translit="ʾāḇôṯ" xml:lang="hbo">אָב֑וֹת</char> <char style="w" x-id="WLC.PRO.19.14.006" x-align="PRO.19.14.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.19.14.007" x-align="PRO.19.14.a009" x-target-ids="t013 t014" x-target="is from" x-target-head="t014" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.19.14.008" x-align="PRO.19.14.a010" x-target-ids="t015" x-target="Jehovah" x-target-head="t015" x-head="true" lemma="יהוה" strong="H3068" x-m