	<para style="p"><verse number="28" style="v" x-ref="PRO.26.28" sid="PRO 26:28" /><char style="w" x-id="WLC.PRO.26.28.001" x-align="PRO.26.28.a001" x-target-ids="t001 t003" x-target="A tongue" x-target-head="t003" x-head="true" lemma="לָשׁוֹן" strong="H3956" x-morph="Ncbsc" x-gloss="a.tongue" x-translit="ləšôn-" xml:lang="hbo">לְֽשׁוֹן</char>־<char style="w" x-id="WLC.PRO.26.28.002" x-align="PRO.26.28.a002" x-target-ids="t002" x-target="lying" x-target-head="t002" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šeqer" xml:lang="hbo">שֶׁ֭קֶר</char> <char style="w" x-id="WLC.PRO.26.28.003" x-align="PRO.26.28.a003" x-target-ids="t004" x-target="hateth" x-target-head="t004" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqi3ms" x-gloss="it.hates" x-translit="yiśnāʾ" xml:lang="hbo">יִשְׂנָ֣א</char> <char style="w" x-id="WLC.PRO.26.28.004" x-align="PRO.26.28.a004" x-target-ids="t005 t006 t008 t009" x-target="those whom hath wounded" x-target-head="t009" x-head="true" lemma="דַּךְ" strong="H1790" x-morph="Aampc" x-gloss="its.crushed" x-translit="ḏakkāy" xml:lang="hbo">דַכָּ֑י</char><char style="w" x-id="WLC.PRO.26.28.005" x-align="PRO.26.28.a005" x-target-ids="t007" x-target="it" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="[people]" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.26.28.006" x-align="PRO.26.28.a006" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.26.28.007" x-align="PRO.26.28.a007" x-target-ids="t011 t013" x-target="a mouth" x-target-head="t013" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsa" x-gloss="a.mouth" x-translit="p̄eh" xml:lang="hbo">פֶ֥ה</char> <char style="w" x-id="WLC.PRO.26.28.008" x-align="PRO.26.28.a008" x-target-ids="t012" x-target="flattering" x-target-head="t012" x-head="