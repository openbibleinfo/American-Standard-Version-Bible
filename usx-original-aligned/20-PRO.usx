	<para style="p"><verse number="7" style="v" x-ref="PRO.1.7" x-added-alignments="PRO.1.7.a005" x-added-target-ids="t010" x-added-target="But" sid="PRO 1:7" /><char style="w" x-id="WLC.PRO.1.7.001" x-align="PRO.1.7.a001" x-target-ids="t001 t002" x-target="The fear" x-target-head="t002" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="the.fear" x-translit="yirʾaṯ" xml:lang="hbo">יִרְאַ֣ת</char> <char style="w" x-id="WLC.PRO.1.7.002" x-align="PRO.1.7.a002" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.1.7.003" x-align="PRO.1.7.a003" x-target-ids="t005 t006 t007" x-target="is the beginning" x-target-head="t007" x-head="true" lemma="רֵאשִׁית" strong="H7225" x-morph="Ncfsc" x-gloss="[is.the].beginning" x-translit="rēʾšiyṯ" xml:lang="hbo">רֵאשִׁ֣ית</char> <char style="w" x-id="WLC.PRO.1.7.004" x-align="PRO.1.7.a004" x-target-ids="t008 t009" x-target="of knowledge" x-target-head="t009" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="of.knowledge" x-translit="dāʿaṯ" xml:lang="hbo">דָּ֑עַת</char> <char style="w" x-id="WLC.PRO.1.7.005" x-align="PRO.1.7.a008" x-target-ids="t014" x-target="wisdom" x-target-head="t014" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֥ה</char> <char style="w" x-id="WLC.PRO.1.7.006" x-align="PRO.1.7.a009" x-target-ids="t015" x-target="and" x-target-head="t015" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.1.7.007" x-align="PRO.1.7.a010" x-target-ids="t016" x-target="instruction" x-target-head="t016" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsa" x-gloss="discipline" x-translit="mûsār" xml:lang="hbo">מוּסָ֗ר</char> <char style="w" x-id="WLC.PRO.1.7.008" x-align="PR