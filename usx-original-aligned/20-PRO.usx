	<para style="p"><verse number="2" style="v" x-ref="PRO.14.2" sid="PRO 14:2" /><char style="w" x-id="WLC.PRO.14.2.001" x-align="PRO.14.2.a001" x-target-ids="t001 t002 t003" x-target="He that walketh" x-target-head="t003" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqrmsa" x-gloss="[one.who].walks" x-translit="hôlēḵ" xml:lang="hbo">הוֹלֵ֣ךְ</char> <char style="w" x-id="WLC.PRO.14.2.002" x-align="PRO.14.2.a002" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ֭</char><char style="w" x-id="WLC.PRO.14.2.003" x-align="PRO.14.2.a003" x-target-ids="t006" x-target="uprightness" x-target-head="t006" x-head="true" lemma="יֹשֶׁר" strong="H3476" x-morph="Ncmsc" x-gloss="uprightness" x-translit="yāšər" xml:lang="hbo">יָשְׁר</char><char style="w" x-id="WLC.PRO.14.2.004" x-align="PRO.14.2.a004" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.14.2.005" x-align="PRO.14.2.a005" x-target-ids="t007" x-target="feareth" x-target-head="t007" x-head="true" lemma="יָרֵא" strong="H3373" x-morph="Aamsc" x-gloss="[is].fearing" x-translit="yərēʾ" xml:lang="hbo">יְרֵ֣א</char> <char style="w" x-id="WLC.PRO.14.2.006" x-align="PRO.14.2.a006" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="(of).Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.14.2.007" x-align="PRO.14.2.a007" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.14.2.008" x-align="PRO.14.2.a008" x-target-ids="t010 t011 t012 t013" x-target="he that is perverse" x-target-head="t013" x-head="true" lemma="לוּז" strong="H3868" x