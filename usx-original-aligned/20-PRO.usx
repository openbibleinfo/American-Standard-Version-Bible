	<para style="p"><verse number="2" style="v" x-ref="PRO.12.2" sid="PRO 12:2" /><char style="w" x-id="WLC.PRO.12.2.001" x-align="PRO.12.2.a001" x-target-ids="t001 t002 t003" x-target="A good man" x-target-head="t002" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="a.good.[person]" x-translit="ṭôḇ" xml:lang="hbo">ט֗וֹב</char> <char style="w" x-id="WLC.PRO.12.2.002" x-align="PRO.12.2.a002" x-target-ids="t004 t005" x-target="shall obtain" x-target-head="t005" x-head="true" lemma="פּוּק" strong="H6329" x-morph="Vhi3ms" x-gloss="he.obtains" x-translit="yāp̄iyq" xml:lang="hbo">יָפִ֣יק</char> <char style="w" x-id="WLC.PRO.12.2.003" x-align="PRO.12.2.a003" x-target-ids="t006" x-target="favor" x-target-head="t006" x-head="true" lemma="רָצוֹן" strong="H7522" x-morph="Ncmsa" x-gloss="favor" x-translit="rāṣôn" xml:lang="hbo">רָ֭צוֹן</char> <char style="w" x-id="WLC.PRO.12.2.004" x-align="PRO.12.2.a004" x-target-ids="t007" x-target="of" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.12.2.005" x-align="PRO.12.2.a005" x-target-ids="t008" x-target="Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.12.2.006" x-align="PRO.12.2.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.2.007" x-align="PRO.12.2.a007" x-target-ids="t010 t011" x-target="a man" x-target-head="t011" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmsc" x-gloss="a.person" x-translit="ʾiyš" xml:lang="hbo">אִ֖ישׁ</char> <char style="w" x-id="WLC.PRO.12.2.008" x-align="PRO.12.2.a008" x-target-ids="t012 t013 t014" x-target="of wicked devices" x-target-head="t014" x-head="true" lemma="מְזִמָּה" strong="H4209" x