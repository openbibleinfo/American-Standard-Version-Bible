	<para style="p"><verse number="2" style="v" x-ref="PRO.24.2" sid="PRO 24:2" /><char style="w" x-id="WLC.PRO.24.2.001" x-align="PRO.24.2.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.24.2.002" x-align="PRO.24.2.a002" x-target-ids="t005" x-target="oppression" x-target-head="t005" x-head="true" lemma="שֹׁד" strong="H7701" x-morph="Ncmsa" x-gloss="violence" x-translit="šōḏ" xml:lang="hbo">שֹׁ֭ד</char><char style="w" x-id="WLC.PRO.24.2.003" x-align="PRO.24.2.a003" x-target-ids="t004" x-target="studieth" x-target-head="t004" x-head="true" lemma="הָגָה" strong="H1897" x-morph="Vqi3ms" x-gloss="it.plots" x-translit="yehgeh" xml:lang="hbo">יֶהְגֶּ֣ה</char> <char style="w" x-id="WLC.PRO.24.2.004" x-align="PRO.24.2.a004" x-target-ids="t003" x-target="heart" x-target-head="t003" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsc" x-gloss="heart" x-translit="libb" xml:lang="hbo">לִבָּ֑</char><char style="w" x-id="WLC.PRO.24.2.005" x-align="PRO.24.2.a005" x-target-ids="t002" x-target="their" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PRO.24.2.006" x-align="PRO.24.2.a006" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.24.2.007" x-align="PRO.24.2.a007" x-target-ids="t011" x-target="mischief" x-target-head="t011" x-head="true" lemma="עָמָל" strong="H5999" x-morph="Ncbsa" x-gloss="trouble" x-translit="ʿāmāl" xml:lang="hbo">עָמָ֗ל</char> <char style="w" x-id="WLC.PRO.24.2.008" x-align="PRO.24.2.a008" x-target-ids="t008" x-target="lips" x-target-head="t008" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śip̄ṯēy" xml:lang="h