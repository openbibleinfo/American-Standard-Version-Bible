	<para style="p"><verse number="23" style="v" x-ref="PRO.3.23" sid="PRO 3:23" /><char style="w" x-id="WLC.PRO.3.23.001" x-align="PRO.3.23.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֤ז</char> <char style="w" x-id="WLC.PRO.3.23.002" x-align="PRO.3.23.a002" x-target-ids="t002 t003 t004" x-target="shalt thou walk" x-target-head="t004" x-head="true" lemma="הלך" strong="H1980" x-morph="Vqi2ms" x-gloss="you.will.walk" x-translit="tēlēḵ" xml:lang="hbo">תֵּלֵ֣ךְ</char> <char style="w" x-id="WLC.PRO.3.23.003" x-align="PRO.3.23.a003" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo">לָ</char><char style="w" x-id="WLC.PRO.3.23.004" x-align="PRO.3.23.a003" x-target-ids="t008" x-target="securely" x-target-head="t008" x-head="true" lemma="בֶּטַח" strong="H983" x-morph="Ncmsa" x-gloss="security" x-translit="ḇeṭaḥ" xml:lang="hbo">בֶ֣טַח</char> <char style="w" x-id="WLC.PRO.3.23.005" x-align="PRO.3.23.a004" x-target-ids="t005 t007" x-target="in way" x-target-head="t007" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="dark" xml:lang="hbo">דַּרְכֶּ֑</char><char style="w" x-id="WLC.PRO.3.23.006" x-align="PRO.3.23.a005" x-target-ids="t006" x-target="thy" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.3.23.007" x-align="PRO.3.23.a006" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.3.23.008" x-align="PRO.3.23.a007" x-target-ids="t011" x-target="foot" x-target-head="t011" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfsc" x-gloss="foot" x-translit="raḡl" xml:lang="hbo">רַגְלְ</char><char style="w" x-id="WLC.PRO.3.23.009" x-align="P