	<para style="p"><verse number="11" style="v" x-ref="PRO.9.11" sid="PRO 9:11" /><char style="w" x-id="WLC.PRO.9.11.001" x-align="PRO.9.11.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.9.11.002" x-align="PRO.9.11.a002" x-target-ids="t002" x-target="by" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇi" xml:lang="hbo">בִ֭</char><char style="w" x-id="WLC.PRO.9.11.003" x-align="PRO.9.11.a003" x-target-ids="t003" x-target="me" x-target-head="t003" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="y" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.9.11.004" x-align="PRO.9.11.a004" x-target-ids="t006 t007 t008" x-target="shall be multiplied" x-target-head="t008" x-head="true" lemma="רָבָה" strong="H7235" x-morph="Vqi3mp" x-gloss="they.will.increase" x-translit="yirbû" xml:lang="hbo">יִרְבּ֣וּ</char> <char style="w" x-id="WLC.PRO.9.11.005" x-align="PRO.9.11.a005" x-target-ids="t005" x-target="days" x-target-head="t005" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmpc" x-gloss="days" x-translit="yāmey" xml:lang="hbo">יָמֶ֑י</char><char style="w" x-id="WLC.PRO.9.11.006" x-align="PRO.9.11.a006" x-target-ids="t004" x-target="thy" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.9.11.007" x-align="PRO.9.11.a007" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.9.11.008" x-align="PRO.9.11.a008" x-target-ids="t015 t016 t017" x-target="shall be increased" x-target-head="t017" x-head="true" lemma="יָסַף" strong="H3254" x-morph="Vhi3mp" x-gloss="they.will.add" x-translit="y