	<para style="p"><verse number="4" style="v" x-ref="PRO.14.4" sid="PRO 14:4" /><char style="w" x-id="WLC.PRO.14.4.001" x-align="PRO.14.4.a001" x-target-ids="t001" x-target="Where" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.14.4.002" x-align="PRO.14.4.a002" x-target-ids="t002 t004" x-target="no are" x-target-head="t002" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[are].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.PRO.14.4.003" x-align="PRO.14.4.a003" x-target-ids="t003" x-target="oxen" x-target-head="t003" x-head="true" lemma="אֶלֶף" strong="H504" x-morph="Acbpa" x-gloss="cattle(s)" x-translit="ʾălāp̄îm" xml:lang="hbo">אֲ֭לָפִים</char> <char style="w" x-id="WLC.PRO.14.4.004" x-align="PRO.14.4.a004" x-target-ids="t005 t006" x-target="the crib" x-target-head="t006" x-head="true" lemma="אֵבוּס" strong="H18" x-morph="Ncmsc" x-gloss="[the].feeding.trough" x-translit="ʾēḇûs" xml:lang="hbo">אֵב֣וּס</char> <char style="w" x-id="WLC.PRO.14.4.005" x-align="PRO.14.4.a005" x-target-ids="t007 t008" x-target="is clean" x-target-head="t008" x-head="true" lemma="בַּר" strong="H1249" x-morph="Ncmsa" x-gloss="[is].clean" x-translit="bār" xml:lang="hbo">בָּ֑ר</char> <char style="w" x-id="WLC.PRO.14.4.006" x-align="PRO.14.4.a006" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.4.007" x-align="PRO.14.4.a007" x-target-ids="t010" x-target="much" x-target-head="t010" x-head="true" lemma="רֹב" strong="H7230" x-morph="Ncbsc" x-gloss="abundance" x-translit="rāḇ-" xml:lang="hbo">רָב</char>־<char style="w" x-id="WLC.PRO.14.4.008" x-align="PRO.14.4.a008" x-target-ids="t011" x-target="increase" x-target-head="t011" x-head="true" lemma="תְּבוּאָה" strong="H8393" x-morph="Ncfpa" x-g