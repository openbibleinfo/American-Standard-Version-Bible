	<para style="p"><verse number="7" style="v" x-ref="PRO.8.7" sid="PRO 8:7" /><char style="w" x-id="WLC.PRO.8.7.001" x-align="PRO.8.7.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.8.7.002" x-align="PRO.8.7.a002" x-target-ids="t006" x-target="truth" x-target-head="t006" x-head="true" lemma="אֱמֶת" strong="H571" x-morph="Ncfsa" x-gloss="truth" x-translit="ʾĕmeṯ" xml:lang="hbo">אֱ֭מֶת</char> <char style="w" x-id="WLC.PRO.8.7.003" x-align="PRO.8.7.a003" x-target-ids="t004 t005" x-target="shall utter" x-target-head="t005" x-head="true" lemma="הָגָה" strong="H1897" x-morph="Vqi3ms" x-gloss="it.will.utter" x-translit="yehgeh" xml:lang="hbo">יֶהְגֶּ֣ה</char> <char style="w" x-id="WLC.PRO.8.7.004" x-align="PRO.8.7.a004" x-target-ids="t003" x-target="mouth" x-target-head="t003" x-head="true" lemma="חֵךְ" strong="H2441" x-morph="Ncmsc" x-gloss="palate" x-translit="ḥikk" xml:lang="hbo">חִכִּ֑</char><char style="w" x-id="WLC.PRO.8.7.005" x-align="PRO.8.7.a005" x-target-ids="t002" x-target="my" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.8.7.006" x-align="PRO.8.7.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is].(the)" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.8.7.007" x-align="PRO.8.7.a007" x-target-ids="t009 t010 t011" x-target="is an abomination" x-target-head="t011" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="abomination" x-translit="ṯôʿăḇaṯ" xml:lang="hbo">תוֹעֲבַ֖ת</char> <char style="w" x-id="WLC.PRO.8.7.008" x-align="PRO.8.7.a008" x-target-ids="t012 t014" x-target="to lips" x-target-head="t014" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss=