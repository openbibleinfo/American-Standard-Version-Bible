	<para style="p"><verse number="15" style="v" x-ref="PRO.28.15" x-added-alignments="PRO.28.15.a001 PRO.28.15.a007" x-added-target-ids="t001 t009" x-added-target="As | So" sid="PRO 28:15" /><char style="w" x-id="WLC.PRO.28.15.001" x-align="PRO.28.15.a002" x-target-ids="t002 t004 t010" x-target="a lion is" x-target-italic-ids="t010" x-target-head="t004" x-head="true" lemma="אֲרִי" strong="H738" x-morph="Ncmsa" x-gloss="[is].a.lion" x-translit="ʾărî-" xml:lang="hbo">אֲרִי</char>־<char style="w" x-id="WLC.PRO.28.15.002" x-align="PRO.28.15.a003" x-target-ids="t003" x-target="roaring" x-target-head="t003" x-head="true" lemma="נָהַם" strong="H5098" x-morph="Vqrmsa" x-gloss="roaring" x-translit="nōhēm" xml:lang="hbo">נֹ֭הֵם</char> <char style="w" x-id="WLC.PRO.28.15.003" x-align="PRO.28.15.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.15.004" x-align="PRO.28.15.a005" x-target-ids="t006 t008" x-target="a bear" x-target-head="t008" x-head="true" lemma="דֹּב" strong="H1677" x-morph="Ncmsa" x-gloss="a.bear" x-translit="ḏōḇ" xml:lang="hbo">דֹ֣ב</char> <char style="w" x-id="WLC.PRO.28.15.005" x-align="PRO.28.15.a006" x-target-ids="t007" x-target="ranging" x-target-head="t007" x-head="true" lemma="שָׁקַק" strong="H8264" x-morph="Vqrmsa" x-gloss="rushing" x-translit="šôqēq" xml:lang="hbo">שׁוֹקֵ֑ק</char> <char style="w" x-id="WLC.PRO.28.15.006" x-align="PRO.28.15.a008" x-target-ids="t011 t013" x-target="a ruler" x-target-head="t013" x-head="true" lemma="מָשַׁל" strong="H4910" x-morph="Vqrmsa" x-gloss="a.ruler" x-translit="mōšēl" xml:lang="hbo">מֹשֵׁ֥ל</char> <char style="w" x-id="WLC.PRO.28.15.007" x-align="PRO.28.15.a009" x-target-ids="t012" x-target="wicked" x-target-head="t012" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="wicked" x-translit="rāšāʿ" xml:lang="hbo">רָ֝שָׁ֗ע</char> <char style="w" x-id="W