	<para style="p"><verse number="26" style="v" x-ref="PRO.11.26" x-added-alignments="PRO.11.26.a011" x-added-target-ids="t021" x-added-target="it" sid="PRO 11:26" /><char style="w" x-id="WLC.PRO.11.26.001" x-align="PRO.11.26.a001" x-target-ids="t001 t002 t003" x-target="He that withholdeth" x-target-head="t003" x-head="true" lemma="מָנַע" strong="H4513" x-morph="Vqrmsa" x-gloss="[one.who].withholds" x-translit="mōnēᵃʿ" xml:lang="hbo">מֹ֣נֵֽעַ</char> <char style="w" x-id="WLC.PRO.11.26.002" x-align="PRO.11.26.a002" x-target-ids="t004" x-target="grain" x-target-head="t004" x-head="true" lemma="בַּר" strong="H1250" x-morph="Ncmsa" x-gloss="grain" x-translit="bār" xml:lang="hbo">בָּ֭ר</char> <char style="w" x-id="WLC.PRO.11.26.003" x-align="PRO.11.26.a003" x-target-ids="t007 t008" x-target="shall curse" x-target-head="t008" x-head="true" lemma="קבב" strong="H6895" x-morph="Vqi3mp" x-gloss="they" x-translit="yiqqəḇu" xml:lang="hbo">יִקְּבֻ֣</char><char style="w" x-id="WLC.PRO.11.26.004" x-align="PRO.11.26.a004" x-target-ids="t009" x-target="him" x-target-head="t009" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="curse.him" x-translit="hû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.11.26.005" x-align="PRO.11.26.a005" x-target-ids="t005 t006" x-target="the people" x-target-head="t006" x-head="true" lemma="לְאֹם" strong="H3816" x-morph="Ncmsa" x-gloss="a.people" x-translit="ləʾôm" xml:lang="hbo">לְא֑וֹם</char> <char style="w" x-id="WLC.PRO.11.26.006" x-align="PRO.11.26.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.11.26.007" x-align="PRO.11.26.a007" x-target-ids="t011" x-target="blessing" x-target-head="t011" x-head="true" lemma="בְּרָכָה" strong="H1293" x-morph="Ncfsa" x-gloss="a.blessing" x-translit="ḇərāḵāh" xml:lang="hbo">בְרָכָ֗ה</char> <char style="w" x-id="WLC.PRO.11.26.008" x-align="