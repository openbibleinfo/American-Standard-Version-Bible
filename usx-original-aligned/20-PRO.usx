	<para style="p"><verse number="21" style="v" x-ref="PRO.23.21" x-added-alignments="PRO.23.21.a009" x-added-target-ids="t015 t016" x-added-target="a man" sid="PRO 23:21" /><char style="w" x-id="WLC.PRO.23.21.001" x-align="PRO.23.21.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.23.21.002" x-align="PRO.23.21.a002" x-target-ids="t002 t003" x-target="the drunkard" x-target-head="t003" x-head="true" lemma="סָבָא" strong="H5433" x-morph="Vqrmsa" x-gloss="a.drunkard" x-translit="sōḇēʾ" xml:lang="hbo">סֹבֵ֣א</char> <char style="w" x-id="WLC.PRO.23.21.003" x-align="PRO.23.21.a003" x-target-ids="t004" x-target="and" x-target-head="t004" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֭</char><char style="w" x-id="WLC.PRO.23.21.004" x-align="PRO.23.21.a004" x-target-ids="t005 t006" x-target="the glutton" x-target-head="t006" x-head="true" lemma="זָלַל" strong="H2151" x-morph="Vqrmsa" x-gloss="a.glutton" x-translit="zôlēl" xml:lang="hbo">זוֹלֵל</char> <char style="w" x-id="WLC.PRO.23.21.005" x-align="PRO.23.21.a005" x-target-ids="t007 t008 t009 t010" x-target="shall come to poverty" x-target-head="t010" x-head="true" lemma="יָרַשׁ" strong="H3423" x-morph="VNi3ms" x-gloss="he.will.become.impoverished" x-translit="yiwwārēš" xml:lang="hbo">יִוָּרֵ֑שׁ</char> <char style="w" x-id="WLC.PRO.23.21.006" x-align="PRO.23.21.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.23.21.007" x-align="PRO.23.21.a007" x-target-ids="t018" x-target="rags" x-target-head="t018" x-head="true" lemma="קְרָעִים" strong="H7168" x-morph="Ncmpa" x-gloss="rags" x-translit="qərāʿiym" xml:lang="hbo">קְרָעִ֗ים</char> <char style="w" x-id="WLC.PRO.23.21.008" x-