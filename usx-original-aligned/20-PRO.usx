	<para style="p"><verse number="9" style="v" x-ref="PRO.28.9" sid="PRO 28:9" /><char style="w" x-id="WLC.PRO.28.9.001" x-align="PRO.28.9.a001" x-target-ids="t001 t002 t003 t004" x-target="He that turneth away" x-target-head="t003" x-head="true" lemma="סוּר" strong="H5493" x-morph="Vhrmsa" x-gloss="[one.who].turns.aside" x-translit="mēsiyr" xml:lang="hbo">מֵסִ֣יר</char> <char style="w" x-id="WLC.PRO.28.9.002" x-align="PRO.28.9.a003" x-target-ids="t006" x-target="ear" x-target-head="t006" x-head="true" lemma="אֹזֶן" strong="H241" x-morph="Ncfsc" x-gloss="ear" x-translit="ʾāzən" xml:lang="hbo">אָ֭זְנ</char><char style="w" x-id="WLC.PRO.28.9.003" x-align="PRO.28.9.a002" x-target-ids="t005" x-target="his" x-target-head="t005" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.28.9.004" x-align="PRO.28.9.a004" x-target-ids="t007" x-target="from" x-target-head="t007" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.28.9.005" x-align="PRO.28.9.a005" x-target-ids="t008" x-target="hearing" x-target-head="t008" x-head="true" lemma="שָׁמַע" strong="H8085" x-morph="Vqc" x-gloss="hearing" x-translit="ššəmōᵃʿ" xml:lang="hbo">שְּׁמֹ֣עַ</char> <char style="w" x-id="WLC.PRO.28.9.006" x-align="PRO.28.9.a006" x-target-ids="t009 t010" x-target="the law" x-target-head="t010" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsa" x-gloss="[the].law" x-translit="tôrāh" xml:lang="hbo">תּוֹרָ֑ה</char> <char style="w" x-id="WLC.PRO.28.9.007" x-align="PRO.28.9.a007" x-target-ids="t011" x-target="Even" x-target-head="t011" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּֽם</char>־<char style="w" x-id="WLC.PRO.28.9.008" x-align="PRO.28.9.a009" x-target-ids="t013" x-target="prayer" x-target-head="t013" x-head="true" lemma="תְּפִלָּה" strong="H8605" x-morph