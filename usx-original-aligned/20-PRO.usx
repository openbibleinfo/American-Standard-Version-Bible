	<para style="p"><verse number="27" style="v" x-ref="PRO.21.27" sid="PRO 21:27" /><char style="w" x-id="WLC.PRO.21.27.001" x-align="PRO.21.27.a001" x-target-ids="t001 t002" x-target="The sacrifice" x-target-head="t002" x-head="true" lemma="זֶבַח" strong="H2077" x-morph="Ncmsc" x-gloss="[the].sacrifice" x-translit="zeḇaḥ" xml:lang="hbo">זֶ֣בַח</char> <char style="w" x-id="WLC.PRO.21.27.002" x-align="PRO.21.27.a002" x-target-ids="t003 t004 t005" x-target="of the wicked" x-target-head="t005" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿîm" xml:lang="hbo">רְ֭שָׁעִים</char> <char style="w" x-id="WLC.PRO.21.27.003" x-align="PRO.21.27.a003" x-target-ids="t006 t007 t008" x-target="is an abomination" x-target-head="t008" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsa" x-gloss="[is].an.abomination" x-translit="tôʿēḇāh" xml:lang="hbo">תּוֹעֵבָ֑ה</char> <char style="w" x-id="WLC.PRO.21.27.004" x-align="PRO.21.27.a004" x-target-ids="t009 t010 t011" x-target="How much more" x-target-head="t011" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="indeed?" x-translit="ʾap̄" xml:lang="hbo">אַ֝֗ף</char> <char style="w" x-id="WLC.PRO.21.27.005" x-align="PRO.21.27.a005" x-target-ids="t012" x-target="when" x-target-head="t012" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.21.27.006" x-align="PRO.21.27.a008" x-target-ids="t016" x-target="with" x-target-head="t016" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.21.27.007" x-align="PRO.21.27.a009" x-target-ids="t017 t018 t019" x-target="a wicked mind" x-target-head="t018" x-head="true" lemma="זִמָּה" strong="H2154" x-morph="Ncfsa" x-gloss="evil.intent" x-translit="zimmāh" xml:lang="hbo">זִמָּ֥ה</char> <char style="w" x-id="WLC.PRO.21.27.008" x-align="PRO.21.27.a006" x-