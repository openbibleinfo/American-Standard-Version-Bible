	<para style="p"><verse number="2" style="v" x-ref="PRO.25.2" x-added-alignments="PRO.25.2.a001" x-added-target-ids="t001" x-added-target="It" sid="PRO 25:2" /><char style="w" x-id="WLC.PRO.25.2.001" x-align="PRO.25.2.a002" x-target-ids="t002 t003 t004" x-target="is the glory" x-target-head="t004" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="[is].the.glory" x-translit="kəḇōḏ" xml:lang="hbo">כְּבֹ֣ד</char> <char style="w" x-id="WLC.PRO.25.2.002" x-align="PRO.25.2.a003" x-target-ids="t005 t006" x-target="of God" x-target-head="t006" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="of.God" x-translit="ʾĕlōhîm" xml:lang="hbo">אֱ֭לֹהִים</char> <char style="w" x-id="WLC.PRO.25.2.003" x-align="PRO.25.2.a004" x-target-ids="t007 t008" x-target="to conceal" x-target-head="t008" x-head="true" lemma="סָתַר" strong="H5641" x-morph="Vhv2ms" x-gloss="to.conceal" x-translit="hastēr" xml:lang="hbo">הַסְתֵּ֣ר</char> <char style="w" x-id="WLC.PRO.25.2.004" x-align="PRO.25.2.a005" x-target-ids="t009 t010" x-target="a thing" x-target-head="t010" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsa" x-gloss="a.matter" x-translit="dāḇār" xml:lang="hbo">דָּבָ֑ר</char> <char style="w" x-id="WLC.PRO.25.2.005" x-align="PRO.25.2.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.25.2.006" x-align="PRO.25.2.a007" x-target-ids="t012 t013 t016" x-target="the glory is" x-target-head="t013" x-head="true" lemma="כָּבוֹד" strong="H3519" x-morph="Ncbsc" x-gloss="[is.the].glory" x-translit="ḵəḇōḏ" xml:lang="hbo">כְבֹ֥ד</char> <char style="w" x-id="WLC.PRO.25.2.007" x-align="PRO.25.2.a008" x-target-ids="t014 t015" x-target="of kings" x-target-head="t015" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmpa" x-gloss="of.kings" x-translit="məlāḵiym" xml:lang="hbo">מְ֝לָכִ֗ים</char> <char style="w" x-id="