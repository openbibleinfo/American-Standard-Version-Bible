	<para style="p"><verse number="25" style="v" x-ref="PRO.13.25" sid="PRO 13:25" /><char style="w" x-id="WLC.PRO.13.25.001" x-align="PRO.13.25.a001" x-target-ids="t001 t002" x-target="The righteous" x-target-head="t002" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="a.righteous.[person]" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֗יק</char> <char style="w" x-id="WLC.PRO.13.25.002" x-align="PRO.13.25.a002" x-target-ids="t003" x-target="eateth" x-target-head="t003" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqrmsa" x-gloss="[is].eating" x-translit="ʾōḵēl" xml:lang="hbo">אֹ֭כֵל</char> <char style="w" x-id="WLC.PRO.13.25.003" x-align="PRO.13.25.a003" x-target-ids="t004" x-target="to" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.13.25.004" x-align="PRO.13.25.a004" x-target-ids="t005 t006" x-target="the satisfying" x-target-head="t006" x-head="true" lemma="שֹׂבַע" strong="H7648" x-morph="Ncmsc" x-gloss="the.satiety" x-translit="śōḇaʿ" xml:lang="hbo">שֹׂ֣בַע</char> <char style="w" x-id="WLC.PRO.13.25.005" x-align="PRO.13.25.a005" x-target-ids="t007 t009" x-target="of soul" x-target-head="t009" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="his.appetite" x-translit="nap̄š" xml:lang="hbo">נַפְשׁ֑</char><char style="w" x-id="WLC.PRO.13.25.006" x-align="PRO.13.25.a006" x-target-ids="t008" x-target="his" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.13.25.007" x-align="PRO.13.25.a007" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.13.25.008" x-align="PRO.13.25.a008" x-target-ids="t011 t012" x-target="the belly" x-target-head="t012" x-head="true" lemma="בּ