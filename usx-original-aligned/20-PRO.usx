	<para style="p"><verse number="17" style="v" x-ref="PRO.12.17" sid="PRO 12:17" /><char style="w" x-id="WLC.PRO.12.17.001" x-align="PRO.12.17.a001" x-target-ids="t001 t002 t003" x-target="He that uttereth" x-target-head="t003" x-head="true" lemma="פּוּחַ" strong="H6315a" x-morph="Vhi3ms" x-gloss="he.breathes.out" x-translit="yāp̄iyᵃḥ" xml:lang="hbo">יָפִ֣יחַ</char> <char style="w" x-id="WLC.PRO.12.17.002" x-align="PRO.12.17.a002" x-target-ids="t004" x-target="truth" x-target-head="t004" x-head="true" lemma="אֱמוּנָה" strong="H530" x-morph="Ncfsa" x-gloss="faithfulness" x-translit="ʾĕmûnâ" xml:lang="hbo">אֱ֭מוּנָה</char> <char style="w" x-id="WLC.PRO.12.17.003" x-align="PRO.12.17.a003" x-target-ids="t005 t006" x-target="showeth forth" x-target-head="t005" x-head="true" lemma="נָגַד" strong="H5046" x-morph="Vhi3ms" x-gloss="he.declares" x-translit="yaggiyḏ" xml:lang="hbo">יַגִּ֣יד</char> <char style="w" x-id="WLC.PRO.12.17.004" x-align="PRO.12.17.a004" x-target-ids="t007" x-target="righteousness" x-target-head="t007" x-head="true" lemma="צֶדֶק" strong="H6664" x-morph="Ncmsa" x-gloss="righteousness" x-translit="ṣeḏeq" xml:lang="hbo">צֶ֑דֶק</char> <char style="w" x-id="WLC.PRO.12.17.005" x-align="PRO.12.17.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.12.17.006" x-align="PRO.12.17.a006" x-target-ids="t009 t011" x-target="a witness" x-target-head="t011" x-head="true" lemma="עֵד" strong="H5707" x-morph="Ncmsc" x-gloss="a.witness" x-translit="ʿēḏ" xml:lang="hbo">עֵ֖ד</char> <char style="w" x-id="WLC.PRO.12.17.007" x-align="PRO.12.17.a007" x-target-ids="t010" x-target="false" x-target-head="t010" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmpa" x-gloss="of.lies" x-translit="šəqāriym" xml:lang="hbo">שְׁקָרִ֣ים</char> <char style="w" x-id="WLC.PRO.12.17.008" x-align="PRO.12.17.a008" x-target-ids="t012" x-target="de