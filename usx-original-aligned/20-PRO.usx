	<para style="p"><verse number="16" style="v" x-ref="PRO.25.16" sid="PRO 25:16" /><char style="w" x-id="WLC.PRO.25.16.001" x-align="PRO.25.16.a002" x-target-ids="t004" x-target="honey" x-target-head="t004" x-head="true" lemma="דְּבַשׁ" strong="H1706" x-morph="Ncmsa" x-gloss="honey" x-translit="dəḇaš" xml:lang="hbo">דְּבַ֣שׁ</char> <char style="w" x-id="WLC.PRO.25.16.002" x-align="PRO.25.16.a001" x-target-ids="t001 t002 t003" x-target="Hast thou found" x-target-head="t003" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqp2ms" x-gloss="you.have.found" x-translit="māṣāʾṯā" xml:lang="hbo">מָ֭צָאתָ</char> <char style="w" x-id="WLC.PRO.25.16.003" x-align="PRO.25.16.a003" x-target-ids="t005" x-target="eat" x-target-head="t005" x-head="true" lemma="אָכַל" strong="H398" x-morph="Vqv2ms" x-gloss="eat" x-translit="ʾĕḵōl" xml:lang="hbo">אֱכֹ֣ל</char> <char style="w" x-id="WLC.PRO.25.16.004" x-align="PRO.25.16.a004" x-target-ids="t006 t007 t008 t009 t010" x-target="so much as is sufficient" x-target-head="t010" x-head="true" lemma="דַּי" strong="H1767" x-morph="Ncmsc" x-gloss="sufficiency" x-translit="day" xml:lang="hbo">דַּיֶּ֑</char><char style="w" x-id="WLC.PRO.25.16.005" x-align="PRO.25.16.a005" x-target-ids="t011 t012" x-target="for thee" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ekkā" xml:lang="hbo">ךָּ</char> <char style="w" x-id="WLC.PRO.25.16.006" x-align="PRO.25.16.a006" x-target-ids="t013" x-target="Lest" x-target-head="t013" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="lest" x-translit="pen-" xml:lang="hbo">פֶּן</char>־<char style="w" x-id="WLC.PRO.25.16.007" x-align="PRO.25.16.a007" x-target-ids="t014 t015 t016" x-target="thou be filled" x-target-head="t016" x-head="true" lemma="שָׂבֵעַ" strong="H7646" x-morph="Vqi2ms" x-gloss="you" x-translit="tiśbāʿ" xml:lang="hbo">תִּ֝שְׂבָּעֶ֗</char><char style="w" x-id="WLC.PRO.25.16.008" x-align="PRO.25.16.a008" x-target-ids="t017" x-targe