	<para style="p"><verse number="27" style="v" x-ref="PRO.11.27" sid="PRO 11:27" /><char style="w" x-id="WLC.PRO.11.27.001" x-align="PRO.11.27.a001" x-target-ids="t001 t002 t003 t004" x-target="He that diligently seeketh" x-target-head="t004" x-head="true" lemma="שָׁחַר" strong="H7836" x-morph="Vqrmsa" x-gloss="[one.who].seeks.diligently" x-translit="šōḥēr" xml:lang="hbo">שֹׁ֣חֵֽר</char> <char style="w" x-id="WLC.PRO.11.27.002" x-align="PRO.11.27.a002" x-target-ids="t005" x-target="good" x-target-head="t005" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ" xml:lang="hbo">ט֭וֹב</char> <char style="w" x-id="WLC.PRO.11.27.003" x-align="PRO.11.27.a003" x-target-ids="t006" x-target="seeketh" x-target-head="t006" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vpi3ms" x-gloss="he.seeks" x-translit="yəḇaqqēš" xml:lang="hbo">יְבַקֵּ֣שׁ</char> <char style="w" x-id="WLC.PRO.11.27.004" x-align="PRO.11.27.a004" x-target-ids="t007" x-target="favor" x-target-head="t007" x-head="true" lemma="רָצוֹן" strong="H7522" x-morph="Ncmsa" x-gloss="favor" x-translit="rāṣôn" xml:lang="hbo">רָצ֑וֹן</char> <char style="w" x-id="WLC.PRO.11.27.005" x-align="PRO.11.27.a005" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.27.006" x-align="PRO.11.27.a006" x-target-ids="t009 t010 t011 t012" x-target="he that searcheth after" x-target-head="t011" x-head="true" lemma="דָּרַשׁ" strong="H1875" x-morph="Vqrmsa" x-gloss="[one.who].seeks.carefully" x-translit="ḏōrēš" xml:lang="hbo">דֹרֵ֖שׁ</char> <char style="w" x-id="WLC.PRO.11.27.007" x-align="PRO.11.27.a007" x-target-ids="t013" x-target="evil" x-target-head="t013" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="evil" x-translit="rāʿāh" xml:lang="hbo">רָעָ֣ה</char> <char style="w" x-id="WLC.PRO.11.27.008" x-align="PRO.11.27.a008" x-target-ids=