	<para style="p"><verse number="18" style="v" x-ref="PRO.5.18" sid="PRO 5:18" /><char style="w" x-id="WLC.PRO.5.18.001" x-align="PRO.5.18.a001" x-target-ids="t001 t004" x-target="Let be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqj3ms" x-gloss="may.it.be" x-translit="yəhiy-" xml:lang="hbo">יְהִֽי</char>־<char style="w" x-id="WLC.PRO.5.18.002" x-align="PRO.5.18.a003" x-target-ids="t003" x-target="fountain" x-target-head="t003" x-head="true" lemma="מָקוֹר" strong="H4726" x-morph="Ncmsc" x-gloss="spring" x-translit="məqôr" xml:lang="hbo">מְקוֹרְ</char><char style="w" x-id="WLC.PRO.5.18.003" x-align="PRO.5.18.a002" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PRO.5.18.004" x-align="PRO.5.18.a004" x-target-ids="t005" x-target="blessed" x-target-head="t005" x-head="true" lemma="בָּרַךְ" strong="H1288" x-morph="Vqsmsa" x-gloss="blessed" x-translit="ḇārûḵ" xml:lang="hbo">בָר֑וּךְ</char> <char style="w" x-id="WLC.PRO.5.18.005" x-align="PRO.5.18.a005" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.5.18.006" x-align="PRO.5.18.a006" x-target-ids="t007" x-target="rejoice" x-target-head="t007" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vqv2ms" x-gloss="rejoice" x-translit="śəmaḥ" xml:lang="hbo">שְׂמַ֗ח</char> <char style="w" x-id="WLC.PRO.5.18.007" x-align="PRO.5.18.a007" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.5.18.008" x-align="PRO.5.18.a008" x-target-ids="t009 t010" x-target="the wife" x-target-head="t010" x-head="true" lemma="אִשָּׁה" strong="H802" x-morph="Ncfsc" x-gloss="the.wife" x-trans