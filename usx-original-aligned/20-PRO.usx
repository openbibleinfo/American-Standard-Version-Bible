	<para style="p"><verse number="5" style="v" x-ref="PRO.17.5" x-added-alignments="PRO.17.5.a008" x-added-target-ids="t008" x-added-target="And" sid="PRO 17:5" /><char style="w" x-id="WLC.PRO.17.5.001" x-align="PRO.17.5.a001" x-target-ids="t001 t002" x-target="Whoso mocketh" x-target-head="t002" x-head="true" lemma="לָעַג" strong="H3932" x-morph="Vqrmsa" x-gloss="[one.who].mocks" x-translit="lōʿēḡ" xml:lang="hbo">לֹעֵ֣ג</char> <char style="w" x-id="WLC.PRO.17.5.002" x-align="PRO.17.5.a002" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="Rd" x-gloss="(to" x-translit="lā" xml:lang="hbo">לָ֭</char><char style="w" x-id="WLC.PRO.17.5.003" x-align="PRO.17.5.a003" x-target-ids="t003" x-target="the" x-target-head="t003" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.17.5.004" x-align="PRO.17.5.a004" x-target-ids="t004" x-target="poor" x-target-head="t004" x-head="true" lemma="רוּשׁ" strong="H7326" x-morph="Vqrmsa" x-gloss="[one.who.is].poor" x-translit="rāš" xml:lang="hbo">רָשׁ</char> <char style="w" x-id="WLC.PRO.17.5.005" x-align="PRO.17.5.a005" x-target-ids="t005" x-target="reproacheth" x-target-head="t005" x-head="true" lemma="חָרַף" strong="H2778" x-morph="Vpp3ms" x-gloss="he.reproaches" x-translit="ḥērēp̄" xml:lang="hbo">חֵרֵ֣ף</char> <char style="w" x-id="WLC.PRO.17.5.006" x-align="PRO.17.5.a006" x-target-ids="t007" x-target="Maker" x-target-head="t007" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqrmsc" x-gloss="maker" x-translit="ʿōś" xml:lang="hbo">עֹשֵׂ֑</char><char style="w" x-id="WLC.PRO.17.5.007" x-align="PRO.17.5.a007" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1930a" x-morph="Sp3ms" x-gloss="his" x-translit="ēhû" xml:lang="hbo">הוּ</char> <char style="w" x-id="WLC.PRO.17.5.008" x-align="PRO.17.5.a009" x-target-ids="t009 t010 t011 t012" x-target="he that is glad" x-target-head="t012"