	<para style="p"><verse number="5" style="v" x-ref="PRO.2.5" sid="PRO 2:5" /><char style="w" x-id="WLC.PRO.2.5.001" x-align="PRO.2.5.a001" x-target-ids="t001" x-target="Then" x-target-head="t001" x-head="true" lemma="אָז" strong="H227" x-morph="D" x-gloss="then" x-translit="ʾāz" xml:lang="hbo">אָ֗ז</char> <char style="w" x-id="WLC.PRO.2.5.002" x-align="PRO.2.5.a002" x-target-ids="t002 t003 t004" x-target="shalt thou understand" x-target-head="t004" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi2ms" x-gloss="you.will.discern" x-translit="tāḇîn" xml:lang="hbo">תָּ֭בִין</char> <char style="w" x-id="WLC.PRO.2.5.003" x-align="PRO.2.5.a003" x-target-ids="t005 t006" x-target="the fear" x-target-head="t006" x-head="true" lemma="יִרְאָה" strong="H3374" x-morph="Ncfsc" x-gloss="the.fear" x-translit="yirʾaṯ" xml:lang="hbo">יִרְאַ֣ת</char> <char style="w" x-id="WLC.PRO.2.5.004" x-align="PRO.2.5.a004" x-target-ids="t007 t008" x-target="of Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֑ה</char> <char style="w" x-id="WLC.PRO.2.5.005" x-align="PRO.2.5.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.2.5.006" x-align="PRO.2.5.a007" x-target-ids="t011 t012" x-target="the knowledge" x-target-head="t012" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsc" x-gloss="the.knowledge" x-translit="ḏaʿaṯ" xml:lang="hbo">דַ֖עַת</char> <char style="w" x-id="WLC.PRO.2.5.007" x-align="PRO.2.5.a008" x-target-ids="t013 t014" x-target="of God" x-target-head="t014" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="of.God" x-translit="ʾĕlōhiym" xml:lang="hbo">אֱלֹהִ֣ים</char> <char style="w" x-id="WLC.PRO.2.5.008" x-align="PRO.2.5.a006" x-target-ids="t010" x-target="find" x-target-head="t010" x-head="true" lemma="מָצָא" st