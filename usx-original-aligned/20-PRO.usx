	<para style="p"><verse number="5" style="v" x-ref="PRO.15.5" sid="PRO 15:5" /><char style="w" x-id="WLC.PRO.15.5.001" x-align="PRO.15.5.a001" x-target-ids="t001 t002" x-target="A fool" x-target-head="t002" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="a.fool" x-translit="ʾĕwiyl" xml:lang="hbo">אֱוִ֗יל</char> <char style="w" x-id="WLC.PRO.15.5.002" x-align="PRO.15.5.a002" x-target-ids="t003" x-target="despiseth" x-target-head="t003" x-head="true" lemma="נָאַץ" strong="H5006" x-morph="Vqi3ms" x-gloss="he.spurns" x-translit="yinʾaṣ" xml:lang="hbo">יִ֭נְאַץ</char> <char style="w" x-id="WLC.PRO.15.5.003" x-align="PRO.15.5.a003" x-target-ids="t006" x-target="correction" x-target-head="t006" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsc" x-gloss="the.discipline" x-translit="mûsar" xml:lang="hbo">מוּסַ֣ר</char> <char style="w" x-id="WLC.PRO.15.5.004" x-align="PRO.15.5.a004" x-target-ids="t005" x-target="father’s" x-target-head="t005" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="his.father" x-translit="ʾāḇiy" xml:lang="hbo">אָבִ֑י</char><char style="w" x-id="WLC.PRO.15.5.005" x-align="PRO.15.5.a005" x-target-ids="t004" x-target="his" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.15.5.006" x-align="PRO.15.5.a006" x-target-ids="t007" x-target="But" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.15.5.007" x-align="PRO.15.5.a007" x-target-ids="t008 t009 t010" x-target="he that regardeth" x-target-head="t010" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[one.who].keeps" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֖ר</char> <char style="w" x-id="WLC.PRO.15.5.008" x-align="PRO.15.5.a008" x-target-ids="t011" x-target="reproof" x-target-head="t011" x-head="true" lemma="תּוֹכַחַת" strong=