	<para style="p"><verse number="2" style="v" x-ref="PRO.20.2" sid="PRO 20:2" /><char style="w" x-id="WLC.PRO.20.2.001" x-align="PRO.20.2.a003" x-target-ids="t006 t008 t009" x-target="is the roaring" x-target-head="t009" x-head="true" lemma="נַהַם" strong="H5099" x-morph="Ncmsa" x-gloss="[is].a.roaring" x-translit="naham" xml:lang="hbo">נַ֣הַם</char> <char style="w" x-id="WLC.PRO.20.2.002" x-align="PRO.20.2.a004" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="כְּ" strong="H3509a" x-morph="Rd" x-gloss="like.(the)" x-translit="ka" xml:lang="hbo">כַּ֭</char><char style="w" x-id="WLC.PRO.20.2.003" x-align="PRO.20.2.a005" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="young" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.20.2.004" x-align="PRO.20.2.a006" x-target-ids="t010 t011 t012" x-target="of a lion" x-target-head="t012" x-head="true" lemma="כְּפִיר" strong="H3715" x-morph="Ncmsa" x-gloss="lion" x-translit="kəp̄îr" xml:lang="hbo">כְּפִיר</char> <char style="w" x-id="WLC.PRO.20.2.005" x-align="PRO.20.2.a001" x-target-ids="t001 t002" x-target="The terror" x-target-head="t002" x-head="true" lemma="אֵימָה" strong="H367" x-morph="Ncfsc" x-gloss="[the].terror" x-translit="ʾēymaṯ" xml:lang="hbo">אֵ֣ימַת</char> <char style="w" x-id="WLC.PRO.20.2.006" x-align="PRO.20.2.a002" x-target-ids="t003 t004 t005" x-target="of a king" x-target-head="t005" x-head="true" lemma="מֶלֶךְ" strong="H4428" x-morph="Ncmsa" x-gloss="of.a.king" x-translit="meleḵ" xml:lang="hbo">מֶ֑לֶךְ</char> <char style="w" x-id="WLC.PRO.20.2.007" x-align="PRO.20.2.a007" x-target-ids="t013 t014 t015 t017 t018" x-target="He that provoketh to anger" x-target-head="t015" x-head="true" lemma="עָבַר" strong="H5674a" x-morph="Vtrmsc" x-gloss="[one" x-translit="miṯʿabbər" xml:lang="hbo">מִ֝תְעַבְּר֗</char><char style="w" x-id="WLC.PRO.20.2.008" x-align="PRO.20.2.a008" x-target-ids="t016" x-target="him" x-target-head="t016" x