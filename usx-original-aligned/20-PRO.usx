	<para style="p"><verse number="34" style="v" x-ref="PRO.14.34" sid="PRO 14:34" /><char style="w" x-id="WLC.PRO.14.34.001" x-align="PRO.14.34.a001" x-target-ids="t001" x-target="Righteousness" x-target-head="t001" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְדָקָ֥ה</char> <char style="w" x-id="WLC.PRO.14.34.002" x-align="PRO.14.34.a002" x-target-ids="t002" x-target="exalteth" x-target-head="t002" x-head="true" lemma="רוּם" strong="H7311" x-morph="Voi3fs" x-gloss="it.exalts" x-translit="ṯərômēm-" xml:lang="hbo">תְרֽוֹמֵֽם</char>־<char style="w" x-id="WLC.PRO.14.34.003" x-align="PRO.14.34.a003" x-target-ids="t003 t004" x-target="a nation" x-target-head="t004" x-head="true" lemma="גּוֹי" strong="H1471" x-morph="Ncmsa" x-gloss="a.nation" x-translit="gôy" xml:lang="hbo">גּ֑וֹי</char> <char style="w" x-id="WLC.PRO.14.34.004" x-align="PRO.14.34.a004" x-target-ids="t005" x-target="But" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[is]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.34.005" x-align="PRO.14.34.a005" x-target-ids="t007 t008 t009" x-target="is a reproach" x-target-head="t009" x-head="true" lemma="חֶסֶד" strong="H2617a" x-morph="Ncmsc" x-gloss="a.shame" x-translit="ḥeseḏ" xml:lang="hbo">חֶ֖סֶד</char> <char style="w" x-id="WLC.PRO.14.34.006" x-align="PRO.14.34.a006" x-target-ids="t010 t011 t012" x-target="to any people" x-target-head="t012" x-head="true" lemma="לְאֹם" strong="H3816" x-morph="Ncmpa" x-gloss="to.a.people" x-translit="ləʾummiym" xml:lang="hbo">לְאֻמִּ֣ים</char> <char style="w" x-id="WLC.PRO.14.34.007" x-align="PRO.14.34.a007" x-target-ids="t006" x-target="sin" x-target-head="t006" x-head="true" lemma="חַטָּאת" strong="H2403" x-morph="Ncfsa" x-gloss="sin" x-translit="ḥaṭṭāʾṯ:" xml:lang="hbo">חַטָּֽאת</char>׃<verse eid="PRO 14:34" /></para>
