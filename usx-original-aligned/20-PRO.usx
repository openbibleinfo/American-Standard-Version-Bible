	<para style="p"><verse number="20" style="v" x-ref="PRO.13.20" x-added-alignments="PRO.13.20.a010" x-added-target-ids="t017 t018" x-added-target="for it" sid="PRO 13:20" /><char style="w" x-id="WLC.PRO.13.20.v001.r01.001" x-align="PRO.13.20.a001" x-target-ids="t001" x-target="Walk" x-target-head="t001" x-head="true" lemma="הָלַךְ" strong="H1980" x-morph="Vqa" x-translit="hlwḵ" xml:lang="hbo">הלוך</char><char style="w" x-id="WLC.PRO.13.20.002" x-align="PRO.13.20.a002" x-target-ids="t002" x-target="with" x-target-head="t002" x-head="true" lemma="אֵת" strong="H854" x-morph="R" x-gloss="with" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.PRO.13.20.003" x-align="PRO.13.20.a003" x-target-ids="t003 t004" x-target="wise men" x-target-head="t003" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֣ים</char> <char style="w" x-id="WLC.PRO.13.20.v002.r01.001" x-align="PRO.13.20.a004" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" x-morph="C" x-translit="w" xml:lang="hbo">ו</char><char style="w" x-id="WLC.PRO.13.20.v002.r01.002" x-align="PRO.13.20.a005" x-target-ids="t006 t007 t008 t009" x-target="thou shalt be wise" x-target-head="t009" x-head="true" lemma="חָכַם" strong="H2449" x-morph="Vqv2ms" x-translit="ḥḵm" xml:lang="hbo">חכם</char> <char style="w" x-id="WLC.PRO.13.20.005" x-align="PRO.13.20.a006" x-target-ids="t010" x-target="But" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.20.006" x-align="PRO.13.20.a007" x-target-ids="t011 t012" x-target="the companion" x-target-head="t012" x-head="true" lemma="רָעָה" strong="H7462a" x-morph="Vqrmsa" x-gloss="[one.who].associates.with" x-translit="rōʿeh" xml:lang="hbo">רֹעֶ֖ה</char> <char style="w" x-id="WLC.PRO.13.20.007" x-align="PRO.13.20.a008" x-target-ids="t013 t014" x-target="of fools