	<para style="p"><verse number="17" style="v" x-ref="PRO.5.17" sid="PRO 5:17" /><char style="w" x-id="WLC.PRO.5.17.001" x-align="PRO.5.17.a001" x-target-ids="t001 t002 t003" x-target="Let them be" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqj3mp" x-gloss="let.them.belong" x-translit="yihəyû-" xml:lang="hbo">יִֽהְיוּ</char>־<char style="w" x-id="WLC.PRO.5.17.002" x-align="PRO.5.17.a002" x-target-ids="t004" x-target="for" x-target-head="t004" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.5.17.003" x-align="PRO.5.17.a003" x-target-ids="t005" x-target="thyself" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="you" x-translit="əḵā" xml:lang="hbo">ךָ֥</char> <char style="w" x-id="WLC.PRO.5.17.004" x-align="PRO.5.17.a004" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="you" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.5.17.005" x-align="PRO.5.17.a004" x-target-ids="t006" x-target="alone" x-target-head="t006" x-head="true" lemma="בַּד" strong="H905" x-morph="Ncmsc" x-translit="ḇadd" xml:lang="hbo">בַדֶּ֑</char><char style="w" x-id="WLC.PRO.5.17.006" x-align="PRO.5.17.a005" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="alone" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.5.17.007" x-align="PRO.5.17.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.5.17.008" x-align="PRO.5.17.a007" x-target-ids="t008" x-target="not" x-target-head="t008" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="not" x-translit="ʾēyn" xml:lang="hbo">אֵ֖ין</char> <char style="w" x-id="WLC.PRO.5.17.009" x-align="PRO.5.17.a008" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="t