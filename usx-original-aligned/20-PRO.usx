	<para style="p"><verse number="24" style="v" x-ref="PRO.30.24" x-added-alignments="PRO.30.24.a003" x-added-target-ids="t005" x-added-target="which" sid="PRO 30:24" /><char style="w" x-id="WLC.PRO.30.24.001" x-align="PRO.30.24.a001" x-target-ids="t001 t002 t003 t004" x-target="There are four things" x-target-head="t003" x-head="true" lemma="אַרְבַּע" strong="H702" x-morph="Acmsa" x-gloss="four.[things]" x-translit="ʾarbāʿâ" xml:lang="hbo">אַרְבָּ֣עָה</char> <char style="w" x-id="WLC.PRO.30.24.002" x-align="PRO.30.24.a002" x-status="unrepresented" x-head="true" lemma="הֵם" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēm" xml:lang="hbo">הֵ֭ם</char> <char style="w" x-id="WLC.PRO.30.24.003" x-align="PRO.30.24.a004" x-target-ids="t006 t007" x-target="are little" x-target-head="t007" x-head="true" lemma="קָטָן" strong="H6996" x-morph="Aampc" x-gloss="[are].small.[things]" x-translit="qəṭannê-" xml:lang="hbo">קְטַנֵּי</char>־<char style="w" x-id="WLC.PRO.30.24.004" x-align="PRO.30.24.a005" x-target-ids="t008 t009 t010" x-target="upon the earth" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="of.[the].earth" x-translit="ʾāreṣ" xml:lang="hbo">אָ֑רֶץ</char> <char style="w" x-id="WLC.PRO.30.24.005" x-align="PRO.30.24.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.30.24.006" x-align="PRO.30.24.a007" x-target-ids="t012" x-target="they" x-target-head="t012" x-head="true" lemma="הֵמָּה" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēmmâ" xml:lang="hbo">הֵ֗מָּה</char> <char style="w" x-id="WLC.PRO.30.24.007" x-align="PRO.30.24.a008" x-target-ids="t013 t015" x-target="are wise" x-target-head="t015" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="[are].wise.[things]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֥ים</char> <char style="w" x-id="WLC.PR