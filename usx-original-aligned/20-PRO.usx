	<para style="p"><verse number="1" style="v" x-ref="PRO.27.1" sid="PRO 27:1" /><char style="w" x-id="WLC.PRO.27.1.001" x-align="PRO.27.1.a001" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַֽל</char>־<char style="w" x-id="WLC.PRO.27.1.002" x-align="PRO.27.1.a002" x-target-ids="t001 t003" x-target="Boast thyself" x-target-head="t001" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vtj2ms" x-gloss="boast" x-translit="tiṯhallēl" xml:lang="hbo">תִּ֭תְהַלֵּל</char> <char style="w" x-id="WLC.PRO.27.1.003" x-align="PRO.27.1.a003" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.27.1.004" x-align="PRO.27.1.a003" x-target-ids="t004" x-target="of" x-target-head="t004" x-head="true" lemma="יוֹם" strong="H3117" x-morph="Ncmsc" x-gloss="a.day" x-translit="yôm" xml:lang="hbo">י֣וֹם</char> <char style="w" x-id="WLC.PRO.27.1.005" x-align="PRO.27.1.a004" x-target-ids="t005" x-target="tomorrow" x-target-head="t005" x-head="true" lemma="מָחָר" strong="H4279" x-morph="Ncmsa" x-gloss="tomorrow" x-translit="māḥār" xml:lang="hbo">מָחָ֑ר</char> <char style="w" x-id="WLC.PRO.27.1.006" x-align="PRO.27.1.a005" x-target-ids="t006" x-target="For" x-target-head="t006" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char> <char style="w" x-id="WLC.PRO.27.1.007" x-align="PRO.27.1.a006" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.27.1.008" x-align="PRO.27.1.a007" x-target-ids="t007 t008" x-target="thou knowest" x-target-head="t008" x-head="true" lemma="יָדַע" strong="H3045" x-morph="Vqi2ms" x-gloss="you.know" x-translit="ṯēḏaʿ" xml:lang="hbo">תֵ֝דַ֗ע</char> <char style="w" x-id="WLC.PRO.27.1.009" x-