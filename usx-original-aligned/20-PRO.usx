	<para style="p"><verse number="27" style="v" x-ref="PRO.7.27" sid="PRO 7:27" /><char style="w" x-id="WLC.PRO.7.27.001" x-align="PRO.7.27.a001" x-target-ids="t003 t004 t005" x-target="is the way" x-target-head="t005" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbpc" x-gloss="[is].the.ways" x-translit="darḵēy" xml:lang="hbo">דַּרְכֵ֣י</char> <char style="w" x-id="WLC.PRO.7.27.002" x-align="PRO.7.27.a002" x-target-ids="t006 t007" x-target="to Sheol" x-target-head="t007" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="of.Sheol" x-translit="šəʾôl" xml:lang="hbo">שְׁא֣וֹל</char> <char style="w" x-id="WLC.PRO.7.27.003" x-align="PRO.7.27.a003" x-target-ids="t002" x-target="house" x-target-head="t002" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="house" x-translit="bēyṯ" xml:lang="hbo">בֵּיתָ֑</char><char style="w" x-id="WLC.PRO.7.27.004" x-align="PRO.7.27.a004" x-target-ids="t001" x-target="Her" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.7.27.005" x-align="PRO.7.27.a005" x-target-ids="t008 t009" x-target="Going down" x-target-head="t008" x-head="true" lemma="יָרַד" strong="H3381" x-morph="Vqrfpa" x-gloss="[they.are].going.down" x-translit="yōrəḏôṯ" xml:lang="hbo">יֹ֝רְד֗וֹת</char> <char style="w" x-id="WLC.PRO.7.27.006" x-align="PRO.7.27.a006" x-target-ids="t010" x-target="to" x-target-head="t010" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.PRO.7.27.007" x-align="PRO.7.27.a007" x-target-ids="t011 t012" x-target="the chambers" x-target-head="t012" x-head="true" lemma="חֶדֶר" strong="H2315" x-morph="Ncmpc" x-gloss="[the].chambers" x-translit="ḥaḏrê-" xml:lang="hbo">חַדְרֵי</char>־<char style="w" x-id="WLC.PRO.7.27.008" x-align="PRO.7.27.a008" x-target-ids="t013 t014" x-target="of death" x-target-head="t014" x-hea