	<para style="p"><verse number="28" style="v" x-ref="PRO.10.28" sid="PRO 10:28" /><char style="w" x-id="WLC.PRO.10.28.001" x-align="PRO.10.28.a001" x-target-ids="t001 t002" x-target="The hope" x-target-head="t002" x-head="true" lemma="תּוֹחֶלֶת" strong="H8431" x-morph="Ncfsc" x-gloss="[the].hope" x-translit="tôḥeleṯ" xml:lang="hbo">תּוֹחֶ֣לֶת</char> <char style="w" x-id="WLC.PRO.10.28.002" x-align="PRO.10.28.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="of.righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַדִּיקִ֣ים</char> <char style="w" x-id="WLC.PRO.10.28.003" x-align="PRO.10.28.a003" x-target-ids="t006 t007 t008" x-target="shall be gladness" x-target-italic-ids="t006 t007" x-target-head="t008" x-head="true" lemma="שִׂמְחָה" strong="H8057" x-morph="Ncfsa" x-gloss="[is].joy" x-translit="śimḥāh" xml:lang="hbo">שִׂמְחָ֑ה</char> <char style="w" x-id="WLC.PRO.10.28.004" x-align="PRO.10.28.a004" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.10.28.005" x-align="PRO.10.28.a005" x-target-ids="t010 t011" x-target="the expectation" x-target-head="t011" x-head="true" lemma="תִּקְוָה" strong="H8615" x-morph="Ncfsc" x-gloss="hope" x-translit="ṯiqwaṯ" xml:lang="hbo">תִקְוַ֖ת</char> <char style="w" x-id="WLC.PRO.10.28.006" x-align="PRO.10.28.a006" x-target-ids="t012 t013 t014" x-target="of the wicked" x-target-head="t014" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.10.28.007" x-align="PRO.10.28.a007" x-target-ids="t015 t016" x-target="shall perish" x-target-head="t016" x-head="true" lemma="אָבַד" strong="H6" x-morph="Vqi3fs" x-gloss="it.is.lost" x-translit="tōʾḇēḏ:" xml:lang="hbo">תֹּא