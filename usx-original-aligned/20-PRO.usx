	<para style="p"><verse number="3" style="v" x-ref="PRO.4.3" sid="PRO 4:3" /><char style="w" x-id="WLC.PRO.4.3.001" x-align="PRO.4.3.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.4.3.002" x-align="PRO.4.3.a003" x-target-ids="t004 t005" x-target="a son" x-target-head="t005" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="a.son" x-translit="ḇēn" xml:lang="hbo">בֵ֭ן</char> <char style="w" x-id="WLC.PRO.4.3.003" x-align="PRO.4.3.a002" x-target-ids="t002 t003" x-target="I was" x-target-head="t003" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqp1cs" x-gloss="I.was" x-translit="hāyiyṯî" xml:lang="hbo">הָיִ֣יתִי</char> <char style="w" x-id="WLC.PRO.4.3.004" x-align="PRO.4.3.a004" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.4.3.005" x-align="PRO.4.3.a005" x-target-ids="t008" x-target="father" x-target-head="t008" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="father" x-translit="ʾāḇ" xml:lang="hbo">אָבִ֑</char><char style="w" x-id="WLC.PRO.4.3.006" x-align="PRO.4.3.a006" x-target-ids="t007" x-target="my" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.4.3.007" x-align="PRO.4.3.a007" x-target-ids="t009" x-target="Tender" x-target-head="t009" x-head="true" lemma="רַךְ" strong="H7390" x-morph="Aamsa" x-gloss="a.tender" x-translit="raḵ" xml:lang="hbo">רַ֥ךְ</char> <char style="w" x-id="WLC.PRO.4.3.008" x-align="PRO.4.3.a008" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.4.3.00