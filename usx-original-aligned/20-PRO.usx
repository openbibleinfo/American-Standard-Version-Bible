	<para style="p"><verse number="29" style="v" x-ref="PRO.31.29" sid="PRO 31:29" /><char style="w" x-id="WLC.PRO.31.29.001" x-align="PRO.31.29.a001" x-target-ids="t001" x-target="Many" x-target-head="t001" x-head="true" lemma="רַב" strong="H7227" x-morph="Aafpa" x-gloss="many" x-translit="rabôṯ" xml:lang="hbo">רַבּ֣וֹת</char> <char style="w" x-id="WLC.PRO.31.29.002" x-align="PRO.31.29.a002" x-target-ids="t002" x-target="daughters" x-target-head="t002" x-head="true" lemma="בַּת" strong="H1323" x-morph="Ncfpa" x-gloss="daughters" x-translit="bānôṯ" xml:lang="hbo">בָּ֭נוֹת</char> <char style="w" x-id="WLC.PRO.31.29.003" x-align="PRO.31.29.a003" x-target-ids="t003 t004" x-target="have done" x-target-head="t004" x-head="true" lemma="עָשָׂה" strong="H6213" x-morph="Vqp3cp" x-gloss="they.have.done" x-translit="ʿāśû" xml:lang="hbo">עָ֣שׂוּ</char> <char style="w" x-id="WLC.PRO.31.29.004" x-align="PRO.31.29.a004" x-target-ids="t005" x-target="worthily" x-target-head="t005" x-head="true" lemma="חַיִל" strong="H2428" x-morph="Ncmsa" x-gloss="ability" x-translit="ḥāyil" xml:lang="hbo">חָ֑יִל</char> <char style="w" x-id="WLC.PRO.31.29.005" x-align="PRO.31.29.a005" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.31.29.006" x-align="PRO.31.29.a006" x-target-ids="t007" x-target="thou" x-target-head="t007" x-head="true" lemma="אַתְּ" strong="H859b" x-morph="Pp2fs" x-gloss="you" x-translit="ʾatə" xml:lang="hbo">אַ֗תְּ</char> <char style="w" x-id="WLC.PRO.31.29.007" x-align="PRO.31.29.a007" x-target-ids="t008" x-target="excellest" x-target-head="t008" x-head="true" lemma="עָלָה" strong="H5927" x-morph="Vqp2fs" x-gloss="you.have.gone.up" x-translit="ʿāliyṯ" xml:lang="hbo">עָלִ֥ית</char> <char style="w" x-id="WLC.PRO.31.29.008" x-align="PRO.31.29.a008" x-status="unrepresented" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="above" 