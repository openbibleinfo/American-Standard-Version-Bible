	<para style="p"><verse number="7" style="v" x-ref="PRO.17.7" sid="PRO 17:7" /><char style="w" x-id="WLC.PRO.17.7.001" x-align="PRO.17.7.a001" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.17.7.002" x-align="PRO.17.7.a002" x-target-ids="t003 t009" x-target="becometh do" x-target-head="t003" x-head="true" lemma="נָאוֶה" strong="H5000" x-morph="Aafsa" x-gloss="[is].suitable" x-translit="nāʾwāh" xml:lang="hbo">נָאוָ֣ה</char> <char style="w" x-id="WLC.PRO.17.7.003" x-align="PRO.17.7.a003" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.17.7.004" x-align="PRO.17.7.a004" x-target-ids="t005 t006" x-target="a fool" x-target-head="t006" x-head="true" lemma="נָבָל" strong="H5036" x-morph="Aamsa" x-gloss="a.fool" x-translit="nāḇāl" xml:lang="hbo">נָבָ֣ל</char> <char style="w" x-id="WLC.PRO.17.7.005" x-align="PRO.17.7.a005" x-target-ids="t002" x-target="speech" x-target-head="t002" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfsc" x-gloss="a.lip" x-translit="śəp̄aṯ-" xml:lang="hbo">שְׂפַת</char>־<char style="w" x-id="WLC.PRO.17.7.006" x-align="PRO.17.7.a006" x-target-ids="t001" x-target="Excellent" x-target-head="t001" x-head="true" lemma="יֶתֶר" strong="H3499" x-morph="Ncmsa" x-gloss="of.excellence" x-translit="yeṯer" xml:lang="hbo">יֶ֑תֶר</char> <char style="w" x-id="WLC.PRO.17.7.007" x-align="PRO.17.7.a007" x-target-ids="t007 t008" x-target="Much less" x-target-head="t008" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="indeed?" x-translit="ʾap̄" xml:lang="hbo">אַ֝֗ף</char> <char style="w" x-id="WLC.PRO.17.7.008" x-align="PRO.17.7.a007" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.17.7.009" x-align="PRO.17