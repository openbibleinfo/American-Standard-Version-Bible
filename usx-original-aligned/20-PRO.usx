	<para style="p"><verse number="7" style="v" x-ref="PRO.4.7" x-added-alignments="PRO.4.7.a003" x-added-target-ids="t006" x-added-target="therefore" sid="PRO 4:7" /><char style="w" x-id="WLC.PRO.4.7.001" x-align="PRO.4.7.a002" x-target-ids="t002 t003 t004 t005" x-target="is the principal thing" x-target-italic-ids="t002" x-target-head="t004" x-head="true" lemma="רֵאשִׁית" strong="H7225" x-morph="Ncfsc" x-gloss="[the].beginning" x-translit="rēʾšiyṯ" xml:lang="hbo">רֵאשִׁ֣ית</char> <char style="w" x-id="WLC.PRO.4.7.002" x-align="PRO.4.7.a001" x-target-ids="t001" x-target="Wisdom" x-target-head="t001" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="of.wisdom" x-translit="ḥoḵmâ" xml:lang="hbo">חָ֭כְמָה</char> <char style="w" x-id="WLC.PRO.4.7.003" x-align="PRO.4.7.a004" x-target-ids="t007" x-target="get" x-target-head="t007" x-head="true" lemma="קָנָה" strong="H7069" x-morph="Vqv2ms" x-gloss="acquire" x-translit="qənēh" xml:lang="hbo">קְנֵ֣ה</char> <char style="w" x-id="WLC.PRO.4.7.004" x-align="PRO.4.7.a005" x-target-ids="t008" x-target="wisdom" x-target-head="t008" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֑ה</char> <char style="w" x-id="WLC.PRO.4.7.005" x-align="PRO.4.7.a006" x-target-ids="t009" x-target="Yea" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.4.7.006" x-align="PRO.4.7.a007" x-target-ids="t010" x-target="with" x-target-head="t010" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.4.7.007" x-align="PRO.4.7.a008" x-target-ids="t011" x-target="all" x-target-head="t011" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.4.7.008" x-align="PRO.4.7.a009" x-target-ids="t013" x-tar