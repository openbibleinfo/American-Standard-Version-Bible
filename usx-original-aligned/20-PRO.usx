	<para style="p"><verse number="16" style="v" x-ref="PRO.28.16" x-added-alignments="PRO.28.16.a007 PRO.28.16.a011" x-added-target-ids="t011 t018" x-added-target="But | his" sid="PRO 28:16" /><char style="w" x-id="WLC.PRO.28.16.001" x-align="PRO.28.16.a001" x-target-ids="t001 t002" x-target="The prince" x-target-head="t002" x-head="true" lemma="נָגִיד" strong="H5057" x-morph="Ncmsa" x-gloss="a.ruler" x-translit="nāḡiyḏ" xml:lang="hbo">נָגִ֗יד</char> <char style="w" x-id="WLC.PRO.28.16.002" x-align="PRO.28.16.a002" x-target-ids="t003 t004" x-target="that lacketh" x-target-head="t004" x-head="true" lemma="חָסֵר" strong="H2638" x-morph="Aamsc" x-gloss="lacking" x-translit="ḥăsar" xml:lang="hbo">חֲסַ֣ר</char> <char style="w" x-id="WLC.PRO.28.16.003" x-align="PRO.28.16.a003" x-target-ids="t005" x-target="understanding" x-target-head="t005" x-head="true" lemma="תְּבוּנָה" strong="H8394" x-morph="Ncfpa" x-gloss="of.understanding(s)" x-translit="təḇûnôṯ" xml:lang="hbo">תְּ֭בוּנוֹת</char> <char style="w" x-id="WLC.PRO.28.16.004" x-align="PRO.28.16.a004" x-target-ids="t007" x-target="also" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.16.005" x-align="PRO.28.16.a005" x-target-ids="t006 t009" x-target="is great" x-target-head="t009" x-head="true" lemma="רַב" strong="H7227" x-morph="Aamsc" x-gloss="great" x-translit="raḇ" xml:lang="hbo">רַ֥ב</char> <char style="w" x-id="WLC.PRO.28.16.006" x-align="PRO.28.16.a006" x-target-ids="t008 t010" x-target="a oppressor" x-target-head="t010" x-head="true" lemma="מַעֲשַׁקֹּות" strong="H4642" x-morph="Ncfpa" x-gloss="of.extortion(s)" x-translit="maʿăšaqqôṯ" xml:lang="hbo">מַעֲשַׁקּ֑וֹת</char> <char style="w" x-id="WLC.PRO.28.16.007" x-align="PRO.28.16.a008" x-target-ids="t012 t013 t014" x-target="he that hateth" x-target-head="t014" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[one.who].hates" x-translit