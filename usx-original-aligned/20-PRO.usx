	<para style="p"><verse number="23" style="v" x-ref="PRO.20.23" sid="PRO 20:23" /><char style="w" x-id="WLC.PRO.20.23.001" x-align="PRO.20.23.a004" x-target-ids="t003 t004 t005" x-target="are an abomination" x-target-head="t005" x-head="true" lemma="תּוֹעֵבַה" strong="H8441" x-morph="Ncfsc" x-gloss="[are].(the).abomination" x-translit="tôʿăḇaṯ" xml:lang="hbo">תּוֹעֲבַ֣ת</char> <char style="w" x-id="WLC.PRO.20.23.002" x-align="PRO.20.23.a005" x-target-ids="t006 t007" x-target="to Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.20.23.003" x-align="PRO.20.23.a001" x-target-ids="t001 t002" x-target="Diverse weights" x-target-head="t002" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="a.weight" x-translit="ʾeḇen" xml:lang="hbo">אֶ֣בֶן</char> <char style="w" x-id="WLC.PRO.20.23.004" x-align="PRO.20.23.a002" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.PRO.20.23.005" x-align="PRO.20.23.a003" x-status="unrepresented" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="a.weight" x-translit="ʾāḇen" xml:lang="hbo">אָ֑בֶן</char> <char style="w" x-id="WLC.PRO.20.23.006" x-align="PRO.20.23.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.20.23.007" x-align="PRO.20.23.a007" x-target-ids="t009 t011" x-target="a balance" x-target-head="t011" x-head="true" lemma="מֹאזְנַיִם" strong="H3976" x-morph="Ncmdc" x-gloss="balances" x-translit="mōʾzənēy" xml:lang="hbo">מֹאזְנֵ֖י</char> <char style="w" x-id="WLC.PRO.20.23.008" x-align="PRO.20.23.a008" x-target-ids="t010" x-target="false" x-target-head="t010" x-head="true" lemma="מִרְמָה" strong="H4820" x-morph="Ncfsa" x-gl