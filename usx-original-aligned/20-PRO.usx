	<para style="p"><verse number="1" style="v" x-ref="PRO.10.1" sid="PRO 10:1" /><char style="w" x-id="WLC.PRO.10.1.001" x-align="PRO.10.1.a001" x-target-ids="t001 t002" x-target="The proverbs" x-target-head="t002" x-head="true" lemma="מָשָׁל" strong="H4912" x-morph="Ncmpc" x-gloss="the.proverbs" x-translit="mišlēy" xml:lang="hbo">מִשְׁלֵ֗י</char> <char style="w" x-id="WLC.PRO.10.1.002" x-align="PRO.10.1.a002" x-target-ids="t003 t004" x-target="of Solomon" x-target-head="t004" x-head="true" lemma="שְׁלֹמֹה" strong="H8010" x-morph="Np" x-gloss="of.Solomon" x-translit="šəlōmōh" xml:lang="hbo">שְׁלֹ֫מֹ֥ה</char>פ<char style="w" x-id="WLC.PRO.10.1.003" x-align="PRO.10.1.a003" x-target-ids="t005 t007" x-target="A son" x-target-head="t007" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="a.son" x-translit="bēn" xml:lang="hbo">בֵּ֣ן</char> <char style="w" x-id="WLC.PRO.10.1.004" x-align="PRO.10.1.a004" x-target-ids="t006" x-target="wise" x-target-head="t006" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="wise" x-translit="ḥāḵām" xml:lang="hbo">חָ֭כָם</char> <char style="w" x-id="WLC.PRO.10.1.005" x-align="PRO.10.1.a005" x-target-ids="t008 t010" x-target="maketh glad" x-target-head="t010" x-head="true" lemma="שָׂמַח" strong="H8055" x-morph="Vpi3ms" x-gloss="he.makes.glad" x-translit="yəśammaḥ-" xml:lang="hbo">יְשַׂמַּח</char>־<char style="w" x-id="WLC.PRO.10.1.006" x-align="PRO.10.1.a006" x-target-ids="t009 t011" x-target="a father" x-target-head="t011" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsa" x-gloss="a.father" x-translit="ʾāḇ" xml:lang="hbo">אָ֑ב</char> <char style="w" x-id="WLC.PRO.10.1.007" x-align="PRO.10.1.a007" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.1.008" x-align="PRO.10.1.a008" x-target-ids="t013 t015" x-target="a son" x-target-head="t015" x-head="true" lemma="בֵּ