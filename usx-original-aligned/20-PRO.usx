	<para style="p"><verse number="23" style="v" x-ref="PRO.28.23" sid="PRO 28:23" /><char style="w" x-id="WLC.PRO.28.23.001" x-align="PRO.28.23.a001" x-target-ids="t001 t002 t003" x-target="He that rebuketh" x-target-head="t003" x-head="true" lemma="יָכַח" strong="H3198" x-morph="Vhrmsa" x-gloss="[one.who].reproves" x-translit="môḵiyᵃḥ" xml:lang="hbo">מ֘וֹכִ֤יחַ</char> <char style="w" x-id="WLC.PRO.28.23.002" x-align="PRO.28.23.a002" x-target-ids="t004 t005" x-target="a man" x-target-head="t005" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֣ם</char> <char style="w" x-id="WLC.PRO.28.23.003" x-align="PRO.28.23.a003" x-target-ids="t007" x-target="afterward" x-target-head="t007" x-head="true" lemma="אַחַר" strong="H310" x-morph="R" x-gloss="after" x-translit="ʾaḥăray" xml:lang="hbo">אַ֭חֲרַי</char> <char style="w" x-id="WLC.PRO.28.23.004" x-align="PRO.28.23.a006" x-target-ids="t010" x-target="favor" x-target-head="t010" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="favor" x-translit="ḥēn" xml:lang="hbo">חֵ֣ן</char> <char style="w" x-id="WLC.PRO.28.23.005" x-align="PRO.28.23.a004" x-target-ids="t006 t008" x-target="shall find" x-target-head="t008" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqi3ms" x-gloss="he.will.find" x-translit="yimṣāʾ" xml:lang="hbo">יִמְצָ֑א</char> <char style="w" x-id="WLC.PRO.28.23.006" x-align="PRO.28.23.a005" x-target-ids="t009 t011" x-target="more Than" x-target-head="t011" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="mi" xml:lang="hbo">מִֽ</char><char style="w" x-id="WLC.PRO.28.23.007" x-align="PRO.28.23.a007" x-target-ids="t012 t013 t014 t015" x-target="he that flattereth with" x-target-head="t014" x-head="true" lemma="חָלַק" strong="H2505a" x-morph="Vhrmsa" x-gloss="than.[one.who].makes.smooth" x-translit="mmaḥăliyq" xml:lang="hbo">מַּחֲלִ֥יק</char> <char style="w" x-id="WLC.PRO.28.23.008" x-align="PRO.28.23.a00