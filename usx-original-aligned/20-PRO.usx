	<para style="p"><verse number="11" style="v" x-ref="PRO.14.11" sid="PRO 14:11" /><char style="w" x-id="WLC.PRO.14.11.001" x-align="PRO.14.11.a001" x-target-ids="t001 t002" x-target="The house" x-target-head="t002" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="[the].house" x-translit="bēyṯ" xml:lang="hbo">בֵּ֣ית</char> <char style="w" x-id="WLC.PRO.14.11.002" x-align="PRO.14.11.a002" x-target-ids="t003 t004 t005" x-target="of the wicked" x-target-head="t005" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿîm" xml:lang="hbo">רְ֭שָׁעִים</char> <char style="w" x-id="WLC.PRO.14.11.003" x-align="PRO.14.11.a003" x-target-ids="t006 t007 t008" x-target="shall be overthrown" x-target-head="t008" x-head="true" lemma="שָׁמַד" strong="H8045" x-morph="VNi3ms" x-gloss="it.will.be.destroyed" x-translit="yiššāmēḏ" xml:lang="hbo">יִשָּׁמֵ֑ד</char> <char style="w" x-id="WLC.PRO.14.11.004" x-align="PRO.14.11.a004" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.11.005" x-align="PRO.14.11.a005" x-target-ids="t010 t011" x-target="the tent" x-target-head="t011" x-head="true" lemma="אֹהֶל" strong="H168" x-morph="Ncmsc" x-gloss="tent" x-translit="ʾōhel" xml:lang="hbo">אֹ֖הֶל</char> <char style="w" x-id="WLC.PRO.14.11.006" x-align="PRO.14.11.a006" x-target-ids="t012 t013 t014" x-target="of the upright" x-target-head="t014" x-head="true" lemma="יָשָׁר" strong="H3477" x-morph="Aampa" x-gloss="of.upright.[people]" x-translit="yəšāriym" xml:lang="hbo">יְשָׁרִ֣ים</char> <char style="w" x-id="WLC.PRO.14.11.007" x-align="PRO.14.11.a007" x-target-ids="t015 t016" x-target="shall flourish" x-target-head="t016" x-head="true" lemma="פָּרַח" strong="H6524" x-morph="Vhi3ms" x-gloss="it.will.flourish" x-translit="yap̄riyᵃḥ:" xml:lang="hbo">יַפְרִֽיחַ</char>׃<verse eid="PRO 1