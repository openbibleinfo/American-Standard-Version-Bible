	<para style="p"><verse number="3" style="v" x-ref="PRO.27.3" sid="PRO 27:3" /><char style="w" x-id="WLC.PRO.27.3.001" x-align="PRO.27.3.a001" x-target-ids="t003 t004" x-target="is heavy" x-target-head="t004" x-head="true" lemma="כֹּבֶד" strong="H3514" x-morph="Ncmsc" x-gloss="[the].weight" x-translit="kōḇeḏ-" xml:lang="hbo">כֹּֽבֶד</char>־<char style="w" x-id="WLC.PRO.27.3.002" x-align="PRO.27.3.a002" x-target-ids="t001 t002" x-target="A stone" x-target-head="t002" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsa" x-gloss="of.a.stone" x-translit="ʾeḇen" xml:lang="hbo">אֶ֭בֶן</char> <char style="w" x-id="WLC.PRO.27.3.003" x-align="PRO.27.3.a003" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.27.3.004" x-align="PRO.27.3.a004" x-target-ids="t008" x-target="weighty" x-target-head="t008" x-head="true" lemma="נֵטֶל" strong="H5192" x-morph="Ncmsc" x-gloss="the.burden" x-translit="nēṭel" xml:lang="hbo">נֵ֣טֶל</char> <char style="w" x-id="WLC.PRO.27.3.005" x-align="PRO.27.3.a005" x-target-ids="t006" x-target="the" x-target-head="t006" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="of.(the)" x-translit="ha" xml:lang="hbo">הַ</char><char style="w" x-id="WLC.PRO.27.3.006" x-align="PRO.27.3.a006" x-target-ids="t007" x-target="sand" x-target-head="t007" x-head="true" lemma="חוֹל" strong="H2344" x-morph="Ncmsa" x-gloss="sand" x-translit="ḥôl" xml:lang="hbo">ח֑וֹל</char> <char style="w" x-id="WLC.PRO.27.3.007" x-align="PRO.27.3.a007" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.27.3.008" x-align="PRO.27.3.a008" x-target-ids="t012" x-target="vexation" x-target-head="t012" x-head="true" lemma="כַּעַס" strong="H3708" x-morph="Ncmsc" x-gloss="provocation" x-translit="