	<para style="p"><verse number="18" style="v" x-ref="PRO.29.18" sid="PRO 29:18" /><char style="w" x-id="WLC.PRO.29.18.001" x-align="PRO.29.18.a001" x-target-ids="t001" x-target="Where" x-target-head="t001" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="when" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.29.18.002" x-align="PRO.29.18.a002" x-target-ids="t002 t003 t004" x-target="there is no" x-target-head="t004" x-head="true" lemma="אַיִן" strong="H369" x-morph="Tn" x-gloss="there.[is].not" x-translit="ʾēyn" xml:lang="hbo">אֵ֣ין</char> <char style="w" x-id="WLC.PRO.29.18.003" x-align="PRO.29.18.a003" x-target-ids="t005" x-target="vision" x-target-head="t005" x-head="true" lemma="חָזוֹן" strong="H2377" x-morph="Ncmsa" x-gloss="vision" x-translit="ḥāzôn" xml:lang="hbo">חָ֭זוֹן</char> <char style="w" x-id="WLC.PRO.29.18.004" x-align="PRO.29.18.a004" x-target-ids="t008 t009 t010" x-target="cast off restraint" x-target-head="t010" x-head="true" lemma="פָּרַע" strong="H6544" x-morph="VNi3ms" x-gloss="it.is.let.loose" x-translit="yippāraʿ" xml:lang="hbo">יִפָּ֣רַֽע</char> <char style="w" x-id="WLC.PRO.29.18.005" x-align="PRO.29.18.a005" x-target-ids="t006 t007" x-target="the people" x-target-head="t007" x-head="true" lemma="עַם" strong="H5971" x-morph="Ncmsa" x-gloss="a.people" x-translit="ʿām" xml:lang="hbo">עָ֑ם</char> <char style="w" x-id="WLC.PRO.29.18.006" x-align="PRO.29.18.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.29.18.007" x-align="PRO.29.18.a007" x-target-ids="t012 t013 t014" x-target="he that keepeth" x-target-head="t014" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmsa" x-gloss="[one.who].keeps" x-translit="šōmēr" xml:lang="hbo">שֹׁמֵ֖ר</char> <char style="w" x-id="WLC.PRO.29.18.008" x-align="PRO.29.18.a008" x-target-ids="t015 t016" x-target="the law" x-targ