	<para style="p"><verse number="16" style="v" x-ref="PRO.10.16" sid="PRO 10:16" /><char style="w" x-id="WLC.PRO.10.16.001" x-align="PRO.10.16.a001" x-target-ids="t001 t002" x-target="The labor" x-target-head="t002" x-head="true" lemma="פְּעֻלָּה" strong="H6468" x-morph="Ncfsc" x-gloss="[the].wage[s]" x-translit="pəʿullaṯ" xml:lang="hbo">פְּעֻלַּ֣ת</char> <char style="w" x-id="WLC.PRO.10.16.002" x-align="PRO.10.16.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֣יק</char> <char style="w" x-id="WLC.PRO.10.16.003" x-align="PRO.10.16.a003" x-target-ids="t006 t007" x-target="tendeth to" x-target-italic-ids="t006" x-target-head="t007" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].(to)" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.10.16.004" x-align="PRO.10.16.a004" x-target-ids="t008" x-target="life" x-target-head="t008" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.10.16.005" x-align="PRO.10.16.a005" x-target-ids="t009 t010" x-target="The increase" x-target-head="t010" x-head="true" lemma="תְּבוּאָה" strong="H8393" x-morph="Ncfsc" x-gloss="[the].yield" x-translit="təḇûʾaṯ" xml:lang="hbo">תְּבוּאַ֖ת</char> <char style="w" x-id="WLC.PRO.10.16.006" x-align="PRO.10.16.a006" x-target-ids="t011 t012 t013" x-target="of the wicked" x-target-head="t013" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="of.[the].wicked" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֣ע</char> <char style="w" x-id="WLC.PRO.10.16.007" x-align="PRO.10.16.a007" x-target-ids="t014" x-target="to" x-target-head="t014" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].(to)" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.10.16.008" x-al