	<para style="p"><verse number="2" style="v" x-ref="PRO.27.2" sid="PRO 27:2" /><char style="w" x-id="WLC.PRO.27.2.001" x-align="PRO.27.2.a001" x-target-ids="t001 t004" x-target="Let praise" x-target-head="t004" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpj3ms" x-gloss="let" x-translit="yəhallel" xml:lang="hbo">יְהַלֶּלְ</char><char style="w" x-id="WLC.PRO.27.2.002" x-align="PRO.27.2.a002" x-target-ids="t005" x-target="thee" x-target-head="t005" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="him.praise.you" x-translit="əḵā" xml:lang="hbo">ךָ֣</char> <char style="w" x-id="WLC.PRO.27.2.003" x-align="PRO.27.2.a003" x-target-ids="t002 t003" x-target="another man" x-target-head="t002" x-head="true" lemma="זָר" strong="H2114b" x-morph="Aamsa" x-gloss="a.stranger" x-translit="zār" xml:lang="hbo">זָ֣ר</char> <char style="w" x-id="WLC.PRO.27.2.004" x-align="PRO.27.2.a004" x-target-ids="t006" x-target="and" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.27.2.005" x-align="PRO.27.2.a005" x-target-ids="t007" x-target="not" x-target-head="t007" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹא</char>־<char style="w" x-id="WLC.PRO.27.2.006" x-align="PRO.27.2.a006" x-target-ids="t010" x-target="mouth" x-target-head="t010" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄iy" xml:lang="hbo">פִ֑י</char><char style="w" x-id="WLC.PRO.27.2.007" x-align="PRO.27.2.a007" x-target-ids="t008 t009" x-target="thine own" x-target-head="t008" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your.own" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.27.2.008" x-align="PRO.27.2.a008" x-target-ids="t011 t012" x-target="A stranger" x-target-head="t012" x-head="true" lemma="נׇכְרִי" strong="H5237" x-morph="Aamsa" x-gloss="a.fore