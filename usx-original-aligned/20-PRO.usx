	<para style="p"><verse number="1" style="v" x-ref="PRO.18.1" x-added-alignments="PRO.18.1.a003 PRO.18.1.a006" x-added-target-ids="t006 t007 t009" x-added-target="his own | And" sid="PRO 18:1" /><char style="w" x-id="WLC.PRO.18.1.001" x-align="PRO.18.1.a005" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(to)" x-translit="lə" xml:lang="hbo">לְֽ֭</char><char style="w" x-id="WLC.PRO.18.1.002" x-align="PRO.18.1.a004" x-target-ids="t008" x-target="desire" x-target-head="t008" x-head="true" lemma="תַּאֲוָה" strong="H8378" x-morph="Ncfsa" x-gloss="desire" x-translit="ṯaʾăwâ" xml:lang="hbo">תַאֲוָה</char> <char style="w" x-id="WLC.PRO.18.1.003" x-align="PRO.18.1.a002" x-target-ids="t005" x-target="seeketh" x-target-head="t005" x-head="true" lemma="בָּקַשׁ" strong="H1245" x-morph="Vpi3ms" x-gloss="he.seeks" x-translit="yəḇaqqēš" xml:lang="hbo">יְבַקֵּ֣שׁ</char> <char style="w" x-id="WLC.PRO.18.1.004" x-align="PRO.18.1.a001" x-target-ids="t001 t002 t003 t004" x-target="He that separateth himself" x-target-head="t003" x-head="true" lemma="פָּרַד" strong="H6504" x-morph="VNrmsa" x-gloss="[one.who].separates.himself" x-translit="nip̄rāḏ" xml:lang="hbo">נִפְרָ֑ד</char> <char style="w" x-id="WLC.PRO.18.1.005" x-align="PRO.18.1.a008" x-target-ids="t011" x-target="against" x-target-head="t011" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="on" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.18.1.006" x-align="PRO.18.1.a009" x-target-ids="t012" x-target="all" x-target-head="t012" x-head="true" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.18.1.007" x-align="PRO.18.1.a010" x-target-ids="t013 t014" x-target="sound wisdom" x-target-head="t013" x-head="true" lemma="תּוּשִׁיָּה" strong="H8454" x-morph="Ncfsa" x-gloss="sound.wisdom" x-translit="tûšiyyāh" xml:lang="hbo">תּ֝וּשִׁיָּ֗ה</char> <char style="w" x-id="WLC.PRO.18.1.008