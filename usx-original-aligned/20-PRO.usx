	<para style="p"><verse number="17" style="v" x-ref="PRO.25.17" sid="PRO 25:17" /><char style="w" x-id="WLC.PRO.25.17.001" x-align="PRO.25.17.a001" x-target-ids="t001 t004 t005" x-target="Let be seldom" x-target-head="t005" x-head="true" lemma="יָקַר" strong="H3365" x-morph="Vhv2ms" x-gloss="make.precious" x-translit="hōqar" xml:lang="hbo">הֹקַ֣ר</char> <char style="w" x-id="WLC.PRO.25.17.002" x-align="PRO.25.17.a003" x-target-ids="t003" x-target="foot" x-target-head="t003" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfsc" x-gloss="foot" x-translit="raḡl" xml:lang="hbo">רַ֭גְלְ</char><char style="w" x-id="WLC.PRO.25.17.003" x-align="PRO.25.17.a002" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="əḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.25.17.004" x-align="PRO.25.17.a004" x-target-ids="t006" x-target="in" x-target-head="t006" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.25.17.005" x-align="PRO.25.17.a007" x-target-ids="t009" x-target="house" x-target-head="t009" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="the.house" x-translit="bēyṯ" xml:lang="hbo">בֵּ֣ית</char> <char style="w" x-id="WLC.PRO.25.17.006" x-align="PRO.25.17.a006" x-target-ids="t008" x-target="neighbor’s" x-target-head="t008" x-head="true" lemma="רֵעַ" strong="H7453" x-morph="Ncmsc" x-gloss="your.neighbor" x-translit="rēʿ" xml:lang="hbo">רֵעֶ֑</char><char style="w" x-id="WLC.PRO.25.17.007" x-align="PRO.25.17.a005" x-target-ids="t007" x-target="thy" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.25.17.008" x-align="PRO.25.17.a008" x-target-ids="t010" x-target="Lest" x-target-head="t010" x-head="true" lemma="פֶּן" strong="H6435" x-morph="C" x-gloss="les