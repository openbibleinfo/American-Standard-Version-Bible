	<para style="p"><verse number="29" style="v" x-ref="PRO.11.29" sid="PRO 11:29" /><char style="w" x-id="WLC.PRO.11.29.001" x-align="PRO.11.29.a001" x-target-ids="t001 t002 t003" x-target="He that troubleth" x-target-head="t003" x-head="true" lemma="עָכַר" strong="H5916" x-morph="Vqrmsa" x-gloss="[one.who].troubles" x-translit="ʿôḵēr" xml:lang="hbo">עוֹכֵ֣ר</char> <char style="w" x-id="WLC.PRO.11.29.002" x-align="PRO.11.29.a002" x-target-ids="t006" x-target="house" x-target-head="t006" x-head="true" lemma="בַּיִת" strong="H1004" x-morph="Ncmsc" x-gloss="household" x-translit="bēyṯ" xml:lang="hbo">בֵּ֭ית</char><char style="w" x-id="WLC.PRO.11.29.003" x-align="PRO.11.29.a003" x-target-ids="t004 t005" x-target="his own" x-target-head="t004" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.11.29.004" x-align="PRO.11.29.a004" x-target-ids="t007 t008" x-target="shall inherit" x-target-head="t008" x-head="true" lemma="נָחַל" strong="H5157" x-morph="Vqi3ms" x-gloss="he.will.inherit" x-translit="yinḥal-" xml:lang="hbo">יִנְחַל</char>־<char style="w" x-id="WLC.PRO.11.29.005" x-align="PRO.11.29.a005" x-target-ids="t009 t010" x-target="the wind" x-target-head="t010" x-head="true" lemma="רוּחַ" strong="H7307" x-morph="Ncbsa" x-gloss="wind" x-translit="rûᵃḥ" xml:lang="hbo">ר֑וּחַ</char> <char style="w" x-id="WLC.PRO.11.29.006" x-align="PRO.11.29.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.11.29.007" x-align="PRO.11.29.a007" x-target-ids="t014 t015 t016" x-target="shall be servant" x-target-head="t016" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsa" x-gloss="[will.be].a.servant" x-translit="ʿeḇeḏ" xml:lang="hbo">עֶ֥בֶד</char> <char style="w" x-id="WLC.PRO.11.29.008" x-align="PRO.11.29.a008" x-target-ids="t012 t013" x-target="t