	<para style="p"><verse number="3" style="v" x-ref="PRO.10.3" sid="PRO 10:3" /><char style="w" x-id="WLC.PRO.10.3.001" x-align="PRO.10.3.a001" x-target-ids="t003" x-target="not" x-target-head="t003" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.10.3.002" x-align="PRO.10.3.a002" x-target-ids="t002 t004 t010 t011" x-target="will suffer to famish" x-target-head="t011" x-head="true" lemma="רָעֵב" strong="H7456" x-morph="Vhi3ms" x-gloss="he.allows.to.hunger" x-translit="yarʿiyḇ" xml:lang="hbo">יַרְעִ֣יב</char> <char style="w" x-id="WLC.PRO.10.3.003" x-align="PRO.10.3.a003" x-target-ids="t001" x-target="Jehovah" x-target-head="t001" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.10.3.004" x-align="PRO.10.3.a004" x-target-ids="t005 t006" x-target="the soul" x-target-head="t006" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsc" x-gloss="[the].appetite" x-translit="nep̄eš" xml:lang="hbo">נֶ֣פֶשׁ</char> <char style="w" x-id="WLC.PRO.10.3.005" x-align="PRO.10.3.a005" x-target-ids="t007 t008 t009" x-target="of the righteous" x-target-head="t009" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.[the].righteous" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PRO.10.3.006" x-align="PRO.10.3.a006" x-target-ids="t012" x-target="But" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.10.3.007" x-align="PRO.10.3.a007" x-target-ids="t016 t017" x-target="the desire" x-target-head="t017" x-head="true" lemma="הַוָּה" strong="H1942" x-morph="Ncfsc" x-gloss="desire" x-translit="hawwaṯ" xml:lang="hbo">הַוַּ֖ת</char> <char style="w" x-id="WLC.PRO.10.3.008" x-align="PRO.10.3.a008" x-target-ids="t018 t019 t020" x-target="of