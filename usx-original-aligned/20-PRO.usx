	<para style="p"><verse number="29" style="v" x-ref="PRO.20.29" sid="PRO 20:29" /><char style="w" x-id="WLC.PRO.20.29.001" x-align="PRO.20.29.a001" x-target-ids="t001 t002" x-target="The glory" x-target-head="t002" x-head="true" lemma="תִּפְאֶרֶת" strong="H8597" x-morph="Ncfsc" x-gloss="[the].glory" x-translit="tip̄ʾereṯ" xml:lang="hbo">תִּפְאֶ֣רֶת</char> <char style="w" x-id="WLC.PRO.20.29.002" x-align="PRO.20.29.a002" x-target-ids="t003 t004 t005" x-target="of young men" x-target-head="t005" x-head="true" lemma="בָּחוּר" strong="H970" x-morph="Ncmpa" x-gloss="of.young.men" x-translit="baḥûriym" xml:lang="hbo">בַּחוּרִ֣ים</char> <char style="w" x-id="WLC.PRO.20.29.003" x-align="PRO.20.29.a003" x-target-ids="t006 t008" x-target="is strength" x-target-head="t008" x-head="true" lemma="כֹּחַ" strong="H3581" x-morph="Ncmsc" x-gloss="strength" x-translit="kōḥ" xml:lang="hbo">כֹּחָ֑</char><char style="w" x-id="WLC.PRO.20.29.004" x-align="PRO.20.29.a004" x-target-ids="t007" x-target="their" x-target-head="t007" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="[is].their" x-translit="ām" xml:lang="hbo">ם</char> <char style="w" x-id="WLC.PRO.20.29.005" x-align="PRO.20.29.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.PRO.20.29.006" x-align="PRO.20.29.a006" x-target-ids="t010 t011" x-target="the beauty" x-target-head="t011" x-head="true" lemma="הָדָר" strong="H1926" x-morph="Ncmsc" x-gloss="splendor" x-translit="hăḏar" xml:lang="hbo">הֲדַ֖ר</char> <char style="w" x-id="WLC.PRO.20.29.007" x-align="PRO.20.29.a007" x-target-ids="t012 t013 t014" x-target="of old men" x-target-head="t014" x-head="true" lemma="זָקֵן" strong="H2205" x-morph="Aampa" x-gloss="of.old.[people]" x-translit="zəqēniym" xml:lang="hbo">זְקֵנִ֣ים</char> <char style="w" x-id="WLC.PRO.20.29.008" x-align="PRO.20.29.a008" x-target-ids="t015 t0