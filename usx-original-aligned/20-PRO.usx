	<para style="p"><verse number="5" style="v" x-ref="PRO.13.5" sid="PRO 13:5" /><char style="w" x-id="WLC.PRO.13.5.001" x-align="PRO.13.5.a001" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="a.word" x-translit="dəḇar-" xml:lang="hbo">דְּבַר</char>־<char style="w" x-id="WLC.PRO.13.5.002" x-align="PRO.13.5.a001" x-target-ids="t005" x-target="lying" x-target-head="t005" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šeqer" xml:lang="hbo">שֶׁ֭קֶר</char> <char style="w" x-id="WLC.PRO.13.5.003" x-align="PRO.13.5.a002" x-target-ids="t004" x-target="hateth" x-target-head="t004" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqi3ms" x-gloss="he.hates" x-translit="yiśnāʾ" xml:lang="hbo">יִשְׂנָ֣א</char> <char style="w" x-id="WLC.PRO.13.5.004" x-align="PRO.13.5.a003" x-target-ids="t001 t002 t003" x-target="A righteous man" x-target-head="t002" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="a.righteous.[person]" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PRO.13.5.005" x-align="PRO.13.5.a004" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.13.5.006" x-align="PRO.13.5.a005" x-target-ids="t007 t008 t009" x-target="a wicked man" x-target-head="t008" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="a.wicked.[person]" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֗ע</char> <char style="w" x-id="WLC.PRO.13.5.007" x-align="PRO.13.5.a006" x-target-ids="t010 t011" x-target="is loathsome" x-target-head="t011" x-head="true" lemma="בָּאַשׁ" strong="H887" x-morph="Vhi3ms" x-gloss="he.acts.odiously" x-translit="yaḇʾiyš" xml:lang="hbo">יַבְאִ֥ישׁ</char> <char style="w" x-id="WLC.PRO.13.5.008" x-align="PRO.13.5.a007" x-target-ids="t012" x-target="and" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="