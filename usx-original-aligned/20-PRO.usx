	<para style="p"><verse number="20" style="v" x-ref="PRO.16.20" sid="PRO 16:20" /><char style="w" x-id="WLC.PRO.16.20.001" x-align="PRO.16.20.a001" x-target-ids="t001 t002 t003 t004" x-target="He that giveth heed" x-target-head="t004" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vhrmsa" x-gloss="[one.who].gives.attention" x-translit="maśkiyl" xml:lang="hbo">מַשְׂכִּ֣יל</char> <char style="w" x-id="WLC.PRO.16.20.002" x-align="PRO.16.20.a002" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.16.20.003" x-align="PRO.16.20.a003" x-target-ids="t006 t007" x-target="the word" x-target-head="t007" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsa" x-gloss="a.word" x-translit="dāḇār" xml:lang="hbo">דָּ֭בָר</char> <char style="w" x-id="WLC.PRO.16.20.004" x-align="PRO.16.20.a004" x-target-ids="t008 t009" x-target="shall find" x-target-head="t009" x-head="true" lemma="מָצָא" strong="H4672" x-morph="Vqi3ms" x-gloss="he.finds" x-translit="yimṣāʾ-" xml:lang="hbo">יִמְצָא</char>־<char style="w" x-id="WLC.PRO.16.20.005" x-align="PRO.16.20.a005" x-target-ids="t010" x-target="good" x-target-head="t010" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PRO.16.20.006" x-align="PRO.16.20.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.16.20.007" x-align="PRO.16.20.a007" x-target-ids="t012 t013" x-target="whoso trusteth" x-target-head="t013" x-head="true" lemma="בָּטַח" strong="H982" x-morph="Vqrmsa" x-gloss="[one.who].trusts" x-translit="ḇôṭēᵃḥ" xml:lang="hbo">בוֹטֵ֖חַ</char> <char style="w" x-id="WLC.PRO.16.20.008" x-align="PRO.16.20.a008" x-target-ids="t014" x-target="in" x-target-head