	<para style="p"><verse number="11" style="v" x-ref="PRO.13.11" x-added-alignments="PRO.13.11.a002" x-added-target-ids="t002" x-added-target="gotten" sid="PRO 13:11" /><char style="w" x-id="WLC.PRO.13.11.001" x-align="PRO.13.11.a001" x-target-ids="t001" x-target="Wealth" x-target-head="t001" x-head="true" lemma="הוֹן" strong="H1952" x-morph="Ncmsa" x-gloss="wealth" x-translit="hôn" xml:lang="hbo">ה֭וֹן</char> <char style="w" x-id="WLC.PRO.13.11.002" x-align="PRO.13.11.a003" x-target-ids="t003" x-target="by" x-target-head="t003" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.13.11.003" x-align="PRO.13.11.a004" x-target-ids="t004" x-target="vanity" x-target-head="t004" x-head="true" lemma="הֶבֶל" strong="H1892" x-morph="Ncmsa" x-gloss="vanity" x-translit="heḇel" xml:lang="hbo">הֶ֣בֶל</char> <char style="w" x-id="WLC.PRO.13.11.004" x-align="PRO.13.11.a005" x-target-ids="t005 t006 t007" x-target="shall be diminished" x-target-head="t007" x-head="true" lemma="מָעַט" strong="H4591" x-morph="Vqi3ms" x-gloss="it.will.become.small" x-translit="yimʿāṭ" xml:lang="hbo">יִמְעָ֑ט</char> <char style="w" x-id="WLC.PRO.13.11.005" x-align="PRO.13.11.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.13.11.006" x-align="PRO.13.11.a007" x-target-ids="t009 t010 t011" x-target="he that gathereth" x-target-head="t011" x-head="true" lemma="קָבַץ" strong="H6908" x-morph="Vqrmsa" x-gloss="[one.who].gathers" x-translit="qōḇēṣ" xml:lang="hbo">קֹבֵ֖ץ</char> <char style="w" x-id="WLC.PRO.13.11.007" x-align="PRO.13.11.a008" x-target-ids="t012" x-target="by" x-target-head="t012" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.PRO.13.11.008" x-align="PRO.13.11.a009" x-target-id