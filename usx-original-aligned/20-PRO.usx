	<para style="p"><verse number="13" style="v" x-ref="PRO.14.13" sid="PRO 14:13" /><char style="w" x-id="WLC.PRO.14.13.001" x-align="PRO.14.13.a001" x-target-ids="t001" x-target="Even" x-target-head="t001" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="also" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.PRO.14.13.002" x-align="PRO.14.13.a002" x-target-ids="t002" x-target="in" x-target-head="t002" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bi" xml:lang="hbo">בִּ</char><char style="w" x-id="WLC.PRO.14.13.003" x-align="PRO.14.13.a003" x-target-ids="t003" x-target="laughter" x-target-head="t003" x-head="true" lemma="שְׂחֹוק" strong="H7814" x-morph="Ncmsa" x-gloss="laughter" x-translit="śəḥôq" xml:lang="hbo">שְׂח֥וֹק</char> <char style="w" x-id="WLC.PRO.14.13.004" x-align="PRO.14.13.a004" x-target-ids="t006 t007" x-target="is sorrowful" x-target-head="t007" x-head="true" lemma="כָּאַב" strong="H3510" x-morph="Vqi3ms" x-gloss="it.is.in.pain" x-translit="yiḵʾaḇ-" xml:lang="hbo">יִכְאַב</char>־<char style="w" x-id="WLC.PRO.14.13.005" x-align="PRO.14.13.a005" x-target-ids="t004 t005" x-target="the heart" x-target-head="t005" x-head="true" lemma="לֵב" strong="H3820" x-morph="Ncmsa" x-gloss="a.heart" x-translit="lēḇ" xml:lang="hbo">לֵ֑ב</char> <char style="w" x-id="WLC.PRO.14.13.006" x-align="PRO.14.13.a006" x-target-ids="t008" x-target="And" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.13.007" x-align="PRO.14.13.a007" x-target-ids="t009 t010" x-target="the end" x-target-head="t010" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="end" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִיתָ֖</char><char style="w" x-id="WLC.PRO.14.13.008" x-align="PRO.14.13.a008" x-status="unrepresented" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="its" x-translit="āhh" x