	<para style="p"><verse number="25" style="v" x-ref="PRO.8.25" sid="PRO 8:25" /><char style="w" x-id="WLC.PRO.8.25.001" x-align="PRO.8.25.a001" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="before" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.8.25.002" x-align="PRO.8.25.a001" x-target-ids="t001" x-target="Before" x-target-head="t001" x-head="true" lemma="טֶרֶם" strong="H2962" x-morph="D" x-translit="ṭerem" xml:lang="hbo">טֶ֣רֶם</char> <char style="w" x-id="WLC.PRO.8.25.003" x-align="PRO.8.25.a002" x-target-ids="t002 t003" x-target="the mountains" x-target-head="t003" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpa" x-gloss="mountains" x-translit="hāriym" xml:lang="hbo">הָרִ֣ים</char> <char style="w" x-id="WLC.PRO.8.25.004" x-align="PRO.8.25.a003" x-target-ids="t004 t005" x-target="were settled" x-target-head="t005" x-head="true" lemma="טָבַע" strong="H2883" x-morph="VHp3cp" x-gloss="they.were.planted" x-translit="hoṭbāʿû" xml:lang="hbo">הָטְבָּ֑עוּ</char> <char style="w" x-id="WLC.PRO.8.25.005" x-align="PRO.8.25.a004" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="before" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.8.25.006" x-align="PRO.8.25.a004" x-target-ids="t006" x-target="Before" x-target-head="t006" x-head="true" lemma="פָּנֶה" strong="H6440" x-morph="Ncbpc" x-translit="p̄ənēy" xml:lang="hbo">פְנֵ֖י</char> <char style="w" x-id="WLC.PRO.8.25.007" x-align="PRO.8.25.a005" x-target-ids="t007 t008" x-target="the hills" x-target-head="t008" x-head="true" lemma="גִּבְעָה" strong="H1389" x-morph="Ncfpa" x-gloss="[the].hills" x-translit="ḡəḇāʿôṯ" xml:lang="hbo">גְבָע֣וֹת</char> <char style="w" x-id="WLC.PRO.8.25.008" x-align="PRO.8.25.a006" x-target-ids="t009 t010 t011 t012" x-target="was I brought forth" x-target-head="t011" x-head="true" lemma="חיל" strong="H2342a" x-morph="VOp1cs" x-gloss="I.was.brought.forth" x-translit="ḥôlālətî:" xml:lang="hbo">חוֹלָֽלְתִּי</char>׃<verse eid="PRO 8:25" /></para>
