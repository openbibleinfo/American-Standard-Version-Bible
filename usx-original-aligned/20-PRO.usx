	<para style="p"><verse number="23" style="v" x-ref="PRO.11.23" x-added-alignments="PRO.11.23.a005" x-added-target-ids="t009" x-added-target="But" sid="PRO 11:23" /><char style="w" x-id="WLC.PRO.11.23.001" x-align="PRO.11.23.a001" x-target-ids="t001 t002" x-target="The desire" x-target-head="t002" x-head="true" lemma="תַּאֲוָה" strong="H8378" x-morph="Ncfsc" x-gloss="[the].desire" x-translit="taʾăwaṯ" xml:lang="hbo">תַּאֲוַ֣ת</char> <char style="w" x-id="WLC.PRO.11.23.002" x-align="PRO.11.23.a002" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aampa" x-gloss="of.righteous.[people]" x-translit="ṣaddîqiym" xml:lang="hbo">צַדִּיקִ֣ים</char> <char style="w" x-id="WLC.PRO.11.23.003" x-align="PRO.11.23.a003" x-target-ids="t007" x-target="only" x-target-head="t007" x-head="true" lemma="אַךְ" strong="H389" x-morph="Ta" x-gloss="only" x-translit="ʾaḵ-" xml:lang="hbo">אַךְ</char>־<char style="w" x-id="WLC.PRO.11.23.004" x-align="PRO.11.23.a004" x-target-ids="t006 t008" x-target="is good" x-target-head="t008" x-head="true" lemma="טוֹב" strong="H2896" x-morph="Aamsa" x-gloss="[is].good" x-translit="ṭôḇ" xml:lang="hbo">ט֑וֹב</char> <char style="w" x-id="WLC.PRO.11.23.005" x-align="PRO.11.23.a006" x-target-ids="t010 t011" x-target="the expectation" x-target-head="t011" x-head="true" lemma="תִּקְוָה" strong="H8615" x-morph="Ncfsc" x-gloss="[the].hope" x-translit="tiqwaṯ" xml:lang="hbo">תִּקְוַ֖ת</char> <char style="w" x-id="WLC.PRO.11.23.006" x-align="PRO.11.23.a007" x-target-ids="t012 t013 t014" x-target="of the wicked" x-target-head="t014" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aampa" x-gloss="of.wicked.[people]" x-translit="rəšāʿiym" xml:lang="hbo">רְשָׁעִ֣ים</char> <char style="w" x-id="WLC.PRO.11.23.007" x-align="PRO.11.23.a008" x-target-ids="t015 t016" x-target="is wrath" x-target-head="t016" x-head="true" lemma="עֶבְרָה" strong="H5678" x-morph="Ncfsa" x-gloss="[is].fury" x-tr