	<para style="p"><verse number="17" style="v" x-ref="PRO.28.17" x-added-alignments="PRO.28.17.a011" x-added-target-ids="t019" x-added-target="man" sid="PRO 28:17" /><char style="w" x-id="WLC.PRO.28.17.001" x-align="PRO.28.17.a001" x-target-ids="t001 t002" x-target="A man" x-target-head="t002" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="a.person" x-translit="ʾāḏām" xml:lang="hbo">אָ֭דָם</char> <char style="w" x-id="WLC.PRO.28.17.002" x-align="PRO.28.17.a002" x-target-ids="t003 t004 t005" x-target="that is laden" x-target-head="t005" x-head="true" lemma="עָשַׁק" strong="H6231" x-morph="Vqsmsa" x-gloss="oppressed" x-translit="ʿāšuq" xml:lang="hbo">עָשֻׁ֣ק</char> <char style="w" x-id="WLC.PRO.28.17.003" x-align="PRO.28.17.a003" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by.[the]" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.28.17.004" x-align="PRO.28.17.a004" x-target-ids="t007 t008" x-target="the blood" x-target-head="t008" x-head="true" lemma="דָּם" strong="H1818" x-morph="Ncmsc" x-gloss="blood" x-translit="ḏam-" xml:lang="hbo">דַם</char>־<char style="w" x-id="WLC.PRO.28.17.005" x-align="PRO.28.17.a005" x-target-ids="t009 t010 t011" x-target="of any person" x-target-head="t011" x-head="true" lemma="נֶפֶשׁ" strong="H5315" x-morph="Ncbsa" x-gloss="of.a.person" x-translit="nāp̄eš" xml:lang="hbo">נָפֶשׁ</char><char style="w" x-id="WLC.PRO.28.17.006" x-align="PRO.28.17.a007" x-target-ids="t014" x-target="unto" x-target-head="t014" x-head="true" lemma="עַד" strong="H5704" x-morph="R" x-gloss="to" x-translit="ʿaḏ-" xml:lang="hbo">עַד</char>־<char style="w" x-id="WLC.PRO.28.17.007" x-align="PRO.28.17.a008" x-target-ids="t015 t016" x-target="the pit" x-target-head="t016" x-head="true" lemma="בּוֹר" strong="H953" x-morph="Ncmsa" x-gloss="[the].pit" x-translit="bôr" xml:lang="hbo">בּ֥וֹר</char> <char style="w" x-id="WLC.PRO.28.17.008" x-align="PRO.28.17.a0