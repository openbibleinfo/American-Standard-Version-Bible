	<para style="p"><verse number="21" style="v" x-ref="PRO.29.21" sid="PRO 29:21" /><char style="w" x-id="WLC.PRO.29.21.001" x-align="PRO.29.21.a001" x-target-ids="t001 t002 t003 t004 t005" x-target="He that delicately bringeth up" x-target-head="t003" x-head="true" lemma="פָּנַק" strong="H6445" x-morph="Vprmsa" x-gloss="[one.who].pampers" x-translit="məp̄annēq" xml:lang="hbo">מְפַנֵּ֣ק</char> <char style="w" x-id="WLC.PRO.29.21.002" x-align="PRO.29.21.a002" x-target-ids="t008" x-target="from" x-target-head="t008" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="from" x-translit="mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.29.21.003" x-align="PRO.29.21.a003" x-target-ids="t009 t010" x-target="a child" x-target-head="t010" x-head="true" lemma="נֹעַר" strong="H5290" x-morph="Ncmsa" x-gloss="youth" x-translit="nnōʿar" xml:lang="hbo">נֹּ֣עַר</char> <char style="w" x-id="WLC.PRO.29.21.004" x-align="PRO.29.21.a004" x-target-ids="t007" x-target="servant" x-target-head="t007" x-head="true" lemma="עֶבֶד" strong="H5650" x-morph="Ncmsc" x-gloss="slave" x-translit="ʿaḇd" xml:lang="hbo">עַבְדּ֑</char><char style="w" x-id="WLC.PRO.29.21.005" x-align="PRO.29.21.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.29.21.006" x-align="PRO.29.21.a006" x-status="unrepresented" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.29.21.007" x-align="PRO.29.21.a007" x-target-ids="t017 t018 t019" x-target="at the last" x-target-head="t019" x-head="true" lemma="אַחֲרִית" strong="H319" x-morph="Ncfsc" x-gloss="end" x-translit="ʾaḥăriyṯ" xml:lang="hbo">אַחֲרִית֗</char><char style="w" x-id="WLC.PRO.29.21.008" x-align="PRO.29.21.a008" x-target-ids="t013" x-target="him" x-target-head="t013" x-head="true" lemma="הוּא" strong="H2050c" x-m