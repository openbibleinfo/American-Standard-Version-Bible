	<para style="p"><verse number="9" style="v" x-ref="PRO.1.9" sid="PRO 1:9" /><char style="w" x-id="WLC.PRO.1.9.001" x-align="PRO.1.9.a001" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy" xml:lang="hbo">כִּ֤י</char>׀<char style="w" x-id="WLC.PRO.1.9.002" x-align="PRO.1.9.a003" x-target-ids="t003 t004 t005 t006" x-target="shall be a chaplet" x-target-head="t006" x-head="true" lemma="לִוְיָה" strong="H3880" x-morph="Ncfsc" x-gloss="[will.be].a.wreath" x-translit="liwyaṯ" xml:lang="hbo">לִוְיַ֤ת</char> <char style="w" x-id="WLC.PRO.1.9.003" x-align="PRO.1.9.a004" x-target-ids="t007 t008" x-target="of grace" x-target-head="t008" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="of.grace" x-translit="ḥēn" xml:lang="hbo">חֵ֓ן</char> <char style="w" x-id="WLC.PRO.1.9.004" x-align="PRO.1.9.a002" x-target-ids="t002" x-target="they" x-target-head="t002" x-head="true" lemma="הֵם" strong="H1992" x-morph="Pp3mp" x-gloss="they" x-translit="hēm" xml:lang="hbo">הֵ֬ם</char> <char style="w" x-id="WLC.PRO.1.9.005" x-align="PRO.1.9.a005" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.1.9.006" x-align="PRO.1.9.a006" x-target-ids="t011" x-target="head" x-target-head="t011" x-head="true" lemma="רֹאשׁ" strong="H7218" x-morph="Ncmsc" x-gloss="head" x-translit="rōʾš" xml:lang="hbo">רֹאשֶׁ֑</char><char style="w" x-id="WLC.PRO.1.9.007" x-align="PRO.1.9.a007" x-target-ids="t010" x-target="thy" x-target-head="t010" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="eḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.1.9.008" x-align="PRO.1.9.a008" x-target-ids="t012" x-target="And" x-target-head="t012" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝