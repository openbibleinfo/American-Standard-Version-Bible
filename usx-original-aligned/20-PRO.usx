	<para style="p"><verse number="22" style="v" x-ref="PRO.20.22" sid="PRO 20:22" /><char style="w" x-id="WLC.PRO.20.22.001" x-align="PRO.20.22.a002" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.20.22.002" x-align="PRO.20.22.a001" x-target-ids="t001 t003" x-target="Say thou" x-target-head="t001" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqj2ms" x-gloss="say" x-translit="tōʾmar" xml:lang="hbo">תֹּאמַ֥ר</char> <char style="w" x-id="WLC.PRO.20.22.003" x-align="PRO.20.22.a003" x-target-ids="t004 t005 t006" x-target="I will recompense" x-target-head="t006" x-head="true" lemma="שָׁלֵם" strong="H7999" x-morph="Vph1cs" x-gloss="I.will.repay" x-translit="ʾăšalləmâ-" xml:lang="hbo">אֲשַׁלְּמָה</char>־<char style="w" x-id="WLC.PRO.20.22.004" x-align="PRO.20.22.a004" x-target-ids="t007" x-target="evil" x-target-head="t007" x-head="true" lemma="רַע" strong="H7451" x-morph="Aamsa" x-gloss="evil" x-translit="rāʿ" xml:lang="hbo">רָ֑ע</char> <char style="w" x-id="WLC.PRO.20.22.005" x-align="PRO.20.22.a005" x-target-ids="t008" x-target="Wait" x-target-head="t008" x-head="true" lemma="קָוָה" strong="H6960" x-morph="Vpv2ms" x-gloss="wait" x-translit="qawwēh" xml:lang="hbo">קַוֵּ֥ה</char> <char style="w" x-id="WLC.PRO.20.22.006" x-align="PRO.20.22.a006" x-target-ids="t009" x-target="for" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="la" xml:lang="hbo">לַֽ֝</char><char style="w" x-id="WLC.PRO.20.22.007" x-align="PRO.20.22.a007" x-target-ids="t010" x-target="Jehovah" x-target-head="t010" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֗ה</char> <char style="w" x-id="WLC.PRO.20.22.008" x-align="PRO.20.22.a008" x-target-ids="t011" x-target="and" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C"