	<para style="p"><verse number="24" style="v" x-ref="PRO.20.24" sid="PRO 20:24" /><char style="w" x-id="WLC.PRO.20.24.001" x-align="PRO.20.24.a003" x-target-ids="t004 t005" x-target="are of" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="[are].from" x-translit="mē" xml:lang="hbo">מֵ</char><char style="w" x-id="WLC.PRO.20.24.002" x-align="PRO.20.24.a004" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yhwāh" xml:lang="hbo">יהוָ֥ה</char><char style="w" x-id="WLC.PRO.20.24.003" x-align="PRO.20.24.a002" x-target-ids="t003" x-target="goings" x-target-head="t003" x-head="true" lemma="מִצְעָד" strong="H4703" x-morph="Ncmpc" x-gloss="[the].steps" x-translit="miṣʿăḏê-" xml:lang="hbo">מִצְעֲדֵי</char>־<char style="w" x-id="WLC.PRO.20.24.004" x-align="PRO.20.24.a001" x-target-ids="t001 t002" x-target="A man’s" x-target-head="t002" x-head="true" lemma="גֶּבֶר" strong="H1397" x-morph="Ncmsa" x-gloss="of.a.man" x-translit="ḡāḇer" xml:lang="hbo">גָ֑בֶר</char> <char style="w" x-id="WLC.PRO.20.24.005" x-align="PRO.20.24.a006" x-target-ids="t008" x-target="then" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.20.24.006" x-align="PRO.20.24.a008" x-target-ids="t010" x-target="man" x-target-head="t010" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="anyone" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֗ם</char> <char style="w" x-id="WLC.PRO.20.24.007" x-align="PRO.20.24.a005" x-target-ids="t007" x-target="How" x-target-head="t007" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.PRO.20.24.008" x-align="PRO.20.24.a007" x-target-ids="t009 t011" x-target="can understand" x-target-head="t011" x-head="true" lemma="בִּין" strong="H995" x-morph="Vqi3ms" 