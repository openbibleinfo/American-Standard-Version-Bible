	<para style="p"><verse number="8" style="v" x-ref="PRO.14.8" sid="PRO 14:8" /><char style="w" x-id="WLC.PRO.14.8.001" x-align="PRO.14.8.a001" x-target-ids="t001 t002" x-target="The wisdom" x-target-head="t002" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsc" x-gloss="[the].wisdom" x-translit="ḥoḵmaṯ" xml:lang="hbo">חָכְמַ֣ת</char> <char style="w" x-id="WLC.PRO.14.8.002" x-align="PRO.14.8.a002" x-target-ids="t003 t004 t005" x-target="of the prudent" x-target-head="t005" x-head="true" lemma="עָרוּם" strong="H6175" x-morph="Aamsa" x-gloss="of.a.sensible.[person]" x-translit="ʿārûm" xml:lang="hbo">עָ֭רוּם</char> <char style="w" x-id="WLC.PRO.14.8.003" x-align="PRO.14.8.a003" x-target-ids="t006 t007 t008" x-target="is to understand" x-target-head="t008" x-head="true" lemma="בִּין" strong="H995" x-morph="Vhc" x-gloss="[is].to.understand" x-translit="hāḇiyn" xml:lang="hbo">הָבִ֣ין</char> <char style="w" x-id="WLC.PRO.14.8.004" x-align="PRO.14.8.a004" x-target-ids="t010" x-target="way" x-target-head="t010" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsc" x-gloss="way" x-translit="dark" xml:lang="hbo">דַּרְכּ֑</char><char style="w" x-id="WLC.PRO.14.8.005" x-align="PRO.14.8.a005" x-target-ids="t009" x-target="his" x-target-head="t009" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his.own" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.14.8.006" x-align="PRO.14.8.a006" x-target-ids="t011" x-target="But" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.14.8.007" x-align="PRO.14.8.a007" x-target-ids="t012 t013" x-target="the folly" x-target-head="t013" x-head="true" lemma="אִוֶּלֶת" strong="H200" x-morph="Ncfsc" x-gloss="foolishness" x-translit="ʾiwweleṯ" xml:lang="hbo">אִוֶּ֖לֶת</char> <char style="w" x-id="WLC.PRO.14.8.008" x-align="PRO.14.8.a008" x-target-ids="t014 t015" x-target="of fools" x-t