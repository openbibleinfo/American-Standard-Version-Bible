	<para style="p"><verse number="4" style="v" x-ref="PRO.28.4" sid="PRO 28:4" /><char style="w" x-id="WLC.PRO.28.4.001" x-align="PRO.28.4.a001" x-target-ids="t001 t002 t003" x-target="They that forsake" x-target-head="t003" x-head="true" lemma="עָזַב" strong="H5800" x-morph="Vqrmpc" x-gloss="[those.who].forsake" x-translit="ʿōzəḇēy" xml:lang="hbo">עֹזְבֵ֣י</char> <char style="w" x-id="WLC.PRO.28.4.002" x-align="PRO.28.4.a002" x-target-ids="t004 t005" x-target="the law" x-target-head="t005" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsa" x-gloss="(of).[the].law" x-translit="ṯôrâ" xml:lang="hbo">ת֭וֹרָה</char> <char style="w" x-id="WLC.PRO.28.4.003" x-align="PRO.28.4.a003" x-target-ids="t006" x-target="praise" x-target-head="t006" x-head="true" lemma="הָלַל" strong="H1984a" x-morph="Vpi3mp" x-gloss="they.praise" x-translit="yəhaləlû" xml:lang="hbo">יְהַֽלְל֣וּ</char> <char style="w" x-id="WLC.PRO.28.4.004" x-align="PRO.28.4.a004" x-target-ids="t007 t008" x-target="the wicked" x-target-head="t008" x-head="true" lemma="רָשָׁע" strong="H7563" x-morph="Aamsa" x-gloss="[the].wicked" x-translit="rāšāʿ" xml:lang="hbo">רָשָׁ֑ע</char> <char style="w" x-id="WLC.PRO.28.4.005" x-align="PRO.28.4.a005" x-target-ids="t009" x-target="But" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.28.4.006" x-align="PRO.28.4.a006" x-target-ids="t010 t011 t012" x-target="such as keep" x-target-head="t012" x-head="true" lemma="שָׁמַר" strong="H8104" x-morph="Vqrmpc" x-gloss="[those.who].keep" x-translit="šōmərēy" xml:lang="hbo">שֹׁמְרֵ֥י</char> <char style="w" x-id="WLC.PRO.28.4.007" x-align="PRO.28.4.a007" x-target-ids="t013 t014" x-target="the law" x-target-head="t014" x-head="true" lemma="תּוֹרָה" strong="H8451" x-morph="Ncfsa" x-gloss="(of).[the].law" x-translit="ṯôrāh" xml:lang="hbo">ת֝וֹרָ֗ה</char> <char style="w" x-id="WLC.PRO.28.4.008" x-align="PRO.28.4.a008" x-target-i