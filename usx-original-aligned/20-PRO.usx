	<para style="p"><verse number="24" style="v" x-ref="PRO.23.24" sid="PRO 23:24" /><char style="w" x-id="WLC.PRO.23.24.001" x-align="PRO.23.24.a001" x-target-ids="t007" x-target="greatly" x-target-head="t007" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqa" x-gloss="greatly.(rejoice)" x-translit="**giyl" xml:lang="hbo">גִּ֣יל</char> <char style="w" x-id="WLC.PRO.23.24.002" x-align="PRO.23.24.a002" x-target-ids="t006 t008" x-target="will rejoice" x-target-head="t008" x-head="true" lemma="גִּיל" strong="H1523" x-morph="Vqi3ms" x-gloss="he.rejoices" x-translit="**yāḡîl" xml:lang="hbo">יָ֭גִיל</char> <char style="w" x-id="WLC.PRO.23.24.003" x-align="PRO.23.24.a003" x-target-ids="t001 t002" x-target="The father" x-target-head="t002" x-head="true" lemma="אָב" strong="H1" x-morph="Ncmsc" x-gloss="[the].father" x-translit="ʾăḇiy" xml:lang="hbo">אֲבִ֣י</char> <char style="w" x-id="WLC.PRO.23.24.004" x-align="PRO.23.24.a004" x-target-ids="t003 t004 t005" x-target="of the righteous" x-target-head="t005" x-head="true" lemma="צַדִּיק" strong="H6662" x-morph="Aamsa" x-gloss="of.a.righteous.[son]" x-translit="ṣaddiyq" xml:lang="hbo">צַדִּ֑יק</char> <char style="w" x-id="WLC.PRO.23.24.005" x-align="PRO.23.24.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="**wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.23.24.006" x-align="PRO.23.24.a006" x-target-ids="t010 t011 t012" x-target="he that begetteth" x-target-head="t012" x-head="true" lemma="יָלַד" strong="H3205" x-morph="Vqrmsa" x-gloss="[one.who].begets" x-translit="**yôlēḏ" xml:lang="hbo">יוֹלֵ֥ד</char> <char style="w" x-id="WLC.PRO.23.24.007" x-align="PRO.23.24.a007" x-target-ids="t013 t014 t015" x-target="a wise child" x-target-head="t014" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aamsa" x-gloss="a.wise.[son]" x-translit="ḥāḵām" xml:lang="hbo">חָ֝כָ֗ם</char> <char style="w" x-id="WLC.PRO.23.24.008" x-align="PRO.