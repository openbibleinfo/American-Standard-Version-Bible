	<para style="p"><verse number="19" style="v" x-ref="PRO.11.19" x-added-alignments="PRO.11.19.a003 PRO.11.19.a009" x-added-target-ids="t007 t008 t016 t017" x-added-target="shall attain | doeth it" sid="PRO 11:19" /><char style="w" x-id="WLC.PRO.11.19.001" x-align="PRO.11.19.a001" x-target-ids="t001 t002 t003 t004" x-target="He that is stedfast" x-target-head="t004" x-head="true" lemma="כֵּן" strong="H3651a" x-morph="Tm" x-gloss="true" x-translit="kēn-" xml:lang="hbo">כֵּן</char>־<char style="w" x-id="WLC.PRO.11.19.002" x-align="PRO.11.19.a002" x-target-ids="t005 t006" x-target="in righteousness" x-target-head="t006" x-head="true" lemma="צְדָקָה" strong="H6666" x-morph="Ncfsa" x-gloss="righteousness" x-translit="ṣəḏāqāh" xml:lang="hbo">צְדָקָ֥ה</char> <char style="w" x-id="WLC.PRO.11.19.003" x-align="PRO.11.19.a004" x-target-ids="t009" x-target="unto" x-target-head="t009" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="[is].to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.11.19.004" x-align="PRO.11.19.a005" x-target-ids="t010" x-target="life" x-target-head="t010" x-head="true" lemma="חַיִּים" strong="H2416" x-morph="Ncmpa" x-gloss="life" x-translit="ḥayyiym" xml:lang="hbo">חַיִּ֑ים</char> <char style="w" x-id="WLC.PRO.11.19.005" x-align="PRO.11.19.a006" x-target-ids="t011" x-target="And" x-target-head="t011" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.11.19.006" x-align="PRO.11.19.a007" x-target-ids="t012 t013 t014" x-target="he that pursueth" x-target-head="t014" x-head="true" lemma="רָדַף" strong="H7291" x-morph="Vprmsa" x-gloss="[one.who].pursues" x-translit="məraddēp̄" xml:lang="hbo">מְרַדֵּ֖ף</char> <char style="w" x-id="WLC.PRO.11.19.007" x-align="PRO.11.19.a008" x-target-ids="t015" x-target="evil" x-target-head="t015" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="evil" x-translit="rāʿāh" xml:lang="hbo">רָעָ֣ה