	<para style="p"><verse number="24" style="v" x-ref="PRO.26.24" sid="PRO 26:24" /><char style="w" x-id="WLC.PRO.26.24.001" x-align="PRO.26.24.a003" x-target-ids="t005" x-target="with" x-target-head="t005" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="with" x-translit="**bi" xml:lang="hbo">בִּ֭</char><char style="w" x-id="WLC.PRO.26.24.002" x-align="PRO.26.24.a004" x-target-ids="t007" x-target="lips" x-target-head="t007" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="lips" x-translit="śəp̄āṯāy" xml:lang="hbo">שְׂפָתָי</char><char style="w" x-id="WLC.PRO.26.24.003" x-align="PRO.26.24.a005" x-target-ids="t006" x-target="his" x-target-head="t006" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="w" xml:lang="hbo">ו</char> <char style="w" x-id="WLC.PRO.26.24.004" x-align="PRO.26.24.a002" x-target-ids="t004" x-target="dissembleth" x-target-head="t004" x-head="true" lemma="נָכַר" strong="H5234a" x-morph="VNi3ms" x-gloss="he.disguises.himself" x-translit="yinnāḵēr" xml:lang="hbo">יִנָּכֵ֣ר</char> <char style="w" x-id="WLC.PRO.26.24.005" x-align="PRO.26.24.a001" x-target-ids="t001 t002 t003" x-target="He that hateth" x-target-head="t003" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqrmsa" x-gloss="[one.who].hates" x-translit="śônēʾ" xml:lang="hbo">שׂוֹנֵ֑א</char> <char style="w" x-id="WLC.PRO.26.24.006" x-align="PRO.26.24.a006" x-target-ids="t008" x-target="But" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.26.24.007" x-align="PRO.26.24.a009" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="ḇə" xml:lang="hbo">בְ</char><char style="w" x-id="WLC.PRO.26.24.008" x-align="PRO.26.24.a009" x-target-ids="t013" x-target="within" x-target-head="t013" x-head="true" lemma="קֶרֶב" strong="H7130" x-morph="Ncmsc" x-gloss="his.inner" x-translit="qirb" xml:lang="hbo">קִרְבּ֗</char><char