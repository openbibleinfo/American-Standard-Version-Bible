	<para style="p"><verse number="18" style="v" x-ref="PRO.10.18" sid="PRO 10:18" /><char style="w" x-id="WLC.PRO.10.18.001" x-align="PRO.10.18.a001" x-target-ids="t001 t002 t003" x-target="He that hideth" x-target-head="t003" x-head="true" lemma="כָּסָה" strong="H3680" x-morph="Vprmsa" x-gloss="[one.who].conceals" x-translit="məḵasseh" xml:lang="hbo">מְכַסֶּ֣ה</char> <char style="w" x-id="WLC.PRO.10.18.002" x-align="PRO.10.18.a002" x-target-ids="t004" x-target="hatred" x-target-head="t004" x-head="true" lemma="שִׂנְאָה" strong="H8135" x-morph="Ncfsa" x-gloss="hatred" x-translit="śinʾâ" xml:lang="hbo">שִׂ֭נְאָה</char> <char style="w" x-id="WLC.PRO.10.18.003" x-align="PRO.10.18.a003" x-target-ids="t005 t006 t008" x-target="is of lips" x-target-head="t008" x-head="true" lemma="שָׂפָה" strong="H8193" x-morph="Ncfdc" x-gloss="[is].lips" x-translit="śip̄ṯê-" xml:lang="hbo">שִׂפְתֵי</char>־<char style="w" x-id="WLC.PRO.10.18.004" x-align="PRO.10.18.a004" x-target-ids="t007" x-target="lying" x-target-head="t007" x-head="true" lemma="שֶׁקֶר" strong="H8267" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāqer" xml:lang="hbo">שָׁ֑קֶר</char> <char style="w" x-id="WLC.PRO.10.18.005" x-align="PRO.10.18.a005" x-target-ids="t009" x-target="And" x-target-head="t009" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.18.006" x-align="PRO.10.18.a006" x-target-ids="t010 t011 t012" x-target="he that uttereth" x-target-head="t012" x-head="true" lemma="יָצָא" strong="H3318" x-morph="Vhrmsa" x-gloss="[one.who].spreads" x-translit="môṣiʾ" xml:lang="hbo">מוֹצִ֥א</char> <char style="w" x-id="WLC.PRO.10.18.007" x-align="PRO.10.18.a007" x-target-ids="t013 t014" x-target="a slander" x-target-head="t014" x-head="true" lemma="דִּבָּה" strong="H1681" x-morph="Ncfsa" x-gloss="a.bad.report" x-translit="ḏibbāh" xml:lang="hbo">דִ֝בָּ֗ה</char> <char style="w" x-id="WLC.PRO.10.18.008" x-align="PRO.10.18.a008" x-sta