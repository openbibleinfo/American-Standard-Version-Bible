	<para style="p"><verse number="25" style="v" x-ref="PRO.31.25" sid="PRO 31:25" /><char style="w" x-id="WLC.PRO.31.25.001" x-align="PRO.31.25.a001" x-target-ids="t001" x-target="Strength" x-target-head="t001" x-head="true" lemma="עֹז" strong="H5797" x-morph="Ncmsa" x-gloss="[is].strength" x-translit="ʿōz-" xml:lang="hbo">עֹז</char>־<char style="w" x-id="WLC.PRO.31.25.002" x-align="PRO.31.25.a002" x-target-ids="t002" x-target="and" x-target-head="t002" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.31.25.003" x-align="PRO.31.25.a003" x-target-ids="t003" x-target="dignity" x-target-head="t003" x-head="true" lemma="הָדָר" strong="H1926" x-morph="Ncmsa" x-gloss="honor" x-translit="hāḏār" xml:lang="hbo">הָדָ֥ר</char> <char style="w" x-id="WLC.PRO.31.25.004" x-align="PRO.31.25.a004" x-target-ids="t004 t006" x-target="are clothing" x-target-head="t006" x-head="true" lemma="לְבוּשׁ" strong="H3830" x-morph="Ncmsc" x-gloss="clothing" x-translit="ləḇûš" xml:lang="hbo">לְבוּשָׁ֑</char><char style="w" x-id="WLC.PRO.31.25.005" x-align="PRO.31.25.a005" x-target-ids="t005" x-target="her" x-target-head="t005" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.PRO.31.25.006" x-align="PRO.31.25.a006" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ֝</char><char style="w" x-id="WLC.PRO.31.25.007" x-align="PRO.31.25.a007" x-target-ids="t008 t009" x-target="she laugheth" x-target-head="t009" x-head="true" lemma="שָׂחַק" strong="H7832" x-morph="Vqw3fs" x-gloss="she.laughed" x-translit="tiśḥaq" xml:lang="hbo">תִּשְׂחַ֗ק</char> <char style="w" x-id="WLC.PRO.31.25.008" x-align="PRO.31.25.a008" x-target-ids="t010" x-target="at" x-target-head="t010" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="