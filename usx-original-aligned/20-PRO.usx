	<para style="p"><verse number="5" style="v" x-ref="PRO.10.5" x-added-alignments="PRO.10.5.a007" x-added-target-ids="t010" x-added-target="But" sid="PRO 10:5" /><char style="w" x-id="WLC.PRO.10.5.001" x-align="PRO.10.5.a001" x-target-ids="t001 t002 t003" x-target="He that gathereth" x-target-head="t003" x-head="true" lemma="אָגַר" strong="H103" x-morph="Vqrmsa" x-gloss="[one.who].gathers" x-translit="ʾōḡēr" xml:lang="hbo">אֹגֵ֣ר</char> <char style="w" x-id="WLC.PRO.10.5.002" x-align="PRO.10.5.a002" x-target-ids="t004" x-target="in" x-target-head="t004" x-head="true" lemma="בְּ" strong="H871a" x-morph="Rd" x-gloss="in" x-translit="ba" xml:lang="hbo">בַּ֭</char><char style="w" x-id="WLC.PRO.10.5.003" x-align="PRO.10.5.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="[ha]" xml:lang="hbo">[הַ]</char><char style="w" x-id="WLC.PRO.10.5.004" x-align="PRO.10.5.a004" x-target-ids="t005" x-target="summer" x-target-head="t005" x-head="true" lemma="קַיִץ" strong="H7019" x-morph="Ncmsa" x-gloss="summer" x-translit="qqayiṣ" xml:lang="hbo">קַּיִץ</char> <char style="w" x-id="WLC.PRO.10.5.005" x-align="PRO.10.5.a005" x-target-ids="t006 t007 t009" x-target="is a son" x-target-head="t009" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsa" x-gloss="[is].a.son" x-translit="bēn" xml:lang="hbo">בֵּ֣ן</char> <char style="w" x-id="WLC.PRO.10.5.006" x-align="PRO.10.5.a006" x-target-ids="t008" x-target="wise" x-target-head="t008" x-head="true" lemma="שָׂכַל" strong="H7919" x-morph="Vhrmsa" x-gloss="[who].acts.prudently" x-translit="maśkiyl" xml:lang="hbo">מַשְׂכִּ֑יל</char> <char style="w" x-id="WLC.PRO.10.5.007" x-align="PRO.10.5.a008" x-target-ids="t011 t012 t013" x-target="he that sleepeth" x-target-head="t013" x-head="true" lemma="רָדַם" strong="H7290" x-morph="VNrmsa" x-gloss="[one.who].sleeps" x-translit="nirdām" xml:lang="hbo">נִרְדָּ֥ם</char> <char style="w" x-id="WLC.PRO.10.5.008" x-align="PRO.10.5.a009" x-target-i