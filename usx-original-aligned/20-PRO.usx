	<para style="p"><verse number="8" style="v" x-ref="PRO.17.8" sid="PRO 17:8" /><char style="w" x-id="WLC.PRO.17.8.001" x-align="PRO.17.8.a001" x-target-ids="t003 t004 t005 t007" x-target="is as a stone" x-target-italic-ids="t004" x-target-head="t007" x-head="true" lemma="אֶבֶן" strong="H68" x-morph="Ncfsc" x-gloss="[is].a.stone" x-translit="ʾeḇen-" xml:lang="hbo">אֶֽבֶן</char>־<char style="w" x-id="WLC.PRO.17.8.002" x-align="PRO.17.8.a002" x-target-ids="t006" x-target="precious" x-target-head="t006" x-head="true" lemma="חֵן" strong="H2580" x-morph="Ncmsa" x-gloss="of.favor" x-translit="ḥēn" xml:lang="hbo">חֵ֣ן</char> <char style="w" x-id="WLC.PRO.17.8.003" x-align="PRO.17.8.a003" x-status="unrepresented" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="the" x-translit="ha" xml:lang="hbo">הַ֭</char><char style="w" x-id="WLC.PRO.17.8.004" x-align="PRO.17.8.a004" x-target-ids="t001 t002" x-target="A bribe" x-target-head="t002" x-head="true" lemma="שֹׁחַד" strong="H7810" x-morph="Ncmsa" x-gloss="bribe" x-translit="ššōḥaḏ" xml:lang="hbo">שֹּׁחַד</char> <char style="w" x-id="WLC.PRO.17.8.005" x-align="PRO.17.8.a005" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.PRO.17.8.006" x-align="PRO.17.8.a006" x-target-ids="t009 t010" x-target="the eyes" x-target-head="t010" x-head="true" lemma="עַיִן" strong="H5869" x-morph="Ncbdc" x-gloss="the.eyes" x-translit="ʿênēy" xml:lang="hbo">עֵינֵ֣י</char> <char style="w" x-id="WLC.PRO.17.8.007" x-align="PRO.17.8.a007" x-target-ids="t011 t012 t013 t014" x-target="of him that hath" x-target-head="t014" x-head="true" lemma="בַּעַל" strong="H1167" x-morph="Ncmpc" x-gloss="its.owners" x-translit="ḇəʿālāy" xml:lang="hbo">בְעָלָ֑י</char><char style="w" x-id="WLC.PRO.17.8.008" x-align="PRO.17.8.a008" x-target-ids="t015" x-target="it" x-target-head="t015" x-head="true" lemma="הוּא" strong="H2050