	<para style="p"><verse number="5" style="v" x-ref="PRO.5.5" sid="PRO 5:5" /><char style="w" x-id="WLC.PRO.5.5.001" x-align="PRO.5.5.a002" x-target-ids="t002" x-target="feet" x-target-head="t002" x-head="true" lemma="רֶגֶל" strong="H7272" x-morph="Ncfdc" x-gloss="feet" x-translit="raḡley" xml:lang="hbo">רַ֭גְלֶי</char><char style="w" x-id="WLC.PRO.5.5.002" x-align="PRO.5.5.a001" x-target-ids="t001" x-target="Her" x-target-head="t001" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.5.5.003" x-align="PRO.5.5.a003" x-target-ids="t003 t004" x-target="go down" x-target-head="t003" x-head="true" lemma="יָרַד" strong="H3381" x-morph="Vqrfpa" x-gloss="[are].going.down" x-translit="yōrəḏôṯ" xml:lang="hbo">יֹרְד֣וֹת</char> <char style="w" x-id="WLC.PRO.5.5.004" x-align="PRO.5.5.a004" x-target-ids="t005 t006" x-target="to death" x-target-head="t006" x-head="true" lemma="מָוֶת" strong="H4194" x-morph="Ncmsa" x-gloss="death" x-translit="māweṯ" xml:lang="hbo">מָ֑וֶת</char> <char style="w" x-id="WLC.PRO.5.5.005" x-align="PRO.5.5.a008" x-target-ids="t012" x-target="Sheol" x-target-head="t012" x-head="true" lemma="שְׁאוֹל" strong="H7585" x-morph="Np" x-gloss="Sheol" x-translit="šəʾôl" xml:lang="hbo">שְׁ֝א֗וֹל</char> <char style="w" x-id="WLC.PRO.5.5.006" x-align="PRO.5.5.a006" x-target-ids="t008" x-target="steps" x-target-head="t008" x-head="true" lemma="צַעַד" strong="H6806" x-morph="Ncmpc" x-gloss="steps" x-translit="ṣəʿāḏey" xml:lang="hbo">צְעָדֶ֥י</char><char style="w" x-id="WLC.PRO.5.5.007" x-align="PRO.5.5.a005" x-target-ids="t007" x-target="Her" x-target-head="t007" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ</char> <char style="w" x-id="WLC.PRO.5.5.008" x-align="PRO.5.5.a007" x-target-ids="t009 t010 t011" x-target="take hold on" x-target-head="t010" x-head="true" lemma="תָּמַךְ" strong="H8551" x-morph="Vqi3mp" x-gloss=