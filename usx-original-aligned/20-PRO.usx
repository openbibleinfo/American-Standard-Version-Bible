	<para style="p"><verse number="15" style="v" x-ref="PRO.3.15" sid="PRO 3:15" /><char style="w" x-id="WLC.PRO.3.15.001" x-align="PRO.3.15.a001" x-target-ids="t002 t004" x-target="is precious" x-target-head="t004" x-head="true" lemma="יָקָר" strong="H3368" x-morph="Aafsa" x-gloss="[is].precious" x-translit="yəqārâ" xml:lang="hbo">יְקָ֣רָה</char> <char style="w" x-id="WLC.PRO.3.15.002" x-align="PRO.3.15.a002" x-target-ids="t001" x-target="She" x-target-head="t001" x-head="true" lemma="הִיא" strong="H1931a" x-morph="Pp3fs" x-gloss="she" x-translit="hîʾ" xml:lang="hbo">הִ֭יא</char> <char style="w" x-id="WLC.PRO.3.15.003" x-align="PRO.3.15.a003" x-target-ids="t003 t005" x-target="more than" x-target-head="t005" x-head="true" lemma="מִן" strong="H4480" x-morph="R" x-gloss="more" x-translit="**mi" xml:lang="hbo">מִ</char><char style="w" x-id="WLC.PRO.3.15.004" x-align="PRO.3.15.a004" x-target-ids="t006" x-target="rubies" x-target-head="t006" x-head="true" lemma="פְּנִינִים" strong="H6443" x-morph="Ncbpa" x-gloss="than.corals" x-translit="**pənîniym" xml:lang="hbo">פְּנִינִ֑ים</char> <char style="w" x-id="WLC.PRO.3.15.005" x-align="PRO.3.15.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.3.15.006" x-align="PRO.3.15.a006" lemma="כֹּל" strong="H3605" x-morph="Ncmsc" x-gloss="all" x-translit="ḵol-" xml:lang="hbo">כָל</char>־<char style="w" x-id="WLC.PRO.3.15.007" x-align="PRO.3.15.a007" x-target-ids="t009 t010 t011 t013 t014" x-target="of the things canst desire" x-target-head="t014" x-head="true" lemma="חֵפֶץ" strong="H2656" x-morph="Ncmpc" x-gloss="pleasures" x-translit="ḥăp̄āṣey" xml:lang="hbo">חֲ֝פָצֶ֗י</char><char style="w" x-id="WLC.PRO.3.15.008" x-align="PRO.3.15.a008" x-target-ids="t012" x-target="thou" x-target-head="t012" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang