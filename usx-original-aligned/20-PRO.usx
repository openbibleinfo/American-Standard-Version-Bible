	<para style="p"><verse number="3" style="v" x-ref="PRO.16.3" sid="PRO 16:3" /><char style="w" x-id="WLC.PRO.16.3.001" x-align="PRO.16.3.a001" x-target-ids="t001" x-target="Commit" x-target-head="t001" x-head="true" lemma="גָּלַל" strong="H1556" x-morph="Vqv2ms" x-gloss="roll" x-translit="gōl" xml:lang="hbo">גֹּ֣ל</char> <char style="w" x-id="WLC.PRO.16.3.002" x-align="PRO.16.3.a004" x-target-ids="t004" x-target="unto" x-target-head="t004" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.PRO.16.3.003" x-align="PRO.16.3.a005" x-target-ids="t005" x-target="Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֣ה</char> <char style="w" x-id="WLC.PRO.16.3.004" x-align="PRO.16.3.a003" x-target-ids="t003" x-target="works" x-target-head="t003" x-head="true" lemma="מַעֲשֶׂה" strong="H4639" x-morph="Ncmpc" x-gloss="works" x-translit="maʿăśey" xml:lang="hbo">מַעֲשֶׂ֑י</char><char style="w" x-id="WLC.PRO.16.3.005" x-align="PRO.16.3.a002" x-target-ids="t002" x-target="thy" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3509b" x-morph="Sp2ms" x-gloss="your" x-translit="ḵā" xml:lang="hbo">ךָ</char> <char style="w" x-id="WLC.PRO.16.3.006" x-align="PRO.16.3.a006" x-target-ids="t006" x-target="And" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.16.3.007" x-align="PRO.16.3.a009" x-target-ids="t009 t010 t011" x-target="shall be established" x-target-head="t011" x-head="true" lemma="כּוּן" strong="H3559" x-morph="VNj3mp" x-gloss="they.will.be.established" x-translit="yikkōnû" xml:lang="hbo">יִכֹּ֗נוּ</char> <char style="w" x-id="WLC.PRO.16.3.008" x-align="PRO.16.3.a008" x-target-ids="t008" x-target="purposes" x-target-head="t008" x-head="true" lemma="מַחֲשָׁבָה" strong="H4284" x-morph="Ncfpc" x-