	<para style="p"><verse number="12" style="v" x-ref="PRO.27.12" x-added-alignments="PRO.27.12.a004 PRO.27.12.a006 PRO.27.12.a009" x-added-target-ids="t007 t010 t015" x-added-target="and | But | and" sid="PRO 27:12" /><char style="w" x-id="WLC.PRO.27.12.001" x-align="PRO.27.12.a001" x-target-ids="t001 t002 t003" x-target="A prudent man" x-target-head="t002" x-head="true" lemma="עָרוּם" strong="H6175" x-morph="Aamsa" x-gloss="a.sensible.[person]" x-translit="ʿārûm" xml:lang="hbo">עָר֤וּם</char> <char style="w" x-id="WLC.PRO.27.12.002" x-align="PRO.27.12.a002" x-target-ids="t004" x-target="seeth" x-target-head="t004" x-head="true" lemma="רָאָה" strong="H7200" x-morph="Vqp3ms" x-gloss="he.sees" x-translit="rāʾāh" xml:lang="hbo">רָאָ֣ה</char> <char style="w" x-id="WLC.PRO.27.12.003" x-align="PRO.27.12.a003" x-target-ids="t005 t006" x-target="the evil" x-target-head="t006" x-head="true" lemma="רָעָה" strong="H7451b" x-morph="Ncfsa" x-gloss="evil" x-translit="rāʿāh" xml:lang="hbo">רָעָ֣ה</char> <char style="w" x-id="WLC.PRO.27.12.004" x-align="PRO.27.12.a005" x-target-ids="t008 t009" x-target="hideth himself" x-target-head="t008" x-head="true" lemma="סָתַר" strong="H5641" x-morph="VNp3ms" x-gloss="he.hides.himself" x-translit="nistār" xml:lang="hbo">נִסְתָּ֑ר</char> <char style="w" x-id="WLC.PRO.27.12.005" x-align="PRO.27.12.a007" x-target-ids="t011 t012" x-target="the simple" x-target-head="t012" x-head="true" lemma="פֶּתִי" strong="H6612" x-morph="Ncmpa" x-gloss="naive.people" x-translit="pəṯāʾyim" xml:lang="hbo">פְּ֝תָאיִ֗ם</char> <char style="w" x-id="WLC.PRO.27.12.006" x-align="PRO.27.12.a008" x-target-ids="t013 t014" x-target="pass on" x-target-head="t013" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqp3cp" x-gloss="they.pass.on" x-translit="ʿāḇərû" xml:lang="hbo">עָבְר֥וּ</char> <char style="w" x-id="WLC.PRO.27.12.007" x-align="PRO.27.12.a010" x-target-ids="t016 t017 t018" x-target="suffer for it" x-target-head="t016" x-head="true" lemma="עָנַשׁ" strong="H6064" x-morph="VNp3cp" x-gloss="they.are.punished" x-translit="neʿĕnāšû:" xml:lang="hbo">נֶעֱנָֽשׁוּ</char>׃<verse eid="PRO 27:12" /></para>
	<para style="p"><verse number="13" style="v" x-ref="PRO.27.13" sid="PRO 27:13" /><char style="w" x-id="WLC.PRO.27.13.001" x-align="PRO.27.13.a001" x-target-ids="t001" x-target="Take" x-target-head="t001" x-head="true" lemma="לָקַח" strong="H3947" x-morph="Vqv2ms" x-gloss="take" x-translit="qaḥ-" xml:lang="hbo">קַח</char>־<char style="w" x-id="WLC.PRO.27.13.002" x-align="PRO.27.13.a002" x-target-ids="t003" x-target="garment" x-target-head="t003" x-head="true" lemma="בֶּגֶד" strong="H899" x-morph="Ncmsc" x-gloss="garment" x-translit="biḡḏ" xml:lang="hbo">בִּ֭גְד</char><char style="w" x-id="WLC.PRO.27.13.003" x-align="PRO.27.13.a003" x-target-ids="t002" x-target="his" x-target-head="t002" x-head="true" lemma="הוּא" strong="H2050c" x-morph="Sp3ms" x-gloss="his" x-translit="ô" xml:lang="hbo">וֹ</char> <char style="w" x-id="WLC.PRO.27.13.004" x-align="PRO.27.13.a004" x-target-ids="t004 t015" x-target="that that" x-target-italic-ids="t015" x-target-head="t004" x-head="true" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kî-" xml:lang="hbo">כִּי</char>־<char style="w" x-id="WLC.PRO.27.13.005" x-align="PRO.27.13.a005" x-target-ids="t005 t006 t007 t016 t017" x-target="is surety for is surety" x-target-italic-ids="t016 t017" x-target-head="t006" x-head="true" lemma="עָרַב" strong="H6148" x-morph="Vqp3ms" x-gloss="he.stands.surety.for" x-translit="ʿāraḇ" xml:lang="hbo">עָ֣רַב</char> <char style="w" x-id="WLC.PRO.27.13.006" x-align="PRO.27.13.a006" x-target-ids="t008 t009" x-target="a stranger" x-target-head="t009" x-head="true" lemma="זָר" strong="H2114b" x-morph="Aamsa" x-gloss="a.stranger" x-translit="zār" xml:lang="hbo">זָ֑ר</char> <char style="w" x-id="WLC.PRO.27.13.007" x-align="PRO.27.13.a007" x-target-ids="t010" x-target="And" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.27.13.008" x-align="PRO.27.13.a008" x-target-ids="t018" x-target="for"