	<para style="p"><verse number="14" style="v" x-ref="PRO.10.14" sid="PRO 10:14" /><char style="w" x-id="WLC.PRO.10.14.001" x-align="PRO.10.14.a001" x-target-ids="t001 t002" x-target="Wise men" x-target-head="t001" x-head="true" lemma="חָכָם" strong="H2450" x-morph="Aampa" x-gloss="wise.[people]" x-translit="ḥăḵāmiym" xml:lang="hbo">חֲכָמִ֥ים</char> <char style="w" x-id="WLC.PRO.10.14.002" x-align="PRO.10.14.a002" x-target-ids="t003 t004" x-target="lay up" x-target-head="t003" x-head="true" lemma="צָפַן" strong="H6845" x-morph="Vqi3mp" x-gloss="they.store.up" x-translit="yiṣpənû-" xml:lang="hbo">יִצְפְּנוּ</char>־<char style="w" x-id="WLC.PRO.10.14.003" x-align="PRO.10.14.a003" x-target-ids="t005" x-target="knowledge" x-target-head="t005" x-head="true" lemma="דַּעַת" strong="H1847" x-morph="Ncfsa" x-gloss="knowledge" x-translit="ḏāʿaṯ" xml:lang="hbo">דָ֑עַת</char> <char style="w" x-id="WLC.PRO.10.14.004" x-align="PRO.10.14.a004" x-target-ids="t006" x-target="But" x-target-head="t006" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and.[the]" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.PRO.10.14.005" x-align="PRO.10.14.a005" x-target-ids="t007 t008" x-target="the mouth" x-target-head="t008" x-head="true" lemma="פֶּה" strong="H6310" x-morph="Ncmsc" x-gloss="mouth" x-translit="p̄iy-" xml:lang="hbo">פִֽי</char>־<char style="w" x-id="WLC.PRO.10.14.006" x-align="PRO.10.14.a006" x-target-ids="t009 t010 t011" x-target="of the foolish" x-target-head="t011" x-head="true" lemma="אֱוִיל" strong="H191" x-morph="Aamsa" x-gloss="of.a.fool" x-translit="ʾĕwîl" xml:lang="hbo">אֱ֝וִיל</char> <char style="w" x-id="WLC.PRO.10.14.007" x-align="PRO.10.14.a007" x-target-ids="t012 t013 t015" x-target="is a destruction" x-target-head="t015" x-head="true" lemma="מְחִתָּה" strong="H4288" x-morph="Ncfsa" x-gloss="[is].ruin" x-translit="məḥittāh" xml:lang="hbo">מְחִתָּ֥ה</char> <char style="w" x-id="WLC.PRO.10.14.008" x-align="PRO.10.14.a008" x-target-ids="t014"