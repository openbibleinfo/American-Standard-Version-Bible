	<para style="p"><verse number="1" style="v" x-ref="PRO.8.1" sid="PRO 8:1" /><char style="w" x-id="WLC.PRO.8.1.001" x-align="PRO.8.1.a001" x-target-ids="t001" x-target="Doth" x-target-head="t001" x-head="true" lemma="הֲ" strong="H1886b" x-morph="Ti" x-gloss="?" x-translit="hă" xml:lang="hbo">הֲ</char><char style="w" x-id="WLC.PRO.8.1.002" x-align="PRO.8.1.a002" x-target-ids="t002" x-target="not" x-target-head="t002" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.8.1.003" x-align="PRO.8.1.a003" x-target-ids="t003" x-target="wisdom" x-target-head="t003" x-head="true" lemma="חׇכְמָה" strong="H2451" x-morph="Ncfsa" x-gloss="wisdom" x-translit="ḥoḵmāh" xml:lang="hbo">חָכְמָ֥ה</char> <char style="w" x-id="WLC.PRO.8.1.004" x-align="PRO.8.1.a004" x-target-ids="t004" x-target="cry" x-target-head="t004" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi3fs" x-gloss="does.she.call.out" x-translit="ṯiqrāʾ" xml:lang="hbo">תִקְרָ֑א</char> <char style="w" x-id="WLC.PRO.8.1.005" x-align="PRO.8.1.a005" x-target-ids="t005" x-target="And" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ֝</char><char style="w" x-id="WLC.PRO.8.1.006" x-align="PRO.8.1.a006" x-target-ids="t006" x-target="understanding" x-target-head="t006" x-head="true" lemma="תְּבוּנָה" strong="H8394" x-morph="Ncfsa" x-gloss="understanding" x-translit="ṯəḇûnāh" xml:lang="hbo">תְבוּנָ֗ה</char> <char style="w" x-id="WLC.PRO.8.1.007" x-align="PRO.8.1.a007" x-target-ids="t007 t008" x-target="put forth" x-target-head="t007" x-head="true" lemma="נָתַן" strong="H5414" x-morph="Vqi3fs" x-gloss="does.she.give.forth?" x-translit="tittēn" xml:lang="hbo">תִּתֵּ֥ן</char> <char style="w" x-id="WLC.PRO.8.1.008" x-align="PRO.8.1.a008" x-target-ids="t010" x-target="voice" x-target-head="t010" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="voice" x-