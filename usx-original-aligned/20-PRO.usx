	<para style="p"><verse number="11" style="v" x-ref="PRO.3.11" sid="PRO 3:11" /><char style="w" x-id="WLC.PRO.3.11.001" x-align="PRO.3.11.a001" x-target-ids="t005 t006" x-target="the chastening" x-target-head="t006" x-head="true" lemma="מוּסָר" strong="H4148" x-morph="Ncmsc" x-gloss="the.discipline" x-translit="mûsar" xml:lang="hbo">מוּסַ֣ר</char> <char style="w" x-id="WLC.PRO.3.11.002" x-align="PRO.3.11.a002" x-target-ids="t007 t008" x-target="of Jehovah" x-target-head="t008" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yhwh" xml:lang="hbo">יְ֭הוָה</char> <char style="w" x-id="WLC.PRO.3.11.003" x-align="PRO.3.11.a003" x-target-ids="t002" x-target="son" x-target-head="t002" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="my.son" x-translit="bən" xml:lang="hbo">בְּנִ֣</char><char style="w" x-id="WLC.PRO.3.11.004" x-align="PRO.3.11.a004" x-target-ids="t001" x-target="My" x-target-head="t001" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.3.11.005" x-align="PRO.3.11.a005" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.3.11.006" x-align="PRO.3.11.a006" x-target-ids="t003" x-target="despise" x-target-head="t003" x-head="true" lemma="מָאַס" strong="H3988" x-morph="Vqj2ms" x-gloss="reject" x-translit="timʾās" xml:lang="hbo">תִּמְאָ֑ס</char> <char style="w" x-id="WLC.PRO.3.11.007" x-align="PRO.3.11.a007" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.PRO.3.11.008" x-align="PRO.3.11.a007" x-target-ids="t009" x-target="Neither" x-target-head="t009" x-head="true" lemma="אַל" strong="H408" x-morph="Tn" x-gloss="do.not" x-translit="ʾal-" xml:lang="hbo">אַל</char>־<char style="w" x-id="WLC.PRO.3.11.009" x-