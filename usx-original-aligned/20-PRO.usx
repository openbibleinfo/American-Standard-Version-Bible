	<para style="p"><verse number="15" style="v" x-ref="PRO.9.15" sid="PRO 9:15" /><char style="w" x-id="WLC.PRO.9.15.001" x-align="PRO.9.15.a001" x-target-ids="t001" x-target="To" x-target-head="t001" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.9.15.002" x-align="PRO.9.15.a002" x-target-ids="t002" x-target="call" x-target-head="t002" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqc" x-gloss="call.out" x-translit="qərōʾ" xml:lang="hbo">קְרֹ֥א</char> <char style="w" x-id="WLC.PRO.9.15.003" x-align="PRO.9.15.a003" x-target-ids="t003" x-target="to" x-target-head="t003" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lə" xml:lang="hbo">לְ</char><char style="w" x-id="WLC.PRO.9.15.004" x-align="PRO.9.15.a004" x-target-ids="t004 t005 t006 t007" x-target="them that pass by" x-target-head="t006" x-head="true" lemma="עָבַר" strong="H5674" x-morph="Vqrmpc" x-gloss="[those.who].pass.by" x-translit="ʿōḇərê-" xml:lang="hbo">עֹֽבְרֵי</char>־<char style="w" x-id="WLC.PRO.9.15.005" x-align="PRO.9.15.a005" x-status="unrepresented" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="of.[the].road" x-translit="ḏāreḵ" xml:lang="hbo">דָ֑רֶךְ</char> <char style="w" x-id="WLC.PRO.9.15.006" x-align="PRO.9.15.a006" x-target-ids="t008" x-target="Who" x-target-head="t008" x-head="true" lemma="הַ" strong="H1886a" x-morph="Td" x-gloss="[those" x-translit="ha" xml:lang="hbo">הַֽ֝</char><char style="w" x-id="WLC.PRO.9.15.007" x-align="PRO.9.15.a007" x-target-ids="t009 t010 t011" x-target="go right on" x-target-head="t010" x-head="true" lemma="יָשַׁר" strong="H3474" x-morph="Vprmpa" x-gloss="who].make.straight" x-translit="məyaššəriym" xml:lang="hbo">מְיַשְּׁרִ֗ים</char> <char style="w" x-id="WLC.PRO.9.15.008" x-align="PRO.9.15.a008" x-target-ids="t013" x-target="ways" x-target-head="t013" x-head="true" lemma="אֹרַח" strong="H734" x-morph="Ncbpc" x-gloss="p