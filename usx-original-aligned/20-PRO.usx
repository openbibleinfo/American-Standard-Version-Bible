	<para style="p"><verse number="4" style="v" x-ref="PRO.8.4" sid="PRO 8:4" /><char style="w" x-id="WLC.PRO.8.4.001" x-align="PRO.8.4.a001" x-target-ids="t001" x-target="Unto" x-target-head="t001" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾălēy" xml:lang="hbo">אֲלֵי</char><char style="w" x-id="WLC.PRO.8.4.002" x-align="PRO.8.4.a002" x-target-ids="t002" x-target="you" x-target-head="t002" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="ḵem" xml:lang="hbo">כֶ֣ם</char> <char style="w" x-id="WLC.PRO.8.4.003" x-align="PRO.8.4.a003" x-target-ids="t003 t004" x-target="O men" x-target-head="t004" x-head="true" lemma="אִישׁ" strong="H376" x-morph="Ncmpa" x-gloss="O.people" x-translit="ʾîšiym" xml:lang="hbo">אִישִׁ֣ים</char> <char style="w" x-id="WLC.PRO.8.4.004" x-align="PRO.8.4.a004" x-target-ids="t005 t006" x-target="I call" x-target-head="t006" x-head="true" lemma="קָרָא" strong="H7121" x-morph="Vqi1cs" x-gloss="I.call" x-translit="ʾeqrāʾ" xml:lang="hbo">אֶקְרָ֑א</char> <char style="w" x-id="WLC.PRO.8.4.005" x-align="PRO.8.4.a005" x-target-ids="t007" x-target="And" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ֝</char><char style="w" x-id="WLC.PRO.8.4.006" x-align="PRO.8.4.a006" x-target-ids="t009" x-target="voice" x-target-head="t009" x-head="true" lemma="קוֹל" strong="H6963" x-morph="Ncmsc" x-gloss="voice" x-translit="qôl" xml:lang="hbo">קוֹלִ֗</char><char style="w" x-id="WLC.PRO.8.4.007" x-align="PRO.8.4.a007" x-target-ids="t008" x-target="my" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="my" x-translit="iy" xml:lang="hbo">י</char> <char style="w" x-id="WLC.PRO.8.4.008" x-align="PRO.8.4.a008" x-target-ids="t010 t011" x-target="is to" x-target-head="t011" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="[is].to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x