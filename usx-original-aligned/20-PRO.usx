	<para style="p"><verse number="10" style="v" x-ref="PRO.19.10" sid="PRO 19:10" /><char style="w" x-id="WLC.PRO.19.10.001" x-align="PRO.19.10.a003" x-target-ids="t004" x-target="not" x-target-head="t004" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="not" x-translit="lōʾ-" xml:lang="hbo">לֹֽא</char>־<char style="w" x-id="WLC.PRO.19.10.002" x-align="PRO.19.10.a002" x-target-ids="t003 t005" x-target="is seemly" x-target-head="t005" x-head="true" lemma="נָאוֶה" strong="H5000" x-morph="Aamsa" x-gloss="[is].suitable" x-translit="nāʾweh" xml:lang="hbo">נָאוֶ֣ה</char> <char style="w" x-id="WLC.PRO.19.10.003" x-align="PRO.19.10.a004" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="li" xml:lang="hbo">לִ</char><char style="w" x-id="WLC.PRO.19.10.004" x-align="PRO.19.10.a005" x-target-ids="t007 t008" x-target="a fool" x-target-head="t008" x-head="true" lemma="כְּסִיל" strong="H3684" x-morph="Aamsa" x-gloss="a.fool" x-translit="ḵəsiyl" xml:lang="hbo">כְסִ֣יל</char> <char style="w" x-id="WLC.PRO.19.10.005" x-align="PRO.19.10.a001" x-target-ids="t001 t002" x-target="Delicate living" x-target-head="t001" x-head="true" lemma="תַּעֲנוּג" strong="H8588" x-morph="Ncmsa" x-gloss="luxury" x-translit="taʿănûḡ" xml:lang="hbo">תַּעֲנ֑וּג</char> <char style="w" x-id="WLC.PRO.19.10.006" x-align="PRO.19.10.a006" x-target-ids="t009 t010" x-target="Much less" x-target-head="t010" x-head="true" lemma="אַף" strong="H637" x-morph="Ta" x-gloss="indeed?" x-translit="ʾap̄" xml:lang="hbo">אַ֝֗ף</char> <char style="w" x-id="WLC.PRO.19.10.007" x-align="PRO.19.10.a006" lemma="כִּי" strong="H3588" x-morph="C" x-gloss="(dm)" x-translit="kiy-" xml:lang="hbo">כִּֽי</char>־<char style="w" x-id="WLC.PRO.19.10.008" x-align="PRO.19.10.a007" x-target-ids="t011" x-target="for" x-target-head="t011" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="for" x-translit="lə" xml:lang="hbo">לְ</char><char styl