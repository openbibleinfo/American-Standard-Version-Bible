	<para style="p"><verse number="1" style="v" x-ref="JHN.16.1" sid="JHN 16:1" /><char style="w" x-id="SBLGNT.JHN.16.1.001" x-align="JHN.16.1.a001" x-target-ids="t001 t002" x-target="These things" x-target-head="t001" x-head="true" lemma="οὗτος" strong="G5023" x-morph="D-APN" x-gloss="These things" x-translit="Tauta" xml:lang="grc">Ταῦτα</char> <char style="w" x-id="SBLGNT.JHN.16.1.002" x-align="JHN.16.1.a002" x-target-ids="t003 t004 t005" x-target="have I spoken" x-target-head="t005" x-head="true" lemma="λαλέω" strong="G2980" x-morph="V-RAI-1S" x-gloss="I have spoken" x-translit="lelalēka" xml:lang="grc">λελάληκα</char> <char style="w" x-id="SBLGNT.JHN.16.1.003" x-align="JHN.16.1.a003" x-target-ids="t006 t007" x-target="unto you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5213" x-morph="P-2DP" x-gloss="to you" x-translit="hymin" xml:lang="grc">ὑμῖν</char> <char style="w" x-id="SBLGNT.JHN.16.1.004" x-align="JHN.16.1.a004" x-target-ids="t008" x-target="that" x-target-head="t008" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.JHN.16.1.005" x-align="JHN.16.1.a005" x-target-ids="t011" x-target="not" x-target-head="t011" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.JHN.16.1.006" x-align="JHN.16.1.a006" x-target-ids="t009 t010 t012 t013 t014 t015" x-target="ye should be caused to stumble" x-target-head="t015" x-head="true" lemma="σκανδαλίζω" strong="G4624" x-morph="V-APS-2P" x-gloss="you might fall away" x-translit="skandalisthēte" xml:lang="grc">σκανδαλισθῆτε</char>.<verse eid="JHN 16:1" /></para>
