ί" strong="G2075" x-morph="V-PAI-2P" x-gloss="you are" x-translit="este" xml:lang="grc">ἐστε</char>,<char style="w" x-id="SBLGNT.JHN.13.35.009" x-align="JHN.13.35.a009" x-target-ids="t012" x-target="if" x-target-head="t012" x-head="true" lemma="ἐάν" strong="G1437" x-morph="COND" x-gloss="if" x-translit="ean" xml:lang="grc">ἐὰν</char> <char style="w" x-id="SBLGNT.JHN.13.35.010" x-align="JHN.13.35.a011" x-target-ids="t015" x-target="love" x-target-head="t015" x-head="true" lemma="ἀγάπη" strong="G26" x-morph="N-ASF" x-gloss="love" x-translit="agapēn" xml:lang="grc">ἀγάπην</char> <char style="w" x-id="SBLGNT.JHN.13.35.011" x-align="JHN.13.35.a010" x-target-ids="t013 t014" x-target="ye have" x-target-head="t014" x-head="true" lemma="ἔχω" strong="G2192" x-morph="V-PAS-2P" x-gloss="you have" x-translit="echēte" xml:lang="grc">ἔχητε</char> <char style="w" x-id="SBLGNT.JHN.13.35.012" x-align="JHN.13.35.a012" x-target-ids="t017" x-target="to" x-target-head="t017" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="among" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.JHN.13.35.013" x-align="JHN.13.35.a013" x-target-ids="t016 t018" x-target="one another" x-target-head="t018" x-head="true" lemma="ἀλλήλων" strong="G240" x-morph="C-DPM" x-gloss="one another" x-translit="allēlois" xml:lang="grc">ἀλλήλοις</char>.<verse eid="JHN 13:35" /></para>
