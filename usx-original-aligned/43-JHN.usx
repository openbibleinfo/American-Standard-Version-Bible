	<para style="p"><verse number="2" style="v" x-ref="JHN.17.2" sid="JHN 17:2" /><char style="w" x-id="SBLGNT.JHN.17.2.001" x-align="JHN.17.2.a001" x-target-ids="t001 t002" x-target="even as" x-target-head="t002" x-head="true" lemma="καθώς" strong="G2531" x-morph="ADV" x-gloss="As" x-translit="kathōs" xml:lang="grc">καθὼς</char> <char style="w" x-id="SBLGNT.JHN.17.2.002" x-align="JHN.17.2.a002" x-target-ids="t003 t004" x-target="thou gavest" x-target-head="t004" x-head="true" lemma="δίδωμι" strong="G1325" x-morph="V-AAI-2S" x-gloss="You gave" x-translit="edōkas" xml:lang="grc">ἔδωκας</char> <char style="w" x-id="SBLGNT.JHN.17.2.003" x-align="JHN.17.2.a003" x-target-ids="t005" x-target="him" x-target-head="t005" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-DSM" x-gloss="Him" x-translit="autōi" xml:lang="grc">αὐτῷ</char> <char style="w" x-id="SBLGNT.JHN.17.2.004" x-align="JHN.17.2.a004" x-target-ids="t006" x-target="authority" x-target-head="t006" x-head="true" lemma="ἐξουσία" strong="G1849" x-morph="N-ASF" x-gloss="authority" x-translit="exousian" xml:lang="grc">ἐξουσίαν</char> <char style="w" x-id="SBLGNT.JHN.17.2.005" x-align="JHN.17.2.a005" x-target-ids="t008" x-target="all" x-target-head="t008" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-GSF" x-gloss="over all" x-translit="pasēs" xml:lang="grc">πάσης</char> <char style="w" x-id="SBLGNT.JHN.17.2.006" x-align="JHN.17.2.a006" x-target-ids="t007 t009" x-target="over flesh" x-target-head="t009" x-head="true" lemma="σάρξ" strong="G4561" x-morph="N-GSF" x-gloss="flesh" x-translit="sarkos" xml:lang="grc">σαρκός</char>,<char style="w" x-id="SBLGNT.JHN.17.2.007" x-align="JHN.17.2.a007" x-target-ids="t010" x-target="that" x-target-head="t010" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="so that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.JHN.17.2.008" x-align="JHN.17.2.a009" x-target-ids="t012" x-target="all" x-target-head="t012" x-head="true" lemma="πᾶς" stron