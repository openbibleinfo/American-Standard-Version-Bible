	<para style="p"><verse number="3" style="v" x-ref="2TH.1.3" sid="2TH 1:3" /><char style="w" x-id="SBLGNT.2TH.1.3.001" x-align="2TH.1.3.a001" x-target-ids="t004 t005 t006" x-target="to give thanks" x-target-head="t006" x-head="true" lemma="εὐχαριστέω" strong="G2168" x-morph="V-PAN" x-gloss="To thank" x-translit="Eucharistein" xml:lang="grc">Εὐχαριστεῖν</char> <char style="w" x-id="SBLGNT.2TH.1.3.002" x-align="2TH.1.3.a002" x-target-ids="t001 t002 t003" x-target="We are bound" x-target-head="t003" x-head="true" lemma="ὀφείλω" strong="G3784" x-morph="V-PAI-1P" x-gloss="we ought" x-translit="opheilomen" xml:lang="grc">ὀφείλομεν</char> <char style="w" x-id="SBLGNT.2TH.1.3.003" x-align="2TH.1.3.a003" x-status="unrepresented" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSM" x-gloss="-" x-translit="tōi" xml:lang="grc">τῷ</char> <char style="w" x-id="SBLGNT.2TH.1.3.004" x-align="2TH.1.3.a004" x-target-ids="t007 t008" x-target="to God" x-target-head="t008" x-head="true" lemma="θεός" strong="G2316" x-morph="N-DSM" x-gloss="God" x-translit="theōi" xml:lang="grc">θεῷ</char> <char style="w" x-id="SBLGNT.2TH.1.3.005" x-align="2TH.1.3.a005" x-target-ids="t009" x-target="always" x-target-head="t009" x-head="true" lemma="πάντοτε" strong="G3842" x-morph="ADV" x-gloss="always" x-translit="pantote" xml:lang="grc">πάντοτε</char> <char style="w" x-id="SBLGNT.2TH.1.3.006" x-align="2TH.1.3.a006" x-target-ids="t010" x-target="for" x-target-head="t010" x-head="true" lemma="περί" strong="G4012" x-morph="PREP" x-gloss="concerning" x-translit="peri" xml:lang="grc">περὶ</char> <char style="w" x-id="SBLGNT.2TH.1.3.007" x-align="2TH.1.3.a007" x-target-ids="t011" x-target="you" x-target-head="t011" x-head="true" lemma="σύ" strong="G5216" x-morph="P-2GP" x-gloss="you" x-translit="hymōn" xml:lang="grc">ὑμῶν</char>,<char style="w" x-id="SBLGNT.2TH.1.3.008" x-align="2TH.1.3.a008" x-target-ids="t012" x-target="brethren" x-target-head="t012" x-head="true" lemma="ἀδελφός" strong="G80" x-morph="N-VPM