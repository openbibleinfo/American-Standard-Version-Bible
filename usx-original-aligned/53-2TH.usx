	<para style="p"><verse number="7" style="v" x-ref="2TH.3.7" sid="2TH 3:7" /><char style="w" x-id="SBLGNT.2TH.3.7.001" x-align="2TH.3.7.a001" x-target-ids="t002" x-target="yourselves" x-target-head="t002" x-head="true" lemma="αὐτός" strong="G846" x-morph="P-NPM" x-gloss="Yourselves" x-translit="autoi" xml:lang="grc">αὐτοὶ</char> <char style="w" x-id="SBLGNT.2TH.3.7.002" x-align="2TH.3.7.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2TH.3.7.003" x-align="2TH.3.7.a003" x-target-ids="t003" x-target="know" x-target-head="t003" x-head="true" lemma="οἶδα" strong="G1492" x-morph="V-RAI-2P" x-gloss="you know" x-translit="oidate" xml:lang="grc">οἴδατε</char> <char style="w" x-id="SBLGNT.2TH.3.7.004" x-align="2TH.3.7.a004" x-target-ids="t004" x-target="how" x-target-head="t004" x-head="true" lemma="πῶς" strong="G4459" x-morph="ADV" x-gloss="how" x-translit="pōs" xml:lang="grc">πῶς</char> <char style="w" x-id="SBLGNT.2TH.3.7.005" x-align="2TH.3.7.a005" x-target-ids="t006" x-target="ought" x-target-head="t006" x-head="true" lemma="δέω" strong="G1210" x-morph="V-PAI-3S" x-gloss="it behooves [you]" x-translit="dei" xml:lang="grc">δεῖ</char> <char style="w" x-id="SBLGNT.2TH.3.7.006" x-align="2TH.3.7.a006" x-target-ids="t005 t007 t008" x-target="ye to imitate" x-target-head="t008" x-head="true" lemma="μιμέομαι" strong="G3401" x-morph="V-PNN" x-gloss="to imitate" x-translit="mimeisthai" xml:lang="grc">μιμεῖσθαι</char> <char style="w" x-id="SBLGNT.2TH.3.7.007" x-align="2TH.3.7.a007" x-target-ids="t009" x-target="us" x-target-head="t009" x-head="true" lemma="ἐγώ" strong="G2248" x-morph="P-1AP" x-gloss="us" x-translit="hēmas" xml:lang="grc">ἡμᾶς</char>,<char style="w" x-id="SBLGNT.2TH.3.7.008" x-align="2TH.3.7.a008" x-target-ids="t010" x-target="for" x-target-head="t010" x-head="true" lemma="ὅτι" strong="G3754" x-morph="CONJ" x-gl