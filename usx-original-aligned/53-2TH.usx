	<para style="p"><verse number="10" style="v" x-ref="2TH.3.10" sid="2TH 3:10" /><char style="w" x-id="SBLGNT.2TH.3.10.001" x-align="2TH.3.10.a001" x-target-ids="t002" x-target="even" x-target-head="t002" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="Even" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.2TH.3.10.002" x-align="2TH.3.10.a002" x-target-ids="t001" x-target="For" x-target-head="t001" x-head="true" lemma="γάρ" strong="G1063" x-morph="CONJ" x-gloss="for" x-translit="gar" xml:lang="grc">γὰρ</char> <char style="w" x-id="SBLGNT.2TH.3.10.003" x-align="2TH.3.10.a003" x-target-ids="t003" x-target="when" x-target-head="t003" x-head="true" lemma="ὅτε" strong="G3753" x-morph="ADV" x-gloss="when" x-translit="hote" xml:lang="grc">ὅτε</char> <char style="w" x-id="SBLGNT.2TH.3.10.004" x-align="2TH.3.10.a004" x-target-ids="t004 t005" x-target="we were" x-target-head="t005" x-head="true" lemma="εἰμί" strong="G2252" x-morph="V-IAI-1P" x-gloss="we were" x-translit="ēmen" xml:lang="grc">ἦμεν</char> <char style="w" x-id="SBLGNT.2TH.3.10.005" x-align="2TH.3.10.a005" x-target-ids="t006" x-target="with" x-target-head="t006" x-head="true" lemma="πρός" strong="G4314" x-morph="PREP" x-gloss="with" x-translit="pros" xml:lang="grc">πρὸς</char> <char style="w" x-id="SBLGNT.2TH.3.10.006" x-align="2TH.3.10.a006" x-target-ids="t007" x-target="you" x-target-head="t007" x-head="true" lemma="σύ" strong="G5209" x-morph="P-2AP" x-gloss="you" x-translit="hymas" xml:lang="grc">ὑμᾶς</char>,<char style="w" x-id="SBLGNT.2TH.3.10.007" x-align="2TH.3.10.a007" x-target-ids="t008" x-target="this" x-target-head="t008" x-head="true" lemma="οὗτος" strong="G5124" x-morph="D-ASN" x-gloss="this" x-translit="touto" xml:lang="grc">τοῦτο</char> <char style="w" x-id="SBLGNT.2TH.3.10.008" x-align="2TH.3.10.a008" x-target-ids="t009 t010" x-target="we commanded" x-target-head="t010" x-head="true" lemma="παραγγέλλω" strong="G3853" x-morph="V-IAI-1P" x-gloss="we were comman