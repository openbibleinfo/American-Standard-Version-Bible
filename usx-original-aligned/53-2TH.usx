	<para style="p"><verse number="12" style="v" x-ref="2TH.2.12" sid="2TH 2:12" /><char style="w" x-id="SBLGNT.2TH.2.12.001" x-align="2TH.2.12.a001" x-target-ids="t001" x-target="that" x-target-head="t001" x-head="true" lemma="ἵνα" strong="G2443" x-morph="CONJ" x-gloss="in order that" x-translit="hina" xml:lang="grc">ἵνα</char> <char style="w" x-id="SBLGNT.2TH.2.12.002" x-align="2TH.2.12.a002" x-target-ids="t002 t004 t005 t006" x-target="they might be judged" x-target-head="t006" x-head="true" lemma="κρίνω" strong="G2919" x-morph="V-APS-3P" x-gloss="should be judged" x-translit="krithōsin" xml:lang="grc">κριθῶσιν</char> <char style="w" x-id="SBLGNT.2TH.2.12.003" x-align="2TH.2.12.a003" x-target-ids="t003" x-target="all" x-target-head="t003" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NPM" x-gloss="all" x-translit="pantes" xml:lang="grc">πάντες</char> <char style="w" x-id="SBLGNT.2TH.2.12.004" x-align="2TH.2.12.a004" x-target-ids="t007" x-target="who" x-target-head="t007" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPM" x-gloss="those" x-translit="hoi" xml:lang="grc">οἱ</char> <char style="w" x-id="SBLGNT.2TH.2.12.005" x-align="2TH.2.12.a006" x-target-ids="t009" x-target="not" x-target-head="t009" x-head="true" lemma="μή" strong="G3361" x-morph="PRT-N" x-gloss="not" x-translit="mē" xml:lang="grc">μὴ</char> <char style="w" x-id="SBLGNT.2TH.2.12.006" x-align="2TH.2.12.a005" x-target-ids="t008" x-target="believed" x-target-head="t008" x-head="true" lemma="πιστεύω" strong="G4100" x-morph="V-AAP-NPM" x-gloss="having believed" x-translit="pisteusantes" xml:lang="grc">πιστεύσαντες</char> <char style="w" x-id="SBLGNT.2TH.2.12.007" x-align="2TH.2.12.a007" x-target-ids="t010" x-target="the" x-target-head="t010" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DSF" x-gloss="the" x-translit="tēi" xml:lang="grc">τῇ</char> <char style="w" x-id="SBLGNT.2TH.2.12.008" x-align="2TH.2.12.a008" x-target-ids="t011" x-target="truth" x-target-head="t011" x-head="true" lemma="ἀ