	<para style="p"><verse number="25" style="v" x-ref="EZK.22.25" sid="EZK 22:25" /><char style="w" x-id="WLC.EZK.22.25.001" x-align="EZK.22.25.a001" x-target-ids="t001 t002 t003 t004" x-target="There is a conspiracy" x-target-head="t004" x-head="true" lemma="קֶשֶׁר" strong="H7195" x-morph="Ncmsc" x-gloss="(the).conspiracy" x-translit="qešer" xml:lang="hbo">קֶ֤שֶׁר</char> <char style="w" x-id="WLC.EZK.22.25.002" x-align="EZK.22.25.a002" x-target-ids="t005 t007" x-target="of prophets" x-target-head="t007" x-head="true" lemma="נָבִיא" strong="H5030" x-morph="Ncmpc" x-gloss="its.prophets" x-translit="nəḇiyʾey" xml:lang="hbo">נְבִיאֶ֨י</char><char style="w" x-id="WLC.EZK.22.25.003" x-align="EZK.22.25.a003" x-target-ids="t006" x-target="her" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="her" x-translit="hā" xml:lang="hbo">הָ֙</char> <char style="w" x-id="WLC.EZK.22.25.004" x-align="EZK.22.25.a004" x-target-ids="t008" x-target="in" x-target-head="t008" x-head="true" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="[is].in" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.EZK.22.25.005" x-align="EZK.22.25.a005" x-target-ids="t009 t010" x-target="the midst" x-target-head="t010" x-head="true" lemma="תָּוֶךְ" strong="H8432" x-morph="Ncmsc" x-gloss="the.midst" x-translit="ṯôḵ" xml:lang="hbo">תוֹכָ֔</char><char style="w" x-id="WLC.EZK.22.25.006" x-align="EZK.22.25.a006" x-target-ids="t011" x-target="thereof" x-target-head="t011" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="of.it" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.EZK.22.25.007" x-align="EZK.22.25.a007" x-target-ids="t012" x-target="like" x-target-head="t012" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="ka" xml:lang="hbo">כַּ</char><char style="w" x-id="WLC.EZK.22.25.008" x-align="EZK.22.25.a008" x-target-ids="t013 t015" x-target="a lion" x-target-head="t015" x-head="true" lemma="