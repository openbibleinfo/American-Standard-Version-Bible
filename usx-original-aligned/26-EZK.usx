	<para style="p"><verse number="24" style="v" x-ref="EZK.22.24" sid="EZK 22:24" /><char style="w" x-id="WLC.EZK.22.24.001" x-align="EZK.22.24.a001" x-target-ids="t001" x-target="Son" x-target-head="t001" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="O.son" x-translit="ben-" xml:lang="hbo">בֶּן</char>־<char style="w" x-id="WLC.EZK.22.24.002" x-align="EZK.22.24.a002" x-target-ids="t002 t003" x-target="of man" x-target-head="t003" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.humankind" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֕ם</char> <char style="w" x-id="WLC.EZK.22.24.003" x-align="EZK.22.24.a003" x-target-ids="t004" x-target="say" x-target-head="t004" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqv2ms" x-gloss="say" x-translit="ʾĕmār-" xml:lang="hbo">אֱמָר</char>־<char style="w" x-id="WLC.EZK.22.24.004" x-align="EZK.22.24.a004" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo">לָ֕</char><char style="w" x-id="WLC.EZK.22.24.005" x-align="EZK.22.24.a005" x-target-ids="t006" x-target="her" x-target-head="t006" x-head="true" lemma="הוּא" strong="H1886d" x-morph="Sp3fs" x-gloss="it" x-translit="āhh" xml:lang="hbo">הּ</char> <char style="w" x-id="WLC.EZK.22.24.006" x-align="EZK.22.24.a006" x-target-ids="t007" x-target="Thou" x-target-head="t007" x-head="true" lemma="אַתְּ" strong="H859b" x-morph="Pp2fs" x-gloss="you" x-translit="ʾatə" xml:lang="hbo">אַ֣תְּ</char> <char style="w" x-id="WLC.EZK.22.24.007" x-align="EZK.22.24.a007" x-target-ids="t008 t009 t010" x-target="art a land" x-target-head="t010" x-head="true" lemma="אֶרֶץ" strong="H776" x-morph="Ncbsa" x-gloss="[are].a.land" x-translit="ʾereṣ" xml:lang="hbo">אֶ֔רֶץ</char> <char style="w" x-id="WLC.EZK.22.24.008" x-align="EZK.22.24.a008" x-target-ids="t013" x-target="not" x-target-head="t013" x-head="true" lemma="לֹא" strong="H3808" x-morph="Tn" x-gloss="[which].not" x