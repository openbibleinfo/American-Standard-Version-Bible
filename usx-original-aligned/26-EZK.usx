	<para style="p"><verse number="1" style="v" x-ref="EZK.34.1" sid="EZK 34:1" /><char style="w" x-id="WLC.EZK.34.1.001" x-align="EZK.34.1.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.EZK.34.1.002" x-align="EZK.34.1.a002" x-target-ids="t006" x-target="came" x-target-head="t006" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw3ms" x-gloss="it.came" x-translit="yəhiy" xml:lang="hbo">יְהִ֥י</char> <char style="w" x-id="WLC.EZK.34.1.003" x-align="EZK.34.1.a003" x-target-ids="t002 t003" x-target="the word" x-target-head="t003" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="the.word" x-translit="ḏəḇar-" xml:lang="hbo">דְבַר</char>־<char style="w" x-id="WLC.EZK.34.1.004" x-align="EZK.34.1.a004" x-target-ids="t004 t005" x-target="of Jehovah" x-target-head="t005" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.EZK.34.1.005" x-align="EZK.34.1.a005" x-target-ids="t007" x-target="unto" x-target-head="t007" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo">אֵלַ֥</char><char style="w" x-id="WLC.EZK.34.1.006" x-align="EZK.34.1.a006" x-target-ids="t008" x-target="me" x-target-head="t008" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo">י</char> <char style="w" x-id="WLC.EZK.34.1.007" x-align="EZK.34.1.a007" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(cmp)" x-translit="lē" xml:lang="hbo">לֵ</char><char style="w" x-id="WLC.EZK.34.1.008" x-align="EZK.34.1.a008" x-target-ids="t009" x-target="saying" x-target-head="t009" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqc" x-translit="ʾmōr:" xml:lang="hbo">אמֹֽר</char>׃<verse eid="EZK 34:1" /></para>
