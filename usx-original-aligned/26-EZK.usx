	<para style="p"><verse number="18" style="v" x-ref="EZK.21.18" sid="EZK 21:18" /><char style="w" x-id="WLC.EZK.21.18.001" x-align="EZK.21.18.a001" x-target-ids="t008" x-target="again" x-target-head="t008" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo" x-source-ref="EZK.21.23">וַ</char><char style="w" x-id="WLC.EZK.21.18.002" x-align="EZK.21.18.a002" x-target-ids="t005" x-target="came" x-target-head="t005" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqw3ms" x-gloss="it.came" x-translit="yəhiy" xml:lang="hbo" x-source-ref="EZK.21.23">יְהִ֥י</char> <char style="w" x-id="WLC.EZK.21.18.003" x-align="EZK.21.18.a003" x-target-ids="t001 t002" x-target="The word" x-target-head="t002" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="the.word" x-translit="ḏəḇar-" xml:lang="hbo" x-source-ref="EZK.21.23">דְבַר</char>־<char style="w" x-id="WLC.EZK.21.18.004" x-align="EZK.21.18.a004" x-target-ids="t003 t004" x-target="of Jehovah" x-target-head="t004" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo" x-source-ref="EZK.21.23">יְהוָ֖ה</char> <char style="w" x-id="WLC.EZK.21.18.005" x-align="EZK.21.18.a005" x-target-ids="t006" x-target="unto" x-target-head="t006" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾēl" xml:lang="hbo" x-source-ref="EZK.21.23">אֵלַ֥</char><char style="w" x-id="WLC.EZK.21.18.006" x-align="EZK.21.18.a006" x-target-ids="t007" x-target="me" x-target-head="t007" x-head="true" lemma="הוּא" strong="H2967a" x-morph="Sp1cs" x-gloss="me" x-translit="ay" xml:lang="hbo" x-source-ref="EZK.21.23">י</char> <char style="w" x-id="WLC.EZK.21.18.007" x-align="EZK.21.18.a007" x-status="unrepresented" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="(cmp)" x-translit="lē" xml:lang="hbo" x-source-ref="EZK.21.23">לֵ</char><char style="w" x-id="WLC.EZK.21.18.008" x-align="EZK.21.18.a008" x-target-ids="