	<para style="p"><verse number="20" style="v" x-ref="EZK.21.20" sid="EZK 21:20" /><char style="w" x-id="WLC.EZK.21.20.001" x-align="EZK.21.20.a001" x-target-ids="t004 t005" x-target="a way" x-target-head="t005" x-head="true" lemma="דֶּרֶךְ" strong="H1870" x-morph="Ncbsa" x-gloss="a.road" x-translit="dereḵ" xml:lang="hbo" x-source-ref="EZK.21.25">דֶּ֣רֶךְ</char> <char style="w" x-id="WLC.EZK.21.20.002" x-align="EZK.21.20.a002" x-target-ids="t001 t002 t003" x-target="Thou shalt appoint" x-target-head="t003" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqi2ms" x-gloss="you.will.make" x-translit="tāśiym" xml:lang="hbo" x-source-ref="EZK.21.25">תָּשִׂ֔ים</char> <char style="w" x-id="WLC.EZK.21.20.003" x-align="EZK.21.20.a003" x-target-ids="t006" x-target="for" x-target-head="t006" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="lā" xml:lang="hbo" x-source-ref="EZK.21.25">לָ</char><char style="w" x-id="WLC.EZK.21.20.004" x-align="EZK.21.20.a004" x-target-ids="t009 t010" x-target="to come" x-target-head="t010" x-head="true" lemma="בּוֹא" strong="H935" x-morph="Vqc" x-gloss="come" x-translit="ḇôʾ" xml:lang="hbo" x-source-ref="EZK.21.25">ב֣וֹא</char> <char style="w" x-id="WLC.EZK.21.20.005" x-align="EZK.21.20.a005" x-target-ids="t007 t008" x-target="the sword" x-target-head="t008" x-head="true" lemma="חֶרֶב" strong="H2719" x-morph="Ncfsa" x-gloss="a.sword" x-translit="ḥereḇ" xml:lang="hbo" x-source-ref="EZK.21.25">חֶ֔רֶב</char> <char style="w" x-id="WLC.EZK.21.20.006" x-align="EZK.21.20.a006" x-target-ids="t011" x-target="to" x-target-head="t011" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾēṯ" xml:lang="hbo" x-source-ref="EZK.21.25">אֵ֖ת</char> <char style="w" x-id="WLC.EZK.21.20.007" x-align="EZK.21.20.a007" x-target-ids="t012" x-target="Rabbah" x-target-head="t012" x-head="true" lemma="רַב" strong="H7237" x-morph="Np" x-gloss="Rabbah" x-translit="rabbaṯ" xml:lang="hbo" x-source-ref="EZK.21.25">רַבַּ֣ת