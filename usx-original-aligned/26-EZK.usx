	<para style="p"><verse number="2" style="v" x-ref="EZK.27.2" sid="EZK 27:2" /><char style="w" x-id="WLC.EZK.27.2.001" x-align="EZK.27.2.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.EZK.27.2.002" x-align="EZK.27.2.a002" x-target-ids="t002" x-target="thou" x-target-head="t002" x-head="true" lemma="אַתָּה" strong="H859" x-morph="Pp2ms" x-gloss="you" x-translit="ʾattāh" xml:lang="hbo">אַתָּ֣ה</char> <char style="w" x-id="WLC.EZK.27.2.003" x-align="EZK.27.2.a003" x-target-ids="t003" x-target="son" x-target-head="t003" x-head="true" lemma="בֵּן" strong="H1121" x-morph="Ncmsc" x-gloss="O.son" x-translit="ḇen-" xml:lang="hbo">בֶן</char>־<char style="w" x-id="WLC.EZK.27.2.004" x-align="EZK.27.2.a004" x-target-ids="t004 t005" x-target="of man" x-target-head="t005" x-head="true" lemma="אָדָם" strong="H120" x-morph="Ncmsa" x-gloss="of.humankind" x-translit="ʾāḏām" xml:lang="hbo">אָדָ֔ם</char> <char style="w" x-id="WLC.EZK.27.2.005" x-align="EZK.27.2.a005" x-target-ids="t006 t007" x-target="take up" x-target-head="t006" x-head="true" lemma="נָשָׂא" strong="H5375" x-morph="Vqv2ms" x-gloss="take.up" x-translit="śāʾ" xml:lang="hbo">שָׂ֥א</char> <char style="w" x-id="WLC.EZK.27.2.006" x-align="EZK.27.2.a006" x-target-ids="t010" x-target="over" x-target-head="t010" x-head="true" lemma="עַל" strong="H5921" x-morph="R" x-gloss="on" x-translit="ʿal-" xml:lang="hbo">עַל</char>־<char style="w" x-id="WLC.EZK.27.2.007" x-align="EZK.27.2.a007" x-target-ids="t011" x-target="Tyre" x-target-head="t011" x-head="true" lemma="צֹר" strong="H6865" x-morph="Np" x-gloss="Tyre" x-translit="ṣōr" xml:lang="hbo">צֹ֖ר</char> <char style="w" x-id="WLC.EZK.27.2.008" x-align="EZK.27.2.a008" x-target-ids="t008 t009" x-target="a lamentation" x-target-head="t009" x-head="true" lemma="קִינָה" strong="H7015" x-morph="Ncfsa" x-gloss="a.lamentation" x-translit="qînāh: