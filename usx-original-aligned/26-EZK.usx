	<para style="p"><verse number="23" style="v" x-ref="EZK.21.23" sid="EZK 21:23" /><char style="w" x-id="WLC.EZK.21.23.001" x-align="EZK.21.23.a001" x-target-ids="t001" x-target="And" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo" x-source-ref="EZK.21.28">וְ</char><char style="w" x-id="WLC.EZK.21.23.002" x-align="EZK.21.23.a002" x-target-ids="t002 t003 t004" x-target="it shall be" x-target-head="t004" x-head="true" lemma="הָיָה" strong="H1961" x-morph="Vqq3ms" x-gloss="it.will.be" x-translit="hāyāh" xml:lang="hbo" x-source-ref="EZK.21.28">הָיָ֨ה</char> <char style="w" x-id="WLC.EZK.21.23.003" x-align="EZK.21.23.a003" x-target-ids="t005" x-target="unto" x-target-head="t005" x-head="true" lemma="לְ" strong="H3807a" x-morph="R" x-gloss="to" x-translit="l" xml:lang="hbo" x-source-ref="EZK.21.28">לָ</char><char style="w" x-id="WLC.EZK.21.23.004" x-align="EZK.21.23.a004" x-target-ids="t006" x-target="them" x-target-head="t006" x-head="true" lemma="הוּא" strong="H3963a" x-morph="Sp3mp" x-gloss="them" x-translit="āhem" xml:lang="hbo" x-source-ref="EZK.21.28">הֶ֤ם</char> <char style="w" x-id="WLC.EZK.21.23.005" x-align="EZK.21.23.a005" x-target-ids="t007" x-target="as" x-target-head="t007" x-head="true" lemma="כְּ" strong="H3509a" x-morph="R" x-gloss="like" x-translit="**ki" xml:lang="hbo" x-source-ref="EZK.21.28">כִּ</char><char style="w" x-id="WLC.EZK.21.23.006" x-align="EZK.21.23.a006" x-target-ids="t008 t010" x-target="a divination" x-target-head="t010" x-head="true" lemma="קָסַם" strong="H7080" x-morph="Ncmsc" x-gloss="divining" x-translit="**qəsām-" xml:lang="hbo" x-source-ref="EZK.21.28">קְסָם</char>־<char style="w" x-id="WLC.EZK.21.23.007" x-align="EZK.21.23.a007" x-target-ids="t009" x-target="false" x-target-head="t009" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="of.falsehood" x-translit="šāwʾ" xml:lang="hbo" x-source-ref="EZK.21.28">שָׁוְא֙</char> <char style="w" x-id="W