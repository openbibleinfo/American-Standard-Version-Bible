	<para style="p"><verse number="14" style="v" x-ref="MAL.3.14" sid="MAL 3:14" /><char style="w" x-id="WLC.MAL.3.14.001" x-align="MAL.3.14.a001" x-target-ids="t001 t002 t003" x-target="Ye have said" x-target-head="t003" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp2mp" x-gloss="you.have.said" x-translit="ʾămartem" xml:lang="hbo">אֲמַרְתֶּ֕ם</char> <char style="w" x-id="WLC.MAL.3.14.002" x-align="MAL.3.14.a002" x-target-ids="t004 t005 t006" x-target="It is vain" x-target-head="t006" x-head="true" lemma="שָׁוְא" strong="H7723" x-morph="Ncmsa" x-gloss="[is].futility" x-translit="šāwəʾ" xml:lang="hbo">שָׁ֖וְא</char> <char style="w" x-id="WLC.MAL.3.14.003" x-align="MAL.3.14.a003" x-target-ids="t007 t008" x-target="to serve" x-target-head="t008" x-head="true" lemma="עָבַד" strong="H5647" x-morph="Vqc" x-gloss="to.serve" x-translit="ʿăḇōḏ" xml:lang="hbo">עֲבֹ֣ד</char> <char style="w" x-id="WLC.MAL.3.14.004" x-align="MAL.3.14.a004" x-target-ids="t009" x-target="God" x-target-head="t009" x-head="true" lemma="אֱלֹהִים" strong="H430" x-morph="Ncmpa" x-gloss="God" x-translit="ʾĕlōhiym" xml:lang="hbo">אֱלֹהִ֑ים</char> <char style="w" x-id="WLC.MAL.3.14.005" x-align="MAL.3.14.a005" x-target-ids="t010" x-target="and" x-target-head="t010" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="û" xml:lang="hbo">וּ</char><char style="w" x-id="WLC.MAL.3.14.006" x-align="MAL.3.14.a006" x-target-ids="t011" x-target="what" x-target-head="t011" x-head="true" lemma="מָה" strong="H4100" x-morph="Ti" x-gloss="what?" x-translit="mah-" xml:lang="hbo">מַה</char>־<char style="w" x-id="WLC.MAL.3.14.007" x-align="MAL.3.14.a007" x-target-ids="t012 t013 t014" x-target="profit is it" x-target-head="t012" x-head="true" lemma="בֶּצַע" strong="H1215" x-morph="Ncmsa" x-gloss="[is.the].profit" x-translit="beṣaʿ" xml:lang="hbo">בֶּ֗צַע</char> <char style="w" x-id="WLC.MAL.3.14.008" x-align="MAL.3.14.a008" x-target-ids="t015" x-target="that" x-target-head="t015" x-head="true"