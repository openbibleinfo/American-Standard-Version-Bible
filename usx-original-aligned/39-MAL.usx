	<para style="p"><verse number="2" style="v" x-ref="MAL.1.2" sid="MAL 1:2" /><char style="w" x-id="WLC.MAL.1.2.001" x-align="MAL.1.2.a001" x-target-ids="t001 t002 t003" x-target="I have loved" x-target-head="t003" x-head="true" lemma="אָהֵב" strong="H157" x-morph="Vqp1cs" x-gloss="I.have.loved" x-translit="ʾāhaḇətî" xml:lang="hbo">אָהַ֤בְתִּי</char> <char style="w" x-id="WLC.MAL.1.2.002" x-align="MAL.1.2.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-translit="ʾeṯ" xml:lang="hbo">אֶתְ</char><char style="w" x-id="WLC.MAL.1.2.003" x-align="MAL.1.2.a003" x-target-ids="t004" x-target="you" x-target-head="t004" x-head="true" lemma="הוּא" strong="H3641b" x-morph="Sp2mp" x-gloss="you" x-translit="əḵem" xml:lang="hbo">כֶם֙</char> <char style="w" x-id="WLC.MAL.1.2.004" x-align="MAL.1.2.a004" x-target-ids="t005" x-target="saith" x-target-head="t005" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp3ms" x-gloss="he.says" x-translit="ʾāmar" xml:lang="hbo">אָמַ֣ר</char> <char style="w" x-id="WLC.MAL.1.2.005" x-align="MAL.1.2.a005" x-target-ids="t006" x-target="Jehovah" x-target-head="t006" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֔ה</char> <char style="w" x-id="WLC.MAL.1.2.006" x-align="MAL.1.2.a006" x-target-ids="t007" x-target="Yet" x-target-head="t007" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wa" xml:lang="hbo">וַ</char><char style="w" x-id="WLC.MAL.1.2.007" x-align="MAL.1.2.a007" x-target-ids="t008 t009" x-target="ye say" x-target-head="t009" x-head="true" lemma="אָמַר" strong="H559" x-morph="Vqp2mp" x-gloss="you.say" x-translit="ʾămartem" xml:lang="hbo">אֲמַרְתֶּ֖ם</char> <char style="w" x-id="WLC.MAL.1.2.008" x-align="MAL.1.2.a008" lemma="בְּ" strong="H871a" x-morph="R" x-translit="ba" xml:lang="hbo">בַּ</char><char style="w" x-id="WLC.MAL.1.2.009" x-align="MAL.1.2.a008" x-target-ids="t010" x-target="Wherein" x-target-head