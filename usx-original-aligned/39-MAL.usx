	<para style="p"><verse number="1" style="v" x-ref="MAL.1.1" sid="MAL 1:1" /><char style="w" x-id="WLC.MAL.1.1.001" x-align="MAL.1.1.a001" x-target-ids="t001 t002" x-target="The burden" x-target-head="t002" x-head="true" lemma="מַשָּׂא" strong="H4853a" x-morph="Ncmsa" x-gloss="the.oracle" x-translit="maśśāʾ" xml:lang="hbo">מַשָּׂ֥א</char> <char style="w" x-id="WLC.MAL.1.1.002" x-align="MAL.1.1.a002" x-target-ids="t003 t004 t005" x-target="of the word" x-target-head="t005" x-head="true" lemma="דָּבָר" strong="H1697" x-morph="Ncmsc" x-gloss="of.the.word" x-translit="ḏəḇar-" xml:lang="hbo">דְבַר</char>־<char style="w" x-id="WLC.MAL.1.1.003" x-align="MAL.1.1.a003" x-target-ids="t006 t007" x-target="of Jehovah" x-target-head="t007" x-head="true" lemma="יהוה" strong="H3068" x-morph="Np" x-gloss="of.Yahweh" x-translit="yəhwāh" xml:lang="hbo">יְהוָ֖ה</char> <char style="w" x-id="WLC.MAL.1.1.004" x-align="MAL.1.1.a004" x-target-ids="t008" x-target="to" x-target-head="t008" x-head="true" lemma="אֶל" strong="H413" x-morph="R" x-gloss="to" x-translit="ʾel-" xml:lang="hbo">אֶל</char>־<char style="w" x-id="WLC.MAL.1.1.005" x-align="MAL.1.1.a005" x-target-ids="t009" x-target="Israel" x-target-head="t009" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478" x-morph="Np" x-gloss="Israel" x-translit="yiśrāʾēl" xml:lang="hbo">יִשְׂרָאֵ֑ל</char> <char style="w" x-id="WLC.MAL.1.1.006" x-align="MAL.1.1.a006" lemma="בְּ" strong="H871a" x-morph="R" x-gloss="by" x-translit="bə" xml:lang="hbo">בְּ</char><char style="w" x-id="WLC.MAL.1.1.007" x-align="MAL.1.1.a006" x-target-ids="t010" x-target="by" x-target-head="t010" x-head="true" lemma="יָד" strong="H3027" x-morph="Ncbsc" x-gloss="the.hand" x-translit="yaḏ" xml:lang="hbo">יַ֖ד</char> <char style="w" x-id="WLC.MAL.1.1.008" x-align="MAL.1.1.a007" x-target-ids="t011" x-target="Malachi" x-target-head="t011" x-head="true" lemma="מַלְאָכִי" strong="H4401" x-morph="Np" x-gloss="of.Malachi" x-translit="malʾāḵiy:" xml:lang="hbo">מַלְאָכִֽי</char>׃<verse