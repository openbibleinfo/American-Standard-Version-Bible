	<para style="p"><verse number="3" style="v" x-ref="MAL.1.3" sid="MAL 1:3" /><char style="w" x-id="WLC.MAL.1.3.001" x-align="MAL.1.3.a001" x-target-ids="t001" x-target="but" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.MAL.1.3.002" x-align="MAL.1.3.a002" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.MAL.1.3.003" x-align="MAL.1.3.a003" x-target-ids="t002" x-target="Esau" x-target-head="t002" x-head="true" lemma="עֵשָׂו" strong="H6215" x-morph="Np" x-gloss="Esau" x-translit="ʿēśāw" xml:lang="hbo">עֵשָׂ֖ו</char> <char style="w" x-id="WLC.MAL.1.3.004" x-align="MAL.1.3.a004" x-target-ids="t003 t004" x-target="I hated" x-target-head="t004" x-head="true" lemma="שָׂנֵא" strong="H8130" x-morph="Vqp1cs" x-gloss="I.hated" x-translit="śānēʾṯî" xml:lang="hbo">שָׂנֵ֑אתִי</char> <char style="w" x-id="WLC.MAL.1.3.005" x-align="MAL.1.3.a005" x-target-ids="t005" x-target="and" x-target-head="t005" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wā" xml:lang="hbo">וָ</char><char style="w" x-id="WLC.MAL.1.3.006" x-align="MAL.1.3.a006" x-target-ids="t006 t012" x-target="made gave" x-target-italic-ids="t012" x-target-head="t006" x-head="true" lemma="שׂים" strong="H7760" x-morph="Vqw1cs" x-gloss="I.have.made" x-translit="ʾāśiym" xml:lang="hbo">אָשִׂ֤ים</char> <char style="w" x-id="WLC.MAL.1.3.007" x-align="MAL.1.3.a007" x-status="unrepresented" x-head="true" lemma="אֵת" strong="H853" x-morph="To" x-gloss="(et)" x-translit="ʾeṯ-" xml:lang="hbo">אֶת</char>־<char style="w" x-id="WLC.MAL.1.3.008" x-align="MAL.1.3.a008" x-target-ids="t008" x-target="mountains" x-target-head="t008" x-head="true" lemma="הַר" strong="H2022" x-morph="Ncmpc" x-gloss="mountains" x-translit="hārāy" xml:lang="hbo">הָרָי</char><char style="w" x-id="WLC.MAL.1.3.009" x