	<para style="p"><verse number="15" style="v" x-ref="MAL.3.15" sid="MAL 3:15" /><char style="w" x-id="WLC.MAL.3.15.001" x-align="MAL.3.15.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="וְ" strong="H2050b" x-morph="C" x-gloss="and" x-translit="wə" xml:lang="hbo">וְ</char><char style="w" x-id="WLC.MAL.3.15.002" x-align="MAL.3.15.a002" x-target-ids="t002" x-target="now" x-target-head="t002" x-head="true" lemma="עַתָּה" strong="H6258" x-morph="D" x-gloss="therefore" x-translit="ʿattāh" xml:lang="hbo">עַתָּ֕ה</char> <char style="w" x-id="WLC.MAL.3.15.003" x-align="MAL.3.15.a003" x-target-ids="t003" x-target="we" x-target-head="t003" x-head="true" lemma="אֲנַחְנוּ" strong="H587" x-morph="Pp1cp" x-gloss="we" x-translit="ʾănaḥənû" xml:lang="hbo">אֲנַ֖חְנוּ</char> <char style="w" x-id="WLC.MAL.3.15.004" x-align="MAL.3.15.a004" x-target-ids="t004 t007" x-target="call happy" x-target-head="t007" x-head="true" lemma="אָשַׁר" strong="H833a" x-morph="Vprmpa" x-gloss="[are].calling.blessed" x-translit="məʾaššəriym" xml:lang="hbo">מְאַשְּׁרִ֣ים</char> <char style="w" x-id="WLC.MAL.3.15.005" x-align="MAL.3.15.a005" x-target-ids="t005 t006" x-target="the proud" x-target-head="t006" x-head="true" lemma="זֵד" strong="H2086" x-morph="Aampa" x-gloss="arrogant.[people]" x-translit="zēḏiym" xml:lang="hbo">זֵדִ֑ים</char> <char style="w" x-id="WLC.MAL.3.15.006" x-align="MAL.3.15.a006" x-target-ids="t008" x-target="yea" x-target-head="t008" x-head="true" lemma="גַּם" strong="H1571" x-morph="Ta" x-gloss="both" x-translit="gam-" xml:lang="hbo">גַּם</char>־<char style="w" x-id="WLC.MAL.3.15.007" x-align="MAL.3.15.a007" x-target-ids="t013 t014 t015" x-target="are built up" x-target-head="t014" x-head="true" lemma="בָּנָה" strong="H1129" x-morph="VNp3cp" x-gloss="they.have.been.built.up" x-translit="niḇnû" xml:lang="hbo">נִבְנוּ֙</char> <char style="w" x-id="WLC.MAL.3.15.008" x-align="MAL.3.15.a008" x-target-ids="t009 t010 t011" x-target="they that work" x-targe