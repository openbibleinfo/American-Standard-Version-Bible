	<para style="p"><verse number="13" style="v" x-ref="EPH.5.13" x-added-alignments="EPH.5.13.a009" x-added-target-ids="t014 t015 t016 t017 t018 t019 t020 t021" x-added-target="for everything that is made manifest is light" sid="EPH 5:13" /><char style="w" x-id="SBLGNT.EPH.5.13.001" x-align="EPH.5.13.a002" x-target-ids="t003" x-target="things" x-target-head="t003" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-NPN" x-gloss="-" x-translit="ta" xml:lang="grc">τὰ</char> <char style="w" x-id="SBLGNT.EPH.5.13.002" x-align="EPH.5.13.a001" x-target-ids="t001" x-target="But" x-target-head="t001" x-head="true" lemma="δέ" strong="G1161" x-morph="CONJ" x-gloss="But" x-translit="de" xml:lang="grc">δὲ</char> <char style="w" x-id="SBLGNT.EPH.5.13.003" x-align="EPH.5.13.a003" x-target-ids="t002" x-target="all" x-target-head="t002" x-head="true" lemma="πᾶς" strong="G3956" x-morph="A-NPN" x-gloss="everything" x-translit="panta" xml:lang="grc">πάντα</char> <char style="w" x-id="SBLGNT.EPH.5.13.004" x-align="EPH.5.13.a004" x-target-ids="t004 t005 t006 t007" x-target="when they are reproved" x-target-head="t007" x-head="true" lemma="ἐλέγχω" strong="G1651" x-morph="V-PPP-NPN" x-gloss="being exposed" x-translit="elenchomena" xml:lang="grc">ἐλεγχόμενα</char> <char style="w" x-id="SBLGNT.EPH.5.13.005" x-align="EPH.5.13.a006" x-target-ids="t011" x-target="by" x-target-head="t011" x-head="true" lemma="ὑπό" strong="G5259" x-morph="PREP" x-gloss="by" x-translit="hypo" xml:lang="grc">ὑπὸ</char> <char style="w" x-id="SBLGNT.EPH.5.13.006" x-align="EPH.5.13.a007" x-target-ids="t012" x-target="the" x-target-head="t012" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-GSN" x-gloss="the" x-translit="tou" xml:lang="grc">τοῦ</char> <char style="w" x-id="SBLGNT.EPH.5.13.007" x-align="EPH.5.13.a008" x-target-ids="t013" x-target="light" x-target-head="t013" x-head="true" lemma="φῶς" strong="G5457" x-morph="N-GSN" x-gloss="light" x-translit="phōtos" xml:lang="grc">φωτὸς</char> <char style="w" x-id="SBLGN