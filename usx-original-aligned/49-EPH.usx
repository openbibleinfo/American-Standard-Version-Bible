	<para style="p"><verse number="6" style="v" x-ref="EPH.2.6" sid="EPH 2:6" /><char style="w" x-id="SBLGNT.EPH.2.6.001" x-align="EPH.2.6.a001" x-target-ids="t001" x-target="and" x-target-head="t001" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.EPH.2.6.002" x-align="EPH.2.6.a002" x-target-ids="t002 t003 t004 t005 t006" x-target="raised us up with him" x-target-head="t002" x-head="true" lemma="συνεγείρω" strong="G4891" x-morph="V-AAI-3S" x-gloss="He raised [us] up together" x-translit="synēgeiren" xml:lang="grc">συνήγειρεν</char> <char style="w" x-id="SBLGNT.EPH.2.6.003" x-align="EPH.2.6.a003" x-target-ids="t007" x-target="and" x-target-head="t007" x-head="true" lemma="καί" strong="G2532" x-morph="CONJ" x-gloss="and" x-translit="kai" xml:lang="grc">καὶ</char> <char style="w" x-id="SBLGNT.EPH.2.6.004" x-align="EPH.2.6.a004" x-target-ids="t008 t009 t010 t011 t012 t013" x-target="made us to sit with him" x-target-head="t011" x-head="true" lemma="συγκαθίζω" strong="G4776" x-morph="V-AAI-3S" x-gloss="seated [us] together" x-translit="synekathisen" xml:lang="grc">συνεκάθισεν</char> <char style="w" x-id="SBLGNT.EPH.2.6.005" x-align="EPH.2.6.a005" x-target-ids="t014" x-target="in" x-target-head="t014" x-head="true" lemma="ἐν" strong="G1722" x-morph="PREP" x-gloss="in" x-translit="en" xml:lang="grc">ἐν</char> <char style="w" x-id="SBLGNT.EPH.2.6.006" x-align="EPH.2.6.a006" x-target-ids="t015" x-target="the" x-target-head="t015" x-head="true" lemma="ὁ" strong="G3588" x-morph="T-DPN" x-gloss="the" x-translit="tois" xml:lang="grc">τοῖς</char> <char style="w" x-id="SBLGNT.EPH.2.6.007" x-align="EPH.2.6.a007" x-target-ids="t016 t017" x-target="heavenly places" x-target-italic-ids="t017" x-target-head="t016" x-head="true" lemma="ἐπουράνιος" strong="G2032" x-morph="A-DPN" x-gloss="heavenly realms" x-translit="epouraniois" xml:lang="grc">ἐπουρανίοις</char> <char style="w" x-id="SBLGNT.EPH.2.