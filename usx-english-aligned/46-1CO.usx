	<para style="p"><verse number="1" style="v" x-unrepresented-source="τοῦ" x-unrepresented-translit="tou" x-unrepresented-src="SBLGNT.1CO.2.1.017" sid="1CO 2:1" /><char style="w" x-id="t001" x-align="1CO.2.1.a001">And</char> <char style="w" x-id="t002" x-align="1CO.2.1.a001" x-src="SBLGNT.1CO.2.1.001" x-source="Κἀγὼ" x-translit="Kagō" srcloc="SBLGNT.1CO.2.1.001" x-head="true" lemma="κἀγώ" strong="G2504">I</char>, <char style="w" x-id="t003" x-align="1CO.2.1.a002" x-src="SBLGNT.1CO.2.1.005" x-source="ἀδελφοί" x-translit="adelphoi" srcloc="SBLGNT.1CO.2.1.005" x-head="true" lemma="ἀδελφός" strong="G80">brethren</char>, <char style="w" x-id="t004" x-align="1CO.2.1.a003">when</char> <char style="w" x-id="t005" x-align="1CO.2.1.a003">I</char> <char style="w" x-id="t006" x-align="1CO.2.1.a003" x-src="SBLGNT.1CO.2.1.002" x-source="ἐλθὼν" x-translit="elthōn" srcloc="SBLGNT.1CO.2.1.002" x-head="true" lemma="ἔρχομαι" strong="G2064">came</char> <char style="w" x-id="t007" x-align="1CO.2.1.a004" x-src="SBLGNT.1CO.2.1.003" x-source="πρὸς" x-translit="pros" srcloc="SBLGNT.1CO.2.1.003" x-head="true" lemma="πρός" strong="G4314">unto</char> <char style="w" x-id="t008" x-align="1CO.2.1.a005" x-src="SBLGNT.1CO.2.1.004" x-source="ὑμᾶς" x-translit="hymas" srcloc="SBLGNT.1CO.2.1.004" x-head="true" lemma="σύ" strong="G5209">you</char>, <char style="w" x-id="t009" x-align="1CO.2.1.a006" x-src="SBLGNT.1CO.2.1.006" x-source="ἦλθον" x-translit="ēlthon" srcloc="SBLGNT.1CO.2.1.006" x-head="true" lemma="ἔρχομαι" strong="G2064">came</char> <char style="w" x-id="t010" x-align="1CO.2.1.a007" x-src="SBLGNT.1CO.2.1.007" x-source="οὐ" x-translit="ou" srcloc="SBLGNT.1CO.2.1.007" x-head="true" lemma="οὐ" strong="G3756">not</char> <char style="w" x-id="t011" x-align="1CO.2.1.a008" x-src="SBLGNT.1CO.2.1.008" x-source="καθ" x-translit="kath" srcloc="SBLGNT.1CO.2.1.008" x-head="true" lemma="κατά" strong="G2596">with</char> <char style="w" x-id="t012" x-align="1CO.2.1.a009" x-src="SBLGNT.1CO.2.1.009" x-source=