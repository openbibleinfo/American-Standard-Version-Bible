	<para style="p"><char style="w" x-id="t001" x-align="1CO.5.1.a002">It</char> <char style="w" x-id="t002" x-align="1CO.5.1.a002">is</char> <char style="w" x-id="t003" x-align="1CO.5.1.a001" x-src="SBLGNT.1CO.5.1.001" x-source="Ὅλως" x-translit="Holōs" srcloc="SBLGNT.1CO.5.1.001" x-head="true" lemma="ὅλως" strong="G3654">actually</char> <char style="w" x-id="t004" x-align="1CO.5.1.a002" x-src="SBLGNT.1CO.5.1.002" x-source="ἀκούεται" x-translit="akouetai" srcloc="SBLGNT.1CO.5.1.002" x-head="true" lemma="ἀκούω" strong="G191">reported</char> <char style="w" x-id="t005" x-align="1CO.5.1.a003">that</char> <char style="w" x-id="t006" x-align="1CO.5.1.a003">there</char> <char style="w" x-id="t007" x-align="1CO.5.1.a003">is</char> <char style="w" x-id="t008" x-align="1CO.5.1.a003" x-src="SBLGNT.1CO.5.1.005" x-source="πορνεία" x-translit="porneia" srcloc="SBLGNT.1CO.5.1.005" x-head="true" lemma="πορνεία" strong="G4202">fornication</char> <char style="w" x-id="t009" x-align="1CO.5.1.a004" x-src="SBLGNT.1CO.5.1.003" x-source="ἐν" x-translit="en" srcloc="SBLGNT.1CO.5.1.003" x-head="true" lemma="ἐν" strong="G1722">among</char> <char style="w" x-id="t010" x-align="1CO.5.1.a005" x-src="SBLGNT.1CO.5.1.004" x-source="ὑμῖν" x-translit="hymin" srcloc="SBLGNT.1CO.5.1.004" x-head="true" lemma="σύ" strong="G5213">you</char>, <char style="w" x-id="t011" x-align="1CO.5.1.a006" x-src="SBLGNT.1CO.5.1.006" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1CO.5.1.006" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t012" x-align="1CO.5.1.a007" x-src="SBLGNT.1CO.5.1.007" x-source="τοιαύτη" x-translit="toiautē" srcloc="SBLGNT.1CO.5.1.007" x-head="true" lemma="τοιοῦτος" strong="G5108">such</char> <char style="w" x-id="t013" x-align="1CO.5.1.a008" x-src="SBLGNT.1CO.5.1.008" x-source="πορνεία" x-translit="porneia" srcloc="SBLGNT.1CO.5.1.008" x-head="true" lemma="πορνεία" strong="G4202">fornication</char> <char style="w" x-id="t014" x-align="1CO.5.1.a009" x-src="SBLGNT.1CO.5.1