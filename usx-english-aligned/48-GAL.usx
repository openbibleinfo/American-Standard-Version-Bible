	<para style="p"><verse number="1" style="v" x-unrepresented-source="τοῦ" x-unrepresented-translit="tou" x-unrepresented-src="SBLGNT.GAL.1.1.016" sid="GAL 1:1" /><char style="w" x-id="t001" x-align="GAL.1.1.a001" x-src="SBLGNT.GAL.1.1.001" x-source="Παῦλος" x-translit="Paulos" srcloc="SBLGNT.GAL.1.1.001" x-head="true" lemma="Παῦλος" strong="G3972">Paul</char>, <char style="w" x-id="t002" x-align="GAL.1.1.a002">an</char> <char style="w" x-id="t003" x-align="GAL.1.1.a002" x-src="SBLGNT.GAL.1.1.002" x-source="ἀπόστολος" x-translit="apostolos" srcloc="SBLGNT.GAL.1.1.002" x-head="true" lemma="ἀπόστολος" strong="G652">apostle</char> (<char style="w" x-id="t004" x-align="GAL.1.1.a003" x-src="SBLGNT.GAL.1.1.003" x-source="οὐκ" x-translit="ouk" srcloc="SBLGNT.GAL.1.1.003" x-head="true" lemma="οὐ" strong="G3756">not</char> <char style="w" x-id="t005" x-align="GAL.1.1.a004" x-src="SBLGNT.GAL.1.1.004" x-source="ἀπ" x-translit="ap" srcloc="SBLGNT.GAL.1.1.004" x-head="true" lemma="ἀπό" strong="G575">from</char> <char style="w" x-id="t006" x-align="GAL.1.1.a005" x-src="SBLGNT.GAL.1.1.005" x-source="ἀνθρώπων" x-translit="anthrōpōn" srcloc="SBLGNT.GAL.1.1.005" x-head="true" lemma="ἄνθρωπος" strong="G444">men</char>, <char style="w" x-id="t007" x-align="GAL.1.1.a006" x-src="SBLGNT.GAL.1.1.006" x-source="οὐδὲ" x-translit="oude" srcloc="SBLGNT.GAL.1.1.006" x-head="true" lemma="οὐδέ" strong="G3761">neither</char> <char style="w" x-id="t008" x-align="GAL.1.1.a007" x-src="SBLGNT.GAL.1.1.007" x-source="δι" x-translit="di" srcloc="SBLGNT.GAL.1.1.007" x-head="true" lemma="διά" strong="G1223">through</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">a man</char></char></note><char style="w" x-id="t009" x-align="GAL.1.1.a008" x-src="SBLGNT.GAL.1.1.008" x-source="ἀνθρώπου" x-translit="anthrōpou" srcloc="SBLGNT.GAL.1.1.008" x-head="true" lemma="ἄνθρωπος" strong="G444">man</char>, <char style="w" x-id="t010" x-align="GAL.1.1.a009" x-src="SBLGNT.GAL.1.1.009" x-source="ἀλλὰ" x