	<para style="p"><verse number="18" style="v" x-unrepresented-source="τοῦ τοῦ" x-unrepresented-translit="tou tou" x-unrepresented-src="SBLGNT.GAL.6.18.003 SBLGNT.GAL.6.18.009" sid="GAL 6:18" /><char style="w" x-id="t001" x-align="GAL.6.18.a001" x-src="SBLGNT.GAL.6.18.001" x-source="Ἡ" x-translit="Hē" srcloc="SBLGNT.GAL.6.18.001" x-head="true" lemma="ὁ" strong="G3588">The</char> <char style="w" x-id="t002" x-align="GAL.6.18.a002" x-src="SBLGNT.GAL.6.18.002" x-source="χάρις" x-translit="charis" srcloc="SBLGNT.GAL.6.18.002" x-head="true" lemma="χάρις" strong="G5485">grace</char> <char style="w" x-id="t003" x-align="GAL.6.18.a004">of</char> <char style="w" x-id="t004" x-align="GAL.6.18.a005" x-src="SBLGNT.GAL.6.18.005" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.GAL.6.18.005" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t005" x-align="GAL.6.18.a004" x-src="SBLGNT.GAL.6.18.004" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.GAL.6.18.004" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t006" x-align="GAL.6.18.a006" x-src="SBLGNT.GAL.6.18.006" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.GAL.6.18.006" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t007" x-align="GAL.6.18.a007" x-src="SBLGNT.GAL.6.18.007" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.GAL.6.18.007" x-head="true" lemma="Χριστός" strong="G5547">Christ</char> <char style="w" x-id="t008" x-align="GAL.6.18.a008">be</char> <char style="w" x-id="t009" x-align="GAL.6.18.a008" x-src="SBLGNT.GAL.6.18.008" x-source="μετὰ" x-translit="meta" srcloc="SBLGNT.GAL.6.18.008" x-head="true" lemma="μετά" strong="G3326">with</char> <char style="w" x-id="t010" x-align="GAL.6.18.a011" x-src="SBLGNT.GAL.6.18.011" x-source="ὑμῶν" x-translit="hymōn" srcloc="SBLGNT.GAL.6.18.011" x-head="true" lemma="σύ" strong="G5216">your</char> <char style="w" x-id="t011" x-align="GAL.6.18.a010" x-src="SBLGNT.GAL.6.18.010" x-source="