	<para style="p"><verse number="1" style="v" sid="EPH 1:1" /><char style="w" x-id="t001" x-align="EPH.1.1.a001" x-src="SBLGNT.EPH.1.1.001" x-source="Παῦλος" x-translit="Paulos" srcloc="SBLGNT.EPH.1.1.001" x-head="true" lemma="Παῦλος" strong="G3972">Paul</char>, <char style="w" x-id="t002" x-align="EPH.1.1.a002">an</char> <char style="w" x-id="t003" x-align="EPH.1.1.a002" x-src="SBLGNT.EPH.1.1.002" x-source="ἀπόστολος" x-translit="apostolos" srcloc="SBLGNT.EPH.1.1.002" x-head="true" lemma="ἀπόστολος" strong="G652">apostle</char> <char style="w" x-id="t004" x-align="EPH.1.1.a003">of</char> <char style="w" x-id="t005" x-align="EPH.1.1.a003" x-src="SBLGNT.EPH.1.1.003" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.EPH.1.1.003" x-head="true" lemma="Χριστός" strong="G5547">Christ</char> <char style="w" x-id="t006" x-align="EPH.1.1.a004" x-src="SBLGNT.EPH.1.1.004" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.EPH.1.1.004" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t007" x-align="EPH.1.1.a005" x-src="SBLGNT.EPH.1.1.005" x-source="διὰ" x-translit="dia" srcloc="SBLGNT.EPH.1.1.005" x-head="true" lemma="διά" strong="G1223">through</char> <char style="w" x-id="t008" x-align="EPH.1.1.a006">the</char> <char style="w" x-id="t009" x-align="EPH.1.1.a006" x-src="SBLGNT.EPH.1.1.006" x-source="θελήματος" x-translit="thelēmatos" srcloc="SBLGNT.EPH.1.1.006" x-head="true" lemma="θέλημα" strong="G2307">will</char> <char style="w" x-id="t010" x-align="EPH.1.1.a007">of</char> <char style="w" x-id="t011" x-align="EPH.1.1.a007" x-src="SBLGNT.EPH.1.1.007" x-source="θεοῦ" x-translit="theou" srcloc="SBLGNT.EPH.1.1.007" x-head="true" lemma="θεός" strong="G2316">God</char>, <char style="w" x-id="t012" x-align="EPH.1.1.a008">to</char> <char style="w" x-id="t013" x-align="EPH.1.1.a008" x-src="SBLGNT.EPH.1.1.008" x-source="τοῖς" x-translit="tois" srcloc="SBLGNT.EPH.1.1.008" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t014" x-