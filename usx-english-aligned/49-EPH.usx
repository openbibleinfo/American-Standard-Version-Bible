 x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.EPH.1.1.018" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char>: <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" /><char style="w" x-id="t001" x-align="EPH.1.2.a001" x-src="SBLGNT.EPH.1.2.001" x-source="χάρις" x-translit="charis" srcloc="SBLGNT.EPH.1.2.001" x-head="true" lemma="χάρις" strong="G5485">Grace</char> <char style="w" x-id="t002" x-align="EPH.1.2.a002">to</char> <char style="w" x-id="t003" x-align="EPH.1.2.a002" x-src="SBLGNT.EPH.1.2.002" x-source="ὑμῖν" x-translit="hymin" srcloc="SBLGNT.EPH.1.2.002" x-head="true" lemma="σύ" strong="G5213">you</char> <char style="w" x-id="t004" x-align="EPH.1.2.a003" x-src="SBLGNT.EPH.1.2.003" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.EPH.1.2.003" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t005" x-align="EPH.1.2.a004" x-src="SBLGNT.EPH.1.2.004" x-source="εἰρήνη" x-translit="eirēnē" srcloc="SBLGNT.EPH.1.2.004" x-head="true" lemma="εἰρήνη" strong="G1515">peace</char> <char style="w" x-id="t006" x-align="EPH.1.2.a005" x-src="SBLGNT.EPH.1.2.005" x-source="ἀπὸ" x-translit="apo" srcloc="SBLGNT.EPH.1.2.005" x-head="true" lemma="ἀπό" strong="G575">from</char> <char style="w" x-id="t007" x-align="EPH.1.2.a006" x-src="SBLGNT.EPH.1.2.006" x-source="θεοῦ" x-translit="theou" srcloc="SBLGNT.EPH.1.2.006" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t008" x-align="EPH.1.2.a007" x-src="SBLGNT.EPH.1.2.008" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.EPH.1.2.008" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t009" x-align="EPH.1.2.a008" x-src="SBLGNT.EPH.1.2.007" x-source="πατρὸς" x-translit="patros" srcloc="SBLGNT.EPH.1.2.007" x-head="true" lemma="πατήρ" strong="G3962">Father</char> <char style="w" x-id="t010" x-align="EPH.1.2.a009" x-src="SBLGNT.EPH.1.2.009" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.EPH.1.2.009" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t011" x-align="EPH.1.2.a010">the</char> <char style="w" x-id="t012" x-align="EPH.1.2.a010" x-src="SBLGNT.EPH.1.2.010" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.EPH.1.2.010" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t013" x-align="EPH.1.2.a011" x-src="SBLGNT.EPH.1.2.011" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.EPH.1.2.011" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t014" x-align="EPH.1.2.a012" x-src="SBLGNT.EPH.1.2.012" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.EPH.1.2.012" x-head="true" lemma="Χριστός" strong="G5547">Christ</char>.<verse eid="EPH 1:2" /></para>
	<para style="b"><verse number="3" style="v" x-unrepresented-source="τοῦ" x-unrepresented-translit="tou" x-unrepresented-src="SBLGNT.EPH.1.3.006" sid="EPH 1:3" /></para>
	<para style="p"><char style="w" x-id="t001" x-align="EPH.1.3.a001" x-src="SBLGNT.EPH.1.3.001" x-source="Εὐλογητὸς" x-translit="Eulogētos" srcloc="SBLGNT.EPH.1.3.001" x-head="true" lemma="εὐλογητός" strong="G2128">Blessed</char> <char style="add"><char style="w" x-id="t002" x-align="EPH.1.3.a001">be</char></char> <note caller="-" style="f"><char style="ft">Or, <char style="it">God and the Father</char>. See <ref loc="ROM 15:6">Rom. 15:6</ref> margin.</char></note><char style="w" x-id="t003" x-align="EPH.1.3.a002" x-src="SBLGNT.EPH.1.3.002" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.EPH.1.3.002" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t004" x-align="EPH.1.3.a003" x-src="SBLGNT.EPH.1.3.003" x-source="θεὸς" x-translit="theos" srcloc="SBLGNT.EPH.1.3.003" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t005" x-align="EPH.1.3.a004" x-src="SBLGNT.EPH.1.3.004" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.EPH.1.3.004" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t006" x-align="EPH.1.3.a005" x-src="SBLGNT.EPH.1.3.005" x-source="πατὴρ" x-translit="patēr" srcloc="SBLGNT.EPH.1.3.005" x-head="true" lemma="πατήρ" strong="G3962">Father</char> <char style="w" x-id="t007" x-align="EPH.1.3.a007">of</char> <char style="w" x-id="t008" x-align="EPH.1.3.a008" x-src="SBLGNT.EPH.1.3.008" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.EPH.1.3.008" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t009" x-align="EPH.1.3.a007" x-src="SBLGNT.EPH.1.3.007" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.EPH.1.3.007" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t010" x-align="EPH.1.3.a009" x-src="SBLGNT.EPH.1.3.009" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.EPH.1.3.009" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t011" x-align="EPH.1.3.a010" x-src="SBLGNT.EPH.1.3.010" x-source="Χριστοῦ" x-translit="Ch