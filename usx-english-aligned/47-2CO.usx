	<para style="p"><verse number="1" style="v" sid="2CO 12:1" /><note caller="-" style="f"><char style="ft">Some ancient authorities read <char style="it">Now to glory is not expedient, but I will come etc.</char></char></note><char style="w" x-id="t001" x-align="2CO.12.1.a002">I</char> <char style="w" x-id="t002" x-align="2CO.12.1.a002" x-src="SBLGNT.2CO.12.1.002" x-source="δεῖ" x-translit="dei" srcloc="SBLGNT.2CO.12.1.002" x-head="true" lemma="δέω" strong="G1210">must</char> <char style="w" x-id="t003" x-align="2CO.12.1.a002">needs</char> <char style="w" x-id="t004" x-align="2CO.12.1.a001" x-src="SBLGNT.2CO.12.1.001" x-source="Καυχᾶσθαι" x-translit="Kauchasthai" srcloc="SBLGNT.2CO.12.1.001" x-head="true" lemma="καυχάομαι" strong="G2744">glory</char>, <char style="w" x-id="t005" x-align="2CO.12.1.a005" x-src="SBLGNT.2CO.12.1.005" x-source="μέν" x-translit="men" srcloc="SBLGNT.2CO.12.1.005" x-head="true" lemma="μέν" strong="G3303">though</char> <char style="w" x-id="t006" x-align="2CO.12.1.a004">it</char> <char style="w" x-id="t007" x-align="2CO.12.1.a004">is</char> <char style="w" x-id="t008" x-align="2CO.12.1.a003" x-src="SBLGNT.2CO.12.1.003" x-source="οὐ" x-translit="ou" srcloc="SBLGNT.2CO.12.1.003" x-head="true" lemma="οὐ" strong="G3756">not</char> <char style="w" x-id="t009" x-align="2CO.12.1.a004" x-src="SBLGNT.2CO.12.1.004" x-source="συμφέρον" x-translit="sympheron" srcloc="SBLGNT.2CO.12.1.004" x-head="true" lemma="συμφέρω" strong="G4851">expedient</char>; <char style="w" x-id="t010" x-align="2CO.12.1.a007" x-src="SBLGNT.2CO.12.1.007" x-source="δὲ" x-translit="de" srcloc="SBLGNT.2CO.12.1.007" x-head="true" lemma="δέ" strong="G1161">but</char> <char style="w" x-id="t011" x-align="2CO.12.1.a006">I</char> <char style="w" x-id="t012" x-align="2CO.12.1.a006">will</char> <char style="w" x-id="t013" x-align="2CO.12.1.a006" x-src="SBLGNT.2CO.12.1.006" x-source="ἐλεύσομαι" x-translit="eleusomai" srcloc="SBLGNT.2CO.12.1.006" x-head="true" lemma="ἔρχομαι" strong="G2064">c