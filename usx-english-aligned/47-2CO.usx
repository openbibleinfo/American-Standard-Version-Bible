	<para style="p"><char style="w" x-id="t001" x-align="2CO.1.3.a001" x-src="SBLGNT.2CO.1.3.001" x-source="Εὐλογητὸς" x-translit="Eulogētos" srcloc="SBLGNT.2CO.1.3.001" x-head="true" lemma="εὐλογητός" strong="G2128">Blessed</char> <char style="add"><char style="w" x-id="t002" x-align="2CO.1.3.a001">be</char></char> <note caller="-" style="f"><char style="ft">Or, <char style="it">God and the Father</char>. See <ref loc="ROM 15:6">Rom. 15:6</ref> margin.</char></note><char style="w" x-id="t003" x-align="2CO.1.3.a002" x-src="SBLGNT.2CO.1.3.002" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.2CO.1.3.002" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t004" x-align="2CO.1.3.a003" x-src="SBLGNT.2CO.1.3.003" x-source="θεὸς" x-translit="theos" srcloc="SBLGNT.2CO.1.3.003" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t005" x-align="2CO.1.3.a004" x-src="SBLGNT.2CO.1.3.004" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.2CO.1.3.004" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t006" x-align="2CO.1.3.a005" x-src="SBLGNT.2CO.1.3.005" x-source="πατὴρ" x-translit="patēr" srcloc="SBLGNT.2CO.1.3.005" x-head="true" lemma="πατήρ" strong="G3962">Father</char> <char style="w" x-id="t007" x-align="2CO.1.3.a007">of</char> <char style="w" x-id="t008" x-align="2CO.1.3.a008" x-src="SBLGNT.2CO.1.3.008" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.2CO.1.3.008" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t009" x-align="2CO.1.3.a007" x-src="SBLGNT.2CO.1.3.007" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.2CO.1.3.007" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t010" x-align="2CO.1.3.a009" x-src="SBLGNT.2CO.1.3.009" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.2CO.1.3.009" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t011" x-align="2CO.1.3.a010" x-src="SBLGNT.2CO.1.3.010" x-source="Χριστοῦ" x-translit="Ch