	<para style="p"><verse number="13" style="v" sid="2CO 13:13" /><char style="w" x-id="t001" x-align="2CO.13.13.a005" x-src="SBLGNT.2CO.13.12.010" x-source="πάντες" x-translit="pantes" srcloc="SBLGNT.2CO.13.12.010" x-head="true" lemma="πᾶς" strong="G3956">All</char> <char style="w" x-id="t002" x-align="2CO.13.13.a003" x-src="SBLGNT.2CO.13.12.008" x-source="οἱ" x-translit="hoi" srcloc="SBLGNT.2CO.13.12.008" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t003" x-align="2CO.13.13.a004" x-src="SBLGNT.2CO.13.12.009" x-source="ἅγιοι" x-translit="hagioi" srcloc="SBLGNT.2CO.13.12.009" x-head="true" lemma="ἅγιος" strong="G40">saints</char> <char style="w" x-id="t004" x-align="2CO.13.13.a001" x-src="SBLGNT.2CO.13.12.006" x-source="ἀσπάζονται" x-translit="aspazontai" srcloc="SBLGNT.2CO.13.12.006" x-head="true" lemma="ἀσπάζομαι" strong="G782">salute</char> <char style="w" x-id="t005" x-align="2CO.13.13.a002" x-src="SBLGNT.2CO.13.12.007" x-source="ὑμᾶς" x-translit="hymas" srcloc="SBLGNT.2CO.13.12.007" x-head="true" lemma="σύ" strong="G5209">you</char>.<verse eid="2CO 13:13" /></para>
