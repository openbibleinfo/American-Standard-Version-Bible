	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="ISA 52:11">Isa. 52:11</ref>.</char></note><char style="w" x-id="t002" x-align="2CO.6.17.a002" x-src="SBLGNT.2CO.6.17.002" x-source="ἐξέλθατε" x-translit="exelthate" srcloc="SBLGNT.2CO.6.17.002" x-head="true" lemma="ἐξέρχομαι" strong="G1831">Come</char> <char style="w" x-id="t003" x-align="2CO.6.17.a002">ye</char> <char style="w" x-id="t004" x-align="2CO.6.17.a002">out</char> <char style="w" x-id="t005" x-align="2CO.6.17.a003" x-src="SBLGNT.2CO.6.17.003" x-source="ἐκ" x-translit="ek" srcloc="SBLGNT.2CO.6.17.003" x-head="true" lemma="ἐκ" strong="G1537">from</char> <char style="w" x-id="t006" x-align="2CO.6.17.a004" x-src="SBLGNT.2CO.6.17.004" x-source="μέσου" x-translit="mesou" srcloc="SBLGNT.2CO.6.17.004" x-head="true" lemma="μέσος" strong="G3319">among</char> <char style="w" x-id="t007" x-align="2CO.6.17.a005" x-src="SBLGNT.2CO.6.17.005" x-source="αὐτῶν" x-translit="autōn" srcloc="SBLGNT.2CO.6.17.005" x-head="true" lemma="αὐτός" strong="G846">them</char>, <char style="w" x-id="t008" x-align="2CO.6.17.a006" x-src="SBLGNT.2CO.6.17.006" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.2CO.6.17.006" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t009" x-align="2CO.6.17.a007">be</char> <char style="w" x-id="t010" x-align="2CO.6.17.a007">ye</char> <char style="w" x-id="t011" x-align="2CO.6.17.a007" x-src="SBLGNT.2CO.6.17.007" x-source="ἀφορίσθητε" x-translit="aphoristhēte" srcloc="SBLGNT.2CO.6.17.007" x-head="true" lemma="ἀφορίζω" strong="G873">separate</char>,</para>
