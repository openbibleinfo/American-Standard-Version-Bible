	<para style="p"><verse number="2" style="v" x-unrepresented-source="ἡ" x-unrepresented-translit="hē" x-unrepresented-src="SBLGNT.3JN.1.2.012" sid="3JN 1:2" /><char style="w" x-id="t001" x-align="3JN.1.2.a001" x-src="SBLGNT.3JN.1.2.001" x-source="Ἀγαπητέ" x-translit="Agapēte" srcloc="SBLGNT.3JN.1.2.001" x-head="true" lemma="ἀγαπητός" strong="G27">Beloved</char>, <char style="w" x-id="t002" x-align="3JN.1.2.a004">I</char> <char style="w" x-id="t003" x-align="3JN.1.2.a004" x-src="SBLGNT.3JN.1.2.004" x-source="εὔχομαί" x-translit="euchomai" srcloc="SBLGNT.3JN.1.2.004" x-head="true" lemma="εὔχομαι" strong="G2172">pray</char> <char style="w" x-id="t004" x-align="3JN.1.2.a006">that</char> <char style="w" x-id="t005" x-align="3JN.1.2.a002" x-src="SBLGNT.3JN.1.2.002" x-source="περὶ" x-translit="peri" srcloc="SBLGNT.3JN.1.2.002" x-head="true" lemma="περί" strong="G4012">in</char> <char style="w" x-id="t006" x-align="3JN.1.2.a003" x-src="SBLGNT.3JN.1.2.003" x-source="πάντων" x-translit="pantōn" srcloc="SBLGNT.3JN.1.2.003" x-head="true" lemma="πᾶς" strong="G3956">all</char> <char style="w" x-id="t007" x-align="3JN.1.2.a003">things</char> <char style="w" x-id="t008" x-align="3JN.1.2.a005" x-src="SBLGNT.3JN.1.2.005" x-source="σε" x-translit="se" srcloc="SBLGNT.3JN.1.2.005" x-head="true" lemma="σύ" strong="G4571">thou</char> <char style="w" x-id="t009" x-align="3JN.1.2.a006">mayest</char> <char style="w" x-id="t010" x-align="3JN.1.2.a006" x-src="SBLGNT.3JN.1.2.006" x-source="εὐοδοῦσθαι" x-translit="euodousthai" srcloc="SBLGNT.3JN.1.2.006" x-head="true" lemma="εὐοδόομαι" strong="G2137">prosper</char> <char style="w" x-id="t011" x-align="3JN.1.2.a007" x-src="SBLGNT.3JN.1.2.007" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.3JN.1.2.007" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t012" x-align="3JN.1.2.a008">be</char> <char style="w" x-id="t013" x-align="3JN.1.2.a008">in</char> <char style="w" x-id="t014" x-align="3JN.1.2.a008" x-src="SBLGNT.3JN.1.2.008" x-source="ὑγιαίνειν" x-translit="hygiainein" srcloc="SBLGNT.3JN.1.2.008" x-head="true" lemma="ὑγιαίνω" strong="G5198">health</char>, <char style="w" x-id="t015" x-align="3JN.1.2.a009">even</char> <char style="w" x-id="t016" x-align="3JN.1.2.a009" x-src="SBLGNT.3JN.1.2.009" x-source="καθὼς" x-translit="kathōs" srcloc="SBLGNT.3JN.1.2.009" x-head="true" lemma="καθώς" strong="G2531">as</char> <char style="w" x-id="t017" x-align="3JN.1.2.a011" x-src="SBLGNT.3JN.1.2.011" x-source="σου" x-translit="sou" srcloc="SBLGNT.3JN.1.2.011" x-head="true" lemma="σύ" strong="G4675">thy</char> <char style="w" x-id="t018" x-align="3JN.1.2.a013" x-src="SBLGNT.3JN.1.2.013" x-source="ψυχή" x-translit="psychē" srcloc="SBLGNT.3JN.1.2.013" x-head="true" lemma="ψυχή" strong="G5590">soul</char> <char style="w" x-id="t019" x-align="3JN.1.2.a010" x-src="SBLGNT.3JN.1.2.010" x-source="εὐοδοῦταί" x-translit="euodoutai" srcloc="SBLGNT.3JN.1.2.010" x-head="true" lemma="εὐοδόομαι" strong="G2137">prospereth</char>. <verse eid="3JN 1:2" /><verse number="3" style="v" x-unrepresented-source="τῇ" x-unrepresented-translit="tēi" x-unrepresented-src="SBLGNT.3JN.1.3.009" sid="3JN 1:3" /><char style="w" x-id="t001" x-align="3JN.1.3.a002" x-src="SBLGNT.3JN.1.3.002" x-source="γὰρ" x-translit="gar" srcloc="SBLGNT.3JN.1.3.002" x-head="true" lemma="γάρ" strong="G1063">For</char> <char style="w" x-id="t002" x-align="3JN.1.3.a001">I</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">rejoice greatly, when brethren come and bear witness</char></char></note><char style="w" x-id="t003" x-align="3JN.1.3.a001" x-src="SBLGNT.3JN.1.3.001" x-source="ἐχάρην" x-translit="echarēn" srcloc="SBLGNT.3JN.1.3.001" x-head="true" lemma="χαίρω" strong="G5463">rejoiced</char> <char style="w" x-id="t004" x-align="3JN.1.3.a003" x-src="SBLGNT.3JN.1.3.003" x-source="λίαν" x-translit="lian" srcloc="SBLGNT.3JN.1.3.003" x-head="true" lemma="λίαν" strong="G3029">greatly</char>, <char style="w" x-id="t005" x-align="3JN.1.3.a004">when</char> <char style="w" x-id="t006" x-align="3JN.1.3.a005" x-src="SBLGNT.3JN.1.3.005" x-source="ἀδελφῶν" x-translit="adelphōn" srcloc="SBLGNT.3JN.1.3.005" x-head="true" lemma="ἀδελφός" strong="G80">brethren</char> <char style="w" x-id="t007" x-align="3JN.1.3.a004" x-src="SBLGNT.3JN.1.3.004" x-source="ἐρχομένων" x-translit="erchomenōn" srcloc="SBLGNT.3JN.1.3.004" x-head="true" lemma="ἔρχομαι" strong="G2064">came</char> <char style="w" x-id="t008" x-align="3JN.1.3.a006" x-src="SBLGNT.3JN.1.3.006" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.3JN.1.3.006" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t009" x-align="3JN.1.3.a007">bare</char> <char style="w" x-id="t010" x-align="3JN.1.3.a007" x-src="SBLGNT.3JN.1.3.007" x-source="μαρτυρούντων" x-translit="martyrountōn" srcloc="SBLGNT.3JN.1.3.007" x-head="true" lemma="μαρτυρέω" strong="G3140">witness</char> <char style="w" x-id="t011" x-align="3JN.1.3.a010">unto</char> <char style="w" x-id="t012" x-align="3JN.1.3.a008" x-src="SBLGNT.3JN.1.3.008" x-source="σου" x-translit="sou" srcloc="SBLGNT.3JN.1.3.008" x-head="true" lemma="σύ" strong="G4675">thy</char> <char style="w" x-id="t013" x-align="3JN.1.3.a010" x-src="SBLGNT.3JN.1.3.010" x-source="ἀληθείᾳ" x-translit="alētheiai" srcloc="SBLGNT.3JN.1.3.010" x-head="true" lemma="ἀλήθεια" strong="G225">truth</char>, <char style="w" x-id="t014" x-align="3JN.1.3.a011">even</char> <char style="w" x-id="t015" x-align="3JN.1.3.a011" x-src="SBLGNT.3JN.1.3.011" x-source="καθὼς" x-translit="kathōs" srcloc="SBLGNT.3JN.1.3.011" x-head="true" lemma="καθώς" strong="G2531">as</char> <char style="w" x-id="t016" x-align="3JN.1.3.a012" x-src="SBLGNT.3JN.1.3.012" x-source="σὺ" x-translit="sy" srcloc="SBLGNT.3JN.1.3.012" x-head="true" lemma="σύ" strong="G4771">thou</char> <char style="w" x-id="t017" x-align="3JN.1.3.a015" x-src="SBLGNT.3JN.1.3.015" x-source="περιπατεῖς" x-translit="peripateis" srcloc="SBLGNT.3JN.1.3.015" x-head="true" lemma="περιπατέω" strong="G4043">walkest</char> <char style="w" x-id="t018" x-align="3JN.1.3.a013" x-src="SBLGNT.3JN.1.3.013" x-source="ἐν" x-translit="en" srcloc="SBLGNT.3JN.1.3.013" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t019" x-align="3JN.1.3.a014" x-src="SBLGNT.3JN.1.3.014" x-source="ἀληθείᾳ" x-translit="alētheiai" srcloc="SBLGNT.3JN.1.3.014" x-head="true" lemma="ἀλήθεια" strong="G225">truth</char>. <verse eid="3JN 1:3" /><verse number="4" style="v" x-unrepresented-source="τὰ" x-unrepresented-translit="ta" x-unrepresented-src="SBLGNT.3JN.1.4.008" sid="3JN 1:4" /><char style="w" x-id="t001" x-align="3JN.1.4.a001" x-src="SBLGNT.3JN.1.4.001" x-source="μειζοτέραν" x-translit="meizoteran" srcloc="SBLGNT.3JN.1.4.001" x-head="true" lemma="μειζότερος" strong="G3186">Greater</char> <char style="w" x-id="t002" x-align="3JN.1.4.a005" x-src="SBLGNT.3JN.1.4.005" x-source="χαράν" x-translit="charan" srcloc="SBLGNT.3JN.1.4.005" x-head="true" lemma="χαρά" strong="G5479">joy</char> <char style="w" x-id="t003" x-align="3JN.1.4.a004" x-src="SBLGNT.3JN.1.4.004" x-source="ἔχω" x-translit="echō" srcloc="SBLGNT.3JN.1.4.004" x-head="true" lemma="ἔχω" strong="G2192">have</char> <char style="w" x-id="t004" x-align="3JN.1.4.a004">I</char> <char style="w" x-id="t005" x-align="3JN.1.4.a003" x-src="SBLGNT.3JN.1.4.003" x-source="οὐκ" x-translit="ouk" srcloc="SBLGNT.3JN.1.4.003" x-head="true" lemma="οὐ" strong="G3756">none</char> <char style="w" x-id="t006" x-align="3JN.1.4.a002">than</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">these</char> things, <char style="it">that I may hear</char></char></note><char style="w" x-id="t007" x-align="3JN.1.4.a002" x-src="SBLGNT.3JN.1.4.002" x-source="τούτων" x-translit="toutōn" srcloc="SBLGNT.3JN.1.4.002" x-head="true" lemma="οὗτος" strong="G5130">this</char>, <char style="w" x-id="t008" x-align="3JN.1.4.a006" x-src="SBLGNT.3JN.1.4.006" x-source="ἵνα" x-translit="hina" srcloc="SBLGNT.3JN.1.4.006" x-head="true" lemma="ἵνα" str