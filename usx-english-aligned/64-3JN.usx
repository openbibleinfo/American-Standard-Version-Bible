	<para style="p"><verse number="1" style="v" sid="3JN 1:1" /><char style="w" x-id="t001" x-align="3JN.1.1.a001" x-src="SBLGNT.3JN.1.1.001" x-source="Ὁ" x-translit="Ho" srcloc="SBLGNT.3JN.1.1.001" x-head="true" lemma="ὁ" strong="G3588">The</char> <char style="w" x-id="t002" x-align="3JN.1.1.a002" x-src="SBLGNT.3JN.1.1.002" x-source="πρεσβύτερος" x-translit="presbyteros" srcloc="SBLGNT.3JN.1.1.002" x-head="true" lemma="πρεσβύτερος" strong="G4245">elder</char> <char style="w" x-id="t003" x-align="3JN.1.1.a003">unto</char> <char style="w" x-id="t004" x-align="3JN.1.1.a003" x-src="SBLGNT.3JN.1.1.003" x-source="Γαΐῳ" x-translit="Gaiōi" srcloc="SBLGNT.3JN.1.1.003" x-head="true" lemma="Γάϊος" strong="G1050">Gaius</char> <char style="w" x-id="t005" x-align="3JN.1.1.a004" x-src="SBLGNT.3JN.1.1.004" x-source="τῷ" x-translit="tōi" srcloc="SBLGNT.3JN.1.1.004" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t006" x-align="3JN.1.1.a005" x-src="SBLGNT.3JN.1.1.005" x-source="ἀγαπητῷ" x-translit="agapētōi" srcloc="SBLGNT.3JN.1.1.005" x-head="true" lemma="ἀγαπητός" strong="G27">beloved</char>, <char style="w" x-id="t007" x-align="3JN.1.1.a006" x-src="SBLGNT.3JN.1.1.006" x-source="ὃν" x-translit="hon" srcloc="SBLGNT.3JN.1.1.006" x-head="true" lemma="ὅς" strong="G3739">whom</char> <char style="w" x-id="t008" x-align="3JN.1.1.a007" x-src="SBLGNT.3JN.1.1.007" x-source="ἐγὼ" x-translit="egō" srcloc="SBLGNT.3JN.1.1.007" x-head="true" lemma="ἐγώ" strong="G1473">I</char> <char style="w" x-id="t009" x-align="3JN.1.1.a008" x-src="SBLGNT.3JN.1.1.008" x-source="ἀγαπῶ" x-translit="agapō" srcloc="SBLGNT.3JN.1.1.008" x-head="true" lemma="ἀγαπάω" strong="G25">love</char> <char style="w" x-id="t010" x-align="3JN.1.1.a009" x-src="SBLGNT.3JN.1.1.009" x-source="ἐν" x-translit="en" srcloc="SBLGNT.3JN.1.1.009" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t011" x-align="3JN.1.1.a010" x-src="SBLGNT.3JN.1.1.010" x-source="ἀληθείᾳ" x-translit="alētheiai" srclo