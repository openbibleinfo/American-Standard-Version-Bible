	<para style="p"><verse number="1" style="v" sid="JUD 1:1" /><note caller="-" style="f"><char style="ft">Greek <char style="it">Judas</char>.</char></note><char style="w" x-id="t001" x-align="JUD.1.1.a001" x-src="SBLGNT.JUD.1.1.001" x-source="Ἰούδας" x-translit="Ioudas" srcloc="SBLGNT.JUD.1.1.001" x-head="true" lemma="Ἰούδας" strong="G2455">Jude</char>, <char style="w" x-id="t002" x-align="JUD.1.1.a002">a</char> <note caller="-" style="f"><char style="ft">Greek <char style="it">bondservant</char>.</char></note><char style="w" x-id="t003" x-align="JUD.1.1.a002" x-src="SBLGNT.JUD.1.1.004" x-source="δοῦλος" x-translit="doulos" srcloc="SBLGNT.JUD.1.1.004" x-head="true" lemma="δοῦλος" strong="G1401">servant</char> <char style="w" x-id="t004" x-align="JUD.1.1.a003">of</char> <char style="w" x-id="t005" x-align="JUD.1.1.a003" x-src="SBLGNT.JUD.1.1.002" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.JUD.1.1.002" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t006" x-align="JUD.1.1.a004" x-src="SBLGNT.JUD.1.1.003" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.JUD.1.1.003" x-head="true" lemma="Χριστός" strong="G5547">Christ</char>, <char style="w" x-id="t007" x-align="JUD.1.1.a005" x-src="SBLGNT.JUD.1.1.006" x-source="δὲ" x-translit="de" srcloc="SBLGNT.JUD.1.1.006" x-head="true" lemma="δέ" strong="G1161">and</char> <char style="w" x-id="t008" x-align="JUD.1.1.a006" x-src="SBLGNT.JUD.1.1.005" x-source="ἀδελφὸς" x-translit="adelphos" srcloc="SBLGNT.JUD.1.1.005" x-head="true" lemma="ἀδελφός" strong="G80">brother</char> <char style="w" x-id="t009" x-align="JUD.1.1.a007">of</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">Jacob</char></char></note><char style="w" x-id="t010" x-align="JUD.1.1.a007" x-src="SBLGNT.JUD.1.1.007" x-source="Ἰακώβου" x-translit="Iakōbou" srcloc="SBLGNT.JUD.1.1.007" x-head="true" lemma="Ἰάκωβος" strong="G2385">James</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">