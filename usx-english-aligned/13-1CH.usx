	<para style="p"><verse number="1" style="v" sid="1CH 2:1" /><char style="w" x-id="t001" x-align="1CH.2.1.a001" x-src="WLC.1CH.2.1.001" x-source="אֵ֖לֶּה" x-translit="ʾēlleh" srcloc="WLC.1CH.2.1.001" x-head="true" lemma="אֵלֶּה" strong="H428">These</char> <char style="w" x-id="t002" x-align="1CH.2.1.a002">are</char> <char style="w" x-id="t003" x-align="1CH.2.1.a002">the</char> <char style="w" x-id="t004" x-align="1CH.2.1.a002" x-src="WLC.1CH.2.1.002" x-source="בְּנֵ֣י" x-translit="bənēy" srcloc="WLC.1CH.2.1.002" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t005" x-align="1CH.2.1.a003">of</char> <char style="w" x-id="t006" x-align="1CH.2.1.a003" x-src="WLC.1CH.2.1.003" x-source="יִשְׂרָאֵ֑ל" x-translit="yiśrāʾēl" srcloc="WLC.1CH.2.1.003" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>: <char style="w" x-id="t007" x-align="1CH.2.1.a004" x-src="WLC.1CH.2.1.004" x-source="רְאוּבֵ֤ן" x-translit="rəʾûḇēn" srcloc="WLC.1CH.2.1.004" x-head="true" lemma="רְאוּבֵן" strong="H7205">Reuben</char>, <char style="w" x-id="t008" x-align="1CH.2.1.a005" x-src="WLC.1CH.2.1.005" x-source="שִׁמְעוֹן֙" x-translit="šimʿôn" srcloc="WLC.1CH.2.1.005" x-head="true" lemma="שִׁמְעוֹן" strong="H8095">Simeon</char>, <char style="w" x-id="t009" x-align="1CH.2.1.a006" x-src="WLC.1CH.2.1.006" x-source="לֵוִ֣י" x-translit="lēwiy" srcloc="WLC.1CH.2.1.006" x-head="true" lemma="לֵוִי" strong="H3878">Levi</char>, <char style="w" x-id="t010" x-align="1CH.2.1.a007" x-src="WLC.1CH.2.1.007" x-source="וִ" x-translit="wi" srcloc="WLC.1CH.2.1.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t011" x-align="1CH.2.1.a008" x-src="WLC.1CH.2.1.008" x-source="יהוּדָ֔ה" x-translit="yhûḏāh" srcloc="WLC.1CH.2.1.008" x-head="true" lemma="יְהוּדָה" strong="H3063">Judah</char>, <char style="w" x-id="t012" x-align="1CH.2.1.a009" x-src="WLC.1CH.2.1.009" x-source="יִשָׂשכָ֖ר" x-translit="yiśās̄ḵār" srcloc="WLC.1CH.2.1.009" x-head="true" lemma="יִשָּׂשכָר"