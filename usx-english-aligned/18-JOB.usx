	<para style="q1"><char style="w" x-id="t012" x-align="JOB.4.16.a007">A</char> <char style="w" x-id="t013" x-align="JOB.4.16.a007" x-src="WLC.JOB.4.16.007" x-source="תְּ֭מוּנָה" x-translit="təmûnâ" srcloc="WLC.JOB.4.16.007" x-head="true" lemma="תְּמוּנָה" strong="H8544">form</char> <char style="w" x-id="t014" x-align="JOB.4.16.a008">was</char> <char style="w" x-id="t015" x-align="JOB.4.16.a008" x-src="WLC.JOB.4.16.008 WLC.JOB.4.16.009" x-source="לְ נֶ֣גֶד" x-translit="lə neḡeḏ" srcloc="WLC.JOB.4.16.009" x-head="true" lemma="נֶגֶד" strong="H5048">before</char> <char style="w" x-id="t016" x-align="JOB.4.16.a010" x-src="WLC.JOB.4.16.011" x-source="י" x-translit="āy" srcloc="WLC.JOB.4.16.011" x-head="true" lemma="הוּא" strong="H2967a">mine</char> <char style="w" x-id="t017" x-align="JOB.4.16.a009" x-src="WLC.JOB.4.16.010" x-source="עֵינָ֑" x-translit="ʿēyn" srcloc="WLC.JOB.4.16.010" x-head="true" lemma="עַיִן" strong="H5869">eyes</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">I heard a still voice</char></char></note><char style="add"><char style="w" x-id="t018" x-align="JOB.4.16.a011">There</char> <char style="w" x-id="t019" x-align="JOB.4.16.a011">was</char></char> <char style="w" x-id="t020" x-align="JOB.4.16.a011" x-src="WLC.JOB.4.16.012" x-source="דְּמָמָ֖ה" x-translit="dəmāmāh" srcloc="WLC.JOB.4.16.012" x-head="true" lemma="דְּמָמָה" strong="H1827">silence</char>, <char style="w" x-id="t021" x-align="JOB.4.16.a012" x-src="WLC.JOB.4.16.013" x-source="וָ" x-translit="wā" srcloc="WLC.JOB.4.16.013" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t022" x-align="JOB.4.16.a014">I</char> <char style="w" x-id="t023" x-align="JOB.4.16.a014" x-src="WLC.JOB.4.16.015" x-source="אֶשְׁמָֽע" x-translit="ʾešmāʿ:" srcloc="WLC.JOB.4.16.015" x-head="true" lemma="שָׁמַע" strong="H8085">heard</char> <char style="w" x-id="t024" x-align="JOB.4.16.a013">a</char> <char style="w" x-id="t025" x-align="JOB.4.16.a013" x-src="WLC.JOB.4.16.014" x-source="ק֣וֹל" x-translit="qôl" srcloc="WLC.JOB.4.16.014" x-head="true" lemma="קוֹל" strong="H6963">voice</char>, <char style="add"><char style="w" x-id="t026" x-align="JOB.4.16.a015" x-status="added" x-source="∅" x-head="true">saying</char></char>,<verse eid="JOB 4:16" /></para>
	<para style="q1"><verse number="17" style="v" sid="JOB 4:17" /><char style="w" x-id="t001" x-align="JOB.4.17.a001" x-src="WLC.JOB.4.17.001" x-source="הַֽ֭" x-translit="ha" srcloc="WLC.JOB.4.17.001" x-head="true" lemma="הֲ" strong="H1886b">Shall</char> <char style="w" x-id="t002" x-align="JOB.4.17.a002">mortal</char> <char style="w" x-id="t003" x-align="JOB.4.17.a002" x-src="WLC.JOB.4.17.002" x-source="אֱנוֹשׁ" x-translit="ʾĕnôš" srcloc="WLC.JOB.4.17.002" x-head="true" lemma="אֱנוֹשׁ" strong="H582">man</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">be just before God</char></char></note><char style="w" x-id="t004" x-align="JOB.4.17.a005">be</char> <char style="w" x-id="t005" x-align="JOB.4.17.a003">more</char> <char style="w" x-id="t006" x-align="JOB.4.17.a005" x-src="WLC.JOB.4.17.005" x-source="יִצְדָּ֑ק" x-translit="yiṣdāq" srcloc="WLC.JOB.4.17.005" x-head="true" lemma="צָדֵק" strong="H6663">just</char> <char style="w" x-id="t007" x-align="JOB.4.17.a003" x-src="WLC.JOB.4.17.003" x-source="מֵ" x-translit="mē" srcloc="WLC.JOB.4.17.003" x-head="true" lemma="מִן" strong="H4480">than</char> <char style="w" x-id="t008" x-align="JOB.4.17.a004" x-src="WLC.JOB.4.17.004" x-source="אֱל֣וֹהַ" x-translit="ʾĕlôᵃh" srcloc="WLC.JOB.4.17.004" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char>?</para>
	<para style="q1"><char style="w" x-id="t009" x-align="JOB.4.17.a006" x-src="WLC.JOB.4.17.006" x-source="אִ֥ם" x-translit="ʾim" srcloc="WLC.JOB.4.17.006" x-head="true" lemma="אִם" strong="H518">Shall</char> <char style="w" x-id="t010" x-align="JOB.4.17.a011">a</char> <char style="w" x-id="t011" x-align="JOB.4.17.a011" x-src="WLC.JOB.4.17.011" x-source="גָּֽבֶר" x-translit="gāḇer:" srcloc="WLC.JOB.4.17.011" x-head="true" lemma="גֶּבֶר" strong="H1397">man</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">be pure before his Maker</char></char></note><char style="w" x-id="t012" x-align="JOB.4.17.a010">be</char> <char style="w" x-id="t013" x-align="JOB.4.17.a007">more</char> <char style="w" x-id="t014" x-align="JOB.4.17.a010" x-src="WLC.JOB.4.17.010" x-source="יִטְהַר" x-translit="yiṭhar-" srcloc="WLC.JOB.4.17.010" x-head="true" lemma="טָהֵר" strong="H2891">pure</char> <char style="w" x-id="t015" x-align="JOB.4.17.a007" x-src="WLC.JOB.4.17.007" x-source="מֵ֝" x-translit="mē" srcloc="WLC.JOB.4.17.007" x-head="true" lemma="מִן" strong="H4480">than</char> <char style="w" x-id="t016" x-align="JOB.4.17.a009" x-src="WLC.JOB.4.17.009" x-source="הוּ" x-translit="ēhû" srcloc="WLC.JOB.4.17.009" x-head="true" lemma="הוּא" strong="H1930a">his</char> <char style="w" x-id="t017" x-align="JOB.4.17.a008" x-src="WLC.JOB.4.17.008" x-source="עֹשֵׂ֗" x-translit="ʿōś" srcloc="WLC.JOB.4.17.008" x-head="true" lemma="עָשָׂה" strong="H6213">Maker</char>?<verse eid="JOB 4:17" /></para>
