	<para style="q1"><verse number="14" style="v" sid="JOB 35:14" /><char style="w" x-id="t001" x-align="JOB.35.14.a001">How</char> <char style="w" x-id="t002" x-align="JOB.35.14.a001">much</char> <char style="w" x-id="t003" x-align="JOB.35.14.a001" x-src="WLC.JOB.35.14.001" x-source="אַ֣ף" x-translit="ʾap̄" srcloc="WLC.JOB.35.14.001" x-head="true" lemma="אַף" strong="H637">less</char> <char style="w" x-id="t004" x-align="JOB.35.14.a002" x-src="WLC.JOB.35.14.002" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.35.14.002" x-head="true" lemma="כִּי" strong="H3588">when</char> <char style="w" x-id="t005" x-align="JOB.35.14.a003">thou</char> <char style="w" x-id="t006" x-align="JOB.35.14.a003" x-src="WLC.JOB.35.14.003" x-source="תֹ֭אמַר" x-translit="ṯōʾmar" srcloc="WLC.JOB.35.14.003" x-head="true" lemma="אָמַר" strong="H559">sayest</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">thou beholdest him not! The cause is before him; therefore wait thou for him</char></char></note><char style="w" x-id="t007" x-align="JOB.35.14.a005">thou</char> <char style="w" x-id="t008" x-align="JOB.35.14.a005" x-src="WLC.JOB.35.14.005" x-source="תְשׁוּרֶ֑" x-translit="ṯəšûr" srcloc="WLC.JOB.35.14.005" x-head="true" lemma="שׁוּר" strong="H7789">beholdest</char> <char style="w" x-id="t009" x-align="JOB.35.14.a006" x-src="WLC.JOB.35.14.006" x-source="נּוּ" x-translit="ennû" srcloc="WLC.JOB.35.14.006" x-head="true" lemma="הוּא" strong="H5105b">him</char> <char style="w" x-id="t010" x-align="JOB.35.14.a004" x-src="WLC.JOB.35.14.004" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.JOB.35.14.004" x-head="true" lemma="לֹא" strong="H3808">not</char>,</para>
	<para style="q1"><char style="w" x-id="t011" x-align="JOB.35.14.a007">The</char> <char style="w" x-id="t012" x-align="JOB.35.14.a007" x-src="WLC.JOB.35.14.007" x-source="דִּ֥ין" x-translit="diyn" srcloc="WLC.JOB.35.14.007" x-head="true" lemma="דִּין" strong="H1779">cause</char> <char style="w" x-id="t013" x-align="JOB.35.14.a008" x-status="noncompositional">is</char> <char style="w" x-id="t014" x-align="JOB.35.14.a008" x-status="noncompositional" x-src="WLC.JOB.35.14.008 WLC.JOB.35.14.009" x-source="לְ֝ פָנָ֗י" x-translit="lə p̄ānāy" srcloc="WLC.JOB.35.14.009" x-head="true" lemma="פָּנֶה" strong="H6440">before</char> <char style="w" x-id="t015" x-align="JOB.35.14.a009" x-src="WLC.JOB.35.14.010" x-source="ו" x-translit="w" srcloc="WLC.JOB.35.14.010" x-head="true" lemma="הוּא" strong="H2050c">him</char>, <char style="w" x-id="t016" x-align="JOB.35.14.a010" x-src="WLC.JOB.35.14.011" x-source="וּ" x-translit="û" srcloc="WLC.JOB.35.14.011" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t017" x-align="JOB.35.14.a011">thou</char> <char style="w" x-id="t018" x-align="JOB.35.14.a011" x-src="WLC.JOB.35.14.012" x-source="תְח֥וֹלֵֽל" x-translit="ṯəḥôlēl" srcloc="WLC.JOB.35.14.012" x-head="true" lemma="חיל" strong="H2342a">waitest</char> <char style="w" x-id="t019" x-align="JOB.35.14.a012" x-src="WLC.JOB.35.14.013" x-source="לֽ" x-translit="l" srcloc="WLC.JOB.35.14.013" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t020" x-align="JOB.35.14.a013" x-src="WLC.JOB.35.14.014" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.35.14.014" x-head="true" lemma="הוּא" strong="H2050c">him</char>!<verse eid="JOB 35:14" /></para>
	<para style="q1"><verse number="15" style="v" x-unrepresented-source="בַּ [הַ]" x-unrepresented-translit="ba [ha]" x-unrepresented-src="WLC.JOB.35.15.011 WLC.JOB.35.15.012" sid="JOB 35:15" /><char style="w" x-id="t001" x-align="JOB.35.15.a001" x-src="WLC.JOB.35.15.001" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.35.15.001" x-head="true" lemma="וְ" strong="H2050b">But</char> <char style="w" x-id="t002" x-align="JOB.35.15.a002" x-src="WLC.JOB.35.15.002" x-source="עַתָּ֗ה" x-translit="ʿattāh" srcloc="WLC.JOB.35.15.002" x-head="true" lemma="עַתָּה" strong="H6258">now</char>, <char style="w" x-id="t003" x-align="JOB.35.15.a003" x-src="WLC.JOB.35.15.003" x-source="כִּי" x-translit="kî-" srcloc="WLC.JOB.35.15.003" x-head="true" lemma="כִּי" strong="H3588">because</char> <char style="w" x-id="t004" x-align="JOB.35.15.a005">he</char> <char style="w" x-id="t005" x-align="JOB.35.15.a005">hath</char> <char style="w" x-id="t006" x-align="JOB.35.15.a004" x-src="WLC.JOB.35.15.004" x-source="אַ֭יִן" x-translit="ʾayin" srcloc="WLC.JOB.35.15.004" x-head="true" lemma="אַיִן" strong="H369">not</char> <char style="w" x-id="t007" x-align="JOB.35.15.a005" x-src="WLC.JOB.35.15.005" x-source="פָּקַ֣ד" x-translit="pāqaḏ" srcloc="WLC.JOB.35.15.005" x-head="true" lemma="פָּקַד" strong="H6485">visited</char> <char style="w" x-id="t008" x-align="JOB.35.15.a006">in</char> <char style="w" x-id="t009" x-align="JOB.35.15.a007" x-src="WLC.JOB.35.15.007" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.35.15.007" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t010" x-align="JOB.35.15.a006" x-src="WLC.JOB.35.15.006" x-source="אַפּ֑" x-translit="ʾapp" srcloc="WLC.JOB.35.15.006" x-head="true" lemma="אַף" strong="H639">anger</char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, Thou sayest, <char style="it">He doth not greatly regard arrogance. Thus doth etc.</char></char></note><char style="w" x-id="t011" x-align="JOB.35.15.a008" x-status="noncompositional" x-src="WLC.JOB.35.15.008 WLC.JOB.35.15.009" x-source="וְ לֹֽא" x-translit="wə lōʾ-" srcloc="WLC.JOB.35.15.009" x-head="true" lemma="לֹא" strong="H3808">Neither</char> <char style="w" x-id="t012" x-align="JOB.35.15.a009">doth</char> <char style="w" x-id="t013" x-align="JOB.35.15.a009">he</char> <char style="w" x-id="t014" x-align="JOB.35.15.a013" x-src="WLC.JOB.35.15.014" x-source="מְאֹֽד" x-translit="məʾōḏ:" srcloc="WLC.JOB.35.15.014" x-head="true" lemma="מְאֹד" strong="H3966">greatly</char> <char style="w" x-id="t015" x-align="JOB.35.15.a009" x-src="WLC.JOB.35.15.010" x-source="יָדַ֖ע" x-translit="yāḏaʿ" srcloc="WLC.JOB.35.15.010" x-head="true" lemma="יָדַע" strong="H3045">regard</char> <char style="w" x-id="t016" x-align="JOB.35.15.a012" x-src="WLC.JOB.35.15.013" x-source="פַּ֣שׁ" x-translit="paš" srcloc="WLC.JOB.35.15.013" x-head="true" lemma="פַּשׁ" strong="H6580">arrogance</char>;<verse eid="JOB 35:15" /></para>
	<para style="q1"><verse number="16" style="v" sid="JOB 35:16" /><char style="w" x-id="t001" x-align="JOB.35.16.a001" x-src="WLC.JOB.35.16.001" x-source="וְ֭" x-translit="wə" srcloc="WLC.JOB.35.16.001" x-head="true" lemma="וְ" strong="H2050b">Therefore</char> <char style="w" x-id="t002" x-align="JOB.35.16.a004">doth</char> <char style="w" x-id="t003" x-align="JOB.35.16.a002" x-src="WLC.JOB.35.16.002" x-source="אִיּוֹב" x-translit="ʾiyyôḇ" srcloc="WLC.JOB.35.16.002" x-head="true" lemma="אִיּוֹב" strong="H347">Job</char> <char style="w" x-id="t004" x-align="JOB.35.16.a004" x-src="WLC.JOB.35.16.004" x-source="יִפְצֶה" x-translit="yip̄ṣeh-" srcloc="WLC.JOB.35.16.004" x-head="true" lemma="פָּצָה" strong="H6475">open</char> <char style="w" x-id="t005" x-align="JOB.35.16.a006" x-src="WLC.JOB.35.16.006" x-source="הוּ" x-translit="hû" srcloc="WLC.JOB.35.16.006" x-head="true" lemma="הוּא" strong="H1930a">his</char> <char style="w" x-id="t006" x-align="JOB.35.16.a005" x-src="WLC.JOB.35.16.005" x-source="פִּ֑י" x-translit="piy" srcloc="WLC.JOB.35.16.005" x-head="true" lemma="פֶּה" strong="H6310">mouth</char> <char style="w" x-id="t007" x-align="JOB.35.16.a003">in</char> <char style="w" x-id="t008" x-align="JOB.35.16.a003" x-src="WLC.JOB.35.16.003" x-source="הֶ֣בֶל" x-translit="heḇel" srcloc="WLC.JOB.35.16.003" x-head="true" lemma="הֶבֶל" strong="H1892">vanity</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="JOB.35.16.a010">He</char> <char style="w" x-id="t010" x-align="JOB.35.16.a010" x-src="WLC.JOB.35.16.011" x-source="יַכְבִּֽר" x-translit="yaḵbir:" srcloc="WLC.JOB.35.16.011" x-head="true" lemma="כָּבַר" strong="H3527">multiplieth</char> <char style="w" x-id="t011" x-align="JOB.35.16.a009" x-src="WLC.JOB.35.16.010" x-source="מִלִּ֥ין" x-translit="milliyn" srcloc="WLC.JOB.35.16.010" x-head="true" lemma="מִלָּה" strong="H4405">words</char> <char style="w" x-id="t012" x-align="JOB.35.16.a007" x-status="noncompositional" x-src="WLC.JOB.35.16.007 WLC.JOB.35.16.008" x-source="בִּ בְלִי" x-translit="bi ḇəlî-" srcloc="WLC.JOB.35.16.008" x-head="true" lemma="בְּלִי" strong="H1097">without</char> <char style="w" x-id="t013" x-align="JOB.35.16.a008" x-src="WLC.JOB.35.16.009" x-source="דַ֝֗עַת" x-translit="ḏaʿaṯ" srcloc="WLC.JOB.35.16.009" x-head="true" lemma="דַּעַת" strong="H1847">knowledge</char>.<verse eid="JOB 35:16" /></para>
	<chapter eid="JOB 35" />
	<chapter number="36" style="c" sid="JOB 36" />
	<para style="b"><verse number="1" style="v" sid="JOB 36:1" /></para>
	<para style="p"><char style="w" x-id="t001" x-align="JOB.36.1.a003" x-src="WLC.JOB.36.1.003" x-source="אֱלִיה֗וּא" x-translit="ʾĕlîhûʾ" srcloc="WLC.JOB.36.1.003" x-head="true" lemma="אֱלִיהוּא" strong="H453">Elihu</char> <char style="w" x-id="t002" x-align="JOB.36.1.a001" x-src="WLC.JOB.36.1.001" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.36.1.001" x-head="true" lemma="וְ" strong="H2050b">also</char> <char style="w" x-id="t003" x-align="JOB.36.1.a002" x-src="WLC.JOB.36.1.002" x-source="יֹּ֥סֶף" x-translit="yyōsep̄" srcloc="WLC.JOB.36.1.002" x-head="true" lemma="יָסַף" strong="H3254">proceeded</char>, <char style="w" x-id="t004" x-align="JOB.36.1.a004" x-src="WLC.JOB.36.1.004" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.36.1.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="JOB.36.1.a005" x-src="WLC.JOB.36.1.005" x-source="יֹּאמַֽר" x-translit="yyōʾmar:" srcloc="WLC.JOB.36.1.005" x-head="true" lemma="אָמַר" strong="H559">said</char>,<verse eid="JOB 36:1" /></para>
	<para style="q1"><verse number="2" style="v" x-unrepresented-source="לִ֣" x-unrepresented-translit="l" x-unrepresented-src="WLC.JOB.36.2.002" sid="JOB 36:2" /><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Wait for</char>.</char></note><char style="w" x-id="t001" x-align="JOB.36.2.a001" x-src="WLC.JOB.36.2.001" x-source="כַּתַּר" x-translit="kattar-" srcloc="WLC.JOB.36.2.001" x-head="true" lemma="כָּתַר" strong="H3803">Suffer</char> <char style="w" x-id="t002" x-align="JOB.36.2.a003" x-src="WLC.JOB.36.2.003" x-source="י" x-translit="iy" srcloc="WLC.JOB.36.2.003" x-head="true" lemma="הוּא" strong="H2967a">me</char> <char style="w" x-id="t003" x-align="JOB.36.2.a004">a</char> <char style="w" x-id="t004" x-align="JOB.36.2.a004" x-src="WLC.JOB.36.2.004" x-source="זְ֭עֵיר" x-translit="zəʿêr" srcloc="WLC.JOB.36.2.004" x-head="true" lemma="זְעֵיר" strong="H2191">little</char>, <char style="w" x-id="t005" x-align="JOB.36.2.a005" x-src="WLC.JOB.36.2.005" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.36.2.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t006" x-align="JOB.36.2.a006">I</char> <char style="w" x-id="t007" x-align="JOB.36.2.a006">will</char> <char style="w" x-id="t008" x-align="JOB.36.2.a006" x-src="WLC.JOB.36.2.006" x-source="אֲחַוֶּ֑" x-translit="ʾăḥaû" srcloc="WLC.JOB.36.2.006" x-head="true" lemma="חָוָה" strong="H2331">show</char> <char style="w" x-id="t009" x-align="JOB.36.2.a007" x-src="WLC.JOB.36.2.007" x-source="ךָּ" x-translit="ekkā" srcloc="WLC.JOB.36.2.007" x-head="true" lemma="הוּא" strong="H3509b">thee</char>;</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.36.2.a008" x-src="WLC.JOB.36.2.008" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.JOB.36.2.008" x-head="true" lemma="כִּי" strong="H3588">For</char> <note caller="-" style="f"><char style="ft">Hebrew there are <char style="it">yet words for God</char>.</char></note><char style="w" x-id="t011" x-align="JOB.36.2.a009" x-status="added">I</char> <char style="w" x-id="t012" x-align="JOB.36.2.a009" x-status="added" x-source="∅" x-head="true">have</char> <char style="w" x-id="t013" x-align="JOB.36.2.a010" x-src="WLC.JOB.36.2.009" x-source="ע֖וֹד" x-translit="ʿôḏ" srcloc="WLC.JOB.36.2.009" x-head="true" lemma="עוֹד" strong="H5750">yet</char> <char style="w" x-id="t014" x-align="JOB.36.2.a011">somewhat</char> <char style="w" x-id="t015" x-align="JOB.36.2.a011">to</char> <char style="w" x-id="t016" x-align="JOB.36.2.a011" x-src="WLC.JOB.36.2.012" x-source="מִלִּֽים" x-translit="milliym:" srcloc="WLC.JOB.36.2.012" x-head="true" lemma="מִלָּה" strong="H4405">say</char> <char style="w" x-id="t017" x-align="JOB.36.2.a012">on</char> <char style="w" x-id="t018" x-align="JOB.36.2.a013" x-src="WLC.JOB.36.2.011" x-source="אֱל֣וֹהַּ" x-translit="ʾĕlôᵃẖ" srcloc="WLC.JOB.36.2.011" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God’s</char> <char style="w" x-id="t019" x-align="JOB.36.2.a012" x-src="WLC.JOB.36.2.010" x-source="לֶ" x-translit="le" srcloc="WLC.JOB.36.2.010" x-head="true" lemma="לְ" strong="H3807a">behalf</char>.<verse eid="JOB 36:2" /></para>
