	<para style="p"><char style="w" x-id="t001" x-align="JOB.27.1.a001" x-src="WLC.JOB.27.1.001" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.27.1.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="JOB.27.1.a003" x-src="WLC.JOB.27.1.003" x-source="אִ֭יּוֹב" x-translit="ʾiyyôḇ" srcloc="WLC.JOB.27.1.003" x-head="true" lemma="אִיּוֹב" strong="H347">Job</char> <char style="w" x-id="t003" x-align="JOB.27.1.a002" x-src="WLC.JOB.27.1.002" x-source="יֹּ֣סֶף" x-translit="yyōsep̄" srcloc="WLC.JOB.27.1.002" x-head="true" lemma="יָסַף" strong="H3254">again</char> <char style="w" x-id="t004" x-align="JOB.27.1.a004" x-src="WLC.JOB.27.1.004" x-source="שְׂאֵ֥ת" x-translit="śəʾēṯ" srcloc="WLC.JOB.27.1.004" x-head="true" lemma="נָשָׂא" strong="H5375">took</char> <char style="w" x-id="t005" x-align="JOB.27.1.a004">up</char> <char style="w" x-id="t006" x-align="JOB.27.1.a006" x-src="WLC.JOB.27.1.006" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.27.1.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="JOB.27.1.a005" x-src="WLC.JOB.27.1.005" x-source="מְשָׁל֗" x-translit="məšāl" srcloc="WLC.JOB.27.1.005" x-head="true" lemma="מָשָׁל" strong="H4912">parable</char>, <char style="w" x-id="t008" x-align="JOB.27.1.a007" x-src="WLC.JOB.27.1.007" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.27.1.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="JOB.27.1.a008" x-src="WLC.JOB.27.1.008" x-source="יֹּאמַֽר" x-translit="yyōʾmar:" srcloc="WLC.JOB.27.1.008" x-head="true" lemma="אָמַר" strong="H559">said</char>,<verse eid="JOB 27:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="JOB 27:2" /><char style="w" x-id="t001" x-align="JOB.27.2.a001">As</char> <char style="w" x-id="t002" x-align="JOB.27.2.a002" x-src="WLC.JOB.27.2.002" x-source="אֵ֭ל" x-translit="ʾēl" srcloc="WLC.JOB.27.2.002" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="w" x-id="t003" x-align="JOB.27.2.a001" x-src="WLC.JOB.27.2.001" x-source="חַי" x-translit="ḥay-" srcloc="WLC.JOB.27.2.001" x-head="true" lemma="חַי" strong="H2416">liveth</char>, <char style="w" x-id="t004" x-align="JOB.27.2.a003" x-status="added" x-source="∅" x-head="true">who</char> <char style="w" x-id="t005" x-align="JOB.27.2.a004">hath</char> <char style="w" x-id="t006" x-align="JOB.27.2.a004" x-src="WLC.JOB.27.2.003" x-source="הֵסִ֣יר" x-translit="hēsiyr" srcloc="WLC.JOB.27.2.003" x-head="true" lemma="סוּר" strong="H5493">taken</char> <char style="w" x-id="t007" x-align="JOB.27.2.a004">away</char> <char style="w" x-id="t008" x-align="JOB.27.2.a006" x-src="WLC.JOB.27.2.005" x-source="י" x-translit="iy" srcloc="WLC.JOB.27.2.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t009" x-align="JOB.27.2.a005" x-src="WLC.JOB.27.2.004" x-source="מִשְׁפָּטִ֑" x-translit="mišpāṭ" srcloc="WLC.JOB.27.2.004" x-head="true" lemma="מִשְׁפָּט" strong="H4941">right</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.27.2.a007" x-src="WLC.JOB.27.2.006" x-source="וְ֝" x-translit="wə" srcloc="WLC.JOB.27.2.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.27.2.a008">the</char> <char style="w" x-id="t012" x-align="JOB.27.2.a008" x-src="WLC.JOB.27.2.007" x-source="שַׁדַּ֗י" x-translit="šadday" srcloc="WLC.JOB.27.2.007" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char>, <char style="w" x-id="t013" x-align="JOB.27.2.a009" x-status="added" x-source="∅" x-head="true">who</char> <char style="w" x-id="t014" x-align="JOB.27.2.a010">hath</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">made my soul bitter</char>.</char></note><char style="w" x-id="t015" x-align="JOB.27.2.a010" x-src="WLC.JOB.27.2.008" x-source="הֵמַ֥ר" x-translit="hēmar" srcloc="WLC.JOB.27.2.008" x-head="true" lemma="מָרַר" strong="H4843">vexed</char> <char style="w" x-id="t016" x-align="JOB.27.2.a012" x-src="WLC.JOB.27.2.010" x-source="י" x-translit="iy" srcloc="WLC.JOB.27.2.010" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t017" x-align="JOB.27.2.a011" x-src="WLC.JOB.27.2.009" x-source="נַפְשִֽׁ" x-translit="nap̄š" srcloc="WLC.JOB.27.2.009" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char><verse eid="JOB 27:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="JOB 27:3" /><note caller="-" style="f"><char style="ft">Or, <char style="it">All the while my breath is in me . . . nostrils; surely</char></char></note>(<char style="w" x-id="t001" x-align="JOB.27.3.a001" x-src="WLC.JOB.27.3.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.27.3.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="JOB.27.3.a005" x-src="WLC.JOB.27.3.005" x-source="י" x-translit="iy" srcloc="WLC.JOB.27.3.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t003" x-align="JOB.27.3.a004" x-src="WLC.JOB.27.3.004" x-source="נִשְׁמָתִ֣" x-translit="nišmāṯ" srcloc="WLC.JOB.27.3.004" x-head="true" lemma="נְשָׁמָה" strong="H5397">life</char> <char style="w" x-id="t004" x-align="JOB.27.3.a006">is</char> <char style="w" x-id="t005" x-align="JOB.27.3.a003" x-src="WLC.JOB.27.3.003" x-source="ע֣וֹד" x-translit="ʿôḏ" srcloc="WLC.JOB.27.3.003" x-head="true" lemma="עוֹד" strong="H5750">yet</char> <char style="w" x-id="t006" x-align="JOB.27.3.a002" x-src="WLC.JOB.27.3.002" x-source="כָל" x-translit="ḵol-" srcloc="WLC.JOB.27.3.002" x-head="true" lemma="כֹּל" strong="H3605">whole</char> <char style="w" x-id="t007" x-align="JOB.27.3.a006" x-src="WLC.JOB.27.3.006" x-source="בִ֑" x-translit="ḇ" srcloc="WLC.JOB.27.3.006" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t008" x-align="JOB.27.3.a007" x-src="WLC.JOB.27.3.007" x-source="י" x-translit="iy" srcloc="WLC.JOB.27.3.007" x-head="true" lemma="הוּא" strong="H2967a">me</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="JOB.27.3.a008" x-src="WLC.JOB.27.3.008" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.27.3.008" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="JOB.27.3.a009">the</char> <char style="w" x-id="t011" x-align="JOB.27.3.a009" x-src="WLC.JOB.27.3.009" x-source="ר֖וּחַ" x-translit="rûᵃḥ" srcloc="WLC.JOB.27.3.009" x-head="true" lemma="רוּחַ" strong="H7307">spirit</char> <char style="w" x-id="t012" x-align="JOB.27.3.a010">of</char> <char style="w" x-id="t013" x-align="JOB.27.3.a010" x-src="WLC.JOB.27.3.010" x-source="אֱל֣וֹהַּ" x-translit="ʾĕlôᵃẖ" srcloc="WLC.JOB.27.3.010" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char> <char style="w" x-id="t014" x-align="JOB.27.3.a011">is</char> <char style="w" x-id="t015" x-align="JOB.27.3.a011" x-src="WLC.JOB.27.3.011" x-source="בְּ" x-translit="bə" srcloc="WLC.JOB.27.3.011" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t016" x-align="JOB.27.3.a013" x-src="WLC.JOB.27.3.013" x-source="י" x-translit="iy" srcloc="WLC.JOB.27.3.013" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t017" x-align="JOB.27.3.a012" x-src="WLC.JOB.27.3.012" x-source="אַפִּֽ" x-translit="ʾapp" srcloc="WLC.JOB.27.3.012" x-head="true" lemma="אַף" strong="H639">nostrils</char>);<verse eid="JOB 27:3" /></para>
