	<para style="q1"><verse number="23" style="v" sid="JOB 37:23" /><char style="add"><char style="w" x-id="t001" x-align="JOB.37.23.a001" x-status="added" x-source="∅" x-head="true">Touching</char></char> <char style="w" x-id="t002" x-align="JOB.37.23.a002">the</char> <char style="w" x-id="t003" x-align="JOB.37.23.a002" x-src="WLC.JOB.37.23.001" x-source="שַׁדַּ֣י" x-translit="šadday" srcloc="WLC.JOB.37.23.001" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char>, <char style="w" x-id="t004" x-align="JOB.37.23.a004">we</char> <char style="w" x-id="t005" x-align="JOB.37.23.a003" x-src="WLC.JOB.37.23.002" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.JOB.37.23.002" x-head="true" lemma="לֹא" strong="H3808">cannot</char> <char style="w" x-id="t006" x-align="JOB.37.23.a004" x-src="WLC.JOB.37.23.003" x-source="מְ֭צָאנֻ" x-translit="məṣāʾnu" srcloc="WLC.JOB.37.23.003" x-head="true" lemma="מָצָא" strong="H4672">find</char> <char style="w" x-id="t007" x-align="JOB.37.23.a005" x-src="WLC.JOB.37.23.004" x-source="הוּ" x-translit="hû" srcloc="WLC.JOB.37.23.004" x-head="true" lemma="הוּא" strong="H1930a">him</char> <char style="w" x-id="t008" x-align="JOB.37.23.a004">out</char>:</para>
	<para style="q1"><char style="w" x-id="t009" x-align="JOB.37.23.a002">He</char> <char style="w" x-id="t010" x-align="JOB.37.23.a006">is</char> <char style="w" x-id="t011" x-align="JOB.37.23.a006" x-src="WLC.JOB.37.23.005" x-source="שַׂגִּיא" x-translit="śaggîʾ-" srcloc="WLC.JOB.37.23.005" x-head="true" lemma="שַׂגִּיא" strong="H7689">excellent</char> <char style="w" x-id="t012" x-align="JOB.37.23.a007">in</char> <char style="w" x-id="t013" x-align="JOB.37.23.a007" x-src="WLC.JOB.37.23.006" x-source="כֹ֑חַ" x-translit="ḵōᵃḥ" srcloc="WLC.JOB.37.23.006" x-head="true" lemma="כֹּחַ" strong="H3581">power</char>;</para>
	<para style="q1"><char style="w" x-id="t014" x-align="JOB.37.23.a008" x-src="WLC.JOB.37.23.007" x-source="וּ" x-translit="û" srcloc="WLC.JOB.37.23.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">to justice . . . he doeth no violence</char></char></note><char style="w" x-id="t015" x-align="JOB.37.23.a009">in</char> <char style="w" x-id="t016" x-align="JOB.37.23.a009" x-src="WLC.JOB.37.23.008" x-source="מִשְׁפָּ֥ט" x-translit="mišpāṭ" srcloc="WLC.JOB.37.23.008" x-head="true" lemma="מִשְׁפָּט" strong="H4941">justice</char> <char style="w" x-id="t017" x-align="JOB.37.23.a010" x-src="WLC.JOB.37.23.009" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.37.23.009" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t018" x-align="JOB.37.23.a011" x-src="WLC.JOB.37.23.010" x-source="רֹב" x-translit="rōḇ-" srcloc="WLC.JOB.37.23.010" x-head="true" lemma="רֹב" strong="H7230">plenteous</char> <char style="w" x-id="t019" x-align="JOB.37.23.a012" x-src="WLC.JOB.37.23.011" x-source="צְ֝דָקָ֗ה" x-translit="ṣəḏāqāh" srcloc="WLC.JOB.37.23.011" x-head="true" lemma="צְדָקָה" strong="H6666">righteousness</char> <char style="w" x-id="t020" x-align="JOB.37.23.a014">he</char> <char style="w" x-id="t021" x-align="JOB.37.23.a014">will</char> <char style="w" x-id="t022" x-align="JOB.37.23.a013" x-src="WLC.JOB.37.23.012" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.JOB.37.23.012" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t023" x-align="JOB.37.23.a014" x-src="WLC.JOB.37.23.013" x-source="יְעַנֶּֽה" x-translit="yəʿanneh:" srcloc="WLC.JOB.37.23.013" x-head="true" lemma="עָנָה" strong="H6031">afflict</char>.<verse eid="JOB 37:23" /></para>
