	<para style="q1"><verse number="6" style="v" sid="JOB 5:6" /><char style="w" x-id="t001" x-align="JOB.5.6.a001" x-src="WLC.JOB.5.6.001" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.JOB.5.6.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">iniquity</char>. See <ref loc="JOB 4:8">4:8</ref>.</char></note><char style="w" x-id="t002" x-align="JOB.5.6.a006" x-src="WLC.JOB.5.6.006" x-source="אָ֑וֶן" x-translit="ʾāwen" srcloc="WLC.JOB.5.6.006" x-head="true" lemma="אָוֶן" strong="H205">affliction</char> <char style="w" x-id="t003" x-align="JOB.5.6.a003" x-src="WLC.JOB.5.6.003" x-source="יֵצֵ֣א" x-translit="yēṣēʾ" srcloc="WLC.JOB.5.6.003" x-head="true" lemma="יָצָא" strong="H3318">cometh</char> <char style="w" x-id="t004" x-align="JOB.5.6.a002" x-src="WLC.JOB.5.6.002" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.JOB.5.6.002" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t005" x-align="JOB.5.6.a003">forth</char> <char style="w" x-id="t006" x-align="JOB.5.6.a004" x-src="WLC.JOB.5.6.004" x-source="מֵ" x-translit="mē" srcloc="WLC.JOB.5.6.004" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t007" x-align="JOB.5.6.a005">the</char> <char style="w" x-id="t008" x-align="JOB.5.6.a005" x-src="WLC.JOB.5.6.005" x-source="עָפָ֣ר" x-translit="ʿāp̄ār" srcloc="WLC.JOB.5.6.005" x-head="true" lemma="עָפָר" strong="H6083">dust</char>,</para>
