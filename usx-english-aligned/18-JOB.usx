	<para style="q1"><verse number="4" style="v" sid="JOB 28:4" /><note caller="-" style="f"><char style="ft">Or, <char style="it">The flood breaketh out from where men sojourn;</char> Even the waters <char style="it">forgotten of the foot: They are diminished, they are gone away from man</char></char></note><char style="w" x-id="t001" x-align="JOB.28.4.a001">He</char> <char style="w" x-id="t002" x-align="JOB.28.4.a001" x-src="WLC.JOB.28.4.001" x-source="פָּ֤רַץ" x-translit="pāraṣ" srcloc="WLC.JOB.28.4.001" x-head="true" lemma="פָּרַץ" strong="H6555">breaketh</char> <char style="w" x-id="t003" x-align="JOB.28.4.a001">open</char> <char style="w" x-id="t004" x-align="JOB.28.4.a002">a</char> <char style="w" x-id="t005" x-align="JOB.28.4.a002" x-src="WLC.JOB.28.4.002" x-source="נַ֨חַל" x-translit="naḥal" srcloc="WLC.JOB.28.4.002" x-head="true" lemma="נַחַל" strong="H5158">shaft</char> <char style="w" x-id="t006" x-align="JOB.28.4.a003" x-src="WLC.JOB.28.4.003 WLC.JOB.28.4.004" x-source="מֵֽ עִם" x-translit="mē ʿim-" srcloc="WLC.JOB.28.4.003" x-head="true" lemma="מִן" strong="H4480">away</char> <char style="w" x-id="t007" x-align="JOB.28.4.a003">from</char> <char style="w" x-id="t008" x-align="JOB.28.4.a004">where</char> <char style="w" x-id="t009" x-align="JOB.28.4.a004">men</char> <char style="w" x-id="t010" x-align="JOB.28.4.a004" x-src="WLC.JOB.28.4.005" x-source="גָּ֗ר" x-translit="gār" srcloc="WLC.JOB.28.4.005" x-head="true" lemma="גּוּר" strong="H1481">sojourn</char>;</para>
	<para style="q1"><char style="w" x-id="t011" x-align="JOB.28.4.a005" x-src="WLC.JOB.28.4.006" x-source="הַֽ" x-translit="ha" srcloc="WLC.JOB.28.4.006" x-head="true" lemma="הַ" strong="H1886a">They</char> <char style="w" x-id="t012" x-align="JOB.28.4.a006">are</char> <char style="w" x-id="t013" x-align="JOB.28.4.a006" x-src="WLC.JOB.28.4.007" x-source="נִּשְׁכָּחִ֥ים" x-translit="nniškāḥiym" srcloc="WLC.JOB.28.4.007" x-head="true" lemma="שָׁכַח" strong="H7911">forgotten</char> <char style="w" x-id="t014" x-align="JOB.28.4.a007" x-src="WLC.JOB.28.4.008" x-source="מִנִּי" x-translit="minnî-" srcloc="WLC.JOB.28.4.008" x-head="true" lemma="מִן" strong="H4480">of</char> <char style="w" x-id="t015" x-align="JOB.28.4.a008">the</char> <char style="w" x-id="t016" x-align="JOB.28.4.a008" x-src="WLC.JOB.28.4.009" x-source="רָ֑גֶל" x-translit="rāḡel" srcloc="WLC.JOB.28.4.009" x-head="true" lemma="רֶגֶל" strong="H7272">foot</char>;</para>
