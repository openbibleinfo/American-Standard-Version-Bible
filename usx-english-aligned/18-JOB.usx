	<para style="q1"><char style="w" x-id="t001" x-align="JOB.22.21.a001" x-src="WLC.JOB.22.21.001" x-source="הַסְכֶּן" x-translit="hasken-" srcloc="WLC.JOB.22.21.001" x-head="true" lemma="סָכַן" strong="H5532">Acquaint</char> <char style="w" x-id="t002" x-align="JOB.22.21.a002" x-src="WLC.JOB.22.21.002" x-source="נָ֣א" x-translit="nāʾ" srcloc="WLC.JOB.22.21.002" x-head="true" lemma="נָא" strong="H4994">now</char> <char style="w" x-id="t003" x-align="JOB.22.21.a001">thyself</char> <char style="w" x-id="t004" x-align="JOB.22.21.a003" x-src="WLC.JOB.22.21.003" x-source="עִמּ֑" x-translit="ʿimm" srcloc="WLC.JOB.22.21.003" x-head="true" lemma="עִם" strong="H5973">with</char> <char style="w" x-id="t005" x-align="JOB.22.21.a004" x-src="WLC.JOB.22.21.004" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.22.21.004" x-head="true" lemma="הוּא" strong="H2050c">him</char>, <char style="w" x-id="t006" x-align="JOB.22.21.a005" x-src="WLC.JOB.22.21.005" x-source="וּ" x-translit="û" srcloc="WLC.JOB.22.21.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t007" x-align="JOB.22.21.a006">be</char> <char style="w" x-id="t008" x-align="JOB.22.21.a006">at</char> <char style="w" x-id="t009" x-align="JOB.22.21.a006" x-src="WLC.JOB.22.21.006" x-source="שְׁלם" x-translit="šəlm" srcloc="WLC.JOB.22.21.006" x-head="true" lemma="שָׁלַם" strong="H7999">peace</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, as otherwise read, <char style="it">Thereby shall thine increase be good</char>.</char></note><char style="w" x-id="t010" x-align="JOB.22.21.a007" x-src="WLC.JOB.22.21.007 WLC.JOB.22.21.008" x-source="בָּ֝ הֶ֗ם" x-translit="bā hem" srcloc="WLC.JOB.22.21.007" x-head="true" lemma="בְּ" strong="H871a">Thereby</char> <char style="w" x-id="t011" x-align="JOB.22.21.a010" x-src="WLC.JOB.22.21.011" x-source="טוֹבָֽה" x-translit="ṭôḇāh:" srcloc="WLC.JOB.22.21.011" x-head="true" lemma="טוֹבָה" strong="H2896b">good</char> <char style="w" x-id="t012" x-align="JOB.22.21.a008">shall</char> <char style="w" x-id="t013" x-align="JOB.22.21.a008" x-src="WLC.JOB.22.21.009" x-source="תְּֽבוֹאַתְ" x-translit="təḇôʾaṯ" srcloc="WLC.JOB.22.21.009" x-head="true" lemma="תְּבוּאָה" strong="H935">come</char> <char style="w" x-id="t014" x-align="JOB.22.21.a008">unto</char> <char style="w" x-id="t015" x-align="JOB.22.21.a009" x-src="WLC.JOB.22.21.010" x-source="ךָ֥" x-translit="əḵā" srcloc="WLC.JOB.22.21.010" x-head="true" lemma="הוּא" strong="H3509b">thee</char>.<verse eid="JOB 22:21" /></para>
	<para style="q1"><verse number="22" style="v" sid="JOB 22:22" /><char style="w" x-id="t001" x-align="JOB.22.22.a001" x-src="WLC.JOB.22.22.001" x-source="קַח" x-translit="qaḥ-" srcloc="WLC.JOB.22.22.001" x-head="true" lemma="לָקַח" strong="H3947">Receive</char>, <char style="w" x-id="t002" x-align="JOB.22.22.a002">I</char> <char style="w" x-id="t003" x-align="JOB.22.22.a002" x-src="WLC.JOB.22.22.002" x-source="נָ֣א" x-translit="nāʾ" srcloc="WLC.JOB.22.22.002" x-head="true" lemma="נָא" strong="H4994">pray</char> <char style="w" x-id="t004" x-align="JOB.22.22.a002">thee</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">instruction</char></char></note><char style="w" x-id="t005" x-align="JOB.22.22.a006">the</char> <char style="w" x-id="t006" x-align="JOB.22.22.a006" x-src="WLC.JOB.22.22.006" x-source="תּוֹרָ֑ה" x-translit="tôrāh" srcloc="WLC.JOB.22.22.006" x-head="true" lemma="תּוֹרָה" strong="H8451">law</char> <char style="w" x-id="t007" x-align="JOB.22.22.a003" x-src="WLC.JOB.22.22.003" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.22.22.003" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t008" x-align="JOB.22.22.a005" x-src="WLC.JOB.22.22.005" x-source="ו" x-translit="w" srcloc="WLC.JOB.22.22.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t009" x-align="JOB.22.22.a004" x-src="WLC.JOB.22.22.004" x-source="פִּ֣י" x-translit="piy" srcloc="WLC.JOB.22.22.004" x-head="true" lemma="פֶּה" strong="H6310">mouth</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.22.22.a007" x-src="WLC.JOB.22.22.007" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.22.22.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.22.22.a008" x-src="WLC.JOB.22.22.008" x-source="שִׂ֥ים" x-translit="śiym" srcloc="WLC.JOB.22.22.008" x-head="true" lemma="שׂים" strong="H7760">lay</char> <char style="w" x-id="t012" x-align="JOB.22.22.a008">up</char> <char style="w" x-id="t013" x-align="JOB.22.22.a010" x-src="WLC.JOB.22.22.010" x-source="ו" x-translit="w" srcloc="WLC.JOB.22.22.010" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t014" x-align="JOB.22.22.a009" x-src="WLC.JOB.22.22.009" x-source="אֲ֝מָרָ֗י" x-translit="ʾămārāy" srcloc="WLC.JOB.22.22.009" x-head="true" lemma="אֵמֶר" strong="H561">words</char> <char style="w" x-id="t015" x-align="JOB.22.22.a011" x-src="WLC.JOB.22.22.011" x-source="בִּ" x-translit="bi" srcloc="WLC.JOB.22.22.011" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t016" x-align="JOB.22.22.a013" x-src="WLC.JOB.22.22.013" x-source="ךָ" x-translit="eḵā" srcloc="WLC.JOB.22.22.013" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t017" x-align="JOB.22.22.a012" x-src="WLC.JOB.22.22.012" x-source="לְבָבֶֽ" x-translit="ləḇāḇ" srcloc="WLC.JOB.22.22.012" x-head="true" lemma="לֵבָב" strong="H3824">heart</char>.<verse eid="JOB 22:22" /></para>
	<para style="q1"><verse number="23" style="v" sid="JOB 22:23" /><char style="w" x-id="t001" x-align="JOB.22.23.a001" x-src="WLC.JOB.22.23.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.22.23.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JOB.22.23.a002">thou</char> <char style="w" x-id="t003" x-align="JOB.22.23.a002" x-src="WLC.JOB.22.23.002" x-source="תָּשׁ֣וּב" x-translit="tāšûḇ" srcloc="WLC.JOB.22.23.002" x-head="true" lemma="שׁוּב" strong="H7725">return</char> <char style="w" x-id="t004" x-align="JOB.22.23.a003" x-src="WLC.JOB.22.23.003" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.JOB.22.23.003" x-head="true" lemma="עַד" strong="H5704">to</char> <char style="w" x-id="t005" x-align="JOB.22.23.a004">the</char> <char style="w" x-id="t006" x-align="JOB.22.23.a004" x-src="WLC.JOB.22.23.004" x-source="שַׁ֭דַּי" x-translit="šadday" srcloc="WLC.JOB.22.23.004" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char>, <char style="w" x-id="t007" x-align="JOB.22.23.a005">thou</char> <char style="w" x-id="t008" x-align="JOB.22.23.a005">shalt</char> <char style="w" x-id="t009" x-align="JOB.22.23.a005">be</char> <char style="w" x-id="t010" x-align="JOB.22.23.a005" x-src="WLC.JOB.22.23.005" x-source="תִּבָּנֶ֑ה" x-translit="tibbāneh" srcloc="WLC.JOB.22.23.005" x-head="true" lemma="בָּנָה" strong="H1129">built</char> <char style="w" x-id="t011" x-align="JOB.22.23.a005">up</char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Thou shalt put away . . . And shalt lay up</char></char></note><char style="w" x-id="t012" x-align="JOB.22.23.a006" x-status="added" x-source="∅" x-head="true">If</char> <char style="w" x-id="t013" x-align="JOB.22.23.a007">thou</char> <char style="w" x-id="t014" x-align="JOB.22.23.a007">put</char> <char style="w" x-id="t015" x-align="JOB.22.23.a007">away</char> <char style="w" x-id="t016" x-align="JOB.22.23.a008" x-src="WLC.JOB.22.23.007" x-source="עַ֝וְלָ֗ה" x-translit="ʿawlāh" srcloc="WLC.JOB.22.23.007" x-head="true" lemma="עַוְלָה" strong="H5766a">unrighteousness</char> <char style="w" x-id="t017" x-align="JOB.22.23.a007" x-src="WLC.JOB.22.23.006" x-source="תַּרְחִ֥יק" x-translit="tarḥiyq" srcloc="WLC.JOB.22.23.006" x-head="true" lemma="רָחַק" strong="H7368">far</char> <char style="w" x-id="t018" x-align="JOB.22.23.a009" x-src="WLC.JOB.22.23.008" x-source="מֵ" x-translit="mē" srcloc="WLC.JOB.22.23.008" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t019" x-align="JOB.22.23.a011" x-src="WLC.JOB.22.23.010" x-source="ךָ" x-translit="eḵā" srcloc="WLC.JOB.22.23.010" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t020" x-align="JOB.22.23.a010" x-src="WLC.JOB.22.23.009" x-source="אָהֳלֶֽ" x-translit="ʾāhŏl" srcloc="WLC.JOB.22.23.009" x-head="true" lemma="אֹהֶל" strong="H168">tents</char>.<verse eid="JOB 22:23" /></para>
	<para style="q1"><verse number="24" style="v" sid="JOB 22:24" /><char style="w" x-id="t001" x-align="JOB.22.24.a001" x-src="WLC.JOB.22.24.001" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.22.24.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="JOB.22.24.a002" x-src="WLC.JOB.22.24.002" x-source="שִׁית" x-translit="šîṯ-" srcloc="WLC.JOB.22.24.002" x-head="true" lemma="שִׁית" strong="H7896">lay</char> <char style="w" x-id="t003" x-align="JOB.22.24.a002">thou</char> <char style="add"><char style="w" x-id="t004" x-align="JOB.22.24.a005" x-status="added" x-source="∅" x-head="true">thy</char></char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">ore</char>.</char></note><char style="w" x-id="t005" x-align="JOB.22.24.a006" x-src="WLC.JOB.22.24.005" x-source="בָּ֑צֶר" x-translit="bāṣer" srcloc="WLC.JOB.22.24.005" x-head="true" lemma="בֶּצֶר" strong="H1220">treasure</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">on the earth</char></char></note><char style="w" x-id="t006" x-align="JOB.22.24.a003" x-src="WLC.JOB.22.24.003" x-source="עַל" x-translit="ʿal-" srcloc="WLC.JOB.22.24.003" x-head="true" lemma="עַל" strong="H5921">in</char> <char style="w" x-id="t007" x-align="JOB.22.24.a004">the</char> <char style="w" x-id="t008" x-align="JOB.22.24.a004" x-src="WLC.JOB.22.24.004" x-source="עָפָ֥ר" x-translit="ʿāp̄ār" srcloc="WLC.JOB.22.24.004" x-head="true" lemma="עָפָר" strong="H6083">dust</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="JOB.22.24.a007" x-src="WLC.JOB.22.24.006" x-source="וּ" x-translit="û" srcloc="WLC.JOB.22.24.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="add"><char style="w" x-id="t010" x-align="JOB.22.24.a011">the</char> <char style="w" x-id="t011" x-align="JOB.22.24.a011">gold</char> <char style="w" x-id="t012" x-align="JOB.22.24.a011">of</char></char> <char style="w" x-id="t013" x-align="JOB.22.24.a011" x-src="WLC.JOB.22.24.010" x-source="אוֹפִֽיר" x-translit="ʾôp̄iyr:" srcloc="WLC.JOB.22.24.010" x-head="true" lemma="אוֹפִיר" strong="H211a">Ophir</char> <char style="w" x-id="t014" x-align="JOB.22.24.a008" x-src="WLC.JOB.22.24.007" x-source="בְ" x-translit="ḇə" srcloc="WLC.JOB.22.24.007" x-head="true" lemma="בְּ" strong="H871a">among</char> <char style="w" x-id="t015" x-align="JOB.22.24.a009">the</char> <char style="w" x-id="t016" x-align="JOB.22.24.a009" x-src="WLC.JOB.22.24.008" x-source="צ֖וּר" x-translit="ṣûr" srcloc="WLC.JOB.22.24.008" x-head="true" lemma="צוּר" strong="H6697a">stones</char> <char style="w" x-id="t017" x-align="JOB.22.24.a010">of</char> <char style="w" x-id="t018" x-align="JOB.22.24.a010">the</char> <char style="w" x-id="t019" x-align="JOB.22.24.a010" x-src="WLC.JOB.22.24.009" x-source="נְחָלִ֣ים" x-translit="nəḥāliym" srcloc="WLC.JOB.22.24.009" x-head="true" lemma="נַחַל" strong="H5158">brooks</char>;<verse eid="JOB 22:24" /></para>
	<para style="q1"><verse number="25" style="v" sid="JOB 22:25" /><char style="w" x-id="t001" x-align="JOB.22.25.a001" x-src="WLC.JOB.22.25.001" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.22.25.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="JOB.22.25.a003">the</char> <char style="w" x-id="t003" x-align="JOB.22.25.a003" x-src="WLC.JOB.22.25.003" x-source="שַׁדַּ֣י" x-translit="šadday" srcloc="WLC.JOB.22.25.003" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char> <char style="w" x-id="t004" x-align="JOB.22.25.a002">will</char> <char style="w" x-id="t005" x-align="JOB.22.25.a002" x-src="WLC.JOB.22.25.002" x-source="הָיָ֣ה" x-translit="hāyāh" srcloc="WLC.JOB.22.25.002" x-head="true" lemma="הָיָה" strong="H1961">be</char> <char style="w" x-id="t006" x-align="JOB.22.25.a005" x-src="WLC.JOB.22.25.005" x-source="ךָ" x-translit="ḵā" srcloc="WLC.JOB.22.25.005" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">ore</char>.</char></note><char style="w" x-id="t007" x-align="JOB.22.25.a004" x-src="WLC.JOB.22.25.004" x-source="בְּצָרֶ֑י" x-translit="bəṣārey" srcloc="WLC.JOB.22.25.004" x-head="true" lemma="בֶּצֶר" strong="H1220">treasure</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="JOB.22.25.a006" x-src="WLC.JOB.22.25.006" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.22.25.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">precious silver shall be thine</char></char></note><char style="w" x-id="t009" x-align="JOB.22.25.a008" x-src="WLC.JOB.22.25.008" x-source="תּוֹעָפ֣וֹת" x-translit="tôʿāp̄ôṯ" srcloc="WLC.JOB.22.25.008" x-head="true" lemma="תֹּועָפֹות" strong="H8443">precious</char> <char style="w" x-id="t010" x-align="JOB.22.25.a007" x-src="WLC.JOB.22.25.007" x-source="כֶ֖סֶף" x-translit="ḵesep̄" srcloc="WLC.JOB.22.25.007" x-head="true" lemma="כֶּסֶף" strong="H3701">silver</char> <char style="w" x-id="t011" x-align="JOB.22.25.a009" x-src="WLC.JOB.22.25.009" x-source="לָֽ" x-translit="l" srcloc="WLC.JOB.22.25.009" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t012" x-align="JOB.22.25.a010" x-src="WLC.JOB.22.25.010" x-source="ךְ" x-translit="āḵ" srcloc="WLC.JOB.22.25.010" x-head="true" lemma="הוּא" strong="H3509b">thee</char>.<verse eid="JOB 22:25" /></para>
	<para style="q1"><verse number="26" style="v" sid="JOB 22:26" /><char style="w" x-id="t001" x-align="JOB.22.26.a001" x-src="WLC.JOB.22.26.001" x-source="כִּי" x-translit="kî-" srcloc="WLC.JOB.22.26.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="JOB.22.26.a002" x-src="WLC.JOB.22.26.002" x-source="אָ֭ז" x-translit="ʾāz" srcloc="WLC.JOB.22.26.002" x-head="true" lemma="אָז" strong="H227">then</char> <char style="w" x-id="t003" x-align="JOB.22.26.a005">shalt</char> <char style="w" x-id="t004" x-align="JOB.22.26.a005">thou</char> <char style="w" x-id="t005" x-align="JOB.22.26.a005" x-src="WLC.JOB.22.26.005" x-source="תִּתְעַנָּ֑ג" x-translit="tiṯʿannāḡ" srcloc="WLC.JOB.22.26.005" x-head="true" lemma="עָנֹג" strong="H6026">delight</char> <char style="w" x-id="t006" x-align="JOB.22.26.a005">thyself</char> <char style="w" x-id="t007" x-align="JOB.22.26.a003" x-src="WLC.JOB.22.26.003" x-source="עַל" x-translit="ʿal-" srcloc="WLC.JOB.22.26.003" x-head="true" lemma="עַל" strong="H5921">in</char> <char style="w" x-id="t008" x-align="JOB.22.26.a004">the</char> <char style="w" x-id="t009" x-align="JOB.22.26.a004" x-src="WLC.JOB.22.26.004" x-source="שַׁדַּ֣י" x-translit="šadday" srcloc="WLC.JOB.22.26.004" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.22.26.a006" x-src="WLC.JOB.22.26.006" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.22.26.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.22.26.a007">shalt</char> <char style="w" x-id="t012" x-align="JOB.22.26.a007" x-src="WLC.JOB.22.26.007" x-source="תִשָּׂ֖א" x-translit="ṯiśśāʾ" srcloc="WLC.JOB.22.26.007" x-head="true" lemma="נָשָׂא" strong="H5375">lift</char> <char style="w" x-id="t013" x-align="JOB.22.26.a007">up</char> <char style="w" x-id="t014" x-align="JOB.22.26.a011" x-src="WLC.JOB.22.26.011" x-source="ךָ" x-translit="ḵā" srcloc="WLC.JOB.22.26.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t015" x-align="JOB.22.26.a010" x-src="WLC.JOB.22.26.010" x-source="פָּנֶֽי" x-translit="pāney" srcloc="WLC.JOB.22.26.010" x-head="true" lemma="פָּנֶה" strong="H6440">face</char> <char style="w" x-id="t016" x-align="JOB.22.26.a008" x-src="WLC.JOB.22.26.008" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.JOB.22.26.008" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t017" x-align="JOB.22.26.a009" x-src="WLC.JOB.22.26.009" x-source="אֱל֣וֹהַּ" x-translit="ʾĕlôᵃẖ" srcloc="WLC.JOB.22.26.009" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char>.<verse eid="JOB 22:26" /></para>
