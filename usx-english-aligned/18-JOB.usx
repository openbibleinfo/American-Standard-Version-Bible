	<para style="q1"><char style="w" x-id="t014" x-align="JOB.37.21.a012" x-src="WLC.JOB.37.21.011" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.37.21.011" x-head="true" lemma="וְ" strong="H2050b">But</char> <char style="w" x-id="t015" x-align="JOB.37.21.a013">the</char> <char style="w" x-id="t016" x-align="JOB.37.21.a013" x-src="WLC.JOB.37.21.012" x-source="ר֥וּחַ" x-translit="rûᵃḥ" srcloc="WLC.JOB.37.21.012" x-head="true" lemma="רוּחַ" strong="H7307">wind</char> <char style="w" x-id="t017" x-align="JOB.37.21.a014" x-src="WLC.JOB.37.21.013" x-source="עָ֝בְרָ֗ה" x-translit="ʿāḇərāh" srcloc="WLC.JOB.37.21.013" x-head="true" lemma="עָבַר" strong="H5674">passeth</char>, <char style="w" x-id="t018" x-align="JOB.37.21.a015" x-src="WLC.JOB.37.21.014" x-source="וַֽ" x-translit="wa" srcloc="WLC.JOB.37.21.014" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t019" x-align="JOB.37.21.a016" x-src="WLC.JOB.37.21.015" x-source="תְּטַהֲרֵֽ" x-translit="təṭahăr" srcloc="WLC.JOB.37.21.015" x-head="true" lemma="טָהֵר" strong="H2891">cleareth</char> <char style="w" x-id="t020" x-align="JOB.37.21.a017" x-src="WLC.JOB.37.21.016" x-source="ם" x-translit="ēm" srcloc="WLC.JOB.37.21.016" x-head="true" lemma="הוּא" strong="H3963a">them</char>.<verse eid="JOB 37:21" /></para>
	<para style="q1"><verse number="22" style="v" sid="JOB 37:22" /><char style="w" x-id="t001" x-align="JOB.37.22.a001" x-src="WLC.JOB.37.22.001" x-source="מִ֭" x-translit="mi" srcloc="WLC.JOB.37.22.001" x-head="true" lemma="מִן" strong="H4480">Out</char> <char style="w" x-id="t002" x-align="JOB.37.22.a001">of</char> <char style="w" x-id="t003" x-align="JOB.37.22.a002">the</char> <char style="w" x-id="t004" x-align="JOB.37.22.a002" x-src="WLC.JOB.37.22.002" x-source="צָּפוֹן" x-translit="ṣṣāp̄ôn" srcloc="WLC.JOB.37.22.002" x-head="true" lemma="צָפוֹן" strong="H6828">north</char> <char style="w" x-id="t005" x-align="JOB.37.22.a003" x-src="WLC.JOB.37.22.004" x-source="יֶֽאֱתֶ֑ה" x-translit="yeʾĕṯeh" srcloc="WLC.JOB.37.22.004" x-head="true" lemma="אָתָה" strong="H857">cometh</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">gold</char>.</char></note><char style="w" x-id="t006" x-align="JOB.37.22.a004" x-src="WLC.JOB.37.22.003" x-source="זָהָ֣ב" x-translit="zāhāḇ" srcloc="WLC.JOB.37.22.003" x-head="true" lemma="זָהָב" strong="H2091">golden</char> <char style="w" x-id="t007" x-align="JOB.37.22.a004">splendor</char>:</para>
