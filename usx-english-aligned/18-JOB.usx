	<para style="q1"><verse number="7" style="v" sid="JOB 6:7" /><note caller="-" style="f"><char style="ft">Or, What things <char style="it">my soul refused to touch, these are as my loathsome food</char></char></note><char style="w" x-id="t001" x-align="JOB.6.7.a005" x-src="WLC.JOB.6.7.005" x-source="י" x-translit="iy" srcloc="WLC.JOB.6.7.005" x-head="true" lemma="הוּא" strong="H2967a">My</char> <char style="w" x-id="t002" x-align="JOB.6.7.a004" x-src="WLC.JOB.6.7.004" x-source="נַפְשִׁ֑" x-translit="nap̄š" srcloc="WLC.JOB.6.7.004" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char> <char style="w" x-id="t003" x-align="JOB.6.7.a001" x-src="WLC.JOB.6.7.001" x-source="מֵאֲנָ֣ה" x-translit="mēʾănāh" srcloc="WLC.JOB.6.7.001" x-head="true" lemma="מָאֵן" strong="H3985">refuseth</char> <char style="w" x-id="t004" x-align="JOB.6.7.a002" x-src="WLC.JOB.6.7.002" x-source="לִ" x-translit="li" srcloc="WLC.JOB.6.7.002" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t005" x-align="JOB.6.7.a003" x-src="WLC.JOB.6.7.003" x-source="נְגּ֣וֹעַ" x-translit="nəgôᵃʿ" srcloc="WLC.JOB.6.7.003" x-head="true" lemma="נָגַע" strong="H5060">touch</char> <char style="add"><char style="w" x-id="t006" x-align="JOB.6.7.a006" x-src="WLC.JOB.6.7.006" x-source="הֵ֝֗מָּה" x-translit="hēmmâ" srcloc="WLC.JOB.6.7.006" x-head="true" lemma="הֵמָּה" strong="H1992">them</char></char>;</para>
