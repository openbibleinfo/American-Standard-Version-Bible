	<para style="q1"><verse number="9" style="v" sid="JOB 23:9" /><char style="w" x-id="t001" x-align="JOB.23.9.a001">On</char> <char style="w" x-id="t002" x-align="JOB.23.9.a001">the</char> <char style="w" x-id="t003" x-align="JOB.23.9.a001" x-src="WLC.JOB.23.9.001" x-source="שְׂמֹ֣אול" x-translit="śəmōʾwl" srcloc="WLC.JOB.23.9.001" x-head="true" lemma="שְׂמֹאל" strong="H8040">left</char> <char style="w" x-id="t004" x-align="JOB.23.9.a001">hand</char>, <char style="w" x-id="t005" x-align="JOB.23.9.a002" x-src="WLC.JOB.23.9.002" x-source="בַּ" x-translit="ba" srcloc="WLC.JOB.23.9.002" x-head="true" lemma="בְּ" strong="H871a">when</char> <char style="w" x-id="t006" x-align="JOB.23.9.a003" x-src="WLC.JOB.23.9.004" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.23.9.004" x-head="true" lemma="הוּא" strong="H2050c">he</char> <char style="w" x-id="t007" x-align="JOB.23.9.a004">doth</char> <char style="w" x-id="t008" x-align="JOB.23.9.a004" x-src="WLC.JOB.23.9.003" x-source="עֲשֹׂת֣" x-translit="ʿăśōṯ" srcloc="WLC.JOB.23.9.003" x-head="true" lemma="עָשָׂה" strong="H6213">work</char>, <char style="w" x-id="t009" x-align="JOB.23.9.a005" x-src="WLC.JOB.23.9.005" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.23.9.005" x-head="true" lemma="וְ" strong="H2050b">but</char> <char style="w" x-id="t010" x-align="JOB.23.9.a007">I</char> <char style="w" x-id="t011" x-align="JOB.23.9.a006" x-src="WLC.JOB.23.9.006" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.JOB.23.9.006" x-head="true" lemma="לֹא" strong="H3808">cannot</char> <char style="w" x-id="t012" x-align="JOB.23.9.a007" x-src="WLC.JOB.23.9.007" x-source="אָ֑חַז" x-translit="ʾāḥaz" srcloc="WLC.JOB.23.9.007" x-head="true" lemma="אחז" strong="H2372">behold</char> <char style="w" x-id="t013" x-align="JOB.23.9.a008" x-status="added" x-source="∅" x-head="true">him</char>;</para>
