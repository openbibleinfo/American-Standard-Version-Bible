	<para style="q1"><verse number="19" style="v" sid="JOB 24:19" /><char style="w" x-id="t001" x-align="JOB.24.19.a001" x-src="WLC.JOB.24.19.001" x-source="צִיָּ֤ה" x-translit="ṣiyyāh" srcloc="WLC.JOB.24.19.001" x-head="true" lemma="צִיָּה" strong="H6723">Drought</char> <char style="w" x-id="t002" x-align="JOB.24.19.a002" x-src="WLC.JOB.24.19.002" x-source="גַם" x-translit="ḡam-" srcloc="WLC.JOB.24.19.002" x-head="true" lemma="גַּם" strong="H1571">and</char> <char style="w" x-id="t003" x-align="JOB.24.19.a003" x-src="WLC.JOB.24.19.003" x-source="חֹ֗ם" x-translit="ḥōm" srcloc="WLC.JOB.24.19.003" x-head="true" lemma="חֹם" strong="H2527">heat</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">violently take away</char>.</char></note><char style="w" x-id="t004" x-align="JOB.24.19.a004" x-src="WLC.JOB.24.19.004" x-source="יִגְזְל֥וּ" x-translit="yiḡzəlû" srcloc="WLC.JOB.24.19.004" x-head="true" lemma="גָּזַל" strong="H1497">consume</char> <char style="w" x-id="t005" x-align="JOB.24.19.a006">the</char> <char style="w" x-id="t006" x-align="JOB.24.19.a007" x-src="WLC.JOB.24.19.006" x-source="שֶׁ֗לֶג" x-translit="šeleḡ" srcloc="WLC.JOB.24.19.006" x-head="true" lemma="שֶׁלֶג" strong="H7950">snow</char> <char style="w" x-id="t007" x-align="JOB.24.19.a006" x-src="WLC.JOB.24.19.005" x-source="מֵֽימֵי" x-translit="mēymê-" srcloc="WLC.JOB.24.19.005" x-head="true" lemma="מַיִם" strong="H4325">waters</char>:</para>
