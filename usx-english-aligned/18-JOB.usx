	<para style="q1"><note caller="-" style="f"><char style="ft">Another reading is, <char style="it">While all his bones are firm</char>.</char></note><char style="w" x-id="t010" x-align="JOB.33.19.a008" x-src="WLC.JOB.33.19.v001.r01.001" x-source="ו" x-translit="w" srcloc="WLC.JOB.33.19.v001.r01.001" x-head="true" lemma="וְ">And</char> <char style="w" x-id="t011" x-align="JOB.33.19.a009">with</char> <char style="w" x-id="t012" x-align="JOB.33.19.a012" x-src="WLC.JOB.33.19.012" x-source="אֵתָֽן" x-translit="ʾēṯān:" srcloc="WLC.JOB.33.19.012" x-head="true" lemma="אֵיתָן" strong="H386">continual</char> <char style="w" x-id="t013" x-align="JOB.33.19.a009" x-src="WLC.JOB.33.19.v001.r01.002" x-source="ריב" x-translit="ryḇ" srcloc="WLC.JOB.33.19.v001.r01.002" x-head="true" lemma="רִיב" strong="H7379">strife</char> <char style="w" x-id="t014" x-align="JOB.33.19.a010">in</char> <char style="w" x-id="t015" x-align="JOB.33.19.a011" x-src="WLC.JOB.33.19.011" x-source="ו" x-translit="w" srcloc="WLC.JOB.33.19.011" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t016" x-align="JOB.33.19.a010" x-src="WLC.JOB.33.19.010" x-source="עֲצָמָ֣י" x-translit="ʿăṣāmāy" srcloc="WLC.JOB.33.19.010" x-head="true" lemma="עֶצֶם" strong="H6106">bones</char>;<verse eid="JOB 33:19" /></para>
