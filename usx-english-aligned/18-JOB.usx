	<para style="q1"><verse number="13" style="v" sid="JOB 18:13" /><char style="w" x-id="t001" x-align="JOB.18.13.a002">The</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">bars of his skin</char>.</char></note><char style="w" x-id="t002" x-align="JOB.18.13.a002" x-src="WLC.JOB.18.13.002" x-source="בַּדֵּ֣י" x-translit="baddēy" srcloc="WLC.JOB.18.13.002" x-head="true" lemma="בַּד" strong="H905">members</char> <char style="w" x-id="t003" x-align="JOB.18.13.a003">of</char> <char style="w" x-id="t004" x-align="JOB.18.13.a004" x-src="WLC.JOB.18.13.004" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.18.13.004" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t005" x-align="JOB.18.13.a003" x-src="WLC.JOB.18.13.003" x-source="עוֹר֑" x-translit="ʿôr" srcloc="WLC.JOB.18.13.003" x-head="true" lemma="עוֹר" strong="H5785">body</char> <char style="w" x-id="t006" x-align="JOB.18.13.a001">shall</char> <char style="w" x-id="t007" x-align="JOB.18.13.a001">be</char> <char style="w" x-id="t008" x-align="JOB.18.13.a001" x-src="WLC.JOB.18.13.001" x-source="יֹ֭אכַל" x-translit="yōʾḵal" srcloc="WLC.JOB.18.13.001" x-head="true" lemma="אָכַל" strong="H398">devoured</char>,</para>
	<para style="q1"><char style="add"><char style="w" x-id="t009" x-align="JOB.18.13.a005" x-status="added" x-source="∅" x-head="true">Yea</char></char>, <char style="w" x-id="t010" x-align="JOB.18.13.a009">the</char> <char style="w" x-id="t011" x-align="JOB.18.13.a009">first</char>-<char style="w" x-id="t012" x-align="JOB.18.13.a009" x-src="WLC.JOB.18.13.008" x-source="בְּכ֣וֹר" x-translit="bəḵôr" srcloc="WLC.JOB.18.13.008" x-head="true" lemma="בְּכֹר" strong="H1060">born</char> <char style="w" x-id="t013" x-align="JOB.18.13.a010">of</char> <char style="w" x-id="t014" x-align="JOB.18.13.a010" x-src="WLC.JOB.18.13.009" x-source="מָֽוֶת" x-translit="māweṯ:" srcloc="WLC.JOB.18.13.009" x-head="true" lemma="מָוֶת" strong="H4194">death</char> <char style="w" x-id="t015" x-align="JOB.18.13.a006">shall</char> <char style="w" x-id="t016" x-align="JOB.18.13.a006" x-src="WLC.JOB.18.13.005" x-source="יֹאכַ֥ל" x-translit="yōʾḵal" srcloc="WLC.JOB.18.13.005" x-head="true" lemma="אָכַל" strong="H398">devour</char> <char style="w" x-id="t017" x-align="JOB.18.13.a008" x-src="WLC.JOB.18.13.007" x-source="ו" x-translit="w" srcloc="WLC.JOB.18.13.007" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t018" x-align="JOB.18.13.a007" x-src="WLC.JOB.18.13.006" x-source="בַּ֝דָּ֗י" x-translit="baddāy" srcloc="WLC.JOB.18.13.006" x-head="true" lemma="בַּד" strong="H905">members</char>.<verse eid="JOB 18:13" /></para>
