	<para style="q1"><verse number="14" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.JOB.36.14.003" sid="JOB 36:14" /><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Their soul dieth</char>.</char></note><char style="w" x-id="t001" x-align="JOB.36.14.a001" x-status="noncompositional" x-src="WLC.JOB.36.14.005 WLC.JOB.36.14.006" x-source="נַפְשָׁ֑ ם" x-translit="nap̄š ām" srcloc="WLC.JOB.36.14.005" x-head="true" lemma="נֶפֶשׁ" strong="H5315">They</char> <char style="w" x-id="t002" x-align="JOB.36.14.a002" x-src="WLC.JOB.36.14.001" x-source="תָּמֹ֣ת" x-translit="tāmōṯ" srcloc="WLC.JOB.36.14.001" x-head="true" lemma="מוּת" strong="H4191">die</char> <char style="w" x-id="t003" x-align="JOB.36.14.a003" x-src="WLC.JOB.36.14.002" x-source="בַּ" x-translit="ba" srcloc="WLC.JOB.36.14.002" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t004" x-align="JOB.36.14.a005" x-src="WLC.JOB.36.14.004" x-source="נֹּ֣עַר" x-translit="nnōʿar" srcloc="WLC.JOB.36.14.004" x-head="true" lemma="נֹעַר" strong="H5290">youth</char>,</para>
