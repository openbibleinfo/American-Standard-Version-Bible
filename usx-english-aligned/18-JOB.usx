	<para style="q1"><char style="w" x-id="t017" x-align="JOB.11.6.a012" x-src="WLC.JOB.11.6.012" x-source="דַ֡ע" x-translit="ḏaʿ" srcloc="WLC.JOB.11.6.012" x-head="true" lemma="יָדַע" strong="H3045">Know</char> <char style="w" x-id="t018" x-align="JOB.11.6.a011" x-src="WLC.JOB.11.6.011" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.11.6.011" x-head="true" lemma="וְ" strong="H2050b">therefore</char> <char style="w" x-id="t019" x-align="JOB.11.6.a013" x-src="WLC.JOB.11.6.013" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.11.6.013" x-head="true" lemma="כִּי" strong="H3588">that</char> <char style="w" x-id="t020" x-align="JOB.11.6.a017" x-src="WLC.JOB.11.6.017" x-source="אֱ֝ל֗וֹהַ" x-translit="ʾĕlôᵃh" srcloc="WLC.JOB.11.6.017" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">remitteth</char> (Hebrew <char style="it">causeth to be forgotten</char>) <char style="it">unto thee of thine iniquity</char></char></note><char style="w" x-id="t021" x-align="JOB.11.6.a014" x-src="WLC.JOB.11.6.014" x-source="יַשֶּׁ֥ה" x-translit="yaššeh" srcloc="WLC.JOB.11.6.014" x-head="true" lemma="נָשָׁה" strong="H5382">exacteth</char> <char style="w" x-id="t022" x-align="JOB.11.6.a015" x-src="WLC.JOB.11.6.015" x-source="לְ" x-translit="l" srcloc="WLC.JOB.11.6.015" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t023" x-align="JOB.11.6.a016" x-src="WLC.JOB.11.6.016" x-source="ךָ֥" x-translit="əḵā" srcloc="WLC.JOB.11.6.016" x-head="true" lemma="הוּא" strong="H3509b">thee</char> <char style="w" x-id="t024" x-align="JOB.11.6.a018">less</char> <char style="w" x-id="t025" x-align="JOB.11.6.a018" x-src="WLC.JOB.11.6.018" x-source="מֵ" x-translit="mē" srcloc="WLC.JOB.11.6.018" x-head="true" lemma="מִן" strong="H4480">than</char> <char style="w" x-id="t026" x-align="JOB.11.6.a020" x-src="WLC.JOB.11.6.020" x-source="ךָ" x-translit="eḵā" srcloc="WLC.JOB.11.6.020" x-head="true" lemma="הוּא" strong="H3509b">t