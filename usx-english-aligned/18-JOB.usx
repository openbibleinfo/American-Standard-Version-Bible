	<para style="q1"><verse number="25" style="v" x-unrepresented-source="וַ" x-unrepresented-translit="wa" x-unrepresented-src="WLC.JOB.3.25.004" sid="JOB 3:25" /><char style="w" x-id="t001" x-align="JOB.3.25.a001" x-src="WLC.JOB.3.25.001" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.JOB.3.25.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">the thing which I feared is come etc.</char></char></note><char style="w" x-id="t002" x-align="JOB.3.25.a002">the</char> <char style="w" x-id="t003" x-align="JOB.3.25.a002" x-src="WLC.JOB.3.25.002" x-source="פַ֣חַד" x-translit="p̄aḥaḏ" srcloc="WLC.JOB.3.25.002" x-head="true" lemma="פַּחַד" strong="H6343">thing</char> <char style="w" x-id="t004" x-align="JOB.3.25.a003" x-status="added" x-source="∅" x-head="true">which</char> <char style="w" x-id="t005" x-align="JOB.3.25.a004">I</char> <char style="w" x-id="t006" x-align="JOB.3.25.a004" x-src="WLC.JOB.3.25.003" x-source="פָּ֭חַדְתִּי" x-translit="pāḥaḏtî" srcloc="WLC.JOB.3.25.003" x-head="true" lemma="פָּחַד" strong="H6342">fear</char> <char style="w" x-id="t007" x-align="JOB.3.25.a006" x-src="WLC.JOB.3.25.005" x-source="יֶּאֱתָיֵ֑" x-translit="yyeʾĕṯāy" srcloc="WLC.JOB.3.25.005" x-head="true" lemma="אָתָה" strong="H857">cometh</char> <char style="w" x-id="t008" x-align="JOB.3.25.a006">upon</char> <char style="w" x-id="t009" x-align="JOB.3.25.a007" x-src="WLC.JOB.3.25.006" x-source="נִי" x-translit="ēniy" srcloc="WLC.JOB.3.25.006" x-head="true" lemma="הוּא" strong="H5204a">me</char>,</para>
