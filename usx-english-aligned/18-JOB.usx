	<para style="q1"><verse number="20" style="v" sid="JOB 22:20" /><char style="add"><char style="w" x-id="t001" x-align="JOB.22.20.a001" x-status="added" x-source="∅" x-head="true">Saying</char></char>, <char style="w" x-id="t002" x-align="JOB.22.20.a002" x-src="WLC.JOB.22.20.001 WLC.JOB.22.20.002" x-source="אִם לֹ֣א" x-translit="ʾim- lōʾ" srcloc="WLC.JOB.22.20.001" x-head="true" lemma="אִם" strong="H518">Surely</char> <char style="w" x-id="t003" x-align="JOB.22.20.a004">they</char> <char style="w" x-id="t004" x-align="JOB.22.20.a004">that</char> <char style="w" x-id="t005" x-align="JOB.22.20.a004">did</char> <char style="w" x-id="t006" x-align="JOB.22.20.a004" x-src="WLC.JOB.22.20.004" x-source="קִימָ֑" x-translit="qiym" srcloc="WLC.JOB.22.20.004" x-head="true" lemma="קִים" strong="H7009">rise</char> <char style="w" x-id="t007" x-align="JOB.22.20.a004">up</char> <char style="w" x-id="t008" x-align="JOB.22.20.a004">against</char> <char style="w" x-id="t009" x-align="JOB.22.20.a005" x-src="WLC.JOB.22.20.005" x-source="נוּ" x-translit="ānû" srcloc="WLC.JOB.22.20.005" x-head="true" lemma="הוּא" strong="H5105a">us</char> <char style="w" x-id="t010" x-align="JOB.22.20.a003">are</char> <char style="w" x-id="t011" x-align="JOB.22.20.a003" x-src="WLC.JOB.22.20.003" x-source="נִכְחַ֣ד" x-translit="niḵḥaḏ" srcloc="WLC.JOB.22.20.003" x-head="true" lemma="כָּחַד" strong="H3582">cut</char> <char style="w" x-id="t012" x-align="JOB.22.20.a003">off</char>,</para>
	<para style="q1"><char style="w" x-id="t013" x-align="JOB.22.20.a006" x-src="WLC.JOB.22.20.006" x-source="וְ֝" x-translit="wə" srcloc="WLC.JOB.22.20.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">that which remained to them</char>. Or, <char style="it">their abundance</char></char></note><char style="w" x-id="t014" x-align="JOB.22.20.a007">the</char> <char style="w" x-id="t015" x-align="JOB.22.20.a007" x-src="WLC.JOB.22.20.007" x-source="יִתְרָ֗" x-translit="yiṯr" srcloc="WLC.JOB.22.20.007" x-head="true" lemma="יֶתֶר" strong="H3499">remnant</char> <char style="w" x-id="t016" x-align="JOB.22.20.a008">of</char> <char style="w" x-id="t017" x-align="JOB.22.20.a008" x-src="WLC.JOB.22.20.008" x-source="ם" x-translit="ām" srcloc="WLC.JOB.22.20.008" x-head="true" lemma="הוּא" strong="H3963a">them</char> <char style="w" x-id="t018" x-align="JOB.22.20.a010">the</char> <char style="w" x-id="t019" x-align="JOB.22.20.a010" x-src="WLC.JOB.22.20.010" x-source="אֵֽשׁ" x-translit="ʾēš:" srcloc="WLC.JOB.22.20.010" x-head="true" lemma="אֵשׁ" strong="H784">fire</char> <char style="w" x-id="t020" x-align="JOB.22.20.a009">hath</char> <char style="w" x-id="t021" x-align="JOB.22.20.a009" x-src="WLC.JOB.22.20.009" x-source="אָ֣כְלָה" x-translit="ʾāḵəlâ" srcloc="WLC.JOB.22.20.009" x-head="true" lemma="אָכַל" strong="H398">consumed</char>.<verse eid="JOB 22:20" /></para>
