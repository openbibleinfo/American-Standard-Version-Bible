	<para style="p"><char style="w" x-id="t001" x-align="JOB.15.1.a001" x-src="WLC.JOB.15.1.001" x-source="וַ֭" x-translit="wa" srcloc="WLC.JOB.15.1.001" x-head="true" lemma="וְ" strong="H2050b">Then</char> <char style="w" x-id="t002" x-align="JOB.15.1.a002" x-src="WLC.JOB.15.1.002" x-source="יַּעַן" x-translit="yyaʿan" srcloc="WLC.JOB.15.1.002" x-head="true" lemma="עָנָה" strong="H6030">answered</char> <char style="w" x-id="t003" x-align="JOB.15.1.a003" x-src="WLC.JOB.15.1.003" x-source="אֱלִיפַ֥ז" x-translit="ʾĕlîp̄az" srcloc="WLC.JOB.15.1.003" x-head="true" lemma="אֱלִיפַז" strong="H464">Eliphaz</char> <char style="w" x-id="t004" x-align="JOB.15.1.a004" x-src="WLC.JOB.15.1.004" x-source="הַֽ" x-translit="ha" srcloc="WLC.JOB.15.1.004" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t005" x-align="JOB.15.1.a005" x-src="WLC.JOB.15.1.005" x-source="תֵּימָנִ֗י" x-translit="têmāniy" srcloc="WLC.JOB.15.1.005" x-head="true" lemma="תֵּימָנִי" strong="H8489">Temanite</char>, <char style="w" x-id="t006" x-align="JOB.15.1.a006" x-src="WLC.JOB.15.1.006" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.15.1.006" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t007" x-align="JOB.15.1.a007" x-src="WLC.JOB.15.1.007" x-source="יֹּאמַֽר" x-translit="yyōʾmar:" srcloc="WLC.JOB.15.1.007" x-head="true" lemma="אָמַר" strong="H559">said</char>,<verse eid="JOB 15:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="JOB 15:2" /><char style="w" x-id="t001" x-align="JOB.15.2.a001" x-src="WLC.JOB.15.2.001" x-source="הֶֽ" x-translit="he" srcloc="WLC.JOB.15.2.001" x-head="true" lemma="הַ" strong="H1886b">Should</char> <char style="w" x-id="t002" x-align="JOB.15.2.a002">a</char> <char style="w" x-id="t003" x-align="JOB.15.2.a002" x-src="WLC.JOB.15.2.002" x-source="חָכָ֗ם" x-translit="ḥāḵām" srcloc="WLC.JOB.15.2.002" x-head="true" lemma="חָכָם" strong="H2450">wise</char> <char style="w" x-id="t004" x-align="JOB.15.2.a002">man</char> <char style="w" x-id="t005" x-align="JOB.15.2.a003">make</char> <char style="w" x-id="t006" x-align="JOB.15.2.a003" x-src="WLC.JOB.15.2.003" x-source="יַעֲנֶ֥ה" x-translit="yaʿăneh" srcloc="WLC.JOB.15.2.003" x-head="true" lemma="עָנָה" strong="H6030">answer</char> <char style="w" x-id="t007" x-align="JOB.15.2.a003">with</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">knowledge of wind</char>.</char></note><char style="w" x-id="t008" x-align="JOB.15.2.a005" x-src="WLC.JOB.15.2.005" x-source="ר֑וּחַ" x-translit="rûᵃḥ" srcloc="WLC.JOB.15.2.005" x-head="true" lemma="רוּחַ" strong="H7307">vain</char> <char style="w" x-id="t009" x-align="JOB.15.2.a004" x-src="WLC.JOB.15.2.004" x-source="דַֽעַת" x-translit="ḏaʿaṯ-" srcloc="WLC.JOB.15.2.004" x-head="true" lemma="דַּעַת" strong="H1847">knowledge</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.15.2.a006" x-src="WLC.JOB.15.2.006" x-source="וִֽ" x-translit="wi" srcloc="WLC.JOB.15.2.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.15.2.a007" x-src="WLC.JOB.15.2.007" x-source="ימַלֵּ֖א" x-translit="ymallēʾ" srcloc="WLC.JOB.15.2.007" x-head="true" lemma="מָלֵא" strong="H4390">fill</char> <char style="w" x-id="t012" x-align="JOB.15.2.a009" x-src="WLC.JOB.15.2.009 WLC.JOB.15.2.010" x-source="בִּטְנֽ וֹ" x-translit="biṭn ô" srcloc="WLC.JOB.15.2.010" x-head="true" lemma="הוּא" strong="H2050c">himself</char> <char style="w" x-id="t013" x-align="JOB.15.2.a007">with</char> <char style="w" x-id="t014" x-align="JOB.15.2.a008">the</char> <char style="w" x-id="t015" x-align="JOB.15.2.a008">east</char> <char style="w" x-id="t016" x-align="JOB.15.2.a008" x-src="WLC.JOB.15.2.008" x-source="קָדִ֣ים" x-translit="qāḏiym" srcloc="WLC.JOB.15.2.008" x-head="true" lemma="קָדִים" strong="H6921">wind</char>?<verse eid="JOB 15:2" /></para>
