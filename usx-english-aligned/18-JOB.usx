	<para style="q1"><verse number="5" style="v" sid="JOB 8:5" /><char style="w" x-id="t001" x-align="JOB.8.5.a001" x-src="WLC.JOB.8.5.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.8.5.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JOB.8.5.a002" x-src="WLC.JOB.8.5.002" x-source="אַ֭תָּה" x-translit="ʾattâ" srcloc="WLC.JOB.8.5.002" x-head="true" lemma="אַתָּה" strong="H859">thou</char> <char style="w" x-id="t003" x-align="JOB.8.5.a003">wouldest</char> <char style="w" x-id="t004" x-align="JOB.8.5.a003" x-src="WLC.JOB.8.5.003" x-source="תְּשַׁחֵ֣ר" x-translit="təšaḥēr" srcloc="WLC.JOB.8.5.003" x-head="true" lemma="שָׁחַר" strong="H7836">seek</char> <char style="w" x-id="t005" x-align="JOB.8.5.a003">diligently</char> <char style="w" x-id="t006" x-align="JOB.8.5.a004" x-src="WLC.JOB.8.5.004" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.JOB.8.5.004" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t007" x-align="JOB.8.5.a005" x-src="WLC.JOB.8.5.005" x-source="אֵ֑ל" x-translit="ʾēl" srcloc="WLC.JOB.8.5.005" x-head="true" lemma="אֵל" strong="H410">God</char>,</para>
