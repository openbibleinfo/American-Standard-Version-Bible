	<para style="q1"><verse number="26" style="v" sid="JOB 3:26" /><char style="w" x-id="t001" x-align="JOB.3.26.a002">I</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">was not at ease . . . yet trouble came</char></char></note><char style="w" x-id="t002" x-align="JOB.3.26.a002">am</char> <char style="w" x-id="t003" x-align="JOB.3.26.a001" x-src="WLC.JOB.3.26.001" x-source="לֹ֤א" x-translit="lōʾ" srcloc="WLC.JOB.3.26.001" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t004" x-align="JOB.3.26.a002">at</char> <char style="w" x-id="t005" x-align="JOB.3.26.a002" x-src="WLC.JOB.3.26.002" x-source="שָׁלַ֨וְתִּי" x-translit="šālawətî" srcloc="WLC.JOB.3.26.002" x-head="true" lemma="שָׁלָה" strong="H7951">ease</char>, <char style="w" x-id="t006" x-align="JOB.3.26.a003" x-src="WLC.JOB.3.26.003 WLC.JOB.3.26.004" x-source="וְ לֹ֖א" x-translit="wə lōʾ" srcloc="WLC.JOB.3.26.004" x-head="true" lemma="לֹא" strong="H3808">neither</char> <char style="w" x-id="t007" x-align="JOB.3.26.a004">am</char> <char style="w" x-id="t008" x-align="JOB.3.26.a004">I</char> <char style="w" x-id="t009" x-align="JOB.3.26.a004" x-src="WLC.JOB.3.26.005" x-source="שָׁקַ֥טְתִּי" x-translit="šāqaṭətî" srcloc="WLC.JOB.3.26.005" x-head="true" lemma="שָׁקַט" strong="H8252">quiet</char>, <char style="w" x-id="t010" x-align="JOB.3.26.a005" x-src="WLC.JOB.3.26.006 WLC.JOB.3.26.007" x-source="וְֽ לֹא" x-translit="wə lōʾ-" srcloc="WLC.JOB.3.26.007" x-head="true" lemma="לֹא" strong="H3808">neither</char> <char style="w" x-id="t011" x-align="JOB.3.26.a006">have</char> <char style="w" x-id="t012" x-align="JOB.3.26.a006">I</char> <char style="w" x-id="t013" x-align="JOB.3.26.a006" x-src="WLC.JOB.3.26.008" x-source="נָ֗חְתִּי" x-translit="nāḥətî" srcloc="WLC.JOB.3.26.008" x-head="true" lemma="נוּחַ" strong="H5117">rest</char>;</para>
