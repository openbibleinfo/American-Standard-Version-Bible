	<para style="q1"><verse number="19" style="v" sid="JOB 21:19" /><note caller="-" style="f"><char style="ft">Or, <char style="it">God layeth up his iniquity for his children: He rewardeth him, and he shall know it. His eyes shall see his destruction, and he shall drink etc.</char></char></note><char style="add"><char style="w" x-id="t001" x-align="JOB.21.19.a001" x-status="added">Ye</char> <char style="w" x-id="t002" x-align="JOB.21.19.a001" x-status="added" x-source="∅" x-head="true">say</char></char>, <char style="w" x-id="t003" x-align="JOB.21.19.a002" x-src="WLC.JOB.21.19.001" x-source="אֱל֗וֹהַּ" x-translit="ʾĕlôᵃẖ" srcloc="WLC.JOB.21.19.001" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char> <char style="w" x-id="t004" x-align="JOB.21.19.a003" x-src="WLC.JOB.21.19.002" x-source="יִצְפֹּן" x-translit="yiṣpōn-" srcloc="WLC.JOB.21.19.002" x-head="true" lemma="צָפַן" strong="H6845">layeth</char> <char style="w" x-id="t005" x-align="JOB.21.19.a003">up</char> <char style="w" x-id="t006" x-align="JOB.21.19.a008" x-src="WLC.JOB.21.19.007" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.21.19.007" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="JOB.21.19.a007" x-src="WLC.JOB.21.19.006" x-source="אוֹנ֑" x-translit="ʾôn" srcloc="WLC.JOB.21.19.006" x-head="true" lemma="אָוֶן" strong="H205">iniquity</char> <char style="w" x-id="t008" x-align="JOB.21.19.a004" x-src="WLC.JOB.21.19.003" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.21.19.003" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t009" x-align="JOB.21.19.a006" x-src="WLC.JOB.21.19.005" x-source="ו" x-translit="w" srcloc="WLC.JOB.21.19.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t010" x-align="JOB.21.19.a005" x-src="WLC.JOB.21.19.004" x-source="בָנָ֥י" x-translit="ḇānāy" srcloc="WLC.JOB.21.19.004" x-head="true" lemma="בֵּן" strong="H1121">children</char>.</para>
