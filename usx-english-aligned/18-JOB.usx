	<para style="q1"><verse number="14" style="v" sid="JOB 34:14" /><note caller="-" style="f"><char style="ft">According to another reading, <char style="it">If he cause his heart to return unto himself</char>.</char></note><char style="w" x-id="t001" x-align="JOB.34.14.a001" x-src="WLC.JOB.34.14.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.34.14.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JOB.34.14.a002">he</char> <char style="w" x-id="t003" x-align="JOB.34.14.a002" x-src="WLC.JOB.34.14.002" x-source="יָשִׂ֣ים" x-translit="yāśiym" srcloc="WLC.JOB.34.14.002" x-head="true" lemma="שׂים" strong="H7760">set</char> <char style="w" x-id="t004" x-align="JOB.34.14.a006" x-src="WLC.JOB.34.14.006" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.34.14.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t005" x-align="JOB.34.14.a005" x-src="WLC.JOB.34.14.005" x-source="לִבּ֑" x-translit="libb" srcloc="WLC.JOB.34.14.005" x-head="true" lemma="לֵב" strong="H3820">heart</char> <char style="w" x-id="t006" x-align="JOB.34.14.a003" x-src="WLC.JOB.34.14.003" x-source="אֵלָ֣י" x-translit="ʾēlāy" srcloc="WLC.JOB.34.14.003" x-head="true" lemma="אֶל" strong="H413">upon</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">man</char>. Hebrew <char style="it">him</char>.</char></note><char style="w" x-id="t007" x-align="JOB.34.14.a004" x-src="WLC.JOB.34.14.004" x-source="ו" x-translit="w" srcloc="WLC.JOB.34.14.004" x-head="true" lemma="הוּא" strong="H2050c">himself</char>,</para>
