	<para style="q1"><verse number="13" style="v" sid="JOB 26:13" /><char style="w" x-id="t001" x-align="JOB.26.13.a001" x-src="WLC.JOB.26.13.001" x-source="בְּ֭" x-translit="bə" srcloc="WLC.JOB.26.13.001" x-head="true" lemma="בְּ" strong="H871a">By</char> <char style="w" x-id="t002" x-align="JOB.26.13.a003" x-src="WLC.JOB.26.13.003" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.26.13.003" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t003" x-align="JOB.26.13.a002" x-src="WLC.JOB.26.13.002" x-source="רוּח" x-translit="rûḥ" srcloc="WLC.JOB.26.13.002" x-head="true" lemma="רוּחַ" strong="H7307">Spirit</char> <char style="w" x-id="t004" x-align="JOB.26.13.a004">the</char> <char style="w" x-id="t005" x-align="JOB.26.13.a004" x-src="WLC.JOB.26.13.004" x-source="שָׁמַ֣יִם" x-translit="šāmayim" srcloc="WLC.JOB.26.13.004" x-head="true" lemma="שָׁמַיִם" strong="H8064">heavens</char> <char style="w" x-id="t006" x-align="JOB.26.13.a005">are</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">beauty</char>.</char></note><char style="w" x-id="t007" x-align="JOB.26.13.a005" x-src="WLC.JOB.26.13.005" x-source="שִׁפְרָ֑ה" x-translit="šip̄rāh" srcloc="WLC.JOB.26.13.005" x-head="true" lemma="שִׁפְרָה" strong="H8235">garnished</char>;</para>
