	<para style="q1"><verse number="26" style="v" sid="JOB 19:26" /><note caller="-" style="f"><char style="ft">Or, <char style="it">And after my skin hath been thus destroyed, Yet from my flesh shall I see God</char></char></note><char style="w" x-id="t001" x-align="JOB.19.26.a001" x-src="WLC.JOB.19.26.001" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.19.26.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="JOB.19.26.a002" x-src="WLC.JOB.19.26.002" x-source="אַחַ֣ר" x-translit="ʾaḥar" srcloc="WLC.JOB.19.26.002" x-head="true" lemma="אַחַר" strong="H310">after</char> <char style="w" x-id="t003" x-align="JOB.19.26.a004" x-src="WLC.JOB.19.26.004" x-source="י" x-translit="iy" srcloc="WLC.JOB.19.26.004" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t004" x-align="JOB.19.26.a003" x-src="WLC.JOB.19.26.003" x-source="ע֭וֹרִֽ" x-translit="ʿôr" srcloc="WLC.JOB.19.26.003" x-head="true" lemma="עוֹר" strong="H5785">skin</char>, <char style="add"><char style="w" x-id="t005" x-align="JOB.19.26.a005" x-status="added" x-source="∅" x-head="true">even</char></char> <char style="w" x-id="t006" x-align="JOB.19.26.a006" x-src="WLC.JOB.19.26.006" x-source="זֹ֑את" x-translit="zōʾṯ" srcloc="WLC.JOB.19.26.006" x-head="true" lemma="זֹאת" strong="H2063">this</char> <char style="add"><char style="w" x-id="t007" x-align="JOB.19.26.a006">body</char></char>, <char style="w" x-id="t008" x-align="JOB.19.26.a007">is</char> <char style="w" x-id="t009" x-align="JOB.19.26.a007" x-src="WLC.JOB.19.26.005" x-source="נִקְּפוּ" x-translit="niqqəp̄û-" srcloc="WLC.JOB.19.26.005" x-head="true" lemma="נָקַף" strong="H5362">destroyed</char>,</para>
