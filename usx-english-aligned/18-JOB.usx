	<para style="q1"><char style="w" x-id="t011" x-align="JOB.9.20.a007" x-status="added" x-source="∅" x-head="true">Though</char> <char style="w" x-id="t012" x-align="JOB.9.20.a009" x-src="WLC.JOB.9.20.008" x-source="אָ֝֗נִי" x-translit="ʾānî" srcloc="WLC.JOB.9.20.008" x-head="true" lemma="אֲנִי" strong="H589">I</char> <char style="w" x-id="t013" x-align="JOB.9.20.a008">be</char> <char style="w" x-id="t014" x-align="JOB.9.20.a008" x-src="WLC.JOB.9.20.007" x-source="תָּֽם" x-translit="tām-" srcloc="WLC.JOB.9.20.007" x-head="true" lemma="תָּם" strong="H8535">perfect</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">he</char></char></note><char style="w" x-id="t015" x-align="JOB.9.20.a011">it</char> <char style="w" x-id="t016" x-align="JOB.9.20.a011">shall</char> <char style="w" x-id="t017" x-align="JOB.9.20.a011">prove</char> <char style="w" x-id="t018" x-align="JOB.9.20.a012" x-src="WLC.JOB.9.20.011" x-source="נִי" x-translit="ēniy" srcloc="WLC.JOB.9.20.011" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t019" x-align="JOB.9.20.a011" x-src="WLC.JOB.9.20.010" x-source="יַּעְקְשֵֽׁ" x-translit="yyaʿqəš" srcloc="WLC.JOB.9.20.010" x-head="true" lemma="עָקַשׁ" strong="H6140">perverse</char>.<verse eid="JOB 9:20" /></para>
	<para style="q1"><verse number="21" style="v" sid="JOB 9:21" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Though I be perfect, I will not regard etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.9.21.a002" x-src="WLC.JOB.9.21.002" x-source="אָ֭נִי" x-translit="ʾānî" srcloc="WLC.JOB.9.21.002" x-head="true" lemma="אֲנִי" strong="H589">I</char> <char style="w" x-id="t002" x-align="JOB.9.21.a001">am</char> <char style="w" x-id="t003" x-align="JOB.9.21.a001" x-src="WLC.JOB.9.21.001" x-source="תָּֽם" x-translit="tām-" srcloc="WLC.JOB.9.21.001" x-head="true" lemma="תָּם" strong="H8535">perfect</char>; <char style="w" x-id="t004" x-align="JOB.9.21.a004">I</char> <char style="w" x-id="t005" x-align="JOB.9.21.a004" x-src="WLC.JOB.9.21.004" x-source="אֵדַ֥ע" x-translit="ʾēḏaʿ" srcloc="WLC.JOB.9.21.004" x-head="true" lemma="יָדַע" strong="H3045">regard</char> <char style="w" x-id="t006" x-align="JOB.9.21.a003" x-src="WLC.JOB.9.21.003" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.JOB.9.21.003" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t007" x-align="JOB.9.21.a005" x-src="WLC.JOB.9.21.005 WLC.JOB.9.21.006" x-source="נַפְשִׁ֗ י" x-translit="nap̄š iy" srcloc="WLC.JOB.9.21.005" x-head="true" lemma="נֶפֶשׁ" strong="H5315">myself</char>;</para>
	<para style="q1"><char style="w" x-id="t008" x-align="JOB.9.21.a006">I</char> <char style="w" x-id="t009" x-align="JOB.9.21.a006" x-src="WLC.JOB.9.21.007" x-source="אֶמְאַ֥ס" x-translit="ʾemʾas" srcloc="WLC.JOB.9.21.007" x-head="true" lemma="מָאַס" strong="H3988">despise</char> <char style="w" x-id="t010" x-align="JOB.9.21.a008" x-src="WLC.JOB.9.21.009" x-source="י" x-translit="āy" srcloc="WLC.JOB.9.21.009" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t011" x-align="JOB.9.21.a007" x-src="WLC.JOB.9.21.008" x-source="חַיָּֽ" x-translit="ḥay" srcloc="WLC.JOB.9.21.008" x-head="true" lemma="חַיִּים" strong="H2416">life</char>.<verse eid="JOB 9:21" /></para>
