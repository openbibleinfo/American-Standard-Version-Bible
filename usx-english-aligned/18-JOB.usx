	<para style="q1"><char style="w" x-id="t010" x-align="JOB.9.18.a007" x-src="WLC.JOB.9.18.007" x-source="כִּ֥י" x-translit="kiy" srcloc="WLC.JOB.9.18.007" x-head="true" lemma="כִּי" strong="H3588">But</char> <char style="w" x-id="t011" x-align="JOB.9.18.a008" x-src="WLC.JOB.9.18.008" x-source="יַ֝שְׂבִּעַ֗" x-translit="yaśbiʿ" srcloc="WLC.JOB.9.18.008" x-head="true" lemma="שָׂבֵעַ" strong="H7646">filleth</char> <char style="w" x-id="t012" x-align="JOB.9.18.a009" x-src="WLC.JOB.9.18.009" x-source="נִי" x-translit="aniy" srcloc="WLC.JOB.9.18.009" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t013" x-align="JOB.9.18.a010">with</char> <char style="w" x-id="t014" x-align="JOB.9.18.a010" x-src="WLC.JOB.9.18.010" x-source="מַמְּרֹרִֽים" x-translit="mammərōriym:" srcloc="WLC.JOB.9.18.010" x-head="true" lemma="מַמְּרֹורִים" strong="H4472">bitterness</char>.<verse eid="JOB 9:18" /></para>
	<para style="q1"><verse number="19" style="v" sid="JOB 9:19" /><char style="w" x-id="t001" x-align="JOB.9.19.a001" x-src="WLC.JOB.9.19.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.9.19.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="add"><char style="w" x-id="t002" x-align="JOB.9.19.a002" x-status="added">we</char> <char style="w" x-id="t003" x-align="JOB.9.19.a002" x-status="added" x-source="∅" x-head="true">speak</char></char> <char style="w" x-id="t004" x-align="JOB.9.19.a003" x-src="WLC.JOB.9.19.002" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.9.19.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t005" x-align="JOB.9.19.a004" x-src="WLC.JOB.9.19.003" x-source="כֹ֣חַ" x-translit="ḵōᵃḥ" srcloc="WLC.JOB.9.19.003" x-head="true" lemma="כֹּחַ" strong="H3581">strength</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">Lo</char>, here am I, saith he; <char style="it">And if of judgement, Who etc.</char></char></note><char style="w" x-id="t006" x-align="JOB.9.19.a006" x-src="WLC.JOB.9.19.005" x-source="הִנֵּ֑ה" x-translit="hinnēh" srcloc="WLC.JOB.9.19.005" x-head="true" lemma="הִנֵּה" strong="H2009">lo</char>, <char style="add"><char style="w" x-id="t007" x-align="JOB.9.19.a005">he</char> <char style="w" x-id="t008" x-align="JOB.9.19.a005">is</char></char> <char style="w" x-id="t009" x-align="JOB.9.19.a005" x-src="WLC.JOB.9.19.004" x-source="אַמִּ֣יץ" x-translit="ʾammiyṣ" srcloc="WLC.JOB.9.19.004" x-head="true" lemma="אַמִּיץ" strong="H533">mighty</char>!</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.9.19.a007" x-src="WLC.JOB.9.19.006" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.9.19.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.9.19.a008" x-src="WLC.JOB.9.19.007" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.9.19.007" x-head="true" lemma="אִם" strong="H518">if</char> <char style="w" x-id="t012" x-align="JOB.9.19.a009" x-src="WLC.JOB.9.19.008" x-source="לְ֝" x-translit="lə" srcloc="WLC.JOB.9.19.008" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t013" x-align="JOB.9.19.a010" x-src="WLC.JOB.9.19.009" x-source="מִשְׁפָּ֗ט" x-translit="mišpāṭ" srcloc="WLC.JOB.9.19.009" x-head="true" lemma="מִשְׁפָּט" strong="H4941">justice</char>, <char style="w" x-id="t014" x-align="JOB.9.19.a011" x-src="WLC.JOB.9.19.010" x-source="מִ֣י" x-translit="miy" srcloc="WLC.JOB.9.19.010" x-head="true" lemma="מִי" strong="H4310">Who</char>, <char style="add"><char style="w" x-id="t015" x-align="JOB.9.19.a012" x-status="added" x-source="∅" x-head="true">saith</char> <char style="w" x-id="t016" x-align="JOB.9.19.a012" x-status="added">he</char></char>, <char style="w" x-id="t017" x-align="JOB.9.19.a013">will</char> <char style="w" x-id="t018" x-align="JOB.9.19.a013" x-src="WLC.JOB.9.19.011" x-source="יוֹעִידֵֽ" x-translit="yôʿiyḏ" srcloc="WLC.JOB.9.19.011" x-head="true" lemma="יָעַד" strong="H3259">summon</char> <char style="w" x-id="t019" x-align="JOB.9.19.a014" x-src="WLC.JOB.9.19.012" x-source="נִי" x-translit="ēniy" srcloc="WLC.JOB.9.19.012" x-head="true" lemma="הוּא" strong="H5204a">me</char>?<verse eid="JOB 9:19" /></para>
