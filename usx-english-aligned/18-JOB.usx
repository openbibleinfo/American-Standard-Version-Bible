	<para style="q1"><verse number="20" style="v" sid="JOB 18:20" /><note caller="-" style="f"><char style="ft">Or, <char style="it">They that dwell in the west are . . . as they that well in the east are etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.18.20.a005">They</char> <char style="w" x-id="t002" x-align="JOB.18.20.a005">that</char> <char style="w" x-id="t003" x-align="JOB.18.20.a005">come</char> <char style="w" x-id="t004" x-align="JOB.18.20.a005" x-src="WLC.JOB.18.20.005" x-source="אַחֲרֹנִ֑ים" x-translit="ʾaḥărōniym" srcloc="WLC.JOB.18.20.005" x-head="true" lemma="אַחֲרוֹן" strong="H314">after</char> <char style="w" x-id="t005" x-align="JOB.18.20.a004">shall</char> <char style="w" x-id="t006" x-align="JOB.18.20.a004">be</char> <char style="w" x-id="t007" x-align="JOB.18.20.a004" x-src="WLC.JOB.18.20.004" x-source="נָשַׁ֣מּוּ" x-translit="nāšammû" srcloc="WLC.JOB.18.20.004" x-head="true" lemma="שָׁמֵם" strong="H8074">astonished</char> <char style="w" x-id="t008" x-align="JOB.18.20.a001" x-src="WLC.JOB.18.20.001" x-source="עַל" x-translit="ʿal-" srcloc="WLC.JOB.18.20.001" x-head="true" lemma="עַל" strong="H5921">at</char> <char style="w" x-id="t009" x-align="JOB.18.20.a003" x-src="WLC.JOB.18.20.003" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.18.20.003" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t010" x-align="JOB.18.20.a002" x-src="WLC.JOB.18.20.002" x-source="י֭וֹמ" x-translit="yôm" srcloc="WLC.JOB.18.20.002" x-head="true" lemma="יוֹם" strong="H3117">day</char>,</para>
