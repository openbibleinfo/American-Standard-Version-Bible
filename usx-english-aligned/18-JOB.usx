	<para style="q1"><verse number="15" style="v" sid="JOB 34:15" /><char style="w" x-id="t001" x-align="JOB.34.15.a002" x-src="WLC.JOB.34.15.002" x-source="כָּל" x-translit="kol-" srcloc="WLC.JOB.34.15.002" x-head="true" lemma="כֹּל" strong="H3605">All</char> <char style="w" x-id="t002" x-align="JOB.34.15.a003" x-src="WLC.JOB.34.15.003" x-source="בָּשָׂ֣ר" x-translit="bāśār" srcloc="WLC.JOB.34.15.003" x-head="true" lemma="בָּשָׂר" strong="H1320">flesh</char> <char style="w" x-id="t003" x-align="JOB.34.15.a001">shall</char> <char style="w" x-id="t004" x-align="JOB.34.15.a001" x-src="WLC.JOB.34.15.001" x-source="יִגְוַ֣ע" x-translit="yiḡwaʿ" srcloc="WLC.JOB.34.15.001" x-head="true" lemma="גָּוַע" strong="H1478">perish</char> <char style="w" x-id="t005" x-align="JOB.34.15.a004" x-src="WLC.JOB.34.15.004" x-source="יָ֑חַד" x-translit="yāḥaḏ" srcloc="WLC.JOB.34.15.004" x-head="true" lemma="יַחַד" strong="H3162">together</char>,</para>
	<para style="q1"><char style="w" x-id="t006" x-align="JOB.34.15.a005" x-src="WLC.JOB.34.15.005" x-source="וְ֝" x-translit="wə" srcloc="WLC.JOB.34.15.005" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t007" x-align="JOB.34.15.a006" x-src="WLC.JOB.34.15.006" x-source="אָדָ֗ם" x-translit="ʾāḏām" srcloc="WLC.JOB.34.15.006" x-head="true" lemma="אָדָם" strong="H120">man</char> <char style="w" x-id="t008" x-align="JOB.34.15.a009">shall</char> <char style="w" x-id="t009" x-align="JOB.34.15.a009" x-src="WLC.JOB.34.15.009" x-source="יָשֽׁוּב" x-translit="yāšûḇ:" srcloc="WLC.JOB.34.15.009" x-head="true" lemma="שׁוּב" strong="H7725">turn</char> <char style="w" x-id="t010" x-align="JOB.34.15.a009">again</char> <char style="w" x-id="t011" x-align="JOB.34.15.a007" x-src="WLC.JOB.34.15.007" x-source="עַל" x-translit="ʿal-" srcloc="WLC.JOB.34.15.007" x-head="true" lemma="עַל" strong="H5921">unto</char> <char style="w" x-id="t012" x-align="JOB.34.15.a008" x-src="WLC.JOB.34.15.008" x-source="עָפָ֥ר" x-translit="ʿāp̄ār" srcloc="WLC.JOB.34.15.008" x-head="true" lemma="עָפָר" strong="H6083">dust</char>.<verse eid="JOB 34:15" /></para>
	<para style="b"><verse number="16" style="v" x-unrepresented-source="ה ה" x-unrepresented-translit="āh- āh" x-unrepresented-src="WLC.JOB.34.16.005 WLC.JOB.34.16.008" sid="JOB 34:16" /></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Only understand</char></char></note><char style="w" x-id="t001" x-align="JOB.34.16.a002" x-src="WLC.JOB.34.16.002" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.34.16.002" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JOB.34.16.a001" x-src="WLC.JOB.34.16.001" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.34.16.001" x-head="true" lemma="וְ" strong="H2050b">now</char> <char style="add"><char style="w" x-id="t003" x-align="JOB.34.16.a013" x-status="added">thou</char> <char style="w" x-id="t004" x-align="JOB.34.16.a013" x-status="added" x-source="∅" x-head="true">hast</char></char> <char style="w" x-id="t005" x-align="JOB.34.16.a003" x-src="WLC.JOB.34.16.003" x-source="בִּ֥ינָה" x-translit="biynâ" srcloc="WLC.JOB.34.16.003" x-head="true" lemma="בִּינָה" strong="H998">understanding</char>, <char style="w" x-id="t006" x-align="JOB.34.16.a004" x-src="WLC.JOB.34.16.004" x-source="שִׁמְעָ" x-translit="šimʿ" srcloc="WLC.JOB.34.16.004" x-head="true" lemma="שָׁמַע" strong="H8085">hear</char> <char style="w" x-id="t007" x-align="JOB.34.16.a006" x-src="WLC.JOB.34.16.006" x-source="זֹּ֑את" x-translit="zzōʾṯ" srcloc="WLC.JOB.34.16.006" x-head="true" lemma="זֹאת" strong="H2063">this</char>:</para>
	<para style="q1"><char style="w" x-id="t008" x-align="JOB.34.16.a007" x-src="WLC.JOB.34.16.007" x-source="הַ֝אֲזִ֗ינָ" x-translit="haʾăziyn" srcloc="WLC.JOB.34.16.007" x-head="true" lemma="אָזַן" strong="H238">Hearken</char> <char style="w" x-id="t009" x-align="JOB.34.16.a009" x-src="WLC.JOB.34.16.009" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.34.16.009" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t010" x-align="JOB.34.16.a010">the</char> <char style="w" x-id="t011" x-align="JOB.34.16.a010" x-src="WLC.JOB.34.16.010" x-source="ק֣וֹל" x-translit="qôl" srcloc="WLC.JOB.34.16.010" x-head="true" lemma="קוֹל" strong="H6963">voice</char> <char style="w" x-id="t012" x-align="JOB.34.16.a011">of</char> <char style="w" x-id="t013" x-align="JOB.34.16.a012" x-src="WLC.JOB.34.16.012" x-source="י" x-translit="āy" srcloc="WLC.JOB.34.16.012" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t014" x-align="JOB.34.16.a011" x-src="WLC.JOB.34.16.011" x-source="מִלָּֽ" x-translit="mill" srcloc="WLC.JOB.34.16.011" x-head="true" lemma="מִלָּה" strong="H4405">words</char>.<verse eid="JOB 34:16" /></para>
	<para style="q1"><verse number="17" style="v" sid="JOB 34:17" /><char style="w" x-id="t001" x-align="JOB.34.17.a001" x-src="WLC.JOB.34.17.001" x-source="הַ" x-translit="ha" srcloc="WLC.JOB.34.17.001" x-head="true" lemma="הֲ" strong="H1886b">Shall</char> <char style="w" x-id="t002" x-align="JOB.34.17.a002" x-src="WLC.JOB.34.17.002" x-source="אַ֬ף" x-translit="ʾap̄" srcloc="WLC.JOB.34.17.002" x-head="true" lemma="אַף" strong="H637">even</char> <char style="w" x-id="t003" x-align="JOB.34.17.a003">one</char> <char style="w" x-id="t004" x-align="JOB.34.17.a003">that</char> <char style="w" x-id="t005" x-align="JOB.34.17.a003" x-src="WLC.JOB.34.17.003" x-source="שׂוֹנֵ֣א" x-translit="śônēʾ" srcloc="WLC.JOB.34.17.003" x-head="true" lemma="שָׂנֵא" strong="H8130">hateth</char> <char style="w" x-id="t006" x-align="JOB.34.17.a004" x-src="WLC.JOB.34.17.004" x-source="מִשְׁפָּ֣ט" x-translit="mišpāṭ" srcloc="WLC.JOB.34.17.004" x-head="true" lemma="מִשְׁפָּט" strong="H4941">justice</char> <char style="w" x-id="t007" x-align="JOB.34.17.a005" x-src="WLC.JOB.34.17.005" x-source="יַחֲב֑וֹשׁ" x-translit="yaḥăḇôš" srcloc="WLC.JOB.34.17.005" x-head="true" lemma="חָבַשׁ" strong="H2280">govern</char>?</para>
	<para style="q1"><char style="w" x-id="t008" x-align="JOB.34.17.a006" x-src="WLC.JOB.34.17.006" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.34.17.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t009" x-align="JOB.34.17.a007" x-src="WLC.JOB.34.17.007" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.34.17.007" x-head="true" lemma="אִם" strong="H518">wilt</char> <char style="w" x-id="t010" x-align="JOB.34.17.a010">thou</char> <char style="w" x-id="t011" x-align="JOB.34.17.a010" x-src="WLC.JOB.34.17.010" x-source="תַּרְשִֽׁיעַ" x-translit="taršiyᵃʿ:" srcloc="WLC.JOB.34.17.010" x-head="true" lemma="רָשַׁע" strong="H7561">condemn</char> <char style="w" x-id="t012" x-align="JOB.34.17.a008">him</char> <char style="w" x-id="t013" x-align="JOB.34.17.a008">that</char> <char style="w" x-id="t014" x-align="JOB.34.17.a008">is</char> <char style="w" x-id="t015" x-align="JOB.34.17.a008" x-src="WLC.JOB.34.17.008" x-source="צַדִּ֖יק" x-translit="ṣaddiyq" srcloc="WLC.JOB.34.17.008" x-head="true" lemma="צַדִּיק" strong="H6662">righteous</char> <char style="add"><char style="w" x-id="t016" x-align="JOB.34.17.a011" x-status="added" x-source="∅" x-head="true">and</char></char> <char style="w" x-id="t017" x-align="JOB.34.17.a009" x-src="WLC.JOB.34.17.009" x-source="כַּבִּ֣יר" x-translit="kabbiyr" srcloc="WLC.JOB.34.17.009" x-head="true" lemma="כַּבִּיר" strong="H3524">mighty</char>?—<verse eid="JOB 34:17" /></para>
	<para style="q1"><verse number="18" style="v" x-unrepresented-source="הַ" x-unrepresented-translit="ha" x-unrepresented-src="WLC.JOB.34.18.001" sid="JOB 34:18" /><note caller="-" style="f"><char style="ft">The Hebrew as pointed reads <char style="it">Is it</char> fit <char style="it">to say to a king</char>, Thou art <char style="it">vile?</char> Or, <char style="it">to nobles</char>, Ye are <char style="it">wicked?</char></char></note><char style="add"><char style="w" x-id="t001" x-align="JOB.34.18.a002">Him</char></char> <char style="w" x-id="t002" x-align="JOB.34.18.a002">that</char> <char style="w" x-id="t003" x-align="JOB.34.18.a002" x-src="WLC.JOB.34.18.002" x-source="אֲמֹ֣ר" x-translit="ʾămōr" srcloc="WLC.JOB.34.18.002" x-head="true" lemma="אָמַר" strong="H559">saith</char> <char style="w" x-id="t004" x-align="JOB.34.18.a003" x-src="WLC.JOB.34.18.003" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.34.18.003" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t005" x-align="JOB.34.18.a004">a</char> <char style="w" x-id="t006" x-align="JOB.34.18.a004" x-src="WLC.JOB.34.18.004" x-source="מֶ֣לֶךְ" x-translit="meleḵ" srcloc="WLC.JOB.34.18.004" x-head="true" lemma="מֶלֶךְ" strong="H4428">king</char>, <char style="add"><char style="w" x-id="t007" x-align="JOB.34.18.a009" x-status="added" x-source="∅" x-head="true">Thou</char> <char style="w" x-id="t008" x-align="JOB.34.18.a005">art</char></char> <char style="w" x-id="t009" x-align="JOB.34.18.a005" x-src="WLC.JOB.34.18.005" x-source="בְּלִיָּ֑עַל" x-translit="bəliyyāʿal" srcloc="WLC.JOB.34.18.005" x-head="true" lemma="בְּלִיַּעַל" strong="H1100">vile</char>,</para>
