	<para style="q1"><verse number="2" style="v" sid="JOB 31:2" /><note caller="-" style="f"><char style="ft">Or, <char style="it">For what portion</char> should I have <char style="it">of God . . . And what heritage etc.? Is there not calamity etc.?</char></char></note><char style="w" x-id="t001" x-align="JOB.31.2.a001" x-src="WLC.JOB.31.2.001" x-source="וּ" x-translit="û" srcloc="WLC.JOB.31.2.001" x-head="true" lemma="וְ" strong="H2050b">For</char> <char style="w" x-id="t002" x-align="JOB.31.2.a002" x-src="WLC.JOB.31.2.002" x-source="מֶ֤ה" x-translit="meh" srcloc="WLC.JOB.31.2.002" x-head="true" lemma="מָה" strong="H4100">what</char> <char style="w" x-id="t003" x-align="JOB.31.2.a002">is</char> <char style="w" x-id="t004" x-align="JOB.31.2.a003">the</char> <char style="w" x-id="t005" x-align="JOB.31.2.a003" x-src="WLC.JOB.31.2.003" x-source="חֵ֣לֶק" x-translit="ḥēleq" srcloc="WLC.JOB.31.2.003" x-head="true" lemma="חֵלֶק" strong="H2506">portion</char> <char style="w" x-id="t006" x-align="JOB.31.2.a004">from</char> <char style="w" x-id="t007" x-align="JOB.31.2.a004" x-src="WLC.JOB.31.2.004" x-source="אֱל֣וֹהַּ" x-translit="ʾĕlôᵃẖ" srcloc="WLC.JOB.31.2.004" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char> <char style="w" x-id="t008" x-align="JOB.31.2.a005" x-src="WLC.JOB.31.2.005 WLC.JOB.31.2.006" x-source="מִ מָּ֑עַל" x-translit="mi mmāʿal" srcloc="WLC.JOB.31.2.006" x-head="true" lemma="מַעַל" strong="H4605">above</char>,</para>
