	<para style="q1"><verse number="14" style="v" sid="JOB 23:14" /><char style="w" x-id="t001" x-align="JOB.23.14.a001" x-src="WLC.JOB.23.14.001" x-source="כִּ֭י" x-translit="kî" srcloc="WLC.JOB.23.14.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="JOB.23.14.a002">he</char> <char style="w" x-id="t003" x-align="JOB.23.14.a002" x-src="WLC.JOB.23.14.002" x-source="יַשְׁלִ֣ים" x-translit="yašliym" srcloc="WLC.JOB.23.14.002" x-head="true" lemma="שָׁלֵם" strong="H7999">performeth</char> <char style="w" x-id="t004" x-align="JOB.23.14.a003">that</char> <char style="w" x-id="t005" x-align="JOB.23.14.a003">which</char> <char style="w" x-id="t006" x-align="JOB.23.14.a003">is</char> <char style="w" x-id="t007" x-align="JOB.23.14.a003" x-src="WLC.JOB.23.14.003" x-source="חֻקִּ֑" x-translit="ḥuqq" srcloc="WLC.JOB.23.14.003" x-head="true" lemma="חֹק" strong="H2706">appointed</char> <char style="w" x-id="t008" x-align="JOB.23.14.a004">for</char> <char style="w" x-id="t009" x-align="JOB.23.14.a004" x-src="WLC.JOB.23.14.004" x-source="י" x-translit="iy" srcloc="WLC.JOB.23.14.004" x-head="true" lemma="הוּא" strong="H2967a">me</char>:</para>
