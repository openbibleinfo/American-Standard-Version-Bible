	<para style="q1"><verse number="24" style="v" sid="JOB 33:24" /><note caller="-" style="f"><char style="ft">Or, <char style="it">And he be gracious . . . and say . . . ransom: his flesh etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.33.24.a001" x-src="WLC.JOB.33.24.001" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.33.24.001" x-head="true" lemma="וְ" strong="H2050b">Then</char> <char style="add"><char style="w" x-id="t002" x-align="JOB.33.24.a002" x-status="added" x-source="∅" x-head="true">God</char></char> <char style="w" x-id="t003" x-align="JOB.33.24.a003">is</char> <char style="w" x-id="t004" x-align="JOB.33.24.a003" x-src="WLC.JOB.33.24.002" x-source="יְחֻנֶּ֗" x-translit="yəḥunn" srcloc="WLC.JOB.33.24.002" x-head="true" lemma="חָנַן" strong="H2603">gracious</char> <char style="w" x-id="t005" x-align="JOB.33.24.a003">unto</char> <char style="w" x-id="t006" x-align="JOB.33.24.a004" x-src="WLC.JOB.33.24.003" x-source="נּוּ" x-translit="ennû" srcloc="WLC.JOB.33.24.003" x-head="true" lemma="הוּא" strong="H5105b">him</char>, <char style="w" x-id="t007" x-align="JOB.33.24.a005" x-src="WLC.JOB.33.24.004" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.33.24.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t008" x-align="JOB.33.24.a006" x-src="WLC.JOB.33.24.005" x-source="יֹּ֗אמֶר" x-translit="yyōʾmer" srcloc="WLC.JOB.33.24.005" x-head="true" lemma="אָמַר" strong="H559">saith</char>,</para>
