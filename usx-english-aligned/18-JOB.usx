	<para style="q1"><char style="w" x-id="t010" x-align="JOB.21.15.a006" x-src="WLC.JOB.21.15.006" x-source="וּ" x-translit="û" srcloc="WLC.JOB.21.15.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.21.15.a007" x-src="WLC.JOB.21.15.007" x-source="מַה" x-translit="mah-" srcloc="WLC.JOB.21.15.007" x-head="true" lemma="מָה" strong="H4100">what</char> <char style="w" x-id="t012" x-align="JOB.21.15.a008" x-src="WLC.JOB.21.15.008" x-source="נּ֝וֹעִ֗יל" x-translit="nnôʿiyl" srcloc="WLC.JOB.21.15.008" x-head="true" lemma="יָעַל" strong="H3276">profit</char> <char style="w" x-id="t013" x-align="JOB.21.15.a008">should</char> <char style="w" x-id="t014" x-align="JOB.21.15.a008">we</char> <char style="w" x-id="t015" x-align="JOB.21.15.a008">have</char>, <char style="w" x-id="t016" x-align="JOB.21.15.a009" x-src="WLC.JOB.21.15.009" x-source="כִּ֣י" x-translit="kiy" srcloc="WLC.JOB.21.15.009" x-head="true" lemma="כִּי" strong="H3588">if</char> <char style="w" x-id="t017" x-align="JOB.21.15.a010">we</char> <char style="w" x-id="t018" x-align="JOB.21.15.a010" x-src="WLC.JOB.21.15.010" x-source="נִפְגַּע" x-translit="nip̄gaʿ-" srcloc="WLC.JOB.21.15.010" x-head="true" lemma="פָּגַע" strong="H6293">pray</char> <char style="w" x-id="t019" x-align="JOB.21.15.a011" x-src="WLC.JOB.21.15.011" x-source="בּֽ" x-translit="b" srcloc="WLC.JOB.21.15.011" x-head="true" lemma="בְּ" strong="H871a">unto</char> <char style="w" x-id="t020" x-align="JOB.21.15.a012" x-src="WLC.JOB.21.15.012" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.21.15.012" x-head="true" lemma="הוּא" strong="H2050c">him</char>?<verse eid="JOB 21:15" /></para>
	<para style="q1"><verse number="16" style="v" sid="JOB 21:16" /><note caller="-" style="f"><char style="ft">Or, Ye say, <char style="it">Lo etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.21.16.a001" x-src="WLC.JOB.21.16.001" x-source="הֵ֤ן" x-translit="hēn" srcloc="WLC.JOB.21.16.001" x-head="true" lemma="הֵן" strong="H2005">Lo</char>, <char style="w" x-id="t002" x-align="JOB.21.16.a007" x-src="WLC.JOB.21.16.007" x-source="ם" x-translit="ām" srcloc="WLC.JOB.21.16.007" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t003" x-align="JOB.21.16.a006" x-src="WLC.JOB.21.16.006" x-source="טוּבָ֑" x-translit="ṭûḇ" srcloc="WLC.JOB.21.16.006" x-head="true" lemma="טוּב" strong="H2898">prosperity</char> <char style="w" x-id="t004" x-align="JOB.21.16.a003">is</char> <char style="w" x-id="t005" x-align="JOB.21.16.a002" x-src="WLC.JOB.21.16.002" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.JOB.21.16.002" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t006" x-align="JOB.21.16.a003" x-src="WLC.JOB.21.16.003" x-source="בְ" x-translit="ḇə" srcloc="WLC.JOB.21.16.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t007" x-align="JOB.21.16.a005" x-src="WLC.JOB.21.16.005" x-source="ם" x-translit="ām" srcloc="WLC.JOB.21.16.005" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t008" x-align="JOB.21.16.a004" x-src="WLC.JOB.21.16.004" x-source="יָדָ֣" x-translit="yāḏ" srcloc="WLC.JOB.21.16.004" x-head="true" lemma="יָד" strong="H3027">hand</char>:</para>
	<para style="q1"><char style="w" x-id="t009" x-align="JOB.21.16.a008">The</char> <char style="w" x-id="t010" x-align="JOB.21.16.a008" x-src="WLC.JOB.21.16.008" x-source="עֲצַ֥ת" x-translit="ʿăṣaṯ" srcloc="WLC.JOB.21.16.008" x-head="true" lemma="עֵצָה" strong="H6098">counsel</char> <char style="w" x-id="t011" x-align="JOB.21.16.a009">of</char> <char style="w" x-id="t012" x-align="JOB.21.16.a009">the</char> <char style="w" x-id="t013" x-align="JOB.21.16.a009" x-src="WLC.JOB.21.16.009" x-source="רְ֝שָׁעִ֗ים" x-translit="rəšāʿiym" srcloc="WLC.JOB.21.16.009" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char> <char style="w" x-id="t014" x-align="JOB.21.16.a010">is</char> <char style="w" x-id="t015" x-align="JOB.21.16.a010" x-src="WLC.JOB.21.16.010" x-source="רָ֣חֲקָה" x-translit="rāḥăqâ" srcloc="WLC.JOB.21.16.010" x-head="true" lemma="רָחַק" strong="H7368">far</char> <char style="w" x-id="t016" x-align="JOB.21.16.a011" x-src="WLC.JOB.21.16.011" x-source="מֶֽ" x-translit="me" srcloc="WLC.JOB.21.16.011" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t017" x-align="JOB.21.16.a012" x-src="WLC.JOB.21.16.012" x-source="נִּי" x-translit="nniy" srcloc="WLC.JOB.21.16.012" x-head="true" lemma="מִן" strong="H2967a">me</char>.<verse eid="JOB 21:16" /></para>
	<para style="b"><verse number="17" style="v" sid="JOB 21:17" /></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">How oft is the lamp of the wicked put out, And</char> how oft <char style="it">cometh their calamity upon them!</char> God <char style="it">distributeth sorrows in his anger. They are as stubble . . . away</char>.</char></note><char style="w" x-id="t001" x-align="JOB.21.17.a001" x-src="WLC.JOB.21.17.001 WLC.JOB.21.17.002" x-source="כַּ מָּ֤ה" x-translit="ka mmāh" srcloc="WLC.JOB.21.17.002" x-head="true" lemma="מָה" strong="H4100">How</char> <char style="w" x-id="t002" x-align="JOB.21.17.a001">oft</char> <char style="w" x-id="t003" x-align="JOB.21.17.a002" x-status="added" x-source="∅" x-head="true">is</char> <char style="w" x-id="t004" x-align="JOB.21.17.a002" x-status="added">it</char> <char style="w" x-id="t005" x-align="JOB.21.17.a003" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t006" x-align="JOB.21.17.a004">the</char> <char style="w" x-id="t007" x-align="JOB.21.17.a004" x-src="WLC.JOB.21.17.003" x-source="נֵר" x-translit="nēr-" srcloc="WLC.JOB.21.17.003" x-head="true" lemma="נֵר" strong="H5216">lamp</char> <char style="w" x-id="t008" x-align="JOB.21.17.a005">of</char> <char style="w" x-id="t009" x-align="JOB.21.17.a005">the</char> <char style="w" x-id="t010" x-align="JOB.21.17.a005" x-src="WLC.JOB.21.17.004" x-source="רְשָׁ֘עִ֤ים" x-translit="rəšāʿiym" srcloc="WLC.JOB.21.17.004" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char> <char style="w" x-id="t011" x-align="JOB.21.17.a006">is</char> <char style="w" x-id="t012" x-align="JOB.21.17.a006" x-src="WLC.JOB.21.17.005" x-source="יִדְעָ֗ךְ" x-translit="yiḏʿāḵ" srcloc="WLC.JOB.21.17.005" x-head="true" lemma="דָּעַךְ" strong="H1846">put</char> <char style="w" x-id="t013" x-align="JOB.21.17.a006">out</char>?</para>
	<para style="q1"><char style="w" x-id="t014" x-align="JOB.21.17.a007" x-src="WLC.JOB.21.17.006" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.21.17.006" x-head="true" lemma="וְ" strong="H2050b">That</char> <char style="w" x-id="t015" x-align="JOB.21.17.a012" x-src="WLC.JOB.21.17.011" x-source="ם" x-translit="ām" srcloc="WLC.JOB.21.17.011" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t016" x-align="JOB.21.17.a011" x-src="WLC.JOB.21.17.010" x-source="אֵידָ֑" x-translit="ʾēyḏ" srcloc="WLC.JOB.21.17.010" x-head="true" lemma="אֵיד" strong="H343">calamity</char> <char style="w" x-id="t017" x-align="JOB.21.17.a008" x-src="WLC.JOB.21.17.007" x-source="יָבֹ֣א" x-translit="yāḇōʾ" srcloc="WLC.JOB.21.17.007" x-head="true" lemma="בּוֹא" strong="H935">cometh</char> <char style="w" x-id="t018" x-align="JOB.21.17.a009" x-src="WLC.JOB.21.17.008" x-source="עָלֵ֣י" x-translit="ʿālēy" srcloc="WLC.JOB.21.17.008" x-head="true" lemma="עַל" strong="H5921">upon</char> <char style="w" x-id="t019" x-align="JOB.21.17.a010" x-src="WLC.JOB.21.17.009" x-source="מוֹ" x-translit="mô" srcloc="WLC.JOB.21.17.009" x-head="true" lemma="הוּא" strong="H3963a">them</char>?</para>
	<para style="q1"><char style="w" x-id="t020" x-align="JOB.21.17.a013" x-status="added" x-source="∅" x-head="true">That</char> <char style="add"><char style="w" x-id="t021" x-align="JOB.21.17.a014" x-status="added" x-source="∅" x-head="true">God</char></char> <char style="w" x-id="t022" x-align="JOB.21.17.a016" x-src="WLC.JOB.21.17.013" x-source="יְחַלֵּ֥ק" x-translit="yəḥallēq" srcloc="WLC.JOB.21.17.013" x-head="true" lemma="חָלַק" strong="H2505">distributeth</char> <char style="w" x-id="t023" x-align="JOB.21.17.a015" x-src="WLC.JOB.21.17.012" x-source="חֲ֝בָלִ֗ים" x-translit="ḥăḇāliym" srcloc="WLC.JOB.21.17.012" x-head="true" lemma="חֵבֶל" strong="H2256b">sorrows</char> <char style="w" x-id="t024" x-align="JOB.21.17.a017" x-src="WLC.JOB.21.17.014" x-source="בְּ" x-translit="bə" srcloc="WLC.JOB.21.17.014" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t025" x-align="JOB.21.17.a019" x-src="WLC.JOB.21.17.016" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.21.17.016" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t026" x-align="JOB.21.17.a018" x-src="WLC.JOB.21.17.015" x-source="אַפּֽ" x-translit="ʾapp" srcloc="WLC.JOB.21.17.015" x-head="true" lemma="אַף" strong="H639">anger</char>?<verse eid="JOB 21:17" /></para>
	<para style="q1"><verse number="18" style="v" sid="JOB 21:18" /><char style="w" x-id="t001" x-align="JOB.21.18.a001" x-status="added" x-source="∅" x-head="true">That</char> <char style="w" x-id="t002" x-align="JOB.21.18.a002">they</char> <char style="w" x-id="t003" x-align="JOB.21.18.a002" x-src="WLC.JOB.21.18.001" x-source="יִהְי֗וּ" x-translit="yihyû" srcloc="WLC.JOB.21.18.001" x-head="true" lemma="הָיָה" strong="H1961">are</char> <char style="w" x-id="t004" x-align="JOB.21.18.a003" x-src="WLC.JOB.21.18.002" x-source="כְּ" x-translit="kə" srcloc="WLC.JOB.21.18.002" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t005" x-align="JOB.21.18.a004" x-src="WLC.JOB.21.18.003" x-source="תֶ֥בֶן" x-translit="ṯeḇen" srcloc="WLC.JOB.21.18.003" x-head="true" lemma="תֶּבֶן" strong="H8401">stubble</char> <char style="w" x-id="t006" x-align="JOB.21.18.a005" x-src="WLC.JOB.21.18.004 WLC.JOB.21.18.005" x-source="לִ פְנֵי" x-translit="li p̄ənê-" srcloc="WLC.JOB.21.18.005" x-head="true" lemma="פָּנֶה" strong="H6440">before</char> <char style="w" x-id="t007" x-align="JOB.21.18.a006">the</char> <char style="w" x-id="t008" x-align="JOB.21.18.a006" x-src="WLC.JOB.21.18.006" x-source="ר֑וּחַ" x-translit="rûᵃḥ" srcloc="WLC.JOB.21.18.006" x-head="true" lemma="רוּחַ" strong="H7307">wind</char>,</para>
