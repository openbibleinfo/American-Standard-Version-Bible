	<para style="q1"><verse number="8" style="v" sid="JOB 30:8" /><char style="add"><char style="w" x-id="t001" x-align="JOB.30.8.a001">They</char> <char style="w" x-id="t002" x-align="JOB.30.8.a001">are</char></char> <char style="w" x-id="t003" x-align="JOB.30.8.a001" x-src="WLC.JOB.30.8.001" x-source="בְּֽנֵי" x-translit="bənê-" srcloc="WLC.JOB.30.8.001" x-head="true" lemma="בֵּן" strong="H1121">children</char> <char style="w" x-id="t004" x-align="JOB.30.8.a002">of</char> <char style="w" x-id="t005" x-align="JOB.30.8.a002" x-src="WLC.JOB.30.8.002" x-source="נָ֭בָל" x-translit="nāḇāl" srcloc="WLC.JOB.30.8.002" x-head="true" lemma="נָבָל" strong="H5036">fools</char>, <char style="w" x-id="t006" x-align="JOB.30.8.a003" x-src="WLC.JOB.30.8.003" x-source="גַּם" x-translit="gam-" srcloc="WLC.JOB.30.8.003" x-head="true" lemma="גַּם" strong="H1571">yea</char>, <char style="w" x-id="t007" x-align="JOB.30.8.a004" x-src="WLC.JOB.30.8.004" x-source="בְּנֵ֣י" x-translit="bənēy" srcloc="WLC.JOB.30.8.004" x-head="true" lemma="בֵּן" strong="H1121">children</char> <char style="w" x-id="t008" x-align="JOB.30.8.a005" x-status="noncompositional">of</char> <note caller="-" style="f"><char style="ft">Hebrew men of <char style="it">no name</char>.</char></note><char style="w" x-id="t009" x-align="JOB.30.8.a005" x-status="noncompositional">base</char> <char style="w" x-id="t010" x-align="JOB.30.8.a005" x-status="noncompositional" x-src="WLC.JOB.30.8.005 WLC.JOB.30.8.006" x-source="בְלִי שֵׁ֑ם" x-translit="ḇəlî- šēm" srcloc="WLC.JOB.30.8.005" x-head="true" lemma="בְּלִי" strong="H1097">men</char>;</para>
	<para style="q1"><char style="w" x-id="t011" x-align="JOB.30.8.a006">They</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">are outcasts from the land</char></char></note><char style="w" x-id="t012" x-align="JOB.30.8.a006">were</char> <char style="w" x-id="t013" x-align="JOB.30.8.a006" x-src="WLC.JOB.30.8.007" x-source="נִ֝כְּא֗וּ" x-translit="nikkəʾû" srcloc="WLC.JOB.30.8.007" x-head="true" lemma="נָכָא" strong="H5217">scourged</char> <char style="w" x-id="t014" x-align="JOB.30.8.a007" x-src="WLC.JOB.30.8.008" x-source="מִן" x-translit="min-" srcloc="WLC.JOB.30.8.008" x-head="true" lemma="מִן" strong="H4480">out</char> <char style="w" x-id="t015" x-align="JOB.30.8.a007">of</char> <char style="w" x-id="t016" x-align="JOB.30.8.a008" x-src="WLC.JOB.30.8.009" x-source="הָ" x-translit="hā" srcloc="WLC.JOB.30.8.009" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t017" x-align="JOB.30.8.a009" x-src="WLC.JOB.30.8.010" x-source="אָֽרֶץ" x-translit="ʾāreṣ:" srcloc="WLC.JOB.30.8.010" x-head="true" lemma="אֶרֶץ" strong="H776">land</char>.<verse eid="JOB 30:8" /></para>
