	<para style="q1"><char style="w" x-id="t012" x-align="JOB.18.14.a007" x-src="WLC.JOB.18.14.007" x-source="וְ֝" x-translit="wə" srcloc="WLC.JOB.18.14.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">it shall</char> (or <char style="it">thou shalt</char>) <char style="it">bring him</char>.</char></note><char style="w" x-id="t013" x-align="JOB.18.14.a009" x-src="WLC.JOB.18.14.009" x-source="הוּ" x-translit="ēhû" srcloc="WLC.JOB.18.14.009" x-head="true" lemma="הוּא" strong="H1930a">he</char> <char style="w" x-id="t014" x-align="JOB.18.14.a008">shall</char> <char style="w" x-id="t015" x-align="JOB.18.14.a008">be</char> <char style="w" x-id="t016" x-align="JOB.18.14.a008" x-src="WLC.JOB.18.14.008" x-source="תַצְעִדֵ֗" x-translit="ṯaṣʿiḏ" srcloc="WLC.JOB.18.14.008" x-head="true" lemma="צָעַד" strong="H6805">brought</char> <char style="w" x-id="t017" x-align="JOB.18.14.a010" x-src="WLC.JOB.18.14.010" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.18.14.010" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t018" x-align="JOB.18.14.a011">the</char> <char style="w" x-id="t019" x-align="JOB.18.14.a011" x-src="WLC.JOB.18.14.011" x-source="מֶ֣לֶךְ" x-translit="meleḵ" srcloc="WLC.JOB.18.14.011" x-head="true" lemma="מֶלֶךְ" strong="H4428">king</char> <char style="w" x-id="t020" x-align="JOB.18.14.a012">of</char> <char style="w" x-id="t021" x-align="JOB.18.14.a012" x-src="WLC.JOB.18.14.012" x-source="בַּלָּהֽוֹת" x-translit="ballāhôṯ:" srcloc="WLC.JOB.18.14.012" x-head="true" lemma="בַּלָּהָה" strong="H1091">terrors</char>.<verse eid="JOB 18:14" /></para>
	<para style="q1"><verse number="15" style="v" sid="JOB 18:15" /><note caller="-" style="f"><char style="ft">Or, <char style="it">It shall dwell in his tent, that it be no more his</char> (or, <char style="it">because it is none of his</char>)</char></note><char style="w" x-id="t001" x-align="JOB.18.15.a001">There</char> <char style="w" x-id="t002" x-align="JOB.18.15.a001">shall</char> <char style="w" x-id="t003" x-align="JOB.18.15.a001" x-src="WLC.JOB.18.15.001" x-source="תִּשְׁכּ֣וֹן" x-translit="tiškôn" srcloc="WLC.JOB.18.15.001" x-head="true" lemma="שָׁכַן" strong="H7931">dwell</char> <char style="w" x-id="t004" x-align="JOB.18.15.a002" x-src="WLC.JOB.18.15.002" x-source="בְּ֭" x-translit="bə" srcloc="WLC.JOB.18.15.002" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t005" x-align="JOB.18.15.a004" x-src="WLC.JOB.18.15.004" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.18.15.004" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t006" x-align="JOB.18.15.a003" x-src="WLC.JOB.18.15.003" x-source="אָהֳל" x-translit="ʾāhŏl" srcloc="WLC.JOB.18.15.003" x-head="true" lemma="אֹהֶל" strong="H168">tent</char> <char style="w" x-id="t007" x-align="JOB.18.15.a005" x-src="WLC.JOB.18.15.005" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.18.15.005" x-head="true" lemma="מִן" strong="H4480">that</char> <char style="w" x-id="t008" x-align="JOB.18.15.a005">which</char> <char style="w" x-id="t009" x-align="JOB.18.15.a006">is</char> <char style="w" x-id="t010" x-align="JOB.18.15.a006" x-src="WLC.JOB.18.15.006" x-source="בְּלִי" x-translit="bəlî-" srcloc="WLC.JOB.18.15.006" x-head="true" lemma="בְּלִי" strong="H1097">none</char> <char style="w" x-id="t011" x-align="JOB.18.15.a007" x-src="WLC.JOB.18.15.007" x-source="ל֑" x-translit="l" srcloc="WLC.JOB.18.15.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t012" x-align="JOB.18.15.a008" x-src="WLC.JOB.18.15.008" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.18.