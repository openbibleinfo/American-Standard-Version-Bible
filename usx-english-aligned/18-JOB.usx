	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">If a man speak, surely he shall be swallowed up</char></char></note><char style="w" x-id="t010" x-align="JOB.37.20.a007" x-src="WLC.JOB.37.20.007" x-source="אִֽם" x-translit="ʾim-" srcloc="WLC.JOB.37.20.007" x-head="true" lemma="אִם" strong="H518">Or</char> <char style="w" x-id="t011" x-align="JOB.37.20.a008">should</char> <char style="w" x-id="t012" x-align="JOB.37.20.a009">a</char> <char style="w" x-id="t013" x-align="JOB.37.20.a009" x-src="WLC.JOB.37.20.009" x-source="אִ֝֗ישׁ" x-translit="ʾiyš" srcloc="WLC.JOB.37.20.009" x-head="true" lemma="אִישׁ" strong="H376">man</char> <char style="w" x-id="t014" x-align="JOB.37.20.a008" x-src="WLC.JOB.37.20.008" x-source="אָ֥מַר" x-translit="ʾāmar" srcloc="WLC.JOB.37.20.008" x-head="true" lemma="אָמַר" strong="H559">wish</char> <char style="w" x-id="t015" x-align="JOB.37.20.a010" x-src="WLC.JOB.37.20.010" x-source="כִּ֣י" x-translit="kiy" srcloc="WLC.JOB.37.20.010" x-head="true" lemma="כִּי" strong="H3588">that</char> <char style="w" x-id="t016" x-align="JOB.37.20.a011">he</char> <char style="w" x-id="t017" x-align="JOB.37.20.a011">were</char> <char style="w" x-id="t018" x-align="JOB.37.20.a011" x-src="WLC.JOB.37.20.011" x-source="יְבֻלָּֽע" x-translit="yəḇullāʿ:" srcloc="WLC.JOB.37.20.011" x-head="true" lemma="בָּלַע" strong="H1104a">swallowed</char> <char style="w" x-id="t019" x-align="JOB.37.20.a011">up</char>?<verse eid="JOB 37:20" /></para>
	<para style="b"><verse number="21" style="v" sid="JOB 37:21" /></para>
	<para style="q1"><char style="w" x-id="t001" x-align="JOB.37.21.a001" x-src="WLC.JOB.37.21.001" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.37.21.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="JOB.37.21.a002" x-src="WLC.JOB.37.21.002" x-source="עַתָּ֤ה" x-translit="ʿattāh" srcloc="WLC.JOB.37.21.002" x-head="true" lemma="עַתָּה" strong="H6258">now</char> <char style="w" x-id="t003" x-align="JOB.37.21.a003" x-status="added" x-source="∅" x-head="true">men</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">cannot look on the light when it is bright in the skies, When the wind hath passed, and cleared them</char></char></note><char style="w" x-id="t004" x-align="JOB.37.21.a004" x-src="WLC.JOB.37.21.004" x-source="רָ֤אוּ" x-translit="rāʾû" srcloc="WLC.JOB.37.21.004" x-head="true" lemma="רָאָה" strong="H7200">see</char> <char style="w" x-id="t005" x-align="JOB.37.21.a005" x-src="WLC.JOB.37.21.003" x-source="לֹ֘א" x-translit="lōʾ" srcloc="WLC.JOB.37.21.003" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t006" x-align="JOB.37.21.a006">the</char> <char style="w" x-id="t007" x-align="JOB.37.21.a006" x-src="WLC.JOB.37.21.005" x-source="א֗וֹר" x-translit="ʾôr" srcloc="WLC.JOB.37.21.005" x-head="true" lemma="אוֹר" strong="H216">light</char> <char style="w" x-id="t008" x-align="JOB.37.21.a007" x-src="WLC.JOB.37.21.007" x-source="ה֭וּא" x-translit="hûʾ" srcloc="WLC.JOB.37.21.007" x-head="true" lemma="הוּא" strong="H1931">which</char> <char style="w" x-id="t009" x-align="JOB.37.21.a008">is</char> <char style="w" x-id="t010" x-align="JOB.37.21.a008" x-src="WLC.JOB.37.21.006" x-source="בָּהִ֣יר" x-translit="bāhiyr" srcloc="WLC.JOB.37.21.006" x-head="true" lemma="בָּהִיר" strong="H925">bright</char> <char style="w" x-id="t011" x-align="JOB.37.21.a009" x-src="WLC.JOB.37.21.008" x-source="בַּ" x-translit="ba" srcloc="WLC.JOB.37.21.008" x-head="true" lemma="בְּ" strong="H871a">in</char> <char