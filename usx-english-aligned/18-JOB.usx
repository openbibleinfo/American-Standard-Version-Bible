	<para style="q1"><verse number="7" style="v" sid="JOB 5:7" /><char style="w" x-id="t001" x-align="JOB.5.7.a001" x-src="WLC.JOB.5.7.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.5.7.001" x-head="true" lemma="כִּי" strong="H3588">But</char> <char style="w" x-id="t002" x-align="JOB.5.7.a002" x-src="WLC.JOB.5.7.002" x-source="אָ֭דָם" x-translit="ʾāḏām" srcloc="WLC.JOB.5.7.002" x-head="true" lemma="אָדָם" strong="H120">man</char> <char style="w" x-id="t003" x-align="JOB.5.7.a005">is</char> <char style="w" x-id="t004" x-align="JOB.5.7.a005" x-src="WLC.JOB.5.7.005" x-source="יוּלָּ֑ד" x-translit="yûllāḏ" srcloc="WLC.JOB.5.7.005" x-head="true" lemma="יָלַד" strong="H3205">born</char> <char style="w" x-id="t005" x-align="JOB.5.7.a003" x-src="WLC.JOB.5.7.003" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.5.7.003" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t006" x-align="JOB.5.7.a004" x-src="WLC.JOB.5.7.004" x-source="עָמָ֣ל" x-translit="ʿāmāl" srcloc="WLC.JOB.5.7.004" x-head="true" lemma="עָמָל" strong="H5999">trouble</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="JOB.5.7.a006" x-src="WLC.JOB.5.7.006" x-source="וּ" x-translit="û" srcloc="WLC.JOB.5.7.006" x-head="true" lemma="וְ" strong="H2050b">As</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">the sons of flame</char> (or <char style="it">of lightning</char>).</char></note><char style="w" x-id="t008" x-align="JOB.5.7.a007" x-status="noncompositional">the</char> <char style="w" x-id="t009" x-align="JOB.5.7.a007" x-status="noncompositional" x-src="WLC.JOB.5.7.007 WLC.JOB.5.7.008" x-source="בְנֵי רֶ֝֗שֶׁף" x-translit="ḇənê- rešep̄" srcloc="WLC.JOB.5.7.007" x-head="true" lemma="בֵּן" strong="H1121">sparks</char> <char style="w" x-id="t010" x-align="JOB.5.7.a009" x-src="WLC.JOB.5.7.010" x-source="עֽוּף" x-translit="ʿûp̄:" srcloc="WLC.JOB.5.7.010" x-head="true" lemma="עוּף" strong="H5774">fly</char> <char style="w" x-id="t011" x-align="JOB.5.7.a008" x-src="WLC.JOB.5.7.009" x-source="יַגְבִּ֥יהוּ" x-translit="yaḡbiyhû" srcloc="WLC.JOB.5.7.009" x-head="true" lemma="גָּבַהּ" strong="H1361">upward</char>.<verse eid="JOB 5:7" /></para>
