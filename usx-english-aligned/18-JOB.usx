	<para style="q1"><verse number="12" style="v" sid="JOB 17:12" /><char style="w" x-id="t001" x-align="JOB.17.12.a001">They</char> <char style="w" x-id="t002" x-align="JOB.17.12.a001" x-src="WLC.JOB.17.12.004" x-source="יָשִׂ֑ימוּ" x-translit="yāśiymû" srcloc="WLC.JOB.17.12.004" x-head="true" lemma="שׂים" strong="H7760">change</char> <char style="w" x-id="t003" x-align="JOB.17.12.a002">the</char> <char style="w" x-id="t004" x-align="JOB.17.12.a002" x-src="WLC.JOB.17.12.001" x-source="לַ֭יְלָה" x-translit="layəlâ" srcloc="WLC.JOB.17.12.001" x-head="true" lemma="לַיְלָה" strong="H3915">night</char> <char style="w" x-id="t005" x-align="JOB.17.12.a003" x-src="WLC.JOB.17.12.002" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.17.12.002" x-head="true" lemma="לְ" strong="H3807a">into</char> <char style="w" x-id="t006" x-align="JOB.17.12.a004" x-src="WLC.JOB.17.12.003" x-source="י֣וֹם" x-translit="yôm" srcloc="WLC.JOB.17.12.003" x-head="true" lemma="יוֹם" strong="H3117">day</char>:</para>
	<para style="q1"><char style="w" x-id="t007" x-align="JOB.17.12.a005">The</char> <char style="w" x-id="t008" x-align="JOB.17.12.a005" x-src="WLC.JOB.17.12.005" x-source="א֝֗וֹר" x-translit="ʾôr" srcloc="WLC.JOB.17.12.005" x-head="true" lemma="אוֹר" strong="H216">light</char>, <char style="add"><char style="w" x-id="t009" x-align="JOB.17.12.a006" x-status="added" x-source="∅" x-head="true">say</char> <char style="w" x-id="t010" x-align="JOB.17.12.a006" x-status="added">they</char></char>, <char style="w" x-id="t011" x-align="JOB.17.12.a007">is</char> <char style="w" x-id="t012" x-align="JOB.17.12.a007" x-src="WLC.JOB.17.12.006" x-source="קָר֥וֹב" x-translit="qārôḇ" srcloc="WLC.JOB.17.12.006" x-head="true" lemma="קָרֹוב" strong="H7138">near</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">because of</char></char></note><char style="w" x-id="t013" x-align="JOB.17.12.a008" x-src="WLC.JOB.17.12.007 WLC.JOB.17.12.008" x-source="מִ פְּנֵי" x-translit="mi pənê-" srcloc="WLC.JOB.17.12.008" x-head="true" lemma="פָּנֶה" strong="H6440">unto</char> <char style="w" x-id="t014" x-align="JOB.17.12.a009">the</char> <char style="w" x-id="t015" x-align="JOB.17.12.a009" x-src="WLC.JOB.17.12.009" x-source="חֹֽשֶׁךְ" x-translit="ḥōšeḵ:" srcloc="WLC.JOB.17.12.009" x-head="true" lemma="חֹשֶׁךְ" strong="H2822">darkness</char>.<verse eid="JOB 17:12" /></para>
	<para style="q1"><verse number="13" style="v" sid="JOB 17:13" /><char style="w" x-id="t001" x-align="JOB.17.13.a001" x-src="WLC.JOB.17.13.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.17.13.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JOB.17.13.a002">I</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">hope, Sheol is my house; I have spread . . . I have said . . . And where now is my hope?</char></char></note><char style="w" x-id="t003" x-align="JOB.17.13.a002" x-src="WLC.JOB.17.13.002" x-source="אֲ֭קַוֶּה" x-translit="ʾăqawweh" srcloc="WLC.JOB.17.13.002" x-head="true" lemma="קָוָה" strong="H6960">look</char> <char style="w" x-id="t004" x-align="JOB.17.13.a002">for</char> <char style="w" x-id="t005" x-align="JOB.17.13.a003" x-src="WLC.JOB.17.13.003" x-source="שְׁא֣וֹל" x-translit="šəʾôl" srcloc="WLC.JOB.17.13.003" x-head="true" lemma="שְׁאוֹל" strong="H7585">Sheol</char> <char style="w" x-id="t006" x-align="JOB.17.13.a004">as</char> <char style="w" x-id="t007" x-align="JOB.17.13.a005" x-src="WLC.JOB.17.13.005" x-source="י" x-translit="iy" srcloc="WLC.JOB.17.13.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t008" x-align="JOB.17.13.a004" x-src="WLC.JOB.17.13.004" x-source="בֵּיתִ֑" x-translit="bēyṯ" srcloc="WLC.JOB.17.13.004" x-head="true" lemma="בַּיִת" strong="H1004">house</char>;</para>
