	<para style="b"><verse number="7" style="v" sid="JOB 11:7" /></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Canst thou find out the deep things of God?</char></char></note><char style="w" x-id="t001" x-align="JOB.11.7.a001" x-src="WLC.JOB.11.7.001" x-source="הַ" x-translit="ha" srcloc="WLC.JOB.11.7.001" x-head="true" lemma="הַ" strong="H1886b">Canst</char> <char style="w" x-id="t002" x-align="JOB.11.7.a004">thou</char> <char style="w" x-id="t003" x-align="JOB.11.7.a002">by</char> <char style="w" x-id="t004" x-align="JOB.11.7.a002" x-src="WLC.JOB.11.7.002" x-source="חֵ֣קֶר" x-translit="ḥēqer" srcloc="WLC.JOB.11.7.002" x-head="true" lemma="חֵקֶר" strong="H2714">searching</char> <char style="w" x-id="t005" x-align="JOB.11.7.a004" x-src="WLC.JOB.11.7.004" x-source="תִּמְצָ֑א" x-translit="timṣāʾ" srcloc="WLC.JOB.11.7.004" x-head="true" lemma="מָצָא" strong="H4672">find</char> <char style="w" x-id="t006" x-align="JOB.11.7.a004">out</char> <char style="w" x-id="t007" x-align="JOB.11.7.a003" x-src="WLC.JOB.11.7.003" x-source="אֱל֣וֹהַ" x-translit="ʾĕlôᵃh" srcloc="WLC.JOB.11.7.003" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char>?</para>
