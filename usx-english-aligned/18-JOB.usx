	<para style="q1"><verse number="15" style="v" x-unrepresented-source="וְ" x-unrepresented-translit="wə" x-unrepresented-src="WLC.JOB.23.15.008" sid="JOB 23:15" /><char style="w" x-id="t001" x-align="JOB.23.15.a001" x-src="WLC.JOB.23.15.001 WLC.JOB.23.15.002" x-source="עַל כֵּ֭ן" x-translit="ʿal- kēn" srcloc="WLC.JOB.23.15.001" x-head="true" lemma="עַל" strong="H5921">Therefore</char> <char style="w" x-id="t002" x-align="JOB.23.15.a002">am</char> <char style="w" x-id="t003" x-align="JOB.23.15.a002">I</char> <char style="w" x-id="t004" x-align="JOB.23.15.a002" x-src="WLC.JOB.23.15.006" x-source="אֶבָּהֵ֑ל" x-translit="ʾebbāhēl" srcloc="WLC.JOB.23.15.006" x-head="true" lemma="בָּהַל" strong="H926">terrified</char> <char style="w" x-id="t005" x-align="JOB.23.15.a003" x-src="WLC.JOB.23.15.003" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.23.15.003" x-head="true" lemma="מִן" strong="H4480">at</char> <char style="w" x-id="t006" x-align="JOB.23.15.a004" x-src="WLC.JOB.23.15.005" x-source="ו" x-translit="w" srcloc="WLC.JOB.23.15.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="JOB.23.15.a005" x-src="WLC.JOB.23.15.004" x-source="פָּנָ֣י" x-translit="pānāy" srcloc="WLC.JOB.23.15.004" x-head="true" lemma="פָּנֶה" strong="H6440">presence</char>;</para>
	<para style="q1"><char style="w" x-id="t008" x-align="JOB.23.15.a006" x-status="added" x-source="∅" x-head="true">When</char> <char style="w" x-id="t009" x-align="JOB.23.15.a007">I</char> <char style="w" x-id="t010" x-align="JOB.23.15.a007" x-src="WLC.JOB.23.15.007" x-source="אֶ֝תְבּוֹנֵ֗ן" x-translit="ʾeṯbônēn" srcloc="WLC.JOB.23.15.007" x-head="true" lemma="בִּין" strong="H995">consider</char>, <char style="w" x-id="t011" x-align="JOB.23.15.a009">I</char> <char style="w" x-id="t012" x-align="JOB.23.15.a009">am</char> <char style="w" x-id="t013" x-align="JOB.23.15.a009" x-src="WLC.JOB.23.15.009" x-source="אֶפְחַ֥ד" x-translit="ʾep̄ḥaḏ" srcloc="WLC.JOB.23.15.009" x-head="true" lemma="פָּחַד" strong="H6342">afraid</char> <char style="w" x-id="t014" x-align="JOB.23.15.a010" x-src="WLC.JOB.23.15.010" x-source="מִמֶּֽ" x-translit="mimm" srcloc="WLC.JOB.23.15.010" x-head="true" lemma="מִן" strong="H4480">of</char> <char style="w" x-id="t015" x-align="JOB.23.15.a011" x-src="WLC.JOB.23.15.011" x-source="נּוּ" x-translit="ennû" srcloc="WLC.JOB.23.15.011" x-head="true" lemma="הוּא" strong="H5105b">him</char>.<verse eid="JOB 23:15" /></para>
	<para style="q1"><verse number="16" style="v" sid="JOB 23:16" /><char style="w" x-id="t001" x-align="JOB.23.16.a001" x-src="WLC.JOB.23.16.001" x-source="וְ֭" x-translit="wə" srcloc="WLC.JOB.23.16.001" x-head="true" lemma="וְ" strong="H2050b">For</char> <char style="w" x-id="t002" x-align="JOB.23.16.a002" x-src="WLC.JOB.23.16.002" x-source="אֵל" x-translit="ʾēl" srcloc="WLC.JOB.23.16.002" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="w" x-id="t003" x-align="JOB.23.16.a003">hath</char> <char style="w" x-id="t004" x-align="JOB.23.16.a003">made</char> <char style="w" x-id="t005" x-align="JOB.23.16.a004" x-src="WLC.JOB.23.16.005" x-source="י" x-translit="iy" srcloc="WLC.JOB.23.16.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t006" x-align="JOB.23.16.a005" x-src="WLC.JOB.23.16.004" x-source="לִבִּ֑" x-translit="libb" srcloc="WLC.JOB.23.16.004" x-head="true" lemma="לֵב" strong="H3820">heart</char> <char style="w" x-id="t007" x-align="JOB.23.16.a003" x-src="WLC.JOB.23.16.003" x-source="הֵרַ֣ךְ" x-translit="hēraḵ" srcloc="WLC.JOB.23.16.003" x-head="true" lemma="רָכַךְ" strong="H7401">faint</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="JOB.23.16.a006" x-src="WLC.JOB.23.16.006" x-source="וְ֝" x-translit="wə" srcloc="WLC.JOB.23.16.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t009" x-align="JOB.23.16.a007">the</char> <char style="w" x-id="t010" x-align="JOB.23.16.a007" x-src="WLC.JOB.23.16.007" x-source="שַׁדַּ֗י" x-translit="šadday" srcloc="WLC.JOB.23.16.007" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char> <char style="w" x-id="t011" x-align="JOB.23.16.a008">hath</char> <char style="w" x-id="t012" x-align="JOB.23.16.a008" x-src="WLC.JOB.23.16.008" x-source="הִבְהִילָֽ" x-translit="hiḇhiyl" srcloc="WLC.JOB.23.16.008" x-head="true" lemma="בָּהַל" strong="H926">terrified</char> <char style="w" x-id="t013" x-align="JOB.23.16.a009" x-src="WLC.JOB.23.16.009" x-source="נִי" x-translit="āniy" srcloc="WLC.JOB.23.16.009" x-head="true" lemma="הוּא" strong="H5204a">me</char>;<verse eid="JOB 23:16" /></para>
	<para style="q1"><verse number="17" style="v" sid="JOB 23:17" /><note caller="-" style="f"><char style="ft">Or, <char style="it">For I am not dismayed because of the darkness, Nor because thick darkness covereth my face</char></char></note><char style="w" x-id="t001" x-align="JOB.23.17.a001" x-src="WLC.JOB.23.17.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.23.17.001" x-head="true" lemma="כִּי" strong="H3588">Because</char> <char style="w" x-id="t002" x-align="JOB.23.17.a002">I</char> <char style="w" x-id="t003" x-align="JOB.23.17.a002">was</char> <char style="w" x-id="t004" x-align="JOB.23.17.a003" x-src="WLC.JOB.23.17.002" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.JOB.23.17.002" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t005" x-align="JOB.23.17.a002" x-src="WLC.JOB.23.17.003" x-source="נִ֭צְמַתִּי" x-translit="niṣmattî" srcloc="WLC.JOB.23.17.003" x-head="true" lemma="צָמַת" strong="H6789">cut</char> <char style="w" x-id="t006" x-align="JOB.23.17.a002">off</char> <char style="w" x-id="t007" x-align="JOB.23.17.a004" x-src="WLC.JOB.23.17.004 WLC.JOB.23.17.005" x-source="מִ פְּנֵי" x-translit="mi pənê-" srcloc="WLC.JOB.23.17.005" x-head="true" lemma="פָּנֶה" strong="H6440">before</char> <char style="w" x-id="t008" x-align="JOB.23.17.a005">the</char> <char style="w" x-id="t009" x-align="JOB.23.17.a005" x-src="WLC.JOB.23.17.006" x-source="חֹ֑שֶׁךְ" x-translit="ḥōšeḵ" srcloc="WLC.JOB.23.17.006" x-head="true" lemma="חֹשֶׁךְ" strong="H2822">darkness</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.23.17.a006" x-src="WLC.JOB.23.17.007" x-source="וּ֝" x-translit="û" srcloc="WLC.JOB.23.17.007" x-head="true" lemma="וְ" strong="H2050b">Neither</char> <char style="w" x-id="t011" x-align="JOB.23.17.a007">did</char> <char style="w" x-id="t012" x-align="JOB.23.17.a007">he</char> <char style="w" x-id="t013" x-align="JOB.23.17.a007" x-src="WLC.JOB.23.17.011" x-source="כִּסָּה" x-translit="kissâ-" srcloc="WLC.JOB.23.17.011" x-head="true" lemma="כָּסָה" strong="H3680">cover</char> <char style="w" x-id="t014" x-align="JOB.23.17.a008">the</char> <char style="w" x-id="t015" x-align="JOB.23.17.a008">thick</char> <char style="w" x-id="t016" x-align="JOB.23.17.a008" x-src="WLC.JOB.23.17.012" x-source="אֹֽפֶל" x-translit="ʾōp̄el:" srcloc="WLC.JOB.23.17.012" x-head="true" lemma="אֹפֶל" strong="H652">darkness</char> <char style="w" x-id="t017" x-align="JOB.23.17.a009" x-src="WLC.JOB.23.17.008" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.23.17.008" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t018" x-align="JOB.23.17.a010" x-src="WLC.JOB.23.17.010" x-source="י" x-translit="ay" srcloc="WLC.JOB.23.17.010" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t019" x-align="JOB.23.17.a011" x-src="WLC.JOB.23.17.009" x-source="פָּנַ֗" x-translit="pān" srcloc="WLC.JOB.23.17.009" x-head="true" lemma="פָּנֶה" strong="H6440">face</char>.<verse eid="JOB 23:17" /></para>
	<chapter eid="JOB 23" />
	<chapter number="24" style="c" sid="JOB 24" />
	<para style="b"><verse number="1" style="v" sid="JOB 24:1" /></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Why is it, seeing times are not hidden from the Almighty, That they who know him see not his days?</char></char></note><char style="w" x-id="t001" x-align="JOB.24.1.a001" x-src="WLC.JOB.24.1.001" x-source="מַדּ֗וּעַ" x-translit="madûᵃʿ" srcloc="WLC.JOB.24.1.001" x-head="true" lemma="מַדּוּעַ" strong="H4069">Why</char> <char style="w" x-id="t002" x-align="JOB.24.1.a005">are</char> <char style="w" x-id="t003" x-align="JOB.24.1.a006" x-src="WLC.JOB.24.1.006" x-source="עִתִּ֑ים" x-translit="ʿittiym" srcloc="WLC.JOB.24.1.006" x-head="true" lemma="עֵת" strong="H6256">times</char> <char style="w" x-id="t004" x-align="JOB.24.1.a004" x-src="WLC.JOB.24.1.004" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.JOB.24.1.004" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t005" x-align="JOB.24.1.a005" x-src="WLC.JOB.24.1.005" x-source="נִצְפְּנ֣וּ" x-translit="niṣpənû" srcloc="WLC.JOB.24.1.005" x-head="true" lemma="צָפַן" strong="H6845">laid</char> <char style="w" x-id="t006" x-align="JOB.24.1.a005">up</char> <char style="w" x-id="t007" x-align="JOB.24.1.a002" x-src="WLC.JOB.24.1.002" x-source="מִ֭" x-translit="mi" srcloc="WLC.JOB.24.1.002" x-head="true" lemma="מִן" strong="H4480">by</char> <char style="w" x-id="t008" x-align="JOB.24.1.a003">the</char> <char style="w" x-id="t009" x-align="JOB.24.1.a003" x-src="WLC.JOB.24.1.003" x-source="שַּׁדַּי" x-translit="ššadday" srcloc="WLC.JOB.24.1.003" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char>?</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.24.1.a007" x-src="WLC.JOB.24.1.007" x-source="וְ֝" x-translit="**wə" srcloc="WLC.JOB.24.1.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t011" x-align="JOB.24.1.a001">why</char> <char style="w" x-id="t012" x-align="JOB.24.1.a011">do</char> <char style="w" x-id="t013" x-align="JOB.24.1.a010" x-src="WLC.JOB.24.1.010" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.JOB.24.1.010" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t014" x-align="JOB.24.1.a008">they</char> <char style="w" x-id="t015" x-align="JOB.24.1.a008">that</char> <char style="w" x-id="t016" x-align="JOB.24.1.a008" x-src="WLC.JOB.24.1.008" x-source="יֹדְעָ֗י" x-translit="yōḏəʿāy" srcloc="WLC.JOB.24.1.008" x-head="true" lemma="יָדַע" strong="H3045">know</char> <char style="w" x-id="t017" x-align="JOB.24.1.a009" x-src="WLC.JOB.24.1.009" x-source="ו" x-translit="w" srcloc="WLC.JOB.24.1.009" x-head="true" lemma="הוּא" strong="H2050c">him</char> <char style="w" x-id="t018" x-align="JOB.24.1.a011" x-src="WLC.JOB.24.1.011" x-source="חָ֥זוּ" x-translit="ḥāzû" srcloc="WLC.JOB.24.1.011" x-head="true" lemma="חָזָה" strong="H2372">see</char> <char style="w" x-id="t019" x-align="JOB.24.1.a013" x-src="WLC.JOB.24.1.013" x-source="ו" x-translit="w" srcloc="WLC.JOB.24.1.013" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t020" x-align="JOB.24.1.a012" x-src="WLC.JOB.24.1.012" x-source="יָמָֽי" x-translit="yāmāy" srcloc="WLC.JOB.24.1.012" x-head="true" lemma="יוֹם" strong="H3117">days</char>?<verse eid="JOB 24:1" /></para>
