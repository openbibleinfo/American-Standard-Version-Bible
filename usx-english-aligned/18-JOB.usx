	<para style="q1"><verse number="20" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.JOB.4.20.004" sid="JOB 4:20" /><note caller="-" style="f"><char style="ft">Or, <char style="it">From morning to evening</char></char></note><char style="w" x-id="t001" x-align="JOB.4.20.a001" x-src="WLC.JOB.4.20.001" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.4.20.001" x-head="true" lemma="מִן" strong="H4480">Betwixt</char> <char style="w" x-id="t002" x-align="JOB.4.20.a002" x-src="WLC.JOB.4.20.002" x-source="בֹּ֣קֶר" x-translit="bōqer" srcloc="WLC.JOB.4.20.002" x-head="true" lemma="בֹּקֶר" strong="H1242">morning</char> <char style="w" x-id="t003" x-align="JOB.4.20.a003" x-src="WLC.JOB.4.20.003" x-source="לָ" x-translit="lā" srcloc="WLC.JOB.4.20.003" x-head="true" lemma="לְ" strong="H3807a">and</char> <char style="w" x-id="t004" x-align="JOB.4.20.a005" x-src="WLC.JOB.4.20.005" x-source="עֶ֣רֶב" x-translit="ʿereḇ" srcloc="WLC.JOB.4.20.005" x-head="true" lemma="עֶרֶב" strong="H6153">evening</char> <char style="w" x-id="t005" x-align="JOB.4.20.a006">they</char> <char style="w" x-id="t006" x-align="JOB.4.20.a006">are</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">broken in pieces</char>.</char></note><char style="w" x-id="t007" x-align="JOB.4.20.a006" x-src="WLC.JOB.4.20.006" x-source="יֻכַּ֑תּוּ" x-translit="yukkatû" srcloc="WLC.JOB.4.20.006" x-head="true" lemma="כָּתַת" strong="H3807">destroyed</char>:</para>
