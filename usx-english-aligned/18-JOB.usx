	<para style="q1"><verse number="16" style="v" sid="JOB 36:16" /><char style="w" x-id="t001" x-align="JOB.36.16.a001" x-src="WLC.JOB.36.16.001 WLC.JOB.36.16.002" x-source="וְ אַ֤ף" x-translit="wə ʾap̄" srcloc="WLC.JOB.36.16.002" x-head="true" lemma="אַף" strong="H637">Yea</char>, <char style="w" x-id="t002" x-align="JOB.36.16.a002">he</char> <char style="w" x-id="t003" x-align="JOB.36.16.a002">would</char> <char style="w" x-id="t004" x-align="JOB.36.16.a002">have</char> <char style="w" x-id="t005" x-align="JOB.36.16.a002" x-src="WLC.JOB.36.16.003" x-source="הֲסִיתְ" x-translit="hăsiyṯ" srcloc="WLC.JOB.36.16.003" x-head="true" lemma="סוּת" strong="H5496">allured</char> <char style="w" x-id="t006" x-align="JOB.36.16.a003" x-src="WLC.JOB.36.16.004" x-source="ךָ֨" x-translit="əḵā" srcloc="WLC.JOB.36.16.004" x-head="true" lemma="הוּא" strong="H3509b">thee</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">out of the mouth of</char>.</char></note><char style="w" x-id="t007" x-align="JOB.36.16.a004" x-src="WLC.JOB.36.16.005 WLC.JOB.36.16.006" x-source="מִ פִּי" x-translit="mi pî-" srcloc="WLC.JOB.36.16.006" x-head="true" lemma="פֶּה" strong="H6310">out</char> <char style="w" x-id="t008" x-align="JOB.36.16.a004">of</char> <char style="w" x-id="t009" x-align="JOB.36.16.a005" x-src="WLC.JOB.36.16.007" x-source="צָ֗ר" x-translit="ṣār" srcloc="WLC.JOB.36.16.007" x-head="true" lemma="צַר" strong="H6862">distress</char></para>
