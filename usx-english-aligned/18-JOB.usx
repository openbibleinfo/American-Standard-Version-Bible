	<para style="q1"><verse number="3" style="v" sid="JOB 8:3" /><char style="w" x-id="t001" x-align="JOB.8.3.a001" x-src="WLC.JOB.8.3.001" x-source="הַ֭" x-translit="ha" srcloc="WLC.JOB.8.3.001" x-head="true" lemma="הֲ" strong="H1886b">Doth</char> <char style="w" x-id="t002" x-align="JOB.8.3.a002" x-src="WLC.JOB.8.3.002" x-source="אֵל" x-translit="ʾēl" srcloc="WLC.JOB.8.3.002" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="w" x-id="t003" x-align="JOB.8.3.a003" x-src="WLC.JOB.8.3.003" x-source="יְעַוֵּ֣ת" x-translit="yəʿawwēṯ" srcloc="WLC.JOB.8.3.003" x-head="true" lemma="עָוַת" strong="H5791">pervert</char> <char style="w" x-id="t004" x-align="JOB.8.3.a004" x-src="WLC.JOB.8.3.004" x-source="מִשְׁפָּ֑ט" x-translit="mišpāṭ" srcloc="WLC.JOB.8.3.004" x-head="true" lemma="מִשְׁפָּט" strong="H4941">justice</char>?</para>
	<para style="q1"><char style="w" x-id="t005" x-align="JOB.8.3.a005" x-src="WLC.JOB.8.3.005" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.8.3.005" x-head="true" lemma="וְ" strong="H2050b">Or</char> <char style="w" x-id="t006" x-align="JOB.8.3.a006" x-src="WLC.JOB.8.3.006" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.8.3.006" x-head="true" lemma="אִם" strong="H518">doth</char> <char style="w" x-id="t007" x-align="JOB.8.3.a007">the</char> <char style="w" x-id="t008" x-align="JOB.8.3.a007" x-src="WLC.JOB.8.3.007" x-source="שַׁ֝דַּ֗י" x-translit="šadday" srcloc="WLC.JOB.8.3.007" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char> <char style="w" x-id="t009" x-align="JOB.8.3.a008" x-src="WLC.JOB.8.3.008" x-source="יְעַוֵּֽת" x-translit="yəʿawwēṯ-" srcloc="WLC.JOB.8.3.008" x-head="true" lemma="עָוַת" strong="H5791">pervert</char> <char style="w" x-id="t010" x-align="JOB.8.3.a009" x-src="WLC.JOB.8.3.009" x-source="צֶֽדֶק" x-translit="ṣeḏeq:" srcloc="WLC.JOB.8.3.009" x-head="true" lemma="צֶדֶק" strong="H6664">righteousness</char>?<verse eid="JOB 8:3" /></para>
	<para style="q1"><verse number="4" style="v" sid="JOB 8:4" /><note caller="-" style="f"><char style="ft">Or, <char style="it">If thy children sinned . . . he delivered etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.8.4.a001" x-src="WLC.JOB.8.4.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JOB.8.4.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JOB.8.4.a003" x-src="WLC.JOB.8.4.003" x-source="ךָ" x-translit="ḵā" srcloc="WLC.JOB.8.4.003" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t003" x-align="JOB.8.4.a002" x-src="WLC.JOB.8.4.002" x-source="בָּנֶ֥י" x-translit="bāney" srcloc="WLC.JOB.8.4.002" x-head="true" lemma="בֵּן" strong="H1121">children</char> <char style="w" x-id="t004" x-align="JOB.8.4.a004">have</char> <char style="w" x-id="t005" x-align="JOB.8.4.a004" x-src="WLC.JOB.8.4.004" x-source="חָֽטְאוּ" x-translit="ḥāṭəʾû-" srcloc="WLC.JOB.8.4.004" x-head="true" lemma="חָטָא" strong="H2398">sinned</char> <char style="w" x-id="t006" x-align="JOB.8.4.a005" x-src="WLC.JOB.8.4.005" x-source="ל֑" x-translit="l" srcloc="WLC.JOB.8.4.005" x-head="true" lemma="לְ" strong="H3807a">against</char> <char style="w" x-id="t007" x-align="JOB.8.4.a006" x-src="WLC.JOB.8.4.006" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.8.4.006" x-head="true" lemma="הוּא" strong="H2050c">him</char>,</para>
