	<para style="q1"><char style="w" x-id="t008" x-align="JOB.9.22.a008" x-src="WLC.JOB.9.22.009" x-source="ה֣וּא" x-translit="hûʾ" srcloc="WLC.JOB.9.22.009" x-head="true" lemma="הוּא" strong="H1931">He</char> <char style="w" x-id="t009" x-align="JOB.9.22.a009" x-src="WLC.JOB.9.22.010" x-source="מְכַלֶּֽה" x-translit="məḵalleh:" srcloc="WLC.JOB.9.22.010" x-head="true" lemma="כָּלָה" strong="H3615">destroyeth</char> <char style="w" x-id="t010" x-align="JOB.9.22.a005">the</char> <char style="w" x-id="t011" x-align="JOB.9.22.a005" x-src="WLC.JOB.9.22.006" x-source="תָּ֥ם" x-translit="tām" srcloc="WLC.JOB.9.22.006" x-head="true" lemma="תָּם" strong="H8535">perfect</char> <char style="w" x-id="t012" x-align="JOB.9.22.a006" x-src="WLC.JOB.9.22.007" x-source="וְ֝" x-translit="wə" srcloc="WLC.JOB.9.22.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t013" x-align="JOB.9.22.a007">the</char> <char style="w" x-id="t014" x-align="JOB.9.22.a007" x-src="WLC.JOB.9.22.008" x-source="רָשָׁ֗ע" x-translit="rāšāʿ" srcloc="WLC.JOB.9.22.008" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char>.<verse eid="JOB 9:22" /></para>
