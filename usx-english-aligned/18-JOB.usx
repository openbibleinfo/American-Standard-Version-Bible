	<para style="q1"><verse number="14" style="v" sid="JOB 13:14" /><note caller="-" style="f"><char style="ft">Or, <char style="it">At all adventures I will take etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.13.14.a001" x-src="WLC.JOB.13.14.001 WLC.JOB.13.14.002" x-source="עַל מָ֤ה" x-translit="ʿal- māh" srcloc="WLC.JOB.13.14.002" x-head="true" lemma="מָה" strong="H4100">Wherefore</char> <char style="w" x-id="t002" x-align="JOB.13.14.a002">should</char> <char style="w" x-id="t003" x-align="JOB.13.14.a002">I</char> <char style="w" x-id="t004" x-align="JOB.13.14.a002" x-src="WLC.JOB.13.14.003" x-source="אֶשָּׂ֣א" x-translit="ʾeśśāʾ" srcloc="WLC.JOB.13.14.003" x-head="true" lemma="נָשָׂא" strong="H5375">take</char> <char style="w" x-id="t005" x-align="JOB.13.14.a004" x-src="WLC.JOB.13.14.005" x-source="י" x-translit="iy" srcloc="WLC.JOB.13.14.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t006" x-align="JOB.13.14.a003" x-src="WLC.JOB.13.14.004" x-source="בְשָׂרִ֣" x-translit="ḇəśār" srcloc="WLC.JOB.13.14.004" x-head="true" lemma="בָּשָׂר" strong="H1320">flesh</char> <char style="w" x-id="t007" x-align="JOB.13.14.a005" x-src="WLC.JOB.13.14.006" x-source="בְ" x-translit="ḇə" srcloc="WLC.JOB.13.14.006" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t008" x-align="JOB.13.14.a007" x-src="WLC.JOB.13.14.008" x-source="י" x-translit="āy" srcloc="WLC.JOB.13.14.008" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t009" x-align="JOB.13.14.a006" x-src="WLC.JOB.13.14.007" x-source="שִׁנָּ֑" x-translit="šinn" srcloc="WLC.JOB.13.14.007" x-head="true" lemma="שֵׁן" strong="H8127">teeth</char>,</para>
