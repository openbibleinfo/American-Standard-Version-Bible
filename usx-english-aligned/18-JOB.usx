	<para style="q1"><verse number="19" style="v" sid="JOB 4:19" /><char style="w" x-id="t001" x-align="JOB.4.19.a001">How</char> <char style="w" x-id="t002" x-align="JOB.4.19.a001">much</char> <char style="w" x-id="t003" x-align="JOB.4.19.a001" x-src="WLC.JOB.4.19.001" x-source="אַ֤ף" x-translit="ʾap̄" srcloc="WLC.JOB.4.19.001" x-head="true" lemma="אַף" strong="H637">more</char> <char style="w" x-id="t004" x-align="JOB.4.19.a002">them</char> <char style="w" x-id="t005" x-align="JOB.4.19.a002">that</char> <char style="w" x-id="t006" x-align="JOB.4.19.a002" x-src="WLC.JOB.4.19.002" x-source="שֹׁכְנֵ֬י" x-translit="šōḵənēy" srcloc="WLC.JOB.4.19.002" x-head="true" lemma="שָׁכַן" strong="H7931">dwell</char> <char style="w" x-id="t007" x-align="JOB.4.19.a003">in</char> <char style="w" x-id="t008" x-align="JOB.4.19.a003" x-src="WLC.JOB.4.19.003" x-source="בָֽתֵּי" x-translit="ḇātê-" srcloc="WLC.JOB.4.19.003" x-head="true" lemma="בַּיִת" strong="H1004">houses</char> <char style="w" x-id="t009" x-align="JOB.4.19.a004">of</char> <char style="w" x-id="t010" x-align="JOB.4.19.a004" x-src="WLC.JOB.4.19.004" x-source="חֹ֗מֶר" x-translit="ḥōmer" srcloc="WLC.JOB.4.19.004" x-head="true" lemma="חֹמֶר" strong="H2563b">clay</char>,</para>
