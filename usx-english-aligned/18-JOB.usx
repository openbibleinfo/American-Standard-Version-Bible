	<para style="q1"><verse number="14" style="v" sid="JOB 26:14" /><char style="w" x-id="t001" x-align="JOB.26.14.a001" x-src="WLC.JOB.26.14.001" x-source="הֶן" x-translit="hen-" srcloc="WLC.JOB.26.14.001" x-head="true" lemma="הֵן" strong="H2005">Lo</char>, <char style="w" x-id="t002" x-align="JOB.26.14.a002" x-src="WLC.JOB.26.14.002" x-source="אֵ֤לֶּה" x-translit="ʾēlleh" srcloc="WLC.JOB.26.14.002" x-head="true" lemma="אֵלֶּה" strong="H428">these</char> <char style="w" x-id="t003" x-align="JOB.26.14.a003">are</char> <char style="w" x-id="t004" x-align="JOB.26.14.a004" x-status="added" x-source="∅" x-head="true">but</char> <char style="w" x-id="t005" x-align="JOB.26.14.a003">the</char> <char style="w" x-id="t006" x-align="JOB.26.14.a003" x-src="WLC.JOB.26.14.003" x-source="קְצ֬וֹת" x-translit="qəṣôṯ" srcloc="WLC.JOB.26.14.003" x-head="true" lemma="קָצָה" strong="H7098">outskirts</char> <char style="w" x-id="t007" x-align="JOB.26.14.a005">of</char> <char style="w" x-id="t008" x-align="JOB.26.14.a006" x-src="WLC.JOB.26.14.005" x-source="ו" x-translit="w" srcloc="WLC.JOB.26.14.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t009" x-align="JOB.26.14.a005" x-src="WLC.JOB.26.14.004" x-source="דְּרָכָ֗י" x-translit="dərāḵāy" srcloc="WLC.JOB.26.14.004" x-head="true" lemma="דֶּרֶךְ" strong="H1870">ways</char>:</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.26.14.a007" x-src="WLC.JOB.26.14.006" x-source="וּ" x-translit="û" srcloc="WLC.JOB.26.14.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">how little a portion</char></char></note><char style="w" x-id="t011" x-align="JOB.26.14.a008" x-src="WLC.JOB.26.14.007" x-source="מַה" x-translit="mah-" srcloc="WLC.JOB.26.14.007" x-head="true" lemma="מָה" strong="H4100">how</char> <char style="w" x-id="t012" x-align="JOB.26.14.a009" x-src="WLC.JOB.26.14.008" x-source="שֵּׁ֣מֶץ" x-translit="ššēmeṣ" srcloc="WLC.JOB.26.14.008" x-head="true" lemma="שֵׁמֶץ" strong="H8102">small</char> <char style="w" x-id="t013" x-align="JOB.26.14.a009">a</char> <char style="w" x-id="t014" x-align="JOB.26.14.a010" x-src="WLC.JOB.26.14.009" x-source="דָּ֭בָר" x-translit="dāḇār" srcloc="WLC.JOB.26.14.009" x-head="true" lemma="דָּבָר" strong="H1697">whisper</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">is heard</char></char></note><char style="w" x-id="t015" x-align="JOB.26.14.a011">do</char> <char style="w" x-id="t016" x-align="JOB.26.14.a011">we</char> <char style="w" x-id="t017" x-align="JOB.26.14.a011" x-src="WLC.JOB.26.14.010" x-source="נִשְׁמַע" x-translit="nišmaʿ-" srcloc="WLC.JOB.26.14.010" x-head="true" lemma="שָׁמַע" strong="H8085">hear</char> <char style="w" x-id="t018" x-align="JOB.26.14.a012" x-src="WLC.JOB.26.14.011" x-source="בּ֑" x-translit="b" srcloc="WLC.JOB.26.14.011" x-head="true" lemma="בְּ" strong="H871a">of</char> <char style="w" x-id="t019" x-align="JOB.26.14.a013" x-src="WLC.JOB.26.14.012" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.26.14.012" x-head="true" lemma="הוּא" strong="H2050c">him</char>!</para>
	<para style="q1"><char style="w" x-id="t020" x-align="JOB.26.14.a014" x-src="WLC.JOB.26.14.013" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.26.14.013" x-head="true" lemma="וְ" strong="H2050b">But</char> <char style="w" x-id="t021" x-align="JOB.26.14.a015">the</char> <char style="w" x-id="t022" x-align="JOB.26.14.a015" x-src="WLC.JOB.26.14.014" x-source="רַ֥עַם" x-translit="raʿam" srcloc="WLC.JOB.26.14.014" x-head="true" lemma="רַעַם" strong="H7482">thunder</char> <char style="w" x-id="t023" x-align="JOB.26.14.a016">of</char> <char style="w" x-id="t024" x-align="JOB.26.14.a017" x-src="WLC.JOB.26.14.016" x-source="ו" x-translit="w" srcloc="WLC.JOB.26.14.016" x-head="true" lemma="הוּא" strong="H2050c">his</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">mighty deeds</char></char></note><char style="w" x-id="t025" x-align="JOB.26.14.a016" x-src="WLC.JOB.26.14.015" x-source="גְּ֝בוּרוֹתָ֗י" x-translit="gəḇûrôṯāy" srcloc="WLC.JOB.26.14.015" x-head="true" lemma="גְּבוּרָה" strong="H1369">power</char> <char style="w" x-id="t026" x-align="JOB.26.14.a018" x-src="WLC.JOB.26.14.017" x-source="מִ֣י" x-translit="miy" srcloc="WLC.JOB.26.14.017" x-head="true" lemma="מִי" strong="H4310">who</char> <char style="w" x-id="t027" x-align="JOB.26.14.a019">can</char> <char style="w" x-id="t028" x-align="JOB.26.14.a019" x-src="WLC.JOB.26.14.018" x-source="יִתְבּוֹנָֽן" x-translit="yiṯbônān:" srcloc="WLC.JOB.26.14.018" x-head="true" lemma="בִּין" strong="H995">understand</char>?<verse eid="JOB 26:14" /></para>
