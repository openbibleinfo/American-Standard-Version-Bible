	<para style="q1"><verse number="13" style="v" sid="JOB 32:13" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Lest ye should say, We have found out wisdom; God thrusteth him down, not man: Now he etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.32.13.a001" x-status="added" x-source="∅" x-head="true">Beware</char> <char style="w" x-id="t002" x-align="JOB.32.13.a002" x-src="WLC.JOB.32.13.001" x-source="פֶּן" x-translit="pen-" srcloc="WLC.JOB.32.13.001" x-head="true" lemma="פֶּן" strong="H6435">lest</char> <char style="w" x-id="t003" x-align="JOB.32.13.a003">ye</char> <char style="w" x-id="t004" x-align="JOB.32.13.a003" x-src="WLC.JOB.32.13.002" x-source="תֹּ֣֭אמְרוּ" x-translit="tōʾmərû" srcloc="WLC.JOB.32.13.002" x-head="true" lemma="אָמַר" strong="H559">say</char>, <char style="w" x-id="t005" x-align="JOB.32.13.a004">We</char> <char style="w" x-id="t006" x-align="JOB.32.13.a004">have</char> <char style="w" x-id="t007" x-align="JOB.32.13.a004" x-src="WLC.JOB.32.13.003" x-source="מָצָ֣אנוּ" x-translit="māṣāʾnû" srcloc="WLC.JOB.32.13.003" x-head="true" lemma="מָצָא" strong="H4672">found</char> <char style="w" x-id="t008" x-align="JOB.32.13.a005" x-src="WLC.JOB.32.13.004" x-source="חָכְמָ֑ה" x-translit="ḥoḵmāh" srcloc="WLC.JOB.32.13.004" x-head="true" lemma="חׇכְמָה" strong="H2451">wisdom</char>;</para>
