	<para style="q1"><char style="w" x-id="t008" x-align="JOB.6.17.a005" x-src="WLC.JOB.6.17.005" x-source="בְּ֝" x-translit="bə" srcloc="WLC.JOB.6.17.005" x-head="true" lemma="בְּ" strong="H871a">When</char> <char style="w" x-id="t009" x-align="JOB.6.17.a007" x-src="WLC.JOB.6.17.007" x-source="וֹ" x-translit="ô" srcloc="WLC.JOB.6.17.007" x-head="true" lemma="הוּא" strong="H2050c">it</char> <char style="w" x-id="t010" x-align="JOB.6.17.a006">is</char> <char style="w" x-id="t011" x-align="JOB.6.17.a006" x-src="WLC.JOB.6.17.006" x-source="חֻמּ֗" x-translit="ḥumm" srcloc="WLC.JOB.6.17.006" x-head="true" lemma="חמם" strong="H2552">hot</char>, <char style="w" x-id="t012" x-align="JOB.6.17.a008">they</char> <char style="w" x-id="t013" x-align="JOB.6.17.a008">are</char> <char style="w" x-id="t014" x-align="JOB.6.17.a008" x-src="WLC.JOB.6.17.008" x-source="נִדְעֲכ֥וּ" x-translit="niḏʿăḵû" srcloc="WLC.JOB.6.17.008" x-head="true" lemma="דָּעַךְ" strong="H1846">consumed</char> <char style="w" x-id="t015" x-align="JOB.6.17.a009" x-src="WLC.JOB.6.17.009" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.6.17.009" x-head="true" lemma="מִן" strong="H4480">out</char> <char style="w" x-id="t016" x-align="JOB.6.17.a009">of</char> <char style="w" x-id="t017" x-align="JOB.6.17.a011" x-src="WLC.JOB.6.17.011" x-source="ם" x-translit="ām" srcloc="WLC.JOB.6.17.011" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t018" x-align="JOB.6.17.a010" x-src="WLC.JOB.6.17.010" x-source="מְּקוֹמָֽ" x-translit="mməqôm" srcloc="WLC.JOB.6.17.010" x-head="true" lemma="מָקוֹם" strong="H4725">place</char>.<verse eid="JOB 6:17" /></para>
	<para style="q1"><verse number="18" style="v" sid="JOB 6:18" /><note caller="-" style="f"><char style="ft">Or, <char style="it">The paths of their way are turned aside</char></char></note><char style="w" x-id="t001" x-align="JOB.6.18.a002">The</char> <char style="w" x-id="t002" x-align="JOB.6.18.a002" x-src="WLC.JOB.6.18.002" x-source="אָרְח֣וֹת" x-translit="ʾārḥôṯ" srcloc="WLC.JOB.6.18.002" x-head="true" lemma="אֹרַח" strong="H734">caravans</char> <char style="add"><char style="w" x-id="t003" x-align="JOB.6.18.a003" x-status="added">that</char> <char style="w" x-id="t004" x-align="JOB.6.18.a003" x-status="added" x-source="∅" x-head="true">travel</char></char> <char style="w" x-id="t005" x-align="JOB.6.18.a004">by</char> <char style="w" x-id="t006" x-align="JOB.6.18.a004">the</char> <char style="w" x-id="t007" x-align="JOB.6.18.a004" x-src="WLC.JOB.6.18.003" x-source="דַּרְכָּ֑" x-translit="dark" srcloc="WLC.JOB.6.18.003" x-head="true" lemma="דֶּרֶךְ" strong="H1870">way</char> <char style="w" x-id="t008" x-align="JOB.6.18.a005">of</char> <char style="w" x-id="t009" x-align="JOB.6.18.a005" x-src="WLC.JOB.6.18.004" x-source="ם" x-translit="ām" srcloc="WLC.JOB.6.18.004" x-head="true" lemma="הוּא" strong="H3963a">them</char> <char style="w" x-id="t010" x-align="JOB.6.18.a001" x-src="WLC.JOB.6.18.001" x-source="יִ֭לָּ֣פְתוּ" x-translit="yillāp̄əṯû" srcloc="WLC.JOB.6.18.001" x-head="true" lemma="לָפַת" strong="H3943">turn</char> <char style="w" x-id="t011" x-align="JOB.6.18.a001">aside</char>;</para>
	<para style="q1"><char style="w" x-id="t012" x-align="JOB.6.18.a006">They</char> <char style="w" x-id="t013" x-align="JOB.6.18.a006">go</char> <char style="w" x-id="t014" x-align="JOB.6.18.a006" x-src="WLC.JOB.6.18.005" x-source="יַעֲל֖וּ" x-translit="yaʿălû" srcloc="WLC.JOB.6.18.005" x-head="true" lemma="עָלָה" strong="H5927">up</char> <char style="w" x-id="t015" x-align="JOB.6.18.a007" x-src="WLC.JOB.6.18.006" x-source="בַ" x-translit="ḇa" srcloc="WLC.JOB.6.18.006" x-head="true" lemma="בְּ" strong="H871a">into</char> <char style="w" x-id="t016" x-align="JOB.6.18.a008" x-src="WLC.JOB.6.18.007" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.JOB.6.18.007" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t017" x-align="JOB.6.18.a009" x-src="WLC.JOB.6.18.008" x-source="תֹּ֣הוּ" x-translit="tōhû" srcloc="WLC.JOB.6.18.008" x-head="true" lemma="תֹּהוּ" strong="H8414">waste</char>, <char style="w" x-id="t018" x-align="JOB.6.18.a010" x-src="WLC.JOB.6.18.009" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.6.18.009" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t019" x-align="JOB.6.18.a011" x-src="WLC.JOB.6.18.010" x-source="יֹאבֵֽדוּ" x-translit="yōʾḇēḏû:" srcloc="WLC.JOB.6.18.010" x-head="true" lemma="אָבַד" strong="H6">perish</char>.<verse eid="JOB 6:18" /></para>
	<para style="q1"><verse number="19" style="v" sid="JOB 6:19" /><char style="w" x-id="t001" x-align="JOB.6.19.a002">The</char> <char style="w" x-id="t002" x-align="JOB.6.19.a002" x-src="WLC.JOB.6.19.002" x-source="אָרְח֣וֹת" x-translit="ʾārḥôṯ" srcloc="WLC.JOB.6.19.002" x-head="true" lemma="אֹרַח" strong="H734">caravans</char> <char style="w" x-id="t003" x-align="JOB.6.19.a003">of</char> <char style="w" x-id="t004" x-align="JOB.6.19.a003" x-src="WLC.JOB.6.19.003" x-source="תֵּמָ֑א" x-translit="tēmāʾ" srcloc="WLC.JOB.6.19.003" x-head="true" lemma="תֵּימָא" strong="H8485">Tema</char> <char style="w" x-id="t005" x-align="JOB.6.19.a001" x-src="WLC.JOB.6.19.001" x-source="הִ֭בִּיטוּ" x-translit="hibbîṭû" srcloc="WLC.JOB.6.19.001" x-head="true" lemma="נָבַט" strong="H5027">looked</char>,</para>
	<para style="q1"><char style="w" x-id="t006" x-align="JOB.6.19.a004">The</char> <char style="w" x-id="t007" x-align="JOB.6.19.a004" x-src="WLC.JOB.6.19.004" x-source="הֲלִיכֹ֥ת" x-translit="hălîḵōṯ" srcloc="WLC.JOB.6.19.004" x-head="true" lemma="הֲלִיכָה" strong="H1979">companies</char> <char style="w" x-id="t008" x-align="JOB.6.19.a005">of</char> <char style="w" x-id="t009" x-align="JOB.6.19.a005" x-src="WLC.JOB.6.19.005" x-source="שְׁ֝בָ֗א" x-translit="šəḇāʾ" srcloc="WLC.JOB.6.19.005" x-head="true" lemma="שְׁבָא" strong="H7614">Sheba</char> <char style="w" x-id="t010" x-align="JOB.6.19.a006" x-src="WLC.JOB.6.19.006" x-source="קִוּוּ" x-translit="qiwwû-" srcloc="WLC.JOB.6.19.006" x-head="true" lemma="קָוָה" strong="H6960">waited</char> <char style="w" x-id="t011" x-align="JOB.6.19.a007" x-src="WLC.JOB.6.19.007" x-source="לָֽ" x-translit="lā" srcloc="WLC.JOB.6.19.007" x-head="true" lemma="לְ" strong="H3807z">for</char> <char style="w" x-id="t012" x-align="JOB.6.19.a008" x-src="WLC.JOB.6.19.008" x-source="מוֹ" x-translit="mô" srcloc="WLC.JOB.6.19.008" x-head="true" lemma="הוּא" strong="H3963a">them</char>.<verse eid="JOB 6:19" /></para>
	<para style="q1"><verse number="20" style="v" sid="JOB 6:20" /><char style="w" x-id="t001" x-align="JOB.6.20.a001">They</char> <char style="w" x-id="t002" x-align="JOB.6.20.a001">were</char> <char style="w" x-id="t003" x-align="JOB.6.20.a001">put</char> <char style="w" x-id="t004" x-align="JOB.6.20.a001">to</char> <char style="w" x-id="t005" x-align="JOB.6.20.a001" x-src="WLC.JOB.6.20.001" x-source="בֹּ֥שׁוּ" x-translit="bōšû" srcloc="WLC.JOB.6.20.001" x-head="true" lemma="בּוֹשׁ" strong="H954">shame</char> <char style="w" x-id="t006" x-align="JOB.6.20.a002" x-src="WLC.JOB.6.20.002" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.6.20.002" x-head="true" lemma="כִּי" strong="H3588">because</char> <char style="w" x-id="t007" x-align="JOB.6.20.a003">they</char> <char style="w" x-id="t008" x-align="JOB.6.20.a003">had</char> <char style="w" x-id="t009" x-align="JOB.6.20.a003" x-src="WLC.JOB.6.20.003" x-source="בָטָ֑ח" x-translit="ḇāṭāḥ" srcloc="WLC.JOB.6.20.003" x-head="true" lemma="בָּטַח" strong="H982">hoped</char>;</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.6.20.a004">They</char> <char style="w" x-id="t011" x-align="JOB.6.20.a004" x-src="WLC.JOB.6.20.004" x-source="בָּ֥אוּ" x-translit="bāʾû" srcloc="WLC.JOB.6.20.004" x-head="true" lemma="בּוֹא" strong="H935">came</char> <char style="w" x-id="t012" x-align="JOB.6.20.a005" x-src="WLC.JOB.6.20.005 WLC.JOB.6.20.006" x-source="עָ֝דֶ֗י הָ" x-translit="ʿāḏey hā" srcloc="WLC.JOB.6.20.005" x-head="true" lemma="עַד" strong="H5704">thither</char>, <char style="w" x-id="t013" x-align="JOB.6.20.a006" x-src="WLC.JOB.6.20.007" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.6.20.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t014" x-align="JOB.6.20.a007">were</char> <char style="w" x-id="t015" x-align="JOB.6.20.a007" x-src="WLC.JOB.6.20.008" x-source="יֶּחְפָּֽרוּ" x-translit="yyeḥpārû:" srcloc="WLC.JOB.6.20.008" x-head="true" lemma="חָפֵר" strong="H2659">confounded</char>.<verse eid="JOB 6:20" /></para>
	<para style="q1"><verse number="21" style="v" sid="JOB 6:21" /><char style="w" x-id="t001" x-align="JOB.6.21.a001" x-src="WLC.JOB.6.21.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.6.21.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="JOB.6.21.a002" x-src="WLC.JOB.6.21.002" x-source="עַ֭תָּה" x-translit="ʿattâ" srcloc="WLC.JOB.6.21.002" x-head="true" lemma="עַתָּה" strong="H6258">now</char> <char style="w" x-id="t003" x-align="JOB.6.21.a003">ye</char> <note caller="-" style="f"><char style="ft">Another reading is, <char style="it">are</char> like <char style="it">thereto</char>.</char></note><char style="w" x-id="t004" x-align="JOB.6.21.a003" x-src="WLC.JOB.6.21.003" x-source="הֱיִ֣יתֶם" x-translit="hĕyiyṯem" srcloc="WLC.JOB.6.21.003" x-head="true" lemma="הָיָה" strong="H1961">are</char> <char style="w" x-id="t005" x-align="JOB.6.21.a004" x-src="WLC.JOB.6.21.v002.r01.001" x-source="לא" x-translit="lʾ" srcloc="WLC.JOB.6.21.v002.r01.001" x-head="true" lemma="לֹא" strong="H3808">nothing</char>;</para>
