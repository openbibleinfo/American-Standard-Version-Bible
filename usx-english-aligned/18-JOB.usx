	<para style="q1"><verse number="2" style="v" sid="JOB 8:2" /><char style="w" x-id="t001" x-align="JOB.8.2.a001" x-status="noncompositional">How</char> <char style="w" x-id="t002" x-align="JOB.8.2.a001" x-status="noncompositional" x-src="WLC.JOB.8.2.001 WLC.JOB.8.2.002" x-source="עַד אָ֥ן" x-translit="ʿaḏ- ʾān" srcloc="WLC.JOB.8.2.001" x-head="true" lemma="עַד" strong="H5704">long</char> <char style="w" x-id="t003" x-align="JOB.8.2.a002">wilt</char> <char style="w" x-id="t004" x-align="JOB.8.2.a002">thou</char> <char style="w" x-id="t005" x-align="JOB.8.2.a002" x-src="WLC.JOB.8.2.003" x-source="תְּמַלֶּל" x-translit="təmallel-" srcloc="WLC.JOB.8.2.003" x-head="true" lemma="מָלַל" strong="H4448">speak</char> <char style="w" x-id="t006" x-align="JOB.8.2.a003" x-src="WLC.JOB.8.2.004" x-source="אֵ֑לֶּה" x-translit="ʾēlleh" srcloc="WLC.JOB.8.2.004" x-head="true" lemma="אֵלֶּה" strong="H428">these</char> <char style="w" x-id="t007" x-align="JOB.8.2.a003">things</char>?</para>
