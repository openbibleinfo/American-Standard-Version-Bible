	<para style="q1"><verse number="32" style="v" sid="JOB 21:32" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Moreover he is borne to the grave, And keepeth watch over his tomb. The clods of the valley are sweet unto him; And all men draw etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.21.32.a001" x-src="WLC.JOB.21.32.001" x-source="וְ֭" x-translit="wə" srcloc="WLC.JOB.21.32.001" x-head="true" lemma="וְ" strong="H2050b">Yet</char> <char style="w" x-id="t002" x-align="JOB.21.32.a005">shall</char> <char style="w" x-id="t003" x-align="JOB.21.32.a002" x-src="WLC.JOB.21.32.002" x-source="הוּא" x-translit="hûʾ" srcloc="WLC.JOB.21.32.002" x-head="true" lemma="הוּא" strong="H1931">he</char> <char style="w" x-id="t004" x-align="JOB.21.32.a005">be</char> <char style="w" x-id="t005" x-align="JOB.21.32.a005" x-src="WLC.JOB.21.32.005" x-source="יוּבָ֑ל" x-translit="yûḇāl" srcloc="WLC.JOB.21.32.005" x-head="true" lemma="יָבַל" strong="H2986">borne</char> <char style="w" x-id="t006" x-align="JOB.21.32.a003" x-src="WLC.JOB.21.32.003" x-source="לִ" x-translit="li" srcloc="WLC.JOB.21.32.003" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t007" x-align="JOB.21.32.a004">the</char> <char style="w" x-id="t008" x-align="JOB.21.32.a004" x-src="WLC.JOB.21.32.004" x-source="קְבָר֣וֹת" x-translit="qəḇārôṯ" srcloc="WLC.JOB.21.32.004" x-head="true" lemma="קֶבֶר" strong="H6913">grave</char>,</para>
