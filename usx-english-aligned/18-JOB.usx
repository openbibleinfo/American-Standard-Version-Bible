	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Host after host is against me</char>.</char></note><char style="w" x-id="t013" x-align="JOB.10.17.a012" x-src="WLC.JOB.10.17.012" x-source="חֲלִיפ֖וֹת" x-translit="ḥălîp̄ôṯ" srcloc="WLC.JOB.10.17.012" x-head="true" lemma="חֲלִיפָה" strong="H2487">Changes</char> <char style="w" x-id="t014" x-align="JOB.10.17.a013" x-src="WLC.JOB.10.17.013" x-source="וְ" x-translit="wə" srcloc="WLC.JOB.10.17.013" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t015" x-align="JOB.10.17.a014" x-src="WLC.JOB.10.17.014" x-source="צָבָ֣א" x-translit="ṣāḇāʾ" srcloc="WLC.JOB.10.17.014" x-head="true" lemma="צָבָא" strong="H6635">warfare</char> <char style="w" x-id="t016" x-align="JOB.10.17.a015">are</char> <char style="w" x-id="t017" x-align="JOB.10.17.a015" x-src="WLC.JOB.10.17.015" x-source="עִמִּֽ" x-translit="ʿimm" srcloc="WLC.JOB.10.17.015" x-head="true" lemma="עִם" strong="H5973">with</char> <char style="w" x-id="t018" x-align="JOB.10.17.a016" x-src="WLC.JOB.10.17.016" x-source="י" x-translit="iy" srcloc="WLC.JOB.10.17.016" x-head="true" lemma="הוּא" strong="H2967a">me</char>.<verse eid="JOB 10:17" /></para>
