	<para style="q1"><char style="w" x-id="t013" x-align="JOB.18.15.a013" x-src="WLC.JOB.18.15.013" x-source="גָפְרִֽית" x-translit="ḡāp̄əriyṯ:" srcloc="WLC.JOB.18.15.013" x-head="true" lemma="גׇּפְרִית" strong="H1614">Brimstone</char> <char style="w" x-id="t014" x-align="JOB.18.15.a009">shall</char> <char style="w" x-id="t015" x-align="JOB.18.15.a009">be</char> <char style="w" x-id="t016" x-align="JOB.18.15.a009" x-src="WLC.JOB.18.15.009" x-source="יְזֹרֶ֖ה" x-translit="yəzōreh" srcloc="WLC.JOB.18.15.009" x-head="true" lemma="זָרָה" strong="H2219">scattered</char> <char style="w" x-id="t017" x-align="JOB.18.15.a010" x-src="WLC.JOB.18.15.010" x-source="עַל" x-translit="ʿal-" srcloc="WLC.JOB.18.15.010" x-head="true" lemma="עַל" strong="H5921">upon</char> <char style="w" x-id="t018" x-align="JOB.18.15.a012" x-src="WLC.JOB.18.15.012" x-source="הוּ" x-translit="ēhû" srcloc="WLC.JOB.18.15.012" x-head="true" lemma="הוּא" strong="H1930a">his</char> <char style="w" x-id="t019" x-align="JOB.18.15.a011" x-src="WLC.JOB.18.15.011" x-source="נָוֵ֣" x-translit="nāw" srcloc="WLC.JOB.18.15.011" x-head="true" lemma="נָוֶה" strong="H5116">habitation</char>.<verse eid="JOB 18:15" /></para>
