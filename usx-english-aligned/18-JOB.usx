	<para style="q1"><verse number="16" style="v" x-unrepresented-source="לָ֗" x-unrepresented-translit="lā" x-unrepresented-src="WLC.JOB.24.16.008" sid="JOB 24:16" /><char style="w" x-id="t001" x-align="JOB.24.16.a002" x-src="WLC.JOB.24.16.002" x-source="בַּ" x-translit="ba" srcloc="WLC.JOB.24.16.002" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t002" x-align="JOB.24.16.a003" x-src="WLC.JOB.24.16.003" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.JOB.24.16.003" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="JOB.24.16.a004" x-src="WLC.JOB.24.16.004" x-source="חֹ֗שֶׁךְ" x-translit="ḥōšeḵ" srcloc="WLC.JOB.24.16.004" x-head="true" lemma="חֹשֶׁךְ" strong="H2822">dark</char> <char style="w" x-id="t004" x-align="JOB.24.16.a001">they</char> <char style="w" x-id="t005" x-align="JOB.24.16.a001" x-src="WLC.JOB.24.16.001" x-source="חָתַ֥ר" x-translit="ḥāṯar" srcloc="WLC.JOB.24.16.001" x-head="true" lemma="חָתַר" strong="H2864">dig</char> <char style="w" x-id="t006" x-align="JOB.24.16.a001">through</char> <char style="w" x-id="t007" x-align="JOB.24.16.a005" x-src="WLC.JOB.24.16.005" x-source="בָּ֫תִּ֥ים" x-translit="bātiym" srcloc="WLC.JOB.24.16.005" x-head="true" lemma="בַּיִת" strong="H1004">houses</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, Which <char style="it">they had marked for themselves</char></char></note><char style="w" x-id="t008" x-align="JOB.24.16.a007">They</char> <char style="w" x-id="t009" x-align="JOB.24.16.a007" x-src="WLC.JOB.24.16.007" x-source="חִתְּמוּ" x-translit="ḥittəmû-" srcloc="WLC.JOB.24.16.007" x-head="true" lemma="חָתַם" strong="H2856">shut</char> <char style="w" x-id="t010" x-align="JOB.24.16.a009" x-src="WLC.JOB.24.16.009" x-source="מוֹ" x-translit="mô" srcloc="WLC.JOB.24.16.009" x-head="true" lemma="הוּא" strong="H3963a">themselves</char> <char style="w" x-id="t011" x-align="JOB.24.16.a007">up</char> <char style="w" x-id="t012" x-align="JOB.24.16.a006">in</char> <char style="w" x-id="t013" x-align="JOB.24.16.a006">the</char> <char style="w" x-id="t014" x-align="JOB.24.16.a006" x-src="WLC.JOB.24.16.006" x-source="יוֹמָ֥ם" x-translit="yômām" srcloc="WLC.JOB.24.16.006" x-head="true" lemma="יוֹמָם" strong="H3119">day</char>-<char style="w" x-id="t015" x-align="JOB.24.16.a006">time</char>;</para>
	<para style="q1"><char style="w" x-id="t016" x-align="JOB.24.16.a011">They</char> <char style="w" x-id="t017" x-align="JOB.24.16.a011" x-src="WLC.JOB.24.16.011" x-source="יָ֥דְעוּ" x-translit="yāḏəʿû" srcloc="WLC.JOB.24.16.011" x-head="true" lemma="יָדַע" strong="H3045">know</char> <char style="w" x-id="t018" x-align="JOB.24.16.a010" x-src="WLC.JOB.24.16.010" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.JOB.24.16.010" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t019" x-align="JOB.24.16.a012">the</char> <char style="w" x-id="t020" x-align="JOB.24.16.a012" x-src="WLC.JOB.24.16.012" x-source="אֽוֹר" x-translit="ʾôr:" srcloc="WLC.JOB.24.16.012" x-head="true" lemma="אוֹר" strong="H216">light</char>.<verse eid="JOB 24:16" /></para>
	<para style="q1"><verse number="17" style="v" sid="JOB 24:17" /><char style="w" x-id="t001" x-align="JOB.24.17.a001" x-src="WLC.JOB.24.17.001" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.JOB.24.17.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">thick darkness is to all of them as the morning; For they etc.</char></char></note><char style="w" x-id="t002" x-align="JOB.24.17.a003">the</char> <char style="w" x-id="t003" x-align="JOB.24.17.a003" x-src="WLC.JOB.24.17.003" x-source="בֹּ֣קֶר" x-translit="bōqer" srcloc="WLC.JOB.24.17.003" x-head="true" lemma="בֹּקֶר" strong="H1242">morning</char> <char style="w" x-id="t004" x-align="JOB.24.17.a006">is</char> <char style="w" x-id="t005" x-align="JOB.24.17.a004" x-src="WLC.JOB.24.17.004" x-source="לָ֣" x-translit="lā" srcloc="WLC.JOB.24.17.004" x-head="true" lemma="לְ" strong="H3807z">to</char> <char style="w" x-id="t006" x-align="JOB.24.17.a002" x-src="WLC.JOB.24.17.002" x-source="יַחְדָּ֨ו" x-translit="yaḥdāw" srcloc="WLC.JOB.24.17.002" x-head="true" lemma="יָחְדָּו" strong="H3162a">all</char> <char style="w" x-id="t007" x-align="JOB.24.17.a002">of</char> <char style="w" x-id="t008" x-align="JOB.24.17.a005" x-src="WLC.JOB.24.17.005" x-source="מוֹ" x-translit="mô" srcloc="WLC.JOB.24.17.005" x-head="true" lemma="הוּא" strong="H3963a">them</char> <char style="w" x-id="t009" x-align="JOB.24.17.a006">as</char> <char style="w" x-id="t010" x-align="JOB.24.17.a006">thick</char> <char style="w" x-id="t011" x-align="JOB.24.17.a006" x-src="WLC.JOB.24.17.006" x-source="צַלְמָ֑וֶת" x-translit="ṣalmāweṯ" srcloc="WLC.JOB.24.17.006" x-head="true" lemma="צַלְמָוֶת" strong="H6757">darkness</char>;</para>
	<para style="q1"><char style="w" x-id="t012" x-align="JOB.24.17.a007" x-src="WLC.JOB.24.17.007" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.24.17.007" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t013" x-align="JOB.24.17.a008">they</char> <char style="w" x-id="t014" x-align="JOB.24.17.a008" x-src="WLC.JOB.24.17.008" x-source="יַ֝כִּ֗יר" x-translit="yakkiyr" srcloc="WLC.JOB.24.17.008" x-head="true" lemma="נָכַר" strong="H5234">know</char> <char style="w" x-id="t015" x-align="JOB.24.17.a009">the</char> <char style="w" x-id="t016" x-align="JOB.24.17.a009" x-src="WLC.JOB.24.17.009" x-source="בַּלְה֥וֹת" x-translit="balhôṯ" srcloc="WLC.JOB.24.17.009" x-head="true" lemma="בַּלָּהָה" strong="H1091">terrors</char> <char style="w" x-id="t017" x-align="JOB.24.17.a010">of</char> <char style="w" x-id="t018" x-align="JOB.24.17.a010">the</char> <char style="w" x-id="t019" x-align="JOB.24.17.a010">thick</char> <char style="w" x-id="t020" x-align="JOB.24.17.a010" x-src="WLC.JOB.24.17.010" x-source="צַלְמָֽוֶת" x-translit="ṣalmāweṯ:" srcloc="WLC.JOB.24.17.010" x-head="true" lemma="צַלְמָוֶת" strong="H6757">darkness</char>.<verse eid="JOB 24:17" /></para>
	<para style="b"><verse number="18" style="v" sid="JOB 24:18" /></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, Ye say, <char style="it">Swiftly etc.</char> Hebrew <char style="it">Swift is he etc.</char></char></note><char style="w" x-id="t001" x-align="JOB.24.18.a001" x-src="WLC.JOB.24.18.001" x-source="קַֽל" x-translit="qal-" srcloc="WLC.JOB.24.18.001" x-head="true" lemma="קַל" strong="H7031">Swiftly</char> <char style="w" x-id="t002" x-align="JOB.24.18.a002" x-src="WLC.JOB.24.18.002" x-source="ה֤וּא" x-translit="hûʾ" srcloc="WLC.JOB.24.18.002" x-head="true" lemma="הוּא" strong="H1931">they</char> <char style="add"><char style="w" x-id="t003" x-align="JOB.24.18.a003" x-status="added" x-source="∅" x-head="true">pass</char> <char style="w" x-id="t004" x-align="JOB.24.18.a003" x-status="added">away</char></char> <char style="w" x-id="t005" x-align="JOB.24.18.a004" x-src="WLC.JOB.24.18.003" x-source="עַל" x-translit="ʿal-" srcloc="WLC.JOB.24.18.003" x-head="true" lemma="עַל" strong="H5921">upon</char> <char style="w" x-id="t006" x-align="JOB.24.18.a005">the</char> <char style="w" x-id="t007" x-align="JOB.24.18.a005" x-src="WLC.JOB.24.18.004" x-source="פְּנֵי" x-translit="pənê-" srcloc="WLC.JOB.24.18.004" x-head="true" lemma="פָּנֶה" strong="H6440">face</char> <char style="w" x-id="t008" x-align="JOB.24.18.a006">of</char> <char style="w" x-id="t009" x-align="JOB.24.18.a006">the</char> <char style="w" x-id="t010" x-align="JOB.24.18.a006" x-src="WLC.JOB.24.18.005" x-source="מַ֗יִם" x-translit="mayim" srcloc="WLC.JOB.24.18.005" x-head="true" lemma="מַיִם" strong="H4325">waters</char>;</para>
