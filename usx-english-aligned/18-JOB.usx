	<para style="q1"><char style="w" x-id="t001" x-align="JOB.5.17.a001" x-src="WLC.JOB.5.17.001" x-source="הִנֵּ֤ה" x-translit="hinnēh" srcloc="WLC.JOB.5.17.001" x-head="true" lemma="הִנֵּה" strong="H2009">Behold</char>, <char style="w" x-id="t002" x-align="JOB.5.17.a002" x-src="WLC.JOB.5.17.002" x-source="אַשְׁרֵ֣י" x-translit="ʾašrēy" srcloc="WLC.JOB.5.17.002" x-head="true" lemma="אֶשֶׁר" strong="H835a">happy</char> <char style="w" x-id="t003" x-align="JOB.5.17.a002">is</char> <char style="w" x-id="t004" x-align="JOB.5.17.a003">the</char> <char style="w" x-id="t005" x-align="JOB.5.17.a003" x-src="WLC.JOB.5.17.003" x-source="אֱ֭נוֹשׁ" x-translit="ʾĕnôš" srcloc="WLC.JOB.5.17.003" x-head="true" lemma="אֱנוֹשׁ" strong="H582">man</char> <char style="w" x-id="t006" x-align="JOB.5.17.a005" x-src="WLC.JOB.5.17.005" x-source="נּֽוּ" x-translit="ennû" srcloc="WLC.JOB.5.17.005" x-head="true" lemma="הוּא" strong="H5105b">whom</char> <char style="w" x-id="t007" x-align="JOB.5.17.a006" x-src="WLC.JOB.5.17.006" x-source="אֱל֑וֹהַּ" x-translit="ʾĕlôᵃẖ" srcloc="WLC.JOB.5.17.006" x-head="true" lemma="אֱלֹוהַּ" strong="H433">God</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">reproveth</char></char></note><char style="w" x-id="t008" x-align="JOB.5.17.a004" x-src="WLC.JOB.5.17.004" x-source="יוֹכִחֶ֣" x-translit="yôḵiḥ" srcloc="WLC.JOB.5.17.004" x-head="true" lemma="יָכַח" strong="H3198">correcteth</char>:</para>
