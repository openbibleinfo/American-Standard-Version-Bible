	<para style="q1"><verse number="5" style="v" sid="JOB 5:5" /><char style="w" x-id="t001" x-align="JOB.5.5.a001" x-src="WLC.JOB.5.5.001 WLC.JOB.5.5.003" x-source="אֲשֶׁ֤ר וֹ" x-translit="ʾăšer ô" srcloc="WLC.JOB.5.5.001" x-head="true" lemma="אֲשֶׁר" strong="H834">Whose</char> <char style="w" x-id="t002" x-align="JOB.5.5.a002" x-src="WLC.JOB.5.5.002" x-source="קְצִיר֨" x-translit="qəṣiyr" srcloc="WLC.JOB.5.5.002" x-head="true" lemma="קָצִיר" strong="H7105">harvest</char> <char style="w" x-id="t003" x-align="JOB.5.5.a003">the</char> <char style="w" x-id="t004" x-align="JOB.5.5.a003" x-src="WLC.JOB.5.5.004" x-source="רָ֘עֵ֤ב" x-translit="rāʿēḇ" srcloc="WLC.JOB.5.5.004" x-head="true" lemma="רָעֵב" strong="H7457">hungry</char> <char style="w" x-id="t005" x-align="JOB.5.5.a004" x-src="WLC.JOB.5.5.005" x-source="יֹאכֵ֗ל" x-translit="yōʾḵēl" srcloc="WLC.JOB.5.5.005" x-head="true" lemma="אָכַל" strong="H398">eateth</char> <char style="w" x-id="t006" x-align="JOB.5.5.a004">up</char>,</para>
