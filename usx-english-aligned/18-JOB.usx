	<para style="q1"><char style="w" x-id="t001" x-align="JOB.31.1.a001">I</char> <char style="w" x-id="t002" x-align="JOB.31.1.a001" x-src="WLC.JOB.31.1.002" x-source="כָּרַ֣תִּי" x-translit="kāratî" srcloc="WLC.JOB.31.1.002" x-head="true" lemma="כָּרַת" strong="H3772">made</char> <char style="w" x-id="t003" x-align="JOB.31.1.a002">a</char> <char style="w" x-id="t004" x-align="JOB.31.1.a002" x-src="WLC.JOB.31.1.001" x-source="בְּ֭רִית" x-translit="bərîṯ" srcloc="WLC.JOB.31.1.001" x-head="true" lemma="בְּרִית" strong="H1285">covenant</char> <char style="w" x-id="t005" x-align="JOB.31.1.a003" x-src="WLC.JOB.31.1.003" x-source="לְ" x-translit="lə" srcloc="WLC.JOB.31.1.003" x-head="true" lemma="לְ" strong="H3807a">with</char> <char style="w" x-id="t006" x-align="JOB.31.1.a004" x-src="WLC.JOB.31.1.005" x-source="י" x-translit="āy" srcloc="WLC.JOB.31.1.005" x-head="true" lemma="הוּא" strong="H2967a">mine</char> <char style="w" x-id="t007" x-align="JOB.31.1.a005" x-src="WLC.JOB.31.1.004" x-source="עֵינָ֑" x-translit="ʿēyn" srcloc="WLC.JOB.31.1.004" x-head="true" lemma="עַיִן" strong="H5869">eyes</char>;</para>
