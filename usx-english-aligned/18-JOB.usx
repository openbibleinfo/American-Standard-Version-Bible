	<para style="q1"><verse number="15" style="v" sid="JOB 13:15" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Though he slay me, yet will I wait for him</char></char></note><char style="w" x-id="t001" x-align="JOB.13.15.a001" x-src="WLC.JOB.13.15.001" x-source="הֵ֣ן" x-translit="hēn" srcloc="WLC.JOB.13.15.001" x-head="true" lemma="הֵן" strong="H2005">Behold</char>, <char style="w" x-id="t002" x-align="JOB.13.15.a002">he</char> <char style="w" x-id="t003" x-align="JOB.13.15.a002">will</char> <char style="w" x-id="t004" x-align="JOB.13.15.a002" x-src="WLC.JOB.13.15.002" x-source="יִ֭קְטְלֵ" x-translit="yiqṭəl" srcloc="WLC.JOB.13.15.002" x-head="true" lemma="קָטַל" strong="H6991">slay</char> <char style="w" x-id="t005" x-align="JOB.13.15.a003" x-src="WLC.JOB.13.15.003" x-source="נִי" x-translit="ēniy" srcloc="WLC.JOB.13.15.003" x-head="true" lemma="הוּא" strong="H5204a">me</char>; <char style="w" x-id="t006" x-align="JOB.13.15.a005">I</char> <char style="w" x-id="t007" x-align="JOB.13.15.a005">have</char> <char style="w" x-id="t008" x-align="JOB.13.15.a004" x-src="WLC.JOB.13.15.v001.r01.001" x-source="לא" x-translit="lʾ" srcloc="WLC.JOB.13.15.v001.r01.001" x-head="true" lemma="לֹא" strong="H3808">no</char> <char style="w" x-id="t009" x-align="JOB.13.15.a005" x-src="WLC.JOB.13.15.006" x-source="אֲיַחֵ֑ל" x-translit="ʾăyaḥēl" srcloc="WLC.JOB.13.15.006" x-head="true" lemma="יָחַל" strong="H3176">hope</char>:</para>
	<para style="q1"><char style="w" x-id="t010" x-align="JOB.13.15.a006" x-src="WLC.JOB.13.15.007" x-source="אַךְ" x-translit="ʾaḵ-" srcloc="WLC.JOB.13.15.007" x-head="true" lemma="אַךְ" strong="H389">Nevertheless</char> <char style="w" x-id="t011" x-align="JOB.13.15.a011">I</char> <char style="w" x-id="t012" x-align="JOB.13.15.a011">will</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">argue</char>.</char></note><char style="w" x-id="t013" x-align="JOB.13.15.a011" x-src="WLC.JOB.13.15.013" x-source="אוֹכִֽיחַ" x-translit="ʾôḵiyᵃḥ:" srcloc="WLC.JOB.13.15.013" x-head="true" lemma="יָכַח" strong="H3198">maintain</char> <char style="w" x-id="t014" x-align="JOB.13.15.a008" x-src="WLC.JOB.13.15.009" x-source="י" x-translit="ay" srcloc="WLC.JOB.13.15.009" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t015" x-align="JOB.13.15.a007" x-src="WLC.JOB.13.15.008" x-source="דְּ֝רָכַ֗" x-translit="dərāḵ" srcloc="WLC.JOB.13.15.008" x-head="true" lemma="דֶּרֶךְ" strong="H1870">ways</char> <char style="w" x-id="t016" x-align="JOB.13.15.a009" x-src="WLC.JOB.13.15.010 WLC.JOB.13.15.011" x-source="אֶל פָּנָ֥י" x-translit="ʾel- pānāy" srcloc="WLC.JOB.13.15.011" x-head="true" lemma="פָּנֶה" strong="H6440">before</char> <char style="w" x-id="t017" x-align="JOB.13.15.a010" x-src="WLC.JOB.13.15.012" x-source="ו" x-translit="w" srcloc="WLC.JOB.13.15.012" x-head="true" lemma="הוּא" strong="H2050c">him</char>.<verse eid="JOB 13:15" /></para>
