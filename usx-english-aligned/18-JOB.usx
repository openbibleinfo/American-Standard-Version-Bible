	<para style="q1"><verse number="11" style="v" sid="JOB 22:11" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Or dost thou not see the darkness, And the flood of waters that covereth thee?</char></char></note><char style="w" x-id="t001" x-align="JOB.22.11.a001" x-src="WLC.JOB.22.11.001" x-source="אוֹ" x-translit="ʾô-" srcloc="WLC.JOB.22.11.001" x-head="true" lemma="אוֹ" strong="H176">Or</char> <char style="w" x-id="t002" x-align="JOB.22.11.a002" x-src="WLC.JOB.22.11.002" x-source="חֹ֥שֶׁךְ" x-translit="ḥōšeḵ" srcloc="WLC.JOB.22.11.002" x-head="true" lemma="חֹשֶׁךְ" strong="H2822">darkness</char>, <char style="w" x-id="t003" x-align="JOB.22.11.a003" x-status="added">so</char> <char style="w" x-id="t004" x-align="JOB.22.11.a003" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t005" x-align="JOB.22.11.a005">thou</char> <char style="w" x-id="t006" x-align="JOB.22.11.a005">canst</char> <char style="w" x-id="t007" x-align="JOB.22.11.a004" x-src="WLC.JOB.22.11.003" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.JOB.22.11.003" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t008" x-align="JOB.22.11.a005" x-src="WLC.JOB.22.11.004" x-source="תִרְאֶ֑ה" x-translit="ṯirʾeh" srcloc="WLC.JOB.22.11.004" x-head="true" lemma="רָאָה" strong="H7200">see</char>,</para>
