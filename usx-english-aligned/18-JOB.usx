	<para style="q1"><char style="w" x-id="t009" x-align="JOB.30.10.a006" x-src="WLC.JOB.30.10.006" x-source="וּ֝" x-translit="û" srcloc="WLC.JOB.30.10.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="JOB.30.10.a011" x-src="WLC.JOB.30.10.011" x-source="חָ֥שְׂכוּ" x-translit="ḥāśəḵû" srcloc="WLC.JOB.30.10.011" x-head="true" lemma="חָשַׂךְ" strong="H2820">spare</char> <char style="w" x-id="t011" x-align="JOB.30.10.a010" x-src="WLC.JOB.30.10.010" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.JOB.30.10.010" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t012" x-align="JOB.30.10.a012">to</char> <char style="w" x-id="t013" x-align="JOB.30.10.a012" x-src="WLC.JOB.30.10.012" x-source="רֹֽק" x-translit="rōq:" srcloc="WLC.JOB.30.10.012" x-head="true" lemma="רֹק" strong="H7536">spit</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">at the sight of me</char></char></note><char style="w" x-id="t014" x-align="JOB.30.10.a007" x-src="WLC.JOB.30.10.007" x-source="מִ" x-translit="mi" srcloc="WLC.JOB.30.10.007" x-head="true" lemma="מִן" strong="H4480">in</char> <char style="w" x-id="t015" x-align="JOB.30.10.a009" x-src="WLC.JOB.30.10.009" x-source="י" x-translit="ay" srcloc="WLC.JOB.30.10.009" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t016" x-align="JOB.30.10.a008" x-src="WLC.JOB.30.10.008" x-source="פָּנַ֗" x-translit="pān" srcloc="WLC.JOB.30.10.008" x-head="true" lemma="פָּנֶה" strong="H6440">face</char>.<verse eid="JOB 30:10" /></para>
	<para style="q1"><verse number="11" style="v" sid="JOB 30:11" /><char style="w" x-id="t001" x-align="JOB.30.11.a001" x-src="WLC.JOB.30.11.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.JOB.30.11.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="JOB.30.11.a002">he</char> <char style="w" x-id="t003" x-align="JOB.30.11.a002">hath</char> <char style="w" x-id="t004" x-align="JOB.30.11.a002" x-src="WLC.JOB.30.11.004" x-source="פִ֭תַּח" x-translit="p̄ittaḥ" srcloc="WLC.JOB.30.11.004" x-head="true" lemma="פָּתַח" strong="H6605">loosed</char> <note caller="-" style="f"><char style="ft">According to another reading, <char style="it">my cord</char> (or, <char style="it">bowstring</char>).</char></note><char style="w" x-id="t005" x-align="JOB.30.11.a003" x-src="WLC.JOB.30.11.v001.r01.002" x-source="ו" x-translit="w" srcloc="WLC.JOB.30.11.v001.r01.002" x-head="true">his</char> <char style="w" x-id="t006" x-align="JOB.30.11.a004" x-src="WLC.JOB.30.11.v001.r01.001" x-source="יתר" x-translit="yṯr" srcloc="WLC.JOB.30.11.v001.r01.001" x-head="true" lemma="יֶתֶר" strong="H3499b">cord</char>, <char style="w" x-id="t007" x-align="JOB.30.11.a005" x-src="WLC.JOB.30.11.005" x-source="וַ" x-translit="wa" srcloc="WLC.JOB.30.11.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t008" x-align="JOB.30.11.a006" x-src="WLC.JOB.30.11.006" x-source="יְעַנֵּ֑" x-translit="yəʿann" srcloc="WLC.JOB.30.11.006" x-head="true" lemma="עָנָה" strong="H6031">afflicted</char> <char style="w" x-id="t009" x-align="JOB.30.11.a007" x-src="WLC.JOB.30.11.007" x-source="נִי" x-translit="ēniy" srcloc="WLC.JOB.30.11.007" x-head="true" lemma="הוּא" strong="H5204a">me</char>;</para>
