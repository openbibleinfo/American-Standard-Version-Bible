	<para style="m"><verse number="28" style="v" x-unrepresented-source="τὸ τοῦ" x-unrepresented-translit="to tou" x-unrepresented-src="SBLGNT.ACT.28.28.010 SBLGNT.ACT.28.28.012" sid="ACT 28:28" /><char style="w" x-id="t001" x-align="ACT.28.28.a001" x-src="SBLGNT.ACT.28.28.003" x-source="ἔστω" x-translit="estō" srcloc="SBLGNT.ACT.28.28.003" x-head="true" lemma="εἰμί" strong="G2077">Be</char> <char style="w" x-id="t002" x-align="ACT.28.28.a001">it</char> <char style="w" x-id="t003" x-align="ACT.28.28.a002" x-src="SBLGNT.ACT.28.28.001" x-source="γνωστὸν" x-translit="gnōston" srcloc="SBLGNT.ACT.28.28.001" x-head="true" lemma="γνωστός" strong="G1110">known</char> <char style="w" x-id="t004" x-align="ACT.28.28.a003" x-src="SBLGNT.ACT.28.28.002" x-source="οὖν" x-translit="oun" srcloc="SBLGNT.ACT.28.28.002" x-head="true" lemma="οὖν" strong="G3767">therefore</char> <char style="w" x-id="t005" x-align="ACT.28.28.a004">unto</char> <char style="w" x-id="t006" x-align="ACT.28.28.a004" x-src="SBLGNT.ACT.28.28.004" x-source="ὑμῖν" x-translit="hymin" srcloc="SBLGNT.ACT.28.28.004" x-head="true" lemma="σύ" strong="G5213">you</char>, <char style="w" x-id="t007" x-align="ACT.28.28.a005" x-src="SBLGNT.ACT.28.28.005" x-source="ὅτι" x-translit="hoti" srcloc="SBLGNT.ACT.28.28.005" x-head="true" lemma="ὅτι" strong="G3754">that</char> <char style="w" x-id="t008" x-align="ACT.28.28.a006" x-src="SBLGNT.ACT.28.28.009" x-source="τοῦτο" x-translit="touto" srcloc="SBLGNT.ACT.28.28.009" x-head="true" lemma="οὗτος" strong="G5124">this</char> <char style="w" x-id="t009" x-align="ACT.28.28.a008" x-src="SBLGNT.ACT.28.28.011" x-source="σωτήριον" x-translit="sōtērion" srcloc="SBLGNT.ACT.28.28.011" x-head="true" lemma="σωτήριος" strong="G4992">salvation</char> <char style="w" x-id="t010" x-align="ACT.28.28.a010">of</char> <char style="w" x-id="t011" x-align="ACT.28.28.a010" x-src="SBLGNT.ACT.28.28.013" x-source="θεοῦ" x-translit="theou" srcloc="SBLGNT.ACT.28.28.013" x-head="true" lemma="θεός" strong="G2316"