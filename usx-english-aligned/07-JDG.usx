	<para style="q1"><char style="w" x-id="t013" x-align="JDG.5.21.a010">O</char> <char style="w" x-id="t014" x-align="JDG.5.21.a011" x-src="WLC.JDG.5.21.011" x-source="י" x-translit="iy" srcloc="WLC.JDG.5.21.011" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t015" x-align="JDG.5.21.a010" x-src="WLC.JDG.5.21.010" x-source="נַפְשִׁ֖" x-translit="nap̄š" srcloc="WLC.JDG.5.21.010" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">thou hast trodden down strength</char></char></note><char style="w" x-id="t016" x-align="JDG.5.21.a009" x-src="WLC.JDG.5.21.009" x-source="תִּדְרְכִ֥י" x-translit="tiḏrəḵiy" srcloc="WLC.JDG.5.21.009" x-head="true" lemma="דָּרַךְ" strong="H1869">march</char> <char style="w" x-id="t017" x-align="JDG.5.21.a009">on</char> <char style="w" x-id="t018" x-align="JDG.5.21.a012">with</char> <char style="w" x-id="t019" x-align="JDG.5.21.a012" x-src="WLC.JDG.5.21.012" x-source="עֹֽז" x-translit="ʿōz:" srcloc="WLC.JDG.5.21.012" x-head="true" lemma="עֹז" strong="H5797">strength</char>.<verse eid="JDG 5:21" /></para>
