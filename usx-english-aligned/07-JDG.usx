	<para style="q1"><verse number="10" style="v" sid="JDG 5:10" /><char style="w" x-id="t001" x-align="JDG.5.10.a001" x-src="WLC.JDG.5.10.011" x-source="שִֽׂיחוּ" x-translit="śiyḥû:" srcloc="WLC.JDG.5.10.011" x-head="true" lemma="שִׂיחַ" strong="H7878">Tell</char> <char style="add"><char style="w" x-id="t002" x-align="JDG.5.10.a002" x-status="added">of</char> <char style="w" x-id="t003" x-align="JDG.5.10.a002" x-status="added" x-source="∅" x-head="true">it</char></char>, <char style="w" x-id="t004" x-align="JDG.5.10.a003">ye</char> <char style="w" x-id="t005" x-align="JDG.5.10.a003">that</char> <char style="w" x-id="t006" x-align="JDG.5.10.a003" x-src="WLC.JDG.5.10.001" x-source="רֹכְבֵי֩" x-translit="rōḵəḇê" srcloc="WLC.JDG.5.10.001" x-head="true" lemma="רָכַב" strong="H7392">ride</char> <char style="w" x-id="t007" x-align="JDG.5.10.a004">on</char> <char style="w" x-id="t008" x-align="JDG.5.10.a005" x-src="WLC.JDG.5.10.003" x-source="צְחֹר֜וֹת" x-translit="ṣəḥōrôṯ" srcloc="WLC.JDG.5.10.003" x-head="true" lemma="צָחֹר" strong="H6715">white</char> <char style="w" x-id="t009" x-align="JDG.5.10.a004" x-src="WLC.JDG.5.10.002" x-source="אֲתֹנ֨וֹת" x-translit="ʾăṯōnôṯ" srcloc="WLC.JDG.5.10.002" x-head="true" lemma="אָתוֹן" strong="H860">asses</char>,</para>
