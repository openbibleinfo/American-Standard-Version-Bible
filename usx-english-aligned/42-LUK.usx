	<para style="q1"><verse number="18" style="v" sid="LUK 4:18" /><note caller="-" style="f"><char style="ft"><ref loc="ISA 61">Isa. 61:1f</ref>.</char></note><char style="w" x-id="t001" x-align="LUK.4.18.a001">The</char> <char style="w" x-id="t002" x-align="LUK.4.18.a001" x-src="SBLGNT.LUK.4.18.001" x-source="Πνεῦμα" x-translit="Pneuma" srcloc="SBLGNT.LUK.4.18.001" x-head="true" lemma="πνεῦμα" strong="G4151">Spirit</char> <char style="w" x-id="t003" x-align="LUK.4.18.a002">of</char> <char style="w" x-id="t004" x-align="LUK.4.18.a002">the</char> <char style="w" x-id="t005" x-align="LUK.4.18.a002" x-src="SBLGNT.LUK.4.18.002" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.LUK.4.18.002" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t006" x-align="LUK.4.18.a003">is</char> <char style="w" x-id="t007" x-align="LUK.4.18.a003" x-src="SBLGNT.LUK.4.18.003" x-source="ἐπ" x-translit="ep" srcloc="SBLGNT.LUK.4.18.003" x-head="true" lemma="ἐπί" strong="G1909">upon</char> <char style="w" x-id="t008" x-align="LUK.4.18.a004" x-src="SBLGNT.LUK.4.18.004" x-source="ἐμέ" x-translit="eme" srcloc="SBLGNT.LUK.4.18.004" x-head="true" lemma="ἐγώ" strong="G1691">me</char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Wherefore</char></char></note><char style="w" x-id="t009" x-align="LUK.4.18.a005" x-src="SBLGNT.LUK.4.18.005 SBLGNT.LUK.4.18.006" x-source="οὗ εἵνεκεν" x-translit="hou heineken" srcloc="SBLGNT.LUK.4.18.006" x-head="true" lemma="εἵνεκεν" strong="G1752">Because</char> <char style="w" x-id="t010" x-align="LUK.4.18.a006">he</char> <char style="w" x-id="t011" x-align="LUK.4.18.a006" x-src="SBLGNT.LUK.4.18.007" x-source="ἔχρισέν" x-translit="echrisen" srcloc="SBLGNT.LUK.4.18.007" x-head="true" lemma="χρίω" strong="G5548">anointed</char> <char style="w" x-id="t012" x-align="LUK.4.18.a007" x-src="SBLGNT.LUK.4.18.008" x-source="με" x-translit="me" srcloc="SBLGNT.LUK.4.18.008" x-head="true" lemma="ἐγώ" strong="G3165">me</char> <char style="w" x-id="t013" x-align="LUK.4.18.a008">to</char> <char style="w" x-id="t014" x-align="LUK.4.18.a008">preach</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">the gospel</char></char></note><char style="w" x-id="t015" x-align="LUK.4.18.a008">good</char> <char style="w" x-id="t016" x-align="LUK.4.18.a008" x-src="SBLGNT.LUK.4.18.009" x-source="εὐαγγελίσασθαι" x-translit="euangelisasthai" srcloc="SBLGNT.LUK.4.18.009" x-head="true" lemma="εὐαγγελίζω" strong="G2097">tidings</char> <char style="w" x-id="t017" x-align="LUK.4.18.a009">to</char> <char style="w" x-id="t018" x-align="LUK.4.18.a009">the</char> <char style="w" x-id="t019" x-align="LUK.4.18.a009" x-src="SBLGNT.LUK.4.18.010" x-source="πτωχοῖς" x-translit="ptōchois" srcloc="SBLGNT.LUK.4.18.010" x-head="true" lemma="πτωχός" strong="G4434">poor</char>:</para>
	<para style="q1"><char style="w" x-id="t020" x-align="LUK.4.18.a010">He</char> <char style="w" x-id="t021" x-align="LUK.4.18.a010">hath</char> <char style="w" x-id="t022" x-align="LUK.4.18.a010" x-src="SBLGNT.LUK.4.18.011" x-source="ἀπέσταλκέν" x-translit="apestalken" srcloc="SBLGNT.LUK.4.18.011" x-head="true" lemma="ἀποστέλλω" strong="G649">sent</char> <char style="w" x-id="t023" x-align="LUK.4.18.a011" x-src="SBLGNT.LUK.4.18.012" x-source="με" x-translit="me" srcloc="SBLGNT.LUK.4.18.012" x-head="true" lemma="ἐγώ" strong="G3165">me</char> <char style="w" x-id="t024" x-align="LUK.4.18.a012">to</char> <char style="w" x-id="t025" x-align="LUK.4.18.a012" x-src="SBLGNT.LUK.4.18.013" x-source="κηρύξαι" x-translit="kēryxai" srcloc="SBLGNT.LUK.4.18.013" x-head="true" lemma="κηρύσσω" strong="G2784">proclaim</char> <char style="w" x-id="t026" x-align="LUK.4.18.a013" x-src="SBLGNT.LUK.4.18.015" x-source="ἄφεσιν" x-translit="aphesin" srcloc="SBLGNT.LUK.4.18.015" x-head="true" lemma="ἄφεσις" strong="G859">release</char> <char style="w" x-id="t027" x-align="LUK.4.18.a014">to</char> <char style="w" x-id="t028" x-align="LUK.4.18.a014">the</char> <char style="w" x-id="t029" x-align="LUK.4.18.a014" x-src="SBLGNT.LUK.4.18.014" x-source="αἰχμαλώτοις" x-translit="aichmalōtois" srcloc="SBLGNT.LUK.4.18.014" x-head="true" lemma="αἰχμάλωτος" strong="G164">captives</char>,</para>
	<para style="q1"><char style="w" x-id="t030" x-align="LUK.4.18.a015" x-src="SBLGNT.LUK.4.18.016" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.LUK.4.18.016" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t031" x-align="LUK.4.18.a016">recovering</char> <char style="w" x-id="t032" x-align="LUK.4.18.a016">of</char> <char style="w" x-id="t033" x-align="LUK.4.18.a016" x-src="SBLGNT.LUK.4.18.018" x-source="ἀνάβλεψιν" x-translit="anablepsin" srcloc="SBLGNT.LUK.4.18.018" x-head="true" lemma="ἀνάβλεψις" strong="G309">sight</char> <char style="w" x-id="t034" x-align="LUK.4.18.a017">to</char> <char style="w" x-id="t035" x-align="LUK.4.18.a017">the</char> <char style="w" x-id="t036" x-align="LUK.4.18.a017" x-src="SBLGNT.LUK.4.18.017" x-source="τυφλοῖς" x-translit="typhlois" srcloc="SBLGNT.LUK.4.18.017" x-head="true" lemma="τυφλός" strong="G5185">blind</char>,</para>
