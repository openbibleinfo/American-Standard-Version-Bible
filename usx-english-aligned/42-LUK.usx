src="SBLGNT.LUK.11.3.006" x-source="δίδου" x-translit="didou" srcloc="SBLGNT.LUK.11.3.006" x-head="true" lemma="δίδωμι" strong="G1325">Give</char> <char style="w" x-id="t002" x-align="LUK.11.3.a007" x-src="SBLGNT.LUK.11.3.007" x-source="ἡμῖν" x-translit="hēmin" srcloc="SBLGNT.LUK.11.3.007" x-head="true" lemma="ἐγώ" strong="G2254">us</char> <char style="w" x-id="t003" x-align="LUK.11.3.a010" x-src="SBLGNT.LUK.11.3.010" x-source="ἡμέραν" x-translit="hēmeran" srcloc="SBLGNT.LUK.11.3.010" x-head="true" lemma="ἡμέρα" strong="G2250">day</char> <char style="w" x-id="t004" x-align="LUK.11.3.a009" x-src="SBLGNT.LUK.11.3.009" x-source="καθ" x-translit="kath" srcloc="SBLGNT.LUK.11.3.009" x-head="true" lemma="κατά" strong="G2596">by</char> <char style="w" x-id="t005" x-align="LUK.11.3.a010">day</char> <note caller="-" style="f"><char style="ft">Greek <char style="it">our bread for the coming day</char>. Or, <char style="it">our needful bread</char>: as in <ref loc="MAT 6:11">Mt. 6:11</ref>.</char></note><char style="w" x-id="t006" x-align="LUK.11.3.a003" x-src="SBLGNT.LUK.11.3.003" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.LUK.11.3.003" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t007" x-align="LUK.11.3.a005" x-src="SBLGNT.LUK.11.3.005" x-source="ἐπιούσιον" x-translit="epiousion" srcloc="SBLGNT.LUK.11.3.005" x-head="true" lemma="ἐπιούσιος" strong="G1967">daily</char> <char style="w" x-id="t008" x-align="LUK.11.3.a002" x-src="SBLGNT.LUK.11.3.002" x-source="ἄρτον" x-translit="arton" srcloc="SBLGNT.LUK.11.3.002" x-head="true" lemma="ἄρτος" strong="G740">bread</char>. <verse eid="LUK 11:3" /><verse number="4" style="v" x-unrepresented-source="τὰς" x-unrepresented-translit="tas" x-unrepresented-src="SBLGNT.LUK.11.4.004" sid="LUK 11:4" /><char style="w" x-id="t001" x-align="LUK.11.4.a001" x-src="SBLGNT.LUK.11.4.001" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.LUK.11.4.001" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-i