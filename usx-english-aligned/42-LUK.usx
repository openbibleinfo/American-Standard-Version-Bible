.030" x-head="true" lemma="αὐτός" strong="G846">his</char> <char style="w" x-id="t036" x-align="LUK.11.1.a030" x-src="SBLGNT.LUK.11.1.029" x-source="μαθητὰς" x-translit="mathētas" srcloc="SBLGNT.LUK.11.1.029" x-head="true" lemma="μαθητής" strong="G3101">disciples</char>. <verse eid="LUK 11:1" /><verse number="2" style="v" x-unrepresented-source="τὸ ἡ" x-unrepresented-translit="to hē" x-unrepresented-src="SBLGNT.LUK.11.2.009 SBLGNT.LUK.11.2.013" sid="LUK 11:2" /><char style="w" x-id="t001" x-align="LUK.11.2.a002" x-src="SBLGNT.LUK.11.2.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.LUK.11.2.002" x-head="true" lemma="δέ" strong="G1161">And</char> <char style="w" x-id="t002" x-align="LUK.11.2.a001">he</char> <char style="w" x-id="t003" x-align="LUK.11.2.a001" x-src="SBLGNT.LUK.11.2.001" x-source="εἶπεν" x-translit="eipen" srcloc="SBLGNT.LUK.11.2.001" x-head="true" lemma="λέγω" strong="G2036">said</char> <char style="w" x-id="t004" x-align="LUK.11.2.a003">unto</char> <char style="w" x-id="t005" x-align="LUK.11.2.a003" x-src="SBLGNT.LUK.11.2.003" x-source="αὐτοῖς" x-translit="autois" srcloc="SBLGNT.LUK.11.2.003" x-head="true" lemma="αὐτός" strong="G846">them</char>, <char style="w" x-id="t006" x-align="LUK.11.2.a004" x-src="SBLGNT.LUK.11.2.004" x-source="Ὅταν" x-translit="Hotan" srcloc="SBLGNT.LUK.11.2.004" x-head="true" lemma="ὅταν" strong="G3752">When</char> <char style="w" x-id="t007" x-align="LUK.11.2.a005">ye</char> <char style="w" x-id="t008" x-align="LUK.11.2.a005" x-src="SBLGNT.LUK.11.2.005" x-source="προσεύχησθε" x-translit="proseuchēsthe" srcloc="SBLGNT.LUK.11.2.005" x-head="true" lemma="προσεύχομαι" strong="G4336">pray</char>, <char style="w" x-id="t009" x-align="LUK.11.2.a006" x-src="SBLGNT.LUK.11.2.006" x-source="λέγετε" x-translit="legete" srcloc="SBLGNT.LUK.11.2.006" x-head="true" lemma="λέγω" strong="G3004">say</char>, <note caller="-" style="f"><char style="ft">Many ancient authorities read <char style="it">Our Father, who art in heaven</char>. See <r