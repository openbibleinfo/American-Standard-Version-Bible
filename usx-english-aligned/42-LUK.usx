4" x-head="true" lemma="ἀπό" strong="G575">from</char> <char style="w" x-id="t023" x-align="LUK.9.54.a016" x-src="SBLGNT.LUK.9.54.016" x-source="οὐρανοῦ" x-translit="ouranou" srcloc="SBLGNT.LUK.9.54.016" x-head="true" lemma="οὐρανός" strong="G3772">heaven</char>, <char style="w" x-id="t024" x-align="LUK.9.54.a017" x-src="SBLGNT.LUK.9.54.017" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.LUK.9.54.017" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t025" x-align="LUK.9.54.a018" x-src="SBLGNT.LUK.9.54.018" x-source="ἀναλῶσαι" x-translit="analōsai" srcloc="SBLGNT.LUK.9.54.018" x-head="true" lemma="ἀναλίσκω" strong="G355">consume</char> <char style="w" x-id="t026" x-align="LUK.9.54.a019" x-src="SBLGNT.LUK.9.54.019" x-source="αὐτούς" x-translit="autous" srcloc="SBLGNT.LUK.9.54.019" x-head="true" lemma="ἑαυτοῦ" strong="G848">them</char><note caller="-" style="f"><char style="ft">Many ancient authorities add <char style="it">even as Elijah did</char>. Compare <ref loc="2KI 1:10-1:12">2 Kin. 1:10–12</ref>.</char></note>? <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" /><char style="w" x-id="t001" x-align="LUK.9.55.a002" x-src="SBLGNT.LUK.9.55.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.LUK.9.55.002" x-head="true" lemma="δέ" strong="G1161">But</char> <char style="w" x-id="t002" x-align="LUK.9.55.a001">he</char> <char style="w" x-id="t003" x-align="LUK.9.55.a001" x-src="SBLGNT.LUK.9.55.001" x-source="στραφεὶς" x-translit="strapheis" srcloc="SBLGNT.LUK.9.55.001" x-head="true" lemma="στρέφω" strong="G4762">turned</char>, <char style="w" x-id="t004" x-align="LUK.9.55.a003">and</char> <char style="w" x-id="t005" x-align="LUK.9.55.a003" x-src="SBLGNT.LUK.9.55.003" x-source="ἐπετίμησεν" x-translit="epetimēsen" srcloc="SBLGNT.LUK.9.55.003" x-head="true" lemma="ἐπιτιμάω" strong="G2008">rebuked</char> <char style="w" x-id="t006" x-align="LUK.9.55.a004" x-src="SBLGNT.LUK.9.55.004" x-source="αὐτοῖς" x-translit="autois" srcloc="SBLGNT.LUK.9.55.004" x-head="true" lemma="αὐτός" strong="G846">them</char><note caller="-" style="f"><char style="ft">Some ancient authorities add <char style="it">and said, Ye know not what manner of spirit ye are of</char>. Some, but fewer, add also <char style="it">For the Son of man came not to destroy men’s lives but to save</char> them. Compare <ref loc="LUK 19:10">19:10</ref>; <ref loc="JHN 3:17">Jn. 3:17</ref>; <ref loc="JHN 12:47">12:47</ref>.</char></note>. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" /><char style="w" x-id="t001" x-align="LUK.9.56.a001" x-src="SBLGNT.LUK.9.56.001" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.LUK.9.56.001" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t002" x-align="LUK.9.56.a002">they</char> <char style="w" x-id="t003" x-align="LUK.9.56.a002" x-src="SBLGNT.LUK.9.56.002" x-source="ἐπορεύθησαν" x-translit="eporeuthēsan" srcloc="SBLGNT.LUK.9.56.002" x-head="true" lemma="πορεύομαι" strong="G4198">went</char> <char style="w" x-id="t004" x-align="LUK.9.56.a003" x-src="SBLGNT.LUK.9.56.003" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.LUK.9.56.003" x-head="true" lemma="εἰς" strong="G1519">to</char> <char style="w" x-id="t005" x-align="LUK.9.56.a004" x-src="SBLGNT.LUK.9.56.004" x-source="ἑτέραν" x-translit="heteran" srcloc="SBLGNT.LUK.9.56.004" x-head="true" lemma="ἕτερος" strong="G2087">another</char> <char style="w" x-id="t006" x-align="LUK.9.56.a005" x-src="SBLGNT.LUK.9.56.005" x-source="κώμην" x-translit="kōmēn" srcloc="SBLGNT.LUK.9.56.005" x-head="true" lemma="κώμη" strong="G2968">village</char>.<verse eid="LUK 9:56" /></para>
