	<para style="m"><verse number="8" style="v" sid="1PE 2:8" /><char style="w" x-id="t001" x-align="1PE.2.8.a001" x-src="SBLGNT.1PE.2.8.001" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.2.8.001" x-head="true" lemma="καί" strong="G2532">and</char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="ISA 8:14">Isa. 8:14</ref>.</char></note><char style="w" x-id="t002" x-align="1PE.2.8.a002">A</char> <char style="w" x-id="t003" x-align="1PE.2.8.a002" x-src="SBLGNT.1PE.2.8.002" x-source="λίθος" x-translit="lithos" srcloc="SBLGNT.1PE.2.8.002" x-head="true" lemma="λίθος" strong="G3037">stone</char> <char style="w" x-id="t004" x-align="1PE.2.8.a003">of</char> <char style="w" x-id="t005" x-align="1PE.2.8.a003" x-src="SBLGNT.1PE.2.8.003" x-source="προσκόμματος" x-translit="proskommatos" srcloc="SBLGNT.1PE.2.8.003" x-head="true" lemma="πρόσκομμα" strong="G4348">stumbling</char>, <char style="w" x-id="t006" x-align="1PE.2.8.a004" x-src="SBLGNT.1PE.2.8.004" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.2.8.004" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t007" x-align="1PE.2.8.a005">a</char> <char style="w" x-id="t008" x-align="1PE.2.8.a005" x-src="SBLGNT.1PE.2.8.005" x-source="πέτρα" x-translit="petra" srcloc="SBLGNT.1PE.2.8.005" x-head="true" lemma="πέτρα" strong="G4073">rock</char> <char style="w" x-id="t009" x-align="1PE.2.8.a006">of</char> <char style="w" x-id="t010" x-align="1PE.2.8.a006" x-src="SBLGNT.1PE.2.8.006" x-source="σκανδάλου" x-translit="skandalou" srcloc="SBLGNT.1PE.2.8.006" x-head="true" lemma="σκάνδαλον" strong="G4625">offence</char>;</para>
	<para style="m"><note caller="-" style="f"><char style="ft">Greek <char style="it">who</char>.</char></note><char style="w" x-id="t011" x-align="1PE.2.8.a007">for</char> <char style="w" x-id="t012" x-align="1PE.2.8.a007" x-src="SBLGNT.1PE.2.8.007" x-source="οἳ" x-translit="hoi" srcloc="SBLGNT.1PE.2.8.007" x-head="true" lemma="ὅς" strong="G3739">they</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">stumble, being disobedient to the word</char></char></note><char style="w" x-id="t013" x-align="1PE.2.8.a008" x-src="SBLGNT.1PE.2.8.008" x-source="προσκόπτουσιν" x-translit="proskoptousin" srcloc="SBLGNT.1PE.2.8.008" x-head="true" lemma="προσκόπτω" strong="G4350">stumble</char> <char style="w" x-id="t014" x-align="1PE.2.8.a009">at</char> <char style="w" x-id="t015" x-align="1PE.2.8.a009" x-src="SBLGNT.1PE.2.8.009" x-source="τῷ" x-translit="tōi" srcloc="SBLGNT.1PE.2.8.009" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t016" x-align="1PE.2.8.a010" x-src="SBLGNT.1PE.2.8.010" x-source="λόγῳ" x-translit="logōi" srcloc="SBLGNT.1PE.2.8.010" x-head="true" lemma="λόγος" strong="G3056">word</char>, <char style="w" x-id="t017" x-align="1PE.2.8.a011">being</char> <char style="w" x-id="t018" x-align="1PE.2.8.a011" x-src="SBLGNT.1PE.2.8.011" x-source="ἀπειθοῦντες" x-translit="apeithountes" srcloc="SBLGNT.1PE.2.8.011" x-head="true" lemma="ἀπειθέω" strong="G544">disobedient</char>: <char style="w" x-id="t019" x-align="1PE.2.8.a012" x-src="SBLGNT.1PE.2.8.012 SBLGNT.1PE.2.8.013" x-source="εἰς ὃ" x-translit="eis ho" srcloc="SBLGNT.1PE.2.8.013" x-head="true" lemma="ὅς" strong="G3739">whereunto</char> <char style="w" x-id="t020" x-align="1PE.2.8.a013" x-src="SBLGNT.1PE.2.8.014" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.2.8.014" x-head="true" lemma="καί" strong="G2532">also</char> <char style="w" x-id="t021" x-align="1PE.2.8.a014">they</char> <char style="w" x-id="t022" x-align="1PE.2.8.a014">were</char> <char style="w" x-id="t023" x-al