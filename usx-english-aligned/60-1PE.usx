	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="PSA 118:22">Ps. 118:22</ref>.</char></note><char style="w" x-id="t014" x-align="1PE.2.7.a009">The</char> <char style="w" x-id="t015" x-align="1PE.2.7.a009" x-src="SBLGNT.1PE.2.7.009" x-source="λίθος" x-translit="lithos" srcloc="SBLGNT.1PE.2.7.009" x-head="true" lemma="λίθος" strong="G3037">stone</char> <char style="w" x-id="t016" x-align="1PE.2.7.a010" x-src="SBLGNT.1PE.2.7.010" x-source="ὃν" x-translit="hon" srcloc="SBLGNT.1PE.2.7.010" x-head="true" lemma="ὅς" strong="G3739">which</char> <char style="w" x-id="t017" x-align="1PE.2.7.a011" x-src="SBLGNT.1PE.2.7.012" x-source="οἱ" x-translit="hoi" srcloc="SBLGNT.1PE.2.7.012" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t018" x-align="1PE.2.7.a012" x-src="SBLGNT.1PE.2.7.013" x-source="οἰκοδομοῦντες" x-translit="oikodomountes" srcloc="SBLGNT.1PE.2.7.013" x-head="true" lemma="οἰκοδομέω" strong="G3618">builders</char> <char style="w" x-id="t019" x-align="1PE.2.7.a013" x-src="SBLGNT.1PE.2.7.011" x-source="ἀπεδοκίμασαν" x-translit="apedokimasan" srcloc="SBLGNT.1PE.2.7.011" x-head="true" lemma="ἀποδοκιμάζω" strong="G593">rejected</char>,</para>
