	<para style="q1"><char style="w" x-id="t018" x-align="1PE.2.6.a013" x-src="SBLGNT.1PE.2.6.013" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.2.6.013" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t019" x-align="1PE.2.6.a014" x-src="SBLGNT.1PE.2.6.014" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.1PE.2.6.014" x-head="true" lemma="ὁ" strong="G3588">he</char> <char style="w" x-id="t020" x-align="1PE.2.6.a015">that</char> <char style="w" x-id="t021" x-align="1PE.2.6.a015" x-src="SBLGNT.1PE.2.6.015" x-source="πιστεύων" x-translit="pisteuōn" srcloc="SBLGNT.1PE.2.6.015" x-head="true" lemma="πιστεύω" strong="G4100">believeth</char> <char style="w" x-id="t022" x-align="1PE.2.6.a016" x-src="SBLGNT.1PE.2.6.016" x-source="ἐπ" x-translit="ep" srcloc="SBLGNT.1PE.2.6.016" x-head="true" lemma="ἐπί" strong="G1909">on</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">it</char></char></note><char style="w" x-id="t023" x-align="1PE.2.6.a017" x-src="SBLGNT.1PE.2.6.017" x-source="αὐτῷ" x-translit="autōi" srcloc="SBLGNT.1PE.2.6.017" x-head="true" lemma="αὐτός" strong="G846">him</char> <char style="w" x-id="t024" x-align="1PE.2.6.a019">shall</char> <char style="w" x-id="t025" x-align="1PE.2.6.a018" x-status="noncompositional" x-src="SBLGNT.1PE.2.6.018 SBLGNT.1PE.2.6.019" x-source="οὐ μὴ" x-translit="ou mē" srcloc="SBLGNT.1PE.2.6.018" x-head="true" lemma="οὐ" strong="G3756">not</char> <char style="w" x-id="t026" x-align="1PE.2.6.a019">be</char> <char style="w" x-id="t027" x-align="1PE.2.6.a019">put</char> <char style="w" x-id="t028" x-align="1PE.2.6.a019">to</char> <char style="w" x-id="t029" x-align="1PE.2.6.a019" x-src="SBLGNT.1PE.2.6.020" x-source="καταισχυνθῇ" x-translit="kataischynthēi" srcloc="SBLGNT.1PE.2.6.020" x-head="true" lemma="καταισχύνω" strong="G2617">shame</char>.<verse eid="1PE 2:6" /></para>
	<para style="m"><verse number="7" style="v" x-unrepresented-source="τοῖς εἰς" x-unrepresented-translit="tois eis" x-unrepresented-src="SBLGNT.1PE.2.7.005 SBLGNT.1PE.2.7.016" sid="1PE 2:7" /><note caller="-" style="f"><char style="ft">Or, <char style="it">In your sight</char></char></note><char style="w" x-id="t001" x-align="1PE.2.7.a001">For</char> <char style="w" x-id="t002" x-align="1PE.2.7.a001" x-src="SBLGNT.1PE.2.7.001" x-source="ὑμῖν" x-translit="hymin" srcloc="SBLGNT.1PE.2.7.001" x-head="true" lemma="σύ" strong="G5213">you</char> <char style="w" x-id="t003" x-align="1PE.2.7.a002" x-src="SBLGNT.1PE.2.7.002" x-source="οὖν" x-translit="oun" srcloc="SBLGNT.1PE.2.7.002" x-head="true" lemma="οὖν" strong="G3767">therefore</char> <char style="w" x-id="t004" x-align="1PE.2.7.a004">that</char> <char style="w" x-id="t005" x-align="1PE.2.7.a004" x-src="SBLGNT.1PE.2.7.006" x-source="πιστεύουσιν" x-translit="pisteuousin" srcloc="SBLGNT.1PE.2.7.006" x-head="true" lemma="πιστεύω" strong="G4100">believe</char> <char style="w" x-id="t006" x-align="1PE.2.7.a001">is</char> <char style="w" x-id="t007" x-align="1PE.2.7.a005" x-src="SBLGNT.1PE.2.7.003" x-source="ἡ" x-translit="hē" srcloc="SBLGNT.1PE.2.7.003" x-head="true" lemma="ὁ" strong="G3588">the</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">honor</char></char></note><char style="w" x-id="t008" x-align="1PE.2.7.a006" x-src="SBLGNT.1PE.2.7.004" x-source="τιμὴ" x-translit="timē" srcloc="SBLGNT.1PE.2.7.004" x-head="true" lemma="τιμή" strong="G5092">preciousness</char>: <char style="w" x-id="t009" x-align="1PE.2.7.a007" x-src="SBLGNT.1PE.2.7.008" x-source="δὲ" x-translit="de" srcloc="SBLGNT.1PE.2.7.008" x-head="true" lemma="δέ" strong="G1161">but</char> <char style="w" x-id="t010" x-align="1PE.2.7.a008">for</char> <char style="w" x-id="t011" x-align="1PE.2.7.a008">such</char> <char style="w" x-id="t012" x-align="1PE.2.7.a008">as</char> <char style="w" x-id="t013" x-align="1PE.2.7.a008" x-src="SBLGNT.1PE.2