	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="ISA 28:16">Isa. 28:16</ref>.</char></note><char style="w" x-id="t007" x-align="1PE.2.6.a005" x-src="SBLGNT.1PE.2.6.005" x-source="Ἰδοὺ" x-translit="Idou" srcloc="SBLGNT.1PE.2.6.005" x-head="true" lemma="ἰδού" strong="G2400">Behold</char>, <char style="w" x-id="t008" x-align="1PE.2.6.a006">I</char> <char style="w" x-id="t009" x-align="1PE.2.6.a006" x-src="SBLGNT.1PE.2.6.006" x-source="τίθημι" x-translit="tithēmi" srcloc="SBLGNT.1PE.2.6.006" x-head="true" lemma="τίθημι" strong="G5087">lay</char> <char style="w" x-id="t010" x-align="1PE.2.6.a007" x-src="SBLGNT.1PE.2.6.007" x-source="ἐν" x-translit="en" srcloc="SBLGNT.1PE.2.6.007" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t011" x-align="1PE.2.6.a008" x-src="SBLGNT.1PE.2.6.008" x-source="Σιὼν" x-translit="Siōn" srcloc="SBLGNT.1PE.2.6.008" x-head="true" lemma="Σιών" strong="G4622">Zion</char> <char style="w" x-id="t012" x-align="1PE.2.6.a009">a</char> <char style="w" x-id="t013" x-align="1PE.2.6.a010">chief</char> <char style="w" x-id="t014" x-align="1PE.2.6.a010" x-src="SBLGNT.1PE.2.6.010" x-source="ἀκρογωνιαῖον" x-translit="akrogōniaion" srcloc="SBLGNT.1PE.2.6.010" x-head="true" lemma="ἀκρογωνιαῖος" strong="G204">corner</char> <char style="w" x-id="t015" x-align="1PE.2.6.a009" x-src="SBLGNT.1PE.2.6.009" x-source="λίθον" x-translit="lithon" srcloc="SBLGNT.1PE.2.6.009" x-head="true" lemma="λίθος" strong="G3037">stone</char>, <char style="w" x-id="t016" x-align="1PE.2.6.a011" x-src="SBLGNT.1PE.2.6.011" x-source="ἐκλεκτὸν" x-translit="eklekton" srcloc="SBLGNT.1PE.2.6.011" x-head="true" lemma="ἐκλεκτός" strong="G1588">elect</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">honorable</char></char></note><char style="w" x-id="t017" x-align="1PE.2.6.a012" x-src="SBLGNT.1PE.2.6.012" x-source="ἔντιμον" x-translit="entimon" srcloc="SBLGNT.1PE.2.6.012" x-head="true" lemma="ἔντιμος" strong="G1784">precious</ch