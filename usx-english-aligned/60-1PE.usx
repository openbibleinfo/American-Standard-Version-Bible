	<para style="p"><verse number="1" style="v" sid="1PE 2:1" /><char style="w" x-id="t001" x-align="1PE.2.1.a001" x-src="SBLGNT.1PE.2.1.001" x-source="Ἀποθέμενοι" x-translit="Apothemenoi" srcloc="SBLGNT.1PE.2.1.001" x-head="true" lemma="ἀποτίθημι" strong="G659">Putting</char> <char style="w" x-id="t002" x-align="1PE.2.1.a001">away</char> <char style="w" x-id="t003" x-align="1PE.2.1.a002" x-src="SBLGNT.1PE.2.1.002" x-source="οὖν" x-translit="oun" srcloc="SBLGNT.1PE.2.1.002" x-head="true" lemma="οὖν" strong="G3767">therefore</char> <char style="w" x-id="t004" x-align="1PE.2.1.a003" x-src="SBLGNT.1PE.2.1.003" x-source="πᾶσαν" x-translit="pasan" srcloc="SBLGNT.1PE.2.1.003" x-head="true" lemma="πᾶς" strong="G3956">all</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">malice</char>. <ref loc="1CO 14:20">1 Cor. 14:20</ref></char></note><char style="w" x-id="t005" x-align="1PE.2.1.a004" x-src="SBLGNT.1PE.2.1.004" x-source="κακίαν" x-translit="kakian" srcloc="SBLGNT.1PE.2.1.004" x-head="true" lemma="κακία" strong="G2549">wickedness</char>, <char style="w" x-id="t006" x-align="1PE.2.1.a005" x-src="SBLGNT.1PE.2.1.005" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.2.1.005" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t007" x-align="1PE.2.1.a006" x-src="SBLGNT.1PE.2.1.006" x-source="πάντα" x-translit="panta" srcloc="SBLGNT.1PE.2.1.006" x-head="true" lemma="πᾶς" strong="G3956">all</char> <char style="w" x-id="t008" x-align="1PE.2.1.a007" x-src="SBLGNT.1PE.2.1.007" x-source="δόλον" x-translit="dolon" srcloc="SBLGNT.1PE.2.1.007" x-head="true" lemma="δόλος" strong="G1388">guile</char>, <char style="w" x-id="t009" x-align="1PE.2.1.a008" x-src="SBLGNT.1PE.2.1.008" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.2.1.008" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t010" x-align="1PE.2.1.a009" x-src="SBLGNT.1PE.2.1.009" x-source="ὑποκρίσεις" x-translit="hypokriseis" srcloc="SBLGNT.1PE.2.1.009" x-head=