	<para style="p"><verse number="1" style="v" sid="1PE 1:1" /><char style="w" x-id="t001" x-align="1PE.1.1.a001" x-src="SBLGNT.1PE.1.1.001" x-source="Πέτρος" x-translit="Petros" srcloc="SBLGNT.1PE.1.1.001" x-head="true" lemma="Πέτρος" strong="G4074">Peter</char>, <char style="w" x-id="t002" x-align="1PE.1.1.a002">an</char> <char style="w" x-id="t003" x-align="1PE.1.1.a002" x-src="SBLGNT.1PE.1.1.002" x-source="ἀπόστολος" x-translit="apostolos" srcloc="SBLGNT.1PE.1.1.002" x-head="true" lemma="ἀπόστολος" strong="G652">apostle</char> <char style="w" x-id="t004" x-align="1PE.1.1.a003">of</char> <char style="w" x-id="t005" x-align="1PE.1.1.a003" x-src="SBLGNT.1PE.1.1.003" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.1PE.1.1.003" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t006" x-align="1PE.1.1.a004" x-src="SBLGNT.1PE.1.1.004" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.1PE.1.1.004" x-head="true" lemma="Χριστός" strong="G5547">Christ</char>, <char style="w" x-id="t007" x-align="1PE.1.1.a005">to</char> <char style="w" x-id="t008" x-align="1PE.1.1.a005">the</char> <char style="w" x-id="t009" x-align="1PE.1.1.a005" x-src="SBLGNT.1PE.1.1.005" x-source="ἐκλεκτοῖς" x-translit="eklektois" srcloc="SBLGNT.1PE.1.1.005" x-head="true" lemma="ἐκλεκτός" strong="G1588">elect</char> <char style="w" x-id="t010" x-align="1PE.1.1.a006">who</char> <char style="w" x-id="t011" x-align="1PE.1.1.a006">are</char> <char style="w" x-id="t012" x-align="1PE.1.1.a006" x-src="SBLGNT.1PE.1.1.006" x-source="παρεπιδήμοις" x-translit="parepidēmois" srcloc="SBLGNT.1PE.1.1.006" x-head="true" lemma="παρεπίδημος" strong="G3927">sojourners</char> <char style="w" x-id="t013" x-align="1PE.1.1.a007">of</char> <char style="w" x-id="t014" x-align="1PE.1.1.a007">the</char> <char style="w" x-id="t015" x-align="1PE.1.1.a007" x-src="SBLGNT.1PE.1.1.007" x-source="διασπορᾶς" x-translit="diasporas" srcloc="SBLGNT.1PE.1.1.007" x-head="true" lemma="διασπορά" strong="G1290">