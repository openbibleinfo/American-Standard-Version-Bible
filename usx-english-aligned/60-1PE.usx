	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="ISA 40:6-40:31">Isa. 40:6ff</ref>.</char></note><char style="w" x-id="t002" x-align="1PE.1.24.a002" x-src="SBLGNT.1PE.1.24.002" x-source="πᾶσα" x-translit="pasa" srcloc="SBLGNT.1PE.1.24.002" x-head="true" lemma="πᾶς" strong="G3956">All</char> <char style="w" x-id="t003" x-align="1PE.1.24.a003" x-src="SBLGNT.1PE.1.24.003" x-source="σὰρξ" x-translit="sarx" srcloc="SBLGNT.1PE.1.24.003" x-head="true" lemma="σάρξ" strong="G4561">flesh</char> <char style="w" x-id="t004" x-align="1PE.1.24.a004">is</char> <char style="w" x-id="t005" x-align="1PE.1.24.a004" x-src="SBLGNT.1PE.1.24.004" x-source="ὡς" x-translit="hōs" srcloc="SBLGNT.1PE.1.24.004" x-head="true" lemma="ὡς" strong="G5613">as</char> <char style="w" x-id="t006" x-align="1PE.1.24.a005" x-src="SBLGNT.1PE.1.24.005" x-source="χόρτος" x-translit="chortos" srcloc="SBLGNT.1PE.1.24.005" x-head="true" lemma="χόρτος" strong="G5528">grass</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="1PE.1.24.a006" x-src="SBLGNT.1PE.1.24.006" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.1.24.006" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t008" x-align="1PE.1.24.a007" x-src="SBLGNT.1PE.1.24.007" x-source="πᾶσα" x-translit="pasa" srcloc="SBLGNT.1PE.1.24.007" x-head="true" lemma="πᾶς" strong="G3956">all</char> <char style="w" x-id="t009" x-align="1PE.1.24.a008">the</char> <char style="w" x-id="t010" x-align="1PE.1.24.a008" x-src="SBLGNT.1PE.1.24.008" x-source="δόξα" x-translit="doxa" srcloc="SBLGNT.1PE.1.24.008" x-head="true" lemma="δόξα" strong="G1391">glory</char> <char style="w" x-id="t011" x-align="1PE.1.24.a009" x-src="SBLGNT.1PE.1.24.009" x-source="αὐτῆς" x-translit="autēs" srcloc="SBLGNT.1PE.1.24.009" x-head="true" lemma="αὐτός" strong="G846">thereof</char> <char style="w" x-id="t012" x-align="1PE.1.24.a010" x-src="SBLGNT.1PE.1.24.010" x-source="ὡς" x-translit="hōs" srcloc="SBLGNT.1PE.1.24.010" x-head="true" lemma="ὡς" strong="G5613">as</char> <char style="w" x-id="t013" x-align="1PE.1.24.a011">the</char> <char style="w" x-id="t014" x-align="1PE.1.24.a011" x-src="SBLGNT.1PE.1.24.011" x-source="ἄνθος" x-translit="anthos" srcloc="SBLGNT.1PE.1.24.011" x-head="true" lemma="ἄνθος" strong="G438">flower</char> <char style="w" x-id="t015" x-align="1PE.1.24.a012">of</char> <char style="w" x-id="t016" x-align="1PE.1.24.a012" x-src="SBLGNT.1PE.1.24.012" x-source="χόρτου" x-translit="chortou" srcloc="SBLGNT.1PE.1.24.012" x-head="true" lemma="χόρτος" strong="G5528">grass</char>.</para>
	<para style="q1"><char style="w" x-id="t017" x-align="1PE.1.24.a014" x-src="SBLGNT.1PE.1.24.014" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.1PE.1.24.014" x-head="true" lemma="ὁ" strong="G3588">The</char> <char style="w" x-id="t018" x-align="1PE.1.24.a015" x-src="SBLGNT.1PE.1.24.015" x-source="χόρτος" x-translit="chortos" srcloc="SBLGNT.1PE.1.24.015" x-head="true" lemma="χόρτος" strong="G5528">grass</char> <char style="w" x-id="t019" x-align="1PE.1.24.a013" x-src="SBLGNT.1PE.1.24.013" x-source="ἐξηράνθη" x-translit="exēranthē" srcloc="SBLGNT.1PE.1.24.013" x-head="true" lemma="ξηραίνω" strong="G3583">withereth</char>, <char style="w" x-id="t020" x-align="1PE.1.24.a016" x-src="SBLGNT.1PE.1.24.016" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.1.24.016" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t021" x-align="1PE.1.24.a017" x-src="SBLGNT.1PE.1.24.017" x-source="τὸ" x-translit="to" srcloc="SBLGNT.1PE.1.24.017" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t022" x-align="1PE.1.24.a018" x-src="SBLGNT.1PE.1.24.018" x-source="ἄνθος" x-translit="anthos" srcloc="SBLGNT.1PE.1.24.018" x-head="true" lemma="ἄνθος" strong="G438">flower</char> <char style="w" x-id="t023" x-align="1PE.1.24.a019" x-src="SBLGNT.1PE.1.24.019" x-source="ἐξέπεσεν" x-translit="exepesen" srcloc="SBLGNT.1PE.1.24.019" x-head="true" lemma="ἐκπίπτω" strong="G1601">falleth</char>:<verse eid="1PE 1:24" /></para>
	<para style="q1"><verse number="25" style="v" x-unrepresented-source="τὸν τὸ" x-unrepresented-translit="ton to" x-unrepresented-src="SBLGNT.1PE.1.25.007 SBLGNT.1PE.1.25.014" sid="1PE 1:25" /><char style="w" x-id="t001" x-align="1PE.1.25.a001" x-src="SBLGNT.1PE.1.25.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.1PE.1.25.002" x-head="true" lemma="δέ" strong="G1161">But</char> <char style="w" x-id="t002" x-align="1PE.1.25.a002" x-src="SBLGNT.1PE.1.25.001" x-source="τὸ" x-translit="to" srcloc="SBLGNT.1PE.1.25.001" x-head="true" lemma="ὁ" strong="G3588">the</char> <note caller="-" style="f"><char style="ft">Greek <char style="it">saying</char>.</char></note><char style="w" x-id="t003" x-align="1PE.1.25.a003" x-src="SBLGNT.1PE.1.25.003" x-source="ῥῆμα" x-translit="rhēma" srcloc="SBLGNT.1PE.1.25.003" x-head="true" lemma="ῥῆμα" strong="G4487">word</char> <char style="w" x-id="t004" x-align="1PE.1.25.a004">of</char> <char style="w" x-id="t005" x-align="1PE.1.25.a004">the</char> <char style="w" x-id="t006" x-align="1PE.1.25.a004" x-src="SBLGNT.1PE.1.25.004" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.1PE.1.25.004" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t007" x-align="1PE.1.25.a005" x-src="SBLGNT.1PE.1.25.005" x-source="μένει" x-translit="menei" srcloc="SBLGNT.1PE.1.25.005" x-head="true" lemma="μένω" strong="G3306">abideth</char> <char style="w" x-id="t008" x-align="1PE.1.25.a006" x-src="SBLGNT.1PE.1.25.006" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.1PE.1.25.006" x-head="true" lemma="εἰς" strong="G1519">for</char> <char style="w" x-id="t009" x-align="1PE.1.25.a008" x-src="SBLGNT.1PE.1.25.008" x-source="αἰῶνα" x-translit="aiōna" srcloc="SBLGNT.1PE.1.25.008" x-head="true" lemma="αἰών" strong="G165">ever</char>.</para>
	<para style="m"><char style="w" x-id="t010" x-align="1PE.1.25.a009" x-src="SBLGNT.1PE.1.25.010" x-source="δέ" x-translit="de" srcloc="SBLGNT.1PE.1.25.010" x-head="true" lemma="δέ" strong="G1161">And</char> <char style="w" x-id="t011" x-align="1PE.1.25.a010" x-src="SBLGNT.1PE.1.25.009" x-source="τοῦτο" x-translit="touto" srcloc="SBLGNT.1PE.1.25.009" x-head="true" lemma="οὗτος" strong="G5124">this</char> <char style="w" x-id="t012" x-align="1PE.1.25.a011" x-src="SBLGNT.1PE.1.25.011" x-source="ἐστιν" x-translit="estin" srcloc="SBLGNT.1PE.1.25.011" x-head="true" lemma="εἰμί" strong="G2076">is</char> <char style="w" x-id="t013" x-align="1PE.1.25.a012" x-src="SBLGNT.1PE.1.25.012" x-source="τὸ" x-translit="to" srcloc="SBLGNT.1PE.1.25.012" x-head="true" lemma="ὁ" strong="G3588">the</char> <note caller="-" style="f"><char style="ft">Greek <char style="it">saying</char>.</char></note><char style="w" x-id="t014" x-align="1PE.1.25.a013" x-src="SBLGNT.1PE.1.25.013" x-source="ῥῆμα" x-translit="rhēma" srcloc="SBLGNT.1PE.1.25.013" x-head="true" lemma="ῥῆμα" strong="G4487">word</char> <char style="w" x-id="t015" x-align="1PE.1.25.a015">of</char> <char style="w" x-id="t016" x-align="1PE.1.25.a015">good</char> <char style="w" x-id="t017" x-align="1PE.1.25.a015">tidings</char> <char style="w" x-id="t018" x-align="1PE.1.25.a015">which</char> <char style="w" x-id="t019" x-align="1PE.1.25.a015">was</char> <note caller="-" style="f"><char style="ft">See <ref loc="1PE 1:12">verse 12</ref>.</char></note><char style="w" x-id="t020" x-align="1PE.1.25.a015" x-src="SBLGNT.1PE.1.25.015" x-source="εὐαγγελισθὲν" x-translit="euangelisthen" srcloc="SBLGNT.1PE.1.25.015" x-head="true" lemma="εὐαγγελίζω" strong="G2097">preached</char> <char style="w" x-id="t021" x-align="1PE.1.25.a016" x-src="SBLGNT.1PE.1.25.016" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.1PE.1.25.016" x-head="true" lemma="εἰς" strong="G1519">unto</char> <char style="w" x-id="t022" x-align="1PE.1.25.a017" x-src="SBLGNT.1PE.1.25.017