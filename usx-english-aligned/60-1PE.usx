	<para style="p"><verse number="1" style="v" sid="1PE 4:1" /><char style="w" x-id="t001" x-align="1PE.4.1.a001">Forasmuch</char> <char style="w" x-id="t002" x-align="1PE.4.1.a002" x-src="SBLGNT.1PE.4.1.002" x-source="οὖν" x-translit="oun" srcloc="SBLGNT.1PE.4.1.002" x-head="true" lemma="οὖν" strong="G3767">then</char> <char style="w" x-id="t003" x-align="1PE.4.1.a001">as</char> <char style="w" x-id="t004" x-align="1PE.4.1.a003" x-src="SBLGNT.1PE.4.1.001" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.1PE.4.1.001" x-head="true" lemma="Χριστός" strong="G5547">Christ</char> <char style="w" x-id="t005" x-align="1PE.4.1.a001" x-src="SBLGNT.1PE.4.1.003" x-source="παθόντος" x-translit="pathontos" srcloc="SBLGNT.1PE.4.1.003" x-head="true" lemma="πάσχω" strong="G3958">suffered</char> <char style="w" x-id="t006" x-align="1PE.4.1.a004">in</char> <char style="w" x-id="t007" x-align="1PE.4.1.a004">the</char> <char style="w" x-id="t008" x-align="1PE.4.1.a004" x-src="SBLGNT.1PE.4.1.004" x-source="σαρκὶ" x-translit="sarki" srcloc="SBLGNT.1PE.4.1.004" x-head="true" lemma="σάρξ" strong="G4561">flesh</char>, <char style="w" x-id="t009" x-align="1PE.4.1.a005" x-src="SBLGNT.1PE.4.1.010" x-source="ὁπλίσασθε" x-translit="hoplisasthe" srcloc="SBLGNT.1PE.4.1.010" x-head="true" lemma="ὁπλίζομαι" strong="G3695">arm</char> <char style="w" x-id="t010" x-align="1PE.4.1.a006" x-src="SBLGNT.1PE.4.1.006" x-source="ὑμεῖς" x-translit="hymeis" srcloc="SBLGNT.1PE.4.1.006" x-head="true" lemma="σύ" strong="G5210">ye</char> <char style="w" x-id="t011" x-align="1PE.4.1.a005">yourselves</char> <char style="w" x-id="t012" x-align="1PE.4.1.a007" x-src="SBLGNT.1PE.4.1.005" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1PE.4.1.005" x-head="true" lemma="καί" strong="G2532">also</char> <char style="w" x-id="t013" x-align="1PE.4.1.a008">with</char> <char style="w" x-id="t014" x-align="1PE.4.1.a008" x-src="SBLGNT.1PE.4.1.007" x-source="τὴν" x-translit="tēn" srcloc="SBLGNT.1PE.4.1.007" x-head="true" lemma=