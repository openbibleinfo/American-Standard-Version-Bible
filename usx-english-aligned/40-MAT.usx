17.20.n01.a007" x-status="noncompositional" x-src="MAT.17.20.n01.s007 MAT.17.20.n01.s008" x-source="εἰ μὴ" x-translit="ei mē" srcloc="MAT.17.20.n01.s007" x-head="true">save</char> <char style="w" x-id="MAT.17.20.n01.t008" x-align="MAT.17.20.n01.a008" x-src="MAT.17.20.n01.s009" x-source="ἐν" x-translit="en" srcloc="MAT.17.20.n01.s009" x-head="true">by</char> <char style="w" x-id="MAT.17.20.n01.t009" x-align="MAT.17.20.n01.a009" x-src="MAT.17.20.n01.s010" x-source="προσευχῇ" x-translit="proseuchēi" srcloc="MAT.17.20.n01.s010" x-head="true">prayer</char> <char style="w" x-id="MAT.17.20.n01.t010" x-align="MAT.17.20.n01.a010" x-src="MAT.17.20.n01.s011" x-source="καὶ" x-translit="kai" srcloc="MAT.17.20.n01.s011" x-head="true">and</char> <char style="w" x-id="MAT.17.20.n01.t011" x-align="MAT.17.20.n01.a011" x-src="MAT.17.20.n01.s012" x-source="νηστείᾳ" x-translit="nēsteiai" srcloc="MAT.17.20.n01.s012" x-head="true">fasting</char>.</char> See <ref loc="MRK 9:29">Mk. 9:29</ref>.</char></note><verse eid="MAT 17:20" /></para>
	<para style="p"><verse number="22" style="v" x-unrepresented-source="τῇ ὁ τοῦ" x-unrepresented-translit="tēi ho tou" x-unrepresented-src="SBLGNT.MAT.17.22.005 SBLGNT.MAT.17.22.009 SBLGNT.MAT.17.22.014" sid="MAT 17:22" /><char style="w" x-id="t001" x-align="MAT.17.22.a002" x-src="SBLGNT.MAT.17.22.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.MAT.17.22.002" x-head="true" lemma="δέ" strong="G1161">And</char> <char style="w" x-id="t002" x-align="MAT.17.22.a001">while</char> <char style="w" x-id="t003" x-align="MAT.17.22.a003" x-src="SBLGNT.MAT.17.22.003" x-source="αὐτῶν" x-translit="autōn" srcloc="SBLGNT.MAT.17.22.003" x-head="true" lemma="αὐτός" strong="G846">they</char> <note caller="-" style="f"><char style="ft">Some ancient authorities read <char style="it">were gathering themselves together</char>.</char></note><char style="w" x-id="t004" x-align="MAT.17.22.a001" x-src="SBLGNT.MAT.17.22.v021.r01.001" x-source="Ἀναστρεφομένων" x-translit="Anastrephomenōn" srcloc="SBLGNT.MAT.17.22.v021.r01.001" x-head="true">abode</char> <char style="w" x-id="t005" x-align="MAT.17.22.a004" x-src="SBLGNT.MAT.17.22.004" x-source="ἐν" x-translit="en" srcloc="SBLGNT.MAT.17.22.004" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t006" x-align="MAT.17.22.a006" x-src="SBLGNT.MAT.17.22.006" x-source="Γαλιλαίᾳ" x-translit="Galilaiai" srcloc="SBLGNT.MAT.17.22.006" x-head="true" lemma="Γαλιλαία" strong="G1056">Galilee</char>, <char style="w" x-id="t007" x-align="MAT.17.22.a010" x-src="SBLGNT.MAT.17.22.010" x-source="Ἰησοῦς" x-translit="Iēsous" srcloc="SBLGNT.MAT.17.22.010" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t008" x-align="MAT.17.22.a007" x-src="SBLGNT.MAT.17.22.007" x-source="εἶπεν" x-translit="eipen" srcloc="SBLGNT.MAT.17.22.007" x-head="true" lemma="λέγω" strong="G2036">said</char> <char style="w" x-id="t009" x-align="MAT.17.22.a008">unto</char> <char style="w" x-id="t010" x-align="MAT.17.22.a008" x-src="SBLGNT.MAT.17.22