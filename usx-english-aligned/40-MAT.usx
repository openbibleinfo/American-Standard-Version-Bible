	<para style="p"><verse number="18" style="v" x-unrepresented-source="Τοῦ τῆς τῷ ἢ ἔχουσα" x-unrepresented-translit="Tou tēs tōi ē echousa" x-unrepresented-src="SBLGNT.MAT.1.18.001 SBLGNT.MAT.1.18.010 SBLGNT.MAT.1.18.014 SBLGNT.MAT.1.18.017 SBLGNT.MAT.1.18.023" sid="MAT 1:18" /><char style="w" x-id="t001" x-align="MAT.1.18.a002" x-src="SBLGNT.MAT.1.18.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.MAT.1.18.002" x-head="true" lemma="δέ" strong="G1161">Now</char> <char style="w" x-id="t002" x-align="MAT.1.18.a005" x-src="SBLGNT.MAT.1.18.005" x-source="ἡ" x-translit="hē" srcloc="SBLGNT.MAT.1.18.005" x-head="true" lemma="ὁ" strong="G3588">the</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">generation</char>: as in <ref loc="MAT 1:1">verse 1</ref>.</char></note><char style="w" x-id="t003" x-align="MAT.1.18.a006" x-src="SBLGNT.MAT.1.18.006" x-source="γένεσις" x-translit="genesis" srcloc="SBLGNT.MAT.1.18.006" x-head="true" lemma="γένεσις" strong="G1078">birth</char> <note caller="-" style="f"><char style="ft">Some ancient authorities read <char style="it">of the Christ</char>.</char></note><char style="w" x-id="t004" x-align="MAT.1.18.a003">of</char> <char style="w" x-id="t005" x-align="MAT.1.18.a003" x-src="SBLGNT.MAT.1.18.003" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.MAT.1.18.003" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t006" x-align="MAT.1.18.a004" x-src="SBLGNT.MAT.1.18.004" x-source="χριστοῦ" x-translit="christou" srcloc="SBLGNT.MAT.1.18.004" x-head="true" lemma="Χριστός" strong="G5547">Christ</char> <char style="w" x-id="t007" x-align="MAT.1.18.a008" x-src="SBLGNT.MAT.1.18.008" x-source="ἦν" x-translit="ēn" srcloc="SBLGNT.MAT.1.18.008" x-head="true" lemma="εἰμί" strong="G2258">was</char> <char style="w" x-id="t008" x-align="MAT.1.18.a007">on</char> <char style="w" x-id="t009" x-align="MAT.1.18.a007">this</char> <char style="w" x-id="t010" x-align="MAT.1.18.a007" x-src="SBLGNT.MAT.1.18.007" x-