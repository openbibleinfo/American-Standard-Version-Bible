	<para style="m"><verse number="7" style="v" sid="MAT 2:7" /><char style="w" x-id="t001" x-align="MAT.2.7.a001" x-src="SBLGNT.MAT.2.7.001" x-source="Τότε" x-translit="Tote" srcloc="SBLGNT.MAT.2.7.001" x-head="true" lemma="τότε" strong="G5119">Then</char> <char style="w" x-id="t002" x-align="MAT.2.7.a002" x-src="SBLGNT.MAT.2.7.002" x-source="Ἡρῴδης" x-translit="Hērōidēs" srcloc="SBLGNT.MAT.2.7.002" x-head="true" lemma="Ἡρῴδης" strong="G2264">Herod</char> <char style="w" x-id="t003" x-align="MAT.2.7.a003" x-src="SBLGNT.MAT.2.7.003" x-source="λάθρᾳ" x-translit="lathrai" srcloc="SBLGNT.MAT.2.7.003" x-head="true" lemma="λάθρᾳ" strong="G2977">privily</char> <char style="w" x-id="t004" x-align="MAT.2.7.a004" x-src="SBLGNT.MAT.2.7.004" x-source="καλέσας" x-translit="kalesas" srcloc="SBLGNT.MAT.2.7.004" x-head="true" lemma="καλέω" strong="G2564">called</char> <char style="w" x-id="t005" x-align="MAT.2.7.a005" x-src="SBLGNT.MAT.2.7.005" x-source="τοὺς" x-translit="tous" srcloc="SBLGNT.MAT.2.7.005" x-head="true" lemma="ὁ" strong="G3588">the</char> <note caller="-" style="f"><char style="ft">Greek <char style="it">Magi</char>. Compare <ref loc="EST 1:13">Esth. 1:13</ref>; <ref loc="DAN 2:12">Dan. 2:12</ref>; <ref loc="ACT 13:6">Acts 13:6</ref>, <ref loc="ACT 13:8">8</ref>.</char></note><char style="w" x-id="t006" x-align="MAT.2.7.a006" x-src="SBLGNT.MAT.2.7.006" x-source="μάγους" x-translit="magous" srcloc="SBLGNT.MAT.2.7.006" x-head="true" lemma="μάγος" strong="G3097">Wise</char>-<char style="w" x-id="t007" x-align="MAT.2.7.a006">men</char>, <char style="w" x-id="t008" x-align="MAT.2.7.a007">and</char> <char style="w" x-id="t009" x-align="MAT.2.7.a007" x-src="SBLGNT.MAT.2.7.007" x-source="ἠκρίβωσεν" x-translit="ēkribōsen" srcloc="SBLGNT.MAT.2.7.007" x-head="true" lemma="ἀκριβόω" strong="G198">learned</char> <char style="w" x-id="t010" x-align="MAT.2.7.a008" x-src="SBLGNT.MAT.2.7.008" x-source="παρ" x-translit="par" srcloc="SBLGNT.MAT.2.7.008" x-head="true" lemma="παρά" strong="G3844">of</char> <char style="w" x-id="t011" x-align="MAT.2.7.a009" x-src="SBLGNT.MAT.2.7.009" x-source="αὐτῶν" x-translit="autōn" srcloc="SBLGNT.MAT.2.7.009" x-head="true" lemma="αὐτός" strong="G846">them</char> <char style="w" x-id="t012" x-align="MAT.2.7.a007">exactly</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">the time of the star that appeared</char></char></note><char style="w" x-id="t013" x-align="MAT.2.7.a010" x-src="SBLGNT.MAT.2.7.010" x-source="τὸν" x-translit="ton" srcloc="SBLGNT.MAT.2.7.010" x-head="true" lemma="ὁ" strong="G3588">what</char> <char style="w" x-id="t014" x-align="MAT.2.7.a011" x-src="SBLGNT.MAT.2.7.011" x-source="χρόνον" x-translit="chronon" srcloc="SBLGNT.MAT.2.7.011" x-head="true" lemma="χρόνος" strong="G5550">time</char> <char style="w" x-id="t015" x-align="MAT.2.7.a012" x-src="SBLGNT.MAT.2.7.012" x-source="τοῦ" x-translit="tou" srcloc="SBLGNT.MAT.2.7.012" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t016" x-align="MAT.2.7.a014" x-src="SBLGNT.MAT.2.7.014" x-source="ἀστέρος" x-translit="asteros" srcloc="SBLGNT.MAT.2.7.014" x-head="true" lemma="ἀστήρ" strong="G792">star</char> <char style="w" x-id="t017" x-align="MAT.2.7.a013" x-src="SBLGNT.MAT.2.7.013" x-source="φαινομένου" x-translit="phainomenou" srcloc="SBLGNT.MAT.2.7.013" x-head="true" lemma="φαίνω" strong="G5316">appeared</char>. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" /><char style="w" x-id="t001" x-align="MAT.2.8.a001" x-src="SBLGNT.MAT.2.8.001" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.MAT.2.8.001" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t002" x-align="MAT.2.8.a002">he</char> <char style="w" x-id="t003" x-align="MAT.2.8.a002" x-src="SBLGNT.MAT.2.8.002" x-source="πέμψας" x-translit="pempsas" srcloc="SBLGNT.MAT.2.8.002" x-head="true" lemma="πέμπω" strong="G3992">sent</char> <char style="w" x-id="t004" x-align="MAT.2.8.a003" x-src="SBLGNT.MAT.2.8.003" x-source="αὐτ