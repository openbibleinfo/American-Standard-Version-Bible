	<para style="q1"><verse number="21" style="v" x-unrepresented-source="τῷ" x-unrepresented-translit="tōi" x-unrepresented-src="SBLGNT.MAT.12.21.002" sid="MAT 12:21" /><char style="w" x-id="t001" x-align="MAT.12.21.a001" x-src="SBLGNT.MAT.12.21.001" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.MAT.12.21.001" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t002" x-align="MAT.12.21.a003">in</char> <char style="w" x-id="t003" x-align="MAT.12.21.a004" x-src="SBLGNT.MAT.12.21.004" x-source="αὐτοῦ" x-translit="autou" srcloc="SBLGNT.MAT.12.21.004" x-head="true" lemma="αὐτός" strong="G846">his</char> <char style="w" x-id="t004" x-align="MAT.12.21.a003" x-src="SBLGNT.MAT.12.21.003" x-source="ὀνόματι" x-translit="onomati" srcloc="SBLGNT.MAT.12.21.003" x-head="true" lemma="ὄνομα" strong="G3686">name</char> <char style="w" x-id="t005" x-align="MAT.12.21.a006">shall</char> <char style="w" x-id="t006" x-align="MAT.12.21.a005">the</char> <note caller="-" style="f"><char style="ft">See marginal note on <ref loc="MAT 4:15">4:15</ref>.</char></note><char style="w" x-id="t007" x-align="MAT.12.21.a005" x-src="SBLGNT.MAT.12.21.005" x-source="ἔθνη" x-translit="ethnē" srcloc="SBLGNT.MAT.12.21.005" x-head="true" lemma="ἔθνος" strong="G1484">Gentiles</char> <char style="w" x-id="t008" x-align="MAT.12.21.a006" x-src="SBLGNT.MAT.12.21.006" x-source="ἐλπιοῦσιν" x-translit="elpiousin" srcloc="SBLGNT.MAT.12.21.006" x-head="true" lemma="ἐλπίζω" strong="G1679">hope</char>.<verse eid="MAT 12:21" /></para>
	<para style="p"><verse number="22" style="v" sid="MAT 12:22" /><char style="w" x-id="t001" x-align="MAT.12.22.a001" x-src="SBLGNT.MAT.12.22.001" x-source="Τότε" x-translit="Tote" srcloc="SBLGNT.MAT.12.22.001" x-head="true" lemma="τότε" strong="G5119">Then</char> <char style="w" x-id="t002" x-align="MAT.12.22.a002">was</char> <char style="w" x-id="t003" x-align="MAT.12.22.a002" x-src="SBLGNT.MAT.12.22.002" x-source="προσηνέχθη" x-translit="prosēnechthē" srcloc="SBLGNT.MAT.12.22.002" x-head="true" lemma="προσφέρω" strong="G4374">brought</char> <char style="w" x-id="t004" x-align="MAT.12.22.a003">unto</char> <char style="w" x-id="t005" x-align="MAT.12.22.a003" x-src="SBLGNT.MAT.12.22.003" x-source="αὐτῷ" x-translit="autōi" srcloc="SBLGNT.MAT.12.22.003" x-head="true" lemma="αὐτός" strong="G846">him</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">a demoniac</char></char></note><char style="w" x-id="t006" x-align="MAT.12.22.a004">one</char> <char style="w" x-id="t007" x-align="MAT.12.22.a004" x-src="SBLGNT.MAT.12.22.004" x-source="δαιμονιζόμενος" x-translit="daimonizomenos" srcloc="SBLGNT.MAT.12.22.004" x-head="true" lemma="δαιμονίζομαι" strong="G1139">possessed</char> <char style="w" x-id="t008" x-align="MAT.12.22.a004">with</char> <char style="w" x-id="t009" x-align="MAT.12.22.a004">a</char> <char style="w" x-id="t010" x-align="MAT.12.22.a004">demon</char>, <char style="w" x-id="t011" x-align="MAT.12.22.a005" x-src="SBLGNT.MAT.12.22.005" x-source="τυφλὸς" x-translit="typhlos" srcloc="SBLGNT.MAT.12.22.005" x-head="true" lemma="τυφλός" strong="G5185">blind</char> <char style="w" x-id="t012" x-align="MAT.12.22.a006" x-src="SBLGNT.MAT.12.22.006" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.MAT.12.22.006" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t013" x-align="MAT.12.22.a007" x-src="SBLGNT.MAT.12.22.007" x-source="κωφός" x-translit="kōphos" srcloc="SBLGNT.MAT.12.22.007" x-head="true" lemma="κωφός" strong="G2974">dum