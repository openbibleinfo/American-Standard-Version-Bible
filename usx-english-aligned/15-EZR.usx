ָה" strong="H1141">Benaiah</char>. <verse eid="EZR 10:43" /><verse number="44" style="v" sid="EZR 10:44" /><char style="w" x-id="t001" x-align="EZR.10.44.a001" x-src="WLC.EZR.10.44.001" x-source="כָּל" x-translit="kol-" srcloc="WLC.EZR.10.44.001" x-head="true" lemma="כֹּל" strong="H3605">All</char> <char style="w" x-id="t002" x-align="EZR.10.44.a002" x-src="WLC.EZR.10.44.002" x-source="אֵ֕לֶּה" x-translit="ʾēlleh" srcloc="WLC.EZR.10.44.002" x-head="true" lemma="אֵלֶּה" strong="H428">these</char> <char style="w" x-id="t003" x-align="EZR.10.44.a003">had</char> <char style="w" x-id="t004" x-align="EZR.10.44.a003" x-src="WLC.EZR.10.44.003" x-source="נָשְׂא֖וּ" x-translit="**nāśʾû" srcloc="WLC.EZR.10.44.003" x-head="true" lemma="נָשָׂא" strong="H5375">taken</char> <char style="w" x-id="t005" x-align="EZR.10.44.a005" x-src="WLC.EZR.10.44.005" x-source="נָכְרִיּ֑וֹת" x-translit="nāḵəriyyôṯ" srcloc="WLC.EZR.10.44.005" x-head="true" lemma="נׇכְרִי" strong="H5237">foreign</char> <char style="w" x-id="t006" x-align="EZR.10.44.a004" x-src="WLC.EZR.10.44.004" x-source="נָשִׁ֣ים" x-translit="nāšiym" srcloc="WLC.EZR.10.44.004" x-head="true" lemma="אִשָּׁה" strong="H802">wives</char>; <char style="w" x-id="t007" x-align="EZR.10.44.a006" x-src="WLC.EZR.10.44.006" x-source="וְ" x-translit="wə" srcloc="WLC.EZR.10.44.006" x-head="true" lemma="וְ" strong="H2050b">and</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">some of the wives had borne children</char>.</char></note><char style="w" x-id="t008" x-align="EZR.10.44.a008" x-src="WLC.EZR.10.44.008" x-source="מֵ" x-translit="mē" srcloc="WLC.EZR.10.44.008" x-head="true" lemma="מִן" strong="H4480">some</char> <char style="w" x-id="t009" x-align="EZR.10.44.a008">of</char> <char style="w" x-id="t010" x-align="EZR.10.44.a009" x-src="WLC.EZR.10.44.009" x-source="הֶ֣ם" x-translit="hem" srcloc="WLC.EZR.10.44.009" x-head="true" lemma="הוּא" strong="H3963a">them</char> <char style="w" x-id="t011" x-align="EZR.10.44.a007" x-