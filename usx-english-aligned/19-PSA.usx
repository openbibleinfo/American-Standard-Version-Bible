	<para style="q1"><char style="w" x-id="t011" x-align="PSA.139.17.a009" x-src="WLC.PSA.139.17.009" x-source="מֶ֥ה" x-translit="meh" srcloc="WLC.PSA.139.17.009" x-head="true" lemma="מָה" strong="H4100">How</char> <char style="w" x-id="t012" x-align="PSA.139.17.a010" x-src="WLC.PSA.139.17.010" x-source="עָ֝צְמוּ" x-translit="ʿāṣəmû" srcloc="WLC.PSA.139.17.010" x-head="true" lemma="עָצֹם" strong="H6105">great</char> <char style="w" x-id="t013" x-align="PSA.139.17.a010">is</char> <char style="w" x-id="t014" x-align="PSA.139.17.a011">the</char> <char style="w" x-id="t015" x-align="PSA.139.17.a011" x-src="WLC.PSA.139.17.011" x-source="רָאשֵׁי" x-translit="rāʾšēy" srcloc="WLC.PSA.139.17.011" x-head="true" lemma="רֹאשׁ" strong="H7218">sum</char> <char style="w" x-id="t016" x-align="PSA.139.17.a012">of</char> <char style="w" x-id="t017" x-align="PSA.139.17.a012" x-src="WLC.PSA.139.17.012" x-source="הֶֽם" x-translit="hem" srcloc="WLC.PSA.139.17.012" x-head="true" lemma="הוּא" strong="H3963a">them</char>!<verse eid="PSA 139:17" /></para>
	<para style="q1"><verse number="18" style="v" x-unrepresented-source="ן וְ" x-unrepresented-translit="n wə" x-unrepresented-src="WLC.PSA.139.18.006 WLC.PSA.139.18.008" sid="PSA 139:18" /><char style="w" x-id="t001" x-align="PSA.139.18.a001" x-status="added" x-source="∅" x-head="true">If</char> <char style="w" x-id="t002" x-align="PSA.139.18.a002">I</char> <char style="w" x-id="t003" x-align="PSA.139.18.a002">should</char> <char style="w" x-id="t004" x-align="PSA.139.18.a002" x-src="WLC.PSA.139.18.001" x-source="אֶ֭סְפְּרֵ" x-translit="ʾespər" srcloc="WLC.PSA.139.18.001" x-head="true" lemma="סָפַר" strong="H5608">count</char> <char style="w" x-id="t005" x-align="PSA.139.18.a003" x-src="WLC.PSA.139.18.002" x-source="ם" x-translit="ēm" srcloc="WLC.PSA.139.18.002" x-head="true" lemma="הוּא" strong="H3963a">them</char>, <char style="w" x-id="t006" x-align="PSA.139.18.a004">they</char> <char style="w" x-id="t007" x-align="PSA.139.18.a004">are</char> <char style="w" x-id="t008" x-align="PSA.139.18.a005">more</char> <char style="w" x-id="t009" x-align="PSA.139.18.a004">in</char> <char style="w" x-id="t010" x-align="PSA.139.18.a004" x-src="WLC.PSA.139.18.005" x-source="יִרְבּ֑וּ" x-translit="yirbû" srcloc="WLC.PSA.139.18.005" x-head="true" lemma="רָבָה" strong="H7235">number</char> <char style="w" x-id="t011" x-align="PSA.139.18.a005" x-src="WLC.PSA.139.18.003" x-source="מֵ" x-translit="mē" srcloc="WLC.PSA.139.18.003" x-head="true" lemma="מִן" strong="H4480">than</char> <char style="w" x-id="t012" x-align="PSA.139.18.a006">the</char> <char style="w" x-id="t013" x-align="PSA.139.18.a006" x-src="WLC.PSA.139.18.004" x-source="ח֣וֹל" x-translit="ḥôl" srcloc="WLC.PSA.139.18.004" x-head="true" lemma="חוֹל" strong="H2344">sand</char>:</para>
