	<para style="q1"><char style="w" x-id="t010" x-align="PSA.93.5.a010">O</char> <char style="w" x-id="t011" x-align="PSA.93.5.a010" x-src="WLC.PSA.93.5.010" x-source="יְ֝הוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.93.5.010" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t012" x-align="PSA.93.5.a011" x-src="WLC.PSA.93.5.011" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.93.5.011" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t013" x-align="PSA.93.5.a012" x-src="WLC.PSA.93.5.012 WLC.PSA.93.5.013" x-source="אֹ֣רֶךְ יָמִֽים" x-translit="ʾōreḵ yāmiym:" srcloc="WLC.PSA.93.5.012" x-head="true" lemma="אֹרֶךְ" strong="H753">evermore</char>.<verse eid="PSA 93:5" /></para>
	<chapter eid="PSA 93" />
	<chapter number="94" style="c" sid="PSA 94" />
	<para style="s1"><verse number="1" style="v" sid="PSA 94:1" />Jehovah implored to avenge his people.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.94.1.a001">O</char> <char style="w" x-id="t002" x-align="PSA.94.1.a001" x-src="WLC.PSA.94.1.003" x-source="יְהוָ֑ה" x-translit="yəhwāh" srcloc="WLC.PSA.94.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t003" x-align="PSA.94.1.a002">thou</char> <char style="w" x-id="t004" x-align="PSA.94.1.a002" x-src="WLC.PSA.94.1.001" x-source="אֵל" x-translit="ʾēl-" srcloc="WLC.PSA.94.1.001" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="w" x-id="t005" x-align="PSA.94.1.a003">to</char> <char style="w" x-id="t006" x-align="PSA.94.1.a003">whom</char> <char style="w" x-id="t007" x-align="PSA.94.1.a003" x-src="WLC.PSA.94.1.002" x-source="נְקָמ֥וֹת" x-translit="nəqāmôṯ" srcloc="WLC.PSA.94.1.002" x-head="true" lemma="נְקָמָה" strong="H5360">vengeance</char> <char style="w" x-id="t008" x-align="PSA.94.1.a003">belongeth</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.94.1.a004">Thou</char> <char style="w" x-id="t010" x-align="PSA.94.1.a004" x-src="WLC.PSA.94.1.004" x-source="אֵ֖ל" x-translit="ʾēl" srcloc="WLC.PSA.94.1.004" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="w" x-id="t011" x-align="PSA.94.1.a005">to</char> <char style="w" x-id="t012" x-align="PSA.94.1.a005">whom</char> <char style="w" x-id="t013" x-align="PSA.94.1.a005" x-src="WLC.PSA.94.1.005" x-source="נְקָמ֣וֹת" x-translit="nəqāmôṯ" srcloc="WLC.PSA.94.1.005" x-head="true" lemma="נְקָמָה" strong="H5360">vengeance</char> <char style="w" x-id="t014" x-align="PSA.94.1.a005">belongeth</char>, <char style="w" x-id="t015" x-align="PSA.94.1.a006" x-src="WLC.PSA.94.1.006" x-source="הוֹפִֽיַע" x-translit="hôp̄iyaʿ:" srcloc="WLC.PSA.94.1.006" x-head="true" lemma="יָפַע" strong="H3313">shine</char> <char style="w" x-id="t016" x-align="PSA.94.1.a006">forth</char>.<verse eid="PSA 94:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 94:2" /><char style="w" x-id="t001" x-align="PSA.94.2.a001" x-src="WLC.PSA.94.2.001" x-source="הִ֭נָּשֵׂא" x-translit="hinnāśēʾ" srcloc="WLC.PSA.94.2.001" x-head="true" lemma="נָשָׂא" strong="H5375">Lift</char> <char style="w" x-id="t002" x-align="PSA.94.2.a001">up</char> <char style="w" x-id="t003" x-align="PSA.94.2.a001">thyself</char>, <char style="w" x-id="t004" x-align="PSA.94.2.a002">thou</char> <char style="w" x-id="t005" x-align="PSA.94.2.a002" x-src="WLC.PSA.94.2.002" x-source="שֹׁפֵ֣ט" x-translit="šōp̄ēṭ" srcloc="WLC.PSA.94.2.002" x-head="true" lemma="שָׁפַט" strong="H8199">judge</char> <char style="w" x-id="t006" x-align="PSA.94.2.a004">of</char> <char style="w" x-id="t007" x-align="PSA.94.2.a003" x-src="WLC.PSA.94.2.003" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.94.2.003" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t008" x-align="PSA.94.2.a004" x-src="WLC.PSA.94.2.004" x-source="אָ֑רֶץ" x-translit="ʾāreṣ" srcloc="WLC.PSA.94.2.004" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>:</para>
