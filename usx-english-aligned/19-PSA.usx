	<chapter eid="PSA 106" />
	<chapter number="107" style="c" sid="PSA 107" />
	<para style="ms1"><verse number="1" style="v" sid="PSA 107:1" />Book V</para>
	<para style="s1">Jehovah delivers men from manifold troubles.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.107.1.a001">Oh</char> <char style="w" x-id="t002" x-align="PSA.107.1.a001">give</char> <char style="w" x-id="t003" x-align="PSA.107.1.a001" x-src="WLC.PSA.107.1.001" x-source="הֹד֣וּ" x-translit="hōḏû" srcloc="WLC.PSA.107.1.001" x-head="true" lemma="יָדָה" strong="H3034">thanks</char> <char style="w" x-id="t004" x-align="PSA.107.1.a002" x-src="WLC.PSA.107.1.002" x-source="לַ" x-translit="la" srcloc="WLC.PSA.107.1.002" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t005" x-align="PSA.107.1.a003" x-src="WLC.PSA.107.1.003" x-source="יהוָ֣ה" x-translit="yhwāh" srcloc="WLC.PSA.107.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t006" x-align="PSA.107.1.a004" x-src="WLC.PSA.107.1.004" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.107.1.004" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t007" x-align="PSA.107.1.a005">he</char> <char style="w" x-id="t008" x-align="PSA.107.1.a005">is</char> <char style="w" x-id="t009" x-align="PSA.107.1.a005" x-src="WLC.PSA.107.1.005" x-source="ט֑וֹב" x-translit="ṭôḇ" srcloc="WLC.PSA.107.1.005" x-head="true" lemma="טוֹב" strong="H2896">good</char>;</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.107.1.a006" x-src="WLC.PSA.107.1.006" x-source="כִּ֖י" x-translit="kiy" srcloc="WLC.PSA.107.1.006" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t011" x-align="PSA.107.1.a007" x-src="WLC.PSA.107.1.010" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.107.1.010" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t012" x-align="PSA.107.1.a008" x-src="WLC.PSA.107.1.009" x-source="חַסְדּֽ" x-translit="ḥasd" srcloc="WLC.PSA.107.1.009" x-head="true" lemma="חֶסֶד" strong="H2617">lovingkindness</char> <char style="add"><char style="w" x-id="t013" x-align="PSA.107.1.a009" x-status="added" x-source="∅" x-head="true">endureth</char></char> <char style="w" x-id="t014" x-align="PSA.107.1.a010" x-src="WLC.PSA.107.1.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.107.1.007" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t015" x-align="PSA.107.1.a011" x-src="WLC.PSA.107.1.008" x-source="עוֹלָ֣ם" x-translit="ʿôlām" srcloc="WLC.PSA.107.1.008" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char>.<verse eid="PSA 107:1" /></para>
