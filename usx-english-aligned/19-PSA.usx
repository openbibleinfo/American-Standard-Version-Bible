	<para style="q1"><char style="w" x-id="t001" x-align="PSA.80.1.a003">Give</char> <char style="w" x-id="t002" x-align="PSA.80.1.a003" x-src="WLC.PSA.80.1.003" x-source="הַאֲזִ֗ינָ" x-translit="haʾăziyn" srcloc="WLC.PSA.80.1.003" x-head="true" lemma="אָזַן" strong="H238">ear</char>, <char style="w" x-id="t003" x-align="PSA.80.1.a001">O</char> <char style="w" x-id="t004" x-align="PSA.80.1.a001" x-src="WLC.PSA.80.1.001" x-source="רֹ֘עֵ֤ה" x-translit="rōʿēh" srcloc="WLC.PSA.80.1.001" x-head="true" lemma="רָעָה" strong="H7473">Shepherd</char> <char style="w" x-id="t005" x-align="PSA.80.1.a002">of</char> <char style="w" x-id="t006" x-align="PSA.80.1.a002" x-src="WLC.PSA.80.1.002" x-source="יִשְׂרָאֵ֨ל" x-translit="yiśrāʾēl" srcloc="WLC.PSA.80.1.002" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>,</para>
