	<para style="q1"><char style="w" x-id="t006" x-align="PSA.9.3.a006">They</char> <char style="w" x-id="t007" x-align="PSA.9.3.a006" x-src="WLC.PSA.9.3.006" x-source="יִכָּשְׁל֥וּ" x-translit="yikkāšəlû" srcloc="WLC.PSA.9.3.006" x-head="true" lemma="כָּשַׁל" strong="H3782">stumble</char> <char style="w" x-id="t008" x-align="PSA.9.3.a007" x-src="WLC.PSA.9.3.007" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.9.3.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="PSA.9.3.a008" x-src="WLC.PSA.9.3.008" x-source="יֹאבְד֗וּ" x-translit="yōʾḇəḏû" srcloc="WLC.PSA.9.3.008" x-head="true" lemma="אָבַד" strong="H6">perish</char> <char style="w" x-id="t010" x-align="PSA.9.3.a009" x-src="WLC.PSA.9.3.009" x-source="מִ" x-translit="mi" srcloc="WLC.PSA.9.3.009" x-head="true" lemma="מִן" strong="H4480">at</char> <char style="w" x-id="t011" x-align="PSA.9.3.a011" x-src="WLC.PSA.9.3.011" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.9.3.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t012" x-align="PSA.9.3.a010" x-src="WLC.PSA.9.3.010" x-source="פָּנֶֽי" x-translit="pāney" srcloc="WLC.PSA.9.3.010" x-head="true" lemma="פָּנֶה" strong="H6440">presence</char>.<verse eid="PSA 9:3" /></para>
