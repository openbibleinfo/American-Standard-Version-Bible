	<para style="q1"><verse number="6" style="v" sid="PSA 9:6" /><note caller="-" style="f"><char style="ft">Or, <char style="it">O thou enemy, desolations are come to a perpetual end</char></char></note><char style="w" x-id="t001" x-align="PSA.9.6.a001" x-src="WLC.PSA.9.6.001" x-source="הָֽ" x-translit="hā" srcloc="WLC.PSA.9.6.001" x-head="true" lemma="הַ" strong="H1886a">The</char> <char style="w" x-id="t002" x-align="PSA.9.6.a002" x-src="WLC.PSA.9.6.002" x-source="אוֹיֵ֨ב" x-translit="ʾôyēḇ" srcloc="WLC.PSA.9.6.002" x-head="true" lemma="אָיַב" strong="H341">enemy</char> <char style="w" x-id="t003" x-align="PSA.9.6.a003">are</char> <char style="w" x-id="t004" x-align="PSA.9.6.a003">come</char> <char style="w" x-id="t005" x-align="PSA.9.6.a003">to</char> <char style="w" x-id="t006" x-align="PSA.9.6.a003">an</char> <char style="w" x-id="t007" x-align="PSA.9.6.a003" x-src="WLC.PSA.9.6.003" x-source="תַּ֥מּוּ" x-translit="tammû" srcloc="WLC.PSA.9.6.003" x-head="true" lemma="תָּמַם" strong="H8552">end</char>, <char style="w" x-id="t008" x-align="PSA.9.6.a004">they</char> <char style="w" x-id="t009" x-align="PSA.9.6.a004">are</char> <char style="w" x-id="t010" x-align="PSA.9.6.a004" x-src="WLC.PSA.9.6.004" x-source="חֳרָב֗וֹת" x-translit="ḥŏrāḇôṯ" srcloc="WLC.PSA.9.6.004" x-head="true" lemma="חׇרְבָּה" strong="H2723">desolate</char> <char style="w" x-id="t011" x-align="PSA.9.6.a005" x-src="WLC.PSA.9.6.005" x-source="לָ֫" x-translit="lā" srcloc="WLC.PSA.9.6.005" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t012" x-align="PSA.9.6.a006" x-src="WLC.PSA.9.6.006" x-source="נֶ֥צַח" x-translit="neṣaḥ" srcloc="WLC.PSA.9.6.006" x-head="true" lemma="נֵצַח" strong="H5331">ever</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">And</char> their <char style="it">cities thou hast overthrown</char></char></note><char style="w" x-id="t013" x-align="PSA.9.6.a007" x-src="WLC.PSA.9.6.007" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.9.6.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t014" x-align="PSA.9.6.a008">the</char> <char style="w" x-id="t015" x-align="PSA.9.6.a008" x-src="WLC.PSA.9.6.008" x-source="עָרִ֥ים" x-translit="ʿāriym" srcloc="WLC.PSA.9.6.008" x-head="true" lemma="עִיר" strong="H5892">cities</char> <char style="w" x-id="t016" x-align="PSA.9.6.a009">which</char> <char style="w" x-id="t017" x-align="PSA.9.6.a009">thou</char> <char style="w" x-id="t018" x-align="PSA.9.6.a009">hast</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">plucked up</char>.</char></note><char style="w" x-id="t019" x-align="PSA.9.6.a009" x-src="WLC.PSA.9.6.009" x-source="נָתַ֑שְׁתָּ" x-translit="nāṯašətā" srcloc="WLC.PSA.9.6.009" x-head="true" lemma="נָתַשׁ" strong="H5428">overthrown</char>,</para>
