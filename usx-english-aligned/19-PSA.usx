	<para style="q1"><verse number="2" style="v" sid="PSA 72:2" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Let him</char> (and so throughout the Psalm)</char></note><char style="w" x-id="t001" x-align="PSA.72.2.a001">He</char> <char style="w" x-id="t002" x-align="PSA.72.2.a001">will</char> <char style="w" x-id="t003" x-align="PSA.72.2.a001" x-src="WLC.PSA.72.2.001" x-source="יָדִ֣ין" x-translit="yāḏiyn" srcloc="WLC.PSA.72.2.001" x-head="true" lemma="דִּין" strong="H1777">judge</char> <char style="w" x-id="t004" x-align="PSA.72.2.a003" x-src="WLC.PSA.72.2.003" x-source="ךָ֣" x-translit="əḵā" srcloc="WLC.PSA.72.2.003" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t005" x-align="PSA.72.2.a002" x-src="WLC.PSA.72.2.002" x-source="עַמְּ" x-translit="ʿamm" srcloc="WLC.PSA.72.2.002" x-head="true" lemma="עַם" strong="H5971">people</char> <char style="w" x-id="t006" x-align="PSA.72.2.a004" x-src="WLC.PSA.72.2.004" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.72.2.004" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t007" x-align="PSA.72.2.a005" x-src="WLC.PSA.72.2.005" x-source="צֶ֑דֶק" x-translit="ṣeḏeq" srcloc="WLC.PSA.72.2.005" x-head="true" lemma="צֶדֶק" strong="H6664">righteousness</char>,</para>
