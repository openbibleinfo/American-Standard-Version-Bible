	<para style="s1"><verse number="1" style="v" sid="PSA 31:1" />A psalm of complaint and of praise.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.31.0.a001" x-src="WLC.PSA.31.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.31.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.31.0.a002" x-src="WLC.PSA.31.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.31.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.31.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.31.0.a003" x-src="WLC.PSA.31.0.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.31.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.31.0.a004">A</char> <char style="w" x-id="t006" x-align="PSA.31.0.a004" x-src="WLC.PSA.31.0.004" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.31.0.004" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t007" x-align="PSA.31.0.a005" x-src="WLC.PSA.31.0.005" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.31.0.005" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.31.0.a006" x-src="WLC.PSA.31.0.006" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.31.0.006" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.31.1.a001" x-src="WLC.PSA.31.1.001" x-source="בְּ" x-translit="b" srcloc="WLC.PSA.31.1.001" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t002" x-align="PSA.31.1.a002" x-src="WLC.PSA.31.1.002" x-source="ךָ֖" x-translit="əḵā" srcloc="WLC.PSA.31.1.002" x-head="true" lemma="הוּא" strong="H3509b">thee</char>, <char style="w" x-id="t003" x-align="PSA.31.1.a003">O</char> <char style="w" x-id="t004" x-align="PSA.31.1.a003" x-src="WLC.PSA.31.1.003" x-source="יְהוָ֣ה" x-translit="yəhwāh" srcloc="WLC.PSA.31.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t005" x-align="PSA.31.1.a004">do</char> <char style="w" x-id="t006" x-align="PSA.31.1.a004">I</char> <char style="w" x-id="t007" x-align="PSA.31.1.a004">take</char> <char style="w" x-id="t008" x-align="PSA.31.1.a004" x-src="WLC.PSA.31.1.004" x-source="חָ֭סִיתִי" x-translit="ḥāsîṯî" srcloc="WLC.PSA.31.1.004" x-head="true" lemma="חָסָה" strong="H2620">refuge</char>;</para>
