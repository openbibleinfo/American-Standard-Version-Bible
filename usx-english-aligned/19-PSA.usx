	<para style="q1"><verse number="7" style="v" sid="PSA 98:7" /><char style="w" x-id="t001" x-align="PSA.98.7.a001">Let</char> <char style="w" x-id="t002" x-align="PSA.98.7.a002" x-src="WLC.PSA.98.7.002" x-source="הַ֭" x-translit="ha" srcloc="WLC.PSA.98.7.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.98.7.a003" x-src="WLC.PSA.98.7.003" x-source="יָּם" x-translit="yyām" srcloc="WLC.PSA.98.7.003" x-head="true" lemma="יָם" strong="H3220">sea</char> <char style="w" x-id="t004" x-align="PSA.98.7.a001" x-src="WLC.PSA.98.7.001" x-source="יִרְעַ֣ם" x-translit="yirʿam" srcloc="WLC.PSA.98.7.001" x-head="true" lemma="רָעַם" strong="H7481">roar</char>, <char style="w" x-id="t005" x-align="PSA.98.7.a004" x-src="WLC.PSA.98.7.004" x-source="וּ" x-translit="û" srcloc="WLC.PSA.98.7.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t006" x-align="PSA.98.7.a005">the</char> <char style="w" x-id="t007" x-align="PSA.98.7.a005" x-src="WLC.PSA.98.7.005" x-source="מְלֹא֑" x-translit="məlōʾ" srcloc="WLC.PSA.98.7.005" x-head="true" lemma="מְלֹא" strong="H4393">fulness</char> <char style="w" x-id="t008" x-align="PSA.98.7.a006" x-src="WLC.PSA.98.7.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.98.7.006" x-head="true" lemma="הוּא" strong="H2050c">thereof</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.98.7.a007">The</char> <char style="w" x-id="t010" x-align="PSA.98.7.a007" x-src="WLC.PSA.98.7.007" x-source="תֵּ֝בֵ֗ל" x-translit="tēḇēl" srcloc="WLC.PSA.98.7.007" x-head="true" lemma="תֵּבֵל" strong="H8398">world</char>, <char style="w" x-id="t011" x-align="PSA.98.7.a008" x-src="WLC.PSA.98.7.008" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.98.7.008" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t012" x-align="PSA.98.7.a009">they</char> <char style="w" x-id="t013" x-align="PSA.98.7.a009">that</char> <char style="w" x-id="t014" x-align="PSA.98.7.a009" x-src="WLC.PSA.98.7.009" x-source="יֹ֣שְׁבֵי" x-translit="yōšəḇê" srcloc="WLC.PSA.98.7.009" x-head="true" lemma="יָשַׁב" strong="H3427">dwell</char> <char style="w" x-id="t015" x-align="PSA.98.7.a010" x-src="WLC.PSA.98.7.010 WLC.PSA.98.7.011" x-source="בָֽ הּ" x-translit="ḇ āhh" srcloc="WLC.PSA.98.7.010" x-head="true" lemma="בְּ" strong="H871a">therein</char>;<verse eid="PSA 98:7" /></para>
	<para style="q1"><verse number="8" style="v" sid="PSA 98:8" /><char style="w" x-id="t001" x-align="PSA.98.8.a002">Let</char> <char style="w" x-id="t002" x-align="PSA.98.8.a001">the</char> <char style="w" x-id="t003" x-align="PSA.98.8.a001" x-src="WLC.PSA.98.8.001" x-source="נְהָר֥וֹת" x-translit="nəhārôṯ" srcloc="WLC.PSA.98.8.001" x-head="true" lemma="נָהָר" strong="H5104">floods</char> <char style="w" x-id="t004" x-align="PSA.98.8.a002" x-src="WLC.PSA.98.8.002" x-source="יִמְחֲאוּ" x-translit="yimḥăʾû-" srcloc="WLC.PSA.98.8.002" x-head="true" lemma="מָחָא" strong="H4222">clap</char> <char style="w" x-id="t005" x-align="PSA.98.8.a004" x-status="added" x-source="∅" x-head="true">their</char> <char style="w" x-id="t006" x-align="PSA.98.8.a003" x-src="WLC.PSA.98.8.003" x-source="כָ֑ף" x-translit="ḵāp̄" srcloc="WLC.PSA.98.8.003" x-head="true" lemma="כַּף" strong="H3709">hands</char>;</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.98.8.a007">Let</char> <char style="w" x-id="t008" x-align="PSA.98.8.a006">the</char> <char style="w" x-id="t009" x-align="PSA.98.8.a006" x-src="WLC.PSA.98.8.005" x-source="הָרִ֥ים" x-translit="hāriym" srcloc="WLC.PSA.98.8.005" x-head="true" lemma="הַר" strong="H2022">hills</char> <char style="w" x-id="t010" x-align="PSA.98.8.a007" x-src="WLC.PSA.98.8.006" x-source="יְרַנֵּֽנוּ" x-translit="yərannēnû:" srcloc="WLC.PSA.98.8.006" x-head="true" lemma="רָנַן" strong="H7442">sing</char> <char style="w" x-id="t011" x-align="PSA.98.8.a007">for</char> <char style="w" x-id="t012" x-align="PSA.98.8.a007">joy</char> <char style="w" x-id="t013" x-align="PSA.98.8.a005" x-src="WLC.PSA.98.8.004" x-source="יַ֝֗חַד" x-translit="yaḥaḏ" srcloc="WLC.PSA.98.8.004" x-head="true" lemma="יַחַד" strong="H3162">together</char><verse eid="PSA 98:8" /></para>
	<para style="q1"><verse number="9" style="v" sid="PSA 98:9" /><char style="w" x-id="t001" x-align="PSA.98.9.a001" x-src="WLC.PSA.98.9.001 WLC.PSA.98.9.002" x-source="לִֽ פְֽנֵי" x-translit="li p̄ənê-" srcloc="WLC.PSA.98.9.002" x-head="true" lemma="פָּנֶה" strong="H6440">Before</char> <char style="w" x-id="t002" x-align="PSA.98.9.a002" x-src="WLC.PSA.98.9.003" x-source="יְהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.98.9.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t003" x-align="PSA.98.9.a003" x-src="WLC.PSA.98.9.004" x-source="כִּ֥י" x-translit="kiy" srcloc="WLC.PSA.98.9.004" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t004" x-align="PSA.98.9.a004">he</char> <char style="w" x-id="t005" x-align="PSA.98.9.a004" x-src="WLC.PSA.98.9.005" x-source="בָא֮" x-translit="ḇāʾ" srcloc="WLC.PSA.98.9.005" x-head="true" lemma="בּוֹא" strong="H935">cometh</char> <char style="w" x-id="t006" x-align="PSA.98.9.a005" x-src="WLC.PSA.98.9.006" x-source="לִ" x-translit="li" srcloc="WLC.PSA.98.9.006" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t007" x-align="PSA.98.9.a006" x-src="WLC.PSA.98.9.007" x-source="שְׁפֹּ֪ט" x-translit="šəpōṭ" srcloc="WLC.PSA.98.9.007" x-head="true" lemma="שָׁפַט" strong="H8199">judge</char> <char style="w" x-id="t008" x-align="PSA.98.9.a007" x-src="WLC.PSA.98.9.008" x-source="הָ֫" x-translit="hā" srcloc="WLC.PSA.98.9.008" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t009" x-align="PSA.98.9.a008" x-src="WLC.PSA.98.9.009" x-source="אָ֥רֶץ" x-translit="ʾāreṣ" srcloc="WLC.PSA.98.9.009" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>:</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.98.9.a009">He</char> <char style="w" x-id="t011" x-align="PSA.98.9.a009">will</char> <char style="w" x-id="t012" x-align="PSA.98.9.a009" x-src="WLC.PSA.98.9.010" x-source="יִשְׁפֹּֽט" x-translit="yišpōṭ-" srcloc="WLC.PSA.98.9.010" x-head="true" lemma="שָׁפַט" strong="H8199">judge</char> <char style="w" x-id="t013" x-align="PSA.98.9.a010">the</char> <char style="w" x-id="t014" x-align="PSA.98.9.a010" x-src="WLC.PSA.98.9.011" x-source="תֵּבֵ֥ל" x-translit="tēḇēl" srcloc="WLC.PSA.98.9.011" x-head="true" lemma="תֵּבֵל" strong="H8398">world</char> <char style="w" x-id="t015" x-align="PSA.98.9.a011" x-src="WLC.PSA.98.9.012" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.98.9.012" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t016" x-align="PSA.98.9.a012" x-src="WLC.PSA.98.9.013" x-source="צֶ֑דֶק" x-translit="ṣeḏeq" srcloc="WLC.PSA.98.9.013" x-head="true" lemma="צֶדֶק" strong="H6664">righteousness</char>,</para>
	<para style="q1"><char style="w" x-id="t017" x-align="PSA.98.9.a013" x-src="WLC.PSA.98.9.014" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.98.9.014" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t018" x-align="PSA.98.9.a014">the</char> <char style="w" x-id="t019" x-align="PSA.98.9.a014" x-src="WLC.PSA.98.9.015" x-source="עַמִּ֗ים" x-translit="ʿammiym" srcloc="WLC.PSA.98.9.015" x-head="true" lemma="עַם" strong="H5971">peoples</char> <char style="w" x-id="t020" x-align="PSA.98.9.a015" x-src="WLC.PSA.98.9.016" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.98.9.016" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t021" x-align="PSA.98.9.a016" x-src="WLC.PSA.98.9.017" x-source="מֵישָׁרִֽים" x-translit="mêšāriym:" srcloc="WLC.PSA.98.9.017" x-head="true" lemma="מֵישָׁרִים" strong="H4339">equity</char>.<verse eid="PSA 98:9" /></para>
	<chapter eid="PSA 98" />
	<chapter number="99" style="c" sid="PSA 99" />
	<para style="s1"><verse number="1" style="v" sid="PSA 99:1" />Praise to Jehovah for his fidelity to Israel.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.99.1.a001" x-src="WLC.PSA.99.1.001" x-source="יְהוָ֣ה" x-translit="yəhwāh" srcloc="WLC.PSA.99.1.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t002" x-align="PSA.99.1.a002" x-src="WLC.PSA.99.1.002" x-source="מָ֭לָךְ" x-translit="mālāḵ" srcloc="WLC.PSA.99.1.002" x-head="true" lemma="מָלַךְ" strong="H4427">reigneth</char>; <char style="w" x-id="t003" x-align="PSA.99.1.a003">let</char> <char style="w" x-id="t004" x-align="PSA.99.1.a004">the</char> <char style="w" x-id="t005" x-align="PSA.99.1.a004" x-src="WLC.PSA.99.1.004" x-source="עַמִּ֑ים" x-translit="ʿammiym" srcloc="WLC.PSA.99.1.004" x-head="true" lemma="עַם" strong="H5971">peoples</char> <char style="w" x-id="t006" x-align="PSA.99.1.a003" x-src="WLC.PSA.99.1.003" x-source="יִרְגְּז֣וּ" x-translit="yirgəzû" srcloc="WLC.PSA.99.1.003" x-head="true" lemma="רָגַז" strong="H7264">tremble</char>:</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.99.1.a001">He</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">is enthroned</char></char></note><char style="w" x-id="t008" x-align="PSA.99.1.a005" x-src="WLC.PSA.99.1.005" x-source="יֹשֵׁ֥ב" x-translit="yōšēḇ" srcloc="WLC.PSA.99.1.005" x-head="true" lemma="יָשַׁב" strong="H3427">sitteth</char> <char style="add"><char style="w" x-id="t009" x-align="PSA.99.1.a006">above</char></char> <char style="w" x-id="t010" x-align="PSA.99.1.a006">the</char> <char style="w" x-id="t011" x-align="PSA.99.1.a006" x-src="WLC.PSA.99.1.006" x-source="כְּ֝רוּבִ֗ים" x-translit="kərûḇiym" srcloc="WLC.PSA.99.1.006" x-head="true" lemma="כְּרוּב" strong="H3742">cherubim</char>; <char style="w" x-id="t012" x-align="PSA.99.1.a007">let</char> <char style="w" x-id="t013" x-align="PSA.99.1.a008" x-src="WLC.PSA.99.1.008" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.99.1.008" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t014" x-align="PSA.99.1.a009" x-src="WLC.PSA.99.1.009" x-source="אָֽרֶץ" x-translit="ʾāreṣ:" srcloc="WLC.PSA.99.1.009" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char> <char style="w" x-id="t015" x-align="PSA.99.1.a007">be</char> <char style="w" x-id="t016" x-align="PSA.99.1.a007" x-src="WLC.PSA.99.1.007" x-source="תָּנ֥וּט" x-translit="tānûṭ" srcloc="WLC.PSA.99.1.007" x-head="true" lemma="נוּט" strong="H5120">moved</char>.<verse eid="PSA 99:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 99:2" /><char style="w" x-id="t001" x-align="PSA.99.2.a001" x-src="WLC.PSA.99.2.001" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.99.2.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t002" x-align="PSA.99.2.a004">is</char> <char style="w" x-id="t003" x-align="PSA.99.2.a004" x-src="WLC.PSA.99.2.004" x-source="גָּד֑וֹל" x-translit="gāḏôl" srcloc="WLC.PSA.99.2.004" x-head="true" lemma="גָּדוֹל" strong="H1419">great</char> <char style="w" x-id="t004" x-align="PSA.99.2.a002" x-src="WLC.PSA.99.2.002" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.99.2.002" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t005" x-align="PSA.99.2.a003" x-src="WLC.PSA.99.2.003" x-source="צִיּ֣וֹן" x-translit="ṣiyyôn" srcloc="WLC.PSA.99.2.003" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>;</para>
