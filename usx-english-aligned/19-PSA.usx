	<para style="q1"><verse number="2" style="v" sid="PSA 47:2" /><char style="w" x-id="t001" x-align="PSA.47.2.a001" x-src="WLC.PSA.47.2.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.47.2.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">Jehovah is most high</char> and <char style="it">terrible</char></char></note><char style="w" x-id="t002" x-align="PSA.47.2.a002" x-src="WLC.PSA.47.2.002" x-source="יְהוָ֣ה" x-translit="yəhwāh" srcloc="WLC.PSA.47.2.002" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t003" x-align="PSA.47.2.a003">Most</char> <char style="w" x-id="t004" x-align="PSA.47.2.a003" x-src="WLC.PSA.47.2.003" x-source="עֶלְי֣וֹן" x-translit="ʿelyôn" srcloc="WLC.PSA.47.2.003" x-head="true" lemma="עֶלְיוֹן" strong="H5945a">High</char> <char style="w" x-id="t005" x-align="PSA.47.2.a004">is</char> <char style="w" x-id="t006" x-align="PSA.47.2.a004" x-src="WLC.PSA.47.2.004" x-source="נוֹרָ֑א" x-translit="nôrāʾ" srcloc="WLC.PSA.47.2.004" x-head="true" lemma="יָרֵא" strong="H3372">terrible</char>;</para>
