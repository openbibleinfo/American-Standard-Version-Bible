	<para style="q1"><verse number="2" style="v" sid="PSA 56:2" /><note caller="-" style="f"><char style="ft">Or, <char style="it">They that lie in wait for me</char></char></note><char style="w" x-id="t001" x-align="PSA.56.2.a003" x-src="WLC.PSA.56.2.003" x-source="י" x-translit="ay" srcloc="WLC.PSA.56.2.003" x-head="true" lemma="הוּא" strong="H2967a">Mine</char> <char style="w" x-id="t002" x-align="PSA.56.2.a002" x-src="WLC.PSA.56.2.002" x-source="שׁ֭וֹרְרַ" x-translit="šôrər" srcloc="WLC.PSA.56.2.002" x-head="true" lemma="שׁוֹרֵר" strong="H8324">enemies</char> <char style="w" x-id="t003" x-align="PSA.56.2.a001">would</char> <char style="w" x-id="t004" x-align="PSA.56.2.a001" x-src="WLC.PSA.56.2.001" x-source="שָׁאֲפ֣וּ" x-translit="šāʾăp̄û" srcloc="WLC.PSA.56.2.001" x-head="true" lemma="שָׁאַף" strong="H7602a">swallow</char> <char style="w" x-id="t005" x-align="PSA.56.2.a013" x-status="added" x-source="∅" x-head="true">me</char> <char style="w" x-id="t006" x-align="PSA.56.2.a001">up</char> <char style="w" x-id="t007" x-align="PSA.56.2.a004" x-src="WLC.PSA.56.2.004" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.56.2.004" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t008" x-align="PSA.56.2.a005" x-src="WLC.PSA.56.2.005" x-source="הַ" x-translit="ha" srcloc="WLC.PSA.56.2.005" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t009" x-align="PSA.56.2.a006" x-src="WLC.PSA.56.2.006" x-source="יּ֑וֹם" x-translit="yyôm" srcloc="WLC.PSA.56.2.006" x-head="true" lemma="יוֹם" strong="H3117">day</char> <char style="w" x-id="t010" x-align="PSA.56.2.a006">long</char>;</para>
