	<para style="d"><char style="w" x-id="t001" x-align="PSA.143.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.143.1.a001" x-src="WLC.PSA.143.1.001" x-source="מִזְמ֗וֹר" x-translit="mizmôr" srcloc="WLC.PSA.143.1.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.143.1.a002" x-src="WLC.PSA.143.1.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.143.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.143.1.a003" x-src="WLC.PSA.143.1.003" x-source="דָ֫וִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.143.1.003" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
