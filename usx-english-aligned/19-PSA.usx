	<para style="q1"><verse number="4" style="v" sid="PSA 82:4" /><char style="w" x-id="t001" x-align="PSA.82.4.a001" x-src="WLC.PSA.82.4.001" x-source="פַּלְּטוּ" x-translit="palləṭû-" srcloc="WLC.PSA.82.4.001" x-head="true" lemma="פָּלַט" strong="H6403">Rescue</char> <char style="w" x-id="t002" x-align="PSA.82.4.a002">the</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">weak</char></char></note><char style="w" x-id="t003" x-align="PSA.82.4.a002" x-src="WLC.PSA.82.4.002" x-source="דַ֥ל" x-translit="ḏal" srcloc="WLC.PSA.82.4.002" x-head="true" lemma="דַּל" strong="H1800">poor</char> <char style="w" x-id="t004" x-align="PSA.82.4.a003" x-src="WLC.PSA.82.4.003" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.82.4.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="PSA.82.4.a004" x-src="WLC.PSA.82.4.004" x-source="אֶבְי֑וֹן" x-translit="ʾeḇyôn" srcloc="WLC.PSA.82.4.004" x-head="true" lemma="אֶבְיוֹן" strong="H34">needy</char>:</para>
