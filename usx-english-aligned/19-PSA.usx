	<chapter number="52" style="c" sid="PSA 52" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="בְּ ב֤וֹא דּוֹאֵ֣ג הָ אֲדֹמִי֮ וַ יַּגֵּ֪ד לְ שָׁ֫א֥וּל וַ יֹּ֥אמֶר ל֑ וֹ בָּ֥א דָ֝וִ֗ד אֶל בֵּ֥ית אֲחִימֶֽלֶךְ הַ" x-unrepresented-translit="bə ḇôʾ dôʾēḡ hā ʾăḏōmî wa yyaggēḏ lə šāʾûl wa yyōʾmer l ô bāʾ ḏāwiḏ ʾel- bēyṯ ʾăḥîmeleḵ: ha" x-unrepresented-src="WLC.PSA.52.1.001 WLC.PSA.52.1.002 WLC.PSA.52.1.003 WLC.PSA.52.1.004 WLC.PSA.52.1.005 WLC.PSA.52.1.006 WLC.PSA.52.1.007 WLC.PSA.52.1.008 WLC.PSA.52.1.009 WLC.PSA.52.1.010 WLC.PSA.52.1.011 WLC.PSA.52.1.012 WLC.PSA.52.1.013 WLC.PSA.52.1.014 WLC.PSA.52.1.015 WLC.PSA.52.1.016 WLC.PSA.52.1.017 WLC.PSA.52.1.018 WLC.PSA.52.1.023" sid="PSA 52:1" />Futility of boastful wickedness.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.52.0.a001" x-src="WLC.PSA.52.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.52.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.52.0.a002" x-src="WLC.PSA.52.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.52.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.52.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.52.0.a003" x-src="WLC.PSA.52.0.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.52.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.52.0.a004" x-src="WLC.PSA.52.0.004" x-source="מַשְׂכִּ֥יל" x-translit="maśkiyl" srcloc="WLC.PSA.52.0.004" x-head="true" lemma="מַשְׂכִּיל" strong="H4905">Maschil</char> <char style="w" x-id="t006" x-align="PSA.52.0.a005" x-src="WLC.PSA.52.0.005" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.52.0.005" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t007" x-align="PSA.52.0.a006" x-src="WLC.PSA.52.0.006" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.52.0.006" x-head="true" lemma="דָּוִד" strong="H1732">David</char>; <char style="w" x-id="t008" x-align="PSA.52.0.a007" x-status="added" x-source="∅">when</char> <char style="w" x-id="t009" x-align="PSA.52.0.a007" x-status="added">Doeg</char> <char style="w" x-id="t010" x-align="PSA.52.0.a007" x-status="added">the</char> <char style="w" x-id="t011" x-align="PSA.52.0.a007" x-status="added">Edomite</char> <char style="w" x-id="t012" x-align="PSA.52.0.a007" x-status="added">came</char> <char style="w" x-id="t013" x-align="PSA.52.0.a007" x-status="added">and</char> <char style="w" x-id="t014" x-align="PSA.52.0.a007" x-status="added">told</char> <char style="w" x-id="t015" x-align="PSA.52.0.a007" x-status="added">Saul</char>, <char style="w" x-id="t016" x-align="PSA.52.0.a007" x-status="added">and</char> <char style="w" x-id="t017" x-align="PSA.52.0.a007" x-status="added">said</char> <char style="w" x-id="t018" x-align="PSA.52.0.a007" x-status="added">unto</char> <char style="w" x-id="t019" x-align="PSA.52.0.a007" x-status="added">him</char>, <char style="w" x-id="t020" x-align="PSA.52.0.a007" x-status="added">David</char> <char style="w" x-id="t021" x-align="PSA.52.0.a007" x-status="added">is</char> <char style="w" x-id="t022" x-align="PSA.52.0.a007" x-status="added">come</char> <char style="w" x-id="t023" x-align="PSA.52.0.a007" x-status="added">to</char> <char style="w" x-id="t024" x-align="PSA.52.0.a007" x-status="added">the</char> <char style="w" x-id="t025" x-align="PSA.52.0.a007" x-status="added">house</char> <char style="w" x-id="t026" x-align="PSA.52.0.a007" x-status="added">of</char> <char style="w" x-id="t027" x-align="PSA.52.0.a007" x-status="added">Ahimelech</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.52.1.a019" x-src="WLC.PSA.52.1.019" x-source="מַה" x-translit="mah-" srcloc="WLC.PSA.52.1.019" x-head="true" lemma="מָה" strong="H4100">Why</char> <char style="w" x-id="t002" x-align="PSA.52.1.a020" x-src="WLC.PSA.52.1.020" x-source="תִּתְהַלֵּ֣ל" x-translit="tiṯhallēl" srcloc="WLC.PSA.52.1.020" x-head="true" lemma="הָלַל" strong="H1984a">boastest</char> <char style="w" x-id="t003" x-align="PSA.52.1.a020">thou</char> <char style="w" x-id="t004" x-align="PSA.52.1.a020">thyself</char> <char style="w" x-id="t005" x-align="PSA.52.1.a021" x-src="WLC.PSA.52.1.021" x-source="בְּ֭" x-translit="bə" srcloc="WLC.PSA.52.1.021" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t006" x-align="PSA.52.1.a022" x-src="WLC.PSA.52.1.022" x-source="רָעָה" x-translit="rāʿâ" srcloc="WLC.PSA.52.1.022" x-head="true" lemma="רָעָה" strong="H7451b">mischief</char>, <char style="w" x-id="t007" x-align="PSA.52.1.a024">O</char> <char style="w" x-id="t008" x-align="PSA.52.1.a024" x-src="WLC.PSA.52.1.024" x-source="גִּבּ֑וֹר" x-translit="gibôr" srcloc="WLC.PSA.52.1.024" x-head="true" lemma="גִּבּוֹר" strong="H1368">mighty</char> <char style="w" x-id="t009" x-align="PSA.52.1.a024">man</char>?</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.52.1.a025">The</char> <char style="w" x-id="t011" x-align="PSA.52.1.a025" x-src="WLC.PSA.52.1.025" x-source="חֶ֥סֶד" x-translit="ḥeseḏ" srcloc="WLC.PSA.52.1.025" x-head="true" lemma="חֶסֶד" strong="H2617">lovingkindness</char> <char style="w" x-id="t012" x-align="PSA.52.1.a026">of</char> <char style="w" x-id="t013" x-align="PSA.52.1.a026" x-src="WLC.PSA.52.1.026" x-source="אֵ֝֗ל" x-translit="ʾēl" srcloc="WLC.PSA.52.1.026" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="add"><char style="w" x-id="t014" x-align="PSA.52.1.a027">endureth</char></char> <char style="w" x-id="t015" x-align="PSA.52.1.a027" x-src="WLC.PSA.52.1.027 WLC.PSA.52.1.028 WLC.PSA.52.1.029" x-source="כָּל הַ יּֽוֹם" x-translit="kol- ha yyôm:" srcloc="WLC.PSA.52.1.027" x-head="true" lemma="כֹּל" strong="H3605">continually</char>.<verse eid="PSA 52:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 52:2" /><char style="w" x-id="t001" x-align="PSA.52.2.a004" x-src="WLC.PSA.52.2.004" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.52.2.004" x-head="true" lemma="הוּא" strong="H3509b">Thy</char> <char style="w" x-id="t002" x-align="PSA.52.2.a003" x-src="WLC.PSA.52.2.003" x-source="לְשׁוֹנֶ֑" x-translit="ləšôn" srcloc="WLC.PSA.52.2.003" x-head="true" lemma="לָשׁוֹן" strong="H3956">tongue</char> <char style="w" x-id="t003" x-align="PSA.52.2.a002" x-src="WLC.PSA.52.2.002" x-source="תַּחְשֹׁ֣ב" x-translit="taḥšōḇ" srcloc="WLC.PSA.52.2.002" x-head="true" lemma="חָשַׁב" strong="H2803">deviseth</char> <char style="w" x-id="t004" x-align="PSA.52.2.a001">very</char> <char style="w" x-id="t005" x-align="PSA.52.2.a001" x-src="WLC.PSA.52.2.001" x-source="הַ֭וּוֹת" x-translit="hawwôṯ" srcloc="WLC.PSA.52.2.001" x-head="true" lemma="הַוָּה" strong="H1942a">wickedness</char>,</para>
