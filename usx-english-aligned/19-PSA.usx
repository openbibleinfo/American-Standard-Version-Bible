	<para style="q1"><char style="w" x-id="t028" x-align="PSA.14.1.a017">There</char> <char style="w" x-id="t029" x-align="PSA.14.1.a017">is</char> <char style="w" x-id="t030" x-align="PSA.14.1.a017" x-src="WLC.PSA.14.1.016" x-source="אֵ֣ין" x-translit="ʾēyn" srcloc="WLC.PSA.14.1.016" x-head="true" lemma="אַיִן" strong="H369">none</char> <char style="w" x-id="t031" x-align="PSA.14.1.a018">that</char> <char style="w" x-id="t032" x-align="PSA.14.1.a018" x-src="WLC.PSA.14.1.017" x-source="עֹֽשֵׂה" x-translit="ʿōśēh-" srcloc="WLC.PSA.14.1.017" x-head="true" lemma="עָשָׂה" strong="H6213">doeth</char> <char style="w" x-id="t033" x-align="PSA.14.1.a019" x-src="WLC.PSA.14.1.018" x-source="טֽוֹב" x-translit="ṭôḇ:" srcloc="WLC.PSA.14.1.018" x-head="true" lemma="טוֹב" strong="H2896">good</char>.<verse eid="PSA 14:1" /></para>
	<para style="q1"><verse number="2" style="v" x-unrepresented-source="אֶת" x-unrepresented-translit="ʾeṯ-" x-unrepresented-src="WLC.PSA.14.2.014" sid="PSA 14:2" /><char style="w" x-id="t001" x-align="PSA.14.2.a001" x-src="WLC.PSA.14.2.001" x-source="יְֽהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.14.2.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t002" x-align="PSA.14.2.a002" x-src="WLC.PSA.14.2.004" x-source="הִשְׁקִ֪יף" x-translit="hišqiyp̄" srcloc="WLC.PSA.14.2.004" x-head="true" lemma="שָׁקַף" strong="H8259">looked</char> <char style="w" x-id="t003" x-align="PSA.14.2.a002">down</char> <char style="w" x-id="t004" x-align="PSA.14.2.a003" x-src="WLC.PSA.14.2.002" x-source="מִ" x-translit="mi" srcloc="WLC.PSA.14.2.002" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t005" x-align="PSA.14.2.a004" x-src="WLC.PSA.14.2.003" x-source="שָּׁמַיִם֮" x-translit="ššāmayim" srcloc="WLC.PSA.14.2.003" x-head="true" lemma="שָׁמַיִם" strong="H8064">heaven</char> <char style="w" x-id="t006" x-align="PSA.14.2.a005" x-src="WLC.PSA.14.2.005" x-source="עַֽל" x-translit="ʿal-" srcloc="WLC.PSA.14.2.005" x-head="true" lemma="עַל" strong="H5921">upon</char> <char style="w" x-id="t007" x-align="PSA.14.2.a006">the</char> <char style="w" x-id="t008" x-align="PSA.14.2.a006" x-src="WLC.PSA.14.2.006" x-source="בְּנֵי" x-translit="bənê-" srcloc="WLC.PSA.14.2.006" x-head="true" lemma="בֵּן" strong="H1121">children</char> <char style="w" x-id="t009" x-align="PSA.14.2.a007">of</char> <char style="w" x-id="t010" x-align="PSA.14.2.a007" x-src="WLC.PSA.14.2.007" x-source="אָ֫דָ֥ם" x-translit="ʾāḏām" srcloc="WLC.PSA.14.2.007" x-head="true" lemma="אָדָם" strong="H120">men</char>,</para>
