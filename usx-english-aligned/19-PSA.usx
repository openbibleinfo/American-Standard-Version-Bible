	<para style="q1"><char style="w" x-id="t015" x-align="PSA.45.2.a010" x-src="WLC.PSA.45.2.010 WLC.PSA.45.2.011" x-source="עַל כֵּ֤ן" x-translit="ʿal- kēn" srcloc="WLC.PSA.45.2.010" x-head="true" lemma="עַל" strong="H5921">Therefore</char> <char style="w" x-id="t016" x-align="PSA.45.2.a013" x-src="WLC.PSA.45.2.014" x-source="אֱלֹהִ֣ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.45.2.014" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t017" x-align="PSA.45.2.a011">hath</char> <char style="w" x-id="t018" x-align="PSA.45.2.a011" x-src="WLC.PSA.45.2.012" x-source="בֵּֽרַכְ" x-translit="bēraḵ" srcloc="WLC.PSA.45.2.012" x-head="true" lemma="בָּרַךְ" strong="H1288">blessed</char> <char style="w" x-id="t019" x-align="PSA.45.2.a012" x-src="WLC.PSA.45.2.013" x-source="ךָ֖" x-translit="əḵā" srcloc="WLC.PSA.45.2.013" x-head="true" lemma="הוּא" strong="H3509b">thee</char> <char style="w" x-id="t020" x-align="PSA.45.2.a014" x-src="WLC.PSA.45.2.015" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.45.2.015" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t021" x-align="PSA.45.2.a015" x-src="WLC.PSA.45.2.016" x-source="עוֹלָֽם" x-translit="ʿôlām:" srcloc="WLC.PSA.45.2.016" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char>.<verse eid="PSA 45:2" /></para>
