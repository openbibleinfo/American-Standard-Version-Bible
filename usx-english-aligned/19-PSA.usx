	<para style="q1"><verse number="17" style="v" sid="PSA 132:17" /><char style="w" x-id="t001" x-align="PSA.132.17.a001" x-src="WLC.PSA.132.17.001" x-source="שָׁ֤ם" x-translit="šām" srcloc="WLC.PSA.132.17.001" x-head="true" lemma="שָׁם" strong="H8033">There</char> <char style="w" x-id="t002" x-align="PSA.132.17.a002">will</char> <char style="w" x-id="t003" x-align="PSA.132.17.a002">I</char> <char style="w" x-id="t004" x-align="PSA.132.17.a002">make</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">a horn to spring forth unto David</char></char></note><char style="w" x-id="t005" x-align="PSA.132.17.a003">the</char> <char style="w" x-id="t006" x-align="PSA.132.17.a003" x-src="WLC.PSA.132.17.003" x-source="קֶ֣רֶן" x-translit="qeren" srcloc="WLC.PSA.132.17.003" x-head="true" lemma="קֶרֶן" strong="H7161">horn</char> <char style="w" x-id="t007" x-align="PSA.132.17.a004" x-src="WLC.PSA.132.17.004" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.132.17.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.132.17.a005" x-src="WLC.PSA.132.17.005" x-source="דָוִ֑ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.132.17.005" x-head="true" lemma="דָּוִד" strong="H1732">David</char> <char style="w" x-id="t009" x-align="PSA.132.17.a002">to</char> <char style="w" x-id="t010" x-align="PSA.132.17.a002" x-src="WLC.PSA.132.17.002" x-source="אַצְמִ֣יחַ" x-translit="ʾaṣmiyᵃḥ" srcloc="WLC.PSA.132.17.002" x-head="true" lemma="צָמַח" strong="H6779">bud</char>:</para>
