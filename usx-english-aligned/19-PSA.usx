	<para style="q1"><verse number="12" style="v" sid="PSA 36:12" /><char style="w" x-id="t001" x-align="PSA.36.12.a001" x-src="WLC.PSA.36.12.001" x-source="שָׁ֣ם" x-translit="šām" srcloc="WLC.PSA.36.12.001" x-head="true" lemma="שָׁם" strong="H8033">There</char> <char style="w" x-id="t002" x-align="PSA.36.12.a002">are</char> <char style="w" x-id="t003" x-align="PSA.36.12.a003">the</char> <char style="w" x-id="t004" x-align="PSA.36.12.a003" x-src="WLC.PSA.36.12.003" x-source="פֹּ֣עֲלֵי" x-translit="pōʿălê" srcloc="WLC.PSA.36.12.003" x-head="true" lemma="פָּעַל" strong="H6466">workers</char> <char style="w" x-id="t005" x-align="PSA.36.12.a004">of</char> <char style="w" x-id="t006" x-align="PSA.36.12.a004" x-src="WLC.PSA.36.12.004" x-source="אָ֑וֶן" x-translit="ʾāwen" srcloc="WLC.PSA.36.12.004" x-head="true" lemma="אָוֶן" strong="H205">iniquity</char> <char style="w" x-id="t007" x-align="PSA.36.12.a002" x-src="WLC.PSA.36.12.002" x-source="נָ֭פְלוּ" x-translit="nāp̄əlû" srcloc="WLC.PSA.36.12.002" x-head="true" lemma="נָפַל" strong="H5307">fallen</char>:</para>
