	<para style="q1"><char style="w" x-id="t014" x-align="PSA.74.1.a004">Why</char> <char style="w" x-id="t015" x-align="PSA.74.1.a010">doth</char> <char style="w" x-id="t016" x-align="PSA.74.1.a012" x-src="WLC.PSA.74.1.012" x-source="ךָ֗" x-translit="əḵā" srcloc="WLC.PSA.74.1.012" x-head="true" lemma="הוּא" strong="H3509b">thine</char> <char style="w" x-id="t017" x-align="PSA.74.1.a011" x-src="WLC.PSA.74.1.011" x-source="אַ֝פְּ" x-translit="ʾapp" srcloc="WLC.PSA.74.1.011" x-head="true" lemma="אַף" strong="H639">anger</char> <char style="w" x-id="t018" x-align="PSA.74.1.a010" x-src="WLC.PSA.74.1.010" x-source="יֶעְשַׁ֥ן" x-translit="yeʿšan" srcloc="WLC.PSA.74.1.010" x-head="true" lemma="עָשַׁן" strong="H6225">smoke</char> <char style="w" x-id="t019" x-align="PSA.74.1.a013" x-src="WLC.PSA.74.1.013" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.74.1.013" x-head="true" lemma="בְּ" strong="H871a">against</char> <char style="w" x-id="t020" x-align="PSA.74.1.a014">the</char> <char style="w" x-id="t021" x-align="PSA.74.1.a014" x-src="WLC.PSA.74.1.014" x-source="צֹ֣אן" x-translit="ṣōʾn" srcloc="WLC.PSA.74.1.014" x-head="true" lemma="צֹאן" strong="H6629">sheep</char> <char style="w" x-id="t022" x-align="PSA.74.1.a015">of</char> <char style="w" x-id="t023" x-align="PSA.74.1.a016" x-src="WLC.PSA.74.1.016" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.74.1.016" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t024" x-align="PSA.74.1.a015" x-src="WLC.PSA.74.1.015" x-source="מַרְעִיתֶֽ" x-translit="marʿiyṯ" srcloc="WLC.PSA.74.1.015" x-head="true" lemma="מַרְעִית" strong="H4830">pasture</char>?<verse eid="PSA 74:1" /></para>
