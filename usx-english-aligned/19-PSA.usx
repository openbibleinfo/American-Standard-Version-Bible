	<para style="q1"><verse number="3" style="v" sid="PSA 65:3" /><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Words</char> (or <char style="it">Matters</char>) <char style="it">of iniquities</char>.</char></note><char style="w" x-id="t001" x-align="PSA.65.3.a001" x-src="WLC.PSA.65.3.001 WLC.PSA.65.3.002" x-source="דִּבְרֵ֣י עֲ֭וֺנֹת" x-translit="diḇrēy ʿăwōnōṯ" srcloc="WLC.PSA.65.3.002" x-head="true" lemma="עָוֺן" strong="H5771">Iniquities</char> <char style="w" x-id="t002" x-align="PSA.65.3.a002" x-src="WLC.PSA.65.3.003" x-source="גָּ֣בְרוּ" x-translit="gāḇərû" srcloc="WLC.PSA.65.3.003" x-head="true" lemma="גָּבַר" strong="H1396">prevail</char> <char style="w" x-id="t003" x-align="PSA.65.3.a003" x-src="WLC.PSA.65.3.004" x-source="מֶ֑נִּ" x-translit="menn" srcloc="WLC.PSA.65.3.004" x-head="true" lemma="מִן" strong="H4480">against</char> <char style="w" x-id="t004" x-align="PSA.65.3.a004" x-src="WLC.PSA.65.3.005" x-source="י" x-translit="iy" srcloc="WLC.PSA.65.3.005" x-head="true" lemma="הוּא" strong="H2967a">me</char>:</para>
