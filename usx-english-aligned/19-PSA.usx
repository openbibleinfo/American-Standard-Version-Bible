	<para style="q1"><verse number="2" style="v" sid="PSA 2:2" /><char style="w" x-id="t001" x-align="PSA.2.2.a002">The</char> <char style="w" x-id="t002" x-align="PSA.2.2.a002" x-src="WLC.PSA.2.2.002" x-source="מַלְכֵי" x-translit="malḵê-" srcloc="WLC.PSA.2.2.002" x-head="true" lemma="מֶלֶךְ" strong="H4428">kings</char> <char style="w" x-id="t003" x-align="PSA.2.2.a003">of</char> <char style="w" x-id="t004" x-align="PSA.2.2.a003">the</char> <char style="w" x-id="t005" x-align="PSA.2.2.a003" x-src="WLC.PSA.2.2.003" x-source="אֶ֗רֶץ" x-translit="ʾereṣ" srcloc="WLC.PSA.2.2.003" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char> <char style="w" x-id="t006" x-align="PSA.2.2.a001" x-src="WLC.PSA.2.2.001" x-source="יִ֥תְיַצְּב֨וּ" x-translit="yiṯəyaṣṣəḇû" srcloc="WLC.PSA.2.2.001" x-head="true" lemma="יָצַב" strong="H3320">set</char> <char style="w" x-id="t007" x-align="PSA.2.2.a001">themselves</char>,</para>
