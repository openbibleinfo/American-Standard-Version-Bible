	<para style="q1"><verse number="18" style="v" x-unrepresented-source="ךָ" x-unrepresented-translit="eḵā" x-unrepresented-src="WLC.PSA.83.18.010" sid="PSA 83:18" /><char style="w" x-id="t001" x-align="PSA.83.18.a001" x-src="WLC.PSA.83.18.001" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.83.18.001" x-head="true" lemma="וְ" strong="H2050b">That</char> <char style="w" x-id="t002" x-align="PSA.83.18.a002">they</char> <char style="w" x-id="t003" x-align="PSA.83.18.a002">may</char> <char style="w" x-id="t004" x-align="PSA.83.18.a002" x-src="WLC.PSA.83.18.002" x-source="יֵדְע֗וּ" x-translit="yēḏʿû" srcloc="WLC.PSA.83.18.002" x-head="true" lemma="יָדַע" strong="H3045">know</char> <char style="w" x-id="t005" x-align="PSA.83.18.a003" x-src="WLC.PSA.83.18.003" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.83.18.003" x-head="true" lemma="כִּי" strong="H3588">that</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">thou, whose name alone is Jehovah, art etc.</char></char></note><char style="w" x-id="t006" x-align="PSA.83.18.a004" x-src="WLC.PSA.83.18.004" x-source="אַתָּ֬ה" x-translit="ʾattāh" srcloc="WLC.PSA.83.18.004" x-head="true" lemma="אַתָּה" strong="H859">thou</char> <char style="w" x-id="t007" x-align="PSA.83.18.a008" x-src="WLC.PSA.83.18.008 WLC.PSA.83.18.009" x-source="לְ בַדֶּ֑" x-translit="lə ḇadd" srcloc="WLC.PSA.83.18.009" x-head="true" lemma="בַּד" strong="H905">alone</char>, <char style="w" x-id="t008" x-align="PSA.83.18.a006" x-src="WLC.PSA.83.18.006" x-source="ךָ֣" x-translit="əḵā" srcloc="WLC.PSA.83.18.006" x-head="true" lemma="הוּא" strong="H3509b">whose</char> <char style="w" x-id="t009" x-align="PSA.83.18.a005" x-src="WLC.PSA.83.18.005" x-source="שִׁמְ" x-translit="šim" srcloc="WLC.PSA.83.18.005" x-head="true" lemma="שֵׁם" strong="H8034">name</char> <char style="w" x-id="t010" x-align="PSA.83.18.a007">is</char> <char style="w" x-id="t011" x-align="PSA.83.18.a007" x-src="WLC.PSA.83.18.007" x-source="יְהוָ֣ה" x-translit="yəhwāh" src