	<para style="s1"><verse number="1" style="v" sid="PSA 118:1" />Thanksgiving for Jehovah’s saving goodness.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.118.1.a001">Oh</char> <char style="w" x-id="t002" x-align="PSA.118.1.a001">give</char> <char style="w" x-id="t003" x-align="PSA.118.1.a001" x-src="WLC.PSA.118.1.001" x-source="הוֹד֣וּ" x-translit="hôḏû" srcloc="WLC.PSA.118.1.001" x-head="true" lemma="יָדָה" strong="H3034">thanks</char> <char style="w" x-id="t004" x-align="PSA.118.1.a002" x-src="WLC.PSA.118.1.002" x-source="לַ" x-translit="la" srcloc="WLC.PSA.118.1.002" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t005" x-align="PSA.118.1.a003" x-src="WLC.PSA.118.1.003" x-source="יהוָ֣ה" x-translit="yhwāh" srcloc="WLC.PSA.118.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t006" x-align="PSA.118.1.a004" x-src="WLC.PSA.118.1.004" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.118.1.004" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t007" x-align="PSA.118.1.a005">he</char> <char style="w" x-id="t008" x-align="PSA.118.1.a005">is</char> <char style="w" x-id="t009" x-align="PSA.118.1.a005" x-src="WLC.PSA.118.1.005" x-source="ט֑וֹב" x-translit="ṭôḇ" srcloc="WLC.PSA.118.1.005" x-head="true" lemma="טוֹב" strong="H2896">good</char>;</para>
