	<para style="ms1"><verse number="1" style="v" x-unrepresented-source="י לָּ֗ וָ דֹֽר" x-unrepresented-translit="āy ll wā ḏōr:" x-unrepresented-src="WLC.PSA.90.1.008 WLC.PSA.90.1.012 WLC.PSA.90.1.016 WLC.PSA.90.1.017" sid="PSA 90:1" />Book IV</para>
	<para style="s1">God’s eternity and man’s transitoriness.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.90.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.90.1.a001" x-src="WLC.PSA.90.1.001" x-source="תְּפִלָּה֮" x-translit="təp̄illāh" srcloc="WLC.PSA.90.1.001" x-head="true" lemma="תְּפִלָּה" strong="H8605">Prayer</char> <char style="w" x-id="t003" x-align="PSA.90.1.a002" x-src="WLC.PSA.90.1.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.90.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.90.1.a003" x-src="WLC.PSA.90.1.003" x-source="מֹשֶׁ֪ה" x-translit="mōšeh" srcloc="WLC.PSA.90.1.003" x-head="true" lemma="מֹשֶׁה" strong="H4872">Moses</char> <char style="w" x-id="t005" x-align="PSA.90.1.a005" x-src="WLC.PSA.90.1.005" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.90.1.005" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t006" x-align="PSA.90.1.a004" x-src="WLC.PSA.90.1.004" x-source="אִֽישׁ" x-translit="ʾiyš-" srcloc="WLC.PSA.90.1.004" x-head="true" lemma="אִישׁ" strong="H376">man</char> <char style="w" x-id="t007" x-align="PSA.90.1.a006">of</char> <char style="w" x-id="t008" x-align="PSA.90.1.a006" x-src="WLC.PSA.90.1.006" x-source="אֱלֹ֫הִ֥ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.90.1.006" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>.</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.90.1.a007" x-src="WLC.PSA.90.1.007" x-source="אֲֽדֹנָ֗" x-translit="ʾăḏōn" srcloc="WLC.PSA.90.1.007" x-head="true" lemma="אֲדֹנָי" strong="H136">Lord</char>, <char style="w" x-id="t010" x-align="PSA.90.1.a010" x-src="WLC.PSA.90.1.010" x-source="אַ֭תָּה" x-translit="ʾattâ" srcloc="WLC.PSA.90.1.010" x-head="true" lemma="אַתָּה" strong="H859">thou</char> <char style="w" x-id="t011" x-align="PSA.90.1.a011">hast</char> <char style="w" x-id="t012" x-align="PSA.90.1.a011" x-src="WLC.PSA.90.1.011" x-source="הָיִ֥יתָ" x-translit="hāyiyṯā" srcloc="WLC.PSA.90.1.011" x-head="true" lemma="הָיָה" strong="H1961">been</char> <char style="w" x-id="t013" x-align="PSA.90.1.a013" x-src="WLC.PSA.90.1.013" x-source="נוּ" x-translit="ānû" srcloc="WLC.PSA.90.1.013" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t014" x-align="PSA.90.1.a009" x-src="WLC.PSA.90.1.009" x-source="מָע֣וֹן" x-translit="māʿôn" srcloc="WLC.PSA.90.1.009" x-head="true" lemma="מָעוֹן" strong="H4583">dwelling</char>-<char style="w" x-id="t015" x-align="PSA.90.1.a009">place</char></para>
	<para style="q1"><char style="w" x-id="t016" x-align="PSA.90.1.a014" x-src="WLC.PSA.90.1.014" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.90.1.014" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t017" x-align="PSA.90.1.a015">all</char> <char style="w" x-id="t018" x-align="PSA.90.1.a015" x-src="WLC.PSA.90.1.015" x-source="דֹ֣ר" x-translit="ḏōr" srcloc="WLC.PSA.90.1.015" x-head="true" lemma="דּוֹר" strong="H1755">generations</char>.<verse eid="PSA 90:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 90:2" /><char style="w" x-id="t001" x-align="PSA.90.2.a001" x-src="WLC.PSA.90.2.001 WLC.PSA.90.2.002" x-source="בְּ טֶ֤רֶם" x-translit="bə ṭerem" srcloc="WLC.PSA.90.2.002" x-head="true" lemma="טֶרֶם" strong="H2962">Before</char> <char style="w" x-id="t002" x-align="PSA.90.2.a002">the</char> <char style="w" x-id="t003" x-align="PSA.90.2.a002" x-src="WLC.PSA.90.2.003" x-source="הָ֘רִ֤ים" x-translit="hāriym" srcloc="WLC.PSA.90.2.003" x-head="true" lemma="הַר" strong="H2022">mountains</char> <char style="w" x-id="t004" x-align="PSA.90.2.a003">were</char> <char style="w" x-id="t005" x-align="PSA.90.2.a003" x-src="WLC.PSA.90.2.004" x-source="יֻלָּ֗דוּ" x-translit="yullāḏû" srcloc="WLC.PSA.90.2.004" x-head="true" lemma="יָלַד" strong="H3205">brought</char> <char style="w" x-id="t006" x-align="PSA.90.2.a003">forth</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.90.2.a004" x-src="WLC.PSA.90.2.005" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.90.2.005" x-head="true" lemma="וְ" strong="H2050b">Or</char> <char style="w" x-id="t008" x-align="PSA.90.2.a004">ever</char> <char style="w" x-id="t009" x-align="PSA.90.2.a005">thou</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">gavest birth to</char>.</char></note><char style="w" x-id="t010" x-align="PSA.90.2.a005">hadst</char> <char style="w" x-id="t011" x-align="PSA.90.2.a005" x-src="WLC.PSA.90.2.006" x-source="תְּח֣וֹלֵֽל" x-translit="təḥôlēl" srcloc="WLC.PSA.90.2.006" x-head="true" lemma="חיל" strong="H2342a">formed</char> <char style="w" x-id="t012" x-align="PSA.90.2.a006">the</char> <char style="w" x-id="t013" x-align="PSA.90.2.a006" x-src="WLC.PSA.90.2.007" x-source="אֶ֣רֶץ" x-translit="ʾereṣ" srcloc="WLC.PSA.90.2.007" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char> <char style="w" x-id="t014" x-align="PSA.90.2.a007" x-src="WLC.PSA.90.2.008" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.90.2.008" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t015" x-align="PSA.90.2.a008">the</char> <char style="w" x-id="t016" x-align="PSA.90.2.a008" x-src="WLC.PSA.90.2.009" x-source="תֵבֵ֑ל" x-translit="ṯēḇēl" srcloc="WLC.PSA.90.2.009" x-head="true" lemma="תֵּבֵל" strong="H8398">world</char>,</para>
