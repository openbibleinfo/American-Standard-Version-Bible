	<para style="q1"><verse number="5" style="v" sid="PSA 30:5" /><char style="w" x-id="t001" x-align="PSA.30.5.a001" x-src="WLC.PSA.30.5.001" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.PSA.30.5.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.30.5.a005" x-src="WLC.PSA.30.5.005" x-source="וֹ֮" x-translit="ô" srcloc="WLC.PSA.30.5.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t003" x-align="PSA.30.5.a004" x-src="WLC.PSA.30.5.004" x-source="אַפּ" x-translit="ʾapp" srcloc="WLC.PSA.30.5.004" x-head="true" lemma="אַף" strong="H639">anger</char> <char style="w" x-id="t004" x-align="PSA.30.5.a003">is</char> <char style="w" x-id="t005" x-align="PSA.30.5.a006" x-status="added" x-source="∅" x-head="true">but</char> <char style="w" x-id="t006" x-align="PSA.30.5.a003" x-src="WLC.PSA.30.5.003" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.30.5.003" x-head="true" lemma="בְּ" strong="H871a">for</char> <char style="w" x-id="t007" x-align="PSA.30.5.a002">a</char> <char style="w" x-id="t008" x-align="PSA.30.5.a002" x-src="WLC.PSA.30.5.002" x-source="רֶ֨גַע" x-translit="reḡaʿ" srcloc="WLC.PSA.30.5.002" x-head="true" lemma="רֶגַע" strong="H7281">moment</char>;</para>
