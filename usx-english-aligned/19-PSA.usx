	<para style="q1"><char style="w" x-id="t020" x-align="PSA.95.7.a014">To</char>-<char style="w" x-id="t021" x-align="PSA.95.7.a014" x-src="WLC.PSA.95.7.014 WLC.PSA.95.7.015" x-source="הַ֝ יּ֗וֹם" x-translit="ha yyôm" srcloc="WLC.PSA.95.7.015" x-head="true" lemma="יוֹם" strong="H3117">day</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">if ye will hear his voice, Harden etc.</char></char></note><char style="w" x-id="t022" x-align="PSA.95.7.a015">oh</char> <char style="w" x-id="t023" x-align="PSA.95.7.a015" x-src="WLC.PSA.95.7.016" x-source="אִֽם" x-translit="ʾim-" srcloc="WLC.PSA.95.7.016" x-head="true" lemma="אִם" strong="H518">that</char> <char style="w" x-id="t024" x-align="PSA.95.7.a019">ye</char> <char style="w" x-id="t025" x-align="PSA.95.7.a019">would</char> <char style="w" x-id="t026" x-align="PSA.95.7.a019" x-src="WLC.PSA.95.7.020" x-source="תִשְׁמָֽעוּ" x-translit="ṯišmāʿû:" srcloc="WLC.PSA.95.7.020" x-head="true" lemma="שָׁמַע" strong="H8085">hear</char> <char style="w" x-id="t027" x-align="PSA.95.7.a018" x-src="WLC.PSA.95.7.019" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.95.7.019" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t028" x-align="PSA.95.7.a017" x-src="WLC.PSA.95.7.018" x-source="קֹל֥" x-translit="qōl" srcloc="WLC.PSA.95.7.018" x-head="true" lemma="קוֹל" strong="H6963">voice</char>!<verse eid="PSA 95:7" /></para>
	<para style="q1"><verse number="8" style="v" sid="PSA 95:8" /><char style="w" x-id="t001" x-align="PSA.95.8.a002" x-src="WLC.PSA.95.8.002" x-source="תַּקְשׁ֣וּ" x-translit="taqšû" srcloc="WLC.PSA.95.8.002" x-head="true" lemma="קָשָׁה" strong="H7185">Harden</char> <char style="w" x-id="t002" x-align="PSA.95.8.a001" x-src="WLC.PSA.95.8.001" x-source="אַל" x-translit="ʾal-" srcloc="WLC.PSA.95.8.001" x-head="true" lemma="אַל" strong="H408">not</char> <char style="w" x-id="t003" x-align="PSA.95.8.a004" x-src="WLC.PSA.95.8.004" x-source="כֶם" x-translit="əḵem" srcloc="WLC.PSA.95.8.004" x-head="true" lemma="הוּא" strong="H3641b">your</char> <char style="w" x-id="t004" x-align="PSA.95.8.a003" x-src="WLC.PSA.95.8.003" x-source="לְ֭בַבְ" x-translit="ləḇaḇ" srcloc="WLC.PSA.95.8.003" x-head="true" lemma="לֵבָב" strong="H3824">heart</char>, <char style="w" x-id="t005" x-align="PSA.95.8.a005" x-src="WLC.PSA.95.8.005" x-source="כִּ" x-translit="ki" srcloc="WLC.PSA.95.8.005" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t006" x-align="PSA.95.8.a005">at</char> <note caller="-" style="f"><char style="ft">That is, <char style="it">strife</char>.</char></note><char style="w" x-id="t007" x-align="PSA.95.8.a006" x-src="WLC.PSA.95.8.006" x-source="מְרִיבָ֑ה" x-translit="mərîḇāh" srcloc="WLC.PSA.95.8.006" x-head="true" lemma="מְרִיבָה" strong="H4809">Meribah</char>,</para>
