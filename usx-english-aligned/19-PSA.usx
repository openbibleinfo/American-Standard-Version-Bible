	<para style="q1"><verse number="14" style="v" sid="PSA 17:14" /><char style="w" x-id="t001" x-align="PSA.17.14.a001" x-src="WLC.PSA.17.14.001" x-source="מִֽ" x-translit="mi" srcloc="WLC.PSA.17.14.001" x-head="true" lemma="מִן" strong="H4480">From</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">men who are thy hand</char></char></note><char style="w" x-id="t002" x-align="PSA.17.14.a002" x-src="WLC.PSA.17.14.002" x-source="מְתִ֥ים" x-translit="məṯiym" srcloc="WLC.PSA.17.14.002" x-head="true" lemma="מַת" strong="H4962">men</char> <char style="w" x-id="t003" x-align="PSA.17.14.a003">by</char> <char style="w" x-id="t004" x-align="PSA.17.14.a004" x-src="WLC.PSA.17.14.004" x-source="ךָ֨" x-translit="əḵā" srcloc="WLC.PSA.17.14.004" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t005" x-align="PSA.17.14.a003" x-src="WLC.PSA.17.14.003" x-source="יָדְ" x-translit="yāḏ" srcloc="WLC.PSA.17.14.003" x-head="true" lemma="יָד" strong="H3027">hand</char>, <char style="w" x-id="t006" x-align="PSA.17.14.a005">O</char> <char style="w" x-id="t007" x-align="PSA.17.14.a005" x-src="WLC.PSA.17.14.005" x-source="יְהוָ֡ה" x-translit="yəhwāh" srcloc="WLC.PSA.17.14.005" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.17.14.a006" x-src="WLC.PSA.17.14.006" x-source="מִֽ" x-translit="mi" srcloc="WLC.PSA.17.14.006" x-head="true" lemma="מִן" strong="H4480">From</char> <char style="w" x-id="t009" x-align="PSA.17.14.a007" x-src="WLC.PSA.17.14.007" x-source="מְתִ֬ים" x-translit="məṯiym" srcloc="WLC.PSA.17.14.007" x-head="true" lemma="מַת" strong="H4962">men</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">whose portion in life is of the world</char></char></note><char style="w" x-id="t010" x-align="PSA.17.14.a008" x-src="WLC.PSA.17.14.008" x-source="מֵ" x-translit="mē" srcloc="WLC.PSA.17.14.008" x-head="true" lemma="מִן" strong="H4480">of</char> <char style="w" x-id="t011" x-align="PSA.17.14.a009">the</char> <char style="w" x-id="t012" x-align="PSA.17.14.a009" x-src="WLC.PSA.17.14.009" x-source="חֶ֗לֶד" x-translit="ḥeleḏ" srcloc="WLC.PSA.17.14.009" x-head="true" lemma="חֶלֶד" strong="H2465">world</char>, <char style="w" x-id="t013" x-align="PSA.17.14.a011" x-src="WLC.PSA.17.14.011" x-source="ם" x-translit="ām" srcloc="WLC.PSA.17.14.011" x-head="true" lemma="הוּא" strong="H3963a">whose</char> <char style="w" x-id="t014" x-align="PSA.17.14.a010" x-src="WLC.PSA.17.14.010" x-source="חֶלְקָ֥" x-translit="ḥelq" srcloc="WLC.PSA.17.14.010" x-head="true" lemma="חֵלֶק" strong="H2506">portion</char> <char style="w" x-id="t015" x-align="PSA.17.14.a012">is</char> <char style="w" x-id="t016" x-align="PSA.17.14.a012" x-src="WLC.PSA.17.14.012" x-source="בַּֽ" x-translit="ba" srcloc="WLC.PSA.17.14.012" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="add"><char style="w" x-id="t017" x-align="PSA.17.14.a013" x-src="WLC.PSA.17.14.013" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.17.14.013" x-head="true" lemma="הַ" strong="H1886a">this</char></char> <char style="w" x-id="t018" x-align="PSA.17.14.a014" x-src="WLC.PSA.17.14.014" x-source="חַיִּים֮" x-translit="ḥayyîm" srcloc="WLC.PSA.17.14.014" x-head="true"