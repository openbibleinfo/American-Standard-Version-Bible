	<para style="q1"><verse number="4" style="v" sid="PSA 90:4" /><char style="w" x-id="t001" x-align="PSA.90.4.a001" x-src="WLC.PSA.90.4.001" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.PSA.90.4.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.90.4.a002">a</char> <char style="w" x-id="t003" x-align="PSA.90.4.a002" x-src="WLC.PSA.90.4.002" x-source="אֶ֪לֶף" x-translit="ʾelep̄" srcloc="WLC.PSA.90.4.002" x-head="true" lemma="אֶלֶף" strong="H505">thousand</char> <char style="w" x-id="t004" x-align="PSA.90.4.a003" x-src="WLC.PSA.90.4.003" x-source="שָׁנִ֡ים" x-translit="šāniym" srcloc="WLC.PSA.90.4.003" x-head="true" lemma="שָׁנָה" strong="H8141">years</char> <char style="w" x-id="t005" x-align="PSA.90.4.a004" x-src="WLC.PSA.90.4.004" x-source="בְּֽ" x-translit="bə" srcloc="WLC.PSA.90.4.004" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t006" x-align="PSA.90.4.a006" x-src="WLC.PSA.90.4.006" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.90.4.006" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t007" x-align="PSA.90.4.a005" x-src="WLC.PSA.90.4.005" x-source="עֵינֶ֗י" x-translit="ʿēyney" srcloc="WLC.PSA.90.4.005" x-head="true" lemma="עַיִן" strong="H5869">sight</char></para>
