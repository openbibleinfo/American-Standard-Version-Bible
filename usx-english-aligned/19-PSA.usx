	<para style="q1"><verse number="18" style="v" x-unrepresented-source="וַ ךָ" x-unrepresented-translit="wa eḵā" x-unrepresented-src="WLC.PSA.50.18.004 WLC.PSA.50.18.012" sid="PSA 50:18" /><char style="w" x-id="t001" x-align="PSA.50.18.a001" x-src="WLC.PSA.50.18.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.PSA.50.18.001" x-head="true" lemma="אִם" strong="H518">When</char> <char style="w" x-id="t002" x-align="PSA.50.18.a002">thou</char> <char style="w" x-id="t003" x-align="PSA.50.18.a002" x-src="WLC.PSA.50.18.002" x-source="רָאִ֣יתָ" x-translit="rāʾiyṯā" srcloc="WLC.PSA.50.18.002" x-head="true" lemma="רָאָה" strong="H7200">sawest</char> <char style="w" x-id="t004" x-align="PSA.50.18.a003">a</char> <char style="w" x-id="t005" x-align="PSA.50.18.a003" x-src="WLC.PSA.50.18.003" x-source="גַ֭נָּב" x-translit="ḡannāḇ" srcloc="WLC.PSA.50.18.003" x-head="true" lemma="גַּנָּב" strong="H1590">thief</char>, <char style="w" x-id="t006" x-align="PSA.50.18.a005">thou</char> <char style="w" x-id="t007" x-align="PSA.50.18.a005" x-src="WLC.PSA.50.18.005" x-source="תִּ֣רֶץ" x-translit="tireṣ" srcloc="WLC.PSA.50.18.005" x-head="true" lemma="רָצָה" strong="H7521">consentedst</char> <char style="w" x-id="t008" x-align="PSA.50.18.a006" x-src="WLC.PSA.50.18.006" x-source="עִמּ֑" x-translit="ʿimm" srcloc="WLC.PSA.50.18.006" x-head="true" lemma="עִם" strong="H5973">with</char> <char style="w" x-id="t009" x-align="PSA.50.18.a007" x-src="WLC.PSA.50.18.007" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.50.18.007" x-head="true" lemma="הוּא" strong="H2050c">him</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.50.18.a008" x-src="WLC.PSA.50.18.008" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.50.18.008" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">thy portion was with adulterers</char>.</char></note><char style="w" x-id="t011" x-align="PSA.50.18.a011">hast</char> <char style="w" x-id="t012" x-align="PSA.50.18.a011">been</char> <char style="w" x-id="t013" x-align="PSA.50.18.a011" x-src="WLC.PSA.50.18.011" x-source="חֶלְקֶֽ" x-translit="ḥelq" srcloc="WLC.PSA.50.18.011" x-head="true" lemma="חֵלֶק" strong="H2506">partaker</char> <char style="w" x-id="t014" x-align="PSA.50.18.a009" x-src="WLC.PSA.50.18.009" x-source="עִ֖ם" x-translit="ʿim" srcloc="WLC.PSA.50.18.009" x-head="true" lemma="עִם" strong="H5973">with</char> <char style="w" x-id="t015" x-align="PSA.50.18.a010" x-src="WLC.PSA.50.18.010" x-source="מְנָאֲפִ֣ים" x-translit="mənāʾăp̄iym" srcloc="WLC.PSA.50.18.010" x-head="true" lemma="נָאַף" strong="H5003">adulterers</char>.<verse eid="PSA 50:18" /></para>
	<para style="q1"><verse number="19" style="v" sid="PSA 50:19" /><char style="w" x-id="t001" x-align="PSA.50.19.a003">Thou</char> <char style="w" x-id="t002" x-align="PSA.50.19.a003" x-src="WLC.PSA.50.19.003" x-source="שָׁלַ֣חְתָּ" x-translit="šālaḥətā" srcloc="WLC.PSA.50.19.003" x-head="true" lemma="שָׁלַח" strong="H7971">givest</char> <char style="w" x-id="t003" x-align="PSA.50.19.a002" x-src="WLC.PSA.50.19.002" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.50.19.002" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t004" x-align="PSA.50.19.a001" x-src="WLC.PSA.50.19.001" x-source="פִּ֭י" x-translit="piy" srcloc="WLC.PSA.50.19.001" x-head="true" lemma="פֶּה" strong="H6310">mouth</char> <char style="w" x-id="t005" x-align="PSA.50.19.a004" x-src="WLC.PSA.50.19.004" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.50.19.004" x-head="true" lemma="בְּ" strong="H871a">to</char> <char style="w" x-id="t006" x-align="PSA.50.19.a005" x-src="WLC.PSA.50.19.005" x-source="רָעָ֑ה" x-translit="rāʿāh" srcloc="WLC.PSA.50.19.005" x-head="true" lemma="רָעָה" strong="H7451b">evil</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.50.19.a006" x-src="WLC.PSA.50.19.006" x-source="וּ֝" x-translit="û" srcloc="WLC.PSA.50.19.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t008" x-align="PSA.50.19.a008" x-src="WLC.PSA.50.19.008" x-source="ךָ֗" x-translit="əḵā" srcloc="WLC.PSA.50.19.008" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t009" x-align="PSA.50.19.a007" x-src="WLC.PSA.50.19.007" x-source="לְשׁוֹנְ" x-translit="ləšôn" srcloc="WLC.PSA.50.19.007" x-head="true" lemma="לָשׁוֹן" strong="H3956">tongue</char> <char style="w" x-id="t010" x-align="PSA.50.19.a009" x-src="WLC.PSA.50.19.009" x-source="תַּצְמִ֥יד" x-translit="taṣmiyḏ" srcloc="WLC.PSA.50.19.009" x-head="true" lemma="צָמַד" strong="H6775">frameth</char> <char style="w" x-id="t011" x-align="PSA.50.19.a010" x-src="WLC.PSA.50.19.010" x-source="מִרְמָֽה" x-translit="mirmāh:" srcloc="WLC.PSA.50.19.010" x-head="true" lemma="מִרְמָה" strong="H4820">deceit</char>.<verse eid="PSA 50:19" /></para>
	<para style="q1"><verse number="20" style="v" x-unrepresented-source="בְּ" x-unrepresented-translit="bə" x-unrepresented-src="WLC.PSA.50.20.006" sid="PSA 50:20" /><char style="w" x-id="t001" x-align="PSA.50.20.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.50.20.a001" x-src="WLC.PSA.50.20.001" x-source="תֵּ֭שֵׁב" x-translit="tēšēḇ" srcloc="WLC.PSA.50.20.001" x-head="true" lemma="יָשַׁב" strong="H3427">sittest</char> <char style="w" x-id="t003" x-align="PSA.50.20.a002" x-status="added" x-source="∅" x-head="true">and</char> <char style="w" x-id="t004" x-align="PSA.50.20.a006" x-src="WLC.PSA.50.20.005" x-source="תְדַבֵּ֑ר" x-translit="ṯəḏabbēr" srcloc="WLC.PSA.50.20.005" x-head="true" lemma="דָבַר" strong="H1696">speakest</char> <char style="w" x-id="t005" x-align="PSA.50.20.a003" x-src="WLC.PSA.50.20.002" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.50.20.002" x-head="true" lemma="בְּ" strong="H871a">against</char> <char style="w" x-id="t006" x-align="PSA.50.20.a005" x-src="WLC.PSA.50.20.004" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.50.20.004" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t007" x-align="PSA.50.20.a004" x-src="WLC.PSA.50.20.003" x-source="אָחִ֣י" x-translit="ʾāḥiy" srcloc="WLC.PSA.50.20.003" x-head="true" lemma="אָח" strong="H251">brother</char>;</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.50.20.a011">Thou</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">givest a thrust against</char></char></note><char style="w" x-id="t009" x-align="PSA.50.20.a011" x-src="WLC.PSA.50.20.010 WLC.PSA.50.20.011" x-source="תִּתֶּן דֹּֽפִי" x-translit="titten- dōp̄î:" srcloc="WLC.PSA.50.20.011" x-head="true" lemma="דֳּפִי" strong="H1848">slanderest</char> <char style="w" x-id="t010" x-align="PSA.50.20.a010" x-src="WLC.PSA.50.20.009" x-source="ךָ֗" x-translit="əḵā" srcloc="WLC.PSA.50.20.009" x-head="true" lemma="הוּא" strong="H3509b">thine</char> <char style="w" x-id="t011" x-align="PSA.50.20.a010">own</char> <char style="w" x-id="t012" x-align="PSA.50.20.a009" x-src="WLC.PSA.50.20.008" x-source="אִ֝מְּ" x-translit="ʾimm" srcloc="WLC.PSA.50.20.008" x-head="true" lemma="אֵם" strong="H517">mother’s</char> <char style="w" x-id="t013" x-align="PSA.50.20.a008" x-src="WLC.PSA.50.20.007" x-source="בֶֽן" x-translit="ḇen-" srcloc="WLC.PSA.50.20.007" x-head="true" lemma="בֵּן" strong="H1121">son</char>.<verse eid="PSA 50:20" /></para>
	<para style="q1"><verse number="21" style="v" sid="PSA 50:21" /><char style="w" x-id="t001" x-align="PSA.50.21.a001" x-src="WLC.PSA.50.21.001" x-source="אֵ֤לֶּה" x-translit="ʾēlleh" srcloc="WLC.PSA.50.21.001" x-head="true" lemma="אֵלֶּה" strong="H428">These</char> <char style="w" x-id="t002" x-align="PSA.50.21.a001">things</char> <char style="w" x-id="t003" x-align="PSA.50.21.a002">hast</char> <char style="w" x-id="t004" x-align="PSA.50.21.a002">thou</char> <char style="w" x-id="t005" x-align="PSA.50.21.a002" x-src="WLC.PSA.50.21.002" x-source="עָשִׂ֨יתָ" x-translit="ʿāśiyṯā" srcloc="WLC.PSA.50.21.002" x-head="true" lemma="עָשָׂה" strong="H6213">done</char>, <char style="w" x-id="t006" x-align="PSA.50.21.a003" x-src="WLC.PSA.50.21.003" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.50.21.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t007" x-align="PSA.50.21.a004">I</char> <char style="w" x-id="t008" x-align="PSA.50.21.a004">kept</char> <char style="w" x-id="t009" x-align="PSA.50.21.a004" x-src="WLC.PSA.50.21.004" x-source="הֶחֱרַ֗שְׁתִּי" x-translit="heḥĕrašətî" srcloc="WLC.PSA.50.21.004" x-head="true" lemma="חָרֵשׁ" strong="H2790a">silence</char>;</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.50.21.a005">Thou</char> <char style="w" x-id="t011" x-align="PSA.50.21.a005" x-src="WLC.PSA.50.21.005" x-source="דִּמִּ֗יתָ" x-translit="dimmiyṯā" srcloc="WLC.PSA.50.21.005" x-head="true" lemma="דָּמָה" strong="H1819">thoughtest</char> <char style="w" x-id="t012" x-align="PSA.50.21.a006" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t013" x-align="PSA.50.21.a008">I</char> <char style="w" x-id="t014" x-align="PSA.50.21.a008" x-src="WLC.PSA.50.21.007" x-source="אֶֽהְיֶ֥ה" x-translit="ʾehəyeh" srcloc="WLC.PSA.50.21.007" x-head="true" lemma="הָיָה" strong="H1961">was</char> <char style="w" x-id="t015" x-align="PSA.50.21.a007" x-src="WLC.PSA.50.21.006" x-source="הֱֽיוֹת" x-translit="hĕyôṯ-" srcloc="WLC.PSA.50.21.006" x-head="true" lemma="הָיָה" strong="H1961">altogether</char> <char style="w" x-id="t016" x-align="PSA.50.21.a009">such</char> <char style="w" x-id="t017" x-align="PSA.50.21.a009">a</char> <char style="w" x-id="t018" x-align="PSA.50.21.a009">one</char> <char style="w" x-id="t019" x-align="PSA.50.21.a009" x-src="WLC.PSA.50.21.008" x-source="כָמ֑וֹ" x-translit="ḵāmô" srcloc="WLC.PSA.50.21.008" x-head="true" lemma="כְּמוֹ" strong="H3644">as</char> <char style="w" x-id="t020" x-align="PSA.50.21.a010" x-src="WLC.PSA.50.21.009" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.50.21.009" x-head="true" lemma="הוּא" strong="H3509b">thyself</char>:</para>
