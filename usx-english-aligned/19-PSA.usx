	<para style="q1"><char style="w" x-id="t001" x-align="PSA.45.1.a003" x-src="WLC.PSA.45.1.003" x-source="י" x-translit="iy" srcloc="WLC.PSA.45.1.003" x-head="true" lemma="הוּא" strong="H2967a">My</char> <char style="w" x-id="t002" x-align="PSA.45.1.a002" x-src="WLC.PSA.45.1.002" x-source="לִבִּ֨" x-translit="libb" srcloc="WLC.PSA.45.1.002" x-head="true" lemma="לֵב" strong="H3820">heart</char> <char style="w" x-id="t003" x-align="PSA.45.1.a001" x-src="WLC.PSA.45.1.001" x-source="רָ֘חַ֤שׁ" x-translit="rāḥaš" srcloc="WLC.PSA.45.1.001" x-head="true" lemma="רָחַשׁ" strong="H7370">overfloweth</char> <char style="w" x-id="t004" x-align="PSA.45.1.a001">with</char> <char style="w" x-id="t005" x-align="PSA.45.1.a004">a</char> <char style="w" x-id="t006" x-align="PSA.45.1.a005" x-src="WLC.PSA.45.1.005" x-source="ט֗וֹב" x-translit="ṭôḇ" srcloc="WLC.PSA.45.1.005" x-head="true" lemma="טוֹב" strong="H2896">goodly</char> <char style="w" x-id="t007" x-align="PSA.45.1.a004" x-src="WLC.PSA.45.1.004" x-source="דָּ֘בָ֤ר" x-translit="dāḇār" srcloc="WLC.PSA.45.1.004" x-head="true" lemma="דָּבָר" strong="H1697">matter</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">I speak: my work is for a king</char></char></note><char style="w" x-id="t008" x-align="PSA.45.1.a007" x-src="WLC.PSA.45.1.007" x-source="אָ֭נִי" x-translit="ʾānî" srcloc="WLC.PSA.45.1.007" x-head="true" lemma="אֲנִי" strong="H589">I</char> <char style="w" x-id="t009" x-align="PSA.45.1.a006" x-src="WLC.PSA.45.1.006" x-source="אֹמֵ֣ר" x-translit="ʾōmēr" srcloc="WLC.PSA.45.1.006" x-head="true" lemma="אָמַר" strong="H559">speak</char> <char style="w" x-id="t010" x-align="PSA.45.1.a008">the</char> <char style="w" x-id="t011" x-align="PSA.45.1.a008">things</char> <char style="w" x-id="t012" x-align="PSA.45.1.a008">which</char> <char style="w" x-id="t013" x-align="PSA.45.1.a009" x-src="WLC.PSA.45.1.009" x-source="י" x-translit="ay" srcloc="WLC.PSA.45.1.009" x-head="true" lemma="הוּא" strong="H2967a">I</char> <char style="w" x-id="t014" x-align="PSA.45.1.a008">have</char> <char style="w" x-id="t015" x-align="PSA.45.1.a008" x-src="WLC.PSA.45.1.008" x-source="מַעֲשַׂ֣" x-translit="maʿăś" srcloc="WLC.PSA.45.1.008" x-head="true" lemma="מַעֲשֶׂה" strong="H4639">made</char> <char style="w" x-id="t016" x-align="PSA.45.1.a010" x-src="WLC.PSA.45.1.010" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.45.1.010" x-head="true" lemma="לְ" strong="H3807a">touching</char> <char style="w" x-id="t017" x-align="PSA.45.1.a011">the</char> <char style="w" x-id="t018" x-align="PSA.45.1.a011" x-src="WLC.PSA.45.1.011" x-source="מֶ֑לֶךְ" x-translit="meleḵ" srcloc="WLC.PSA.45.1.011" x-head="true" lemma="מֶלֶךְ" strong="H4428">king</char>:</para>
	<para style="q1"><char style="w" x-id="t019" x-align="PSA.45.1.a013" x-src="WLC.PSA.45.1.013" x-source="י" x-translit="iy" srcloc="WLC.PSA.45.1.013" x-head="true" lemma="הוּא" strong="H2967a">My</char> <char style="w" x-id="t020" x-align="PSA.45.1.a012" x-src="WLC.PSA.45.1.012" x-source="לְ֝שׁוֹנִ֗" x-translit="ləšôn" srcloc="WLC.PSA.45.1.012" x-head="true" lemma="לָשׁוֹן" strong="H3956">tongue</char> <char style="w" x-id="t021" x-align="PSA.45.1.a014">is</char> <char style="w" x-id="t022" x-align="PSA.45.1.a014">the</char> <char style="w" x-id="t023" x-align="PSA.45.1.a014" x-src="WLC.PSA.45.1.014" x-source="עֵ֤ט" x-translit="ʿēṭ" srcloc="WLC.PSA.45.1.014" x-head="true" lemma="עֵט" strong="H5842">pen</char> <char style="w" x-id="t024" x-align="PSA.45.1.a015">of</char> <char style="w" x-id="t025" x-align="PSA.45.1.a015">a</char> <char style="w" x-id="t026" x-align="PSA.45.1.a016" x-src="WLC.PSA.45.1.016" x-source="מָהִֽיר" x-translit="māhiyr:" srcloc="WLC.PSA.45.1.016" x-head="true" lemma="מָהִיר" strong="H4106">ready</char> <char style="w" x-id="t027" x-align="PSA.45.1.a015" x-src="WLC.PSA.45.1.015" x-source="סוֹפֵ֬ר" x-translit="sôp̄ēr" srcloc="WLC.PSA.45.1.015" x-head="true" lemma="סֹפֵר" strong="H5608a">writer</char>.<verse eid="PSA 45:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 45:2" /><char style="w" x-id="t001" x-align="PSA.45.2.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.45.2.a001">art</char> <char style="w" x-id="t003" x-align="PSA.45.2.a001" x-src="WLC.PSA.45.2.001" x-source="יָפְיָפִ֡יתָ" x-translit="yāp̄əyāp̄iyṯā" srcloc="WLC.PSA.45.2.001" x-head="true" lemma="יָפָה" strong="H3302">fairer</char> <char style="w" x-id="t004" x-align="PSA.45.2.a002" x-src="WLC.PSA.45.2.002" x-source="מִ" x-translit="mi" srcloc="WLC.PSA.45.2.002" x-head="true" lemma="מִן" strong="H4480">than</char> <char style="w" x-id="t005" x-align="PSA.45.2.a003">the</char> <char style="w" x-id="t006" x-align="PSA.45.2.a003" x-src="WLC.PSA.45.2.003" x-source="בְּנֵ֬י" x-translit="bənēy" srcloc="WLC.PSA.45.2.003" x-head="true" lemma="בֵּן" strong="H1121">children</char> <char style="w" x-id="t007" x-align="PSA.45.2.a004">of</char> <char style="w" x-id="t008" x-align="PSA.45.2.a004" x-src="WLC.PSA.45.2.004" x-source="אָדָ֗ם" x-translit="ʾāḏām" srcloc="WLC.PSA.45.2.004" x-head="true" lemma="אָדָם" strong="H120">men</char>;</para>
