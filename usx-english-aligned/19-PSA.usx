	<chapter eid="PSA 43" />
	<chapter number="44" style="c" sid="PSA 44" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="לָ֑" x-unrepresented-translit="l" x-unrepresented-src="WLC.PSA.44.1.009" sid="PSA 44:1" />Former deliverances and present troubles.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.44.0.a001" x-src="WLC.PSA.44.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.44.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.44.0.a002" x-src="WLC.PSA.44.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.44.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.44.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.44.0.a003" x-src="WLC.PSA.44.0.003" x-source="מְנַצֵּ֬חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.44.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="add"><char style="w" x-id="t005" x-align="PSA.44.0.a004" x-status="added">A</char> <char style="w" x-id="t006" x-align="PSA.44.0.a004" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t007" x-align="PSA.44.0.a005" x-src="WLC.PSA.44.0.004" x-source="לִ" x-translit="li" srcloc="WLC.PSA.44.0.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.44.0.a006">the</char> <char style="w" x-id="t009" x-align="PSA.44.0.a006" x-src="WLC.PSA.44.0.005" x-source="בְנֵי" x-translit="ḇənê-" srcloc="WLC.PSA.44.0.005" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t010" x-align="PSA.44.0.a007">of</char> <char style="w" x-id="t011" x-align="PSA.44.0.a007" x-src="WLC.PSA.44.0.006" x-source="קֹ֬רַח" x-translit="qōraḥ" srcloc="WLC.PSA.44.0.006" x-head="true" lemma="קֹרַח" strong="H7141">Korah</char>. <char style="w" x-id="t012" x-align="PSA.44.0.a008" x-src="WLC.PSA.44.0.007" x-source="מַשְׂכִּֽיל" x-translit="maśkiyl:" srcloc="WLC.PSA.44.0.007" x-head="true" lemma="מַשְׂכִּיל" strong="H4905">Maschil</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.44.1.a005">We</char> <char style="w" x-id="t002" x-align="PSA.44.1.a005">have</char> <char style="w" x-id="t003" x-align="PSA.44.1.a005" x-src="WLC.PSA.44.1.005" x-source="שָׁמַ֗עְנוּ" x-translit="šāmaʿənû" srcloc="WLC.PSA.44.1.005" x-head="true" lemma="שָׁמַע" strong="H8085">heard</char> <char style="w" x-id="t004" x-align="PSA.44.1.a002" x-src="WLC.PSA.44.1.002" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.44.1.002" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t005" x-align="PSA.44.1.a004" x-src="WLC.PSA.44.1.004" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.44.1.004" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t006" x-align="PSA.44.1.a003" x-src="WLC.PSA.44.1.003" x-source="אָזְנֵ֬י" x-translit="ʾāzənēy" srcloc="WLC.PSA.44.1.003" x-head="true" lemma="אֹזֶן" strong="H241">ears</char>, <char style="w" x-id="t007" x-align="PSA.44.1.a001">O</char> <char style="w" x-id="t008" x-align="PSA.44.1.a001" x-src="WLC.PSA.44.1.001" x-source="אֱלֹהִ֤ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.44.1.001" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>,</para>
