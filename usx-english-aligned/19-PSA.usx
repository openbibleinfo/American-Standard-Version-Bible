	<para style="q1"><char style="w" x-id="t007" x-align="PSA.117.1.a006" x-src="WLC.PSA.117.1.006" x-source="שַׁ֝בְּח֗וּ" x-translit="šabbəḥû" srcloc="WLC.PSA.117.1.006" x-head="true" lemma="שָׁבַח" strong="H7623">Laud</char> <char style="w" x-id="t008" x-align="PSA.117.1.a007" x-src="WLC.PSA.117.1.007" x-source="הוּ" x-translit="hû" srcloc="WLC.PSA.117.1.007" x-head="true" lemma="הוּא" strong="H1930a">him</char>, <char style="w" x-id="t009" x-align="PSA.117.1.a008" x-src="WLC.PSA.117.1.008" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.117.1.008" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t010" x-align="PSA.117.1.a010">ye</char> <char style="w" x-id="t011" x-align="PSA.117.1.a010" x-src="WLC.PSA.117.1.010" x-source="אֻמִּֽים" x-translit="ʾummiym:" srcloc="WLC.PSA.117.1.010" x-head="true" lemma="אֻמָּה" strong="H523">peoples</char>.<verse eid="PSA 117:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 117:2" /><char style="w" x-id="t001" x-align="PSA.117.2.a001" x-src="WLC.PSA.117.2.001" x-source="כִּ֥י" x-translit="kiy" srcloc="WLC.PSA.117.2.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.117.2.a006" x-src="WLC.PSA.117.2.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.117.2.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t003" x-align="PSA.117.2.a005" x-src="WLC.PSA.117.2.005" x-source="חַסְדּ֗" x-translit="ḥasd" srcloc="WLC.PSA.117.2.005" x-head="true" lemma="חֶסֶד" strong="H2617">lovingkindness</char> <char style="w" x-id="t004" x-align="PSA.117.2.a002">is</char> <char style="w" x-id="t005" x-align="PSA.117.2.a002" x-src="WLC.PSA.117.2.002" x-source="גָ֘בַ֤ר" x-translit="ḡāḇar" srcloc="WLC.PSA.117.2.002" x-head="true" lemma="גָּבַר" strong="H1396">great</char> <char style="w" x-id="t006" x-align="PSA.117.2.a003" x-src="WLC.PSA.117.2.003" x-source="עָלֵ֨י" x-translit="ʿālēy" srcloc="WLC.PSA.117.2.003" x-head="true" lemma="עַל" strong="H5921">toward</char> <char style="w" x-id="t007" x-align="PSA.117.2.a004" x-src="WLC.PSA.117.2.004" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.117.2.004" x-head="true" lemma="הוּא" strong="H5105a">us</char>;</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.117.2.a007" x-src="WLC.PSA.117.2.007" x-source="וֶֽ" x-translit="we" srcloc="WLC.PSA.117.2.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t009" x-align="PSA.117.2.a008">the</char> <char style="w" x-id="t010" x-align="PSA.117.2.a008" x-src="WLC.PSA.117.2.008" x-source="אֱמֶת" x-translit="ʾĕmeṯ-" srcloc="WLC.PSA.117.2.008" x-head="true" lemma="אֱמֶת" strong="H571">truth</char> <char style="w" x-id="t011" x-align="PSA.117.2.a009">of</char> <char style="w" x-id="t012" x-align="PSA.117.2.a009" x-src="WLC.PSA.117.2.009" x-source="יְהוָ֥ה" x-translit="yəhwāh" srcloc="WLC.PSA.117.2.009" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="add"><char style="w" x-id="t013" x-align="PSA.117.2.a010">endureth</char></char> <char style="w" x-id="t014" x-align="PSA.117.2.a010" x-src="WLC.PSA.117.2.010" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.117.2.010" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t015" x-align="PSA.117.2.a011" x-src="WLC.PSA.117.2.011" x-source="עוֹלָ֗ם" x-translit="ʿôlām" srcloc="WLC.PSA.117.2.011" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char>.</para>
