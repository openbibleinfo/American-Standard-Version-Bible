	<para style="s1"><verse number="1" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.PSA.37.1.006" sid="PSA 37:1" />Security of those who trust in Jehovah, and insecurity of the wicked.</para>
	<para style="d"><char style="add"><char style="w" x-id="t001" x-align="PSA.37.1.a001" x-status="added">A</char> <char style="w" x-id="t002" x-align="PSA.37.1.a001" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t003" x-align="PSA.37.1.a002" x-src="WLC.PSA.37.1.001" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.37.1.001" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.37.1.a003" x-src="WLC.PSA.37.1.002" x-source="דָוִ֨ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.37.1.002" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
