	<para style="q1"><verse number="37" style="v" sid="PSA 89:37" /><note caller="-" style="f"><char style="ft">Or, <char style="it">As the moon which is established for ever</char></char></note><char style="w" x-id="t001" x-align="PSA.89.37.a003">It</char> <char style="w" x-id="t002" x-align="PSA.89.37.a003">shall</char> <char style="w" x-id="t003" x-align="PSA.89.37.a003">be</char> <char style="w" x-id="t004" x-align="PSA.89.37.a003" x-src="WLC.PSA.89.37.003" x-source="יִכּ֣וֹן" x-translit="yikôn" srcloc="WLC.PSA.89.37.003" x-head="true" lemma="כּוּן" strong="H3559">established</char> <char style="w" x-id="t005" x-align="PSA.89.37.a004">for</char> <char style="w" x-id="t006" x-align="PSA.89.37.a004" x-src="WLC.PSA.89.37.004" x-source="עוֹלָ֑ם" x-translit="ʿôlām" srcloc="WLC.PSA.89.37.004" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char> <char style="w" x-id="t007" x-align="PSA.89.37.a001" x-src="WLC.PSA.89.37.001" x-source="כְּ֭" x-translit="kə" srcloc="WLC.PSA.89.37.001" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t008" x-align="PSA.89.37.a002">the</char> <char style="w" x-id="t009" x-align="PSA.89.37.a002" x-src="WLC.PSA.89.37.002" x-source="יָרֵחַ" x-translit="yārēᵃḥ" srcloc="WLC.PSA.89.37.002" x-head="true" lemma="יָרֵחַ" strong="H3394">moon</char>,</para>
