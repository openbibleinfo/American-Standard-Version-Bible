	<chapter number="56" style="c" sid="PSA 56" />
	<para style="s1"><verse number="1" style="v" sid="PSA 56:1" />Supplication for deliverance, and grateful trust in God.</para>
	<para style="d" x-unrepresented-source="אֹת֖" x-unrepresented-translit="ʾōṯ" x-unrepresented-src="WLC.PSA.56.0.013"><char style="w" x-id="t001" x-align="PSA.56.0.a001" x-src="WLC.PSA.56.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.56.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.56.0.a002" x-src="WLC.PSA.56.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.56.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.56.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.56.0.a003" x-src="WLC.PSA.56.0.003" x-source="מְנַצֵּ֤חַ" x-translit="mənaṣṣēḥa" srcloc="WLC.PSA.56.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="w" x-id="t005" x-align="PSA.56.0.a004">set</char> <char style="w" x-id="t006" x-align="PSA.56.0.a004" x-src="WLC.PSA.56.0.004" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.56.0.004" x-head="true" lemma="עַל" strong="H5921">to</char> <note caller="-" style="f"><char style="ft">That is, <char style="it">The silent dove of them that are afar off</char>. Or, as otherwise read, <char style="it">The dove of the distant terebinths</char>.</char></note><char style="w" x-id="t007" x-align="PSA.56.0.a005" x-src="WLC.PSA.56.0.005" x-source="י֬וֹנַת" x-translit="yônaṯ" srcloc="WLC.PSA.56.0.005" x-head="true" lemma="יוֹנָה" strong="H3123">Jonath</char> <char style="w" x-id="t008" x-align="PSA.56.0.a006" x-src="WLC.PSA.56.0.006" x-source="אֵ֣לֶם" x-translit="ʾēlem" srcloc="WLC.PSA.56.0.006" x-head="true" lemma="אֵלֶם" strong="H482">elem</char> <char style="w" x-id="t009" x-align="PSA.56.0.a007" x-src="WLC.PSA.56.0.007" x-source="רְ֭חֹקִים" x-translit="rəḥōqîm" srcloc="WLC.PSA.56.0.007" x-head="true" lemma="רָחֹוק" strong="H7350">rehokim</char>. <char style="add"><char style="w" x-id="t010" x-align="PSA.56.0.a010" x-status="added">A</char> <char style="w" x-id="t011" x-align="PSA.56.0.a010" x-status="added" x-sourc