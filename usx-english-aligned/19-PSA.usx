	<chapter number="85" style="c" sid="PSA 85" />
	<para style="s1"><verse number="1" style="v" sid="PSA 85:1" />Prayer for God’s mercy upon the nation.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.85.0.a001" x-src="WLC.PSA.85.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.85.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.85.0.a002" x-src="WLC.PSA.85.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.85.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.85.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.85.0.a003" x-src="WLC.PSA.85.0.003" x-source="מְנַצֵּ֬חַ" x-translit="mənaṣṣēḥa" srcloc="WLC.PSA.85.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.85.0.a007">A</char> <char style="w" x-id="t006" x-align="PSA.85.0.a007" x-src="WLC.PSA.85.0.007" x-source="מִזְמֽוֹר" x-translit="mizmôr:" srcloc="WLC.PSA.85.0.007" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t007" x-align="PSA.85.0.a004" x-src="WLC.PSA.85.0.004" x-source="לִ" x-translit="li" srcloc="WLC.PSA.85.0.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.85.0.a005">the</char> <char style="w" x-id="t009" x-align="PSA.85.0.a005" x-src="WLC.PSA.85.0.005" x-source="בְנֵי" x-translit="ḇənê-" srcloc="WLC.PSA.85.0.005" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t010" x-align="PSA.85.0.a006">of</char> <char style="w" x-id="t011" x-align="PSA.85.0.a006" x-src="WLC.PSA.85.0.006" x-source="קֹ֬רַח" x-translit="qōraḥ" srcloc="WLC.PSA.85.0.006" x-head="true" lemma="קֹרַח" strong="H7141">Korah</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.85.1.a001" x-src="WLC.PSA.85.1.002" x-source="יְהוָ֣ה" x-translit="yəhwāh" srcloc="WLC.PSA.85.1.002" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t002" x-align="PSA.85.1.a002">thou</char> <char style="w" x-id="t003" x-align="PSA.85.1.a002">hast</char> <char style="w" x-id="t004" x-align="PSA.85.1.a002">been</char> <char style="w" x-id="t005" x-align="PSA.85.1.a002" x-src="WLC.PSA.85.1.001" x-source="רָצִ֣יתָ" x-translit="rāṣiyṯā" srcloc="WLC.PSA.85.1.001" x-head="true" lemma="רָצָה" strong="H7521">favorable</char> <char style="w" x-id="t006" x-align="PSA.85.1.a002">unto</char> <char style="w" x-id="t007" x-align="PSA.85.1.a003" x-src="WLC.PSA.85.1.004" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.85.1.004" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t008" x-align="PSA.85.1.a004" x-src="WLC.PSA.85.1.003" x-source="אַרְצֶ֑" x-translit="ʾarṣ" srcloc="WLC.PSA.85.1.003" x-head="true" lemma="אֶרֶץ" strong="H776">land</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.85.1.a005">Thou</char> <char style="w" x-id="t010" x-align="PSA.85.1.a005">hast</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">returned to</char></char></note><char style="w" x-id="t011" x-align="PSA.85.1.a005" x-src="WLC.PSA.85.1.005" x-source="שַׁ֝֗בְתָּ" x-translit="šaḇətā" srcloc="WLC.PSA.85.1.005" x-head="true" lemma="שׁוּב" strong="H7725">brought</char> <char style="w" x-id="t012" x-align="PSA.85.1.a005">back</char> <char style="w" x-id="t013" x-align="PSA.85.1.a006">the</char> <char style="w" x-id="t014" x-align="PSA.85.1.a006" x-src="WLC.PSA.85.1.006" x-source="שְׁבִ֣ית" x-translit="**šəḇiyṯ" srcloc="WLC.PSA.85.1.006" x-head="true" lemma="שְׁבִית" strong="H7622a">captivity</char> <char style="w" x-id="t015" x-align="PSA.85.1.a007">of</char> <char style="w" x-id="t016" x-align="PSA.85.1.a007" x-src="WLC.PSA.85.1.007" x-source="יַעֲקֹֽב" x-translit="yaʿăqōḇ:" srcloc="WLC.PSA.85.1.007" x-head="true" lemma="יַעֲקֹב" strong="H3290">Jacob</char>.<verse eid="PSA 85:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 85:2" /><char style="w" x-id="t001" x-align="PSA.85.2.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.85.2.a001">hast</char> <char style="w" x-id="t003" x-align="PSA.85.2.a001" x-src="WLC.PSA.85.2.001" x-source="נָ֭שָׂאתָ" x-translit="nāśāʾṯā" srcloc="WLC.PSA.85.2.001" x-head="true" lemma="נָשָׂא" strong="H5375">forgiven</char> <char style="w" x-id="t004" x-align="PSA.85.2.a002">the</char> <char style="w" x-id="t005" x-align="PSA.85.2.a002" x-src="WLC.PSA.85.2.002" x-source="עֲוֺ֣ן" x-translit="ʿăwōn" srcloc="WLC.PSA.85.2.002" x-head="true" lemma="עָוֺן" strong="H5771">iniquity</char> <char style="w" x-id="t006" x-align="PSA.85.2.a003">of</char> <char style="w" x-id="t007" x-align="PSA.85.2.a004" x-src="WLC.PSA.85.2.004" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.85.2.004" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t008" x-align="PSA.85.2.a003" x-src="WLC.PSA.85.2.003" x-source="עַמֶּ֑" x-translit="ʿamm" srcloc="WLC.PSA.85.2.003" x-head="true" lemma="עַם" strong="H5971">people</char>;</para>
