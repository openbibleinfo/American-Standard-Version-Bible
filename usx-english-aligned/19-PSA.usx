	<para style="q1"><char style="w" x-id="t001" x-align="PSA.68.19.a001" x-src="WLC.PSA.68.19.001" x-source="בָּ֤ר֣וּךְ" x-translit="bārûḵ" srcloc="WLC.PSA.68.19.001" x-head="true" lemma="בָּרַךְ" strong="H1288">Blessed</char> <char style="w" x-id="t002" x-align="PSA.68.19.a001">be</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">the Lord day by day: if one oppresseth us, God is our salvation</char></char></note><char style="w" x-id="t003" x-align="PSA.68.19.a002">the</char> <char style="w" x-id="t004" x-align="PSA.68.19.a002" x-src="WLC.PSA.68.19.002" x-source="אֲדֹנָ" x-translit="ʾăḏōn" srcloc="WLC.PSA.68.19.002" x-head="true" lemma="אֲדֹנָי" strong="H136">Lord</char>, <char style="w" x-id="t005" x-align="PSA.68.19.a005" x-status="added" x-source="∅" x-head="true">who</char> <char style="w" x-id="t006" x-align="PSA.68.19.a004" x-src="WLC.PSA.68.19.004 WLC.PSA.68.19.005" x-source="י֤וֹם י֥וֹם" x-translit="yôm yôm" srcloc="WLC.PSA.68.19.004" x-head="true" lemma="יוֹם" strong="H3117">daily</char> <char style="w" x-id="t007" x-align="PSA.68.19.a006" x-src="WLC.PSA.68.19.006" x-source="יַֽעֲמָס" x-translit="yaʿămās-" srcloc="WLC.PSA.68.19.006" x-head="true" lemma="עָמַס" strong="H6006">beareth</char> <char style="w" x-id="t008" x-align="PSA.68.19.a008" x-src="WLC.PSA.68.19.008" x-source="נוּ" x-translit="ānû" srcloc="WLC.PSA.68.19.008" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t009" x-align="PSA.68.19.a006">burden</char>,</para>
