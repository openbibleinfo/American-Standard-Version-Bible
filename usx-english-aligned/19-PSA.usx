	<para style="q1"><char style="w" x-id="t019" x-align="PSA.17.14.a015" x-src="WLC.PSA.17.14.015" x-source="וּֽ" x-translit="**û" srcloc="WLC.PSA.17.14.015" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t020" x-align="PSA.17.14.a020" x-src="WLC.PSA.17.14.020" x-source="ם" x-translit="ām" srcloc="WLC.PSA.17.14.020" x-head="true" lemma="הוּא" strong="H3963a">whose</char> <char style="w" x-id="t021" x-align="PSA.17.14.a019" x-src="WLC.PSA.17.14.019" x-source="בִ֫טְנָ֥" x-translit="ḇiṭn" srcloc="WLC.PSA.17.14.019" x-head="true" lemma="בֶּטֶן" strong="H990">belly</char> <char style="w" x-id="t022" x-align="PSA.17.14.a018">thou</char> <char style="w" x-id="t023" x-align="PSA.17.14.a018" x-src="WLC.PSA.17.14.018" x-source="תְּמַלֵּ֪א" x-translit="təmallēʾ" srcloc="WLC.PSA.17.14.018" x-head="true" lemma="מָלֵא" strong="H4390">fillest</char> <char style="w" x-id="t024" x-align="PSA.17.14.a016">with</char> <char style="w" x-id="t025" x-align="PSA.17.14.a017" x-src="WLC.PSA.17.14.017" x-source="ךָ֮" x-translit="əḵā" srcloc="WLC.PSA.17.14.017" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t026" x-align="PSA.17.14.a016" x-src="WLC.PSA.17.14.016" x-source="צְפוּנְ" x-translit="ṣəp̄ûn" srcloc="WLC.PSA.17.14.016" x-head="true" lemma="צָפַן" strong="H6845">treasure</char>:</para>
	<para style="q1"><char style="w" x-id="t027" x-align="PSA.17.14.a021">They</char> <char style="w" x-id="t028" x-align="PSA.17.14.a021">are</char> <char style="w" x-id="t029" x-align="PSA.17.14.a021" x-src="WLC.PSA.17.14.021" x-source="יִשְׂבְּע֥וּ" x-translit="yiśbəʿû" srcloc="WLC.PSA.17.14.021" x-head="true" lemma="שָׂבֵעַ" strong="H7646">satisfied</char> <char style="w" x-id="t030" x-align="PSA.17.14.a022">with</char> <char style="w" x-id="t031" x-align="PSA.17.14.a022" x-src="WLC.PSA.17.14.022" x-source="בָנִ֑ים" x-translit="ḇāniym" srcloc="WLC.PSA.17.14.022" x-head="true" lemma="בֵּן" strong="H1121">children</char>,</para>
	<para style="q1"><char style="w" x-id="t032" x-align="PSA.17.14.a023" x-src="WLC.PSA.17.14.023" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.17.14.023" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t033" x-align="PSA.17.14.a024" x-src="WLC.PSA.17.14.024" x-source="הִנִּ֥יחוּ" x-translit="hinniyḥû" srcloc="WLC.PSA.17.14.024" x-head="true" lemma="נוח" strong="H5117">leave</char> <char style="w" x-id="t034" x-align="PSA.17.14.a025">the</char> <char style="w" x-id="t035" x-align="PSA.17.14.a025" x-src="WLC.PSA.17.14.025" x-source="יִ֝תְרָ֗" x-translit="yiṯr" srcloc="WLC.PSA.17.14.025" x-head="true" lemma="יֶתֶר" strong="H3499">rest</char> <char style="w" x-id="t036" x-align="PSA.17.14.a025">of</char> <char style="w" x-id="t037" x-align="PSA.17.14.a026" x-src="WLC.PSA.17.14.026" x-source="ם" x-translit="ām" srcloc="WLC.PSA.17.14.026" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t038" x-align="PSA.17.14.a025">substance</char> <char style="w" x-id="t039" x-align="PSA.17.14.a027" x-src="WLC.PSA.17.14.027" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.17.14.027" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t040" x-align="PSA.17.14.a029" x-src="WLC.PSA.17.14.029" x-source="הֶֽם" x-translit="hem" srcloc="WLC.PSA.17.14.029" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t041" x-align="PSA.17.14.a028" x-src="WLC.PSA.17.14.028" x-source="עוֹלְלֵי" x-translit="ʿôləlēy" srcloc="WLC.PSA.17.14.028" x-head="true" lemma="עוֹלֵל" strong="H5768">babes</char>.<verse eid="PSA 17:14" /></para>
	<para style="q1"><verse number="15" style="v" sid="PSA 17:15" /><char style="w" x-id="t001" x-align="PSA.17.15.a001">As</char> <char style="w" x-id="t002" x-align="PSA.17.15.a001">for</char> <char style="w" x-id="t003" x-align="PSA.17.15.a001" x-src="WLC.PSA.17.15.001" x-source="אֲנִ֗י" x-translit="ʾăniy" srcloc="WLC.PSA.17.15.001" x-head="true" lemma="אֲנִי" strong="H589">me</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">let me</char></char></note><char style="w" x-id="t004" x-align="PSA.17.15.a004">I</char> <char style="w" x-id="t005" x-align="PSA.17.15.a004">shall</char> <char style="w" x-id="t006" x-align="PSA.17.15.a004" x-src="WLC.PSA.17.15.004" x-source="אֶחֱזֶ֣ה" x-translit="ʾeḥĕzeh" srcloc="WLC.PSA.17.15.004" x-head="true" lemma="חָזָה" strong="H2372">behold</char> <char style="w" x-id="t007" x-align="PSA.17.15.a006" x-src="WLC.PSA.17.15.006" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.17.15.006" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t008" x-align="PSA.17.15.a005" x-src="WLC.PSA.17.15.005" x-source="פָנֶ֑י" x-translit="p̄āney" srcloc="WLC.PSA.17.15.005" x-head="true" lemma="פָּנֶה" strong="H6440">face</char> <char style="w" x-id="t009" x-align="PSA.17.15.a002" x-src="WLC.PSA.17.15.002" x-source="בְּ֭" x-translit="bə" srcloc="WLC.PSA.17.15.002" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t010" x-align="PSA.17.15.a003" x-src="WLC.PSA.17.15.003" x-source="צֶדֶק" x-translit="ṣeḏeq" srcloc="WLC.PSA.17.15.003" x-head="true" lemma="צֶדֶק" strong="H6664">righteousness</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">let me</char></char></note><char style="w" x-id="t011" x-align="PSA.17.15.a007">I</char> <char style="w" x-id="t012" x-align="PSA.17.15.a007">shall</char> <char style="w" x-id="t013" x-align="PSA.17.15.a007">be</char> <char style="w" x-id="t014" x-align="PSA.17.15.a007" x-src="WLC.PSA.17.15.007" x-source="אֶשְׂבְּעָ֥ה" x-translit="ʾeśbəʿāh" srcloc="WLC.PSA.17.15.007" x-head="true" lemma="שָׂבֵעַ" strong="H7646">satisfied</char>, <char style="w" x-id="t015" x-align="PSA.17.15.a008" x-src="WLC.PSA.17.15.008" x-source="בְ֝" x-translit="ḇə" srcloc="WLC.PSA.17.15.008" x-head="true" lemma="בְּ" strong="H871a">when</char> <char style="w" x-id="t016" x-align="PSA.17.15.a009">I</char> <char style="w" x-id="t017" x-align="PSA.17.15.a009" x-src="WLC.PSA.17.15.009" x-source="הָקִ֗יץ" x-translit="hāqiyṣ" srcloc="WLC.PSA.17.15.009" x-head="true" lemma="קִיץ" strong="H6974a">awake</char>, <char style="w" x-id="t018" x-align="PSA.17.15.a010">with</char> <char style="add"><char style="w" x-id="t019" x-align="PSA.17.15.a012" x-status="added" x-source="∅" x-head="true">beholding</char></char> <char style="w" x-id="t020" x-align="PSA.17.15.a011" x-src="WLC.PSA.17.15.011" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.17.15.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t021" x-align="PSA.17.15.a010" x-src="WLC.PSA.17.15.010" x-source="תְּמוּנָתֶֽ" x-translit="təmûnāṯ" srcloc="WLC.PSA.17.15.010" x-head="true" lemma="תְּמוּנָה" strong="H8544">form</char>.<verse eid="PSA 17:15" /></para>
	<chapter eid="PSA 17" />
	<chapter number="18" style="c" sid="PSA 18" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="וַ יֹּאמַ֡ר" x-unrepresented-translit="wa yyōʾmar" x-unrepresented-src="WLC.PSA.18.1.001 WLC.PSA.18.1.002" sid="PSA 18:1" />Jehovah praised for giving victory and dominion.</para>
