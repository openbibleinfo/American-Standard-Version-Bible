	<chapter eid="PSA 21" />
	<chapter number="22" style="c" sid="PSA 22" />
	<para style="s1"><verse number="1" style="v" sid="PSA 22:1" />A cry of anguish, and a song of praise.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.22.0.a001" x-src="WLC.PSA.22.0.001" x-source="לַ֭" x-translit="la" srcloc="WLC.PSA.22.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.22.0.a002" x-src="WLC.PSA.22.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.22.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.22.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.22.0.a003" x-src="WLC.PSA.22.0.003" x-source="מְנַצֵּחַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.22.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="w" x-id="t005" x-align="PSA.22.0.a004">set</char> <char style="w" x-id="t006" x-align="PSA.22.0.a004" x-src="WLC.PSA.22.0.004" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.22.0.004" x-head="true" lemma="עַל" strong="H5921">to</char> <note caller="-" style="f"><char style="ft">That is, <char style="it">The hind of the morning</char>.</char></note><char style="w" x-id="t007" x-align="PSA.22.0.a005" x-src="WLC.PSA.22.0.005" x-source="אַיֶּ֥לֶת" x-translit="ʾayyeleṯ" srcloc="WLC.PSA.22.0.005" x-head="true" lemma="אַיֶּלֶת" strong="H365">Aijeleth</char> <char style="w" x-id="t008" x-align="PSA.22.0.a006" x-src="WLC.PSA.22.0.006" x-source="הַ" x-translit="ha" srcloc="WLC.PSA.22.0.006" x-head="true" lemma="הַ" strong="H1886a">hash</char>-<char style="w" x-id="t009" x-align="PSA.22.0.a007" x-src="WLC.PSA.22.0.007" x-source="שַּׁ֗חַר" x-translit="ššaḥar" srcloc="WLC.PSA.22.0.007" x-head="true" lemma="שַׁחַר" strong="H7837">Shahar</char>. <char style="w" x-id="t010" x-align="PSA.22.0.a008">A</char> <char style="w" x-id="t011" x-align="PSA.22.0.a008" x-src="WLC.PSA.22.0.008" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.22.0.008" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t012" x-align="PSA.22.0.a009" x-src="WLC.PSA.22.0.009" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.22.0.009" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t013" x-align="PSA.22.0.a010" x-src="WLC.PSA.22.0.010" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.22.0.010" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.22.1.a002" x-src="WLC.PSA.22.1.002" x-source="י" x-translit="iy" srcloc="WLC.PSA.22.1.002" x-head="true" lemma="הוּא" strong="H2967a">My</char> <char style="w" x-id="t002" x-align="PSA.22.1.a001" x-src="WLC.PSA.22.1.001" x-source="אֵלִ֣" x-translit="ʾēl" srcloc="WLC.PSA.22.1.001" x-head="true" lemma="אֵל" strong="H410">God</char>, <char style="w" x-id="t003" x-align="PSA.22.1.a004" x-src="WLC.PSA.22.1.004" x-source="י" x-translit="iy" srcloc="WLC.PSA.22.1.004" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t004" x-align="PSA.22.1.a003" x-src="WLC.PSA.22.1.003" x-source="אֵ֭לִ" x-translit="ʾēl" srcloc="WLC.PSA.22.1.003" x-head="true" lemma="אֵל" strong="H410">God</char>, <char style="w" x-id="t005" x-align="PSA.22.1.a005" x-src="WLC.PSA.22.1.005 WLC.PSA.22.1.006" x-source="לָ מָ֣ה" x-translit="lā māh" srcloc="WLC.PSA.22.1.006" x-head="true" lemma="מָה" strong="H4100">why</char> <char style="w" x-id="t006" x-align="PSA.22.1.a006">hast</char> <char style="w" x-id="t007" x-align="PSA.22.1.a006">thou</char> <char style="w" x-id="t008" x-align="PSA.22.1.a006" x-src="WLC.PSA.22.1.007" x-source="עֲזַבְתָּ֑" x-translit="ʿăzaḇtā" srcloc="WLC.PSA.22.1.007" x-head="true" lemma="עָזַב" strong="H5800">forsaken</char> <char style="w" x-id="t009" x-align="PSA.22.1.a007" x-src="WLC.PSA.22.1.008" x-source="נִי" x-translit="niy" srcloc="WLC.PSA.22.1.008" x-head="true" lemma="הוּא" strong="H5204a">me</char>?</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Far from my help</char> are <char style="it">the words of my groaning</char>. Hebrew <char style="it">roaring</char>.</char></note><char style="add"><char style="w" x-id="t010" x-align="PSA.22.1.a005">Why</char> <char style="w" x-id="t011" x-align="PSA.22.1.a008">art</char> <char style="w" x-id="t012" x-align="PSA.22.1.a001">thou</char> <char style="w" x-id="t013" x-align="PSA.22.1.a009" x-status="added" x-source="∅" x-head="true">so</char></char> <char style="w" x-id="t014" x-align="PSA.22.1.a008" x-src="WLC.PSA.22.1.009" x-source="רָח֥וֹק" x-translit="rāḥôq" srcloc="WLC.PSA.22.1.009" x-head="true" lemma="רָחֹוק" strong="H7350">far</char> <char style="w" x-id="t015" x-align="PSA.22.1.a010" x-src="WLC.PSA.22.1.010" x-source="מִֽ֝" x-translit="mi" srcloc="WLC.PSA.22.1.010" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t016" x-align="PSA.22.1.a011" x-src="WLC.PSA.22.1.011" x-source="ישׁוּעָתִ֗" x-translit="yšûʿāṯ" srcloc="WLC.PSA.22.1.011" x-head="true" lemma="יְשׁוּעָה" strong="H3444">helping</char> <char style="w" x-id="t017" x-align="PSA.22.1.a012" x-src="WLC.PSA.22.1.012" x-source="י" x-translit="iy" srcloc="WLC.PSA.22.1.012" x-head="true" lemma="הוּא" strong="H2967a">me</char>, <char style="add"><char style="w" x-id="t018" x-align="PSA.22.1.a013" x-status="added" x-source="∅" x-head="true">and</char> <char style="w" x-id="t019" x-align="PSA.22.1.a010">from</char></char> <char style="w" x-id="t020" x-align="PSA.22.1.a014">the</char> <char style="w" x-id="t021" x-align="PSA.22.1.a014" x-src="WLC.PSA.22.1.013" x-source="דִּבְרֵ֥י" x-translit="diḇrēy" srcloc="WLC.PSA.22.1.013" x-head="true" lemma="דָּבָר" strong="H1697">words</char> <char style="w" x-id="t022" x-align="PSA.22.1.a015">of</char> <char style="w" x-id="t023" x-align="PSA.22.1.a016" x-src="WLC.PSA.22.1.015" x-source="י" x-translit="iy" srcloc="WLC.PSA.22.1.015" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t024" x-align="PSA.22.1.a015" x-src="WLC.PSA.22.1.014" x-source="שַׁאֲגָתִֽ" x-translit="šaʾăḡāṯ" srcloc="WLC.PSA.22.1.014" x-head="true" lemma="שְׁאָגָה" strong="H7581">groaning</char>?<verse eid="PSA 22:1" /></para>
	<para style="q1"><verse number="2" style="v" x-unrepresented-source="לִֽ י" x-unrepresented-translit="l iy" x-unrepresented-src="WLC.PSA.22.2.013 WLC.PSA.22.2.014" sid="PSA 22:2" /><char style="w" x-id="t001" x-align="PSA.22.2.a001">O</char> <char style="w" x-id="t002" x-align="PSA.22.2.a002" x-src="WLC.PSA.22.2.002" x-source="י" x-translit="ay" srcloc="WLC.PSA.22.2.002" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t003" x-align="PSA.22.2.a001" x-src="WLC.PSA.22.2.001" x-source="אֱֽלֹהַ֗" x-translit="ʾĕlōh" srcloc="WLC.PSA.22.2.001" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t004" x-align="PSA.22.2.a003">I</char> <char style="w" x-id="t005" x-align="PSA.22.2.a003" x-src="WLC.PSA.22.2.003" x-source="אֶקְרָ֣א" x-translit="ʾeqrāʾ" srcloc="WLC.PSA.22.2.003" x-head="true" lemma="קָרָא" strong="H7121">cry</char> <char style="w" x-id="t006" x-align="PSA.22.2.a004">in</char> <char style="w" x-id="t007" x-align="PSA.22.2.a004">the</char> <char style="w" x-id="t008" x-align="PSA.22.2.a004" x-src="WLC.PSA.22.2.004" x-source="י֭וֹמָם" x-translit="yômām" srcloc="WLC.PSA.22.2.004" x-head="true" lemma="יוֹמָם" strong="H3119">daytime</char>, <char style="w" x-id="t009" x-align="PSA.22.2.a005" x-src="WLC.PSA.22.2.005" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.22.2.005" x-head="true" lemma="וְ" strong="H2050b">but</char> <char style="w" x-id="t010" x-align="PSA.22.2.a007">thou</char> <char style="w" x-id="t011" x-align="PSA.22.2.a007" x-src="WLC.PSA.22.2.007" x-source="תַעֲנֶ֑ה" x-translit="ṯaʿăneh" srcloc="WLC.PSA.22.2.007" x-head="true" lemma="עָנָה" strong="H6030">answerest</char> <char style="w" x-id="t012" x-align="PSA.22.2.a006" x-src="WLC.PSA.22.2.006" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.PSA.22.2.006" x-head="true" lemma="לֹא" strong="H3808">not</char>;</para>
	<para style="q1"><char style="w" x-id="t013" x-align="PSA.22.2.a008" x-src="WLC.PSA.22.2.008" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.22.2.008" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t014" x-align="PSA.22.2.a009">in</char> <char style="w" x-id="t015" x-align="PSA.22.2.a009">the</char> <char style="w" x-id="t016" x-align="PSA.22.2.a009" x-src="WLC.PSA.22.2.009" x-source="לַ֗יְלָה" x-translit="layəlâ" srcloc="WLC.PSA.22.2.009" x-head="true" lemma="לַיְלָה" strong="H3915">night</char> <char style="w" x-id="t017" x-align="PSA.22.2.a009">season</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">but find no rest</char></char></note><char style="w" x-id="t018" x-align="PSA.22.2.a010" x-src="WLC.PSA.22.2.010" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.22.2.010" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t019" x-align="PSA.22.2.a012">am</char> <char style="w" x-id="t020" x-align="PSA.22.2.a011" x-src="WLC.PSA.22.2.011" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.PSA.22.2.011" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t021" x-align="PSA.22.2.a012" x-src="WLC.PSA.22.2.012" x-source="דֽוּמִיָּ֥ה" x-translit="ḏûmiyyāh" srcloc="WLC.PSA.22.2.012" x-head="true" lemma="דּוּמִיָּה" strong="H1747">silent</char>.<verse eid="PSA 22:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="PSA 22:3" /><char style="w" x-id="t001" x-align="PSA.22.3.a001" x-src="WLC.PSA.22.3.001" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.22.3.001" x-head="true" lemma="וְ" strong="H2050b">But</char> <char style="w" x-id="t002" x-align="PSA.22.3.a002" x-src="WLC.PSA.22.3.002" x-source="אַתָּ֥ה" x-translit="ʾattāh" srcloc="WLC.PSA.22.3.002" x-head="true" lemma="אַתָּה" strong="H859">thou</char> <char style="w" x-id="t003" x-align="PSA.22.3.a003">art</char> <char style="w" x-id="t004" x-align="PSA.22.3.a003" x-src="WLC.PSA.22.3.003" x-source="קָד֑וֹשׁ" x-translit="qāḏôš" srcloc="WLC.PSA.22.3.003" x-head="true" lemma="קָדוֹשׁ" strong="H6918">holy</char>,</para>
	<para style="q1"><char style="w" x-id="t005" x-align="PSA.22.3.a004">O</char> <char style="w" x-id="t006" x-align="PSA.22.3.a004">thou</char> <char style="w" x-id="t007" x-align="PSA.22.3.a004">that</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">art enthroned upon</char></char></note><char style="w" x-id="t008" x-align="PSA.22.3.a004" x-src="WLC.PSA.22.3.004" x-source="י֝וֹשֵׁ֗ב" x-translit="yôšēḇ" srcloc="WLC.PSA.22.3.004" x-head="true" lemma="יָשַׁב" strong="H3427">inhabitest</char> <char style="w" x-id="t009" x-align="PSA.22.3.a005">the</char> <char style="w" x-id="t010" x-align="PSA.22.3.a005" x-src="WLC.PSA.22.3.005" x-source="תְּהִלּ֥וֹת" x-translit="təhillôṯ" srcloc="WLC.PSA.22.3.005" x-head="true" lemma="תְּהִלָּה" strong="H8416">praises</char> <char style="w" x-id="t011" x-align="PSA.22.3.a006">of</char> <char style="w" x-id="t012" x-align="PSA.22.3.a006" x-src="WLC.PSA.22.3.006" x-source="יִשְׂרָאֵֽל" x-translit="yiśrāʾēl:" srcloc="WLC.PSA.22.3.006" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>.<verse eid="PSA 22:3" /></para>
	<para style="q1"><verse number="4" style="v" sid="PSA 22:4" /><char style="w" x-id="t001" x-align="PSA.22.4.a005" x-src="WLC.PSA.22.4.005" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.22.4.005" x-head="true" lemma="הוּא" strong="H5105a">Our</char> <char style="w" x-id="t002" x-align="PSA.22.4.a004" x-src="WLC.PSA.22.4.004" x-source="אֲבֹתֵ֑י" x-translit="ʾăḇōṯēy" srcloc="WLC.PSA.22.4.004" x-head="true" lemma="אָב" strong="H1">fathers</char> <char style="w" x-id="t003" x-align="PSA.22.4.a003" x-src="WLC.PSA.22.4.003" x-source="בָּטְח֣וּ" x-translit="bāṭḥû" srcloc="WLC.PSA.22.4.003" x-head="true" lemma="בָּטַח" strong="H982">trusted</char> <char style="w" x-id="t004" x-align="PSA.22.4.a001" x-src="WLC.PSA.22.4.001" x-source="בְּ֭" x-translit="bə" srcloc="WLC.PSA.22.4.001" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t005" x-align="PSA.22.4.a002" x-src="WLC.PSA.22.4.002" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.22.4.002" x-head="true" lemma="הוּא" strong="H3509b">thee</char>:</para>
	<para style="q1"><char style="w" x-id="t006" x-align="PSA.22.4.a006">They</char> <char style="w" x-id="t007" x-align="PSA.22.4.a006" x-src="WLC.PSA.22.4.006" x-source="בָּ֝טְח֗וּ" x-translit="bāṭḥû" srcloc="WLC.PSA.22.4.006" x-head="true" lemma="בָּטַח" strong="H982">trusted</char>, <char style="w" x-id="t008" x-align="PSA.22.4.a007" x-src="WLC.PSA.22.4.007" x-source="וַֽ" x-translit="wa" srcloc="WLC.PSA.22.4.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="PSA.22.4.a008">thou</char> <char style="w" x-id="t010" x-align="PSA.22.4.a008">didst</char> <char style="w" x-id="t011" x-align="PSA.22.4.a008" x-src="WLC.PSA.22.4.008" x-source="תְּפַלְּטֵֽ" x-translit="təp̄alləṭ" srcloc="WLC.PSA.22.4.008" x-head="true" lemma="פָּלַט" strong="H6403">deliver</char> <char style="w" x-id="t012" x-align="PSA.22.4.a009" x-src="WLC.PSA.22.4.009" x-source="מוֹ" x-translit="ēmô" srcloc="WLC.PSA.22.4.009" x-head="true" lemma="הוּא" strong="H3963a">them</char>.<verse eid="PSA 22:4" /></para>
