	<para style="s1"><verse number="1" style="v" sid="PSA 25:1" />Prayer for protection, guidance, and pardon.</para>
	<para style="d"><char style="add"><char style="w" x-id="t001" x-align="PSA.25.1.a001" x-status="added">A</char> <char style="w" x-id="t002" x-align="PSA.25.1.a001" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t003" x-align="PSA.25.1.a002" x-src="WLC.PSA.25.1.001" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.25.1.001" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.25.1.a003" x-src="WLC.PSA.25.1.002" x-source="דָוִ֡ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.25.1.002" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
