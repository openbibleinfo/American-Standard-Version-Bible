	<para style="q1"><verse number="8" style="v" x-unrepresented-source="בָֽ" x-unrepresented-translit="ḇ" x-unrepresented-src="WLC.PSA.64.8.011" sid="PSA 64:8" /><char style="w" x-id="t001" x-align="PSA.64.8.a001" x-src="WLC.PSA.64.8.001" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.64.8.001" x-head="true" lemma="וְ" strong="H2050b">So</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">shall they against whom their tongue was make them to stumble</char></char></note><char style="w" x-id="t002" x-align="PSA.64.8.a003" x-src="WLC.PSA.64.8.003" x-source="הוּ" x-translit="hû" srcloc="WLC.PSA.64.8.003" x-head="true" lemma="הוּא" strong="H1930a">they</char> <char style="w" x-id="t003" x-align="PSA.64.8.a002">shall</char> <char style="w" x-id="t004" x-align="PSA.64.8.a002">be</char> <char style="w" x-id="t005" x-align="PSA.64.8.a002">made</char> <char style="w" x-id="t006" x-align="PSA.64.8.a002">to</char> <char style="w" x-id="t007" x-align="PSA.64.8.a002" x-src="WLC.PSA.64.8.002" x-source="יַּכְשִׁיל֣וּ" x-translit="yyaḵšiylû" srcloc="WLC.PSA.64.8.002" x-head="true" lemma="כָּשַׁל" strong="H3782">stumble</char>, <char style="w" x-id="t008" x-align="PSA.64.8.a007" x-src="WLC.PSA.64.8.007" x-source="ם" x-translit="ām" srcloc="WLC.PSA.64.8.007" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t009" x-align="PSA.64.8.a007">own</char> <char style="w" x-id="t010" x-align="PSA.64.8.a006" x-src="WLC.PSA.64.8.006" x-source="לְשׁוֹנָ֑" x-translit="ləšôn" srcloc="WLC.PSA.64.8.006" x-head="true" lemma="לָשׁוֹן" strong="H3956">tongue</char> <char style="w" x-id="t011" x-align="PSA.64.8.a004">being</char> <char style="w" x-id="t012" x-align="PSA.64.8.a004" x-src="WLC.PSA.64.8.004" x-source="עָלֵ֣י" x-translit="ʿālēy" srcloc="WLC.PSA.64.8.004" x-head="true" lemma="עַל" strong="H5921">against</char> <char style="w" x-id="t013" x-align="PSA.64.8.a005" x-src="WLC.PSA.64.8.005" x-source="מוֹ" x-translit="mô" srcloc="WLC.PSA.64.8.005" x-head=