	<para style="q1"><verse number="35" style="v" sid="PSA 68:35" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Terrible is God</char></char></note><char style="w" x-id="t001" x-align="PSA.68.35.a002">O</char> <char style="w" x-id="t002" x-align="PSA.68.35.a002" x-src="WLC.PSA.68.35.002" x-source="אֱלֹהִ֗ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.68.35.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="add"><char style="w" x-id="t003" x-align="PSA.68.35.a002">thou</char> <char style="w" x-id="t004" x-align="PSA.68.35.a001">art</char></char> <char style="w" x-id="t005" x-align="PSA.68.35.a001" x-src="WLC.PSA.68.35.001" x-source="נ֤וֹרָ֥א" x-translit="nôrāʾ" srcloc="WLC.PSA.68.35.001" x-head="true" lemma="יָרֵא" strong="H3372">terrible</char> <char style="w" x-id="t006" x-align="PSA.68.35.a003" x-src="WLC.PSA.68.35.003" x-source="מִֽ" x-translit="mi" srcloc="WLC.PSA.68.35.003" x-head="true" lemma="מִן" strong="H4480">out</char> <char style="w" x-id="t007" x-align="PSA.68.35.a003">of</char> <char style="w" x-id="t008" x-align="PSA.68.35.a005" x-src="WLC.PSA.68.35.005" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.68.35.005" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t009" x-align="PSA.68.35.a004" x-src="WLC.PSA.68.35.004" x-source="מִּקְדָּ֫שֶׁ֥י" x-translit="mmiqdāšey" srcloc="WLC.PSA.68.35.004" x-head="true" lemma="מִקְדָּשׁ" strong="H4720">holy</char> <char style="w" x-id="t010" x-align="PSA.68.35.a004">places</char>:</para>
