	<chapter number="127" style="c" sid="PSA 127" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="הַֽ בּ֑ וֹ" x-unrepresented-translit="ha b ô" x-unrepresented-src="WLC.PSA.127.1.002 WLC.PSA.127.1.015 WLC.PSA.127.1.016" sid="PSA 127:1" />Prosperity comes from Jehovah.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.127.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.127.1.a001" x-src="WLC.PSA.127.1.001" x-source="שִׁ֥יר" x-translit="šiyr" srcloc="WLC.PSA.127.1.001" x-head="true" lemma="שִׁיר" strong="H7892">Song</char> <char style="w" x-id="t003" x-align="PSA.127.1.a003">of</char> <char style="w" x-id="t004" x-align="PSA.127.1.a003" x-src="WLC.PSA.127.1.003" x-source="מַּֽעֲל֗וֹת" x-translit="mmaʿălôṯ" srcloc="WLC.PSA.127.1.003" x-head="true" lemma="מַעֲלָה" strong="H4609">Ascents</char>; <char style="w" x-id="t005" x-align="PSA.127.1.a004" x-src="WLC.PSA.127.1.004" x-source="לִ" x-translit="li" srcloc="WLC.PSA.127.1.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t006" x-align="PSA.127.1.a005" x-src="WLC.PSA.127.1.005" x-source="שְׁלֹ֫מֹ֥ה" x-translit="šəlōmōh" srcloc="WLC.PSA.127.1.005" x-head="true" lemma="שְׁלֹמֹה" strong="H8010">Solomon</char>.</para>
