	<para style="q1"><verse number="19" style="v" sid="PSA 49:19" /><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Thou shalt go</char>, or, <char style="it">It shall go</char>.</char></note><char style="w" x-id="t001" x-align="PSA.49.19.a001">He</char> <char style="w" x-id="t002" x-align="PSA.49.19.a001">shall</char> <char style="w" x-id="t003" x-align="PSA.49.19.a001" x-src="WLC.PSA.49.19.001" x-source="תָּ֭בוֹא" x-translit="tāḇôʾ" srcloc="WLC.PSA.49.19.001" x-head="true" lemma="בּוֹא" strong="H935">go</char> <char style="w" x-id="t004" x-align="PSA.49.19.a002" x-src="WLC.PSA.49.19.002" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.PSA.49.19.002" x-head="true" lemma="עַד" strong="H5704">to</char> <char style="w" x-id="t005" x-align="PSA.49.19.a003">the</char> <char style="w" x-id="t006" x-align="PSA.49.19.a003" x-src="WLC.PSA.49.19.003" x-source="דּ֣וֹר" x-translit="dôr" srcloc="WLC.PSA.49.19.003" x-head="true" lemma="דּוֹר" strong="H1755">generation</char> <char style="w" x-id="t007" x-align="PSA.49.19.a004">of</char> <char style="w" x-id="t008" x-align="PSA.49.19.a005" x-src="WLC.PSA.49.19.005" x-source="ו" x-translit="w" srcloc="WLC.PSA.49.19.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t009" x-align="PSA.49.19.a004" x-src="WLC.PSA.49.19.004" x-source="אֲבוֹתָ֑י" x-translit="ʾăḇôṯāy" srcloc="WLC.PSA.49.19.004" x-head="true" lemma="אָב" strong="H1">fathers</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Who never more see</char></char></note><char style="w" x-id="t010" x-align="PSA.49.19.a007">They</char> <char style="w" x-id="t011" x-align="PSA.49.19.a007">shall</char> <char style="w" x-id="t012" x-align="PSA.49.19.a006" x-src="WLC.PSA.49.19.006 WLC.PSA.49.19.007 WLC.PSA.49.19.008" x-source="עַד נֵ֝֗צַח לֹ֣א" x-translit="ʿaḏ- nēṣaḥ lōʾ" srcloc="WLC.PSA.49.19.008" x-head="true" lemma="לֹא" strong="H3808">never</char> <char style="w" x-id="t013" x-align="PSA.49.19.a007" x-src="WLC.PSA.49.19.009" x-source="יִרְאוּ" x-translit="yirʾû-" srcloc="WLC.PSA.49.19.009" x-head="true" lemma="רָאָה" strong="H7200">see</char> <char style="w" x-id="t014" x-align="PSA.49.19.a008">the</char> <char style="w" x-id="t015" x-align="PSA.49.19.a008" x-src="WLC.PSA.49.19.010" x-source="אֽוֹר" x-translit="ʾôr:" srcloc="WLC.PSA.49.19.010" x-head="true" lemma="אוֹר" strong="H216">light</char>.<verse eid="PSA 49:19" /></para>
	<para style="q1"><verse number="20" style="v" sid="PSA 49:20" /><char style="w" x-id="t001" x-align="PSA.49.20.a001" x-src="WLC.PSA.49.20.001" x-source="אָדָ֣ם" x-translit="ʾāḏām" srcloc="WLC.PSA.49.20.001" x-head="true" lemma="אָדָם" strong="H120">Man</char> <char style="w" x-id="t002" x-align="PSA.49.20.a002" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t003" x-align="PSA.49.20.a003">is</char> <char style="w" x-id="t004" x-align="PSA.49.20.a003" x-src="WLC.PSA.49.20.002" x-source="בִּ֭" x-translit="bi" srcloc="WLC.PSA.49.20.002" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t005" x-align="PSA.49.20.a004" x-src="WLC.PSA.49.20.003" x-source="יקָר" x-translit="yqār" srcloc="WLC.PSA.49.20.003" x-head="true" lemma="יְקָר" strong="H3366">honor</char>, <char style="w" x-id="t006" x-align="PSA.49.20.a005" x-src="WLC.PSA.49.20.004" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.49.20.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t007" x-align="PSA.49.20.a007" x-src="WLC.PSA.49.20.006" x-source="יָבִ֑ין" x-translit="yāḇiyn" srcloc="WLC.PSA.49.20.006" x-head="true" lemma="בִּין" strong="H995">understandeth</char> <char style="w" x-id="t008" x-align="PSA.49.20.a006" x-src="WLC.PSA.49.20.005" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.PSA.49.20.005" x-head="true" lemma="לֹא" strong="H3808">not</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.49.20.a008">Is</char> <char style="w" x-id="t010" x-align="PSA.49.20.a008" x-src="WLC.PSA.49.20.007 WLC.PSA.49.20.008" x-source="נִמְשַׁ֖ל כַּ" x-translit="nimšal ka" srcloc="WLC.PSA.49.20.007" x-head="true" lemma="מָשַׁל" strong="H4911">like</char> <char style="w" x-id="t011" x-align="PSA.49.20.a009" x-src="WLC.PSA.49.20.009" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.49.20.009" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t012" x-align="PSA.49.20.a010" x-src="WLC.PSA.49.20.010" x-source="בְּהֵמ֣וֹת" x-translit="bəhēmôṯ" srcloc="WLC.PSA.49.20.010" x-head="true" lemma="בְּהֵמָה" strong="H929">beasts</char> <char style="w" x-id="t013" x-align="PSA.49.20.a011" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t014" x-align="PSA.49.20.a012" x-src="WLC.PSA.49.20.011" x-source="נִדְמֽוּ" x-translit="niḏmû:" srcloc="WLC.PSA.49.20.011" x-head="true" lemma="דָּמָה" strong="H1820a">perish</char>.<verse eid="PSA 49:20" /></para>
	<chapter eid="PSA 49" />
	<chapter number="50" style="c" sid="PSA 50" />
	<para style="s1"><verse number="1" style="v" sid="PSA 50:1" />God the judge of the righteous and the wicked.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.50.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.50.1.a001" x-src="WLC.PSA.50.1.001" x-source="מִזְמ֗וֹר" x-translit="mizmôr" srcloc="WLC.PSA.50.1.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.50.1.a002" x-src="WLC.PSA.50.1.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.50.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.50.1.a003" x-src="WLC.PSA.50.1.003" x-source="אָ֫סָ֥ף" x-translit="ʾāsāp̄" srcloc="WLC.PSA.50.1.003" x-head="true" lemma="אָסָף" strong="H623">Asaph</char>.</para>
	<para style="q1"><char style="w" x-id="t005" x-align="PSA.50.1.a004">The</char> <char style="w" x-id="t006" x-align="PSA.50.1.a004" x-src="WLC.PSA.50.1.004" x-source="אֵ֤ל" x-translit="ʾēl" srcloc="WLC.PSA.50.1.004" x-head="true" lemma="אֵל" strong="H410">Mighty</char> <char style="w" x-id="t007" x-align="PSA.50.1.a004">One</char>, <char style="w" x-id="t008" x-align="PSA.50.1.a005" x-src="WLC.PSA.50.1.005" x-source="אֱֽלֹהִ֡ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.50.1.005" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t009" x-align="PSA.50.1.a006" x-src="WLC.PSA.50.1.006" x-source="יְֽהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.50.1.006" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t010" x-align="PSA.50.1.a007">hath</char> <char style="w" x-id="t011" x-align="PSA.50.1.a007" x-src="WLC.PSA.50.1.007" x-source="דִּבֶּ֥ר" x-translit="dibber" srcloc="WLC.PSA.50.1.007" x-head="true" lemma="דָבַר" strong="H1696">spoken</char>,</para>
	<para style="q1"><char style="w" x-id="t012" x-align="PSA.50.1.a008" x-src="WLC.PSA.50.1.008" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.50.1.008" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t013" x-align="PSA.50.1.a009" x-src="WLC.PSA.50.1.009" x-source="יִּקְרָא" x-translit="yyiqrāʾ-" srcloc="WLC.PSA.50.1.009" x-head="true" lemma="קָרָא" strong="H7121">called</char> <char style="w" x-id="t014" x-align="PSA.50.1.a010">the</char> <char style="w" x-id="t015" x-align="PSA.50.1.a010" x-src="WLC.PSA.50.1.010" x-source="אָ֑רֶץ" x-translit="ʾāreṣ" srcloc="WLC.PSA.50.1.010" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char> <char style="w" x-id="t016" x-align="PSA.50.1.a011" x-src="WLC.PSA.50.1.011" x-source="מִ" x-translit="mi" srcloc="WLC.PSA.50.1.011" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t017" x-align="PSA.50.1.a012">the</char> <char style="w" x-id="t018" x-align="PSA.50.1.a012" x-src="WLC.PSA.50.1.012" x-source="מִּזְרַח" x-translit="mmizraḥ-" srcloc="WLC.PSA.50.1.012" x-head="true" lemma="מִזְרָח" strong="H4217">rising</char> <char style="w" x-id="t019" x-align="PSA.50.1.a013">of</char> <char style="w" x-id="t020" x-align="PSA.50.1.a013">the</char> <char style="w" x-id="t021" x-align="PSA.50.1.a013" x-src="WLC.PSA.50.1.013" x-source="שֶׁ֝֗מֶשׁ" x-translit="šemeš" srcloc="WLC.PSA.50.1.013" x-head="true" lemma="שֶׁמֶשׁ" strong="H8121">sun</char> <char style="w" x-id="t022" x-align="PSA.50.1.a014" x-src="WLC.PSA.50.1.014" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.PSA.50.1.014" x-head="true" lemma="עַד" strong="H5704">unto</char> <char style="w" x-id="t023" x-align="PSA.50.1.a015">the</char> <char style="w" x-id="t024" x-align="PSA.50.1.a015" x-src="WLC.PSA.50.1.015" x-source="מְבֹאֽ" x-translit="məḇōʾ" srcloc="WLC.PSA.50.1.015" x-head="true" lemma="מָבוֹא" strong="H3996">going</char> <char style="w" x-id="t025" x-align="PSA.50.1.a015">down</char> <char style="w" x-id="t026" x-align="PSA.50.1.a