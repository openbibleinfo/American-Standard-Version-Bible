	<para style="q1"><verse number="5" style="v" sid="PSA 9:5" /><char style="w" x-id="t001" x-align="PSA.9.5.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.9.5.a001">hast</char> <char style="w" x-id="t003" x-align="PSA.9.5.a001" x-src="WLC.PSA.9.5.001" x-source="גָּעַ֣רְתָּ" x-translit="gāʿarətā" srcloc="WLC.PSA.9.5.001" x-head="true" lemma="גָּעַר" strong="H1605">rebuked</char> <char style="w" x-id="t004" x-align="PSA.9.5.a002">the</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">heathen</char></char></note><char style="w" x-id="t005" x-align="PSA.9.5.a002" x-src="WLC.PSA.9.5.002" x-source="ג֭וֹיִם" x-translit="ḡôyim" srcloc="WLC.PSA.9.5.002" x-head="true" lemma="גּוֹי" strong="H1471">nations</char>, <char style="w" x-id="t006" x-align="PSA.9.5.a003">thou</char> <char style="w" x-id="t007" x-align="PSA.9.5.a003">hast</char> <char style="w" x-id="t008" x-align="PSA.9.5.a003" x-src="WLC.PSA.9.5.003" x-source="אִבַּ֣דְתָּ" x-translit="ʾibbaḏətā" srcloc="WLC.PSA.9.5.003" x-head="true" lemma="אָבַד" strong="H6">destroyed</char> <char style="w" x-id="t009" x-align="PSA.9.5.a004">the</char> <char style="w" x-id="t010" x-align="PSA.9.5.a004" x-src="WLC.PSA.9.5.004" x-source="רָשָׁ֑ע" x-translit="rāšāʿ" srcloc="WLC.PSA.9.5.004" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char>;</para>
