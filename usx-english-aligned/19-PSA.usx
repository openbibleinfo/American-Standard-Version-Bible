	<para style="q1"><verse number="5" style="v" sid="PSA 45:5" /><char style="w" x-id="t001" x-align="PSA.45.5.a002" x-src="WLC.PSA.45.5.002" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.45.5.002" x-head="true" lemma="הוּא" strong="H3509b">Thine</char> <char style="w" x-id="t002" x-align="PSA.45.5.a001" x-src="WLC.PSA.45.5.001" x-source="חִצֶּ֗י" x-translit="ḥiṣṣey" srcloc="WLC.PSA.45.5.001" x-head="true" lemma="חֵץ" strong="H2671">arrows</char> <char style="w" x-id="t003" x-align="PSA.45.5.a003">are</char> <char style="w" x-id="t004" x-align="PSA.45.5.a003" x-src="WLC.PSA.45.5.003" x-source="שְׁנ֫וּנִ֥ים" x-translit="šənûniym" srcloc="WLC.PSA.45.5.003" x-head="true" lemma="שָׁנַן" strong="H8150">sharp</char>;</para>
