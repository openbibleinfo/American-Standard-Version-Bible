	<para style="q1"><char style="w" x-id="t009" x-align="PSA.104.18.a007">The</char> <char style="w" x-id="t010" x-align="PSA.104.18.a007" x-src="WLC.PSA.104.18.007" x-source="סְ֝לָעִ֗ים" x-translit="səlāʿiym" srcloc="WLC.PSA.104.18.007" x-head="true" lemma="סֶלַע" strong="H5553">rocks</char> <char style="w" x-id="t011" x-align="PSA.104.18.a008">are</char> <char style="w" x-id="t012" x-align="PSA.104.18.a008">a</char> <char style="w" x-id="t013" x-align="PSA.104.18.a008" x-src="WLC.PSA.104.18.008" x-source="מַחְסֶ֥ה" x-translit="maḥseh" srcloc="WLC.PSA.104.18.008" x-head="true" lemma="מַחְסֶּה" strong="H4268">refuge</char> <char style="w" x-id="t014" x-align="PSA.104.18.a009" x-src="WLC.PSA.104.18.009" x-source="לַֽ" x-translit="la" srcloc="WLC.PSA.104.18.009" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t015" x-align="PSA.104.18.a010" x-src="WLC.PSA.104.18.010" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.104.18.010" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t016" x-align="PSA.104.18.a011" x-src="WLC.PSA.104.18.011" x-source="שְׁפַנִּֽים" x-translit="šəp̄anniym:" srcloc="WLC.PSA.104.18.011" x-head="true" lemma="שָׁפָן" strong="H8227">conies</char>.<verse eid="PSA 104:18" /></para>
