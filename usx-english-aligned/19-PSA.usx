	<para style="d"><char style="w" x-id="t001" x-align="PSA.39.0.a001" x-src="WLC.PSA.39.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.39.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.39.0.a002" x-src="WLC.PSA.39.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.39.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.39.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.39.0.a003" x-src="WLC.PSA.39.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.39.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>, <char style="w" x-id="t005" x-align="PSA.39.0.a004" x-src="WLC.PSA.39.0.004" x-source="לִֽ" x-translit="**li" srcloc="WLC.PSA.39.0.004" x-head="true" lemma="לְ" strong="H3807a">for</char> <note caller="-" style="f"><char style="ft"><ref loc="PSA 62:1">62:title</ref>; <ref loc="PSA 77:1">77:title</ref>; <ref loc="1CH 16:41">1 Chr. 16:41</ref>; <ref loc="1CH 25:1">25:1</ref>.</char></note><char style="w" x-id="t006" x-align="PSA.39.0.a005" x-src="WLC.PSA.39.0.005" x-source="ידוּת֗וּן" x-translit="**yḏûṯûn" srcloc="WLC.PSA.39.0.005" x-head="true" lemma="יְדוּתוּן" strong="H3038">Jeduthun</char>. <char style="w" x-id="t007" x-align="PSA.39.0.a006">A</char> <char style="w" x-id="t008" x-align="PSA.39.0.a006" x-src="WLC.PSA.39.0.006" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.39.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t009" x-align="PSA.39.0.a007" x-src="WLC.PSA.39.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.39.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t010" x-align="PSA.39.0.a008" x-src="WLC.PSA.39.0.008" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.39.0.008" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
