	<chapter number="1" style="c" sid="PSA 1" />
	<para style="ms1"><verse number="1" style="v" sid="PSA 1:1" />Book I</para>
	<para style="s1">The righteous and the wicked contrasted.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Happy</char></char></note><char style="w" x-id="t001" x-align="PSA.1.1.a001" x-src="WLC.PSA.1.1.001" x-source="אַ֥שְֽׁרֵי" x-translit="ʾašərê-" srcloc="WLC.PSA.1.1.001" x-head="true" lemma="אֶשֶׁר" strong="H835a">Blessed</char> <char style="w" x-id="t002" x-align="PSA.1.1.a001">is</char> <char style="w" x-id="t003" x-align="PSA.1.1.a002" x-src="WLC.PSA.1.1.002" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.1.1.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t004" x-align="PSA.1.1.a003" x-src="WLC.PSA.1.1.003" x-source="אִ֗ישׁ" x-translit="ʾiyš" srcloc="WLC.PSA.1.1.003" x-head="true" lemma="אִישׁ" strong="H376">man</char> <char style="w" x-id="t005" x-align="PSA.1.1.a004" x-src="WLC.PSA.1.1.004" x-source="אֲשֶׁ֤ר" x-translit="ʾăšer" srcloc="WLC.PSA.1.1.004" x-head="true" lemma="אֲשֶׁר" strong="H834">that</char> <char style="w" x-id="t006" x-align="PSA.1.1.a006" x-src="WLC.PSA.1.1.006" x-source="הָלַךְ֮" x-translit="hālaḵə" srcloc="WLC.PSA.1.1.006" x-head="true" lemma="הָלַךְ" strong="H1980">walketh</char> <char style="w" x-id="t007" x-align="PSA.1.1.a005" x-src="WLC.PSA.1.1.005" x-source="לֹ֥א" x-translit="lōʾ" srcloc="WLC.PSA.1.1.005" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t008" x-align="PSA.1.1.a007" x-src="WLC.PSA.1.1.007" x-source="בַּ" x-translit="ba" srcloc="WLC.PSA.1.1.007" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t009" x-align="PSA.1.1.a008">the</char> <char style="w" x-id="t010" x-align="PSA.1.1.a008" x-src="WLC.PSA.1.1.008" x-source="עֲצַ֪ת" x-translit="ʿăṣaṯ" srcloc="WLC.PSA.1.1.008" x-head="true" lemma="עֵצָה" strong="H6098">counsel</char> <char style="w" x-id="t011" x-align="PSA.1.1.a009">of</char> <char style="w" x-id="t012" x-align="PSA.1.1.a009">the</char> <char style="w" x-id="t013" x-align="PSA.1.1.a009" x-src="WLC.PSA.1.1.009" x-source="רְשָׁ֫עִ֥ים" x-translit="rəšāʿiym"