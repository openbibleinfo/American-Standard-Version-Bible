	<chapter eid="PSA 54" />
	<chapter number="55" style="c" sid="PSA 55" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="ה" x-unrepresented-translit="āh" x-unrepresented-src="WLC.PSA.55.1.002" sid="PSA 55:1" />Prayer for the destruction of the treacherous.</para>
