	<para style="q1"><char style="w" x-id="t010" x-align="PSA.130.2.a012" x-src="WLC.PSA.130.2.012" x-source="לְ֝" x-translit="lə" srcloc="WLC.PSA.130.2.012" x-head="true" lemma="לְ" strong="H3807a">To</char> <char style="w" x-id="t011" x-align="PSA.130.2.a013">the</char> <char style="w" x-id="t012" x-align="PSA.130.2.a013" x-src="WLC.PSA.130.2.013" x-source="ק֗וֹל" x-translit="qôl" srcloc="WLC.PSA.130.2.013" x-head="true" lemma="קוֹל" strong="H6963">voice</char> <char style="w" x-id="t013" x-align="PSA.130.2.a014">of</char> <char style="w" x-id="t014" x-align="PSA.130.2.a015" x-src="WLC.PSA.130.2.015" x-source="י" x-translit="āy" srcloc="WLC.PSA.130.2.015" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t015" x-align="PSA.130.2.a014" x-src="WLC.PSA.130.2.014" x-source="תַּחֲנוּנָֽ" x-translit="taḥănûn" srcloc="WLC.PSA.130.2.014" x-head="true" lemma="תַּחֲנוּן" strong="H8469">supplications</char>.<verse eid="PSA 130:2" /></para>
	<para style="q1"><verse number="3" style="v" x-unrepresented-source="י" x-unrepresented-translit="āy" x-unrepresented-src="WLC.PSA.130.3.006" sid="PSA 130:3" /><char style="w" x-id="t001" x-align="PSA.130.3.a001" x-src="WLC.PSA.130.3.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.PSA.130.3.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="PSA.130.3.a003">thou</char>, <note caller="-" style="f"><char style="ft">Hebrew <char style="it">Jah</char>.</char></note><char style="w" x-id="t003" x-align="PSA.130.3.a004" x-src="WLC.PSA.130.3.004" x-source="יָ֑הּ" x-translit="yāẖ" srcloc="WLC.PSA.130.3.004" x-head="true" lemma="יָהּ" strong="H3050">Jehovah</char>, <char style="w" x-id="t004" x-align="PSA.130.3.a003">shouldest</char> <char style="w" x-id="t005" x-align="PSA.130.3.a003" x-src="WLC.PSA.130.3.003" x-source="תִּשְׁמָר" x-translit="tišmār-" srcloc="WLC.PSA.130.3.003" x-head="true" lemma="שָׁמַר" strong="H8104">mark</char> <char style="w" x-id="t006" x-align="PSA.130.3.a002" x-src="WLC.PSA.130.3.002" x-source="עֲוֺנ֥וֹת" x-translit="ʿăwōnôṯ" srcloc="WLC.PSA.130.3.002" x-head="true" lemma="עָוֺן" strong="H5771">iniquities</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.130.3.a005">O</char> <char style="w" x-id="t008" x-align="PSA.130.3.a005" x-src="WLC.PSA.130.3.005" x-source="אֲ֝דֹנָ֗" x-translit="ʾăḏōn" srcloc="WLC.PSA.130.3.005" x-head="true" lemma="אֲדֹנָי" strong="H136">Lord</char>, <char style="w" x-id="t009" x-align="PSA.130.3.a007" x-src="WLC.PSA.130.3.007" x-source="מִ֣י" x-translit="miy" srcloc="WLC.PSA.130.3.007" x-head="true" lemma="מִי" strong="H4310">who</char> <char style="w" x-id="t010" x-align="PSA.130.3.a008">could</char> <char style="w" x-id="t011" x-align="PSA.130.3.a008" x-src="WLC.PSA.130.3.008" x-source="יַעֲמֹֽד" x-translit="yaʿămōḏ:" srcloc="WLC.PSA.130.3.008" x-head="true" lemma="עָמַד" strong="H5975">stand</char>?<verse eid="PSA 130:3" /></para>
