	<para style="q1"><verse number="19" style="v" x-unrepresented-source="ה" x-unrepresented-translit="āh" x-unrepresented-src="WLC.PSA.9.19.002" sid="PSA 9:19" /><char style="w" x-id="t001" x-align="PSA.9.19.a001" x-src="WLC.PSA.9.19.001" x-source="קוּמָ֣" x-translit="qûm" srcloc="WLC.PSA.9.19.001" x-head="true" lemma="קוּם" strong="H6965">Arise</char>, <char style="w" x-id="t002" x-align="PSA.9.19.a003">O</char> <char style="w" x-id="t003" x-align="PSA.9.19.a003" x-src="WLC.PSA.9.19.003" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.9.19.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t004" x-align="PSA.9.19.a005">let</char> <char style="w" x-id="t005" x-align="PSA.9.19.a004" x-src="WLC.PSA.9.19.004" x-source="אַל" x-translit="ʾal-" srcloc="WLC.PSA.9.19.004" x-head="true" lemma="אַל" strong="H408">not</char> <char style="w" x-id="t006" x-align="PSA.9.19.a006" x-src="WLC.PSA.9.19.006" x-source="אֱנ֑וֹשׁ" x-translit="ʾĕnôš" srcloc="WLC.PSA.9.19.006" x-head="true" lemma="אֱנוֹשׁ" strong="H582">man</char> <char style="w" x-id="t007" x-align="PSA.9.19.a005" x-src="WLC.PSA.9.19.005" x-source="יָעֹ֣ז" x-translit="yāʿōz" srcloc="WLC.PSA.9.19.005" x-head="true" lemma="עָזַז" strong="H5810">prevail</char>:</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.9.19.a007">Let</char> <char style="w" x-id="t009" x-align="PSA.9.19.a008">the</char> <char style="w" x-id="t010" x-align="PSA.9.19.a008" x-src="WLC.PSA.9.19.008" x-source="ג֝וֹיִ֗ם" x-translit="ḡôyim" srcloc="WLC.PSA.9.19.008" x-head="true" lemma="גּוֹי" strong="H1471">nations</char> <char style="w" x-id="t011" x-align="PSA.9.19.a007">be</char> <char style="w" x-id="t012" x-align="PSA.9.19.a007" x-src="WLC.PSA.9.19.007" x-source="יִשָּׁפְט֥וּ" x-translit="yiššāp̄əṭû" srcloc="WLC.PSA.9.19.007" x-head="true" lemma="שָׁפַט" strong="H8199">judged</char> <char style="w" x-id="t013" x-align="PSA.9.19.a009" x-src="WLC.PSA.9.19.009" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.9.19.009" x-head="true" lemma="עַל" strong="H5921">in</char> <char style="w" x-id="t014" x-align="PSA.9.19.a011" x-src="WLC.PSA.9.19.011" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.9.19.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t015" x-align="PSA.9.19.a010" x-src="WLC.PSA.9.19.010" x-source="פָּנֶֽי" x-translit="pāney" srcloc="WLC.PSA.9.19.010" x-head="true" lemma="פָּנֶה" strong="H6440">sight</char>.<verse eid="PSA 9:19" /></para>
