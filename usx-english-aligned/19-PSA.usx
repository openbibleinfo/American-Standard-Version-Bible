	<para style="q1"><verse number="20" style="v" sid="PSA 66:20" /><char style="w" x-id="t001" x-align="PSA.66.20.a001" x-src="WLC.PSA.66.20.001" x-source="בָּר֥וּךְ" x-translit="bārûḵ" srcloc="WLC.PSA.66.20.001" x-head="true" lemma="בָּרַךְ" strong="H1288">Blessed</char> <char style="w" x-id="t002" x-align="PSA.66.20.a001">be</char> <char style="w" x-id="t003" x-align="PSA.66.20.a002" x-src="WLC.PSA.66.20.002" x-source="אֱלֹהִ֑ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.66.20.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>,</para>
