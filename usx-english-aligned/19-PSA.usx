	<para style="q1"><verse number="16" style="v" sid="PSA 9:16" /><char style="w" x-id="t001" x-align="PSA.9.16.a002" x-src="WLC.PSA.9.16.002" x-source="יְהוָה֮" x-translit="yhwh" srcloc="WLC.PSA.9.16.002" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t002" x-align="PSA.9.16.a001">hath</char> <char style="w" x-id="t003" x-align="PSA.9.16.a001">made</char> <char style="w" x-id="t004" x-align="PSA.9.16.a001">himself</char> <char style="w" x-id="t005" x-align="PSA.9.16.a001" x-src="WLC.PSA.9.16.001" x-source="נ֤וֹדַ֨ע" x-translit="nôḏaʿ" srcloc="WLC.PSA.9.16.001" x-head="true" lemma="יָדַע" strong="H3045">known</char>, <char style="w" x-id="t006" x-align="PSA.9.16.a004">he</char> <char style="w" x-id="t007" x-align="PSA.9.16.a004">hath</char> <char style="w" x-id="t008" x-align="PSA.9.16.a004" x-src="WLC.PSA.9.16.004" x-source="עָ֫שָׂ֥ה" x-translit="ʿāśāh" srcloc="WLC.PSA.9.16.004" x-head="true" lemma="עָשָׂה" strong="H6213">executed</char> <char style="w" x-id="t009" x-align="PSA.9.16.a003" x-src="WLC.PSA.9.16.003" x-source="מִשְׁפָּ֪ט" x-translit="mišpāṭ" srcloc="WLC.PSA.9.16.003" x-head="true" lemma="מִשְׁפָּט" strong="H4941">judgment</char>:</para>
