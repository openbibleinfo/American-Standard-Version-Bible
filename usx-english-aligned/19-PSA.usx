	<chapter eid="PSA 95" />
	<chapter number="96" style="c" sid="PSA 96" />
	<para style="s1"><verse number="1" style="v" sid="PSA 96:1" />A call to worship Jehovah the Righteous Judge.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.96.1.a001">Oh</char> <char style="w" x-id="t002" x-align="PSA.96.1.a001" x-src="WLC.PSA.96.1.001" x-source="שִׁ֣ירוּ" x-translit="šiyrû" srcloc="WLC.PSA.96.1.001" x-head="true" lemma="שִׁיר" strong="H7891">sing</char> <char style="w" x-id="t003" x-align="PSA.96.1.a002" x-src="WLC.PSA.96.1.002" x-source="לַ֭" x-translit="la" srcloc="WLC.PSA.96.1.002" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t004" x-align="PSA.96.1.a003" x-src="WLC.PSA.96.1.003" x-source="יהוָה" x-translit="yhwâ" srcloc="WLC.PSA.96.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t005" x-align="PSA.96.1.a004">a</char> <char style="w" x-id="t006" x-align="PSA.96.1.a005" x-src="WLC.PSA.96.1.005" x-source="חָדָ֑שׁ" x-translit="ḥāḏāš" srcloc="WLC.PSA.96.1.005" x-head="true" lemma="חָדָשׁ" strong="H2319">new</char> <char style="w" x-id="t007" x-align="PSA.96.1.a004" x-src="WLC.PSA.96.1.004" x-source="שִׁ֣יר" x-translit="šiyr" srcloc="WLC.PSA.96.1.004" x-head="true" lemma="שִׁיר" strong="H7892">song</char>:</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.96.1.a006" x-src="WLC.PSA.96.1.006" x-source="שִׁ֥ירוּ" x-translit="šiyrû" srcloc="WLC.PSA.96.1.006" x-head="true" lemma="שִׁיר" strong="H7891">Sing</char> <char style="w" x-id="t009" x-align="PSA.96.1.a007" x-src="WLC.PSA.96.1.007" x-source="לַ֝" x-translit="la" srcloc="WLC.PSA.96.1.007" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t010" x-align="PSA.96.1.a008" x-src="WLC.PSA.96.1.008" x-source="יהוָ֗ה" x-translit="yhwāh" srcloc="WLC.PSA.96.1.008" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t011" x-align="PSA.96.1.a009" x-src="WLC.PSA.96.1.009" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.96.1.009" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t012" x-align="PSA.96.1.a010" x-src="WLC.PSA.96.1.010" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.96.1.010" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t013" x-align="PSA.96.1.a011" x-src="WLC.PSA.96.1.011" x-source="אָֽרֶץ" x-translit="ʾāreṣ:" srcloc="WLC.PSA.96.1.011" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>.<verse eid="PSA 96:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 96:2" /><char style="w" x-id="t001" x-align="PSA.96.2.a001" x-src="WLC.PSA.96.2.001" x-source="שִׁ֣ירוּ" x-translit="šiyrû" srcloc="WLC.PSA.96.2.001" x-head="true" lemma="שִׁיר" strong="H7891">Sing</char> <char style="w" x-id="t002" x-align="PSA.96.2.a002" x-src="WLC.PSA.96.2.002" x-source="לַ֭" x-translit="la" srcloc="WLC.PSA.96.2.002" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t003" x-align="PSA.96.2.a003" x-src="WLC.PSA.96.2.003" x-source="יהוָה" x-translit="yhwâ" srcloc="WLC.PSA.96.2.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t004" x-align="PSA.96.2.a004" x-src="WLC.PSA.96.2.004" x-source="בָּרֲכ֣וּ" x-translit="bārăḵû" srcloc="WLC.PSA.96.2.004" x-head="true" lemma="בָּרַךְ" strong="H1288">bless</char> <char style="w" x-id="t005" x-align="PSA.96.2.a006" x-src="WLC.PSA.96.2.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.96.2.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t006" x-align="PSA.96.2.a005" x-src="WLC.PSA.96.2.005" x-source="שְׁמ֑" x-translit="šəm" srcloc="WLC.PSA.96.2.005" x-head="true" lemma="שֵׁם" strong="H8034">name</char>;</para>
