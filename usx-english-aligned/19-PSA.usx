	<chapter number="30" style="c" sid="PSA 30" />
	<para style="s1"><verse number="1" style="v" sid="PSA 30:1" />Thanksgiving for deliverance from death.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.30.0.a001">A</char> <char style="w" x-id="t002" x-align="PSA.30.0.a001" x-src="WLC.PSA.30.0.001" x-source="מִזְמ֡וֹר" x-translit="mizmôr" srcloc="WLC.PSA.30.0.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char>; <char style="w" x-id="t003" x-align="PSA.30.0.a002">a</char> <char style="w" x-id="t004" x-align="PSA.30.0.a002" x-src="WLC.PSA.30.0.002" x-source="שִׁיר" x-translit="šîr-" srcloc="WLC.PSA.30.0.002" x-head="true" lemma="שִׁיר" strong="H7892">Song</char> <char style="w" x-id="t005" x-align="PSA.30.0.a003">at</char> <char style="w" x-id="t006" x-align="PSA.30.0.a003">the</char> <char style="w" x-id="t007" x-align="PSA.30.0.a003" x-src="WLC.PSA.30.0.003" x-source="חֲנֻכַּ֖ת" x-translit="ḥănukkaṯ" srcloc="WLC.PSA.30.0.003" x-head="true" lemma="חֲנֻכָּה" strong="H2598">Dedication</char> <char style="w" x-id="t008" x-align="PSA.30.0.a005">of</char> <char style="w" x-id="t009" x-align="PSA.30.0.a004" x-src="WLC.PSA.30.0.004" x-source="הַ" x-translit="ha" srcloc="WLC.PSA.30.0.004" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t010" x-align="PSA.30.0.a005" x-src="WLC.PSA.30.0.005" x-source="בַּ֣יִת" x-translit="bayiṯ" srcloc="WLC.PSA.30.0.005" x-head="true" lemma="בַּיִת" strong="H1004">House</char>. <char style="add"><char style="w" x-id="t011" x-align="PSA.30.0.a006" x-status="added">A</char> <char style="w" x-id="t012" x-align="PSA.30.0.a006" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t013" x-align="PSA.30.0.a007" x-src="WLC.PSA.30.0.006" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.30.0.006" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t014" x-align="PSA.30.0.a008" x-src="WLC.PSA.30.0.007" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.30.0.007" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.30.1.a001">I</char> <char style="w" x-id="t002" x-align="PSA.30.1.a001">will</char> <char style="w" x-id="t003" x-align="PSA.30.1.a001" x-src="WLC.PSA.30.1.001" x-source="אֲרוֹמִמְ" x-translit="ʾărômim" srcloc="WLC.PSA.30.1.001" x-head="true" lemma="רוּם" strong="H7311">extol</char> <char style="w" x-id="t004" x-align="PSA.30.1.a002" x-src="WLC.PSA.30.1.002" x-source="ךָ֣" x-translit="əḵā" srcloc="WLC.PSA.30.1.002" x-head="true" lemma="הוּא" strong="H3509b">thee</char>, <char style="w" x-id="t005" x-align="PSA.30.1.a003">O</char> <char style="w" x-id="t006" x-align="PSA.30.1.a003" x-src="WLC.PSA.30.1.003" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.30.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t007" x-align="PSA.30.1.a004" x-src="WLC.PSA.30.1.004" x-source="כִּ֣י" x-translit="kiy" srcloc="WLC.PSA.30.1.004" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t008" x-align="PSA.30.1.a005">thou</char> <char style="w" x-id="t009" x-align="PSA.30.1.a005">hast</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">drawn</char></char></note><char style="w" x-id="t010" x-align="PSA.30.1.a005" x-src="WLC.PSA.30.1.005" x-source="דִלִּיתָ֑" x-translit="ḏilliyṯā" srcloc="WLC.PSA.30.1.005" x-head="true" lemma="דָּלָה" strong="H1802">raised</char> <char style="w" x-id="t011" x-align="PSA.30.1.a006" x-src="WLC.PSA.30.1.006" x-source="נִי" x-translit="niy" srcloc="WLC.PSA.30.1.006" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t012" x-align="PSA.30.1.a005">up</char>,</para>
	<para style="q1"><char style="w" x-id="t013" x-align="PSA.30.1.a007" x-src="WLC.PSA.30.1.007" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.30.1.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t014" x-align="PSA.30.1.a009">hast</char> <char style="w" x-id="t015" x-align="PSA.30.1.a008" x-src="WLC.PSA.30.1.008" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.PSA.30.1.008" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t016" x-align="PSA.30.1.a009">made</char> <char style="w" x-id="t017" x-align="PSA.30.1.a011" x-src="WLC.PSA.30.1.011" x-source="י" x-translit="ay" srcloc="WLC.PSA.30.1.011" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t018" x-align="PSA.30.1.a010" x-src="WLC.PSA.30.1.010" x-source="אֹיְבַ֣" x-translit="ʾōyəḇ" srcloc="WLC.PSA.30.1.010" x-head="true" lemma="אָיַב" strong="H341">foes</char> <char style="w" x-id="t019" x-align="PSA.30.1.a009">to</char> <char style="w" x-id="t020" x-align="PSA.30.1.a009" x-src="WLC.PSA.30.1.009" x-source="שִׂמַּ֖חְתָּ" x-translit="śimmaḥətā" srcloc="WLC.PSA.30.1.009" x-head="true" lemma="שָׂמַח" strong="H8055">rejoice</char> <char style="w" x-id="t021" x-align="PSA.30.1.a012" x-src="WLC.PSA.30.1.012" x-source="לִֽ" x-translit="l" srcloc="WLC.PSA.30.1.012" x-head="true" lemma="לְ" strong="H3807a">over</char> <char style="w" x-id="t022" x-align="PSA.30.1.a013" x-src="WLC.PSA.30.1.013" x-source="י" x-translit="iy" srcloc="WLC.PSA.30.1.013" x-head="true" lemma="הוּא" strong="H2967a">me</char>.<verse eid="PSA 30:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 30:2" /><char style="w" x-id="t001" x-align="PSA.30.2.a001">O</char> <char style="w" x-id="t002" x-align="PSA.30.2.a001" x-src="WLC.PSA.30.2.001" x-source="יְהוָ֥ה" x-translit="yəhwāh" srcloc="WLC.PSA.30.2.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t003" x-align="PSA.30.2.a003" x-src="WLC.PSA.30.2.003" x-source="י" x-translit="āy" srcloc="WLC.PSA.30.2.003" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t004" x-align="PSA.30.2.a002" x-src="WLC.PSA.30.2.002" x-source="אֱלֹהָ֑" x-translit="ʾĕlōh" srcloc="WLC.PSA.30.2.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>,</para>
	<para style="q1"><char style="w" x-id="t005" x-align="PSA.30.2.a004">I</char> <char style="w" x-id="t006" x-align="PSA.30.2.a004" x-src="WLC.PSA.30.2.004" x-source="שִׁוַּ֥עְתִּי" x-translit="šiwwaʿətî" srcloc="WLC.PSA.30.2.004" x-head="true" lemma="שָׁוַע" strong="H7768">cried</char> <char style="w" x-id="t007" x-align="PSA.30.2.a005" x-src="WLC.PSA.30.2.005" x-source="אֵ֝לֶ֗י" x-translit="ʾēley" srcloc="WLC.PSA.30.2.005" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t008" x-align="PSA.30.2.a006" x-src="WLC.PSA.30.2.006" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.30.2.006" x-head="true" lemma="הוּא" strong="H3509b">thee</char>, <char style="w" x-id="t009" x-align="PSA.30.2.a007" x-src="WLC.PSA.30.2.007" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.30.2.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t010" x-align="PSA.30.2.a008">thou</char> <char style="w" x-id="t011" x-align="PSA.30.2.a008">hast</char> <char style="w" x-id="t012" x-align="PSA.30.2.a008" x-src="WLC.PSA.30.2.008" x-source="תִּרְפָּאֵֽ" x-translit="tirpāʾ" srcloc="WLC.PSA.30.2.008" x-head="true" lemma="רָפָא" strong="H7495">healed</char> <char style="w" x-id="t013" x-align="PSA.30.2.a009" x-src="WLC.PSA.30.2.009" x-source="נִי" x-translit="ēniy" srcloc="WLC.PSA.30.2.009" x-head="true" lemma="הוּא" strong="H5204a">me</char>.<verse eid="PSA 30:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="PSA 30:3" /><char style="w" x-id="t001" x-align="PSA.30.3.a001">O</char> <char style="w" x-id="t002" x-align="PSA.30.3.a001" x-src="WLC.PSA.30.3.001" x-source="יְֽהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.30.3.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t003" x-align="PSA.30.3.a002">thou</char> <char style="w" x-id="t004" x-align="PSA.30.3.a002">hast</char> <char style="w" x-id="t005" x-align="PSA.30.3.a002" x-src="WLC.PSA.30.3.002" x-source="הֶֽעֱלִ֣יתָ" x-translit="heʿĕliyṯā" srcloc="WLC.PSA.30.3.002" x-head="true" lemma="עָלָה" strong="H5927">brought</char> <char style="w" x-id="t006" x-align="PSA.30.3.a002">up</char> <char style="w" x-id="t007" x-align="PSA.30.3.a006" x-src="WLC.PSA.30.3.006" x-source="י" x-translit="iy" srcloc="WLC.PSA.30.3.006" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t008" x-align="PSA.30.3.a005" x-src="WLC.PSA.30.3.005" x-source="נַפְשִׁ֑" x-translit="nap̄š" srcloc="WLC.PSA.30.3.005" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char> <char style="w" x-id="t009" x-align="PSA.30.3.a003" x-src="WLC.PSA.30.3.003" x-source="מִן" x-translit="min-" srcloc="WLC.PSA.30.3.003" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t010" x-align="PSA.30.3.a004" x-src="WLC.PSA.30.3.004" x-source="שְׁא֣וֹל" x-translit="šəʾôl" srcloc="WLC.PSA.30.3.004" x-head="true" lemma="שְׁאוֹל" strong="H7585">Sheol</char>;</para>
	<para style="q1"><char style="w" x-id="t011" x-align="PSA.30.3.a007">Thou</char> <char style="w" x-id="t012" x-align="PSA.30.3.a007">hast</char> <char style="w" x-id="t013" x-align="PSA.30.3.a007">kept</char> <char style="w" x-id="t014" x-align="PSA.30.3.a008" x-src="WLC.PSA.30.3.008" x-source="נִי" x-translit="niy" srcloc="WLC.PSA.30.3.008" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t015" x-align="PSA.30.3.a007" x-src="WLC.PSA.30.3.007" x-source="חִ֝יִּיתַ֗" x-translit="ḥiyyiyṯa" srcloc="WLC.PSA.30.3.007" x-head="true" lemma="חָיָה" strong="H2421">alive</char>, <note caller="-" style="f"><char style="ft">Another reading is, <char style="it">from among them that go down to the pit</char>.</char></note><char style="w" x-id="t016" x-align="PSA.30.3.a009" x-src="WLC.PSA.30.3.009" x-source="מִ" x-translit="**mi" srcloc="WLC.PSA.30.3.009" x-head="true" lemma="מִן" strong="H4480">that</char> <char style="w" x-id="t017" x-align="PSA.30.3.a011" x-src="WLC.PSA.30.3.011" x-source="י" x-translit="iy-" srcloc="WLC.PSA.30.3.011" x-head="true" lemma="הוּא" strong="H5204a">I</char> <char style="w" x-id="t018" x-align="PSA.30.3.a010">should</char> <char style="w" x-id="t019" x-align="PSA.30.3.a009">not</char> <char style="w" x-id="t020" x-align="PSA.30.3.a010" x-src="WLC.PSA.30.3.010" x-source="יָּֽרְדִ" x-translit="yyārəḏ" srcloc="WLC.PSA.30.3.010" x-head="true" lemma="יָרַד" strong="H3381">go</char> <char style="w" x-id="t021" x-align="PSA.30.3.a010">down</char> <char style="w" x-id="t022" x-align="PSA.30.3.a012">to</char> <char style="w" x-id="t023" x-align="PSA.30.3.a012">the</char> <char style="w" x-id="t024" x-align="PSA.30.3.a012" x-src="WLC.PSA.30.3.012" x-source="בֽוֹר" x-translit="ḇôr:" srcloc="WLC.PSA.30.3.012" x-head="true" lemma="בּוֹר" strong="H953">pit</char>.<verse eid="PSA 30:3" /></para>
