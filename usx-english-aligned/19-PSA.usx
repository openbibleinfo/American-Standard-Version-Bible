	<para style="q1"><char style="w" x-id="t010" x-align="PSA.96.4.a008" x-src="WLC.PSA.96.4.008" x-source="ה֝֗וּא" x-translit="hûʾ" srcloc="WLC.PSA.96.4.008" x-head="true" lemma="הוּא" strong="H1931">He</char> <char style="w" x-id="t011" x-align="PSA.96.4.a007">is</char> <char style="w" x-id="t012" x-align="PSA.96.4.a007">to</char> <char style="w" x-id="t013" x-align="PSA.96.4.a007">be</char> <char style="w" x-id="t014" x-align="PSA.96.4.a007" x-src="WLC.PSA.96.4.007" x-source="נוֹרָ֥א" x-translit="nôrāʾ" srcloc="WLC.PSA.96.4.007" x-head="true" lemma="יָרֵא" strong="H3372">feared</char> <char style="w" x-id="t015" x-align="PSA.96.4.a009" x-src="WLC.PSA.96.4.009" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.96.4.009" x-head="true" lemma="עַל" strong="H5921">above</char> <char style="w" x-id="t016" x-align="PSA.96.4.a010" x-src="WLC.PSA.96.4.010" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.96.4.010" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t017" x-align="PSA.96.4.a011" x-src="WLC.PSA.96.4.011" x-source="אֱלֹהִֽים" x-translit="ʾĕlōhiym:" srcloc="WLC.PSA.96.4.011" x-head="true" lemma="אֱלֹהִים" strong="H430">gods</char>.<verse eid="PSA 96:4" /></para>
