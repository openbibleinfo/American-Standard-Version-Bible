	<para style="s1"><verse number="1" style="v" x-unrepresented-source="אֶל" x-unrepresented-translit="ʾel-" x-unrepresented-src="WLC.PSA.41.1.003" sid="PSA 41:1" />The psalmist in sickness complains of enemies and false friends.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.41.0.a001" x-src="WLC.PSA.41.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.41.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.41.0.a002" x-src="WLC.PSA.41.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.41.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.41.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.41.0.a003" x-src="WLC.PSA.41.0.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.41.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.41.0.a004">A</char> <char style="w" x-id="t006" x-align="PSA.41.0.a004" x-src="WLC.PSA.41.0.004" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.41.0.004" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t007" x-align="PSA.41.0.a005" x-src="WLC.PSA.41.0.005" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.41.0.005" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.41.0.a006" x-src="WLC.PSA.41.0.006" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.41.0.006" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.41.1.a001" x-src="WLC.PSA.41.1.001" x-source="אַ֭שְׁרֵי" x-translit="ʾašrê" srcloc="WLC.PSA.41.1.001" x-head="true" lemma="אֶשֶׁר" strong="H835a">Blessed</char> <char style="w" x-id="t002" x-align="PSA.41.1.a001">is</char> <char style="w" x-id="t003" x-align="PSA.41.1.a002">he</char> <char style="w" x-id="t004" x-align="PSA.41.1.a002">that</char> <char style="w" x-id="t005" x-align="PSA.41.1.a002" x-src="WLC.PSA.41.1.002" x-source="מַשְׂכִּ֣יל" x-translit="maśkiyl" srcloc="WLC.PSA.41.1.002" x-head="true" lemma="שָׂכַל" strong="H7919">considereth</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">the weak</char></char></note><char style="w" x-id="t006" x-align="PSA.41.1.a004">the</char> <char style="w" x-id="t007" x-align="PSA.41.1.a004" x-src="WLC.PSA.41.1.004" x-source="דָּ֑ל" x-translit="dāl" srcloc="WLC.PSA.41.1.004" x-head="true" lemma="דַּל" strong="H1800">poor</char>:</para>
