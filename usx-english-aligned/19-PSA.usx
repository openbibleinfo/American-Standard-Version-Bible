	<para style="q1"><verse number="2" style="v" x-unrepresented-source="י֮ ה בְ" x-unrepresented-translit="āy āh ḇə" x-unrepresented-src="WLC.PSA.130.2.002 WLC.PSA.130.2.004 WLC.PSA.130.2.005" sid="PSA 130:2" /><char style="w" x-id="t001" x-align="PSA.130.2.a001" x-src="WLC.PSA.130.2.001" x-source="אֲדֹנָ" x-translit="ʾăḏōn" srcloc="WLC.PSA.130.2.001" x-head="true" lemma="אֲדֹנָי" strong="H136">Lord</char>, <char style="w" x-id="t002" x-align="PSA.130.2.a003" x-src="WLC.PSA.130.2.003" x-source="שִׁמְעָ֪" x-translit="šimʿ" srcloc="WLC.PSA.130.2.003" x-head="true" lemma="שָׁמַע" strong="H8085">hear</char> <char style="w" x-id="t003" x-align="PSA.130.2.a007" x-src="WLC.PSA.130.2.007" x-source="י" x-translit="iy" srcloc="WLC.PSA.130.2.007" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t004" x-align="PSA.130.2.a006" x-src="WLC.PSA.130.2.006" x-source="ק֫וֹלִ֥" x-translit="qôl" srcloc="WLC.PSA.130.2.006" x-head="true" lemma="קוֹל" strong="H6963">voice</char>:</para>
