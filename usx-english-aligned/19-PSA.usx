	<para style="s1"><verse number="1" style="v" x-unrepresented-source="בְּֽ בוֹא אֵ֭לָי ו נָתָ֣ן הַ נָּבִ֑יא כַּֽ אֲשֶׁר בָּ֝֗א אֶל בַּת שָֽׁבַע" x-unrepresented-translit="bə ḇôʾ- ʾēlāy w nāṯān ha nnāḇiyʾ ka ʾăšer- bāʾ ʾel- baṯ-šāḇaʿ baṯ-šāḇaʿ" x-unrepresented-src="WLC.PSA.51.1.001 WLC.PSA.51.1.002 WLC.PSA.51.1.003 WLC.PSA.51.1.004 WLC.PSA.51.1.005 WLC.PSA.51.1.006 WLC.PSA.51.1.007 WLC.PSA.51.1.008 WLC.PSA.51.1.009 WLC.PSA.51.1.010 WLC.PSA.51.1.011 WLC.PSA.51.1.012 WLC.PSA.51.1.013" sid="PSA 51:1" />A contrite sinner’s prayer for pardon.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.51.0.a001" x-src="WLC.PSA.51.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.51.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.51.0.a002" x-src="WLC.PSA.51.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.51.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.51.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.51.0.a003" x-src="WLC.PSA.51.0.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.51.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.51.0.a004">A</char> <char style="w" x-id="t006" x-align="PSA.51.0.a004" x-src="WLC.PSA.51.0.004" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.51.0.004" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t007" x-align="PSA.51.0.a005" x-src="WLC.PSA.51.0.005" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.51.0.005" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.51.0.a006" x-src="WLC.PSA.51.0.006" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.51.0.006" x-head="true" lemma="דָּוִד" strong="H1732">David</char>; <char style="w" x-id="t009" x-align="PSA.51.0.a007" x-status="added" x-source="∅">when</char> <char style="w" x-id="t010" x-align="PSA.51.0.a007" x-status="added">Nathan</char> <char style="w" x-id="t011" x-align="PSA.51.0.a007" x-status="added">the</char> <char style="w" x-id="t012" x-align="PSA.51.0.a007" x-status="added">prophet</char> <char style="w" x-id="t013" x-align="PSA.51.0.a007" x-status="added">came</char> <char style="w" x-id="t014" x-align="PSA.51.0.a007" x-status="added">unto</char> <char style="w" x-id="t015" x-align="PSA.51.0.a007" x-status="added">him</char>, <char style="w" x-id="t016" x-align="PSA.51.0.a007" x-status="added">after</char> <char style="w" x-id="t017" x-align="PSA.51.0.a007" x-status="added">he</char> <char style="w" x-id="t018" x-align="PSA.51.0.a007" x-status="added">had</char> <char style="w" x-id="t019" x-align="PSA.51.0.a007" x-status="added">gone</char> <char style="w" x-id="t020" x-align="PSA.51.0.a007" x-status="added">in</char> <char style="w" x-id="t021" x-align="PSA.51.0.a007" x-status="added">to</char> <char style="w" x-id="t022" x-align="PSA.51.0.a007" x-status="added">Bath</char>-<char style="w" x-id="t023" x-align="PSA.51.0.a007" x-status="added">sheba</char>.</para>
