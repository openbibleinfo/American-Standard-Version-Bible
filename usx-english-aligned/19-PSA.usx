	<para style="q1"><char style="w" x-id="t010" x-align="PSA.98.1.a007" x-src="WLC.PSA.98.1.007" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.98.1.007" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t011" x-align="PSA.98.1.a009">he</char> <char style="w" x-id="t012" x-align="PSA.98.1.a009">hath</char> <char style="w" x-id="t013" x-align="PSA.98.1.a009" x-src="WLC.PSA.98.1.009" x-source="עָשָׂ֑ה" x-translit="ʿāśāh" srcloc="WLC.PSA.98.1.009" x-head="true" lemma="עָשָׂה" strong="H6213">done</char> <char style="w" x-id="t014" x-align="PSA.98.1.a008" x-src="WLC.PSA.98.1.008" x-source="נִפְלָא֣וֹת" x-translit="nip̄lāʾôṯ" srcloc="WLC.PSA.98.1.008" x-head="true" lemma="פָּלָא" strong="H6381">marvellous</char> <char style="w" x-id="t015" x-align="PSA.98.1.a008">things</char>:</para>
