	<para style="s1"><verse number="1" style="v" sid="PSA 87:1" />The privileges of citizenship in Zion.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.87.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.87.1.a001" x-src="WLC.PSA.87.1.004" x-source="מִזְמ֣וֹר" x-translit="mizmôr" srcloc="WLC.PSA.87.1.004" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.87.1.a002" x-src="WLC.PSA.87.1.001" x-source="לִ" x-translit="li" srcloc="WLC.PSA.87.1.001" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.87.1.a003">the</char> <char style="w" x-id="t005" x-align="PSA.87.1.a003" x-src="WLC.PSA.87.1.002" x-source="בְנֵי" x-translit="ḇənê-" srcloc="WLC.PSA.87.1.002" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t006" x-align="PSA.87.1.a004">of</char> <char style="w" x-id="t007" x-align="PSA.87.1.a004" x-src="WLC.PSA.87.1.003" x-source="קֹ֭רַח" x-translit="qōraḥ" srcloc="WLC.PSA.87.1.003" x-head="true" lemma="קֹרַח" strong="H7141">Korah</char>; <char style="w" x-id="t008" x-align="PSA.87.1.a005">a</char> <char style="w" x-id="t009" x-align="PSA.87.1.a005" x-src="WLC.PSA.87.1.005" x-source="שִׁ֑יר" x-translit="šiyr" srcloc="WLC.PSA.87.1.005" x-head="true" lemma="שִׁיר" strong="H7892">Song</char>.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">His foundation in the holy mountains Jehovah loveth, even the gates etc.</char></char></note><char style="w" x-id="t010" x-align="PSA.87.1.a007" x-src="WLC.PSA.87.1.007" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.87.1.007" x-head="true" lemma="הוּא" strong="H2050c">His</char> <char style="w" x-id="t011" x-align="PSA.87.1.a006" x-src="WLC.PSA.87.1.006" x-source="יְ֝סוּדָת֗" x-translit="yəsûḏāṯ" srcloc="WLC.PSA.87.1.006" x-head="true" lemma="יְסוּדָה" strong="H3248">foundation</char> <char style="w" x-id="t012" x-align="PSA.87.1.a008">is</char> <char style="w" x-id="t013" x-align="PSA.87.1.a008" x-src="WLC.PSA.87.1.008" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.87.1.008" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t014" x-align="PSA.87.1.a009">the</char> <char style="w" x-id="t015" x-align="PSA.87.1.a010" x-src="WLC.PSA.87.1.010" x-source="קֹֽדֶשׁ" x-translit="qōḏeš:" srcloc="WLC.PSA.87.1.010" x-head="true" lemma="קֹדֶשׁ" strong="H6944">holy</char> <char style="w" x-id="t016" x-align="PSA.87.1.a009" x-src="WLC.PSA.87.1.009" x-source="הַרְרֵי" x-translit="harərê-" srcloc="WLC.PSA.87.1.009" x-head="true" lemma="הַר" strong="H2022">mountains</char>.<verse eid="PSA 87:1" /></para>
