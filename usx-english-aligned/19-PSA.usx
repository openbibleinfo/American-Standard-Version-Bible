	<para style="q1"><char style="w" x-id="t007" x-align="PSA.108.12.a008" x-src="WLC.PSA.108.12.008" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.108.12.008" x-head="true" lemma="וְ" strong="H2050b">For</char> <char style="w" x-id="t008" x-align="PSA.108.12.a009" x-src="WLC.PSA.108.12.009" x-source="שָׁ֗וְא" x-translit="šāwəʾ" srcloc="WLC.PSA.108.12.009" x-head="true" lemma="שָׁוְא" strong="H7723">vain</char> <char style="w" x-id="t009" x-align="PSA.108.12.a009">is</char> <char style="w" x-id="t010" x-align="PSA.108.12.a010">the</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">salvation</char>.</char></note><char style="w" x-id="t011" x-align="PSA.108.12.a010" x-src="WLC.PSA.108.12.010" x-source="תְּשׁוּעַ֥ת" x-translit="təšûʿaṯ" srcloc="WLC.PSA.108.12.010" x-head="true" lemma="תְּשׁוּעָה" strong="H8668">help</char> <char style="w" x-id="t012" x-align="PSA.108.12.a011">of</char> <char style="w" x-id="t013" x-align="PSA.108.12.a011" x-src="WLC.PSA.108.12.011" x-source="אָדָֽם" x-translit="ʾāḏām:" srcloc="WLC.PSA.108.12.011" x-head="true" lemma="אָדָם" strong="H120">man</char>.<verse eid="PSA 108:12" /></para>
