	<chapter eid="PSA 97" />
	<chapter number="98" style="c" sid="PSA 98" />
	<para style="s1"><verse number="1" style="v" sid="PSA 98:1" />A call to praise Jehovah for his righteousness.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.98.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.98.1.a001" x-src="WLC.PSA.98.1.001" x-source="מִזְמ֡וֹר" x-translit="mizmôr" srcloc="WLC.PSA.98.1.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char>.</para>
