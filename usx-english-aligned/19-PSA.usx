	<para style="q1"><char style="w" x-id="t009" x-align="PSA.61.5.a008">Thou</char> <char style="w" x-id="t010" x-align="PSA.61.5.a008">hast</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">given a heritage unto those etc.</char></char></note><char style="w" x-id="t011" x-align="PSA.61.5.a008" x-src="WLC.PSA.61.5.008" x-source="נָתַ֥תָּ" x-translit="nāṯatā" srcloc="WLC.PSA.61.5.008" x-head="true" lemma="נָתַן" strong="H5414">given</char> <char style="add"><char style="w" x-id="t012" x-align="PSA.61.5.a009" x-status="added" x-source="∅" x-head="true">me</char></char> <char style="w" x-id="t013" x-align="PSA.61.5.a010">the</char> <char style="w" x-id="t014" x-align="PSA.61.5.a010" x-src="WLC.PSA.61.5.009" x-source="יְ֝רֻשַּׁ֗ת" x-translit="yəruššaṯ" srcloc="WLC.PSA.61.5.009" x-head="true" lemma="יְרֻשָּׁה" strong="H3425">heritage</char> <char style="w" x-id="t015" x-align="PSA.61.5.a011">of</char> <char style="w" x-id="t016" x-align="PSA.61.5.a011">those</char> <char style="w" x-id="t017" x-align="PSA.61.5.a011">that</char> <char style="w" x-id="t018" x-align="PSA.61.5.a011" x-src="WLC.PSA.61.5.010" x-source="יִרְאֵ֥י" x-translit="yirʾēy" srcloc="WLC.PSA.61.5.010" x-head="true" lemma="יָרֵא" strong="H3373">fear</char> <char style="w" x-id="t019" x-align="PSA.61.5.a013" x-src="WLC.PSA.61.5.012" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.61.5.012" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t020" x-align="PSA.61.5.a012" x-src="WLC.PSA.61.5.011" x-source="שְׁמֶֽ" x-translit="šəm" srcloc="WLC.PSA.61.5.011" x-head="true" lemma="שֵׁם" strong="H8034">name</char>.<verse eid="PSA 61:5" /></para>
	<para style="q1"><verse number="6" style="v" x-unrepresented-source="יָמִ֣ים עַל וָ דֹֽר" x-unrepresented-translit="yāmiym ʿal- wā ḏōr:" x-unrepresented-src="WLC.PSA.61.6.001 WLC.PSA.61.6.002 WLC.PSA.61.6.010 WLC.PSA.61.6.011" sid="PSA 61:6" /><char style="w" x-id="t001" x-align="PSA.61.6.a005">Thou</char> <char style="w" x-id="t002" x-align="PSA.61.6.a005">wilt</char> <char style="w" x-id="t003" x-align="PSA.61.6.a005" x-src="WLC.PSA.61.6.005" x-source="תּוֹסִ֑יף" x-translit="tôsiyp̄" srcloc="WLC.PSA.61.6.005" x-head="true" lemma="יָסַף" strong="H3254">prolong</char> <char style="w" x-id="t004" x-align="PSA.61.6.a004">the</char> <char style="w" x-id="t005" x-align="PSA.61.6.a004" x-src="WLC.PSA.61.6.004" x-source="מֶ֣לֶךְ" x-translit="meleḵ" srcloc="WLC.PSA.61.6.004" x-head="true" lemma="מֶלֶךְ" strong="H4428">king’s</char> <char style="w" x-id="t006" x-align="PSA.61.6.a003" x-src="WLC.PSA.61.6.003" x-source="יְמֵי" x-translit="yəmê-" srcloc="WLC.PSA.61.6.003" x-head="true" lemma="יוֹם" strong="H3117">life</char>;</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.61.6.a007" x-src="WLC.PSA.61.6.007" x-source="ו" x-translit="w" srcloc="WLC.PSA.61.6.007" x-head="true" lemma="הוּא" strong="H2050c">His</char> <char style="w" x-id="t008" x-align="PSA.61.6.a006" x-src="WLC.PSA.61.6.006" x-source="שְׁ֝נוֹתָ֗י" x-translit="šənôṯāy" srcloc="WLC.PSA.61.6.006" x-head="true" lemma="שָׁנָה" strong="H8141">years</char> <char style="w" x-id="t009" x-align="PSA.61.6.a008">shall</char> <char style="w" x-id="t010" x-align="PSA.61.6.a008">be</char> <char style="w" x-id="t011" x-align="PSA.61.6.a008" x-src="WLC.PSA.61.6.008" x-source="כְּמוֹ" x-translit="kəmô-" srcloc="WLC.PSA.61.6.008" x-head="true" lemma="כְּמוֹ" strong="H3644">as</char> <char style="w" x-id="t012" x-align="PSA.61.6.a009">many</char> <char style="w" x-id="t013" x-align="PSA.61.6.a009" x-src="WLC.PSA.61.6.009" x-source="דֹ֥ר" x-translit="ḏōr" srcloc="WLC.PSA.61.6.009" x-head="true" lemma="דּוֹר" strong="H1755">generations</char>.<verse eid="PSA 61:6" /></para>
	<para style="q1"><verse number="7" style="v" sid="PSA 61:7" /><char style="w" x-id="t001" x-align="PSA.61.7.a001">He</char> <char style="w" x-id="t002" x-align="PSA.61.7.a001">shall</char> <char style="w" x-id="t003" x-align="PSA.61.7.a001" x-src="WLC.PSA.61.7.001" x-source="יֵשֵׁ֣ב" x-translit="yēšēḇ" srcloc="WLC.PSA.61.7.001" x-head="true" lemma="יָשַׁב" strong="H3427">abide</char> <char style="w" x-id="t004" x-align="PSA.61.7.a003" x-src="WLC.PSA.61.7.003 WLC.PSA.61.7.004" x-source="לִ פְנֵ֣י" x-translit="li p̄ənēy" srcloc="WLC.PSA.61.7.004" x-head="true" lemma="פָּנֶה" strong="H6440">before</char> <char style="w" x-id="t005" x-align="PSA.61.7.a004" x-src="WLC.PSA.61.7.005" x-source="אֱלֹהִ֑ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.61.7.005" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t006" x-align="PSA.61.7.a002">for</char> <char style="w" x-id="t007" x-align="PSA.61.7.a002" x-src="WLC.PSA.61.7.002" x-source="ע֭וֹלָם" x-translit="ʿôlām" srcloc="WLC.PSA.61.7.002" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char>:</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.61.7.a008">Oh</char> <char style="w" x-id="t009" x-align="PSA.61.7.a008" x-src="WLC.PSA.61.7.009" x-source="מַ֣ן" x-translit="man" srcloc="WLC.PSA.61.7.009" x-head="true" lemma="מָנָה" strong="H4487">prepare</char> <char style="w" x-id="t010" x-align="PSA.61.7.a005" x-src="WLC.PSA.61.7.006" x-source="חֶ֥סֶד" x-translit="ḥeseḏ" srcloc="WLC.PSA.61.7.006" x-head="true" lemma="חֶסֶד" strong="H2617">lovingkindness</char> <char style="w" x-id="t011" x-align="PSA.61.7.a006" x-src="WLC.PSA.61.7.007" x-source="וֶ֝" x-translit="we" srcloc="WLC.PSA.61.7.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t012" x-align="PSA.61.7.a007" x-src="WLC.PSA.61.7.008" x-source="אֱמֶ֗ת" x-translit="ʾĕmeṯ" srcloc="WLC.PSA.61.7.008" x-head="true" lemma="אֱמֶת" strong="H571">truth</char>, <char style="w" x-id="t013" x-align="PSA.61.7.a009" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t014" x-align="PSA.61.7.a010">they</char> <char style="w" x-id="t015" x-align="PSA.61.7.a010">may</char> <char style="w" x-id="t016" x-align="PSA.61.7.a010" x-src="WLC.PSA.61.7.010" x-source="יִנְצְרֻֽ" x-translit="yinṣəru" srcloc="WLC.PSA.61.7.010" x-head="true" lemma="נָצַר" strong="H5341">preserve</char> <char style="w" x-id="t017" x-align="PSA.61.7.a011" x-src="WLC.PSA.61.7.011" x-source="הוּ" x-translit="hû" srcloc="WLC.PSA.61.7.011" x-head="true" lemma="הוּא" strong="H1930a">him</char>.<verse eid="PSA 61:7" /></para>
	<para style="q1"><verse number="8" style="v" sid="PSA 61:8" /><char style="w" x-id="t001" x-align="PSA.61.8.a001" x-src="WLC.PSA.61.8.001" x-source="כֵּ֤ן" x-translit="kēn" srcloc="WLC.PSA.61.8.001" x-head="true" lemma="כֵּן" strong="H3651">So</char> <char style="w" x-id="t002" x-align="PSA.61.8.a002">will</char> <char style="w" x-id="t003" x-align="PSA.61.8.a002">I</char> <char style="w" x-id="t004" x-align="PSA.61.8.a002" x-src="WLC.PSA.61.8.002" x-source="אֲזַמְּרָ֣ה" x-translit="ʾăzammərāh" srcloc="WLC.PSA.61.8.002" x-head="true" lemma="זָמַר" strong="H2167">sing</char> <char style="w" x-id="t005" x-align="PSA.61.8.a002">praise</char> <char style="w" x-id="t006" x-align="PSA.61.8.a002">unto</char> <char style="w" x-id="t007" x-align="PSA.61.8.a004" x-src="WLC.PSA.61.8.004" x-source="ךָ֣" x-translit="əḵā" srcloc="WLC.PSA.61.8.004" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t008" x-align="PSA.61.8.a003" x-src="WLC.PSA.61.8.003" x-source="שִׁמְ" x-translit="šim" srcloc="WLC.PSA.61.8.003" x-head="true" lemma="שֵׁם" strong="H8034">name</char> <char style="w" x-id="t009" x-align="PSA.61.8.a005" x-src="WLC.PSA.61.8.005" x-source="לָ" x-translit="lā" srcloc="WLC.PSA.61.8.005" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t010" x-align="PSA.61.8.a006" x-src="WLC.PSA.61.8.006" x-source="עַ֑ד" x-translit="ʿaḏ" srcloc="WLC.PSA.61.8.006" x-head="true" lemma="עַד" strong="H5703">ever</char>,</para>
	<para style="q1"><char style="w" x-id="t011" x-align="PSA.61.8.a007" x-src="WLC.PSA.61.8.007" x-source="לְֽ" x-translit="lə" srcloc="WLC.PSA.61.8.007" x-head="true" lemma="לְ" strong="H3807a">That</char> <char style="w" x-id="t012" x-align="PSA.61.8.a009" x-src="WLC.PSA.61.8.009" x-source="י" x-translit="iy" srcloc="WLC.PSA.61.8.009" x-head="true" lemma="הוּא" strong="H5204a">I</char> <char style="w" x-id="t013" x-align="PSA.61.8.a008">may</char> <char style="w" x-id="t014" x-align="PSA.61.8.a012" x-src="WLC.PSA.61.8.012 WLC.PSA.61.8.013" x-source="י֣וֹם יֽוֹם" x-translit="yôm yôm:" srcloc="WLC.PSA.61.8.012" x-head="true" lemma="יוֹם" strong="H3117">daily</char> <char style="w" x-id="t015" x-align="PSA.61.8.a008" x-src="WLC.PSA.61.8.008" x-source="שַׁלְּמִ֥" x-translit="šalləm" srcloc="WLC.PSA.61.8.008" x-head="true" lemma="שָׁלֵם" strong="H7999">perform</char> <char style="w" x-id="t016" x-align="PSA.61.8.a011" x-src="WLC.PSA.61.8.011" x-source="י" x-translit="ay" srcloc="WLC.PSA.61.8.011" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t017" x-align="PSA.61.8.a010" x-src="WLC.PSA.61.8.010" x-source="נְדָרַ֗" x-translit="nəḏār" srcloc="WLC.PSA.61.8.010" x-head="true" lemma="נֶדֶר" strong="H5088">vows</char>.<verse eid="PSA 61:8" /></para>
	<chapter eid="PSA 61" />
	<chapter number="62" style="c" sid="PSA 62" />
	<para style="s1"><verse number="1" style="v" sid="PSA 62:1" />God alone a refuge from treachery and oppression.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.62.0.a001" x-src="WLC.PSA.62.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.62.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.62.0.a002" x-src="WLC.PSA.62.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.62.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.62.0.a003" x-src="WLC.PSA.62.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.62.0.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.62.0.a003">Musician</char>; <char style="w" x-id="t005" x-align="PSA.62.0.a004">after</char> <char style="w" x-id="t006" x-align="PSA.62.0.a004">the</char> <char style="w" x-id="t007" x-align="PSA.62.0.a004" x-src="WLC.PSA.62.0.004" x-source="עַֽל" x-translit="ʿal-" srcloc="WLC.PSA.62.0.004" x-head="true" lemma="עַל" strong="H5921">manner</char> <char style="w" x-id="t008" x-align="PSA.62.0.a004">of</char> <char style="w" x-id="t009" x-align="PSA.62.0.a005" x-src="WLC.PSA.62.0.005" x-source="יְדוּת֗וּן" x-translit="yəḏûṯûn" srcloc="WLC.PSA.62.0.005" x-head="true" lemma="יְדוּתוּן" strong="H3038">Jeduthun</char>. <char style="w" x-id="t010" x-align="PSA.62.0.a006">A</char> <char style="w" x-id="t011" x-align="PSA.62.0.a006" x-src="WLC.PSA.62.0.006" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.62.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t012" x-align="PSA.62.0.a007" x-src="WLC.PSA.62.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.62.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t013" x-align="PSA.62.0.a008" x-src="WLC.PSA.62.0.008" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.62.0.008" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.62.1.a007" x-src="WLC.PSA.62.1.006" x-source="י" x-translit="iy" srcloc="WLC.PSA.62.1.006" x-head="true" lemma="הוּא" strong="H2967a">My</char> <char style="w" x-id="t002" x-align="PSA.62.1.a006" x-src="WLC.PSA.62.1.005" x-source="נַפְשִׁ֑" x-translit="nap̄š" srcloc="WLC.PSA.62.1.005" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">is silent unto God</char>.</char></note><char style="w" x-id="t003" x-align="PSA.62.1.a005" x-status="added" x-source="∅" x-head="true">waiteth</char> <char style="w" x-id="t004" x-align="PSA.62.1.a004">in</char> <char style="w" x-id="t005" x-align="PSA.62.1.a004" x-src="WLC.PSA.62.1.004" x-source="דּֽוּמִיָּ֣ה" x-translit="dûmiyyāh" srcloc="WLC.PSA.62.1.004" x-head="true" lemma="דּוּמִיָּה" strong="H1747">silence</char> <char style="w" x-id="t006" x-align="PSA.62.1.a002" x-src="WLC.PSA.62.1.002" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.PSA.62.1.002" x-head="true" lemma="אֶל" strong="H413">for</char> <char style="w" x-id="t007" x-align="PSA.62.1.a003" x-src="WLC.PSA.62.1.003" x-source="אֱ֭לֹהִים" x-translit="ʾĕlōhîm" srcloc="WLC.PSA.62.1.003" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t008" x-align="PSA.62.1.a001" x-src="WLC.PSA.62.1.001" x-source="אַ֣ךְ" x-translit="ʾaḵ" srcloc="WLC.PSA.62.1.001" x-head="true" lemma="אַךְ" strong="H389">only</char>:</para>
