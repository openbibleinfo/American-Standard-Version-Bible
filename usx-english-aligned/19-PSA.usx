	<para style="q1"><verse number="8" style="v" sid="PSA 35:8" /><char style="w" x-id="t001" x-align="PSA.35.8.a001">Let</char> <char style="w" x-id="t002" x-align="PSA.35.8.a003" x-src="WLC.PSA.35.8.003" x-source="שׁוֹאָה֮" x-translit="šôʾāh" srcloc="WLC.PSA.35.8.003" x-head="true" lemma="שׁוֹאָה" strong="H7722a">destruction</char> <char style="w" x-id="t003" x-align="PSA.35.8.a001" x-src="WLC.PSA.35.8.001" x-source="תְּבוֹאֵ֣" x-translit="təḇôʾ" srcloc="WLC.PSA.35.8.001" x-head="true" lemma="בּוֹא" strong="H935">come</char> <char style="w" x-id="t004" x-align="PSA.35.8.a001">upon</char> <char style="w" x-id="t005" x-align="PSA.35.8.a002" x-src="WLC.PSA.35.8.002" x-source="הוּ" x-translit="ēhû" srcloc="WLC.PSA.35.8.002" x-head="true" lemma="הוּא" strong="H1930a">him</char> <char style="w" x-id="t006" x-align="PSA.35.8.a004" x-src="WLC.PSA.35.8.004 WLC.PSA.35.8.005" x-source="לֹֽא יֵ֫דָ֥ע" x-translit="lōʾ- yēḏāʿ" srcloc="WLC.PSA.35.8.004" x-head="true" lemma="לֹא" strong="H3808">unawares</char>;</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.35.8.a005" x-src="WLC.PSA.35.8.006" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.35.8.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t008" x-align="PSA.35.8.a010">let</char> <char style="w" x-id="t009" x-align="PSA.35.8.a007" x-src="WLC.PSA.35.8.008" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.35.8.008" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t010" x-align="PSA.35.8.a006" x-src="WLC.PSA.35.8.007" x-source="רִשְׁתּ֣" x-translit="rišt" srcloc="WLC.PSA.35.8.007" x-head="true" lemma="רֶשֶׁת" strong="H7568">net</char> <char style="w" x-id="t011" x-align="PSA.35.8.a008" x-src="WLC.PSA.35.8.009" x-source="אֲשֶׁר" x-translit="ʾăšer-" srcloc="WLC.PSA.35.8.009" x-head="true" lemma="אֲשֶׁר" strong="H834">that</char> <char style="w" x-id="t012" x-align="PSA.35.8.a009">he</char> <char style="w" x-id="t013" x-align="PSA.35.8.a009">hath</char> <char style="w" x-id="t014" x-align="PSA.35.8.a009" x-src="WLC.PSA.35.8.010" x-source="טָמַ֣ן" x-translit="ṭāman" srcloc="WLC.PSA.35.8.010" x-head="true" lemma="טָמַן" strong="H2934">hid</char> <char style="w" x-id="t015" x-align="PSA.35.8.a010" x-src="WLC.PSA.35.8.011" x-source="תִּלְכְּד֑" x-translit="tilkəḏ" srcloc="WLC.PSA.35.8.011" x-head="true" lemma="לָכַד" strong="H3920">catch</char> <char style="w" x-id="t016" x-align="PSA.35.8.a011" x-src="WLC.PSA.35.8.012" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.35.8.012" x-head="true" lemma="הוּא" strong="H2050c">himself</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Into that very destruction let him fall</char></char></note><char style="w" x-id="t017" x-align="PSA.35.8.a012" x-src="WLC.PSA.35.8.013" x-source="בְּ֝" x-translit="bə" srcloc="WLC.PSA.35.8.013" x-head="true" lemma="בְּ" strong="H871a">With</char> <char style="w" x-id="t018" x-align="PSA.35.8.a013" x-src="WLC.PSA.35.8.014" x-source="שׁוֹאָ֗ה" x-translit="šôʾāh" srcloc="WLC.PSA.35.8.014" x-head="true" lemma="שׁוֹאָה" strong="H7722a">destruction</char> <char style="w" x-id="t019" x-align="PSA.35.8.a014">let</char> <char style="w" x-id="t020" x-align="PSA.35.8.a014">him</char> <char style="w" x-id="t021" x-align="PSA.35.8.a014" x-src="WLC.PSA.35.8.015" x-source="יִפָּל" x-translit="yippāl-" srcloc="WLC.PSA.35.8.015" x-head="true" lemma="נָפַל" strong="H5307">fall</char> <char style="w" x-id="t022" x-align="PSA.35.8.a015" x-src="WLC.PSA.35.8.016 WLC.PSA.35.8.017" x-source="בָּֽ הּ" x-translit="b āhh" srcloc="WLC.PSA.35.8.016" x-head="true" lemma="בְּ" strong="H871a">therein</char>.<verse eid="PSA 35:8" /></para>
	<para style="q1"><verse number="9" style="v" sid="PSA 35:9" /><char style="w" x-id="t001" x-align="PSA.35.9.a001" x-src="WLC.PSA.35.9.001" x-source="וְ֭" x-translit="wə" srcloc="WLC.PSA.35.9.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="PSA.35.9.a003" x-src="WLC.PSA.35.9.003" x-source="י" x-translit="iy" srcloc="WLC.PSA.35.9.003" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t003" x-align="PSA.35.9.a002" x-src="WLC.PSA.35.9.002" x-source="נַפְשִׁ" x-translit="nap̄š" srcloc="WLC.PSA.35.9.002" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char> <char style="w" x-id="t004" x-align="PSA.35.9.a004">shall</char> <char style="w" x-id="t005" x-align="PSA.35.9.a004">be</char> <char style="w" x-id="t006" x-align="PSA.35.9.a004" x-src="WLC.PSA.35.9.004" x-source="תָּגִ֣יל" x-translit="tāḡiyl" srcloc="WLC.PSA.35.9.004" x-head="true" lemma="גִּיל" strong="H1523">joyful</char> <char style="w" x-id="t007" x-align="PSA.35.9.a005" x-src="WLC.PSA.35.9.005" x-source="בַּ" x-translit="ba" srcloc="WLC.PSA.35.9.005" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t008" x-align="PSA.35.9.a006" x-src="WLC.PSA.35.9.006" x-source="יהוָ֑ה" x-translit="yhwāh" srcloc="WLC.PSA.35.9.006" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>:</para>
