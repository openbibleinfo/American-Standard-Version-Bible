	<para style="q1"><verse number="12" style="v" sid="PSA 27:12" /><char style="w" x-id="t001" x-align="PSA.27.12.a002" x-src="WLC.PSA.27.12.002" x-source="תִּ֭תְּנֵ" x-translit="tittən" srcloc="WLC.PSA.27.12.002" x-head="true" lemma="נָתַן" strong="H5414">Deliver</char> <char style="w" x-id="t002" x-align="PSA.27.12.a003" x-src="WLC.PSA.27.12.003" x-source="נִי" x-translit="ēniy" srcloc="WLC.PSA.27.12.003" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t003" x-align="PSA.27.12.a001" x-src="WLC.PSA.27.12.001" x-source="אַֽל" x-translit="ʾal-" srcloc="WLC.PSA.27.12.001" x-head="true" lemma="אַל" strong="H408">not</char> <char style="w" x-id="t004" x-align="PSA.27.12.a002">over</char> <char style="w" x-id="t005" x-align="PSA.27.12.a004" x-src="WLC.PSA.27.12.004" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.27.12.004" x-head="true" lemma="בְּ" strong="H871a">unto</char> <char style="w" x-id="t006" x-align="PSA.27.12.a005">the</char> <char style="w" x-id="t007" x-align="PSA.27.12.a005" x-src="WLC.PSA.27.12.005" x-source="נֶ֣פֶשׁ" x-translit="nep̄eš" srcloc="WLC.PSA.27.12.005" x-head="true" lemma="נֶפֶשׁ" strong="H5315">will</char> <char style="w" x-id="t008" x-align="PSA.27.12.a006">of</char> <char style="w" x-id="t009" x-align="PSA.27.12.a007" x-src="WLC.PSA.27.12.007" x-source="י" x-translit="āy" srcloc="WLC.PSA.27.12.007" x-head="true" lemma="הוּא" strong="H2967a">mine</char> <char style="w" x-id="t010" x-align="PSA.27.12.a006" x-src="WLC.PSA.27.12.006" x-source="צָרָ֑" x-translit="ṣār" srcloc="WLC.PSA.27.12.006" x-head="true" lemma="צַר" strong="H6862a">adversaries</char>:</para>
	<para style="q1"><char style="w" x-id="t011" x-align="PSA.27.12.a008" x-src="WLC.PSA.27.12.008" x-source="כִּ֥י" x-translit="kiy" srcloc="WLC.PSA.27.12.008" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t012" x-align="PSA.27.12.a013" x-src="WLC.PSA.27.12.013" x-source="שֶׁ֝֗קֶר" x-translit="šeqer" srcloc="WLC.PSA.27.12.013" x-head="true" lemma="שֶׁקֶר" strong="H8267">false</char> <char style="w" x-id="t013" x-align="PSA.27.12.a012" x-src="WLC.PSA.27.12.012" x-source="עֵֽדֵי" x-translit="ʿēḏê-" srcloc="WLC.PSA.27.12.012" x-head="true" lemma="עֵד" strong="H5707">witnesses</char> <char style="w" x-id="t014" x-align="PSA.27.12.a009">are</char> <char style="w" x-id="t015" x-align="PSA.27.12.a009" x-src="WLC.PSA.27.12.009" x-source="קָֽמוּ" x-translit="qāmû-" srcloc="WLC.PSA.27.12.009" x-head="true" lemma="קוּם" strong="H6965">risen</char> <char style="w" x-id="t016" x-align="PSA.27.12.a009">up</char> <char style="w" x-id="t017" x-align="PSA.27.12.a010" x-src="WLC.PSA.27.12.010" x-source="בִ֥" x-translit="ḇ" srcloc="WLC.PSA.27.12.010" x-head="true" lemma="בְּ" strong="H871a">against</char> <char style="w" x-id="t018" x-align="PSA.27.12.a011" x-src="WLC.PSA.27.12.011" x-source="י" x-translit="iy" srcloc="WLC.PSA.27.12.011" x-head="true" lemma="הוּא" strong="H2967a">me</char>,</para>
	<para style="q1"><char style="w" x-id="t019" x-align="PSA.27.12.a014" x-src="WLC.PSA.27.12.014" x-source="וִ" x-translit="wi" srcloc="WLC.PSA.27.12.014" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t020" x-align="PSA.27.12.a015">such</char> <char style="w" x-id="t021" x-align="PSA.27.12.a015">as</char> <char style="w" x-id="t022" x-align="PSA.27.12.a015" x-src="WLC.PSA.27.12.015" x-source="יפֵ֥חַ" x-translit="yp̄ēᵃḥ" srcloc="WLC.PSA.27.12.015" x-head="true" lemma="יָפֵחַ" strong="H3307">breathe</char> <char style="w" x-id="t023" x-align="PSA.27.12.a015">out</char> <char style="w" x-id="t024" x-align="PSA.27.12.a016" x-src="WLC.PSA.27.12.016" x-source="חָמָֽס" x-translit="ḥāmās:" srcloc="WLC.PSA.27.12.016" x-head="true" lemma="חָמָס" strong="H2555">cruelty</char>.<verse eid="PSA 27:12" /></para>
