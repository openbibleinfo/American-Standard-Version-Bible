	<chapter number="63" style="c" sid="PSA 63" />
	<para style="s1"><verse number="1" style="v" sid="PSA 63:1" />The thirsting soul satisfied in God.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.63.0.a001">A</char> <char style="w" x-id="t002" x-align="PSA.63.0.a001" x-src="WLC.PSA.63.0.001" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.63.0.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.63.0.a002" x-src="WLC.PSA.63.0.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.63.0.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.63.0.a003" x-src="WLC.PSA.63.0.003" x-source="דָוִ֑ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.63.0.003" x-head="true" lemma="דָּוִד" strong="H1732">David</char>, <char style="w" x-id="t005" x-align="PSA.63.0.a004" x-src="WLC.PSA.63.0.004" x-source="בִּ֝" x-translit="bi" srcloc="WLC.PSA.63.0.004" x-head="true" lemma="בְּ" strong="H871a">when</char> <char style="w" x-id="t006" x-align="PSA.63.0.a006" x-src="WLC.PSA.63.0.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.63.0.006" x-head="true" lemma="הוּא" strong="H2050c">he</char> <char style="w" x-id="t007" x-align="PSA.63.0.a005" x-src="WLC.PSA.63.0.005" x-source="הְיוֹת֗" x-translit="həyôṯ" srcloc="WLC.PSA.63.0.005" x-head="true" lemma="הָיָה" strong="H1961">was</char> <char style="w" x-id="t008" x-align="PSA.63.0.a007" x-src="WLC.PSA.63.0.007" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.63.0.007" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t009" x-align="PSA.63.0.a008">the</char> <char style="w" x-id="t010" x-align="PSA.63.0.a008" x-src="WLC.PSA.63.0.008" x-source="מִדְבַּ֥ר" x-translit="miḏbar" srcloc="WLC.PSA.63.0.008" x-head="true" lemma="מִדְבָּר" strong="H4057">wilderness</char> <char style="w" x-id="t011" x-align="PSA.63.0.a009">of</char> <char style="w" x-id="t012" x-align="PSA.63.0.a009" x-src="WLC.PSA.63.0.009" x-source="יְהוּדָֽה" x-translit="yəhûḏāh:" srcloc="WLC.PSA.63.0.009" x-head="true" lemma="יְהוּדָה" strong="H3063">Judah</char>.</para>
