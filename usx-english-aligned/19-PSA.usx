	<para style="q1"><verse number="2" style="v" sid="PSA 84:2" /><char style="w" x-id="t001" x-align="PSA.84.2.a006" x-src="WLC.PSA.84.2.006" x-source="י֮" x-translit="iy" srcloc="WLC.PSA.84.2.006" x-head="true" lemma="הוּא" strong="H2967a">My</char> <char style="w" x-id="t002" x-align="PSA.84.2.a005" x-src="WLC.PSA.84.2.005" x-source="נַפְשִׁ" x-translit="nap̄š" srcloc="WLC.PSA.84.2.005" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char> <char style="w" x-id="t003" x-align="PSA.84.2.a001" x-src="WLC.PSA.84.2.001" x-source="נִכְסְפָ֬ה" x-translit="niḵsəp̄āh" srcloc="WLC.PSA.84.2.001" x-head="true" lemma="כָּסַף" strong="H3700">longeth</char>, <char style="w" x-id="t004" x-align="PSA.84.2.a002" x-src="WLC.PSA.84.2.002" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.84.2.002" x-head="true" lemma="וְ" strong="H2050b">yea</char>, <char style="w" x-id="t005" x-align="PSA.84.2.a003" x-src="WLC.PSA.84.2.003" x-source="גַם" x-translit="ḡam-" srcloc="WLC.PSA.84.2.003" x-head="true" lemma="גַּם" strong="H1571">even</char> <char style="w" x-id="t006" x-align="PSA.84.2.a004" x-src="WLC.PSA.84.2.004" x-source="כָּלְתָ֨ה" x-translit="kāləṯāh" srcloc="WLC.PSA.84.2.004" x-head="true" lemma="כָּלָה" strong="H3615">fainteth</char> <char style="w" x-id="t007" x-align="PSA.84.2.a007" x-src="WLC.PSA.84.2.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.84.2.007" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t008" x-align="PSA.84.2.a008">the</char> <char style="w" x-id="t009" x-align="PSA.84.2.a008" x-src="WLC.PSA.84.2.008" x-source="חַצְר֪וֹת" x-translit="ḥaṣrôṯ" srcloc="WLC.PSA.84.2.008" x-head="true" lemma="חָצֵר" strong="H2691">courts</char> <char style="w" x-id="t010" x-align="PSA.84.2.a009">of</char> <char style="w" x-id="t011" x-align="PSA.84.2.a009" x-src="WLC.PSA.84.2.009" x-source="יְה֫וָ֥ה" x-translit="yəhwāh" srcloc="WLC.PSA.84.2.009" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>;</para>
