	<para style="s1"><verse number="1" style="v" x-unrepresented-source="הַֽ" x-unrepresented-translit="ha" x-unrepresented-src="WLC.PSA.131.1.002" sid="PSA 131:1" />Childlike trust in Jehovah.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.131.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.131.1.a001" x-src="WLC.PSA.131.1.001" x-source="שִׁ֥יר" x-translit="šiyr" srcloc="WLC.PSA.131.1.001" x-head="true" lemma="שִׁיר" strong="H7892">Song</char> <char style="w" x-id="t003" x-align="PSA.131.1.a003">of</char> <char style="w" x-id="t004" x-align="PSA.131.1.a003" x-src="WLC.PSA.131.1.003" x-source="מַּֽעֲל֗וֹת" x-translit="mmaʿălôṯ" srcloc="WLC.PSA.131.1.003" x-head="true" lemma="מַעֲלָה" strong="H4609">Ascents</char>; <char style="w" x-id="t005" x-align="PSA.131.1.a004" x-src="WLC.PSA.131.1.004" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.131.1.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t006" x-align="PSA.131.1.a005" x-src="WLC.PSA.131.1.005" x-source="דָ֫וִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.131.1.005" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
