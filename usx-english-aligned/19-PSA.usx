	<chapter eid="PSA 90" />
	<chapter number="91" style="c" sid="PSA 91" />
	<para style="s1"><verse number="1" style="v" sid="PSA 91:1" />Security of him who trusts in Jehovah.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.91.1.a001">He</char> <char style="w" x-id="t002" x-align="PSA.91.1.a001">that</char> <char style="w" x-id="t003" x-align="PSA.91.1.a001" x-src="WLC.PSA.91.1.001" x-source="יֹ֭שֵׁב" x-translit="yōšēḇ" srcloc="WLC.PSA.91.1.001" x-head="true" lemma="יָשַׁב" strong="H3427">dwelleth</char> <char style="w" x-id="t004" x-align="PSA.91.1.a002" x-src="WLC.PSA.91.1.002" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.91.1.002" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t005" x-align="PSA.91.1.a003">the</char> <char style="w" x-id="t006" x-align="PSA.91.1.a003" x-src="WLC.PSA.91.1.003" x-source="סֵ֣תֶר" x-translit="sēṯer" srcloc="WLC.PSA.91.1.003" x-head="true" lemma="סֵתֶר" strong="H5643">secret</char> <char style="w" x-id="t007" x-align="PSA.91.1.a003">place</char> <char style="w" x-id="t008" x-align="PSA.91.1.a004">of</char> <char style="w" x-id="t009" x-align="PSA.91.1.a004">the</char> <char style="w" x-id="t010" x-align="PSA.91.1.a004">Most</char> <char style="w" x-id="t011" x-align="PSA.91.1.a004" x-src="WLC.PSA.91.1.004" x-source="עֶלְי֑וֹן" x-translit="ʿelyôn" srcloc="WLC.PSA.91.1.004" x-head="true" lemma="עֶלְיוֹן" strong="H5945a">High</char></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">That abideth . . . Almighty; Even I etc.</char></char></note><char style="w" x-id="t012" x-align="PSA.91.1.a008">Shall</char> <char style="w" x-id="t013" x-align="PSA.91.1.a008" x-src="WLC.PSA.91.1.008" x-source="יִתְלוֹנָֽן" x-translit="yiṯlônān:" srcloc="WLC.PSA.91.1.008" x-head="true" lemma="לין" strong="H3885a">abide</char> <char style="w" x-id="t014" x-align="PSA.91.1.a005" x-src="WLC.PSA.91.1.005" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.91.1.005" x-head="true" lemma="בְּ" strong="H871a">under</char> <char style="w" x-id="t015" x-align="PSA.91.1.a006">the</char> <char style="w" x-id="t016" x-align="PSA.91.1.a006" x-src="WLC.PSA.91.1.006" x-source="צֵ֥ל" x-translit="ṣēl" srcloc="WLC.PSA.91.1.006" x-head="true" lemma="צֵל" strong="H6738">shadow</char> <char style="w" x-id="t017" x-align="PSA.91.1.a007">of</char> <char style="w" x-id="t018" x-align="PSA.91.1.a007">the</char> <char style="w" x-id="t019" x-align="PSA.91.1.a007" x-src="WLC.PSA.91.1.007" x-source="שַׁ֝דַּ֗י" x-translit="šadday" srcloc="WLC.PSA.91.1.007" x-head="true" lemma="שַׁדַּי" strong="H7706">Almighty</char>.<verse eid="PSA 91:1" /></para>
