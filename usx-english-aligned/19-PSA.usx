	<para style="q1"><char style="w" x-id="t014" x-align="PSA.64.10.a009" x-src="WLC.PSA.64.10.009" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.64.10.009" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t015" x-align="PSA.64.10.a011" x-src="WLC.PSA.64.10.011" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.64.10.011" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t016" x-align="PSA.64.10.a012">the</char> <char style="w" x-id="t017" x-align="PSA.64.10.a012" x-src="WLC.PSA.64.10.012" x-source="יִשְׁרֵי" x-translit="yišrê-" srcloc="WLC.PSA.64.10.012" x-head="true" lemma="יָשָׁר" strong="H3477">upright</char> <char style="w" x-id="t018" x-align="PSA.64.10.a013">in</char> <char style="w" x-id="t019" x-align="PSA.64.10.a013" x-src="WLC.PSA.64.10.013" x-source="לֵֽב" x-translit="lēḇ:" srcloc="WLC.PSA.64.10.013" x-head="true" lemma="לֵב" strong="H3820">heart</char> <char style="w" x-id="t020" x-align="PSA.64.10.a010">shall</char> <char style="w" x-id="t021" x-align="PSA.64.10.a010" x-src="WLC.PSA.64.10.010" x-source="יִתְהַֽלְל֗וּ" x-translit="yiṯhaləlû" srcloc="WLC.PSA.64.10.010" x-head="true" lemma="הָלַל" strong="H1984a">glory</char>.<verse eid="PSA 64:10" /></para>
	<chapter eid="PSA 64" />
	<chapter number="65" style="c" sid="PSA 65" />
	<para style="s1"><verse number="1" style="v" sid="PSA 65:1" />God’s abundant favor to earth and man.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.65.0.a001" x-src="WLC.PSA.65.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.65.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.65.0.a002" x-src="WLC.PSA.65.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.65.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.65.0.a003" x-src="WLC.PSA.65.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.65.0.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.65.0.a003">Musician</char>. <char style="w" x-id="t005" x-align="PSA.65.0.a004">A</char> <char style="w" x-id="t006" x-align="PSA.65.0.a004" x-src="WLC.PSA.65.0.004" x-source="מִזְמ֗וֹר" x-translit="mizmôr" srcloc="WLC.PSA.65.0.004" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char>. <char style="w" x-id="t007" x-align="PSA.65.0.a007">A</char> <char style="w" x-id="t008" x-align="PSA.65.0.a007" x-src="WLC.PSA.65.0.007" x-source="שִֽׁיר" x-translit="šiyr:" srcloc="WLC.PSA.65.0.007" x-head="true" lemma="שִׁיר" strong="H7892">Song</char> <char style="w" x-id="t009" x-align="PSA.65.0.a005" x-src="WLC.PSA.65.0.005" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.65.0.005" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t010" x-align="PSA.65.0.a006" x-src="WLC.PSA.65.0.006" x-source="דָוִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.65.0.006" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">There shall be silence before thee</char>, and <char style="it">praise, O God etc.</char></char></note><char style="w" x-id="t001" x-align="PSA.65.1.a004" x-src="WLC.PSA.65.1.004" x-source="תְהִלָּ֓ה" x-translit="ṯəhillāh" srcloc="WLC.PSA.65.1.004" x-head="true" lemma="תְּהִלָּה" strong="H8416">Praise</char> <char style="w" x-id="t002" x-align="PSA.65.1.a003" x-src="WLC.PSA.65.1.003" x-source="דֻֽמִיָּ֬ה" x-translit="ḏumiyyāh" srcloc="WLC.PSA.65.1.003" x-head="true" lemma="דּוּמִיָּה" strong="H1747">waiteth</char> <char style="w" x-id="t003" x-align="PSA.65.1.a001" x-src="WLC.PSA.65.1.001" x-source="לְ" x-translit="l" srcloc="WLC.PSA.65.1.001" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t004" x-align="PSA.65.1.a002" x-src="WLC.PSA.65.1.002" x-source="ךָ֤" x-translit="əḵā" srcloc="WLC.PSA.65.1.002" x-head="true" lemma="הוּא" strong="H3509b">thee</char>, <char style="w" x-id="t005" x-align="PSA.65.1.a005">O</char> <char style="w" x-id="t006" x-align="PSA.65.1.a005" x-src="WLC.PSA.65.1.005" x-source="אֱלֹ֘הִ֥ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.65.1.005" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t007" x-align="PSA.65.1.a006" x-src="WLC.PSA.65.1.006" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.65.1.006" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t008" x-align="PSA.65.1.a007" x-src="WLC.PSA.65.1.007" x-source="צִיּ֑וֹן" x-translit="ṣiyyôn" srcloc="WLC.PSA.65.1.007" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.65.1.a008" x-src="WLC.PSA.65.1.008" x-source="וּ֝" x-translit="û" srcloc="WLC.PSA.65.1.008" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="PSA.65.1.a009" x-src="WLC.PSA.65.1.009" x-source="לְ" x-translit="l" srcloc="WLC.PSA.65.1.009" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t011" x-align="PSA.65.1.a010" x-src="WLC.PSA.65.1.010" x-source="ךָ֗" x-translit="əḵā" srcloc="WLC.PSA.65.1.010" x-head="true" lemma="הוּא" strong="H3509b">thee</char> <char style="w" x-id="t012" x-align="PSA.65.1.a011">shall</char> <char style="w" x-id="t013" x-align="PSA.65.1.a012">the</char> <char style="w" x-id="t014" x-align="PSA.65.1.a012" x-src="WLC.PSA.65.1.012" x-source="נֶֽדֶר" x-translit="neḏer:" srcloc="WLC.PSA.65.1.012" x-head="true" lemma="נֶדֶר" strong="H5088">vow</char> <char style="w" x-id="t015" x-align="PSA.65.1.a011">be</char> <char style="w" x-id="t016" x-align="PSA.65.1.a011" x-src="WLC.PSA.65.1.011" x-source="יְשֻׁלַּם" x-translit="yəšullam-" srcloc="WLC.PSA.65.1.011" x-head="true" lemma="שָׁלֵם" strong="H7999">performed</char>.<verse eid="PSA 65:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 65:2" /><char style="w" x-id="t001" x-align="PSA.65.2.a001">O</char> <char style="w" x-id="t002" x-align="PSA.65.2.a001">thou</char> <char style="w" x-id="t003" x-align="PSA.65.2.a001">that</char> <char style="w" x-id="t004" x-align="PSA.65.2.a001" x-src="WLC.PSA.65.2.001" x-source="שֹׁמֵ֥עַ" x-translit="šōmēᵃʿ" srcloc="WLC.PSA.65.2.001" x-head="true" lemma="שָׁמַע" strong="H8085">hearest</char> <char style="w" x-id="t005" x-align="PSA.65.2.a002" x-src="WLC.PSA.65.2.002" x-source="תְּפִלָּ֑ה" x-translit="təp̄illāh" srcloc="WLC.PSA.65.2.002" x-head="true" lemma="תְּפִלָּה" strong="H8605">prayer</char>,</para>
