	<chapter eid="PSA 94" />
	<chapter number="95" style="c" sid="PSA 95" />
	<para style="s1"><verse number="1" style="v" sid="PSA 95:1" />Praise to Jehovah, and warning against unbelief.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.95.1.a001">Oh</char> <char style="w" x-id="t002" x-align="PSA.95.1.a001" x-src="WLC.PSA.95.1.001" x-source="לְ֭כוּ" x-translit="ləḵû" srcloc="WLC.PSA.95.1.001" x-head="true" lemma="הלך" strong="H1980">come</char>, <char style="w" x-id="t003" x-align="PSA.95.1.a002">let</char> <char style="w" x-id="t004" x-align="PSA.95.1.a002">us</char> <char style="w" x-id="t005" x-align="PSA.95.1.a002" x-src="WLC.PSA.95.1.002" x-source="נְרַנְּנָ֣ה" x-translit="nərannənāh" srcloc="WLC.PSA.95.1.002" x-head="true" lemma="רָנַן" strong="H7442">sing</char> <char style="w" x-id="t006" x-align="PSA.95.1.a003" x-src="WLC.PSA.95.1.003" x-source="לַ" x-translit="la" srcloc="WLC.PSA.95.1.003" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t007" x-align="PSA.95.1.a004" x-src="WLC.PSA.95.1.004" x-source="יהוָ֑ה" x-translit="yhwāh" srcloc="WLC.PSA.95.1.004" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>;</para>
