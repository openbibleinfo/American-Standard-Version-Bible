	<para style="q1"><char style="w" x-id="t012" x-align="PSA.14.7.a006" x-src="WLC.PSA.14.7.007" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.14.7.007" x-head="true" lemma="בְּ" strong="H871a">When</char> <char style="w" x-id="t013" x-align="PSA.14.7.a008" x-src="WLC.PSA.14.7.009" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.14.7.009" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">returneth to</char></char></note><char style="w" x-id="t014" x-align="PSA.14.7.a007" x-src="WLC.PSA.14.7.008" x-source="שׁ֣וּב" x-translit="šûḇ" srcloc="WLC.PSA.14.7.008" x-head="true" lemma="שׁוּב" strong="H7725">bringeth</char> <char style="w" x-id="t015" x-align="PSA.14.7.a007">back</char> <char style="w" x-id="t016" x-align="PSA.14.7.a009">the</char> <char style="w" x-id="t017" x-align="PSA.14.7.a009" x-src="WLC.PSA.14.7.010" x-source="שְׁב֣וּת" x-translit="šəḇûṯ" srcloc="WLC.PSA.14.7.010" x-head="true" lemma="שְׁבוּת" strong="H7622">captivity</char> <char style="w" x-id="t018" x-align="PSA.14.7.a010">of</char> <char style="w" x-id="t019" x-align="PSA.14.7.a011" x-src="WLC.PSA.14.7.012" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.14.7.012" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t020" x-align="PSA.14.7.a010" x-src="WLC.PSA.14.7.011" x-source="עַמּ֑" x-translit="ʿamm" srcloc="WLC.PSA.14.7.011" x-head="true" lemma="עַם" strong="H5971">people</char>,</para>
	<para style="q1"><char style="w" x-id="t021" x-align="PSA.14.7.a012" x-status="added" x-source="∅" x-head="true">Then</char> <char style="w" x-id="t022" x-align="PSA.14.7.a013">shall</char> <char style="w" x-id="t023" x-align="PSA.14.7.a014" x-src="WLC.PSA.14.7.014" x-source="יַ֝עֲקֹ֗ב" x-translit="yaʿăqōḇ" srcloc="WLC.PSA.14.7.014" x-head="true" lemma="יַעֲקֹב" strong="H3290">Jacob</char> <char style="w" x-id="t024" x-align="PSA.14.7.a013" x-src="WLC.PSA.14.7.013" x-source="יָגֵ֥ל" x-translit="yāḡēl" srcloc="WLC.PSA.14.7.013" x-head="true" lemma="גִּיל" strong="H1523">rejoice</char>, <char style="add"><char style="w" x-id="t025" x-align="PSA.14.7.a015" x-status="added" x-source="∅" x-head="true">and</char></char> <char style="w" x-id="t026" x-align="PSA.14.7.a017" x-src="WLC.PSA.14.7.016" x-source="יִשְׂרָֽאֵל" x-translit="yiśrāʾēl:" srcloc="WLC.PSA.14.7.016" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char> <char style="w" x-id="t027" x-align="PSA.14.7.a016">shall</char> <char style="w" x-id="t028" x-align="PSA.14.7.a016">be</char> <char style="w" x-id="t029" x-align="PSA.14.7.a016" x-src="WLC.PSA.14.7.015" x-source="יִשְׂמַ֥ח" x-translit="yiśmaḥ" srcloc="WLC.PSA.14.7.015" x-head="true" lemma="שָׂמַח" strong="H8055">glad</char>.<verse eid="PSA 14:7" /></para>
