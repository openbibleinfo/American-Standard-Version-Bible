	<para style="q1"><verse number="10" style="v" sid="PSA 27:10" /><note caller="-" style="f"><char style="ft">Or, <char style="it">For my father and my mother have forsaken me, But Jehovah etc.</char></char></note><char style="w" x-id="t001" x-align="PSA.27.10.a001" x-src="WLC.PSA.27.10.001" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.27.10.001" x-head="true" lemma="כִּי" strong="H3588">When</char> <char style="w" x-id="t002" x-align="PSA.27.10.a003" x-src="WLC.PSA.27.10.003" x-source="י" x-translit="iy" srcloc="WLC.PSA.27.10.003" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t003" x-align="PSA.27.10.a002" x-src="WLC.PSA.27.10.002" x-source="אָבִ֣" x-translit="ʾāḇ" srcloc="WLC.PSA.27.10.002" x-head="true" lemma="אָב" strong="H1">father</char> <char style="w" x-id="t004" x-align="PSA.27.10.a004" x-src="WLC.PSA.27.10.004" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.27.10.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="PSA.27.10.a006" x-src="WLC.PSA.27.10.006" x-source="י" x-translit="iy" srcloc="WLC.PSA.27.10.006" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t006" x-align="PSA.27.10.a005" x-src="WLC.PSA.27.10.005" x-source="אִמִּ֣" x-translit="ʾimm" srcloc="WLC.PSA.27.10.005" x-head="true" lemma="אֵם" strong="H517">mother</char> <char style="w" x-id="t007" x-align="PSA.27.10.a007" x-src="WLC.PSA.27.10.007" x-source="עֲזָב֑וּ" x-translit="ʿăzāḇû" srcloc="WLC.PSA.27.10.007" x-head="true" lemma="עָזַב" strong="H5800">forsake</char> <char style="w" x-id="t008" x-align="PSA.27.10.a008" x-src="WLC.PSA.27.10.008" x-source="נִי" x-translit="niy" srcloc="WLC.PSA.27.10.008" x-head="true" lemma="הוּא" strong="H5204a">me</char>,</para>
