	<para style="q1"><char style="w" x-id="t013" x-align="PSA.71.24.a010" x-src="WLC.PSA.71.24.010" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.71.24.010" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t014" x-align="PSA.71.24.a011">they</char> <char style="w" x-id="t015" x-align="PSA.71.24.a011">are</char> <char style="w" x-id="t016" x-align="PSA.71.24.a011">put</char> <char style="w" x-id="t017" x-align="PSA.71.24.a011">to</char> <char style="w" x-id="t018" x-align="PSA.71.24.a011" x-src="WLC.PSA.71.24.011" x-source="בֹ֥שׁוּ" x-translit="ḇōšû" srcloc="WLC.PSA.71.24.011" x-head="true" lemma="בּוֹשׁ" strong="H954">shame</char>, <char style="w" x-id="t019" x-align="PSA.71.24.a012" x-src="WLC.PSA.71.24.012" x-source="כִֽי" x-translit="ḵiy-" srcloc="WLC.PSA.71.24.012" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t020" x-align="PSA.71.24.a013">they</char> <char style="w" x-id="t021" x-align="PSA.71.24.a013">are</char> <char style="w" x-id="t022" x-align="PSA.71.24.a013" x-src="WLC.PSA.71.24.013" x-source="חָ֝פְר֗וּ" x-translit="ḥāp̄ərû" srcloc="WLC.PSA.71.24.013" x-head="true" lemma="חָפֵר" strong="H2659">confounded</char>, <char style="w" x-id="t023" x-align="PSA.71.24.a014">that</char> <char style="w" x-id="t024" x-align="PSA.71.24.a014" x-src="WLC.PSA.71.24.014" x-source="מְבַקְשֵׁ֥י" x-translit="məḇaqšēy" srcloc="WLC.PSA.71.24.014" x-head="true" lemma="בָּקַשׁ" strong="H1245">seek</char> <char style="w" x-id="t025" x-align="PSA.71.24.a016" x-src="WLC.PSA.71.24.016" x-source="י" x-translit="iy" srcloc="WLC.PSA.71.24.016" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t026" x-align="PSA.71.24.a015" x-src="WLC.PSA.71.24.015" x-source="רָעָתִֽ" x-translit="rāʿāṯ" srcloc="WLC.PSA.71.24.015" x-head="true" lemma="רָעָה" strong="H7451b">hurt</char>.<verse eid="PSA 71:24" /></para>
	<chapter eid="PSA 71" />
	<chapter number="72" style="c" sid="PSA 72" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="לְ" x-unrepresented-translit="lə" x-unrepresented-src="WLC.PSA.72.1.006" sid="PSA 72:1" />The reign of the righteous king.</para>
	<para style="d"><char style="add"><char style="w" x-id="t001" x-align="PSA.72.1.a001" x-status="added">A</char> <char style="w" x-id="t002" x-align="PSA.72.1.a001" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t003" x-align="PSA.72.1.a002" x-src="WLC.PSA.72.1.001" x-source="לִ" x-translit="li" srcloc="WLC.PSA.72.1.001" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.72.1.a003" x-src="WLC.PSA.72.1.002" x-source="שְׁלֹמֹ֨ה" x-translit="šəlōmōh" srcloc="WLC.PSA.72.1.002" x-head="true" lemma="שְׁלֹמֹה" strong="H8010">Solomon</char>.</para>
