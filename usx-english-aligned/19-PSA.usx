	<para style="q1"><verse number="2" style="v" sid="PSA 50:2" /><char style="w" x-id="t001" x-align="PSA.50.2.a001" x-src="WLC.PSA.50.2.001" x-source="מִ" x-translit="mi" srcloc="WLC.PSA.50.2.001" x-head="true" lemma="מִן" strong="H4480">Out</char> <char style="w" x-id="t002" x-align="PSA.50.2.a001">of</char> <char style="w" x-id="t003" x-align="PSA.50.2.a002" x-src="WLC.PSA.50.2.002" x-source="צִּיּ֥וֹן" x-translit="ṣṣiyyôn" srcloc="WLC.PSA.50.2.002" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>, <char style="w" x-id="t004" x-align="PSA.50.2.a003">the</char> <char style="w" x-id="t005" x-align="PSA.50.2.a003" x-src="WLC.PSA.50.2.003" x-source="מִכְלַל" x-translit="miḵlal-" srcloc="WLC.PSA.50.2.003" x-head="true" lemma="מִכְלָל" strong="H4359">perfection</char> <char style="w" x-id="t006" x-align="PSA.50.2.a004">of</char> <char style="w" x-id="t007" x-align="PSA.50.2.a004" x-src="WLC.PSA.50.2.004" x-source="יֹ֗פִי" x-translit="yōp̄î" srcloc="WLC.PSA.50.2.004" x-head="true" lemma="יֳפִי" strong="H3308">beauty</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.50.2.a005" x-src="WLC.PSA.50.2.005" x-source="אֱלֹהִ֥ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.50.2.005" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t009" x-align="PSA.50.2.a006">hath</char> <char style="w" x-id="t010" x-align="PSA.50.2.a006" x-src="WLC.PSA.50.2.006" x-source="הוֹפִֽיעַ" x-translit="hôp̄iyᵃʿ:" srcloc="WLC.PSA.50.2.006" x-head="true" lemma="יָפַע" strong="H3313">shined</char> <char style="w" x-id="t011" x-align="PSA.50.2.a006">forth</char>.<verse eid="PSA 50:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="PSA 50:3" /><char style="w" x-id="t001" x-align="PSA.50.3.a003" x-src="WLC.PSA.50.3.003" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.50.3.003" x-head="true" lemma="הוּא" strong="H5105a">Our</char> <char style="w" x-id="t002" x-align="PSA.50.3.a002" x-src="WLC.PSA.50.3.002" x-source="אֱלֹהֵ֗י" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.50.3.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t003" x-align="PSA.50.3.a001" x-src="WLC.PSA.50.3.001" x-source="יָ֤בֹ֥א" x-translit="yāḇōʾ" srcloc="WLC.PSA.50.3.001" x-head="true" lemma="בּוֹא" strong="H935">cometh</char>, <char style="w" x-id="t004" x-align="PSA.50.3.a004" x-src="WLC.PSA.50.3.004" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.50.3.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="PSA.50.3.a006">doth</char> <char style="w" x-id="t006" x-align="PSA.50.3.a005" x-src="WLC.PSA.50.3.005" x-source="אַל" x-translit="ʾal-" srcloc="WLC.PSA.50.3.005" x-head="true" lemma="אַל" strong="H408">not</char> <char style="w" x-id="t007" x-align="PSA.50.3.a006">keep</char> <char style="w" x-id="t008" x-align="PSA.50.3.a006" x-src="WLC.PSA.50.3.006" x-source="יֶ֫חֱרַ֥שׁ" x-translit="yeḥĕraš" srcloc="WLC.PSA.50.3.006" x-head="true" lemma="חָרֵשׁ" strong="H2790a">silence</char>:</para>
