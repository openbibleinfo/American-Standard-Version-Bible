	<para style="q1"><verse number="9" style="v" sid="PSA 65:9" /><char style="w" x-id="t001" x-align="PSA.65.9.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.65.9.a001" x-src="WLC.PSA.65.9.001" x-source="פָּקַ֥דְתָּ" x-translit="pāqaḏətā" srcloc="WLC.PSA.65.9.001" x-head="true" lemma="פָּקַד" strong="H6485">visitest</char> <char style="w" x-id="t003" x-align="PSA.65.9.a002" x-src="WLC.PSA.65.9.002" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.65.9.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t004" x-align="PSA.65.9.a003" x-src="WLC.PSA.65.9.003" x-source="אָ֨רֶץ" x-translit="ʾāreṣ" srcloc="WLC.PSA.65.9.003" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>, <char style="w" x-id="t005" x-align="PSA.65.9.a004" x-src="WLC.PSA.65.9.004" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.65.9.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t006" x-align="PSA.65.9.a005" x-src="WLC.PSA.65.9.005" x-source="תְּשֹׁ֪קְקֶ֡" x-translit="təšōqəq" srcloc="WLC.PSA.65.9.005" x-head="true" lemma="שׁוּק" strong="H7783">waterest</char> <char style="w" x-id="t007" x-align="PSA.65.9.a006" x-src="WLC.PSA.65.9.006" x-source="הָ" x-translit="ehā" srcloc="WLC.PSA.65.9.006" x-head="true" lemma="הוּא" strong="H1886d">it</char>,</para>
