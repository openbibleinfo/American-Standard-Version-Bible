	<para style="q1"><verse number="26" style="v" x-unrepresented-source="א֝וֹתָ֗" x-unrepresented-translit="ʾôṯ" x-unrepresented-src="WLC.PSA.106.26.009" sid="PSA 106:26" /><char style="w" x-id="t001" x-align="PSA.106.26.a001" x-src="WLC.PSA.106.26.001" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.106.26.001" x-head="true" lemma="וְ" strong="H2050b">Therefore</char> <char style="w" x-id="t002" x-align="PSA.106.26.a002" x-status="noncompositional">he</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">lifted up his hand</char>.</char></note><char style="w" x-id="t003" x-align="PSA.106.26.a002" x-status="noncompositional" x-src="WLC.PSA.106.26.002 WLC.PSA.106.26.003 WLC.PSA.106.26.004" x-source="יִּשָּׂ֣א יָד֣ וֹ" x-translit="yyiśśāʾ yāḏ ô" srcloc="WLC.PSA.106.26.002" x-head="true" lemma="נָשָׂא" strong="H5375">sware</char> <char style="w" x-id="t004" x-align="PSA.106.26.a003" x-src="WLC.PSA.106.26.005" x-source="לָ" x-translit="l" srcloc="WLC.PSA.106.26.005" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t005" x-align="PSA.106.26.a004" x-src="WLC.PSA.106.26.006" x-source="הֶ֑ם" x-translit="āhem" srcloc="WLC.PSA.106.26.006" x-head="true" lemma="הוּא" strong="H3963a">them</char>,</para>
