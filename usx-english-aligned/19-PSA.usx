	<para style="q1"><verse number="11" style="v" sid="PSA 108:11" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Wilt not thou, O God, who hast cast us off, And goest . . . hosts?</char></char></note><char style="w" x-id="t001" x-align="PSA.108.11.a001" x-src="WLC.PSA.108.11.001" x-source="הֲ" x-translit="hă" srcloc="WLC.PSA.108.11.001" x-head="true" lemma="הֲ" strong="H1886b">Hast</char> <char style="w" x-id="t002" x-align="PSA.108.11.a002" x-src="WLC.PSA.108.11.002" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.PSA.108.11.002" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t003" x-align="PSA.108.11.a003">thou</char> <char style="w" x-id="t004" x-align="PSA.108.11.a003" x-src="WLC.PSA.108.11.004" x-source="זְנַחְתָּ֑" x-translit="zənaḥtā" srcloc="WLC.PSA.108.11.004" x-head="true" lemma="זָנַח" strong="H2186">cast</char> <char style="w" x-id="t005" x-align="PSA.108.11.a004" x-src="WLC.PSA.108.11.005" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.108.11.005" x-head="true" lemma="הוּא" strong="H5105a">us</char> <char style="w" x-id="t006" x-align="PSA.108.11.a003">off</char>, <char style="w" x-id="t007" x-align="PSA.108.11.a005">O</char> <char style="w" x-id="t008" x-align="PSA.108.11.a005" x-src="WLC.PSA.108.11.003" x-source="אֱלֹהִ֥ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.108.11.003" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>?</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.108.11.a006" x-src="WLC.PSA.108.11.006" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.108.11.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="PSA.108.11.a007">thou</char> <char style="w" x-id="t011" x-align="PSA.108.11.a007" x-src="WLC.PSA.108.11.008" x-source="תֵצֵ֥א" x-translit="ṯēṣēʾ" srcloc="WLC.PSA.108.11.008" x-head="true" lemma="יָצָא" strong="H3318">goest</char> <char style="w" x-id="t012" x-align="PSA.108.11.a008" x-src="WLC.PSA.108.11.007" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.PSA.108.11.007" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t013" x-align="PSA.108.11.a007">forth</char>, <char style="w" x-id="t014" x-align="PSA.108.11.a009">O</char> <char style="w" x-id="t015" x-align="PSA.108.11.a009" x-src="WLC.PSA.108.11.009" x-source="אֱ֝לֹהִ֗ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.108.11.009" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t016" x-align="PSA.108.11.a010" x-src="WLC.PSA.108.11.010" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.108.11.010" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t017" x-align="PSA.108.11.a011" x-src="WLC.PSA.108.11.012" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.108.11.012" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t018" x-align="PSA.108.11.a012" x-src="WLC.PSA.108.11.011" x-source="צִבְאֹתֵֽי" x-translit="ṣiḇʾōṯēy" srcloc="WLC.PSA.108.11.011" x-head="true" lemma="צָבָא" strong="H6635">hosts</char>.<verse eid="PSA 108:11" /></para>
