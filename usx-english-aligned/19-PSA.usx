	<chapter eid="PSA 146" />
	<chapter number="147" style="c" sid="PSA 147" />
	<para style="s1"><verse number="1" style="v" sid="PSA 147:1" />Praise for Jerusalem’s restoration and prosperity.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Hallelujah</char>.</char></note><char style="w" x-id="t001" x-align="PSA.147.1.a001" x-src="WLC.PSA.147.1.001" x-source="הַ֥לְלוּ" x-translit="haləlû" srcloc="WLC.PSA.147.1.001" x-head="true" lemma="הָלַל" strong="H1984a">Praise</char> <char style="w" x-id="t002" x-align="PSA.147.1.a001">ye</char> <char style="w" x-id="t003" x-align="PSA.147.1.a002" x-src="WLC.PSA.147.1.002" x-source="יָ֨הּ" x-translit="yāhh" srcloc="WLC.PSA.147.1.002" x-head="true" lemma="יָהּ" strong="H3050">Jehovah</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">For he is good: sing praises unto our God; For he is gracious</char></char></note><char style="w" x-id="t004" x-align="PSA.147.1.a003" x-src="WLC.PSA.147.1.003" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.147.1.003" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t005" x-align="PSA.147.1.a005" x-status="added" x-source="∅" x-head="true">it</char> <char style="w" x-id="t006" x-align="PSA.147.1.a004">is</char> <char style="w" x-id="t007" x-align="PSA.147.1.a004" x-src="WLC.PSA.147.1.004" x-source="ט֭וֹב" x-translit="ṭôḇ" srcloc="WLC.PSA.147.1.004" x-head="true" lemma="טוֹב" strong="H2896">good</char> <char style="w" x-id="t008" x-align="PSA.147.1.a006">to</char> <char style="w" x-id="t009" x-align="PSA.147.1.a006" x-src="WLC.PSA.147.1.005" x-source="זַמְּרָ֣ה" x-translit="zammərāh" srcloc="WLC.PSA.147.1.005" x-head="true" lemma="זָמַר" strong="H2167">sing</char> <char style="w" x-id="t010" x-align="PSA.147.1.a006">praises</char> <char style="w" x-id="t011" x-align="PSA.147.1.a006">unto</char> <char style="w" x-id="t012" x-align="PSA.147.1.a008" x-src="WLC.PSA.147.1.007" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.147.1.007" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t013" x-align="PSA.147.1.a007" x-src="WLC.PSA.147.1.006" x-source="אֱלֹהֵ֑י" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.147.1.006" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>;</para>
