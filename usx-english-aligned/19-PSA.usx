	<para style="s1"><verse number="1" style="v" x-unrepresented-source="ה [הַ] ה" x-unrepresented-translit="āh [ha] āh" x-unrepresented-src="WLC.PSA.80.1.004 WLC.PSA.80.1.007 WLC.PSA.80.1.014" sid="PSA 80:1" />God implored to rescue his people from their calamities.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.80.0.a001" x-src="WLC.PSA.80.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.80.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.80.0.a002" x-src="WLC.PSA.80.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.80.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.80.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.80.0.a003" x-src="WLC.PSA.80.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.80.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="w" x-id="t005" x-align="PSA.80.0.a004">set</char> <char style="w" x-id="t006" x-align="PSA.80.0.a004" x-src="WLC.PSA.80.0.004" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.PSA.80.0.004" x-head="true" lemma="אֶל" strong="H413">to</char> <note caller="-" style="f"><char style="ft">That is, <char style="it">Lilies, a testimony</char>.</char></note><char style="w" x-id="t007" x-align="PSA.80.0.a005" x-src="WLC.PSA.80.0.005" x-source="שֹׁשַׁנִּ֑ים" x-translit="šōšanniym" srcloc="WLC.PSA.80.0.005" x-head="true" lemma="שׁוּשַׁן" strong="H7799">Shoshannim</char> <char style="w" x-id="t008" x-align="PSA.80.0.a006" x-src="WLC.PSA.80.0.006" x-source="עֵד֖וּת" x-translit="ʿēḏûṯ" srcloc="WLC.PSA.80.0.006" x-head="true" lemma="עֵדוּת" strong="H5715">Eduth</char>. <char style="w" x-id="t009" x-align="PSA.80.0.a009">A</char> <char style="w" x-id="t010" x-align="PSA.80.0.a009" x-src="WLC.PSA.80.0.009" x-source="מִזְמֽוֹר" x-translit="mizmôr:" srcloc="WLC.PSA.80.0.009" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t011" x-align="PSA.80.0.a007" x-src="WLC.PSA.80.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.80.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t012" x-align="PSA.80.0.a008" x-src="WLC.PSA.80.0.008" x-source="אָסָ֣ף" x-translit="ʾāsāp̄"