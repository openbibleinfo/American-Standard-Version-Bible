	<chapter number="48" style="c" sid="PSA 48" />
	<para style="s1"><verse number="1" style="v" sid="PSA 48:1" />The beauty and glory of Zion.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.48.0.a001">A</char> <char style="w" x-id="t002" x-align="PSA.48.0.a001" x-src="WLC.PSA.48.0.001" x-source="שִׁ֥יר" x-translit="šiyr" srcloc="WLC.PSA.48.0.001" x-head="true" lemma="שִׁיר" strong="H7892">Song</char>; <char style="w" x-id="t003" x-align="PSA.48.0.a002">a</char> <char style="w" x-id="t004" x-align="PSA.48.0.a002" x-src="WLC.PSA.48.0.002" x-source="מִ֝זְמוֹר" x-translit="mizmôr" srcloc="WLC.PSA.48.0.002" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t005" x-align="PSA.48.0.a003" x-src="WLC.PSA.48.0.003" x-source="לִ" x-translit="li" srcloc="WLC.PSA.48.0.003" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t006" x-align="PSA.48.0.a004">the</char> <char style="w" x-id="t007" x-align="PSA.48.0.a004" x-src="WLC.PSA.48.0.004" x-source="בְנֵי" x-translit="ḇənê-" srcloc="WLC.PSA.48.0.004" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t008" x-align="PSA.48.0.a005">of</char> <char style="w" x-id="t009" x-align="PSA.48.0.a005" x-src="WLC.PSA.48.0.005" x-source="קֹֽרַח" x-translit="qōraḥ:" srcloc="WLC.PSA.48.0.005" x-head="true" lemma="קֹרַח" strong="H7141">Korah</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.48.1.a001" x-src="WLC.PSA.48.1.001" x-source="גָּ֘ד֤וֹל" x-translit="gāḏôl" srcloc="WLC.PSA.48.1.001" x-head="true" lemma="גָּדוֹל" strong="H1419">Great</char> <char style="w" x-id="t002" x-align="PSA.48.1.a001">is</char> <char style="w" x-id="t003" x-align="PSA.48.1.a002" x-src="WLC.PSA.48.1.002" x-source="יְהוָ֣ה" x-translit="yəhwāh" srcloc="WLC.PSA.48.1.002" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t004" x-align="PSA.48.1.a003" x-src="WLC.PSA.48.1.003" x-source="וּ" x-translit="û" srcloc="WLC.PSA.48.1.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="PSA.48.1.a005" x-src="WLC.PSA.48.1.005" x-source="מְאֹ֑ד" x-translit="məʾōḏ" srcloc="WLC.PSA.48.1.005" x-head="true" lemma="מְאֹד" strong="H3966">greatly</char> <char style="w" x-id="t006" x-align="PSA.48.1.a004">to</char> <char style="w" x-id="t007" x-align="PSA.48.1.a004">be</char> <char style="w" x-id="t008" x-align="PSA.48.1.a004" x-src="WLC.PSA.48.1.004" x-source="מְהֻלָּ֣ל" x-translit="məhullāl" srcloc="WLC.PSA.48.1.004" x-head="true" lemma="הָלַל" strong="H1984a">praised</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.48.1.a006" x-src="WLC.PSA.48.1.006" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.48.1.006" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t010" x-align="PSA.48.1.a007">the</char> <char style="w" x-id="t011" x-align="PSA.48.1.a007" x-src="WLC.PSA.48.1.007" x-source="עִ֥יר" x-translit="ʿiyr" srcloc="WLC.PSA.48.1.007" x-head="true" lemma="עִיר" strong="H5892">city</char> <char style="w" x-id="t012" x-align="PSA.48.1.a008">of</char> <char style="w" x-id="t013" x-align="PSA.48.1.a009" x-src="WLC.PSA.48.1.009" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.48.1.009" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t014" x-align="PSA.48.1.a008" x-src="WLC.PSA.48.1.008" x-source="אֱ֝לֹהֵ֗י" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.48.1.008" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t015" x-align="PSA.48.1.a010">in</char> <char style="w" x-id="t016" x-align="PSA.48.1.a012" x-src="WLC.PSA.48.1.012" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.48.1.012" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t017" x-align="PSA.48.1.a011" x-src="WLC.PSA.48.1.011" x-source="קָדְשֽׁ" x-translit="qāḏəš" srcloc="WLC.PSA.48.1.011" x-head="true" lemma="קֹדֶשׁ" strong="H6944">holy</char> <char style="w" x-id="t018" x-align="PSA.48.1.a010" x-src="WLC.PSA.48.1.010" x-source="הַר" x-translit="har-" srcloc="WLC.PSA.48.1.010" x-head="true" lemma="הַר" strong="H2022">mountain</char>.<verse eid="PSA 48:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 48:2" /><char style="w" x-id="t001" x-align="PSA.48.2.a001" x-src="WLC.PSA.48.2.001" x-source="יְפֵ֥ה" x-translit="yəp̄ēh" srcloc="WLC.PSA.48.2.001" x-head="true" lemma="יָפֶה" strong="H3303">Beautiful</char> <char style="w" x-id="t002" x-align="PSA.48.2.a002">in</char> <char style="w" x-id="t003" x-align="PSA.48.2.a002" x-src="WLC.PSA.48.2.002" x-source="נוֹף֮" x-translit="nôp̄" srcloc="WLC.PSA.48.2.002" x-head="true" lemma="נוֹף" strong="H5131">elevation</char>, <char style="w" x-id="t004" x-align="PSA.48.2.a003">the</char> <char style="w" x-id="t005" x-align="PSA.48.2.a003" x-src="WLC.PSA.48.2.003" x-source="מְשׂ֪וֹשׂ" x-translit="məśôś" srcloc="WLC.PSA.48.2.003" x-head="true" lemma="מָשׂוֹשׂ" strong="H4885">joy</char> <char style="w" x-id="t006" x-align="PSA.48.2.a004">of</char> <char style="w" x-id="t007" x-align="PSA.48.2.a005" x-src="WLC.PSA.48.2.005" x-source="הָ֫" x-translit="hā" srcloc="WLC.PSA.48.2.005" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t008" x-align="PSA.48.2.a004" x-src="WLC.PSA.48.2.004" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.48.2.004" x-head="true" lemma="כֹּל" strong="H3605">whole</char> <char style="w" x-id="t009" x-align="PSA.48.2.a006" x-src="WLC.PSA.48.2.006" x-source="אָ֥רֶץ" x-translit="ʾāreṣ" srcloc="WLC.PSA.48.2.006" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>,</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.48.2.a001">Is</char> <char style="w" x-id="t011" x-align="PSA.48.2.a007" x-src="WLC.PSA.48.2.007" x-source="הַר" x-translit="har-" srcloc="WLC.PSA.48.2.007" x-head="true" lemma="הַר" strong="H2022">mount</char> <char style="w" x-id="t012" x-align="PSA.48.2.a008" x-src="WLC.PSA.48.2.008" x-source="צִ֭יּוֹן" x-translit="ṣiyyôn" srcloc="WLC.PSA.48.2.008" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>, <char style="add"><char style="w" x-id="t013" x-align="PSA.48.2.a009">on</char></char> <char style="w" x-id="t014" x-align="PSA.48.2.a009">the</char> <char style="w" x-id="t015" x-align="PSA.48.2.a009" x-src="WLC.PSA.48.2.009" x-source="יַרְכְּתֵ֣י" x-translit="yarkəṯēy" srcloc="WLC.PSA.48.2.009" x-head="true" lemma="יַרְכָה" strong="H3411">sides</char> <char style="w" x-id="t016" x-align="PSA.48.2.a010">of</char> <char style="w" x-id="t017" x-align="PSA.48.2.a010">the</char> <char style="w" x-id="t018" x-align="PSA.48.2.a010" x-src="WLC.PSA.48.2.010" x-source="צָפ֑וֹן" x-translit="ṣāp̄ôn" srcloc="WLC.PSA.48.2.010" x-head="true" lemma="צָפוֹן" strong="H6828">north</char>,</para>
	<para style="q1"><char style="w" x-id="t019" x-align="PSA.48.2.a011">The</char> <char style="w" x-id="t020" x-align="PSA.48.2.a011" x-src="WLC.PSA.48.2.011" x-source="קִ֝רְיַ֗ת" x-translit="qiryaṯ" srcloc="WLC.PSA.48.2.011" x-head="true" lemma="קִרְיָה" strong="H7151">city</char> <char style="w" x-id="t021" x-align="PSA.48.2.a012">of</char> <char style="w" x-id="t022" x-align="PSA.48.2.a012">the</char> <char style="w" x-id="t023" x-align="PSA.48.2.a013" x-src="WLC.PSA.48.2.013" x-source="רָֽב" x-translit="rāḇ:" srcloc="WLC.PSA.48.2.013" x-head="true" lemma="רַב" strong="H7227">great</char> <char style="w" x-id="t024" x-align="PSA.48.2.a012" x-src="WLC.PSA.48.2.012" x-source="מֶ֣לֶךְ" x-translit="meleḵ" srcloc="WLC.PSA.48.2.012" x-head="true" lemma="מֶלֶךְ" strong="H4428">King</char>.<verse eid="PSA 48:2" /></para>
