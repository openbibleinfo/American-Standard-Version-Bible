	<chapter eid="PSA 52" />
	<chapter number="53" style="c" sid="PSA 53" />
	<para style="s1"><verse number="1" style="v" sid="PSA 53:1" />The folly and wickedness of men.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.53.0.a001" x-src="WLC.PSA.53.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.53.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.53.0.a002" x-src="WLC.PSA.53.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.53.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.53.0.a003" x-src="WLC.PSA.53.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.53.0.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.53.0.a003">Musician</char>; <char style="w" x-id="t005" x-align="PSA.53.0.a004" x-src="WLC.PSA.53.0.004" x-source="עַֽל" x-translit="ʿal-" srcloc="WLC.PSA.53.0.004" x-head="true" lemma="עַל" strong="H5921">set</char> <char style="w" x-id="t006" x-align="PSA.53.0.a004">to</char> <char style="w" x-id="t007" x-align="PSA.53.0.a005" x-src="WLC.PSA.53.0.005" x-source="מָחֲלַ֗ת" x-translit="māḥălaṯ" srcloc="WLC.PSA.53.0.005" x-head="true" lemma="מַחֲלַת" strong="H4257">Mahalath</char>. <char style="w" x-id="t008" x-align="PSA.53.0.a006" x-src="WLC.PSA.53.0.006" x-source="מַשְׂכִּ֥יל" x-translit="maśkiyl" srcloc="WLC.PSA.53.0.006" x-head="true" lemma="מַשְׂכִּיל" strong="H4905">Maschil</char> <char style="w" x-id="t009" x-align="PSA.53.0.a007" x-src="WLC.PSA.53.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.53.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t010" x-align="PSA.53.0.a008" x-src="WLC.PSA.53.0.008" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.53.0.008" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
