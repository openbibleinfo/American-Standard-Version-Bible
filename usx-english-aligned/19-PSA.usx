	<para style="q1"><char style="w" x-id="t015" x-align="PSA.65.13.a009">They</char> <char style="w" x-id="t016" x-align="PSA.65.13.a009" x-src="WLC.PSA.65.13.009" x-source="יִ֝תְרוֹעֲע֗וּ" x-translit="yiṯrôʿăʿû" srcloc="WLC.PSA.65.13.009" x-head="true" lemma="רוּעַ" strong="H7321">shout</char> <char style="w" x-id="t017" x-align="PSA.65.13.a009">for</char> <char style="w" x-id="t018" x-align="PSA.65.13.a009">joy</char>, <char style="w" x-id="t019" x-align="PSA.65.13.a011">they</char> <char style="w" x-id="t020" x-align="PSA.65.13.a010" x-src="WLC.PSA.65.13.010" x-source="אַף" x-translit="ʾap̄-" srcloc="WLC.PSA.65.13.010" x-head="true" lemma="אַף" strong="H637">also</char> <char style="w" x-id="t021" x-align="PSA.65.13.a011" x-src="WLC.PSA.65.13.011" x-source="יָשִֽׁירוּ" x-translit="yāšiyrû:" srcloc="WLC.PSA.65.13.011" x-head="true" lemma="שִׁיר" strong="H7891">sing</char>.<verse eid="PSA 65:13" /></para>
	<chapter eid="PSA 65" />
	<chapter number="66" style="c" sid="PSA 66" />
	<para style="s1"><verse number="1" style="v" sid="PSA 66:1" />Praise for God’s mighty deeds and for his answer to prayer.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.66.1.a001" x-src="WLC.PSA.66.1.001" x-source="לַ֭" x-translit="la" srcloc="WLC.PSA.66.1.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.66.1.a002" x-src="WLC.PSA.66.1.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.66.1.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.66.1.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.66.1.a003" x-src="WLC.PSA.66.1.003" x-source="מְנַצֵּחַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.66.1.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.66.1.a004">A</char> <char style="w" x-id="t006" x-align="PSA.66.1.a004" x-src="WLC.PSA.66.1.004" x-source="שִׁ֣יר" x-translit="šiyr" srcloc="WLC.PSA.66.1.004" x-head="true" lemma="שִׁיר" strong="H7892">Song</char>, <char style="w" x-id="t007" x-align="PSA.66.1.a005">a</char> <char style="w" x-id="t008" x-align="PSA.66.1.a005" x-src="WLC.PSA.66.1.005" x-source="מִזְמ֑וֹר" x-translit="mizmôr" srcloc="WLC.PSA.66.1.005" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char>.</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.66.1.a006">Make</char> <char style="w" x-id="t010" x-align="PSA.66.1.a006">a</char> <char style="w" x-id="t011" x-align="PSA.66.1.a006">joyful</char> <char style="w" x-id="t012" x-align="PSA.66.1.a006" x-src="WLC.PSA.66.1.006" x-source="הָרִ֥יעוּ" x-translit="hāriyʿû" srcloc="WLC.PSA.66.1.006" x-head="true" lemma="רוּעַ" strong="H7321">noise</char> <char style="w" x-id="t013" x-align="PSA.66.1.a007" x-src="WLC.PSA.66.1.007" x-source="לֵ֝" x-translit="lē" srcloc="WLC.PSA.66.1.007" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t014" x-align="PSA.66.1.a008" x-src="WLC.PSA.66.1.008" x-source="אלֹהִים" x-translit="ʾlōhîm" srcloc="WLC.PSA.66.1.008" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t015" x-align="PSA.66.1.a009" x-src="WLC.PSA.66.1.009" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.66.1.009" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t016" x-align="PSA.66.1.a010" x-src="WLC.PSA.66.1.010" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.66.1.010" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t017" x-align="PSA.66.1.a011" x-src="WLC.PSA.66.1.011" x-source="אָֽרֶץ" x-translit="ʾāreṣ:" srcloc="WLC.PSA.66.1.011" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>:<verse eid="PSA 66:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 66:2" /><char style="w" x-id="t001" x-align="PSA.66.2.a001" x-src="WLC.PSA.66.2.001" x-source="זַמְּר֥וּ" x-translit="zammərû" srcloc="WLC.PSA.66.2.001" x-head="true" lemma="זָמַר" strong="H2167">Sing</char> <char style="w" x-id="t002" x-align="PSA.66.2.a001">forth</char> <char style="w" x-id="t003" x-align="PSA.66.2.a002">the</char> <char style="w" x-id="t004" x-align="PSA.66.2.a002" x-src="WLC.PSA.66.2.002" x-source="כְבֽוֹד" x-translit="ḵəḇôḏ-" srcloc="WLC.PSA.66.2.002" x-head="true" lemma="כָּבוֹד" strong="H3519">glory</char> <char style="w" x-id="t005" x-align="PSA.66.2.a003">of</char> <char style="w" x-id="t006" x-align="PSA.66.2.a004" x-src="WLC.PSA.66.2.004" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.66.2.004" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="PSA.66.2.a003" x-src="WLC.PSA.66.2.003" x-source="שְׁמ֑" x-translit="šəm" srcloc="WLC.PSA.66.2.003" x-head="true" lemma="שֵׁם" strong="H8034">name</char>:</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.66.2.a005" x-src="WLC.PSA.66.2.005" x-source="שִׂ֥ימוּ" x-translit="śiymû" srcloc="WLC.PSA.66.2.005" x-head="true" lemma="שׂים" strong="H7760">Make</char> <char style="w" x-id="t009" x-align="PSA.66.2.a008" x-src="WLC.PSA.66.2.008" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.66.2.008" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t010" x-align="PSA.66.2.a007" x-src="WLC.PSA.66.2.007" x-source="תְּהִלָּתֽ" x-translit="təhillāṯ" srcloc="WLC.PSA.66.2.007" x-head="true" lemma="תְּהִלָּה" strong="H8416">praise</char> <char style="w" x-id="t011" x-align="PSA.66.2.a006" x-src="WLC.PSA.66.2.006" x-source="כָ֝ב֗וֹד" x-translit="ḵāḇôḏ" srcloc="WLC.PSA.66.2.006" x-head="true" lemma="כָּבוֹד" strong="H3519">glorious</char>.<verse eid="PSA 66:2" /></para>
