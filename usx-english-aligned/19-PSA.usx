	<para style="q1"><verse number="4" style="v" sid="PSA 143:4" /><char style="w" x-id="t001" x-align="PSA.143.4.a001" x-src="WLC.PSA.143.4.001" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.143.4.001" x-head="true" lemma="וְ" strong="H2050b">Therefore</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">my spirit fainteth</char></char></note><char style="w" x-id="t002" x-align="PSA.143.4.a004">is</char> <char style="w" x-id="t003" x-align="PSA.143.4.a002" x-src="WLC.PSA.143.4.006" x-source="י" x-translit="iy" srcloc="WLC.PSA.143.4.006" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t004" x-align="PSA.143.4.a003" x-src="WLC.PSA.143.4.005" x-source="רוּחִ֑" x-translit="rûḥ" srcloc="WLC.PSA.143.4.005" x-head="true" lemma="רוּחַ" strong="H7307">spirit</char> <char style="w" x-id="t005" x-align="PSA.143.4.a004" x-src="WLC.PSA.143.4.002" x-source="תִּתְעַטֵּ֣ף" x-translit="tiṯʿaṭṭēp̄" srcloc="WLC.PSA.143.4.002" x-head="true" lemma="עָטַף" strong="H5848a">overwhelmed</char> <char style="w" x-id="t006" x-align="PSA.143.4.a005" x-src="WLC.PSA.143.4.003" x-source="עָלַ֣" x-translit="ʿāl" srcloc="WLC.PSA.143.4.003" x-head="true" lemma="עַל" strong="H5921">within</char> <char style="w" x-id="t007" x-align="PSA.143.4.a006" x-src="WLC.PSA.143.4.004" x-source="י" x-translit="ay" srcloc="WLC.PSA.143.4.004" x-head="true" lemma="הוּא" strong="H2967a">me</char>;</para>
