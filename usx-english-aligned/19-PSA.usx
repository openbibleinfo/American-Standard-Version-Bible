	<para style="q1"><verse number="7" style="v" sid="PSA 35:7" /><char style="w" x-id="t001" x-align="PSA.35.7.a001" x-src="WLC.PSA.35.7.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.35.7.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.35.7.a002">without</char> <char style="w" x-id="t003" x-align="PSA.35.7.a002" x-src="WLC.PSA.35.7.002" x-source="חִנָּ֣ם" x-translit="ḥinnām" srcloc="WLC.PSA.35.7.002" x-head="true" lemma="חִנָּם" strong="H2600">cause</char> <char style="w" x-id="t004" x-align="PSA.35.7.a003">have</char> <char style="w" x-id="t005" x-align="PSA.35.7.a003">they</char> <char style="w" x-id="t006" x-align="PSA.35.7.a003" x-src="WLC.PSA.35.7.003" x-source="טָֽמְנוּ" x-translit="ṭāmənû-" srcloc="WLC.PSA.35.7.003" x-head="true" lemma="טָמַן" strong="H2934">hid</char> <char style="w" x-id="t007" x-align="PSA.35.7.a004" x-src="WLC.PSA.35.7.004" x-source="לִ֭" x-translit="li" srcloc="WLC.PSA.35.7.004" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t008" x-align="PSA.35.7.a005" x-src="WLC.PSA.35.7.005" x-source="י" x-translit="y" srcloc="WLC.PSA.35.7.005" x-head="true" lemma="הוּא" strong="H2967a">me</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">the pit of their net</char></char></note><char style="w" x-id="t009" x-align="PSA.35.7.a008" x-src="WLC.PSA.35.7.008" x-source="ם" x-translit="ām" srcloc="WLC.PSA.35.7.008" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t010" x-align="PSA.35.7.a007" x-src="WLC.PSA.35.7.007" x-source="רִשְׁתָּ֑" x-translit="rišt" srcloc="WLC.PSA.35.7.007" x-head="true" lemma="רֶשֶׁת" strong="H7568">net</char> <char style="add"><char style="w" x-id="t011" x-align="PSA.35.7.a006">in</char></char> <char style="w" x-id="t012" x-align="PSA.35.7.a006">a</char> <char style="w" x-id="t013" x-align="PSA.35.7.a006" x-src="WLC.PSA.35.7.006" x-source="שַׁ֣חַת" x-translit="šaḥaṯ" srcloc="WLC.PSA.35.7.006" x-he