	<para style="q1"><char style="w" x-id="t016" x-align="PSA.43.5.a010" x-src="WLC.PSA.43.5.010" x-source="הוֹחִ֣ילִי" x-translit="hôḥiylî" srcloc="WLC.PSA.43.5.010" x-head="true" lemma="יָחַל" strong="H3176">Hope</char> <char style="w" x-id="t017" x-align="PSA.43.5.a010">thou</char> <char style="w" x-id="t018" x-align="PSA.43.5.a011" x-src="WLC.PSA.43.5.011" x-source="לֵֽ֭" x-translit="lē" srcloc="WLC.PSA.43.5.011" x-head="true" lemma="לְ" strong="H3807a">in</char> <char style="w" x-id="t019" x-align="PSA.43.5.a012" x-src="WLC.PSA.43.5.012" x-source="אלֹהִים" x-translit="ʾlōhîm" srcloc="WLC.PSA.43.5.012" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>; <char style="w" x-id="t020" x-align="PSA.43.5.a013" x-src="WLC.PSA.43.5.013" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.43.5.013" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t021" x-align="PSA.43.5.a015">I</char> <char style="w" x-id="t022" x-align="PSA.43.5.a015">shall</char> <char style="w" x-id="t023" x-align="PSA.43.5.a014" x-src="WLC.PSA.43.5.014" x-source="ע֣וֹד" x-translit="ʿôḏ" srcloc="WLC.PSA.43.5.014" x-head="true" lemma="עוֹד" strong="H5750">yet</char> <char style="w" x-id="t024" x-align="PSA.43.5.a015" x-src="WLC.PSA.43.5.015" x-source="אוֹדֶ֑" x-translit="ʾôḏ" srcloc="WLC.PSA.43.5.015" x-head="true" lemma="יָדָה" strong="H3034">praise</char> <char style="w" x-id="t025" x-align="PSA.43.5.a016" x-src="WLC.PSA.43.5.016" x-source="נּוּ" x-translit="ennû" srcloc="WLC.PSA.43.5.016" x-head="true" lemma="הוּא" strong="H5105b">him</char>,</para>
