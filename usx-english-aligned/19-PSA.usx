	<chapter number="82" style="c" sid="PSA 82" />
	<para style="s1"><verse number="1" style="v" sid="PSA 82:1" />Unjust judgments rebuked.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.82.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.82.1.a001" x-src="WLC.PSA.82.1.001" x-source="מִזְמ֗וֹר" x-translit="mizmôr" srcloc="WLC.PSA.82.1.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.82.1.a002" x-src="WLC.PSA.82.1.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.82.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.82.1.a003" x-src="WLC.PSA.82.1.003" x-source="אָ֫סָ֥ף" x-translit="ʾāsāp̄" srcloc="WLC.PSA.82.1.003" x-head="true" lemma="אָסָף" strong="H623">Asaph</char>.</para>
	<para style="q1"><char style="w" x-id="t005" x-align="PSA.82.1.a004" x-src="WLC.PSA.82.1.004" x-source="אֱֽלֹהִ֗ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.82.1.004" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t006" x-align="PSA.82.1.a005" x-src="WLC.PSA.82.1.005" x-source="נִצָּ֥ב" x-translit="niṣṣāḇ" srcloc="WLC.PSA.82.1.005" x-head="true" lemma="נָצַב" strong="H5324">standeth</char> <char style="w" x-id="t007" x-align="PSA.82.1.a006" x-src="WLC.PSA.82.1.006" x-source="בַּ" x-translit="ba" srcloc="WLC.PSA.82.1.006" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t008" x-align="PSA.82.1.a007">the</char> <char style="w" x-id="t009" x-align="PSA.82.1.a007" x-src="WLC.PSA.82.1.007" x-source="עֲדַת" x-translit="ʿăḏaṯ-" srcloc="WLC.PSA.82.1.007" x-head="true" lemma="עֵדָה" strong="H5712">congregation</char> <char style="w" x-id="t010" x-align="PSA.82.1.a008">of</char> <char style="w" x-id="t011" x-align="PSA.82.1.a008" x-src="WLC.PSA.82.1.008" x-source="אֵ֑ל" x-translit="ʾēl" srcloc="WLC.PSA.82.1.008" x-head="true" lemma="אֵל" strong="H410">God</char>;</para>
	<para style="q1"><char style="w" x-id="t012" x-align="PSA.82.1.a009">He</char> <char style="w" x-id="t013" x-align="PSA.82.1.a009" x-src="WLC.PSA.82.1.012" x-source="יִשְׁפֹּֽט" x-translit="yišpōṭ:" srcloc="WLC.PSA.82.1.012" x-head="true" lemma="שָׁפַט" strong="H8199">judgeth</char> <char style="w" x-id="t014" x-align="PSA.82.1.a010" x-src="WLC.PSA.82.1.009 WLC.PSA.82.1.010" x-source="בְּ קֶ֖רֶב" x-translit="bə qereḇ" srcloc="WLC.PSA.82.1.010" x-head="true" lemma="קֶרֶב" strong="H7130">among</char> <char style="w" x-id="t015" x-align="PSA.82.1.a011">the</char> <char style="w" x-id="t016" x-align="PSA.82.1.a011" x-src="WLC.PSA.82.1.011" x-source="אֱלֹהִ֣ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.82.1.011" x-head="true" lemma="אֱלֹהִים" strong="H430">gods</char>.<verse eid="PSA 82:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 82:2" /><char style="w" x-id="t001" x-align="PSA.82.2.a001" x-status="noncompositional">How</char> <char style="w" x-id="t002" x-align="PSA.82.2.a001" x-status="noncompositional" x-src="WLC.PSA.82.2.001 WLC.PSA.82.2.002" x-source="עַד מָתַ֥י" x-translit="ʿaḏ- māṯay" srcloc="WLC.PSA.82.2.001" x-head="true" lemma="עַד" strong="H5704">long</char> <char style="w" x-id="t003" x-align="PSA.82.2.a002">will</char> <char style="w" x-id="t004" x-align="PSA.82.2.a002">ye</char> <char style="w" x-id="t005" x-align="PSA.82.2.a002" x-src="WLC.PSA.82.2.003" x-source="תִּשְׁפְּטוּ" x-translit="tišpəṭû-" srcloc="WLC.PSA.82.2.003" x-head="true" lemma="שָׁפַט" strong="H8199">judge</char> <char style="w" x-id="t006" x-align="PSA.82.2.a003" x-src="WLC.PSA.82.2.004" x-source="עָ֑וֶל" x-translit="ʿāwel" srcloc="WLC.PSA.82.2.004" x-head="true" lemma="עָוֶל" strong="H5766">unjustly</char>,</para>
