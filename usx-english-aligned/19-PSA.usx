	<para style="q1"><verse number="7" style="v" sid="PSA 11:7" /><char style="w" x-id="t001" x-align="PSA.11.7.a001" x-src="WLC.PSA.11.7.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.11.7.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.11.7.a003" x-src="WLC.PSA.11.7.003" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.11.7.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t003" x-align="PSA.11.7.a002">is</char> <char style="w" x-id="t004" x-align="PSA.11.7.a002" x-src="WLC.PSA.11.7.002" x-source="צַדִּ֣יק" x-translit="ṣaddiyq" srcloc="WLC.PSA.11.7.002" x-head="true" lemma="צַדִּיק" strong="H6662">righteous</char>; <char style="w" x-id="t005" x-align="PSA.11.7.a005">he</char> <char style="w" x-id="t006" x-align="PSA.11.7.a005" x-src="WLC.PSA.11.7.005" x-source="אָהֵ֑ב" x-translit="ʾāhēḇ" srcloc="WLC.PSA.11.7.005" x-head="true" lemma="אָהֵב" strong="H157">loveth</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">righteous deeds</char></char></note><char style="w" x-id="t007" x-align="PSA.11.7.a004" x-src="WLC.PSA.11.7.004" x-source="צְדָק֣וֹת" x-translit="ṣəḏāqôṯ" srcloc="WLC.PSA.11.7.004" x-head="true" lemma="צְדָקָה" strong="H6666">righteousness</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">His countenance doth behold the upright</char></char></note><char style="w" x-id="t008" x-align="PSA.11.7.a006">The</char> <char style="w" x-id="t009" x-align="PSA.11.7.a006" x-src="WLC.PSA.11.7.006" x-source="יָ֝שָׁ֗ר" x-translit="yāšār" srcloc="WLC.PSA.11.7.006" x-head="true" lemma="יָשָׁר" strong="H3477">upright</char> <char style="w" x-id="t010" x-align="PSA.11.7.a007">shall</char> <char style="w" x-id="t011" x-align="PSA.11.7.a007" x-src="WLC.PSA.11.7.007" x-source="יֶחֱז֥וּ" x-translit="yeḥĕzû" srcloc="WLC.PSA.11.7.007" x-head="true" lemma="חָזָה" strong="H2372">behold</char> <char style="w" x-id="t012" x-align="PSA.11.7.a009" x-src="WLC.PSA.11.7.009" x-source="מוֹ" x-translit="mô" srcloc="WLC.PSA.11.7.009" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t013" x-align="PSA.11.7.a008" x-src="WLC.PSA.11.7.008" x-source="פָנֵֽי" x-translit="p̄ānēy" srcloc="WLC.PSA.11.7.008" x-head="true" lemma="פָּנֶה" strong="H6440">face</char>.<verse eid="PSA 11:7" /></para>
