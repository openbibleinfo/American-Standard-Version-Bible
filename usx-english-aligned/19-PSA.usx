	<chapter eid="PSA 74" />
	<chapter number="75" style="c" sid="PSA 75" />
	<para style="s1"><verse number="1" style="v" sid="PSA 75:1" />God abases the proud, but exalts the righteous.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.75.0.a001" x-src="WLC.PSA.75.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.75.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.75.0.a002" x-src="WLC.PSA.75.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.75.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.75.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.75.0.a003" x-src="WLC.PSA.75.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.75.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="add"><char style="w" x-id="t005" x-align="PSA.75.0.a004" x-status="added" x-source="∅" x-head="true">set</char> <char style="w" x-id="t006" x-align="PSA.75.0.a004" x-status="added">to</char></char> <char style="w" x-id="t007" x-align="PSA.75.0.a005" x-src="WLC.PSA.75.0.004" x-source="אַל" x-translit="ʾal-" srcloc="WLC.PSA.75.0.004" x-head="true" lemma="אַל" strong="H408">Al</char>-<char style="w" x-id="t008" x-align="PSA.75.0.a006" x-src="WLC.PSA.75.0.005" x-source="תַּשְׁחֵ֑ת" x-translit="tašḥēṯ" srcloc="WLC.PSA.75.0.005" x-head="true" lemma="שׁחת" strong="H7843">tashheth</char>. <char style="w" x-id="t009" x-align="PSA.75.0.a007">A</char> <char style="w" x-id="t010" x-align="PSA.75.0.a007" x-src="WLC.PSA.75.0.006" x-source="מִזְמ֖וֹר" x-translit="mizmôr" srcloc="WLC.PSA.75.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t011" x-align="PSA.75.0.a008" x-src="WLC.PSA.75.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.75.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t012" x-align="PSA.75.0.a009" x-src="WLC.PSA.75.0.008" x-source="אָסָ֣ף" x-translit="ʾāsāp̄" srcloc="WLC.PSA.75.0.008" x-head="true" lemma="אָסָף" strong="H623">Asaph</char>, <char style="w" x-id="t013" x-align="PSA.75.0.a010">a</char> <char style="w" x-id="t014" x