	<para style="q1"><verse number="2" style="v" sid="PSA 76:2" /><char style="w" x-id="t001" x-align="PSA.76.2.a003" x-src="WLC.PSA.76.2.003" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.76.2.003" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t002" x-align="PSA.76.2.a004" x-src="WLC.PSA.76.2.004" x-source="שָׁלֵ֣ם" x-translit="šālēm" srcloc="WLC.PSA.76.2.004" x-head="true" lemma="שָׁלֵם" strong="H8004">Salem</char> <char style="w" x-id="t003" x-align="PSA.76.2.a001" x-src="WLC.PSA.76.2.001" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.76.2.001" x-head="true" lemma="וְ" strong="H2050b">also</char> <char style="w" x-id="t004" x-align="PSA.76.2.a002" x-src="WLC.PSA.76.2.002" x-source="יְהִ֣י" x-translit="yəhiy" srcloc="WLC.PSA.76.2.002" x-head="true" lemma="הָיָה" strong="H1961">is</char> <char style="w" x-id="t005" x-align="PSA.76.2.a006" x-src="WLC.PSA.76.2.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.76.2.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">covert</char></char></note><char style="w" x-id="t006" x-align="PSA.76.2.a005" x-src="WLC.PSA.76.2.005" x-source="סֻכּ֑" x-translit="sukk" srcloc="WLC.PSA.76.2.005" x-head="true" lemma="סֹךְ" strong="H5520">tabernacle</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.76.2.a007" x-src="WLC.PSA.76.2.007" x-source="וּ" x-translit="û" srcloc="WLC.PSA.76.2.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t008" x-align="PSA.76.2.a009" x-src="WLC.PSA.76.2.009" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.76.2.009" x-head="true" lemma="הוּא" strong="H2050c">his</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">lair</char></char></note><char style="w" x-id="t009" x-align="PSA.76.2.a008" x-src="WLC.PSA.76.2.008" x-source="מְע֖וֹנָת֣" x-translit="məʿônāṯ" srcloc="WLC.PSA.76.2.008" x-head="true" lemma="מְעֹנָה" strong="H4585">dwelling</char>-<char style="w" x-id="t010" x-align="PSA.76.2.a008">place</char> <char style="w" x-id="t011" x-align="PSA.76.2.a010" x-src="WLC.PSA.76.2.010" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.76.2.010" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t012" x-align="PSA.76.2.a011" x-src="WLC.PSA.76.2.011" x-source="צִיּֽוֹן" x-translit="ṣiyyôn:" srcloc="WLC.PSA.76.2.011" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>.<verse eid="PSA 76:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="PSA 76:3" /><char style="w" x-id="t001" x-align="PSA.76.3.a001" x-src="WLC.PSA.76.3.001 WLC.PSA.76.3.002" x-source="שָׁ֭מָּ ה" x-translit="šāmm āh" srcloc="WLC.PSA.76.3.001" x-head="true" lemma="שָׁם" strong="H8033">There</char> <char style="w" x-id="t002" x-align="PSA.76.3.a002">he</char> <char style="w" x-id="t003" x-align="PSA.76.3.a002" x-src="WLC.PSA.76.3.003" x-source="שִׁבַּ֣ר" x-translit="šibbar" srcloc="WLC.PSA.76.3.003" x-head="true" lemma="שָׁבַר" strong="H7665">brake</char> <char style="w" x-id="t004" x-align="PSA.76.3.a003">the</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">fiery shafts</char>. Or, <char style="it">lightnings</char></char></note><char style="w" x-id="t005" x-align="PSA.76.3.a003" x-src="WLC.PSA.76.3.004" x-source="רִשְׁפֵי" x-translit="rišp̄ê-" srcloc="WLC.PSA.76.3.004" x-head="true" lemma="רֶשֶׁף" strong="H7565">arrows</char> <char style="w" x-id="t006" x-align="PSA.76.3.a004">of</char> <char style="w" x-id="t007" x-align="PSA.76.3.a004">the</char> <char style="w" x-id="t008" x-align="PSA.76.3.a004" x-src="WLC.PSA.76.3.005" x-source="קָ֑שֶׁת" x-translit="qāšeṯ" srcloc="WLC.PSA.76.3.005" x-head="true" lemma="קֶשֶׁת" strong="H7198">bow</char>;</para>
