	<para style="q1"><char style="w" x-id="t005" x-align="PSA.8.9.a004" x-src="WLC.PSA.8.9.004" x-source="מָֽה" x-translit="māh-" srcloc="WLC.PSA.8.9.004" x-head="true" lemma="מָה" strong="H4100">How</char> <char style="w" x-id="t006" x-align="PSA.8.9.a005" x-src="WLC.PSA.8.9.005" x-source="אַדִּ֥יר" x-translit="ʾaddiyr" srcloc="WLC.PSA.8.9.005" x-head="true" lemma="אַדִּיר" strong="H117">excellent</char> <char style="w" x-id="t007" x-align="PSA.8.9.a005">is</char> <char style="w" x-id="t008" x-align="PSA.8.9.a007" x-src="WLC.PSA.8.9.007" x-source="ךָ֗" x-translit="əḵā" srcloc="WLC.PSA.8.9.007" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t009" x-align="PSA.8.9.a006" x-src="WLC.PSA.8.9.006" x-source="שִׁ֝מְ" x-translit="šim" srcloc="WLC.PSA.8.9.006" x-head="true" lemma="שֵׁם" strong="H8034">name</char> <char style="w" x-id="t010" x-align="PSA.8.9.a008" x-src="WLC.PSA.8.9.008" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.8.9.008" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t011" x-align="PSA.8.9.a009" x-src="WLC.PSA.8.9.009" x-source="כָל" x-translit="ḵol-" srcloc="WLC.PSA.8.9.009" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t012" x-align="PSA.8.9.a010" x-src="WLC.PSA.8.9.010" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.8.9.010" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t013" x-align="PSA.8.9.a011" x-src="WLC.PSA.8.9.011" x-source="אָֽרֶץ" x-translit="ʾāreṣ:" srcloc="WLC.PSA.8.9.011" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>!<verse eid="PSA 8:9" /></para>
	<chapter eid="PSA 8" />
	<chapter number="9" style="c" sid="PSA 9" />
	<para style="s1"><verse number="1" style="v" sid="PSA 9:1" />A psalm of thanksgiving for God’s justice.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.9.0.a001" x-src="WLC.PSA.9.0.001" x-source="לַ֭" x-translit="la" srcloc="WLC.PSA.9.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.9.0.a002" x-src="WLC.PSA.9.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.9.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.9.0.a003" x-src="WLC.PSA.9.0.003" x-source="מְנַצֵּחַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.9.0.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.9.0.a003">Musician</char>; <char style="w" x-id="t005" x-align="PSA.9.0.a004">set</char> <char style="w" x-id="t006" x-align="PSA.9.0.a004">to</char> <char style="w" x-id="t007" x-align="PSA.9.0.a004" x-src="WLC.PSA.9.0.004" x-source="עַלְמ֥וּת" x-translit="ʿalmûṯ" srcloc="WLC.PSA.9.0.004" x-head="true" lemma="עַלְמוּת" strong="H4192">Muth</char>-<char style="w" x-id="t008" x-align="PSA.9.0.a005" x-src="WLC.PSA.9.0.005" x-source="לַבֵּ֗ן" x-translit="labbēn" srcloc="WLC.PSA.9.0.005" x-head="true" lemma="לְ" strong="H4192">labben</char>. <char style="w" x-id="t009" x-align="PSA.9.0.a006">A</char> <char style="w" x-id="t010" x-align="PSA.9.0.a006" x-src="WLC.PSA.9.0.006" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.9.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t011" x-align="PSA.9.0.a007" x-src="WLC.PSA.9.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.9.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t012" x-align="PSA.9.0.a008" x-src="WLC.PSA.9.0.008" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.9.0.008" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.9.1.a001">I</char> <char style="w" x-id="t002" x-align="PSA.9.1.a001">will</char> <char style="w" x-id="t003" x-align="PSA.9.1.a001">give</char> <char style="w" x-id="t004" x-align="PSA.9.1.a001" x-src="WLC.PSA.9.1.001" x-source="אוֹדֶ֣ה" x-translit="ʾôḏeh" srcloc="WLC.PSA.9.1.001" x-head="true" lemma="יָדָה" strong="H3034">thanks</char> <char style="w" x-id="t005" x-align="PSA.9.1.a001">unto</char> <char style="w" x-id="t006" x-align="PSA.9.1.a002" x-src="WLC.PSA.9.1.002" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.9.1.002" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t007" x-align="PSA.9.1.a003" x-src="WLC.PSA.9.1.003" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.9.1.003" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t008" x-align="PSA.9.1.a006" x-src="WLC.PSA.9.1.006" x-source="י" x-translit="iy" srcloc="WLC.PSA.9.1.006" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t009" x-align="PSA.9.1.a004" x-src="WLC.PSA.9.1.004" x-source="כָל" x-translit="ḵol-" srcloc="WLC.PSA.9.1.004" x-head="true" lemma="כֹּל" strong="H3605">whole</char> <char style="w" x-id="t010" x-align="PSA.9.1.a005" x-src="WLC.PSA.9.1.005" x-source="לִבִּ֑" x-translit="libb" srcloc="WLC.PSA.9.1.005" x-head="true" lemma="לֵב" strong="H3820">heart</char>;</para>
	<para style="q1"><char style="w" x-id="t011" x-align="PSA.9.1.a007">I</char> <char style="w" x-id="t012" x-align="PSA.9.1.a007">will</char> <char style="w" x-id="t013" x-align="PSA.9.1.a007" x-src="WLC.PSA.9.1.007" x-source="אֲ֝סַפְּרָ֗ה" x-translit="ʾăsappərāh" srcloc="WLC.PSA.9.1.007" x-head="true" lemma="סָפַר" strong="H5608">show</char> <char style="w" x-id="t014" x-align="PSA.9.1.a007">forth</char> <char style="w" x-id="t015" x-align="PSA.9.1.a008" x-src="WLC.PSA.9.1.008" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.9.1.008" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t016" x-align="PSA.9.1.a010" x-src="WLC.PSA.9.1.010" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.9.1.010" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t017" x-align="PSA.9.1.a009" x-src="WLC.PSA.9.1.009" x-source="נִפְלְאוֹתֶֽי" x-translit="nip̄ləʾôṯey" srcloc="WLC.PSA.9.1.009" x-head="true" lemma="פָּלָא" strong="H6381">marvellous</char> <char style="w" x-id="t018" x-align="PSA.9.1.a009">works</char>.<verse eid="PSA 9:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 9:2" /><char style="w" x-id="t001" x-align="PSA.9.2.a001">I</char> <char style="w" x-id="t002" x-align="PSA.9.2.a001">will</char> <char style="w" x-id="t003" x-align="PSA.9.2.a001">be</char> <char style="w" x-id="t004" x-align="PSA.9.2.a001" x-src="WLC.PSA.9.2.001" x-source="אֶשְׂמְחָ֣ה" x-translit="ʾeśməḥāh" srcloc="WLC.PSA.9.2.001" x-head="true" lemma="שָׂמַח" strong="H8055">glad</char> <char style="w" x-id="t005" x-align="PSA.9.2.a002" x-src="WLC.PSA.9.2.002" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.9.2.002" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t006" x-align="PSA.9.2.a003" x-src="WLC.PSA.9.2.003" x-source="אֶעֶלְצָ֣ה" x-translit="ʾeʿelṣāh" srcloc="WLC.PSA.9.2.003" x-head="true" lemma="עָלַץ" strong="H5970">exult</char> <char style="w" x-id="t007" x-align="PSA.9.2.a004" x-src="WLC.PSA.9.2.004" x-source="בָ֑" x-translit="ḇ" srcloc="WLC.PSA.9.2.004" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t008" x-align="PSA.9.2.a005" x-src="WLC.PSA.9.2.005" x-source="ךְ" x-translit="āḵ" srcloc="WLC.PSA.9.2.005" x-head="true" lemma="הוּא" strong="H3509b">thee</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.9.2.a006">I</char> <char style="w" x-id="t010" x-align="PSA.9.2.a006">will</char> <char style="w" x-id="t011" x-align="PSA.9.2.a006">sing</char> <char style="w" x-id="t012" x-align="PSA.9.2.a006" x-src="WLC.PSA.9.2.006" x-source="אֲזַמְּרָ֖ה" x-translit="ʾăzammərāh" srcloc="WLC.PSA.9.2.006" x-head="true" lemma="זָמַר" strong="H2167">praise</char> <char style="w" x-id="t013" x-align="PSA.9.2.a006">to</char> <char style="w" x-id="t014" x-align="PSA.9.2.a008" x-src="WLC.PSA.9.2.008" x-source="ךָ֣" x-translit="əḵā" srcloc="WLC.PSA.9.2.008" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t015" x-align="PSA.9.2.a007" x-src="WLC.PSA.9.2.007" x-source="שִׁמְ" x-translit="šim" srcloc="WLC.PSA.9.2.007" x-head="true" lemma="שֵׁם" strong="H8034">name</char>, <char style="w" x-id="t016" x-align="PSA.9.2.a009">O</char> <char style="w" x-id="t017" x-align="PSA.9.2.a009">thou</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">Most High; Because mine etc.</char></char></note><char style="w" x-id="t018" x-align="PSA.9.2.a009">Most</char> <char style="w" x-id="t019" x-align="PSA.9.2.a009" x-src="WLC.PSA.9.2.009" x-source="עֶלְיֽוֹן" x-translit="ʿelyôn:" srcloc="WLC.PSA.9.2.009" x-head="true" lemma="עֶלְיוֹן" strong="H5945a">High</char>.<verse eid="PSA 9:2" /></para>
