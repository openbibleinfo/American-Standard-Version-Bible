	<para style="q1"><verse number="36" style="v" sid="PSA 89:36" /><char style="w" x-id="t001" x-align="PSA.89.36.a002" x-src="WLC.PSA.89.36.002" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.89.36.002" x-head="true" lemma="הוּא" strong="H2050c">His</char> <char style="w" x-id="t002" x-align="PSA.89.36.a001" x-src="WLC.PSA.89.36.001" x-source="זַ֭רְע" x-translit="zarʿ" srcloc="WLC.PSA.89.36.001" x-head="true" lemma="זֶרַע" strong="H2233">seed</char> <char style="w" x-id="t003" x-align="PSA.89.36.a005">shall</char> <char style="w" x-id="t004" x-align="PSA.89.36.a005" x-src="WLC.PSA.89.36.005" x-source="יִהְיֶ֑ה" x-translit="yihyeh" srcloc="WLC.PSA.89.36.005" x-head="true" lemma="הָיָה" strong="H1961">endure</char> <char style="w" x-id="t005" x-align="PSA.89.36.a003" x-src="WLC.PSA.89.36.003" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.89.36.003" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t006" x-align="PSA.89.36.a004" x-src="WLC.PSA.89.36.004" x-source="עוֹלָ֣ם" x-translit="ʿôlām" srcloc="WLC.PSA.89.36.004" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char>,</para>
