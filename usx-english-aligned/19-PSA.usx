	<para style="q1"><verse number="11" style="v" x-unrepresented-source="עָלֵ֑י" x-unrepresented-translit="ʿālēy" x-unrepresented-src="WLC.PSA.5.11.012" sid="PSA 5:11" /><note caller="-" style="f"><char style="ft">Or, <char style="it">So shall all those . . . rejoice, They shall ever shout . . . and thou shalt defend them: They also . . . shall be joyful in thee</char>.</char></note><char style="w" x-id="t001" x-align="PSA.5.11.a001" x-src="WLC.PSA.5.11.001" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.5.11.001" x-head="true" lemma="וְ" strong="H2050b">But</char> <char style="w" x-id="t002" x-align="PSA.5.11.a002">let</char> <char style="w" x-id="t003" x-align="PSA.5.11.a003" x-src="WLC.PSA.5.11.003" x-source="כָל" x-translit="ḵol-" srcloc="WLC.PSA.5.11.003" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t004" x-align="PSA.5.11.a004">those</char> <char style="w" x-id="t005" x-align="PSA.5.11.a004">that</char> <char style="w" x-id="t006" x-align="PSA.5.11.a004">take</char> <char style="w" x-id="t007" x-align="PSA.5.11.a004" x-src="WLC.PSA.5.11.004" x-source="ח֪וֹסֵי" x-translit="ḥôsê" srcloc="WLC.PSA.5.11.004" x-head="true" lemma="חָסָה" strong="H2620">refuge</char> <char style="w" x-id="t008" x-align="PSA.5.11.a005" x-src="WLC.PSA.5.11.005" x-source="בָ֡" x-translit="ḇ" srcloc="WLC.PSA.5.11.005" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t009" x-align="PSA.5.11.a006" x-src="WLC.PSA.5.11.006" x-source="ךְ" x-translit="āḵ" srcloc="WLC.PSA.5.11.006" x-head="true" lemma="הוּא" strong="H3509b">thee</char> <char style="w" x-id="t010" x-align="PSA.5.11.a002" x-src="WLC.PSA.5.11.002" x-source="יִשְׂמְח֨וּ" x-translit="yiśməḥû" srcloc="WLC.PSA.5.11.002" x-head="true" lemma="שָׂמַח" strong="H8055">rejoice</char>,</para>
