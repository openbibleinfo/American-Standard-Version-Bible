	<chapter number="14" style="c" sid="PSA 14" />
	<para style="s1"><verse number="1" style="v" sid="PSA 14:1" />The folly and wickedness of men.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.14.1.a001" x-src="WLC.PSA.14.1.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.14.1.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.14.1.a002" x-src="WLC.PSA.14.1.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.14.1.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.14.1.a003" x-src="WLC.PSA.14.1.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.14.1.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.14.1.a003">Musician</char>. <char style="add"><char style="w" x-id="t005" x-align="PSA.14.1.a004" x-status="added">A</char> <char style="w" x-id="t006" x-align="PSA.14.1.a004" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t007" x-align="PSA.14.1.a005" x-src="WLC.PSA.14.1.004" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.14.1.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.14.1.a006" x-src="WLC.PSA.14.1.005" x-source="דָ֫וִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.14.1.005" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.14.1.a008">The</char> <char style="w" x-id="t010" x-align="PSA.14.1.a008" x-src="WLC.PSA.14.1.007" x-source="נָבָ֣ל" x-translit="nāḇāl" srcloc="WLC.PSA.14.1.007" x-head="true" lemma="נָבָל" strong="H5036">fool</char> <char style="w" x-id="t011" x-align="PSA.14.1.a007">hath</char> <char style="w" x-id="t012" x-align="PSA.14.1.a007" x-src="WLC.PSA.14.1.006" x-source="אָ֘מַ֤ר" x-translit="ʾāmar" srcloc="WLC.PSA.14.1.006" x-head="true" lemma="אָמַר" strong="H559">said</char> <char style="w" x-id="t013" x-align="PSA.14.1.a009" x-src="WLC.PSA.14.1.008" x-source="בְּ֭" x-translit="bə" srcloc="WLC.PSA.14.1.008" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t014" x-align="PSA.14.1.a011" x-src="WLC.PSA.14.1.010" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.14.1.010" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t015" x-align="PSA.14.1.a010" x-src="WLC.PSA.14.1.009" x-source="לִבּ" x-translit="libb" srcloc="WLC.PSA.14.1.009" x-head="true" lemma="לֵב" strong="H3820">heart</char>, <char style="w" x-id="t016" x-align="PSA.14.1.a012">There</char> <char style="w" x-id="t017" x-align="PSA.14.1.a012">is</char> <char style="w" x-id="t018" x-align="PSA.14.1.a012" x-src="WLC.PSA.14.1.011" x-source="אֵ֣ין" x-translit="ʾēyn" srcloc="WLC.PSA.14.1.011" x-head="true" lemma="אַיִן" strong="H369">no</char> <char style="w" x-id="t019" x-align="PSA.14.1.a013" x-src="WLC.PSA.14.1.012" x-source="אֱלֹהִ֑ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.14.1.012" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>.</para>
