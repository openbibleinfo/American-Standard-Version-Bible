	<para style="q1"><verse number="17" style="v" sid="PSA 66:17" /><char style="w" x-id="t001" x-align="PSA.66.17.a005">I</char> <char style="w" x-id="t002" x-align="PSA.66.17.a005" x-src="WLC.PSA.66.17.005" x-source="קָרָ֑אתִי" x-translit="qārāʾṯî" srcloc="WLC.PSA.66.17.005" x-head="true" lemma="קָרָא" strong="H7121">cried</char> <char style="w" x-id="t003" x-align="PSA.66.17.a001" x-src="WLC.PSA.66.17.001" x-source="אֵלָ֥י" x-translit="ʾēlāy" srcloc="WLC.PSA.66.17.001" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t004" x-align="PSA.66.17.a002" x-src="WLC.PSA.66.17.002" x-source="ו" x-translit="w" srcloc="WLC.PSA.66.17.002" x-head="true" lemma="הוּא" strong="H2050c">him</char> <char style="w" x-id="t005" x-align="PSA.66.17.a003">with</char> <char style="w" x-id="t006" x-align="PSA.66.17.a004" x-src="WLC.PSA.66.17.004" x-source="י" x-translit="iy-" srcloc="WLC.PSA.66.17.004" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t007" x-align="PSA.66.17.a003" x-src="WLC.PSA.66.17.003" x-source="פִּֽ" x-translit="p" srcloc="WLC.PSA.66.17.003" x-head="true" lemma="פֶּה" strong="H6310">mouth</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.66.17.a006" x-src="WLC.PSA.66.17.006" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.66.17.006" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, as otherwise read, <char style="it">high praise was under my tongue</char></char></note><char style="w" x-id="t009" x-align="PSA.66.17.a007">he</char> <char style="w" x-id="t010" x-align="PSA.66.17.a007">was</char> <char style="w" x-id="t011" x-align="PSA.66.17.a007" x-src="WLC.PSA.66.17.007" x-source="רוֹמַ֗ם" x-translit="rômam" srcloc="WLC.PSA.66.17.007" x-head="true" lemma="רוֹמָם" strong="H7318">extolled</char> <char style="w" x-id="t012" x-align="PSA.66.17.a008" x-src="WLC.PSA.66.17.008" x-source="תַּ֣חַת" x-translit="taḥaṯ" srcloc="WLC.PSA.66.17.008" x-head="true" lemma="תַּחַת" strong="H8478">with</char> <char style="w" x-id="t013" x-align="PSA.66.17.a010" x-src="WLC.PSA.66.17.010" x-source="י" x-translit="iy" srcloc="WLC.PSA.66.17.010" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t014" x-align="PSA.66.17.a009" x-src="WLC.PSA.66.17.009" x-source="לְשׁוֹנִֽ" x-translit="ləšôn" srcloc="WLC.PSA.66.17.009" x-head="true" lemma="לָשׁוֹן" strong="H3956">tongue</char>.<verse eid="PSA 66:17" /></para>
	<para style="q1"><verse number="18" style="v" x-unrepresented-source="י" x-unrepresented-translit="āy" x-unrepresented-src="WLC.PSA.66.18.010" sid="PSA 66:18" /><char style="w" x-id="t001" x-align="PSA.66.18.a002" x-src="WLC.PSA.66.18.002" x-source="אִם" x-translit="ʾim-" srcloc="WLC.PSA.66.18.002" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="PSA.66.18.a003">I</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">had regarded</char></char></note><char style="w" x-id="t003" x-align="PSA.66.18.a003" x-src="WLC.PSA.66.18.003" x-source="רָאִ֣יתִי" x-translit="rāʾiyṯî" srcloc="WLC.PSA.66.18.003" x-head="true" lemma="רָאָה" strong="H7200">regard</char> <char style="w" x-id="t004" x-align="PSA.66.18.a001" x-src="WLC.PSA.66.18.001" x-source="אָ֭וֶן" x-translit="ʾāwen" srcloc="WLC.PSA.66.18.001" x-head="true" lemma="אָוֶן" strong="H205">iniquity</char> <char style="w" x-id="t005" x-align="PSA.66.18.a004" x-src="WLC.PSA.66.18.004" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.66.18.004" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t006" x-align="PSA.66.18.a006" x-src="WLC.PSA.66.18.006" x-source="י" x-translit="iy" srcloc="WLC.PSA.66.18.006" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t007" x-align="PSA.66.18.a005" x-src="WLC.PSA.66.18.005" x-source="לִבִּ֑" x-translit="libb" srcloc="WLC.PSA.66.18.005" x-head="true" lemma="לֵב" strong="H3820">heart</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.66.18.a009">The</char> <char style="w" x-id="t009" x-align="PSA.66.18.a009" x-src="WLC.PSA.66.18.009" x-source="אֲדֹנָֽ" x-translit="ʾăḏōn" srcloc="WLC.PSA.66.18.009" x-head="true" lemma="אֲדֹנָי" strong="H136">Lord</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">would</char></char></note><char style="w" x-id="t010" x-align="PSA.66.18.a008">will</char> <char style="w" x-id="t011" x-align="PSA.66.18.a007" x-src="WLC.PSA.66.18.007" x-source="לֹ֖א" x-translit="lōʾ" srcloc="WLC.PSA.66.18.007" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t012" x-align="PSA.66.18.a008" x-src="WLC.PSA.66.18.008" x-source="יִשְׁמַ֣ע" x-translit="yišmaʿ" srcloc="WLC.PSA.66.18.008" x-head="true" lemma="שָׁמַע" strong="H8085">hear</char>:<verse eid="PSA 66:18" /></para>
	<para style="q1"><verse number="19" style="v" sid="PSA 66:19" /><char style="w" x-id="t001" x-align="PSA.66.19.a001">But</char> <char style="w" x-id="t002" x-align="PSA.66.19.a001" x-src="WLC.PSA.66.19.001" x-source="אָ֭כֵן" x-translit="ʾāḵēn" srcloc="WLC.PSA.66.19.001" x-head="true" lemma="אָכֵן" strong="H403">verily</char> <char style="w" x-id="t003" x-align="PSA.66.19.a003" x-src="WLC.PSA.66.19.003" x-source="אֱלֹהִ֑ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.66.19.003" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t004" x-align="PSA.66.19.a002">hath</char> <char style="w" x-id="t005" x-align="PSA.66.19.a002" x-src="WLC.PSA.66.19.002" x-source="שָׁמַ֣ע" x-translit="šāmaʿ" srcloc="WLC.PSA.66.19.002" x-head="true" lemma="שָׁמַע" strong="H8085">heard</char>;</para>
