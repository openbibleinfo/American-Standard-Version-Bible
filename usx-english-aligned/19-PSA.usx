	<chapter eid="PSA 72" />
	<chapter number="73" style="c" sid="PSA 73" />
	<para style="ms1"><verse number="1" style="v" sid="PSA 73:1" />Book III</para>
	<para style="s1">The end of the wicked contrasted with that of the righteous.</para>
