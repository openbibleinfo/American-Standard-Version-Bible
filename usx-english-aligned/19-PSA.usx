	<chapter eid="PSA 9" />
	<chapter number="10" style="c" sid="PSA 10" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="בְּ" x-unrepresented-translit="bə" x-unrepresented-src="WLC.PSA.10.1.005" sid="PSA 10:1" />A prayer for the overthrow of the wicked.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.10.1.a001" x-src="WLC.PSA.10.1.001 WLC.PSA.10.1.002" x-source="לָ מָ֣ה" x-translit="lā māh" srcloc="WLC.PSA.10.1.002" x-head="true" lemma="מָה" strong="H4100">Why</char> <char style="w" x-id="t002" x-align="PSA.10.1.a003" x-src="WLC.PSA.10.1.004" x-source="תַּעֲמֹ֣ד" x-translit="taʿămōḏ" srcloc="WLC.PSA.10.1.004" x-head="true" lemma="עָמַד" strong="H5975">standest</char> <char style="w" x-id="t003" x-align="PSA.10.1.a003">thou</char> <char style="w" x-id="t004" x-align="PSA.10.1.a005" x-src="WLC.PSA.10.1.006" x-source="רָח֑וֹק" x-translit="rāḥôq" srcloc="WLC.PSA.10.1.006" x-head="true" lemma="רָחֹוק" strong="H7350">afar</char> <char style="w" x-id="t005" x-align="PSA.10.1.a005">off</char>, <char style="w" x-id="t006" x-align="PSA.10.1.a002">O</char> <char style="w" x-id="t007" x-align="PSA.10.1.a002" x-src="WLC.PSA.10.1.003" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.10.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>?</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.10.1.a006">Why</char> <char style="w" x-id="t009" x-align="PSA.10.1.a006" x-src="WLC.PSA.10.1.007" x-source="תַּ֝עְלִ֗ים" x-translit="taʿliym" srcloc="WLC.PSA.10.1.007" x-head="true" lemma="עָלַם" strong="H5956">hidest</char> <char style="w" x-id="t010" x-align="PSA.10.1.a006">thou</char> <char style="w" x-id="t011" x-align="PSA.10.1.a006">thyself</char> <char style="w" x-id="t012" x-align="PSA.10.1.a007" x-src="WLC.PSA.10.1.008" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.10.1.008" x-head="true" lemma="לְ" strong="H3807a">in</char> <char style="w" x-id="t013" x-align="PSA.10.1.a008" x-src="WLC.PSA.10.1.009" x-source="עִתּ֥וֹת" x-translit="ʿitôṯ" srcloc="WLC.PSA.10.1.009" x-head="true" lemma="עֵת" strong="H6256">times</char> <char style="w" x-id="t014" x-align="PSA.10.1.a009">of</char> <char style="w" x-id="t015" x-align="PSA.10.1.a009" x-src="WLC.PSA.10.1.010" x-source="בַּצָּרָֽה" x-translit="baṣṣārâ:" srcloc="WLC.PSA.10.1.010" x-head="true" lemma="בְּ" strong="H1226a">trouble</char>?<verse eid="PSA 10:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 10:2" /><char style="w" x-id="t001" x-align="PSA.10.2.a001" x-src="WLC.PSA.10.2.001" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.10.2.001" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t002" x-align="PSA.10.2.a002">the</char> <char style="w" x-id="t003" x-align="PSA.10.2.a002" x-src="WLC.PSA.10.2.002" x-source="גַאֲוַ֣ת" x-translit="ḡaʾăwaṯ" srcloc="WLC.PSA.10.2.002" x-head="true" lemma="גַּאֲוָה" strong="H1346">pride</char> <char style="w" x-id="t004" x-align="PSA.10.2.a003">of</char> <char style="w" x-id="t005" x-align="PSA.10.2.a003">the</char> <char style="w" x-id="t006" x-align="PSA.10.2.a003" x-src="WLC.PSA.10.2.003" x-source="רָ֭שָׁע" x-translit="rāšāʿ" srcloc="WLC.PSA.10.2.003" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">he doth hotly pursue the poor</char></char></note><char style="w" x-id="t007" x-align="PSA.10.2.a005">the</char> <char style="w" x-id="t008" x-align="PSA.10.2.a005" x-src="WLC.PSA.10.2.005" x-source="עָנִ֑י" x-translit="ʿāniy" srcloc="WLC.PSA.10.2.005" x-head="true" lemma="עָנִי" strong="H6041">poor</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">is set on fire</char>.</char></note><char style="w" x-id="t009" x-align="PSA.10.2.a004">is</char> <char style="w" x-id="t010" x-align="PSA.10.2.a004">hotly</char> <char style="w" x-id="t011" x-align="PSA.10.2.a004" x-src="WLC.PSA.10.2.004" x-source="יִדְלַ֣ק" x-translit="yiḏlaq" srcloc="WLC.PSA.10.2.004" x-head="true" lemma="דָּלַק" strong="H1814">pursued</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">They are taken</char></char></note><char style="w" x-id="t012" x-align="PSA.10.2.a006">Let</char> <char style="w" x-id="t013" x-align="PSA.10.2.a006">them</char> <char style="w" x-id="t014" x-align="PSA.10.2.a006">be</char> <char style="w" x-id="t015" x-align="PSA.10.2.a006" x-src="WLC.PSA.10.2.006" x-source="יִתָּפְשׂ֓וּ" x-translit="yittāp̄əśû" srcloc="WLC.PSA.10.2.006" x-head="true" lemma="תָּפַשׂ" strong="H8610">taken</char> <char style="w" x-id="t016" x-align="PSA.10.2.a007" x-src="WLC.PSA.10.2.007" x-source="בִּ" x-translit="bi" srcloc="WLC.PSA.10.2.007" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t017" x-align="PSA.10.2.a008">the</char> <char style="w" x-id="t018" x-align="PSA.10.2.a008" x-src="WLC.PSA.10.2.008" x-source="מְזִמּ֖וֹת" x-translit="məzimmôṯ" srcloc="WLC.PSA.10.2.008" x-head="true" lemma="מְזִמָּה" strong="H4209">devices</char> <char style="w" x-id="t019" x-align="PSA.10.2.a009" x-src="WLC.PSA.10.2.009" x-source="ז֣וּ" x-translit="zû" srcloc="WLC.PSA.10.2.009" x-head="true" lemma="זוּ" strong="H2098">that</char> <char style="w" x-id="t020" x-align="PSA.10.2.a010">they</char> <char style="w" x-id="t021" x-align="PSA.10.2.a010">have</char> <char style="w" x-id="t022" x-align="PSA.10.2.a010" x-src="WLC.PSA.10.2.010" x-source="חָשָֽׁבוּ" x-translit="ḥāšāḇû:" srcloc="WLC.PSA.10.2.010" x-head="true" lemma="חָשַׁב" strong="H2803">conceived</char>.<verse eid="PSA 10:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="PSA 10:3" /><char style="w" x-id="t001" x-align="PSA.10.3.a001" x-src="WLC.PSA.10.3.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.10.3.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.10.3.a003">the</char> <char style="w" x-id="t003" x-align="PSA.10.3.a003" x-src="WLC.PSA.10.3.003" x-source="רָ֭שָׁע" x-translit="rāšāʿ" srcloc="WLC.PSA.10.3.003" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char> <char style="w" x-id="t004" x-align="PSA.10.3.a002" x-src="WLC.PSA.10.3.002" x-source="הִלֵּ֣ל" x-translit="hillēl" srcloc="WLC.PSA.10.3.002" x-head="true" lemma="הָלַל" strong="H1984a">boasteth</char> <char style="w" x-id="t005" x-align="PSA.10.3.a004" x-src="WLC.PSA.10.3.004" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.10.3.004" x-head="true" lemma="עַל" strong="H5921">of</char> <char style="w" x-id="t006" x-align="PSA.10.3.a007" x-src="WLC.PSA.10.3.007" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.10.3.007" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="PSA.10.3.a006" x-src="WLC.PSA.10.3.006" x-source="נַפְשׁ֑" x-translit="nap̄š" srcloc="WLC.PSA.10.3.006" x-head="true" lemma="נֶפֶשׁ" strong="H5315">heart’s</char> <char style="w" x-id="t008" x-align="PSA.10.3.a005" x-src="WLC.PSA.10.3.005" x-source="תַּאֲוַ֣ת" x-translit="taʾăwaṯ" srcloc="WLC.PSA.10.3.005" x-head="true" lemma="תַּאֲוָה" strong="H8378">desire</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.10.3.a008" x-src="WLC.PSA.10.3.008" x-source="וּ" x-translit="û" srcloc="WLC.PSA.10.3.008" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">blesseth the covetous</char>, but <char style="it">contemneth etc.</char></char></note><char style="w" x-id="t010" x-align="PSA.10.3.a009">the</char> <char style="w" x-id="t011" x-align="PSA.10.3.a009" x-src="WLC.PSA.10.3.009" x-source="בֹצֵ֥עַ" x-translit="ḇōṣēᵃʿ" srcloc="WLC.PSA.10.3.009" x-head="true" lemma="בָּצַע" strong="H1214">covetous</char> <char style="w" x-id="t012" x-align="PSA.10.3.a010" x-src="WLC.PSA.10.3.010" x-source="בֵּ֝רֵ֗ךְ" x-translit="bērēḵ" srcloc="WLC.PSA.10.3.010" x-head="true" lemma="בָּרַךְ" strong="H1288">renounceth</char>, <char style="add"><char style="w" x-id="t013" x-align="PSA.10.3.a011" x-status="added" x-source="∅" x-head="true">yea</char></char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">revileth</char></char></note><char style="w" x-id="t014" x-align="PSA.10.3.a012" x-src="WLC.PSA.10.3.011" x-source="נִ֘אֵ֥ץ" x-translit="niʾēṣ" srcloc="WLC.PSA.10.3.011" x-head="true" lemma="נָאַץ" strong="H5006">contemneth</char> <char style="w" x-id="t015" x-align="PSA.10.3.a013" x-src="WLC.PSA.10.3.012" x-source="יְהוָֽה" x-translit="yəhwāh:" srcloc="WLC.PSA.10.3.012" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>.<verse eid="PSA 10:3" /></para>
	<para style="q1"><verse number="4" style="v" sid="PSA 10:4" /><char style="w" x-id="t001" x-align="PSA.10.4.a001">The</char> <char style="w" x-id="t002" x-align="PSA.10.4.a001" x-src="WLC.PSA.10.4.001" x-source="רָשָׁ֗ע" x-translit="rāšāʿ" srcloc="WLC.PSA.10.4.001" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char>, <char style="w" x-id="t003" x-align="PSA.10.4.a002" x-src="WLC.PSA.10.4.002" x-source="כְּ" x-translit="kə" srcloc="WLC.PSA.10.4.002" x-head="true" lemma="כְּ" strong="H3509a">in</char> <char style="w" x-id="t004" x-align="PSA.10.4.a003">the</char> <char style="w" x-id="t005" x-align="PSA.10.4.a003" x-src="WLC.PSA.10.4.003" x-source="גֹ֣בַהּ" x-translit="ḡōḇaẖ" srcloc="WLC.PSA.10.4.003" x-head="true" lemma="גֹּבַהּ" strong="H1363">pride</char> <char style="w" x-id="t006" x-align="PSA.10.4.a004">of</char> <char style="w" x-id="t007" x-align="PSA.10.4.a005" x-src="WLC.PSA.10.4.005" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.10.4.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t008" x-align="PSA.10.4.a004" x-src="WLC.PSA.10.4.004" x-source="אַ֭פּ" x-translit="ʾapp" srcloc="WLC.PSA.10.4.004" x-head="true" lemma="אַף" strong="H639">countenance</char>, <char style="add"><char style="w" x-id="t009" x-align="PSA.10.4.a006" x-status="added" x-source="∅" x-head="true">saith</char></char>, <char style="w" x-id="t010" x-align="PSA.10.4.a008">He</char> <char style="w" x-id="t011" x-align="PSA.10.4.a008">will</char> <char style="w" x-id="t012" x-align="PSA.10.4.a007" x-src="WLC.PSA.10.4.006" x-source="בַּל" x-translit="bal-" srcloc="WLC.PSA.10.4.006" x-head="true" lemma="בַּל" strong="H1077">not</char> <char style="w" x-id="t013" x-align="PSA.10.4.a008" x-src="WLC.PSA.10.4.007" x-source="יִדְרֹ֑שׁ" x-translit="yiḏrōš" srcloc="WLC.PSA.10.4.007" x-head="true" lemma="דָּרַשׁ" strong="H1875">require</char> <char style="add"><char style="w" x-id="t014" x-align="PSA.10.4.a009" x-status="added" x-source="∅" x-head="true">it</char></char>.</para>
	<para style="q1"><char style="w" x-id="t015" x-align="PSA.10.4.a012" x-src="WLC.PSA.10.4.010" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.10.4.010" x-head="true" lemma="כֹּל" strong="H3605">All</char> <char style="w" x-id="t016" x-align="PSA.10.4.a014" x-src="WLC.PSA.10.4.012" x-source="ו" x-translit="w" srcloc="WLC.PSA.10.4.012" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t017" x-align="PSA.10.4.a013" x-src="WLC.PSA.10.4.011" x-source="מְזִמּוֹתָֽי" x-translit="məzimmôṯāy" srcloc="WLC.PSA.10.4.011" x-head="true" lemma="מְזִמָּה" strong="H4209">thoughts</char> <char style="w" x-id="t018" x-align="PSA.10.4.a010">are</char>, <char style="w" x-id="t019" x-align="PSA.10.4.a010">There</char> <char style="w" x-id="t020" x-align="PSA.10.4.a010">is</char> <char style="w" x-id="t021" x-align="PSA.10.4.a010" x-src="WLC.PSA.10.4.008" x-source="אֵ֥ין" x-translit="ʾēyn" srcloc="WLC.PSA.10.4.008" x-head="true" lemma="אַיִן" strong="H369">no</char> <char style="w" x-id="t022" x-align="PSA.10.4.a011" x-src="WLC.PSA.10.4.009" x-source="אֱ֝לֹהִ֗ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.10.4.009" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>.<verse eid="PSA 10:4" /></para>
