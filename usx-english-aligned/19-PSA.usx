	<chapter eid="PSA 31" />
	<chapter number="32" style="c" sid="PSA 32" />
	<para style="s1"><verse number="1" style="v" sid="PSA 32:1" />Blessedness of forgiveness and of trust in God.</para>
	<para style="d"><char style="add"><char style="w" x-id="t001" x-align="PSA.32.1.a001" x-status="added">A</char> <char style="w" x-id="t002" x-align="PSA.32.1.a001" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t003" x-align="PSA.32.1.a002" x-src="WLC.PSA.32.1.001" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.32.1.001" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.32.1.a003" x-src="WLC.PSA.32.1.002" x-source="דָוִ֗ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.32.1.002" x-head="true" lemma="דָּוִד" strong="H1732">David</char>. <char style="w" x-id="t005" x-align="PSA.32.1.a004" x-src="WLC.PSA.32.1.003" x-source="מַ֫שְׂכִּ֥יל" x-translit="maśəkiyl" srcloc="WLC.PSA.32.1.003" x-head="true" lemma="מַשְׂכִּיל" strong="H4905">Maschil</char>.</para>
