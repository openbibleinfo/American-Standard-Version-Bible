	<para style="q1"><char style="w" x-id="t017" x-align="PSA.65.10.a013">Thou</char> <char style="w" x-id="t018" x-align="PSA.65.10.a013" x-src="WLC.PSA.65.10.013" x-source="תְּבָרֵֽךְ" x-translit="təḇārēḵ:" srcloc="WLC.PSA.65.10.013" x-head="true" lemma="בָּרַךְ" strong="H1288">blessest</char> <char style="w" x-id="t019" x-align="PSA.65.10.a011">the</char> <char style="w" x-id="t020" x-align="PSA.65.10.a011" x-src="WLC.PSA.65.10.011" x-source="צִמְחָ֥" x-translit="ṣimḥ" srcloc="WLC.PSA.65.10.011" x-head="true" lemma="צֶמַח" strong="H6780">springing</char> <char style="w" x-id="t021" x-align="PSA.65.10.a012" x-src="WLC.PSA.65.10.012" x-source="הּ" x-translit="āhh" srcloc="WLC.PSA.65.10.012" x-head="true" lemma="הוּא" strong="H1886d">thereof</char>.<verse eid="PSA 65:10" /></para>
	<para style="q1"><verse number="11" style="v" x-unrepresented-source="ן" x-unrepresented-translit="n" x-unrepresented-src="WLC.PSA.65.11.009" sid="PSA 65:11" /><char style="w" x-id="t001" x-align="PSA.65.11.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.65.11.a001" x-src="WLC.PSA.65.11.001" x-source="עִ֭טַּרְתָּ" x-translit="ʿiṭṭartā" srcloc="WLC.PSA.65.11.001" x-head="true" lemma="עָטַר" strong="H5849">crownest</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">the year of thy goodness</char>.</char></note><char style="w" x-id="t003" x-align="PSA.65.11.a002">the</char> <char style="w" x-id="t004" x-align="PSA.65.11.a002" x-src="WLC.PSA.65.11.002" x-source="שְׁנַ֣ת" x-translit="šənaṯ" srcloc="WLC.PSA.65.11.002" x-head="true" lemma="שָׁנָה" strong="H8141">year</char> <char style="w" x-id="t005" x-align="PSA.65.11.a003">with</char> <char style="w" x-id="t006" x-align="PSA.65.11.a004" x-src="WLC.PSA.65.11.004" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.65.11.004" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t007" x-align="PSA.65.11.a003" x-src="WLC.PSA.65.11.003" x-source="טוֹבָתֶ֑" x-translit="ṭôḇāṯ" srcloc="WLC.PSA.65.11.003" x-head="true" lemma="טוֹבָה" strong="H2896b">goodness</char>;</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.65.11.a005" x-src="WLC.PSA.65.11.005" x-source="וּ֝" x-translit="û" srcloc="WLC.PSA.65.11.005" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t009" x-align="PSA.65.11.a007" x-src="WLC.PSA.65.11.007" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.65.11.007" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t010" x-align="PSA.65.11.a006" x-src="WLC.PSA.65.11.006" x-source="מַעְגָּלֶ֗י" x-translit="maʿgāley" srcloc="WLC.PSA.65.11.006" x-head="true" lemma="מַעְגָּל" strong="H4570a">paths</char> <char style="w" x-id="t011" x-align="PSA.65.11.a008" x-src="WLC.PSA.65.11.008" x-source="יִרְעֲפ֥וּ" x-translit="yirʿăp̄û" srcloc="WLC.PSA.65.11.008" x-head="true" lemma="רָעַף" strong="H7491">drop</char> <char style="w" x-id="t012" x-align="PSA.65.11.a010" x-src="WLC.PSA.65.11.010" x-source="דָּֽשֶׁן" x-translit="dāšen:" srcloc="WLC.PSA.65.11.010" x-head="true" lemma="דֶּשֶׁן" strong="H1880">fatness</char>.<verse eid="PSA 65:11" /></para>
	<para style="q1"><verse number="12" style="v" sid="PSA 65:12" /><note caller="-" style="f"><char style="ft">Or, <char style="it">The pastures . . . do drop</char></char></note><char style="w" x-id="t001" x-align="PSA.65.12.a001">They</char> <char style="w" x-id="t002" x-align="PSA.65.12.a001" x-src="WLC.PSA.65.12.001" x-source="יִ֭רְעֲפוּ" x-translit="yirʿăp̄û" srcloc="WLC.PSA.65.12.001" x-head="true" lemma="רָעַף" strong="H7491">drop</char> <char style="w" x-id="t003" x-align="PSA.65.12.a002">upon</char> <char style="w" x-id="t004" x-align="PSA.65.12.a002">the</char> <char style="w" x-id="t005" x-align="PSA.65.12.a002" x-src="WLC.PSA.65.12.002" x-source="נְא֣וֹת" x-translit="nəʾôṯ" srcloc="WLC.PSA.65.12.002" x-head="true" lemma="נָוָה" strong="H4999">pastures</char> <char style="w" x-id="t006" x-align="PSA.65.12.a003">of</char> <char style="w" x-id="t007" x-align="PSA.65.12.a003">the</char> <char style="w" x-id="t008" x-align="PSA.65.12.a003" x-src="WLC.PSA.65.12.003" x-source="מִדְבָּ֑ר" x-translit="miḏbār" srcloc="WLC.PSA.65.12.003" x-head="true" lemma="מִדְבָּר" strong="H4057">wilderness</char>;</para>
