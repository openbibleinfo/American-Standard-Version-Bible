	<para style="q1"><verse number="3" style="v" sid="PSA 96:3" /><char style="w" x-id="t001" x-align="PSA.96.3.a001" x-src="WLC.PSA.96.3.001" x-source="סַפְּר֣וּ" x-translit="sappərû" srcloc="WLC.PSA.96.3.001" x-head="true" lemma="סָפַר" strong="H5608">Declare</char> <char style="w" x-id="t002" x-align="PSA.96.3.a006" x-src="WLC.PSA.96.3.006" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.96.3.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t003" x-align="PSA.96.3.a005" x-src="WLC.PSA.96.3.005" x-source="כְּבוֹד֑" x-translit="kəḇôḏ" srcloc="WLC.PSA.96.3.005" x-head="true" lemma="כָּבוֹד" strong="H3519">glory</char> <char style="w" x-id="t004" x-align="PSA.96.3.a002" x-src="WLC.PSA.96.3.002" x-source="בַ" x-translit="ḇa" srcloc="WLC.PSA.96.3.002" x-head="true" lemma="בְּ" strong="H871a">among</char> <char style="w" x-id="t005" x-align="PSA.96.3.a003" x-src="WLC.PSA.96.3.003" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.96.3.003" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t006" x-align="PSA.96.3.a004" x-src="WLC.PSA.96.3.004" x-source="גּוֹיִ֣ם" x-translit="gôyim" srcloc="WLC.PSA.96.3.004" x-head="true" lemma="גּוֹי" strong="H1471">nations</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.96.3.a012" x-src="WLC.PSA.96.3.012" x-source="ו" x-translit="w" srcloc="WLC.PSA.96.3.012" x-head="true" lemma="הוּא" strong="H2050c">His</char> <char style="w" x-id="t008" x-align="PSA.96.3.a011" x-src="WLC.PSA.96.3.011" x-source="נִפְלְאוֹתָֽי" x-translit="nip̄ləʾôṯāy" srcloc="WLC.PSA.96.3.011" x-head="true" lemma="פָּלָא" strong="H6381">marvellous</char> <char style="w" x-id="t009" x-align="PSA.96.3.a011">works</char> <char style="w" x-id="t010" x-align="PSA.96.3.a007" x-src="WLC.PSA.96.3.007" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.96.3.007" x-head="true" lemma="בְּ" strong="H871a">among</char> <char style="w" x-id="t011" x-align="PSA.96.3.a008" x-src="WLC.PSA.96.3.008" x-source="כָל" x-translit="ḵol-" srcloc="WLC.PSA.96.3.008" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t012" x-align="PSA.96.3.a009" x-src="WLC.PSA.96.3.009" x-source="הָֽ֝" x-translit="hā" srcloc="WLC.PSA.96.3.009" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t013" x-align="PSA.96.3.a010" x-src="WLC.PSA.96.3.010" x-source="עַמִּ֗ים" x-translit="ʿammiym" srcloc="WLC.PSA.96.3.010" x-head="true" lemma="עַם" strong="H5971">peoples</char>.<verse eid="PSA 96:3" /></para>
