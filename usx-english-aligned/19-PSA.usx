	<para style="q1"><verse number="3" style="v" sid="PSA 1:3" /><char style="w" x-id="t001" x-align="PSA.1.3.a001" x-src="WLC.PSA.1.3.001" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.1.3.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="PSA.1.3.a002">he</char> <char style="w" x-id="t003" x-align="PSA.1.3.a002">shall</char> <char style="w" x-id="t004" x-align="PSA.1.3.a002" x-src="WLC.PSA.1.3.002" x-source="הָיָ֗ה" x-translit="hāyāh" srcloc="WLC.PSA.1.3.002" x-head="true" lemma="הָיָה" strong="H1961">be</char> <char style="w" x-id="t005" x-align="PSA.1.3.a003" x-src="WLC.PSA.1.3.003" x-source="כְּ" x-translit="kə" srcloc="WLC.PSA.1.3.003" x-head="true" lemma="כְּ" strong="H3509a">like</char> <char style="w" x-id="t006" x-align="PSA.1.3.a004">a</char> <char style="w" x-id="t007" x-align="PSA.1.3.a004" x-src="WLC.PSA.1.3.004" x-source="עֵץ֮" x-translit="ʿēṣ" srcloc="WLC.PSA.1.3.004" x-head="true" lemma="עֵץ" strong="H6086">tree</char> <char style="w" x-id="t008" x-align="PSA.1.3.a005" x-src="WLC.PSA.1.3.005" x-source="שָׁת֪וּל" x-translit="šāṯûl" srcloc="WLC.PSA.1.3.005" x-head="true" lemma="שָׁתַל" strong="H8362">planted</char> <char style="w" x-id="t009" x-align="PSA.1.3.a006" x-src="WLC.PSA.1.3.006" x-source="עַֽל" x-translit="ʿal-" srcloc="WLC.PSA.1.3.006" x-head="true" lemma="עַל" strong="H5921">by</char> <char style="w" x-id="t010" x-align="PSA.1.3.a007">the</char> <char style="w" x-id="t011" x-align="PSA.1.3.a007" x-src="WLC.PSA.1.3.007" x-source="פַּלְגֵ֫י" x-translit="palḡēy" srcloc="WLC.PSA.1.3.007" x-head="true" lemma="פֶּלֶג" strong="H6388">streams</char> <char style="w" x-id="t012" x-align="PSA.1.3.a008">of</char> <char style="w" x-id="t013" x-align="PSA.1.3.a008" x-src="WLC.PSA.1.3.008" x-source="מָ֥יִם" x-translit="māyim" srcloc="WLC.PSA.1.3.008" x-head="true" lemma="מַיִם" strong="H4325">water</char>,</para>
	<para style="q1"><char style="w" x-id="t014" x-align="PSA.1.3.a009" x-src="WLC.PSA.1.3.009" x-source="אֲשֶׁ֤ר" x-translit="ʾăšer" srcloc="WLC.PSA.1.3.009" x-head="true" lemma="אֲשֶׁר" strong="H834">That</char> <char style="w" x-id="t015" x-align="PSA.1.3.a012" x-src="WLC.PSA.1.3.012" x-source="יִתֵּ֬ן" x-translit="yittēn" srcloc="WLC.PSA.1.3.012" x-head="true" lemma="נָתַן" strong="H5414">bringeth</char> <char style="w" x-id="t016" x-align="PSA.1.3.a012">forth</char> <char style="w" x-id="t017" x-align="PSA.1.3.a011" x-src="WLC.PSA.1.3.011" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.1.3.011" x-head="true" lemma="הוּא" strong="H2050c">its</char> <char style="w" x-id="t018" x-align="PSA.1.3.a010" x-src="WLC.PSA.1.3.010" x-source="פִּרְי֨" x-translit="piry" srcloc="WLC.PSA.1.3.010" x-head="true" lemma="פְּרִי" strong="H6529">fruit</char> <char style="w" x-id="t019" x-align="PSA.1.3.a013" x-src="WLC.PSA.1.3.013" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.1.3.013" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t020" x-align="PSA.1.3.a015" x-src="WLC.PSA.1.3.015" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.1.3.015" x-head="true" lemma="הוּא" strong="H2050c">its</char> <char style="w" x-id="t021" x-align="PSA.1.3.a014" x-src="WLC.PSA.1.3.014" x-source="עִתּ֗" x-translit="ʿitt" srcloc="WLC.PSA.1.3.014" x-head="true" lemma="עֵת" strong="H6256">season</char>,</para>
	<para style="q1"><char style="w" x-id="t022" x-align="PSA.1.3.a018" x-src="WLC.PSA.1.3.018" x-source="הוּ" x-translit="ēhû" srcloc="WLC.PSA.1.3.018" x-head="true" lemma="הוּא" strong="H1930a">Whose</char> <char style="w" x-id="t023" x-align="PSA.1.3.a017" x-src="WLC.PSA.1.3.017" x-source="עָלֵ֥" x-translit="ʿāl" srcloc="WLC.PSA.1.3.017" x-head="true" lemma="עָלֶה" strong="H5929">leaf</char> <char style="w" x-id="t024" x-align="PSA.1.3.a016" x-src="WLC.PSA.1.3.016" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.1.3.016" x-head="true" lemma="וְ" strong="H2050b">also</char> <char style="w" x-id="t025" x-align="PSA.1.3.a020">doth</char> <char style="w" x-id="t026" x-align="PSA.1.3.a019" x-src="WLC.PSA.1.3.019" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.PSA.1.3.019" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t027" x-align="PSA.1.3.a020" x-src="WLC.PSA.1.3.020" x-source="יִבּ֑וֹל" x-translit="yibôl" srcloc="WLC.PSA.1.3.020" x-head="true" lemma="נָבֵל" strong="H5034">wither</char>;</para>
	<para style="q1"><char style="w" x-id="t028" x-align="PSA.1.3.a021" x-src="WLC.PSA.1.3.021" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.1.3.021" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">in whatsoever he doeth he shall prosper</char></char></note><char style="w" x-id="t029" x-align="PSA.1.3.a022" x-src="WLC.PSA.1.3.022 WLC.PSA.1.3.023" x-source="כֹ֖ל אֲשֶׁר" x-translit="ḵōl ʾăšer-" srcloc="WLC.PSA.1.3.022" x-head="true" lemma="כֹּל" strong="H3605">whatsoever</char> <char style="w" x-id="t030" x-align="PSA.1.3.a023">he</char> <char style="w" x-id="t031" x-align="PSA.1.3.a023" x-src="WLC.PSA.1.3.024" x-source="יַעֲשֶׂ֣ה" x-translit="yaʿăśeh" srcloc="WLC.PSA.1.3.024" x-head="true" lemma="עָשָׂה" strong="H6213">doeth</char> <char style="w" x-id="t032" x-align="PSA.1.3.a024">shall</char> <char style="w" x-id="t033" x-align="PSA.1.3.a024" x-src="WLC.PSA.1.3.025" x-source="יַצְלִֽיחַ" x-translit="yaṣliyᵃḥ:" srcloc="WLC.PSA.1.3.025" x-head="true" lemma="צָלֵחַ" strong="H6743">prosper</char>.<verse eid="PSA 1:3" /></para>
	<para style="q1"><verse number="4" style="v" x-unrepresented-source="נּוּ" x-unrepresented-translit="ennû" x-unrepresented-src="WLC.PSA.1.4.012" sid="PSA 1:4" /><char style="w" x-id="t001" x-align="PSA.1.4.a003" x-src="WLC.PSA.1.4.003" x-source="הָ" x-translit="hā" srcloc="WLC.PSA.1.4.003" x-head="true" lemma="הַ" strong="H1886a">The</char> <char style="w" x-id="t002" x-align="PSA.1.4.a004" x-src="WLC.PSA.1.4.004" x-source="רְשָׁעִ֑ים" x-translit="rəšāʿiym" srcloc="WLC.PSA.1.4.004" x-head="true" lemma="רָשָׁע" strong="H7563">wicked</char> <char style="w" x-id="t003" x-align="PSA.1.4.a002">are</char> <char style="w" x-id="t004" x-align="PSA.1.4.a001" x-src="WLC.PSA.1.4.001" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.PSA.1.4.001" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t005" x-align="PSA.1.4.a002" x-src="WLC.PSA.1.4.002" x-source="כֵ֥ן" x-translit="ḵēn" srcloc="WLC.PSA.1.4.002" x-head="true" lemma="כֵּן" strong="H3651">so</char>,</para>
	<para style="q1"><char style="w" x-id="t006" x-align="PSA.1.4.a005" x-src="WLC.PSA.1.4.005 WLC.PSA.1.4.006" x-source="כִּ֥י אִם" x-translit="kiy ʾim-" srcloc="WLC.PSA.1.4.005" x-head="true" lemma="כִּי" strong="H3588">But</char> <char style="w" x-id="t007" x-align="PSA.1.4.a006">are</char> <char style="w" x-id="t008" x-align="PSA.1.4.a006" x-src="WLC.PSA.1.4.007" x-source="כַּ֝" x-translit="ka" srcloc="WLC.PSA.1.4.007" x-head="true" lemma="כְּ" strong="H3509a">like</char> <char style="w" x-id="t009" x-align="PSA.1.4.a007" x-src="WLC.PSA.1.4.008" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.1.4.008" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t010" x-align="PSA.1.4.a008" x-src="WLC.PSA.1.4.009" x-source="מֹּ֗ץ" x-translit="mmōṣ" srcloc="WLC.PSA.1.4.009" x-head="true" lemma="מֹץ" strong="H4671">chaff</char> <char style="w" x-id="t011" x-align="PSA.1.4.a009" x-src="WLC.PSA.1.4.010" x-source="אֲֽשֶׁר" x-translit="ʾăšer-" srcloc="WLC.PSA.1.4.010" x-head="true" lemma="אֲשֶׁר" strong="H834">which</char> <char style="w" x-id="t012" x-align="PSA.1.4.a012">the</char> <char style="w" x-id="t013" x-align="PSA.1.4.a012" x-src="WLC.PSA.1.4.013" x-source="רֽוּחַ" x-translit="rûᵃḥ:" srcloc="WLC.PSA.1.4.013" x-head="true" lemma="רוּחַ" strong="H7307">wind</char> <char style="w" x-id="t014" x-align="PSA.1.4.a010" x-src="WLC.PSA.1.4.011" x-source="תִּדְּפֶ֥" x-translit="tiddəp̄" srcloc="WLC.PSA.1.4.011" x-head="true" lemma="נָדַף" strong="H5086">driveth</char> <char style="w" x-id="t015" x-align="PSA.1.4.a010">away</char>.<verse eid="PSA 1:4" /></para>
