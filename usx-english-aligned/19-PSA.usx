	<para style="q1"><char style="w" x-id="t017" x-align="PSA.68.18.a012" x-src="WLC.PSA.68.18.012" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.68.18.012" x-head="true" lemma="וְ" strong="H2050b">Yea</char>, <char style="add"><char style="w" x-id="t018" x-align="PSA.68.18.a009">among</char></char> <char style="w" x-id="t019" x-align="PSA.68.18.a014">the</char> <char style="w" x-id="t020" x-align="PSA.68.18.a014" x-src="WLC.PSA.68.18.014" x-source="ס֝וֹרְרִ֗ים" x-translit="sôrəriym" srcloc="WLC.PSA.68.18.014" x-head="true" lemma="סָרַר" strong="H5637">rebellious</char> <char style="w" x-id="t021" x-align="PSA.68.18.a013" x-src="WLC.PSA.68.18.013" x-source="אַ֥ף" x-translit="ʾap̄" srcloc="WLC.PSA.68.18.013" x-head="true" lemma="אַף" strong="H637">also</char>, <char style="w" x-id="t022" x-align="PSA.68.18.a015" x-src="WLC.PSA.68.18.015" x-source="לִ" x-translit="li" srcloc="WLC.PSA.68.18.015" x-head="true" lemma="לְ" strong="H3807a">that</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">Jah</char>.</char></note><char style="w" x-id="t023" x-align="PSA.68.18.a017" x-src="WLC.PSA.68.18.017" x-source="יָ֬הּ" x-translit="yāẖ" srcloc="WLC.PSA.68.18.017" x-head="true" lemma="יָהּ" strong="H3050">Jehovah</char> <char style="w" x-id="t024" x-align="PSA.68.18.a018" x-src="WLC.PSA.68.18.018" x-source="אֱלֹהִֽים" x-translit="ʾĕlōhiym:" srcloc="WLC.PSA.68.18.018" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t025" x-align="PSA.68.18.a016">might</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">dwell</char> there</char></note><char style="w" x-id="t026" x-align="PSA.68.18.a016" x-src="WLC.PSA.68.18.016" x-source="שְׁכֹּ֤ן" x-translit="šəkōn" srcloc="WLC.PSA.68.18.016" x-head="true" lemma="שָׁכַן" strong="H7931">dwell</char> <char style="add"><char style="w" x-id="t027" x-align="PSA.68.18.a019" x-status="added" x-source="∅" x-head="true">with</char> <char style="w" x-id="t028" x-align="PSA.68.18.a019" x-