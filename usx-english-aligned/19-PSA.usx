	<para style="s1"><verse number="1" style="v" sid="PSA 45:1" />A song celebrating the king’s marriage.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.45.0.a001" x-src="WLC.PSA.45.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.45.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.45.0.a002" x-src="WLC.PSA.45.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.45.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.45.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.45.0.a003" x-src="WLC.PSA.45.0.003" x-source="מְנַצֵּ֣חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.45.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="w" x-id="t005" x-align="PSA.45.0.a004">set</char> <char style="w" x-id="t006" x-align="PSA.45.0.a004" x-src="WLC.PSA.45.0.004" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.45.0.004" x-head="true" lemma="עַל" strong="H5921">to</char> <note caller="-" style="f"><char style="ft">That is, <char style="it">Lilies</char>.</char></note><char style="w" x-id="t007" x-align="PSA.45.0.a005" x-src="WLC.PSA.45.0.005" x-source="שֹׁ֭שַׁנִּים" x-translit="šōšannîm" srcloc="WLC.PSA.45.0.005" x-head="true" lemma="שׁוּשַׁן" strong="H7799">Shoshannim</char>. <char style="add"><char style="w" x-id="t008" x-align="PSA.45.0.a006" x-status="added">A</char> <char style="w" x-id="t009" x-align="PSA.45.0.a006" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t010" x-align="PSA.45.0.a007" x-src="WLC.PSA.45.0.006" x-source="לִ" x-translit="li" srcloc="WLC.PSA.45.0.006" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t011" x-align="PSA.45.0.a008">the</char> <char style="w" x-id="t012" x-align="PSA.45.0.a008" x-src="WLC.PSA.45.0.007" x-source="בְנֵי" x-translit="ḇənê-" srcloc="WLC.PSA.45.0.007" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t013" x-align="PSA.45.0.a009">of</char> <char style="w" x-id="t014" x-align="PSA.45.0.a009" x-src="W