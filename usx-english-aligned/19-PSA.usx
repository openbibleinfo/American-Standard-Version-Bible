	<para style="q1"><verse number="4" style="v" sid="PSA 65:4" /><char style="w" x-id="t001" x-align="PSA.65.4.a001" x-src="WLC.PSA.65.4.001" x-source="אַשְׁרֵ֤י" x-translit="ʾašrēy" srcloc="WLC.PSA.65.4.001" x-head="true" lemma="אֶשֶׁר" strong="H835a">Blessed</char> <char style="w" x-id="t002" x-align="PSA.65.4.a001">is</char> <char style="w" x-id="t003" x-align="PSA.65.4.a002">the</char> <char style="w" x-id="t004" x-align="PSA.65.4.a002">man</char> <char style="w" x-id="t005" x-align="PSA.65.4.a002">whom</char> <char style="w" x-id="t006" x-align="PSA.65.4.a002">thou</char> <char style="w" x-id="t007" x-align="PSA.65.4.a002" x-src="WLC.PSA.65.4.002" x-source="תִּֽבְחַ֣ר" x-translit="tiḇəḥar" srcloc="WLC.PSA.65.4.002" x-head="true" lemma="בָּחַר" strong="H977">choosest</char>, <char style="w" x-id="t008" x-align="PSA.65.4.a003" x-src="WLC.PSA.65.4.003" x-source="וּ" x-translit="û" srcloc="WLC.PSA.65.4.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="PSA.65.4.a004">causest</char> <char style="w" x-id="t010" x-align="PSA.65.4.a004">to</char> <char style="w" x-id="t011" x-align="PSA.65.4.a004" x-src="WLC.PSA.65.4.004" x-source="תְקָרֵב֮" x-translit="ṯəqārēḇ" srcloc="WLC.PSA.65.4.004" x-head="true" lemma="קָרַב" strong="H7126">approach</char> <char style="add"><char style="w" x-id="t012" x-align="PSA.65.4.a005" x-status="added">unto</char> <char style="w" x-id="t013" x-align="PSA.65.4.a005" x-status="added" x-source="∅" x-head="true">thee</char></char>,</para>
