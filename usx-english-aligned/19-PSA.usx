	<para style="s1"><verse number="1" style="v" x-unrepresented-source="ן" x-unrepresented-translit="n" x-unrepresented-src="WLC.PSA.58.1.006" sid="PSA 58:1" />Prayer for the punishment of the wicked.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.58.0.a001" x-src="WLC.PSA.58.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.58.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.58.0.a002" x-src="WLC.PSA.58.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.58.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.58.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.58.0.a003" x-src="WLC.PSA.58.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.58.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="add"><char style="w" x-id="t005" x-align="PSA.58.0.a004" x-status="added" x-source="∅" x-head="true">set</char> <char style="w" x-id="t006" x-align="PSA.58.0.a004" x-status="added">to</char></char> <char style="w" x-id="t007" x-align="PSA.58.0.a005" x-src="WLC.PSA.58.0.004" x-source="אַל" x-translit="ʾal-" srcloc="WLC.PSA.58.0.004" x-head="true" lemma="אַל" strong="H408">Al</char>-<char style="w" x-id="t008" x-align="PSA.58.0.a006" x-src="WLC.PSA.58.0.005" x-source="תַּשְׁחֵ֗ת" x-translit="tašḥēṯ" srcloc="WLC.PSA.58.0.005" x-head="true" lemma="שׁחת" strong="H7843">tashheth</char>. <char style="add"><char style="w" x-id="t009" x-align="PSA.58.0.a007" x-status="added">A</char> <char style="w" x-id="t010" x-align="PSA.58.0.a007" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t011" x-align="PSA.58.0.a008" x-src="WLC.PSA.58.0.006" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.58.0.006" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t012" x-align="PSA.58.0.a009" x-src="WLC.PSA.58.0.007" x-source="דָוִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.58.0.007" x-head="true" lemma="דָּוִד" strong="H1732">David</char>. <char style="w" x-id="t013" x-align="PSA.58.0.a010" x-src="WLC.PSA.58.0.008" x-source="מִכְתָּֽם" x-translit="miḵtām:" srcloc="WLC.PSA.58.0.0