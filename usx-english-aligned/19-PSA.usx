	<para style="q1"><verse number="29" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.PSA.109.29.008" sid="PSA 109:29" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Mine adversaries shall be clothed . . . And they shall cover etc.</char></char></note><char style="w" x-id="t001" x-align="PSA.109.29.a001">Let</char> <char style="w" x-id="t002" x-align="PSA.109.29.a003" x-src="WLC.PSA.109.29.003" x-source="י" x-translit="ay" srcloc="WLC.PSA.109.29.003" x-head="true" lemma="הוּא" strong="H2967a">mine</char> <char style="w" x-id="t003" x-align="PSA.109.29.a002" x-src="WLC.PSA.109.29.002" x-source="שׂוֹטְנַ֣" x-translit="śôṭən" srcloc="WLC.PSA.109.29.002" x-head="true" lemma="שָׂטַן" strong="H7853">adversaries</char> <char style="w" x-id="t004" x-align="PSA.109.29.a001">be</char> <char style="w" x-id="t005" x-align="PSA.109.29.a001" x-src="WLC.PSA.109.29.001" x-source="יִלְבְּשׁ֣וּ" x-translit="yilbəšû" srcloc="WLC.PSA.109.29.001" x-head="true" lemma="לָבֵשׁ" strong="H3847">clothed</char> <char style="w" x-id="t006" x-align="PSA.109.29.a001">with</char> <char style="w" x-id="t007" x-align="PSA.109.29.a004" x-src="WLC.PSA.109.29.004" x-source="כְּלִמָּ֑ה" x-translit="kəlimmāh" srcloc="WLC.PSA.109.29.004" x-head="true" lemma="כְּלִמָּה" strong="H3639">dishonor</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.109.29.a005" x-src="WLC.PSA.109.29.005" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.109.29.005" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t009" x-align="PSA.109.29.a006">let</char> <char style="w" x-id="t010" x-align="PSA.109.29.a006">them</char> <char style="w" x-id="t011" x-align="PSA.109.29.a006" x-src="WLC.PSA.109.29.006" x-source="יַעֲט֖וּ" x-translit="yaʿăṭû" srcloc="WLC.PSA.109.29.006" x-head="true" lemma="עָטָה" strong="H5844">cover</char> <char style="w" x-id="t012" x-align="PSA.109.29.a006">themselves</char> <char style="w" x-id="t013" x-align="PSA.109.29.a006">with</char> <char style="w" x-id="t014" x-align="PSA.109.29.a011" x-src="WLC.PSA.109.29.011" x-source="ם" x-translit="ām" srcloc="WLC.PSA.109.29.011" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t015" x-align="PSA.109.29.a011">own</char> <char style="w" x-id="t016" x-align="PSA.109.29.a010" x-src="WLC.PSA.109.29.010" x-source="בָּשְׁתָּֽ" x-translit="bāšətt" srcloc="WLC.PSA.109.29.010" x-head="true" lemma="בֹּשֶׁת" strong="H1322">shame</char> <char style="w" x-id="t017" x-align="PSA.109.29.a007" x-src="WLC.PSA.109.29.007" x-source="כַ" x-translit="ḵa" srcloc="WLC.PSA.109.29.007" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t018" x-align="PSA.109.29.a006">with</char> <char style="w" x-id="t019" x-align="PSA.109.29.a009">a</char> <char style="w" x-id="t020" x-align="PSA.109.29.a009" x-src="WLC.PSA.109.29.009" x-source="מְעִ֣יל" x-translit="məʿiyl" srcloc="WLC.PSA.109.29.009" x-head="true" lemma="מְעִיל" strong="H4598">robe</char>.<verse eid="PSA 109:29" /></para>
