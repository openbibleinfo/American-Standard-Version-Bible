	<para style="s1"><verse number="1" style="v" x-unrepresented-source="הַֽ" x-unrepresented-translit="ha" x-unrepresented-src="WLC.PSA.129.1.002" sid="PSA 129:1" />Prayer for the overthrow of Zion’s enemies.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.129.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.129.1.a001" x-src="WLC.PSA.129.1.001" x-source="שִׁ֗יר" x-translit="šiyr" srcloc="WLC.PSA.129.1.001" x-head="true" lemma="שִׁיר" strong="H7892">Song</char> <char style="w" x-id="t003" x-align="PSA.129.1.a003">of</char> <char style="w" x-id="t004" x-align="PSA.129.1.a003" x-src="WLC.PSA.129.1.003" x-source="מַּ֫עֲל֥וֹת" x-translit="mmaʿălôṯ" srcloc="WLC.PSA.129.1.003" x-head="true" lemma="מַעֲלָה" strong="H4609">Ascents</char>.</para>
