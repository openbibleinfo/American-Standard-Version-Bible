	<chapter eid="PSA 10" />
	<chapter number="11" style="c" sid="PSA 11" />
	<para style="s1"><verse number="1" style="v" sid="PSA 11:1" />Jehovah a refuge and defence.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.11.1.a001" x-src="WLC.PSA.11.1.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.11.1.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.11.1.a002" x-src="WLC.PSA.11.1.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.11.1.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.11.1.a003" x-src="WLC.PSA.11.1.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.11.1.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.11.1.a003">Musician</char>. <char style="add"><char style="w" x-id="t005" x-align="PSA.11.1.a004" x-status="added">A</char> <char style="w" x-id="t006" x-align="PSA.11.1.a004" x-status="added" x-source="∅" x-head="true">Psalm</char></char> <char style="w" x-id="t007" x-align="PSA.11.1.a005" x-src="WLC.PSA.11.1.004" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.11.1.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.11.1.a006" x-src="WLC.PSA.11.1.005" x-source="דָ֫וִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.11.1.005" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
