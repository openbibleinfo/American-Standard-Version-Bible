	<para style="d"><char style="w" x-id="t001" x-align="PSA.68.0.a001" x-src="WLC.PSA.68.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.68.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.68.0.a002" x-src="WLC.PSA.68.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.68.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.68.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.68.0.a003" x-src="WLC.PSA.68.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.68.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="w" x-id="t005" x-align="PSA.68.0.a006">A</char> <char style="w" x-id="t006" x-align="PSA.68.0.a006" x-src="WLC.PSA.68.0.006" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.68.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t007" x-align="PSA.68.0.a004" x-src="WLC.PSA.68.0.004" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.68.0.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.68.0.a005" x-src="WLC.PSA.68.0.005" x-source="דָוִ֗ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.68.0.005" x-head="true" lemma="דָּוִד" strong="H1732">David</char>, <char style="w" x-id="t009" x-align="PSA.68.0.a007">a</char> <char style="w" x-id="t010" x-align="PSA.68.0.a007" x-src="WLC.PSA.68.0.007" x-source="שִֽׁיר" x-translit="šiyr:" srcloc="WLC.PSA.68.0.007" x-head="true" lemma="שִׁיר" strong="H7892">Song</char>.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">God ariseth</char>; and so throughout verses <ref loc="PSA 68:1">1</ref>, <ref loc="PSA 68:2">2</ref>, <ref loc="PSA 68:3">3</ref></char></note><char style="w" x-id="t001" x-align="PSA.68.1.a001">Let</char> <char style="w" x-id="t002" x-align="PSA.68.1.a002" x-src="WLC.PSA.68.1.002" x-source="אֱ֭לֹהִים" x-translit="ʾĕlōhîm" srcloc="WLC.PSA.68.1.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t003" x-align="PSA.68.1.a001" x-src="WLC.PSA.68.1.001" x-source="יָק֣וּם" x-translit="yāqûm" srcloc="WLC.PSA.68.1.001" x-head="true" lemma="קוּם" strong="H6965">arise</char>, <char style="w" x-id="t004" x-align="PSA.68.1.a003">let</char> <char style="w" x-id="t005" x-align="PSA.68.1.a005" x-src="WLC.PSA.68.1.005" x-source="ו" x-translit="w" srcloc="WLC.PSA.68.1.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t006" x-align="PSA.68.1.a004" x-src="WLC.PSA.68.1.004" x-source="אוֹיְבָ֑י" x-translit="ʾôyəḇāy" srcloc="WLC.PSA.68.1.004" x-head="true" lemma="אָיַב" strong="H341">enemies</char> <char style="w" x-id="t007" x-align="PSA.68.1.a003">be</char> <char style="w" x-id="t008" x-align="PSA.68.1.a003" x-src="WLC.PSA.68.1.003" x-source="יָפ֣וּצוּ" x-translit="yāp̄ûṣû" srcloc="WLC.PSA.68.1.003" x-head="true" lemma="פּוּץ" strong="H6327">scattered</char>;</para>
