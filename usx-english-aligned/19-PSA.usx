	<para style="q1"><char style="w" x-id="t006" x-align="PSA.89.52.a005" x-src="WLC.PSA.89.52.005" x-source="אָ֘מֵ֥ן" x-translit="ʾāmēn" srcloc="WLC.PSA.89.52.005" x-head="true" lemma="אָמֵן" strong="H543">Amen</char>, <char style="w" x-id="t007" x-align="PSA.89.52.a006" x-src="WLC.PSA.89.52.006" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.89.52.006" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t008" x-align="PSA.89.52.a007" x-src="WLC.PSA.89.52.007" x-source="אָמֵֽן" x-translit="ʾāmēn:" srcloc="WLC.PSA.89.52.007" x-head="true" lemma="אָמֵן" strong="H543">Amen</char>.<verse eid="PSA 89:52" /></para>
