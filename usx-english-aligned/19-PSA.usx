	<para style="q1"><char style="w" x-id="t001" x-align="PSA.68.28.a003" x-src="WLC.PSA.68.28.003" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.68.28.003" x-head="true" lemma="הוּא" strong="H3509b">Thy</char> <char style="w" x-id="t002" x-align="PSA.68.28.a002" x-src="WLC.PSA.68.28.002" x-source="אֱלֹהֶ֗י" x-translit="ʾĕlōhey" srcloc="WLC.PSA.68.28.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t003" x-align="PSA.68.28.a001">hath</char> <char style="w" x-id="t004" x-align="PSA.68.28.a001" x-src="WLC.PSA.68.28.001" x-source="צִוָּ֥ה" x-translit="ṣiwwāh" srcloc="WLC.PSA.68.28.001" x-head="true" lemma="צָוָה" strong="H6680">commanded</char> <char style="w" x-id="t005" x-align="PSA.68.28.a005" x-src="WLC.PSA.68.28.005" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.68.28.005" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t006" x-align="PSA.68.28.a004" x-src="WLC.PSA.68.28.004" x-source="עֻ֫זֶּ֥" x-translit="ʿuzz" srcloc="WLC.PSA.68.28.004" x-head="true" lemma="עֹז" strong="H5797">strength</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Be strong, O God, thou that hast etc.</char></char></note><char style="w" x-id="t007" x-align="PSA.68.28.a006" x-src="WLC.PSA.68.28.006" x-source="עוּזָּ֥" x-translit="ʿûzz" srcloc="WLC.PSA.68.28.006" x-head="true" lemma="עָזַז" strong="H5810">Strengthen</char>, <char style="w" x-id="t008" x-align="PSA.68.28.a008">O</char> <char style="w" x-id="t009" x-align="PSA.68.28.a008" x-src="WLC.PSA.68.28.008" x-source="אֱלֹהִ֑ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.68.28.008" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t010" x-align="PSA.68.28.a009" x-src="WLC.PSA.68.28.009" x-source="ז֝֗וּ" x-translit="zû" srcloc="WLC.PSA.68.28.009" x-head="true" lemma="זוּ" strong="H2098">that</char> <char style="w" x-id="t011" x-align="PSA.68.28.a009">which</char> <char style="w" x-id="t012" x-align="PSA.68.28.a010">thou</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">hast wrought for us out of thy temple. Unto Jerusalem etc.</char></char></note><char style="w" x-id="t013" x-align="PSA.68.28.a010">hast</char> <char style="w" x-id="t014" x-align="PSA.68.28.a010" x-src="WLC.PSA.68.28.010" x-source="פָּעַ֥לְתָּ" x-translit="pāʿalətā" srcloc="WLC.PSA.68.28.010" x-head="true" lemma="פָּעַל" strong="H6466">wrought</char> <char style="w" x-id="t015" x-align="PSA.68.28.a011" x-src="WLC.PSA.68.28.011" x-source="לָּֽ" x-translit="ll" srcloc="WLC.PSA.68.28.011" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t016" x-align="PSA.68.28.a012" x-src="WLC.PSA.68.28.012" x-source="נוּ" x-translit="ānû" srcloc="WLC.PSA.68.28.012" x-head="true" lemma="הוּא" strong="H5105a">us</char>.<verse eid="PSA 68:28" /></para>
	<para style="q1"><verse number="29" style="v" sid="PSA 68:29" /><char style="w" x-id="t001" x-align="PSA.68.29.a001" x-src="WLC.PSA.68.29.001" x-source="מֵֽ֭" x-translit="mē" srcloc="WLC.PSA.68.29.001" x-head="true" lemma="מִן" strong="H4480">Because</char> <char style="w" x-id="t002" x-align="PSA.68.29.a001">of</char> <char style="w" x-id="t003" x-align="PSA.68.29.a003" x-src="WLC.PSA.68.29.003" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.68.29.003" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t004" x-align="PSA.68.29.a002" x-src="WLC.PSA.68.29.002" x-source="הֵיכָלֶ" x-translit="hēyḵāl" srcloc="WLC.PSA.68.29.002" x-head="true" lemma="הֵיכָל" strong="H1964">temple</char> <char style="w" x-id="t005" x-align="PSA.68.29.a004" x-src="WLC.PSA.68.29.004" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.68.29.004" x-head="true" lemma="עַל" strong="H5921">at</char> <char style="w" x-id="t006" x-align="PSA.68.29.a005" x-src="WLC.PSA.68.29.005" x-source="יְרוּשָׁלִָ֑ם" x-translit="yərûšālāim" srcloc="WLC.PSA.68.29.005" x-head="true" lemma="יְרוּשָׁלִַ͏ם" strong="H3389">Jerusalem</char></para>
	<para style="q1"><char style="w" x-id="t007" x-align="PSA.68.29.a009" x-src="WLC.PSA.68.29.009" x-source="מְלָכִ֣ים" x-translit="məlāḵiym" srcloc="WLC.PSA.68.29.009" x-head="true" lemma="מֶלֶךְ" strong="H4428">Kings</char> <char style="w" x-id="t008" x-align="PSA.68.29.a008">shall</char> <char style="w" x-id="t009" x-align="PSA.68.29.a008" x-src="WLC.PSA.68.29.008" x-source="יוֹבִ֖ילוּ" x-translit="yôḇiylû" srcloc="WLC.PSA.68.29.008" x-head="true" lemma="יָבַל" strong="H2986">bring</char> <char style="w" x-id="t010" x-align="PSA.68.29.a010" x-src="WLC.PSA.68.29.010" x-source="שָֽׁי" x-translit="šāy:" srcloc="WLC.PSA.68.29.010" x-head="true" lemma="שַׁי" strong="H7862">presents</char> <char style="w" x-id="t011" x-align="PSA.68.29.a006" x-src="WLC.PSA.68.29.006" x-source="לְ" x-translit="l" srcloc="WLC.PSA.68.29.006" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t012" x-align="PSA.68.29.a007" x-src="WLC.PSA.68.29.007" x-source="ךָ֤" x-translit="əḵā" srcloc="WLC.PSA.68.29.007" x-head="true" lemma="הוּא" strong="H3509b">thee</char>.<verse eid="PSA 68:29" /></para>
	<para style="q1"><verse number="30" style="v" x-unrepresented-source="בְּ" x-unrepresented-translit="bə" x-unrepresented-src="WLC.PSA.68.30.010" sid="PSA 68:30" /><char style="w" x-id="t001" x-align="PSA.68.30.a001" x-src="WLC.PSA.68.30.001" x-source="גְּעַ֨ר" x-translit="gəʿar" srcloc="WLC.PSA.68.30.001" x-head="true" lemma="גָּעַר" strong="H1605">Rebuke</char> <char style="w" x-id="t002" x-align="PSA.68.30.a002">the</char> <char style="w" x-id="t003" x-align="PSA.68.30.a002">wild</char> <char style="w" x-id="t004" x-align="PSA.68.30.a002" x-src="WLC.PSA.68.30.002" x-source="חַיַּ֪ת" x-translit="ḥayyaṯ" srcloc="WLC.PSA.68.30.002" x-head="true" lemma="חַיָּה" strong="H2416c">beast</char> <char style="w" x-id="t005" x-align="PSA.68.30.a003">of</char> <char style="w" x-id="t006" x-align="PSA.68.30.a003">the</char> <char style="w" x-id="t007" x-align="PSA.68.30.a003" x-src="WLC.PSA.68.30.003" x-source="קָנֶ֡ה" x-translit="qāneh" srcloc="WLC.PSA.68.30.003" x-head="true" lemma="קָנֶה" strong="H7070">reeds</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.68.30.a004">The</char> <char style="w" x-id="t009" x-align="PSA.68.30.a004" x-src="WLC.PSA.68.30.004" x-source="עֲדַ֤ת" x-translit="ʿăḏaṯ" srcloc="WLC.PSA.68.30.004" x-head="true" lemma="עֵדָה" strong="H5712">multitude</char> <char style="w" x-id="t010" x-align="PSA.68.30.a005">of</char> <char style="w" x-id="t011" x-align="PSA.68.30.a005">the</char> <char style="w" x-id="t012" x-align="PSA.68.30.a005" x-src="WLC.PSA.68.30.005" x-source="אַבִּירִ֨ים" x-translit="ʾabbîriym" srcloc="WLC.PSA.68.30.005" x-head="true" lemma="אַבִּיר" strong="H47">bulls</char>, <char style="w" x-id="t013" x-align="PSA.68.30.a006" x-src="WLC.PSA.68.30.006" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.68.30.006" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t014" x-align="PSA.68.30.a007">the</char> <char style="w" x-id="t015" x-align="PSA.68.30.a007" x-src="WLC.PSA.68.30.007" x-source="עֶגְלֵ֬י" x-translit="ʿeḡlēy" srcloc="WLC.PSA.68.30.007" x-head="true" lemma="עֵגֶל" strong="H5695">calves</char> <char style="w" x-id="t016" x-align="PSA.68.30.a008">of</char> <char style="w" x-id="t017" x-align="PSA.68.30.a008">the</char> <char style="w" x-id="t018" x-align="PSA.68.30.a008" x-src="WLC.PSA.68.30.008" x-source="עַמִּ֗ים" x-translit="ʿammiym" srcloc="WLC.PSA.68.30.008" x-head="true" lemma="עַם" strong="H5971">peoples</char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, Every one <char style="it">submitting himself with pieces of silver</char></char></note><char style="w" x-id="t019" x-align="PSA.68.30.a009" x-src="WLC.PSA.68.30.009" x-source="מִתְרַפֵּ֥ס" x-translit="miṯrappēs" srcloc="WLC.PSA.68.30.009" x-head="true" lemma="רָפַס" strong="H7515">Trampling</char> <char style="w" x-id="t020" x-align="PSA.68.30.a009">under</char> <char style="w" x-id="t021" x-align="PSA.68.30.a009">foot</char> <char style="w" x-id="t022" x-align="PSA.68.30.a011">the</char> <char style="w" x-id="t023" x-align="PSA.68.30.a011" x-src="WLC.PSA.68.30.011" x-source="רַצֵּי" x-translit="raṣṣê-" srcloc="WLC.PSA.68.30.011" x-head="true" lemma="רַץ" strong="H7518">pieces</char> <char style="w" x-id="t024" x-align="PSA.68.30.a012">of</char> <char style="w" x-id="t025" x-align="PSA.68.30.a012" x-src="WLC.PSA.68.30.012" x-source="כָ֑סֶף" x-translit="ḵāsep̄" srcloc="WLC.PSA.68.30.012" x-head="true" lemma="כֶּסֶף" strong="H3701">silver</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, as otherwise read, <char style="it">Scatter thou</char></char></note><char style="w" x-id="t026" x-align="PSA.68.30.a013">He</char> <char style="w" x-id="t027" x-align="PSA.68.30.a013">hath</char> <char style="w" x-id="t028" x-align="PSA.68.30.a013" x-src="WLC.PSA.68.30.013" x-source="בִּזַּ֥ר" x-translit="bizzar" srcloc="WLC.PSA.68.30.013" x-head="true" lemma="בָּזַר" strong="H967">scattered</char> <char style="w" x-id="t029" x-align="PSA.68.30.a014">the</char> <char style="w" x-id="t030" x-align="PSA.68.30.a014" x-src="WLC.PSA.68.30.014" x-source="עַ֝מִּ֗ים" x-translit="ʿammiym" srcloc="WLC.PSA.68.30.014" x-head="true" lemma="עַם" strong="H5971">peoples</char> <char style="w" x-id="t031" x-align="PSA.68.30.a015" x-status="added" x-source="∅" x-head="true">that</char> <char style="w" x-id="t032" x-align="PSA.68.30.a017" x-src="WLC.PSA.68.30.016" x-source="יֶחְפָּֽצוּ" x-translit="yeḥpāṣû:" srcloc="WLC.PSA.68.30.016" x-head="true" lemma="חָפֵץ" strong="H2654">delight</char> <char style="w" x-id="t033" x-align="PSA.68.30.a017">in</char> <char style="w" x-id="t034" x-align="PSA.68.30.a016" x-src="WLC.PSA.68.30.015" x-source="קְרָב֥וֹת" x-translit="qərāḇôṯ" srcloc="WLC.PSA.68.30.015" x-head="true" lemma="קְרָב" strong="H7128">war</char>.<verse eid="PSA 68:30" /></para>
	<para style="q1"><verse number="31" style="v" sid="PSA 68:31" /><char style="w" x-id="t001" x-align="PSA.68.31.a002" x-src="WLC.PSA.68.31.002" x-source="חַ֭שְׁמַנִּים" x-translit="ḥašmannîm" srcloc="WLC.PSA.68.31.002" x-head="true" lemma="חַשְׁמַנִּים" strong="H2831">Princes</char> <char style="w" x-id="t002" x-align="PSA.68.31.a001">shall</char> <char style="w" x-id="t003" x-align="PSA.68.31.a001" x-src="WLC.PSA.68.31.001" x-source="יֶאֱתָ֣יוּ" x-translit="yeʾĕṯāyû" srcloc="WLC.PSA.68.31.001" x-head="true" lemma="אָתָה" strong="H857">come</char> <char style="w" x-id="t004" x-align="PSA.68.31.a003" x-src="WLC.PSA.68.31.003" x-source="מִנִּ֣י" x-translit="minniy" srcloc="WLC.PSA.68.31.003" x-head="true" lemma="מִן" strong="H4480">out</char> <char style="w" x-id="t005" x-align="PSA.68.31.a003">of</char> <char style="w" x-id="t006" x-align="PSA.68.31.a004" x-src="WLC.PSA.68.31.004" x-source="מִצְרָ֑יִם" x-translit="miṣrāyim" srcloc="WLC.PSA.68.31.004" x-head="true" lemma="מִצְרַיִם" strong="H4714">Egypt</char>;</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Cush</char>.</char></note><char style="w" x-id="t007" x-align="PSA.68.31.a005" x-src="WLC.PSA.68.31.005" x-source="כּ֥וּשׁ" x-translit="kûš" srcloc="WLC.PSA.68.31.005" x-head="true" lemma="כּוּשׁ" strong="H3568a">Ethiopia</char> <char style="w" x-id="t008" x-align="PSA.68.31.a006">shall</char> <char style="w" x-id="t009" x-align="PSA.68.31.a006" x-src="WLC.PSA.68.31.006" x-source="תָּרִ֥יץ" x-translit="tāriyṣ" srcloc="WLC.PSA.68.31.006" x-head="true" lemma="רוּץ" strong="H7323">haste</char> <char style="w" x-id="t010" x-align="PSA.68.31.a006">to</char> <char style="w" x-id="t011" x-align="PSA.68.31.a006">stretch</char> <char style="w" x-id="t012" x-align="PSA.68.31.a006">out</char> <char style="w" x-id="t013" x-align="PSA.68.31.a008" x-src="WLC.PSA.68.31.008" x-source="ו" x-translit="w" srcloc="WLC.PSA.68.31.008" x-head="true" lemma="הוּא" strong="H2050c">her</char> <char style="w" x-id="t014" x-align="PSA.68.31.a007" x-src="WLC.PSA.68.31.007" x-source="יָ֝דָ֗י" x-translit="yāḏāy" srcloc="WLC.PSA.68.31.007" x-head="true" lemma="יָד" strong="H3027">hands</char> <char style="w" x-id="t015" x-align="PSA.68.31.a009" x-src="WLC.PSA.68.31.009" x-source="לֵ" x-translit="lē" srcloc="WLC.PSA.68.31.009" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t016" x-align="PSA.68.31.a010" x-src="WLC.PSA.68.31.010" x-source="אלֹהִֽים" x-translit="ʾlōhiym:" srcloc="WLC.PSA.68.31.010" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>.<verse eid="PSA 68:31" /></para>
