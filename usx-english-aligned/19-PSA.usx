	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Is the righteousness ye should speak dumb?</char></char></note><char style="w" x-id="t001" x-align="PSA.58.1.a001" x-src="WLC.PSA.58.1.001" x-source="הַֽ" x-translit="ha" srcloc="WLC.PSA.58.1.001" x-head="true" lemma="הֲ" strong="H1886b">Do</char> <char style="w" x-id="t002" x-align="PSA.58.1.a005">ye</char> <char style="w" x-id="t003" x-align="PSA.58.1.a002" x-src="WLC.PSA.58.1.002" x-source="אֻמְנָ֗ם" x-translit="ʾumnām" srcloc="WLC.PSA.58.1.002" x-head="true" lemma="אֻמְנָם" strong="H552">indeed</char> <note caller="-" style="f"><char style="ft">Or, as otherwise read, <char style="it">O ye gods</char>. Or, <char style="it">O ye mighty ones</char></char></note><char style="w" x-id="t004" x-align="PSA.58.1.a003">in</char> <char style="w" x-id="t005" x-align="PSA.58.1.a003" x-src="WLC.PSA.58.1.003" x-source="אֵ֣לֶם" x-translit="ʾēlem" srcloc="WLC.PSA.58.1.003" x-head="true" lemma="אֵלֶם" strong="H482">silence</char> <char style="w" x-id="t006" x-align="PSA.58.1.a005" x-src="WLC.PSA.58.1.005" x-source="תְּדַבֵּר֑וּ" x-translit="təḏabbērû" srcloc="WLC.PSA.58.1.005" x-head="true" lemma="דָבַר" strong="H1696">speak</char> <char style="w" x-id="t007" x-align="PSA.58.1.a004" x-src="WLC.PSA.58.1.004" x-source="צֶ֭דֶק" x-translit="ṣeḏeq" srcloc="WLC.PSA.58.1.004" x-head="true" lemma="צֶדֶק" strong="H6664">righteousness</char>?</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.58.1.a001">Do</char> <char style="w" x-id="t009" x-align="PSA.58.1.a008">ye</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">judge uprightly the sons of men</char></char></note><char style="w" x-id="t010" x-align="PSA.58.1.a008" x-src="WLC.PSA.58.1.008" x-source="תִּ֝שְׁפְּט֗וּ" x-translit="tišpəṭû" srcloc="WLC.PSA.58.1.008" x-head="true" lemma="שָׁפַט" strong="H8199">judge</char> <char style="w" x-id="t011" x-align="PSA.58.1.a007" x-src="WLC.PSA.58.1.007" x-source="מֵישָׁרִ֥ים" x-translit="mêšāriym" srcloc="WLC.PSA.58.1.007" x-head="true" lemma="מֵישָׁרִים" strong="H4339">uprightly</char>, <char style="w" x-id="t012" x-align="PSA.58.1.a009">O</char> <char style="w" x-id="t013" x-align="PSA.58.1.a009">ye</char> <char style="w" x-id="t014" x-align="PSA.58.1.a009" x-src="WLC.PSA.58.1.009" x-source="בְּנֵ֣י" x-translit="bənēy" srcloc="WLC.PSA.58.1.009" x-head="true" lemma="בֵּן" strong="H1121">sons</char> <char style="w" x-id="t015" x-align="PSA.58.1.a010">of</char> <char style="w" x-id="t016" x-align="PSA.58.1.a010" x-src="WLC.PSA.58.1.010" x-source="אָדָֽם" x-translit="ʾāḏām:" srcloc="WLC.PSA.58.1.010" x-head="true" lemma="אָדָם" strong="H120">men</char>?<verse eid="PSA 58:1" /></para>
