	<para style="q1"><char style="w" x-id="t014" x-align="PSA.27.13.a009" x-src="WLC.PSA.27.13.008" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.27.13.008" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t015" x-align="PSA.27.13.a010">the</char> <char style="w" x-id="t016" x-align="PSA.27.13.a010" x-src="WLC.PSA.27.13.009" x-source="אֶ֣רֶץ" x-translit="ʾereṣ" srcloc="WLC.PSA.27.13.009" x-head="true" lemma="אֶרֶץ" strong="H776">land</char> <char style="w" x-id="t017" x-align="PSA.27.13.a011">of</char> <char style="w" x-id="t018" x-align="PSA.27.13.a011">the</char> <char style="w" x-id="t019" x-align="PSA.27.13.a011" x-src="WLC.PSA.27.13.010" x-source="חַיִּֽים" x-translit="ḥayyiym:" srcloc="WLC.PSA.27.13.010" x-head="true" lemma="חַי" strong="H2416a">living</char>.<verse eid="PSA 27:13" /></para>
	<para style="q1"><verse number="14" style="v" sid="PSA 27:14" /><char style="w" x-id="t001" x-align="PSA.27.14.a001" x-src="WLC.PSA.27.14.001" x-source="קַוֵּ֗ה" x-translit="qawwēh" srcloc="WLC.PSA.27.14.001" x-head="true" lemma="קָוָה" strong="H6960">Wait</char> <char style="w" x-id="t002" x-align="PSA.27.14.a002" x-src="WLC.PSA.27.14.002" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.PSA.27.14.002" x-head="true" lemma="אֶל" strong="H413">for</char> <char style="w" x-id="t003" x-align="PSA.27.14.a003" x-src="WLC.PSA.27.14.003" x-source="יְה֫וָ֥ה" x-translit="yəhwāh" srcloc="WLC.PSA.27.14.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>:</para>
	<para style="q1"><char style="w" x-id="t004" x-align="PSA.27.14.a004">Be</char> <char style="w" x-id="t005" x-align="PSA.27.14.a004" x-src="WLC.PSA.27.14.004" x-source="חֲ֭זַק" x-translit="ḥăzaq" srcloc="WLC.PSA.27.14.004" x-head="true" lemma="חָזַק" strong="H2388">strong</char>, <char style="w" x-id="t006" x-align="PSA.27.14.a005" x-src="WLC.PSA.27.14.005" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.27.14.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t007" x-align="PSA.27.14.a006">let</char> <char style="w" x-id="t008" x-align="PSA.27.14.a008" x-src="WLC.PSA.27.14.008" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.27.14.008" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t009" x-align="PSA.27.14.a007" x-src="WLC.PSA.27.14.007" x-source="לִבֶּ֑" x-translit="libb" srcloc="WLC.PSA.27.14.007" x-head="true" lemma="לֵב" strong="H3820">heart</char> <char style="w" x-id="t010" x-align="PSA.27.14.a006">take</char> <char style="w" x-id="t011" x-align="PSA.27.14.a006" x-src="WLC.PSA.27.14.006" x-source="יַאֲמֵ֣ץ" x-translit="yaʾămēṣ" srcloc="WLC.PSA.27.14.006" x-head="true" lemma="אָמֵץ" strong="H553">courage</char>;</para>
