	<para style="q1"><char style="w" x-id="t012" x-align="PSA.65.9.a010">The</char> <char style="w" x-id="t013" x-align="PSA.65.9.a010" x-src="WLC.PSA.65.9.010" x-source="פֶּ֣לֶג" x-translit="peleḡ" srcloc="WLC.PSA.65.9.010" x-head="true" lemma="פֶּלֶג" strong="H6388">river</char> <char style="w" x-id="t014" x-align="PSA.65.9.a011">of</char> <char style="w" x-id="t015" x-align="PSA.65.9.a011" x-src="WLC.PSA.65.9.011" x-source="אֱ֭לֹהִים" x-translit="ʾĕlōhîm" srcloc="WLC.PSA.65.9.011" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t016" x-align="PSA.65.9.a012">is</char> <char style="w" x-id="t017" x-align="PSA.65.9.a012" x-src="WLC.PSA.65.9.012" x-source="מָ֣לֵא" x-translit="mālēʾ" srcloc="WLC.PSA.65.9.012" x-head="true" lemma="מָלֵא" strong="H4392">full</char> <char style="w" x-id="t018" x-align="PSA.65.9.a012">of</char> <char style="w" x-id="t019" x-align="PSA.65.9.a013" x-src="WLC.PSA.65.9.013" x-source="מָ֑יִם" x-translit="māyim" srcloc="WLC.PSA.65.9.013" x-head="true" lemma="מַיִם" strong="H4325">water</char>:</para>
	<para style="q1"><char style="w" x-id="t020" x-align="PSA.65.9.a014">Thou</char> <char style="w" x-id="t021" x-align="PSA.65.9.a014" x-src="WLC.PSA.65.9.014" x-source="תָּכִ֥ין" x-translit="tāḵiyn" srcloc="WLC.PSA.65.9.014" x-head="true" lemma="כּוּן" strong="H3559">providest</char> <char style="w" x-id="t022" x-align="PSA.65.9.a016" x-src="WLC.PSA.65.9.016" x-source="ם" x-translit="ām" srcloc="WLC.PSA.65.9.016" x-head="true" lemma="הוּא" strong="H3963a">them</char> <char style="w" x-id="t023" x-align="PSA.65.9.a015" x-src="WLC.PSA.65.9.015" x-source="דְּ֝גָנָ֗" x-translit="dəḡān" srcloc="WLC.PSA.65.9.015" x-head="true" lemma="דָּגָן" strong="H1715">grain</char>, <note caller="-" style="f"><char style="ft">Or, <char style="it">for so preparest thou</char></char></note><char style="w" x-id="t024" x-align="PSA.65.9.a017" x-src="WLC.PSA.65.9.017" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.65.9.017" x-head="true" lemma="כִּי" strong="H3588">when</char> <char style="w" x-id="t025" x-align="PSA.65.9.a019">thou</char> <char style="w" x-id="t026" x-align="PSA.65.9.a019">hast</char> <char style="w" x-id="t027" x-align="PSA.65.9.a018" x-src="WLC.PSA.65.9.018" x-source="כֵ֥ן" x-translit="ḵēn" srcloc="WLC.PSA.65.9.018" x-head="true" lemma="כֵּן" strong="H3651">so</char> <char style="w" x-id="t028" x-align="PSA.65.9.a019" x-src="WLC.PSA.65.9.019" x-source="תְּכִינֶֽ" x-translit="təḵiyn" srcloc="WLC.PSA.65.9.019" x-head="true" lemma="כּוּן" strong="H3559">prepared</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">it</char>.</char></note><char style="w" x-id="t029" x-align="PSA.65.9.a020">the</char> <char style="w" x-id="t030" x-align="PSA.65.9.a020" x-src="WLC.PSA.65.9.020" x-source="הָ" x-translit="ehā" srcloc="WLC.PSA.65.9.020" x-head="true" lemma="הוּא" strong="H1886d">earth</char>.<verse eid="PSA 65:9" /></para>
