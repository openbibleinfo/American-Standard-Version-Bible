	<para style="s1"><verse number="1" style="v" x-unrepresented-source="אֶת אֶת" x-unrepresented-translit="ʾeṯ- ʾeṯ-" x-unrepresented-src="WLC.PSA.79.1.011 WLC.PSA.79.1.016" sid="PSA 79:1" />A lament over the destruction of Jerusalem, and prayer for help.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.79.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.79.1.a001" x-src="WLC.PSA.79.1.001" x-source="מִזְמ֗וֹר" x-translit="mizmôr" srcloc="WLC.PSA.79.1.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t003" x-align="PSA.79.1.a002" x-src="WLC.PSA.79.1.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.79.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.79.1.a003" x-src="WLC.PSA.79.1.003" x-source="אָ֫סָ֥ף" x-translit="ʾāsāp̄" srcloc="WLC.PSA.79.1.003" x-head="true" lemma="אָסָף" strong="H623">Asaph</char>.</para>
