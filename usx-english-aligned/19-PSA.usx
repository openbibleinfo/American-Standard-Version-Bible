	<para style="q1"><char style="w" x-id="t007" x-align="PSA.33.3.a007" x-src="WLC.PSA.33.3.007" x-source="נַ֝גֵּ֗ן" x-translit="naggēn" srcloc="WLC.PSA.33.3.007" x-head="true" lemma="נָגַן" strong="H5059">Play</char> <char style="w" x-id="t008" x-align="PSA.33.3.a006" x-src="WLC.PSA.33.3.006" x-source="הֵיטִ֥יבוּ" x-translit="hêṭiyḇû" srcloc="WLC.PSA.33.3.006" x-head="true" lemma="יָטַב" strong="H3190">skilfully</char> <char style="w" x-id="t009" x-align="PSA.33.3.a008" x-src="WLC.PSA.33.3.008" x-source="בִּ" x-translit="bi" srcloc="WLC.PSA.33.3.008" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t010" x-align="PSA.33.3.a009">a</char> <char style="w" x-id="t011" x-align="PSA.33.3.a009">loud</char> <char style="w" x-id="t012" x-align="PSA.33.3.a009" x-src="WLC.PSA.33.3.009" x-source="תְרוּעָֽה" x-translit="ṯərûʿāh:" srcloc="WLC.PSA.33.3.009" x-head="true" lemma="תְּרוּעָה" strong="H8643">noise</char>.<verse eid="PSA 33:3" /></para>
	<para style="q1"><verse number="4" style="v" sid="PSA 33:4" /><char style="w" x-id="t001" x-align="PSA.33.4.a001" x-src="WLC.PSA.33.4.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.33.4.001" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t002" x-align="PSA.33.4.a003">the</char> <char style="w" x-id="t003" x-align="PSA.33.4.a003" x-src="WLC.PSA.33.4.003" x-source="דְּבַר" x-translit="dəḇar-" srcloc="WLC.PSA.33.4.003" x-head="true" lemma="דָּבָר" strong="H1697">word</char> <char style="w" x-id="t004" x-align="PSA.33.4.a004">of</char> <char style="w" x-id="t005" x-align="PSA.33.4.a004" x-src="WLC.PSA.33.4.004" x-source="יְהוָ֑ה" x-translit="yəhwāh" srcloc="WLC.PSA.33.4.004" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t006" x-align="PSA.33.4.a002">is</char> <char style="w" x-id="t007" x-align="PSA.33.4.a002" x-src="WLC.PSA.33.4.002" x-source="יָשָׁ֥ר" x-translit="yāšār" srcloc="WLC.PSA.33.4.002" x-head="true" lemma="יָשָׁר" strong="H3477">right</char>;</para>
