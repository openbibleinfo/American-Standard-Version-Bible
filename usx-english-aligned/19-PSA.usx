	<para style="q1"><char style="w" x-id="t017" x-align="PSA.39.1.a010">I</char> <char style="w" x-id="t018" x-align="PSA.39.1.a010">will</char> <char style="w" x-id="t019" x-align="PSA.39.1.a010" x-src="WLC.PSA.39.1.010" x-source="אֶשְׁמְרָ֥ה" x-translit="ʾešmərāh" srcloc="WLC.PSA.39.1.010" x-head="true" lemma="שָׁמַר" strong="H8104">keep</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">a bridle</char> (or <char style="it">muzzle</char>) <char style="it">for my mouth</char>.</char></note><char style="w" x-id="t020" x-align="PSA.39.1.a013" x-src="WLC.PSA.39.1.013" x-source="י" x-translit="iy" srcloc="WLC.PSA.39.1.013" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t021" x-align="PSA.39.1.a012" x-src="WLC.PSA.39.1.012" x-source="פִ֥" x-translit="p̄" srcloc="WLC.PSA.39.1.012" x-head="true" lemma="פֶּה" strong="H6310">mouth</char> <char style="w" x-id="t022" x-align="PSA.39.1.a010">with</char> <char style="w" x-id="t023" x-align="PSA.39.1.a014">a</char> <char style="w" x-id="t024" x-align="PSA.39.1.a014" x-src="WLC.PSA.39.1.014" x-source="מַחְס֑וֹם" x-translit="maḥsôm" srcloc="WLC.PSA.39.1.014" x-head="true" lemma="מַחְסוֹם" strong="H4269">bridle</char>,</para>
