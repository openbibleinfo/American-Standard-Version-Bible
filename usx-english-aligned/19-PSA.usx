	<chapter eid="PSA 1" />
	<chapter number="2" style="c" sid="PSA 2" />
	<para style="s1"><verse number="1" style="v" sid="PSA 2:1" />The reign of Jehovah’s anointed.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.2.1.a001" x-src="WLC.PSA.2.1.001 WLC.PSA.2.1.002" x-source="לָ֭ מָּה" x-translit="lā mmâ" srcloc="WLC.PSA.2.1.002" x-head="true" lemma="מָה" strong="H4100">Why</char> <char style="w" x-id="t002" x-align="PSA.2.1.a002">do</char> <char style="w" x-id="t003" x-align="PSA.2.1.a003">the</char> <char style="w" x-id="t004" x-align="PSA.2.1.a003" x-src="WLC.PSA.2.1.004" x-source="גוֹיִ֑ם" x-translit="ḡôyim" srcloc="WLC.PSA.2.1.004" x-head="true" lemma="גּוֹי" strong="H1471">nations</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">tumultuously assemble</char></char></note><char style="w" x-id="t005" x-align="PSA.2.1.a002" x-src="WLC.PSA.2.1.003" x-source="רָגְשׁ֣וּ" x-translit="rāḡəšû" srcloc="WLC.PSA.2.1.003" x-head="true" lemma="רָגַשׁ" strong="H7283">rage</char>,</para>
