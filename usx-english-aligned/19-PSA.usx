	<para style="q1"><verse number="17" style="v" sid="PSA 10:17" /><char style="w" x-id="t001" x-align="PSA.10.17.a004" x-src="WLC.PSA.10.17.004" x-source="יְהוָ֑ה" x-translit="yəhwāh" srcloc="WLC.PSA.10.17.004" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t002" x-align="PSA.10.17.a003">thou</char> <char style="w" x-id="t003" x-align="PSA.10.17.a003">hast</char> <char style="w" x-id="t004" x-align="PSA.10.17.a003" x-src="WLC.PSA.10.17.003" x-source="שָׁמַ֣עְתָּ" x-translit="šāmaʿətā" srcloc="WLC.PSA.10.17.003" x-head="true" lemma="שָׁמַע" strong="H8085">heard</char> <char style="w" x-id="t005" x-align="PSA.10.17.a001">the</char> <char style="w" x-id="t006" x-align="PSA.10.17.a001" x-src="WLC.PSA.10.17.001" x-source="תַּאֲוַ֬ת" x-translit="taʾăwaṯ" srcloc="WLC.PSA.10.17.001" x-head="true" lemma="תַּאֲוָה" strong="H8378">desire</char> <char style="w" x-id="t007" x-align="PSA.10.17.a002">of</char> <char style="w" x-id="t008" x-align="PSA.10.17.a002">the</char> <char style="w" x-id="t009" x-align="PSA.10.17.a002" x-src="WLC.PSA.10.17.002" x-source="עֲנָוִ֣ים" x-translit="ʿănāwiym" srcloc="WLC.PSA.10.17.002" x-head="true" lemma="עָנָו" strong="H6035">meek</char>:</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.10.17.a005">Thou</char> <char style="w" x-id="t011" x-align="PSA.10.17.a005">wilt</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">establish</char></char></note><char style="w" x-id="t012" x-align="PSA.10.17.a005" x-src="WLC.PSA.10.17.005" x-source="תָּכִ֥ין" x-translit="tāḵiyn" srcloc="WLC.PSA.10.17.005" x-head="true" lemma="כּוּן" strong="H3559">prepare</char> <char style="w" x-id="t013" x-align="PSA.10.17.a007" x-src="WLC.PSA.10.17.007" x-source="ם" x-translit="ām" srcloc="WLC.PSA.10.17.007" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t014" x-align="PSA.10.17.a006" x-src="WLC.PSA.10.17.006" x-source="לִ֝בָּ֗" x-translit="libb" srcloc="WLC.PSA.10.17.006" x-head="true" lemma="לֵב" strong="H3820">heart</char>, <char style="w" x-id="t015" x-align="PSA.10.17.a008">thou</char> <char style="w" x-id="t016" x-align="PSA.10.17.a008">wilt</char> <char style="w" x-id="t017" x-align="PSA.10.17.a008">cause</char> <char style="w" x-id="t018" x-align="PSA.10.17.a010" x-src="WLC.PSA.10.17.010" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.10.17.010" x-head="true" lemma="הוּא" strong="H3509b">thine</char> <char style="w" x-id="t019" x-align="PSA.10.17.a009" x-src="WLC.PSA.10.17.009" x-source="אָזְנֶֽ" x-translit="ʾāzən" srcloc="WLC.PSA.10.17.009" x-head="true" lemma="אֹזֶן" strong="H241">ear</char> <char style="w" x-id="t020" x-align="PSA.10.17.a008">to</char> <char style="w" x-id="t021" x-align="PSA.10.17.a008" x-src="WLC.PSA.10.17.008" x-source="תַּקְשִׁ֥יב" x-translit="taqšiyḇ" srcloc="WLC.PSA.10.17.008" x-head="true" lemma="קָשַׁב" strong="H7181">hear</char>;<verse eid="PSA 10:17" /></para>
