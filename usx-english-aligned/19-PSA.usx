	<para style="q1"><verse number="6" style="v" sid="PSA 45:6" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Thy throne is</char> the throne of <char style="it">God etc.</char></char></note><char style="w" x-id="t001" x-align="PSA.45.6.a002" x-src="WLC.PSA.45.6.002" x-source="ךָ֣" x-translit="ăḵā" srcloc="WLC.PSA.45.6.002" x-head="true" lemma="הוּא" strong="H3509b">Thy</char> <char style="w" x-id="t002" x-align="PSA.45.6.a001" x-src="WLC.PSA.45.6.001" x-source="כִּסְאֲ" x-translit="kisʾ" srcloc="WLC.PSA.45.6.001" x-head="true" lemma="כִּסֵּא" strong="H3678">throne</char>, <char style="w" x-id="t003" x-align="PSA.45.6.a003">O</char> <char style="w" x-id="t004" x-align="PSA.45.6.a003" x-src="WLC.PSA.45.6.003" x-source="אֱ֭לֹהִים" x-translit="ʾĕlōhîm" srcloc="WLC.PSA.45.6.003" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t005" x-align="PSA.45.6.a004">is</char> <char style="w" x-id="t006" x-align="PSA.45.6.a004">for</char> <char style="w" x-id="t007" x-align="PSA.45.6.a004" x-src="WLC.PSA.45.6.004" x-source="עוֹלָ֣ם" x-translit="ʿôlām" srcloc="WLC.PSA.45.6.004" x-head="true" lemma="עוֹלָם" strong="H5769">ever</char> <char style="w" x-id="t008" x-align="PSA.45.6.a005" x-src="WLC.PSA.45.6.005" x-source="וָ" x-translit="wā" srcloc="WLC.PSA.45.6.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="PSA.45.6.a006" x-src="WLC.PSA.45.6.006" x-source="עֶ֑ד" x-translit="ʿeḏ" srcloc="WLC.PSA.45.6.006" x-head="true" lemma="עַד" strong="H5703">ever</char>:</para>
	<para style="q1"><char style="w" x-id="t010" x-align="PSA.45.6.a007">A</char> <char style="w" x-id="t011" x-align="PSA.45.6.a007" x-src="WLC.PSA.45.6.007" x-source="שֵׁ֥בֶט" x-translit="šēḇeṭ" srcloc="WLC.PSA.45.6.007" x-head="true" lemma="שֵׁבֶט" strong="H7626">sceptre</char> <char style="w" x-id="t012" x-align="PSA.45.6.a008">of</char> <char style="w" x-id="t013" x-align="PSA.45.6.a008" x-src="WLC.PSA.45.6.008" x-source="מִ֝ישֹׁ֗ר" x-translit="mîšōr" srcloc="WLC.PSA.45.6.008" x-head="true" lemma="מִישׁוֹר" strong="H4334">equity</char> <char style="w" x-id="t014" x-align="PSA.45.6.a007">is</char> <char style="w" x-id="t015" x-align="PSA.45.6.a009">the</char> <char style="w" x-id="t016" x-align="PSA.45.6.a009" x-src="WLC.PSA.45.6.009" x-source="שֵׁ֣בֶט" x-translit="šēḇeṭ" srcloc="WLC.PSA.45.6.009" x-head="true" lemma="שֵׁבֶט" strong="H7626">sceptre</char> <char style="w" x-id="t017" x-align="PSA.45.6.a010">of</char> <char style="w" x-id="t018" x-align="PSA.45.6.a011" x-src="WLC.PSA.45.6.011" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.45.6.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t019" x-align="PSA.45.6.a010" x-src="WLC.PSA.45.6.010" x-source="מַלְכוּתֶֽ" x-translit="malḵûṯ" srcloc="WLC.PSA.45.6.010" x-head="true" lemma="מַלְכוּת" strong="H4438">kingdom</char>.<verse eid="PSA 45:6" /></para>
	<para style="q1"><verse number="7" style="v" sid="PSA 45:7" /><char style="w" x-id="t001" x-align="PSA.45.7.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.45.7.a001">hast</char> <char style="w" x-id="t003" x-align="PSA.45.7.a001" x-src="WLC.PSA.45.7.001" x-source="אָהַ֣בְתָּ" x-translit="ʾāhaḇətā" srcloc="WLC.PSA.45.7.001" x-head="true" lemma="אָהֵב" strong="H157">loved</char> <char style="w" x-id="t004" x-align="PSA.45.7.a002" x-src="WLC.PSA.45.7.002" x-source="צֶּדֶק֮" x-translit="ṣṣeḏeq" srcloc="WLC.PSA.45.7.002" x-head="true" lemma="צֶדֶק" strong="H6664">righteousness</char>, <char style="w" x-id="t005" x-align="PSA.45.7.a003" x-src="WLC.PSA.45.7.003" x-source="וַ" x-translit="wa" srcloc="WLC.PSA.45.7.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t006" x-align="PSA.45.7.a004" x-src="WLC.PSA.45.7.004" x-source="תִּשְׂנָ֫א" x-translit="tiśnāʾ" srcloc="WLC.PSA.45.7.004" x-head="true" lemma="שָׂנֵא" strong="H8130">hated</char> <char style="w" x-id="t007" x-align="PSA.45.7.a005" x-src="WLC.PSA.45.7.005" x-source="רֶ֥שַׁע" x-translit="rešaʿ" srcloc="WLC.PSA.45.7.005" x-head="true" lemma="רֶשַׁע" strong="H7562">wickedness</char>:</para>
