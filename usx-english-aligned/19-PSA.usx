	<para style="q1"><char style="w" x-id="t008" x-align="PSA.99.8.a009">Thou</char> <char style="w" x-id="t009" x-align="PSA.99.8.a009" x-src="WLC.PSA.99.8.009" x-source="הָיִ֣יתָ" x-translit="hāyiyṯā" srcloc="WLC.PSA.99.8.009" x-head="true" lemma="הָיָה" strong="H1961">wast</char> <char style="w" x-id="t010" x-align="PSA.99.8.a007">a</char> <char style="w" x-id="t011" x-align="PSA.99.8.a007" x-src="WLC.PSA.99.8.007" x-source="אֵ֣ל" x-translit="ʾēl" srcloc="WLC.PSA.99.8.007" x-head="true" lemma="אֵל" strong="H410">God</char> <char style="w" x-id="t012" x-align="PSA.99.8.a008">that</char> <char style="w" x-id="t013" x-align="PSA.99.8.a008" x-src="WLC.PSA.99.8.008" x-source="נֹ֭שֵׂא" x-translit="nōśēʾ" srcloc="WLC.PSA.99.8.008" x-head="true" lemma="נָשָׂא" strong="H5375">forgavest</char> <char style="w" x-id="t014" x-align="PSA.99.8.a011" x-src="WLC.PSA.99.8.011" x-source="הֶ֑ם" x-translit="āhem" srcloc="WLC.PSA.99.8.011" x-head="true" lemma="הוּא" strong="H3963a">them</char>,</para>
	<para style="q1"><char style="w" x-id="t015" x-align="PSA.99.8.a012" x-src="WLC.PSA.99.8.012" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.99.8.012" x-head="true" lemma="וְ" strong="H2050b">Though</char> <char style="w" x-id="t016" x-align="PSA.99.8.a004">thou</char> <char style="w" x-id="t017" x-align="PSA.99.8.a013">tookest</char> <char style="w" x-id="t018" x-align="PSA.99.8.a013" x-src="WLC.PSA.99.8.013" x-source="נֹקֵ֗ם" x-translit="nōqēm" srcloc="WLC.PSA.99.8.013" x-head="true" lemma="נָקַם" strong="H5358">vengeance</char> <char style="w" x-id="t019" x-align="PSA.99.8.a014" x-src="WLC.PSA.99.8.014" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.99.8.014" x-head="true" lemma="עַל" strong="H5921">of</char> <char style="w" x-id="t020" x-align="PSA.99.8.a016" x-src="WLC.PSA.99.8.016" x-source="ם" x-translit="ām" srcloc="WLC.PSA.99.8.016" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t021" x-align="PSA.99.8.a015" x-src="WLC.PSA.99.8.015" x-source="עֲלִילוֹתָֽ" x-translit="ʿăliylôṯ" srcloc="WLC.PSA.99.8.015" x-head="true" lemma="עֲלִילָה" strong="H5949">doings</char>.<verse eid="PSA 99:8" /></para>
	<para style="q1"><verse number="9" style="v" sid="PSA 99:9" /><char style="w" x-id="t001" x-align="PSA.99.9.a001" x-src="WLC.PSA.99.9.001" x-source="רֽוֹמְמ֡וּ" x-translit="rôməmû" srcloc="WLC.PSA.99.9.001" x-head="true" lemma="רוּם" strong="H7311">Exalt</char> <char style="w" x-id="t002" x-align="PSA.99.9.a001">ye</char> <char style="w" x-id="t003" x-align="PSA.99.9.a002" x-src="WLC.PSA.99.9.002" x-source="יְה֘וָ֤ה" x-translit="yəhwāh" srcloc="WLC.PSA.99.9.002" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t004" x-align="PSA.99.9.a004" x-src="WLC.PSA.99.9.004" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.99.9.004" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t005" x-align="PSA.99.9.a003" x-src="WLC.PSA.99.9.003" x-source="אֱלֹהֵ֗י" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.99.9.003" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>,</para>
	<para style="q1"><char style="w" x-id="t006" x-align="PSA.99.9.a005" x-src="WLC.PSA.99.9.005" x-source="וְ֭" x-translit="wə" srcloc="WLC.PSA.99.9.005" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t007" x-align="PSA.99.9.a006" x-src="WLC.PSA.99.9.006" x-source="הִֽשְׁתַּחֲווּ" x-translit="hišətaḥăwû" srcloc="WLC.PSA.99.9.006" x-head="true" lemma="חוה" strong="H7812a">worship</char> <char style="w" x-id="t008" x-align="PSA.99.9.a007" x-src="WLC.PSA.99.9.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.99.9.007" x-head="true" lemma="לְ" strong="H3807a">at</char> <char style="w" x-id="t009" x-align="PSA.99.9.a010" x-src="WLC.PSA.99.9.010" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.99.9.010" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t010" x-align="PSA.99.9.a009" x-src="WLC.PSA.99.9.009" x-source="קָדְשׁ֑" x-translit="qāḏəš" srcloc="WLC.PSA.99.9.009" x-head="true" lemma="קֹדֶשׁ" strong="H6944">holy</char> <char style="w" x-id="t011" x-align="PSA.99.9.a008" x-src="WLC.PSA.99.9.008" x-source="הַ֣ר" x-translit="har" srcloc="WLC.PSA.99.9.008" x-head="true" lemma="הַר" strong="H2022">hill</char>;</para>
	<para style="q1"><char style="w" x-id="t012" x-align="PSA.99.9.a011" x-src="WLC.PSA.99.9.011" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.99.9.011" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t013" x-align="PSA.99.9.a013" x-src="WLC.PSA.99.9.013" x-source="יְהוָ֥ה" x-translit="yəhwāh" srcloc="WLC.PSA.99.9.013" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t014" x-align="PSA.99.9.a015" x-src="WLC.PSA.99.9.015" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.99.9.015" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t015" x-align="PSA.99.9.a014" x-src="WLC.PSA.99.9.014" x-source="אֱלֹהֵֽי" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.99.9.014" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t016" x-align="PSA.99.9.a012">is</char> <char style="w" x-id="t017" x-align="PSA.99.9.a012" x-src="WLC.PSA.99.9.012" x-source="קָ֝ד֗וֹשׁ" x-translit="qāḏôš" srcloc="WLC.PSA.99.9.012" x-head="true" lemma="קָדוֹשׁ" strong="H6918">holy</char>.<verse eid="PSA 99:9" /></para>
	<chapter eid="PSA 99" />
	<chapter number="100" style="c" sid="PSA 100" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="הָ" x-unrepresented-translit="hā" x-unrepresented-src="WLC.PSA.100.1.008" sid="PSA 100:1" />All men exhorted to praise God.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.100.1.a001">A</char> <char style="w" x-id="t002" x-align="PSA.100.1.a001" x-src="WLC.PSA.100.1.001" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.100.1.001" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">for the thank-offering</char></char></note><char style="w" x-id="t003" x-align="PSA.100.1.a002" x-src="WLC.PSA.100.1.002" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.100.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="PSA.100.1.a003" x-src="WLC.PSA.100.1.003" x-source="תוֹדָ֑ה" x-translit="ṯôḏāh" srcloc="WLC.PSA.100.1.003" x-head="true" lemma="תּוֹדָה" strong="H8426">thanksgiving</char>.</para>
