	<para style="q1"><verse number="13" style="v" sid="PSA 96:13" /><char style="w" x-id="t001" x-align="PSA.96.13.a001" x-src="WLC.PSA.96.13.001 WLC.PSA.96.13.002" x-source="לִ פְנֵ֤י" x-translit="li p̄ənēy" srcloc="WLC.PSA.96.13.002" x-head="true" lemma="פָּנֶה" strong="H6440">Before</char> <char style="w" x-id="t002" x-align="PSA.96.13.a002" x-src="WLC.PSA.96.13.003" x-source="יְהוָ֨ה" x-translit="yəhwāh" srcloc="WLC.PSA.96.13.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t003" x-align="PSA.96.13.a003" x-src="WLC.PSA.96.13.004" x-source="כִּ֬י" x-translit="kiy" srcloc="WLC.PSA.96.13.004" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t004" x-align="PSA.96.13.a004">he</char> <char style="w" x-id="t005" x-align="PSA.96.13.a004" x-src="WLC.PSA.96.13.005" x-source="בָ֗א" x-translit="ḇāʾ" srcloc="WLC.PSA.96.13.005" x-head="true" lemma="בּוֹא" strong="H935">cometh</char>,</para>
