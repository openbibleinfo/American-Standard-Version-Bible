	<para style="q1"><char style="w" x-id="t001" x-align="PSA.12.1.a001" x-src="WLC.PSA.12.1.001" x-source="הוֹשִׁ֣יעָ" x-translit="hôšiyʿ" srcloc="WLC.PSA.12.1.001" x-head="true" lemma="יָשַׁע" strong="H3467">Help</char>, <char style="w" x-id="t002" x-align="PSA.12.1.a003" x-src="WLC.PSA.12.1.003" x-source="יְ֭הוָה" x-translit="yhwh" srcloc="WLC.PSA.12.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t003" x-align="PSA.12.1.a004" x-src="WLC.PSA.12.1.004" x-source="כִּי" x-translit="kî-" srcloc="WLC.PSA.12.1.004" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t004" x-align="PSA.12.1.a006">the</char> <char style="w" x-id="t005" x-align="PSA.12.1.a006" x-src="WLC.PSA.12.1.006" x-source="חָסִ֑יד" x-translit="ḥāsiyḏ" srcloc="WLC.PSA.12.1.006" x-head="true" lemma="חָסִיד" strong="H2623">godly</char> <char style="w" x-id="t006" x-align="PSA.12.1.a006">man</char> <char style="w" x-id="t007" x-align="PSA.12.1.a005" x-src="WLC.PSA.12.1.005" x-source="גָמַ֣ר" x-translit="ḡāmar" srcloc="WLC.PSA.12.1.005" x-head="true" lemma="גָּמַר" strong="H1584">ceaseth</char>;</para>
