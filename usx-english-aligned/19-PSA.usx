	<para style="s1"><verse number="1" style="v" x-unrepresented-source="ה" x-unrepresented-translit="āh" x-unrepresented-src="WLC.PSA.8.1.014" sid="PSA 8:1" />Jehovah’s glory and man’s dignity.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.8.0.a001" x-src="WLC.PSA.8.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.8.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.8.0.a002" x-src="WLC.PSA.8.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.8.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.8.0.a003" x-src="WLC.PSA.8.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.8.0.003" x-head="true" lemma="נָצַח" strong="H5329">Chief</char> <char style="w" x-id="t004" x-align="PSA.8.0.a003">Musician</char>; <char style="w" x-id="t005" x-align="PSA.8.0.a004">set</char> <char style="w" x-id="t006" x-align="PSA.8.0.a004" x-src="WLC.PSA.8.0.004" x-source="עַֽל" x-translit="ʿal-" srcloc="WLC.PSA.8.0.004" x-head="true" lemma="עַל" strong="H5921">to</char> <char style="w" x-id="t007" x-align="PSA.8.0.a005" x-src="WLC.PSA.8.0.005" x-source="הַ" x-translit="ha" srcloc="WLC.PSA.8.0.005" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t008" x-align="PSA.8.0.a006" x-src="WLC.PSA.8.0.006" x-source="גִּתִּ֗ית" x-translit="gittiyṯ" srcloc="WLC.PSA.8.0.006" x-head="true" lemma="גִּתִּית" strong="H1665">Gittith</char>. <char style="w" x-id="t009" x-align="PSA.8.0.a007">A</char> <char style="w" x-id="t010" x-align="PSA.8.0.a007" x-src="WLC.PSA.8.0.007" x-source="מִזְמ֥וֹר" x-translit="mizmôr" srcloc="WLC.PSA.8.0.007" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t011" x-align="PSA.8.0.a008" x-src="WLC.PSA.8.0.008" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.8.0.008" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t012" x-align="PSA.8.0.a009" x-src="WLC.PSA.8.0.009" x-source="דָוִֽד" x-translit="ḏāwiḏ:" srcloc="WLC.PSA.8.0.009" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
