	<para style="q1"><char style="w" x-id="t024" x-align="PSA.22.29.a013" x-src="WLC.PSA.22.29.014" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.22.29.014" x-head="true" lemma="וְ" strong="H2050b">Even</char> <char style="w" x-id="t025" x-align="PSA.22.29.a017">he</char> <char style="w" x-id="t026" x-align="PSA.22.29.a017">that</char> <char style="w" x-id="t027" x-align="PSA.22.29.a016" x-src="WLC.PSA.22.29.017" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.PSA.22.29.017" x-head="true" lemma="לֹא" strong="H3808">cannot</char> <char style="w" x-id="t028" x-align="PSA.22.29.a017">keep</char> <char style="w" x-id="t029" x-align="PSA.22.29.a015" x-src="WLC.PSA.22.29.016" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.22.29.016" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t030" x-align="PSA.22.29.a014" x-src="WLC.PSA.22.29.015" x-source="נַפְשׁ֗" x-translit="nap̄š" srcloc="WLC.PSA.22.29.015" x-head="true" lemma="נֶפֶשׁ" strong="H5315">soul</char> <char style="w" x-id="t031" x-align="PSA.22.29.a017" x-src="WLC.PSA.22.29.018" x-source="חִיָּֽה" x-translit="ḥiyyāh:" srcloc="WLC.PSA.22.29.018" x-head="true" lemma="חָיָה" strong="H2421">alive</char>.<verse eid="PSA 22:29" /></para>
