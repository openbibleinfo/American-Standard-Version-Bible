	<para style="q1"><char style="add"><char style="w" x-id="t011" x-align="PSA.73.1.a009" x-status="added" x-source="∅" x-head="true">Even</char></char> <char style="w" x-id="t012" x-align="PSA.73.1.a010" x-src="WLC.PSA.73.1.009" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.73.1.009" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t013" x-align="PSA.73.1.a011">such</char> <char style="w" x-id="t014" x-align="PSA.73.1.a011">as</char> <char style="w" x-id="t015" x-align="PSA.73.1.a011">are</char> <char style="w" x-id="t016" x-align="PSA.73.1.a011" x-src="WLC.PSA.73.1.010" x-source="בָרֵ֥י" x-translit="ḇārēy" srcloc="WLC.PSA.73.1.010" x-head="true" lemma="בַּר" strong="H1249">pure</char> <char style="w" x-id="t017" x-align="PSA.73.1.a012">in</char> <char style="w" x-id="t018" x-align="PSA.73.1.a012" x-src="WLC.PSA.73.1.011" x-source="לֵבָֽב" x-translit="lēḇāḇ:" srcloc="WLC.PSA.73.1.011" x-head="true" lemma="לֵבָב" strong="H3824">heart</char>.<verse eid="PSA 73:1" /></para>
