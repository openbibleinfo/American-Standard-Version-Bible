	<chapter number="115" style="c" sid="PSA 115" />
	<para style="s1"><verse number="1" style="v" sid="PSA 115:1" />Heathen idols contrasted with Jehovah.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.115.1.a001" x-src="WLC.PSA.115.1.001" x-source="לֹ֤א" x-translit="lōʾ" srcloc="WLC.PSA.115.1.001" x-head="true" lemma="לֹא" strong="H3808">Not</char> <char style="w" x-id="t002" x-align="PSA.115.1.a002" x-src="WLC.PSA.115.1.002" x-source="לָ֥" x-translit="l" srcloc="WLC.PSA.115.1.002" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t003" x-align="PSA.115.1.a003" x-src="WLC.PSA.115.1.003" x-source="נוּ" x-translit="ānû" srcloc="WLC.PSA.115.1.003" x-head="true" lemma="הוּא" strong="H5105a">us</char>, <char style="w" x-id="t004" x-align="PSA.115.1.a004">O</char> <char style="w" x-id="t005" x-align="PSA.115.1.a004" x-src="WLC.PSA.115.1.004" x-source="יְהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.115.1.004" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t006" x-align="PSA.115.1.a005" x-src="WLC.PSA.115.1.005" x-source="לֹ֫א" x-translit="lōʾ" srcloc="WLC.PSA.115.1.005" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t007" x-align="PSA.115.1.a006" x-src="WLC.PSA.115.1.006" x-source="לָ֥" x-translit="l" srcloc="WLC.PSA.115.1.006" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t008" x-align="PSA.115.1.a007" x-src="WLC.PSA.115.1.007" x-source="נוּ" x-translit="ānû" srcloc="WLC.PSA.115.1.007" x-head="true" lemma="הוּא" strong="H5105a">us</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.115.1.a008" x-src="WLC.PSA.115.1.008" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.PSA.115.1.008" x-head="true" lemma="כִּי" strong="H3588">But</char> <char style="w" x-id="t010" x-align="PSA.115.1.a009" x-src="WLC.PSA.115.1.009" x-source="לְ֭" x-translit="lə" srcloc="WLC.PSA.115.1.009" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t011" x-align="PSA.115.1.a010" x-src="WLC.PSA.115.1.011" x-source="ךָ" x-translit="əḵā" srcloc="WLC.PSA.115.1.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t012" x-align="PSA.115.1.a011" x-src="WLC.PSA.115.1.010" x-source="שִׁמְ" x-translit="šim" srcloc="WLC.PSA.115.1.010" x-head="true" lemma="שֵׁם" strong="H8034">name</char> <char style="w" x-id="t013" x-align="PSA.115.1.a012" x-src="WLC.PSA.115.1.012" x-source="תֵּ֣ן" x-translit="tēn" srcloc="WLC.PSA.115.1.012" x-head="true" lemma="נָתַן" strong="H5414">give</char> <char style="w" x-id="t014" x-align="PSA.115.1.a013" x-src="WLC.PSA.115.1.013" x-source="כָּב֑וֹד" x-translit="kāḇôḏ" srcloc="WLC.PSA.115.1.013" x-head="true" lemma="כָּבוֹד" strong="H3519">glory</char>,</para>
	<para style="q1"><char style="w" x-id="t015" x-align="PSA.115.1.a014" x-src="WLC.PSA.115.1.014" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.115.1.014" x-head="true" lemma="עַל" strong="H5921">For</char> <char style="w" x-id="t016" x-align="PSA.115.1.a015" x-src="WLC.PSA.115.1.016" x-source="ךָ֗" x-translit="əḵā" srcloc="WLC.PSA.115.1.016" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t017" x-align="PSA.115.1.a016" x-src="WLC.PSA.115.1.015" x-source="חַ֝סְדְּ" x-translit="ḥasd" srcloc="WLC.PSA.115.1.015" x-head="true" lemma="חֶסֶד" strong="H2617">lovingkindness</char>, <char style="w" x-id="t018" x-align="PSA.115.1.a017" x-status="added" x-source="∅" x-head="true">and</char> <char style="w" x-id="t019" x-align="PSA.115.1.a018">for</char> <char style="w" x-id="t020" x-align="PSA.115.1.a019" x-src="WLC.PSA.115.1.019" x-source="ךָ" x-translit="eḵā" srcloc="WLC.PSA.115.1.019" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t021" x-align="PSA.115.1.a020" x-src="WLC.PSA.115.1.018" x-source="אֲמִתֶּֽ" x-translit="ʾămitt" srcloc="WLC.PSA.115.1.018" x-head="true" lemma="אֱמֶת" strong="H571">truth’s</char> <char style="w" x-id="t022" x-align="PSA.115.1.a018" x-src="WLC.PSA.115.1.017" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.115.1.017" x-head="true" lemma="עַל" strong="H5921">sake</char>.<verse eid="PSA 115:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 115:2" /><char style="w" x-id="t001" x-align="PSA.115.2.a001" x-src="WLC.PSA.115.2.001 WLC.PSA.115.2.002" x-source="לָ֭ מָּה" x-translit="lā mmâ" srcloc="WLC.PSA.115.2.002" x-head="true" lemma="מָה" strong="H4100">Wherefore</char> <char style="w" x-id="t002" x-align="PSA.115.2.a002">should</char> <char style="w" x-id="t003" x-align="PSA.115.2.a003" x-src="WLC.PSA.115.2.004" x-source="הַ" x-translit="ha" srcloc="WLC.PSA.115.2.004" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t004" x-align="PSA.115.2.a004" x-src="WLC.PSA.115.2.005" x-source="גּוֹיִ֑ם" x-translit="gôyim" srcloc="WLC.PSA.115.2.005" x-head="true" lemma="גּוֹי" strong="H1471">nations</char> <char style="w" x-id="t005" x-align="PSA.115.2.a002" x-src="WLC.PSA.115.2.003" x-source="יֹאמְר֣וּ" x-translit="yōʾmərû" srcloc="WLC.PSA.115.2.003" x-head="true" lemma="אָמַר" strong="H559">say</char>,</para>
	<para style="q1"><char style="w" x-id="t006" x-align="PSA.115.2.a005" x-src="WLC.PSA.115.2.006" x-source="אַיֵּה" x-translit="ʾayyēh-" srcloc="WLC.PSA.115.2.006" x-head="true" lemma="אַיֵּה" strong="H346">Where</char> <char style="w" x-id="t007" x-align="PSA.115.2.a005">is</char> <char style="w" x-id="t008" x-align="PSA.115.2.a006" x-src="WLC.PSA.115.2.007" x-source="נָ֝֗א" x-translit="nāʾ" srcloc="WLC.PSA.115.2.007" x-head="true" lemma="נָא" strong="H4994">now</char> <char style="w" x-id="t009" x-align="PSA.115.2.a007" x-src="WLC.PSA.115.2.009" x-source="הֶֽם" x-translit="hem" srcloc="WLC.PSA.115.2.009" x-head="true" lemma="הוּא" strong="H3963a">their</char> <char style="w" x-id="t010" x-align="PSA.115.2.a008" x-src="WLC.PSA.115.2.008" x-source="אֱלֹהֵי" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.115.2.008" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>?<verse eid="PSA 115:2" /></para>
	<para style="q1"><verse number="3" style="v" sid="PSA 115:3" /><char style="w" x-id="t001" x-align="PSA.115.3.a001" x-src="WLC.PSA.115.3.001" x-source="וֵֽ" x-translit="wē" srcloc="WLC.PSA.115.3.001" x-head="true" lemma="וְ" strong="H2050b">But</char> <char style="w" x-id="t002" x-align="PSA.115.3.a002" x-src="WLC.PSA.115.3.003" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.115.3.003" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t003" x-align="PSA.115.3.a003" x-src="WLC.PSA.115.3.002" x-source="אלֹהֵ֥י" x-translit="ʾlōhēy" srcloc="WLC.PSA.115.3.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t004" x-align="PSA.115.3.a004">is</char> <char style="w" x-id="t005" x-align="PSA.115.3.a004" x-src="WLC.PSA.115.3.004" x-source="בַ" x-translit="ḇa" srcloc="WLC.PSA.115.3.004" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t006" x-align="PSA.115.3.a005" x-src="WLC.PSA.115.3.005" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.115.3.005" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t007" x-align="PSA.115.3.a006" x-src="WLC.PSA.115.3.006" x-source="שָּׁמָ֑יִם" x-translit="ššāmāyim" srcloc="WLC.PSA.115.3.006" x-head="true" lemma="שָׁמַיִם" strong="H8064">heavens</char>:</para>
	<para style="q1"><char style="w" x-id="t008" x-align="PSA.115.3.a007">He</char> <char style="w" x-id="t009" x-align="PSA.115.3.a007">hath</char> <char style="w" x-id="t010" x-align="PSA.115.3.a007" x-src="WLC.PSA.115.3.010" x-source="עָשָֽׂה" x-translit="ʿāśāh:" srcloc="WLC.PSA.115.3.010" x-head="true" lemma="עָשָׂה" strong="H6213">done</char> <char style="w" x-id="t011" x-align="PSA.115.3.a008" x-src="WLC.PSA.115.3.007 WLC.PSA.115.3.008" x-source="כֹּ֭ל אֲשֶׁר" x-translit="kōl ʾăšer-" srcloc="WLC.PSA.115.3.007" x-head="true" lemma="כֹּל" strong="H3605">whatsoever</char> <char style="w" x-id="t012" x-align="PSA.115.3.a009">he</char> <char style="w" x-id="t013" x-align="PSA.115.3.a009" x-src="WLC.PSA.115.3.009" x-source="חָפֵ֣ץ" x-translit="ḥāp̄ēṣ" srcloc="WLC.PSA.115.3.009" x-head="true" lemma="חָפֵץ" strong="H2654">pleased</char>.<verse eid="PSA 115:3" /></para>
