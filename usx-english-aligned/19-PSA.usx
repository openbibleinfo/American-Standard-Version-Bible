	<para style="q1"><char style="w" x-id="t012" x-align="PSA.75.10.a006" x-status="added" x-source="∅" x-head="true">But</char> <char style="w" x-id="t013" x-align="PSA.75.10.a008">the</char> <char style="w" x-id="t014" x-align="PSA.75.10.a008" x-src="WLC.PSA.75.10.007" x-source="קַֽרְנ֥וֹת" x-translit="qarənôṯ" srcloc="WLC.PSA.75.10.007" x-head="true" lemma="קֶרֶן" strong="H7161">horns</char> <char style="w" x-id="t015" x-align="PSA.75.10.a009">of</char> <char style="w" x-id="t016" x-align="PSA.75.10.a009">the</char> <char style="w" x-id="t017" x-align="PSA.75.10.a009" x-src="WLC.PSA.75.10.008" x-source="צַדִּֽיק" x-translit="ṣaddiyq:" srcloc="WLC.PSA.75.10.008" x-head="true" lemma="צַדִּיק" strong="H6662">righteous</char> <char style="w" x-id="t018" x-align="PSA.75.10.a007">shall</char> <char style="w" x-id="t019" x-align="PSA.75.10.a007">be</char> <char style="w" x-id="t020" x-align="PSA.75.10.a007" x-src="WLC.PSA.75.10.006" x-source="תְּ֝רוֹמַ֗מְנָה" x-translit="tərômamənâ" srcloc="WLC.PSA.75.10.006" x-head="true" lemma="רוּם" strong="H7311">lifted</char> <char style="w" x-id="t021" x-align="PSA.75.10.a007">up</char>.<verse eid="PSA 75:10" /></para>
	<chapter eid="PSA 75" />
	<chapter number="76" style="c" sid="PSA 76" />
	<para style="s1"><verse number="1" style="v" sid="PSA 76:1" />The victorious power of the God of Jacob.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.76.0.a001" x-src="WLC.PSA.76.0.001" x-source="לַ" x-translit="la" srcloc="WLC.PSA.76.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.76.0.a002" x-src="WLC.PSA.76.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.76.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.76.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.76.0.a003" x-src="WLC.PSA.76.0.003" x-source="מְנַצֵּ֥חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.76.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>; <char style="w" x-id="t005" x-align="PSA.76.0.a004" x-src="WLC.PSA.76.0.004" x-source="בִּ" x-translit="bi" srcloc="WLC.PSA.76.0.004" x-head="true" lemma="בְּ" strong="H871a">on</char> <char style="w" x-id="t006" x-align="PSA.76.0.a005" x-src="WLC.PSA.76.0.005" x-source="נְגִינֹ֑ת" x-translit="nəḡînōṯ" srcloc="WLC.PSA.76.0.005" x-head="true" lemma="נְגִינָה" strong="H5058">stringed</char> <char style="w" x-id="t007" x-align="PSA.76.0.a005">instruments</char>. <char style="w" x-id="t008" x-align="PSA.76.0.a006">A</char> <char style="w" x-id="t009" x-align="PSA.76.0.a006" x-src="WLC.PSA.76.0.006" x-source="מִזְמ֖וֹר" x-translit="mizmôr" srcloc="WLC.PSA.76.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t010" x-align="PSA.76.0.a007" x-src="WLC.PSA.76.0.007" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.76.0.007" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t011" x-align="PSA.76.0.a008" x-src="WLC.PSA.76.0.008" x-source="אָסָ֣ף" x-translit="ʾāsāp̄" srcloc="WLC.PSA.76.0.008" x-head="true" lemma="אָסָף" strong="H623">Asaph</char>, <char style="w" x-id="t012" x-align="PSA.76.0.a009">a</char> <char style="w" x-id="t013" x-align="PSA.76.0.a009" x-src="WLC.PSA.76.0.009" x-source="שִֽׁיר" x-translit="šiyr:" srcloc="WLC.PSA.76.0.009" x-head="true" lemma="שִׁיר" strong="H7892">Song</char>.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.76.1.a002" x-src="WLC.PSA.76.1.002" x-source="בִּֽ" x-translit="bi" srcloc="WLC.PSA.76.1.002" x-head="true" lemma="בְּ" strong="H871a">In</char> <char style="w" x-id="t002" x-align="PSA.76.1.a003" x-src="WLC.PSA.76.1.003" x-source="יהוּדָ֣ה" x-translit="yhûḏāh" srcloc="WLC.PSA.76.1.003" x-head="true" lemma="יְהוּדָה" strong="H3063">Judah</char> <char style="w" x-id="t003" x-align="PSA.76.1.a001">is</char> <char style="w" x-id="t004" x-align="PSA.76.1.a004" x-src="WLC.PSA.76.1.004" x-source="אֱלֹהִ֑ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.76.1.004" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t005" x-align="PSA.76.1.a001" x-src="WLC.PSA.76.1.001" x-source="נוֹדָ֣ע" x-translit="nôḏāʿ" srcloc="WLC.PSA.76.1.001" x-head="true" lemma="יָדַע" strong="H3045">known</char>:</para>
