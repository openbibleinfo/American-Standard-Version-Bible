	<para style="q1"><char style="w" x-id="t009" x-align="PSA.32.11.a007" x-src="WLC.PSA.32.11.007" x-source="וְ֝" x-translit="wə" srcloc="WLC.PSA.32.11.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="PSA.32.11.a008" x-src="WLC.PSA.32.11.008" x-source="הַרְנִ֗ינוּ" x-translit="harniynû" srcloc="WLC.PSA.32.11.008" x-head="true" lemma="רָנַן" strong="H7442">shout</char> <char style="w" x-id="t011" x-align="PSA.32.11.a008">for</char> <char style="w" x-id="t012" x-align="PSA.32.11.a008">joy</char>, <char style="w" x-id="t013" x-align="PSA.32.11.a009" x-src="WLC.PSA.32.11.009" x-source="כָּל" x-translit="kol-" srcloc="WLC.PSA.32.11.009" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t014" x-align="PSA.32.11.a010">ye</char> <char style="w" x-id="t015" x-align="PSA.32.11.a010">that</char> <char style="w" x-id="t016" x-align="PSA.32.11.a010">are</char> <char style="w" x-id="t017" x-align="PSA.32.11.a010" x-src="WLC.PSA.32.11.010" x-source="יִשְׁרֵי" x-translit="yišrê-" srcloc="WLC.PSA.32.11.010" x-head="true" lemma="יָשָׁר" strong="H3477">upright</char> <char style="w" x-id="t018" x-align="PSA.32.11.a011">in</char> <char style="w" x-id="t019" x-align="PSA.32.11.a011" x-src="WLC.PSA.32.11.011" x-source="לֵֽב" x-translit="lēḇ:" srcloc="WLC.PSA.32.11.011" x-head="true" lemma="לֵב" strong="H3820">heart</char>.<verse eid="PSA 32:11" /></para>
	<chapter eid="PSA 32" />
	<chapter number="33" style="c" sid="PSA 33" />
	<para style="s1"><verse number="1" style="v" sid="PSA 33:1" />Praise to the Creator and Preserver.</para>
	<para style="q1"><char style="w" x-id="t001" x-align="PSA.33.1.a001" x-src="WLC.PSA.33.1.001" x-source="רַנְּנ֣וּ" x-translit="rannənû" srcloc="WLC.PSA.33.1.001" x-head="true" lemma="רָנַן" strong="H7442">Rejoice</char> <char style="w" x-id="t002" x-align="PSA.33.1.a003" x-src="WLC.PSA.33.1.003" x-source="בַּֽ" x-translit="ba" srcloc="WLC.PSA.33.1.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t003" x-align="PSA.33.1.a004" x-src="WLC.PSA.33.1.004" x-source="יהוָ֑ה" x-translit="yhwāh" srcloc="WLC.PSA.33.1.004" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t004" x-align="PSA.33.1.a002">O</char> <char style="w" x-id="t005" x-align="PSA.33.1.a002">ye</char> <char style="w" x-id="t006" x-align="PSA.33.1.a002" x-src="WLC.PSA.33.1.002" x-source="צַ֭דִּיקִים" x-translit="ṣaddîqîm" srcloc="WLC.PSA.33.1.002" x-head="true" lemma="צַדִּיק" strong="H6662">righteous</char>:</para>
