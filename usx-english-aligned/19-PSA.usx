	<para style="q1"><verse number="3" style="v" sid="PSA 15:3" /><note caller="-" style="f"><char style="ft">Or, <char style="it">He slandereth</char></char></note><char style="w" x-id="t001" x-align="PSA.15.3.a001">He</char> <char style="w" x-id="t002" x-align="PSA.15.3.a001">that</char> <char style="w" x-id="t003" x-align="PSA.15.3.a001" x-src="WLC.PSA.15.3.002" x-source="רָגַ֨ל" x-translit="rāḡal" srcloc="WLC.PSA.15.3.002" x-head="true" lemma="רָגַל" strong="H7270">slandereth</char> <char style="w" x-id="t004" x-align="PSA.15.3.a002" x-src="WLC.PSA.15.3.001" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.PSA.15.3.001" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t005" x-align="PSA.15.3.a003" x-src="WLC.PSA.15.3.003" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PSA.15.3.003" x-head="true" lemma="עַל" strong="H5921">with</char> <char style="w" x-id="t006" x-align="PSA.15.3.a005" x-src="WLC.PSA.15.3.005" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.15.3.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="PSA.15.3.a004" x-src="WLC.PSA.15.3.004" x-source="לְשֹׁנ֗" x-translit="ləšōn" srcloc="WLC.PSA.15.3.004" x-head="true" lemma="לָשׁוֹן" strong="H3956">tongue</char>,</para>
