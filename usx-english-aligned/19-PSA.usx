	<para style="q1"><char style="w" x-id="t019" x-align="PSA.39.12.a016" x-src="WLC.PSA.39.12.016" x-source="כִּ֤י" x-translit="kiy" srcloc="WLC.PSA.39.12.016" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t020" x-align="PSA.39.12.a018" x-src="WLC.PSA.39.12.018" x-source="אָנֹכִ֣י" x-translit="ʾānōḵiy" srcloc="WLC.PSA.39.12.018" x-head="true" lemma="אָנֹכִי" strong="H595">I</char> <char style="w" x-id="t021" x-align="PSA.39.12.a017">am</char> <char style="w" x-id="t022" x-align="PSA.39.12.a017">a</char> <char style="w" x-id="t023" x-align="PSA.39.12.a017" x-src="WLC.PSA.39.12.017" x-source="גֵ֣ר" x-translit="ḡēr" srcloc="WLC.PSA.39.12.017" x-head="true" lemma="גֵּר" strong="H1616">stranger</char> <char style="w" x-id="t024" x-align="PSA.39.12.a019" x-src="WLC.PSA.39.12.019" x-source="עִמָּ֑" x-translit="ʿimm" srcloc="WLC.PSA.39.12.019" x-head="true" lemma="עִם" strong="H5973">with</char> <char style="w" x-id="t025" x-align="PSA.39.12.a020" x-src="WLC.PSA.39.12.020" x-source="ךְ" x-translit="āḵ" srcloc="WLC.PSA.39.12.020" x-head="true" lemma="הוּא" strong="H3509c">thee</char>,</para>
	<para style="q1"><char style="w" x-id="t026" x-align="PSA.39.12.a021">A</char> <char style="w" x-id="t027" x-align="PSA.39.12.a021" x-src="WLC.PSA.39.12.021" x-source="תּ֝וֹשָׁ֗ב" x-translit="tôšāḇ" srcloc="WLC.PSA.39.12.021" x-head="true" lemma="תּוֹשָׁב" strong="H8453">sojourner</char>, <char style="w" x-id="t028" x-align="PSA.39.12.a022" x-src="WLC.PSA.39.12.022" x-source="כְּ" x-translit="kə" srcloc="WLC.PSA.39.12.022" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t029" x-align="PSA.39.12.a023" x-src="WLC.PSA.39.12.023" x-source="כָל" x-translit="ḵol-" srcloc="WLC.PSA.39.12.023" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t030" x-align="PSA.39.12.a025" x-src="WLC.PSA.39.12.025" x-source="י" x-translit="āy" srcloc="WLC.PSA.39.12.025" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t031" x-align="PSA.39.12.a024" x-src="WLC.PSA.39.12.024" x-source="אֲבוֹתָֽ" x-translit="ʾăḇôṯ" srcloc="WLC.PSA.39.12.024" x-head="true" lemma="אָב" strong="H1">fathers</char> <char style="w" x-id="t032" x-align="PSA.39.12.a024">were</char>.<verse eid="PSA 39:12" /></para>
	<para style="q1"><verse number="13" style="v" x-unrepresented-source="מִמֶּ֣ נִּי" x-unrepresented-translit="mimm enniy" x-unrepresented-src="WLC.PSA.39.13.002 WLC.PSA.39.13.011" sid="PSA 39:13" /><char style="w" x-id="t001" x-align="PSA.39.13.a001">Oh</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">look away from me</char></char></note><char style="w" x-id="t002" x-align="PSA.39.13.a001" x-src="WLC.PSA.39.13.001" x-source="הָשַׁ֣ע" x-translit="hāšaʿ" srcloc="WLC.PSA.39.13.001" x-head="true" lemma="שָׁעָה" strong="H8173">spare</char> <char style="w" x-id="t003" x-align="PSA.39.13.a003" x-src="WLC.PSA.39.13.003" x-source="נִּי" x-translit="enniy" srcloc="WLC.PSA.39.13.003" x-head="true" lemma="הוּא" strong="H2967a">me</char>, <char style="w" x-id="t004" x-align="PSA.39.13.a004" x-src="WLC.PSA.39.13.004" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.39.13.004" x-head="true" lemma="וְ" strong="H2050b">that</char> <char style="w" x-id="t005" x-align="PSA.39.13.a005">I</char> <char style="w" x-id="t006" x-align="PSA.39.13.a005">may</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">brighten up</char>.</char></note><char style="w" x-id="t007" x-align="PSA.39.13.a005" x-src="WLC.PSA.39.13.005" x-source="אַבְלִ֑יגָה" x-translit="ʾaḇliyḡâ" srcloc="WLC.PSA.39.13.005" x-head="true" lemma="בָּלַג" strong="H1082">recover</char> <char style="w" x-id="t008" x-align="PSA.39.13.a005">strength</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.39.13.a006" x-src="WLC.PSA.39.13.006 WLC.PSA.39.13.007" x-source="בְּ טֶ֖רֶם" x-translit="bə ṭerem" srcloc="WLC.PSA.39.13.007" x-head="true" lemma="טֶרֶם" strong="H2962">Before</char> <char style="w" x-id="t010" x-align="PSA.39.13.a007">I</char> <char style="w" x-id="t011" x-align="PSA.39.13.a007" x-src="WLC.PSA.39.13.008" x-source="אֵלֵ֣ךְ" x-translit="ʾēlēḵ" srcloc="WLC.PSA.39.13.008" x-head="true" lemma="הלך" strong="H1980">go</char> <char style="w" x-id="t012" x-align="PSA.39.13.a008" x-status="added" x-source="∅" x-head="true">hence</char>, <char style="w" x-id="t013" x-align="PSA.39.13.a009" x-src="WLC.PSA.39.13.009" x-source="וְ" x-translit="wə" srcloc="WLC.PSA.39.13.009" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t014" x-align="PSA.39.13.a010">be</char> <char style="w" x-id="t015" x-align="PSA.39.13.a010" x-src="WLC.PSA.39.13.010" x-source="אֵינֶֽ" x-translit="ʾēyn" srcloc="WLC.PSA.39.13.010" x-head="true" lemma="אַיִן" strong="H369">no</char> <char style="w" x-id="t016" x-align="PSA.39.13.a010">more</char>.<verse eid="PSA 39:13" /></para>
	<chapter eid="PSA 39" />
	<chapter number="40" style="c" sid="PSA 40" />
	<para style="s1"><verse number="1" style="v" sid="PSA 40:1" />A sacrifice of praise, and prayer for help.</para>
	<para style="d"><char style="w" x-id="t001" x-align="PSA.40.0.a001" x-src="WLC.PSA.40.0.001" x-source="לַ֝" x-translit="la" srcloc="WLC.PSA.40.0.001" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t002" x-align="PSA.40.0.a002" x-src="WLC.PSA.40.0.002" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.PSA.40.0.002" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t003" x-align="PSA.40.0.a003">Chief</char> <char style="w" x-id="t004" x-align="PSA.40.0.a003" x-src="WLC.PSA.40.0.003" x-source="מְנַצֵּ֗חַ" x-translit="mənaṣṣēᵃḥ" srcloc="WLC.PSA.40.0.003" x-head="true" lemma="נָצַח" strong="H5329">Musician</char>. <char style="w" x-id="t005" x-align="PSA.40.0.a006">A</char> <char style="w" x-id="t006" x-align="PSA.40.0.a006" x-src="WLC.PSA.40.0.006" x-source="מִזְמֽוֹר" x-translit="mizmôr:" srcloc="WLC.PSA.40.0.006" x-head="true" lemma="מִזְמוֹר" strong="H4210">Psalm</char> <char style="w" x-id="t007" x-align="PSA.40.0.a004" x-src="WLC.PSA.40.0.004" x-source="לְ" x-translit="lə" srcloc="WLC.PSA.40.0.004" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t008" x-align="PSA.40.0.a005" x-src="WLC.PSA.40.0.005" x-source="דָוִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.PSA.40.0.005" x-head="true" lemma="דָּוִד" strong="H1732">David</char>.</para>
