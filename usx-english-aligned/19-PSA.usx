	<para style="q1"><verse number="3" style="v" sid="PSA 90:3" /><char style="w" x-id="t001" x-align="PSA.90.3.a001">Thou</char> <char style="w" x-id="t002" x-align="PSA.90.3.a001" x-src="WLC.PSA.90.3.001" x-source="תָּשֵׁ֣ב" x-translit="tāšēḇ" srcloc="WLC.PSA.90.3.001" x-head="true" lemma="שׁוּב" strong="H7725">turnest</char> <char style="w" x-id="t003" x-align="PSA.90.3.a002" x-src="WLC.PSA.90.3.002" x-source="אֱ֭נוֹשׁ" x-translit="ʾĕnôš" srcloc="WLC.PSA.90.3.002" x-head="true" lemma="אֱנוֹשׁ" strong="H582">man</char> <char style="w" x-id="t004" x-align="PSA.90.3.a003" x-src="WLC.PSA.90.3.003" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.PSA.90.3.003" x-head="true" lemma="עַד" strong="H5704">to</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">dust</char>. Hebrew <char style="it">crushing</char>.</char></note><char style="w" x-id="t005" x-align="PSA.90.3.a004" x-src="WLC.PSA.90.3.004" x-source="דַּכָּ֑א" x-translit="dakkāʾ" srcloc="WLC.PSA.90.3.004" x-head="true" lemma="דַּכָּא" strong="H1793">destruction</char>,</para>
