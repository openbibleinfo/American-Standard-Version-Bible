	<chapter number="113" style="c" sid="PSA 113" />
	<para style="s1"><verse number="1" style="v" x-unrepresented-source="אֶת" x-unrepresented-translit="ʾeṯ-" x-unrepresented-src="WLC.PSA.113.1.007" sid="PSA 113:1" />Jehovah praised for exalting the humble.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Hallelujah</char>.</char></note><char style="w" x-id="t001" x-align="PSA.113.1.a001" x-src="WLC.PSA.113.1.001" x-source="הַ֥לְלוּ" x-translit="haləlû" srcloc="WLC.PSA.113.1.001" x-head="true" lemma="הָלַל" strong="H1984a">Praise</char> <char style="w" x-id="t002" x-align="PSA.113.1.a001">ye</char> <char style="w" x-id="t003" x-align="PSA.113.1.a002" x-src="WLC.PSA.113.1.002" x-source="יָ֨הּ" x-translit="yāhh" srcloc="WLC.PSA.113.1.002" x-head="true" lemma="יָהּ" strong="H3050">Jehovah</char>.</para>
