	<para style="q1"><verse number="12" style="v" sid="PSA 97:12" /><char style="w" x-id="t001" x-align="PSA.97.12.a001">Be</char> <char style="w" x-id="t002" x-align="PSA.97.12.a001" x-src="WLC.PSA.97.12.001" x-source="שִׂמְח֣וּ" x-translit="śimḥû" srcloc="WLC.PSA.97.12.001" x-head="true" lemma="שָׂמַח" strong="H8055">glad</char> <char style="w" x-id="t003" x-align="PSA.97.12.a003" x-src="WLC.PSA.97.12.003" x-source="בַּֽ" x-translit="ba" srcloc="WLC.PSA.97.12.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t004" x-align="PSA.97.12.a004" x-src="WLC.PSA.97.12.004" x-source="יהוָ֑ה" x-translit="yhwāh" srcloc="WLC.PSA.97.12.004" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t005" x-align="PSA.97.12.a002">ye</char> <char style="w" x-id="t006" x-align="PSA.97.12.a002" x-src="WLC.PSA.97.12.002" x-source="צַ֭דִּיקִים" x-translit="ṣaddîqîm" srcloc="WLC.PSA.97.12.002" x-head="true" lemma="צַדִּיק" strong="H6662">righteous</char>;</para>
