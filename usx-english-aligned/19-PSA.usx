	<para style="q1"><char style="w" x-id="t010" x-align="PSA.140.13.a008">The</char> <char style="w" x-id="t011" x-align="PSA.140.13.a008" x-src="WLC.PSA.140.13.008" x-source="יְ֝שָׁרִ֗ים" x-translit="yəšāriym" srcloc="WLC.PSA.140.13.008" x-head="true" lemma="יָשָׁר" strong="H3477">upright</char> <char style="w" x-id="t012" x-align="PSA.140.13.a007">shall</char> <char style="w" x-id="t013" x-align="PSA.140.13.a007" x-src="WLC.PSA.140.13.007" x-source="יֵשְׁב֥וּ" x-translit="yēšəḇû" srcloc="WLC.PSA.140.13.007" x-head="true" lemma="יָשַׁב" strong="H3427">dwell</char> <char style="w" x-id="t014" x-align="PSA.140.13.a009" x-src="WLC.PSA.140.13.009" x-source="אֶת" x-translit="ʾeṯ-" srcloc="WLC.PSA.140.13.009" x-head="true" lemma="אֵת" strong="H854">in</char> <char style="w" x-id="t015" x-align="PSA.140.13.a011" x-src="WLC.PSA.140.13.011" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.140.13.011" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t016" x-align="PSA.140.13.a010" x-src="WLC.PSA.140.13.010" x-source="פָּנֶֽי" x-translit="pāney" srcloc="WLC.PSA.140.13.010" x-head="true" lemma="פָּנֶה" strong="H6440">presence</char>.<verse eid="PSA 140:13" /></para>
