	<para style="q1"><char style="w" x-id="t014" x-align="PSA.1.1.a010" x-src="WLC.PSA.1.1.010 WLC.PSA.1.1.014" x-source="וּ לֹ֥א" x-translit="û lōʾ" srcloc="WLC.PSA.1.1.014" x-head="true" lemma="לֹא" strong="H3808">Nor</char> <char style="w" x-id="t015" x-align="PSA.1.1.a014" x-src="WLC.PSA.1.1.015" x-source="עָמָ֑ד" x-translit="ʿāmāḏ" srcloc="WLC.PSA.1.1.015" x-head="true" lemma="עָמַד" strong="H5975">standeth</char> <char style="w" x-id="t016" x-align="PSA.1.1.a011" x-src="WLC.PSA.1.1.011" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.1.1.011" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t017" x-align="PSA.1.1.a012">the</char> <char style="w" x-id="t018" x-align="PSA.1.1.a012" x-src="WLC.PSA.1.1.012" x-source="דֶ֣רֶךְ" x-translit="ḏereḵ" srcloc="WLC.PSA.1.1.012" x-head="true" lemma="דֶּרֶךְ" strong="H1870">way</char> <char style="w" x-id="t019" x-align="PSA.1.1.a013">of</char> <char style="w" x-id="t020" x-align="PSA.1.1.a013" x-src="WLC.PSA.1.1.013" x-source="חַ֭טָּאִים" x-translit="ḥaṭṭāʾîm" srcloc="WLC.PSA.1.1.013" x-head="true" lemma="חַטָּא" strong="H2400">sinners</char>,</para>
	<para style="q1"><char style="w" x-id="t021" x-align="PSA.1.1.a015" x-src="WLC.PSA.1.1.016 WLC.PSA.1.1.020" x-source="וּ לֹ֣א" x-translit="û lōʾ" srcloc="WLC.PSA.1.1.020" x-head="true" lemma="לֹא" strong="H3808">Nor</char> <char style="w" x-id="t022" x-align="PSA.1.1.a019" x-src="WLC.PSA.1.1.021" x-source="יָשָֽׁב" x-translit="yāšāḇ:" srcloc="WLC.PSA.1.1.021" x-head="true" lemma="יָשַׁב" strong="H3427">sitteth</char> <char style="w" x-id="t023" x-align="PSA.1.1.a016" x-src="WLC.PSA.1.1.017" x-source="בְ" x-translit="ḇə" srcloc="WLC.PSA.1.1.017" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t024" x-align="PSA.1.1.a017">the</char> <char style="w" x-id="t025" x-align="PSA.1.1.a017" x-src="WLC.PSA.1.1.018" x-source="מוֹשַׁ֥ב" x-translit="môšaḇ" srcloc="WLC.PSA.1.1.018" x-head="true" lemma="מוֹשָׁב" strong="H4186">seat</char> <char style="w" x-id="t026" x-align="PSA.1.1.a018">of</char> <char style="w" x-id="t027" x-align="PSA.1.1.a018" x-src="WLC.PSA.1.1.019" x-source="לֵ֝צִ֗ים" x-translit="lēṣiym" srcloc="WLC.PSA.1.1.019" x-head="true" lemma="לֵץ" strong="H3887a">scoffers</char>:<verse eid="PSA 1:1" /></para>
	<para style="q1"><verse number="2" style="v" sid="PSA 1:2" /><char style="w" x-id="t001" x-align="PSA.1.2.a001" x-src="WLC.PSA.1.2.001 WLC.PSA.1.2.002" x-source="כִּ֤י אִ֥ם" x-translit="kiy ʾim" srcloc="WLC.PSA.1.2.001" x-head="true" lemma="כִּי" strong="H3588">But</char> <char style="w" x-id="t002" x-align="PSA.1.2.a006" x-src="WLC.PSA.1.2.007" x-source="וֹ" x-translit="ô" srcloc="WLC.PSA.1.2.007" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t003" x-align="PSA.1.2.a005" x-src="WLC.PSA.1.2.006" x-source="חֶ֫פְצ֥" x-translit="ḥep̄ṣ" srcloc="WLC.PSA.1.2.006" x-head="true" lemma="חֵפֶץ" strong="H2656">delight</char> <char style="w" x-id="t004" x-align="PSA.1.2.a002">is</char> <char style="w" x-id="t005" x-align="PSA.1.2.a002" x-src="WLC.PSA.1.2.003" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.1.2.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t006" x-align="PSA.1.2.a003">the</char> <char style="w" x-id="t007" x-align="PSA.1.2.a003" x-src="WLC.PSA.1.2.004" x-source="תוֹרַ֥ת" x-translit="ṯôraṯ" srcloc="WLC.PSA.1.2.004" x-head="true" lemma="תּוֹרָה" strong="H8451">law</char> <char style="w" x-id="t008" x-align="PSA.1.2.a004">of</char> <char style="w" x-id="t009" x-align="PSA.1.2.a004" x-src="WLC.PSA.1.2.005" x-source="יְהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.PSA.1.2.005" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>;</para>
