	<para style="q1"><char style="w" x-id="t015" x-align="PSA.138.8.a014" x-src="WLC.PSA.138.8.014" x-source="תֶּֽרֶף" x-translit="terep̄:" srcloc="WLC.PSA.138.8.014" x-head="true" lemma="רָפָה" strong="H7503">Forsake</char> <char style="w" x-id="t016" x-align="PSA.138.8.a013" x-src="WLC.PSA.138.8.013" x-source="אַל" x-translit="ʾal-" srcloc="WLC.PSA.138.8.013" x-head="true" lemma="אַל" strong="H408">not</char> <char style="w" x-id="t017" x-align="PSA.138.8.a010">the</char> <char style="w" x-id="t018" x-align="PSA.138.8.a010" x-src="WLC.PSA.138.8.010" x-source="מַעֲשֵׂ֖י" x-translit="maʿăśēy" srcloc="WLC.PSA.138.8.010" x-head="true" lemma="מַעֲשֶׂה" strong="H4639">works</char> <char style="w" x-id="t019" x-align="PSA.138.8.a011">of</char> <char style="w" x-id="t020" x-align="PSA.138.8.a012" x-src="WLC.PSA.138.8.012" x-source="ךָ" x-translit="ḵā" srcloc="WLC.PSA.138.8.012" x-head="true" lemma="הוּא" strong="H3509b">thine</char> <char style="w" x-id="t021" x-align="PSA.138.8.a012">own</char> <char style="w" x-id="t022" x-align="PSA.138.8.a011" x-src="WLC.PSA.138.8.011" x-source="יָדֶ֣י" x-translit="yāḏey" srcloc="WLC.PSA.138.8.011" x-head="true" lemma="יָד" strong="H3027">hands</char>.<verse eid="PSA 138:8" /></para>
	<chapter eid="PSA 138" />
	<chapter number="139" style="c" sid="PSA 139" />
	<para style="s1"><verse number="1" style="v" sid="PSA 139:1" />God’s omnipresence and omniscience.</para>
