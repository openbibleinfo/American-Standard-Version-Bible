	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Who will lead me etc.</char></char></note><char style="w" x-id="t009" x-align="PSA.60.9.a006" x-src="WLC.PSA.60.9.006" x-source="מִ֖י" x-translit="miy" srcloc="WLC.PSA.60.9.006" x-head="true" lemma="מִי" strong="H4310">Who</char> <char style="w" x-id="t010" x-align="PSA.60.9.a007">hath</char> <char style="w" x-id="t011" x-align="PSA.60.9.a007" x-src="WLC.PSA.60.9.007" x-source="נָחַ֣" x-translit="nāḥ" srcloc="WLC.PSA.60.9.007" x-head="true" lemma="נָחָה" strong="H5148">led</char> <char style="w" x-id="t012" x-align="PSA.60.9.a008" x-src="WLC.PSA.60.9.008" x-source="נִי" x-translit="aniy" srcloc="WLC.PSA.60.9.008" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t013" x-align="PSA.60.9.a009" x-src="WLC.PSA.60.9.009" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.PSA.60.9.009" x-head="true" lemma="עַד" strong="H5704">unto</char> <char style="w" x-id="t014" x-align="PSA.60.9.a010" x-src="WLC.PSA.60.9.010" x-source="אֱדֽוֹם" x-translit="ʾĕḏôm:" srcloc="WLC.PSA.60.9.010" x-head="true" lemma="אֱדוֹם" strong="H123">Edom</char>?<verse eid="PSA 60:9" /></para>
	<para style="q1"><verse number="10" style="v" sid="PSA 60:10" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Wilt not thou, O God, who hast cast us off, And goest . . . hosts?</char></char></note><char style="w" x-id="t001" x-align="PSA.60.10.a001" x-src="WLC.PSA.60.10.001" x-source="הֲ" x-translit="hă" srcloc="WLC.PSA.60.10.001" x-head="true" lemma="הֲ" strong="H1886b">Hast</char> <char style="w" x-id="t002" x-align="PSA.60.10.a002" x-src="WLC.PSA.60.10.002" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.PSA.60.10.002" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t003" x-align="PSA.60.10.a003" x-src="WLC.PSA.60.10.003" x-source="אַתָּ֣ה" x-translit="ʾattāh" srcloc="WLC.PSA.60.10.003" x-head="true" lemma="אַתָּה" strong="H859">thou</char>, <char style="w" x-id="t004" x-align="PSA.60.10.a004">O</char> <char style="w" x-id="t005" x-align="PSA.60.10.a004" x-src="WLC.PSA.60.10.004" x-source="אֱלֹהִ֣ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.60.10.004" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t006" x-align="PSA.60.10.a005" x-src="WLC.PSA.60.10.005" x-source="זְנַחְתָּ֑" x-translit="zənaḥtā" srcloc="WLC.PSA.60.10.005" x-head="true" lemma="זָנַח" strong="H2186">cast</char> <char style="w" x-id="t007" x-align="PSA.60.10.a006" x-src="WLC.PSA.60.10.006" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.60.10.006" x-head="true" lemma="הוּא" strong="H5105a">us</char> <char style="w" x-id="t008" x-align="PSA.60.10.a005">off</char>?</para>
	<para style="q1"><char style="w" x-id="t009" x-align="PSA.60.10.a007" x-src="WLC.PSA.60.10.007" x-source="וְֽ" x-translit="wə" srcloc="WLC.PSA.60.10.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="PSA.60.10.a008">thou</char> <char style="w" x-id="t011" x-align="PSA.60.10.a008" x-src="WLC.PSA.60.10.009" x-source="תֵצֵ֥א" x-translit="ṯēṣēʾ" srcloc="WLC.PSA.60.10.009" x-head="true" lemma="יָצָא" strong="H3318">goest</char> <char style="w" x-id="t012" x-align="PSA.60.10.a009" x-src="WLC.PSA.60.10.008" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.PSA.60.10.008" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t013" x-align="PSA.60.10.a008">forth</char>, <char style="w" x-id="t014" x-align="PSA.60.10.a010">O</char> <char style="w" x-id="t015" x-align="PSA.60.10.a010" x-src="WLC.PSA.60.10.010" x-source="אֱ֝לֹהִ֗ים" x-translit="ʾĕlōhiym" srcloc="WLC.PSA.60.10.010" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>, <char style="w" x-id="t016" x-align="PSA.60.10.a011" x-src="WLC.PSA.60.10.011" x-source="בְּ" x-translit="bə" srcloc="WLC.PSA.60.10.011" x-head="true" lemma="בְּ" strong="H871a">with</char> <char style="w" x-id="t017" x-align="PSA.60.10.a012" x-src="WLC.PSA.60.10.013" x-source="נוּ" x-translit="nû" srcloc="WLC.PSA.60.10.013" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t018" x-align="PSA.60.10.a013" x-src="WLC.PSA.60.10.012" x-source="צִבְאוֹתֵֽי" x-translit="ṣiḇʾôṯēy" srcloc="WLC.PSA.60.10.012" x-head="true" lemma="צָבָא" strong="H6635">hosts</char>.<verse eid="PSA 60:10" /></para>
