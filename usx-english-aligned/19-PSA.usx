	<para style="q1"><verse number="9" style="v" sid="PSA 47:9" /><char style="w" x-id="t001" x-align="PSA.47.9.a001">The</char> <char style="w" x-id="t002" x-align="PSA.47.9.a001" x-src="WLC.PSA.47.9.001" x-source="נְדִ֘יבֵ֤י" x-translit="nəḏiyḇēy" srcloc="WLC.PSA.47.9.001" x-head="true" lemma="נָדִיב" strong="H5081">princes</char> <char style="w" x-id="t003" x-align="PSA.47.9.a002">of</char> <char style="w" x-id="t004" x-align="PSA.47.9.a002">the</char> <char style="w" x-id="t005" x-align="PSA.47.9.a002" x-src="WLC.PSA.47.9.002" x-source="עַמִּ֨ים" x-translit="ʿammiym" srcloc="WLC.PSA.47.9.002" x-head="true" lemma="עַם" strong="H5971">peoples</char> <char style="w" x-id="t006" x-align="PSA.47.9.a003">are</char> <char style="w" x-id="t007" x-align="PSA.47.9.a003" x-src="WLC.PSA.47.9.003" x-source="נֶאֱסָ֗פוּ" x-translit="neʾĕsāp̄û" srcloc="WLC.PSA.47.9.003" x-head="true" lemma="אָסַף" strong="H622">gathered</char> <char style="w" x-id="t008" x-align="PSA.47.9.a003">together</char></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, Unto <char style="it">the people</char></char></note><char style="add"><char style="w" x-id="t009" x-align="PSA.47.9.a004">To</char> <char style="w" x-id="t010" x-align="PSA.47.9.a004">be</char></char> <char style="w" x-id="t011" x-align="PSA.47.9.a004">the</char> <char style="w" x-id="t012" x-align="PSA.47.9.a004" x-src="WLC.PSA.47.9.004" x-source="עַם֮" x-translit="ʿam" srcloc="WLC.PSA.47.9.004" x-head="true" lemma="עַם" strong="H5971">people</char> <char style="w" x-id="t013" x-align="PSA.47.9.a005">of</char> <char style="w" x-id="t014" x-align="PSA.47.9.a005">the</char> <char style="w" x-id="t015" x-align="PSA.47.9.a005" x-src="WLC.PSA.47.9.005" x-source="אֱלֹהֵ֪י" x-translit="ʾĕlōhēy" srcloc="WLC.PSA.47.9.005" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t016" x-align="PSA.47.9.a006">of</char> <char style="w" x-id="t017" x-align="PSA.47.9.a006" x-src="WLC.PSA.47.9.006" x-source="אַבְרָ֫הָ֥ם" x-translit="ʾaḇrāhām" srcloc="WLC.PSA.47.9.006" x-head="true" lemma="אַבְרָהָם" strong="H85">Abraham</char>;</para>
	<para style="q1"><char style="w" x-id="t018" x-align="PSA.47.9.a007" x-src="WLC.PSA.47.9.007" x-source="כִּ֣י" x-translit="kiy" srcloc="WLC.PSA.47.9.007" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t019" x-align="PSA.47.9.a010">the</char> <char style="w" x-id="t020" x-align="PSA.47.9.a010" x-src="WLC.PSA.47.9.010" x-source="מָֽגִנֵּי" x-translit="māḡinnê-" srcloc="WLC.PSA.47.9.010" x-head="true" lemma="מָגֵן" strong="H4043">shields</char> <char style="w" x-id="t021" x-align="PSA.47.9.a011">of</char> <char style="w" x-id="t022" x-align="PSA.47.9.a011">the</char> <char style="w" x-id="t023" x-align="PSA.47.9.a011" x-src="WLC.PSA.47.9.011" x-source="אֶ֗רֶץ" x-translit="ʾereṣ" srcloc="WLC.PSA.47.9.011" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char> <char style="w" x-id="t024" x-align="PSA.47.9.a008">belong</char> <char style="w" x-id="t025" x-align="PSA.47.9.a008" x-src="WLC.PSA.47.9.008" x-source="לֵֽ֭" x-translit="lē" srcloc="WLC.PSA.47.9.008" x-head="true" lemma="לְ" strong="H3807a">unto</char> <char style="w" x-id="t026" x-align="PSA.47.9.a009" x-src="WLC.PSA.47.9.009" x-source="אלֹהִים" x-translit="ʾlōhîm" srcloc="WLC.PSA.47.9.009" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>:</para>
	<para style="q1"><char style="w" x-id="t027" x-align="PSA.47.9.a013">He</char> <char style="w" x-id="t028" x-align="PSA.47.9.a013">is</char> <char style="w" x-id="t029" x-align="PSA.47.9.a012" x-src="WLC.PSA.47.9.012" x-source="מְאֹ֣ד" x-translit="məʾōḏ" srcloc="WLC.PSA.47.9.012" x-head="true" lemma="מְאֹד" strong="H3966">greatly</char> <char style="w" x-id="t030" x-align="PSA.47.9.a013" x-src="WLC.PSA.47.9.013" x-source="נַעֲלָֽה" x-translit="naʿălāh:" srcloc="WLC.PSA.47.9.013" x-head="true" lemma="עָלָה" strong="H5927">exalted</char>.<verse eid="PSA 47:9" /></para>
