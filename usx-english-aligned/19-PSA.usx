	<para style="q1"><char style="w" x-id="t007" x-align="PSA.133.1.a006" x-src="WLC.PSA.133.1.006" x-source="הִנֵּ֣ה" x-translit="hinnēh" srcloc="WLC.PSA.133.1.006" x-head="true" lemma="הִנֵּה" strong="H2009">Behold</char>, <char style="w" x-id="t008" x-align="PSA.133.1.a007" x-src="WLC.PSA.133.1.007" x-source="מַה" x-translit="mah-" srcloc="WLC.PSA.133.1.007" x-head="true" lemma="מָה" strong="H4100">how</char> <char style="w" x-id="t009" x-align="PSA.133.1.a008" x-src="WLC.PSA.133.1.008" x-source="טּ֭וֹב" x-translit="ṭṭôḇ" srcloc="WLC.PSA.133.1.008" x-head="true" lemma="טוֹב" strong="H2896">good</char> <char style="w" x-id="t010" x-align="PSA.133.1.a009" x-src="WLC.PSA.133.1.009" x-source="וּ" x-translit="û" srcloc="WLC.PSA.133.1.009" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t011" x-align="PSA.133.1.a010" x-src="WLC.PSA.133.1.010" x-source="מַה" x-translit="mah-" srcloc="WLC.PSA.133.1.010" x-head="true" lemma="מָה" strong="H4100">how</char> <char style="w" x-id="t012" x-align="PSA.133.1.a011" x-src="WLC.PSA.133.1.011" x-source="נָּעִ֑ים" x-translit="nnāʿiym" srcloc="WLC.PSA.133.1.011" x-head="true" lemma="נָעִים" strong="H5273">pleasant</char> <char style="w" x-id="t013" x-align="PSA.133.1.a012" x-status="added" x-source="∅" x-head="true">it</char> <char style="w" x-id="t014" x-align="PSA.133.1.a011">is</char></para>
	<para style="q1"><char style="w" x-id="t015" x-align="PSA.133.1.a013">For</char> <char style="w" x-id="t016" x-align="PSA.133.1.a014" x-src="WLC.PSA.133.1.013" x-source="אַחִ֣ים" x-translit="ʾaḥiym" srcloc="WLC.PSA.133.1.013" x-head="true" lemma="אָח" strong="H251">brethren</char> <char style="w" x-id="t017" x-align="PSA.133.1.a013">to</char> <char style="w" x-id="t018" x-align="PSA.133.1.a013" x-src="WLC.PSA.133.1.012" x-source="שֶׁ֖בֶת" x-translit="šeḇeṯ" srcloc="WLC.PSA.133.1.012" x-head="true" lemma="יָשַׁב" strong="H3427">dwell</char> <char style="w" x-id="t019" x-align="PSA.133.1.a016" x-src="WLC.PSA.133.1.015" x-source="יָֽחַד" x-translit="yāḥaḏ:" srcloc="WLC.PSA.133.1.015" x-head="true" lemma="יַחַד" strong="H3162">together</char> <char style="w" x-id="t020" x-align="PSA.133.1.a016">in</char> <char style="w" x-id="t021" x-align="PSA.133.1.a016">unity</char>!<verse eid="PSA 133:1" /></para>
