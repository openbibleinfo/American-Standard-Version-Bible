	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="PSA 118:6">Ps. 118:6</ref>.</char></note><char style="w" x-id="t008" x-align="HEB.13.6.a005">The</char> <char style="w" x-id="t009" x-align="HEB.13.6.a005" x-src="SBLGNT.HEB.13.6.005" x-source="Κύριος" x-translit="Kyrios" srcloc="SBLGNT.HEB.13.6.005" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t010" x-align="HEB.13.6.a007">is</char> <char style="w" x-id="t011" x-align="HEB.13.6.a006" x-src="SBLGNT.HEB.13.6.006" x-source="ἐμοὶ" x-translit="emoi" srcloc="SBLGNT.HEB.13.6.006" x-head="true" lemma="ἐγώ" strong="G1698">my</char> <char style="w" x-id="t012" x-align="HEB.13.6.a007" x-src="SBLGNT.HEB.13.6.007" x-source="βοηθός" x-translit="boēthos" srcloc="SBLGNT.HEB.13.6.007" x-head="true" lemma="βοηθός" strong="G998">helper</char>; <char style="w" x-id="t013" x-align="HEB.13.6.a009">I</char> <char style="w" x-id="t014" x-align="HEB.13.6.a009">will</char> <char style="w" x-id="t015" x-align="HEB.13.6.a008" x-src="SBLGNT.HEB.13.6.008" x-source="οὐ" x-translit="ou" srcloc="SBLGNT.HEB.13.6.008" x-head="true" lemma="οὐ" strong="G3756">not</char> <char style="w" x-id="t016" x-align="HEB.13.6.a009" x-src="SBLGNT.HEB.13.6.009" x-source="φοβηθήσομαι" x-translit="phobēthēsomai" srcloc="SBLGNT.HEB.13.6.009" x-head="true" lemma="φοβέομαι" strong="G5399">fear</char>:</para>
	<para style="q1"><char style="w" x-id="t017" x-align="HEB.13.6.a010" x-src="SBLGNT.HEB.13.6.010" x-source="τί" x-translit="ti" srcloc="SBLGNT.HEB.13.6.010" x-head="true" lemma="τίς" strong="G5101">What</char> <char style="w" x-id="t018" x-align="HEB.13.6.a011">shall</char> <char style="w" x-id="t019" x-align="HEB.13.6.a013" x-src="SBLGNT.HEB.13.6.013" x-source="ἄνθρωπος" x-translit="anthrōpos" srcloc="SBLGNT.HEB.13.6.013" x-head="true" lemma="ἄνθρωπος" strong="G444">man</char> <char style="w" x-id="t020" x-align="HEB.13.6.a011" x-src="SBLGNT.HEB.13.6.011" x-source="ποιήσει" x-translit="poiēsei" srcloc="SBLGNT.HEB.13.6.011" x-head="true" lemma="ποιέω" strong="G4160">do</char> <char style="w" x-id="t021" x-align="HEB.13.6.a012">unto</char> <char style="w" x-id="t022" x-align="HEB.13.6.a012" x-src="SBLGNT.HEB.13.6.012" x-source="μοι" x-translit="moi" srcloc="SBLGNT.HEB.13.6.012" x-head="true" lemma="ἐγώ" strong="G3427">me</char>?<verse eid="HEB 13:6" /></para>
	<para style="p"><verse number="7" style="v" x-unrepresented-source="τοῦ τῆς" x-unrepresented-translit="tou tēs" x-unrepresented-src="SBLGNT.HEB.13.7.010 SBLGNT.HEB.13.7.016" sid="HEB 13:7" /><char style="w" x-id="t001" x-align="HEB.13.7.a001" x-src="SBLGNT.HEB.13.7.001" x-source="Μνημονεύετε" x-translit="Mnēmoneuete" srcloc="SBLGNT.HEB.13.7.001" x-head="true" lemma="μνημονεύω" strong="G3421">Remember</char> <char style="w" x-id="t002" x-align="HEB.13.7.a002" x-src="SBLGNT.HEB.13.7.002" x-source="τῶν" x-translit="tōn" srcloc="SBLGNT.HEB.13.7.002" x-head="true" lemma="ὁ" strong="G3588">them</char> <char style="w" x-id="t003" x-align="HEB.13.7.a003">that</char> <char style="w" x-id="t004" x-align="HEB.13.7.a003">had</char> <char style="w" x-id="t005" x-align="HEB.13.7.a003">the</char> <char style="w" x-id="t006" x-align="HEB.13.7.a003" x-src="SBLGNT.HEB.13.7.003" x-source="ἡγουμένων" x-translit="hēgoumenōn" srcloc="SBLGNT.HEB.13.7.003" x-head="true" lemma="ἡγέομαι" strong="G2233">rule</char> <char style="w" x-id="t007" x-align="HEB.13.7.a004">over</char> <char style="w" x-id="t008" x-align="HEB.13.7.a004" x-src="SBLGNT.HEB.13.7.004" x-source="ὑμῶν" x-translit="hymōn" srcloc="SBLGNT.HEB.13.7.004" x-head="true" lemma="σύ" strong="G5216">you</char>, <char style="w" x-id="t009" x-align="HEB.13.7.a005" x-src="SBLGNT.HEB.13.7.005" x-source="οἵτινες" x-translit="hoitines" srcloc="SBLGNT.HEB.13.7.005" x-head="true" lemma="ὅστις" strong="G3748">men</char> <char style="w" x-id="t010" x-align="HEB.13.7.a005">that</char> <char style="w" x-id="t011" x-align="HEB.13.7.a006" x-src="SBLGNT.HEB.13.7.006" x-source="ἐλάλησαν" x-translit="elalēsan" srcloc="SBLGNT.HEB.13.7.006" x-head="true" lemma="λαλέω" strong="G2980">spake</char> <char style="w" x-id="t012" x-align="HEB.13.7.a007">unto</char> <char style="w" x-id="t013" x-align="HEB.13.7.a007" x-src="SBLGNT.HEB.13.7.007" x-source="ὑμῖν" x-translit="hymin" srcloc="SBLGNT.HEB.13.7.007" x-head="true" lemma="σύ" strong="G5213">you</char> <