	<para style="m"><verse number="6" style="v" sid="HEB 1:6" /><note caller="-" style="f"><char style="ft">Or, <char style="it">And again, when he bringeth in</char></char></note><char style="w" x-id="t001" x-align="HEB.1.6.a002" x-src="SBLGNT.HEB.1.6.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.HEB.1.6.002" x-head="true" lemma="δέ" strong="G1161">And</char> <char style="w" x-id="t002" x-align="HEB.1.6.a001" x-src="SBLGNT.HEB.1.6.001" x-source="ὅταν" x-translit="hotan" srcloc="SBLGNT.HEB.1.6.001" x-head="true" lemma="ὅταν" strong="G3752">when</char> <char style="w" x-id="t003" x-align="HEB.1.6.a004">he</char> <char style="w" x-id="t004" x-align="HEB.1.6.a003" x-src="SBLGNT.HEB.1.6.003" x-source="πάλιν" x-translit="palin" srcloc="SBLGNT.HEB.1.6.003" x-head="true" lemma="πάλιν" strong="G3825">again</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">shall have brought in</char></char></note><char style="w" x-id="t005" x-align="HEB.1.6.a004" x-src="SBLGNT.HEB.1.6.004" x-source="εἰσαγάγῃ" x-translit="eisagagēi" srcloc="SBLGNT.HEB.1.6.004" x-head="true" lemma="εἰσάγω" strong="G1521">bringeth</char> <char style="w" x-id="t006" x-align="HEB.1.6.a004">in</char> <char style="w" x-id="t007" x-align="HEB.1.6.a005" x-src="SBLGNT.HEB.1.6.005" x-source="τὸν" x-translit="ton" srcloc="SBLGNT.HEB.1.6.005" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t008" x-align="HEB.1.6.a006" x-src="SBLGNT.HEB.1.6.006" x-source="πρωτότοκον" x-translit="prōtotokon" srcloc="SBLGNT.HEB.1.6.006" x-head="true" lemma="πρωτότοκος" strong="G4416">firstborn</char> <char style="w" x-id="t009" x-align="HEB.1.6.a007" x-src="SBLGNT.HEB.1.6.007" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.HEB.1.6.007" x-head="true" lemma="εἰς" strong="G1519">into</char> <note caller="-" style="f"><char style="ft">Greek <char style="it">the inhabited earth</char>.</char></note><char style="w" x-id="t010" x-align="HEB.1.6.a008" x-src="SBLGNT.HEB.1.6.008" x-source="τὴν" x-transl