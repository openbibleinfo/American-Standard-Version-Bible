	<para style="q1"><verse number="7" style="v" x-unrepresented-source="τῶν" x-unrepresented-translit="tōn" x-unrepresented-src="SBLGNT.HEB.2.7.v002.r01.007" sid="HEB 2:7" /><char style="w" x-id="t001" x-align="HEB.2.7.a001">Thou</char> <char style="w" x-id="t002" x-align="HEB.2.7.a001">madest</char> <char style="w" x-id="t003" x-align="HEB.2.7.a002" x-src="SBLGNT.HEB.2.7.002" x-source="αὐτὸν" x-translit="auton" srcloc="SBLGNT.HEB.2.7.002" x-head="true" lemma="αὐτός" strong="G846">him</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">for a little while lower</char></char></note><char style="w" x-id="t004" x-align="HEB.2.7.a003" x-src="SBLGNT.HEB.2.7.004" x-source="τι" x-translit="ti" srcloc="SBLGNT.HEB.2.7.004" x-head="true" lemma="τις" strong="G5100">a</char> <char style="w" x-id="t005" x-align="HEB.2.7.a004" x-src="SBLGNT.HEB.2.7.003" x-source="βραχύ" x-translit="brachy" srcloc="SBLGNT.HEB.2.7.003" x-head="true" lemma="βραχύ" strong="G1024">little</char> <char style="w" x-id="t006" x-align="HEB.2.7.a001" x-src="SBLGNT.HEB.2.7.001" x-source="ἠλάττωσας" x-translit="ēlattōsas" srcloc="SBLGNT.HEB.2.7.001" x-head="true" lemma="ἐλαττόω" strong="G1642">lower</char> <char style="w" x-id="t007" x-align="HEB.2.7.a005" x-src="SBLGNT.HEB.2.7.005" x-source="παρ" x-translit="par" srcloc="SBLGNT.HEB.2.7.005" x-head="true" lemma="παρά" strong="G3844">than</char> <char style="w" x-id="t008" x-align="HEB.2.7.a006">the</char> <char style="w" x-id="t009" x-align="HEB.2.7.a006" x-src="SBLGNT.HEB.2.7.006" x-source="ἀγγέλους" x-translit="angelous" srcloc="SBLGNT.HEB.2.7.006" x-head="true" lemma="ἄγγελος" strong="G32">angels</char>;</para>
	<para style="q1"><char style="w" x-id="t010" x-align="HEB.2.7.a007">Thou</char> <char style="w" x-id="t011" x-align="HEB.2.7.a007" x-src="SBLGNT.HEB.2.7.010" x-source="ἐστεφάνωσας" x-translit="estephanōsas" srcloc="SBLGNT.HEB.2.7.010" x-head="true" lemma="στεφανόω" strong="G4737">crownedst</char> <char style="w" x-id="t012" x-align="HEB.2.7.a008" x-src="SBLGNT.HEB.2.7.011" x-source="αὐτόν" x-translit="auton" srcloc="SBLGNT.HEB.2.7.011" x-head="true" lemma="αὐτός" strong="G846">him</char> <char style="w" x-id="t013" x-align="HEB.2.7.a009">with</char> <char style="w" x-id="t014" x-align="HEB.2.7.a009" x-src="SBLGNT.HEB.2.7.007" x-source="δόξῃ" x-translit="doxēi" srcloc="SBLGNT.HEB.2.7.007" x-head="true" lemma="δόξα" strong="G1391">glory</char> <char style="w" x-id="t015" x-align="HEB.2.7.a010" x-src="SBLGNT.HEB.2.7.008" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.HEB.2.7.008" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t016" x-align="HEB.2.7.a011" x-src="SBLGNT.HEB.2.7.009" x-source="τιμῇ" x-translit="timēi" srcloc="SBLGNT.HEB.2.7.009" x-head="true" lemma="τιμή" strong="G5092">honor</char>,</para>
