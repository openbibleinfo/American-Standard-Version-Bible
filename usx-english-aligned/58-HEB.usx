	<para style="q1"><char style="w" x-id="t012" x-align="HEB.1.7.a013" x-src="SBLGNT.HEB.1.7.013" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.HEB.1.7.013" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t013" x-align="HEB.1.7.a016" x-src="SBLGNT.HEB.1.7.016" x-source="αὐτοῦ" x-translit="autou" srcloc="SBLGNT.HEB.1.7.016" x-head="true" lemma="αὐτός" strong="G846">his</char> <char style="w" x-id="t014" x-align="HEB.1.7.a015" x-src="SBLGNT.HEB.1.7.015" x-source="λειτουργοὺς" x-translit="leitourgous" srcloc="SBLGNT.HEB.1.7.015" x-head="true" lemma="λειτουργός" strong="G3011">ministers</char> <char style="w" x-id="t015" x-align="HEB.1.7.a018">a</char> <char style="w" x-id="t016" x-align="HEB.1.7.a018" x-src="SBLGNT.HEB.1.7.018" x-source="φλόγα" x-translit="phloga" srcloc="SBLGNT.HEB.1.7.018" x-head="true" lemma="φλόξ" strong="G5395">flame</char> <char style="w" x-id="t017" x-align="HEB.1.7.a017">of</char> <char style="w" x-id="t018" x-align="HEB.1.7.a017" x-src="SBLGNT.HEB.1.7.017" x-source="πυρὸς" x-translit="pyros" srcloc="SBLGNT.HEB.1.7.017" x-head="true" lemma="πῦρ" strong="G4442">fire</char>:<verse eid="HEB 1:7" /></para>
	<para style="m"><verse number="8" style="v" x-unrepresented-source="Ὁ τὸν τοῦ τῆς τῆς" x-unrepresented-translit="Ho ton tou tēs tēs" x-unrepresented-src="SBLGNT.HEB.1.8.005 SBLGNT.HEB.1.8.011 SBLGNT.HEB.1.8.013 SBLGNT.HEB.1.8.018 SBLGNT.HEB.1.8.021" sid="HEB 1:8" /><char style="w" x-id="t001" x-align="HEB.1.8.a002" x-src="SBLGNT.HEB.1.8.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.HEB.1.8.002" x-head="true" lemma="δέ" strong="G1161">but</char> <char style="w" x-id="t002" x-align="HEB.1.8.a001" x-src="SBLGNT.HEB.1.8.001" x-source="πρὸς" x-translit="pros" srcloc="SBLGNT.HEB.1.8.001" x-head="true" lemma="πρός" strong="G4314">of</char> <char style="w" x-id="t003" x-align="HEB.1.8.a003" x-src="SBLGNT.HEB.1.8.003" x-source="τὸν" x-translit="ton" srcloc="SBLGNT.HEB.1.8.003" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t004" x-align="HEB.1.8.a004" x-src="SBLGNT.HEB.1.8.004" x-source="υἱόν" x-translit="huion" srcloc="SBLGNT.HEB.1.8.004" x-head="true" lemma="υἱός" strong="G5207">Son</char> <char style="add"><char style="w" x-id="t005" x-align="HEB.1.8.a005" x-status="added">he</char> <char style="w" x-id="t006" x-align="HEB.1.8.a005" x-status="added" x-source="∅" x-head="true">saith</char></char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="PSA 45:6-45:17">Ps. 45:6f</ref>.</char></note><note caller="-" style="f"><char style="ft">Or, <char style="it">Thy throne is God for etc.</char></char></note><char style="w" x-id="t007" x-align="HEB.1.8.a008" x-src="SBLGNT.HEB.1.8.007" x-source="σου" x-translit="sou" srcloc="SBLGNT.HEB.1.8.007" x-head="true" lemma="σύ" strong="G4675">Thy</char> <char style="w" x-id="t008" x-align="HEB.1.8.a007" x-src="SBLGNT.HEB.1.8.006" x-source="θρόνος" x-translit="thronos" srcloc="SBLGNT.HEB.1.8.006" x-head="true" lemma="θρόνος" strong="G2362">throne</char>, <char style="w" x-id="t009" x-align="HEB.1.8.a009" x-src="SBLGNT.HEB.1.8.008" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.HEB.1.8.008" x-head="true" lemma="ὁ" strong="G3588">O</char> <char style="w" x-id="t010" x-align="HEB.1.8.a010" x-src="SBLGNT.HEB.1.8.009" x-source="θεὸς" x-translit="theos" srcloc="SBLGNT.HEB.1.8.009" x-head="true" lemma="θεός" strong="G2316">God</char>, <char style="w" x-id="t011" x-align="HEB.1.8.a011">is</char> <char style="w" x-id="t012" x-align="HEB.1.8.a011" x-src="SBLGNT.HEB.1.8.010" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.HEB.1.8.010" x-head="true" lemma="εἰς" strong="G1519">for</char> <char style="w" x-id="t013" x-align="HEB.1.8.a013" x-src="SBLGNT.HEB.1.8.012" x-source="αἰῶνα" x-translit="aiōna" srcloc="SBLGNT.HEB.1.8.012" x-head="true" lemma="αἰών" strong="G165">ever</char> <char style="w" x-id="t014" x-align="HEB.1.8.a015">and</char> <char style="w" x-id="t015" x-align="HEB.1.8.a015" x-src="SBLGNT.HEB.1.8.014" x-source="αἰῶνος" x-translit="aiōnos" srcloc="SBLGNT.HEB.1.8.014" x-head="true" lemma="αἰών" strong="G165">ever</char>;</para>
	<para style="q1"><char style="w" x-id="t016" x-align="HEB.1.8.a016" x-src="SBLGNT.HEB.1.8.015" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.HEB.1.8.015" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t017" x-align="HEB.1.8.a017" x-src="SBLGNT.HEB.1.8.016" x-source="ἡ" x-translit="hē" srcloc="SBLGNT.HEB.1.8.016" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t018" x-align="HEB.1.8.a018" x-src="SBLGNT.HEB.1.8.017" x-source="ῥάβδος" x-translit="rhabdos" srcloc="SBLGNT.HEB.1.8.017" x-head="true" lemma="ῥάβδος" strong="G4464">sceptre</char> <char style="w" x-id="t019" x-align="HEB.1.8.a020">of</char> <char style="w" x-id="t020" x-align="HEB.1.8.a020" x-src="SBLGNT.HEB.1.8.019" x-source="εὐθύτητος" x-translit="euthytētos" srcloc="SBLGNT.HEB.1.8.019" x-head="true" lemma="εὐθύτης" strong="G2118">uprightness</char> <char style="w" x-id="t021" x-align="HEB.1.8.a021">is</char> <char style="w" x-id="t022" x-align="HEB.1.8.a021">the</char> <char style="w" x-id="t023" x-align="HEB.1.8.a021" x-src="SBLGNT.HEB.1.8.020" x-source="ῥάβδος" x-translit="rhabdos" srcloc="SBLGNT.HEB.1.8.020" x-head="true" lemma="ῥάβδος" strong="G4464">sceptre</char> <char style="w" x-id="t024" x-align="HEB.1.8.a023">of</char> <note caller="-" style="f"><char style="ft">The two oldest Greek manuscripts read, <char style="it">his</char></char></note><char style="w" x-id="t025" x-align="HEB.1.8.a024" x-src="SBLGNT.HEB.1.8.023" x-source="σου" x-translit="sou" srcloc="SBLGNT.HEB.1.8.023" x-head="true" lemma="σύ" strong="G4675">thy</char> <char style="w" x-id="t026" x-align="HEB.1.8.a023" x-src="SBLGNT.HEB.1.8.022" x-source="βασιλείας" x-translit="basileias" srcloc="SBLGNT.HEB.1.8.022" x-head="true" lemma="βασιλεία" strong="G932">kingdom</char>.<verse eid="HEB 1:8" /></para>
	<para style="q1"><verse number="9" style="v" x-unrepresented-source="ὁ ὁ τοὺς" x-unrepresented-translit="ho ho tous" x-unrepresented-src="SBLGNT.HEB.1.9.010 SBLGNT.HEB.1.9.012 SBLGNT.HEB.1.9.018" sid="HEB 1:9" /><char style="w" x-id="t001" x-align="HEB.1.9.a001">Thou</char> <char style="w" x-id="t002" x-align="HEB.1.9.a001">hast</char> <char style="w" x-id="t003" x-align="HEB.1.9.a001" x-src="SBLGNT.HEB.1.9.001" x-source="ἠγάπησας" x-translit="ēgapēsas" srcloc="SBLGNT.HEB.1.9.001" x-head="true" lemma="ἀγαπάω" strong="G25">loved</char> <char style="w" x-id="t004" x-align="HEB.1.9.a002" x-src="SBLGNT.HEB.1.9.002" x-source="δικαιοσύνην" x-translit="dikaiosynēn" srcloc="SBLGNT.HEB.1.9.002" x-head="true" lemma="δικαιοσύνη" strong="G1343">righteousness</char>, <char style="w" x-id="t005" x-align="HEB.1.9.a003" x-src="SBLGNT.HEB.1.9.003" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.HEB.1.9.003" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t006" x-align="HEB.1.9.a004" x-src="SBLGNT.HEB.1.9.004" x-source="ἐμίσησας" x-translit="emisēsas" srcloc="SBLGNT.HEB.1.9.004" x-head="true" lemma="μισέω" strong="G3404">hated</char> <char style="w" x-id="t007" x-align="HEB.1.9.a005" x-src="SBLGNT.HEB.1.9.005" x-source="ἀνομίαν" x-translit="anomian" srcloc="SBLGNT.HEB.1.9.005" x-head="true" lemma="ἀνομία" strong="G458">iniquity</char>;</para>
