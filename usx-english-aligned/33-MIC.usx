	<para style="p"><verse number="6" style="v" x-unrepresented-source="ן" x-unrepresented-translit="n" x-unrepresented-src="WLC.MIC.2.6.004" sid="MIC 2:6" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Prophesy ye not, they are</char> ever <char style="it">prophesying</char>, say they; Hebrew <char style="it">Drop etc.</char> See <ref loc="AMO 7:16">Am. 7:16</ref>.</char></note><char style="w" x-id="t001" x-align="MIC.2.6.a001" x-src="WLC.MIC.2.6.002" x-source="תַּטִּ֖פוּ" x-translit="taṭṭip̄û" srcloc="WLC.MIC.2.6.002" x-head="true" lemma="נָטַף" strong="H5197">Prophesy</char> <char style="w" x-id="t002" x-align="MIC.2.6.a001">ye</char> <char style="w" x-id="t003" x-align="MIC.2.6.a002" x-src="WLC.MIC.2.6.001" x-source="אַל" x-translit="ʾal-" srcloc="WLC.MIC.2.6.001" x-head="true" lemma="אַל" strong="H408">not</char>, <char style="add"><char style="w" x-id="t004" x-align="MIC.2.6.a003" x-status="added" x-source="∅" x-head="true">thus</char></char> <char style="w" x-id="t005" x-align="MIC.2.6.a004">they</char> <char style="w" x-id="t006" x-align="MIC.2.6.a004" x-src="WLC.MIC.2.6.003" x-source="יַטִּיפ֑וּ" x-translit="yaṭṭiyp̄û" srcloc="WLC.MIC.2.6.003" x-head="true" lemma="נָטַף" strong="H5197">prophesy</char>. <char style="w" x-id="t007" x-align="MIC.2.6.a006">They</char> <char style="w" x-id="t008" x-align="MIC.2.6.a006">shall</char> <char style="w" x-id="t009" x-align="MIC.2.6.a007" x-src="WLC.MIC.2.6.005" x-source="לֹֽא" x-translit="lōʾ-" srcloc="WLC.MIC.2.6.005" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t010" x-align="MIC.2.6.a006" x-src="WLC.MIC.2.6.006" x-source="יַטִּ֣פוּ" x-translit="yaṭṭip̄û" srcloc="WLC.MIC.2.6.006" x-head="true" lemma="נָטַף" strong="H5197">prophesy</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">of these things: their reproaches never cease</char></char></note><char style="w" x-id="t011" x-align="MIC.2.6.a008" x-src="WLC.MIC.2.6.007" x-source="לָ" x-translit="lā" s