	<para style="p"><verse number="23" style="v" x-unrepresented-source="τῆς τὸ ἡ τὸ τοῦ" x-unrepresented-translit="tēs to hē to tou" x-unrepresented-src="SBLGNT.1TH.5.23.005 SBLGNT.1TH.5.23.013 SBLGNT.1TH.5.23.016 SBLGNT.1TH.5.23.019 SBLGNT.1TH.5.23.025" sid="1TH 5:23" /><char style="w" x-id="t001" x-align="1TH.5.23.a002" x-src="SBLGNT.1TH.5.23.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.1TH.5.23.002" x-head="true" lemma="δέ" strong="G1161">And</char> <char style="w" x-id="t002" x-align="1TH.5.23.a003" x-src="SBLGNT.1TH.5.23.003" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.1TH.5.23.003" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t003" x-align="1TH.5.23.a004" x-src="SBLGNT.1TH.5.23.004" x-source="θεὸς" x-translit="theos" srcloc="SBLGNT.1TH.5.23.004" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t004" x-align="1TH.5.23.a006">of</char> <char style="w" x-id="t005" x-align="1TH.5.23.a006" x-src="SBLGNT.1TH.5.23.006" x-source="εἰρήνης" x-translit="eirēnēs" srcloc="SBLGNT.1TH.5.23.006" x-head="true" lemma="εἰρήνη" strong="G1515">peace</char> <char style="w" x-id="t006" x-align="1TH.5.23.a001" x-src="SBLGNT.1TH.5.23.001" x-source="Αὐτὸς" x-translit="Autos" srcloc="SBLGNT.1TH.5.23.001" x-head="true" lemma="αὐτός" strong="G846">himself</char> <char style="w" x-id="t007" x-align="1TH.5.23.a007" x-src="SBLGNT.1TH.5.23.007" x-source="ἁγιάσαι" x-translit="hagiasai" srcloc="SBLGNT.1TH.5.23.007" x-head="true" lemma="ἁγιάζω" strong="G37">sanctify</char> <char style="w" x-id="t008" x-align="1TH.5.23.a008" x-src="SBLGNT.1TH.5.23.008" x-source="ὑμᾶς" x-translit="hymas" srcloc="SBLGNT.1TH.5.23.008" x-head="true" lemma="σύ" strong="G5209">you</char> <char style="w" x-id="t009" x-align="1TH.5.23.a009" x-src="SBLGNT.1TH.5.23.009" x-source="ὁλοτελεῖς" x-translit="holoteleis" srcloc="SBLGNT.1TH.5.23.009" x-head="true" lemma="ὁλοτελής" strong="G3651">wholly</char>; <char style="w" x-id="t010" x-align="1TH.5.23.a010" x-src="SBLGNT.1