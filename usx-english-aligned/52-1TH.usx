	<para style="b"><verse number="2" style="v" x-unrepresented-source="τῷ τῶν" x-unrepresented-translit="tōi tōn" x-unrepresented-src="SBLGNT.1TH.1.2.002 SBLGNT.1TH.1.2.011" sid="1TH 1:2" /></para>
	<para style="p"><char style="w" x-id="t001" x-align="1TH.1.2.a001">We</char> <char style="w" x-id="t002" x-align="1TH.1.2.a001">give</char> <char style="w" x-id="t003" x-align="1TH.1.2.a001" x-src="SBLGNT.1TH.1.2.001" x-source="Εὐχαριστοῦμεν" x-translit="Eucharistoumen" srcloc="SBLGNT.1TH.1.2.001" x-head="true" lemma="εὐχαριστέω" strong="G2168">thanks</char> <char style="w" x-id="t004" x-align="1TH.1.2.a003">to</char> <char style="w" x-id="t005" x-align="1TH.1.2.a003" x-src="SBLGNT.1TH.1.2.003" x-source="θεῷ" x-translit="theōi" srcloc="SBLGNT.1TH.1.2.003" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t006" x-align="1TH.1.2.a004" x-src="SBLGNT.1TH.1.2.004" x-source="πάντοτε" x-translit="pantote" srcloc="SBLGNT.1TH.1.2.004" x-head="true" lemma="πάντοτε" strong="G3842">always</char> <char style="w" x-id="t007" x-align="1TH.1.2.a005" x-src="SBLGNT.1TH.1.2.005" x-source="περὶ" x-translit="peri" srcloc="SBLGNT.1TH.1.2.005" x-head="true" lemma="περί" strong="G4012">for</char> <char style="w" x-id="t008" x-align="1TH.1.2.a007" x-src="SBLGNT.1TH.1.2.007" x-source="ὑμῶν" x-translit="hymōn" srcloc="SBLGNT.1TH.1.2.007" x-head="true" lemma="σύ" strong="G5216">you</char> <char style="w" x-id="t009" x-align="1TH.1.2.a006" x-src="SBLGNT.1TH.1.2.006" x-source="πάντων" x-translit="pantōn" srcloc="SBLGNT.1TH.1.2.006" x-head="true" lemma="πᾶς" strong="G3956">all</char>, <char style="w" x-id="t010" x-align="1TH.1.2.a010" x-src="SBLGNT.1TH.1.2.009" x-source="ποιούμενοι" x-translit="poioumenoi" srcloc="SBLGNT.1TH.1.2.009" x-head="true" lemma="ποιέω" strong="G4160">making</char> <char style="w" x-id="t011" x-align="1TH.1.2.a008" x-src="SBLGNT.1TH.1.2.008" x-source="μνείαν" x-translit="mneian" srcloc="SBLGNT.1TH.1.2.008" x-head="true" lemma="μνεία" strong="G3417">mention</char> <char style="add"><char style="w" x-id="t012" x-align="1TH.1.2.a009">of</char> <char style="w" x-id="t013" x-align="1TH.1.2.a009" x-src="SBLGNT.1TH.1.2.v002.r01.001" x-source="ὑμῶν" x-tr