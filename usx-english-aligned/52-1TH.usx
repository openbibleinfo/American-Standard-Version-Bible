	<para style="p"><verse number="1" style="v" sid="1TH 1:1" /><char style="w" x-id="t001" x-align="1TH.1.1.a001" x-src="SBLGNT.1TH.1.1.001" x-source="Παῦλος" x-translit="Paulos" srcloc="SBLGNT.1TH.1.1.001" x-head="true" lemma="Παῦλος" strong="G3972">Paul</char>, <char style="w" x-id="t002" x-align="1TH.1.1.a002" x-src="SBLGNT.1TH.1.1.002" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1TH.1.1.002" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t003" x-align="1TH.1.1.a003" x-src="SBLGNT.1TH.1.1.003" x-source="Σιλουανὸς" x-translit="Silouanos" srcloc="SBLGNT.1TH.1.1.003" x-head="true" lemma="Σιλουανός" strong="G4610">Silvanus</char>, <char style="w" x-id="t004" x-align="1TH.1.1.a004" x-src="SBLGNT.1TH.1.1.004" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1TH.1.1.004" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t005" x-align="1TH.1.1.a005" x-src="SBLGNT.1TH.1.1.005" x-source="Τιμόθεος" x-translit="Timotheos" srcloc="SBLGNT.1TH.1.1.005" x-head="true" lemma="Τιμόθεος" strong="G5095">Timothy</char>, <char style="w" x-id="t006" x-align="1TH.1.1.a006">unto</char> <char style="w" x-id="t007" x-align="1TH.1.1.a006" x-src="SBLGNT.1TH.1.1.006" x-source="τῇ" x-translit="tēi" srcloc="SBLGNT.1TH.1.1.006" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t008" x-align="1TH.1.1.a007" x-src="SBLGNT.1TH.1.1.007" x-source="ἐκκλησίᾳ" x-translit="ekklēsiai" srcloc="SBLGNT.1TH.1.1.007" x-head="true" lemma="ἐκκλησία" strong="G1577">church</char> <char style="w" x-id="t009" x-align="1TH.1.1.a008">of</char> <char style="w" x-id="t010" x-align="1TH.1.1.a008">the</char> <char style="w" x-id="t011" x-align="1TH.1.1.a008" x-src="SBLGNT.1TH.1.1.008" x-source="Θεσσαλονικέων" x-translit="Thessalonikeōn" srcloc="SBLGNT.1TH.1.1.008" x-head="true" lemma="Θεσσαλονικεύς" strong="G2331">Thessalonians</char> <char style="w" x-id="t012" x-align="1TH.1.1.a009" x-src="SBLGNT.1TH.1.1.009" x-source="ἐν" x-translit="en" srcloc="SBLG