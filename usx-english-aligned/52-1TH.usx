02" x-align="1TH.5.24.a001">is</char> <char style="w" x-id="t003" x-align="1TH.5.24.a002" x-src="SBLGNT.1TH.5.24.002" x-source="ὁ" x-translit="ho" srcloc="SBLGNT.1TH.5.24.002" x-head="true" lemma="ὁ" strong="G3588">he</char> <char style="w" x-id="t004" x-align="1TH.5.24.a003">that</char> <char style="w" x-id="t005" x-align="1TH.5.24.a003" x-src="SBLGNT.1TH.5.24.003" x-source="καλῶν" x-translit="kalōn" srcloc="SBLGNT.1TH.5.24.003" x-head="true" lemma="καλέω" strong="G2564">calleth</char> <char style="w" x-id="t006" x-align="1TH.5.24.a004" x-src="SBLGNT.1TH.5.24.004" x-source="ὑμᾶς" x-translit="hymas" srcloc="SBLGNT.1TH.5.24.004" x-head="true" lemma="σύ" strong="G5209">you</char>, <char style="w" x-id="t007" x-align="1TH.5.24.a005" x-src="SBLGNT.1TH.5.24.005" x-source="ὃς" x-translit="hos" srcloc="SBLGNT.1TH.5.24.005" x-head="true" lemma="ὅς" strong="G3739">who</char> <char style="w" x-id="t008" x-align="1TH.5.24.a007">will</char> <char style="w" x-id="t009" x-align="1TH.5.24.a006" x-src="SBLGNT.1TH.5.24.006" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.1TH.5.24.006" x-head="true" lemma="καί" strong="G2532">also</char> <char style="w" x-id="t010" x-align="1TH.5.24.a007" x-src="SBLGNT.1TH.5.24.007" x-source="ποιήσει" x-translit="poiēsei" srcloc="SBLGNT.1TH.5.24.007" x-head="true" lemma="ποιέω" strong="G4160">do</char> <char style="w" x-id="t011" x-align="1TH.5.24.a007">it</char>.<verse eid="1TH 5:24" /></para>
	<para style="p"><verse number="25" style="v" sid="1TH 5:25" /><char style="w" x-id="t001" x-align="1TH.5.25.a001" x-src="SBLGNT.1TH.5.25.001" x-source="Ἀδελφοί" x-translit="Adelphoi" srcloc="SBLGNT.1TH.5.25.001" x-head="true" lemma="ἀδελφός" strong="G80">Brethren</char>, <char style="w" x-id="t002" x-align="1TH.5.25.a002" x-src="SBLGNT.1TH.5.25.002" x-source="προσεύχεσθε" x-translit="proseuchesthe" srcloc="SBLGNT.1TH.5.25.002" x-head="true" lemma="προσεύχομαι" strong="G4336">pray</char> <char style="w" x-id="t003" x-align="1TH.5.25.a003" x-src="SBLGNT.1TH.5.25.003" x-source="περὶ" x-translit="peri" srcloc="SBLGNT.1TH.5.25.003" x-head="true" lemma="περί" strong="G4012">for</char> <char style="w" x-id="t004" x-align="1TH.5.25.a004" x-src="SBLGNT.1TH.5.25.004" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.1TH.5.25.004" x-head="true" lemma="ἐγώ" strong="G2257">us</char><note caller="-" style="f"><char style="ft">Some ancient authorities add <char style="it">also</char>.</char></note>.<verse eid="1TH 5:25" /></para>
	<para style="p"><verse number="26" style="v" sid="1TH 5:26" /><char style="w" x-id="t001" x-align="1TH.5.26.a001" x-src="SBLGNT.1TH.5.26.001" x-source="ἀσπάσασθε" x-translit="aspasasthe" srcloc="SBLGNT.1TH.5.26.001" x-head="true" lemma="ἀσπάζομαι" strong="G782">Salute</char> <char style="w" x-id="t002" x-align="1TH.5.26.a004" x-src="SBLGNT.1TH.5.26.004" x-source="πάντας" x-translit="pantas" srcloc="SBLGNT.1TH.5.26.004" x-head="true" lemma="πᾶς" strong="G3956">all</char> <char style="w" x-id="t003" x-align="1TH.5.26.a002" x-src="SBLGNT.1TH.5.26.002" x-source="τοὺς" x-translit="tous" srcloc="SBLGNT.1TH.5.26.002" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t004" x-align="1TH.5.26.a003" x-src="SBLGNT.1TH.5.26.003" x-source="ἀδελφοὺς" x-translit="adelphous" srcloc="SBLGNT.1TH.5.26.003" x-head="true" lemma="ἀδελφός" strong="G80">brethren</char> <char style="w" x-id="t005" x-align="1TH.5.26.a005" x-src="SBLGNT.1TH.5.26.005" x-source="ἐν" x-translit="en" srcloc="SBLGNT.1TH.5.26.005" x-head="true" lemma="ἐν" strong="G1722">with</char> <char style="w" x-id="t006" x-align="1TH.5.26.a006">a</char> <char style="w" x-id="t007" x-align="1TH.5.26.a007" x-src="SBLGNT.1TH.5.26.007" x-source="ἁγίῳ" x-translit="hagiōi" srcloc="SBLGNT.1TH.5.26.007" x-head="true" lemma="ἅγιος" strong="G40">holy</char> <char style="w" x-id="t008" x-align="1TH.5.26.a006" x-src="SBLGNT.1TH.5.26.006" x-source="φιλήματι" x-translit="philēmati" srcloc="SBLGNT.1TH.5.26.006" x-head="true" lemma="φίλημα" strong="G5370">kiss</char>. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" /><char style="w" x-id="t001" x-align="1TH.5.27.a001">I</char> <char style="w" x-id="t002" x-align="1TH.5.27.a001" x-src="SBLGNT.1TH.5.27.001" x-source="ἐνορκίζω" x-translit="enorkizō" srcloc="SBLGNT.1TH.5.27.001" x-head="true" lemma="ἐνορκίζω" strong="G3726">adjure</char> <char style="w" x-id="t003" x-align="1TH.5.27.a002" x-src="SBLGNT.1TH.5.27.002" x-source="ὑμᾶς" x-translit="hymas" srcl