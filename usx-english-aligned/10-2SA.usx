	<para style="q1"><verse number="3" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.2SA.23.3.011" sid="2SA 23:3" /><char style="w" x-id="t001" x-align="2SA.23.3.a001">The</char> <char style="w" x-id="t002" x-align="2SA.23.3.a001" x-src="WLC.2SA.23.3.002" x-source="אֱלֹהֵ֣י" x-translit="ʾĕlōhēy" srcloc="WLC.2SA.23.3.002" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t003" x-align="2SA.23.3.a002">of</char> <char style="w" x-id="t004" x-align="2SA.23.3.a002" x-src="WLC.2SA.23.3.003" x-source="יִשְׂרָאֵ֔ל" x-translit="yiśrāʾēl" srcloc="WLC.2SA.23.3.003" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char> <char style="w" x-id="t005" x-align="2SA.23.3.a003" x-src="WLC.2SA.23.3.001" x-source="אָמַר֙" x-translit="ʾāmar" srcloc="WLC.2SA.23.3.001" x-head="true" lemma="אָמַר" strong="H559">said</char>,</para>
	<para style="q1"><char style="w" x-id="t006" x-align="2SA.23.3.a004">The</char> <char style="w" x-id="t007" x-align="2SA.23.3.a004" x-src="WLC.2SA.23.3.007" x-source="צ֣וּר" x-translit="ṣûr" srcloc="WLC.2SA.23.3.007" x-head="true" lemma="צוּר" strong="H6697">Rock</char> <char style="w" x-id="t008" x-align="2SA.23.3.a005">of</char> <char style="w" x-id="t009" x-align="2SA.23.3.a005" x-src="WLC.2SA.23.3.008" x-source="יִשְׂרָאֵ֑ל" x-translit="yiśrāʾēl" srcloc="WLC.2SA.23.3.008" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char> <char style="w" x-id="t010" x-align="2SA.23.3.a006" x-src="WLC.2SA.23.3.006" x-source="דִבֶּ֖ר" x-translit="ḏibber" srcloc="WLC.2SA.23.3.006" x-head="true" lemma="דָבַר" strong="H1696">spake</char> <char style="w" x-id="t011" x-align="2SA.23.3.a007" x-src="WLC.2SA.23.3.004" x-source="לִ֥" x-translit="l" srcloc="WLC.2SA.23.3.004" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t012" x-align="2SA.23.3.a008" x-src="WLC.2SA.23.3.005" x-source="י" x-translit="iy" srcloc="WLC.2SA.23.3.005" x-head="true" lemma="הוּא" strong="H2967a">me</char>:</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, There shall be <char style="it">one . . . and</char> it shall be <char style="it">as etc.</char></char></note><char style="w" x-id="t013" x-align="2SA.23.3.a009">One</char> <char style="w" x-id="t014" x-align="2SA.23.3.a009">that</char> <char style="w" x-id="t015" x-align="2SA.23.3.a009" x-src="WLC.2SA.23.3.009" x-source="מוֹשֵׁל֙" x-translit="môšēl" srcloc="WLC.2SA.23.3.009" x-head="true" lemma="מָשַׁל" strong="H4910">ruleth</char> <char style="w" x-id="t016" x-align="2SA.23.3.a010" x-src="WLC.2SA.23.3.010" x-source="בָּ" x-translit="bā" srcloc="WLC.2SA.23.3.010" x-head="true" lemma="בְּ" strong="H871a">over</char> <char style="w" x-id="t017" x-align="2SA.23.3.a012" x-src="WLC.2SA.23.3.012" x-source="אָדָ֔ם" x-translit="ʾāḏām" srcloc="WLC.2SA.23.3.012" x-head="true" lemma="אָדָם" strong="H120">men</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">a righteous one</char>.</char></note><char style="w" x-id="t018" x-align="2SA.23.3.a013" x-src="WLC.2SA.23.3.013" x-source="צַדִּ֕יק" x-translit="ṣaddiyq" srcloc="WLC.2SA.23.3.013" x-head="true" lemma="צַדִּיק" strong="H6662">righteously</char>,</para>
	<para style="q1"><char style="w" x-id="t019" x-align="2SA.23.3.a014">That</char> <char style="w" x-id="t020" x-align="2SA.23.3.a014" x-src="WLC.2SA.23.3.014" x-source="מוֹשֵׁ֖ל" x-translit="môšēl" srcloc="WLC.2SA.23.3.014" x-head="true" lemma="מָשַׁל" strong="H4910">ruleth</char> <char style="w" x-id="t021" x-align="2SA.23.3.a015">in</char> <char style="w" x-id="t022" x-align="2SA.23.3.a015">the</char> <char style="w" x-id="t023" x-align="2SA.23.3.a015" x-src="WLC.2SA.23.3.015" x-source="יִרְאַ֥ת" x-translit="yirʾaṯ" srcloc="WLC.2SA.23.3.015" x-head="true" lemma="יִרְאָה" strong="H3374">fear</char> <char style="w" x-id="t024" x-align="2SA.23.3.a016">of</char> <char style="w" x-id="t025" x-align="2SA.23.3.a016" x-src="WLC.2SA.23.3.016" x-source="אֱלֹהִֽים" x-translit="ʾĕlōhiym:" srcloc="WLC.2SA.23.3.016" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>,<verse eid="2SA 23:3" /></para>
