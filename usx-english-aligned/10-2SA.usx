	<para style="q1"><verse number="51" style="v" sid="2SA 22:51" /><note caller="-" style="f"><char style="ft">Another reading is, <char style="it">He is a tower of deliverance</char>.</char></note><char style="w" x-id="t001" x-align="2SA.22.51.a001" x-src="WLC.2SA.22.51.v006.r01.001" x-source="מגדיל" x-translit="mḡḏyl" srcloc="WLC.2SA.22.51.v006.r01.001" x-head="true" lemma="גָּדַל" strong="H1431">Great</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">salvations</char>.</char></note><char style="w" x-id="t002" x-align="2SA.22.51.a002" x-src="WLC.2SA.22.51.002" x-source="יְשׁוּע֣וֹת" x-translit="yəšûʿôṯ" srcloc="WLC.2SA.22.51.002" x-head="true" lemma="יְשׁוּעָה" strong="H3444">deliverance</char> <char style="w" x-id="t003" x-align="2SA.22.51.a001">giveth</char> <char style="w" x-id="t004" x-align="2SA.22.51.a001">he</char> <char style="w" x-id="t005" x-align="2SA.22.51.a003">to</char> <char style="w" x-id="t006" x-align="2SA.22.51.a004" x-src="WLC.2SA.22.51.004" x-source="וֹ" x-translit="ô" srcloc="WLC.2SA.22.51.004" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="2SA.22.51.a003" x-src="WLC.2SA.22.51.003" x-source="מַלְכּ֑" x-translit="malk" srcloc="WLC.2SA.22.51.003" x-head="true" lemma="מֶלֶךְ" strong="H4428">king</char>,</para>
	<para style="q1"><char style="w" x-id="t008" x-align="2SA.22.51.a005" x-src="WLC.2SA.22.51.005" x-source="וְ" x-translit="wə" srcloc="WLC.2SA.22.51.005" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t009" x-align="2SA.22.51.a006" x-src="WLC.2SA.22.51.006" x-source="עֹֽשֶׂה" x-translit="ʿōśeh-" srcloc="WLC.2SA.22.51.006" x-head="true" lemma="עָשָׂה" strong="H6213">showeth</char> <char style="w" x-id="t010" x-align="2SA.22.51.a007" x-src="WLC.2SA.22.51.007" x-source="חֶ֧סֶד" x-translit="ḥeseḏ" srcloc="WLC.2SA.22.51.007" x-head="true" lemma="חֶסֶד" strong="H2617">lovingkindness</char> <char style="w" x-id="t011" x-align="2SA.22.51.a008" x-src="WLC.2SA.22.51.008" x-source="לִ" x-translit="li" srcloc="WLC.2SA.22.51.008" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t012" x-align="2SA.22.51.a010" x-src="WLC.2SA.22.51.010" x-source="וֹ" x-translit="ô" srcloc="WLC.2SA.22.51.010" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t013" x-align="2SA.22.51.a009" x-src="WLC.2SA.22.51.009" x-source="מְשִׁיח֛" x-translit="məšiyḥ" srcloc="WLC.2SA.22.51.009" x-head="true" lemma="מָשִׁיחַ" strong="H4899">anointed</char>,</para>
	<para style="q1"><char style="w" x-id="t014" x-align="2SA.22.51.a011" x-src="WLC.2SA.22.51.011" x-source="לְ" x-translit="lə" srcloc="WLC.2SA.22.51.011" x-head="true" lemma="לְ" strong="H3807a">To</char> <char style="w" x-id="t015" x-align="2SA.22.51.a012" x-src="WLC.2SA.22.51.012" x-source="דָוִ֥ד" x-translit="ḏāwiḏ" srcloc="WLC.2SA.22.51.012" x-head="true" lemma="דָּוִד" strong="H1732">David</char> <char style="w" x-id="t016" x-align="2SA.22.51.a013" x-src="WLC.2SA.22.51.013" x-source="וּ" x-translit="û" srcloc="WLC.2SA.22.51.013" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t017" x-align="2SA.22.51.a014" x-src="WLC.2SA.22.51.014" x-source="לְ" x-translit="lə" srcloc="WLC.2SA.22.51.014" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t018" x-align="2SA.22.51.a016" x-src="WLC.2SA.22.51.016" x-source="וֹ" x-translit="ô" srcloc="WLC.2SA.22.51.016" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t019" x-align="2SA.22.51.a015" x-src="WLC.2SA.22.51.015" x-source="זַרְע֖" x-translit="zarʿ" srcloc="WLC.2SA.22.51.015" x-head="true" lemma="זֶרַע" strong="H2233">seed</char>, <char style="w" x-id="t020" x-align="2SA.22.51.a017" x-src="WLC.2SA.22.51.017" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.2SA.22.51.017" x-head="true" lemma="עַד" strong="H5704">for</char> <char style="w" x-id="t021" x-align="2SA.22.51.a018" x-src="WLC.2SA.22.51.018" x-source="עוֹלָֽם" x-translit="ʿôlām:" srcloc="WLC.2SA.22.51.018" x-head="true" lemma="עוֹלָם" strong="H5769">evermore</char>.<verse eid="2SA 22:51" /></para>
