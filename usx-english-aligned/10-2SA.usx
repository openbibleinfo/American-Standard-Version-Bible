	<para style="q1"><verse number="5" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.2SA.23.5.016" sid="2SA 23:5" /><note caller="-" style="f"><char style="ft">Or, <char style="it">For is not my house so with God? for he . . . for all my salvation, and all</char> my <char style="it">desire, will he not make it to grow?</char></char></note><char style="w" x-id="t001" x-align="2SA.23.5.a001" x-src="WLC.2SA.23.5.001" x-source="כִּֽי" x-translit="kiy-" srcloc="WLC.2SA.23.5.001" x-head="true" lemma="כִּי" strong="H3588">Verily</char> <char style="w" x-id="t002" x-align="2SA.23.5.a002" x-src="WLC.2SA.23.5.005" x-source="י" x-translit="iy" srcloc="WLC.2SA.23.5.005" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t003" x-align="2SA.23.5.a003" x-src="WLC.2SA.23.5.004" x-source="בֵּיתִ֖" x-translit="bēyṯ" srcloc="WLC.2SA.23.5.004" x-head="true" lemma="בַּיִת" strong="H1004">house</char> <char style="w" x-id="t004" x-align="2SA.23.5.a004">is</char> <char style="w" x-id="t005" x-align="2SA.23.5.a005" x-src="WLC.2SA.23.5.002" x-source="לֹא" x-translit="lōʾ-" srcloc="WLC.2SA.23.5.002" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t006" x-align="2SA.23.5.a004" x-src="WLC.2SA.23.5.003" x-source="כֵ֥ן" x-translit="ḵēn" srcloc="WLC.2SA.23.5.003" x-head="true" lemma="כֵּן" strong="H3651">so</char> <char style="w" x-id="t007" x-align="2SA.23.5.a006" x-src="WLC.2SA.23.5.006" x-source="עִם" x-translit="ʿim-" srcloc="WLC.2SA.23.5.006" x-head="true" lemma="עִם" strong="H5973">with</char> <char style="w" x-id="t008" x-align="2SA.23.5.a007" x-src="WLC.2SA.23.5.007" x-source="אֵ֑ל" x-translit="ʾēl" srcloc="WLC.2SA.23.5.007" x-head="true" lemma="אֵל" strong="H410">God</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="2SA.23.5.a008" x-src="WLC.2SA.23.5.008" x-source="כִּי֩" x-translit="kî" srcloc="WLC.2SA.23.5.008" x-head="true" lemma="כִּי" strong="H3588">Yet</char> <char style="w" x-id="t010" x-align="2SA.23.5.a009">he</char> <char style="w" x-id="t011" x-align="2SA.23.5.a009">hath</char> <char style="w" x-id="t012" x-align="2SA.23.5.a009" x-src="WLC.2SA.23.5.011" x-source="שָׂ֣ם" x-translit="śām" srcloc="WLC.2SA.23.5.011" x-head="true" lemma="שׂים" strong="H7760">made</char> <char style="w" x-id="t013" x-align="2SA.23.5.a010" x-src="WLC.2SA.23.5.012" x-source="לִ֗" x-translit="l" srcloc="WLC.2SA.23.5.012" x-head="true" lemma="לְ" strong="H3807a">with</char> <char style="w" x-id="t014" x-align="2SA.23.5.a011" x-src="WLC.2SA.23.5.013" x-source="י" x-translit="iy" srcloc="WLC.2SA.23.5.013" x-head="true" lemma="הוּא" strong="H2967a">me</char> <char style="w" x-id="t015" x-align="2SA.23.5.a012">an</char> <char style="w" x-id="t016" x-align="2SA.23.5.a013" x-src="WLC.2SA.23.5.010" x-source="עוֹלָ֜ם" x-translit="ʿôlām" srcloc="WLC.2SA.23.5.010" x-head="true" lemma="עוֹלָם" strong="H5769">everlasting</char> <char style="w" x-id="t017" x-align="2SA.23.5.a012" x-src="WLC.2SA.23.5.009" x-source="בְרִ֨ית" x-translit="ḇəriyṯ" srcloc="WLC.2SA.23.5.009" x-head="true" lemma="בְּרִית" strong="H1285">covenant</char>,</para>
