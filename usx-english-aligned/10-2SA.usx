	<para style="q1"><verse number="6" style="v" sid="2SA 23:6" /><char style="w" x-id="t001" x-align="2SA.23.6.a001" x-src="WLC.2SA.23.6.001" x-source="וּ" x-translit="û" srcloc="WLC.2SA.23.6.001" x-head="true" lemma="וְ" strong="H2050b">But</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">Belial</char>, that is, <char style="it">worthlessness</char>.</char></note><char style="w" x-id="t002" x-align="2SA.23.6.a002">the</char> <char style="w" x-id="t003" x-align="2SA.23.6.a002" x-src="WLC.2SA.23.6.002" x-source="בְלִיַּ֕עַל" x-translit="ḇəliyyaʿal" srcloc="WLC.2SA.23.6.002" x-head="true" lemma="בְּלִיַּעַל" strong="H1100">ungodly</char> <char style="w" x-id="t004" x-align="2SA.23.6.a003">shall</char> <char style="w" x-id="t005" x-align="2SA.23.6.a003">be</char> <char style="w" x-id="t006" x-align="2SA.23.6.a004" x-src="WLC.2SA.23.6.006" x-source="כֻּלָּ֑" x-translit="kull" srcloc="WLC.2SA.23.6.006" x-head="true" lemma="כֹּל" strong="H3605">all</char> <char style="w" x-id="t007" x-align="2SA.23.6.a005">of</char> <char style="w" x-id="t008" x-align="2SA.23.6.a005" x-src="WLC.2SA.23.6.007" x-source="הַם" x-translit="āham" srcloc="WLC.2SA.23.6.007" x-head="true" lemma="הוּא" strong="H3963a">them</char> <char style="w" x-id="t009" x-align="2SA.23.6.a003" x-src="WLC.2SA.23.6.003" x-source="כְּ" x-translit="kə" srcloc="WLC.2SA.23.6.003" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t010" x-align="2SA.23.6.a006" x-src="WLC.2SA.23.6.004" x-source="ק֥וֹץ" x-translit="qôṣ" srcloc="WLC.2SA.23.6.004" x-head="true" lemma="קוֹץ" strong="H6975">thorns</char> <char style="w" x-id="t011" x-align="2SA.23.6.a007">to</char> <char style="w" x-id="t012" x-align="2SA.23.6.a007">be</char> <char style="w" x-id="t013" x-align="2SA.23.6.a007" x-src="WLC.2SA.23.6.005" x-source="מֻנָ֖ד" x-translit="munāḏ" srcloc="WLC.2SA.23.6.005" x-head="true" lemma="נָדַד" strong="H5074">thrust</char> <char style="w" x-id="t014" x-align="2SA.23.6.a007">away</c