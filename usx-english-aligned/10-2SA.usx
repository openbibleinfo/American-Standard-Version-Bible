	<para style="q1"><char style="w" x-id="t031" x-align="2SA.23.1.a021" x-src="WLC.2SA.23.1.020" x-source="וּ" x-translit="û" srcloc="WLC.2SA.23.1.020" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">pleasant in the psalms of Israel</char>.</char></note><char style="w" x-id="t032" x-align="2SA.23.1.a022">the</char> <char style="w" x-id="t033" x-align="2SA.23.1.a022" x-src="WLC.2SA.23.1.021" x-source="נְעִ֖ים" x-translit="nəʿiym" srcloc="WLC.2SA.23.1.021" x-head="true" lemma="נָעִים" strong="H5273">sweet</char> <char style="w" x-id="t034" x-align="2SA.23.1.a023" x-src="WLC.2SA.23.1.022" x-source="זְמִר֥וֹת" x-translit="zəmirôṯ" srcloc="WLC.2SA.23.1.022" x-head="true" lemma="זָמִיר" strong="H2158">psalmist</char> <char style="w" x-id="t035" x-align="2SA.23.1.a024">of</char> <char style="w" x-id="t036" x-align="2SA.23.1.a024" x-src="WLC.2SA.23.1.023" x-source="יִשְׂרָאֵֽל" x-translit="yiśrāʾēl:" srcloc="WLC.2SA.23.1.023" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>:<verse eid="2SA 23:1" /></para>
