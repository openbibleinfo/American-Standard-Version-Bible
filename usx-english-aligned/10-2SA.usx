	<para style="q1"><char style="w" x-id="t014" x-align="2SA.23.4.a009">A</char> <char style="w" x-id="t015" x-align="2SA.23.4.a009" x-src="WLC.2SA.23.4.007" x-source="בֹּ֚קֶר" x-translit="bōqer" srcloc="WLC.2SA.23.4.007" x-head="true" lemma="בֹּקֶר" strong="H1242">morning</char> <char style="w" x-id="t016" x-align="2SA.23.4.a010" x-src="WLC.2SA.23.4.008" x-source="לֹ֣א" x-translit="lōʾ" srcloc="WLC.2SA.23.4.008" x-head="true" lemma="לֹא" strong="H3808">without</char> <char style="w" x-id="t017" x-align="2SA.23.4.a011" x-src="WLC.2SA.23.4.009" x-source="עָב֔וֹת" x-translit="ʿāḇôṯ" srcloc="WLC.2SA.23.4.009" x-head="true" lemma="עָב" strong="H5645">clouds</char>,</para>
