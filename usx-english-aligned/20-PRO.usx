	<para style="q1"><verse number="16" style="v" sid="PRO 26:16" /><char style="w" x-id="t001" x-align="PRO.26.16.a002">The</char> <char style="w" x-id="t002" x-align="PRO.26.16.a002" x-src="WLC.PRO.26.16.002" x-source="עָצֵ֣ל" x-translit="ʿāṣēl" srcloc="WLC.PRO.26.16.002" x-head="true" lemma="עָצֵל" strong="H6102">sluggard</char> <char style="w" x-id="t003" x-align="PRO.26.16.a001">is</char> <char style="w" x-id="t004" x-align="PRO.26.16.a001" x-src="WLC.PRO.26.16.001" x-source="חָכָ֣ם" x-translit="ḥāḵām" srcloc="WLC.PRO.26.16.001" x-head="true" lemma="חָכָם" strong="H2450">wiser</char> <char style="w" x-id="t005" x-align="PRO.26.16.a003" x-src="WLC.PRO.26.16.003" x-source="בְּ" x-translit="bə" srcloc="WLC.PRO.26.16.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">his own eyes</char>.</char></note><char style="w" x-id="t006" x-align="PRO.26.16.a005" x-src="WLC.PRO.26.16.005" x-source="ו" x-translit="w" srcloc="WLC.PRO.26.16.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t007" x-align="PRO.26.16.a005">own</char> <char style="w" x-id="t008" x-align="PRO.26.16.a004" x-src="WLC.PRO.26.16.004" x-source="עֵינָ֑י" x-translit="ʿēynāy" srcloc="WLC.PRO.26.16.004" x-head="true" lemma="עַיִן" strong="H5869">conceit</char></para>
