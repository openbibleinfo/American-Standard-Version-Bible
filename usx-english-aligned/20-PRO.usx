	<para style="q1"><verse number="1" style="v" x-unrepresented-source="מִ" x-unrepresented-translit="mi" x-unrepresented-src="WLC.PRO.22.1.009" sid="PRO 22:1" /><char style="w" x-id="t001" x-align="PRO.22.1.a001">A</char> <char style="add"><char style="w" x-id="t002" x-align="PRO.22.1.a002" x-status="added" x-source="∅" x-head="true">good</char></char> <char style="w" x-id="t003" x-align="PRO.22.1.a001" x-src="WLC.PRO.22.1.002" x-source="שֵׁ֭ם" x-translit="šēm" srcloc="WLC.PRO.22.1.002" x-head="true" lemma="שֵׁם" strong="H8034">name</char> <char style="w" x-id="t004" x-align="PRO.22.1.a003">is</char> <char style="w" x-id="t005" x-align="PRO.22.1.a004">rather</char> <char style="w" x-id="t006" x-align="PRO.22.1.a003">to</char> <char style="w" x-id="t007" x-align="PRO.22.1.a003">be</char> <char style="w" x-id="t008" x-align="PRO.22.1.a003" x-src="WLC.PRO.22.1.001" x-source="נִבְחָ֣ר" x-translit="niḇḥār" srcloc="WLC.PRO.22.1.001" x-head="true" lemma="בָּחַר" strong="H977">chosen</char> <char style="w" x-id="t009" x-align="PRO.22.1.a004" x-src="WLC.PRO.22.1.003" x-source="מֵ" x-translit="mē" srcloc="WLC.PRO.22.1.003" x-head="true" lemma="מִן" strong="H4480">than</char> <char style="w" x-id="t010" x-align="PRO.22.1.a005" x-src="WLC.PRO.22.1.005" x-source="רָ֑ב" x-translit="rāḇ" srcloc="WLC.PRO.22.1.005" x-head="true" lemma="רַב" strong="H7227">great</char> <char style="w" x-id="t011" x-align="PRO.22.1.a006" x-src="WLC.PRO.22.1.004" x-source="עֹ֣שֶׁר" x-translit="ʿōšer" srcloc="WLC.PRO.22.1.004" x-head="true" lemma="עֹשֶׁר" strong="H6239">riches</char>,</para>
