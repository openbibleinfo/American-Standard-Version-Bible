	<para style="q1"><verse number="17" style="v" sid="PRO 26:17" /><note caller="-" style="f"><char style="ft">Or, <char style="it">He that vexeth himself . . . Is</char> like <char style="it">one that taketh a passing dog etc.</char></char></note><char style="w" x-id="t001" x-align="PRO.26.17.a001">He</char> <char style="w" x-id="t002" x-align="PRO.26.17.a001">that</char> <char style="w" x-id="t003" x-align="PRO.26.17.a001" x-src="WLC.PRO.26.17.005" x-source="עֹבֵ֥ר" x-translit="ʿōḇēr" srcloc="WLC.PRO.26.17.005" x-head="true" lemma="עָבַר" strong="H5674">passeth</char> <char style="w" x-id="t004" x-align="PRO.26.17.a001">by</char>, <char style="add"><char style="w" x-id="t005" x-align="PRO.26.17.a002" x-status="added" x-source="∅" x-head="true">and</char></char> <char style="w" x-id="t006" x-align="PRO.26.17.a003" x-src="WLC.PRO.26.17.006" x-source="מִ֝תְעַבֵּ֗ר" x-translit="miṯʿabbēr" srcloc="WLC.PRO.26.17.006" x-head="true" lemma="עָבַר" strong="H5674a">vexeth</char> <char style="w" x-id="t007" x-align="PRO.26.17.a003">himself</char> <char style="w" x-id="t008" x-align="PRO.26.17.a004" x-src="WLC.PRO.26.17.007" x-source="עַל" x-translit="ʿal-" srcloc="WLC.PRO.26.17.007" x-head="true" lemma="עַל" strong="H5921">with</char> <char style="w" x-id="t009" x-align="PRO.26.17.a005" x-src="WLC.PRO.26.17.008" x-source="רִ֥יב" x-translit="riyḇ" srcloc="WLC.PRO.26.17.008" x-head="true" lemma="רִיב" strong="H7379">strife</char> <char style="w" x-id="t010" x-align="PRO.26.17.a007">belonging</char> <char style="w" x-id="t011" x-align="PRO.26.17.a006" x-src="WLC.PRO.26.17.009" x-source="לֹּֽא" x-translit="llōʾ-" srcloc="WLC.PRO.26.17.009" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t012" x-align="PRO.26.17.a007" x-src="WLC.PRO.26.17.010" x-source="לֽ" x-translit="l" srcloc="WLC.PRO.26.17.010" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t013" x-align="PRO.26.17.a008" x-src="WLC.PRO.26.17.011" x-source="וֹ" x-translit="ô" sr