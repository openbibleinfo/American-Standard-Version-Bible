	<para style="q1"><verse number="1" style="v" x-unrepresented-source="לְֽ֭" x-unrepresented-translit="lə" x-unrepresented-src="WLC.PRO.18.1.001" sid="PRO 18:1" /><char style="w" x-id="t001" x-align="PRO.18.1.a001">He</char> <char style="w" x-id="t002" x-align="PRO.18.1.a001">that</char> <char style="w" x-id="t003" x-align="PRO.18.1.a001" x-src="WLC.PRO.18.1.004" x-source="נִפְרָ֑ד" x-translit="nip̄rāḏ" srcloc="WLC.PRO.18.1.004" x-head="true" lemma="פָּרַד" strong="H6504">separateth</char> <char style="w" x-id="t004" x-align="PRO.18.1.a001">himself</char> <char style="w" x-id="t005" x-align="PRO.18.1.a002" x-src="WLC.PRO.18.1.003" x-source="יְבַקֵּ֣שׁ" x-translit="yəḇaqqēš" srcloc="WLC.PRO.18.1.003" x-head="true" lemma="בָּקַשׁ" strong="H1245">seeketh</char> <char style="add"><char style="w" x-id="t006" x-align="PRO.18.1.a003" x-status="added" x-source="∅" x-head="true">his</char> <char style="w" x-id="t007" x-align="PRO.18.1.a003" x-status="added">own</char></char> <char style="w" x-id="t008" x-align="PRO.18.1.a004" x-src="WLC.PRO.18.1.002" x-source="תַאֲוָה" x-translit="ṯaʾăwâ" srcloc="WLC.PRO.18.1.002" x-head="true" lemma="תַּאֲוָה" strong="H8378">desire</char>,</para>
