	<para style="q1"><verse number="10" style="v" sid="PRO 26:10" /><note caller="-" style="f"><char style="ft">Or, <char style="it">A master worker formeth all things; But he that hireth the fool is as one that hireth them that pass by.</char> The Hebrew is obscure.</char></note><char style="add"><char style="w" x-id="t001" x-align="PRO.26.10.a001" x-status="added" x-source="∅" x-head="true">As</char></char> <char style="w" x-id="t002" x-align="PRO.26.10.a002">an</char> <char style="w" x-id="t003" x-align="PRO.26.10.a002" x-src="WLC.PRO.26.10.001" x-source="רַ֥ב" x-translit="raḇ" srcloc="WLC.PRO.26.10.001" x-head="true" lemma="רַב" strong="H7228">archer</char> <char style="w" x-id="t004" x-align="PRO.26.10.a003">that</char> <char style="w" x-id="t005" x-align="PRO.26.10.a003" x-src="WLC.PRO.26.10.002" x-source="מְחֽוֹלֵֽל" x-translit="məḥôlēl-" srcloc="WLC.PRO.26.10.002" x-head="true" lemma="חלל" strong="H2490a">woundeth</char> <char style="w" x-id="t006" x-align="PRO.26.10.a004" x-src="WLC.PRO.26.10.003" x-source="כֹּ֑ל" x-translit="kōl" srcloc="WLC.PRO.26.10.003" x-head="true" lemma="כֹּל" strong="H3605">all</char>,</para>
