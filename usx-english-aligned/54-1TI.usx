	<para style="p"><char style="w" x-id="t001" x-align="1TI.1.3.a001" x-src="SBLGNT.1TI.1.3.001" x-source="Καθὼς" x-translit="Kathōs" srcloc="SBLGNT.1TI.1.3.001" x-head="true" lemma="καθώς" strong="G2531">As</char> <char style="w" x-id="t002" x-align="1TI.1.3.a002">I</char> <char style="w" x-id="t003" x-align="1TI.1.3.a002" x-src="SBLGNT.1TI.1.3.002" x-source="παρεκάλεσά" x-translit="parekalesa" srcloc="SBLGNT.1TI.1.3.002" x-head="true" lemma="παρακαλέω" strong="G3870">exhorted</char> <char style="w" x-id="t004" x-align="1TI.1.3.a003" x-src="SBLGNT.1TI.1.3.003" x-source="σε" x-translit="se" srcloc="SBLGNT.1TI.1.3.003" x-head="true" lemma="σύ" strong="G4571">thee</char> <char style="w" x-id="t005" x-align="1TI.1.3.a004">to</char> <char style="w" x-id="t006" x-align="1TI.1.3.a004" x-src="SBLGNT.1TI.1.3.004" x-source="προσμεῖναι" x-translit="prosmeinai" srcloc="SBLGNT.1TI.1.3.004" x-head="true" lemma="προσμένω" strong="G4357">tarry</char> <char style="w" x-id="t007" x-align="1TI.1.3.a005" x-src="SBLGNT.1TI.1.3.005" x-source="ἐν" x-translit="en" srcloc="SBLGNT.1TI.1.3.005" x-head="true" lemma="ἐν" strong="G1722">at</char> <char style="w" x-id="t008" x-align="1TI.1.3.a006" x-src="SBLGNT.1TI.1.3.006" x-source="Ἐφέσῳ" x-translit="Ephesōi" srcloc="SBLGNT.1TI.1.3.006" x-head="true" lemma="Ἔφεσος" strong="G2181">Ephesus</char>, <char style="w" x-id="t009" x-align="1TI.1.3.a007">when</char> <char style="w" x-id="t010" x-align="1TI.1.3.a007">I</char> <char style="w" x-id="t011" x-align="1TI.1.3.a007">was</char> <char style="w" x-id="t012" x-align="1TI.1.3.a007" x-src="SBLGNT.1TI.1.3.007" x-source="πορευόμενος" x-translit="poreuomenos" srcloc="SBLGNT.1TI.1.3.007" x-head="true" lemma="πορεύομαι" strong="G4198">going</char> <char style="w" x-id="t013" x-align="1TI.1.3.a008" x-src="SBLGNT.1TI.1.3.008" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.1TI.1.3.008" x-head="true" lemma="εἰς" strong="G1519">into</char> <char style="w" x-id="t014" x-align="1TI.1.3.a009" x-src="SBLGNT.1TI.1.3