	<para style="p"><verse number="1" style="v" sid="1SA 2:1" /><char style="w" x-id="t001" x-align="1SA.2.1.a001" x-src="WLC.1SA.2.1.001" x-source="וַ" x-translit="wa" srcloc="WLC.1SA.2.1.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="1SA.2.1.a003" x-src="WLC.1SA.2.1.003" x-source="חַנָּה֙" x-translit="ḥannāh" srcloc="WLC.1SA.2.1.003" x-head="true" lemma="חַנָּה" strong="H2584">Hannah</char> <char style="w" x-id="t003" x-align="1SA.2.1.a002" x-src="WLC.1SA.2.1.002" x-source="תִּתְפַּלֵּ֤ל" x-translit="tiṯpallēl" srcloc="WLC.1SA.2.1.002" x-head="true" lemma="פָּלַל" strong="H6419">prayed</char>, <char style="w" x-id="t004" x-align="1SA.2.1.a004" x-src="WLC.1SA.2.1.004" x-source="וַ" x-translit="wa" srcloc="WLC.1SA.2.1.004" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="1SA.2.1.a005" x-src="WLC.1SA.2.1.005" x-source="תֹּאמַ֔ר" x-translit="tōʾmar" srcloc="WLC.1SA.2.1.005" x-head="true" lemma="אָמַר" strong="H559">said</char>:</para>
