	<para style="q1"><verse number="13" style="v" sid="LAM 1:13" /><char style="w" x-id="t001" x-align="LAM.1.13.a001" x-src="WLC.LAM.1.13.001" x-source="מִ" x-translit="mi" srcloc="WLC.LAM.1.13.001" x-head="true" lemma="מִן" strong="H4480">From</char> <char style="w" x-id="t002" x-align="LAM.1.13.a002">on</char> <char style="w" x-id="t003" x-align="LAM.1.13.a002" x-src="WLC.LAM.1.13.002" x-source="מָּר֛וֹם" x-translit="mmārôm" srcloc="WLC.LAM.1.13.002" x-head="true" lemma="מָרוֹם" strong="H4791">high</char> <char style="w" x-id="t004" x-align="LAM.1.13.a003">hath</char> <char style="w" x-id="t005" x-align="LAM.1.13.a003">he</char> <char style="w" x-id="t006" x-align="LAM.1.13.a003" x-src="WLC.LAM.1.13.003" x-source="שָֽׁלַח" x-translit="šālaḥ-" srcloc="WLC.LAM.1.13.003" x-head="true" lemma="שָׁלַח" strong="H7971">sent</char> <char style="w" x-id="t007" x-align="LAM.1.13.a004" x-src="WLC.LAM.1.13.004" x-source="אֵ֥שׁ" x-translit="ʾēš" srcloc="WLC.LAM.1.13.004" x-head="true" lemma="אֵשׁ" strong="H784">fire</char> <char style="w" x-id="t008" x-align="LAM.1.13.a005" x-src="WLC.LAM.1.13.005" x-source="בְּ" x-translit="bə" srcloc="WLC.LAM.1.13.005" x-head="true" lemma="בְּ" strong="H871a">into</char> <char style="w" x-id="t009" x-align="LAM.1.13.a006" x-src="WLC.LAM.1.13.007" x-source="י" x-translit="ay" srcloc="WLC.LAM.1.13.007" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t010" x-align="LAM.1.13.a007" x-src="WLC.LAM.1.13.006" x-source="עַצְמֹתַ֖" x-translit="ʿaṣmōṯ" srcloc="WLC.LAM.1.13.006" x-head="true" lemma="עֶצֶם" strong="H6106">bones</char>, <char style="w" x-id="t011" x-align="LAM.1.13.a008" x-src="WLC.LAM.1.13.008" x-source="וַ" x-translit="wa" srcloc="WLC.LAM.1.13.008" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t012" x-align="LAM.1.13.a009">it</char> <char style="w" x-id="t013" x-align="LAM.1.13.a009" x-src="WLC.LAM.1.13.009" x-source="יִּרְדֶּ֑" x-translit="yyird" srcloc="WLC.LAM.1.13.009" x-head="true