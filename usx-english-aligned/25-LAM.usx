	<para style="q1"><verse number="20" style="v" sid="LAM 5:20" /><char style="w" x-id="t001" x-align="LAM.5.20.a001" x-src="WLC.LAM.5.20.001 WLC.LAM.5.20.002" x-source="לָ֤ מָּה" x-translit="lā mmâ" srcloc="WLC.LAM.5.20.002" x-head="true" lemma="מָה" strong="H4100">Wherefore</char> <char style="w" x-id="t002" x-align="LAM.5.20.a004">dost</char> <char style="w" x-id="t003" x-align="LAM.5.20.a004">thou</char> <char style="w" x-id="t004" x-align="LAM.5.20.a004" x-src="WLC.LAM.5.20.005" x-source="תִּשְׁכָּחֵ֔" x-translit="tiškāḥ" srcloc="WLC.LAM.5.20.005" x-head="true" lemma="שָׁכַח" strong="H7911">forget</char> <char style="w" x-id="t005" x-align="LAM.5.20.a005" x-src="WLC.LAM.5.20.006" x-source="נוּ" x-translit="ēnû" srcloc="WLC.LAM.5.20.006" x-head="true" lemma="הוּא" strong="H5105a">us</char> <char style="w" x-id="t006" x-align="LAM.5.20.a002" x-src="WLC.LAM.5.20.003" x-source="לָ" x-translit="lā" srcloc="WLC.LAM.5.20.003" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t007" x-align="LAM.5.20.a003" x-src="WLC.LAM.5.20.004" x-source="נֶ֨צַח֙" x-translit="neṣaḥ" srcloc="WLC.LAM.5.20.004" x-head="true" lemma="נֵצַח" strong="H5331">ever</char>,</para>
	<para style="q1"><char style="add"><char style="w" x-id="t008" x-align="LAM.5.20.a008" x-status="added" x-source="∅" x-head="true">And</char></char> <char style="w" x-id="t009" x-align="LAM.5.20.a006" x-src="WLC.LAM.5.20.007" x-source="תַּֽעַזְבֵ֖" x-translit="taʿazḇ" srcloc="WLC.LAM.5.20.007" x-head="true" lemma="עָזַב" strong="H5800">forsake</char> <char style="w" x-id="t010" x-align="LAM.5.20.a007" x-src="WLC.LAM.5.20.008" x-source="נוּ" x-translit="ēnû" srcloc="WLC.LAM.5.20.008" x-head="true" lemma="הוּא" strong="H5105a">us</char> <char style="w" x-id="t011" x-align="LAM.5.20.a009" x-src="WLC.LAM.5.20.009" x-source="לְ" x-translit="lə" srcloc="WLC.LAM.5.20.009" x-head="true" lemma="לְ" strong="H3807a">so</char> <char style="w" x-id="t012" x-align="LAM.5.20.a010" x-src="WLC.LAM.5.20.010" x-source="אֹ֥רֶךְ" x-translit="ʾōreḵ" srcloc="WLC.LAM.5.20.010" x-head="true" lemma="אֹרֶךְ" strong="H753">long</char> <char style="w" x-id="t013" x-align="LAM.5.20.a011" x-src="WLC.LAM.5.20.011" x-source="יָמִֽים" x-translit="yāmiym:" srcloc="WLC.LAM.5.20.011" x-head="true" lemma="יוֹם" strong="H3117">time</char>?<verse eid="LAM 5:20" /></para>
	<para style="q1"><verse number="21" style="v" sid="LAM 5:21" /><char style="w" x-id="t001" x-align="LAM.5.21.a001" x-src="WLC.LAM.5.21.001" x-source="הֲשִׁיבֵ֨" x-translit="hăšiyḇ" srcloc="WLC.LAM.5.21.001" x-head="true" lemma="שׁוּב" strong="H7725">Turn</char> <char style="w" x-id="t002" x-align="LAM.5.21.a001">thou</char> <char style="w" x-id="t003" x-align="LAM.5.21.a002" x-src="WLC.LAM.5.21.002" x-source="נוּ" x-translit="ēnû" srcloc="WLC.LAM.5.21.002" x-head="true" lemma="הוּא" strong="H5105a">us</char> <char style="w" x-id="t004" x-align="LAM.5.21.a004" x-src="WLC.LAM.5.21.004" x-source="אֵלֶ֨י" x-translit="ʾēley" srcloc="WLC.LAM.5.21.004" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t005" x-align="LAM.5.21.a005" x-src="WLC.LAM.5.21.005" x-source="ךָ֙" x-translit="ḵā" srcloc="WLC.LAM.5.21.005" x-head="true" lemma="הוּא" strong="H3509b">thee</char>, <char style="w" x-id="t006" x-align="LAM.5.21.a003">O</char> <char style="w" x-id="t007" x-align="LAM.5.21.a003" x-src="WLC.LAM.5.21.003" x-source="יְהוָ֤ה" x-translit="yəhwāh" srcloc="WLC.LAM.5.21.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t008" x-align="LAM.5.21.a006" x-src="WLC.LAM.5.21.006" x-source="וְֽ" x-translit="**wə" srcloc="WLC.LAM.5.21.006" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="LAM.5.21.a007">we</char> <char style="w" x-id="t010" x-align="LAM.5.21.a007">shall</char> <char style="w" x-id="t011" x-align="LAM.5.21.a007">be</char> <char style="w" x-id="t012" x-align="LAM.5.21.a007" x-src="WLC.LAM.5.21.007" x-source="נָשׁ֔וּבָה" x-translit="**nāšûḇâ" srcloc="WLC.LAM.5.21.007" x-head="true" lemma="שׁוּב" strong="H7725">turned</char>;</para>
	<para style="q1"><char style="w" x-id="t013" x-align="LAM.5.21.a008" x-src="WLC.LAM.5.21.008" x-source="חַדֵּ֥שׁ" x-translit="ḥaddēš" srcloc="WLC.LAM.5.21.008" x-head="true" lemma="חָדַשׁ" strong="H2318">Renew</char> <char style="w" x-id="t014" x-align="LAM.5.21.a010" x-src="WLC.LAM.5.21.010" x-source="נוּ" x-translit="nû" srcloc="WLC.LAM.5.21.010" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t015" x-align="LAM.5.21.a009" x-src="WLC.LAM.5.21.009" x-source="יָמֵ֖י" x-translit="yāmēy" srcloc="WLC.LAM.5.21.009" x-head="true" lemma="יוֹם" strong="H3117">days</char> <char style="w" x-id="t016" x-align="LAM.5.21.a011" x-src="WLC.LAM.5.21.011" x-source="כְּ" x-translit="kə" srcloc="WLC.LAM.5.21.011" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t017" x-align="LAM.5.21.a012">of</char> <char style="w" x-id="t018" x-align="LAM.5.21.a012" x-src="WLC.LAM.5.21.012" x-source="קֶֽדֶם" x-translit="qeḏem:" srcloc="WLC.LAM.5.21.012" x-head="true" lemma="קֶדֶם" strong="H6924">old</char>.<verse eid="LAM 5:21" /></para>
	<para style="q1"><verse number="22" style="v" x-unrepresented-source="עַד" x-unrepresented-translit="ʿaḏ-" x-unrepresented-src="WLC.LAM.5.22.009" sid="LAM 5:22" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Unless thou . . .</char> and <char style="it">art etc.</char></char></note><char style="w" x-id="t001" x-align="LAM.5.22.a001" x-status="noncompositional" x-src="WLC.LAM.5.22.001 WLC.LAM.5.22.002" x-source="כִּ֚י אִם" x-translit="kî ʾim-" srcloc="WLC.LAM.5.22.001" x-head="true" lemma="כִּי" strong="H3588">But</char> <char style="w" x-id="t002" x-align="LAM.5.22.a003">thou</char> <char style="w" x-id="t003" x-align="LAM.5.22.a003">hast</char> <char style="w" x-id="t004" x-align="LAM.5.22.a002" x-src="WLC.LAM.5.22.003" x-source="מָאֹ֣ס" x-translit="māʾōs" srcloc="WLC.LAM.5.22.003" x-head="true" lemma="מָאַס" strong="H3988">utterly</char> <char style="w" x-id="t005" x-align="LAM.5.22.a003" x-src="WLC.LAM.5.22.004" x-source="מְאַסְתָּ֔" x-translit="məʾastā" srcloc="WLC.LAM.5.22.004" x-head="true" lemma="מָאַס" strong="H3988">rejected</char> <char style="w" x-id="t006" x-align="LAM.5.22.a004" x-src="WLC.LAM.5.22.005" x-source="נוּ" x-translit="nû" srcloc="WLC.LAM.5.22.005" x-head="true" lemma="הוּא" strong="H5105a">us</char>;</para>
	<para style="q1"><char style="w" x-id="t007" x-align="LAM.5.22.a005">Thou</char> <char style="w" x-id="t008" x-align="LAM.5.22.a005">art</char> <char style="w" x-id="t009" x-align="LAM.5.22.a009" x-src="WLC.LAM.5.22.010" x-source="מְאֹֽד" x-translit="məʾōḏ:" srcloc="WLC.LAM.5.22.010" x-head="true" lemma="מְאֹד" strong="H3966">very</char> <char style="w" x-id="t010" x-align="LAM.5.22.a005" x-src="WLC.LAM.5.22.006" x-source="קָצַ֥פְתָּ" x-translit="qāṣap̄ətā" srcloc="WLC.LAM.5.22.006" x-head="true" lemma="קָצַף" strong="H7107">wroth</char> <char style="w" x-id="t011" x-align="LAM.5.22.a006" x-src="WLC.LAM.5.22.007" x-source="עָלֵ֖י" x-translit="ʿālēy" srcloc="WLC.LAM.5.22.007" x-head="true" lemma="עַל" strong="H5921">against</char> <char style="w" x-id="t012" x-align="LAM.5.22.a007" x-src="WLC.LAM.5.22.008" x-source="נוּ" x-translit="nû" srcloc="WLC.LAM.5.22.008" x-head="true" lemma="הוּא" strong="H5105a">us</char>.<verse eid="LAM 5:22" /></para>
