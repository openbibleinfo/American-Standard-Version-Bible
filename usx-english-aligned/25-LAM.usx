	<para style="q1"><verse number="22" style="v" x-unrepresented-source="לְ עַל" x-unrepresented-translit="lə ʿal-" x-unrepresented-src="WLC.LAM.4.22.008 WLC.LAM.4.22.017" sid="LAM 4:22" /><note caller="-" style="f"><char style="ft">Or, <char style="it">Thine iniquity hath an end</char></char></note><char style="w" x-id="t001" x-align="LAM.4.22.a002">The</char> <char style="w" x-id="t002" x-align="LAM.4.22.a002" x-src="WLC.LAM.4.22.002" x-source="עֲוֺנֵ" x-translit="ʿăôn" srcloc="WLC.LAM.4.22.002" x-head="true" lemma="עָוֺן" strong="H5771">punishment</char> <char style="w" x-id="t003" x-align="LAM.4.22.a002">of</char> <char style="w" x-id="t004" x-align="LAM.4.22.a003" x-src="WLC.LAM.4.22.003" x-source="ךְ֙" x-translit="ēḵ" srcloc="WLC.LAM.4.22.003" x-head="true" lemma="הוּא" strong="H3509c">thine</char> <char style="w" x-id="t005" x-align="LAM.4.22.a002">iniquity</char> <char style="w" x-id="t006" x-align="LAM.4.22.a001">is</char> <char style="w" x-id="t007" x-align="LAM.4.22.a001" x-src="WLC.LAM.4.22.001" x-source="תַּם" x-translit="tam-" srcloc="WLC.LAM.4.22.001" x-head="true" lemma="תָּמַם" strong="H8552">accomplished</char>, <char style="w" x-id="t008" x-align="LAM.4.22.a004">O</char> <char style="w" x-id="t009" x-align="LAM.4.22.a004" x-src="WLC.LAM.4.22.004" x-source="בַּת" x-translit="baṯ-" srcloc="WLC.LAM.4.22.004" x-head="true" lemma="בַּת" strong="H1323">daughter</char> <char style="w" x-id="t010" x-align="LAM.4.22.a005">of</char> <char style="w" x-id="t011" x-align="LAM.4.22.a005" x-src="WLC.LAM.4.22.005" x-source="צִיּ֔וֹן" x-translit="ṣiyyôn" srcloc="WLC.LAM.4.22.005" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>; <char style="w" x-id="t012" x-align="LAM.4.22.a007">he</char> <char style="w" x-id="t013" x-align="LAM.4.22.a007">will</char> <char style="w" x-id="t014" x-align="LAM.4.22.a006" x-src="WLC.LAM.4.22.006" x-source="לֹ֥א" x-translit="lōʾ" srcloc="WLC.LAM.4.22.006" x-head="true" lemma="לֹא" strong="H3808">no</char> <char style="w" x-id="