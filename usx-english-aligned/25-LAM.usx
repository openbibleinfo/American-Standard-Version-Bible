	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">Whom Jehovah hath afflicted</char></char></note><char style="w" x-id="t028" x-align="LAM.1.12.a020" x-src="WLC.LAM.1.12.020" x-source="אֲשֶׁר֙" x-translit="ʾăšer" srcloc="WLC.LAM.1.12.020" x-head="true" lemma="אֲשֶׁר" strong="H834">Wherewith</char> <char style="w" x-id="t029" x-align="LAM.1.12.a021" x-src="WLC.LAM.1.12.022" x-source="יְהוָ֔ה" x-translit="yəhwāh" srcloc="WLC.LAM.1.12.022" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t030" x-align="LAM.1.12.a022">hath</char> <char style="w" x-id="t031" x-align="LAM.1.12.a022" x-src="WLC.LAM.1.12.021" x-source="הוֹגָ֣ה" x-translit="hôḡāh" srcloc="WLC.LAM.1.12.021" x-head="true" lemma="יָגָה" strong="H3013">afflicted</char> <char style="add"><char style="w" x-id="t032" x-align="LAM.1.12.a023" x-status="added" x-source="∅" x-head="true">me</char></char> <char style="w" x-id="t033" x-align="LAM.1.12.a024" x-src="WLC.LAM.1.12.023" x-source="בְּ" x-translit="bə" srcloc="WLC.LAM.1.12.023" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t034" x-align="LAM.1.12.a025">the</char> <char style="w" x-id="t035" x-align="LAM.1.12.a025" x-src="WLC.LAM.1.12.024" x-source="י֖וֹם" x-translit="yôm" srcloc="WLC.LAM.1.12.024" x-head="true" lemma="יוֹם" strong="H3117">day</char> <char style="w" x-id="t036" x-align="LAM.1.12.a026">of</char> <char style="w" x-id="t037" x-align="LAM.1.12.a027" x-src="WLC.LAM.1.12.027" x-source="וֹ" x-translit="ô" srcloc="WLC.LAM.1.12.027" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t038" x-align="LAM.1.12.a026" x-src="WLC.LAM.1.12.025" x-source="חֲר֥וֹן" x-translit="ḥărôn" srcloc="WLC.LAM.1.12.025" x-head="true" lemma="חָרוֹן" strong="H2740">fierce</char> <char style="w" x-id="t039" x-align="LAM.1.12.a028" x-src="WLC.LAM.1.12.026" x-source="אַפּֽ" x-translit="ʾapp" srcloc="WLC.LAM.1.12.026" x-head="true" lemma="אַף" strong="H639">anger</cha