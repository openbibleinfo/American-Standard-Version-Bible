"SBLGNT.COL.1.2.008" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t008" x-align="COL.1.2.a009" x-src="SBLGNT.COL.1.2.009" x-source="Χριστῷ" x-translit="Christōi" srcloc="SBLGNT.COL.1.2.009" x-head="true" lemma="Χριστός" strong="G5547">Christ</char> <char style="add"><char style="w" x-id="t009" x-align="COL.1.2.a001">that</char> <char style="w" x-id="t010" x-align="COL.1.2.a002">are</char></char> <char style="w" x-id="t011" x-align="COL.1.2.a002" x-src="SBLGNT.COL.1.2.002" x-source="ἐν" x-translit="en" srcloc="SBLGNT.COL.1.2.002" x-head="true" lemma="ἐν" strong="G1722">at</char> <char style="w" x-id="t012" x-align="COL.1.2.a003" x-src="SBLGNT.COL.1.2.003" x-source="Κολοσσαῖς" x-translit="Kolossais" srcloc="SBLGNT.COL.1.2.003" x-head="true" lemma="Κολοσσαί" strong="G2857">Colossae</char>: <char style="w" x-id="t013" x-align="COL.1.2.a010" x-src="SBLGNT.COL.1.2.010" x-source="χάρις" x-translit="charis" srcloc="SBLGNT.COL.1.2.010" x-head="true" lemma="χάρις" strong="G5485">Grace</char> <char style="w" x-id="t014" x-align="COL.1.2.a011">to</char> <char style="w" x-id="t015" x-align="COL.1.2.a011" x-src="SBLGNT.COL.1.2.011" x-source="ὑμῖν" x-translit="hymin" srcloc="SBLGNT.COL.1.2.011" x-head="true" lemma="σύ" strong="G5213">you</char> <char style="w" x-id="t016" x-align="COL.1.2.a012" x-src="SBLGNT.COL.1.2.012" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.COL.1.2.012" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t017" x-align="COL.1.2.a013" x-src="SBLGNT.COL.1.2.013" x-source="εἰρήνη" x-translit="eirēnē" srcloc="SBLGNT.COL.1.2.013" x-head="true" lemma="εἰρήνη" strong="G1515">peace</char> <char style="w" x-id="t018" x-align="COL.1.2.a014" x-src="SBLGNT.COL.1.2.014" x-source="ἀπὸ" x-translit="apo" srcloc="SBLGNT.COL.1.2.014" x-head="true" lemma="ἀπό" strong="G575">from</char> <char style="w" x-id="t019" x-align="COL.1.2.a015" x-src="SBLGNT.COL.1.2.015" x-source="θεοῦ" x-translit="theou" srcloc="SBLGNT.COL.1.2.015" x