	<para style="b"><verse number="3" style="v" x-unrepresented-source="τῷ τοῦ" x-unrepresented-translit="tōi tou" x-unrepresented-src="SBLGNT.COL.1.3.002 SBLGNT.COL.1.3.005" sid="COL 1:3" /></para>
	<para style="p"><char style="w" x-id="t001" x-align="COL.1.3.a001">We</char> <char style="w" x-id="t002" x-align="COL.1.3.a001">give</char> <char style="w" x-id="t003" x-align="COL.1.3.a001" x-src="SBLGNT.COL.1.3.001" x-source="Εὐχαριστοῦμεν" x-translit="Eucharistoumen" srcloc="SBLGNT.COL.1.3.001" x-head="true" lemma="εὐχαριστέω" strong="G2168">thanks</char> <char style="w" x-id="t004" x-align="COL.1.3.a003">to</char> <char style="w" x-id="t005" x-align="COL.1.3.a003" x-src="SBLGNT.COL.1.3.003" x-source="θεῷ" x-translit="theōi" srcloc="SBLGNT.COL.1.3.003" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t006" x-align="COL.1.3.a004">the</char> <char style="w" x-id="t007" x-align="COL.1.3.a004" x-src="SBLGNT.COL.1.3.004" x-source="πατρὶ" x-translit="patri" srcloc="SBLGNT.COL.1.3.004" x-head="true" lemma="πατήρ" strong="G3962">Father</char> <char style="w" x-id="t008" x-align="COL.1.3.a006">of</char> <char style="w" x-id="t009" x-align="COL.1.3.a007" x-src="SBLGNT.COL.1.3.007" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.COL.1.3.007" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t010" x-align="COL.1.3.a006" x-src="SBLGNT.COL.1.3.006" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.COL.1.3.006" x-head="true" lemma="κύριος" strong="G2962">Lord</char> <char style="w" x-id="t011" x-align="COL.1.3.a008" x-src="SBLGNT.COL.1.3.008" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.COL.1.3.008" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t012" x-align="COL.1.3.a009" x-src="SBLGNT.COL.1.3.009" x-source="Χριστοῦ" x-translit="Christou" srcloc="SBLGNT.COL.1.3.009" x-head="true" lemma="Χριστός" strong="G5547">Christ</char>, <char style="w" x-id="t013" x-align="COL.1.3.a013" x-src="SBLGNT.COL.1.3.013" x-source="προσευχόμενοι" x-translit="proseuchomenoi" srcloc="SBLGNT.COL.1.3.013" x-head="true" lemma="προσεύχομαι" strong="G4336">praying</char> <char style="w" x-id="t014" x-align="COL