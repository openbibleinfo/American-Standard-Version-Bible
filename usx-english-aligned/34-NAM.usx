	<para style="p"><verse number="1" style="v" sid="NAM 1:1" /><char style="w" x-id="t001" x-align="NAM.1.1.a001">The</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">oracle concerning</char></char></note><char style="w" x-id="t002" x-align="NAM.1.1.a001" x-src="WLC.NAM.1.1.001" x-source="מַשָּׂ֖א" x-translit="maśśāʾ" srcloc="WLC.NAM.1.1.001" x-head="true" lemma="מַשָּׂא" strong="H4853a">burden</char> <char style="w" x-id="t003" x-align="NAM.1.1.a002">of</char> <char style="w" x-id="t004" x-align="NAM.1.1.a002" x-src="WLC.NAM.1.1.002" x-source="נִֽינְוֵ֑ה" x-translit="niynəwēh" srcloc="WLC.NAM.1.1.002" x-head="true" lemma="נִינְוֵה" strong="H5210">Nineveh</char>. <char style="w" x-id="t005" x-align="NAM.1.1.a003">The</char> <char style="w" x-id="t006" x-align="NAM.1.1.a003" x-src="WLC.NAM.1.1.003" x-source="סֵ֧פֶר" x-translit="sēp̄er" srcloc="WLC.NAM.1.1.003" x-head="true" lemma="סֵפֶר" strong="H5612">book</char> <char style="w" x-id="t007" x-align="NAM.1.1.a004">of</char> <char style="w" x-id="t008" x-align="NAM.1.1.a004">the</char> <char style="w" x-id="t009" x-align="NAM.1.1.a004" x-src="WLC.NAM.1.1.004" x-source="חֲז֛וֹן" x-translit="ḥăzôn" srcloc="WLC.NAM.1.1.004" x-head="true" lemma="חָזוֹן" strong="H2377">vision</char> <char style="w" x-id="t010" x-align="NAM.1.1.a005">of</char> <char style="w" x-id="t011" x-align="NAM.1.1.a005" x-src="WLC.NAM.1.1.005" x-source="נַח֖וּם" x-translit="naḥûm" srcloc="WLC.NAM.1.1.005" x-head="true" lemma="נַחוּם" strong="H5151">Nahum</char> <char style="w" x-id="t012" x-align="NAM.1.1.a006" x-src="WLC.NAM.1.1.006" x-source="הָ" x-translit="hā" srcloc="WLC.NAM.1.1.006" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t013" x-align="NAM.1.1.a007" x-src="WLC.NAM.1.1.007" x-source="אֶלְקֹשִֽׁי" x-translit="ʾelqōšiy:" srcloc="WLC.NAM.1.1.007" x-head="true" lemma="אֶלְקֹשִׁי" strong="H512">Elkoshite</char>.<verse eid="NAM 1:1" /></para>
