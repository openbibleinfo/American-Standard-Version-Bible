	<para style="p"><verse number="1" style="v" sid="MAL 1:1" /><char style="w" x-id="t001" x-align="MAL.1.1.a001">The</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">oracle</char></char></note><char style="w" x-id="t002" x-align="MAL.1.1.a001" x-src="WLC.MAL.1.1.001" x-source="מַשָּׂ֥א" x-translit="maśśāʾ" srcloc="WLC.MAL.1.1.001" x-head="true" lemma="מַשָּׂא" strong="H4853a">burden</char> <char style="w" x-id="t003" x-align="MAL.1.1.a002">of</char> <char style="w" x-id="t004" x-align="MAL.1.1.a002">the</char> <char style="w" x-id="t005" x-align="MAL.1.1.a002" x-src="WLC.MAL.1.1.002" x-source="דְבַר" x-translit="ḏəḇar-" srcloc="WLC.MAL.1.1.002" x-head="true" lemma="דָּבָר" strong="H1697">word</char> <char style="w" x-id="t006" x-align="MAL.1.1.a003">of</char> <char style="w" x-id="t007" x-align="MAL.1.1.a003" x-src="WLC.MAL.1.1.003" x-source="יְהוָ֖ה" x-translit="yəhwāh" srcloc="WLC.MAL.1.1.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t008" x-align="MAL.1.1.a004" x-src="WLC.MAL.1.1.004" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.MAL.1.1.004" x-head="true" lemma="אֶל" strong="H413">to</char> <char style="w" x-id="t009" x-align="MAL.1.1.a005" x-src="WLC.MAL.1.1.005" x-source="יִשְׂרָאֵ֑ל" x-translit="yiśrāʾēl" srcloc="WLC.MAL.1.1.005" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char> <char style="w" x-id="t010" x-align="MAL.1.1.a006" x-src="WLC.MAL.1.1.006 WLC.MAL.1.1.007" x-source="בְּ יַ֖ד" x-translit="bə yaḏ" srcloc="WLC.MAL.1.1.007" x-head="true" lemma="יָד" strong="H3027">by</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">my messenger</char></char></note><char style="w" x-id="t011" x-align="MAL.1.1.a007" x-src="WLC.MAL.1.1.008" x-source="מַלְאָכִֽי" x-translit="malʾāḵiy:" srcloc="WLC.MAL.1.1.008" x-head="true" lemma="מַלְאָכִי" strong="H4401">Malachi</char>.<verse eid="MAL 1:1" /></para>
	<para style="p"><verse number="2" style="v" x-unrepresented-source="אֶתְ הֲ אֶֽת" x-unrepresented-translit="ʾeṯ hă ʾeṯ-" x-unrepresented-src="WLC.MAL.1.2.002 WLC.MAL.1.2.012 WLC.MAL.1.2.022" sid="MAL 1:2" /><char style="w" x-id="t001" x-align="MAL.1.2.a001">I</char> <char style="w" x-id="t002" x-align="MAL.1.2.a001">have</char> <char style="w" x-id="t003" x-align="MAL.1.2.a001" x-src="WLC.MAL.1.2.001" x-source="אָהַ֤בְתִּי" x-translit="ʾāhaḇətî" srcloc="WLC.MAL.1.2.001" x-head="true" lemma="אָהֵב" strong="H157">loved</char> <char style="w" x-id="t004" x-align="MAL.1.2.a003" x-src="WLC.MAL.1.2.003" x-source="כֶם֙" x-translit="əḵem" srcloc="WLC.MAL.1.2.003" x-head="true" lemma="הוּא" strong="H3641b">you</char>, <char style="w" x-id="t005" x-align="MAL.1.2.a004" x-src="WLC.MAL.1.2.004" x-source="אָמַ֣ר" x-translit="ʾāmar" srcloc="WLC.MAL.1.2.004" x-head="true" lemma="אָמַר" strong="H559">saith</char> <char style="w" x-id="t006" x-align="MAL.1.2.a005" x-src="WLC.MAL.1.2.005" x-source="יְהוָ֔ה" x-translit="yəhwāh" srcloc="WLC.MAL.1.2.005" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>. <char style="w" x-id="t007" x-align="MAL.1.2.a006" x-src="WLC.MAL.1.2.006" x-source="וַ" x-translit="wa" srcloc="WLC.MAL.1.2.006" x-head="true" lemma="וְ" strong="H2050b">Yet</char> <char style="w" x-id="t008" x-align="MAL.1.2.a007">ye</char> <char style="w" x-id="t009" x-align="MAL.1.2.a007" x-src="WLC.MAL.1.2.007" x-source="אֲמַרְתֶּ֖ם" x-translit="ʾămartem" srcloc="WLC.MAL.1.2.007" x-head="true" lemma="אָמַר" strong="H559">say</char>, <char style="w" x-id="t010" x-align="MAL.1.2.a008" x-src="WLC.MAL.1.2.008 WLC.MAL.1.2.009" x-source="בַּ מָּ֣ה" x-translit="ba mmāh" srcloc="WLC.MAL.1.2.009" x-head="true" lemma="מָה" strong="H4100">Wherein</char> <char style="w" x-id="t011" x-align="MAL.1.2.a009">hast</char> <char style="w" x-id="t012" x-align="MAL.1.2.a009">thou</char> <char style="w" x-id="t013" x-align="MAL.1.2.a009" x-src="WLC.MAL.1.2.010" x-source="אֲהַבְתָּ֑" x-translit="ʾăhaḇtā" srcloc="WLC.MAL.1.2.010" x-head="true" lemma="אָהֵב" strong="H157">loved</char> <char style="w" x-id="t014" x-align="MAL.1.2.a010" x-src="WLC.MAL.1.2.011" x-source="נוּ" x-translit="nû" srcloc="WLC.MAL.1.2.011" x-head="true" lemma="הוּא" strong="H5105a">us</char>? <note caller="-" style="f"><char style="ft">Or, <char style="it">Is not Esau . . . yet I have loved etc.</char></char></note><char style="w" x-id="t015" x-align="MAL.1.2.a013">Was</char> <char style="w" x-id="t016" x-align="MAL.1.2.a012" x-src="WLC.MAL.1.2.013" x-source="לוֹא" x-translit="lôʾ-" srcloc="WLC.MAL.1.2.013" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t017" x-align="MAL.1.2.a014" x-src="WLC.MAL.1.2.015" x-source="עֵשָׂ֤ו" x-translit="ʿēśāw" srcloc="WLC.MAL.1.2.015" x-head="true" lemma="עֵשָׂו" strong="H6215">Esau</char> <char style="w" x-id="t018" x-align="MAL.1.2.a015" x-src="WLC.MAL.1.2.016 WLC.MAL.1.2.017" x-source="לְ יַֽעֲקֹב֙" x-translit="lə yaʿăqōḇ" srcloc="WLC.MAL.1.2.017" x-head="true" lemma="יַעֲקֹב" strong="H3290">Jacob’s</char> <char style="w" x-id="t019" x-align="MAL.1.2.a013" x-src="WLC.MAL.1.2.014" x-source="אָ֨ח" x-translit="ʾāḥ" srcloc="WLC.MAL.1.2.014" x-head="true" lemma="אָח" strong="H251">brother</char>? <char style="w" x-id="t020" x-align="MAL.1.2.a016" x-src="WLC.MAL.1.2.018" x-source="נְאֻם" x-translit="nəʾum-" srcloc="WLC.MAL.1.2.018" x-head="true" lemma="נְאֻם" strong="H5002">saith</char> <char style="w" x-id="t021" x-align="MAL.1.2.a017" x-src="WLC.MAL.1.2.019" x-source="יְהוָ֔ה" x-translit="yəhwāh" srcloc="WLC.MAL.1.2.019" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>: <char style="w" x-id="t022" x-align="MAL.1.2.a018" x-src="WLC.MAL.1.2.020" x-source="וָ" x-translit="wā" srcloc="WLC.MAL.1.2.020" x-head="true" lemma="וְ" strong="H2050b">yet</char> <char style="w" x-id="t023" x-align="MAL.1.2.a019">I</char> <char style="w" x-id="t024" x-align="MAL.1.2.a019" x-src="WLC.MAL.1.2.021" x-source="אֹהַ֖ב" x-translit="ʾōhaḇ" srcloc="WLC.MAL.1.2.021" x-head="true" lemma="אָהֵב" strong="H157">loved</char> <char style="w" x-id="t025" x-align="MAL.1.2.a021" x-src="WLC.MAL.1.2.023" x-source="יַעֲקֹֽב" x-translit="yaʿăqōḇ:" srcloc="WLC.MAL.1.2.023" x-head="true" lemma="יַעֲקֹב" strong="H3290">Jacob</char>; <verse eid="MAL 1:2" /><verse number="3" style="v" x-unrepresented-source="אֶת אֶת אֶת" x-unrepresented-translit="ʾeṯ- ʾeṯ- ʾeṯ-" x-unrepresented-src="WLC.MAL.1.3.002 WLC.MAL.1.3.007 WLC.MAL.1.3.012" sid="MAL 1:3" /><char style="w" x-id="t001" x-align="MAL.1.3.a001" x-src="WLC.MAL.1.3.001" x-source="וְ" x-translit="wə" srcloc="WLC.MAL.1.3.001" x-head="true" lemma="וְ" strong="H2050b">but</char> <char style="w" x-id="t002" x-align="MAL.1.3.a003" x-src="WLC.MAL.1.3.003" x-source="עֵשָׂ֖ו" x-translit="ʿēśāw" srcloc="WLC.MAL.1.3.003" x-head="true" lemma="עֵשָׂו" strong="H6215">Esau</char> <char style="w" x-id="t003" x-align="MAL.1.3.a004">I</char> <char style="w" x-id="t004" x-align="MAL.1.3.a004" x-src="WLC.MAL.1.3.004" x-source="שָׂנֵ֑אתִי" x-translit="śānēʾṯî" srcloc="WLC.MAL.1.3.004" x-head="true" lemma="שָׂנֵא" strong="H8130">hated</char>, <char style="w" x-id="t005" x-align="MAL.1.3.a005" x-src="WLC.MAL.1.3.005" x-source="וָ" x-translit="wā" srcloc="WLC.MAL.1.3.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t006" x-align="MAL.1.3.a006" x-src="WLC.MAL.1.3.006" x-source="אָשִׂ֤ים" x-translit="ʾāśiym" srcloc="WLC.MAL.1.3.006" x-head="true" lemma="שׂים" strong="H7760">made</char> <char style="w" x-id="t007" x-align="MAL.1.3.a009" x-src="WLC.MAL.1.3.009" x-source="ו֙" x-translit="w" srcloc="WLC.MAL.1.3.009" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t008" x-align="MAL.1.3.a008" x-src="WLC.MAL.1.3.008" x-source="הָרָי" x-translit="hārāy" srcloc="WLC.MAL.1.3.008" x-head="true" lemma="הַר" strong="H2022">mountains</char> <char style="w" x-id="t009" x-align="MAL.1.3.a010">a</char> <char style="w" x-id="t010" x-align="MAL.1.3.a010" x-sr