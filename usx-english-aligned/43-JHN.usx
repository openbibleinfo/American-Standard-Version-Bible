	<para style="p"><verse number="1" style="v" sid="JHN 5:1" /><char style="w" x-id="t001" x-align="JHN.5.1.a001" x-src="SBLGNT.JHN.5.1.001" x-source="Μετὰ" x-translit="Meta" srcloc="SBLGNT.JHN.5.1.001" x-head="true" lemma="μετά" strong="G3326">After</char> <char style="w" x-id="t002" x-align="JHN.5.1.a002" x-src="SBLGNT.JHN.5.1.002" x-source="ταῦτα" x-translit="tauta" srcloc="SBLGNT.JHN.5.1.002" x-head="true" lemma="οὗτος" strong="G5023">these</char> <char style="w" x-id="t003" x-align="JHN.5.1.a002">things</char> <char style="w" x-id="t004" x-align="JHN.5.1.a003">there</char> <char style="w" x-id="t005" x-align="JHN.5.1.a003" x-src="SBLGNT.JHN.5.1.003" x-source="ἦν" x-translit="ēn" srcloc="SBLGNT.JHN.5.1.003" x-head="true" lemma="εἰμί" strong="G2258">was</char> <note caller="-" style="f"><char style="ft">Many ancient authorities read <char style="it">the feast</char> (Compare <ref loc="JHN 2:13">2:13</ref>?).</char></note><char style="w" x-id="t006" x-align="JHN.5.1.a004">a</char> <char style="w" x-id="t007" x-align="JHN.5.1.a004" x-src="SBLGNT.JHN.5.1.004" x-source="ἑορτὴ" x-translit="heortē" srcloc="SBLGNT.JHN.5.1.004" x-head="true" lemma="ἑορτή" strong="G1859">feast</char> <char style="w" x-id="t008" x-align="JHN.5.1.a005">of</char> <char style="w" x-id="t009" x-align="JHN.5.1.a005" x-src="SBLGNT.JHN.5.1.005" x-source="τῶν" x-translit="tōn" srcloc="SBLGNT.JHN.5.1.005" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t010" x-align="JHN.5.1.a006" x-src="SBLGNT.JHN.5.1.006" x-source="Ἰουδαίων" x-translit="Ioudaiōn" srcloc="SBLGNT.JHN.5.1.006" x-head="true" lemma="Ἰουδαῖος" strong="G2453">Jews</char>; <char style="w" x-id="t011" x-align="JHN.5.1.a007" x-src="SBLGNT.JHN.5.1.007" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.JHN.5.1.007" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t012" x-align="JHN.5.1.a009" x-src="SBLGNT.JHN.5.1.009" x-source="Ἰησοῦς" x-translit="Iēsous" srcloc="SBLGNT.JHN.5.1.009" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t013" x-align="JHN.5.1.a008" x-src="SBLGNT.JHN.5.1.008" x-source="ἀνέβη" x-translit="anebē" srcloc="SBLGNT.JHN.5.1.008" x-head="true" lemma="ἀναβαίνω" strong="G305">went</char> <char style="w" x-id="t014" x-align="JHN.5.1.a008">up</char> <char style="w" x-id="t015" x-align="JHN.5.1.a010" x-src="SBLGNT.JHN.5.1.010" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.JHN.5.1.010" x-head="true" lemma="εἰς" strong="G1519">to</char> <char style="w" x-id="t016" x-align="JHN.5.1.a011" x-src="SBLGNT.JHN.5.1.011" x-source="Ἱεροσόλυμα" x-translit="Hierosolyma" srcloc="SBLGNT.JHN.5.1.011" x-head="true" lemma="Ἱεροσόλυμα" strong="G2414">Jerusalem</char>.<verse eid="JHN 5:1" /></para>
	<para style="p"><verse number="2" style="v" x-unrepresented-source="τοῖς ἡ" x-unrepresented-translit="tois hē" x-unrepresented-src="SBLGNT.JHN.5.2.004 SBLGNT.JHN.5.2.010" sid="JHN 5:2" /><char style="w" x-id="t001" x-align="JHN.5.2.a001" x-src="SBLGNT.JHN.5.2.002" x-source="δὲ" x-translit="de" srcloc="SBLGNT.JHN.5.2.002" x-head="true" lemma="δέ" strong="G1161">Now</char> <char style="w" x-id="t002" x-align="JHN.5.2.a002">there</char> <char style="w" x-id="t003" x-align="JHN.5.2.a002" x-src="SBLGNT.JHN.5.2.001" x-source="ἔστιν" x-translit="estin" srcloc="SBLGNT.JHN.5.2.001" x-head="true" lemma="εἰμί" strong="G2076">is</char> <char style="w" x-id="t004" x-align="JHN.5.2.a003" x-src="SBLGNT.JHN.5.2.003" x-source="ἐν" x-translit="en" srcloc="SBLGNT.JHN.5.2.003" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t005" x-align="JHN.5.2.a005" x-src="SBLGNT.JHN.5.2.005" x-source="Ἱεροσολύμοις" x-translit="Hierosolymois" srcloc="SBLGNT.JHN.5.2.005" x-head="true" lemma="Ἱεροσόλυμα" strong="G2414">Jerusalem</char> <char style="w" x-id="t006" x-align="JHN.5.2.a006" x-src="SBLGNT.JHN.5.2.006" x-source="ἐπὶ" x-translit="epi" srcloc="SBLGNT.JHN.5.2.006" x-head="true" lemma="ἐπί" strong="G1909">by</char> <char style="w" x-id="t007" x-align="JHN.5.2.a007" x-src="SBLGNT.JHN.5.2.007" x-source="τῇ" x-translit="tēi" srcloc="SBLGNT.JHN.5.2.007" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t008" x-align="JHN.5.2.a008" x-src="SBLGNT.JHN.5.2.008" x-source="προβατικῇ" x-translit="probatikēi" srcloc="SBLGNT.JHN.5.2.008" x-head="true" lemma="προβατικός" strong="G4262">sheep</char> <char style="add"><char style="w" x-id="t009" x-align="JHN.5.2.a008">gate</char></char> <char style="w" x-id="t010" x-align="JHN.5.2.a009">a</char> <char style="w" x-id="t011" x-align="JHN.5.2.a009" x-src="SBLGNT.JHN.5.2.009" x-source="κολυμβήθρα" x-translit="kolymbēthra" srcloc="SBLGNT.JHN.5.2.009" x-head="true" lemma="κολυμβήθρα" strong="G2861">pool</char>, <char style="w" x-id="t012" x-align="JHN.5.2.a011">which</char> <char style="w" x-id="t013" x-align="JHN.5.2.a011">is</char> <char style="w" x-id="t014" x-align="JHN.5.2.a011" x-src="SBLGNT.JHN.5.2.011" x-source="ἐπιλεγομένη" x-translit="epilegomenē" srcloc="SBLGNT.JHN.5.2.011" x-head="true" lemma="ἐπιλέγω" strong="G1951">called</char> <char style="w" x-id="t015" x-align="JHN.5.2.a012">in</char> <char style="w" x-id="t016" x-align="JHN.5.2.a012" x-src="SBLGNT.JHN.5.2.012" x-source="Ἑβραϊστὶ" x-translit="Hebraisti" srcloc="SBLGNT.JHN.5.2.012" x-head="true" lemma="Ἑβραϊστί" strong="G1447">Hebrew</char> <note caller="-" style="f"><char style="ft">Some ancient authorities read <char style="it">Bethsaida</char>, others <char style="it">Bethzatha</char></char></note><char style="w" x-id="t017" x-align="JHN.5.2.a013" x-src="SBLGNT.JHN.5.2.013" x-source="Βηθεσδά" x-translit="Bēthesda" srcloc="SBLGNT.JHN.5.2.013" x-head="true" lemma="Βηθεσδά" strong="G964">Bethesda</char>, <char style="w" x-id="t018" x-align="JHN.5.2.a014" x-src="SBLGNT.JHN.5.2.016" x-source="ἔχουσα" x-translit="echousa" srcloc="SBLGNT.JHN.5.2.016" x-head="true" lemma="ἔχω" strong="G2192">having</char> <char style="w" x-id="t019" x-align="JHN.5.2.a015" x-src="SBLGNT.JHN.5.2.014" x-source="πέντε" x-translit="pente" srcloc="SBLGNT.JHN.5.2.014" x-head="true" lemma="πέντε" strong="G4002">five</char> <char style="w" x-id="t020" x-align="JHN.5.2.a016" x-src="SBLGNT.JHN.5.2.015" x-source="στοὰς" x-translit="stoas" srcloc="SBLGNT.JHN.5.2.015" x-head="true" lemma="στοά" strong="G4745">porches</char>. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" /><char style="w" x-id="t001" x-align="JHN.5.3.a001" x-src="SBLGNT.JHN.5.3.001" x-source="ἐν" x-translit="en" srcloc="SBLGNT.JHN.5.3.001" x-head="true" lemma="ἐν" strong="G1722">In</char> <char style="w" x-id="t002" x-align="JHN.5.3.a002" x-src="SBLGNT.JHN.5.3.002" x-source="ταύταις" x-translit="tautais" srcloc="SBLGNT.JHN.5.3.002" x-head="true" lemma="οὗτος" strong="G5025">these</char> <char style="w" x-id="t003" x-align="JHN.5.3.a003" x-src="SBLGNT.JHN.5.3.003" x-source="κατέκειτο" x-translit="katekeito" srcloc="SBLGNT.JHN.5.3.003" x-head="true" lemma="κατάκειμαι" strong="G2621">lay</char> <char style="w" x-id="t004" x-align="JHN.5.3.a004">a</char> <char style="w" x-id="t005" x-align="JHN.5.3.a004" x-src="SBLGNT.JHN.5.3.004" x-source="πλῆθος" x-translit="plēthos" srcloc="SBLGNT.JHN.5.3.004" x-head="true" lemma="πλῆθος" strong="G4128">multitude</char> <char style="w" x-id="t006" x-align="JHN.5.3.a005">of</char> <char style="w" x-id="t007" x-align="JHN.5.3.a005" x-src="SBLGNT.JHN.5.3.005" x-source="τῶν" x-translit="tōn" srcloc="SBLGNT.JHN.5.3.005" x-head="true" lemma="ὁ" strong="G3588">them</char> <char style="w" x-id="t008" x-align="JHN.5.3.a006">that</char> <char style="w" x-id="t009" x-align="JHN.5.3.a006">were</char> <char style="w" x-id="t010" x-align="JHN.5.3.a006" x-src="SBLGNT.JHN.5.3.006" x-source="ἀσθενούντων" x-translit="asthenountōn" srcloc="SBLGNT.JHN.5.3.006" x-head="true" lemma="ἀσθενέω" strong="G770">sick</char>, <char style="w" x-id="t011" x-align="JHN.5.3.a007" x-src="SBLGNT.JHN.5.3.007" x-source="τυφλῶν" x-translit="typhlōn" srcloc="SBLGNT.JHN.5.3.007" x-head="true" lemma="τυφλός" strong="G5185">blind</char>, <char style="w" x-id="t012" x-align="JHN.5.3.a008" x-src="SBLGNT.JHN.5.3.008" x-source="χωλῶν" x-translit="chōlōn" srcloc="SBLGNT.JHN.5.3.008" x-head="true" lemma="χωλός" strong="G5560">halt</char>, <char style="w" x-id="t013" x-align="JHN.5.3.a009" x-src="SBLGNT.JHN.5.3.009" x-source="ξηρῶν" x-translit="xērōn" srcloc="SBLGNT.JHN.5.3.009" x-head="true" lemma="ξηρός" strong="G3584">withered</char><note caller="-" style="f" x-footnote-id="JHN.5.3.n01" x-host-ref="JHN.5.3" x-source-citation="SBLGNT apparatus 5:3 (SBLGNT.JHN.5.3.v005, r01, witnesses RP); pinned TEI reading" x-source-projection="bounded apparatus fallback; not exact ASV note reconstruction" x-projection-limitations="The only pinned insertion candidate has no Κυρίου corresponding to ASV 'of the Lord'. The candidate reads ἐν τῇ κολυμβήθρᾳ where ASV writes 'into the pool'. Do not invent Greek or silently treat this as an exact historical ASV source reconstruction."><char style="ft">Many ancient authorities insert, wholly or in part, <char style="it"><char style="w" x-id="JHN.5.3.n01.t001" x-align="JHN.5.3.n01.a001" x-src="JHN.5.3.n01.s001" x-source="ἐκδεχομένων" x-translit="ekdechomenōn" srcloc="JHN.5.3.n01.s001" x-head="true">waiting</char> <char style="w" x-id="JHN.5.3.n01.t002" x-align="JHN.5.3.n01.a001">for</char> <char style="w" x-id="JHN.5.3.n01.t003" x-align="JHN.5.3.n01.a002" x-src="JHN.5.3.n01.s002" x-source="τὴν" x-translit="tēn" srcloc="JHN.5.3.n01.s002" x-head="true">the</char> <char style="w" x-id="JHN.5.3.n01.t004" x-align="JHN.5.3.n01.a005" x-src="JHN.5.3.n01.s005" x-source="κίνησιν" x-translit="kinēsin" srcloc="JHN.5.3.n01.s005" x-head="true">moving</char> <char style="w" x-id="JHN.5.3.n01.t005" x-align="JHN.5.3.n01.a003">of</char> <char style="w" x-id="JHN.5.3.n01.t006" x-align="JHN.5.3.n01.a003" x-src="JHN.5.3.n01.s003" x-source="τοῦ" x-translit="tou" srcloc="JHN.5.3.n01.s003" x-head="true">the</char> <char style="w" x-id="JHN.5.3.n01.t007" x-align="JHN.5.3.n01.a004" x-src="JHN.5.3.n01.s004" x-source="ὕδατος" x-translit="hydatos" srcloc="JHN.5.3.n01.s004" x-head="true">water</char>:</char> <char style="fv">4</char><char style="it"><char style="w" x-id="JHN.5.3.n01.t008" x-align="JHN.5.3.n01.a007" x-src="JHN.5.3.n01.s007" x-source="γὰρ" x-translit="gar" srcloc="JHN.5.3.n01.s007" x-head="true">for</char> <char style="w" x-id="JHN.5.3.n01.t009" x-align="JHN.5.3.n01.a006">an</char> <char style="w" x-id="JHN.5.3.n01.t010" x-align="JHN.5.3.n01.a006" x-src="JHN.5.3.n01.s006" x-source="ἄγγελος" x-translit="angelos" srcloc="JHN.5.3.n01.s006" x-head="true">angel</char> <char style="w" x-id="JHN.5.3.n01.t011" x-align="JHN.5.3.n01.a008" x-status="added">of</char> <char style="w" x-id="JHN.5.3.n01.t0