	<para style="p"><note caller="-" style="f"><char style="ft">Most of the ancient authorities omit <ref loc="JHN 7:53-8:11">7:53–8:11</ref>. Those which contain it vary much from each other.</char></note>[<char style="w" x-id="t001" x-align="JHN.7.53.a001" x-src="SBLGNT.JHN.7.53.001" x-source="Καὶ" x-translit="Kai" srcloc="SBLGNT.JHN.7.53.001" x-head="true" lemma="καί" strong="G2532">And</char> <char style="w" x-id="t002" x-align="JHN.7.53.a002">they</char> <char style="w" x-id="t003" x-align="JHN.7.53.a002" x-src="SBLGNT.JHN.7.53.002" x-source="ἐπορεύθη" x-translit="eporeuthē" srcloc="SBLGNT.JHN.7.53.002" x-head="true" lemma="πορεύομαι" strong="G4198">went</char> <char style="w" x-id="t004" x-align="JHN.7.53.a003" x-src="SBLGNT.JHN.7.53.003" x-source="ἕκαστος" x-translit="hekastos" srcloc="SBLGNT.JHN.7.53.003" x-head="true" lemma="ἕκαστος" strong="G1538">every</char> <char style="w" x-id="t005" x-align="JHN.7.53.a003">man</char> <char style="w" x-id="t006" x-align="JHN.7.53.a004" x-src="SBLGNT.JHN.7.53.004" x-source="εἰς" x-translit="eis" srcloc="SBLGNT.JHN.7.53.004" x-head="true" lemma="εἰς" strong="G1519">unto</char> <char style="w" x-id="t007" x-align="JHN.7.53.a007" x-src="SBLGNT.JHN.7.53.007" x-source="αὐτοῦ" x-translit="autou" srcloc="SBLGNT.JHN.7.53.007" x-head="true" lemma="αὐτός" strong="G846">his</char> <char style="w" x-id="t008" x-align="JHN.7.53.a007">own</char> <char style="w" x-id="t009" x-align="JHN.7.53.a006" x-src="SBLGNT.JHN.7.53.006" x-source="οἶκον" x-translit="oikon" srcloc="SBLGNT.JHN.7.53.006" x-head="true" lemma="οἶκος" strong="G3624">house</char>:<verse eid="JHN 7:53" /></para>
