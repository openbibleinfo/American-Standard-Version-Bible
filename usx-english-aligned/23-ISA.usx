	<para style="q1"><verse number="17" style="v" sid="ISA 38:17" /><char style="w" x-id="t001" x-align="ISA.38.17.a001" x-src="WLC.ISA.38.17.001" x-source="הִנֵּ֥ה" x-translit="hinnēh" srcloc="WLC.ISA.38.17.001" x-head="true" lemma="הִנֵּה" strong="H2009">Behold</char>, <char style="add"><char style="w" x-id="t002" x-align="ISA.38.17.a002">it</char> <char style="w" x-id="t003" x-align="ISA.38.17.a002">was</char></char> <char style="w" x-id="t004" x-align="ISA.38.17.a002" x-src="WLC.ISA.38.17.002" x-source="לְ" x-translit="lə" srcloc="WLC.ISA.38.17.002" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="add"><char style="w" x-id="t005" x-align="ISA.38.17.a003" x-status="added" x-source="∅" x-head="true">my</char></char> <char style="w" x-id="t006" x-align="ISA.38.17.a004" x-src="WLC.ISA.38.17.003" x-source="שָׁל֖וֹם" x-translit="šālôm" srcloc="WLC.ISA.38.17.003" x-head="true" lemma="שָׁלוֹם" strong="H7965">peace</char> <char style="add"><char style="w" x-id="t007" x-align="ISA.38.17.a005" x-status="added" x-source="∅" x-head="true">that</char></char> <char style="w" x-id="t008" x-align="ISA.38.17.a008" x-src="WLC.ISA.38.17.006" x-source="י" x-translit="iy" srcloc="WLC.ISA.38.17.006" x-head="true" lemma="הוּא" strong="H2967a">I</char> <char style="w" x-id="t009" x-align="ISA.38.17.a007" x-src="WLC.ISA.38.17.005" x-source="לִ֣" x-translit="l" srcloc="WLC.ISA.38.17.005" x-head="true" lemma="לְ" strong="H3807a">had</char> <char style="w" x-id="t010" x-align="ISA.38.17.a006" x-src="WLC.ISA.38.17.004" x-source="מַר" x-translit="mar-" srcloc="WLC.ISA.38.17.004" x-head="true" lemma="מרר" strong="H4751">great</char> <char style="w" x-id="t011" x-align="ISA.38.17.a009" x-src="WLC.ISA.38.17.007" x-source="מָ֑ר" x-translit="mār" srcloc="WLC.ISA.38.17.007" x-head="true" lemma="מַר" strong="H4843">bitterness</char>:</para>
