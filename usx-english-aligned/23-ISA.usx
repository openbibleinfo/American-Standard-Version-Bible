	<para style="q1"><verse number="13" style="v" x-unrepresented-source="[הַ]" x-unrepresented-translit="[ha]" x-unrepresented-src="WLC.ISA.38.13.005" sid="ISA 38:13" /><note caller="-" style="f"><char style="ft">Or, <char style="it">I thought until morning, As a lion, so will he break etc.</char></char></note><char style="w" x-id="t001" x-align="ISA.38.13.a001">I</char> <char style="w" x-id="t002" x-align="ISA.38.13.a001" x-src="WLC.ISA.38.13.001" x-source="שִׁוִּ֤יתִי" x-translit="šiwwiyṯî" srcloc="WLC.ISA.38.13.001" x-head="true" lemma="שָׁוָה" strong="H7737">quieted</char> <char style="add"><char style="w" x-id="t003" x-align="ISA.38.13.a001">myself</char></char> <char style="w" x-id="t004" x-align="ISA.38.13.a002" x-src="WLC.ISA.38.13.002" x-source="עַד" x-translit="ʿaḏ-" srcloc="WLC.ISA.38.13.002" x-head="true" lemma="עַד" strong="H5704">until</char> <char style="w" x-id="t005" x-align="ISA.38.13.a003" x-src="WLC.ISA.38.13.003" x-source="בֹּ֨קֶר֙" x-translit="bōqer" srcloc="WLC.ISA.38.13.003" x-head="true" lemma="בֹּקֶר" strong="H1242">morning</char>; <char style="w" x-id="t006" x-align="ISA.38.13.a004" x-src="WLC.ISA.38.13.004" x-source="כָּֽ" x-translit="kā" srcloc="WLC.ISA.38.13.004" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t007" x-align="ISA.38.13.a006">a</char> <char style="w" x-id="t008" x-align="ISA.38.13.a006" x-src="WLC.ISA.38.13.006" x-source="אֲרִ֔י" x-translit="ʾăriy" srcloc="WLC.ISA.38.13.006" x-head="true" lemma="אֲרִי" strong="H738">lion</char>, <char style="w" x-id="t009" x-align="ISA.38.13.a007" x-src="WLC.ISA.38.13.007" x-source="כֵּ֥ן" x-translit="kēn" srcloc="WLC.ISA.38.13.007" x-head="true" lemma="כֵּן" strong="H3651">so</char> <char style="w" x-id="t010" x-align="ISA.38.13.a008">he</char> <char style="w" x-id="t011" x-align="ISA.38.13.a008" x-src="WLC.ISA.38.13.008" x-source="יְשַׁבֵּ֖ר" x-translit="yəšabbēr" srcloc="WLC.ISA.38.13.008" x-head="true" lemma="שָׁבַר" strong="H7665">breaketh</char> <char style="