	<para style="p"><char style="w" x-id="t001" x-align="ISA.40.1.a001" x-src="WLC.ISA.40.1.001" x-source="נַחֲמ֥וּ" x-translit="naḥămû" srcloc="WLC.ISA.40.1.001" x-head="true" lemma="נָחַם" strong="H5162">Comfort</char> <char style="w" x-id="t002" x-align="ISA.40.1.a001">ye</char>, <char style="w" x-id="t003" x-align="ISA.40.1.a002" x-src="WLC.ISA.40.1.002" x-source="נַחֲמ֖וּ" x-translit="naḥămû" srcloc="WLC.ISA.40.1.002" x-head="true" lemma="נָחַם" strong="H5162">comfort</char> <char style="w" x-id="t004" x-align="ISA.40.1.a002">ye</char> <char style="w" x-id="t005" x-align="ISA.40.1.a004" x-src="WLC.ISA.40.1.004" x-source="י" x-translit="iy" srcloc="WLC.ISA.40.1.004" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t006" x-align="ISA.40.1.a003" x-src="WLC.ISA.40.1.003" x-source="עַמִּ֑" x-translit="ʿamm" srcloc="WLC.ISA.40.1.003" x-head="true" lemma="עַם" strong="H5971">people</char>, <char style="w" x-id="t007" x-align="ISA.40.1.a005" x-src="WLC.ISA.40.1.005" x-source="יֹאמַ֖ר" x-translit="yōʾmar" srcloc="WLC.ISA.40.1.005" x-head="true" lemma="אָמַר" strong="H559">saith</char> <char style="w" x-id="t008" x-align="ISA.40.1.a007" x-src="WLC.ISA.40.1.007" x-source="כֶֽם" x-translit="ḵem" srcloc="WLC.ISA.40.1.007" x-head="true" lemma="הוּא" strong="H3641b">your</char> <char style="w" x-id="t009" x-align="ISA.40.1.a006" x-src="WLC.ISA.40.1.006" x-source="אֱלֹהֵי" x-translit="ʾĕlōhēy" srcloc="WLC.ISA.40.1.006" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>. <verse eid="ISA 40:1" /><verse number="2" style="v" sid="ISA 40:2" /><char style="w" x-id="t001" x-align="ISA.40.2.a001" x-src="WLC.ISA.40.2.001" x-source="דַּבְּר֞וּ" x-translit="dabbərû" srcloc="WLC.ISA.40.2.001" x-head="true" lemma="דָבַר" strong="H1696">Speak</char> <char style="w" x-id="t002" x-align="ISA.40.2.a001">ye</char> <note caller="-" style="f"><char style="ft">Hebrew <char style="it">to the heart of</char>.</char></note><char style="w" x-id="t003" x-align="ISA.40.2.a002