	<para style="p"><verse number="1" style="v" sid="ISA 17:1" /><char style="w" x-id="t001" x-align="ISA.17.1.a001">The</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">oracle concerning</char></char></note><char style="w" x-id="t002" x-align="ISA.17.1.a001" x-src="WLC.ISA.17.1.001" x-source="מַשָּׂ֖א" x-translit="maśśāʾ" srcloc="WLC.ISA.17.1.001" x-head="true" lemma="מַשָּׂא" strong="H4853a">burden</char> <char style="w" x-id="t003" x-align="ISA.17.1.a002">of</char> <char style="w" x-id="t004" x-align="ISA.17.1.a002" x-src="WLC.ISA.17.1.002" x-source="דַּמָּ֑שֶׂק" x-translit="dammāśeq" srcloc="WLC.ISA.17.1.002" x-head="true" lemma="דַּמֶּשֶׂק" strong="H1834">Damascus</char>.</para>
