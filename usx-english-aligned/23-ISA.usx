	<para style="p"><verse number="3" style="v" sid="ISA 40:3" /><char style="w" x-id="t001" x-align="ISA.40.3.a001">The</char> <char style="w" x-id="t002" x-align="ISA.40.3.a001" x-src="WLC.ISA.40.3.001" x-source="ק֣וֹל" x-translit="qôl" srcloc="WLC.ISA.40.3.001" x-head="true" lemma="קוֹל" strong="H6963">voice</char> <char style="w" x-id="t003" x-align="ISA.40.3.a002">of</char> <char style="w" x-id="t004" x-align="ISA.40.3.a002">one</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">that crieth in the wilderness, Prepare ye the way etc.</char></char></note><char style="w" x-id="t005" x-align="ISA.40.3.a002">that</char> <char style="w" x-id="t006" x-align="ISA.40.3.a002" x-src="WLC.ISA.40.3.002" x-source="קוֹרֵ֔א" x-translit="qôrēʾ" srcloc="WLC.ISA.40.3.002" x-head="true" lemma="קָרָא" strong="H7121">crieth</char>, <char style="w" x-id="t007" x-align="ISA.40.3.a006" x-src="WLC.ISA.40.3.006" x-source="פַּנּ֖וּ" x-translit="pannû" srcloc="WLC.ISA.40.3.006" x-head="true" lemma="פָּנָה" strong="H6437">Prepare</char> <char style="w" x-id="t008" x-align="ISA.40.3.a006">ye</char> <char style="w" x-id="t009" x-align="ISA.40.3.a003" x-src="WLC.ISA.40.3.003" x-source="בַּ" x-translit="ba" srcloc="WLC.ISA.40.3.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t010" x-align="ISA.40.3.a004" x-src="WLC.ISA.40.3.004" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.ISA.40.3.004" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t011" x-align="ISA.40.3.a005" x-src="WLC.ISA.40.3.005" x-source="מִּדְבָּ֕ר" x-translit="mmiḏbār" srcloc="WLC.ISA.40.3.005" x-head="true" lemma="מִדְבָּר" strong="H4057">wilderness</char> <char style="w" x-id="t012" x-align="ISA.40.3.a007">the</char> <char style="w" x-id="t013" x-align="ISA.40.3.a007" x-src="WLC.ISA.40.3.007" x-source="דֶּ֣רֶךְ" x-translit="dereḵ" srcloc="WLC.ISA.40.3.007" x-head="true" lemma="דֶּרֶךְ" strong="H1870">way</char> <char style="w" x-id="t014" x-align="ISA.40.3.a008">of</char> <char style="w" x-id="t015" x-align="ISA.40.3.a008" x-src="WLC.ISA.40.3.008" x-source="יְהוָ֑ה" x-translit="yəhwāh" srcloc="WLC.ISA.40.3.008" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>; <char style="w" x-id="t016" x-align="ISA.40.3.a009">make</char> <char style="w" x-id="t017" x-align="ISA.40.3.a009" x-src="WLC.ISA.40.3.009" x-source="יַשְּׁרוּ֙" x-translit="yaššərû" srcloc="WLC.ISA.40.3.009" x-head="true" lemma="יָשַׁר" strong="H3474">level</char> <char style="w" x-id="t018" x-align="ISA.40.3.a010" x-src="WLC.ISA.40.3.010" x-source="בָּ" x-translit="bā" srcloc="WLC.ISA.40.3.010" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t019" x-align="ISA.40.3.a011" x-src="WLC.ISA.40.3.011" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.ISA.40.3.011" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t020" x-align="ISA.40.3.a012" x-src="WLC.ISA.40.3.012" x-source="עֲרָבָ֔ה" x-translit="ʿărāḇāh" srcloc="WLC.ISA.40.3.012" x-head="true" lemma="עֲרָבָה" strong="H6160">desert</char> <char style="w" x-id="t021" x-align="ISA.40.3.a013">a</char> <char style="w" x-id="t022" x-align="ISA.40.3.a013" x-src="WLC.ISA.40.3.013" x-source="מְסִלָּ֖ה" x-translit="məsillāh" srcloc="WLC.ISA.40.3.013" x-head="true" lemma="מְסִלָּה" strong="H4546">highway</char> <char style="w" x-id="t023" x-align="ISA.40.3.a014" x-src="WLC.ISA.40.3.014" x-source="לֵ" x-translit="lē" srcloc="WLC.ISA.40.3.014" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t024" x-align="ISA.40.3.a016" x-src="WLC.ISA.40.3.016" x-source="נוּ" x-translit="nû" srcloc="WLC.ISA.40.3.016" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t025" x-align="ISA.40.3.a015" x-src="WLC.ISA.40.3.015" x-source="אלֹהֵֽי" x-translit="ʾlōhēy" srcloc="WLC.ISA.40.3.015" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char>. <verse eid="ISA 40:3" /><verse number="4" style="v" x-unrepresented-source="לְ לְ" x-unrepresented-tr