	<para style="p"><verse number="2" style="v" sid="ISA 1:2" /><char style="w" x-id="t001" x-align="ISA.1.2.a001" x-src="WLC.ISA.1.2.001" x-source="שִׁמְע֤וּ" x-translit="šimʿû" srcloc="WLC.ISA.1.2.001" x-head="true" lemma="שָׁמַע" strong="H8085">Hear</char>, <char style="w" x-id="t002" x-align="ISA.1.2.a002">O</char> <char style="w" x-id="t003" x-align="ISA.1.2.a002" x-src="WLC.ISA.1.2.002" x-source="שָׁמַ֨יִם֙" x-translit="šāmayim" srcloc="WLC.ISA.1.2.002" x-head="true" lemma="שָׁמַיִם" strong="H8064">heavens</char>, <char style="w" x-id="t004" x-align="ISA.1.2.a003" x-src="WLC.ISA.1.2.003" x-source="וְ" x-translit="wə" srcloc="WLC.ISA.1.2.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="ISA.1.2.a004">give</char> <char style="w" x-id="t006" x-align="ISA.1.2.a004" x-src="WLC.ISA.1.2.004" x-source="הַאֲזִ֣ינִי" x-translit="haʾăziynî" srcloc="WLC.ISA.1.2.004" x-head="true" lemma="אָזַן" strong="H238">ear</char>, <char style="w" x-id="t007" x-align="ISA.1.2.a005">O</char> <char style="w" x-id="t008" x-align="ISA.1.2.a005" x-src="WLC.ISA.1.2.005" x-source="אֶ֔רֶץ" x-translit="ʾereṣ" srcloc="WLC.ISA.1.2.005" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char>; <char style="w" x-id="t009" x-align="ISA.1.2.a006" x-src="WLC.ISA.1.2.006" x-source="כִּ֥י" x-translit="kiy" srcloc="WLC.ISA.1.2.006" x-head="true" lemma="כִּי" strong="H3588">for</char> <char style="w" x-id="t010" x-align="ISA.1.2.a007" x-src="WLC.ISA.1.2.007" x-source="יְהוָ֖ה" x-translit="yəhwāh" srcloc="WLC.ISA.1.2.007" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t011" x-align="ISA.1.2.a008">hath</char> <char style="w" x-id="t012" x-align="ISA.1.2.a008" x-src="WLC.ISA.1.2.008" x-source="דִּבֵּ֑ר" x-translit="dibbēr" srcloc="WLC.ISA.1.2.008" x-head="true" lemma="דָבַר" strong="H1696">spoken</char>: <char style="w" x-id="t013" x-align="ISA.1.2.a010">I</char> <char style="w" x-id="t014" x-align="ISA.1.2.a010">have</char> <note caller