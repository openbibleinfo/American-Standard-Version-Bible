	<para style="p"><verse number="1" style="v" sid="MRK 1:1" /><char style="w" x-id="t001" x-align="MRK.1.1.a001">The</char> <char style="w" x-id="t002" x-align="MRK.1.1.a001" x-src="SBLGNT.MRK.1.1.001" x-source="Ἀρχὴ" x-translit="Archē" srcloc="SBLGNT.MRK.1.1.001" x-head="true" lemma="ἀρχή" strong="G746">beginning</char> <char style="w" x-id="t003" x-align="MRK.1.1.a002">of</char> <char style="w" x-id="t004" x-align="MRK.1.1.a002" x-src="SBLGNT.MRK.1.1.002" x-source="τοῦ" x-translit="tou" srcloc="SBLGNT.MRK.1.1.002" x-head="true" lemma="ὁ" strong="G3588">the</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">good tidings</char>: and so elsewhere.</char></note><char style="w" x-id="t005" x-align="MRK.1.1.a003" x-src="SBLGNT.MRK.1.1.003" x-source="εὐαγγελίου" x-translit="euangeliou" srcloc="SBLGNT.MRK.1.1.003" x-head="true" lemma="εὐαγγέλιον" strong="G2098">gospel</char> <char style="w" x-id="t006" x-align="MRK.1.1.a004">of</char> <char style="w" x-id="t007" x-align="MRK.1.1.a004" x-src="SBLGNT.MRK.1.1.004" x-source="Ἰησοῦ" x-translit="Iēsou" srcloc="SBLGNT.MRK.1.1.004" x-head="true" lemma="Ἰησοῦς" strong="G2424">Jesus</char> <char style="w" x-id="t008" x-align="MRK.1.1.a005" x-src="SBLGNT.MRK.1.1.005" x-source="χριστοῦ" x-translit="christou" srcloc="SBLGNT.MRK.1.1.005" x-head="true" lemma="Χριστός" strong="G5547">Christ</char>, <note caller="-" style="f"><char style="ft">Some ancient authorities omit <char style="it">the Son of God</char>.</char></note><char style="w" x-id="t009" x-align="MRK.1.1.a006" x-status="added">the</char> <char style="w" x-id="t010" x-align="MRK.1.1.a006" x-status="added" x-source="∅" x-head="true">Son</char> <char style="w" x-id="t011" x-align="MRK.1.1.a006" x-status="added">of</char> <char style="w" x-id="t012" x-align="MRK.1.1.a006" x-status="added">God</char>.<verse eid="MRK 1:1" /></para>
	<para style="p"><verse number="2" style="v" x-unrepresented-source="τῷ τὸν τὴν" x-unrepresented-translit="tōi ton tēn" x-unrepresented-src="SBLGNT.MRK.1.2.004 SBLGNT.MRK.1.2.010 SBLGNT.MRK.1.2.018" sid="MRK 1:2" /><char style="w" x-id="t001" x-align="MRK.1.2.a001">Even</char> <char style="w" x-id="t002" x-align="MRK.1.2.a001" x-src="SBLGNT.MRK.1.2.001" x-source="Καθὼς" x-translit="Kathōs" srcloc="SBLGNT.MRK.1.2.001" x-head="true" lemma="καθώς" strong="G2531">as</char> <char style="w" x-id="t003" x-align="MRK.1.2.a002">it</char> <char style="w" x-id="t004" x-align="MRK.1.2.a002">is</char> <char style="w" x-id="t005" x-align="MRK.1.2.a002" x-src="SBLGNT.MRK.1.2.002" x-source="γέγραπται" x-translit="gegraptai" srcloc="SBLGNT.MRK.1.2.002" x-head="true" lemma="γράφω" strong="G1125">written</char> <note caller="-" style="f"><char style="ft">Some ancient authorities read <char style="it">in the prophets</char>.</char></note><char style="w" x-id="t006" x-align="MRK.1.2.a003" x-src="SBLGNT.MRK.1.2.003" x-source="ἐν" x-translit="en" srcloc="SBLGNT.MRK.1.2.003" x-head="true" lemma="ἐν" strong="G1722">in</char> <char style="w" x-id="t007" x-align="MRK.1.2.a005" x-src="SBLGNT.MRK.1.2.005" x-source="Ἠσαΐᾳ" x-translit="Ēsaiai" srcloc="SBLGNT.MRK.1.2.005" x-head="true" lemma="Ἠσαΐας" strong="G2268">Isaiah</char> <char style="w" x-id="t008" x-align="MRK.1.2.a006" x-src="SBLGNT.MRK.1.2.006" x-source="τῷ" x-translit="tōi" srcloc="SBLGNT.MRK.1.2.006" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t009" x-align="MRK.1.2.a007" x-src="SBLGNT.MRK.1.2.007" x-source="προφήτῃ" x-translit="prophētēi" srcloc="SBLGNT.MRK.1.2.007" x-head="true" lemma="προφήτης" strong="G4396">prophet</char>,</para>
	<para style="q1"><note caller="-" style="f"><char style="ft"><ref loc="MAL 3:1">Mal. 3:1</ref>.</char></note><char style="w" x-id="t010" x-align="MRK.1.2.a008" x-src="SBLGNT.MRK.1.2.008" x-source="Ἰδοὺ" x-translit="Idou" srcloc="SBLGNT.MRK.1.2.008" x-head="true" lemma="ἰδού" strong="G2400">Behold</char>, <char style="w" x-id="t011" x-align="MRK.1.2.a009">I</char> <char style="w" x-id="t012" x-align="MRK.1.2.a009" x-src="SBLGNT.MRK.1.2.009" x-source="ἀποστέλλω" x-translit="apostellō" srcloc="SBLGNT.MRK.1.2.009" x-head="true" lemma="ἀποστέλλω" strong="G649">send</char> <char style="w" x-id="t013" x-align="MRK.1.2.a012" x-src="SBLGNT.MRK.1.2.012" x-source="μου" x-translit="mou" srcloc="SBLGNT.MRK.1.2.012" x-head="true" lemma="ἐγώ" strong="G3450">my</char> <char style="w" x-id="t014" x-align="MRK.1.2.a011" x-src="SBLGNT.MRK.1.2.011" x-source="ἄγγελόν" x-translit="angelon" srcloc="SBLGNT.MRK.1.2.011" x-head="true" lemma="ἄγγελος" strong="G32">messenger</char> <char style="w" x-id="t015" x-align="MRK.1.2.a013" x-src="SBLGNT.MRK.1.2.013" x-source="πρὸ" x-translit="pro" srcloc="SBLGNT.MRK.1.2.013" x-head="true" lemma="πρό" strong="G4253">before</char> <char style="w" x-id="t016" x-align="MRK.1.2.a015" x-src="SBLGNT.MRK.1.2.015" x-source="σου" x-translit="sou" srcloc="SBLGNT.MRK.1.2.015" x-head="true" lemma="σύ" strong="G4675">thy</char> <char style="w" x-id="t017" x-align="MRK.1.2.a014" x-src="SBLGNT.MRK.1.2.014" x-source="προσώπου" x-translit="prosōpou" srcloc="SBLGNT.MRK.1.2.014" x-head="true" lemma="πρόσωπον" strong="G4383">face</char>,</para>
	<para style="q1"><char style="w" x-id="t018" x-align="MRK.1.2.a016" x-src="SBLGNT.MRK.1.2.016" x-source="ὃς" x-translit="hos" srcloc="SBLGNT.MRK.1.2.016" x-head="true" lemma="ὅς" strong="G3739">Who</char> <char style="w" x-id="t019" x-align="MRK.1.2.a017">shall</char> <char style="w" x-id="t020" x-align="MRK.1.2.a017" x-src="SBLGNT.MRK.1.2.017" x-source="κατασκευάσει" x-translit="kataskeuasei" srcloc="SBLGNT.MRK.1.2.017" x-head="true" lemma="κατασκευάζω" strong="G2680">prepare</char> <char style="w" x-id="t021" x-align="MRK.1.2.a020" x-src="SBLGNT.MRK.1.2.020" x-source="σου" x-translit="sou" srcloc="SBLGNT.MRK.1.2.020" x-head="true" lemma="σύ" strong="G4675">thy</char> <char style="w" x-id="t022" x-align="MRK.1.2.a019" x-src="SBLGNT.MRK.1.2.019" x-source="ὁδόν" x-translit="hodon" srcloc="SBLGNT.MRK.1.2.019" x-head="true" lemma="ὁδός" strong="G3598">way</char>;<verse eid="MRK 1:2" /></para>
