	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">From thence</char>, from <char style="it">the shepherd</char>. Or, as otherwise read, <char style="it">By the name of the shepherd</char></char></note>(<char style="w" x-id="t025" x-align="GEN.49.24.a016" x-src="WLC.GEN.49.24.016" x-source="מִ" x-translit="mi" srcloc="WLC.GEN.49.24.016" x-head="true" lemma="מִן" strong="H4480">From</char> <char style="w" x-id="t026" x-align="GEN.49.24.a017" x-src="WLC.GEN.49.24.017" x-source="שָּׁ֥ם" x-translit="ššām" srcloc="WLC.GEN.49.24.017" x-head="true" lemma="שָׁם" strong="H8033">thence</char> <char style="w" x-id="t027" x-align="GEN.49.24.a016">is</char> <char style="w" x-id="t028" x-align="GEN.49.24.a018">the</char> <char style="w" x-id="t029" x-align="GEN.49.24.a018" x-src="WLC.GEN.49.24.018" x-source="רֹעֶ֖ה" x-translit="rōʿeh" srcloc="WLC.GEN.49.24.018" x-head="true" lemma="רָעָה" strong="H7473">shepherd</char>, <char style="w" x-id="t030" x-align="GEN.49.24.a019">the</char> <char style="w" x-id="t031" x-align="GEN.49.24.a019" x-src="WLC.GEN.49.24.019" x-source="אֶ֥בֶן" x-translit="ʾeḇen" srcloc="WLC.GEN.49.24.019" x-head="true" lemma="אֶבֶן" strong="H68">stone</char> <char style="w" x-id="t032" x-align="GEN.49.24.a020">of</char> <char style="w" x-id="t033" x-align="GEN.49.24.a020" x-src="WLC.GEN.49.24.020" x-source="יִשְׂרָאֵֽל" x-translit="yiśrāʾēl:" srcloc="WLC.GEN.49.24.020" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>),<verse eid="GEN 49:24" /></para>
