	<para style="p"><verse number="11" style="v" sid="JER 10:11" /><note caller="-" style="f"><char style="ft">This verse is in Aramaic.</char></note><char style="w" x-id="t001" x-align="JER.10.11.a001" x-src="WLC.JER.10.11.001 WLC.JER.10.11.002" x-source="כִּ דְנָה֙" x-translit="ki ḏənāh" srcloc="WLC.JER.10.11.002" x-head="true" lemma="דְּנָה" strong="H1836">Thus</char> <char style="w" x-id="t002" x-align="JER.10.11.a002">shall</char> <char style="w" x-id="t003" x-align="JER.10.11.a002">ye</char> <char style="w" x-id="t004" x-align="JER.10.11.a002" x-src="WLC.JER.10.11.003" x-source="תֵּאמְר֣וּן" x-translit="tēʾmərûn" srcloc="WLC.JER.10.11.003" x-head="true" lemma="אֲמַר" strong="H560">say</char> <char style="w" x-id="t005" x-align="JER.10.11.a003" x-src="WLC.JER.10.11.004" x-source="לְ" x-translit="lə" srcloc="WLC.JER.10.11.004" x-head="true" lemma="לְ" strong="H3807b">unto</char> <char style="w" x-id="t006" x-align="JER.10.11.a004" x-src="WLC.JER.10.11.005" x-source="ה֔וֹם" x-translit="hôm" srcloc="WLC.JER.10.11.005" x-head="true" lemma="הוּא" strong="H1952a">them</char>, <char style="w" x-id="t007" x-align="JER.10.11.a006" x-src="WLC.JER.10.11.007" x-source="א" x-translit="āʾ" srcloc="WLC.JER.10.11.007" x-head="true" lemma="א" strong="H1b">The</char> <char style="w" x-id="t008" x-align="JER.10.11.a005" x-src="WLC.JER.10.11.006" x-source="אֱלָ֣הַיָּ֔" x-translit="ʾĕlāhayy" srcloc="WLC.JER.10.11.006" x-head="true" lemma="אֱלָהּ" strong="H426">gods</char> <char style="w" x-id="t009" x-align="JER.10.11.a007" x-src="WLC.JER.10.11.008" x-source="דִּֽי" x-translit="diy-" srcloc="WLC.JER.10.11.008" x-head="true" lemma="דִּי" strong="H1768">that</char> <char style="w" x-id="t010" x-align="JER.10.11.a014">have</char> <char style="w" x-id="t011" x-align="JER.10.11.a013" x-src="WLC.JER.10.11.014" x-source="לָ֣א" x-translit="lāʾ" srcloc="WLC.JER.10.11.014" x-head="true" lemma="לָא" strong="H3809">not</char> <char style="w" x-id="t012" x-align="JER.10.11.a014" x-src="WLC.JER.10.