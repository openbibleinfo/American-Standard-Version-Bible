	<para style="p"><verse number="1" style="v" sid="JER 4:1" /><char style="w" x-id="t001" x-align="JER.4.1.a001" x-src="WLC.JER.4.1.001" x-source="אִם" x-translit="ʾim-" srcloc="WLC.JER.4.1.001" x-head="true" lemma="אִם" strong="H518">If</char> <char style="w" x-id="t002" x-align="JER.4.1.a002">thou</char> <char style="w" x-id="t003" x-align="JER.4.1.a002">wilt</char> <char style="w" x-id="t004" x-align="JER.4.1.a002" x-src="WLC.JER.4.1.002" x-source="תָּשׁ֨וּב" x-translit="tāšûḇ" srcloc="WLC.JER.4.1.002" x-head="true" lemma="שׁוּב" strong="H7725">return</char>, <char style="w" x-id="t005" x-align="JER.4.1.a003">O</char> <char style="w" x-id="t006" x-align="JER.4.1.a003" x-src="WLC.JER.4.1.003" x-source="יִשְׂרָאֵ֧ל" x-translit="yiśrāʾēl" srcloc="WLC.JER.4.1.003" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>, <char style="w" x-id="t007" x-align="JER.4.1.a004" x-src="WLC.JER.4.1.004" x-source="נְאֻם" x-translit="nəʾum-" srcloc="WLC.JER.4.1.004" x-head="true" lemma="נְאֻם" strong="H5002">saith</char> <char style="w" x-id="t008" x-align="JER.4.1.a005" x-src="WLC.JER.4.1.005" x-source="יְהוָ֛ה" x-translit="yəhwāh" srcloc="WLC.JER.4.1.005" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t009" x-align="JER.4.1.a006" x-status="added" x-source="∅" x-head="true">if</char> <char style="w" x-id="t010" x-align="JER.4.1.a007">thou</char> <char style="w" x-id="t011" x-align="JER.4.1.a007">wilt</char> <char style="w" x-id="t012" x-align="JER.4.1.a007" x-src="WLC.JER.4.1.008" x-source="תָּשׁ֑וּב" x-translit="tāšûḇ" srcloc="WLC.JER.4.1.008" x-head="true" lemma="שׁוּב" strong="H7725">return</char> <char style="w" x-id="t013" x-align="JER.4.1.a008" x-src="WLC.JER.4.1.006" x-source="אֵלַ֖" x-translit="ʾēl" srcloc="WLC.JER.4.1.006" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t014" x-align="JER.4.1.a009" x-src="WLC.JER.4.1.007" x-source="י" x-translit="ay" srcloc="WLC.JER.4.1.007" x-head="true" lemma="הוּא" stro