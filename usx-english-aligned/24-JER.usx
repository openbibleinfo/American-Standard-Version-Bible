	<para style="p"><verse number="12" style="v" sid="JER 10:12" /><char style="w" x-id="t001" x-align="JER.10.12.a001">He</char> <char style="w" x-id="t002" x-align="JER.10.12.a001">hath</char> <char style="w" x-id="t003" x-align="JER.10.12.a001" x-src="WLC.JER.10.12.001" x-source="עֹשֵׂ֥ה" x-translit="ʿōśēh" srcloc="WLC.JER.10.12.001" x-head="true" lemma="עָשָׂה" strong="H6213">made</char> <char style="w" x-id="t004" x-align="JER.10.12.a002">the</char> <char style="w" x-id="t005" x-align="JER.10.12.a002" x-src="WLC.JER.10.12.002" x-source="אֶ֨רֶץ֙" x-translit="ʾereṣ" srcloc="WLC.JER.10.12.002" x-head="true" lemma="אֶרֶץ" strong="H776">earth</char> <char style="w" x-id="t006" x-align="JER.10.12.a003" x-src="WLC.JER.10.12.003" x-source="בְּ" x-translit="bə" srcloc="WLC.JER.10.12.003" x-head="true" lemma="בְּ" strong="H871a">by</char> <char style="w" x-id="t007" x-align="JER.10.12.a005" x-src="WLC.JER.10.12.005" x-source="וֹ" x-translit="ô" srcloc="WLC.JER.10.12.005" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t008" x-align="JER.10.12.a004" x-src="WLC.JER.10.12.004" x-source="כֹח֔" x-translit="ḵōḥ" srcloc="WLC.JER.10.12.004" x-head="true" lemma="כֹּחַ" strong="H3581">power</char>, <char style="w" x-id="t009" x-align="JER.10.12.a006">he</char> <char style="w" x-id="t010" x-align="JER.10.12.a006">hath</char> <char style="w" x-id="t011" x-align="JER.10.12.a006" x-src="WLC.JER.10.12.006" x-source="מֵכִ֥ין" x-translit="mēḵiyn" srcloc="WLC.JER.10.12.006" x-head="true" lemma="כּוּן" strong="H3559">established</char> <char style="w" x-id="t012" x-align="JER.10.12.a007">the</char> <char style="w" x-id="t013" x-align="JER.10.12.a007" x-src="WLC.JER.10.12.007" x-source="תֵּבֵ֖ל" x-translit="tēḇēl" srcloc="WLC.JER.10.12.007" x-head="true" lemma="תֵּבֵל" strong="H8398">world</char> <char style="w" x-id="t014" x-align="JER.10.12.a008" x-src="WLC.JER.10.12.008" x-source="בְּ" x-translit="bə" srcloc="WLC.JER.10.12.008" x-head="true" lemma="בְּ" strong="H871a">by</char> <char style="w" x-id="t015" x-align="JER.10.12.a010" x-src="WLC.JER.10.12.010" x-source="וֹ" x-translit="ô" srcloc="WLC.JER.10.12.010" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t016" x-align="JER.10.12.a009" x-src="WLC.JER.10.12.009" x-source="חָכְמָת֑" x-translit="ḥāḵəmāṯ" srcloc="WLC.JER.10.12.009" x-head="true" lemma="חׇכְמָה" strong="H2451">wisdom</char>, <char style="w" x-id="t017" x-align="JER.10.12.a011" x-src="WLC.JER.10.12.011" x-source="וּ" x-translit="û" srcloc="WLC.JER.10.12.011" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t018" x-align="JER.10.12.a012" x-src="WLC.JER.10.12.012" x-source="בִ" x-translit="ḇi" srcloc="WLC.JER.10.12.012" x-head="true" lemma="בְּ" strong="H871a">by</char> <char style="w" x-id="t019" x-align="JER.10.12.a014" x-src="WLC.JER.10.12.014" x-source="וֹ" x-translit="ô" srcloc="WLC.JER.10.12.014" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t020" x-align="JER.10.12.a013" x-src="WLC.JER.10.12.013" x-source="תְבוּנָת֖" x-translit="ṯəḇûnāṯ" srcloc="WLC.JER.10.12.013" x-head="true" lemma="תְּבוּנָה" strong="H8394">understanding</char> <char style="w" x-id="t021" x-align="JER.10.12.a015">hath</char> <char style="w" x-id="t022" x-align="JER.10.12.a015">he</char> <char style="w" x-id="t023" x-align="JER.10.12.a015" x-src="WLC.JER.10.12.015" x-source="נָטָ֥ה" x-translit="nāṭāh" srcloc="WLC.JER.10.12.015" x-head="true" lemma="נָטָה" strong="H5186">stretched</char> <char style="w" x-id="t024" x-align="JER.10.12.a015">out</char> <char style="w" x-id="t025" x-align="JER.10.12.a016">the</char> <char style="w" x-id="t026" x-align="JER.10.12.a016" x-src="WLC.JER.10.12.016" x-source="שָׁמָֽיִם" x-translit="šāmāyim:" srcloc="WLC.JER.10.12.016" x-head="true" lemma="שָׁמַיִם" strong="H8064">heavens</char>. <verse eid="JER 10:12" /><verse number="13" style="v" sid="JER 10:13" /><note caller="-" style="f"><char style="ft">Or, <char style="it">at