	<para style="q1"><char style="w" x-id="t007" x-align="SNG.8.13.a006">The</char> <char style="w" x-id="t008" x-align="SNG.8.13.a006" x-src="WLC.SNG.8.13.006" x-source="חֲבֵרִ֛ים" x-translit="ḥăḇēriym" srcloc="WLC.SNG.8.13.006" x-head="true" lemma="חָבֵר" strong="H2270">companions</char> <char style="w" x-id="t009" x-align="SNG.8.13.a007" x-src="WLC.SNG.8.13.007" x-source="מַקְשִׁיבִ֥ים" x-translit="maqšîḇiym" srcloc="WLC.SNG.8.13.007" x-head="true" lemma="קָשַׁב" strong="H7181">hearken</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">to</char></char></note><char style="w" x-id="t010" x-align="SNG.8.13.a008" x-src="WLC.SNG.8.13.008" x-source="לְ" x-translit="lə" srcloc="WLC.SNG.8.13.008" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t011" x-align="SNG.8.13.a010" x-src="WLC.SNG.8.13.010" x-source="ךְ" x-translit="ēḵ" srcloc="WLC.SNG.8.13.010" x-head="true" lemma="הוּא" strong="H3509c">thy</char> <char style="w" x-id="t012" x-align="SNG.8.13.a009" x-src="WLC.SNG.8.13.009" x-source="קוֹלֵ֖" x-translit="qôl" srcloc="WLC.SNG.8.13.009" x-head="true" lemma="קוֹל" strong="H6963">voice</char>:</para>
	<para style="q1"><char style="w" x-id="t013" x-align="SNG.8.13.a011">Cause</char> <char style="w" x-id="t014" x-align="SNG.8.13.a012" x-src="WLC.SNG.8.13.012" x-source="נִי" x-translit="niy" srcloc="WLC.SNG.8.13.012" x-head="true" lemma="הוּא" strong="H5204a">me</char> <char style="w" x-id="t015" x-align="SNG.8.13.a011">to</char> <char style="w" x-id="t016" x-align="SNG.8.13.a011" x-src="WLC.SNG.8.13.011" x-source="הַשְׁמִיעִֽי" x-translit="hašmiyʿiy" srcloc="WLC.SNG.8.13.011" x-head="true" lemma="שָׁמַע" strong="H8085">hear</char> <char style="w" x-id="t017" x-align="SNG.8.13.a013" x-status="added" x-source="∅" x-head="true">it</char>.<verse eid="SNG 8:13" /></para>
	<para style="b"><verse number="14" style="v" x-unrepresented-source="לְ ךָ֤ הָֽ" x-unrepresented-translit="l əḵā hā" x-unrepresented-src="WLC.SNG.8.14.006 WLC.SNG.8.14.007 WLC.SNG.8.14.013" sid="SNG 8:14" /></para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Hebrew <char style="it">Flee</char>.</char></note><char style="w" x-id="t001" x-align="SNG.8.14.a001">Make</char> <char style="w" x-id="t002" x-align="SNG.8.14.a001" x-src="WLC.SNG.8.14.001" x-source="בְּרַ֣ח" x-translit="bəraḥ" srcloc="WLC.SNG.8.14.001" x-head="true" lemma="בָּרַח" strong="H1272">haste</char>, <char style="w" x-id="t003" x-align="SNG.8.14.a003" x-src="WLC.SNG.8.14.003" x-source="י" x-translit="iy" srcloc="WLC.SNG.8.14.003" x-head="true" lemma="הוּא" strong="H2967a">my</char> <char style="w" x-id="t004" x-align="SNG.8.14.a002" x-src="WLC.SNG.8.14.002" x-source="דּוֹדִ֗" x-translit="dôḏ" srcloc="WLC.SNG.8.14.002" x-head="true" lemma="דּוֹד" strong="H1730">beloved</char>,</para>
	<para style="q1"><char style="w" x-id="t005" x-align="SNG.8.14.a004" x-src="WLC.SNG.8.14.004" x-source="וּֽ" x-translit="û" srcloc="WLC.SNG.8.14.004" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t006" x-align="SNG.8.14.a005">be</char> <char style="w" x-id="t007" x-align="SNG.8.14.a005">thou</char> <char style="w" x-id="t008" x-align="SNG.8.14.a005" x-src="WLC.SNG.8.14.005" x-source="דְמֵה" x-translit="ḏəmēh-" srcloc="WLC.SNG.8.14.005" x-head="true" lemma="דָּמָה" strong="H1819">like</char> <char style="w" x-id="t009" x-align="SNG.8.14.a008" x-src="WLC.SNG.8.14.008" x-source="לִ" x-translit="li" srcloc="WLC.SNG.8.14.008" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t010" x-align="SNG.8.14.a009">a</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">gazelle</char></char></note><char style="w" x-id="t011" x-align="SNG.8.14.a009" x-src="WLC.SNG.8.14.009" x-source="צְבִי֙" x-translit="ṣəḇî" srcloc="WLC.SNG.8.14.009" x-head="true" lemma="צְבִי" strong="H6643a">roe</char> <char style="w" x-id="t012" x-align="SNG.8.14.a010" x-src="WLC.SNG.8.14.010" x-source="א֚וֹ" x-translit="ʾô" srcloc="WLC.SNG.8.14.010" x-head="true" lemma="אוֹ" strong="H176">or</char> <char style="w" x-id="t013" x-align="SNG.8.14.a011" x-src="WLC.SNG.8.14.011" x-source="לְ" x-translit="lə" srcloc="WLC.SNG.8.14.011" x-head="true" lemma="לְ" strong="H3807a">to</char> <char style="w" x-id="t014" x-align="SNG.8.14.a014">a</char> <char style="w" x-id="t015" x-align="SNG.8.14.a012" x-src="WLC.SNG.8.14.012" x-source="עֹ֣פֶר" x-translit="ʿōp̄er" srcloc="WLC.SNG.8.14.012" x-head="true" lemma="עֹפֶר" strong="H6082">young</char> <char style="w" x-id="t016" x-align="SNG.8.14.a014" x-src="WLC.SNG.8.14.014" x-source="אַיָּלִ֔ים" x-translit="ʾayyāliym" srcloc="WLC.SNG.8.14.014" x-head="true" lemma="אַיָּל" strong="H354">hart</char></para>
	<para style="q1"><char style="w" x-id="t017" x-align="SNG.8.14.a015" x-src="WLC.SNG.8.14.015" x-source="עַ֖ל" x-translit="ʿal" srcloc="WLC.SNG.8.14.015" x-head="true" lemma="עַל" strong="H5921">Upon</char> <char style="w" x-id="t018" x-align="SNG.8.14.a016">the</char> <char style="w" x-id="t019" x-align="SNG.8.14.a016" x-src="WLC.SNG.8.14.016" x-source="הָרֵ֥י" x-translit="hārēy" srcloc="WLC.SNG.8.14.016" x-head="true" lemma="הַר" strong="H2022">mountains</char> <char style="w" x-id="t020" x-align="SNG.8.14.a017">of</char> <char style="w" x-id="t021" x-align="SNG.8.14.a017" x-src="WLC.SNG.8.14.017" x-source="בְשָׂמִֽים" x-translit="ḇəśāmiym:" srcloc="WLC.SNG.8.14.017" x-head="true" lemma="בֶּשֶׂם" strong="H1314">spices</char>.<verse eid="SNG 8:14" /></para>
