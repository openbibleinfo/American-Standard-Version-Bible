	<para style="q1"><verse number="15" style="v" x-unrepresented-source="בַ" x-unrepresented-translit="ḇa" x-unrepresented-src="WLC.HAB.3.15.002" sid="HAB 3:15" /><char style="w" x-id="t001" x-align="HAB.3.15.a001">Thou</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">hast trodden</char></char></note><char style="w" x-id="t002" x-align="HAB.3.15.a001">didst</char> <char style="w" x-id="t003" x-align="HAB.3.15.a001" x-src="WLC.HAB.3.15.001" x-source="דָּרַ֥כְתָּ" x-translit="dāraḵətā" srcloc="WLC.HAB.3.15.001" x-head="true" lemma="דָּרַךְ" strong="H1869">tread</char> <char style="w" x-id="t004" x-align="HAB.3.15.a003" x-src="WLC.HAB.3.15.003" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.HAB.3.15.003" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t005" x-align="HAB.3.15.a004" x-src="WLC.HAB.3.15.004" x-source="יָּ֖ם" x-translit="yyām" srcloc="WLC.HAB.3.15.004" x-head="true" lemma="יָם" strong="H3220">sea</char> <char style="w" x-id="t006" x-align="HAB.3.15.a005">with</char> <char style="w" x-id="t007" x-align="HAB.3.15.a006" x-src="WLC.HAB.3.15.006" x-source="ךָ" x-translit="ḵā" srcloc="WLC.HAB.3.15.006" x-head="true" lemma="הוּא" strong="H3509b">thy</char> <char style="w" x-id="t008" x-align="HAB.3.15.a005" x-src="WLC.HAB.3.15.005" x-source="סוּסֶ֑י" x-translit="sûsey" srcloc="WLC.HAB.3.15.005" x-head="true" lemma="סוּס" strong="H5483">horses</char>,</para>
