	<para style="p"><char style="w" x-id="t001" x-align="HAB.3.1.a001">A</char> <char style="w" x-id="t002" x-align="HAB.3.1.a001" x-src="WLC.HAB.3.1.001" x-source="תְּפִלָּ֖ה" x-translit="təp̄illāh" srcloc="WLC.HAB.3.1.001" x-head="true" lemma="תְּפִלָּה" strong="H8605">prayer</char> <char style="w" x-id="t003" x-align="HAB.3.1.a002" x-src="WLC.HAB.3.1.002" x-source="לַ" x-translit="la" srcloc="WLC.HAB.3.1.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t004" x-align="HAB.3.1.a003" x-src="WLC.HAB.3.1.003" x-source="חֲבַקּ֣וּק" x-translit="ḥăḇaqqûq" srcloc="WLC.HAB.3.1.003" x-head="true" lemma="חֲבַקּוּק" strong="H2265">Habakkuk</char> <char style="w" x-id="t005" x-align="HAB.3.1.a004" x-src="WLC.HAB.3.1.004" x-source="הַ" x-translit="ha" srcloc="WLC.HAB.3.1.004" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t006" x-align="HAB.3.1.a005" x-src="WLC.HAB.3.1.005" x-source="נָּבִ֑יא" x-translit="nnāḇiyʾ" srcloc="WLC.HAB.3.1.005" x-head="true" lemma="נָבִיא" strong="H5030">prophet</char>, <char style="w" x-id="t007" x-align="HAB.3.1.a006" x-status="added" x-source="∅" x-head="true">set</char> <char style="w" x-id="t008" x-align="HAB.3.1.a007" x-src="WLC.HAB.3.1.006" x-source="עַ֖ל" x-translit="ʿal" srcloc="WLC.HAB.3.1.006" x-head="true" lemma="עַל" strong="H5921">to</char> <char style="w" x-id="t009" x-align="HAB.3.1.a008" x-src="WLC.HAB.3.1.007" x-source="שִׁגְיֹנֽוֹת" x-translit="šiḡyōnôṯ:" srcloc="WLC.HAB.3.1.007" x-head="true" lemma="שִׁגָּיוֹן" strong="H7692">Shigionoth</char>.<verse eid="HAB 3:1" /></para>
	<para style="q1"><verse number="2" style="v" x-unrepresented-source="הוּ" x-unrepresented-translit="hû" x-unrepresented-src="WLC.HAB.3.2.013" sid="HAB 3:2" /><char style="w" x-id="t001" x-align="HAB.3.2.a001">O</char> <char style="w" x-id="t002" x-align="HAB.3.2.a001" x-src="WLC.HAB.3.2.001" x-source="יְהוָ֗ה" x-translit="yəhwāh" srcloc="WLC.HAB.3.2.001" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t003" x-align="HAB.3.2.a002">I</char> <char style="w" x-id="t004" x-align="HAB.3.2.a002">have</char> <char style="w" x-id="t005" x-align="HAB.3.2.a002" x-src="WLC.HAB.3.2.002" x-source="שָׁמַ֣עְתִּי" x-translit="šāmaʿətî" srcloc="WLC.HAB.3.2.002" x-head="true" lemma="שָׁמַע" strong="H8085">heard</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">thy fame</char></char></note><char style="w" x-id="t006" x-align="HAB.3.2.a003">the</char> <char style="w" x-id="t007" x-align="HAB.3.2.a003" x-src="WLC.HAB.3.2.003" x-source="שִׁמְעֲ" x-translit="šimʿ" srcloc="WLC.HAB.3.2.003" x-head="true" lemma="שֵׁמַע" strong="H8088">report</char> <char style="w" x-id="t008" x-align="HAB.3.2.a004">of</char> <char style="w" x-id="t009" x-align="HAB.3.2.a004" x-src="WLC.HAB.3.2.004" x-source="ךָ֮" x-translit="ăḵā" srcloc="WLC.HAB.3.2.004" x-head="true" lemma="הוּא" strong="H3509b">thee</char>, <char style="w" x-id="t010" x-align="HAB.3.2.a005" x-status="added" x-source="∅">and</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">was</char></char></note><char style="w" x-id="t011" x-align="HAB.3.2.a006">am</char> <char style="w" x-id="t012" x-align="HAB.3.2.a006" x-src="WLC.HAB.3.2.005" x-source="יָרֵאתִי֒" x-translit="yārēʾṯî" srcloc="WLC.HAB.3.2.005" x-head="true" lemma="יָרֵא" strong="H3372">afraid</char>:</para>
