	<para style="q1"><note caller="-" style="f"><char style="ft">Or, <char style="it">When there shall come up against the people he that invadeth them</char></char></note><char style="w" x-id="t034" x-align="HAB.3.16.a025" x-src="WLC.HAB.3.16.025" x-source="לַ" x-translit="la" srcloc="WLC.HAB.3.16.025" x-head="true" lemma="לְ" strong="H3807a">For</char> <char style="w" x-id="t035" x-align="HAB.3.16.a026">the</char> <char style="w" x-id="t036" x-align="HAB.3.16.a026" x-src="WLC.HAB.3.16.026" x-source="עֲל֖וֹת" x-translit="ʿălôṯ" srcloc="WLC.HAB.3.16.026" x-head="true" lemma="עָלָה" strong="H5927">coming</char> <char style="w" x-id="t037" x-align="HAB.3.16.a026">up</char> <char style="w" x-id="t038" x-align="HAB.3.16.a027" x-src="WLC.HAB.3.16.027" x-source="לְ" x-translit="lə" srcloc="WLC.HAB.3.16.027" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t039" x-align="HAB.3.16.a028">the</char> <char style="w" x-id="t040" x-align="HAB.3.16.a028" x-src="WLC.HAB.3.16.028" x-source="עַ֥ם" x-translit="ʿam" srcloc="WLC.HAB.3.16.028" x-head="true" lemma="עַם" strong="H5971">people</char> <char style="w" x-id="t041" x-align="HAB.3.16.a029">that</char> <char style="w" x-id="t042" x-align="HAB.3.16.a029" x-src="WLC.HAB.3.16.029" x-source="יְגוּדֶֽ" x-translit="yəḡûḏ" srcloc="WLC.HAB.3.16.029" x-head="true" lemma="גּוּד" strong="H1464">invadeth</char> <char style="w" x-id="t043" x-align="HAB.3.16.a030" x-src="WLC.HAB.3.16.030" x-source="נּוּ" x-translit="ennû" srcloc="WLC.HAB.3.16.030" x-head="true" lemma="הוּא" strong="H5105a">us</char>.<verse eid="HAB 3:16" /></para>
