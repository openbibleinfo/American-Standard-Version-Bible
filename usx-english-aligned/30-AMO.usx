	<para style="p"><verse number="1" style="v" sid="AMO 1:1" /><char style="w" x-id="t001" x-align="AMO.1.1.a001">The</char> <char style="w" x-id="t002" x-align="AMO.1.1.a001" x-src="WLC.AMO.1.1.001" x-source="דִּבְרֵ֣י" x-translit="diḇrēy" srcloc="WLC.AMO.1.1.001" x-head="true" lemma="דָּבָר" strong="H1697">words</char> <char style="w" x-id="t003" x-align="AMO.1.1.a002">of</char> <char style="w" x-id="t004" x-align="AMO.1.1.a002" x-src="WLC.AMO.1.1.002" x-source="עָמ֔וֹס" x-translit="ʿāmôs" srcloc="WLC.AMO.1.1.002" x-head="true" lemma="עָמוֹס" strong="H5986">Amos</char>, <char style="w" x-id="t005" x-align="AMO.1.1.a003" x-src="WLC.AMO.1.1.003" x-source="אֲשֶׁר" x-translit="ʾăšer-" srcloc="WLC.AMO.1.1.003" x-head="true" lemma="אֲשֶׁר" strong="H834">who</char> <char style="w" x-id="t006" x-align="AMO.1.1.a004" x-src="WLC.AMO.1.1.004" x-source="הָיָ֥ה" x-translit="hāyāh" srcloc="WLC.AMO.1.1.004" x-head="true" lemma="הָיָה" strong="H1961">was</char> <char style="w" x-id="t007" x-align="AMO.1.1.a005" x-src="WLC.AMO.1.1.005" x-source="בַ" x-translit="ḇa" srcloc="WLC.AMO.1.1.005" x-head="true" lemma="בְּ" strong="H871a">among</char> <char style="w" x-id="t008" x-align="AMO.1.1.a006" x-src="WLC.AMO.1.1.006" x-source="[הַ]" x-translit="[ha]" srcloc="WLC.AMO.1.1.006" x-head="true" lemma="הַ" strong="H1886a">the</char> <char style="w" x-id="t009" x-align="AMO.1.1.a007" x-src="WLC.AMO.1.1.007" x-source="נֹּקְדִ֖ים" x-translit="nnōqəḏiym" srcloc="WLC.AMO.1.1.007" x-head="true" lemma="נֹקֵד" strong="H5349">herdsmen</char> <char style="w" x-id="t010" x-align="AMO.1.1.a008" x-src="WLC.AMO.1.1.008" x-source="מִ" x-translit="mi" srcloc="WLC.AMO.1.1.008" x-head="true" lemma="מִן" strong="H4480">of</char> <char style="w" x-id="t011" x-align="AMO.1.1.a009" x-src="WLC.AMO.1.1.009" x-source="תְּק֑וֹעַ" x-translit="təqôᵃʿ" srcloc="WLC.AMO.1.1.009" x-head="true" lemma="תְּקוֹעַ" strong="H8620">Tekoa</char>, <char style="w" x-id="t012" x-align="AMO.1.1.a010" x-src="WLC.AMO.1.1.010" x-source=