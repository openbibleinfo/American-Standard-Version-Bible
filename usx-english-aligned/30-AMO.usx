	<para style="p"><verse number="16" style="v" x-unrepresented-source="י" x-unrepresented-translit="āy" x-unrepresented-src="WLC.AMO.5.16.009" sid="AMO 5:16" /><char style="w" x-id="t001" x-align="AMO.5.16.a001" x-status="noncompositional" x-src="WLC.AMO.5.16.001 WLC.AMO.5.16.002" x-source="לָ֠ כֵן" x-translit="lā ḵēn" srcloc="WLC.AMO.5.16.001" x-head="true" lemma="לָכֵן" strong="H3807a">Therefore</char> <char style="w" x-id="t002" x-align="AMO.5.16.a002" x-src="WLC.AMO.5.16.003" x-source="כֹּֽה" x-translit="kōh-" srcloc="WLC.AMO.5.16.003" x-head="true" lemma="כֹּה" strong="H3541">thus</char> <char style="w" x-id="t003" x-align="AMO.5.16.a003" x-src="WLC.AMO.5.16.004" x-source="אָמַ֨ר" x-translit="ʾāmar" srcloc="WLC.AMO.5.16.004" x-head="true" lemma="אָמַר" strong="H559">saith</char> <char style="w" x-id="t004" x-align="AMO.5.16.a004" x-src="WLC.AMO.5.16.005" x-source="יְהוָ֜ה" x-translit="yəhwāh" srcloc="WLC.AMO.5.16.005" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t005" x-align="AMO.5.16.a005">the</char> <char style="w" x-id="t006" x-align="AMO.5.16.a005" x-src="WLC.AMO.5.16.006" x-source="אֱלֹהֵ֤י" x-translit="ʾĕlōhēy" srcloc="WLC.AMO.5.16.006" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t007" x-align="AMO.5.16.a006">of</char> <char style="w" x-id="t008" x-align="AMO.5.16.a006" x-src="WLC.AMO.5.16.007" x-source="צְבָאוֹת֙" x-translit="ṣəḇāʾôṯ" srcloc="WLC.AMO.5.16.007" x-head="true" lemma="צָבָא" strong="H6635">hosts</char>, <char style="w" x-id="t009" x-align="AMO.5.16.a007">the</char> <char style="w" x-id="t010" x-align="AMO.5.16.a007" x-src="WLC.AMO.5.16.008" x-source="אֲדֹנָ֔" x-translit="ʾăḏōn" srcloc="WLC.AMO.5.16.008" x-head="true" lemma="אֲדֹנָי" strong="H136">Lord</char>: <char style="w" x-id="t011" x-align="AMO.5.16.a012" x-src="WLC.AMO.5.16.013" x-source="מִסְפֵּ֔ד" x-translit="mispēḏ" srcloc="WLC.AMO.5.16.013" x-head="true" lemma="מִסְפֵּד" strong="H4553">Wailing</char> <char style="