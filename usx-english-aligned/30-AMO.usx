	<para style="p"><verse number="2" style="v" sid="AMO 1:2" /><char style="w" x-id="t001" x-align="AMO.1.2.a001" x-src="WLC.AMO.1.2.001" x-source="וַ" x-translit="wa" srcloc="WLC.AMO.1.2.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="AMO.1.2.a002">he</char> <char style="w" x-id="t003" x-align="AMO.1.2.a002" x-src="WLC.AMO.1.2.002" x-source="יֹּאמַ֓ר" x-translit="yyōʾmar" srcloc="WLC.AMO.1.2.002" x-head="true" lemma="אָמַר" strong="H559">said</char>, <char style="w" x-id="t004" x-align="AMO.1.2.a003" x-src="WLC.AMO.1.2.003" x-source="יְהוָה֙" x-translit="yhwh" srcloc="WLC.AMO.1.2.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t005" x-align="AMO.1.2.a006">will</char> <char style="w" x-id="t006" x-align="AMO.1.2.a006" x-src="WLC.AMO.1.2.006" x-source="יִשְׁאָ֔ג" x-translit="yišʾāḡ" srcloc="WLC.AMO.1.2.006" x-head="true" lemma="שָׁאַג" strong="H7580">roar</char> <char style="w" x-id="t007" x-align="AMO.1.2.a004" x-src="WLC.AMO.1.2.004" x-source="מִ" x-translit="mi" srcloc="WLC.AMO.1.2.004" x-head="true" lemma="מִן" strong="H4480">from</char> <char style="w" x-id="t008" x-align="AMO.1.2.a005" x-src="WLC.AMO.1.2.005" x-source="צִיּ֣וֹן" x-translit="ṣiyyôn" srcloc="WLC.AMO.1.2.005" x-head="true" lemma="צִיּוֹן" strong="H6726">Zion</char>, <char style="w" x-id="t009" x-align="AMO.1.2.a007" x-src="WLC.AMO.1.2.007" x-source="וּ" x-translit="û" srcloc="WLC.AMO.1.2.007" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t010" x-align="AMO.1.2.a010" x-src="WLC.AMO.1.2.010" x-source="יִתֵּ֣ן" x-translit="yittēn" srcloc="WLC.AMO.1.2.010" x-head="true" lemma="נָתַן" strong="H5414">utter</char> <char style="w" x-id="t011" x-align="AMO.1.2.a012" x-src="WLC.AMO.1.2.012" x-source="וֹ" x-translit="ô" srcloc="WLC.AMO.1.2.012" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t012" x-align="AMO.1.2.a011" x-src="WLC.AMO.1.2.011" x-source="קוֹל֑" x-translit="qô