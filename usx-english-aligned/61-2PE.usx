lign="2PE.1.2.a014" x-src="SBLGNT.2PE.1.2.014" x-source="ἡμῶν" x-translit="hēmōn" srcloc="SBLGNT.2PE.1.2.014" x-head="true" lemma="ἐγώ" strong="G2257">our</char> <char style="w" x-id="t017" x-align="2PE.1.2.a013" x-src="SBLGNT.2PE.1.2.013" x-source="κυρίου" x-translit="kyriou" srcloc="SBLGNT.2PE.1.2.013" x-head="true" lemma="κύριος" strong="G2962">Lord</char>; <verse eid="2PE 1:2" /><verse number="3" style="v" x-unrepresented-source="τῆς" x-unrepresented-translit="tēs" x-unrepresented-src="SBLGNT.2PE.1.3.004" sid="2PE 1:3" /><char style="w" x-id="t001" x-align="2PE.1.3.a001" x-src="SBLGNT.2PE.1.3.001" x-source="Ὡς" x-translit="Hōs" srcloc="SBLGNT.2PE.1.3.001" x-head="true" lemma="ὡς" strong="G5613">seeing</char> <char style="w" x-id="t002" x-align="2PE.1.3.a001">that</char> <char style="w" x-id="t003" x-align="2PE.1.3.a002" x-src="SBLGNT.2PE.1.3.007" x-source="αὐτοῦ" x-translit="autou" srcloc="SBLGNT.2PE.1.3.007" x-head="true" lemma="αὐτός" strong="G846">his</char> <char style="w" x-id="t004" x-align="2PE.1.3.a004" x-src="SBLGNT.2PE.1.3.005" x-source="θείας" x-translit="theias" srcloc="SBLGNT.2PE.1.3.005" x-head="true" lemma="θεῖος" strong="G2304">divine</char> <char style="w" x-id="t005" x-align="2PE.1.3.a005" x-src="SBLGNT.2PE.1.3.006" x-source="δυνάμεως" x-translit="dynameōs" srcloc="SBLGNT.2PE.1.3.006" x-head="true" lemma="δύναμις" strong="G1411">power</char> <char style="w" x-id="t006" x-align="2PE.1.3.a006">hath</char> <char style="w" x-id="t007" x-align="2PE.1.3.a006" x-src="SBLGNT.2PE.1.3.013" x-source="δεδωρημένης" x-translit="dedōrēmenēs" srcloc="SBLGNT.2PE.1.3.013" x-head="true" lemma="δωρέομαι" strong="G1433">granted</char> <char style="w" x-id="t008" x-align="2PE.1.3.a007">unto</char> <char style="w" x-id="t009" x-align="2PE.1.3.a007" x-src="SBLGNT.2PE.1.3.003" x-source="ἡμῖν" x-translit="hēmin" srcloc="SBLGNT.2PE.1.3.003" x-head="true" lemma="ἐγώ" strong="G2254">us</char> <char style="w" x-id="t010" x-align="2PE.1.3.a008" x-src="SBLGNT.2PE.1.3.002" x-s