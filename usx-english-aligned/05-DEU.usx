	<para style="q1"><verse number="21" style="v" sid="DEU 33:21" /><char style="w" x-id="t001" x-align="DEU.33.21.a001" x-src="WLC.DEU.33.21.001" x-source="וַ" x-translit="wa" srcloc="WLC.DEU.33.21.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="DEU.33.21.a002">he</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">chose</char>. Hebrew <char style="it">saw</char>.</char></note><char style="w" x-id="t003" x-align="DEU.33.21.a002" x-src="WLC.DEU.33.21.002" x-source="יַּ֤רְא" x-translit="yyarəʾ" srcloc="WLC.DEU.33.21.002" x-head="true" lemma="רָאָה" strong="H7200">provided</char> <char style="w" x-id="t004" x-align="DEU.33.21.a003">the</char> <char style="w" x-id="t005" x-align="DEU.33.21.a003" x-src="WLC.DEU.33.21.003" x-source="רֵאשִׁית֙" x-translit="rēʾšîṯ" srcloc="WLC.DEU.33.21.003" x-head="true" lemma="רֵאשִׁית" strong="H7225">first</char> <char style="w" x-id="t006" x-align="DEU.33.21.a003">part</char> <char style="w" x-id="t007" x-align="DEU.33.21.a004" x-src="WLC.DEU.33.21.004" x-source="ל֔" x-translit="l" srcloc="WLC.DEU.33.21.004" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t008" x-align="DEU.33.21.a005" x-src="WLC.DEU.33.21.005" x-source="וֹ" x-translit="ô" srcloc="WLC.DEU.33.21.005" x-head="true" lemma="הוּא" strong="H2050c">himself</char>,</para>
	<para style="q1"><char style="w" x-id="t009" x-align="DEU.33.21.a006" x-src="WLC.DEU.33.21.006" x-source="כִּי" x-translit="kî-" srcloc="WLC.DEU.33.21.006" x-head="true" lemma="כִּי" strong="H3588">For</char> <char style="w" x-id="t010" x-align="DEU.33.21.a007" x-src="WLC.DEU.33.21.007" x-source="שָׁ֛ם" x-translit="šām" srcloc="WLC.DEU.33.21.007" x-head="true" lemma="שָׁם" strong="H8033">there</char> <char style="w" x-id="t011" x-align="DEU.33.21.a010">was</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">a ruler’s portion</char></char></note><char style="w" x-id="t012" x-align="DEU.33.21.a009">the</char> <char style="w" x-id="t013" x-align="DEU.33.21.a009" x-src="WLC.DEU.33.21.009" x-source="מְחֹקֵ֖ק" x-translit="məḥōqēq" srcloc="WLC.DEU.33.21.009" x-head="true" lemma="חָקַק" strong="H2710">lawgiver’s</char> <char style="w" x-id="t014" x-align="DEU.33.21.a008" x-src="WLC.DEU.33.21.008" x-source="חֶלְקַ֥ת" x-translit="ḥelqaṯ" srcloc="WLC.DEU.33.21.008" x-head="true" lemma="חֶלְקָה" strong="H2513">portion</char> <char style="w" x-id="t015" x-align="DEU.33.21.a010" x-src="WLC.DEU.33.21.010" x-source="סָפ֑וּן" x-translit="sāp̄ûn" srcloc="WLC.DEU.33.21.010" x-head="true" lemma="סָפַן" strong="H5603">reserved</char>;</para>
	<para style="q1"><char style="w" x-id="t016" x-align="DEU.33.21.a011" x-src="WLC.DEU.33.21.011" x-source="וַ" x-translit="wa" srcloc="WLC.DEU.33.21.011" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t017" x-align="DEU.33.21.a012">he</char> <char style="w" x-id="t018" x-align="DEU.33.21.a012" x-src="WLC.DEU.33.21.012" x-source="יֵּתֵא֙" x-translit="yyēṯēʾ" srcloc="WLC.DEU.33.21.012" x-head="true" lemma="אָתָה" strong="H857">came</char> <note caller="-" style="f"><char style="ft">Or, to</char></note><char style="add"><char style="w" x-id="t019" x-align="DEU.33.21.a013">with</char></char> <char style="w" x-id="t020" x-align="DEU.33.21.a013">the</char> <char style="w" x-id="t021" x-align="DEU.33.21.a013" x-src="WLC.DEU.33.21.013" x-source="רָ֣אשֵׁי" x-translit="rāʾšê" srcloc="WLC.DEU.33.21.013" x-head="true" lemma="רֹאשׁ" strong="H7218">heads</char> <char style="w" x-id="t022" x-align="DEU.33.21.a014">of</char> <char style="w" x-id="t023" x-align="DEU.33.21.a014">the</char> <char style="w" x-id="t024" x-align="DEU.33.21.a014" x-src="WLC.DEU.33.21.014" x-source="עָ֔ם" x-translit="ʿām" srcloc="WLC.DEU.33.21.014" x-head="true" lemma="עַם" strong="H5971">people</char>;</para>
	<para style="q1"><char style="w" x-id="t025" x-align="DEU.33.21.a017">He</char> <char style="w" x-id="t026" x-align="DEU.33.21.a017" x-src="WLC.DEU.33.21.017" x-source="עָשָׂ֔ה" x-translit="ʿāśāh" srcloc="WLC.DEU.33.21.017" x-head="true" lemma="עָשָׂה" strong="H6213">executed</char> <char style="w" x-id="t027" x-align="DEU.33.21.a015">the</char> <char style="w" x-id="t028" x-align="DEU.33.21.a015" x-src="WLC.DEU.33.21.015" x-source="צִדְקַ֤ת" x-translit="ṣiḏqaṯ" srcloc="WLC.DEU.33.21.015" x-head="true" lemma="צְדָקָה" strong="H6666">righteousness</char> <char style="w" x-id="t029" x-align="DEU.33.21.a016">of</char> <char style="w" x-id="t030" x-align="DEU.33.21.a016" x-src="WLC.DEU.33.21.016" x-source="יְהוָה֙" x-translit="yhwh" srcloc="WLC.DEU.33.21.016" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>,</para>
