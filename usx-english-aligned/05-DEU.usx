	<para style="q1"><verse number="5" style="v" sid="DEU 32:5" /><char style="w" x-id="t001" x-align="DEU.32.5.a001">They</char> <char style="w" x-id="t002" x-align="DEU.32.5.a001">have</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">corrupted themselves</char>, they <char style="it">etc.</char></char></note><char style="w" x-id="t003" x-align="DEU.32.5.a001">dealt</char> <char style="w" x-id="t004" x-align="DEU.32.5.a001" x-src="WLC.DEU.32.5.001" x-source="שִׁחֵ֥ת" x-translit="šiḥēṯ" srcloc="WLC.DEU.32.5.001" x-head="true" lemma="שָׁחַת" strong="H7843">corruptly</char> <char style="w" x-id="t005" x-align="DEU.32.5.a002" x-src="WLC.DEU.32.5.002" x-source="ל֛" x-translit="l" srcloc="WLC.DEU.32.5.002" x-head="true" lemma="לְ" strong="H3807a">with</char> <char style="w" x-id="t006" x-align="DEU.32.5.a003" x-src="WLC.DEU.32.5.003" x-source="וֹ" x-translit="ô" srcloc="WLC.DEU.32.5.003" x-head="true" lemma="הוּא" strong="H2050c">him</char>, <char style="add"><char style="w" x-id="t007" x-align="DEU.32.5.a005">they</char> <char style="w" x-id="t008" x-align="DEU.32.5.a005">are</char></char> <char style="w" x-id="t009" x-align="DEU.32.5.a004" x-src="WLC.DEU.32.5.004" x-source="לֹ֖א" x-translit="lōʾ" srcloc="WLC.DEU.32.5.004" x-head="true" lemma="לֹא" strong="H3808">not</char> <char style="w" x-id="t010" x-align="DEU.32.5.a006" x-src="WLC.DEU.32.5.006" x-source="ו" x-translit="w" srcloc="WLC.DEU.32.5.006" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t011" x-align="DEU.32.5.a005" x-src="WLC.DEU.32.5.005" x-source="בָּנָ֣י" x-translit="bānāy" srcloc="WLC.DEU.32.5.005" x-head="true" lemma="בֵּן" strong="H1121">children</char>, <note caller="-" style="f"><char style="ft">Or, but <char style="it">a blot upon them</char></char></note><char style="add"><char style="w" x-id="t012" x-align="DEU.32.5.a007">it</char> <char style="w" x-id="t013" x-align="DEU.32.5.a007">is</char></char> <char style="w" x-id="t014" x-align="DEU.32.5.a00