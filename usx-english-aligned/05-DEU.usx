	<para style="p"><verse number="7" style="v" sid="DEU 33:7" /><char style="w" x-id="t001" x-align="DEU.33.7.a001" x-src="WLC.DEU.33.7.001" x-source="וְ" x-translit="wə" srcloc="WLC.DEU.33.7.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="DEU.33.7.a002" x-src="WLC.DEU.33.7.002" x-source="זֹ֣את" x-translit="zōʾṯ" srcloc="WLC.DEU.33.7.002" x-head="true" lemma="זֹאת" strong="H2063">this</char> <char style="w" x-id="t003" x-align="DEU.33.7.a003">is</char> <char style="add"><char style="w" x-id="t004" x-align="DEU.33.7.a004" x-status="added">the</char> <char style="w" x-id="t005" x-align="DEU.33.7.a004" x-status="added" x-source="∅" x-head="true">blessing</char></char> <char style="w" x-id="t006" x-align="DEU.33.7.a003" x-src="WLC.DEU.33.7.003" x-source="לִֽ" x-translit="li" srcloc="WLC.DEU.33.7.003" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t007" x-align="DEU.33.7.a005" x-src="WLC.DEU.33.7.004" x-source="יהוּדָה֮" x-translit="yhûḏāh" srcloc="WLC.DEU.33.7.004" x-head="true" lemma="יְהוּדָה" strong="H3063">Judah</char>: <char style="w" x-id="t008" x-align="DEU.33.7.a006" x-src="WLC.DEU.33.7.005" x-source="וַ" x-translit="wa" srcloc="WLC.DEU.33.7.005" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t009" x-align="DEU.33.7.a007">he</char> <char style="w" x-id="t010" x-align="DEU.33.7.a007" x-src="WLC.DEU.33.7.006" x-source="יֹּאמַר֒" x-translit="yyōʾmar" srcloc="WLC.DEU.33.7.006" x-head="true" lemma="אָמַר" strong="H559">said</char>,</para>
	<para style="q1"><char style="w" x-id="t011" x-align="DEU.33.7.a008" x-src="WLC.DEU.33.7.007" x-source="שְׁמַ֤ע" x-translit="šəmaʿ" srcloc="WLC.DEU.33.7.007" x-head="true" lemma="שָׁמַע" strong="H8085">Hear</char>, <char style="w" x-id="t012" x-align="DEU.33.7.a009" x-src="WLC.DEU.33.7.008" x-source="יְהוָה֙" x-translit="yhwh" srcloc="WLC.DEU.33.7.008" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>, <char style="w" x-id="t013" x-align="DEU.33.7.a010">the</char> <char style="w" x-id="t014" x-align="DEU.33.7.a010" x-src="WLC.DEU.33.7.009" x-source="ק֣וֹל" x-translit="qôl" srcloc="WLC.DEU.33.7.009" x-head="true" lemma="קוֹל" strong="H6963">voice</char> <char style="w" x-id="t015" x-align="DEU.33.7.a011">of</char> <char style="w" x-id="t016" x-align="DEU.33.7.a011" x-src="WLC.DEU.33.7.010" x-source="יְהוּדָ֔ה" x-translit="yəhûḏāh" srcloc="WLC.DEU.33.7.010" x-head="true" lemma="יְהוּדָה" strong="H3063">Judah</char>,</para>
	<para style="q1"><char style="w" x-id="t017" x-align="DEU.33.7.a012" x-src="WLC.DEU.33.7.011" x-source="וְ" x-translit="wə" srcloc="WLC.DEU.33.7.011" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t018" x-align="DEU.33.7.a016" x-src="WLC.DEU.33.7.015" x-source="תְּבִיאֶ֑" x-translit="təḇiyʾ" srcloc="WLC.DEU.33.7.015" x-head="true" lemma="בּוֹא" strong="H935">bring</char> <char style="w" x-id="t019" x-align="DEU.33.7.a017" x-src="WLC.DEU.33.7.016" x-source="נּוּ" x-translit="ennû" srcloc="WLC.DEU.33.7.016" x-head="true" lemma="הוּא" strong="H5105b">him</char> <char style="w" x-id="t020" x-align="DEU.33.7.a016">in</char> <char style="w" x-id="t021" x-align="DEU.33.7.a013" x-src="WLC.DEU.33.7.012" x-source="אֶל" x-translit="ʾel-" srcloc="WLC.DEU.33.7.012" x-head="true" lemma="אֶל" strong="H413">unto</char> <char style="w" x-id="t022" x-align="DEU.33.7.a015" x-src="WLC.DEU.33.7.014" x-source="וֹ" x-translit="ô" srcloc="WLC.DEU.33.7.014" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t023" x-align="DEU.33.7.a014" x-src="WLC.DEU.33.7.013" x-source="עַמּ֖" x-translit="ʿamm" srcloc="WLC.DEU.33.7.013" x-head="true" lemma="עַם" strong="H5971">people</char>.</para>
	<para style="q1"><note caller="-" style="f"><char style="ft">Or, Let <char style="it">his hands</char> be <char style="it">sufficient for them</char></char></note><char style="w" x-id="t024" x-align="DEU.33.7.a018">With</char> <char style="w" x-id="t025" x-align="DEU.33.7.a019" x-src="WLC.DEU.33.7.018" x-source="ו֙" x-translit="w" srcloc="WLC.DEU.33.7.018" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t026" x-align="DEU.33.7.a018" x-src="WLC.DEU.33.7.017" x-source="יָדָי" x-translit="yāḏāy" srcloc="WLC.DEU.33.7.017" x-head="true" lemma="יָד" strong="H3027">hands</char> <char style="w" x-id="t027" x-align="DEU.33.7.a020">he</char> <char style="w" x-id="t028" x-align="DEU.33.7.a020" x-src="WLC.DEU.33.7.019" x-source="רָ֣ב" x-translit="rāḇ" srcloc="WLC.DEU.33.7.019" x-head="true" lemma="ריב" strong="H7378">contended</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">for them</char></char></note><char style="w" x-id="t029" x-align="DEU.33.7.a021" x-src="WLC.DEU.33.7.020" x-source="ל֔" x-translit="l" srcloc="WLC.DEU.33.7.020" x-head="true" lemma="לְ" strong="H3807a">for</char> <char style="w" x-id="t030" x-align="DEU.33.7.a022" x-src="WLC.DEU.33.7.021" x-source="וֹ" x-translit="ô" srcloc="WLC.DEU.33.7.021" x-head="true" lemma="הוּא" strong="H2050c">himself</char>;</para>
	<para style="q1"><char style="w" x-id="t031" x-align="DEU.33.7.a023" x-src="WLC.DEU.33.7.022" x-source="וְ" x-translit="wə" srcloc="WLC.DEU.33.7.022" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t032" x-align="DEU.33.7.a028">thou</char> <char style="w" x-id="t033" x-align="DEU.33.7.a028">shalt</char> <char style="w" x-id="t034" x-align="DEU.33.7.a028" x-src="WLC.DEU.33.7.027" x-source="תִּהְיֶֽה" x-translit="tihyeh:" srcloc="WLC.DEU.33.7.027" x-head="true" lemma="הָיָה" strong="H1961">be</char> <char style="w" x-id="t035" x-align="DEU.33.7.a024">a</char> <char style="w" x-id="t036" x-align="DEU.33.7.a024" x-src="WLC.DEU.33.7.023" x-source="עֵ֥זֶר" x-translit="ʿēzer" srcloc="WLC.DEU.33.7.023" x-head="true" lemma="עֵזֶר" strong="H5828">help</char> <char style="w" x-id="t037" x-align="DEU.33.7.a025" x-src="WLC.DEU.33.7.024" x-source="מִ" x-translit="mi" srcloc="WLC.DEU.33.7.024" x-head="true" lemma="מִן" strong="H4480">against</char> <char style="w" x-id="t038" x-align="DEU.33.7.a027" x-src="WLC.DEU.33.7.026" x-source="ו" x-translit="w" srcloc="WLC.DEU.33.7.026" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t039" x-align="DEU.33.7.a026" x-src="WLC.DEU.33.7.025" x-source="צָּרָ֖י" x-translit="ṣṣārāy" srcloc="WLC.DEU.33.7.025" x-head="true" lemma="צַר" strong="H6862a">adversaries</char>.<verse eid="DEU 33:7" /></para>
	<para style="p"><verse number="8" style="v" x-unrepresented-source="וֹ֙" x-unrepresented-translit="ô" x-unrepresented-src="WLC.DEU.33.8.016" sid="DEU 33:8" /><char style="w" x-id="t001" x-align="DEU.33.8.a001" x-src="WLC.DEU.33.8.001" x-source="וּ" x-translit="û" srcloc="WLC.DEU.33.8.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t002" x-align="DEU.33.8.a002" x-src="WLC.DEU.33.8.002" x-source="לְ" x-translit="lə" srcloc="WLC.DEU.33.8.002" x-head="true" lemma="לְ" strong="H3807a">of</char> <char style="w" x-id="t003" x-align="DEU.33.8.a003" x-src="WLC.DEU.33.8.003" x-source="לֵוִ֣י" x-translit="lēwiy" srcloc="WLC.DEU.33.8.003" x-head="true" lemma="לֵוִי" strong="H3881">Levi</char> <char style="w" x-id="t004" x-align="DEU.33.8.a004">he</char> <char style="w" x-id="t005" x-align="DEU.33.8.a004" x-src="WLC.DEU.33.8.004" x-source="אָמַ֔ר" x-translit="ʾāmar" srcloc="WLC.DEU.33.8.004" x-head="true" lemma="אָמַר" strong="H559">said</char>,</para>
