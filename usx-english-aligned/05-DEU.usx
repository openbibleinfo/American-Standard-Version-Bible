	<para style="q1"><char style="w" x-id="t006" x-align="DEU.33.4.a006">An</char> <char style="w" x-id="t007" x-align="DEU.33.4.a006" x-src="WLC.DEU.33.4.006" x-source="מוֹרָשָׁ֖ה" x-translit="môrāšāh" srcloc="WLC.DEU.33.4.006" x-head="true" lemma="מוֹרָשָׁה" strong="H4181">inheritance</char> <char style="w" x-id="t008" x-align="DEU.33.4.a007">for</char> <char style="w" x-id="t009" x-align="DEU.33.4.a007">the</char> <char style="w" x-id="t010" x-align="DEU.33.4.a007" x-src="WLC.DEU.33.4.007" x-source="קְהִלַּ֥ת" x-translit="qəhillaṯ" srcloc="WLC.DEU.33.4.007" x-head="true" lemma="קְהִלָּה" strong="H6952">assembly</char> <char style="w" x-id="t011" x-align="DEU.33.4.a008">of</char> <char style="w" x-id="t012" x-align="DEU.33.4.a008" x-src="WLC.DEU.33.4.008" x-source="יַעֲקֹֽב" x-translit="yaʿăqōḇ:" srcloc="WLC.DEU.33.4.008" x-head="true" lemma="יַעֲקֹב" strong="H3290">Jacob</char>.<verse eid="DEU 33:4" /></para>
	<para style="q1"><verse number="5" style="v" sid="DEU 33:5" /><char style="w" x-id="t001" x-align="DEU.33.5.a001" x-src="WLC.DEU.33.5.001" x-source="וַ" x-translit="wa" srcloc="WLC.DEU.33.5.001" x-head="true" lemma="וְ" strong="H2050b">And</char> <note caller="-" style="f"><char style="ft">Or, <char style="it">there was a king</char></char></note><char style="w" x-id="t002" x-align="DEU.33.5.a002">he</char> <char style="w" x-id="t003" x-align="DEU.33.5.a002" x-src="WLC.DEU.33.5.002" x-source="יְהִ֥י" x-translit="yəhiy" srcloc="WLC.DEU.33.5.002" x-head="true" lemma="הָיָה" strong="H1961">was</char> <char style="w" x-id="t004" x-align="DEU.33.5.a005" x-src="WLC.DEU.33.5.005" x-source="מֶ֑לֶךְ" x-translit="meleḵ" srcloc="WLC.DEU.33.5.005" x-head="true" lemma="מֶלֶךְ" strong="H4428">king</char> <char style="w" x-id="t005" x-align="DEU.33.5.a003" x-src="WLC.DEU.33.5.003" x-source="בִ" x-translit="ḇi" srcloc="WLC.DEU.33.5.003" x-head="true" lemma="בְּ" strong="H871a">in</char> <char style="w" x-id="t006" x-align="DEU.33.5.a004" x-src="WLC.DEU.33.5.004" x-source="ישֻׁר֖וּן" x-translit="yšurûn" srcloc="WLC.DEU.33.5.004" x-head="true" lemma="יְשֻׁרוּן" strong="H3484">Jeshurun</char>,</para>
	<para style="q1"><char style="w" x-id="t007" x-align="DEU.33.5.a006" x-src="WLC.DEU.33.5.006" x-source="בְּ" x-translit="bə" srcloc="WLC.DEU.33.5.006" x-head="true" lemma="בְּ" strong="H871a">When</char> <char style="w" x-id="t008" x-align="DEU.33.5.a008">the</char> <char style="w" x-id="t009" x-align="DEU.33.5.a008" x-src="WLC.DEU.33.5.008" x-source="רָ֣אשֵׁי" x-translit="rāʾšê" srcloc="WLC.DEU.33.5.008" x-head="true" lemma="רֹאשׁ" strong="H7218">heads</char> <char style="w" x-id="t010" x-align="DEU.33.5.a009">of</char> <char style="w" x-id="t011" x-align="DEU.33.5.a009">the</char> <char style="w" x-id="t012" x-align="DEU.33.5.a009" x-src="WLC.DEU.33.5.009" x-source="עָ֔ם" x-translit="ʿām" srcloc="WLC.DEU.33.5.009" x-head="true" lemma="עַם" strong="H5971">people</char> <char style="w" x-id="t013" x-align="DEU.33.5.a007">were</char> <char style="w" x-id="t014" x-align="DEU.33.5.a007" x-src="WLC.DEU.33.5.007" x-source="הִתְאַסֵּף֙" x-translit="hiṯʾassēp̄" srcloc="WLC.DEU.33.5.007" x-head="true" lemma="אָסַף" strong="H622">gathered</char>,</para>
