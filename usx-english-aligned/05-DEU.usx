	<para style="q1"><verse number="17" style="v" sid="DEU 33:17" /><note caller="-" style="f"><char style="ft">Or, <char style="it">His firstling bullock</char></char></note><char style="w" x-id="t001" x-align="DEU.33.17.a001">The</char> <char style="w" x-id="t002" x-align="DEU.33.17.a001" x-src="WLC.DEU.33.17.001" x-source="בְּכ֨וֹר" x-translit="bəḵôr" srcloc="WLC.DEU.33.17.001" x-head="true" lemma="בְּכֹר" strong="H1060">firstling</char> <char style="w" x-id="t003" x-align="DEU.33.17.a002">of</char> <char style="w" x-id="t004" x-align="DEU.33.17.a003" x-src="WLC.DEU.33.17.003" x-source="וֹ" x-translit="ô" srcloc="WLC.DEU.33.17.003" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t005" x-align="DEU.33.17.a002" x-src="WLC.DEU.33.17.002" x-source="שׁוֹר֜" x-translit="šôr" srcloc="WLC.DEU.33.17.002" x-head="true" lemma="שׁוֹר" strong="H7794">herd</char>, <char style="w" x-id="t006" x-align="DEU.33.17.a004" x-src="WLC.DEU.33.17.004" x-source="הָדָ֣ר" x-translit="hāḏār" srcloc="WLC.DEU.33.17.004" x-head="true" lemma="הָדָר" strong="H1926">majesty</char> <char style="w" x-id="t007" x-align="DEU.33.17.a005">is</char> <char style="w" x-id="t008" x-align="DEU.33.17.a005" x-src="WLC.DEU.33.17.005 WLC.DEU.33.17.006" x-source="ל֗ וֹ" x-translit="l ô" srcloc="WLC.DEU.33.17.006" x-head="true" lemma="הוּא" strong="H2050c">his</char>;</para>
	<para style="q1"><char style="w" x-id="t009" x-align="DEU.33.17.a006" x-src="WLC.DEU.33.17.007" x-source="וְ" x-translit="wə" srcloc="WLC.DEU.33.17.007" x-head="true" lemma="וְ" strong="H2050b">And</char> <char style="w" x-id="t010" x-align="DEU.33.17.a010" x-src="WLC.DEU.33.17.011" x-source="ו" x-translit="w" srcloc="WLC.DEU.33.17.011" x-head="true" lemma="הוּא" strong="H2050c">his</char> <char style="w" x-id="t011" x-align="DEU.33.17.a009" x-src="WLC.DEU.33.17.010" x-source="קַרְנָ֔י" x-translit="qarnāy" srcloc="WLC.DEU.33.17.010" x-head="true" lemma="קֶרֶן" strong="H7161">horns</char> <char style="w" x-id="t012" x-align="DEU.33.17.a007">are</char> <char style="w" x-id="t013" x-align="DEU.33.17.a007">the</char> <char style="w" x-id="t014" x-align="DEU.33.17.a007" x-src="WLC.DEU.33.17.008" x-source="קַרְנֵ֤י" x-translit="qarnēy" srcloc="WLC.DEU.33.17.008" x-head="true" lemma="קֶרֶן" strong="H7161">horns</char> <char style="w" x-id="t015" x-align="DEU.33.17.a008">of</char> <char style="w" x-id="t016" x-align="DEU.33.17.a008">the</char> <char style="w" x-id="t017" x-align="DEU.33.17.a008">wild</char>-<char style="w" x-id="t018" x-align="DEU.33.17.a008" x-src="WLC.DEU.33.17.009" x-source="רְאֵם֙" x-translit="rəʾēm" srcloc="WLC.DEU.33.17.009" x-head="true" lemma="רְאֵם" strong="H7214">ox</char>:</para>
