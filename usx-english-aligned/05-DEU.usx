	<para style="q1"><char style="w" x-id="t006" x-align="DEU.33.20.a005" x-src="WLC.DEU.33.20.005" x-source="בָּר֖וּךְ" x-translit="bārûḵ" srcloc="WLC.DEU.33.20.005" x-head="true" lemma="בָּרַךְ" strong="H1288">Blessed</char> <char style="w" x-id="t007" x-align="DEU.33.20.a005">be</char> <char style="w" x-id="t008" x-align="DEU.33.20.a006">he</char> <char style="w" x-id="t009" x-align="DEU.33.20.a006">that</char> <char style="w" x-id="t010" x-align="DEU.33.20.a006" x-src="WLC.DEU.33.20.006" x-source="מַרְחִ֣יב" x-translit="marḥiyḇ" srcloc="WLC.DEU.33.20.006" x-head="true" lemma="רָחַב" strong="H7337">enlargeth</char> <char style="w" x-id="t011" x-align="DEU.33.20.a007" x-src="WLC.DEU.33.20.007" x-source="גָּ֑ד" x-translit="gāḏ" srcloc="WLC.DEU.33.20.007" x-head="true" lemma="גָּד" strong="H1410">Gad</char>:</para>
	<para style="q1"><char style="w" x-id="t012" x-align="DEU.33.20.a010">He</char> <char style="w" x-id="t013" x-align="DEU.33.20.a010" x-src="WLC.DEU.33.20.010" x-source="שָׁכֵ֔ן" x-translit="šāḵēn" srcloc="WLC.DEU.33.20.010" x-head="true" lemma="שָׁכַן" strong="H7931">dwelleth</char> <char style="w" x-id="t014" x-align="DEU.33.20.a008" x-src="WLC.DEU.33.20.008" x-source="כְּ" x-translit="kə" srcloc="WLC.DEU.33.20.008" x-head="true" lemma="כְּ" strong="H3509a">as</char> <char style="w" x-id="t015" x-align="DEU.33.20.a009">a</char> <char style="w" x-id="t016" x-align="DEU.33.20.a009" x-src="WLC.DEU.33.20.009" x-source="לָבִ֣יא" x-translit="lāḇiyʾ" srcloc="WLC.DEU.33.20.009" x-head="true" lemma="לָבִיא" strong="H3833">lioness</char>,</para>
