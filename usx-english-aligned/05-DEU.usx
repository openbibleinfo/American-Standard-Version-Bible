	<para style="p"><verse number="4" style="v" sid="DEU 6:4" /><char style="w" x-id="t001" x-align="DEU.6.4.a001" x-src="WLC.DEU.6.4.001" x-source="שְׁמַ֖ע" x-translit="šəmaʿ" srcloc="WLC.DEU.6.4.001" x-head="true" lemma="שָׁמַע" strong="H8085">Hear</char>, <char style="w" x-id="t002" x-align="DEU.6.4.a002">O</char> <char style="w" x-id="t003" x-align="DEU.6.4.a002" x-src="WLC.DEU.6.4.002" x-source="יִשְׂרָאֵ֑ל" x-translit="yiśrāʾēl" srcloc="WLC.DEU.6.4.002" x-head="true" lemma="יִשְׂרָאֵל" strong="H3478">Israel</char>: <note caller="-" style="f"><char style="ft">Or, <char style="it">Jehovah our God, Jehovah is one</char>. Or, <char style="it">Jehovah is our God, Jehovah is one</char>. Or, <char style="it">Jehovah is our God, Jehovah alone</char></char></note><char style="w" x-id="t004" x-align="DEU.6.4.a003" x-src="WLC.DEU.6.4.003" x-source="יְהוָ֥ה" x-translit="yəhwāh" srcloc="WLC.DEU.6.4.003" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char> <char style="w" x-id="t005" x-align="DEU.6.4.a005" x-src="WLC.DEU.6.4.005" x-source="נוּ" x-translit="nû" srcloc="WLC.DEU.6.4.005" x-head="true" lemma="הוּא" strong="H5105a">our</char> <char style="w" x-id="t006" x-align="DEU.6.4.a004" x-src="WLC.DEU.6.4.004" x-source="אֱלֹהֵ֖י" x-translit="ʾĕlōhēy" srcloc="WLC.DEU.6.4.004" x-head="true" lemma="אֱלֹהִים" strong="H430">God</char> <char style="w" x-id="t007" x-align="DEU.6.4.a007">is</char> <char style="w" x-id="t008" x-align="DEU.6.4.a007" x-src="WLC.DEU.6.4.007" x-source="אֶחָֽד" x-translit="ʾeḥāḏ:" srcloc="WLC.DEU.6.4.007" x-head="true" lemma="אֶחָד" strong="H259">one</char> <char style="w" x-id="t009" x-align="DEU.6.4.a006" x-src="WLC.DEU.6.4.006" x-source="יְהוָ֥ה" x-translit="yəhwāh" srcloc="WLC.DEU.6.4.006" x-head="true" lemma="יהוה" strong="H3068">Jehovah</char>: <verse eid="DEU 6:4" /><verse number="5" style="v" x-unrepresented-source="אֵ֖ת" x-unrepresented-translit="ʾēṯ" x-unrepresented-src="WLC.DEU.6.5.003" sid="DEU 6:5" /><char style="w" x-id="t001" x-align="DE