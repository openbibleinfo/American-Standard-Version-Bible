	<para style="q1"><verse number="6" style="v" sid="DEU 33:6" /><char style="w" x-id="t001" x-align="DEU.33.6.a001">Let</char> <char style="w" x-id="t002" x-align="DEU.33.6.a002" x-src="WLC.DEU.33.6.002" x-source="רְאוּבֵ֖ן" x-translit="rəʾûḇēn" srcloc="WLC.DEU.33.6.002" x-head="true" lemma="רְאוּבֵן" strong="H7205">Reuben</char> <char style="w" x-id="t003" x-align="DEU.33.6.a001" x-src="WLC.DEU.33.6.001" x-source="יְחִ֥י" x-translit="yəḥiy" srcloc="WLC.DEU.33.6.001" x-head="true" lemma="חָיָה" strong="H2421">live</char>, <char style="w" x-id="t004" x-align="DEU.33.6.a003" x-src="WLC.DEU.33.6.003" x-source="וְ" x-translit="wə" srcloc="WLC.DEU.33.6.003" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t005" x-align="DEU.33.6.a004" x-src="WLC.DEU.33.6.004" x-source="אַל" x-translit="ʾal-" srcloc="WLC.DEU.33.6.004" x-head="true" lemma="אַל" strong="H408">not</char> <char style="w" x-id="t006" x-align="DEU.33.6.a005" x-src="WLC.DEU.33.6.005" x-source="יָמֹ֑ת" x-translit="yāmōṯ" srcloc="WLC.DEU.33.6.005" x-head="true" lemma="מוּת" strong="H4191">die</char>;</para>
