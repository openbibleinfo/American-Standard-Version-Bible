	<para style="q1"><char style="add"><char style="w" x-id="t016" x-align="DEU.32.5.a009">They</char> <char style="w" x-id="t017" x-align="DEU.32.5.a009">are</char></char> <char style="w" x-id="t018" x-align="DEU.32.5.a009">a</char> <char style="w" x-id="t019" x-align="DEU.32.5.a010" x-src="WLC.DEU.32.5.010" x-source="עִקֵּ֖שׁ" x-translit="ʿiqqēš" srcloc="WLC.DEU.32.5.010" x-head="true" lemma="עִקֵּשׁ" strong="H6141">perverse</char> <char style="w" x-id="t020" x-align="DEU.32.5.a011" x-src="WLC.DEU.32.5.011" x-source="וּ" x-translit="û" srcloc="WLC.DEU.32.5.011" x-head="true" lemma="וְ" strong="H2050b">and</char> <char style="w" x-id="t021" x-align="DEU.32.5.a012" x-src="WLC.DEU.32.5.012" x-source="פְתַלְתֹּֽל" x-translit="p̄əṯaltōl:" srcloc="WLC.DEU.32.5.012" x-head="true" lemma="פְּתַלְתֹּל" strong="H6618">crooked</char> <char style="w" x-id="t022" x-align="DEU.32.5.a009" x-src="WLC.DEU.32.5.009" x-source="דּ֥וֹר" x-translit="dôr" srcloc="WLC.DEU.32.5.009" x-head="true" lemma="דּוֹר" strong="H1755">generation</char>.<verse eid="DEU 32:5" /></para>
