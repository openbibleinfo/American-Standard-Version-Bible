	<para style="p"><char style="w" x-id="t001" x-align="2TH.1.3.a002">We</char> <char style="w" x-id="t002" x-align="2TH.1.3.a002">are</char> <char style="w" x-id="t003" x-align="2TH.1.3.a002" x-src="SBLGNT.2TH.1.3.002" x-source="ὀφείλομεν" x-translit="opheilomen" srcloc="SBLGNT.2TH.1.3.002" x-head="true" lemma="ὀφείλω" strong="G3784">bound</char> <char style="w" x-id="t004" x-align="2TH.1.3.a001">to</char> <char style="w" x-id="t005" x-align="2TH.1.3.a001">give</char> <char style="w" x-id="t006" x-align="2TH.1.3.a001" x-src="SBLGNT.2TH.1.3.001" x-source="Εὐχαριστεῖν" x-translit="Eucharistein" srcloc="SBLGNT.2TH.1.3.001" x-head="true" lemma="εὐχαριστέω" strong="G2168">thanks</char> <char style="w" x-id="t007" x-align="2TH.1.3.a004">to</char> <char style="w" x-id="t008" x-align="2TH.1.3.a004" x-src="SBLGNT.2TH.1.3.004" x-source="θεῷ" x-translit="theōi" srcloc="SBLGNT.2TH.1.3.004" x-head="true" lemma="θεός" strong="G2316">God</char> <char style="w" x-id="t009" x-align="2TH.1.3.a005" x-src="SBLGNT.2TH.1.3.005" x-source="πάντοτε" x-translit="pantote" srcloc="SBLGNT.2TH.1.3.005" x-head="true" lemma="πάντοτε" strong="G3842">always</char> <char style="w" x-id="t010" x-align="2TH.1.3.a006" x-src="SBLGNT.2TH.1.3.006" x-source="περὶ" x-translit="peri" srcloc="SBLGNT.2TH.1.3.006" x-head="true" lemma="περί" strong="G4012">for</char> <char style="w" x-id="t011" x-align="2TH.1.3.a007" x-src="SBLGNT.2TH.1.3.007" x-source="ὑμῶν" x-translit="hymōn" srcloc="SBLGNT.2TH.1.3.007" x-head="true" lemma="σύ" strong="G5216">you</char>, <char style="w" x-id="t012" x-align="2TH.1.3.a008" x-src="SBLGNT.2TH.1.3.008" x-source="ἀδελφοί" x-translit="adelphoi" srcloc="SBLGNT.2TH.1.3.008" x-head="true" lemma="ἀδελφός" strong="G80">brethren</char>, <char style="w" x-id="t013" x-align="2TH.1.3.a009">even</char> <char style="w" x-id="t014" x-align="2TH.1.3.a009" x-src="SBLGNT.2TH.1.3.009" x-source="καθὼς" x-translit="kathōs" srcloc="SBLGNT.2TH.1.3.009" x-head="true" lemma="καθώς" strong="G2531">as</char> <char style="w" x-id="t015" x-align="2TH.1.3.a011">it</char> <char style="w" x-id="t016" x-align="2TH.1.3.a011" x-src="SBLGNT.2TH.1.3.011" x-source="ἐστιν" x-translit="estin" srcloc="SBLGNT.2TH.1.3.011" x-head="true" lemma="εἰμί" strong="G2076">is</char> <char style="w" x-id="t017" x-align="2TH.1.3.a010" x-src="SBLGNT.2TH.1.3.010" x-source="ἄξιόν" x-translit="axion" srcloc="SBLGNT.2TH.1.3.010" x-head="true" lemma="ἄξιος" strong="G514">meet</char>, <char style="w" x-id="t018" x-align="2TH.1.3.a012" x-src="SBLGNT.2TH.1.3.012" x-source="ὅτι" x-translit="hoti" srcloc="SBLGNT.2TH.1.3.012" x-head="true" lemma="ὅτι" strong="G3754">for</char> <char style="w" x-id="t019" x-align="2TH.1.3.a012">that</char> <char style="w" x-id="t020" x-align="2TH.1.3.a016" x-src="SBLGNT.2TH.1.3.016" x-source="ὑμῶν" x-translit="hymōn" srcloc="SBLGNT.2TH.1.3.016" x-head="true" lemma="σύ" strong="G5216">your</char> <char style="w" x-id="t021" x-align="2TH.1.3.a015" x-src="SBLGNT.2TH.1.3.015" x-source="πίστις" x-translit="pistis" srcloc="SBLGNT.2TH.1.3.015" x-head="true" lemma="πίστις" strong="G4102">faith</char> <char style="w" x-id="t022" x-align="2TH.1.3.a013" x-src="SBLGNT.2TH.1.3.013" x-source="ὑπεραυξάνει" x-translit="hyperauxanei" srcloc="SBLGNT.2TH.1.3.013" x-head="true" lemma="ὑπεραυξάνω" strong="G5232">groweth</char> <char style="w" x-id="t023" x-align="2TH.1.3.a013">exceedingly</char>, <char style="w" x-id="t024" x-align="2TH.1.3.a017" x-src="SBLGNT.2TH.1.3.017" x-source="καὶ" x-translit="kai" srcloc="SBLGNT.2TH.1.3.017" x-head="true" lemma="καί" strong="G2532">and</char> <char style="w" x-id="t025" x-align="2TH.1.3.a019" x-src="SBLGNT.2TH.1.3.019" x-source="ἡ" x-translit="hē" srcloc="SBLGNT.2TH.1.3.019" x-head="true" lemma="ὁ" strong="G3588">the</char> <char style="w" x-id="t026" x-align="2TH.1.3.a020" x-src="SBLGNT.2TH.1.3.020" x-source="ἀγάπη" x-translit="agapē" srcloc="SBLGNT.2TH.1.3.020" x-head="true" lemma="ἀγάπη" strong="G26">love</char> <char style="w" x-id="t027" x-align="2TH.